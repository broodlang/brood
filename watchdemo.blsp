;; watchdemo.blsp — a live test of the process-native debugger's terminal view.
;;
;; Run it (see instructions), then WATCH the screen refresh:
;;   • the causal tree grows a worker roughly every ~1.2s, each on its own pid;
;;   • even-numbered workers PARK at a breakpoint and stay in "parked processes"
;;     INDEFINITELY — no timeout (Elixir's dbg would have given up);
;;   • every 10s a background resumer drains the queue, so the parked workers
;;     finally continue. You'll see the queue fill, sit, then drain.
;;
;; Ctrl-C to exit.

(require 'debug)
(defmodule watchdemo (:use debug))

;; A worker: trace a compute with `spy`; every 2nd one PARKS at a breakpoint.
(defn work (n)
  (spy (* n n))
  (when (= 0 (mod n 2))
    (break (str "checkpoint-" n) :n n :square (* n n))))

;; Spawn workers one per ~1.2s as causal children of the current span, so the
;; debugger's causal tree grows across processes as you watch.
(defn generate (total n)
  (when (<= n total)
    (span-spawn (str "worker-" n) (fn () (work n)))
    (sleep 1200)
    (generate total (inc n))))

(def dbg (start-debugger))

;; background: run the workload under one root span
(spawn (with-debugger dbg
         (fn () (span "request-handler" (fn () (generate 6 1))))))

;; background: drain the paused queue every 10s (so you first SEE it sit parked)
(spawn (letrec (loop (fn () (sleep 10000) (resume-all dbg) (loop))) (loop)))

;; foreground: the live, self-refreshing view
(debug-watch dbg)
