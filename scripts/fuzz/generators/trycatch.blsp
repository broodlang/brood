;; try/catch + JIT error-propagation fuzzer. Generate a JIT-eligible function `f` whose body
;; can throw on data-dependent edges (quot/rem/mod by zero, an explicit error, an
;; out-of-range `nth`). Warm it past the tier threshold inside a try/catch loop fed throwing
;; and non-throwing args. Every engine (tree-walker = reference, VM, VM+JIT, GC-stress) must
;; agree on the accumulated checksum, and none may abort — a Brood error raised inside JIT'd
;; code must stay catchable, never crash.
;;
;;   brood scripts/fuzz/generators/trycatch.blsp -- <count> <base-seed> <outdir>

;; ---- seeded draws
(def rng-state (table/new))

(defn rng-reset (seed)
  (table/put rng-state :seed (rand/seed (+ (* seed 2654435761) 1013904223))))

(defn draw-float ()
  (let ([value next-seed] (rand/float (table/get rng-state :seed)))
    (table/put rng-state :seed next-seed)
    value))

(defn draw-int (low high)
  (let ([value next-seed] (rand/int (table/get rng-state :seed) (+ 1 (- high low))))
    (table/put rng-state :seed next-seed)
    (+ low value)))

(defn draw-choice (items) (nth items (draw-int 0 (- (count items) 1))))

;; ---- the grammar
(def leaves ["a" "b" "0" "1" "2" "-1" "3" "-3"])
;; ops that throw on an edge (a zero divisor), and plain arithmetic
(def throwing-ops ["math/quot" "math/rem" "math/mod"])
(def safe-ops ["+" "-" "*"])

;; A depth-bounded tree walk: the recursion is at most `depth` deep by construction.
(check-allow :non-tail-recursion
  (defn expr (depth)
    (if (or (<= depth 0) (< (draw-float) 0.4))
      (draw-choice leaves)
      (let (roll (draw-float) below (- depth 1))
        (cond
          (< roll 0.4) (str "(" (draw-choice throwing-ops) " " (expr below) " " (expr below) ")")
          (< roll 0.7) (str "(" (draw-choice safe-ops) " " (expr below) " " (expr below) ")")
          ;; an explicit conditional throw
          (< roll 0.85) (str "(if (< " (expr below) " 0) (error \"neg\") " (expr below) ")")
          ;; `nth` out of range answers nil rather than throwing, so the throw this leaf
          ;; exists to exercise is made explicit
          else (str "(or (nth [10 20 30] " (expr below) ") (error \"oob\"))"))))))

;; A nested try/catch: the inner catch answers a sentinel, then more arithmetic runs under
;; the outer accumulation — catch-then-continue.
(defn program (seed)
  (rng-reset seed)
  (str "(defn f (a b) "
    (expr 4)
    ")
(defn lp (i acc)
  (if (= i 0) acc
    (lp (- i 1)
      (+ acc
        (try (math/rem (+ 1000 (f (- (math/rem i 9) 4) (- (math/rem i 5) 2))) 100)
             (catch e (+ 7 (try (f (math/rem i 3) 0) (catch e2 3)))))))))
(io/puts (lp 6000 0))
"))

;; ---- driver
(defn argument-int (text)
  (let (value (string/->number text))
    (if (int? value) value (error "generator: expected an integer argument, got: " text))))

(defn write-programs (seed last-seed outdir)
  (when (< seed last-seed)
    (file/spit (str outdir "/tc_" seed ".blsp") (program seed))
    (write-programs (+ seed 1) last-seed outdir)))

(let ([count-text base-text outdir] (system/script-args)
      program-count (argument-int count-text)
      base (argument-int base-text))
  (write-programs base (+ base program-count) outdir)
  (io/puts "wrote" program-count "try/catch programs"))
