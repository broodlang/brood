;; Differential fuzzer for Brood's numeric engines.
;;
;; Generates randomized, deterministic, number-closed programs. Each defines `f(a b c)`
;; whose body is a random numeric expression tree, then warms it in a tail loop (past the
;; JIT tier threshold) accumulating a pr-str checksum of EVERY call result, and prints that
;; checksum. The same program runs under every engine; identical input must yield identical
;; output. Any mismatch (value, TYPE — 5 vs 5.0 —, or one-errors-other-doesn't) is a real
;; bug, because the tree-walker is the reference semantics.
;;
;;   brood scripts/fuzz/generators/numeric.blsp -- <count> <base-seed> <outdir>

;; ---- seeded draws
(def rng-state (table/new))

(defn rng-reset (seed)
  (table/put rng-state :seed (rand/seed (+ (* seed 2654435761) 1013904223))))

(defn draw-float ()
  (let ([value next-seed] (rand/float (table/get rng-state :seed)))
    (table/put rng-state :seed next-seed)
    value))

(defn draw-int (low high)
  (let ([value next-seed] (rand/int (table/get rng-state :seed) (+ 1 (- high low))))
    (table/put rng-state :seed next-seed)
    (+ low value)))

(defn draw-choice (items) (nth items (draw-int 0 (- (count items) 1))))

;; ---- the grammar
(def parameters ["a" "b" "c"])

;; number-closed leaves: params, ints (incl. huge → bignum), floats, negatives
(defn draw-leaf ()
  (let (roll (draw-float))
    (cond
      (< roll 0.45) (draw-choice parameters)
      (< roll 0.6) (str (draw-choice [0 1 2 -1 3 -2 7 -8 100 -100]))
      ;; huge ints: i64 edges, bignum promotion, float precision loss
      (< roll 0.75)
        (str (draw-choice [4611686018427387904
                            -4611686018427387904 9223372036854775807 -9223372036854775808
                            9007199254740993 1180591620717411303424 -1180591620717411303424
                            9223372036854775807]))
      else
        (draw-choice ["0.0" "-0.0" "1.5" "2.0" "0.1" "3.14" "-2.5" "1e308" "-1e16" "0.5" "100.0"]))))

(def binary-ops ["+" "-" "*" "math/max" "math/min" "math/quot" "math/rem" "math/mod"])
(def comparisons ["<" "<=" ">" ">=" "=" "not="])

;; A depth-bounded tree walk: the recursion is at most `depth` deep by construction.
(check-allow :non-tail-recursion
  (defn expr (depth)
    (if (or (<= depth 0) (< (draw-float) 0.3))
      (draw-leaf)
      (let (roll (draw-float) below (- depth 1))
        (cond
          (< roll 0.5) (str "(" (draw-choice binary-ops) " " (expr below) " " (expr below) ")")
          ;; a comparison folded into an if, so the result stays numeric (the spot the
          ;; float= bug lived: a comparison whose operands may be mixed)
          (< roll 0.7)
            (let (test (str "(" (draw-choice comparisons) " " (expr below) " " (expr below) ")"))
              (str "(if " test " " (expr below) " " (expr below) ")"))
          (< roll 0.82) (str "(math/abs " (expr below) ")")
          ;; a let-binding, for slot reuse / float-slot tracking
          (< roll 0.9)
            (str "(let (t " (expr below) ") (" (draw-choice binary-ops) " t " (expr below) "))")
          ;; division can yield a float or an error — both must match across engines
          else (str "(math/quot " (expr below) " (math/max 1 (math/abs " (expr below) ")))"))))))

(defn program (seed)
  (rng-reset seed)
  ;; args derived from i: a int, b float, c mixed — guarantees float paths warm
  (str "(defn f (a b c) "
    (expr 4)
    ")
(defn lp (i acc)
  (if (= i 0) acc
    (lp (- i 1)
      (str acc \"|\"
        (try (pr-str (f (- (math/rem i 11) 5)
                        (/ (- i 50) 4.0)
                        (if (< (math/rem i 3) 1) (- i 30) (* 1.5 (- i 20)))))
             (catch e \"ERR\"))))))
(io/puts (lp 120 \"\"))
"))

;; ---- driver
(defn argument-int (text)
  (let (value (string/->number text))
    (if (int? value) value (error "generator: expected an integer argument, got: " text))))

(defn write-programs (seed last-seed outdir)
  (when (< seed last-seed)
    (file/spit (str outdir "/fz_" seed ".blsp") (program seed))
    (write-programs (+ seed 1) last-seed outdir)))

(let ([count-text base-text outdir] (system/script-args)
      program-count (argument-int count-text)
      base (argument-int base-text))
  (write-programs base (+ base program-count) outdir)
  (io/puts "wrote" program-count "numeric programs"))
