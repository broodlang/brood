;; JIT tier-transition fuzzer. A function's hot arm is fed arguments whose TYPE cycles every
;; iteration (int -> float -> bignum -> int), so the JIT tiers on one type and then must
;; deopt/retier as the type flips — hammering the as_int/as_f64 tag guards and the
;; overflow->bignum deopt. Every engine (tree-walker / VM / JIT / GC-stress) must produce the
;; identical checksum.
;;
;;   brood scripts/fuzz/generators/tier_transition.blsp -- <count> <base-seed> <outdir>

;; ---- seeded draws
(def rng-state (table/new))

(defn rng-reset (seed)
  (table/put rng-state :seed (rand/seed (+ (* seed 2654435761) 1013904223))))

(defn draw-float ()
  (let ([value next-seed] (rand/float (table/get rng-state :seed)))
    (table/put rng-state :seed next-seed)
    value))

(defn draw-int (low high)
  (let ([value next-seed] (rand/int (table/get rng-state :seed) (+ 1 (- high low))))
    (table/put rng-state :seed next-seed)
    (+ low value)))

(defn draw-choice (items) (nth items (draw-int 0 (- (count items) 1))))

;; ---- the grammar
(def operators ["+" "-" "*" "math/max" "math/min"])

;; A depth-bounded tree walk: the recursion is at most `depth` deep by construction.
(check-allow :non-tail-recursion
  (defn expr (depth)
    (if (or (<= depth 0) (< (draw-float) 0.4))
      (draw-choice ["x" "1" "2" "-1" "3" "0"])
      (let (roll (draw-float) below (- depth 1))
        (cond
          (< roll 0.65) (str "(" (draw-choice operators) " " (expr below) " " (expr below) ")")
          (< roll 0.85)
            (let (test (str "("
                         (draw-choice ["<" "<=" ">" "="])
                         " "
                         (expr below)
                         " "
                         (expr below)
                         ")"))
              (str "(if " test " " (expr below) " " (expr below) ")"))
          else (str "(math/abs " (expr below) ")"))))))

;; `pick` cycles the argument type by phase: int (negative and positive), float, bignum
;; (past i64), small int.
(defn program (seed)
  (rng-reset seed)
  (str "(defn f (x) "
    (expr 4)
    ")
(defn pick (i)
  (cond (< (math/rem i 4) 1) (- (math/rem i 200) 100)
        (< (math/rem i 4) 2) (* 1.0 (- (math/rem i 200) 100))
        (< (math/rem i 4) 3) (* 4611686018427387904 (+ 1 (math/rem i 6)))
        else (math/rem i 13)))
(defn lp (i acc)
  (if (= i 0) acc
    (lp (- i 1) (str acc \"|\" (try (pr-str (f (pick i))) (catch e \"E\"))))))
(io/puts (lp 4000 \"\"))
"))

;; ---- driver
(defn argument-int (text)
  (let (value (string/->number text))
    (if (int? value) value (error "generator: expected an integer argument, got: " text))))

(defn write-programs (seed last-seed outdir)
  (when (< seed last-seed)
    (file/spit (str outdir "/tr_" seed ".blsp") (program seed))
    (write-programs (+ seed 1) last-seed outdir)))

(let ([count-text base-text outdir] (system/script-args)
      program-count (argument-int count-text)
      base (argument-int base-text))
  (write-programs base (+ base program-count) outdir)
  (io/puts "wrote" program-count "tier-transition programs"))
