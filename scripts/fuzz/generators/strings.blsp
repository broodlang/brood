;; Self-checking fuzzer for the char-indexed string ops and the form-start scanner.
;;
;; An oracle rather than an engine differential: the string slot's char→byte index
;; (ADR-213) and the form-start safepoint table (ADR-214) live on the HEAP, so every engine
;; config shares them and would agree on a wrong answer. Each generated program checks every
;; result against a reference computed a different way (a code-point vector, or a property
;; that must hold) and prints `BAD …` on a mismatch, which `scripts/fuzz/run.sh` greps for.
;;
;; The corpus mixes 1-, 2-, 3- and 4-byte characters at random positions, and half the
;; strings are long enough (> 256 chars) to be indexed rather than walked — the two code
;; paths differ, and short fixtures exercise only one.
;;
;;   brood scripts/fuzz/generators/strings.blsp -- <count> <base-seed> <outdir>

;; ---- seeded draws
(def rng-state (table/new))

(defn rng-reset (seed)
  (table/put rng-state :seed (rand/seed (+ (* seed 2654435761) 1013904223))))

(defn draw-int (low high)
  (let ([value next-seed] (rand/int (table/get rng-state :seed) (+ 1 (- high low))))
    (table/put rng-state :seed next-seed)
    (+ low value)))

(defn draw-choice (items) (nth items (draw-int 0 (- (count items) 1))))

;; ---- the corpus
;; [source-spelling weight]: 1-, 2-, 3- and 4-byte characters plus the ones the sexp lexer
;; cares about, as they are spelled INSIDE a string literal. Weighted so brackets, quotes
;; and semicolons appear often enough to matter to the scanner without drowning out the
;; multi-byte characters the index exists for.
(def weighted-characters
  [["a" 14]
    ["z" 6]
    ["0" 6]
    [" " 10]
    ["\\n" 8]
    ["é" 8]
    ["ß" 4]
    ["€" 4]
    ["漢" 6]
    ["🙂" 6]
    ["(" 6]
    [")" 6]
    ["[" 2]
    ["]" 2]
    [";" 5]
    ["\\\"" 3]])

(def character-pool
  (into [] (mapcat weighted-characters (fn ([character weight]) (seq/repeat weight character)))))

(defn draw-text (length)
  (apply str (map (range length) (fn (_) (draw-choice character-pool)))))

(defn program (seed)
  (rng-reset seed)
  ;; half short (walked), half past the 256-char index threshold (indexed)
  (let (length (draw-choice [(draw-int 0 40) (draw-int 260 900)])
        body (draw-text length)
        needle (draw-text (draw-int 1 3))
        source-lines (draw-int 2 12))
    (str
      "
;; GENERATED by scripts/fuzz/generators/strings.blsp — seed "
      seed
      "
;; Every op is checked against a reference computed from the code-point vector, so a wrong
;; char->byte conversion is caught here rather than becoming a silently wrong substring.
(def s \""
      body
      "\")
(def needle \""
      needle
      "\")
(def cps (into [] (map (string/->codepoints s) string/int->char)))
(def n (count s))

(defn bad (what a b) (io/puts \"BAD\" what \"got\" (pr-str a) \"want\" (pr-str b)))
(defn chk (what a b) (if (= a b) 0 (do (bad what a b) 1)))

;; substring / char-at against slices of the code-point vector
(defn ref-sub (i j) (apply str (seq/subvec cps i j)))
(defn chk-slices (i acc)
  (if (>= i n)
    acc
    (let (j (math/min n (+ i 1 (math/rem (* i 7) 5))))
      (chk-slices (+ i 1)
        (+ acc (chk \"string/substring\" (string/substring s i j) (ref-sub i j))
           (chk \"string/char-at\" (string/char-at s i) (nth cps i)))))))

;; the string's count agrees with the code-point count, and the whole string round-trips
(def errs0 (+ (chk \"count\" n (count cps))
              (chk \"roundtrip\" s (apply str cps))
              (chk \"substring-all\" (string/substring s 0 n) s)))

;; index-of with a rising `from` must find occurrences in order, each one really there
(defn chk-scan (from acc)
  (let (j (index-of s needle from))
    (if (< j 0)
      acc
      (chk-scan (+ j 1)
        (+ acc (chk \"index-of-at\" (string/substring s j (math/min n (+ j (count needle))))
                 (if (<= (+ j (count needle)) n) needle
                   (string/substring s j n)))
           (if (>= j from) 0 (do (bad \"index-of-order\" j from) 1)))))))

;; last-index-of: the reported position holds the needle, and nothing after it does
(def errs2
  (let (last (string/last-index-of s needle))
    (if (< last 0)
      (chk \"no-needle\" (index-of s needle 0) -1)
      (+ (chk \"last-index-of-at\" (string/substring s last (math/min n (+ last (count needle))))
           (if (<= (+ last (count needle)) n) needle (string/substring s last n)))
         (chk \"nothing-after-last\" (index-of s needle (+ last 1)) -1)))))

;; string/span: `e` is just PAST the maximal run of set members from `i`, so every char in
;; [i, e) is in the set and the char AT `e` (if any) is not.
(defn all-in-set (set i e)
  (if (>= i e) true (if (includes? set (string/char-at s i)) (all-in-set set (+ i 1) e) false)))
(def errs3
  (let (set \" \\n\" i (math/min (math/max 0 (math/quot n 2)) (math/max 0 (- n 1)))
        e (string/span s i set))
    (if (= n 0) 0
      (+ (if (and (>= e i) (<= e n)) 0 (do (bad \"span-range\" e n) 1))
         (if (all-in-set set i e) 0 (do (bad \"span-run-not-all-in-set\" i e) 1))
         (if (or (= e n) (not (includes? set (string/char-at s e)))) 0
           (do (bad \"span-stopped-early\" (string/char-at s e) set) 1))))))

;; the form-start scanner (ADR-214's safepoint table) as a property: the answer is at or
;; before `pos`, at a line start, and is a bracket — or 0 when there is no form start.
(def src (apply str (seq/repeat "
      source-lines
      " \"(defn f (a) (str \\\"x\\\" a))\\n\")))
(defn chk-form (pos acc)
  (if (>= pos (count src))
    acc
    (let (b (reflect/scan-form-start src pos))
      (chk-form (+ pos 3)
        (+ acc
           (if (<= b pos) 0 (do (bad \"form-start-after-pos\" b pos) 1))
           (if (or (= b 0) (= (string/char-at src (- b 1)) \"\\n\")) 0
             (do (bad \"form-start-not-bol\" b (string/char-at src (- b 1))) 1))
           (if (includes? \"([{\" (string/char-at src b)) 0
             (do (bad \"form-start-not-bracket\" (string/char-at src b) b) 1)))))))

(io/puts \"checked\"
  (+ errs0 errs2 errs3 (chk-slices 0 0) (chk-scan 0 0) (chk-form 0 0)))
")))

;; ---- driver
(defn argument-int (text)
  (let (value (string/->number text))
    (if (int? value) value (error "generator: expected an integer argument, got: " text))))

(defn write-programs (seed last-seed outdir)
  (when (< seed last-seed)
    (file/spit (str outdir "/str_" seed ".blsp") (program seed))
    (write-programs (+ seed 1) last-seed outdir)))

(let ([count-text base-text outdir] (system/script-args)
      program-count (argument-int count-text)
      base (argument-int base-text))
  (write-programs base (+ base program-count) outdir)
  (io/puts "wrote" program-count "strings programs"))
