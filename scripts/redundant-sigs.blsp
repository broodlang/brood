;; scripts/redundant-sigs.blsp — the `(sig …)` declarations the checker would derive anyway.
;;
;; A sig is REDUNDANT when the checker infers the same signature for its function with the
;; declaration removed and everything else in the file left as it is — the rule this repo
;; follows is "declare at the leaf that knows a fact nothing above can prove", and a sig
;; that restates the inference proves nothing. Judged per sig, in isolation, through
;; `reflect/source-signatures` (the checker's own pass over the text with that one form
;; blanked), so the comparison is between two renderings of the same `Sig`.
;;
;;   brood scripts/redundant-sigs.blsp -- std/*.blsp std/*/*.blsp   > redundant.txt
;;   brood scripts/redundant-sigs.blsp -- --remove redundant.txt
;;
;; The first prints `path:line name sig` per candidate. The second removes them ONE AT A
;; TIME, keeping each removal only when the file's `nest check --strict` count does not
;; rise — because the same signature is necessary, not sufficient. A sig can be a CONTRACT
;; on what callers hand over: `ed-reindent-line`'s `(buffer int -> buffer)` names the `int`
;; a mode service returns, and its own inference reads the same arrow from the body's
;; demands, yet without it `(+ bol target)` reads `number` at every caller. Eight such
;; sigs across std and bedit survived the first sweep (2026-09-16) only because the gates
;; ran afterwards; the tool measures the gate itself now. The prelude sweeps like any other
;; file (21 went that day, every gate green).

(defn- kept-for-cost? (text line-start)
  "True when the line before `line-start` is a comment carrying `kept for cost` — a sig the
checker infers verbatim that stays anyway, because `brood file`'s pre-flight check pays
for the inference on every run (KI-150). Listed nowhere, removed never."
  (let (before (string/substring text 0 (math/max 0 (dec line-start)))
        nl (string/last-index-of before "\n")
        previous (string/trim (string/substring before
                                (if (< nl 0) 0 (inc nl))
                                (string/length before))))
    (and (string/starts-with? previous ";") (includes? previous "kept for cost"))))

(defn- sig-spans (text)
  "`[start end name]` for every top-level-looking `(sig NAME …)` form in `text`: the
char range of the whole form (balanced parens from the `(sig`) and the declared name.
A sig under a `kept for cost` comment (KI-150) is not a candidate."
  (let (n (string/length text))
    (letrec (scan (fn (i acc)
                    (let (at (index-of text "(sig " i))
                      (if (< at 0)
                        (reverse acc)
                        (let (line-start (let (nl (string/last-index-of (string/substring text 0 at)
                                                    "\n"))
                                           (if (< nl 0) 0 (inc nl)))
                              prefix (string/substring text line-start at))
                          (if (or (not (= "" (string/trim prefix)))
                                (kept-for-cost? text line-start))
                            (scan (inc at) acc)
                            (let (end (balanced-end text at n))
                              (if (nil? end)
                                (reverse acc)
                                (let (body (string/substring text (+ at 5) end)
                                      name (first (string/split (string/trim body) " ")))
                                  (scan end (cons [at end name] acc)))))))))))
      (scan 0 '()))))

(defn- balanced-end (text start n)
  "The index just past the paren that closes the form opening at `start`, or nil."
  (letrec (go (fn (i depth in-str)
                (if (>= i n)
                  nil
                  (let (c (string/substring text i (inc i)))
                    (cond
                      in-str
                        (if (= c "\\") (go (+ i 2) depth true) (go (inc i) depth (not (= c "\""))))
                      (= c "\"") (go (inc i) depth true)
                      (= c "(") (go (inc i) (inc depth) false)
                      (= c ")") (if (= depth 1) (inc i) (go (inc i) (dec depth) false))
                      else (go (inc i) depth false))))))
    (go start 0 false)))

(defn- line-of (text at)
  (count (string/split (string/substring text 0 at) "\n")))

(defn- entry-for (entries name)
  "The signature entry whose name is `name`, qualified or bare."
  (seq/find entries
    (fn (e)
      (let (n (:name e)
            bare (let (i (string/last-index-of n "/"))
                   (if (< i 0) n (string/substring n (inc i) (string/length n)))))
        (or (= n name) (= bare name))))))

(defn- blank-span (text start end)
  "`text` with `[start end)` replaced by spaces — the form gone, every position kept."
  (str (string/substring text 0 start)
    (string/repeat " " (- end start))
    (string/substring text end (string/length text))))

(defn- check-file (path)
  (let (text (file/slurp path)
        spans (sig-spans text)
        declared (reflect/source-signatures text))
    (doseq (span spans)
      (let ([start end name] span
            before (entry-for declared name)
            after (entry-for (reflect/source-signatures (blank-span text start end)) name))
        (when (and before
                after
                (:declared? before)
                (not (:declared? after))
                (not (nil? (:sig before)))
                (= (:sig before) (:sig after)))
          (io/puts (str path ":" (line-of text start) " " name " " (:sig before))))))))

(when (not (= (first (system/script-args)) "--remove"))
  (doseq (path (system/script-args))
    (check-file path)))

;; ---- removal ------------------------------------------------------------------------
;; `brood redundant-sigs.blsp -- --remove redundant.txt`: delete every listed sig (whole
;; lines, spans processed last-first so offsets hold), then re-derive the file and report
;; any removed function whose inferred signature no longer matches what was declared —
;; a sig whose presence another sig's redundancy depended on.

(defn- line-start-of (text at)
  (let (nl (string/last-index-of (string/substring text 0 at) "\n"))
    (if (< nl 0) 0 (inc nl))))

(defn- remove-spans (text spans)
  "`text` without the lines the spans occupy, spans given in any order."
  (fold (reverse (sort-by spans first))
    text
    (fn (t [start end _])
      (let (ls (line-start-of t start)
            after (if (and (< end (string/length t)) (= "\n" (string/substring t end (inc end))))
                    (inc end)
                    end))
        (str (string/substring t 0 ls) (string/substring t after (string/length t)))))))

(defn- strict-count (path)
  "How many strict findings `nest check --strict` reports for `path` alone — the gate a
removal must not move. A sig whose function infers identically without it can still be
a CONTRACT: `ed-reindent-line`'s `(buffer int -> buffer)` names the `int` a mode service
hands its caller, and without it `(+ bol target)` reads `number`. Only the gate sees that."
  (let (r (%os-cmd "nest" ["check" "--strict" path]))
    (count (seq/filter (string/split (str (:stdout r) "\n" (:stderr r)) "\n")
             (fn (line) (includes? line "warning:"))))))

(defn- remove-one-at-a-time (path spans baseline)
  "Remove each span in turn, keeping a removal only when the file's strict count stays at
`baseline`; returns `[removed kept]` counts. Last span first, so earlier offsets hold."
  (fold (reverse (sort-by spans first))
    [0 0]
    (fn ([removed kept] span)
      (let (text (file/slurp path)
            candidate (remove-spans text (list span)))
        (file/spit path candidate)
        (if (<= (strict-count path) baseline)
          [(inc removed) kept]
          (do (file/spit path text) [removed (inc kept)]))))))

(defn- remove-listed (listing)
  (let (lines (seq/filter (string/split (file/slurp listing) "\n") (fn (l) (not (= l ""))))
        by-file (fold lines
                  {}
                  (fn (acc l)
                    (let (path (first (string/split l ":"))
                          tail (string/substring l (inc (string/length path)) (string/length l))
                          name (nth (string/split tail " ") 1 ""))
                      (assoc acc path (cons name (get acc path '())))))))
    (doseq (kv (%map-pairs by-file))
      (let ([path wanted] kv
            names (into #{} wanted)
            spans (seq/filter (sig-spans (file/slurp path))
                    (fn ([_ _ name]) (contains? names name)))
            baseline (strict-count path)
            [removed kept] (remove-one-at-a-time path spans baseline))
        (io/puts (str path ": removed " removed ", kept " kept " (a contract the gate reads)"))))))

(let (args (system/script-args))
  (when (= (first args) "--remove")
    (remove-listed (second args))))
