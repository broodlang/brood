#!/usr/bin/env bash
# ws — drive every Brood repo in the workspace with one command.
#
# The Brood ecosystem is many sibling git repos (brood, hatch, hive, bedit, pong, …), so
# an ecosystem-wide change means the same check → commit → push in each. This runs that
# fan-out. It auto-discovers the sibling repos of the directory it lives in: any sibling
# with a `.git` dir AND a `project.blsp` (a Brood project) or that is `brood` itself.
#
# Usage (run from anywhere):
#   ws list                     # the discovered Brood repos
#   ws status                   # git short-status of each (only the dirty ones)
#   ws check                    # `nest check` each project (needs `nest` on PATH)
#   ws exec  -- <cmd...>        # run <cmd> in each repo
#   ws commit "<message>"       # git add -A && commit each DIRTY repo with <message>
#   ws push                     # git push each repo that is ahead of its upstream
#
# Nothing here force-pushes, resets, stashes, or checks out — it only adds/commits/pushes.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"   # the parent of the brood repo

repos=()
for d in "$root"/*/; do
  d="${d%/}"; name="$(basename "$d")"
  [ -d "$d/.git" ] || continue
  if [ "$name" = "brood" ] || [ -f "$d/project.blsp" ]; then repos+=("$d"); fi
done

cmd="${1:-list}"; shift || true

case "$cmd" in
  list)
    printf '%s\n' "${repos[@]##*/}" ;;
  status)
    for r in "${repos[@]}"; do
      ( cd "$r"
        n=$(git status --short | wc -l)
        a=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo "?")
        if [ "$n" -gt 0 ] || { [ "$a" != "0" ] && [ "$a" != "?" ]; }; then
          printf '%-20s uncommitted=%s unpushed=%s\n' "$(basename "$r")" "$n" "$a"
        fi )
    done ;;
  check)
    for r in "${repos[@]}"; do
      [ -f "$r/project.blsp" ] || continue
      printf '=== %s ===\n' "$(basename "$r")"
      ( cd "$r"; nest check ) || echo "  CHECK FAILED: $(basename "$r")"
    done ;;
  exec)
    [ "${1:-}" = "--" ] && shift
    for r in "${repos[@]}"; do printf '=== %s ===\n' "$(basename "$r")"; ( cd "$r"; "$@" ); done ;;
  commit)
    msg="${1:?ws commit \"<message>\"}"
    for r in "${repos[@]}"; do
      ( cd "$r"
        [ -n "$(git status --short)" ] || exit 0
        git add -A && git commit -q -m "$msg" && echo "committed: $(basename "$r")" )
    done ;;
  push)
    for r in "${repos[@]}"; do
      ( cd "$r"
        [ "$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)" != "0" ] || exit 0
        git push && echo "pushed: $(basename "$r")" )
    done ;;
  *)
    echo "ws: unknown command '$cmd' (list|status|check|exec|commit|push)" >&2; exit 2 ;;
esac
