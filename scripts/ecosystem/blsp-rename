#!/usr/bin/env bash
# blsp-rename — identifier-aware whole-token rename across Brood (.blsp) sources.
#
# A plain sed/`s/old/new/` corrupts substrings: `map/get` sits inside `multimap/get`,
# `map-pairs` inside `assoc-map-pairs`. This renames only whole Brood identifiers, using
# the Brood identifier character set for the word boundary, so those are never touched.
#
# Usage:
#   blsp-rename OLD NEW [PATH ...]           # one rename
#   blsp-rename -f mapping.txt [PATH ...]    # many, from a file of "OLD NEW" lines
#
# PATH defaults to the current directory (recursively; .git and _deps are skipped).
# Prints each changed file. Idempotent: a token already renamed is not re-matched.
set -euo pipefail

mapfile=""
pairs=()
paths=()
while [ $# -gt 0 ]; do
  case "$1" in
    -f) mapfile="$2"; shift 2 ;;
    -f*) mapfile="${1#-f}"; shift ;;
    -*) echo "blsp-rename: unknown flag $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

if [ -n "$mapfile" ]; then
  while read -r o n _; do [ -n "$o" ] && pairs+=("$o" "$n"); done < "$mapfile"
  paths=("$@")
else
  [ $# -lt 2 ] && { echo "usage: blsp-rename OLD NEW [PATH...]  |  blsp-rename -f map.txt [PATH...]" >&2; exit 2; }
  pairs+=("$1" "$2"); shift 2
  paths=("$@")
fi
[ ${#paths[@]} -eq 0 ] && paths=(.)

# Collect target .blsp files (skip .git and vendored _deps — those are re-fetched).
files=()
for p in "${paths[@]}"; do
  while IFS= read -r f; do files+=("$f"); done < <(
    find "$p" -type f -name '*.blsp' -not -path '*/.git/*' -not -path '*/_deps/*'
  )
done
[ ${#files[@]} -eq 0 ] && { echo "no .blsp files under: ${paths[*]}"; exit 0; }

PAIRS_STR="$(printf '%s\n' "${pairs[@]}")" perl -i -e '
  my @flat = split /\n/, $ENV{PAIRS_STR};
  my @p; for (my $i = 0; $i+1 <= $#flat; $i += 2) { push @p, [$flat[$i], $flat[$i+1]]; }
  # Brood identifier chars — NOT ":" or "/" so that `name:` and `mod/name` boundaries match,
  # while letters/digits/"-" protect longer identifiers (multimap-, assoc-map-pairs).
  my $C = qr/[A-Za-z0-9_?!*<>=+.%&~\^\-]/;
  local $/;
  while (my $f = shift @ARGV) {
    open my $fh, "<", $f or next; my $s = <$fh>; close $fh; my $orig = $s;
    for my $pair (@p) { my ($o, $n) = @$pair; $s =~ s/(?<!$C)\Q$o\E(?!$C)/$n/g; }
    if ($s ne $orig) { open my $w, ">", $f or next; print $w $s; close $w; print "  changed: $f\n"; }
  }
' "${files[@]}"
