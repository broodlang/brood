#!/usr/bin/env bash
# release-package — bump a Brood package's version and publish it to the registry.
#
# Publishing the naming change meant bumping + republishing hatch and store-postgres. A
# naive `sed 's/:version "0.2.5"/:version "0.2.6"/'` there also bumped the `store`
# *dependency* line to a version that did not exist — a broken release. This bumps ONLY
# the project's OWN version (the first `:version` in project.blsp, which precedes the
# `:dependencies`), never a dep pin, then commits, pushes, and `nest publish`es.
#
# Usage:
#   release-package [DIR] [VERSION]   # DIR default: cwd. VERSION default: patch-bump.
set -euo pipefail

dir="${1:-.}"; want="${2:-}"
cd "$dir"
[ -f project.blsp ] || { echo "release-package: no project.blsp in $dir" >&2; exit 2; }

cur="$(grep -m1 -oE ':version "[0-9]+\.[0-9]+\.[0-9]+"' project.blsp | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')"
[ -n "$cur" ] || { echo "release-package: could not read current :version" >&2; exit 2; }

if [ -n "$want" ]; then
  new="$want"
else
  IFS=. read -r MA MI PA <<<"$cur"; new="$MA.$MI.$((PA + 1))"   # patch bump
fi

name="$(grep -m1 -oE ':name "[^"]+"' project.blsp | sed -E 's/:name "([^"]+)"/\1/')"
echo "release-package: $name  $cur -> $new"

# Replace ONLY the FIRST `:version "cur"` (the project's own, before :dependencies).
perl -0pi -e 'BEGIN{$c=$ENV{CUR};$n=$ENV{NEW}} s/:version "\Q$c\E"/:version "$n"/' \
  CUR="$cur" NEW="$new" project.blsp 2>/dev/null || \
  CUR="$cur" NEW="$new" perl -0pi -e 's/:version "\Q$ENV{CUR}\E"/:version "$ENV{NEW}"/' project.blsp

git add project.blsp
git commit -q -m "release: v$new"
git push -q
echo "==> nest publish"
nest publish
echo "released $name v$new"
