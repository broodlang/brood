;; scripts/stdlib-audit.blsp — the standing audit of the standard library's surface.
;;
;; Three questions, asked of every public name the runtime can see:
;;
;;   1. STUTTER    — does a module function repeat its module (`ansi/strip-ansi`)?
;;   2. DOCS       — does it have a docstring, and does that docstring show an EXAMPLE?
;;   3. BARE       — is a core (unnamespaced) name one that has earned staying bare?
;;
;; Written in Brood because the library it audits is Brood: the introspection it needs
;; (`reflect/global-names`, `doc`, `arglist`, `reflect/private?`) is the language's own, so the audit is a
;; program in the thing being audited rather than a script that parses it from outside.
;;
;;   brood scripts/stdlib-audit.blsp

(require-one 'io)
(require-one 'string)
(require-one 'seq)

;; Load everything so the audit sees the whole surface, not just what boot happens to pull.
(doseq (m (reflect/builtin-modules)) (try (require-one m) (catch _ nil)))

(defn- public-names ()
  "Every public global the runtime can see, minus the `%` primitives (mechanism, not
vocabulary) and minus anything a module marked private."
  (sort (filter (reflect/global-names)
          (fn (s)
            (let (n (->string s))
              (and (not (string/starts-with? n "%")) (not (reflect/private? s))))))))

(defn- module-of (n)
  "The module prefix of qualified name `n`, or nil when it is a bare core name.
A leading `/` (the bare `/` operator) is not a namespace separator."
  (let (i (index-of n "/"))
    (if (and i (> i 0)) (string/substring n 0 i) nil)))

(defn- local-of (n)
  (let (i (index-of n "/")) (if (and i (> i 0)) (string/substring n (inc i) (count n)) n)))

;; ---- 1. stutter -------------------------------------------------------------

(defn- stutters? (n)
  "Does the local part repeat its module — `ansi/strip-ansi`, `bytes/bytes-at`? The last
segment of the module is what must not reappear, so `editor/buffer/buffer-put` counts."
  (let (m (module-of n))
    (when m
      (let (tail (last (string/split m "/"))
            local (local-of n))
        (or (string/starts-with? local (str tail "-"))
          (string/ends-with? local (str "-" tail))
          (= local tail))))))

;; ---- 2. docs ----------------------------------------------------------------

(defn- example? (d)
  "Does docstring `d` show a usage example? Either an indented form, an arrow, or a
parenthesised call on its own line — the shapes the stdlib actually uses."
  (and d
    (let (s (str d))
      (or (includes? s "\n    (")
        (includes? s " => ")
        (includes? s " → ")
        (includes? s "\ne.g.")
        (includes? s "(e.g.")))))

;; ---- report -----------------------------------------------------------------

(defn- report (label xs)
  (io/puts "")
  (io/puts "== " label " (" (count xs) ")")
  (doseq (chunk (partition (sort xs) 6))
    (io/puts "   " (reduce chunk "" (fn (a b) (if (= a "") b (str a "  " b)))))))

(let (names (map (public-names) ->string)
      qualified (filter names (fn (n) (module-of n)))
      bare (filter names (fn (n) (not (module-of n))))
      stutter (filter qualified stutters?)
      no-doc (filter names
               (fn (n) (nil? (try (doc (reflect/eval (string/->symbol n))) (catch _ nil)))))
      no-example (filter names
                   (fn (n)
                     (let (d (try (doc (reflect/eval (string/->symbol n))) (catch _ nil)))
                       (and d (not (example? d)))))))
  (io/puts "stdlib audit — "
    (count names)
    " public names ("
    (count bare)
    " bare, "
    (count qualified)
    " namespaced)")
  (report "STUTTER — local part repeats its module" stutter)
  (io/puts "")
  (io/puts "== DOCS")
  ;; "no docstring" is a misleading headline on its own. Measured 2026-08-25: of 248 such
  ;; names, exactly THREE were `defn`/`defmacro` — and those three turned out to be
  ;; ability ops. The other 245 come from `def`, `defdyn`, `defrecord` and `defability`
  ;; op declarations, none of which HAS a docstring slot, so no amount of writing prose
  ;; fixes them. Every public `defn`/`defmacro` in the library is documented.
  ;;
  ;; The actionable number is therefore the example count below, not this one.
  (io/puts "   no docstring at all : "
    (count no-doc)
    "  (def/defdyn/defrecord/ability ops — no docstring slot exists)")
  (io/puts "   docstring, no example: " (count no-example))
  (io/puts "   documented + example : " (- (count names) (count no-doc) (count no-example)))
  (report "BARE core names — each must earn staying unnamespaced" bare))
