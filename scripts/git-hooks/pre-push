#!/bin/sh
# Local pre-push guard: catch the two format gates here instead of five minutes into
# CI. Install with `make hooks`. Bypass with --no-verify if you must.
#
# Rust half: unformatted Rust reached main three times on 2026-07-26 (ADR-165,
# ADR-167, plus a clippy unused_mut).
#
# Brood half added 2026-08-18: the hook only ever checked `cargo fmt`, so `nest
# format` was the gate that could still go red in a push — and did, when a merge was
# pushed with the formatter red because its *last line* was read instead of its exit
# code. Two different formatters, two different gates; the hook needs both.
if ! cargo fmt --all --check >/dev/null 2>&1; then
    echo "pre-push: rustfmt would fail CI. Run: cargo fmt --all" >&2
    cargo fmt --all --check 2>&1 | grep '^Diff in' | sed 's/^/  /' >&2
    exit 1
fi

# `nest format --check` is whole-project by design (`--changed` is documented as
# ignored with `--check`), so it costs ~50s with a debug binary and there is no
# cheaper subset to check. Only pay that when the push actually carries Brood
# changes — most pushes here are Rust-only and stay fast.
# Both the commits being pushed AND the working tree, because `nest format --check`
# reads the tree: gating only on the pushed commits left a dirty .blsp unchecked while
# the Rust half above checks the tree unconditionally. Whichever shows a .blsp, look.
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)
blsp_touched=$( { git diff --name-only "$upstream..HEAD" 2>/dev/null; \
                  git diff --name-only HEAD 2>/dev/null; \
                  git diff --name-only --cached 2>/dev/null; \
                  git ls-files --others --exclude-standard 2>/dev/null; } | grep -c '\.blsp$' )
if [ "$blsp_touched" -gt 0 ]; then
    # Pick the nest that MATCHES THIS TREE, not merely the first one that exists.
    # The old order was release, then debug, then PATH — so it used whatever
    # `make gcstress` / `make breakagetests` last left in target/release/, which can be
    # arbitrarily old. On 2026-08-25 that was `nest 0.10.0 (f53ad7dc)` against a tree at
    # 0.11.0: a formatter one release behind reported "134 files need formatting" and
    # blocked a push whose tree the CURRENT formatter calls clean. A stale gate that
    # refuses correct work is worse than no gate, because the reflex is to --no-verify.
    #
    # So: prefer a binary whose build sha matches HEAD; failing that take the newest by
    # mtime and say the answer may be stale. Never block on "no binary" — unchanged.
    #
    # `target/release-fast/nest` comes FIRST because that is what `make release` builds
    # (RELEASE_DIR); target/release is only written by a plain `cargo build --release`.
    # Omitting it is how this hook announced "no nest built at 39cb081b; using the newest
    # (./target/debug/nest, 6790e1b6)" on 2026-08-28 while a matching binary sat in
    # release-fast — the same wrong-artifact class as KI-76, which was `green.sh` reading
    # target/release for the same reason. If you add a build output path, add it here.
    head_sha=$(git rev-parse --short=8 HEAD 2>/dev/null)
    for candidate in ./target/release-fast/nest ./target/release/nest ./target/debug/nest "$(command -v nest 2>/dev/null)"; do
        [ -n "$candidate" ] && [ -x "$candidate" ] || continue
        case "$("$candidate" --version 2>/dev/null)" in
            *"$head_sha"*) nest_bin="$candidate"; break ;;
        esac
    done
    if [ -z "$nest_bin" ]; then
        # Nothing matches HEAD (a dirty tree, or nothing rebuilt since the last commit).
        # Fall back to the most recently BUILT candidate rather than a fixed order.
        for candidate in ./target/release-fast/nest ./target/release/nest ./target/debug/nest "$(command -v nest 2>/dev/null)"; do
            [ -n "$candidate" ] && [ -x "$candidate" ] || continue
            if [ -z "$nest_bin" ] || [ "$candidate" -nt "$nest_bin" ]; then nest_bin="$candidate"; fi
        done
        [ -n "$nest_bin" ] && echo "pre-push: no nest built at $head_sha; using the newest ($nest_bin, $("$nest_bin" --version 2>/dev/null)) — this check may be stale." >&2
    fi
    if [ -z "$nest_bin" ]; then
        echo "pre-push: .blsp files changed but no nest binary found — skipping the format check." >&2
    elif ! "$nest_bin" format --check >/dev/null 2>&1; then
        echo "pre-push: nest format would fail CI. Run: nest format" >&2
        "$nest_bin" format --check 2>&1 | tail -5 | sed 's/^/  /' >&2
        exit 1
    fi
fi
