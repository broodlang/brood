#!/bin/sh
# Local pre-push guard: catch the cheap gates here instead of five minutes into CI.
# Install with `make hooks`; run it by hand with `make prepush`. Bypass a single push
# with --no-verify if you must.
#
# What it runs, and why each is here (every one is a gate that went red on `main`
# because nothing between "it works" and CI asked):
#
#   always (under a second)
#     - `cargo fmt --check` — unformatted Rust reached main three times on 2026-07-26.
#     - `scripts/banned-names.sh` — Brood described in its own terms; a whole-tree git grep.
#     - `scripts/embedded-paths.sh HEAD` — every file an `include_str!` / `embedded_module!`
#       names is in the pushed tree; a swept-up deletion of an embedded std module reached
#       `main` on 2026-11-11 and nothing built.
#     - the BROOD_* flag catalogue — every `"BROOD_X"` literal in a changed .rs/.blsp must
#       have an entry in diagnostics/debug_flags.rs (the same rule the 0.03 s Rust unit test
#       `every_runtime_flag_is_catalogued` enforces, as a grep, so it costs nothing to ask
#       here). `BROOD_GUI_BLIT` landed uncatalogued on 2026-09-13.
#     - two of CI's Rust source gates, as greps over the ADDED lines (both reddened main on
#       2026-10-23, an hour after a push the hook had passed): a new lock-holding `static`
#       under crates/lisp/src must be listed in `tests/process_wide_statics.rs`, and a new
#       `symbol_is(_, "name")` rule head in the checker must name something bound — or be
#       listed in `rule_heads_are_bound`'s NOT_CALLEES.
#   when a .blsp is involved (a minute or so; a Rust-only push never pays it)
#     - the binaries are REBUILT first (`make release`, incremental) when they are older than
#       the tree: a gate judged by a stale binary fails correct work ("nest check would fail
#       CI" over a std/ edit the binary predates — four times on 2026-10-22/23, every one a
#       rebuild-and-retry). `PREPUSH_NO_BUILD=1` skips the build and says the check may be stale.
#     - `nest format --check` — whole-project by design; the merge that went red on
#       2026-08-18 read the formatter's LAST LINE instead of its exit code.
#     - the tests that name the modules touched: `std/**/foo-bar.blsp` → `tests/foo_bar_test.blsp`
#       when it exists, every changed `tests/*_test.blsp`, plus the surface audit
#       (`tests/audit_test.blsp`: docstring + `form → result` example ratchets) and the
#       executed doc examples (`tests/doc_examples_test.blsp`) whenever std/ changed — two
#       public functions landed without an example on 2026-09-13 and moved the ratchet.
#     - a change under std/prelude/ also runs the bare-name ledger (`bare_names_test`) and the
#       macro-capture gate (`prelude_capture_test`): a new root name (`->count`, 2026-10-22)
#       is only caught there, and nothing in its own file's name points at either.
#     - a change under crates/lisp/src/types/ runs the checker's expectation files
#       (`sig_adoption_test`, `checker_pass_agreement_test`): a spelling change in a warning
#       (ADR-341's tuple merge) sat red in the suite for a day.
#     - a change under crates/lisp/src/types/ or std/ runs CI's two checker gates over the
#       tree — `nest check` on std/tests/examples and `nest check --strict` on std + tests, both at
#       zero — because a checker change is judged by what it says about std/: ADR-341's
#       second cut landed with `math/clamp` red in strict (2026-09-13). A push touching only
#       tests/ or examples/ runs the same two gates over just the changed files.
#
# Not here, deliberately: the Rust suite and the full `nest test` (12 minutes each — CI's
# job, `make green` reads the verdict), clippy (`make check`), and anything that needs a
# release build. A hook that takes ten minutes is a hook that gets --no-verify'd.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

# ---- 0. the tests must not inherit git's view of THIS repository ------------------
# git runs a hook with GIT_DIR (and, in a linked worktree, more) pointing at the repo being
# pushed. The Brood tests below shell out to git in scratch directories — `package_test`
# builds throwaway repos to resolve `:git` deps — and an inherited GIT_DIR sends every one of
# those commands to the real repository instead: on 2026-09-23 a push from a worktree set
# `core.bare = true` and a `Test <t@example.com>` identity in brood's shared `.git/config`,
# stacked five `init` commits on the branch being pushed and created tags v1.0.0–v2.0.0.
# Nothing below needs them: `cd` to the top level already made the cwd the repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX

fail() { echo "pre-push: $*" >&2; exit 1; }

# ---- 1. rustfmt --------------------------------------------------------------------
if ! cargo fmt --all --check >/dev/null 2>&1; then
    cargo fmt --all --check 2>&1 | grep '^Diff in' | sed 's/^/  /' >&2
    fail "rustfmt would fail CI. Run: cargo fmt --all"
fi

# ---- 1b. no other runtime named in a forward-facing file ----------------------------
scripts/banned-names.sh >/dev/null || fail "banned-names would fail CI (listed above)"

# ---- 1c. every file a crate compiles in is in the commit -----------------------------
# A commit that drops a file `include_str!` / `embedded_module!` still names builds here (the
# file is on disk) and nowhere else: 2b21345d1 swept up a staged deletion of
# std/tool/migrate.blsp and main stopped building (2026-11-11). HEAD's tree is what is pushed.
scripts/embedded-paths.sh HEAD || fail "a crate embeds a file the pushed commit does not have (listed above)"

# ---- 2. the change set: the commits being pushed AND the working tree -------------
# Both, because the Brood gates read the TREE: gating only on the pushed commits left a
# dirty .blsp unchecked while the Rust half checks the tree unconditionally.
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)
changed=$( { git diff --name-only "$upstream..HEAD" 2>/dev/null; \
             git diff --name-only HEAD 2>/dev/null; \
             git diff --name-only --cached 2>/dev/null; \
             git ls-files --others --exclude-standard 2>/dev/null; } | sort -u )
blsp_touched=$(printf '%s\n' "$changed" | grep -c '\.blsp$')
types_touched=$(printf '%s\n' "$changed" | grep -c '^crates/lisp/src/types/')

# ---- 3. the BROOD_* flag catalogue -------------------------------------------------
# The changed files only; `make check-desktop` runs the same script over every file.
if [ -n "$changed" ]; then
    # shellcheck disable=SC2086
    scripts/check-flag-catalogue.sh $changed || fail "the BROOD_* flag catalogue (above)"
fi

# ---- 3b. CI's Rust source gates, on the lines this push ADDS -----------------------
added_rs() { # the added lines of changed .rs files under $1, prefixed `path:`
    for f in $(printf '%s\n' "$changed" | grep -E "^$1.*\.rs\$"); do
        [ -f "$f" ] || continue
        { git diff "$upstream" -- "$f" 2>/dev/null; git diff --cached -- "$f" 2>/dev/null; } \
            | grep -E '^\+[^+]' | sed "s|^+|$f:|"
    done
}
statics_list=crates/lisp/tests/process_wide_statics.rs
unlisted=""
for hit in $(added_rs crates/lisp/src/ \
        | grep -E ':[[:space:]]*(pub(\((crate|super)\))? )?static [A-Z][A-Z0-9_]*:.*(Mutex|RwLock|boxcar|Registry)' \
        | grep -v 'Cell<' | sed -E 's|^crates/lisp/src/([^:]*):.*static ([A-Z][A-Z0-9_]*):.*|\1,\2|'); do
    path=${hit%,*}; name=${hit#*,}
    grep -qF "(\"$path\", \"$name\"" "$statics_list" || unlisted="$unlisted $path:$name"
done
[ -n "$unlisted" ] && fail "a new process-wide table static is not listed with its reason:$unlisted
  if it records anything about ONE runtime make it a RuntimeCode field; otherwise add it to
  PROCESS_WIDE in $statics_list (CI's every_process_wide_table_says_why)"
rule_heads=$(added_rs crates/lisp/src/types/ | grep -oE 'symbol_is\([^,]*, "[^"]+"\)' | sed -E 's/.*"([^"]+)"\)/\1/' | sort -u)

[ "$blsp_touched" -eq 0 ] && [ "$types_touched" -eq 0 ] && [ -z "$rule_heads" ] && exit 0

# ---- 4. the binaries that MATCH THIS TREE ------------------------------------------
# Not merely the first that exists: the old order was release, then debug, then PATH, so
# it used whatever `make gcstress` last left in target/release/, which can be arbitrarily
# old — on 2026-08-25 a formatter one release behind reported "134 files need formatting"
# against a tree the current one calls clean. A stale gate that refuses correct work is
# worse than no gate, because the reflex is to --no-verify.
#
# Prefer a binary whose build sha matches HEAD; failing that take the newest by mtime and
# say the answer may be stale. Never block on "no binary". `target/release-fast/` comes
# FIRST because that is what `make release` builds (RELEASE_DIR); target/release is only
# written by a plain `cargo build --release`. If you add a build output path, add it here.
head_sha=$(git rev-parse --short=8 HEAD 2>/dev/null)
pick_bin() { # $1 = nest | brood ; prints the path, or nothing
    name=$1; best=""
    for candidate in "./target/release-fast/$name" "./target/release/$name" "./target/debug/$name" "$(command -v "$name" 2>/dev/null)"; do
        [ -n "$candidate" ] && [ -x "$candidate" ] || continue
        case "$("$candidate" --version 2>/dev/null)" in
            *"$head_sha"*) echo "$candidate"; return ;;
        esac
    done
    for candidate in "./target/release-fast/$name" "./target/release/$name" "./target/debug/$name" "$(command -v "$name" 2>/dev/null)"; do
        [ -n "$candidate" ] && [ -x "$candidate" ] || continue
        if [ -z "$best" ] || [ "$candidate" -nt "$best" ]; then best="$candidate"; fi
    done
    [ -n "$best" ] && echo "pre-push: no $name built at $head_sha; using the newest ($best, $("$best" --version 2>/dev/null | head -1)) — this check may be stale." >&2
    echo "$best"
}
# Stale = older than a std/ or crates/ file in the tree. By mtime, not by the sha in
# `--version`: a `-dirty` build carries HEAD's sha and still predates the edits after it, a
# merge's checkout writes the files it brings in (so they are newer), and a commit alone
# changes the sha without changing a byte the binary was built from.
stale_bin() { # $1 = a binary path; true when it is older than the tree it would judge
    [ -n "$1" ] && [ -x "$1" ] || return 0
    [ -n "$(find std crates -newer "$1" \( -name '*.blsp' -o -name '*.rs' \) -print -quit 2>/dev/null)" ]
}
nest_bin=$(pick_bin nest 2>/dev/null)
if stale_bin "$nest_bin"; then
    if [ "${PREPUSH_NO_BUILD:-}" = 1 ]; then
        echo "pre-push: the binaries predate the tree and PREPUSH_NO_BUILD=1 — the Brood gates may judge stale code." >&2
    else
        echo "pre-push: the binaries predate the tree — rebuilding (make release; PREPUSH_NO_BUILD=1 skips)" >&2
        if ! make release >/tmp/brood-prepush-build.$$.log 2>&1; then
            tail -15 /tmp/brood-prepush-build.$$.log | sed 's/^/  /' >&2
            fail "make release failed (log: /tmp/brood-prepush-build.$$.log) — a full disk reads as an LLVM or linker error"
        fi
        rm -f /tmp/brood-prepush-build.$$.log
    fi
    nest_bin=$(pick_bin nest 2>/dev/null)
fi
if [ -z "$nest_bin" ]; then
    echo "pre-push: Brood files changed but no nest binary found — skipping the Brood gates." >&2
    exit 0
fi
# Build uncapped, run capped (CLAUDE.md): one runaway is the whole spike.
. scripts/lib/run-cap.sh
ulimit -v "$RUN_CAP_KB" 2>/dev/null

# ---- 5. nest format --check --------------------------------------------------------
if [ "$blsp_touched" -gt 0 ]; then
    if ! "$nest_bin" format --check >/dev/null 2>&1; then
        "$nest_bin" format --check 2>&1 | grep -E 'needs formatting|error' | head -8 | sed 's/^/  /' >&2
        fail "nest format would fail CI. Run: nest format --changed"
    fi
fi

# ---- 6. the tests that name what changed ------------------------------------------
# The selection lives in scripts/affected-tests.sh (`make affected-tests` prints it).
tests=$(printf '%s\n' "$changed" | sh scripts/affected-tests.sh --files | grep '\.blsp$' | tr '\n' ' ')
tests=${tests:+ $tests}
std_changed=0
printf '%s\n' "$changed" | grep -q '^std/.*\.blsp$' && std_changed=1
# The checker's rule heads (CI: rule_heads_are_bound): each new `symbol_is(_, "name")` must
# name a bound function, a special form, or a word NOT_CALLEES lists.
not_callees=$(sed -n '/const NOT_CALLEES/,/];/p' crates/lisp/src/types/check/tests/review_inference.rs | grep -oE '"[^"]+"' | tr -d '"')
unbound_heads=""
brood_bin=$(pick_bin brood 2>/dev/null)
for head in $rule_heads; do
    printf '%s\n' "$not_callees" | grep -qxF -- "$head" && continue
    [ -n "$brood_bin" ] || continue
    module=${head%/*}; [ "$module" = "$head" ] && module=""
    probe="${module:+(require-one '$module) }(io/puts (or (bound? '$head) (any? (reflect/special-forms) (fn (x) (= x \"$head\")))))"
    printf '%s\n' "$probe" > /tmp/brood-prepush-head.$$.blsp
    case "$("$brood_bin" /tmp/brood-prepush-head.$$.blsp 2>/dev/null | tail -1)" in
        true) ;;
        *) unbound_heads="$unbound_heads $head" ;;
    esac
done
rm -f /tmp/brood-prepush-head.$$.blsp
[ -n "$unbound_heads" ] && fail "a checker rule keys on a name that is not bound:$unbound_heads
  rename it to the live spelling, or — a clause word, not a callee — add it to NOT_CALLEES in
  crates/lisp/src/types/check/tests/review_inference.rs (CI's rule_heads_are_bound)"
if [ "$types_touched" -gt 0 ] || [ "$std_changed" -eq 1 ]; then
    # CI's checker gates, as CI runs them (ci.yml): the file-list form, since the repo root
    # is not a nest project. `nest check` exits 1 on any warning.
    echo "pre-push: running the checker gates over std/ tests/ examples/ (zero warnings)" >&2
    # shellcheck disable=SC2086
    set -- $(find std tests examples -name '*.blsp' 2>/dev/null | sort)
    # `OLDER than`: a nest built before a std/ edit REFUSES to check (B7) — the fix is a
    # rebuild, not a code change, so the line saying so must reach the screen.
    if ! out=$("$nest_bin" check "$@" 2>&1); then
        printf '%s\n' "$out" | grep -E 'warning|error|OLDER than' | head -10 | sed 's/^/  /' >&2
        fail "nest check would fail CI (zero warnings over std/ tests/ examples/)"
    fi
    set -- $(find std tests -name '*.blsp' 2>/dev/null | sort)
    if ! out=$("$nest_bin" check --strict "$@" 2>&1); then
        printf '%s\n' "$out" | grep -E 'warning|error|OLDER than' | head -10 | sed 's/^/  /' >&2
        fail "nest check --strict over std/ tests/ would fail CI"
    fi
else
    # A push that touches only tests/ or examples/ still meets those gates in CI, and a
    # warning in the file itself is the usual way to fail them (an unused `let` binding in
    # a new test reddened 9fda7da8). Check the changed files, as CI checks them.
    # shellcheck disable=SC2086
    set -- $(printf '%s\n' "$changed" | grep -E '^(tests|examples)/.*\.blsp$' | while read -r f; do [ -f "$f" ] && echo "$f"; done)
    if [ "$#" -gt 0 ]; then
        echo "pre-push: running the checker gate over the changed tests/examples (zero warnings)" >&2
        if ! out=$("$nest_bin" check "$@" 2>&1); then
            printf '%s\n' "$out" | grep -E 'warning|error|OLDER than' | head -10 | sed 's/^/  /' >&2
            fail "nest check would fail CI on a changed file"
        fi
        set -- $(printf '%s\n' "$@" | grep '^tests/')
        if [ "$#" -gt 0 ] && ! out=$("$nest_bin" check --strict "$@" 2>&1); then
            printf '%s\n' "$out" | grep -E 'warning|error|OLDER than' | head -10 | sed 's/^/  /' >&2
            fail "nest check --strict would fail CI on a changed test file"
        fi
    fi
fi
if [ -n "$tests" ]; then
    echo "pre-push: running$tests" >&2
    out=$("$nest_bin" test $tests 2>&1)
    status=$?
    # Assert the summary line is PRESENT, never that failures are absent: a runner that
    # died before printing anything has no "test failed" line either (CLAUDE.md).
    summary=$(printf '%s\n' "$out" | grep -E '^[0-9]+ tests,' | tail -1)
    if [ "$status" -ne 0 ] || [ -z "$summary" ]; then
        printf '%s\n' "$out" | grep -E 'test failed|assert:|actual:|expect:|error' | head -20 | sed 's/^/  /' >&2
        fail "these tests would fail CI (${summary:-no summary line — the runner died}). Run: $nest_bin test$tests"
    fi
    echo "pre-push: $summary" >&2
fi
exit 0
