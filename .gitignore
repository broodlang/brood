# Rust build output
/target
/target-perfstats
/target-dbgasrt/
**/*.rs.bk

# Editor / OS cruft
*.swp
.DS_Store
# Emacs auto-save (`#file#`) and backup (`file~`) files. `#` starts a comment in a
# gitignore, hence the escape. A `std/#csv.blsp#` auto-save reached a commit once —
# byte-identical to its source, inert (modules are embedded from an explicit list,
# not by globbing std/), but it showed up in tooling that walks *.blsp.
\#*\#
*~

# Local build options written by ./configure
/config.mk

# Brood package cache — regenerable from project.lock.blsp (committed) (ADR-037)
_deps/

# Startup image — a build artifact, regenerated from source whenever the tree
# changes and never authoritative (ADR-218).
.brood/

# Full external conformance corpora — hundreds of MB, fetched on demand with
# `scripts/fetch-corpus.sh --full`. The committed subset lives in <suite>/data/.
tests/corpus/*/full/

# The Gabriel/Larceny benchmarks' Scheme sources. Deliberately NOT committed: the
# licence chain (Gabriel book -> Gambit -> Larceny -> ecraven) is not cleanly
# attributable per file, so we vendor only the .input oracle data and fetch the
# sources on demand with `scripts/fetch-corpus.sh gabriel` when diffing a port
# against its original. See tests/corpus/gabriel/README.md.
tests/corpus/gabriel/reference/

# A single-binary bundle `nest release` (ADR-038) wrote into the repo root. The bundle is
# named after the project, and this project is `brood`, so it lands here as `./brood` — 23 MB,
# stripped, and easy to mistake for the CLI. It is not: it carries an app image and fails with
# `cannot find module 'main'` when run. Anchored with a leading slash so it ignores only this
# path, never a `brood` file or directory elsewhere in the tree.
/brood

# Local debug artifacts (never commit)
.brood_crash_dump
.brood-skip-blsp-check
erl_crash.dump

# LLVM coverage artifacts
*.profraw
/target-cov/
