;;; chaos_pattern_hell.blsp — pattern matching pushed to extremes
;;;
;;; Every weird pattern combination the matcher supports: non-linear (repeated
;;; variable), nested vector-in-list-in-vector, pin-in-quasiquote context, guard
;;; chains, enormous clause lists, patterns on BigInts, patterns on NaN/infinity,
;;; exhaustive structural decomposition, and match-inside-match-inside-match.
;;;
;;; Targets:
;;;   - The pattern compiler / lowering pass on huge clause lists
;;;   - Non-linear pattern variable binding (x = x constraint)
;;;   - `~expr` pin expression evaluation in complex contexts
;;;   - Guard (`:when`) with side-effectful condition (should only eval once)
;;;   - `match` on heterogeneous value streams
;;;   - Mutual pattern recursion (a match that builds a value, matched again)

(io/puts "--- 500-clause match: linear scan or jump table? ---")

;; CRASH FOUND: eval of a 500-clause match expression causes "recursion too deep"
;; in the pattern compiler — it recurses through each clause without TCO.
;; 100 clauses are safe; 500 are not.
(io/puts "SKIP: 500-clause match crashes pattern compiler (stack overflow at ~200 clauses)")

;; 100-clause version works. Each clause is a (pattern body) list.
(defn make-100-match (v)
  (eval `(match ~v
           ~@(map (fn (i) (list i (str "hit-" i))) (range 100))
           (_ "miss"))))

(io/puts "make-100-match(0):" (make-100-match 0))
(io/puts "make-100-match(50):" (make-100-match 50))
(io/puts "make-100-match(99):" (make-100-match 99))
(io/puts "make-100-match(100):" (make-100-match 100))
(io/puts "make-100-match(-1):" (make-100-match -1))

;; Benchmark: compile the match fn ONCE, then call it 100k times
(def compiled-100-match
  (eval `(fn (v)
           (match v
             ~@(map (fn (i) (list i (str "hit-" i))) (range 100))
             (_ "miss")))))

(defn bench-compiled-match (n)
  (if (= n 0)
    :done
    (do
      (compiled-100-match (rem n 101))
      (bench-compiled-match (- n 1)))))
(io/puts "bench 100k calls to compiled 100-clause match..." (bench-compiled-match 100000))

(io/puts "--- non-linear pattern: (match [a a a] to check all-equal) ---")

(defn all-same? (triple)
  (match triple
    ([x x x] true)
    (_ false)))

(io/puts "all-same? [1 1 1]:" (all-same? [1 1 1]))
(io/puts "all-same? [1 1 2]:" (all-same? [1 1 2]))
(io/puts "all-same? [\"a\" \"a\" \"a\"]:" (all-same? ["a" "a" "a"]))
(io/puts "all-same? [:k :k :j]:" (all-same? [:k :k :j]))

(io/puts "--- non-linear: find duplicates in a pair (same head twice) ---")

(defn dup-head? (xs)
  (match xs
    ; first two equal
    ((x x & _) true)
    (_ false)))

(io/puts "dup-head? (1 1 2):" (dup-head? (list 1 1 2)))
(io/puts "dup-head? (1 2 1):" (dup-head? (list 1 2 1)))
(io/puts "dup-head? (\"x\" \"x\"):" (dup-head? (list "x" "x")))

(io/puts "--- pin expressions: runtime-value matching ---")

(def target-key :magic)
(def target-val 42)

(defn find-magic (m)
  (match (get m target-key)
    (^target-val "found the magic value!")
    (other (str "got: " (pr-str other)))))

(io/puts (find-magic {:magic 42}))
(io/puts (find-magic {:magic 99}))
(io/puts (find-magic {:magic nil}))
(io/puts (find-magic {}))

;; Pin inside a nested structure
(def expected-pair [1 2])
(defn pin-nested (v)
  (match v
    ([^expected-pair x] (str "outer with pair, x=" x))
    (_ "no match")))

(io/puts "pin-nested [[1 2] 3]:" (pin-nested [[1 2] 3]))
(io/puts "pin-nested [[1 3] 3]:" (pin-nested [[1 3] 3]))

(io/puts "--- guard chains (:when with complex conditions) ---")

(defn classify-num (n)
  (match n
    (x :when (and (int? x) (< x 0) (= (rem x 2) 0)) "negative even int")
    (x :when (and (int? x) (< x 0)) "negative odd int")
    (x :when (and (int? x) (= x 0)) "zero")
    (x :when (and (int? x) (= (rem x 2) 0)) "positive even int")
    (x :when (int? x) "positive odd int")
    (x :when (float? x) (str "float: " x))
    (_ "other")))

(io/puts (classify-num -4))
(io/puts (classify-num -7))
(io/puts (classify-num 0))
(io/puts (classify-num 6))
(io/puts (classify-num 9))
(io/puts (classify-num 3.14))
(io/puts (classify-num "hello"))

(io/puts "--- deeply nested pattern: 8-level deep list destructuring ---")

(defn deep-extract (v)
  (match v
    ((a (b (c (d (e (f (g (h)))))))) [a b c d e f g h])
    (_ :nomatch)))

(def deep-val (list 1 (list 2 (list 3 (list 4 (list 5 (list 6 (list 7 (list 8)))))))))
(io/puts "deep-extract:" (pr-str (deep-extract deep-val)))
(io/puts "correct?" (= [1 2 3 4 5 6 7 8] (deep-extract deep-val)))
(io/puts "non-match:" (pr-str (deep-extract (list 1 2))))

(io/puts "--- match in a loop: classify 100k integers ---")

(defn classify-loop (n acc-pos acc-neg acc-zero)
  (if (= n 0)
    {:pos acc-pos :neg acc-neg :zero acc-zero}
    (match (rem n 13)
      (0 (classify-loop (- n 1) acc-pos acc-neg (+ acc-zero 1)))
      (x :when (< x 7) (classify-loop (- n 1) (+ acc-pos 1) acc-neg acc-zero))
      (_ (classify-loop (- n 1) acc-pos (+ acc-neg 1) acc-zero)))))

(def class-result (classify-loop 100000 0 0 0))
(io/puts "classified:" class-result)
(io/puts "total:" (+ (get class-result :pos) (get class-result :neg) (get class-result :zero)))

(io/puts "--- match on BigInt ---")

; ~10^20, BigInt
(def huge-int (* 9999999999 9999999999))
(defn match-bigint (v)
  (match v
    (0 "zero")
    (1 "one")
    (^huge-int "the huge int!")
    (x :when (> x 0) (str "positive: " (type-of x)))
    (_ "other")))

(io/puts "match-bigint(0):" (match-bigint 0))
(io/puts "match-bigint(huge-int):" (match-bigint huge-int))
(io/puts "match-bigint(1000):" (match-bigint 1000))
(io/puts "match-bigint(-5):" (match-bigint -5))

(io/puts "--- match on float edge cases ---")

;; Brood raises on float /0; produce inf via overflow
(def f-inf (* 1.7976931348623157e308 2.0))
;; No NaN in Brood (no sqrt(-1), no 0.0/0.0) — test inf instead
; substitute inf for nan (no native NaN)
(def f-nan f-inf)
(defn match-float (v)
  (match v
    (0.0 "zero-float")
    (1.0 "one-float")
    (3.14 "pi-ish")
    (x :when (float? x) (str "float:" x))
    (x :when (int? x) (str "int:" x))
    (_ "other")))

(io/puts "match-float(0.0):" (match-float 0.0))
(io/puts "match-float(1.0):" (match-float 1.0))
(io/puts "match-float(3.14):" (match-float 3.14))
(io/puts "match-float(f-nan):" (match-float f-nan))
(io/puts "match-float(f-inf):" (match-float f-inf))
(io/puts "match-float(42):" (match-float 42))

(io/puts "--- match-in-match: nested match expressions ---")

(defn parse-command (cmd)
  (match cmd
    ([:move direction amount] (match direction
                                (:north (str "go north " amount " steps"))
                                (:south (str "go south " amount " steps"))
                                (:east (str "go east " amount " steps"))
                                (:west (str "go west " amount " steps"))
                                (other (str "unknown direction: " (pr-str other)))))
    ([:say who what] (match who
                       (:player (str "player says: " what))
                       (:npc (str "NPC says: " what))
                       (_ (str "someone says: " what))))
    ([:wait n] (str "waiting " n " turns"))
    (_ "unknown command")))

(io/puts (parse-command [:move :north 5]))
(io/puts (parse-command [:move :east 3]))
(io/puts (parse-command [:move :diagonal 2]))
(io/puts (parse-command [:say :player "hello!"]))
(io/puts (parse-command [:say :npc "greetings"]))
(io/puts (parse-command [:wait 10]))
(io/puts (parse-command [:quit]))

(io/puts "--- head-tail pattern with 1000-element list ---")

(defn sum-alternating (xs acc take-flag)
  (match xs
    (nil acc)
    ((h & t) (if take-flag
               (sum-alternating t (+ acc h) false)
               (sum-alternating t acc true)))))

(def big-list (range 1 1001))
(def alt-sum (sum-alternating big-list 0 true))
;; Takes elements at even positions (1-indexed): 1, 3, 5, ... 999
;; Sum = 500^2 = 250000
(io/puts "alternating sum of 1..1000 (odd-indexed):" alt-sum)
(io/puts "expected 250000:" (= 250000 alt-sum))

(io/puts "--- DONE ---")
