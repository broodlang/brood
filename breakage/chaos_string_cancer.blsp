;;; chaos_string_cancer.blsp — string operations at absurd scale
;;;
;;; Doubles a seed string 25 times → 33 554 432-character string (~32 MB).
;;; Then hammers it with: index-of, contains?, substring, char-at, split, join,
;;; upper/lower, replace, pad-*, string/repeat, and string/->list on a slice.
;;;
;;; Targets:
;;;   - String allocation and copy (immutable model means every op is a fresh value)
;;;   - `index-of` on a 33 MB string (should be O(n) in the worst case)
;;;   - `string/split` producing millions of fragments
;;;   - `join` re-assembling a million fragments
;;;   - `string/->list` → `list->string` round-trip on a large slice

(io/puts "--- building the 32 MB string ---")

;; "ab" doubled 25× → 2^25 = 33 554 432 chars
(defn double-str (s n)
  (if (= n 0) s (double-str (str s s) (- n 1))))

(def leviathan (double-str "ab" 25))
(io/puts "length:" (string/length leviathan))
(io/puts "first 8 chars:" (string/substring leviathan 0 8))
(io/puts "char at 16777216:" (string/char-at leviathan 16777216))

(io/puts "--- searching ---")
;; The string is all 'a' and 'b' alternating, so "ba" always exists at odd positions
(io/puts "contains? 'ab':" (includes? leviathan "ab"))
(io/puts "contains? 'ba':" (includes? leviathan "ba"))
;; A pattern that can't exist: three consecutive 'a's
(io/puts "contains? 'aaa':" (includes? leviathan "aaa"))
;; index-of near the end — should walk the whole string
(def needle
  (str (string/substring leviathan (- (string/length leviathan) 10) (string/length leviathan))))
(io/puts "index-of last-10-chars:" (index-of leviathan needle))

(io/puts "--- substring & slicing ---")
(def mid-slice (string/substring leviathan 1000000 1001000))
(io/puts "mid-slice length:" (string/length mid-slice))
(io/puts "mid-slice first:" (string/char-at mid-slice 0))

(io/puts "--- case conversion (allocates a full copy) ---")
(def up-slice (string/upper (string/substring leviathan 0 1000000)))
(io/puts "upper 1M-char slice length:" (string/length up-slice))
(io/puts "first char of upper:" (string/char-at up-slice 0))
(def down-slice (string/lower up-slice))
(io/puts "lower round-trip matches original?" (= down-slice (string/substring leviathan 0 1000000)))

(io/puts "--- replace on a 1M-char slice ---")
;; Replace every "ab" with "XY" — should produce same-length output (2-char → 2-char)
(def replaced (string/replace (string/substring leviathan 0 1000000) "ab" "XY"))
(io/puts "replaced length:" (string/length replaced))
(io/puts "replaced first 8:" (string/substring replaced 0 8))
;; Replace back
(def restored (string/replace replaced "XY" "ab"))
(io/puts "restored matches original?" (= restored (string/substring leviathan 0 1000000)))

(io/puts "--- split & join ---")
;; Split on "ab" — a 32M string of alternating 'a','b' has no "ab" runs; split gives many ""-parts
;; Actually "ab" appears every 2 chars, so splitting the 1M-char slice on "ab" gives 500001 pieces
(def parts (string/split (string/substring leviathan 0 1000000) "ab"))
(io/puts "parts count:" (count parts))
(io/puts "first part:" (pr-str (first parts)))
;; Rejoin with a different separator
(def rejoined (string/join parts "||"))
(io/puts "rejoined length:" (string/length rejoined))

(io/puts "--- string/->list -> list->string on a 10k-char slice ---")
(def slice-10k (string/substring leviathan 0 10000))
(def chars (string/->list slice-10k))
(io/puts "char count:" (count chars))
;; Reverse the chars and rejoin
(def reversed-str (string/list-> (reverse chars)))
(io/puts "reversed first 8:" (string/substring reversed-str 0 8))
;; reversed "ab"×5000 should be "ba"×5000, so first char 'b'
(io/puts "reversed first char is b?" (= "b" (string/char-at reversed-str 0)))

(io/puts "--- pad ---")
;; pad-left takes (string width) — spaces are the fill char (no 3rd arg)
(def padded (string/pad-left "hello" 100))
(io/puts "pad-left length:" (string/length padded))
(io/puts "pad-left first char:" (pr-str (string/char-at padded 0)))
(io/puts "pad-left last 5:"
  (string/substring padded (- (string/length padded) 5) (string/length padded)))
;; Pad right: pad to 100 chars
(def rpadded (string/pad-right "hello" 100))
(io/puts "pad-right length:" (string/length rpadded))
(io/puts "pad-right last char:" (pr-str (string/char-at rpadded 99)))

(io/puts "--- string/repeat of a long string ---")
;; Repeat the 1k slice 1000 times → 1M chars
(def repeated (string/repeat (string/substring leviathan 0 1000) 1000))
(io/puts "repeated length:" (string/length repeated))
(io/puts "repeated == 1M-char original?" (= repeated (string/substring leviathan 0 1000000)))

(io/puts "--- DONE ---")
