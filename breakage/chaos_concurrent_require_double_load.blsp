;;; chaos_concurrent_require_double_load.blsp — the co-located-secondary double-load race
;;; (found 2026-08-13 while building co-located tests, ADR-225).
;;;
;;; `require-one`'s load-once guarantee is a `%registry-update! :assoc-new` claim on the
;;; feature key: exactly one process may win the test-and-set, and only the winner loads the
;;; file. The kernel op held the runtime `registry_lock` around the read-check-write, so it
;;; LOOKED atomic — but its READ went through `env_get` → `global_lookup_cached`, the
;;; per-process global INLINE CACHE. Under the concurrent-write pressure of many processes'
;;; file loads churning `runtime.version`, a claimant could read a value cached against a
;;; version another claimant's just-committed marker had already superseded, so TWO
;;; claimants both saw the key "absent" and BOTH loaded the file (`heap.rs::registry_update`,
;;; fixed by reading the freshest committed value from the shared globals table directly).
;;;
;;; This reproduces it: build a project with many files, each declaring a primary and a
;;; CO-LOCATED SECONDARY module (ADR-223 Phase 2), then race many concurrent requires at
;;; each secondary. Every file must load EXACTLY once. Counting is atomic on purpose — each
;;; load conses the loading process's globally-unique pid via `%registry-update! :cons-new`
;;; (serialised by the registry lock); a per-module `(def *loads* (inc *loads*))` would lose
;;; the second increment under a concurrent double-load and hide the bug.
;;;
;;; The race is scheduling-sensitive: it needs the near-simultaneous claim burst a mostly
;;; idle worker pool gives, which is why it lives here (a standalone `brood --test`) and not
;;; in the shared suite, where ~110 parallel tests keep the pool busy and close the window.
;;; Before the fix this failed most runs; after it, every file loads once. Run it looped:
;;;   for i in $(seq 20); do ./bin/brood --test breakage/chaos_concurrent_require_double_load.blsp; done

(defmodule chaos-require-test
  (:use test)
  (:use project))

(defn- await-n (n)
  (when (> n 0)
    (receive)
    (await-n (dec n))))

(describe "concurrent require of a co-located secondary loads its file exactly once"
  (test "20 secondaries x 40 concurrent requires never double-load a file"
    (let (root (path/temp "/tmp/brood-chaos-require-")
          files 20
          nreq 40)
      (file/mkdir root)
      (file/mkdir (path/join root "src"))
      (file/spit (path/join root "project.blsp") "(project :name \"crp\" :source-paths [\"src\"])")
      (map (fn (k)
             (file/spit (path/join (path/join root "src") (str "m" k ".blsp"))
               (str "(defmodule m"
                 k ") (defmodule sec" k ") "
                 "(%registry-update! '*chaos-loads* :cons-new nil (self))")))
        (range files))
      (reflect/eval (list 'def '*chaos-loads* nil))
      (setup root)
      ;; Race `nreq` concurrent requires of each secondary in turn — every requirer of one
      ;; key claims against the same marker, so at most one may load its file.
      (map (fn (k)
             (let (me (self)
                   key (symbol (str "crp/sec" k)))
               (map (fn (_) (spawn (fn () (do (require-one key) (send me :done))))) (range nreq))
               (await-n nreq)))
        (range files))
      ;; One load per file → exactly `files` pids on the list. A double-load makes it more.
      (assert= files (count (reflect/eval '*chaos-loads*))))))
