;;; chaos_float_pathology.blsp — IEEE 754 edge cases and int/float boundary stress
;;;
;;; Hammers the evaluator / JIT with float operations that cross tag boundaries,
;;; approach infinity, underflow to subnormals, alternate int/float in accumulators,
;;; and probe the int→float exactness boundary.
;;;
;;; Targets:
;;;   - Tag-checking when the same slot holds int then float then int
;;;   - Float overflow to infinity (Brood should not panic)
;;;   - Float underflow to subnormal / zero
;;;   - `->fixed` / `format` on extreme values
;;;   - Arithmetic chains where intermediate values are float then int
;;;   - `round` / `floor` / `ceil` / `abs` on edge-case values
;;;   - Division that crosses the exact/inexact boundary mid-stream

(io/puts "--- basic IEEE 754 extremes ---")

(def f-max 1.7976931348623157e308)
; smallest positive subnormal (DBL_TRUE_MIN)
(def f-min 5.0e-324)
;; Brood raises on float /0 instead of giving IEEE infinity — so we catch and probe
(def div-by-zero-result (try (/ 1.0 0.0) (catch e (str "raises: " (error-message e)))))
(io/puts "1.0/0.0 behaviour:" div-by-zero-result)
(def fdiv-zero-result (try (/ 0.0 0.0) (catch e (str "raises: " (error-message e)))))
(io/puts "0.0/0.0 behaviour:" fdiv-zero-result)

;; Generate inf/nan via other means — sqrt(-1) might give NaN, or large pow
; overflow → +inf or raises?
(def f-inf (check-allow :discarded-catch (try (math/pow 1.0e308 2.0) (catch _ nil))))
; complex result → NaN or raises?
(def f-nan (check-allow :discarded-catch (try (math/sqrt -1.0) (catch _ nil))))
; overflow negative?
(def f-ninf (check-allow :discarded-catch (try (* f-max -2.0) (catch _ nil))))
(io/puts "--- basic IEEE 754 extremes ---")
(io/puts "f-max:" f-max)
(io/puts "f-min:" f-min)
; may be nil (raised) or +inf
(io/puts "pow(1e308,2):" f-inf)
; may be nil (raised) or NaN
(io/puts "sqrt(-1.0):" f-nan)
; may be nil or -inf
(io/puts "f-max * -2:" f-ninf)
(io/puts "f-min > 0:" (> f-min 0.0))

;; Overflow: multiply f-max by 2 → what happens?
(io/puts "f-max * 2.0:" (try (* f-max 2.0) (catch e (str "raises: " (error-message e)))))
(io/puts "f-max + f-max:" (try (+ f-max f-max) (catch e (str "raises: " (error-message e)))))
;; Underflow: f-min / 2 → subnormal or 0?
(io/puts "f-min / 2.0:" (try (/ f-min 2.0) (catch e (str "raises: " (error-message e)))))
(io/puts "f-min / 3.0:" (try (/ f-min 3.0) (catch e (str "raises: " (error-message e)))))

(io/puts "--- arithmetic on overflow values (if we got them) ---")
(when f-inf
  (io/puts "f-inf + 1.0:" (try (+ f-inf 1.0) (catch e (str "raises: " (error-message e)))))
  (io/puts "f-inf - f-inf:" (try (- f-inf f-inf) (catch e (str "raises: " (error-message e)))))
  (io/puts "f-inf * 0.0:" (try (* f-inf 0.0) (catch e (str "raises: " (error-message e)))))
  (io/puts "f-inf * -1.0:" (try (* f-inf -1.0) (catch e (str "raises: " (error-message e)))))
  (io/puts "1.0 / f-inf:" (try (/ 1.0 f-inf) (catch e (str "raises: " (error-message e))))))

(io/puts "--- int/float alternating accumulator (JIT deopt storm) ---")

;; Accumulate: each step adds an int, then a float, then an int …
;; The tag flips every step, stressing the JIT's type specialisation.
(defn alt-acc (n acc is-float)
  (if (= n 0)
    acc
    (if is-float
      (alt-acc (- n 1) (+ acc 0.5) false)
      (alt-acc (- n 1) (+ acc 1) true))))

(def alt-result (alt-acc 1000000 0 false))
(io/puts "alt-acc(1M) result:" alt-result)
;; 500000 int steps of +1 = 500000; 500000 float steps of +0.5 = 250000.0 → 750000.0
(io/puts "expected 750000.0:" (= 750000.0 alt-result))

(io/puts "--- exact/inexact division alternation ---")

;; / returns an int when exact (no remainder), else float
;; Alternate: some inputs give int results, some float → repeated tag change
(defn div-stress (n acc)
  (if (= n 0)
    acc
    (let (v (/ n 2))
      ; even n → int, odd n → float
      (div-stress (- n 1) (+ acc v)))))

(def div-result (div-stress 100000 0))
(io/puts "div-stress(100k) result:" div-result)
;; sum of n/2 for n=1..100000; odd n gives (n-0.5), even n gives n/2 = int
;; sum = Σ n/2 = 100000*100001/4 = 2500025000 (half of 5000050000)
;; Actually sum of floor is different; let's just print it
(io/puts "type of result:" (type-of div-result))

(io/puts "--- huge integer that is EXACTLY representable as float ---")

;; 2^53 = 9007199254740992 is exactly representable in f64 (53-bit mantissa)
(def two53 9007199254740992)
; coerce to float
(def two53f (+ two53 0.0))
(io/puts "2^53 as int:" two53)
(io/puts "2^53 as float:" two53f)
; true — structural equality
(io/puts "equal?" (= two53 two53f))
;; 2^53 + 1 is NOT exactly representable — adding 0.0 should lose the last bit
(def two53p1 (+ two53 1))
(def two53p1f (+ two53p1 0.0))
(io/puts "2^53+1 as int:" two53p1)
(io/puts "2^53+1 as float:" two53p1f)
; false: float rounds back to 2^53
(io/puts "equal?" (= two53p1 two53p1f))
(io/puts "--- round / floor / ceil on edge values ---")
; ties-to-even: 0 or 1
(io/puts "round(0.5):" (math/round 0.5))
; ties-to-even: 0 or -1
(io/puts "round(-0.5):" (math/round -0.5))
; 2
(io/puts "round(1.5):" (math/round 1.5))
; -2
(io/puts "round(-1.5):" (math/round -1.5))
; 0 (or -0)
(io/puts "floor(-0.0):" (math/floor -0.0))
; 0
(io/puts "ceil(-0.0):" (math/ceil -0.0))
(when f-inf
  (io/puts "floor(f-inf):" (math/floor f-inf))
  (io/puts "abs(f-ninf):" (when f-ninf (math/abs f-ninf))))
(when f-nan
  (io/puts "floor(f-nan):" (try (math/floor f-nan) (catch e (str "raises: " (error-message e)))))
  (io/puts "abs(f-nan):" (try (math/abs f-nan) (catch e (str "raises: " (error-message e))))))

(io/puts "--- ->fixed / format on extreme values ---")
(io/puts "->fixed(1.23456789e15, 2):" (math/->fixed 1.23456789e15 2))
(io/puts "->fixed(f-min, 400):" (math/->fixed f-min 400))
(when f-inf
  (io/puts "format %.2f of f-inf:"
    (try (string/format "%.2f" f-inf) (catch e (str "raises: " (error-message e))))))
(when f-nan
  (io/puts "format %.2f of f-nan:"
    (try (string/format "%.2f" f-nan) (catch e (str "raises: " (error-message e))))))
(io/puts "format %d of 2^53+1:" (string/format "%d" two53p1))

(io/puts "--- cascading float loss ---")
;; Repeatedly add a tiny delta to a large number — eventually the delta is lost
(defn float-cascade (big delta n acc)
  (if (= n 0)
    acc
    (let (next (+ big delta))
      (float-cascade big delta (- n 1) (+ acc (- next big))))))

(def big-base 1.0e15)
; 1.0 added to 1e15: fine
(def tiny-delta 1.0)
; 0.00001 added to 1e15: lost (below ULP)
(def tiny-delta2 0.00001)
(io/puts "cascade with delta=1.0 (should accumulate):" (float-cascade big-base tiny-delta 1000 0.0))
(io/puts "cascade with delta=0.00001 (should be ~0):" (float-cascade big-base tiny-delta2 1000 0.0))

(io/puts "--- min / max with extreme values ---")
(when f-nan
  (io/puts "min(1.0, f-nan):"
    (try (math/min 1.0 f-nan) (catch e (str "raises: " (error-message e)))))
  (io/puts "max(1.0, f-nan):"
    (try (math/max 1.0 f-nan) (catch e (str "raises: " (error-message e))))))
(when f-inf
  (io/puts "min(f-inf, 1e300):" (math/min f-inf 1.0e300))
  (io/puts "max(f-ninf, -1e300):" (when f-ninf (math/max f-ninf -1.0e300))))

(io/puts "--- pow edge cases (int exponent only in Brood) ---")
; 1 or raises?
(io/puts "pow(0.0, 0):" (try (math/pow 0.0 0) (catch e (str "raises: " (error-message e)))))
; -1.0
(io/puts "pow(-1.0, 3):" (try (math/pow -1.0 3) (catch e (str "raises: " (error-message e)))))
; huge or inf
(io/puts "pow(2.0, 1000):" (try (math/pow 2.0 1000) (catch e (str "raises: " (error-message e)))))
; overflow?
(io/puts "pow(2.0, 1100):" (try (math/pow 2.0 1100) (catch e (str "raises: " (error-message e)))))
; inf or raise?
(io/puts "pow(0.0, -1):" (try (math/pow 0.0 -1) (catch e (str "raises: " (error-message e)))))
; 1.0
(io/puts "pow(2.0, 0):" (try (math/pow 2.0 0) (catch e (str "raises: " (error-message e)))))
; 0.25
(io/puts "pow(0.5, 2):" (try (math/pow 0.5 2) (catch e (str "raises: " (error-message e)))))
;; Float as exponent — explicitly non-integer — should raise
(io/puts "pow(2.0, 1.5):" (try (math/pow 2.0 1.5) (catch e (str "raises: " (error-message e)))))

(io/puts "--- sqrt edge cases ---")
(io/puts "sqrt(0.0):" (math/sqrt 0.0))
(io/puts "sqrt(-1.0):" (try (math/sqrt -1.0) (catch e (str "raises: " (error-message e)))))
;; BUG: sqrt(f-min) raises "division by zero" even though f-min > 0!
;; Smallest positive subnormal (5e-324) is not zero — this is a Brood bug.
(io/puts "sqrt(f-min) [BUG?]:" (try (math/sqrt f-min) (catch e (str "raises: " (error-message e)))))

(io/puts "--- DONE ---")
