;;; chaos_type_blender.blsp — heterogeneous type chaos
;;;
;;; Throws every Brood value type into shared pipelines: map, filter, reduce,
;;; sort, fold, pattern match, `=`, `pr-str`, `type-of`. Mixes ints, floats,
;;; BigInts, strings, keywords, symbols, booleans, nil, pairs, vectors, maps,
;;; functions, and pids into single collections. Tests that every operation
;;; degrades gracefully or produces a well-typed error rather than a panic.
;;;
;;; Targets:
;;;   - Structural equality across heterogeneous types
;;;   - `sort` on mixed-type lists (structural ordering)
;;;   - `pr-str` on every value type, including closures and pids
;;;   - Pattern matching on values of unknown runtime type
;;;   - `fold` / `reduce` with a type-polymorphic accumulator function
;;;   - `apply` with ill-typed arguments (should raise, not panic)
;;;   - `eval` of value types that are not self-evaluating

(io/puts "--- the soup: every value type in one list ---")

(def pid-example (spawn :chaos-pid-holder (receive (_ :done))))

(def soup
  (list 42
    ; int
    ; near i64::MIN (triggers BigInt check)
    -9223372036854775807
    ; float
    3.14
    ; f64::MAX
    1.7976931348623157e308
    ;; NaN/inf: Brood raises on float /0, produce via overflow instead
    ; +inf (via overflow)
    (* 1.7976931348623157e308 2.0)
    ; -inf
    (* 1.7976931348623157e308 -2.0)
    ; string
    "hello world"
    ; empty string
    ""
    ; keyword
    :keyword
    ; symbol
    'symbol
    ; bool
    true
    false
    ; nil
    nil
    ; pair list
    (list 1 2 3)
    ; nil (the empty list)
    nil
    ; vector
    [1 2 3]
    ; empty vector
    []
    ; map
    {:a 1 :b 2}
    ; empty map
    {}
    ; closure (function value)
    (fn (x) (* x x))
    ; pid
    pid-example
    ;; BigInts
    ; i64::MAX + 1 → BigInt
    9223372036854775808
    ; i64::MIN - 1 → BigInt
    -9223372036854775809
    ; large BigInt
    (* 99999999999 99999999999)))

(io/puts "soup count:" (count soup))

(io/puts "--- pr-str every element ---")
(doseq (v soup)
  (io/puts "  type:" (type-of v) " pr-str:" (pr-str v)))

(io/puts "--- structural equality: every element equals itself ---")
(let (all-self-equal (=
                       (count
                         (filter
                           (fn (v)
                             (if (= (type-of v) :float)
                               ;; NaN != NaN — expected; count float as "special"
                               (or (= v v) (includes? (pr-str v) "NaN"))
                               (= v v)))
                           soup))
                       (count soup)))
  (io/puts "all self-equal (NaN excepted):" all-self-equal))

(io/puts "--- filter: keep only truthy values ---")
(def truthy-vals (filter (fn (v) v) soup))
(io/puts "truthy count (nil and false removed):" (count truthy-vals))

(io/puts "--- map: pr-str every value (exercises the printer on all types) ---")
(def strs (map pr-str soup))
(io/puts "stringified count:" (count strs))
(io/puts "all strings?" (= (count (filter string? strs)) (count strs)))

(io/puts "--- type-of frequencies ---")
(def type-freq (seq/frequencies (map type-of soup)))
(io/puts "type frequencies:" (pr-str type-freq))

(io/puts "--- sort the soup (structural order) ---")
;; sort handles heterogeneous types by structural comparison
;; It should either produce a deterministic order or raise on incompatible types
(let (sorted (try (sort soup) (catch e (str "sort-error: " (error-message e)))))
  (if (string? sorted)
    (io/puts "sort raised:" sorted)
    (do
      (io/puts "sort succeeded, count:" (count sorted))
      (io/puts "sorted first:" (pr-str (first sorted)))
      (io/puts "sorted last:" (pr-str (first (reverse sorted)))))))

(io/puts "--- pattern match on each soup element ---")
(defn classify-value (v)
  (match v
    (0 "zero-int")
    (0.0 "zero-float")
    (true "true")
    (false "false")
    (nil "nil")
    ("" "empty-string")
    ([] "empty-vector")
    ({} "empty-map")
    (:keyword "keyword-kw")
    ('symbol "symbol-sym")
    ((x & _) (str "pair-head=" (pr-str x)))
    ;; [x & _] is NOT valid — vectors are fixed-length in patterns
    ([x] (str "vector-len1=" (pr-str x)))
    ([x y] (str "vector-len2=" (pr-str x) "+" (pr-str y)))
    ([x y z] (str "vector-len3=" (pr-str x) "+" (pr-str y) "+" (pr-str z)))
    (x (str "other:" (type-of x) "=" (pr-str x)))))

(doseq (v soup)
  (io/puts "  classify:" (classify-value v)))

(io/puts "--- reduce with polymorphic accumulator: stringify-chain ---")
;; Concatenate pr-str of every element
(def big-repr (reduce (fn (acc v) (str acc "|" (pr-str v))) "" soup))
(io/puts "big-repr length:" (string/length big-repr))
(io/puts "big-repr first 80:" (string/substring big-repr 0 (min 80 (string/length big-repr))))

(io/puts "--- apply with wrong type args (should raise cleanly) ---")
(let (result (try
               (apply + (list "not" "a" "number"))
               (catch e (str "error: " (error-message e)))))
  (io/puts "apply + on strings:" result))

(let (result (try
               (+ "a" 1)
               (catch e (str "error: " (error-message e)))))
  (io/puts "+ string int:" result))

(let (result (try
               (first 42)
               (catch e (str "error: " (error-message e)))))
  (io/puts "first of int:" result))

(let (result (try
               (get 42 :k)
               (catch e (str "error: " (error-message e)))))
  (io/puts "get of int:" result))

(let (result (try
               (count (fn (x) x))
               (catch e (str "error: " (error-message e)))))
  (io/puts "count of fn:" result))

(io/puts "--- deeply nested heterogeneous structure (GC traversal) ---")
;; Build a structure: map of vectors of lists of maps of lists …, 6 levels deep
(defn nest-value (v depth)
  (if (= depth 0)
    v
    (nest-value {:kind :level
                 :depth depth
                 :data [v (str "level-" depth) depth]
                 :children (list (nest-value 42 (- depth 1))
                             (nest-value "leaf" (- depth 1))
                             (nest-value [1 2 3] (- depth 1)))}
      (- depth 1))))

;; This will loop! `nest-value` passes v through unchanged when depth > 0,
;; but the recursive calls go to (- depth 1), so it terminates.
;; Actually let me fix this - the outer call should grow, not pass v through:
(defn make-nested (depth)
  (if (= depth 0)
    {:leaf true :v 42}
    {:kind :node
     :depth depth
     :children [(make-nested (- depth 1)) (make-nested (- depth 1))]
     :payload (string/repeat "x" (* depth 100))}))

; 2^12 = 4096 leaves, payload strings up to 1200 chars
(def deep-tree (make-nested 12))
(io/puts "deep-tree built, kind:" (get deep-tree :kind))
(io/puts "deep-tree depth:" (get deep-tree :depth))

;; pr-str the whole thing — exercises the printer on a deep, wide structure
(def tree-str (pr-str deep-tree))
(io/puts "pr-str of deep-tree length:" (string/length tree-str))

;; Round-trip: read it back and check equality
(def reparsed-tree (read-string tree-str))
(io/puts "round-trip equal?" (= deep-tree reparsed-tree))

(io/puts "--- DONE ---")
