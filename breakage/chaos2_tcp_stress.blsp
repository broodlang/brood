;;; chaos2_tcp_stress.blsp — TCP socket stress and edge cases
;;;
;;; All tests use loopback (127.0.0.1) with OS-assigned ports (port 0).
;;; The model: tcp/listen and tcp/connect both deliver to the calling process's
;;; mailbox. tcp/controlling-process transfers ownership of an accepted socket.
;;;
;;; THEREFORE the listener must be created INSIDE the process that accepts on it. Every
;;; phase below used to call `tcp/listen` in the parent and `receive` the `[:tcp-accept …]`
;;; in a spawned server, so the accept was delivered to the PARENT's mailbox and the server
;;; timed out — P36 read `ok=0 bad=50` and P37-P40 all read `:timeout`. The whole file was
;;; dead that way, and nothing ran it (KI-42). Each server now opens its own listener and
;;; hands the port back to the parent, which waits for it before connecting.
;;;
;;; Targets:
;;;   P36 — multi-client echo server: 50 concurrent clients, each sends/receives
;;;   P37 — rapid connect-disconnect: 200 connections opened and closed without data
;;;   P38 — binary mode: send and receive raw bytes (0x00–0xFF)
;;;   P39 — half-close: client closes its side; server gets :tcp-closed; sends last chunk
;;;   P40 — large payload: 512KB transfer, verify length and content integrity
;;;   P41 — listener closed mid-accept: any in-flight accepts complete or get :tcp-closed
;;;   P42 — tcp/local-port returns valid port; connecting to a dead port raises cleanly

;;; ---- P36: multi-client echo server ----
(io/puts "=== P36: 50-client concurrent echo ===")

(let (me (self)
      n-clients 50)

  ;; Server process: owns the listener, accepts and echoes for each client
  (defn echo-server-loop (ls remaining)
    (if (= remaining 0)
      (tcp/close ls)
      (let (client (receive ([:tcp-accept _ cs] cs) (after 10000 :timeout)))
        (if (= :timeout client)
          (do (io/puts "P36: server accept timeout") (tcp/close ls))
          (do
            (tcp/controlling-process client (self))
            (let (data (receive ([:tcp _ d] d) (after 5000 :timeout)))
              (when data (tcp/send client data))
              (tcp/close client)
              (echo-server-loop ls (- remaining 1))))))))

  (spawn (let (ls (tcp/listen "127.0.0.1" 0))
           (send me [:p36-port (tcp/local-port ls)])
           (echo-server-loop ls n-clients)))

  (def p36-port (receive ([:p36-port p] p) (after 5000 :timeout)))

  ;; Spawn n-clients clients, each sends a unique message and waits for echo
  (dotimes (i n-clients)
    (spawn (let (msg (str "client-" i "-hello")
                 c (tcp/connect "127.0.0.1" p36-port))
             (tcp/send c msg)
             (let (echo (receive ([:tcp _ d] d) (after 5000 :timeout)))
               (tcp/close c)
               (send me [:p36-result i (= msg echo)])))))

  ;; Collect all results
  (defn collect-p36 (n ok bad)
    (if (= n 0)
      [ok bad]
      (let (r (receive ([:p36-result _ success] success) (after 30000 :timeout)))
        (collect-p36 (- n 1) (if r (+ ok 1) ok) (if r bad (+ bad 1))))))
  (let ([ok bad] (collect-p36 n-clients 0 0))
    (io/puts "P36: ok=" ok "bad=" bad)
    (io/puts "P36-correct:" (and (= n-clients ok) (= 0 bad)))))

;;; ---- P37: rapid connect-disconnect (no data) ----
(io/puts "=== P37: 200 rapid connect-disconnect ===")

(let (me (self)
      n 200)

  ;; Server: owns the listener; accept and immediately close
  (spawn (let (ls (tcp/listen "127.0.0.1" 0))
           (send me [:p37-port (tcp/local-port ls)])
           (defn quick-close-loop (remaining)
             (if (= remaining 0)
               (do (tcp/close ls) (send me :server-done))
               (let (client (receive ([:tcp-accept _ cs] cs) (after 10000 :timeout)))
                 (if (= :timeout client)
                   (send me :server-timeout)
                   (do
                     (tcp/close client)
                     (quick-close-loop (- remaining 1)))))))
           (quick-close-loop n)))

  (def p37-port (receive ([:p37-port p] p) (after 5000 :timeout)))

  ;; Clients: connect and immediately close
  (dotimes (_ n)
    (let (c (tcp/connect "127.0.0.1" p37-port))
      ;; Connection may be closed by server before we even close our side
      (tcp/close c)))

  (let (r (receive (:server-done :ok) (:server-timeout :timeout) (after 30000 :timeout)))
    (io/puts "P37: server result:" r)
    (io/puts "P37-correct:" (= :ok r))))

;;; ---- P38: binary mode (raw bytes 0x00–0xFF) ----
(io/puts "=== P38: binary mode round-trip ===")

(let (me (self))

  ;; All 256 byte values, as `bytes`. This used to build a STRING of codepoints 0–255 and
  ;; send that: a string goes over the wire UTF-8-encoded, so codepoints 128–255 became two
  ;; bytes each and 256 "bytes" arrived as 384 (visible as \xc2\x80… in the echo). The phase
  ;; claims to round-trip raw bytes 0x00–0xFF, so it has to send `bytes` to do that.
  (def binary-payload (apply bytes (range 256)))

  ;; Server: owns the listener; accept, switch to binary mode, receive and echo
  ;; Binary mode is set on the LISTENER, not on the accepted stream. Setting it on the
  ;; stream is racy and was this phase's flake (KI-102): the accepted socket is already
  ;; reading when `[:tcp-accept …]` arrives, so this client — which sends the moment it
  ;; connects — could get its 256 raw bytes decoded as text first, and they came back as
  ;; 512 (128 ASCII + 128 U+FFFD, re-encoded as UTF-8). Reproduced 2/30 under load on two
  ;; cores; the listener's mode is fixed before any connection exists, so it has no window.
  (spawn (let (ls (tcp/listen "127.0.0.1" 0))
           (tcp/set-binary ls true)
           (send me [:p38-port (tcp/local-port ls)])
           (let (client (receive ([:tcp-accept _ cs] cs) (after 5000 :timeout)))
             (if (= :timeout client)
               (tcp/close ls)
               (do
                 (tcp/controlling-process client (self))
                 (let (data (receive ([:tcp _ d] d) (after 5000 :timeout)))
                   (when (not (= :timeout data)) (tcp/send client data))
                   (tcp/close client)
                   (tcp/close ls)))))))

  (def p38-port (receive ([:p38-port p] p) (after 5000 :timeout)))

  ;; Client: connect, binary mode, send all bytes, receive them back
  (let (c (tcp/connect "127.0.0.1" p38-port))
    (tcp/set-binary c true)
    (tcp/send c binary-payload)
    (let (echo (receive ([:tcp _ d] d) (after 5000 :timeout)))
      (tcp/close c)
      ;; A binary-mode socket delivers `bytes`, so both sides are compared as bytes.
      (io/puts "P38: payload length:" (count binary-payload))
      (io/puts "P38: echo length:" (if (= :timeout echo) :timeout (count echo)))
      (io/puts "P38-correct:" (= binary-payload echo)))))

;;; ---- P39: half-close: client closes, server reads EOF then sends ----
(io/puts "=== P39: half-close (client closes write side) ===")
;; Note: TCP half-close (shutdown(SHUT_WR)) is not directly exposed.
;; We simulate by closing the client and verifying the server gets :tcp-closed.
(let (me (self))

  (spawn
    (let (ls (tcp/listen "127.0.0.1" 0))
      (send me [:p39-port (tcp/local-port ls)])
      (let (client (receive ([:tcp-accept _ cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process client (self))
        ;; Wait for client data OR close
        (let (event (receive
                      ([:tcp _ d] [:data d])
                      ([:tcp-closed _] :closed)
                      (after 5000 :timeout)))
          (send me [:p39-server-saw event])
          (tcp/close client)
          (tcp/close ls)))))

  (def p39-port (receive ([:p39-port p] p) (after 5000 :timeout)))

  (let (c (tcp/connect "127.0.0.1" p39-port))
    (tcp/send c "hello-before-close")
    (tcp/close c))

  (let (r (receive ([:p39-server-saw v] v) (after 5000 :timeout)))
    (io/puts "P39: server saw:" (pr-str r))
    (io/puts "P39-correct (data or closed):"
      (or (= r :closed) (and (vector? r) (= (get r 0) :data))))))

;;; ---- P40: 512 KB payload, integrity check ----
(io/puts "=== P40: 512KB payload integrity ===")

(let (me (self)
      big (string/repeat "BROOD" (math/quot 524288 5)))
  ; ~512KB

  ;; Server: owns the listener; receive all chunks, concatenate, report length
  (spawn (let (ls (tcp/listen "127.0.0.1" 0))
           (send me [:p40-port (tcp/local-port ls)])
           (let (client (receive ([:tcp-accept _ cs] cs) (after 5000 :timeout)))
             (tcp/controlling-process client (self))
             (defn drain-tcp (sock acc)
               (let (event (receive
                             ([:tcp _ d] [:data d])
                             ([:tcp-closed _] :done)
                             (after 10000 :timeout)))
                 (if (= :done event)
                   (send me [:p40-received acc])
                   (drain-tcp sock (str acc (second event))))))
             (drain-tcp client "")
             (tcp/close client)
             (tcp/close ls))))

  (def p40-port (receive ([:p40-port p] p) (after 5000 :timeout)))

  (let (c (tcp/connect "127.0.0.1" p40-port))
    (tcp/send c big)
    (tcp/close c)
    (let (r (receive ([:p40-received s] s) (after 15000 :timeout)))
      (io/puts "P40: sent:" (string/length big) "received:" (string/length r))
      (io/puts "P40-correct:" (= big r)))))

;;; ---- P41: tcp/local-port after close returns nil ----
(io/puts "=== P41: tcp/local-port after close ===")
(let (ls (tcp/listen "127.0.0.1" 0))
  (def p41-port (tcp/local-port ls))
  (io/puts "P41: port before close:" p41-port)
  (tcp/close ls)
  (def p41-after (try (tcp/local-port ls) (catch e :error)))
  (io/puts "P41: port after close:" p41-after)
  (io/puts "P41-correct (valid port then nil/error):"
    (and (> p41-port 0) (or (= nil p41-after) (= :error p41-after)))))

;;; ---- P42: connect to dead port raises cleanly ----
(io/puts "=== P42: connect to dead port → clean error ===")
;; Find a port that's not listening. Bind one, grab the port, close it.
(let (ls (tcp/listen "127.0.0.1" 0)
      port (tcp/local-port ls))
  (tcp/close ls)
  ;; `tcp/connect` is NON-blocking, so a refusal reaches us one of two ways and both
  ;; are correct: the syscall refuses inline and this throws, or the socket comes back
  ;; and the reactor reports the failure as `[:tcp-closed sock]` / `[:tcp-error sock …]`.
  ;; Asserting only the first made this depend on how fast the loopback stack refuses —
  ;; it threw on CI and returned a live socket here, on the same commit.
  (let (r (try
            (tcp/connect "127.0.0.1" port)
            (catch e (str "error: " (error-message e)))))
    (io/puts "P42: result:" r)
    (let (outcome (if (string? r)
                    :refused-inline (receive
                      ([:tcp-closed _] :refused-by-message)
                      ([:tcp-error _ _] :refused-by-message)
                      (after 5000 :never-refused))))
      (io/puts "P42: refusal arrived as:" outcome)
      (io/puts "P42-correct (refused either way):" (not (= :never-refused outcome))))))

(io/puts "=== chaos2_tcp_stress DONE ===")
