;; std/telemetry.blsp — Erlang :telemetry-style instrumentation.
;; Loaded with (require 'telemetry).
;;
;; Design notes (the *why*; the *what* is in the docstrings):
;;  - **Handlers run in a dedicated LISTENER process, never in the emitting process.**
;;    `emit` is a fire-and-forget `send` to the listener, so a handler can NEVER crash,
;;    hang, or even slow the process that emitted the event (e.g. a web-request
;;    process). The only process a buggy handler can take down is the listener — and a
;;    *throwing* handler doesn't even do that (the listener catches it and detaches the
;;    handler). An UNCATCHABLE handler fault (a stack overflow, `(exit … :kill)`) kills
;;    only the listener; supervise it (see `start-telemetry`) and it restarts with the
;;    handler table intact. This is the deliberate trade-off vs. Erlang's inline
;;    dispatch: we accept one listener as a serialization point in exchange for total
;;    emitter isolation. Keep handlers cheap, or `forward` heavy work to your own
;;    process — the listener only dispatches.
;;  - The handler table is a `def`-rebound global (`*telemetry-handlers*`), so it
;;    survives a listener restart (the listener is a stateless executor that reads it)
;;    and a handler attached in one process is visible to the listener (ADR-013).
;;    attach/detach are configuration-time data ops (they never run handler code), so
;;    they can't crash from a handler either.
;;  - Events are plain Brood values compared by structural `=`: a keyword (:request)
;;    or, Erlang-style, a vector of keyword segments ([:http :request :stop]). `span`
;;    builds the :start/:stop/:exception sub-events off a base vector.

(defmodule telemetry
  "An Erlang :telemetry-style instrumentation seam, written in Brood. Code `emit`s a
named event with a measurements map and a metadata map; every handler `attach`ed to
that event runs on each emit. Crucially, handlers run in a dedicated LISTENER process,
reached by a fire-and-forget `send` — so a handler can never crash, hang, or slow the
emitting process; the only thing a buggy handler can take down is the listener (and a
*throwing* handler is merely caught and detached). Start the listener once
(`start-telemetry`) and supervise it; the handler table is a shared global that
survives a restart. To run slow handler work off the listener too, `forward` to a
process you own.")

;; The shared handler table: event → list of {:id … :fn …}. A `def`-rebound global so
;; it survives a listener restart and is visible across processes (ADR-013).
(def *telemetry-handlers* {})

;; ---- table helpers (pure) ---------------------------------------------------

(defn- telemetry-without-id
  (table id)
  "`table` with any handler whose id is `id` removed from every event bucket."
  (fold (fn (acc ev)
          (assoc acc ev (filter (fn (h) (not (= (get h :id) id))) (get table ev))))
    {}
    (keys table)))

(defn- telemetry-dispatch
  (bucket event measurements metadata)
  "Run every handler in `bucket` (the handlers for `event`), each guarded by
try/catch. Returns the list of ids whose handler threw (to be detached). Runs in the
LISTENER process."
  (fold (fn (failed h)
          (try
            (do ((get h :fn) event measurements metadata) failed)
            (catch _ (cons (get h :id) failed))))
    nil bucket))

(defn- telemetry-run-handlers
  (event measurements metadata)
  "Dispatch `event` to its handlers and detach any that threw. Runs in the listener."
  (when *telemetry-validate*
    (doseq (problem (telemetry-check-event event measurements metadata))
      (eprintln (str "telemetry: event "
                  (pr-str event)
                  " "
                  (name (first problem))
                  " missing key "
                  (pr-str (second problem))))))
  (let (bucket (get *telemetry-handlers* event nil))
    (when bucket
      (let (failed (telemetry-dispatch bucket event measurements metadata))
        (when (not (empty? failed))
          ;; Auto-detach the handlers that threw. Same shape as `detach`: fold the removals
          ;; over whatever the registry holds NOW, not over the copy this dispatch read.
          (swap-registry! telemetry/*telemetry-handlers*
            (fn (m) (fold telemetry-without-id m failed))))))))

;; ---- the listener process ---------------------------------------------------

(defn- telemetry-listen
  ()
  "The listener loop: dispatch emits, answer a sync ping, stop on :stop. Tail-recursive
(O(1) stack). A throwing handler is caught in `telemetry--dispatch`; an uncatchable
handler fault kills only this process."
  (receive
    ([:emit event measurements metadata] (do
                                           (telemetry-run-handlers event measurements metadata)
                                           (telemetry-listen)))
    ([:ping from r] (do (send from [:telemetry-pong r]) (telemetry-listen)))
    (:stop nil)))

;; ---- lifecycle --------------------------------------------------------------

(defn start-telemetry ()
  "Spawn the telemetry listener, register it as `:telemetry`, and return its pid. Call
once at startup. Supervise the returned pid (e.g. as a `:permanent` child) so it
restarts on an uncatchable handler fault — the handler table is a separate global, so
handlers survive the restart. A second call replaces the registration with a fresh
listener."
  (let (pid (spawn (telemetry-listen)))
    (register :telemetry pid)
    pid))

(defn telemetry-pid ()
  "The listener pid, or nil if telemetry isn't started."
  (whereis :telemetry))

(defn stop-telemetry ()
  "Stop the listener if running. Returns nil. (Handlers stay registered in the global;
a later `start-telemetry` reuses them.)"
  (let (pid (telemetry-pid)) (when pid (send pid :stop)) nil))

(defn telemetry-sync ()
  "Block until the listener has processed every emit queued before this call (a FIFO
round-trip), or 2s. For ordering in tests and for flushing before shutdown. Safe: it
times out rather than hanging if the listener is down, and never runs handler code in
the caller."
  (let (pid (telemetry-pid))
    (if pid
      (let (r (ref))
        (send pid [:ping (self) r])
        (receive ([:telemetry-pong ^r] :ok) (after 2000 :timeout)))
      :no-listener)))

;; ---- emitting (fire-and-forget — never touches the caller beyond a send) -----

(defn emit (event &optional measurements metadata)
  "Emit `event` with a measurements map and a metadata map (both default `{}`). The
event is `send`-ed to the listener and handlers run THERE — so this never blocks the
caller and no handler can crash or hang it. Returns nil; a cheap no-op if telemetry
isn't started."
  (let (pid (telemetry-pid))
    (when pid (send pid [:emit event (or measurements {}) (or metadata {})]))
    nil))

;; ---- handlers (configuration-time; data ops only, never run handler code) -----

(defn attach (id event handler)
  "Attach `handler` — a fn of `(event measurements metadata)` — to `event` under the
globally-unique `id` (any value; re-attaching the same id replaces it). Returns `id`.
Configuration-time: call at startup, not concurrently from many processes (the table
is a `def`-rebound global). The handler runs in the listener process, so keep it
fast — `forward` heavy work to a process you own."
  ;; Strip any earlier handler with this id from EVERY bucket, then cons onto this
  ;; event's — one transform, so a concurrent attach cannot land between the two halves.
  (swap-registry! telemetry/*telemetry-handlers*
    (fn (m)
      (let (cleaned (telemetry-without-id m id))
        (assoc cleaned event (cons {:id id :fn handler} (get cleaned event nil))))))
  id)

(defn detach (id)
  "Remove the handler attached under `id`. Returns nil; no-op if no such id."
  (swap-registry! telemetry/*telemetry-handlers* (fn (m) (telemetry-without-id m id)))
  nil)

(defn detach-all ()
  "Remove every handler (resets the table). Returns nil."
  (def *telemetry-handlers* {})
  nil)

(defn forward (id event pid)
  "Attach a handler under `id` that forwards each emit of `event` to `pid` as
`[:telemetry event measurements metadata]`. The opt-in way to run heavy/blocking
handler logic in a process you own, off even the listener. Returns `id`."
  (attach id event (fn (e m md) (send pid [:telemetry e m md]))))

(defn handlers ()
  "The handler table as a map of event → list of `{:id :fn}` (introspection)."
  *telemetry-handlers*)

;; ---- declared events (defevent) — events as data with a checked schema -------
;; Erlang `:telemetry` events are bare atoms with no declared shape: a handler and the
;; emitter agree on the measurement/metadata keys by convention only. `defevent` declares
;; that shape ONCE — and, crucially, gets it CHECKED. The trick (same one `defrecord` uses
;; for field types, ADR-130) is to reuse the `sig` seam: `defevent` generates a *typed
;; emitter function* whose signature carries the measurement + metadata types, so calling
;; the emitter is an ordinary typed call the advisory checker validates — no new checker
;; machinery. The schema is also registered for introspection (`event-schema`) and optional
;; runtime presence-checking (`*telemetry-validate*`), and raw `emit` still works for
;; undeclared events.

(def *telemetry-events* {})

(defn- telemetry-spec-name
  (spec)
  "The field name of a `(name type)` / bare-`name` schema spec."
  (if (pair? spec) (first spec) spec))
(defn- telemetry-spec-type
  (spec)
  "The declared type of a schema spec, or `any` when it's a bare name."
  (if (pair? spec) (second spec) 'any))
(defn- telemetry-opt
  (opts key)
  "Look up `key` in a `:k v :k v …` option list (nil if absent)."
  (cond
    (empty? opts) nil
    (= (first opts) key) (second opts)
    else (telemetry-opt (rest (rest opts)) key)))

(defn register-event (event schema)
  "Register `schema` (`{:name :measurements :metadata :doc}`) for telemetry `event` — the
introspection + runtime-validation registry `defevent` populates. Returns `event`."
  (swap-registry! telemetry/*telemetry-events* (fn (m) (assoc m event schema)))
  event)

(defn event-schema (event)
  "The declared schema for `event` (from `defevent`), or nil if undeclared."
  (get *telemetry-events* event))
(defn telemetry-events ()
  "The declared-event registry: `event → {:name :measurements :metadata :doc}`."
  *telemetry-events*)

(defmacro defevent (fname event & opts)
  "Declare telemetry `event` (the value passed to `emit`/`attach`) with a typed schema, and
define a typed EMITTER function `name` the checker validates. `opts`:
`:measurements ((field type) …)` and `:metadata ((field type) …)` (each field a bare symbol
= `any`, or `(symbol type)`), plus an optional `:doc`. Expands to a schema registration
(`*telemetry-events*`, for `event-schema` + `*telemetry-validate*`), a `(sig name …)`, and
`(defn name (m-fields… md-fields…) (emit event {measurements} {metadata}))`. So
`(request-stop 42 \"/\" 200)` is checked like any typed call — 'events as data with a
declared schema', delivered through the `sig` seam (the same trick `defrecord` uses for
field types). Raw `(emit event …)` still works; enable `*telemetry-validate*` for a
runtime presence-check of a declared event.

    (defevent request-stop [:http :request :stop]
      :measurements ((duration int))
      :metadata ((path string) (status int)))
    (request-stop 42 \"/index\" 200)   ; typed; a wrong arg type is a checker warning"
  (let (meas (telemetry-opt opts :measurements)
        meta (telemetry-opt opts :metadata)
        doc (telemetry-opt opts :doc)
        m-names (map telemetry-spec-name meas)
        md-names (map telemetry-spec-name meta)
        m-kws (map (fn (n) (keyword (name n))) m-names)
        md-kws (map (fn (n) (keyword (name n))) md-names)
        all-names (append m-names md-names)
        all-types (append (map telemetry-spec-type meas) (map telemetry-spec-type meta))
        ;; the emitter's measurement/metadata map bodies — `{:field field}` with the field
        ;; symbols as values (spliced as a literal, exactly like defrecord's ctor body, so
        ;; the values evaluate as the params).
        meas-map (zipmap m-kws m-names)
        meta-map (zipmap md-kws md-names)
        ;; the schema stored for introspection / runtime checks (types kept unevaluated).
        schema {:name (list 'quote fname)
                :measurements (zipmap m-kws
                                (map (fn (s) (list 'quote (telemetry-spec-type s))) meas))
                :metadata (zipmap md-kws (map (fn (s) (list 'quote (telemetry-spec-type s))) meta))
                :doc doc})
    `(do
       (register-event ~event ~schema)
       (sig ~fname (~@all-types -> any))
       (defn ~fname (~@all-names) (emit ~event ~meas-map ~meta-map))
       nil)))

;; ---- optional runtime presence-check of a declared event --------------------
;; The checker is the primary guard (via the typed emitter above); this is a cheap
;; secondary net for the RAW `emit` path, off by default. It runs in the LISTENER (never
;; the emitter), checks only key PRESENCE (types are the checker's job), and warns to
;; stderr — it never blocks dispatch. A `def`-global (not a `binding`) because the listener
;; is a separate process: like `*telemetry-handlers*`, it's read THERE, so enabling it must
;; be visible across processes — set it with `(def *telemetry-validate* true)`.
(def *telemetry-validate* false)

(defn telemetry-validate! (on)
  "Enable (`true`) or disable runtime schema presence-checking of declared events. Off by
default. Must be a function (not a bare `def` from your module) so the rebind lands on
telemetry's own global, which the listener process reads. Returns `on`."
  (def *telemetry-validate* on)
  on)

(defn- telemetry-missing-keys
  (schema-map actual)
  "The declared keys of `schema-map` absent from `actual`."
  (filter (fn (k) (not (contains? actual k))) (keys schema-map)))
(defn- telemetry-check-event
  (event measurements metadata)
  "The declared keys missing from a declared event's payload, as `[kind key]` pairs
(`kind` = `:measurements` / `:metadata`); empty when `event` is undeclared or complete.
Pure — the listener turns each pair into a stderr warning. Types are the checker's job."
  (let (schema (get *telemetry-events* event))
    (if (nil? schema)
      nil
      (append (map (fn (k) [:measurements k])
                (telemetry-missing-keys (get schema :measurements) measurements))
        (map (fn (k) [:metadata k]) (telemetry-missing-keys (get schema :metadata) metadata))))))

;; ---- the runtime event stream (kernel sources → telemetry) -------------------
;; Policy over the `system-monitor` kernel seam: a watcher process subscribes to
;; the runtime's own events (GC collections, spawns, exits, JIT deopts) and
;; re-emits each as an ordinary telemetry event — so operators observe the
;; RUNTIME through the exact same attach/handler seam as their app's events, and
;; `nest observe`-style tools consume one stream, not N snapshot builtins.

(defn- telemetry-runtime-event
  (kind pid detail)
  "Map one `[:system …]` kernel event onto a telemetry emit: event
`[:runtime kind]`, measurements = the numeric payload, metadata = the ids."
  (match kind
    (:gc (emit [:runtime :gc] detail {:pid pid}))
    (:spawn (emit [:runtime :spawn] {} {:pid pid :parent detail}))
    (:exit (emit [:runtime :exit] {} {:pid pid :reason detail}))
    (:deopt (emit [:runtime :deopt] {} {:pid pid :fn detail}))
    (_ (emit [:runtime kind] {} {:pid pid :detail detail}))))

(defn- telemetry-runtime-loop
  ()
  "The watcher loop: re-emit each kernel event; stop (and disarm) on `:stop`."
  (receive
    ([:system kind pid detail] (do
                                 (telemetry-runtime-event kind pid detail)
                                 (telemetry-runtime-loop)))
    (:stop (do (system-monitor nil) nil))))

(defn watch-runtime (&optional opts)
  "Arm the kernel system monitor and re-emit its events as telemetry events —
`[:runtime :gc]` (measurements `{:pause-us :collections :live}`),
`[:runtime :spawn]`, `[:runtime :exit]`, `[:runtime :deopt]` (each with the pids
in the metadata). `opts` is passed through to `system-monitor` (nil = every
event; e.g. `{:gc true :gc-min-pause-us 1000}` = only long GCs). Returns the
watcher pid; `stop-watch-runtime` (or killing the watcher) disarms the kernel
stream. One system monitor exists at a time — a second call replaces the first."
  (let (watcher (spawn (telemetry-runtime-loop)))
    (if opts (system-monitor watcher opts) (system-monitor watcher))
    watcher))

(defn stop-watch-runtime (watcher)
  "Stop a `watch-runtime` watcher and disarm the kernel stream. Returns nil."
  (send watcher :stop)
  nil)

;; ---- distribution liveness (node up/down) → the telemetry stream ------------
;; The kernel has no `[:nodeup]` event — `monitor-node` fires only `[:nodedown]`,
;; and reconnect synthesizes `[:nodeup]` per spec — so a general watcher can't be
;; purely event-driven. `watch-nodes` polls `(nodes)` and diffs consecutive peer
;; sets, re-emitting each change through the SAME `[:runtime kind]` seam as
;; `watch-runtime`: `[:runtime :nodeup]` / `[:runtime :nodedown]` with `{:node name}`
;; metadata. Polling (coarse, second-scale) suits node liveness — rare operational
;; events — and catches BOTH inbound peers and outbound `connect`s, which a
;; per-spec `monitor-node` alone would miss.

(defn- telemetry-member?
  (ys x)
  "Whether list `ys` contains `x` (by `=`)."
  (cond
    (empty? ys) false
    (= (first ys) x) true
    else (telemetry-member? (rest ys) x)))

(defn- telemetry-absent
  (xs ys)
  "The elements of list `xs` not present in list `ys`."
  (filter (fn (x) (not (telemetry-member? ys x))) xs))

(defn- telemetry-nodes-loop
  (known interval)
  "Poll `(nodes)` every `interval` ms, emit a `[:runtime :nodeup]`/`[:runtime
:nodedown]` telemetry event per added/removed peer, and recur; stop on `:stop`."
  (receive
    (:stop nil)
    (after interval
      (let (current (or (nodes) (list)))
        (dolist (n (telemetry-absent current known))
          (emit [:runtime :nodeup] {} {:node n}))
        (dolist (n (telemetry-absent known current))
          (emit [:runtime :nodedown] {} {:node n}))
        (telemetry-nodes-loop current interval)))))

(defn watch-nodes (&optional interval-ms)
  "Watch cluster membership and re-emit changes as telemetry: a peer appearing in
`(nodes)` emits `[:runtime :nodeup]` `{:node name}`, one disappearing emits
`[:runtime :nodedown]` — folding distribution liveness into the same attach stream
as `watch-runtime`. `interval-ms` is the poll period (default 1000). Returns the
watcher pid; `stop-watch-nodes` (or killing it) ends it. The peers already connected
at start are the baseline (no spurious `:nodeup` for them)."
  (let (interval (or interval-ms 1000))
    (spawn (telemetry-nodes-loop (or (nodes) (list)) interval))))

(defn stop-watch-nodes (watcher)
  "Stop a `watch-nodes` watcher. Returns nil."
  (send watcher :stop)
  nil)

;; ---- unified runtime vitals (the snapshot builtins, behind one stream) -------
;; The kernel exposes its runtime state through several point-in-time snapshot builtins —
;; `gc-stats`, `sched-stats`, `vm-stats`, `process-info` — that tools scrape individually
;; (`nest observe`, `nest mcp`). `runtime-snapshot` folds them into ONE map, and
;; `watch-vitals` samples that onto the telemetry stream as `[:runtime :vitals]` events, so
;; a consumer subscribes ONCE to the attach seam instead of polling N builtins — the same
;; unification `watch-runtime` does for the kernel event stream. The dev-tools-only
;; snapshot builtins (`gc-stats`/`vm-stats`) are read only when bound, so this degrades
;; cleanly on a lean runtime (those keys are just nil).

(defn- telemetry-stat
  (sym thunk)
  "Call `thunk` (a 0-arg snapshot reader) when `sym` is bound, else nil — so a lean build
without the dev-tools stat builtins doesn't error."
  (when (bound? sym) (thunk)))

(defn runtime-snapshot ()
  "A single point-in-time map of the runtime's vitals, pulled from the kernel snapshot
builtins behind one call: `{:gc :sched :vm :processes :metrics}` (the dev-tools-only
`:gc`/`:vm` are nil on a lean runtime). The one-call, stream-folded replacement for
scraping the individual stat builtins — what `nest observe` / `nest mcp` can read."
  {:gc (telemetry-stat 'gc-stats (fn () (gc-stats)))
   :sched (telemetry-stat 'sched-stats (fn () (sched-stats)))
   :vm (telemetry-stat 'vm-stats (fn () (vm-stats)))
   :processes (count (or (list-processes) []))
   :metrics (metrics-snapshot)})

(defn- telemetry-vitals-measurements
  (snap)
  "Flatten a `runtime-snapshot` into a numeric measurements map for a `[:runtime :vitals]`
telemetry event (gauges): live process count, GC collections / max pause / live bytes, and
the scheduler's spawn/preempt/steal counters. Absent (lean-build) stats read as 0."
  (let (gc (or (get snap :gc) {})
        sched (or (get snap :sched) {}))
    {:processes (get snap :processes 0)
     :gc-collections (get gc :collections 0)
     :gc-pause-max-us (get gc :pause-max-us 0)
     :live-bytes (get gc :live-bytes 0)
     :spawned (get sched :spawned 0)
     :preempts (get sched :preempts 0)
     :steals (get sched :steals 0)}))

(defn- telemetry-vitals-loop
  (interval)
  (receive
    (:stop nil)
    (after interval
      (do
        (emit [:runtime :vitals] (telemetry-vitals-measurements (runtime-snapshot)) {})
        (telemetry-vitals-loop interval)))))

(defn watch-vitals (&optional interval-ms)
  "Periodically sample the runtime vitals (`runtime-snapshot`) and emit them onto the
telemetry stream as `[:runtime :vitals]` events (measurements = the numeric gauges),
folding the kernel snapshot builtins behind the same attach seam as `watch-runtime` —
`(last-value :procs [:runtime :vitals] :processes)` turns a vital into a gauge, or
`forward` the stream to your own process. `interval-ms` is the sample period (default
1000). Returns the watcher pid; `stop-watch-vitals` (or killing it) ends it."
  (let (interval (or interval-ms 1000))
    (spawn (telemetry-vitals-loop interval))))

(defn stop-watch-vitals (watcher)
  "Stop a `watch-vitals` watcher. Returns nil."
  (send watcher :stop)
  nil)

;; ---- remote tier: subscribe to a peer node's telemetry stream (ADR-053) ------
;; Location-transparency for the attach seam: a runtime opts in with `telemetry-serve`
;; (an agent registered as `:telemetry-remote`, like the observer's `:observe`), and a
;; peer `subscribe-remote`s a chosen event. The target attaches a forwarding handler that
;; `send`s each matching emit to the subscriber (routing over the node link — a `send` to
;; a remote pid is transparent), and the subscriber re-emits it into ITS OWN telemetry
;; stream, so local handlers/aggregators consume a peer's events with no new wire format.
;; The dist `send` is the only cross-node mechanism; everything else is ordinary policy.

(defn- telemetry-serve-loop
  (subs)
  "The target-side agent loop: on `[:subscribe event subscriber ref]` attach a forwarder
that ships each emit of `event` to `subscriber`, tagged with `ref`; on `[:unsubscribe ref]`
detach it. `subs` tracks the attached ids so a `:stop` cleans them all up."
  (receive
    ([:subscribe event subscriber ref] (let (id [:remote ref])
                                         (attach id
                                           event
                                           (fn (e m md)
                                             (send subscriber [:remote-telemetry ref e m md])))
                                         (send subscriber [:subscribed ref])
                                         (telemetry-serve-loop (cons id subs))))
    ([:unsubscribe ref] (detach [:remote ref])
      (telemetry-serve-loop (filter (fn (id) (not (= id [:remote ref]))) subs)))
    (:stop (do (doseq (id subs) (detach id)) nil))
    (_ (telemetry-serve-loop subs))))

(defn telemetry-serve ()
  "Make THIS runtime's telemetry stream subscribable from a peer node: spawn an agent and
register it `:telemetry-remote`, so a remote `subscribe-remote` can stream a chosen event's
emits over the node link. Requires `(node-start name addr cookie)` first — opt-in, like
`observe-serve` (a program isn't observable unless it opens itself up). Returns the agent
pid; `stop-telemetry-serve` (or killing it) tears down every remote subscription."
  (if (= (node-name) :nonode)
    (error "telemetry-serve: call (node-start name addr cookie) first")
    (let (agent (spawn (telemetry-serve-loop nil)))
      (register :telemetry-remote agent)
      agent)))

(defn stop-telemetry-serve (agent)
  "Stop a `telemetry-serve` agent and detach every remote-subscription forwarder. Returns nil."
  (send agent :stop)
  nil)

(defn- telemetry-remote-loop
  (target event ref local-event)
  "The subscriber-side loop: re-emit each `[:remote-telemetry ref …]` from the target into
THIS runtime's stream as `local-event` (with `{:remote-event e}` merged into the metadata);
`:stop` unsubscribes from the target and exits."
  (receive
    ([:remote-telemetry ^ref e m md] (emit local-event m (assoc md :remote-event e))
      (telemetry-remote-loop target event ref local-event))
    (:stop (do (send target [:unsubscribe ref]) nil))
    (_ (telemetry-remote-loop target event ref local-event))))

(defn- telemetry-subscribe-to
  (target event local-event)
  "Spawn a subscriber watcher that subscribes to `event` at `target` (a pid or a
`{:name :node}` address) and re-emits into the local stream as `local-event`. The seam
`subscribe-remote` builds the node address over; split out so the message protocol is
testable without a live node. Returns the watcher pid."
  (let (r (ref)
        watcher (spawn (telemetry-remote-loop target event r local-event)))
    (send target [:subscribe event watcher r])
    watcher))

(defn subscribe-remote (peer event &optional local-event)
  "Subscribe to `event` on peer node `peer` (a node name); each remote emit is re-emitted
into THIS runtime's telemetry stream as `local-event` (default `[:remote event]`), with
`{:remote-event event}` in the metadata — so local handlers/aggregators consume a peer's
events through the same attach seam (location-transparent). The peer must have called
`(telemetry-serve)`. Returns the watcher pid; `stop-subscribe-remote` (or killing it)
unsubscribes and exits."
  (telemetry-subscribe-to {:name :telemetry-remote :node peer}
    event
    (or local-event [:remote event])))

(defn stop-subscribe-remote (watcher)
  "Stop a `subscribe-remote` watcher: unsubscribe from the peer and exit. Returns nil."
  (send watcher :stop)
  nil)

;; ---- span -------------------------------------------------------------------

(defn- telemetry-sub
  (event seg)
  "Append lifecycle segment `seg` to a base event: a vector gets it appended
(`[:http :req]` → `[:http :req :stop]`); any other value is wrapped (`[event seg]`)."
  (if (vector? event) (into event [seg]) [event seg]))

(defn- telemetry-span
  (event metadata thunk)
  (let (metadata (or metadata {})
        t0 (now))
    (emit (telemetry-sub event :start) {:system-time t0} metadata)
    (try
      (let (result (thunk))
        (emit (telemetry-sub event :stop) {:duration (- (now) t0)} metadata)
        result)
      (catch e
        (emit (telemetry-sub event :exception)
          {:duration (- (now) t0)}
          (assoc metadata :error (error-message e)))
        (throw e)))))

(defmacro span (event metadata & body)
  "Time `body` as a telemetry span around `event` (a vector base, Erlang-style):
emits `event`++`[:start]` before, `event`++`[:stop]` with `{:duration ms}` after a
normal return, or `event`++`[:exception]` with `{:duration ms}` and the error in the
metadata on a throw (then re-raises). `metadata` is a map shared by all three events.
The events are emitted async (fire-and-forget); the timing measures `body` running in
the caller. Returns `body`'s value."
  `(telemetry-span ~event ~metadata (fn () ~@body)))

;; ---- metric aggregators (Elixir Telemetry.Metrics, folded in Brood) ----------
;; An aggregator is just an `attach` of a folding handler — ADR-106 anticipated
;; exactly this ("a handler that folds events into running stats"). Because every
;; handler runs SERIALLY in the one listener process, a plain read-modify-write on
;; a shared `table` (ADR-107) is race-free here, so we keep float-safe RUNNING
;; aggregates (count/sum/sum-of-squares/min/max) rather than storing samples — the
;; metric state is bounded no matter how many events fire. Readers
;; (`metric`/`metrics-snapshot`) run in another process but read the table
;; atomically. State survives a listener restart (it lives in the table + the
;; `def`-global handle, not listener memory), matching ADR-106's stateless-listener
;; design.

(def *telemetry-metrics* nil)

(defn- telemetry-metrics
  ()
  "The shared metrics table, created on first use (configuration-time, so the lazy
init is single-threaded)."
  (when (nil? *telemetry-metrics*) (def *telemetry-metrics* (table)))
  *telemetry-metrics*)

(defn reset-metrics ()
  "Drop every aggregated metric (fresh table). Does NOT detach the handlers — call
`detach`/`detach-all` for that. Returns nil."
  (def *telemetry-metrics* (table))
  nil)

(defn counter (id event)
  "Count each emit of `event` under metric `id`. `(metric id)` → `{:kind :counter
:count n}`. Returns `id`."
  (let (t (telemetry-metrics))
    (attach id
      event
      (fn (e m md)
        (let (cur (table-get t id {:kind :counter :count 0}))
          (table-put t id (assoc cur :count (+ (get cur :count) 1))))))))

(defn sum (id event key)
  "Sum measurement `key` across each emit of `event` under metric `id`. Float-safe.
`(metric id)` → `{:kind :sum :sum s}`. Returns `id`."
  (let (t (telemetry-metrics))
    (attach id
      event
      (fn (e m md)
        (let (v (get m key 0) cur (table-get t id {:kind :sum :sum 0}))
          (table-put t id (assoc cur :sum (+ (get cur :sum) v))))))))

(defn last-value (id event key)
  "Track the latest value of measurement `key` (a gauge) under metric `id`.
`(metric id)` → `{:kind :gauge :value v}`. Returns `id`."
  (let (t (telemetry-metrics))
    (attach id
      event
      (fn (e m md)
        (table-put t id {:kind :gauge :value (get m key)})))))

(defn summary (id event key)
  "Accumulate running statistics of measurement `key` under metric `id` — a bounded
5-number fold (count/sum/sum-of-squares/min/max), no samples retained. `(metric id)`
→ `{:kind :summary :count :sum :min :max :mean :stddev}` (mean/stddev derived on
read). Returns `id`."
  (let (t (telemetry-metrics))
    (attach id
      event
      (fn (e m md)
        (let (v (get m key)
              cur (table-get t id nil))
          (if (nil? cur)
            (table-put t id {:kind :summary :count 1 :sum v :sumsq (* v v) :min v :max v})
            (table-put t
              id
              (assoc cur
                :count (+ (get cur :count) 1)
                :sum (+ (get cur :sum) v)
                :sumsq (+ (get cur :sumsq) (* v v))
                :min (min (get cur :min) v)
                :max (max (get cur :max) v)))))))))

;; ---- distribution / histogram (bucketed, bounded) ---------------------------
;; The percentile-capable aggregator ADR-106 anticipated. Like `summary` it keeps
;; only running aggregates — here per-bucket counts against explicit upper bounds
;; (Prometheus / Elixir-`Telemetry.Metrics`-`distribution` shape) — so state stays
;; bounded no matter how many events fire (no samples retained). Percentiles are
;; ESTIMATED from the buckets by linear interpolation (`metric-percentile`), the
;; standard `histogram_quantile` trade: bounded memory for approximate quantiles.
;; Assumes non-negative measurements (durations, sizes) — the histogram domain.

(defn- telemetry-bucket-index
  (bounds v i)
  "Index of the first bound ≥ `v` (scanning from `i`), or `(count bounds)` — the
overflow bucket — when `v` exceeds every bound. `bounds` is ascending."
  (if (>= i (count bounds))
    i
    (if (<= v (nth bounds i)) i (telemetry-bucket-index bounds v (+ i 1)))))

(defn distribution (id event key buckets)
  "Bucket measurement `key` of `event` into a histogram under metric `id`. `buckets`
is a vector of ascending upper bounds (e.g. `[10 50 100 500]`); a value goes into the
first bound ≥ it, or an overflow bucket above the last. Bounded (per-bucket counts,
no samples). `(metric id)` → `{:kind :distribution :count :sum :min :max :mean
:buckets [{:le b :count c}… {:le :inf :count c}]}`; estimate quantiles with
`metric-percentile`. Returns `id`."
  (let (t (telemetry-metrics)
        bounds (into [] (sort buckets)))
    (attach id
      event
      (fn (e m md)
        (let (v (get m key)
              cur (table-get t id nil)
              cur (if (nil? cur)
                    {:kind :distribution
                     :bounds bounds
                     :counts {}
                     :count 0
                     :sum 0
                     :min v
                     :max v}
                    cur)
              counts (get cur :counts)
              idx (telemetry-bucket-index (get cur :bounds) v 0))
          (table-put t
            id
            (assoc cur
              :counts (assoc counts idx (+ (get counts idx 0) 1))
              :count (+ (get cur :count) 1)
              :sum (+ (get cur :sum) v)
              :min (min (get cur :min) v)
              :max (max (get cur :max) v))))))))

(defn- telemetry-dist-buckets
  (bounds counts i acc)
  "Build the presented `:buckets` vector: one `{:le bound :count n}` per bound, then
a final `{:le :inf :count n}` for the overflow bucket."
  (if (>= i (count bounds))
    (into [] (reverse (cons {:le :inf :count (get counts i 0)} acc)))
    (telemetry-dist-buckets bounds
      counts
      (+ i 1)
      (cons {:le (nth bounds i) :count (get counts i 0)} acc))))

(defn- telemetry-present
  (state)
  "Turn a raw metric accumulator into its reader shape: a `:summary` gets `:mean`
and `:stddev` derived and its internal `:sumsq` dropped; a `:distribution` gets its
per-bucket `:buckets` and `:mean` presented (internal `:bounds`/`:counts` dropped);
others pass through."
  (let (kind (get state :kind))
    (cond
      (= kind :summary)
        (let (n (get state :count)
              s (get state :sum)
              mean (/ s n)
              var (- (/ (get state :sumsq) n) (* mean mean)))
          {:kind :summary
           :count n
           :sum s
           :min (get state :min)
           :max (get state :max)
           :mean mean
           :stddev (sqrt (if (< var 0) 0 var))})
      (= kind :distribution)
        (let (n (get state :count))
          {:kind :distribution
           :count n
           :sum (get state :sum)
           :min (get state :min)
           :max (get state :max)
           :mean (if (> n 0) (/ (get state :sum) n) 0)
           :buckets (telemetry-dist-buckets (get state :bounds)
                      (get state :counts)
                      0
                      nil)})
      else state)))

(defn metric (id)
  "The current value of metric `id` as a map (with `:summary`'s `:mean`/`:stddev`
derived), or nil if no such metric has recorded anything yet."
  (let (state (table-get (telemetry-metrics) id nil))
    (when state (telemetry-present state))))

(defn metrics-snapshot ()
  "A point-in-time map of every metric `id` → its reader value (see `metric`).
Atomic; safe to poll from any process (this is the stream-folded replacement for
scraping N snapshot builtins). Empty map if no metrics recorded."
  (let (snap (table-snapshot (telemetry-metrics)))
    (reduce-kv (fn (acc id state) (assoc acc id (telemetry-present state))) {} snap)))

(defn- telemetry-quantile
  (bounds counts nb rank i prev-cum prev-bound maxv)
  "Walk the cumulative bucket counts for the bucket the `rank`-th observation falls
in, then linearly interpolate within `[prev-bound, upper]`. The overflow bucket
(`i = nb`) can't interpolate above its (unbounded) top, so it reports `maxv`."
  (let (c (get counts i 0)
        cum (+ prev-cum c))
    (if (or (>= cum rank) (>= i nb))
      (if (>= i nb)
        maxv
        (let (up (nth bounds i))
          (if (<= c 0)
            up
            (+ prev-bound (* (- up prev-bound) (/ (- rank prev-cum) c))))))
      (telemetry-quantile bounds counts nb rank (+ i 1) cum (nth bounds i) maxv))))

(defn metric-percentile (id p)
  "Estimate the `p`-th percentile (`p` in 0..1) of `distribution` metric `id` from its
bucketed counts — linear interpolation within the containing bucket, the standard
`histogram_quantile` estimate (approximate; precision is the bucket granularity).
Returns nil unless `id` is a `distribution` with at least one observation."
  (let (state (table-get (telemetry-metrics) id nil))
    (when (and state
            (= (get state :kind) :distribution)
            (> (get state :count) 0))
      (let (bounds (get state :bounds)
            counts (get state :counts))
        (telemetry-quantile bounds
          counts
          (count bounds)
          (* p (get state :count))
          0
          0
          0
          (get state :max))))))

(defn sample-every (id n handler)
  "Wrap `handler` so it runs on every `n`th matching event (1-in-`n` sampling) —
folds only a fraction of a hot event. Deterministic (an atomic counter under `id`,
not a PRNG), so it never loses count. Compose with an aggregator's handler, or any
attach handler. Returns the wrapped handler."
  (let (t (telemetry-metrics) k [id :sample-seen])
    (fn (e m md) (when (= 0 (rem (table-incr t k 1) n)) (handler e m md)))))
