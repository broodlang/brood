(defmodule datetime
  "Date and time utilities. **Every value is UTC**; the epoch is Unix time
(1970-01-01T00:00:00Z).

Datetimes, dates, and times are plain maps:
  datetime  {:year Y :month M :day D :hour H :minute Min :second S :ms Ms}
  date      {:year Y :month M :day D}
  time-of-day  {:hour H :minute Min :second S :ms Ms}

**Timezones.** There is no zone *type* and no zone database: a value never carries a zone,
so there is no way to represent \"09:00 in Berlin\" as such, and none of the questions that
need a database — when does this zone shift, what is the local time there now — can be asked
here. What IS supported is the boundary case that matters in practice: `parse-iso8601` reads
a numeric offset (`+02:00`, `-05:30`, `+0200`, `+02`) and applies it, so a timestamp from an
API becomes the UTC instant it denotes. Rendering is always UTC (`->iso` emits `Z`). If you
need civil time in a named zone, keep the zone alongside the value and convert at the edges.

**Ordering** is the `compare-to` multimethod, so `<`, `<=`, `>`, `>=`, `sort` and `compare`
work on these values directly — same type only, since a date and a datetime are not two
spellings of one instant.")

;; ---- internal helpers -------------------------------------------------------

(defn- dt-fdiv (a b)
  ;; Integer division toward negative infinity (floor division).
  (let (q (math/quot a b) r (math/rem a b))
    (if (< r 0) (- q 1) q)))
(sig dt-fdiv (int int -> int))

;; check-allow: deliberately non-tail — depth = the pad width — single digits.
(check-allow :non-tail-recursion
  (defn- dt-zero-pad (n width)
    ;; Render n as a decimal string of at least `width` digits. Handles negative n.
    (if (< n 0)
      (str "-" (dt-zero-pad (- n) (- width 1)))
      (let (s (str n)
            pad (- width (string/length s)))
        (if (> pad 0) (str (string/repeat "0" pad) s) s)))))
(sig dt-zero-pad (int int -> string))

;; ---- Gregorian <-> days-since-Unix-epoch ------------------------------------
;; Howard Hinnant's civil_from_days / days_from_civil algorithms.
;; Reference: https://howardhinnant.github.io/date_algorithms.html

(defn- dt-days->ymd (z)
  ;; Days since 1970-01-01 → {:year :month :day}
  (let (z (+ z 719468)
        era (dt-fdiv z 146097)
        doe (- z (* era 146097))
        yoe (dt-fdiv (+ (- doe (dt-fdiv doe 1460)) (- (dt-fdiv doe 36524) (dt-fdiv doe 146096)))
              365)
        y (+ yoe (* era 400))
        doy (- doe (+ (- (* 365 yoe) (dt-fdiv yoe 100)) (dt-fdiv yoe 4)))
        mp (dt-fdiv (+ (* 5 doy) 2) 153)
        d (+ (- doy (dt-fdiv (+ (* 153 mp) 2) 5)) 1)
        m (if (< mp 10) (+ mp 3) (- mp 9))
        y (if (<= m 2) (+ y 1) y))
    {:year y :month m :day d}))
(sig dt-days->ymd (int -> map))

(defn- dt-ymd->days (year month day)
  ;; Date → days since 1970-01-01
  (let (y (if (<= month 2) (- year 1) year)
        era (dt-fdiv y 400)
        yoe (- y (* era 400))
        m+ (if (> month 2) (- month 3) (+ month 9))
        doy (+ (dt-fdiv (+ (* 153 m+) 2) 5) (- day 1))
        doe (+ (* yoe 365)
              (- (dt-fdiv yoe 4) (dt-fdiv yoe 100))
              doy))
    (- (+ (* era 146097) doe) 719468)))
(sig dt-ymd->days (int int int -> int))

;; ---- the three temporal types ------------------------------------------------
;;
;; Each is a RECORD, so the three are genuinely distinct types rather than three plain
;; maps told apart by which keys they carry. That buys real predicates (`datetime?` /
;; `date?` / `time-of-day?` — a date is not "a datetime missing its time"), a per-type
;; display form (an ISO string, not `{:year 2026, :month 7, …}`), and dispatch: the
;; `Temporal` ability below renders any of them, and a fourth temporal type from
;; elsewhere (a zoned datetime, a fiscal quarter) can join by impl'ing it.

(defrecord datetime
  ((year int) (month int) (day int) (hour int) (minute int) (second int) (ms int)))
(defrecord date ((year int) (month int) (day int)))
(defrecord time-of-day ((hour int) (minute int) (second int) (ms int)))

;; The three type predicates are BARE, in the prelude beside `queue?`/`pq?`/`multimap?`
;; (ADR-236 carve-out 2): a value's type should read the same way whatever its type, rather
;; than doubling as `datetime?` inside its own module. They are pure record-id
;; checks and need no module loaded, so they cost the prelude nothing.

;; ---- epoch conversion -------------------------------------------------------

(defn epoch-ms-> (ms)
  "Convert Unix epoch milliseconds to a UTC datetime.

    (datetime/format (datetime/epoch-ms-> 0) \"%Y-%m-%d\")   → \"1970-01-01\""
  (let (total-s (dt-fdiv ms 1000)
        ms-part (- ms (* total-s 1000))
        days (dt-fdiv total-s 86400)
        time-s (- total-s (* days 86400))
        hour (dt-fdiv time-s 3600)
        minute (dt-fdiv (math/rem time-s 3600) 60)
        second (math/rem time-s 60)
        ymd (dt-days->ymd days))
    (datetime (get ymd :year) (get ymd :month) (get ymd :day) hour minute second ms-part)))
(sig epoch-ms-> (int -> datetime))

(defn ->epoch-ms (dt)
  "Convert a UTC datetime (or date — its time is taken as midnight) to Unix epoch
milliseconds."
  (let (days (dt-ymd->days (get dt :year) (get dt :month) (get dt :day))
        ;; Through the declared accessors: a `date` has no time fields (midnight), and a
        ;; record NAME is an open shape (ADR-264), so `(get date :hour 0)` reads as unknown
        ;; where `(hour date)` is declared `int`.
        time-s (+ (* (hour dt) 3600) (* (minute dt) 60) (second dt))
        ms-val (ms dt))
    (+ (* (+ (* days 86400) time-s) 1000) ms-val)))
(sig ->epoch-ms ((or datetime date) -> int))

;; ---- current time -----------------------------------------------------------

(defn utc-now ()
  "The current UTC datetime."
  (epoch-ms-> (os/now)))

(defn today ()
  "The current UTC date."
  (->date (utc-now)))

;; ---- accessors --------------------------------------------------------------

(defn year (dt) "The :year field." (get dt :year))
(sig year ((or datetime date) -> int))
(defn month (dt) "The :month field (1–12)." (get dt :month))
(sig month ((or datetime date) -> int))
(defn day (dt) "The :day field (1–31)." (get dt :day))
(sig day ((or datetime date) -> int))
;; The time accessors take a `date` too — its time is midnight, so each reads 0.
(defn hour (dt) "The :hour field (0–23)." (get dt :hour 0))
(sig hour ((or datetime date time-of-day) -> int))
(defn minute (dt) "The :minute field (0–59)." (get dt :minute 0))
(sig minute ((or datetime date time-of-day) -> int))
(defn second (dt) "The :second field (0–59)." (get dt :second 0))
(sig second ((or datetime date time-of-day) -> int))
(defn ms (dt) "The :ms field (0–999)." (get dt :ms 0))
(sig ms ((or datetime date time-of-day) -> int))

;; ---- decomposition ----------------------------------------------------------

(defn ->date (dt)
  "Extract the date portion of a datetime."
  (date (get dt :year) (get dt :month) (get dt :day)))

(defn ->time (dt)
  "Extract the time-of-day portion of a datetime."
  (time-of-day (get dt :hour 0) (get dt :minute 0) (get dt :second 0) (get dt :ms 0)))

(defn date+time (d t)
  "Combine a date and a time-of-day into a datetime."
  (datetime (get d :year)
    (get d :month)
    (get d :day)
    (get t :hour 0)
    (get t :minute 0)
    (get t :second 0)
    (get t :ms 0)))

;; ---- formatting: the Temporal ability ----------------------------------------
;;
;; ISO 8601 rendering is per-type — a date has no time part, a time-of-day no date — so
;; it was three functions (`date->iso8601` / `time->iso8601` / `dt->iso8601`) that callers
;; had to choose between by knowing which shape they held. It is now ONE op, `->iso`,
;; dispatching on the value: `(->iso x)` renders whichever of the three `x` is, and the
;; ability is `:sealed` so `nest check` flags a temporal type that forgets it.

(defability Temporal
  "A calendar value that renders as ISO 8601."
  :sealed [datetime date time-of-day]
  (->iso [self] :-> string))

;; The two halves, shared by the three impls (a datetime is date + \"T\" + time + \"Z\").
(defn- dt-iso-date (d)
  (str (dt-zero-pad (get d :year) 4)
    "-"
    (dt-zero-pad (get d :month) 2)
    "-"
    (dt-zero-pad (get d :day) 2)))

(defn- dt-iso-time (t)
  (str (dt-zero-pad (get t :hour 0) 2)
    ":"
    (dt-zero-pad (get t :minute 0) 2)
    ":"
    (dt-zero-pad (get t :second 0) 2)
    "."
    (dt-zero-pad (get t :ms 0) 3)))

(impl Temporal datetime/date (->iso [d] (dt-iso-date d)))
(impl Temporal datetime/time-of-day (->iso [t] (dt-iso-time t)))
(impl Temporal
  datetime/datetime
  (->iso [dt] (str (dt-iso-date dt) "T" (dt-iso-time dt) "Z")))

;; A temporal value's display form is its ISO string — so `(io/puts (utc-now))` shows
;; `2026-07-28T14:03:11.000Z`, not the field map. `str`/`pr-str` stay native (ADR-171),
;; so the data form is still available for debugging via `pr-str`.
(impl Display datetime/datetime (->string [dt] (->iso dt)))
(impl Display datetime/date (->string [d] (->iso d)))
(impl Display datetime/time-of-day (->string [t] (->iso t)))

(defn- dt-fmt-code (dt code)
  (cond
    (= code "Y") (dt-zero-pad (year dt) 4)
    (= code "m") (dt-zero-pad (month dt) 2)
    (= code "d") (dt-zero-pad (day dt) 2)
    (= code "H") (dt-zero-pad (hour dt) 2)
    (= code "M") (dt-zero-pad (minute dt) 2)
    (= code "S") (dt-zero-pad (second dt) 2)
    (= code "f") (dt-zero-pad (ms dt) 3)
    (= code "%") "%"
    else (str "%" code)))

(defn- dt-fmt-loop (dt fmt i n acc)
  (if (>= i n)
    acc
    (let (c (string/char-at fmt i))
      (if (and (= c "%") (< (+ i 1) n))
        (dt-fmt-loop dt
          fmt
          (+ i 2)
          n
          (str acc (dt-fmt-code dt (string/char-at fmt (+ i 1)))))
        (dt-fmt-loop dt fmt (+ i 1) n (str acc c))))))
(sig dt-fmt-loop (any string int int string -> string))

(defn format (dt fmt)
  "Format `dt` with %-codes: %Y year, %m month (01-12), %d day (01-31),
%H hour (00-23), %M minute (00-59), %S second (00-59), %f ms (000-999), %% literal %.

    (datetime/format (datetime/parse-date \"2026-08-27\") \"%Y/%m/%d\")   → \"2026/08/27\""
  (dt-fmt-loop dt fmt 0 (string/length fmt) ""))
(sig format (any string -> any))

;; ---- parsing ----------------------------------------------------------------

(defn- dt-parse-int (s)
  ;; A missing component (`(nth parts i)` past the end) parses as nothing, like a bad one.
  (when s
    (let (n (string/->number s))
      (if (int? n) n nil))))
(sig dt-parse-int ((or string nil) -> (or int nil)))

(defn- dt-frac->ms (frac)
  ;; Right-pad the fractional-second digits to 3 and parse as milliseconds.
  ;; "" → 0, "5" → 500, "05" → 50, "005" → 5, "123" → 123.
  (let (padded (str frac "000"))
    (or (dt-parse-int (str (string/char-at padded 0)
                        (string/char-at padded 1)
                        (string/char-at padded 2)))
      0)))

;; The parsers used to check *shape* only — three `-`-separated integers, three
;; `:`-separated integers — and hand whatever came out straight to the record
;; constructor, which does no checking either. So "2026-02-31", "2026-13-05",
;; "12:-5:00" and hour 99 all "parsed", producing a value that every later
;; conversion silently NORMALISED (Feb 31 → Mar 3). A parser that accepts an
;; impossible date and quietly moves it is worse than one that rejects it: the
;; caller's validation looks like it passed. The calendar core underneath
;; (`days-in-month`, `leap-year?`) is correct — only the input gate was missing.
(defn- dt-in-range? (n lo hi)
  (and (int? n) (>= n lo) (<= n hi)))

(defn- dt-parse-time-str (s)
  ;; Parse "HH:MM:SS" or "HH:MM:SS.mmm" → a time-of-day, or nil.
  (let (dot-parts (string/split s ".")
        hms-str (first dot-parts)
        frac-str (if (> (count dot-parts) 1) (nth dot-parts 1) "")
        parts (string/split hms-str ":"))
    (when (and (= (count parts) 3)
            (<= (count dot-parts) 2)
            ;; a fractional part must itself be digits — "12:00:00.xyz" used to
            ;; fall back to 0 ms and parse as a clean time
            (or (= frac-str "") (dt-in-range? (dt-parse-int frac-str) 0 999999999)))
      ;; An unparsable component reads as -1 — never in range — so the values below are ints.
      (let (h (or (dt-parse-int (nth parts 0)) -1)
            mn (or (dt-parse-int (nth parts 1)) -1)
            sc (or (dt-parse-int (nth parts 2)) -1))
        (when (and (dt-in-range? h 0 23) (dt-in-range? mn 0 59) (dt-in-range? sc 0 59))
          (time-of-day h mn sc (dt-frac->ms frac-str)))))))

(defn parse-date (s)
  "Parse an ISO 8601 date string \"YYYY-MM-DD\" → a `date`, or a `failure` naming the
input. The date must be a **real** one: the month is 1–12 and the day is within that
month for that year (so \"2026-02-31\" and \"2026-13-05\" fail rather than silently
normalising to a March date).

    (datetime/format (datetime/parse-date \"2026-08-27\") \"%Y-%m-%d\")   → \"2026-08-27\"
    (failure? (datetime/parse-date \"2026-02-31\"))                     → true"
  (or (let (parts (string/split s "-"))
        (when (= (count parts) 3)
          (let (y (dt-parse-int (nth parts 0))
                m (or (dt-parse-int (nth parts 1)) -1)
                d (or (dt-parse-int (nth parts 2)) -1))
            (when (and (int? y) (dt-in-range? m 1 12) (dt-in-range? d 1 (days-in-month y m)))
              (date y m d)))))
    (failure "datetime/parse-date: not a real YYYY-MM-DD date: " (pr-str s))))

(defn parse-time (s)
  "Parse \"HH:MM:SS\" or \"HH:MM:SS.mmm\" (optional trailing Z) → a `time-of-day`, or a
`failure` naming the input. Hour 0–23, minute and second 0–59."
  ;; `(first (string/split s "Z"))` threw away everything after the FIRST Z, so
  ;; "12:00:00Zjunk" parsed as 12:00:00. Only a trailing Z is a UTC designator.
  (or (cond
        (string/ends-with? s "Z") (dt-parse-time-str (string/substring s 0 (- (string/length s) 1)))
        (>= (index-of s "Z") 0) nil
        else (dt-parse-time-str s))
    (failure "datetime/parse-time: not HH:MM:SS[.mmm][Z]: " (pr-str s))))

;; A numeric zone designator (`+02:00`) is as much a part of ISO 8601 as `Z`, and every
;; timestamp a real API hands you carries one. It used to yield **nil** — indistinguishable
;; from malformed input, and silent: the caller saw "not a datetime" for a perfectly good
;; timestamp. This module is UTC-only and says so, but "UTC-only" is a statement about the
;; values it *holds*, not about the inputs it can read: an offset names a real instant, so
;; the honest reading is to shift it to UTC rather than refuse it.

(defn- dt-offset-index (time-part)
  "Where a numeric zone designator starts in an ISO 8601 time part, or -1. A `-` cannot occur
  inside a time, so either sign marks the offset."
  (let (plus (index-of time-part "+")
        minus (index-of time-part "-"))
    (cond
      (>= plus 0) plus
      (>= minus 0) minus
      else -1)))

(defn- dt-parse-offset-ms (o)
  "The signed milliseconds a zone designator denotes — `+02:00`, `-05:30`, `+0200`, `+02` —
  or nil when it is not one. `Z` never reaches here; `parse-time` consumes it."
  (let (sign (if (string/starts-with? o "-") -1 1)
        body (string/substring o 1 (string/length o))
        n (string/length body)
        ;; Checked by SHAPE, and before the colon is removed. Stripping it first let "+2:0"
        ;; collapse to "20" and parse as +20:00 — a string that means nothing accepted as a
        ;; specific, wrong offset, which is worse than the nil this was meant to stop
        ;; returning.
        shape (cond
                (= n 2) :hh
                (and (= n 4) (< (index-of body ":") 0)) :hhmm
                (and (= n 5) (= (string/char-at body 2) ":")) :hh-mm
                else nil)
        digits (if (= shape :hh-mm)
                 (str (string/substring body 0 2) (string/substring body 3 5))
                 body)
        h (if shape (or (dt-parse-int (string/substring digits 0 2)) -1) -1)
        mn (cond
             (not shape) -1
             (= shape :hh) 0
             else (or (dt-parse-int (string/substring digits 2 4)) -1)))
    (when (and shape (dt-in-range? h 0 23) (dt-in-range? mn 0 59))
      (* sign (+ (* h 3600000) (* mn 60000))))))

(defn parse-iso8601 (s)
  "Parse an ISO 8601 datetime string \"YYYY-MM-DDTHH:MM:SS[.mmm][Z|±HH:MM]\" → a `datetime`,
or a `failure` naming the input.

A numeric offset is applied, yielding the equivalent UTC instant — every datetime this module
produces is UTC.

    (datetime/->iso (datetime/parse-iso8601 \"2026-01-02T03:04:05+02:00\"))   → \"2026-01-02T01:04:05.000Z\""
  ;; The inner `(and d t)` needs no change now that `parse-date`/`parse-time` answer a
  ;; FAILURE instead of nil: a failure is falsy, so a bad component short-circuits here
  ;; exactly as a nil did, and the outer `or` turns the whole thing into one failure
  ;; naming the input the caller actually passed.
  (or
    (let (parts (string/split s "T"))
      (when (= (count parts) 2)
        (let (d (parse-date (or (nth parts 0) ""))
              time-part (or (nth parts 1) "")
              oi (dt-offset-index time-part))
          (if (< oi 0)
            (let (t (parse-time time-part))
              (when (and d t) (date+time d t)))
            (let (t (parse-time (string/substring time-part 0 oi))
                  off (dt-parse-offset-ms (string/substring time-part oi (string/length time-part))))
              ;; subtract: a local time east of UTC names an EARLIER UTC instant
              (when (and d t off) (add (date+time d t) (- off))))))))
    (failure "datetime/parse-iso8601: not an ISO 8601 datetime: " (pr-str s))))

;; ---- duration helpers -------------------------------------------------------

(defn seconds (n)
  "Milliseconds in `n` seconds.

    (datetime/seconds 2)   → 2000"
  (* n 1000))
(defn minutes (n)
  "Milliseconds in `n` minutes.

    (datetime/minutes 1)   → 60000"
  (* n 60000))
(defn hours (n)
  "Milliseconds in `n` hours.

    (datetime/hours 1)     → 3600000"
  (* n 3600000))
(defn days (n)
  "Milliseconds in `n` days.

    (datetime/days 1)      → 86400000"
  (* n 86400000))

;; ---- arithmetic -------------------------------------------------------------

(defn add (dt ms)
  "Add `ms` milliseconds to `dt`, returning a new datetime.

    (datetime/format (datetime/add (datetime/parse-iso8601 \"2026-08-27T00:00:00Z\") (datetime/days 1)) \"%Y-%m-%d\")   → \"2026-08-28\""
  (epoch-ms-> (+ (->epoch-ms dt) ms)))
(sig add ((or datetime date) int -> datetime))

(defn diff (dt1 dt2)
  "Milliseconds from `dt2` to `dt1` (positive when `dt1` is later).

    (datetime/diff (datetime/parse-iso8601 \"2026-08-28T00:00:00Z\") (datetime/parse-iso8601 \"2026-08-27T00:00:00Z\"))   → 86400000"
  (- (->epoch-ms dt1) (->epoch-ms dt2)))

;; ---- comparison -------------------------------------------------------------
;;
;; Ordering is the `compare-to` multimethod, not a private family of predicates. Registering
;; it is what makes `<`, `<=`, `>`, `>=`, `sort`, `compare` and `math/min`/`math/max` work on
;; a temporal value — record ordering is STRICT (see `std/prelude/seq.blsp`: no structural
;; default), so until this existed `(sort dates)` raised `compare-to: no method for
;; [:datetime/date :datetime/date]` while the module carried five hand-written comparisons
;; that none of those operators could see. `before?`/`after?`/`not-before?`/`not-after?`/
;; `same?` are gone with it: they were `<`/`>`/`>=`/`<=`/`=` spelled a second way.
;;
;; **Same-type only, deliberately.** A `date` and a `datetime` are not two spellings of one
;; instant — ordering them would have to invent a time of day — so a mixed pair raises the
;; loud `%no-method` rather than silently assuming midnight. That is the same rule the
;; cross-type arithmetic review settled on: a coercion the user did not ask for is a wrong
;; answer that looks like a right one.

(defn- dt-tod-ms (t)
  "A time-of-day as milliseconds since midnight. `->epoch-ms` cannot serve here — it reads
  the date fields a time-of-day does not have."
  (+ (* (get t :hour 0) 3600000)
    (* (get t :minute 0) 60000)
    (* (get t :second 0) 1000)
    (get t :ms 0)))

(defmethod compare-to [datetime datetime] (a b) (compare (->epoch-ms a) (->epoch-ms b)))
(defmethod compare-to [date date] (a b) (compare (->epoch-ms a) (->epoch-ms b)))
(defmethod compare-to [time-of-day time-of-day] (a b) (compare (dt-tod-ms a) (dt-tod-ms b)))

;; ---- calendar ---------------------------------------------------------------

(defn leap-year? (y)
  "True if year `y` is a Gregorian leap year."
  (and (= (math/rem y 4) 0)
    (or (not (= (math/rem y 100) 0))
      (= (math/rem y 400) 0))))
(sig leap-year? (int -> bool))

(defn days-in-month (y m)
  "Number of days in month `m` (1–12) of year `y`."
  (cond
    (or (= m 1) (= m 3) (= m 5) (= m 7) (= m 8) (= m 10) (= m 12)) 31
    (or (= m 4) (= m 6) (= m 9) (= m 11)) 30
    (= m 2) (if (leap-year? y) 29 28)
    else (error (str "days-in-month: invalid month " m))))

(defn day-of-week (dt)
  "Day of week as a keyword: :monday … :sunday. Based on UTC date."
  (let (w (math/mod (+ (dt-ymd->days (get dt :year) (get dt :month) (get dt :day)) 3) 7))
    (nth [:monday :tuesday :wednesday :thursday :friday :saturday :sunday] w)))

(defn day-of-year (dt)
  "Day within the year (1–366)."
  (+ (- (dt-ymd->days (get dt :year) (get dt :month) (get dt :day))
       (dt-ymd->days (get dt :year) 1 1))
    1))
