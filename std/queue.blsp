;; std/queue.blsp — purely functional FIFO queue.
;;
;; Amortised O(1) push/pop using two lists (front + reversed back). The min-priority
;; queue is its sibling module `pq` (std/pq.blsp).

(defmodule queue
  "Purely functional FIFO queue.

    (let (q (-> (queue/new)
                (queue/push 1)
                (queue/push 2)
                (queue/push 3)))
      (queue/pop q))        ;; => [1 #<queue 2 front=2>]

A queue is a **record**, so it is its own type rather than a map that happens to have the
right shape: `queue/queue?` is a real predicate, a queue is never `=` to a look-alike map, and
it prints as `#<queue …>` instead of leaking its two-list representation.")

;; ============================================================================
;; A `queue` RECORD of {front: list, back: reversed list, size: int}.
;; Invariant: if front is nil, back is also nil (rebalance on push to empty).
;; ============================================================================

(defrecord queue (front back size))

(defn queue? (x)
  "True if `x` is a FIFO queue — by identity, not by shape."
  (and (record? x) (= (record-id x) :queue/queue)))

(defn new ()
  "An empty FIFO queue."
  (queue nil nil 0))

(defn empty? (q)
  "True if the queue has no elements."
  (= (get q :size) 0))

(defn size (q)
  "Number of elements in the queue."
  (get q :size))

(defn- balance
  (front back size)
  "Rebalance: if front is nil, reverse back to front."
  (if (nil? front)
    (queue (reverse back) nil size)
    (queue front back size)))

(defn push (q v)
  "Return a queue with `v` added at the back."
  (balance (get q :front) (cons v (get q :back)) (+ (get q :size) 1)))

(defn pop (q)
  "Return `[front-value new-queue]`, or `:empty` if the queue is empty."
  (if (empty? q)
    :empty
    (let (front (get q :front))
      [(first front) (balance (rest front) (get q :back) (- (get q :size) 1))])))

(defn peek (q)
  "Return the front value without removing it, or `:empty` if empty."
  (if (empty? q)
    :empty
    (first (get q :front))))

;; The queue joins the collection protocol (ADR-172 §7): `Seqable` gives it the generic
;; `seq`/`count`/`map`/`filter`/`fold`/`for` and `into`-from-a-queue; `Conjable` gives it
;; `conj` and `into`-into-a-queue. So a queue is a first-class collection — the helpers
;; below are thin aliases over the protocol, not a parallel API.
(impl Seqable
  queue/queue
  (to-seq [q]
    (if (= (get q :size) 0) nil (append (get q :front) (reverse (get q :back))))))
(impl Conjable queue/queue (-conj [q v] (push q v)))

(defn to-list (q)
  "All elements in FIFO order as a list — the queue's `Seqable` view. `(seq q)` /
`(into [] q)` / `(map f q)` / `(fold f init q)` / `(for (x q) …)` all work directly."
  (seq q))

(defn from-list (xs)
  "Build a queue from a list or vector, front → back — i.e. `(into (queue/new) xs)`."
  (into (new) xs))

;; A queue shows its shape, not its two-list representation: `Display` is the O(1) summary
;; (size + the element that pops next), `Inspect` the full FIFO contents.
(impl Display
  queue/queue
  (to-str [q]
    (if (empty? q)
      "#<queue empty>"
      (str "#<queue " (get q :size) " front=" (to-str (peek q)) ">"))))

(impl Inspect
  queue/queue
  (inspect [q] (str "#<queue " (pr-str (to-list q)) ">")))
