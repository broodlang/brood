;; std/log.blsp — an async, safe logger.
;;
;; Async + safe fall straight out of the process model (ADR-006):
;;  - A logger is one long-lived `gen` process carrying {:level :backends}.
;;  - A log call is a CAST (`!`) — fire-and-forget, so the caller never blocks on
;;    a slow or stuck backend. That is the "async".
;;  - One process owns every write, so lines never interleave and a backend that
;;    throws takes down only the log line, not the caller. That is the "safe".
;;
;; A *backend* is any value implementing the **`LogBackend`** ability — one op,
;; `backend-emit`, which is handed a record and decides what happens to it. The stock
;; backend (`line-backend`, built by `backend` and its `stdout-`/`stderr-`/`process-`/
;; `file-`/`fn-` shorthands) is an `io` port (the redirectable string sink —
;; std/io.blsp) plus a minimum level, a filter, and a formatter: it gates the record and
;; writes one formatted line. So "log to a buffer" is a `process-backend` whose port
;; sends `[:write s]` to the process that owns the buffer (e.g. an editor's
;; *Messages*) — the same share-nothing path `print` redirection uses, never a
;; mutated value. The logger reuses ports rather than inventing its own sink.
;;
;; Because the backend is an ability rather than a fixed map shape, a backend that does
;; something other than "format one line and write it" — batch N records, emit JSON
;; lines, frame for syslog, drop everything but a sample — is a `defrecord` + an `impl
;; LogBackend` in *your* module, with no change here. Reuse `backend-passes?` for the
;; standard level/filter gate.

; ports + write
(defmodule log
  "An async, safe logger. A `gen` process holds a list of
backends; each log call is a cast, so it never blocks the caller, and the single
process serialises writes (no interleaving) and isolates a crashing backend.

    (start-logger)                       ; default: stdout, :info and up
    (info \"server up\" {:port 8080}) ; structured fields optional
    (log :warn \"disk low\")
    (add-backend (file-backend \"app.log\"))
    (add-backend (process-backend editor-pid))  ; → an editor's *Messages*

Levels are `:debug` < `:info` < `:warn` < `:error`. The default logger is
registered as `:logger`; `(log …)` finds it via `proc/whereis` and falls back to
stderr if none is running, so a log is never silently lost.

A *backend* is any value implementing the **`LogBackend`** ability (one op,
`backend-emit`). The stock one is an `io` port + `:min-level` + `:filter` + `:format` —
build it with `stdout-backend` / `stderr-backend` / `process-backend` / `file-backend` /
`fn-backend`. For anything else (batching, JSON lines, sampling), `defrecord` your own
and `impl LogBackend` for it; reuse `backend-passes?` for the standard gate."
  ;; `gen` for defserver / start / cast / stop; `io` for the port sinks.
  (:use gen)
  ;; `:exclude [inspect]` — `io/inspect` WRITES, while the root `inspect` is the `Inspect`
  ;; ability op that RETURNS a string. Referring the writer bare here would shadow the op.
  (:use io :exclude [inspect]))
;; ---- levels -----------------------------------------------------------------
(def- log-ranks {:debug 0 :info 1 :warn 2 :error 3})
(def- log-labels {:debug "DEBUG" :info "INFO" :warn "WARN" :error "ERROR"})

(defn- log-rank
  (level)
  "The numeric severity of `level` (unknown levels rank as :info)."
  (or (get log-ranks level) 1))

(defn- log-default-format
  (rec)
  "The default line for a record: `[LEVEL ts] msg` plus a newline."
  (str "["
    (or (get log-labels (get rec :level)) "?")
    " "
    (get rec :ts)
    "] "
    (get rec :msg)
    "\n"))

;; ---- the LogBackend ability -------------------------------------------------

(defability LogBackend
  "How a backend handles one log record. The logger calls `backend-emit` for each of its
  backends in turn; the backend decides whether and how the record is written."
  (backend-emit [self record] :-> nil))

(defn backend-passes? (b record)
  "True if `record` clears backend `b`'s standard gate: its `:min-level` severity floor
*and* its `:filter` predicate (nil filter = accept all). The reusable half of the stock
backend's policy — a custom `LogBackend` should call this so it honours the same
`:min-level`/`:filter` options every other backend does."
  (let (predicate (get b :filter))
    (and (>= (log-rank (get record :level)) (log-rank (get b :min-level)))
      (or (nil? predicate) (predicate record)))))

;; ---- backends ---------------------------------------------------------------

(defrecord line-backend (sink min-level filter format))

;; The stock backend: gate the record, then write exactly one formatted line to the port.
(impl LogBackend
  log/line-backend
  (backend-emit [b record]
    (when (backend-passes? b record)
      (emit (get b :sink) ((get b :format) record)))
    nil))

(impl Display
  log/line-backend
  (->string [b]
    (str "#<log-backend "
      (->string (get b :sink))
      " min="
      (get b :min-level)
      (if (get b :filter) " filtered" "")
      ">")))

(defn backend (sink & opts)
  "A logger backend over `sink` (an `io` port) — a `line-backend`, which writes one
formatted line per record. `opts` is a map: `:min-level` (default `:debug` — everything)
gates by severity; `:filter` (default nil — accept all) is a `(fn (record) -> bool)`
predicate; `:format` (default the `[LEVEL ts] msg` line) is a `(fn (record) -> string)`.
A backend writes a record only when it passes *both* `:min-level` and `:filter` — so
several backends on one logger can route by category/source (read off the record's
`:meta`) to different sinks (e.g. an editor's `*LSP*` vs `*Messages*` buffer), the
OTP-handler-filter / Elixir-metadata-filter idea.

For a backend that does something other than write one line, `defrecord` your own and
`impl LogBackend` for it — the logger accepts any value with an impl."
  (let (o (if (empty? opts) {} (first opts)))
    (line-backend sink
      (or (get o :min-level) :debug)
      ; nil = accept all
      (get o :filter)
      (or (get o :format) log-default-format))))

(defn stdout-backend (& opts)
  "A backend writing to stdout (`opts` as for `backend`)."
  (apply backend (stdout-port) opts))

(defn stderr-backend (& opts)
  "A backend writing to stderr (`opts` as for `backend`)."
  (apply backend (stderr-port) opts))

(defn process-backend (pid & opts)
  "A backend that sends each formatted line to process `pid` as `[:write s]` —
e.g. an editor appending to its `*Messages*` buffer. Async and share-nothing."
  (apply backend (process-port pid) opts))

(defn fn-backend (f & opts)
  "A backend that hands each formatted line to the 1-arg callback `f`."
  (apply backend (fn-port f) opts))

(defn file-backend (path & opts)
  "A backend that appends each formatted line to the file at `path` (low-volume —
`file/spit-append` is a non-atomic read-modify-write today)."
  (apply backend (file-port path) opts))

;; ---- the logger process -----------------------------------------------------
(defn- log-dispatch
  (backends rec)
  "Hand `rec` to every backend in `backends` (a list or vector) via `backend-emit`, so
each decides for itself whether and how to write it. Uses `fold` so it walks either —
`:backends` defaults to a vector but `add-backend` conses."
  (fold (fn (acc b) (backend-emit b rec) acc) nil backends)
  nil)

(defserver server
  (cfg)
  "The logger process: carries `{:level :backends}` and dispatches each
`[:log rec]` cast to every backend that passes the global and per-backend levels."
  (cast [:log rec]
    (do
      (when (>= (log-rank (get rec :level)) (log-rank (get cfg :level)))
        (log-dispatch (get cfg :backends) rec))
      cfg))
  (cast [:add-backend b] (assoc cfg :backends (cons b (apply list (get cfg :backends)))))
  (cast [:set-level level] (assoc cfg :level level))
  (query :config cfg))

;; ---- lifecycle --------------------------------------------------------------
(defn start-logger (& opts)
  "Spawn the logger, register it as `:logger`, and return its pid. `opts` is a map:
`:level` (default `:info`) is the global minimum severity; `:backends` (default
`[(stdout-backend)]`) is the initial backend list. Replaces any previous `:logger`."
  (let (o (if (empty? opts) {} (first opts))
        level (or (get o :level) :info)
        backends (or (get o :backends) [(stdout-backend)])
        pid (start server {:level level :backends backends}))
    (proc/register :logger pid)
    pid))

(defn logger ()
  "The pid of the running default logger (registered `:logger`), or nil."
  (proc/whereis :logger))

(defn stop-logger ()
  "Stop the running default logger, if any. Returns nil."
  (let (pid (logger))
    (when pid (stop pid)))
  nil)

(defn add-backend (b)
  "Add backend `b` to the running logger (a cast). Returns nil."
  (let (pid (logger))
    (when pid (cast pid [:add-backend b])))
  nil)

(defn set-level (level)
  "Set the running logger's global minimum severity (a cast). Returns nil."
  (let (pid (logger))
    (when pid (cast pid [:set-level level])))
  nil)

;; ---- the log call -----------------------------------------------------------
(defn- log-record
  (level msg meta)
  "Build a log record map, stamping `:ts` (now, ms) and `:from` (the caller's pid)."
  {:level level :msg msg :meta meta :ts (os/now) :from (self)})

(defn log (level msg & meta)
  "Log `msg` at `level` (`:debug`/`:info`/`:warn`/`:error`) to the running logger,
asynchronously (a cast — never blocks the caller). `meta`, if given, is a map of
structured fields carried on the record. If no logger is running, the formatted
line falls back to stderr so a log is never lost. Returns nil."
  (let (m (if (empty? meta) {} (first meta))
        rec (log-record level msg m)
        pid (logger))
    (if pid
      (cast pid [:log rec])
      (io/write (log-default-format rec) :to *err*)))
  nil)

(defn debug (msg & meta) "Log `msg` at `:debug`." (apply log :debug msg meta))
(defn info (msg & meta) "Log `msg` at `:info`." (apply log :info msg meta))
(defn warn (msg & meta) "Log `msg` at `:warn`." (apply log :warn msg meta))
(defn error (msg & meta) "Log `msg` at `:error`." (apply log :error msg meta))
