;; std/text.blsp — the rope text-engine seam. Thin policy over the %rope-* primitives, so
;; editor code reaches the rope (efficient large-text editing: O(log n) insert/delete/slice,
;; cheap line access) as text/insert, text/slice, … rather than the bare language core.
(defmodule text
  "The rope text engine: O(log n) insert, delete and slice with cheap line access, for editing large text.")

(defn insert (r idx s)
  "A fresh rope with string s inserted at character index idx.

    (text/->string (text/insert (text/string-> \"ac\") 1 \"b\"))   ;=> \"abc\""
  (%rope-insert r idx s))

(defn delete (r start end)
  "A fresh rope with characters [start, end) removed.

    (text/->string (text/delete (text/string-> \"abc\") 1 2))   ;=> \"ac\""
  (%rope-delete r start end))

(defn slice (r start end)
  "The text of characters [start, end) of `r`, as a string. `r` is a rope, or a string — so
a query written against a document can take whichever its caller holds (ADR-488), and a rope
is read only where it is sliced.

    (text/slice (text/string-> \"abcd\") 1 3)   ;=> \"bc\"
    (text/slice \"abcd\" 1 3)   ;=> \"bc\""
  (if (rope? r) (%rope-slice r start end) (string/substring r start end)))

(defn length (r)
  "The number of characters in `r`, a rope or a string.

    (text/length (text/string-> \"hi\"))   ;=> 2
    (text/length \"hé\")   ;=> 2"
  (if (rope? r) (%rope-length r) (string/length r)))

(defn line (r n)
  "The text of line n (0-based) of rope r, including any trailing newline.

    (text/line (text/string-> \"a\nb\") 1)   ;=> \"b\""
  (%rope-line r n))

(defn line-count (r)
  "The number of lines in rope r (a trailing newline ends a line; \"\" is 1 line).

    (text/line-count (text/string-> \"a\nb\"))   ;=> 2"
  (%rope-line-count r))

(defn char->line (r idx)
  "The 0-based line index containing character idx.

    (text/char->line (text/string-> \"ab\\ncd\\nef\") 4)   ;=> 1"
  (%rope-char->line r idx))

(defn line->char (r n)
  "The character index where line n (0-based) begins.

    (text/line->char (text/string-> \"ab\\ncd\\nef\") 2)   ;=> 6"
  (%rope-line->char r n))

(defn ->string (r)
  "The full text of rope r as a string.

    (text/->string (text/string-> \"hi\"))   ;=> \"hi\""
  (%rope->string r))

(defn string-> (s)
  "A rope (editor buffer text) holding the characters of string s.

    (text/->string (text/string-> \"hi\"))   ;=> \"hi\""
  (%string->rope s))

(defn changed-range (old new)
  "What changed from rope `old` to rope `new`: nil when they hold the same text, else
`[start old-end new-end]` in characters — `old`'s `[start, old-end)` became `new`'s
`[start, new-end)`, and everything around it is common to both. Found natively from each
end, chunk by chunk, with no string built, so asking costs little more than the edit did:
exact for one contiguous change (a keystroke, a paste, an undo), correct but wider for a
scattered one. What lets a cache keyed on a rope (`editor/line-cache`) keep
everything the edit did not touch.

    (text/changed-range (text/string-> \"abcd\") (text/string-> \"abXcd\"))   ;=> [2 2 3]
    (text/changed-range (text/string-> \"ab\") (text/string-> \"ab\"))   ;=> nil"
  (%rope-changed-range old new))

(defn next-grapheme (r:rope idx:int -> int)
  "The character index one user-perceived character after `idx` — the next grapheme-cluster
boundary, or the rope's length at the end. A cursor steps by this, never by 1: `e` followed
by a combining accent, or an emoji sequence, is one character of several code points.

    (text/next-grapheme (text/string-> \"e\u{301}x\") 0)   ;=> 2"
  (%rope-next-grapheme r idx))

(defn prev-grapheme (r:rope idx:int -> int)
  "The character index one user-perceived character before `idx` — the previous
grapheme-cluster boundary, or 0 at the start.

    (text/prev-grapheme (text/string-> \"xe\u{301}\") 3)   ;=> 1"
  (%rope-prev-grapheme r idx))

(defn forward-graphemes (r:rope idx:int n:int -> int)
  "The character index `n` user-perceived characters after `idx`, stopping at the end.

    (text/forward-graphemes (text/string-> \"ae\u{301}b\") 0 2)   ;=> 3"
  (if (<= n 0) idx (forward-graphemes r (%rope-next-grapheme r idx) (- n 1))))

(defn backward-graphemes (r:rope idx:int n:int -> int)
  "The character index `n` user-perceived characters before `idx`, stopping at the start.

    (text/backward-graphemes (text/string-> \"ae\u{301}b\") 4 2)   ;=> 1"
  (if (<= n 0) idx (backward-graphemes r (%rope-prev-grapheme r idx) (- n 1))))

(defn skip-forward (r at chars inside?)
  "The first index at or after `at` that ends a run of characters from `chars` (with
`inside?`) or of characters NOT from it (without) — how far a word, a run of blanks, or
anything else defined by a character set reaches. Reads only the run, never the whole rope.

    (text/skip-forward (text/string-> \"  ab cd\") 0 \" \" true)   ;=> 2
    (text/skip-forward (text/string-> \"  ab cd\") 2 \" \" false)   ;=> 4"
  (%rope-skip r at true chars inside?))

(defn skip-backward (r at chars inside?)
  "The smallest index at or before `at` such that every character between it and `at` is
in the run — from `chars` with `inside?`, not from it without. The mirror of
`skip-forward`.

    (text/skip-backward (text/string-> \"ab cd\") 5 \" \" false)   ;=> 3"
  (%rope-skip r at false chars inside?))
