;; std/regex.blsp — regular expressions: Brood's pattern LANGUAGE over a native engine.
;;
;; The split (ADR-389): this file is the POLICY — what a pattern means. Its parser reads
;; Brood's dialect into an AST and translates that into an unambiguous pattern for the
;; native engine (`regex-automata`, a lazy DFA and a Pike VM: linear in the input, no
;; backtracking). The engine is the MECHANISM, `crates/lisp/src/builtins/regex_native.rs`,
;; and only ever runs what the translation produced. Redefine the parser and every pattern
;; in the image means something else; the engine never needs to know.
;;
;; The engine is native because an editor tries a pattern table on every visible row: an
;; interpreted NFA/DFA costs milliseconds there where the native one costs microseconds.
;;
;; The dialect:
;;
;;   literals            a b c …
;;   .                   any one character, a newline included
;;   * + ?               greedy quantifiers (on the preceding atom or group)
;;   *? +? ??            lazy quantifiers — the shortest match, not the longest
;;   {m} {m,} {m,n}      counted repetition (*max-repeat* caps it)
;;   ^ $                 the start / end of the WHOLE string (never of a line)
;;   [...] [^...]        a set / negated set: literal chars, `a-z` ranges, and the
;;                       `\d`/`\w`/`\s` classes and their negations, written inside the
;;                       brackets
;;   \d                  an ASCII digit, 0-9 — what `string/->number` can read
;;   \w \s               a Unicode word character (letter, mark, digit, `_`) / whitespace
;;   \D \W \S            the negations: not an ASCII digit / not a word character / not
;;                       whitespace
;;   \b \B               a word boundary / not one, by `\w`
;;   \n \t \r \f \v      newline, tab, carriage return, form feed, vertical tab
;;   \xHH \x{H…}         the character with that code point, as other engines read them;
;;   \uHHHH \u{H…}       a malformed one is the letter, as any other unknown escape is
;;   \x                  any other escaped character is that character: `\.` `\*` `\\`
;;   |                   alternation
;;   (...)  (?:...)      a capturing group, and a non-capturing one
;;   [[:alpha:]] …       a POSIX class inside a set, Emacs's (Unicode-aware) meanings:
;;                       alpha alnum digit xdigit upper lower space blank punct cntrl
;;                       graph print word ascii nonascii — `[^[:space:]]`, `[[:alpha:]_-]`
;;   (?i) (?-i)          case folding on / off for the rest of the enclosing group (the
;;   (?i:...) (?-i:...)  whole pattern at the top), or for one non-capturing group; every
;;                       string search also takes `{:fold? true}`, which is `(?i)` in front
;;
;; A malformed pattern is never an error: a stray `*`, `{` or `)` and an unterminated
;; `[` mean the characters they look like, because in a hand-written pattern they
;; usually did. The one refusal is a repetition past *max-repeat*.
;;
;; NOT supported: backreferences, lookaround, named groups.

(defmodule regex
  "Regular expressions: Brood's pattern language, matched by a native engine.

`(regex/match? pattern s)` searches `s` for `pattern` (anchors `^`/`$` tie to the
string's start/end); `(regex/matches? pattern s)` requires the whole string to
match. `(regex/find pattern s)` returns WHERE it matched and what each `(...)`
group captured, `find-all` every non-overlapping match, and `replace`/`split`
build on those. `tokens` lexes a line with a rule table, `paint` finds the text a
line rule colours.

A buffer is searched in place, never flattened: `rope-find` / `rope-find-backward`
search a rope, `rope-count` counts its matches in slices that add up, and `rope-spans`
lists the ones in a window — reading `^ $ .` a line at a time, as a buffer search
does. `escape` quotes text into a pattern; `incomplete?` says a typed pattern is not
finished yet.

The dialect: literals, `.`, `* + ?` (and their lazy `*? +? ??` forms), `{m,n}`,
`^ $`, `[...]`/`[^...]` sets with ranges, classes and POSIX classes (`[[:alpha:]]`), `\\d \\w \\s
\\D \\W \\S \\b \\B`, the character escapes `\\n \\t \\r \\f \\v \\xHH \\u{…}`, `|`, capturing `(...)` and non-capturing `(?:...)`, and case folding —
`(?i)`, `(?i:...)`, or `{:fold? true}` on any search. No backreferences or lookaround. Each
pattern is parsed once and compiled once, then cached.")

;; ---- parse: pattern string -> AST -------------------------------------------
;; A pattern parses to a list of BRANCHES (the top-level alternation); each branch
;; is a list of PIECES; a piece is an ATOM, optionally wrapped `{:q :star/:plus/:opt
;; :a atom}` or `{:q :count :lo :hi :a atom}`. Atoms are tagged maps: {:t :lit :c c}
;; {:t :any} {:t :bol} {:t :eol} {:t :set :neg b :chars (…)} {:t :class :k
;; :digit/:word/:space} {:t :group :alt …}.

(defn- regex-peek (pcs: (vector string) i:int -> (or nil string))
  (if (< i (count pcs)) (nth pcs i) nil))

;; The class escapes, in a set or out of one. The negations are here because without them
;; `\S` read as the letter S (an unknown escape is its character), so a pattern written in
;; every other dialect matched nothing and said nothing.
(def- regex-class-escapes
  {"d" :digit "w" :word "s" :space "D" :not-digit "W" :not-word "S" :not-space})

;; The escapes that name a control character, as every other engine reads them. They once
;; read as the letter (`\n` an `n`), which silently broke a pattern carried over from any
;; other dialect: `[ \t]*` matched spaces and the letter t.
(def- regex-control-escapes {"n" "\n" "t" "\t" "r" "\r" "f" "\u{c}" "v" "\u{b}"})

(defn- regex-hex-run (pcs: (vector string) i:int limit:int acc:string -> string)
  "The hex digits from `i`, at most `limit` of them."
  (let (c (regex-peek pcs i))
    (if (and (> limit 0) (string? c) (includes? "0123456789abcdefABCDEF" c))
      (regex-hex-run pcs (inc i) (dec limit) (str acc c))
      acc)))

(defn- regex-code-point (digits:string -> (or nil string))
  "The character the hex `digits` name, or nil — for none, or a number past Unicode or in
the surrogate range, which name no character."
  (let (n (if (= digits "") nil (string/->number digits 16)))
    (if (and (int? n) (<= n 0x10FFFF) (not (and (>= n 0xD800) (<= n 0xDFFF))))
      (string/int->char n)
      nil)))

(defn- regex-coded-length (pcs: (vector string) i:int -> int)
  "How many pattern characters from `i` (just past a backslash) an escape that names one
character by its code spans — `\\n \\t \\r \\f \\v`, `\\xHH`, `\\x{H…}`, `\\uHHHH`,
`\\u{H…}` — or 0 when it names none. A malformed hex escape names none: its letter then
stands for itself, as any other unknown escape does."
  (let (c (regex-peek pcs i))
    (cond
      (contains? regex-control-escapes c) 1
      (not (or (= c "x") (= c "u"))) 0
      (= (regex-peek pcs (inc i)) "{")
        (let (digits (regex-hex-run pcs (+ i 2) 8 "")
              close (+ i 2 (string/length digits)))
          (if (and (regex-code-point digits) (= (regex-peek pcs close) "}"))
            (+ 3 (string/length digits))
            0))
      else
        (let (width (if (= c "x") 2 4)
              digits (regex-hex-run pcs (inc i) width ""))
          (if (and (regex-code-point digits) (= (string/length digits) width)) (inc width) 0)))))

(defn- regex-coded-char (pcs: (vector string) i:int -> (or nil string))
  "The character the escape at `i` (just past a backslash) names by its code
([[regex-coded-length]]), or nil."
  (let (c (regex-peek pcs i)
        n (regex-coded-length pcs i))
    (cond
      (= n 0) nil
      (contains? regex-control-escapes c) (get regex-control-escapes c)
      (= (regex-peek pcs (inc i)) "{") (regex-code-point (regex-hex-run pcs (+ i 2) 8 ""))
      else (regex-code-point (regex-hex-run pcs (inc i) (dec n) "")))))

; \. \* \\ … → that char, literal
(defn- regex-escape (pcs i)
  "Parse the atom after a backslash at `i`; returns [atom next]."
  (let (c (regex-peek pcs i)
        coded (regex-coded-char pcs i))
    (cond
      (contains? regex-class-escapes c) [{:t :class :k (get regex-class-escapes c)} (inc i)]
      ;; word-boundary assertions: zero-width, like the anchors
      (= c "b") [{:t :wordb} (inc i)]
      (= c "B") [{:t :nwordb} (inc i)]
      coded [{:t :lit :c coded} (+ i (regex-coded-length pcs i))]
      (nil? c) [{:t :lit :c "\\"} i]
      ; trailing backslash → literal
      else [{:t :lit :c c} (inc i)])))

(defn- regex-set-char-length (pcs: (vector string) i:int -> int)
  "How many pattern characters the set member at `i` spans when it names one character: a
plain character, an escape that names one by its code ([[regex-coded-length]]), an escaped
character standing for itself (`\\]`, `\\-`, `\\\\`), or a trailing backslash, itself.
0 at the end of the pattern, or at a class escape (`\\d` …), which names no one character."
  (let (c (regex-peek pcs i)
        e (regex-peek pcs (inc i)))
    (cond
      (nil? c) 0
      (not (= c "\\")) 1
      (nil? e) 1
      (contains? regex-class-escapes e) 0
      else (let (n (regex-coded-length pcs (inc i))) (if (> n 0) (inc n) 2)))))

(defn- regex-set-char (pcs: (vector string) i:int -> (or nil string))
  "The one character the set member at `i` names ([[regex-set-char-length]]), or nil."
  (let (c (regex-peek pcs i)
        e (regex-peek pcs (inc i)))
    (cond
      (= (regex-set-char-length pcs i) 0) nil
      (not (= c "\\")) c
      (nil? e) "\\"
      else (or (regex-coded-char pcs (inc i)) e))))

(defn- regex-set-range-end (pcs: (vector string) i:int -> (or nil string))
  "The upper end of a range whose `-` would be at `i`, or nil when there is none. A `-` LAST
in the set (`[a-]`) is a literal member, which is why the character after it has to exist
and not be `]`; one before a class (`[a-\\d]`) is a literal member too."
  (let (hi (regex-peek pcs (inc i)))
    (if (and (= (regex-peek pcs i) "-") (not (nil? hi)) (not (= hi "]")))
      (regex-set-char pcs (inc i))
      nil)))

;; The POSIX bracket classes, written INSIDE a set (`[[:alpha:]]`, `[^[:space:]x]`), and what
;; each is in the engine's syntax. Emacs's meanings, which are Unicode-aware where POSIX's are
;; ASCII: `alpha` is every letter, `upper`/`lower` every cased letter (and, under `(?i)`, both),
;; `alnum` a letter or a decimal digit — while `digit` stays ASCII 0-9, as `\d` does, and
;; `xdigit` the hex digits. A name that is not here keeps the old reading: `[[:foo:]]` is a set
;; of the characters `[:fo` followed by a `]`.
(def- regex-posix-classes
  {"alpha" "\\p{Alphabetic}"
   "alnum" "\\p{Alphabetic}\\p{Nd}"
   "digit" "0-9"
   "xdigit" "0-9A-Fa-f"
   "upper" "\\p{Uppercase}"
   "lower" "\\p{Lowercase}"
   "space" "\\s"
   "blank" "\\p{Zs}\\t"
   "punct" "\\p{P}\\p{S}"
   "cntrl" "\\p{Cc}"
   "graph" "[^\\s\\p{C}]"
   "print" "[^\\p{C}]"
   "word" "\\w"
   "ascii" "\\x00-\\x7F"
   "nonascii" "[^\\x00-\\x7F]"})

(defn- regex-posix-end (pcs: (vector string) i:int -> (or nil int))
  "Where the POSIX class `[:name:]` starting at `i` inside a set ends (the index past its
`:]`), or nil when there is none there — or its name is not one of [[regex-posix-classes]]."
  (when (and (= (regex-peek pcs i) "[") (= (regex-peek pcs (inc i)) ":"))
    (letrec (scan (fn (k:int name:string)
                    (let (c (regex-peek pcs k))
                      (cond
                        (and (= c ":") (= (regex-peek pcs (inc k)) "]"))
                          (when (contains? regex-posix-classes name) (+ k 2))
                        (and (string? c)
                          (includes? "abcdefghijklmnopqrstuvwxyz" c)
                          (< (string/length name) 8))
                          (scan (inc k) (str name c))
                        else nil))))
      (scan (+ i 2) ""))))

(defn- regex-posix-name (pcs i end)
  "The name of the POSIX class from `i` to `end` ([[regex-posix-end]]): what is between `[:`
and `:]`."
  (apply str (seq/subvec pcs (+ i 2) (- end 2))))

(defn- regex-set-body (pcs i chars ranges classes)
  "Collect a set's members until the closing `]`; returns [chars ranges classes next].
Three kinds live side by side inside one `[...]`: literal chars, `a-z` ranges, and
the classes — `\\d`/`\\w`/`\\s` and the POSIX `[:alpha:]` kind ([[regex-posix-end]]) — so
`[\\w.-]` (every character a file path is made of) says what it looks like it says."
  (let (c (regex-peek pcs i)
        posix-end (when (= c "[") (regex-posix-end pcs i)))
    (cond
      (nil? c) [chars ranges classes i]
      ; unterminated set → take what we have
      (= c "]") [chars ranges classes (inc i)]
      ;; a POSIX class: its name, as a string, among the classes
      (int? posix-end)
        (regex-set-body pcs
          posix-end
          chars
          ranges
          (cons (regex-posix-name pcs i posix-end) classes))
      (and (= c "\\") (contains? regex-class-escapes (regex-peek pcs (inc i))))
        (regex-set-body pcs
          (+ i 2)
          chars
          ranges
          (cons (get regex-class-escapes (regex-peek pcs (inc i))) classes))
      ;; one character — plain or escaped — alone, or the low end of a range: `a-z`,
      ;; `\x00-\x7F`, `\--z`
      else
        (let (lo (regex-set-char pcs i)
              after (+ i (regex-set-char-length pcs i))
              hi (regex-set-range-end pcs after))
          (if (and (string? lo) (string? hi))
            (regex-set-body pcs
              (+ after 1 (regex-set-char-length pcs (inc after)))
              chars
              (cons [(string/char->int lo) (string/char->int hi)] ranges)
              classes)
            (regex-set-body pcs after (cons lo chars) ranges classes))))))

(defn- regex-set (pcs i)
  "Parse a `[...]` set whose body starts at `i` (just past `[`); returns [atom next]."
  (let (neg (= (regex-peek pcs i) "^")
        start (if neg (inc i) i)
        [chars ranges classes nxt] (regex-set-body pcs start (list) (list) (list)))
    ;; Store the plain members as a STRING so membership is a native `includes?` (one
    ;; Rust scan) instead of `any?` walking a list of 1-char strings per input char.
    ;; Ranges and classes are lists beside it, almost always EMPTY — and the whole
    ;; test runs once per distinct (state-set, char) behind the DFA memo either way.
    [{:t :set :neg neg :chars (apply str chars) :ranges ranges :classes classes} nxt]))

(defn- regex-fold-flag (pcs i)
  "The case flag a group opening at `i` (a `(`) sets, as `[fold? scoped? body]`, or nil when
it sets none: `(?i)` and `(?-i)` turn case folding on or off for the rest of the enclosing
group (the whole pattern at the top), `(?i:…)` and `(?-i:…)` for the group they open, whose
body starts at `body`."
  (when (= (regex-peek pcs (inc i)) "?")
    (let (negated (= (regex-peek pcs (+ i 2)) "-")
          flag-at (if negated (+ i 3) (+ i 2))
          closer (regex-peek pcs (inc flag-at)))
      (when (and (= (regex-peek pcs flag-at) "i") (or (= closer ")") (= closer ":")))
        [(not negated) (= closer ":") (+ flag-at 2)]))))

(defn- regex-atom (pcs i)
  "Parse one atom at `i`; returns [atom next]."
  (let (c (regex-peek pcs i)
        flag (when (= c "(") (regex-fold-flag pcs i)))
    (cond
      ;; `(?i)` / `(?-i)`: zero-width, the engine reads it with the scope Perl gives it
      (and flag (not (second flag))) [{:t :fold :on (first flag)} (nth flag 2)]
      (and flag (second flag))
        (let ([alt nxt] (regex-alt pcs (nth flag 2)))
          [{:t :group :alt alt :cap false :fold (first flag)} (inc nxt)])
      (= c "(")
      ;; `(?:` opens a group that only groups; a bare `(` also CAPTURES, and is
      ;; numbered by the pass below rather than here (the number is the order of
      ;; the opening parens, which a recursive-descent parser sees in the right
      ;; order but would have to thread a counter through every rule to record).
        (let (noncap (and (= (regex-peek pcs (inc i)) "?") (= (regex-peek pcs (+ i 2)) ":"))
              [alt nxt] (regex-alt pcs (if noncap (+ i 3) (inc i))))
          [{:t :group :alt alt :cap (not noncap)} (inc nxt)])
      ; (inc nxt) skips the ')'
      (= c "[") (regex-set pcs (inc i))
      (= c ".") [{:t :any} (inc i)]
      (= c "^") [{:t :bol} (inc i)]
      (= c "$") [{:t :eol} (inc i)]
      (= c "\\") (regex-escape pcs (inc i))
      else [{:t :lit :c c} (inc i)])))

(defn- regex-digits-at (pcs: (vector string) i:int acc:string -> (tuple string int))
  "Consume digits at `i`; returns [text next] (text is \"\" when there are none)."
  (let (c (regex-peek pcs i))
    (if (and c (includes? "0123456789" c))
      (regex-digits-at pcs (inc i) (str acc c))
      [acc i])))
;; The one declaration on the parser chain: `pcs` is the pattern as a vector of
;; characters and `i` an index into it. `regex-seq`/`regex-alt` are top-level `defn-`s
;; (under a `check-allow`, which does not hide them from inference), so
;; the whole chain derives `int` from here and from `regex-parse`'s `0`.

;; The most a `{m,n}` may count to. The engine compiles a count into copies of the atom
;; (there is no counting state in a Thompson NFA), so `a{1,100000}` would be 100k
;; states and a failure that looks like a bug in the engine rather than in the pattern.
;; A pattern asking for more than this is refused out loud, which is the one place
;; this parser raises: every other malformation degrades to literal characters,
;; because a stray `{` or `*` in a hand-written pattern usually MEANT the character.
(def *max-repeat* 1000)

(defn- regex-brace (pcs i)
  "Parse `{m}` / `{m,}` / `{m,n}` whose body starts at `i` (just past `{`); returns
[lo hi next] with `hi` nil for an open end, or nil when this is not a repetition at
all — in which case the caller treats the `{` as the literal character it looks like."
  (let ([lo-text i2] (regex-digits-at pcs i "")
        c (regex-peek pcs i2))
    (cond
      (= lo-text "") nil
      (= c "}") [(reflect/read-string lo-text) (reflect/read-string lo-text) (inc i2)]
      ;; A backwards range (`{3,1}`) is malformed, so it means its characters too.
      (= c ",")
        (let ([hi-text i3] (regex-digits-at pcs (inc i2) "")
              lo (reflect/read-string lo-text)
              hi (if (= hi-text "") nil (reflect/read-string hi-text)))
          (when (and (= (regex-peek pcs i3) "}") (or (nil? hi) (<= lo hi)))
            [lo hi (inc i3)]))
      else nil)))

;; Counted repetition stays counted: the engine has `{m,n}` itself. Expanding it into
;; copies here copied a capturing group too, so `(a*){2}(x)` had three groups and every
;; group after it was misnumbered (found by the Fowler corpus); one group repeated keeps
;; one number and the last iteration's capture.
(defn- regex-repeat (atom lo hi greedy)
  "`atom{lo,hi}` as a counted piece; `hi` is nil for an open end."
  (when (> (or hi lo) *max-repeat*)
    (%raise {:kind :parse
             :code "E0090"
             :message (str "regex: {"
                        lo
                        ","
                        (or hi "")
                        "} repeats more than "
                        *max-repeat*
                        " times")}))
  {:q :count :lo lo :hi hi :a atom :greedy greedy})

(defn- regex-lazy? (pcs i)
  "A `?` directly after a quantifier makes it lazy (`a*?`), rather than being a
quantifier of its own. It used to parse as a literal `?`, which no other engine
does and nothing could have wanted."
  (= (regex-peek pcs i) "?"))

(defn- regex-piece (pcs i)
  "Parse an atom plus an optional quantifier; returns [piece next]."
  (let ([atom i2] (regex-atom pcs i)
        q (regex-peek pcs i2)
        lazy (regex-lazy? pcs (inc i2))
        greedy (not lazy)
        after (if lazy (+ i2 2) (inc i2)))
    (cond
      (= q "*") [{:q :star :a atom :greedy greedy} after]
      (= q "+") [{:q :plus :a atom :greedy greedy} after]
      (= q "?") [{:q :opt :a atom :greedy greedy} after]
      (= q "{")
        (let (brace (regex-brace pcs (inc i2)))
          (if (nil? brace)
            ; not a repetition — the `{` was just a brace
            [atom i2]
            (let ([lo hi nxt] brace
                  lazy2 (regex-lazy? pcs nxt))
              [(regex-repeat atom lo hi (not lazy2)) (if lazy2 (inc nxt) nxt)])))
      else [atom i2])))

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-seq (pcs i)
    "Parse a branch — pieces until `|`, `)`, or end; returns [pieces next]."
    (let (c (regex-peek pcs i))
      (if (or (nil? c) (= c "|") (= c ")"))
        [(list) i]
        (let ([piece i2] (regex-piece pcs i)
              [rest i3] (regex-seq pcs i2))
          [(cons piece rest) i3])))))

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-alt (pcs i)
    "Parse an alternation — branches separated by `|`; returns [branches next]."
    (let ([branch i2] (regex-seq pcs i))
      (if (= (regex-peek pcs i2) "|")
        (let ([rest i3] (regex-alt pcs (inc i2)))
          [(cons branch rest) i3])
        [(list branch) i2]))))

(defn- regex-literal-strays (pcs:vector i:int depth:int in-set:bool acc:vector -> vector)
  "`pcs` with every `)` that closes no group escaped, so the parser reads it as the
character it is. Without this the parser's top level STOPPED at one: `a)x` was the
pattern `a`, and everything after the paren was silently gone. Sets and escapes are
walked the parser's way — a `)` inside `[...]` or after a backslash is not a paren."
  (if (>= i (count pcs))
    acc
    (let (c (nth pcs i)
          next (regex-peek pcs (inc i))
          posix-end (if in-set (regex-posix-end pcs i) nil))
      (cond
        (= c "\\")
          (regex-literal-strays pcs
            (+ i 2)
            depth
            in-set
            (if (nil? next) (conj acc c) (conj (conj acc c) next)))
        ;; a POSIX class inside a set (`[[:alpha:])]`) is passed whole: its `]` closes nothing
        (int? posix-end)
          (regex-literal-strays pcs posix-end depth true (into acc (seq/subvec pcs i posix-end)))
        in-set (regex-literal-strays pcs (inc i) depth (not (= c "]")) (conj acc c))
        (= c "[")
        ;; a set runs to the first `]` after its `[`, whatever is between — `[]` and `[^]`
        ;; close at once — which is how the parser reads one
          (regex-literal-strays pcs (inc i) depth true (conj acc c))
        (= c "(") (regex-literal-strays pcs (inc i) (inc depth) false (conj acc c))
        (= c ")")
          (if (> depth 0)
            (regex-literal-strays pcs (inc i) (dec depth) false (conj acc c))
            (regex-literal-strays pcs (inc i) depth false (conj (conj acc "\\") c)))
        else (regex-literal-strays pcs (inc i) depth false (conj acc c))))))

(defn- regex-parse (pattern)
  "Parse `pattern` into its list of top-level branches."
  (first (regex-alt (regex-literal-strays (apply vector (string/->list pattern)) 0 0 false []) 0)))

;; ---- translate: the AST as the native engine's syntax --------------------------
;; Every construct is written out explicitly rather than handed through, so the native
;; syntax's own readings never leak into the dialect: `.` is `(?s:.)` (the dialect's dot
;; crosses newlines, the engine's does not by default), `^`/`$` are `\A`/`\z` (the whole
;; string, whatever flags), `\d` is `[0-9]` (the engine's is every Unicode digit, which
;; `string/->number` cannot read), and every literal the engine could read as syntax is
;; escaped. A quantified atom is wrapped in `(?:…)`, so a quantifier always applies to
;; exactly the atom the parser saw — including a zero-width one.

(def- regex-meta-chars "\\.+*?()|[]{}^$#&-~")
;; The characters the engine gives a meaning to, in a set or out of one — its own escape
;; list. Deliberately not "all punctuation": since regex 1.10 `\<` and `\>` are word
;; boundaries, so escaping `<` would change what it matches.

(defn- regex-lit (c:string -> string)
  "The literal character `c` in the engine's syntax: escaped when it is one of the
characters the engine reads as syntax, itself otherwise."
  (if (includes? regex-meta-chars c) (str "\\" c) c))

(defn- regex-class-src (k)
  "A `\\d`/`\\w`/`\\s` class or its negation `\\D`/`\\W`/`\\S`, standing alone. `\\d` is
ASCII, so its negation is the ASCII complement, not the engine's Unicode `\\D`."
  (case k
    :digit "[0-9]"
    :word "\\w"
    :not-digit "[^0-9]"
    :not-word "\\W"
    :not-space "\\S"
    "\\s"))

(defn- regex-class-member-src (k)
  "A `\\d`/`\\w`/`\\s` class or its negation written inside a set, or a POSIX class by its
name ([[regex-posix-classes]]). The ASCII complement of `\\d` is a nested class, which the
engine reads as a union member."
  (if (string? k)
    (get regex-posix-classes k)
    (case k
      :digit "0-9"
      :word "\\w"
      :not-digit "[^0-9]"
      :not-word "\\W"
      :not-space "\\S"
      "\\s")))

(defn- regex-set-src (a)
  "A `[...]` set. A range written backwards (`[z-a]`) holds nothing, so it is dropped
rather than handed to the engine, which refuses one. A set with no members at all is
`[]` — nothing — or `[^]` — anything."
  (let (chars (string/join (map (string/->list (:chars a)) regex-lit) "")
        ranges (string/join (map (seq/filter (:ranges a) (fn ([lo hi]) (<= lo hi)))
                              (fn ([lo hi])
                                (str (regex-lit (string/int->char lo))
                                  "-"
                                  (regex-lit (string/int->char hi)))))
                 "")
        classes (string/join (map (:classes a) regex-class-member-src) "")
        members (str chars ranges classes))
    (cond
      (and (= members "") (:neg a)) "(?s:.)"
      (= members "") "[^\\s\\S]"
      else (str "[" (if (:neg a) "^" "") members "]"))))

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-atom-src (a)
    "One atom in the engine's syntax."
    (case (:t a)
      :lit (regex-lit (:c a))
      :any "(?s:.)"
      :bol "\\A"
      :eol "\\z"
      :wordb "\\b"
      :nwordb "\\B"
      :class (regex-class-src (:k a))
      :set (regex-set-src a)
      :group
        (str (cond (= true (:fold a)) "(?i:" (= false (:fold a)) "(?-i:" (:cap a) "(" else "(?:")
          (regex-alt-src (:alt a))
          ")")
      :fold (if (:on a) "(?i)" "(?-i)")
      :line-any "[^\\n]"
      :line-start "(?m:^)"
      :line-end "(?m:$)"
      (error "regex: no translation for atom " (pr-str a)))))

(check-allow :non-tail-recursion
  (defn- regex-piece-src (p)
    "An atom and its quantifier, if it has one."
    (if (nil? (:q p))
      (regex-atom-src p)
      (str "(?:"
        (regex-atom-src (:a p))
        ")"
        (case (:q p)
          :star "*"
          :plus "+"
          :count (str "{" (:lo p) "," (if (nil? (:hi p)) "" (:hi p)) "}")
          "?")
        (if (= false (:greedy p)) "?" "")))))

(check-allow :non-tail-recursion
  (defn- regex-alt-src (branches)
    "An alternation — the whole pattern, or a group's body."
    (string/join (map branches (fn (branch) (string/join (map branch regex-piece-src) ""))) "|")))

;; pattern -> its translation, and pattern -> that anchored to the whole string. Two tables
;; of strings rather than one of pairs: a table read hands back a COPY, and a `string?` guard
;; is what proves to the checker what came back.
(def- regex-search-cache (table/new))
(def- regex-whole-cache (table/new))

(defn- regex-search-src (pattern)
  "`pattern` translated for the engine. Memoised — a pattern in a program is nearly always
a literal, and the engine caches its compiled form under exactly this text."
  (let (hit (table/get regex-search-cache pattern))
    (if (string? hit)
      hit
      (let (src (regex-alt-src (regex-parse pattern)))
        (table/put regex-search-cache pattern src)
        src))))

(defn- regex-whole-src (pattern)
  "`pattern` translated and anchored to the entire string, for `matches?`. Memoised."
  (let (hit (table/get regex-whole-cache pattern))
    (if (string? hit)
      hit
      (let (src (str "\\A(?:" (regex-search-src pattern) ")\\z"))
        (table/put regex-whole-cache pattern src)
        src))))

;; ---- does it match? -------------------------------------------------------------
;; Every string search takes an optional `opts` map, as the rope searches do: `{:fold? true}`
;; ignores case, the same as writing `(?i)` at the pattern's start — which is all it does, so
;; a string search and a rope search under the same flag agree character for character.

(defn- regex-opts-pattern (pattern opts)
  "`pattern` with what `opts` asks for written into it: `(?i)` in front under `:fold?`."
  (if (= true (:fold? opts)) (str "(?i)" pattern) pattern))

(defn match? (pattern:any s:string &optional (opts:map {}) -> bool)
  "True if `pattern` matches anywhere in `s` (a search). `^`/`$` anchor to the
start/end of the whole string, so e.g. `(match? \"\\\\.blsp$\" name)` tests a suffix.
`opts`: `{:fold? true}` ignores case (as `(?i)` does), here and in every string search.

    (regex/match? \"^a\" \"abc\")                     ;=> true
    (regex/match? \"^a\" \"ABC\" {:fold? true})       ;=> true
    (regex/match? \"(?i)password:\" \"Password:\")    ;=> true"
  (%regex-match? (regex-search-src (regex-opts-pattern pattern opts)) s))

(defn matches? (pattern:any s:string &optional (opts:map {}) -> bool)
  "True if `pattern` matches the **entire** string `s` (anchored both ends).

    (regex/matches? \"[0-9]+\" \"a1b22\")   ;=> false   ; the WHOLE string must match"
  (%regex-match? (regex-whole-src (regex-opts-pattern pattern opts)) s))

;; ---- where, and with which groups -----------------------------------------------

(defn find (pattern:any s:string &optional (opts:map {}) -> (or nil (map keyword any)))
  "The leftmost match of `pattern` in `s`, or nil. The match is
`{:start :end :text :groups [...]}` — half-open char offsets, the matched text, and
one entry per `(...)` group in the pattern (each itself `{:start :end :text}`, or
nil for a group that did not participate). Group numbering is the order of the
opening parens; `(?:...)` groups are not numbered.

    (get (regex/find \"([\\\\w.]+):(\\\\d+)\" \"at worker.ex:42\") :text)     ;=> \"worker.ex:42\"
    (get (regex/find \"([\\\\w.]+):(\\\\d+)\" \"at worker.ex:42\") :start)    ;=> 3
    (get (second (get (regex/find \"(a)-(b)\" \"a-b\") :groups)) :text)   ;=> \"b\"
    (regex/find \"zzz\" \"abc\")                                          ;=> nil

Leftmost-first, like Perl and unlike POSIX: of two matches starting at the same
place, the one the pattern's own alternation and greediness prefer wins."
  (%regex-find (regex-search-src (regex-opts-pattern pattern opts)) s 0))

(defn find-all (pattern:any s:string &optional (opts:map {}) -> (vector (map keyword any)))
  "Every non-overlapping match of `pattern` in `s`, left to right, as a vector of the
maps `find` returns (empty when there are none). Scanning resumes at each match's
end, and steps one character past an EMPTY match so a pattern that can match nothing
(`a*`) terminates instead of finding the same empty match forever.

    (map (regex/find-all \"\\\\d+\" \"a1b22c333\") (fn (m) (get m :text)))   ;=> (\"1\" \"22\" \"333\")"
  (%regex-find-all (regex-search-src (regex-opts-pattern pattern opts)) s))

;; ---- searching a rope, and a search box's pattern (ADR-540) ------------------------
;; An editor's buffer is a rope, and the functions above take a string: flattening the rope
;; to search it is a copy of the document per search, and incremental search searches on
;; every key. The `rope-*` functions search the rope in place — the pattern's lazy DFA
;; stepped over its leaves (`crates/lisp/src/builtins/rope_regex.rs`) — so a search costs
;; the distance to its match, and a count can be taken in slices that add up exactly.
;;
;; They read the pattern as a BUFFER search does, Emacs's way, unless told otherwise: `^`
;; and `$` are a LINE's start and end, and `.` stops at a newline — so `a.*z` asks about a
;; line, not the rest of the file (`{:lines? false}` for the string meaning). `{:fold? true}`
;; ignores case (simple case folding, character for character). A match is never empty unless
;; `{:empty? true}` asks for one (a search box that stops on one, as Emacs's isearch does);
;; a count and a window's spans never include one.

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-lines-atom (a)
    "Atom `a` read the way a buffer search reads it: `.` short of a newline, `^`/`$` at a
line's ends."
    (case (:t a)
      :any {:t :line-any}
      :bol {:t :line-start}
      :eol {:t :line-end}
      :group (assoc a :alt (regex-lines-alt (:alt a)))
      a)))

(check-allow :non-tail-recursion
  (defn- regex-lines-alt (branches)
    "Every atom of an alternation read the buffer search's way ([[regex-lines-atom]])."
    (map branches
      (fn (branch)
        (map branch
          (fn (piece)
            (if (nil? (:q piece))
              (regex-lines-atom piece)
              (assoc piece :a (regex-lines-atom (:a piece))))))))))

(def- regex-rope-cache (table/new))

(defn- regex-rope-src (pattern opts)
  "`pattern` translated for a rope search under `opts` (`:fold?`, `:lines?` — on unless
false). Memoised by the pattern and its flags."
  (let (fold? (= true (:fold? opts))
        lines? (not (= false (:lines? opts)))
        key (str (if fold? "i" "-") (if lines? "m" "-") pattern)
        hit (table/get regex-rope-cache key))
    (if (string? hit)
      hit
      (let (ast (regex-parse pattern)
            src (str (if fold? "(?i)" "") (regex-alt-src (if lines? (regex-lines-alt ast) ast))))
        (table/put regex-rope-cache key src)
        src))))

(defn rope-find (pattern r from &optional (opts {}))
  "The first non-empty match of `pattern` in rope `r` starting at or after char index
`from`, as the map [[find]] answers (`{:start :end :text :groups}`, char offsets into the
rope), or nil. Searches the rope in place: the cost is the distance to the match, not the
size of the text. `opts`: `:fold?` ignores case; `:lines?` (on unless false) makes `^`/`$`
a line's ends and `.` stop at a newline, as a buffer search wants; `:empty?` lets an EMPTY
match be the answer (`x*` stops before the first character, as Emacs's `re-search-forward`
does) where by default one is stepped over; `:bound` (a char index) is where a match must END
by — a greedy pattern stops there rather than being refused, while `^`, `$` and `\\b` still read
the text past it (Emacs's BOUND, what a search confined to a region wants; ADR-554).

    (get (regex/rope-find \"o+\" (text/from-string \"foo boo\") 3) :start)                ;=> 5
    (get (regex/rope-find \"^b\" (text/from-string \"ab\\nbc\") 0) :start)                ;=> 3
    (get (regex/rope-find \"FOO\" (text/from-string \"a foo\") 0 {:fold? true}) :text)   ;=> \"foo\"
    (get (regex/rope-find \"x*\" (text/from-string \"ab x\") 0 {:empty? true}) :end)   ;=> 0
    (get (regex/rope-find \"a+\" (text/from-string \"aaaa\") 0 {:bound 2}) :end)       ;=> 2
    (regex/rope-find \"o$\" (text/from-string \"foo bar\") 0 {:bound 3})               ;=> nil"
  (%rope-regex-find r (regex-rope-src pattern opts) from (= true (:empty? opts)) (:bound opts)))

(defn rope-find-backward (pattern r before &optional (opts {}))
  "The non-empty match of `pattern` in rope `r` that starts LAST while ending at or before
char index `before` — Emacs's `re-search-backward` — as the map [[find]] answers, or nil.
Reads backward from `before`, so the cost is the distance to the match. `opts` as
[[rope-find]].

    (get (regex/rope-find-backward \"[fb]o+\" (text/from-string \"foo boo\") 7) :start)   ;=> 4
    (get (regex/rope-find-backward \"[fb]o+\" (text/from-string \"foo boo\") 4) :start)   ;=> 0
    (get (regex/rope-find-backward \"o+\" (text/from-string \"foo boo\") 7) :start)      ;=> 6"
  (%rope-regex-rfind r (regex-rope-src pattern opts) before (= true (:empty? opts))))

(defn rope-count (pattern r from limit &optional (opts {}))
  "`[n resume]`: how many non-overlapping, non-empty matches of `pattern` in rope `r`, scanned
from char index `from`, START before `limit`. `resume` is where the next slice begins — the
first match starting at or past `limit`, or the first point past it where no match is in
progress — or nil once the scan reached the end. Counting a large text in slices (`limit` a
little past `from` each time) adds up to exactly the whole count, and no slice costs much
more than its length: what a search's match count runs on while the editor stays
responsive. `(rope-count p r 0 at)` is how many matches start before `at`. `opts` as
[[rope-find]].

    (regex/rope-count \"ab\" (text/from-string \"ab ab ab\") 0 100)   ;=> [3 nil]
    (regex/rope-count \"ab\" (text/from-string \"ab ab ab\") 0 4)     ;=> [2 5]
    (regex/rope-count \"ab\" (text/from-string \"ab ab ab\") 0 6)     ;=> [2 6]"
  (%rope-regex-count r (regex-rope-src pattern opts) from limit))

(defn rope-spans (pattern r from to &optional (opts {}))
  "Every non-overlapping, non-empty match of `pattern` in rope `r` that starts in char range
`[from, to)`, as a vector of `[start end]` (an end may lie past `to`) — at most 4096. What
highlighting the matches in a window wants: the cost is the window, not the rope. `opts` as
[[rope-find]].

    (regex/rope-spans \"o+\" (text/from-string \"foo boo zoo\") 0 6)   ;=> [[1 3] [5 7]]"
  (%rope-regex-spans r (regex-rope-src pattern opts) from to))

(def- regex-escaped-chars "\\.*+?{}()[]^$|")

(defn escape (s:string -> string)
  "The pattern that matches the text `s` literally — every character the dialect gives a
meaning to escaped.

    (regex/escape \"a.b*\")                      ;=> \"a\\\\.b\\\\*\"
    (regex/match? (regex/escape \"(x)\") \"f(x)\")  ;=> true"
  (string/join (map (string/->list s)
                 (fn (c) (if (includes? regex-escaped-chars c) (str "\\" c) c)))
    ""))

(defn incomplete? (pattern:string -> bool)
  "True when `pattern` stops part-way through a construct — an unclosed `(` group or `[`
set, or a trailing backslash: what a search box is shown while its pattern is still being
typed (Emacs's `[incomplete input]`). The dialect reads such a pattern anyway, leniently, so
this is the only way to tell that the text is unfinished rather than meant.

    (regex/incomplete? \"foo(ba\")    ;=> true
    (regex/incomplete? \"[a-\")       ;=> true
    (regex/incomplete? \"foo(bar)\")  ;=> false
    (regex/incomplete? \"a)\")        ;=> false"
  (let (pcs (into [] (string/->list pattern))
        n (count pcs))
    (letrec (walk (fn (i depth in-set?)
                    (if (>= i n)
                      (or in-set? (> depth 0))
                      (let (c (nth pcs i)
                            posix-end (if in-set? (regex-posix-end pcs i) nil))
                        (cond
                          (= c "\\") (if (>= (inc i) n) true (walk (+ i 2) depth in-set?))
                          (int? posix-end) (walk posix-end depth true)
                          in-set? (walk (inc i) depth (not (= c "]")))
                          (= c "[") (walk (inc i) depth true)
                          (= c "(") (walk (inc i) (inc depth) false)
                          (= c ")") (walk (inc i) (math/max 0 (dec depth)) false)
                          else (walk (inc i) depth false))))))
      (walk 0 0 false))))

;; ---- lexing: a rule table, and a line rule ----------------------------------------

(defn tokenizer (rules:vector -> map)
  "The scanner value for `rules` (a vector of `[pattern tag]`) — what `tokens` takes in
place of the table itself: `{:patterns :tags}`, each pattern already translated, so a
lexer that holds one in a `def` translates its table once rather than per line.

    (regex/tokens (regex/tokenizer [[\"\\\\d+\" :n]]) \"a1\")   ;=> [{:start 1 :end 2 :text \"1\" :tag :n}]"
  {:patterns (into [] (map rules (fn (rule) (regex-search-src (first rule)))))
   :tags (into [] (map rules second))})

(defn tokens (rules:any s:string -> vector)
  "Scan `s` with `rules` — a vector of `[pattern tag]`, or a `tokenizer` of one — into a
vector of the tokens `{:start :end :text :tag}` (half-open char offsets, ascending,
non-overlapping). At the earliest position any rule matches, the FIRST rule in table order
that matches there wins, and it takes its LONGEST match; the scan resumes at the token's
end. A position no rule matches is skipped, and a rule's empty match never makes a token.
`^`/`$` anchor to the string's ends, and `\\b` is a word boundary anywhere in a rule.

    (map (regex/tokens [[\"#.*\" :comment] [\"[a-z]+\" :word]] \"ab # c\") (fn (t) [(get t :tag) (get t :text)]))   ;=> ([:word \"ab\"] [:comment \"# c\"])"
  (let (tz (if (map? rules) rules (tokenizer rules)))
    (%regex-tokens (:patterns tz) (:tags tz) s)))

(defn paint (prefix:string pattern:string suffix:string s:string -> any)
  "At the start of `s`: the `[start end]` of the text `pattern` matches between a `prefix`
matched at position 0 and a `suffix` matched after it — the group a `^prefix(pattern)suffix`
regex would paint — or nil when the line does not match. The prefix's longest match first,
then `pattern`'s longest end after which `suffix` matches (its shortest, when `pattern` is
lazy: it contains `*?`, `+?` or `??`), each backtracked when the rest cannot follow. The
empty pattern `\"\"` is an absent prefix or suffix.

    (regex/paint \"^\\\\s*\" \"\\\\[[^\\\\]]*\\\\]\" \"\" \"  [core] x\")   ;=> [2 8]"
  (%regex-paint (regex-search-src prefix)
    (regex-search-src pattern)
    (regex-search-src suffix)
    (or (includes? pattern "*?") (includes? pattern "+?") (includes? pattern "??"))
    s))

;; ---- replace / split, both written on find-all ------------------------------

(defn- regex-expand-loop (template:string m:any i:int acc:string -> string)
  "Expand `$0`..`$9` (and `$$` for a literal dollar) in a replacement template."
  (if (>= i (string/length template))
    acc
    (let (c (string/substring template i (inc i))
          d (when (< (inc i) (string/length template)) (string/substring template (inc i) (+ i 2))))
      (cond
        (and (= c "$") (= d "$")) (regex-expand-loop template m (+ i 2) (str acc "$"))
        (and (= c "$") d (includes? "0123456789" d))
          (let (k (reflect/read-string d)
                g (if (= k 0) m (nth (get m :groups) (dec k) nil)))
            (regex-expand-loop template m (+ i 2) (str acc (if g (get g :text) ""))))
        else (regex-expand-loop template m (inc i) (str acc c))))))

(defn- regex-replace-loop (s matches j at acc replacement)
  (if (>= j (count matches))
    (str acc (string/substring s at (string/length s)))
    (let (m (nth matches j)
          piece (if (fn? replacement)
                  (replacement m)
                  (regex-expand-loop replacement m 0 "")))
      (regex-replace-loop s
        matches
        (inc j)
        (get m :end)
        (str acc (string/substring s at (get m :start)) piece)
        replacement))))

(defn replace (pattern s replacement &optional (opts {}))
  "Replace every non-overlapping match of `pattern` in `s`. `replacement` is either a
template string, where `$0` is the whole match, `$1`..`$9` are the groups and `$$` is
a literal dollar, or a FUNCTION of the match map — which is the one to reach for when
the new text has to be computed rather than spliced.

    (regex/replace \"(\\\\w+)@(\\\\w+)\" \"a@b\" \"$2@$1\")                     ;=> \"b@a\"
    (regex/replace \"\\\\d+\" \"a1b22\" (fn (m) (str \"<\" (get m :text) \">\")))   ;=> \"a<1>b<22>\"

A group that did not participate expands to the empty string."
  (regex-replace-loop s (find-all pattern s opts) 0 0 "" replacement))

(defn- regex-split-loop (s matches j at acc)
  (if (>= j (count matches))
    (into acc [(string/substring s at (string/length s))])
    (let (m (nth matches j))
      (regex-split-loop s
        matches
        (inc j)
        (get m :end)
        (into acc [(string/substring s at (get m :start))])))))

(defn split (pattern:any s:string &optional (opts:map {}) -> any)
  "Split `s` on every non-overlapping match of `pattern`, returning the pieces between
them — the regex counterpart of `string/split`, which separates on a literal.

    (regex/split \"\\\\s*,\\\\s*\" \"a , b,c\")   ;=> [\"a\" \"b\" \"c\"]

Separators are dropped, and an empty piece between two adjacent separators is kept, so
the result always has one more element than there were matches."
  (regex-split-loop s (find-all pattern s opts) 0 0 []))
