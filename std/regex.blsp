;; std/regex.blsp — regular expressions: Brood's pattern LANGUAGE over a native engine.
;;
;; The split (ADR-389): this file is the POLICY — what a pattern means. Its parser reads
;; Brood's dialect into an AST and translates that into an unambiguous pattern for the
;; native engine (`regex-automata`, a lazy DFA and a Pike VM: linear in the input, no
;; backtracking). The engine is the MECHANISM, `crates/lisp/src/builtins/regex_native.rs`,
;; and only ever runs what the translation produced. Redefine the parser and every pattern
;; in the image means something else; the engine never needs to know.
;;
;; It used to be both. An engine written here — a Thompson NFA with a bitset DFA for
;; `match?` and a Pike VM for `find` — cost about half a millisecond to try a four-pattern
;; `file:line` table on one short line (2026-09-23), and an editor tries such a table on
;; every visible row. Natively it is microseconds.
;;
;; The dialect:
;;
;;   literals            a b c …
;;   .                   any one character, a newline included
;;   * + ?               greedy quantifiers (on the preceding atom or group)
;;   *? +? ??            lazy quantifiers — the shortest match, not the longest
;;   {m} {m,} {m,n}      counted repetition (expanded at parse time; *max-repeat* caps it)
;;   ^ $                 the start / end of the WHOLE string (never of a line)
;;   [...] [^...]        a set / negated set: literal chars, `a-z` ranges, and the
;;                       `\d`/`\w`/`\s` classes written inside the brackets
;;   \d                  an ASCII digit, 0-9 — what `string/->number` can read
;;   \w \s               a Unicode word character (letter, mark, digit, `_`) / whitespace
;;   \b \B               a word boundary / not one, by `\w`
;;   \x                  any other escaped character is that character: `\.` `\*`, and
;;                       `\n` is an `n` (write a newline as a newline)
;;   |                   alternation
;;   (...)  (?:...)      a capturing group, and a non-capturing one
;;
;; A malformed pattern is never an error: a stray `*`, `{` or `)` and an unterminated
;; `[` mean the characters they look like, because in a hand-written pattern they
;; usually did. The one refusal is a repetition past *max-repeat*.
;;
;; NOT supported: backreferences, lookaround, named groups.

(defmodule regex
  "Regular expressions: Brood's pattern language, matched by a native engine.

`(regex/match? pattern s)` searches `s` for `pattern` (anchors `^`/`$` tie to the
string's start/end); `(regex/matches? pattern s)` requires the whole string to
match. `(regex/find pattern s)` returns WHERE it matched and what each `(...)`
group captured, `find-all` every non-overlapping match, and `replace`/`split`
build on those. `tokens` lexes a line with a rule table, `paint` finds the text a
line rule colours.

The dialect: literals, `.`, `* + ?` (and their lazy `*? +? ??` forms), `{m,n}`,
`^ $`, `[...]`/`[^...]` sets with ranges and classes, `\\d \\w \\s \\b \\B`, escapes,
`|`, capturing `(...)` and non-capturing `(?:...)`. No backreferences or
lookaround. Each pattern is parsed once and compiled once, then cached.")

;; ---- parse: pattern string -> AST -------------------------------------------
;; A pattern parses to a list of BRANCHES (the top-level alternation); each branch
;; is a list of PIECES; a piece is an ATOM, optionally wrapped `{:q :star/:plus/:opt
;; :a atom}`. Atoms are tagged maps: {:t :lit :c c} {:t :any} {:t :bol} {:t :eol}
;; {:t :set :neg b :chars (…)} {:t :class :k :digit/:word/:space} {:t :group :alt …}.

(defn- regex-peek (pcs i) (if (< i (count pcs)) (nth pcs i) nil))
(sig regex-peek ((vector string) int -> (or nil string)))

; \. \* \\ … → that char, literal
(defn- regex-escape (pcs i)
  "Parse the atom after a backslash at `i`; returns [atom next]."
  (let (c (regex-peek pcs i))
    (cond
      (= c "d") [{:t :class :k :digit} (inc i)]
      (= c "w") [{:t :class :k :word} (inc i)]
      (= c "s") [{:t :class :k :space} (inc i)]
      ;; word-boundary assertions: zero-width, like the anchors
      (= c "b") [{:t :wordb} (inc i)]
      (= c "B") [{:t :nwordb} (inc i)]
      (nil? c) [{:t :lit :c "\\"} i]
      ; trailing backslash → literal
      else [{:t :lit :c c} (inc i)])))
(defn- regex-set-range-end (pcs i)
  "The upper character of an `a-z` range starting at `i`, or nil when there is none. A
`-` LAST in the set (`[a-]`) is a literal member, which is why the character after it
has to exist and not be `]`. Answers the character rather than a bool so the caller reads
it once, as the string the guard proved it is."
  (let (d (regex-peek pcs (inc i))
        hi (regex-peek pcs (+ i 2)))
    (if (and (= d "-") (not (nil? hi)) (not (= hi "]"))) hi nil)))

(defn- regex-set-body (pcs i chars ranges classes)
  "Collect a set's members until the closing `]`; returns [chars ranges classes next].
Three kinds live side by side inside one `[...]`: literal chars, `a-z` ranges, and
the `\\d`/`\\w`/`\\s` classes — so `[\\w.-]` (every character a file path is made
of) says what it looks like it says."
  (let (c (regex-peek pcs i))
    (cond
      (nil? c) [chars ranges classes i]
      ; unterminated set → take what we have
      (= c "]") [chars ranges classes (inc i)]
      ; consume the ]
      (= c "\\")
        (let (e (regex-peek pcs (inc i)))
          (cond
            (= e "d") (regex-set-body pcs (+ i 2) chars ranges (cons :digit classes))
            (= e "w") (regex-set-body pcs (+ i 2) chars ranges (cons :word classes))
            (= e "s") (regex-set-body pcs (+ i 2) chars ranges (cons :space classes))
            ; a trailing backslash is itself
            (nil? e) (regex-set-body pcs (inc i) (cons "\\" chars) ranges classes)
            ; `\]`, `\-`, `\\` → that char, literally
            else (regex-set-body pcs (+ i 2) (cons e chars) ranges classes)))
      else
        (let (hi (regex-set-range-end pcs i))
          (if hi
            (regex-set-body pcs
              (+ i 3)
              chars
              (cons [(string/char->int c) (string/char->int hi)] ranges)
              classes)
            (regex-set-body pcs (inc i) (cons c chars) ranges classes))))))

(defn- regex-set (pcs i)
  "Parse a `[...]` set whose body starts at `i` (just past `[`); returns [atom next]."
  (let (neg (= (regex-peek pcs i) "^")
        start (if neg (inc i) i)
        [chars ranges classes nxt] (regex-set-body pcs start (list) (list) (list)))
    ;; Store the plain members as a STRING so membership is a native `includes?` (one
    ;; Rust scan) instead of `any?` walking a list of 1-char strings per input char.
    ;; Ranges and classes are lists beside it, almost always EMPTY — and the whole
    ;; test runs once per distinct (state-set, char) behind the DFA memo either way.
    [{:t :set :neg neg :chars (apply str chars) :ranges ranges :classes classes} nxt]))

(defn- regex-atom (pcs i)
  "Parse one atom at `i`; returns [atom next]."
  (let (c (regex-peek pcs i))
    (cond
      (= c "(")
      ;; `(?:` opens a group that only groups; a bare `(` also CAPTURES, and is
      ;; numbered by the pass below rather than here (the number is the order of
      ;; the opening parens, which a recursive-descent parser sees in the right
      ;; order but would have to thread a counter through every rule to record).
        (let (noncap (and (= (regex-peek pcs (inc i)) "?") (= (regex-peek pcs (+ i 2)) ":"))
              [alt nxt] (regex-alt pcs (if noncap (+ i 3) (inc i))))
          [{:t :group :alt alt :cap (not noncap)} (inc nxt)])
      ; (inc nxt) skips the ')'
      (= c "[") (regex-set pcs (inc i))
      (= c ".") [{:t :any} (inc i)]
      (= c "^") [{:t :bol} (inc i)]
      (= c "$") [{:t :eol} (inc i)]
      (= c "\\") (regex-escape pcs (inc i))
      else [{:t :lit :c c} (inc i)])))

(defn- regex-digits-at (pcs i acc)
  "Consume digits at `i`; returns [text next] (text is \"\" when there are none)."
  (let (c (regex-peek pcs i))
    (if (and c (includes? "0123456789" c))
      (regex-digits-at pcs (inc i) (str acc c))
      [acc i])))
;; The one declaration on the parser chain: `pcs` is the pattern as a vector of
;; characters and `i` an index into it. `regex-seq`/`regex-alt` are top-level `defn-`s
;; (under a `check-allow`, which since 2026-09-17 no longer hides them from inference), so
;; the whole chain derives `int` from here and from `regex-parse`'s `0`.
(sig regex-digits-at ((vector string) int string -> (tuple string int)))

;; The most a `{m,n}` may expand to. Repetition is expanded into copies of the atom
;; (there is no counting state in a Thompson NFA), so `a{1,100000}` would be 100k
;; states and a hang that looks like a bug in the engine rather than in the pattern.
;; A pattern asking for more than this is refused out loud, which is the one place
;; this parser raises: every other malformation degrades to literal characters,
;; because a stray `{` or `*` in a hand-written pattern usually MEANT the character.
(def *max-repeat* 1000)

(defn- regex-brace (pcs i)
  "Parse `{m}` / `{m,}` / `{m,n}` whose body starts at `i` (just past `{`); returns
[lo hi next] with `hi` nil for an open end, or nil when this is not a repetition at
all — in which case the caller treats the `{` as the literal character it looks like."
  (let ([lo-text i2] (regex-digits-at pcs i "")
        c (regex-peek pcs i2))
    (cond
      (= lo-text "") nil
      (= c "}") [(reflect/read-string lo-text) (reflect/read-string lo-text) (inc i2)]
      (= c ",")
        (let ([hi-text i3] (regex-digits-at pcs (inc i2) ""))
          (when (= (regex-peek pcs i3) "}")
            [(reflect/read-string lo-text)
              (if (= hi-text "") nil (reflect/read-string hi-text))
              (inc i3)]))
      else nil)))

(defn- regex-repeat-copies (atom k acc)
  (if (<= k 0) acc (regex-repeat-copies atom (dec k) (cons atom acc))))

(defn- regex-repeat-opts (atom greedy k acc)
  (if (<= k 0)
    acc
    (regex-repeat-opts atom greedy (dec k) (cons {:q :opt :a atom :greedy greedy} acc))))

(defn- regex-repeat (atom lo hi greedy)
  "Expand `atom{lo,hi}` into a non-capturing group holding `lo` required copies plus
the optional tail — `a{2,4}` is `(?:aaa?a?)`, `a{2,}` is `(?:aaa*)`. Counted
repetition is sugar; the NFA has no counters."
  (when (> (or hi lo) *max-repeat*)
    (throw {:kind :parse
            :message (str "regex: {" lo "," (or hi "") "} repeats more than " *max-repeat* " times")}))
  (let (required (regex-repeat-copies atom lo (list))
        tail (if (nil? hi)
               (list {:q :star :a atom :greedy greedy})
               (regex-repeat-opts atom greedy (- hi lo) (list))))
    {:t :group :alt (list (append required tail)) :cap false}))

(defn- regex-lazy? (pcs i)
  "A `?` directly after a quantifier makes it lazy (`a*?`), rather than being a
quantifier of its own. It used to parse as a literal `?`, which no other engine
does and nothing could have wanted."
  (= (regex-peek pcs i) "?"))

(defn- regex-piece (pcs i)
  "Parse an atom plus an optional quantifier; returns [piece next]."
  (let ([atom i2] (regex-atom pcs i)
        q (regex-peek pcs i2)
        lazy (regex-lazy? pcs (inc i2))
        greedy (not lazy)
        after (if lazy (+ i2 2) (inc i2)))
    (cond
      (= q "*") [{:q :star :a atom :greedy greedy} after]
      (= q "+") [{:q :plus :a atom :greedy greedy} after]
      (= q "?") [{:q :opt :a atom :greedy greedy} after]
      (= q "{")
        (let (brace (regex-brace pcs (inc i2)))
          (if (nil? brace)
            ; not a repetition — the `{` was just a brace
            [atom i2]
            (let ([lo hi nxt] brace
                  lazy2 (regex-lazy? pcs nxt))
              [(regex-repeat atom lo hi (not lazy2)) (if lazy2 (inc nxt) nxt)])))
      else [atom i2])))

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-seq (pcs i)
    "Parse a branch — pieces until `|`, `)`, or end; returns [pieces next]."
    (let (c (regex-peek pcs i))
      (if (or (nil? c) (= c "|") (= c ")"))
        [(list) i]
        (let ([piece i2] (regex-piece pcs i)
              [rest i3] (regex-seq pcs i2))
          [(cons piece rest) i3])))))

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-alt (pcs i)
    "Parse an alternation — branches separated by `|`; returns [branches next]."
    (let ([branch i2] (regex-seq pcs i))
      (if (= (regex-peek pcs i2) "|")
        (let ([rest i3] (regex-alt pcs (inc i2)))
          [(cons branch rest) i3])
        [(list branch) i2]))))

(defn- regex-literal-strays (pcs i depth in-set acc)
  "`pcs` with every `)` that closes no group escaped, so the parser reads it as the
character it is. Without this the parser's top level STOPPED at one: `a)x` was the
pattern `a`, and everything after the paren was silently gone. Sets and escapes are
walked the parser's way — a `)` inside `[...]` or after a backslash is not a paren."
  (if (>= i (count pcs))
    acc
    (let (c (nth pcs i)
          next (regex-peek pcs (inc i)))
      (cond
        (= c "\\")
          (regex-literal-strays pcs
            (+ i 2)
            depth
            in-set
            (if (nil? next) (conj acc c) (conj (conj acc c) next)))
        in-set (regex-literal-strays pcs (inc i) depth (not (= c "]")) (conj acc c))
        (= c "[")
        ;; a set runs to the first `]` after its `[`, whatever is between — `[]` and `[^]`
        ;; close at once — which is how the parser reads one
          (regex-literal-strays pcs (inc i) depth true (conj acc c))
        (= c "(") (regex-literal-strays pcs (inc i) (inc depth) false (conj acc c))
        (= c ")")
          (if (> depth 0)
            (regex-literal-strays pcs (inc i) (dec depth) false (conj acc c))
            (regex-literal-strays pcs (inc i) depth false (conj (conj acc "\\") c)))
        :else (regex-literal-strays pcs (inc i) depth false (conj acc c))))))
(sig regex-literal-strays (vector int int bool vector -> vector))

(defn- regex-parse (pattern)
  "Parse `pattern` into its list of top-level branches."
  (first (regex-alt (regex-literal-strays (apply vector (string/->list pattern)) 0 0 false []) 0)))

;; ---- translate: the AST as the native engine's syntax --------------------------
;; Every construct is written out explicitly rather than handed through, so the native
;; syntax's own readings never leak into the dialect: `.` is `(?s:.)` (the dialect's dot
;; crosses newlines, the engine's does not by default), `^`/`$` are `\A`/`\z` (the whole
;; string, whatever flags), `\d` is `[0-9]` (the engine's is every Unicode digit, which
;; `string/->number` cannot read), and every literal the engine could read as syntax is
;; escaped. A quantified atom is wrapped in `(?:…)`, so a quantifier always applies to
;; exactly the atom the parser saw — including a zero-width one.

(def- regex-meta-chars "\\.+*?()|[]{}^$#&-~")
;; The characters the engine gives a meaning to, in a set or out of one — its own escape
;; list. Deliberately not "all punctuation": since regex 1.10 `\<` and `\>` are word
;; boundaries, so escaping `<` would change what it matches.

(defn- regex-lit (c)
  "The literal character `c` in the engine's syntax: escaped when it is one of the
characters the engine reads as syntax, itself otherwise."
  (if (includes? regex-meta-chars c) (str "\\" c) c))
(sig regex-lit (string -> string))

(defn- regex-class-src (k)
  "A `\\d`/`\\w`/`\\s` class, standing alone."
  (case k
    :digit "[0-9]"
    :word "\\w"
    "\\s"))

(defn- regex-class-member-src (k)
  "A `\\d`/`\\w`/`\\s` class written inside a set."
  (case k
    :digit "0-9"
    :word "\\w"
    "\\s"))

(defn- regex-set-src (a)
  "A `[...]` set. A range written backwards (`[z-a]`) holds nothing, so it is dropped
rather than handed to the engine, which refuses one. A set with no members at all is
`[]` — nothing — or `[^]` — anything."
  (let (chars (string/join (map (string/->list (:chars a)) regex-lit) "")
        ranges (string/join (map (seq/filter (:ranges a) (fn ([lo hi]) (<= lo hi)))
                              (fn ([lo hi])
                                (str (regex-lit (string/int->char lo))
                                  "-"
                                  (regex-lit (string/int->char hi)))))
                 "")
        classes (string/join (map (:classes a) regex-class-member-src) "")
        members (str chars ranges classes))
    (cond
      (and (= members "") (:neg a)) "(?s:.)"
      (= members "") "[^\\s\\S]"
      :else (str "[" (if (:neg a) "^" "") members "]"))))

;; check-allow: deliberately non-tail — depth = pattern nesting, not subject length.
(check-allow :non-tail-recursion
  (defn- regex-atom-src (a)
    "One atom in the engine's syntax."
    (case (:t a)
      :lit (regex-lit (:c a))
      :any "(?s:.)"
      :bol "\\A"
      :eol "\\z"
      :wordb "\\b"
      :nwordb "\\B"
      :class (regex-class-src (:k a))
      :set (regex-set-src a)
      :group (str (if (:cap a) "(" "(?:") (regex-alt-src (:alt a)) ")")
      (error "regex: no translation for atom " (pr-str a)))))

(check-allow :non-tail-recursion
  (defn- regex-piece-src (p)
    "An atom and its quantifier, if it has one."
    (if (nil? (:q p))
      (regex-atom-src p)
      (str "(?:"
        (regex-atom-src (:a p))
        ")"
        (case (:q p)
          :star "*"
          :plus "+"
          "?")
        (if (= false (:greedy p)) "?" "")))))

(check-allow :non-tail-recursion
  (defn- regex-alt-src (branches)
    "An alternation — the whole pattern, or a group's body."
    (string/join (map branches (fn (branch) (string/join (map branch regex-piece-src) ""))) "|")))

;; pattern -> its translation, and pattern -> that anchored to the whole string. Two tables
;; of strings rather than one of pairs: a table read hands back a COPY, and a `string?` guard
;; is what proves to the checker what came back.
(def- regex-search-cache (table/new))
(def- regex-whole-cache (table/new))

(defn- regex-search-src (pattern)
  "`pattern` translated for the engine. Memoised — a pattern in a program is nearly always
a literal, and the engine caches its compiled form under exactly this text."
  (let (hit (table/get regex-search-cache pattern))
    (if (string? hit)
      hit
      (let (src (regex-alt-src (regex-parse pattern)))
        (table/put regex-search-cache pattern src)
        src))))

(defn- regex-whole-src (pattern)
  "`pattern` translated and anchored to the entire string, for `matches?`. Memoised."
  (let (hit (table/get regex-whole-cache pattern))
    (if (string? hit)
      hit
      (let (src (str "\\A(?:" (regex-search-src pattern) ")\\z"))
        (table/put regex-whole-cache pattern src)
        src))))

;; ---- does it match? -------------------------------------------------------------

(defn match? (pattern s)
  "True if `pattern` matches anywhere in `s` (a search). `^`/`$` anchor to the
start/end of the whole string, so e.g. `(match? \"\\\\.blsp$\" name)` tests a suffix.

    (regex/match? \"^a\" \"abc\")   → true"
  (%regex-match? (regex-search-src pattern) s))
(sig match? (any string -> bool))

(defn matches? (pattern s)
  "True if `pattern` matches the **entire** string `s` (anchored both ends).

    (regex/matches? \"[0-9]+\" \"a1b22\")   → false   ; the WHOLE string must match"
  (%regex-match? (regex-whole-src pattern) s))
(sig matches? (any string -> bool))

;; ---- where, and with which groups -----------------------------------------------

(defn find (pattern s)
  "The leftmost match of `pattern` in `s`, or nil. The match is
`{:start :end :text :groups [...]}` — half-open char offsets, the matched text, and
one entry per `(...)` group in the pattern (each itself `{:start :end :text}`, or
nil for a group that did not participate). Group numbering is the order of the
opening parens; `(?:...)` groups are not numbered.

    (get (regex/find \"([\\\\w.]+):(\\\\d+)\" \"at worker.ex:42\") :text)     → \"worker.ex:42\"
    (get (regex/find \"([\\\\w.]+):(\\\\d+)\" \"at worker.ex:42\") :start)    → 3
    (get (second (get (regex/find \"(a)-(b)\" \"a-b\") :groups)) :text)   → \"b\"
    (regex/find \"zzz\" \"abc\")                                          → nil

Leftmost-first, like Perl and unlike POSIX: of two matches starting at the same
place, the one the pattern's own alternation and greediness prefer wins."
  (%regex-find (regex-search-src pattern) s 0))
(sig find (any string -> (or nil (map keyword any))))

(defn find-all (pattern s)
  "Every non-overlapping match of `pattern` in `s`, left to right, as a vector of the
maps `find` returns (empty when there are none). Scanning resumes at each match's
end, and steps one character past an EMPTY match so a pattern that can match nothing
(`a*`) terminates instead of finding the same empty match forever.

    (map (regex/find-all \"\\\\d+\" \"a1b22c333\") (fn (m) (get m :text)))   → (\"1\" \"22\" \"333\")"
  (%regex-find-all (regex-search-src pattern) s))
(sig find-all (any string -> (vector (map keyword any))))

;; ---- lexing: a rule table, and a line rule ----------------------------------------

(defn tokenizer (rules)
  "The scanner value for `rules` (a vector of `[pattern tag]`) — what `tokens` takes in
place of the table itself: `{:patterns :tags}`, each pattern already translated, so a
lexer that holds one in a `def` translates its table once rather than per line.

    (regex/tokens (regex/tokenizer [[\"\\\\d+\" :n]]) \"a1\")   → [{:start 1 :end 2 :text \"1\" :tag :n}]"
  {:patterns (into [] (map rules (fn (rule) (regex-search-src (first rule)))))
   :tags (into [] (map rules second))})
(sig tokenizer (vector -> map))

(defn tokens (rules s)
  "Scan `s` with `rules` — a vector of `[pattern tag]`, or a `tokenizer` of one — into a
vector of the tokens `{:start :end :text :tag}` (half-open char offsets, ascending,
non-overlapping). At the earliest position any rule matches, the FIRST rule in table order
that matches there wins, and it takes its LONGEST match; the scan resumes at the token's
end. A position no rule matches is skipped, and a rule's empty match never makes a token.
`^`/`$` anchor to the string's ends, and `\\b` is a word boundary anywhere in a rule.

    (map (regex/tokens [[\"#.*\" :comment] [\"[a-z]+\" :word]] \"ab # c\") (fn (t) [(get t :tag) (get t :text)]))   → ([:word \"ab\"] [:comment \"# c\"])"
  (let (tz (if (map? rules) rules (tokenizer rules)))
    (%regex-tokens (:patterns tz) (:tags tz) s)))
(sig tokens (any string -> vector))

(defn paint (prefix pattern suffix s)
  "At the start of `s`: the `[start end]` of the text `pattern` matches between a `prefix`
matched at position 0 and a `suffix` matched after it — the group a `^prefix(pattern)suffix`
regex would paint — or nil when the line does not match. The prefix's longest match first,
then `pattern`'s longest end after which `suffix` matches (its shortest, when `pattern` is
lazy: it contains `*?`, `+?` or `??`), each backtracked when the rest cannot follow. The
empty pattern `\"\"` is an absent prefix or suffix.

    (regex/paint \"^\\\\s*\" \"\\\\[[^\\\\]]*\\\\]\" \"\" \"  [core] x\")   → [2 8]"
  (%regex-paint (regex-search-src prefix)
    (regex-search-src pattern)
    (regex-search-src suffix)
    (or (includes? pattern "*?") (includes? pattern "+?") (includes? pattern "??"))
    s))
(sig paint (string string string string -> any))

;; ---- replace / split, both written on find-all ------------------------------

(defn- regex-expand-loop (template m i acc)
  "Expand `$0`..`$9` (and `$$` for a literal dollar) in a replacement template."
  (if (>= i (string/length template))
    acc
    (let (c (string/substring template i (inc i))
          d (when (< (inc i) (string/length template)) (string/substring template (inc i) (+ i 2))))
      (cond
        (and (= c "$") (= d "$")) (regex-expand-loop template m (+ i 2) (str acc "$"))
        (and (= c "$") d (includes? "0123456789" d))
          (let (k (reflect/read-string d)
                g (if (= k 0) m (nth (get m :groups) (dec k) nil)))
            (regex-expand-loop template m (+ i 2) (str acc (if g (get g :text) ""))))
        else (regex-expand-loop template m (inc i) (str acc c))))))
(sig regex-expand-loop (string any int string -> string))

(defn- regex-replace-loop (s matches j at acc replacement)
  (if (>= j (count matches))
    (str acc (string/substring s at (string/length s)))
    (let (m (nth matches j)
          piece (if (fn? replacement)
                  (replacement m)
                  (regex-expand-loop replacement m 0 "")))
      (regex-replace-loop s
        matches
        (inc j)
        (get m :end)
        (str acc (string/substring s at (get m :start)) piece)
        replacement))))

(defn replace (pattern s replacement)
  "Replace every non-overlapping match of `pattern` in `s`. `replacement` is either a
template string, where `$0` is the whole match, `$1`..`$9` are the groups and `$$` is
a literal dollar, or a FUNCTION of the match map — which is the one to reach for when
the new text has to be computed rather than spliced.

    (regex/replace \"(\\\\w+)@(\\\\w+)\" \"a@b\" \"$2@$1\")                     → \"b@a\"
    (regex/replace \"\\\\d+\" \"a1b22\" (fn (m) (str \"<\" (get m :text) \">\")))   → \"a<1>b<22>\"

A group that did not participate expands to the empty string."
  (regex-replace-loop s (find-all pattern s) 0 0 "" replacement))

(defn- regex-split-loop (s matches j at acc)
  (if (>= j (count matches))
    (into acc [(string/substring s at (string/length s))])
    (let (m (nth matches j))
      (regex-split-loop s
        matches
        (inc j)
        (get m :end)
        (into acc [(string/substring s at (get m :start))])))))

(defn split (pattern s)
  "Split `s` on every non-overlapping match of `pattern`, returning the pieces between
them — the regex counterpart of `string/split`, which separates on a literal.

    (regex/split \"\\\\s*,\\\\s*\" \"a , b,c\")   → [\"a\" \"b\" \"c\"]

Separators are dropped, and an empty piece between two adjacent separators is kept, so
the result always has one more element than there were matches."
  (regex-split-loop s (find-all pattern s) 0 0 []))
(sig split (any string -> any))
