;; std/regex.blsp — a small regular-expression engine, written in Brood.
;; (require 'regex).
;;
;; A practical subset — enough for tokenising, filename/type matching, and most
;; text-processing — implemented as a recursive-descent parser to an AST, which is
;; then **compiled to a Thompson NFA** (a flat state table) and matched by a
;; closure-free simulation loop. Like Erlang compiling `~r/…/` to a PCRE NFA once
;; and matching native, we compile the pattern once (memoised) and simulate it:
;; no per-step continuation closures, no catastrophic backtracking — linear in the
;; input. Pure Brood over the string/bit ops (no new kernel primitives). Supported:
;;
;;   literals            a b c …
;;   .                   any one character
;;   * + ?               greedy quantifiers (on the preceding atom or group)
;;   ^ $                 start / end of string anchors
;;   [...] [^...]        a character set / negated set (explicit chars; NO ranges yet)
;;   \d \w \s            digit / word (letter|digit|_) / whitespace classes
;;   \. \* …             escape — a metacharacter taken literally
;;   |                   alternation
;;   (...)               grouping (quantifiable; not a capture)
;;
;; NOT yet: ranges `[a-z]`, backreferences, lookaround, capture groups, `{m,n}`.
;; The NFA simulation is O(states × input), so even a pathological pattern stays
;; linear (unlike the old backtracker). Framework/tooling tier, opt-in.

(defmodule regex
  "A small regular-expression engine in pure Brood, compiled to a Thompson NFA.
`(require 'regex)`. `(regex/match? pattern s)` searches `s` for `pattern` (anchors
`^`/`$` tie to the string's start/end); `(regex/matches? pattern s)` requires the
whole string to match. The pattern is parsed and NFA-compiled once, then memoised.
Subset: literals, `.`, `* + ?`, `^ $`, `[...]`/`[^...]` sets (explicit chars),
`\\d \\w \\s`, escapes, `|`, and `(...)` groups. No ranges, captures, or
backreferences yet.")

;; ---- parse: pattern string -> AST -------------------------------------------
;; A pattern parses to a list of BRANCHES (the top-level alternation); each branch
;; is a list of PIECES; a piece is an ATOM, optionally wrapped `{:q :star/:plus/:opt
;; :a atom}`. Atoms are tagged maps: {:t :lit :c c} {:t :any} {:t :bol} {:t :eol}
;; {:t :set :neg b :chars (…)} {:t :class :k :digit/:word/:space} {:t :group :alt …}.

(defn regex--peek (pcs i) (if (< i (count pcs)) (nth pcs i) nil))

(defn regex--escape (pcs i)
  "Parse the atom after a backslash at `i`; returns [atom next]."
  (let (c (regex--peek pcs i))
    (cond
      (= c "d") [{:t :class :k :digit} (inc i)]
      (= c "w") [{:t :class :k :word} (inc i)]
      (= c "s") [{:t :class :k :space} (inc i)]
      (nil? c) [{:t :lit :c "\\"} i]
      ; trailing backslash → literal
      :else [{:t :lit :c c} (inc i)])))  ; \. \* \\ … → that char, literal

(defn regex--set-chars (pcs i acc)
  "Collect set members until the closing `]`; returns [chars next]."
  (let (c (regex--peek pcs i))
    (cond
      (nil? c) [acc i]
      ; unterminated set → take what we have
      (= c "]") [acc (inc i)]
      ; consume the ]
      :else (regex--set-chars pcs (inc i) (cons c acc)))))

(defn regex--set (pcs i)
  "Parse a `[...]` set whose body starts at `i` (just past `[`); returns [atom next]."
  (let (neg (= (regex--peek pcs i) "^")
        start (if neg (inc i) i)
        [chars nxt] (regex--set-chars pcs start (list)))
    ;; Store members as a STRING so membership is a native `string-contains?` (one
    ;; Rust scan) instead of `some?` walking a list of 1-char strings per input char.
    [{:t :set :neg neg :chars (apply str chars)} nxt]))

(defn regex--atom (pcs i)
  "Parse one atom at `i`; returns [atom next]."
  (let (c (regex--peek pcs i))
    (cond
      (= c "(") (let ([alt nxt] (regex--alt pcs (inc i)))
                  [{:t :group :alt alt} (inc nxt)])
      ; (inc nxt) skips the ')'
      (= c "[") (regex--set pcs (inc i))
      (= c ".") [{:t :any} (inc i)]
      (= c "^") [{:t :bol} (inc i)]
      (= c "$") [{:t :eol} (inc i)]
      (= c "\\") (regex--escape pcs (inc i))
      :else [{:t :lit :c c} (inc i)])))

(defn regex--piece (pcs i)
  "Parse an atom plus an optional quantifier; returns [piece next]."
  (let ([atom i2] (regex--atom pcs i)
        q (regex--peek pcs i2))
    (cond
      (= q "*") [{:q :star :a atom} (inc i2)]
      (= q "+") [{:q :plus :a atom} (inc i2)]
      (= q "?") [{:q :opt :a atom} (inc i2)]
      :else [atom i2])))

(defn regex--seq (pcs i)
  "Parse a branch — pieces until `|`, `)`, or end; returns [pieces next]."
  (let (c (regex--peek pcs i))
    (if (or (nil? c) (= c "|") (= c ")"))
      [(list) i]
      (let ([piece i2] (regex--piece pcs i)
            [rest i3] (regex--seq pcs i2))
        [(cons piece rest) i3]))))

(defn regex--alt (pcs i)
  "Parse an alternation — branches separated by `|`; returns [branches next]."
  (let ([branch i2] (regex--seq pcs i))
    (if (= (regex--peek pcs i2) "|")
      (let ([rest i3] (regex--alt pcs (inc i2)))
        [(cons branch rest) i3])
      [(list branch) i2])))

(defn regex--parse (pattern)
  "Parse `pattern` into its list of top-level branches."
  (first (regex--alt (apply vector (string->list pattern)) 0)))

;; ---- compile: AST -> Thompson NFA -------------------------------------------
;; The NFA is a flat vector of STATES; index 0 is always the accepting `:match`
;; state. A state is one of:
;;   {:t :char :test <test> :next s}   consume one char if `test` passes, go to s
;;   {:t :split :a s1 :b s2}           epsilon fork to s1 and s2 (no consume)
;;   {:t :bol :next s}                 epsilon to s, only when position = 0
;;   {:t :eol :next s}                 epsilon to s, only when position = n
;;   {:t :match}                       accept
;; A `test` is a tagged map picking the char predicate: {:kind :any},
;; {:kind :lit :c c}, {:kind :set :neg b :chars "…"}, {:kind :class :k :digit}.
;;
;; Construction is the classic Thompson build, threaded functionally: each
;; `regex--nfa-*` takes the state vector plus `nx` (the index to jump to once this
;; fragment matches) and returns `[start states']`. Quantifiers with a back-edge
;; (`*`/`+`) reserve their split slot first (a placeholder appended so the index is
;; live), compile the body pointing back at it, then `assoc` the real split in.

(defn regex--push (states st)
  "Append state `st`; return [its-index states']."
  [(count states) (into states [st])])

(defn regex--atom->test (a)
  "The char-predicate `test` for a consuming atom (lit/any/set/class)."
  (let (t (get a :t))
    (cond
      (= t :lit)   {:kind :lit :c (get a :c)}
      (= t :any)   {:kind :any}
      (= t :set)   {:kind :set :neg (get a :neg) :chars (get a :chars)}
      (= t :class) {:kind :class :k (get a :k)}
      :else        {:kind :any})))

(defn regex--nfa-atom (a nx states)
  "Compile one atom into states leading to `nx`; returns [start states']."
  (let (t (get a :t))
    (cond
      (= t :group) (regex--nfa-alt (get a :alt) nx states)
      (= t :bol)   (regex--push states {:t :bol :next nx})
      (= t :eol)   (regex--push states {:t :eol :next nx})
      :else        (regex--push states {:t :char :test (regex--atom->test a) :next nx}))))

(defn regex--nfa-piece (p nx states)
  "Compile a piece (atom + optional quantifier) leading to `nx`; [start states']."
  (let (q (get p :q))
    (cond
      (nil? q)    (regex--nfa-atom p nx states)
      (= q :opt)  (let ([as st1] (regex--nfa-atom (get p :a) nx states))
                    (regex--push st1 {:t :split :a as :b nx}))
      ;; `*`: L = split(body, nx); body loops back to L; enter at L (zero-or-more).
      (= q :star) (let (li (count states)
                        st0 (into states [{:t :split :a 0 :b 0}])
                        [as st1] (regex--nfa-atom (get p :a) li st0)
                        st2 (assoc st1 li {:t :split :a as :b nx}))
                    [li st2])
      ;; `+`: same wiring, but enter at the body (one required), then L loops.
      (= q :plus) (let (li (count states)
                        st0 (into states [{:t :split :a 0 :b 0}])
                        [as st1] (regex--nfa-atom (get p :a) li st0)
                        st2 (assoc st1 li {:t :split :a as :b nx}))
                    [as st2])
      :else       (regex--nfa-atom p nx states))))

(defn regex--nfa-seq (pieces nx states)
  "Chain a branch's pieces; each piece's exit is the next piece's start. [start states']."
  (if (empty? pieces)
    [nx states]
    (let ([rest-start st1] (regex--nfa-seq (rest pieces) nx states))
      (regex--nfa-piece (first pieces) rest-start st1))))

(defn regex--nfa-alt (branches nx states)
  "Fan out over alternation branches with `:split` states; returns [start states']."
  (cond
    (empty? branches) [nx states]
    (empty? (rest branches)) (regex--nfa-seq (first branches) nx states)
    :else (let ([b-start st1] (regex--nfa-seq (first branches) nx states)
                [rest-start st2] (regex--nfa-alt (rest branches) nx st1))
            (regex--push st2 {:t :split :a b-start :b rest-start}))))

(defn regex--nfa (branches)
  "Compile the parsed branch list into {:states vec :start idx :match idx}."
  (let (states0 [{:t :match}]
        [start st] (regex--nfa-alt branches 0 states0))
    {:states st :start start :match 0}))

;; A pattern is almost always a literal reused across many match calls (a loop, a
;; filter), so memoise the *compiled NFA*: pattern string -> {:states …}. This
;; folds in the parse too, so a match-in-a-loop pays the parse+compile once. The
;; cache is a Table (the one mutable structure), keyed by the pattern string.
(def regex--cache (table))
(defn regex--compile (pattern)
  "The compiled NFA + everything pattern-constant, memoised across calls (the
Erlang `re:compile` discipline: pay it once per pattern, never per match call):
  :memo      the lazy DFA — (state-set, char) -> next state-set, filled on demand;
  :matchbit  the accept state's bit (so accept tests are plain `bit-and`);
  :startfull the full eps-closure of {start} at position 0 for a NON-empty input
             (`^` fires, `$` doesn't — position-independent for every n > 0);
  :startmid  the split-only closure of {start} (the search loop's injection set);
  :exitmemo  accept-closure memo — final set -> boolean (for n > 0 the exit
             closure depends only on the set, so it caches exactly)."
  (let (hit (table-get regex--cache pattern))
    (if (nil? hit)
      (let (nfa (regex--nfa (regex--parse pattern))
            states (get nfa :states)
            start (get nfa :start)
            m (count states)
            startbit (bit-shift-left 1 start)
            obj {:states states :start start :match (get nfa :match)
                 :matchbit (bit-shift-left 1 (get nfa :match))
                 :startfull (regex--eps-close states startbit 0 1 m)
                 :startmid (regex--eps-close-mid states startbit m)
                 :memo (table) :exitmemo (table)})
        (table-put regex--cache pattern obj)
        obj)
      hit)))

;; ---- simulate: closure-free Thompson NFA over integer-bitset state sets ------
;; A "state set" is a Brood integer used as a bitset: bit s set ⇔ NFA state s is
;; live. `bit-or` unions, `bit-shift-left` makes a singleton, `bit-positions` lists
;; the live states. No per-step allocation beyond the bitset ints.

(defn regex--letter? (c)
  "ASCII/Unicode cased letter: upper-case ≠ lower-case."
  (not (= (upper c) (lower c))))

(defn regex--class-match? (k c)
  (cond
    (= k :digit) (string-contains? "0123456789" c)
    (= k :space) (string-contains? " \t\n\r" c)
    (= k :word) (or (regex--letter? c) (string-contains? "0123456789" c) (= c "_"))
    :else false))

(defn regex--char-test? (test c)
  "Does the single char `c` satisfy a compiled `:char` state's `test`?"
  (let (k (get test :kind))
    (cond
      (= k :any)   true
      (= k :lit)   (= c (get test :c))
      (= k :set)   (let (m (string-contains? (get test :chars) c))
                     (if (get test :neg) (not m) m))
      (= k :class) (regex--class-match? (get test :k) c)
      :else        false)))

(defn regex--bit? (s i) (not (= 0 (bit-and s (bit-shift-left 1 i)))))

(defn regex--eps-targets (states s i n)
  "Epsilon successors of state `s` valid at position `i` (a bitset; 0 for none)."
  (let (st (nth states s) t (get st :t))
    (cond
      (= t :split) (bit-or (bit-shift-left 1 (get st :a)) (bit-shift-left 1 (get st :b)))
      (= t :bol)   (if (= i 0) (bit-shift-left 1 (get st :next)) 0)
      (= t :eol)   (if (= i n) (bit-shift-left 1 (get st :next)) 0)
      :else 0)))

;; The inner loops walk state indices 0..m with top-level recursive helpers — NOT
;; `reduce` over `(bit-positions set)`, which would allocate a fresh lambda AND a
;; positions vector on every character. A `defn` helper is a global (no per-call
;; closure), so the whole per-char simulation allocates nothing but the bitset ints.

(defn regex--eps-step (states set i n j m acc)
  "One epsilon-expansion pass over states j..m; returns the grown set."
  (if (>= j m)
    acc
    (regex--eps-step states set i n (inc j) m
      (if (regex--bit? set j) (bit-or acc (regex--eps-targets states j i n)) acc))))

(defn regex--eps-close (states set i n m)
  "Expand epsilon moves (split/anchors) to a fixpoint at position `i`."
  (let (grown (regex--eps-step states set i n 0 m set))
    (if (= grown set) set (regex--eps-close states grown i n m))))

;; -- middle transition: split-only closure (position-independent, memoisable) --
;; Anchors (`^`/`$`) are excluded here — they fire only at the string boundaries
;; (handled once by the full `regex--eps-close` at start/accept), so the per-char
;; transition depends only on (state-set, char) and can be cached in the DFA memo.

(defn regex--eps-step-mid (states set j m acc)
  (if (>= j m)
    acc
    (regex--eps-step-mid states set (inc j) m
      (if (regex--bit? set j)
        (let (st (nth states j))
          (if (= (get st :t) :split)
            (bit-or acc (bit-or (bit-shift-left 1 (get st :a)) (bit-shift-left 1 (get st :b))))
            acc))
        acc))))

(defn regex--eps-close-mid (states set m)
  "Split-only epsilon-closure fixpoint (no anchors)."
  (let (grown (regex--eps-step-mid states set 0 m set))
    (if (= grown set) set (regex--eps-close-mid states grown m))))

(defn regex--step (states set c j m acc)
  "Consume char `c`: the (unclosed) successor set of every live `:char` state matching."
  (if (>= j m)
    acc
    (regex--step states set c (inc j) m
      (if (regex--bit? set j)
        (let (st (nth states j))
          (if (if (= (get st :t) :char) (regex--char-test? (get st :test) c) false)
            (bit-or acc (bit-shift-left 1 (get st :next)))
            acc))
        acc))))

;; The string is converted ONCE per match call to a vector of integer char codes,
;; so the per-char loop below is pure integer/prim work: `(nth codes i)` (a
;; vector-ref prim), the packed memo key `(+ (* set 2097152) code)` (int arith),
;; `table-get` (a table prim), and the self tail call. No per-char Brood→Brood
;; call and no `char->int` call — which is what lets the whole loop JIT-tier.
(defn regex--codes (s)
  "The chars of `s` as a vector of integer codepoints."
  (apply vector (map char->int (string->list s))))

(defn regex--delta-slow (states memo m set code)
  "The DFA-transition MISS path: compute the split-closed successor of `set` on
char-code `code` (an NFA step + closure over the char), memoise it, return it.
Runs once per distinct (set, char) — every repeat is the loop's one `table-get`."
  (let (c (int->char code)
        nxt (regex--eps-close-mid states (regex--step states set c 0 m 0) m))
    (table-put memo (+ (* set 2097152) code) nxt)
    nxt))

;; Accept test at the end of input (position n > 0): full eps-closure of the final
;; set (`$` fires, `^` doesn't), then the matchbit test — memoised per SET in
;; `exitmemo`, so after warmup the loop's exit is one `table-get`. The closure is
;; computed with the (1, 1) position sentinel: for ANY n > 0, `i == n` makes `:eol`
;; fire and `:bol` not — exactly what (i=1, n=1) reproduces.
(defn regex--exit-slow (states exitmemo m matchbit set)
  (let (r (not (= 0 (bit-and (regex--eps-close states set 1 1 m) matchbit))))
    (table-put exitmemo set r)
    r))

;; anchored (matches?): the whole string must be consumed ending in `:match`.
;; Per char: one memo lookup (+ the rare miss computing it). Everything
;; pattern-constant (start closure, match bit) arrives precomputed from
;; `regex--compile`; the exit closure comes from `exitmemo`. The loop body is
;; pure prims (vector-ref, int arith, table-get) + the self tail call.
(defn regex--exit (obj states m matchbit set)
  "End-of-input accept test: the memoised exit closure, computing on first sight."
  (let (r (table-get (get obj :exitmemo) set))
    (if (nil? r) (regex--exit-slow states (get obj :exitmemo) m matchbit set) r)))

(defn regex--run-anchored-loop (obj states memo m matchbit codes n i set)
  (if (= i n)
    (regex--exit obj states m matchbit set)
    (if (= set 0)
      false
      (let (nxt (table-get memo (+ (* set 2097152) (nth codes i))))
        (regex--run-anchored-loop obj states memo m matchbit codes n (+ i 1)
          (if (nil? nxt) (regex--delta-slow states memo m set (nth codes i)) nxt))))))

;; unanchored search (match?): inject the (split-closed) start state at every
;; position so a match may begin anywhere; `^` fires only in the start closure
;; (position 0), `$` only in the exit closure at position n.
(defn regex--run-search-loop (obj states memo m startmid matchbit codes n i set)
  (if (not (= 0 (bit-and set matchbit)))
    true
    (if (>= i n)
      (regex--exit obj states m matchbit set)
      (let (nxt (table-get memo (+ (* set 2097152) (nth codes i))))
        (regex--run-search-loop obj states memo m startmid matchbit codes n (+ i 1)
          (bit-or
            (if (nil? nxt) (regex--delta-slow states memo m set (nth codes i)) nxt)
            startmid))))))

;; ---- public entry points ----------------------------------------------------
;; The n == 0 edge (empty input) is the one case where the precomputed closures
;; are wrong (`$` fires at position 0 too), so it recomputes both closures live.

(defn regex--empty-input? (obj)
  "Does the pattern match the empty string? (Both anchors fire at position 0.)"
  (let (states (get obj :states)
        m (count states)
        set (regex--eps-close states (bit-shift-left 1 (get obj :start)) 0 0 m))
    (not (= 0 (bit-and set (get obj :matchbit))))))

(defn match? (pattern s)
  "True if `pattern` matches anywhere in `s` (a search). `^`/`$` anchor to the
start/end of the whole string, so e.g. `(match? \"\\\\.blsp$\" name)` tests a suffix."
  (let (obj (regex--compile pattern)
        states (get obj :states)
        codes (regex--codes s)
        n (count codes))
    (if (= n 0)
      (regex--empty-input? obj)
      (regex--run-search-loop obj states (get obj :memo) (count states)
        (get obj :startmid) (get obj :matchbit) codes n 0 (get obj :startfull)))))

(defn matches? (pattern s)
  "True if `pattern` matches the **entire** string `s` (anchored both ends)."
  (let (obj (regex--compile pattern)
        states (get obj :states)
        codes (regex--codes s)
        n (count codes))
    (if (= n 0)
      (regex--empty-input? obj)
      (regex--run-anchored-loop obj states (get obj :memo) (count states)
        (get obj :matchbit) codes n 0 (get obj :startfull)))))
