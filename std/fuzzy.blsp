;; std/fuzzy.blsp — fuzzy (subsequence) string matching + ranking.
;;
;; The matcher completion UIs ride on: a query matches a candidate when its characters
;; appear IN ORDER somewhere in the candidate — "fb" matches "foo-bar". A space separates
;; TERMS that must each match, in any order — "lim ex" finds "lib/limits.ex" (ADR-429) — and
;; a term's first character can change what it asks (orderless's dispatch, ADR-497): `!x`
;; EXCLUDES what contains x, `=x` wants x as one literal run, `^x` a run at the start (of the
;; file name, for a path) and `x$` one at the end. Smart case: a term with an upper-case
;; letter matches case-sensitively, any other ignores case.
;;
;; Matches are scored so the best rise first: contiguous runs, matches at word boundaries
;; (string start, after a `- _ / . space`, or a camelCase upper) and early matches score
;; higher; skipping characters costs. The alignment is the OPTIMAL one under those rules — a
;; dynamic programme over the term and the candidate, fzf v2's and hotfuzz's shape (ADR-497)
;; — so `somet` takes the word-start run in `something` rather than the first `s` it meets.
;; Past `fuzzy-dp-max-cells` it falls back to the greedy walk and the first contiguous run.
;;
;; The rules live in ONE place — `fuzzy-char-bonus` and `fuzzy-step`, what one matched char
;; is worth — and the walks apply them, whether the caller wants a single candidate's
;; positions (`match`, to highlight a row) or a whole set ranked (`top`, on every keystroke).
;; They are also REPLACEABLE at runtime: bind `fuzzy/*scorer*` and every completion UI in the
;; image ranks by your rules instead (ADR-357).
;;
;; Ranking by the DEFAULT rules is also a native pass (`%fuzzy-top`, ADR-375), taken only
;; while `fuzzy/*scorer*` has not been rebound — so the code below is what a ranking MEANS
;; and the primitive is what an unmodified one costs. Replace the scorer and every ranking
;; comes back here. `tests/fuzzy_native_test.blsp` is the contract between them.

(defmodule fuzzy
  "Fuzzy (subsequence) matching + ranking.

    (match \"foo-bar\" \"fb\")   ; => {:score N :positions [0 4] :terms [[0 4]]}
    (match \"foo-bar\" \"xz\")   ; => nil
    (filter cands \"fb\")        ; => the matching cands, best score first
    (top cands \"fb\" 20)        ; => just the best 20 of them
    (top paths \"view\" 20 {:category :file :boost {\"src/view.blsp\" 40}})

`match` returns nil unless each space-separated term of `query` matches the candidate (in
any order), else `{:score :positions :terms}` (`positions` are the matched char indices, for
highlighting). A term is a subsequence (case-insensitive unless it has an upper-case letter);
`!x` excludes candidates containing x, `=x` wants x literally, `^x` / `x$` anchor it at the
start (of the file name, for `:category :file`) / end. `filter` keeps the matches and sorts
them best-first (ties: fewer path segments for files, shorter candidate, then lexicographic);
an empty query returns the candidates unchanged. `top` is `filter` stopping at the number of
rows a UI can actually show. Its options say what is being ranked: `:category :file` scores
a path's file name above its directories, `:boost` maps a candidate to a number added to its
score when it matches (frecency, history), and a candidate that IS the query ranks first.
`fuzzy/*scorer*` replaces the rules."
  (:shadow match))

;; ---- the rules --------------------------------------------------------------

; a match just after one of these is a word boundary
(def- fuzzy-separators "-_/. ")

(defn- fuzzy-upper? (ch)
  "True if 1-char string `ch` is an upper-case letter."
  (not (= (string/lower ch) ch)))

(defn- fuzzy-fold-char (ch)
  "1-char string `ch` lowered to ONE character — the first of its full lowering when that
expands (`İ` → `i̇`), so a lowered candidate stays index-for-index with the original. The
boundary test reads the original (case is what a camelCase hump is made of) at positions
found in the lowered form, which is only sound while the two have the same length."
  (let (lowered (string/lower ch))
    (if (= (count lowered) 1) lowered (string/substring lowered 0 1))))

(defn- fuzzy-fold-case (text)
  "`text` lowered character by character (`fuzzy-fold-char`)."
  (string/join (map (string/->list text) fuzzy-fold-char) ""))

(defn- fuzzy-boundary? (chars pos)
  "True if char `pos` of `chars` (a vector of 1-char strings) starts a word: index 0, after a
separator, or a camelCase hump (an upper preceded by a non-upper)."
  (or (= pos 0)
    (let (prev (nth chars (dec pos) ""))
      (or (includes? fuzzy-separators prev)
        (and (fuzzy-upper? (nth chars pos "")) (not (fuzzy-upper? prev)))))))

;; The terms of the score. A match is worth something; starting a word is worth more;
;; continuing the previous match is worth more again; and SKIPPING is worth less — that
;; last one is not decoration, it is what stops a query smearing itself across a path.
(def- fuzzy-match-score 1) ; being a match at all
(def- fuzzy-boundary-bonus 8) ; this char starts a word
(def- fuzzy-contiguous-bonus 6) ; this char directly follows the previous match
(def- fuzzy-gap-penalty 3) ; opening a gap — any run of skipped chars
(def- fuzzy-gap-extend-penalty 1) ; each further char skipped in that gap
(def- fuzzy-lead-penalty 3) ; most the first match can be docked for starting late
(def- fuzzy-basename-bonus 2) ; a `:file` candidate's char in its last path segment
(def- fuzzy-exact-bonus 1000000000) ; the candidate IS the query: it ranks first
(def- fuzzy-dp-max-cells 16384) ; term length × candidate length the optimal alignment runs to

(defn- fuzzy-gap-cost (gap:int -> int)
  "What skipping `gap` chars between two matched ones costs: nothing when they are
adjacent, else opening the gap plus each further char skipped.

This term is why a contiguous match wins. Without it the boundary bonus is pure profit, so
a query spread across a path's segments collects one per segment and beats the file it
names: `limits.ex` over a real project ranked `…/reports/it3b/submission.ex` (six
boundaries, 73) ABOVE `…/moneyclub/limits.ex` (62) — scattering paid, because 8 > 6 and the
distance between the hits cost nothing. Charging for distance is fzf's fix and it is the
right one: the bonuses say what a good match looks like, this says what it costs to reach."
  (if (<= gap 0)
    0
    (- 0 (+ fuzzy-gap-penalty (* fuzzy-gap-extend-penalty (dec gap))))))

(defn- fuzzy-char-bonus (chars pos basename-start)
  "What matching a query char at `pos` of `chars` is worth before its neighbours are known:
1 for being a match at all, +8 at a word boundary, and — for a path (`basename-start` not
nil) — +2 inside its last segment. A file is named by its name: `view` in `src/view.blsp`
outranks the same run in `view/model.blsp` by this term alone. Per candidate, once, however
many terms and alignments read it."
  (+ fuzzy-match-score
    (if (fuzzy-boundary? chars pos) fuzzy-boundary-bonus 0)
    (if (and (not (nil? basename-start)) (>= pos basename-start)) fuzzy-basename-bonus 0)))

(defn- fuzzy-step (bonuses pos prev)
  "What a query char matched at `pos` adds, given the previous match's position `prev` (nil
for the first): its `fuzzy-char-bonus`, +6 directly after the previous match, less what the
gap since then cost — and on the first match a small penalty for starting late instead. THE
scoring rule: every alignment below scores through here or through the recurrence that is
this function rearranged (`fuzzy-dp-row`), so the library has one definition of \"better\"."
  (+ (nth bonuses pos 0)
    (if (and (not (nil? prev)) (= pos (inc prev))) fuzzy-contiguous-bonus 0)
    (if (nil? prev)
      (- 0 (math/min fuzzy-lead-penalty pos))
      (fuzzy-gap-cost (- pos (inc prev))))))

;; ---- the candidate, prepared once per ranking of it -------------------------

(defn- fuzzy-basename-start (chars)
  "The index just past the last `/` in `chars`, 0 when there is none."
  (fold (range (count chars)) 0 (fn (acc j) (if (= (nth chars j) "/") (inc j) acc))))

(defn- fuzzy-candidate (cand file?)
  "`cand` as every term reads it: its characters (`:chars`) and their lowered form
(`:lows`, `:low` as one string), each char's `fuzzy-char-bonus`, its length and — for a
`:file` candidate — where its file name starts (`:base`, else nil)."
  (let (chars (into [] (string/->list cand))
        lows (into [] (map chars fuzzy-fold-char))
        base (if file? (fuzzy-basename-start chars) nil))
    {:text cand
     :chars chars
     :lows lows
     :low (string/join lows "")
     :n (count chars)
     :base base
     :bonus (into [] (map (range (count chars)) (fn (j) (fuzzy-char-bonus chars j base))))}))

;; ---- terms: a space separates what must match, in any order -----------------
;; `lim ex` is two things the reader remembers about a file, not a name with a space in it.
;; Each term matches on its own, anywhere and in either order (orderless's rule, which is
;; what Emacs completion settled on), the candidate's score is the terms' scores added, and
;; its positions are all of theirs — so a row can highlight every term it was found by.
;;
;; A term's first (or last) character picks what it asks, orderless's style dispatchers:
;;
;;   !x   exclude — a candidate containing x literally does not match (scores nothing)
;;   =x   literal — x as one unbroken run, wherever it scores best
;;   ^x   anchored — x literally at the start (of the file name, for `:category :file`)
;;   x$   anchored — x literally at the end; `^x$` is the whole (file) name
;;
;; A lone operator asks nothing and is not a term. There is no escape: a term that starts
;; with a literal `!` or `=` cannot be typed — the price of one-keystroke dispatch, as in
;; orderless's default; `=!x` covers the rare case.
;;
;; SMART CASE, per term: one with an upper-case letter matches case-sensitively, one without
;; ignores case. A query of nothing but spaces asks for nothing, like "".

(defn- fuzzy-make-term (kind body start? end?)
  "The prepared term for `body` (the piece without its operator), or nil when it is empty:
`{:kind :text :chars :case? :start? :end?}`, `:text`/`:chars` folded unless `:case?`."
  (if (= body "")
    nil
    (let (raw (string/->list body)
          case? (any? raw fuzzy-upper?)
          chars (into [] (if case? raw (map raw fuzzy-fold-char))))
      {:kind kind :text (string/join chars "") :chars chars :case? case? :start? start? :end? end?})))

(defn- fuzzy-parse-term (piece)
  "One space-separated `piece` of a query as a term (`fuzzy-make-term`), or nil."
  (let (length (count piece))
    (cond
      (string/starts-with? piece "!")
        (fuzzy-make-term :exclude (string/substring piece 1 length) false false)
      (string/starts-with? piece "=")
        (fuzzy-make-term :literal (string/substring piece 1 length) false false)
      else
        (let (start? (string/starts-with? piece "^")
              from (if start? 1 0)
              end? (and (string/ends-with? piece "$") (> length from))
              body (string/substring piece from (if end? (dec length) length)))
          (fuzzy-make-term (if (or start? end?) :literal :fuzzy) body start? end?)))))

(defn- fuzzy-pieces (query)
  "The non-empty space-separated pieces of `query`, as typed."
  (seq/filter (string/split query " ") (fn (piece) (not (= piece "")))))

(defn- fuzzy-terms (query)
  "`query`'s terms, each prepared — the once-per-ranking work."
  (into [] (seq/filter (map (fuzzy-pieces query) fuzzy-parse-term) (fn (term) (not (nil? term))))))

;; ---- aligning one term ------------------------------------------------------
;; Every alignment answers `[score positions]` or nil. The haystack is the candidate's
;; lowered chars for a case-insensitive term and its own chars for a case-sensitive one; the
;; bonuses are always the original's.

(defn- fuzzy-haystack (term ctx)
  "`[chars string]` the term is matched against: lowered unless the term is case-sensitive."
  (if (:case? term) [(:chars ctx) (:text ctx)] [(:lows ctx) (:low ctx)]))

(defn- fuzzy-run-at (bonuses at length)
  "`[score positions]` for a literal run of `length` chars starting at `at`."
  (let (positions (range at (+ at length)))
    [(fold positions
       0
       (fn (score pos) (+ score (fuzzy-step bonuses pos (if (= pos at) nil (dec pos))))))
      positions]))

(defn- fuzzy-better (best candidate)
  "The higher-scoring of two `[score positions]` alignments, either of which may be nil; the
first on a tie."
  (cond
    (nil? best) candidate
    (nil? candidate) best
    (> (first candidate) (first best)) candidate
    else best))

(defn- fuzzy-walk (qchars hay-string bonuses at)
  "`[score positions]` for the GREEDY alignment of `qchars` within `hay-string` from index
`at` — each query char taken at the first place it occurs — or nil when the query is not a
subsequence from there. The fallback past `fuzzy-dp-max-cells`, where the optimal alignment
would cost too much: `index-of` is the native scan, so this is linear in the candidate."
  (letrec (go (fn (qi from prev score positions)
                (if (>= qi (count qchars))
                  [score (reverse positions)]
                  (let (pos (index-of hay-string (nth qchars qi) from))
                    (if (< pos 0)
                      nil
                      (go (inc qi)
                        (inc pos)
                        pos
                        (+ score (fuzzy-step bonuses pos prev))
                        (cons pos positions)))))))
    (go 0 at nil 0 '())))

(defn- fuzzy-greedy (term ctx)
  "The better of the greedy alignment and the walk from the first place the term occurs as
one unbroken run — what a long candidate gets instead of the optimal alignment. The run
matters because the greedy walk cannot backtrack: `limits.ex` against
`lib/moneyclub/accounts/limits.ex` spends l-i-m inside `lib/moneyclub` and then crawls."
  (let ([_ hay-string] (fuzzy-haystack term ctx)
        greedy (fuzzy-walk (:chars term) hay-string (:bonus ctx) 0))
    (if (nil? greedy)
      nil
      (let (at (index-of hay-string (:text term)))
        (fuzzy-better greedy
          (if (< at 0) nil (fuzzy-walk (:chars term) hay-string (:bonus ctx) at)))))))

;; ---- the optimal alignment --------------------------------------------------
;; Row i of the table holds, for each candidate position j, the best score of an alignment
;; of the term's first i+1 chars whose LAST char sits at j (nil where none can). Row 0 is the
;; first char's bonus less the lead penalty. Row i at j is the char's bonus plus the better of
;;
;;   * continuing a run: row i-1 at j-1, plus the contiguous bonus, and
;;   * arriving across a gap from some p ≤ j-2: row i-1 at p, less `fuzzy-gap-cost(j-p-1)`.
;;
;; The gap cost is linear in p, so that second maximum is a running prefix maximum of
;; `row[p] + extend·p`, carried along the row — O(term × candidate) for the table, not cubed.
;; The answer is the best cell of the last row; the positions are traced back through the
;; table, preferring the run at each step.

(defn- fuzzy-dp-first-row (qc hay bonuses)
  "Row 0 of the table for first query char `qc` over `hay`."
  (into []
    (map (range (count hay))
      (fn (j) (if (= (nth hay j) qc) (- (nth bonuses j 0) (math/min fuzzy-lead-penalty j)) nil)))))

(defn- fuzzy-max (a b)
  "The larger of two scores either of which may be nil."
  (cond
    (nil? a) b
    (nil? b) a
    else (math/max a b)))

(defn- fuzzy-gap-arrival (gap-best j)
  "The best score reaching `j` across a gap, from `gap-best` — the running maximum of
`row[p] + extend·p` over p ≤ j-2 — or nil when nothing can."
  (if (nil? gap-best)
    nil
    (- gap-best
      (* fuzzy-gap-extend-penalty (dec j))
      (- fuzzy-gap-penalty fuzzy-gap-extend-penalty))))

(defn- fuzzy-dp-row (previous qc hay bonuses)
  "Row i of the table for query char `qc`, from row i-1 `previous`."
  (let (n (count hay))
    (letrec (go (fn (j gap-best row)
                  (if (= j n)
                    row
                    (let (two-back (if (>= j 2) (nth previous (- j 2)) nil)
                          one-back (if (>= j 1) (nth previous (dec j)) nil)
                          gap-best (if (nil? two-back)
                                     gap-best
                                     (fuzzy-max gap-best
                                       (+ two-back (* fuzzy-gap-extend-penalty (- j 2)))))
                          best (if (= (nth hay j) qc)
                                 (fuzzy-max (if (nil? one-back)
                                              nil
                                              (+ one-back fuzzy-contiguous-bonus))
                                   (fuzzy-gap-arrival gap-best j))
                                 nil))
                      (go (inc j)
                        gap-best
                        (conj row (if (nil? best) nil (+ (nth bonuses j 0) best))))))))
      (go 0 nil []))))

(defn- fuzzy-dp-predecessor (previous bonuses j cell)
  "Where the char before the one at `j` (scoring `cell`) sat: `j - 1` when the run explains
the score, else the nearest p ≤ j-2 whose gap arrival does."
  (let (target (- cell (nth bonuses j 0))
        one-back (if (>= j 1) (nth previous (dec j)) nil))
    (if (and (not (nil? one-back)) (= (+ one-back fuzzy-contiguous-bonus) target))
      (dec j)
      (letrec (go (fn (p)
                    (let (at (nth previous p))
                      (if (and (not (nil? at))
                            (= (fuzzy-gap-arrival (+ at (* fuzzy-gap-extend-penalty p)) j) target))
                        p
                        (go (dec p))))))
        (go (- j 2))))))

(defn- fuzzy-dp-trace (rows bonuses)
  "`[score positions]` read off the finished table: the best cell of the last row (the
first, on a tie), then each row's predecessor back to the first char."
  (let (last-row (last rows)
        score (fold last-row nil fuzzy-max))
    (if (nil? score)
      nil
      (letrec (go (fn (i j positions)
                    (if (= i 0)
                      [score (cons j positions)]
                      (go (dec i)
                        (fuzzy-dp-predecessor (nth rows (dec i))
                          bonuses
                          j
                          (or (nth (nth rows i) j) 0))
                        (cons j positions)))))
        (go (dec (count rows)) (index-of last-row score) '())))))

(defn- fuzzy-optimal (term ctx)
  "`[score positions]` for the best alignment of a fuzzy `term` in `ctx`, or nil."
  (let ([hay _] (fuzzy-haystack term ctx)
        qchars (:chars term)
        bonuses (:bonus ctx)
        rows (fold (rest qchars)
               [(fuzzy-dp-first-row (first qchars) hay bonuses)]
               (fn (rows qc) (conj rows (fuzzy-dp-row (last rows) qc hay bonuses)))))
    (fuzzy-dp-trace rows bonuses)))

;; ---- the literal and anchored terms -----------------------------------------

(defn- fuzzy-literal (term ctx)
  "`[score positions]` for a literal `term`: at the anchor when it has one — the start (the
file name's, for a path) and/or the end — else the best-scoring place it occurs."
  (let ([_ hay-string] (fuzzy-haystack term ctx)
        text (:text term)
        length (count (:chars term))
        n (:n ctx)
        bonuses (:bonus ctx)
        at-start (or (:base ctx) 0)
        run? (fn (at)
               (and (>= at 0)
                 (<= (+ at length) n)
                 (= (string/substring hay-string at (+ at length)) text))))
    (cond
      (:start? term)
        (if (and (run? at-start) (or (not (:end? term)) (= (+ at-start length) n)))
          (fuzzy-run-at bonuses at-start length)
          nil)
      (:end? term) (if (run? (- n length)) (fuzzy-run-at bonuses (- n length) length) nil)
      else
        (letrec (go (fn (from best)
                      (let (at (index-of hay-string text from))
                        (if (< at 0)
                          best
                          (go (inc at) (fuzzy-better best (fuzzy-run-at bonuses at length)))))))
          (go 0 nil)))))

(defn- fuzzy-term-run (term ctx)
  "`[score positions]` for one term against prepared candidate `ctx`, or nil when it does not
match. An excluding term matches — score 0, no positions — exactly when it is ABSENT."
  (case (:kind term)
    :exclude
      (let ([_ hay-string] (fuzzy-haystack term ctx))
        (if (includes? hay-string (:text term)) nil [0 '()]))
    :literal (fuzzy-literal term ctx)
    (if (> (* (count (:chars term)) (:n ctx)) fuzzy-dp-max-cells)
      (fuzzy-greedy term ctx)
      (fuzzy-optimal term ctx))))

(defn- fuzzy-run-terms (terms cand file?)
  "`[score positions per-term]` for `cand` against every prepared term, or nil when one of
them does not match: the scores added, every term's positions merged in order (each index
once), and each term's own positions in query order."
  (let (ctx (fuzzy-candidate cand file?))
    (letrec (go (fn (index score per-term)
                  (if (>= index (count terms))
                    [score (sort (seq/distinct (fold per-term (list) append))) per-term]
                    (let (run (fuzzy-term-run (nth terms index) ctx))
                      (if (nil? run)
                        nil
                        (go (inc index) (+ score (first run)) (conj per-term (second run))))))))
      (go 0 0 []))))

(defn- fuzzy-file? (options)
  "Whether `options` (a map or nil) rank paths — `:category :file`."
  (= (get options :category) :file))

;; ---- matching one candidate -------------------------------------------------

(defn match (cand:string query:string &optional (options nil) -> (or nil map))
  "`nil` unless every term of `query` matches `cand`, else `{:score <int> :positions (i …)
:terms [(i …) …]}` — the terms' scores added, all their matched indices in order (each
once), and each term's own indices in query order, so a UI can colour every term apart (an
excluding `!` term's are empty). `options` as `top` takes them; `:category :file` moves the
alignment onto the file name. A query with no terms (`\"\"`, only spaces, a lone operator)
matches anything (score 0, no terms).

For ONE candidate — the rows a UI actually draws, which need `:positions` to highlight the
matched chars. To rank a whole set use `top`.

    (fuzzy/match \"xAxbxC\" \"abc\")   ;=> {:score 12 :positions (1 3 5) :terms [(1 3 5)]}
    (fuzzy/match \"abc\" \"zz\")   ;=> nil
    (:terms (fuzzy/match \"lib/limits.ex\" \"ex lim\"))   ;=> [(11 12) (4 5 6)]
    (:positions (fuzzy/match \"s-o-m/something\" \"somet\"))   ;=> (6 7 8 9 10)
    (:terms (fuzzy/match \"lib/limits.ex/lim\" \"=it !zz lim$\"))   ;=> [(7 8) () (14 15 16)]"
  (let (terms (fuzzy-terms query))
    (if (empty? terms)
      {:score 0 :positions () :terms []}
      (let (run (fuzzy-run-terms terms cand (fuzzy-file? options)))
        (if (nil? run) nil {:score (first run) :positions (second run) :terms (third run)})))))

;; ---- the scorer: the rules as a value you can replace -----------------------

(defn scorer (query:string &optional (options nil) -> fn)
  "A `(cand) -> score | nil` for `query` under the built-in rules — the query prepared once
and closed over. `options` as `top` takes them (only `:category` reaches a scorer: the boost
and the exact-match rule are `top`'s, applied over whatever scorer is in force). The default
`fuzzy/*scorer*`, and what a custom one replaces.

Curried on purpose: ranking calls the inner function tens of thousands of times per
keystroke, so everything that depends only on the query happens out here, once.

    ((fuzzy/scorer \"fb\") \"foo-bar\")   ;=> 13
    ((fuzzy/scorer \"fb\") \"zz\")   ;=> nil

    ; the built-in rules, plus a nudge for what you opened recently
    (binding (fuzzy/*scorer*
               (fn (q options) (let (base (fuzzy/scorer q options))
                                 (fn (c) (let (s (base c)) (if (nil? s) nil (+ s (recency c))))))))
      (fuzzy/top files query 20))"
  (let (terms (fuzzy-terms query)
        file? (fuzzy-file? options))
    (if (empty? terms)
      (fn (_cand) 0)
      (fn (cand) (let (run (fuzzy-run-terms terms cand file?)) (if (nil? run) nil (first run)))))))

(defdyn fuzzy/*scorer* :default)
;; How ranking scores a candidate: a `(query options) -> (cand) -> score | nil`. Bind it to
;; rank by your own rules — weight the boundary bonus differently, prefer what you opened
;; recently — and `top`/`filter` follow, live, everywhere in the image. `scorer` is the
;; default and composes: wrap it, don't restate it. `options` is the map `top` was given (or
;; nil); a scorer that does not care about the category ignores it.
;;
;; The default is the KEYWORD `:default`, not `scorer` itself, and that is load-bearing:
;; `top` must be able to ask "has anybody replaced these rules?" to decide whether the
;; native pass applies (ADR-375), and it cannot ask that of a function. `=` on two fn values
;; is identity, and the stdlib image rehydrates the dynvar's default and the global `scorer`
;; as separate objects — so comparing them answered "replaced" in a fresh image, which would
;; have silently left every ranking on the slow path. A keyword compares exactly.
;; `scorer-in-force` is what reads it; nothing else should.

;; check-allow: the dynvar's value is whatever a caller bound — the checker cannot see that
;; it is a scorer, and the declaration is the author saying so (strict: trusted, not verified).
(check-allow :trusted
  (defn- scorer-in-force ()
    "The scorer to rank with: whatever `fuzzy/*scorer*` is bound to, or `scorer` when that is
still `:default`. The one place the sentinel is resolved."
    (let (s fuzzy/*scorer*) (if (= s :default) scorer s))))
(sig scorer-in-force (-> fn))

;; ---- what `top` adds over any scorer: the boost and the exact match ----------
;; prescient's two lessons, as vertico-sort-history applies them. What you chose before is
;; what you will choose again, so a caller's history or frecency rides in as `:boost`, a
;; number added to a MATCHING candidate's score — it reorders matches and never makes a
;; non-match match. And a candidate that IS the typed query — the whole thing, or for a path
;; its file name — is what the reader meant, so it ranks first whatever else scores.

(defn- fuzzy-basename (cand)
  "`cand` past its last `/` — the file name `fuzzy-basename-start` measures."
  (let (at (string/last-index-of cand "/"))
    (if (< at 0) cand (string/substring cand (inc at) (count cand)))))

(defn- fuzzy-exact-of (query file?)
  "A `(cand) -> bool`: whether `cand` (or its file name, for a path) is the query itself —
its pieces joined by one space, compared ignoring case unless the query has an upper-case
letter (smart case, as each term)."
  (let (wanted (string/join (fuzzy-pieces query) " ")
        case? (any? (string/->list wanted) fuzzy-upper?)
        target (if case? wanted (fuzzy-fold-case wanted))
        normalise (if case? (fn (text) text) fuzzy-fold-case))
    (fn (cand)
      (or (= (normalise cand) target)
        (and file? (= (normalise (fuzzy-basename cand)) target))))))

(defn- fuzzy-score-of (query options)
  "The `(cand) -> score | nil` a ranking orders by: the scorer in force, plus the candidate's
`:boost` and the exact-match bonus when — and only when — it matched."
  (let (base ((scorer-in-force) query options)
        boost (get options :boost)
        exact? (fuzzy-exact-of query (fuzzy-file? options)))
    (fn (cand)
      (let (score (base cand))
        (if (nil? score)
          nil
          (+ score (if (nil? boost) 0 (get boost cand 0)) (if (exact? cand) fuzzy-exact-bonus 0)))))))

;; ---- ranking a whole set ----------------------------------------------------
;; This is the per-keystroke pass, and at project scale (tens of thousands of paths, where
;; a short query matches nearly all of them) it is where a completion UI lives or dies.
;; Under the default rules it is native (`%fuzzy-top`); what follows is the definition, and
;; the path a custom scorer takes:
;;
;;   1. TOP-K, NOT A SORT. A UI shows ~20 rows; sorting tens of thousands of matches to
;;      throw nearly all away dominates. `fuzzy-fold` keeps the best k instead: one int
;;      compare rejects the common candidate, and no key is built for one that loses.
;;   2. SHARDED ACROSS PROCESSES past `fuzzy/*parallel-min*` candidates (`fuzzy-parallel`).

(defn- fuzzy-segments (cand)
  "How many `/` separate `cand`'s path segments."
  (dec (count (string/split cand "/"))))

(defn- fuzzy-key (score cand file?)
  "The sort key `[(- score) segments length cand]` — best score first, then (for a path) the
one with fewer segments, then the shorter candidate, then lexicographic. The candidate rides
last in the key, so a ranked list is a list of keys."
  [(- 0 score) (if file? (fuzzy-segments cand) 0) (count cand) cand])

(defn- fuzzy-worse? (score cand file? worst)
  "True if `cand` scoring `score` loses to `worst`, the worst key kept. The reject test of
the top-k fold, so it runs once per match: an int compare settles almost every one, and the
key is only built on a tie."
  (let (worst-score (- 0 (first worst)))
    (cond
      (< score worst-score) true
      (> score worst-score) false
      else (> (compare (fuzzy-key score cand file?) worst) 0))))

(defn- fuzzy-place (best k score cand file?)
  "The fold state `[count worst kept]` after `cand` is placed in `best` (ascending by key)
and the list re-capped to `k`. Only reached by a candidate that beat the worst one kept,
which is rare once the first k are in."
  (let (key (fuzzy-key score cand file?)
        kept (take (sort (cons key best)) k))
    [(count kept) (or (last kept) key) kept]))

(defn- fuzzy-fold (score-of cands k file?)
  "The best `k` candidates by `score-of`, best first — the bounded fold."
  (map (third (fold cands
                [0 nil ()]
                (fn (state cand)
                  (let (score (score-of cand))
                    (cond
                      (nil? score) state
                      (< (first state) k) (fuzzy-place (third state) k score cand file?)
                      (fuzzy-worse? score cand file? (second state)) state
                      else (fuzzy-place (third state) k score cand file?))))))
    last))

(defn- fuzzy-all (score-of cands file?)
  "Every match by `score-of`, best first — decorate-sort-undecorate, for an unbounded
`filter`. (The bounded fold is the wrong shape with no k: every candidate would place, and
placing re-sorts the kept list.)"
  (map (sort (fold cands
               '()
               (fn (acc cand)
                 (let (score (score-of cand))
                   (if (nil? score) acc (cons (fuzzy-key score cand file?) acc))))))
    last))

;; ---- sharding a big ranking across processes --------------------------------
;; Ranking is a fold over independent candidates, which is the shape that shards. Each
;; worker gets a slice and returns only its own best k, so at most `workers × k` come back
;; for the caller to merge — the same fold over a few hundred, and the answer is identical
;; to ranking the whole set in one process.
;;
;; The workers are spawned per ranking rather than pooled: a shard is only meaningful for
;; one candidate set, `spawn` plus the slice is cheap next to the ranking it parallelises,
;; and a pool would need invalidating every time the set changed —
;; state to get wrong for no gain.
;;
;; Two things this has to get right, because the caller is an editor's loop and its mailbox
;; is full of other traffic. The reply carries a `ref` and the receive selects on it, so
;; nothing else is consumed or reordered. And a shard that does not answer in time is
;; killed before its slice is ranked in the caller instead, and any reply that landed anyway
;; is swept out of the mailbox first — a straggler's message left queued is one nothing will
;; ever read, and this caller lives for the length of a session. A worker runs a pure fold,
;; so the deadline is reached through a loaded machine or a `fuzzy/*scorer*` that throws; the
;; ranking then
;; costs time and still finishes, rather than hanging the loop.

(defdyn fuzzy/*parallel-min* 4000)
;; Candidate sets bigger than this rank across `fuzzy/*workers*` processes; smaller ones
;; rank inline, where spawning would cost more than it saves. Set it huge to keep ranking
;; single-process.

(defdyn fuzzy/*workers* 8)
;; How many processes a big ranking shards across. Past about eight the per-shard fixed
;; cost grows faster than the parallelism pays back.

(defdyn fuzzy/*worker-timeout-ms* 1000)
;; How long to wait for a shard before killing that worker and ranking its slice here. A
;; ceiling on the damage a wedged worker can do, not a tuning knob.

(defn- fuzzy-shards (cands n)
  "`cands` split into `n` slices of nearly equal size."
  (let (per (inc (math/quot (count cands) n)))
    (map (range n) (fn (i) (into [] (take (drop cands (* i per)) per))))))

(defn- fuzzy-worker (parent tag index score-of shard k file?)
  "A shard's own best `k`, sent back tagged with `tag` and its shard `index`."
  (send parent [:fuzzy-ranked tag index (fuzzy-fold score-of shard k file?)]))

(defn- fuzzy-sweep (tag pending acc)
  "`[pending' acc']` after taking every reply for `tag` ALREADY queued, waiting for none.
A worker that answered just past the deadline has done the work — using it beats redoing
it, and leaving it queued is what would strand a message in the caller's mailbox."
  (receive
    ([:fuzzy-ranked ^tag index ranked] (fuzzy-sweep tag (dissoc pending index) (append acc ranked)))
    (after 0 [pending acc])))

(defn- fuzzy-abandon (tag pending score-of k file? acc)
  "Give up on the shards still out: kill their workers, take any reply that landed anyway,
and rank whatever is still missing here. `pending` is `{index -> [shard pid]}`.

The ORDER is the point. Killing first stops any further send; sweeping second collects what
was already in flight — and a reply sent before the kill lands is in the mailbox whether or
not we look, so not looking is what leaves it there forever. (That is not hypothetical: at a
1 ms budget over 8k candidates, killing alone stranded seven replies in the caller — and the
caller is an editor's loop, which then scans past them on every selective receive it ever
does again.) Only then is the remainder ranked locally, so the ANSWER is whole either way."
  (let (_ (doseq (entry (vals pending)) (exit (second entry) :kill))
        [left swept] (fuzzy-sweep tag pending acc))
    (fold (vals left)
      swept
      (fn (a entry) (append a (fuzzy-fold score-of (first entry) k file?))))))

(defn- fuzzy-gather (tag pending acc score-of k file?)
  "The replies tagged `tag`, appended to `acc`. `pending` is `{index -> [shard pid]}` for
the shards not yet in; the receive selects on `tag`, so other traffic in this process's
mailbox is left where it is."
  (if (empty? pending)
    acc
    (receive
      ([:fuzzy-ranked ^tag index ranked] (fuzzy-gather tag
                                           (dissoc pending index)
                                           (append acc ranked)
                                           score-of
                                           k
                                           file?))
      (after fuzzy/*worker-timeout-ms* (fuzzy-abandon tag pending score-of k file? acc)))))

(defn- fuzzy-discard-loop (n)
  "The drain itself, tail-recursive: an accumulator rather than `(inc (recur))`, which grows
the stack by one frame per stray."
  (receive
    ([:fuzzy-ranked _ _ _] (fuzzy-discard-loop (inc n)))
    (after 0 n)))

(defn- fuzzy-discard-stale ()
  "Drop any `[:fuzzy-ranked …]` left in this process's mailbox by an EARLIER ranking, waiting
for none. Returns how many there were.

A worker that missed its deadline is killed, but the kill is not synchronous: it may already
be inside `send`, so the reply can land after the gather has stopped looking and after
`fuzzy-abandon` has swept. Nothing closes that race at the timeout — so it is closed HERE
instead, one ranking later. Anything matching at this point predates the tag about to be
made, which is what makes discarding it safe. Cost: one zero-wait receive per sharded
ranking; benefit: strays can never accumulate in a caller that lives for a whole session."
  (fuzzy-discard-loop 0))

(defn- default-rules? (-> bool)
  "Whether ranking is still scoring by the built-in rules — i.e. `fuzzy/*scorer*` has not
been rebound. The gate on the native pass (`%fuzzy-top`, ADR-375): the primitive implements
the rules above and nothing else, so it is only ever correct while they are what a ranking
means. A custom scorer takes the Brood paths, unchanged."
  (= fuzzy/*scorer* :default))

(defn- fuzzy-parallel (score-of cands k file?)
  "The best `k` of `cands`, ranked across `fuzzy/*workers*` processes and merged here."
  (let (_ (fuzzy-discard-stale)
        shards (into [] (fuzzy-shards cands fuzzy/*workers*))
        tag (ref)
        me (self)
        ;; `fold`, not `map`: every worker must have been SPAWNED before the gather starts
        ;; waiting on it, and a lazy map would run the spawns inside the receive.
        pending (fold (range (count shards))
                  {}
                  (fn (acc i)
                    (let (shard (nth shards i))
                      (assoc acc
                        i [shard (spawn (fuzzy-worker me tag i score-of shard k file?))]))))
        partial (fuzzy-gather tag pending '() score-of k file?))
    (fuzzy-fold score-of partial k file?)))

(defn top (cands query &optional (limit nil) (options nil))
  "The best `limit` candidates in `cands` for `query`, best score first — the ranking
`filter` does, stopping at the `limit` a completion UI can actually show. `nil` or a limit
≤ 0 means all of them. Ties: fewer path segments (for `:category :file`), shorter candidate,
then lexicographic. A query with no terms keeps `cands` in their given order. Scores through
`fuzzy/*scorer*`, and shards across processes past `fuzzy/*parallel-min*` candidates.

`options` (a map, or nil):

- `:category :file` — the candidates are paths: a match in the file name scores above one
  in the directories, `^x` anchors at the file name, and fewer segments win a tie.
- `:boost {cand n}` — added to a candidate's score when it matches: history, frecency.
- a candidate equal to the whole query (for a path, or its file name) ranks first.

    (fuzzy/top [\"axb\" \"ab\" \"zz\"] \"ab\" 1)   ;=> (\"ab\")
    (fuzzy/top [\"view/model.blsp\" \"src/view.blsp\"] \"view\" 2 {:category :file})   ;=> (\"src/view.blsp\" \"view/model.blsp\")
    (fuzzy/top [\"abc\" \"axb\"] \"ab\" 2 {:boost {\"axb\" 50}})   ;=> (\"axb\" \"abc\")"
  (let (k (or limit 0)
        bounded (> k 0)
        n (if bounded (count cands) 0)
        file? (fuzzy-file? options))
    (cond
      ;; no terms — "", only spaces, a lone operator — asks for nothing, so nothing is ranked
      (empty? (fuzzy-terms query)) (if bounded (take cands k) cands)
      ;; The default rules, natively (ADR-375). Same rules, same ordering, no shard fan-out
      ;; — and no copy of the candidate set across process boundaries per keystroke. Gated
      ;; on the scorer still BEING the default: bind `fuzzy/*scorer*` and every ranking
      ;; falls back to the Brood paths below, which is the whole of ADR-357 kept intact.
      (default-rules?) (%fuzzy-top query cands limit options)
      (not bounded) (fuzzy-all (fuzzy-score-of query options) cands file?)
      (> n fuzzy/*parallel-min*) (fuzzy-parallel (fuzzy-score-of query options) cands k file?)
      ;; The bounded fold only pays once the sort it replaces is mostly waste. The
      ;; crossover is around a hundred candidates per row shown — under that the native
      ;; sort beats an interpreted fold, over it the fold pulls away. A ratio, not a size:
      ;; what matters is how many candidates get sorted per row actually displayed.
      (> n (* 100 k)) (fuzzy-fold (fuzzy-score-of query options) cands k file?)
      else (take (fuzzy-all (fuzzy-score-of query options) cands file?) k))))
(sig top (seqable string &optional (or nil int) (or nil map) -> seqable))

(defn filter (cands:seqable query:string &optional (options nil) -> seqable)
  "The candidates in `cands` that fuzzily match `query`, best score first (ties: fewer path
segments for `:category :file`, shorter candidate, then lexicographic). An empty `query`
returns `cands` unchanged. `options` as `top`.

    (fuzzy/filter [\"axb\" \"zz\"] \"ab\")   ;=> (\"axb\")"
  (top cands query nil options))
;; `cands` and the result are `seqable` (empty query returns `cands` as-is, else a ranked
;; list) — the domain checks the argument without false-flagging a vector caller.

;; ---- a ranking session: the set is sent once, the loop never waits ------------
;; `top` answers where it is called, which is the wrong place when the caller is an event
;; loop. However fast ranking gets, a set can always be big enough to miss a frame — and
;; the caller that hurts is the one that must also be drawing at the time. A `ranker` moves
;; the work to a process that OWNS the candidate set: a query costs the query, the loop
;; sends and returns, and the answer arrives as an ordinary message it folds like any other.
;;
;; Three properties are the whole point, and none is available to a caller rolling this by
;; hand around `top`:
;;
;;   * The set crosses the process boundary ONCE, at `ranker` — and so do the options, a
;;     history boost of thousands of entries included. Each query hands the native pass the
;;     same heap values; nothing is copied per keystroke.
;;   * A superseded query is DROPPED, not queued. Typing five characters quickly enqueues
;;     five rankings, four of which nobody will ever see; `ranker-latest` takes the newest
;;     already in the mailbox before ranking, so a burst ranks once, at the last keystroke.
;;   * A query that REFINES the last one ranks only what the last one matched (ADR-497).
;;     Typing narrows: when every term of the previous query is implied by a term of the
;;     new one (`fuzzy-refines?`), no candidate the previous query rejected can match the
;;     new one, so the session keeps the previous query's whole match set — every index,
;;     not the capped rows it answered with, which would drop the matches that belong in
;;     the next twenty — and ranks that. On a project, the first keystroke pays for the set
;;     and each one after pays for what is still in the running.
;;
;; The scorer is resolved in the CALLER at `ranker` and re-bound in the child around each
;; ranking, because a dynamic binding does not reach a spawned process — same reason
;; `fuzzy-parallel` ships its closure. So a session created under a custom `fuzzy/*scorer*`
;; keeps it for its lifetime, and one created under the default takes the native pass.
;; Narrowing is the default rules' alone: a custom scorer's matches need not shrink as the
;; query grows, so that session ranks the whole set every time.

(defn- fuzzy-implies? (newer older)
  "Whether every candidate term `newer` matches is one term `older` matches too — the
narrowing rule, per term. Same case sensitivity, and: an exclusion only by the same
exclusion; a fuzzy term by any matching term containing its text (a run contains its
subsequences); a literal by a literal containing it, at the same anchors."
  (let (newer-text (or (:text newer) "")
        older-text (or (:text older) ""))
    (and (= (:case? newer) (:case? older))
      (case (:kind older)
        :exclude (and (= (:kind newer) :exclude) (= newer-text older-text))
        :fuzzy (and (not (= (:kind newer) :exclude)) (includes? newer-text older-text))
        (and (= (:kind newer) :literal)
          (cond
            (and (:start? older) (:end? older))
              (and (:start? newer) (:end? newer) (= newer-text older-text))
            (:start? older) (and (:start? newer) (string/starts-with? newer-text older-text))
            (:end? older) (and (:end? newer) (string/ends-with? newer-text older-text))
            else (includes? newer-text older-text)))))))

(defn- fuzzy-refines? (older newer)
  "Whether query terms `newer` can only match a subset of what `older` matched: each older
term is implied by some newer one. A new exclusion only narrows further; a changed one
(`!f` → `!fo` excludes less) is not implied, so it ranks the whole set."
  (every? older (fn (term) (any? newer (fn (candidate) (fuzzy-implies? candidate term))))))

(defn- ranker-latest (msg)
  "The newest `[:rank from query limit]` already in this process's mailbox, or `msg` when
there is none — a non-blocking selective receive, so a burst of keystrokes ranks once."
  (let (next (receive ([:rank from query limit] [:rank from query limit]) (after 0 nil)))
    (if (nil? next) msg (ranker-latest next))))

(defn- ranker-answer (cands score-of options previous query limit)
  "`[hits previous']` for `query`: the ranking, and what the next query may narrow from —
`[terms indices]`, the query's terms and the indices of EVERY candidate it matched, or nil
when there is nothing to narrow from (a custom scorer, a query with no terms)."
  (let (terms (fuzzy-terms query))
    (if (or (not (= score-of :default)) (empty? terms))
      [(binding (fuzzy/*scorer* score-of) (top cands query limit options)) nil]
      (let (subset (if (and previous (fuzzy-refines? (first previous) terms)) (second previous) nil)
            [hits indices] (%fuzzy-top query
                             cands
                             limit
                             (assoc (or options {}) :subset subset :indices true)))
        [hits [terms indices]]))))

(defn- ranker-loop (cands score-of options previous)
  "The session process: rank the newest pending query against `cands` and reply, replace the
candidate set on `[:candidates …]`, exit on `[:stop]`. `previous` is what the last query
matched (`ranker-answer`); replacing the set forgets it."
  (receive
    ([:rank from query limit] (let ([_ to q k] (ranker-latest [:rank from query limit])
                                    [hits next] (ranker-answer cands score-of options previous q k))
                                (do
                                  (send to [:fuzzy-ranked (self) q hits])
                                  (ranker-loop cands score-of options next))))
    ([:candidates replacement] (ranker-loop replacement score-of options nil))
    ([:stop] nil)))

(defn ranker (cands:seqable &optional (options nil) -> pid)
  "A ranking **session** over `cands`: a process that holds the candidate set — and the
`options` every query ranks with, as `top` takes them (`:category`, a history `:boost`) — so
each query costs only the query and the asking process never blocks. Returns its pid —
`rank-async` to ask, `ranker-candidates` to replace the set, `ranker-stop` when done.

For a caller that ranks repeatedly from an event loop (an editor's minibuffer, a REPL
completer) rather than once. A query that extends the previous one ranks only what that one
matched. The rules are whatever `fuzzy/*scorer*` is **here, now**: a dynamic binding does
not reach a spawned process, so the session captures it at creation and keeps it.

    (let (r (fuzzy/ranker project-files {:category :file :boost frecency}))
      (fuzzy/rank-async r \"view\" 20)
      (receive ([:fuzzy-ranked ^r query hits] hits)))

    (let (r (fuzzy/ranker [\"view.blsp\" \"model.blsp\"])) (fuzzy/rank-async r \"view\" 1) (receive ([:fuzzy-ranked ^r _ hits] (do (fuzzy/ranker-stop r) (count hits)))))   ;=> 1"
  (let (score-of fuzzy/*scorer*)
    (spawn (fn () (ranker-loop cands score-of options nil)))))
(sig ranker (seqable &optional (or nil map) -> pid))

(defn rank-async (session query &optional (limit nil))
  "Ask `session` for the best `limit` candidates for `query`. Returns immediately; the answer
arrives in the calling process's mailbox as `[:fuzzy-ranked <session> query hits]`. A query
sent while an older one is still queued REPLACES it — only the newest is ever answered, so a
caller that sends one per keystroke gets one reply per burst, not one per key.

    (let (r (fuzzy/ranker [\"alpha\" \"beta\"])) (fuzzy/rank-async r \"bet\") (receive ([:fuzzy-ranked ^r q hits] (do (fuzzy/ranker-stop r) [q (count hits)]))))   ;=> [\"bet\" 1]"
  (send session [:rank (self) query limit]))
(sig rank-async (pid string &optional (or nil int) -> any))

(defn ranker-candidates (session:pid cands:seqable -> any)
  "Replace `session`'s candidate set with `cands` — the one thing about a session that is
not the query. Queries already queued are answered against whichever set has arrived first,
so a caller that cares should re-ask after replacing.

    (let (r (fuzzy/ranker [])) (fuzzy/ranker-candidates r [\"only\"]) (fuzzy/rank-async r \"on\") (receive ([:fuzzy-ranked ^r _ hits] (do (fuzzy/ranker-stop r) (count hits)))))   ;=> 1"
  (send session [:candidates cands]))

(defn ranker-stop (session:pid -> any)
  "End `session`. The process exits once it reaches the message; anything queued behind it
is dropped with the mailbox.

    (let (r (fuzzy/ranker [\"a\"]) m (monitor r)) (fuzzy/ranker-stop r) (receive ([:down ^m _ reason] reason)))   ;=> :normal"
  (send session [:stop]))

;; ---- nearest names: "did you mean" ------------------------------------------
;; Not the subsequence matcher above: a typo drops, doubles or swaps a character, which a
;; subsequence test misses, so this ranks by edit distance. Tooling that answers an unbound
;; name with a suggestion asks here, so every surface suggests the same names.

(defn- edit-row (previous-row character other-characters row-index)
  "One row of the Levenshtein table: the cost of turning the first `row-index + 1`
characters of one string into each prefix of `other-characters` (a vector)."
  (let (width (count other-characters))
    (letrec (go (fn (column left row)
                  (if (= column width)
                    row
                    (let (cost (if (= character (nth other-characters column)) 0 1)
                          cell (math/min (+ (nth previous-row (+ column 1) 0) 1)
                                 (+ left 1)
                                 (+ (nth previous-row column 0) cost)))
                      (go (+ column 1) cell (conj row cell))))))
      (go 0 (+ row-index 1) [(+ row-index 1)]))))

(defn- characters-distance (characters other-characters)
  "The edit distance between two codepoint lists — one immutable row per character of
`characters`, O(n·m) time."
  (let (others (vec other-characters)
        first-row (vec (range 0 (+ (count others) 1))))
    (letrec (go (fn (remaining row-index row)
                  (if (empty? remaining)
                    (nth row (count others) 0)
                    (go (rest remaining)
                      (+ row-index 1)
                      (edit-row row (first remaining) others row-index)))))
      (go characters 0 first-row))))

(defn edit-distance (a:string b:string -> int)
  "The Levenshtein distance between `a` and `b`: the fewest single-character insertions,
deletions and substitutions turning one into the other, counted in codepoints.

    (fuzzy/edit-distance \"kitten\" \"sitting\")   ;=> 3
    (fuzzy/edit-distance \"reduc\" \"reduce\")   ;=> 1
    (fuzzy/edit-distance \"\" \"abc\")   ;=> 3"
  (characters-distance (string/->list a) (string/->list b)))

(defn nearest (candidates:seqable name:string -> list)
  "The \"did you mean\" for `name`: at most three of `candidates` within edit distance
`max(1, length/3)` of it, nearest first, ties alphabetical. `name` itself and duplicates
are never offered, and the threshold grows with the name, so a short unrelated candidate
(`x` for `frobnicate`) is not.

    (fuzzy/nearest [\"reduce\" \"reduced\" \"map\"] \"reduc\")   ;=> (\"reduce\")
    (fuzzy/nearest [\"cot\" \"bat\" \"cat\" \"cab\" \"bat\"] \"cat\")   ;=> (\"bat\" \"cab\" \"cot\")
    (fuzzy/nearest [\"reduce\" \"map\"] \"zzqqxx\")   ;=> ()"
  (let (characters (string/->list name)
        length (count characters)
        limit (math/max 1 (math/quot length 3))
        scored (fold (into #{} candidates)
                 '()
                 (fn (acc candidate)
                   (let (candidate-characters (string/->list candidate))
                     (if (or (= candidate name)
                           (> (math/abs (- (count candidate-characters) length)) limit))
                       acc
                       (let (distance (characters-distance characters candidate-characters))
                         (if (> distance limit) acc (cons [distance candidate] acc))))))))
    (map (take (sort scored) 3) second)))
