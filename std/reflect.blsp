;; std/reflect.blsp — reading Brood source as DATA: the advisory checker, the reader's
;; lossless CST, the string/comment-aware scanners, and where a definition lives.
;;
;; The split from core is "what a program does to itself" vs "what a tool does to source
;; text". Interactive introspection — `doc`, `arglist`, `bound?`, `apropos`, `doc-search`,
;; `macroexpand` — stays bare, because you type it at a REPL and namespacing it would tax
;; the most common exploratory use. Everything here takes a FILE or a SOURCE STRING and is
;; called by tooling (`nest check`, the LSP, the MCP server, the doc builder), never in the
;; middle of an algorithm.
;;
;; `check-allow` deliberately stays core: it is a source PRAGMA, matched textually out of
;; the source by the Rust checker the way `sig` is, and it reads at 42 call sites as part of
;; the code rather than as a call into a tool.
;;
;; Ten of this module's names are KERNEL primitives, registered under `reflect/` in Rust
;; the way `bit/and` and `proc/register` are (`crates/lisp/src/builtins.rs`): Rust
;; supplies the mechanism, the namespace is Brood's. Every one takes a file, a source
;; string or a form and is called by TOOLING, which is this module's charter; and eval and
;; load are too generic to take from a user's own top-level `def`. The bare namespace is the scarce resource. `(:use reflect)` brings
;; the whole surface back bare inside one module.
;;
;; A macro that EMITS one of these must emit the root escape — `'/reflect/current-ns`, not
;; `'reflect/current-ns` — so a consuming module that happens to `(:alias reflect …)`
;; something else cannot capture the reference. The prelude's `defability`/`defrecord`
;; expansions do exactly this.
(defmodule reflect
  "Reading Brood source as DATA: the advisory checker, the reader's lossless CST, the string- and comment-aware scanners, and where a definition lives.")

(defn reflect/read-string (s)
  "Parse the source string `s` into a single form (the first one). Errors on malformed
input. Text in, data out — which is what this module is for.

    (reflect/read-string \"(a b)\")   ;=> (a b)"
  (%read-string s))

(defn reflect/read-all (s)
  "Every top-level form in the source string `s`, as a list. What the module loader reads
a file with.

    (count (reflect/read-all \"(a) (b)\"))   ;=> 2"
  (%read-all s))

(defn reflect/read-first (s)
  "The first top-level form in `s`, or nil when it holds none.

    (reflect/read-first \"(a) (b)\")   ;=> (a)"
  (%read-first s))

(defn behaviour-ops (bname)
  "The op specs `defbehaviour` recorded for behaviour `bname`, or nil — which ops a module
claiming `(:implements bname)` must define, and at what arities. The checker and the LSP
read the same registry.

    (reflect/behaviour-ops 'No-Such-Behaviour)   ;=> nil

after `(defbehaviour Renderable (render (x)))`, `(reflect/behaviour-ops 'Renderable)`
answers `((render [x]))`."
  (get *protocols* bname))

(defn check (form)
  "Advisory type-check a quoted form: a list of warning strings, or nil. Never raises.

    (reflect/check '(+ 1 2))             ;=> nil
    (count (reflect/check '(+ 1 \"a\")))   ;=> 1"
  (%check form))

(defn check-deps-fp (dep-keys)
  "Recompute the fingerprint of a file's dep-keys (from check-file-deps) against the current global image. The incremental check cache reuses a file's warnings iff this equals the stored fingerprint.

    (reflect/check-deps-fp dep-keys)   ;~> the fingerprint, to compare with the one stored beside `dep-keys`"
  (%check-deps-fp dep-keys))

(defn strict-checking? ()
  "Is STRICT checking on for this process (`nest check --strict`, or `BROOD_CHECK_STRICT=1`)? A verdict depends on the mode that produced it, which is why the incremental check cache keys its manifest on this.

    (reflect/strict-checking?)   ;=> false"
  (%check-strict?))

(defn check-file (path & more)
  "Advisory type-check every top-level form in the file at path: a list of `path:line:col: warning: …` strings, or nil. Does not evaluate the file. `required-mods` is the file's transitive require-closure (module-name strings) — the KI-17 reachability set that flags a qualified `mod/name` whose module the file never requires; omit it (single-file / editor) to disable that lint.

    (reflect/check-file \"src/app.blsp\")   ;~> (\"src/app.blsp:3:5: warning: …\"), or nil"
  (if (empty? more) (%check-file path) (%check-file path (first more))))

(defn check-file-deps (path & more)
  "Incremental-cache check (ADR-119): returns [warnings dep-keys fingerprint] — the GNU warning strings, the set of global observations the check made, and a fingerprint of them against the current image. Store dep-keys+fingerprint; reuse warnings on a later run iff (check-deps-fp dep-keys) still matches and the file's mtime is unchanged. `required-mods`: see check-file.

    (reflect/check-file-deps \"src/app.blsp\")   ;~> [warnings dep-keys fingerprint]"
  (if (empty? more) (%check-file-deps path) (%check-file-deps path (first more))))

(defn check-file-structured (path & more)
  "Like check-file but returns a list of `{:file :line :col :message}` maps instead of GNU-format strings — for tools (the `nest mcp` `check` tool, editor diagnostics). `required-mods`: see check-file.

    (reflect/check-file-structured \"src/app.blsp\")   ;~> ({:file \"src/app.blsp\" :line 3 :col 5 :message \"…\"})"
  (if (empty? more) (%check-file-structured path) (%check-file-structured path (first more))))

(defn file-signatures (path)
  "The signature the checker holds for every function the file at path defines: a list of `{:name :sig :declared? :informative?}` maps, `:sig` written in source syntax (`\"(int int -> int)\"`) and ready to paste into a `(sig …)`, or nil where the type names a runtime kind the grammar cannot write. `:declared?` marks the ones a `(sig …)` already states; `:informative?` marks the ones saying something an all-`any` arrow does not. Does not evaluate the file. The bulk counterpart of the editor's declare-sig action.

    (reflect/file-signatures \"src/app.blsp\")   ;~> ({:name \"twice\" :sig \"(int -> int)\" :declared? false :informative? true})"
  (%file-signatures path))

(defn source-signatures (src)
  "[[file-signatures]] for source TEXT rather than a file: the checker's signature for every
function `src` defines, same `{:name :sig :declared? :informative?}` maps. `()` when `src`
doesn't parse, so a live editor buffer never errors mid-edit.

    (reflect/source-signatures \"(defn twice (n) (* 2 n))\")
    ;=> ({:name \"twice\" :sig \"(int -> int)\" :declared? false :informative? true})

The question [[expr-type]] cannot answer. A `(defn …)` form evaluates to its own NAME, so
the type of its value says nothing about the function — which is why a live evaluator
showing `=> foo` for a definition has nothing to put beside it. Shares one checker pass
with [[file-signatures]], so a buffer and the file it will be saved as cannot disagree.

    (get (first (reflect/source-signatures \"(defn twice (x) (* 2 x))\")) :name)   ;=> \"twice\""
  (%source-signatures src))

(defn check-string-structured (src)
  "Advisory type-check the source string `src`, returning a list of `{:line :col :message}` maps (1-based positions), or `()` when `src` doesn't parse (e.g. incomplete input) — the string-source counterpart of check-file-structured, for live editor-buffer diagnostics.

    (reflect/check-string-structured \"(+ 1 2)\")   ;=> nil
    (get (first (reflect/check-string-structured \"(+ 1 \\\"a\\\")\")) :line)   ;=> 1"
  (%check-string-structured src))

(defn check-string-here (src)
  "Advisory type-check the source string `src` **as it is about to be evaluated here**:
under this process's current compile context — the namespace `defmodule` last opened and
its `(:use …)` imports — rather than as a file of its own. The same `{:line :col
:message}` maps as [[check-string-structured]], `()` when `src` doesn't parse.

What a REPL line or an editor's eval-in-buffer wants: a form pulled out of a module's
buffer names the module's imports bare and its `deftype`s by their short names, and only
this context resolves them the way `eval` will — checked as a standalone file, every one
of them reads as unbound. Forms that open a `(defmodule …)` of their own are checked under
it, as a file would be.

    (reflect/check-string-here \"(+ 1 2)\")   ;=> nil"
  (%check-string-here src))

(defn source-deps (src)
  "Per TOP-LEVEL form of `src`, in document order, what it defines, what globals it uses,
and which of those change the world outside the evaluation: a list of
`{:defines (…) :references (…) :effects (…)}` maps of name strings.

    (reflect/source-deps \"(defn twice (n) (* 2 n))\\n(twice 4)\")
    ;=> ({:defines (\"twice\") :references (\"*\") :effects ()}
    ;    {:defines () :references (\"twice\") :effects ()})
    (:effects (first (reflect/source-deps \"(file/spit \\\"notes.txt\\\" \\\"\\\")\")))   ;=> (\"file/spit\")

`:effects` are the calls a live evaluator must not make on a half-typed form: a file
written, moved or removed, a program run, a signal sent, the runtime halted. An electric
pair closes `(file/spit \"notes.txt\" \"\")` a moment before the text is typed, and a buffer
that evaluates as you type would empty the file. Reads and prints are not effects here —
running those early costs nothing. Every such call in the form counts, including one inside
a function the form only DEFINES: whether evaluating the form runs it (a `defn` does not, a
`def` of a call does) is the caller's to decide.

The question a live evaluator has to answer to avoid re-running a whole buffer on every
keystroke: given that one form changed, which of the forms below it could possibly be
affected? Without this the only correct answer is \"all of them\", so a buffer of twenty
forms costs twenty evaluations per edit; with it, the transitive closure of \"references
something a re-run form defines\" — usually one form, and never fewer than is correct.

Syntactic, and read the way find-references reads: locals are excluded (a parameter named
`map` is not a use of `map`) and a plain `'…` quote is data rather than a use. Two things it
cannot see, both the caller's policy to decide: a name a macro introduces, and a side effect
— a `spawn`, a table write, a print — through which one form reaches another without naming
anything."
  (%source-deps src))

(defn- source-module (src)
  "`{:name :uses}` for the module source `src`: the name its `(defmodule …)` header opens (a
string; nil for a file with no header) and every name it refers to — its header's `(:use …)`
modules and every global its forms name ([[source-deps]]'s references), so a module reached
only through a qualified macro (`other/mac`) counts as well as one it `:use`s."
  (let (header (check-allow :discarded-catch (try (%read-first src) (catch _ nil)))
        name (when (and (list? header) (= (first header) 'defmodule) (symbol? (second header)))
               (->string (second header)))
        uses (check-allow :discarded-catch
               (try (mapcat (%source-deps src) (fn (form) (or (:references form) ()))) (catch _ ()))))
    {:name name :uses uses}))

(defn- source-required (uses modules)
  "The modules of `modules` (name -> file) that the reference names `uses` reach: a name that
IS a module (a header's `(:use b)`), or whose qualifier is one (`b/f`, `b/mac`)."
  (seq/distinct (seq/keep uses
                  (fn (used)
                    (cond
                      (contains? modules used) used
                      (includes? used "/")
                        (let (qualifier (string/substring used 0 (string/last-index-of used "/")))
                          (when (contains? modules qualifier) qualifier))
                      else nil)))))

(defn source-load-order (files)
  "`files` (paths of `.blsp` sources) reordered so each comes after the files whose modules it
requires — its `(:use …)` modules and the modules it names qualified — the order a fresh load
would have run them in: the given order, but with a file's requirements moved up to just before
it (as a load requires them on reaching it). A require cycle is broken where the walk meets it.

What reloading SEVERAL changed files needs (`project/reload-changed`, an editor updating a
plugin): `reflect/load` of one file in walk order would expand a caller's macro with the
definition it already had, and only a second reload would pick up the changed one. Reads
each file's text; does not evaluate it.

    (reflect/source-load-order [])   ;=> []"
  (let (infos (map files (fn (file) [file (source-module (file/slurp file))]))
        modules (into {}
                  (seq/keep infos (fn ([file info]) (when (:name info) [(:name info) file]))))
        required (into {}
                   (map infos
                     (fn ([file info])
                       [file
                         (seq/keep (source-required (:uses info) modules)
                           (fn (module)
                             (let (dependency (get modules module))
                               (when (not (= dependency file)) dependency))))]))))
    ;; depth-first, a file's requirements before it: `[file expanded?]` frames on an
    ;; explicit stack, `entered` to break a cycle, `done` for what is already placed
    (letrec (walk (fn (stack entered done out)
                    (if (empty? stack)
                      out
                      (let ([file expanded?] (first stack)
                            more (rest stack))
                        (cond
                          expanded?
                            (if (contains? done file)
                              (walk more entered done out)
                              (walk more entered (conj done file) (conj out file)))
                          (contains? entered file) (walk more entered done out)
                          else
                            (walk (append (map (get required file)
                                            (fn (dependency) [dependency false]))
                                    (cons [file true] more))
                              (conj entered file)
                              done
                              out))))))
      (walk (map files (fn (file) [file false])) #{} #{} []))))

(defn references-in-source (name source)
  "Occurrences of the global `name` in `source`, as a list of [line col] (1-based); locals that shadow it are excluded.

    (reflect/references-in-source 'inc \"(inc 1)\\n(let (inc 2) inc)\\n(inc 3)\")   ;=> ([1 2] [3 2])"
  (%references-in-source name source))

(defn parse-source (s:string -> (vector any))
  "Parse s into a lossless CST tree as nested vectors (mechanism for std/format.blsp).

    (reflect/parse-source \"(a)\")   ;=> [:root [[:list [[:symbol \"a\"]]]]]"
  (%parse-source s))

(defn parse-source-positioned (s:string -> (map keyword any))
  "Parse s into a CST of maps, each `{:kind :start :end}` (leaves add :text, containers/wrappers add :kids) with half-open character offsets — for structural navigation (std/sexp).

    (get (reflect/parse-source-positioned \"(a b)\") :kind)   ;=> :root"
  (%parse-source-positioned s))

(defn scan-form-start (s pos)
  "The greatest char offset <= pos of a top-level (bracket depth 0) open bracket in s lying OUTSIDE any string or ; comment, else 0 — depth-tracked, not the Emacs column-0 heuristic, so a mis-indented open bracket at column 0 inside an unclosed form is not a form start — the string/comment-aware beginning-of-defun behind highlight/safe-restart and tool/sexp narrowing. The required forward lexical pass (a backward scan cannot know string state) runs natively: O(pos) at native speed instead of interpreted per-char cost on every eldoc/fontify-restart in a large buffer. s may be a string or a rope (ADR-488): a rope is read in place, and its safepoint table is carried across edits from the last ropes scanned, so a query after a keystroke re-scans about one form rather than the document.

    (reflect/scan-form-start \"(a)\\n(b \\\"(\\\" c)\" 12)   ;=> 4"
  (%scan-form-start s pos))

(defn scan-form-start-2 (s pos)
  "[prev start] — the greatest top-level (depth-0) form-start offset <= pos AND the one before it, from a SINGLE forward pass. What tool/sexp narrowing actually wants: computing the pair as two scan-form-start calls runs the O(pos) lexical pass twice over the same prefix. prev is 0 when there is no earlier form start, matching what the second call returned there. s may be a string or a rope, as for scan-form-start.

    (reflect/scan-form-start-2 \"(a)\\n(b)\\n(c)\" 9)   ;=> [4 8]"
  (%scan-form-start-2 s pos))

(defn scan-form-end (s from n-forms)
  "The char offset just after n-forms top-level forms starting at char offset from, skipping strings/comments and tracking bracket depth, or the length of s if the text ends first. s may be a string or a rope, read in place from from. The forward window-end companion to scan-form-start: tool/sexp narrowing uses the pair to bound structural motion to the neighbourhood of point in ONE native pass, replacing an interpreted char-at loop that was the dominant cost of every keystroke-driven motion.

    (reflect/scan-form-end \"(a) (b c) d\" 0 2)   ;=> 9"
  (%scan-form-end s from n-forms))

(defn scan-source-extract (src)
  "Native per-file scan for the whole-project check (ADR-119): parse src and return [counts privs def-names] — a map of every symbol's occurrence count, this file's `defn-`/`def-` privates as [bare qual], and every top-level def's qualified name. The fast path replacing the interpreted CST walk.

    (nth (reflect/scan-source-extract \"(defn f () 1)\") 2)   ;=> (\"f\")"
  (%scan-source-extract src))

(defn scan-tokens (s)
  "Lexically tokenize Brood source s into a vector of [start end kind text] tokens (char offsets, end-exclusive; whitespace skipped). kind is :comment, :string, :number, :keyword, :symbol, :open, or :close. The lossless token stream a fontifier / structural tool walks — the per-char scan runs natively, leaving policy (faces, head-position) to the consumer over O(tokens).

    (reflect/scan-tokens \"(f 1)\")   ;=> [[0 1 :open \"(\"] [1 2 :symbol \"f\"] [3 4 :number \"1\"] [4 5 :close \")\"]]"
  (%scan-tokens s))

(defn resolves? (name:symbol -> bool)
  "Whether `name` — a symbol — names something that EXISTS, loading its module first if
`name` is qualified and that module is not loaded yet.

`bound?` cannot answer this. It asks the current scope, and a module-qualified name is
not in any scope until its module has been loaded, so `(bound? 'regex/find)` is false in
a fresh image whether or not `regex/find` exists. That makes it useless for the question
a documentation check actually asks — \"does the name this prose cites exist?\" — which
is why bedit's tutorial had a gate for exactly that which could not be written.

    (reflect/resolves? 'regex/find)         ;=> true
    (reflect/resolves? 'regex/no-such)      ;=> false
    (reflect/resolves? 'no-such-module/x)   ;=> false   ; a module that will not load
    (reflect/resolves? 'map)                ;=> true    ; bare names are just `bound?`

Loading is a side effect, and deliberate: there is no way to know whether a name exists
without the module that would define it. A module that fails to load answers false
rather than raising — to a caller asking whether a citation is good, a module that
cannot load is a citation that does not work."
  ;; A name already bound answers at once, loading nothing. Otherwise the REFERENCE is
  ;; evaluated, which loads the module the way code naming it would (ADR-560): the module
  ;; a name means is not the text before its first `/` (`editor/buffer/make-buffer` is
  ;; module `editor/buffer`), and inside a project `model/f` is the project's
  ;; `bedit/model/f` — requiring `'model` by that spelling loaded the project's module a
  ;; SECOND time under another name, redefining every function in it.
  (cond
    (bound? name) true
    ;; bare (or the `/` operator itself), and unbound — `index-of` answers -1, never nil
    (< (index-of (->string name) "/") 1) false
    else
      (check-allow :discarded-catch
        (or (try (do (reflect/eval name) true) (catch _ false)) (bound? name)))))

(defn call-if-bound (name fallback & args)
  "Call the function `name` — a symbol, resolved NOW — with `args`, or answer `fallback`
when nothing is bound under it. The late-bound call a registry of hooks wants: a hook kept
as a symbol takes a redefinition on its next call, and one whose module has not loaded yet
is simply absent rather than an `unbound symbol` error. It does not load the module — a
hook in a module nobody has opened is not a hook yet (that is `resolves?`'s job).

    (reflect/call-if-bound 'inc 0 41)          ;=> 42
    (reflect/call-if-bound 'no-such-fn :none 1) ;=> :none"
  (if (bound? name) (apply (reflect/eval name) args) fallback))

(defn source-location (name)
  "Where global name was defined, as [file line col], or nil. Quote it: (source-location 'foo).

    (reflect/source-location 'no-such-global-xyz)   ;=> nil"
  (%source-location name))

(defn declared-signature (name)
  "The type expression a `(sig …)` DECLARED for global `name`, as the author wrote it —
`\"(model any -> model)\"` — or nil when none was declared. [[type-signature]] answers
the checker's view (declared, curated or inferred, aliases expanded); this answers the
CONTRACT as stated, which is what an editor shows beside a command's name. Symbol or
string arg; a `deftype` alias is a type, not a signature, and answers nil.

    (do (require-one 'hash) (reflect/declared-signature 'hash/md5))   ;=> \"(string -> string)\"
    (reflect/declared-signature 'inc)   ;=> nil"
  (let (form (%declared-sig name)) (if (nil? form) nil (pr-str form))))

(defn type-aliases (&optional module: (or nil string symbol) -> (or nil (list map)))
  "Every `(deftype name T)` alias the checker knows (ADR-327), as `{:name :type}` maps —
the qualified name and the type-expression as written, rendered — sorted by name. With
`module` (a symbol or string), only that module's: `(type-aliases 'editor/pane)`. A
`deftype` binds no global, so this is the only way to enumerate them; `nest doc` renders
a module's under a Types heading.

    (reflect/type-aliases 'editor/pane)   ;~> ({:name \"editor/pane/…\" :type \"…\"} …)"
  (let (prefix (if (nil? module) nil (str (->string module) "/"))
        entries (seq/filter (%type-aliases)
                  (fn (entry) (or (nil? prefix) (string/starts-with? (first entry) prefix)))))
    (seq/sort-by (map entries (fn (entry) {:name (first entry) :type (pr-str (second entry))}))
      :name)))

(defn type-signature (name)
  "The checker's type signature for global `name` (declared/curated/inferred) as an arrow string like \"(int -> int)\", or nil if it can't be pinned. Symbol or string arg: (type-signature 'map).

    (reflect/type-signature 'inc)   ;=> \"(number) -> number\""
  (%type-signature name))

(defn expr-type (src)
  "The type the advisory checker infers for the FIRST form in source string `src`, written
the way a `sig` is — `\"int\"`, `\"(list any)\"`, `\"(int -> int)\"` — or nil when `src`
doesn't parse or the checker has no opinion.

    (reflect/expr-type \"(+ 1 2)\")   ;~> \"int\"

[[type-signature]] answers this for a NAMED global; this answers it for an anonymous
expression you just typed, which is what a REPL or a scratch buffer has to work with. Nil
rather than an error on unparsable input, like [[check-string-structured]]: both get read
live, from a buffer that is mid-edit half the time.

    (reflect/expr-type \"(+ 1 2)\")   ;=> \"3\"
    (reflect/expr-type \"(str 1)\")   ;=> \"string\""
  (%expr-type src))

(defn form-pos (form)
  "A form's [line col] source position, or nil.

    (reflect/form-pos 42)   ;=> nil"
  (%form-pos form))

(defn current-file ()
  "The path of the file currently being loaded, or nil.

    (reflect/current-file)   ;~> the path being loaded, e.g. \"src/app.blsp\", or nil"
  (%current-file))
