;; std/json.blsp — JSON ↔ Brood data, written entirely in Brood.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - **Policy in Brood, not Rust** (ADR-006): a JSON reader/writer is exactly the
;;    kind of thing that belongs in the language, not the kernel. It's pure
;;    data→data, so it's a recursive-descent parser threaded through a position
;;    index (Brood has no loops — tail recursion + an accumulator), and an encoder
;;    that walks a value. Not built for speed; built to dogfood the language (and to
;;    unblock the build-watcher frontend, which speaks JSON to its daemon).
;;  - **The JSON ⇄ Brood mapping:**
;;      object → map with **keyword** keys — idiomatic Brood (`(get obj :repo)`,
;;             destructuring, `match`). A JSON key becomes `(keyword k)`; encoding
;;             turns it back into a string key via the keyword's name, so the data
;;             round-trips even for keys that print oddly (spaces / digits).
;;      array  → vector       string → string     number → int or float
;;      true/false → bool     null   → nil
;;    Encoding accepts those plus string keys (emitted as-is) and lists (as arrays).
;;  - **`\uXXXX` with no codepoint primitive:** pure Brood can't build a character
;;    from an integer — but the *reader* decodes `\u{H..H}` escapes, so we synthesize
;;    the one-char Brood source `"\u{H..H}"` and `reflect/read-string` it. That makes the
;;    whole library Rust-free (the reader is the codepoint→char mechanism), including
;;    `\b`/`\f` and astral surrogate pairs.
;;  - Pure, opt-in (`require`), never in the prelude.

(defmodule json
  "JSON ↔ Brood data, written entirely in Brood (pure; opt-in).

    (decode \"{\\\"a\\\":[1,2],\\\"b\\\":true}\")  ; => {:a [1 2] :b true}
    (encode {:a [1 2] :b nil})                ; => \"{\\\"a\\\":[1,2],\\\"b\\\":null}\"

`decode` maps a JSON object → a Brood map with **keyword** keys (`(get m :repo)`),
array → vector, string → string, number → int/float, true/false → bool, null → nil;
it errors on malformed input. `encode` is the inverse — it accepts keyword,
symbol, or string keys (all emitted as JSON string keys) and keyword/symbol values
(emitted as their name) and lists (as arrays). Not optimised — a recursive-descent
parser for dogfooding and modest payloads (e.g. a daemon's JSON API).")

;; ---- codepoint → char, via the reader (the one tricky bit) ------------------
;;
;; Pure Brood has no integer→char primitive, but the scanner decodes `\u{H..H}`
;; string escapes — so `(reflect/read-string "\"\\u{41}\"")` reads the Brood string "A".
;; We build that source and read it. Used for `\uXXXX`, `\b`, `\f`.

(def- json-hex-digits "0123456789abcdef")

(defn- int->hex-acc (n acc)
  (if (= n 0)
    acc
    (int->hex-acc (math/quot n 16) (str (string/char-at json-hex-digits (math/rem n 16)) acc))))

(defn- int->hex (n)
  "The lowercase hex string for non-negative int `n` (`0` → \"0\")."
  (if (= n 0) "0" (int->hex-acc n "")))

(defn- cp->string (cp)
  "The one-character string for Unicode code point `cp`, via a `\\u{…}` reader
escape (the codepoint→char mechanism pure Brood otherwise lacks)."
  (reflect/read-string (str "\"\\u{" (int->hex cp) "}\"")))

;; ---- parse ------------------------------------------------------------------
;;
;; Each `json-X (s i n)` reads from char index `i` of source `s` (count `n`) and
;; returns `[value next-index]`. Whitespace is skipped between tokens. Tail
;; recursion + accumulators throughout; `error` on anything malformed.

;; The parser indexes a vector of INTEGER CODE POINTS (built once in `decode`),
;; not the raw string and not 1-char strings. `char-at` on a UTF-8 string is O(i),
;; so calling it at every position made parsing O(n^2); and 1-char-string tokens made
;; every comparison a string-equality through the slow dispatch path. Int codes make
;; every per-char test a pure integer prim (`=`/`<=` on i64s — register work in a
;; JIT'd arm), the same conversion that took the regex matcher call-free. `s` in every
;; parser helper below is that code vector; -1 is the end-of-input sentinel.
(defn- json-at (s i n)
  "The code point at `i`, or -1 at/after the end (so callers never index past `n`)."
  (if (< i n) (nth s i) -1))

(defn- json-slice (s i end)
  "The code points [i, end) of `s`, joined back into a string."
  (%codepoints->string (seq/subvec s i end)))
(sig json-slice (vector int any -> string))

(defn- ws? (c) (or (= c 32) (= c 9) (= c 10) (= c 13)))

(defn- skip-ws (s i n)
  (if (and (< i n) (ws? (nth s i))) (skip-ws s (+ i 1) n) i))
(sig skip-ws (vector int int -> int))

(defn- digit? (c) (and (>= c 48) (<= c 57)))

;; -- numbers --
(defn- num-end (s i n)
  (if (< i n)
    (let (c (nth s i))
      ;; digit or one of `-+.eE` (45 43 46 101 69)
      (if (or (digit? c) (= c 45) (= c 43) (= c 46) (= c 101) (= c 69))
        (num-end s (+ i 1) n)
        i))
    i))

;; Strict JSON number validation (RFC 8259): `string/->number` is lenient (it accepts
;; a leading `+` and leading zeros — `+5`, `01`), which JSON forbids. We munch the
;; token loosely with `num-end`, then validate it against the grammar
;;   number = [-] int [frac] [exp],  int = 0 | [1-9] digit*
;;   frac = . digit+,  exp = [eE] [+-]? digit+
;; before handing it to `string/->number`. The validators walk the same code vector
;; over the token's [i, end) range — no token string is built unless it parses.
(defn- digits-run (s i n)
  ; consume zero or more digits
  (if (and (< i n) (digit? (nth s i))) (digits-run s (+ i 1) n) i))

(defn- int-end (s i n)
  "Index after the integer part at `i`, or nil. A lone `0`, or `[1-9]` then digits —
no leading zeros."
  (cond
    (>= i n) nil
    (= (nth s i) 48) (+ i 1)
    ; lone 0 (leading-zero check below)
    (digit? (nth s i)) (digits-run s (+ i 1) n)
    else nil))

(defn- frac-end (s i n)
  "Index after an optional `.digit+` fraction at `i`; `i` unchanged if none; nil if a
`.` isn't followed by a digit."
  (if (and (< i n) (= (nth s i) 46))
    (if (and (< (+ i 1) n) (digit? (nth s (+ i 1))))
      (digits-run s (+ i 2) n)
      nil)
    i))

(defn- exp-end (s i n)
  "Index after an optional `[eE][+-]?digit+` exponent at `i`; `i` unchanged if none;
nil if malformed."
  (if (and (< i n) (or (= (nth s i) 101) (= (nth s i) 69)))
    (let (j (if (and (< (+ i 1) n) (or (= (nth s (+ i 1)) 43) (= (nth s (+ i 1)) 45)))
              (+ i 2)
              (+ i 1)))
      (if (and (< j n) (digit? (nth s j)))
        (digits-run s (+ j 1) n)
        nil))
    i))

; the grammar must consume the whole token
(defn- strict-number? (s i end)
  "True iff the codes [i, end) form a strict JSON number (rejects a leading `+` and
leading zeros)."
  (let (j (if (and (< i end) (= (nth s i) 45)) (+ i 1) i)
        j (int-end s j end))
    (and j
      (let (j (frac-end s j end))
        (and j
          (let (j (exp-end s j end))
            (and j (= j end))))))))
(defn- json-number (s i n)
  (let (end (num-end s i n))
    (if (strict-number? s i end)
      [(string/->number (json-slice s i end)) end]
      (error "json: invalid number '" (json-slice s i end) "' at index " i))))

;; -- strings --
(defn- hex-val (c)
  "The value of hex-digit code `c` (0-9 a-f A-F), or nil."
  (cond
    (and (>= c 48) (<= c 57)) (- c 48)
    (and (>= c 97) (<= c 102)) (- c 87)
    (and (>= c 65) (<= c 70)) (- c 55)
    else nil))

(defn- hex1 (s i)
  (let (v (hex-val (nth s i)))
    (if (nil? v) (error "json: invalid hex digit in \\u escape at index " i) v)))

(defn- hex4 (s i)
  "The int value of the four hex digits at `i` (a `\\uXXXX` body)."
  (+ (* 4096 (hex1 s i))
    (* 256 (hex1 s (+ i 1)))
    (* 16 (hex1 s (+ i 2)))
    (hex1 s (+ i 3))))

(defn- json-unicode (s i n)
  "A `\\uXXXX` escape body starting at `i` (after the `u`): decode one BMP code
point, or combine a high+low surrogate pair into one astral code point. Returns
`[code next-index]`."
  (if (> (+ i 4) n)
    (error "json: truncated \\u escape at index " i)
    (let (hi (hex4 s i))
      (cond
        ; D800..DBFF: high surrogate — the low half must follow as `\uXXXX` (92 117)
        (and (>= hi 55296) (<= hi 56319))
          (if (and (<= (+ i 10) n) (= (nth s (+ i 4)) 92) (= (nth s (+ i 5)) 117))
            (let (lo (hex4 s (+ i 6)))
              ;; The second escape must be a LOW surrogate (DC00..DFFF). Without this
              ;; check `\uD800A` computed 65536 + 0 - 56320 + 65 = a bogus
              ;; codepoint (U+2441) and `(json/decode "\"\\uD800\\u0041\"")` silently
              ;; returned "⑁" — a mis-decode, which is worse than an error.
              (if (or (< lo 56320) (> lo 57343))
                (error "json: high surrogate at index " i " is not followed by a low surrogate")
                [(+ 65536 (* 1024 (- hi 55296)) (- lo 56320)) (+ i 10)]))
            (error "json: lone high surrogate at index " i))
        ; DC00..DFFF: a low surrogate with no high half before it is equally invalid —
        ; it used to fall through to `string/int->char`, which raised the KERNEL's message
        ; ("string/int->char: 56320 is not a valid Unicode codepoint") instead of a json one.
        (and (>= hi 56320) (<= hi 57343)) (error "json: lone low surrogate at index " i)
        else [hi (+ i 4)]))))

(defn- json-escape (s i n)
  "An escape body starting at `i` (after the backslash). Returns `[code next-index]`."
  (let (c (json-at s i n))
    (cond
      (= c 34) [34 (+ i 1)]
      ; \"
      (= c 92) [92 (+ i 1)]
      ; \\
      (= c 47) [47 (+ i 1)]
      ; \/
      (= c 110) [10 (+ i 1)]
      ; \n
      (= c 116) [9 (+ i 1)]
      ; \t
      (= c 114) [13 (+ i 1)]
      ; \r
      (= c 98) [8 (+ i 1)]
      ; \b
      (= c 102) [12 (+ i 1)]
      ; \f
      (= c 117) (json-unicode s (+ i 1) n)
      else (error "json: invalid escape at index " i))))

;; `acc` is the content CODES collected in reverse; the string is assembled once at
;; the close quote. (The old per-char `(str acc c)` rebuilt the whole accumulator
;; each step — O(n²) over a long string body.)
(defn- string-acc (s i n acc)
  (let (c (json-at s i n))
    (cond
      (= c -1) (error "json: unterminated string")
      ;; `%codepoints->string`, not `(apply str (map int->char …))`: one native pass
      ;; instead of a one-character string plus a closure call per code point, then an
      ;; N-way variadic concat. This runs once per string and key in the document.
      (= c 34) [(%codepoints->string (reverse acc)) (+ i 1)]
      (= c 92) (let ([cp j] (json-escape s (+ i 1) n)) (string-acc s j n (cons cp acc)))
      ;; RFC 8259 §7: U+0000–U+001F MUST be escaped inside a string. A raw newline
      ;; or tab in a string body is malformed JSON, not content — accepting it made
      ;; `{"a": "x<TAB>y"}` parse where every conforming parser rejects it.
      ;; (JSONTestSuite n_string_unescaped_{ctrl_char,newline,tab}.)
      (< c 32)
        (error "json: unescaped control character in string: U+"
          (string/pad-left (string/upper (int->hex c)) 4 "0"))
      else (string-acc s (+ i 1) n (cons c acc)))))

(defn- json-string (s i n)
  "A string body starting at `i` (just after the opening quote). Returns `[str end]`."
  (string-acc s i n nil))

;; -- literals --
(defn- lit-match (s i codes k m)
  (if (>= k m)
    true
    (and (= (nth s (+ i k)) (nth codes k)) (lit-match s i codes (+ k 1) m))))

(defn- json-lit (s i n codes val)
  "Match the literal spelled by code-vector `codes` at `i`; returns `[val end]`."
  (let (m (count codes)
        end (+ i m))
    (if (and (<= end n) (lit-match s i codes 0 m))
      [val end]
      (error "json: invalid literal at index " i))))

;; -- arrays --
(defn- array-acc (s i n acc)
  (let ([v j0] (json-value s i n)
        j (skip-ws s j0 n)
        acc2 (cons v acc)
        c (json-at s j n))
    (cond
      (= c 44) (array-acc s (skip-ws s (+ j 1) n) n acc2)
      ; ,
      (= c 93) [(into [] (reverse acc2)) (+ j 1)]
      ; ]
      else (error "json: expected ',' or ']' in array at index " j))))

(defn- json-array (s i n)
  "An array body starting at `i` (just after `[`). Returns `[vector end]`."
  (let (i2 (skip-ws s i n))
    (if (= (json-at s i2 n) 93)
      [[] (+ i2 1)]
      (array-acc s i2 n nil))))

;; -- objects --
(defn- object-acc (s i n acc)
  (let (i2 (skip-ws s i n))
    (if (not (= (json-at s i2 n) 34))
      (error "json: expected string key at index " i2)
      (let ([k j0] (json-string s (+ i2 1) n)
            j1 (skip-ws s j0 n))
        (if (not (= (json-at s j1 n) 58))
          (error "json: expected ':' after key at index " j1)
          (let ([v j2] (json-value s (skip-ws s (+ j1 1) n) n)
                j3 (skip-ws s j2 n)
                ; JSON keys → keywords (acc is always a map)
                acc2 (%map-assoc acc (keyword k) v)
                c (json-at s j3 n))
            (cond
              (= c 44) (object-acc s (+ j3 1) n acc2)
              (= c 125) [acc2 (+ j3 1)]
              else (error "json: expected ',' or '}' in object at index " j3))))))))

(defn- json-object (s i n)
  "An object body starting at `i` (just after `{`). Returns `[map end]`."
  (let (i2 (skip-ws s i n))
    (if (= (json-at s i2 n) 125)
      [{} (+ i2 1)]
      (object-acc s i2 n {}))))

(defn- json-value (s i n)
  "One JSON value at index `i` (whitespace already skipped). Returns `[value end]`."
  (let (c (json-at s i n))
    (cond
      (= c 123) (json-object s (+ i 1) n)
      ; {
      (= c 91) (json-array s (+ i 1) n)
      ; [
      (= c 34) (json-string s (+ i 1) n)
      ; "
      (= c 116) (json-lit s i n [116 114 117 101] true)
      ; true
      (= c 102) (json-lit s i n [102 97 108 115 101] false)
      ; false
      (= c 110) (json-lit s i n [110 117 108 108] nil)
      ; null
      (= c -1) (error "json: unexpected end of input")
      else (json-number s i n))))
(sig json-value (vector int int -> vector))

(defn decode (s)
  "Parse JSON text `s` into Brood data: object → a map with **keyword** keys, array →
a vector, string → string, number → int/float, true/false → bool, null → nil. Errors
on malformed input or trailing content. Pure.

    (json/decode \"[1,2]\")   → [1 2]"
  (let (
        ; int code points: O(1) nth, one native pass
        s (string/->codepoints s)
        ; and pure-prim per-char tests
        n (count s)
        i (skip-ws s 0 n))
    (if (>= i n)
      (error "json: empty input")
      (let ([v j] (json-value s i n)
            k (skip-ws s j n))
        (if (< k n)
          (error "json: trailing content at index " k)
          v)))))
(sig decode (string -> (or map vector string number bool nil)))

;; ---- encode -----------------------------------------------------------------

(defn- enc-u (cp)
  "The `\\u00XX` escape for a control code point `cp` (< 0x20)."
  (str "\\u00"
    (string/char-at json-hex-digits (math/quot cp 16))
    (string/char-at json-hex-digits (math/rem cp 16))))

;; `[raw escape]` for every control char the named escapes below don't cover —
;; strict JSON forbids any raw char < U+0020 in a string, named escape or not.
(def- json-control-escapes
  (map (filter (range 32) (fn (cp) (not (includes? [8 9 10 12 13] cp))))
    (fn (cp) [(cp->string cp) (enc-u cp)])))

(defn- needs-escape? (s)
  "True if `s` contains any char JSON must escape: `\"` (34), `\\` (92), or a control
char (< 0x20). The common case is a clean ASCII string, so this one O(n) codepoint
scan lets `enc-escapes` skip ~27 whole-string `replace` passes (backslash/quote/
the named escapes + every C0 control) that would each find nothing."
  (any? (string/->codepoints s) (fn (c) (or (< c 32) (= c 34) (= c 92)))))

(defn- enc-escapes (s)
  "Escape the JSON-special characters in `s` (backslash first)."
  (if (not (needs-escape? s))
    ; clean — emit as-is (the overwhelmingly common case)
    s
    (fold json-control-escapes
      (-> s
        (string/replace "\\" "\\\\")
        (string/replace "\"" "\\\"")
        (string/replace "\n" "\\n")
        (string/replace "\r" "\\r")
        (string/replace "\t" "\\t")
        (string/replace "\u{8}" "\\b")
        (string/replace "\u{c}" "\\f"))
      (fn (acc [raw esc]) (string/replace acc raw esc)))))

(defn- enc-string (s) (str "\"" (enc-escapes s) "\""))

(defn- enc-key (k)
  "A JSON object key: a string as-is, a keyword/symbol by name, else its `str`."
  (enc-string (cond (keyword? k) (->string k) (symbol? k) (->string k) (string? k) k else (str k))))

;; The encoder EMITS into a reversed fragment list threaded through the recursion
;; (a string builder), assembled with one `(apply str (reverse …))` at the top. The
;; old shape built a string per pair, `join`ed per object (a lazy seq-view + realize
;; per node), and re-copied every enclosing level — this emits each fragment exactly
;; once and concatenates exactly once.
(defn- emit-pairs (pairs acc first?)
  (if (empty? pairs)
    acc
    (let ([k v] (first pairs)
          acc1 (if first? acc (cons "," acc))
          acc2 (emit v (cons ":" (cons (enc-key k) acc1))))
      (emit-pairs (rest pairs) acc2 false))))

(defn- emit-items (xs i n acc)
  (if (>= i n)
    acc
    (emit-items xs
      (+ i 1)
      n
      (emit (nth xs i) (if (= i 0) acc (cons "," acc))))))

(defn- emit-list (xs acc first?)
  (if (empty? xs)
    acc
    (emit-list (rest xs)
      (emit (first xs) (if first? acc (cons "," acc)))
      false)))

;; ---- JsonEncode: the extension seam for values JSON has no rule for ----------
;;
;; The built-in rules below are CLOSED — the JSON data model is fixed, so nil/bool/
;; number/string/keyword/symbol/map/vector/list stay a plain `cond` (no dispatch cost
;; on the hot path). What is open is everything *else*: a `defrecord` that wants a wire
;; shape other than its fields, and the kinds `emit` can only `error` on today (a
;; pid, a fn, a datetime record, a queue). `JsonEncode` is that seam — Brood's
;; `Jason.Encoder`: one op returning a value the built-in rules DO cover, which
;; `emit` then encodes normally.
;;
;; **No `:default` is registered, deliberately.** A `:default` would make every value
;; "encodable" and turn the loud error into an infinite recursion (a pid's default would
;; hand back the pid). With no `:default`, `custom` returning nil means exactly
;; "no rule for this identity", which is the question both call sites below ask.
(defability JsonEncode
  "How a value converts to a JSON-encodable Brood value (nil / bool / number / string /
  keyword / map / vector / list). The seam `encode` consults for a record with a
  custom wire shape, and for any kind JSON has no built-in rule for."
  (->json [self] :-> any))

(defn- custom (v)
  "`v`'s own `JsonEncode/->json` impl, or nil when its identity has none. `JsonEncode`
registers no `:default`, so nil here means \"no rule\" rather than \"the fallback\"."
  (%impl-for '[JsonEncode ->json] (%identity-of v)))

(defn- emit-record (v acc)
  "Emit record `v`. A custom `JsonEncode` impl decides the wire shape; otherwise the
default is its FIELDS — the internal `:__id__` identity must never reach the wire."
  (let (custom (custom v))
    (if custom
      (emit (custom v) acc)
      (cons "}" (emit-pairs (%map-pairs (fields v)) (cons "{" acc) true)))))

(defn- emit (v acc)
  "Emit `v`'s JSON fragments onto `acc` (reversed); returns the new acc."
  (cond
    (nil? v) (cons "null" acc)
    (= v true) (cons "true" acc)
    (= v false) (cons "false" acc)
    ;; NOT `number?`: that also covers `:ratio` and `:decimal`, whose `str` forms
    ;; (`1/3`, `1.50M`) are not JSON at all, and a float may be `inf`/`-inf`/`nan`,
    ;; which JSON has no syntax for either. All four used to be emitted verbatim,
    ;; producing output no parser on earth can read back — a silently corrupt
    ;; document rather than a loud failure. Ints and finite floats only; the rest
    ;; fall through to the `else` branch's "give its type a JsonEncode impl" error,
    ;; which is the documented escape hatch (encode a decimal as a string, say).
    (int? v) (cons (str v) acc)
    (float? v)
      (if (or (math/nan? v) (math/infinite? v))
        (error "json: cannot encode "
          (str v)
          " — JSON has no infinity or NaN; encode it as a string or null instead")
        (cons (str v) acc))
    (string? v) (cons (enc-string v) acc)
    (keyword? v) (cons (enc-string (->string v)) acc)
    (symbol? v) (cons (enc-string (->string v)) acc)
    (record? v) (emit-record v acc)
    (map? v) (cons "}" (emit-pairs (%map-pairs v) (cons "{" acc) true))
    (vector? v) (cons "]" (emit-items v 0 (count v) (cons "[" acc)))
    (list? v) (cons "]" (emit-list v (cons "[" acc) true))
    else
      (let (custom (custom v))
        (if custom
          (emit (custom v) acc)
          (error "json: cannot encode "
            v
            " (a "
            (type-of v)
            ") — give its type a JsonEncode impl to encode it")))))

(defn encode (v)
  "Encode Brood value `v` as JSON text: nil → null, true/false → bool, a number → a
number, a string → a quoted string, a keyword/symbol → a string of its name, a map →
an object (keyword keys become string keys), a vector or list → an array. A `defrecord`
value encodes as its **fields** (its internal id never reaches the wire) unless its type
has a `JsonEncode` impl, which then decides the wire shape. Any other kind (a pid, a fn)
errors unless it has a `JsonEncode` impl. Pure.

    (json/encode [1 2])   → \"[1,2]\""
  (apply str (reverse (emit v nil))))
(sig encode (any -> string))
