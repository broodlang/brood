;; std/version.blsp — semantic versions as data: parse, order, and test against a
;; constraint. Pure predicates over versions; the SELECTION algorithm (which version
;; to pick from a candidate set) lives one layer up in `std/resolver.blsp`.
;;
;; Why this exists: two consumers wrote it independently before it did. hive (the
;; package registry) needs "which published release is the newest"; an application
;; that hosts plugins needs "is this plugin's `:enhances {app \">= 0.3\"}` satisfied
;; by the version I am?" Both are questions *about two versions*, and both were
;; about to be answered by a third hand-rolled copy. Since then the dependency
;; resolver (ADR-209) became a third consumer: it asks the same "does this version
;; satisfy this range?" question millions of times while searching.
;;
;; What this module does and does not do: it answers whether ONE version satisfies
;; ONE constraint — a single term (`>= 1.2`, `^1.2`, `~> 1.3`) or a comma-separated
;; conjunction of them (`>= 1.2, < 2.0`). It chooses nothing and fetches nothing; the
;; backtracking search that picks a concrete version out of what a registry publishes
;; is the resolver's job. Keeping the predicate here and the search there is what lets
;; the resolver be a pure function tested offline (ADR-209).

(defmodule version
  "Semantic-version helpers: `core` (→ `[major minor patch]`),
`valid?`, `compare`, `newer?`, and `satisfies?`
(a version against a `\">= 1.2\"`-, `\"^1.2\"`-, `\"~> 1.3\"`-, or `\">= 1.2, < 2.0\"`-style
constraint). For repeated checks against one constraint, `compile` it once and
match many versions with `match?` / `match-parts?` — that is the fast path
the resolver runs. Comparison is on the numeric `MAJOR.MINOR.PATCH` core, then on
PRE-RELEASE precedence when the cores tie (`1.0.0-rc.1 < 1.0.0`; `prerelease` reads
the identifiers). A plain range excludes pre-releases; one that names a pre-release admits
them at that core (npm/Cargo rule). `+build` metadata never affects order or matching.")

;; ---- parsing ------------------------------------------------------------------

(defn core (v)
  "The `[major minor patch]` integers of version string `v`, ignoring any
`-prerelease` / `+build` suffix. A missing or non-numeric segment reads as 0, so
`\"1.2\"` is `(1 2)` and `\"1.x\"` is `(1 0)` — lenient, because this is used to
compare what a human typed in a manifest, not to validate it (that is
`valid?`).

    (version/core \"1.2.3-rc1\")   → (1 2 3)"
  (let (core (first (string/split (first (string/split v "+")) "-")))
    (map (fn (p) (or (string/->number p) 0)) (string/split core "."))))

(defn- digit-run?
  (s)
  (let (cps (string/->codepoints s))
    (and (not (empty? cps))
      (not (any? (fn (cp) (or (< cp 48) (> cp 57))) cps)))))

(defn valid? (v)
  "Whether `v` is a full `MAJOR.MINOR.PATCH` version — three segments, each a run of
ASCII digits — ignoring any `-prerelease` / `+build` suffix. The check a registry
applies on publish; `satisfies?` is deliberately more forgiving, since a
CONSTRAINT is usually written short (`\">= 0.3\"`).

    (version/valid? \"1.2.3\")   → true"
  (and (string? v)
    (let (core (first (string/split (first (string/split v "+")) "-"))
          parts (string/split core "."))
      (and (= (count parts) 3)
        (not (any? (fn (p) (not (digit-run? p))) parts))))))

;; ---- ordering -----------------------------------------------------------------

(defn compare (a b)
  "Compare two version STRINGS: -1, 0, or 1. On the numeric core first (shorter is not
smaller — `\"1.2\"` and `\"1.2.0\"` compare equal). When the cores tie, PRE-RELEASE precedence
decides (semver §11): a pre-release is LESS than its release (`1.0.0-rc.1 < 1.0.0`), and two
pre-releases compare identifier-by-identifier (numeric numerically and below alphanumeric;
more identifiers outrank a prefix). `+build` metadata never affects order.

    (version/compare \"1.2.0\" \"1.10.0\")   → -1"
  (let (c (compare-parts (core a) (core b)))
    (if (= c 0)
      (compare-prerelease (prerelease a) (prerelease b))
      c)))

(defn prerelease (v)
  "The pre-release identifiers of version string `v` (`\"1.0.0-rc.1\"` → `(\"rc\" \"1\")`), or
nil when there is none. Everything after the first `-` (and before any `+build`), split on
`.`. A `+build` suffix is dropped first — build metadata is not part of precedence.

    (version/prerelease \"1.0.0-rc1\")   → (\"rc1\")"
  (let (no-build (first (string/split v "+"))
        dash (index-of-str no-build "-"))
    (if (nil? dash)
      nil
      (string/split (string/substring no-build (+ dash 1) (string/length no-build)) "."))))

(defn- index-of-str
  (s sub)
  (let (i (index-of s sub)) (if (< i 0) nil i)))

(defn- compare-prerelease
  (a b)
  ;; a, b are identifier lists or nil. A release (nil) outranks any pre-release.
  (cond
    (and (nil? a) (nil? b)) 0
    (nil? a) 1
    (nil? b) -1
    else (compare-ids a b)))

(defn- compare-ids
  (a b)
  ;; identifier-by-identifier; a longer list outranks a prefix of it (semver §11.4.4).
  (cond
    (and (empty? a) (empty? b)) 0
    (empty? a) -1
    (empty? b) 1
    else (let (c (compare-id (first a) (first b)))
           (if (= c 0) (compare-ids (rest a) (rest b)) c))))

(defn- compare-id
  (x y)
  ;; numeric identifiers compare numerically and rank BELOW alphanumeric ones; two
  ;; alphanumeric identifiers compare in ASCII order.
  (let (nx (string/->number x)
        ny (string/->number y))
    (cond
      (and nx ny) (cond (< nx ny) -1 (> nx ny) 1 else 0)
      nx -1
      ny 1
      else (/compare x y))))

(defn- compare-parts
  (a b)
  ;; Missing tail segments read as 0 (so 1.2 == 1.2.0), which is what makes a
  ;; short constraint mean what a human means by it.
  (cond
    (and (empty? a) (empty? b)) 0
    else
      (let (x (if (empty? a) 0 (first a))
            y (if (empty? b) 0 (first b)))
        (cond
          (< x y) -1
          (> x y) 1
          else (compare-parts (if (empty? a) a (rest a))
                 (if (empty? b) b (rest b)))))))

(defn compare-cores (a b)
  "Compare two numeric cores (integer part-lists, as returned by `core`): -1, 0, or
1. For callers that have already parsed both versions and want to avoid re-parsing — the
resolver sorts and filters thousands of candidates this way."
  (compare-parts a b))

(defn newer? (a b)
  "Whether version `a` is strictly newer than `b`. The empty string is older than
everything (the \"no release yet\" placeholder a registry starts from).

    (version/newer? \"1.1.0\" \"1.0.9\")   → true"
  (cond
    (= b "") (not (= a ""))
    (= a "") false
    else (> (compare a b) 0)))

;; ---- constraints ---------------------------------------------------------------
;; One version, one constraint, a yes/no answer. A constraint is a single term
;; (`>= 1.2`, `> 1.2.3`, `<= 2.0`, `< 2`, `= 1.2.3`, a bare `1.2.3`, `^1.2`, or
;; `~> 1.3`) or a comma-separated CONJUNCTION of terms (`>= 1.2, < 2.0`) — every
;; term must hold. The caret/tilde families expand to a `>=`-plus-exclusive-`<`
;; range, so they add no new comparison, only a new spelling. This is the whole
;; vocabulary the resolver (ADR-209) matches candidate versions against.

(def *operators* ["~>" "<=" ">=" "<" ">" "=" "^"]) ; longest first: "<=" before "<"
(defn- digit-start?
  (s)
  (let (cps (string/->codepoints s))
    (and (not (empty? cps)) (>= (first cps) 48) (<= (first cps) 57))))

(defn- split-constraint
  (constraint)
  ;; `">= 1.2"` -> `[">=" "1.2"]`; a bare `"1.2"` -> `["=" "1.2"]`; `"^1.2"` ->
  ;; `["^" "1.2"]`; `"~> 1.3"` -> `["~>" "1.3"]`.
  ;;
  ;; No operator is only legal in front of a VERSION. Treating anything else as `=`
  ;; is how `"~> 1.0"` once came out as a silent `false`: `core` read `"~> 1"`
  ;; as 0, so the comparison was against garbage and the caller was told, confidently,
  ;; "not satisfied". An operator with no meaning has to say so.
  (let (c (string/trim constraint)
        op (seq/find (fn (o) (string/starts-with? c o)) *operators*))
    (cond
      (not (nil? op)) [op (string/trim (string/substring c (string/length op) (string/length c)))]
      (digit-start? c) ["=" c]
      else
        (error "satisfies?: unknown operator in "
          (pr-str constraint)
          " — use >=, >, <=, <, =, ^, ~> or a bare version"))))

;; --- caret/tilde ranges ---------------------------------------------------------
;; `^` and `~>` are shorthand for a `>= lo, < hi` range whose bounds come from where
;; the *written* version has its first significant digit. `^` (Cargo/npm "compatible")
;; keeps the left-most non-zero component fixed: `^1.2.3` = `>=1.2.3, <2.0.0`, but
;; `^0.2.3` = `>=0.2.3, <0.3.0` (a 0.x major means minor is the breaking axis). `~>`
;; (Elixir/Ruby "pessimistic") pins one level shallower than what was written:
;; `~> 1.2.3` = `>=1.2.3, <1.3.0` (patch may move), `~> 1.2` = `>=1.2.0, <2.0.0`
;; (minor may move). Both bounds compare on part-lists, so no string is built.

(defn- nth0
  (parts i)
  "The `i`-th element of the int list `parts`, or 0 when out of range — the same
'missing segment reads as 0' rule the comparisons use."
  (cond
    (empty? parts) 0
    (= i 0) (first parts)
    else (nth0 (rest parts) (dec i))))

(defn- first-nonzero-index
  (parts)
  (first-nonzero-index-go parts 0))
(defn- first-nonzero-index-go
  (parts i)
  (cond
    (empty? parts) nil
    (not (= (first parts) 0)) i
    else (first-nonzero-index-go (rest parts) (inc i))))

(defn- bump-index
  (op parts)
  ;; The 0-based component the exclusive upper bound increments.
  ;;   `^`  : the first non-zero component (so 1.x.y bumps major, 0.2.y bumps minor);
  ;;          if every written component is zero, the last one written.
  ;;   `~>` : one shallower than written — index (written-count - 2), floored at 0.
  (if (= op "^")
    (or (first-nonzero-index parts) (math/max 0 (dec (count parts))))
    (math/max 0 (- (count parts) 2))))

(defn- upper-bound
  (parts bump-index)
  ;; A 3-int list: components before `bump-index` copied, the one at it incremented,
  ;; everything after zeroed — the exclusive top of the range.
  (map (fn (i)
         (cond
           (< i bump-index) (nth0 parts i)
           (= i bump-index) (inc (nth0 parts i))
           else 0))
    (list 0 1 2)))

;; --- compiled constraints ------------------------------------------------------
;; Parsing a constraint STRING (`">= 1.2, < 2.0"`) into terms is the expensive part of a
;; check — string-splitting, operator-finding, `->number`. A resolver checks one constraint
;; against many versions (and re-checks across backtracking), so it compiles once with
;; `compile` and then matches versions cheaply with `match?`. A COMPILED
;; constraint is `{:terms [<term>…] :pre-cores [<core>…]}`; a <term> is a map
;; `{:kind :cmp :op OP :core PARTS :pre PRE}` or `{:kind :lo-hi :lo PARTS :lo-pre PRE :hi PARTS}`
;; (PARTS a `[maj min pat]` core, PRE the wanted's pre-release identifiers or nil). `:pre-cores`
;; are the cores of terms that NAME a pre-release. nil compiled = no constraint, matches anything.
;;
;; PRE-RELEASE rule (npm/Cargo): a pre-release candidate is EXCLUDED unless some term names a
;; pre-release at the same core — so `^1.0.0` skips `1.0.0-rc.1`, but `>= 1.0.0-rc` (or a bare
;; `1.0.0-rc.1`) admits pre-releases at `1.0.0`. Release candidates match as before.

(defn compile (constraint)
  "Compile a constraint STRING into a form `match?` checks quickly (see this
module's overview). nil / \"\" compile to nil (no constraint). Raises on a malformed term,
the same as `satisfies?` — compiling is where a bad constraint is caught."
  (if (or (nil? constraint) (= (string/trim constraint) ""))
    nil
    (let (terms (map (fn (term) (compile-term term constraint))
                  (seq/keep (fn (t) (let (tt (string/trim t)) (when (not (= tt "")) tt)))
                    (string/split constraint ","))))
      {:terms terms
       :pre-cores (seq/keep (fn (t) (get t :pre-core)) terms)})))

;; A version part must not contain whitespace or a constraint operator. Both mean a SECOND
;; term that the comma split did not separate — `">=1.0.0 <2.0.0"` (npm/cargo), `"^1 || ^2"`
;; (npm alternation), `"1.0.0 - 2.0.0"` (npm hyphen). `core` is deliberately lenient
;; (a non-numeric segment reads as 0, which is what makes `"1.x"` and the short `">= 0.3"`
;; work), and that leniency used to swallow the dropped term whole: `">=1.0.0 <2.0.0"`
;; compiled to a bare `>=1.0.0`, so 3.0.0 satisfied it and a breaking major resolved clean.
;; This is the same rule the operator check already applies one level up — a term with no
;; meaning has to say so — extended from the operator to the version beside it.
;; `-`/`+` are NOT rejected: they are legal prerelease/build punctuation (`1.0.0-alpha`).
(defn- junk-in-version?
  (wanted)
  (any?
    (fn (cp)
      (or (= cp 32)
        (= cp 9) ; space, tab
        (= cp 60)
        (= cp 62)
        (= cp 61) ; < > =
        (= cp 124)
        (= cp 94)
        (= cp 126))) ; | ^ ~
    (string/->codepoints wanted)))

(defn- compile-term
  (term constraint)
  ;; `constraint` is the whole original string, carried only so an error names what the
  ;; user actually wrote.
  (let ([op wanted] (split-constraint term))
    (when (= (string/trim wanted) "")
      (error "satisfies?: no version in constraint " (pr-str constraint)))
    (when (junk-in-version? (string/trim wanted))
      (error "satisfies?: "
        (pr-str (string/trim wanted))
        " in constraint "
        (pr-str constraint)
        " is not a single version — separate the terms with a comma, as in >=1.0.0, <2.0.0"))
    (let (core (core wanted)
          pre (prerelease wanted))
      (if (or (= op "^") (= op "~>"))
        {:kind :lo-hi
         :lo core
         :lo-pre pre
         :hi (upper-bound core (bump-index op core))
         :pre-core (when pre core)}
        {:kind :cmp :op op :core core :pre pre :pre-core (when pre core)}))))

(defn match-parts? (compiled parsed)
  "Whether a version whose numeric core is `parsed` (from `core`) satisfies the
`compiled` constraint, treating it as a RELEASE (no pre-release). The integer-only hot path;
for pre-release-aware matching use `match?`, which has the version string."
  (if (nil? compiled)
    true
    (every? (fn (term) (match-term? term parsed nil)) (get compiled :terms))))

;; Compare a candidate `(core, pre)` against a term bound `(core, pre)` — core first, then
;; pre-release precedence when the cores tie.
(defn- compare-cp
  (core-a pre-a core-b pre-b)
  (let (c (compare-parts core-a core-b))
    (if (= c 0) (compare-prerelease pre-a pre-b) c)))

(defn- match-term?
  (term core pre)
  (case (get term :kind)
    :lo-hi
      (and (>= (compare-cp core pre (get term :lo) (get term :lo-pre)) 0)
        (< (compare-cp core pre (get term :hi) nil) 0))
    :cmp
      (let (c (compare-cp core pre (get term :core) (get term :pre)))
        (case (get term :op)
          "=" (= c 0)
          ">" (> c 0)
          "<" (< c 0)
          ">=" (>= c 0)
          "<=" (<= c 0)
          (error "satisfies?: unknown operator " (pr-str (get term :op)))))))

(defn match? (compiled v)
  "Whether version STRING `v` satisfies an already-`compile`d constraint (pre-release
aware — see the compile overview)."
  (if (nil? compiled)
    true
    (let (core (core v)
          pre (prerelease v))
      (and
        ;; a pre-release candidate is admissible only where a term names a pre-release at its core
        (or (nil? pre)
          (any? (fn (pc) (= (compare-parts pc core) 0)) (get compiled :pre-cores)))
        (every? (fn (term) (match-term? term core pre)) (get compiled :terms))))))

(defn satisfies? (v constraint)
  "Whether version string `v` satisfies `constraint`. A constraint is one term —
`\">= 1.2\"`, `\"> 1.2.3\"`, `\"<= 2.0\"`, `\"< 2\"`, `\"= 1.2.3\"`, a bare `\"1.2.3\"`
(which means `=`), `\"^1.2\"` (compatible-with), or `\"~> 1.3\"` (pessimistic) — or a
comma-separated CONJUNCTION of terms (`\">= 1.2, < 2.0\"`), all of which must hold.
Whitespace around each operator is optional.

The comparison is on the numeric core with missing segments read as 0, so
`\"0.3.1\"` satisfies `\">= 0.3\"`. A constraint of nil or `\"\"` is *no
constraint* — satisfied by anything, so a manifest that names an application
without pinning a version is legal (`{bedit \"\"}`).

An operator this module does not implement, or a term with no version after it,
**raises** rather than answering a confident `false` — a dependency refused for a
reason nobody wrote down is worse than a loud one. (For repeated checks against one
constraint, `compile` it once and use `match?`.)

    (version/satisfies? \"1.2.3\" \"^1.0\")   → true"
  (match? (compile constraint) v))

(defn satisfies-all? (versions constraints)
  "Whether every entry of the `constraints` map (name → constraint string) is
satisfied by the same-named entry of the `versions` map (name → version string).
A constraint naming something absent from `versions` is NOT satisfied — that is
the \"this plugin wants an application I am not\" case, which must fail closed.

The shape a plugin manifest's `:enhances` map is checked with:
`(satisfies-all? {'bedit \"0.4.0\"} {'bedit \">= 0.3\"})`."
  (not (any? (fn (kv)
               (let ([nm constraint] kv
                     have (get versions nm))
                 (or (nil? have) (not (satisfies? have constraint)))))
         (%map-pairs constraints))))

(defn unsatisfied (versions constraints)
  "The `constraints` entries `versions` does NOT satisfy, as a list of
`[name constraint have]` (`have` is nil when absent) — what an application shows
the user when it declines a plugin, instead of a bare false."
  (seq/keep (fn (kv)
              (let ([nm constraint] kv
                    have (get versions nm))
                (when (or (nil? have) (not (satisfies? have constraint)))
                  [nm constraint have])))
    (%map-pairs constraints)))
