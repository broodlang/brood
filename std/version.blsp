;; std/version.blsp — semantic versions as data: parse, order, and test against a
;; constraint. Pure predicates over versions; the SELECTION algorithm (which version
;; to pick from a candidate set) lives one layer up in `std/resolver.blsp`.
;;
;; Why this exists: two consumers wrote it independently before it did. hive (the
;; package registry) needs "which published release is the newest"; an application
;; that hosts plugins needs "is this plugin's `:enhances {app \">= 0.3\"}` satisfied
;; by the version I am?" Both are questions *about two versions*, and both were
;; about to be answered by a third hand-rolled copy. Since then the dependency
;; resolver (ADR-209) became a third consumer: it asks the same "does this version
;; satisfy this range?" question millions of times while searching.
;;
;; What this module does and does not do: it answers whether ONE version satisfies
;; ONE constraint — a single term (`>= 1.2`, `^1.2`, `~> 1.3`) or a comma-separated
;; conjunction of them (`>= 1.2, < 2.0`). It chooses nothing and fetches nothing; the
;; backtracking search that picks a concrete version out of what a registry publishes
;; is the resolver's job. Keeping the predicate here and the search there is what lets
;; the resolver be a pure function tested offline (ADR-209).

(defmodule version
  "Semantic-version helpers: `version-core` (→ `[major minor patch]`),
`version-valid?`, `version-compare`, `version-newer?`, and `version-satisfies?`
(a version against a `\">= 1.2\"`-, `\"^1.2\"`-, `\"~> 1.3\"`-, or `\">= 1.2, < 2.0\"`-style
constraint). Comparison is on the numeric `MAJOR.MINOR.PATCH` core; any
`-prerelease` / `+build` suffix is ignored (ordering pre-releases is deferred until
something needs it). `(require 'version)`.")

;; ---- parsing ------------------------------------------------------------------

(defn version-core (v)
  "The `[major minor patch]` integers of version string `v`, ignoring any
`-prerelease` / `+build` suffix. A missing or non-numeric segment reads as 0, so
`\"1.2\"` is `(1 2)` and `\"1.x\"` is `(1 0)` — lenient, because this is used to
compare what a human typed in a manifest, not to validate it (that is
`version-valid?`)."
  (let (core (first (string-split (first (string-split v "+")) "-")))
    (map (fn (p) (or (string->number p) 0)) (string-split core "."))))

(defn version--digit-run? (s)
  (let (cps (string->codepoints s))
    (and (not (empty? cps))
      (not (any? (fn (cp) (or (< cp 48) (> cp 57))) cps)))))

(defn version-valid? (v)
  "Whether `v` is a full `MAJOR.MINOR.PATCH` version — three segments, each a run of
ASCII digits — ignoring any `-prerelease` / `+build` suffix. The check a registry
applies on publish; `version-satisfies?` is deliberately more forgiving, since a
CONSTRAINT is usually written short (`\">= 0.3\"`)."
  (and (string? v)
    (let (core (first (string-split (first (string-split v "+")) "-"))
          parts (string-split core "."))
      (and (= (count parts) 3)
        (not (any? (fn (p) (not (version--digit-run? p))) parts))))))

;; ---- ordering -----------------------------------------------------------------

(defn version-compare (a b)
  "Compare two version STRINGS on their numeric core: -1, 0, or 1. Shorter is not
smaller — `\"1.2\"` and `\"1.2.0\"` compare equal, because a constraint written
`\">= 1.2\"` means 1.2.0, not 1.2.anything-above-nothing."
  (version--compare-parts (version-core a) (version-core b)))

(defn version--compare-parts (a b)
  ;; Missing tail segments read as 0 (so 1.2 == 1.2.0), which is what makes a
  ;; short constraint mean what a human means by it.
  (cond
    (and (empty? a) (empty? b)) 0
    else
      (let (x (if (empty? a) 0 (first a))
            y (if (empty? b) 0 (first b)))
        (cond
          (< x y) -1
          (> x y) 1
          else (version--compare-parts (if (empty? a) a (rest a))
                 (if (empty? b) b (rest b)))))))

(defn version-newer? (a b)
  "Whether version `a` is strictly newer than `b`. The empty string is older than
everything (the \"no release yet\" placeholder a registry starts from)."
  (cond
    (= b "") (not (= a ""))
    (= a "") false
    else (> (version-compare a b) 0)))

;; ---- constraints ---------------------------------------------------------------
;; One version, one constraint, a yes/no answer. A constraint is a single term
;; (`>= 1.2`, `> 1.2.3`, `<= 2.0`, `< 2`, `= 1.2.3`, a bare `1.2.3`, `^1.2`, or
;; `~> 1.3`) or a comma-separated CONJUNCTION of terms (`>= 1.2, < 2.0`) — every
;; term must hold. The caret/tilde families expand to a `>=`-plus-exclusive-`<`
;; range, so they add no new comparison, only a new spelling. This is the whole
;; vocabulary the resolver (ADR-209) matches candidate versions against.

(def *version-operators* ["~>" "<=" ">=" "<" ">" "=" "^"]) ; longest first: "<=" before "<"
(defn version--digit-start? (s)
  (let (cps (string->codepoints s))
    (and (not (empty? cps)) (>= (first cps) 48) (<= (first cps) 57))))

(defn version--split-constraint (constraint)
  ;; `">= 1.2"` -> `[">=" "1.2"]`; a bare `"1.2"` -> `["=" "1.2"]`; `"^1.2"` ->
  ;; `["^" "1.2"]`; `"~> 1.3"` -> `["~>" "1.3"]`.
  ;;
  ;; No operator is only legal in front of a VERSION. Treating anything else as `=`
  ;; is how `"~> 1.0"` once came out as a silent `false`: `version-core` read `"~> 1"`
  ;; as 0, so the comparison was against garbage and the caller was told, confidently,
  ;; "not satisfied". An operator with no meaning has to say so.
  (let (c (trim constraint)
        op (find (fn (o) (starts-with? c o)) *version-operators*))
    (cond
      (not (nil? op)) [op (trim (substring c (string-length op) (string-length c)))]
      (version--digit-start? c) ["=" c]
      else
        (error "version-satisfies?: unknown operator in "
          (pr-str constraint)
          " — use >=, >, <=, <, =, ^, ~> or a bare version"))))

;; --- caret/tilde ranges ---------------------------------------------------------
;; `^` and `~>` are shorthand for a `>= lo, < hi` range whose bounds come from where
;; the *written* version has its first significant digit. `^` (Cargo/npm "compatible")
;; keeps the left-most non-zero component fixed: `^1.2.3` = `>=1.2.3, <2.0.0`, but
;; `^0.2.3` = `>=0.2.3, <0.3.0` (a 0.x major means minor is the breaking axis). `~>`
;; (Elixir/Ruby "pessimistic") pins one level shallower than what was written:
;; `~> 1.2.3` = `>=1.2.3, <1.3.0` (patch may move), `~> 1.2` = `>=1.2.0, <2.0.0`
;; (minor may move). Both bounds compare on part-lists, so no string is built.

(defn version--nth0 (parts i)
  "The `i`-th element of the int list `parts`, or 0 when out of range — the same
'missing segment reads as 0' rule the comparisons use."
  (cond
    (empty? parts) 0
    (= i 0) (first parts)
    else (version--nth0 (rest parts) (dec i))))

(defn version--first-nonzero-index (parts)
  (version--first-nonzero-index--go parts 0))
(defn version--first-nonzero-index--go (parts i)
  (cond
    (empty? parts) nil
    (not (= (first parts) 0)) i
    else (version--first-nonzero-index--go (rest parts) (inc i))))

(defn version--bump-index (op parts)
  ;; The 0-based component the exclusive upper bound increments.
  ;;   `^`  : the first non-zero component (so 1.x.y bumps major, 0.2.y bumps minor);
  ;;          if every written component is zero, the last one written.
  ;;   `~>` : one shallower than written — index (written-count - 2), floored at 0.
  (if (= op "^")
    (or (version--first-nonzero-index parts) (max 0 (dec (count parts))))
    (max 0 (- (count parts) 2))))

(defn version--upper-bound (parts bump-index)
  ;; A 3-int list: components before `bump-index` copied, the one at it incremented,
  ;; everything after zeroed — the exclusive top of the range.
  (map (fn (i)
         (cond
           (< i bump-index) (version--nth0 parts i)
           (= i bump-index) (inc (version--nth0 parts i))
           else 0))
    (list 0 1 2)))

(defn version--range-satisfied? (v op wanted)
  ;; `>= wanted, < (upper-bound wanted)` on part-lists.
  (let (parts (version-core wanted)
        vc (version-core v)
        hi (version--upper-bound parts (version--bump-index op parts)))
    (and (>= (version--compare-parts vc parts) 0)
      (< (version--compare-parts vc hi) 0))))

(defn version--term-satisfied? (v term constraint)
  ;; One term of a (possibly comma-separated) constraint. `constraint` is the whole
  ;; original string, carried only so an error names what the user actually wrote.
  (let ([op wanted] (version--split-constraint term))
    (when (= (trim wanted) "")
      (error "version-satisfies?: no version in constraint " (pr-str constraint)))
    (case op
      "^" (version--range-satisfied? v "^" wanted)
      "~>" (version--range-satisfied? v "~>" wanted)
      (let (c (version-compare v wanted))
        (case op
          "=" (= c 0)
          ">" (> c 0)
          "<" (< c 0)
          ">=" (>= c 0)
          "<=" (<= c 0)
          (error "version-satisfies?: unknown operator "
            (pr-str op)
            " in "
            (pr-str constraint)))))))

(defn version-satisfies? (v constraint)
  "Whether version string `v` satisfies `constraint`. A constraint is one term —
`\">= 1.2\"`, `\"> 1.2.3\"`, `\"<= 2.0\"`, `\"< 2\"`, `\"= 1.2.3\"`, a bare `\"1.2.3\"`
(which means `=`), `\"^1.2\"` (compatible-with), or `\"~> 1.3\"` (pessimistic) — or a
comma-separated CONJUNCTION of terms (`\">= 1.2, < 2.0\"`), all of which must hold.
Whitespace around each operator is optional.

The comparison is on the numeric core with missing segments read as 0, so
`\"0.3.1\"` satisfies `\">= 0.3\"`. A constraint of nil or `\"\"` is *no
constraint* — satisfied by anything, so a manifest that names an application
without pinning a version is legal (`{bedit \"\"}`).

An operator this module does not implement, or a term with no version after it,
**raises** rather than answering a confident `false` — a dependency refused for a
reason nobody wrote down is worse than a loud one."
  (if (or (nil? constraint) (= (trim constraint) ""))
    true
    (every? (fn (term) (version--term-satisfied? v term constraint))
      (keep (fn (t) (let (tt (trim t)) (when (not (= tt "")) tt)))
        (string-split constraint ",")))))

(defn version-satisfies-all? (versions constraints)
  "Whether every entry of the `constraints` map (name → constraint string) is
satisfied by the same-named entry of the `versions` map (name → version string).
A constraint naming something absent from `versions` is NOT satisfied — that is
the \"this plugin wants an application I am not\" case, which must fail closed.

The shape a plugin manifest's `:enhances` map is checked with:
`(version-satisfies-all? {'bedit \"0.4.0\"} {'bedit \">= 0.3\"})`."
  (not (any? (fn (kv)
               (let ([nm constraint] kv
                     have (get versions nm))
                 (or (nil? have) (not (version-satisfies? have constraint)))))
         (map-pairs constraints))))

(defn version-unsatisfied (versions constraints)
  "The `constraints` entries `versions` does NOT satisfy, as a list of
`[name constraint have]` (`have` is nil when absent) — what an application shows
the user when it declines a plugin, instead of a bare false."
  (keep (fn (kv)
          (let ([nm constraint] kv
                have (get versions nm))
            (when (or (nil? have) (not (version-satisfies? have constraint)))
              [nm constraint have])))
    (map-pairs constraints)))
