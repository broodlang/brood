;; std/gui.blsp — native window seam (ADR-046/080). Thin policy over the %gui-* primitives,
;; so an app reaches windows as gui/open, gui/draw, … rather than the bare language core.
(defmodule gui
  "Native windows: open a window, draw into it, and read input events.")

(defn open (&optional title width height opts)
  "Open a new native window and return its integer id (needs the runtime built with --features gui; errors otherwise). An optional `title` string sets the OS title-bar text (default `Brood`); change it later with gui/title. Optional `width` `height` (logical pixels, both required together) set the initial window size (default 840x560). Optional `opts` map, the attributes fixed when the window is built: `{:decorations false}` opens a **borderless** window — no OS title bar or frame — for an app that draws its own chrome (a browser's tab strip and toolbar) and would otherwise sit under a redundant second title; `{:input :pixels}` delivers the window's mouse input in PHYSICAL PIXELS instead of cells — the row/col slots of a `[:mouse …]` message carry the pointer's y and x in pixels, `:move`/`:drag` fire on every pixel of motion, and `[:resize w h]` reports the pixel size — the grain a game drawing with the pixel-space ops needs (gui/size-px is the same size on demand); `:vsync` picks how the GPU render target presents (the CPU target presents synchronously regardless): by default MAILBOX where the platform offers it, else FIFO — the newest frame at the next refresh, one frame in flight, never tearing; `{:vsync true}` is FIFO, every frame in step with the monitor refresh; `{:vsync false}` asks for the work-bound rate with tearing allowed (IMMEDIATE where available) — what a sim measuring its own frame rate wants; `{:app-id \"my-app\"}` sets the desktop application id (Wayland `app_id`, X11 `WM_CLASS`), which the desktop matches against the installed `my-app.desktop` entry to give the window its real icon and name in the dash / alt-tab — without one it is unidentifiable and draws the desktop's generic fallback icon (on Wayland a client cannot supply icon pixels at all, so this, not gui/icon, is how a window gets an icon there). Its key/mouse input is delivered to the CALLING process's mailbox as messages — a key as a 1-char string / keyword (`:up`, `:ctrl-c`), the mouse as `[:mouse action button row col mods]` (action `:press`/`:release`/`:drag`/`:move`/`:scroll-up`/`:scroll-down` — `:drag` is motion with a button held and `:move` is bare motion with none (button nil), both delivered once per cell crossed (so mouse-look / hover need no click); `mods` a vector of held modifier keywords in `:ctrl :alt :shift` order, `[]` when none, so Ctrl+wheel / Ctrl+drag are bindable; a `:press` carries a trailing 7th element, its click-chain count `[… mods n]` — 1 single, 2 double, 3 triple, … for repeated presses of the same button in the same cell within the double-click window, so double-click-to-select-word and triple-click-to-select-line are bindable; the terminal reports 1; a scroll carries its delta in LINE units in the same 7th slot), and a cell-grid window appends the pointer's EXACT position after those, `{:at [row col]}` in FRACTIONAL cells — the 7th slot is nil when the event has no count or delta, so the positional slots keep their meaning — which is what a consumer painting a `cell-region` at another cell size needs to hit-test inside it, since the whole cell was rounded before it could divide by the ratio (the terminal and a `{:input :pixels}` window send none), a resize as `[:resize cols rows]` (the new cell grid, so the loop re-renders at the new size) — so the consumer parks in `(receive)` instead of polling (ADR-059). Clicking the window's close button delivers a dedicated `:close` message — distinct from the Escape *key* (`:escape`), so an app can quit on the X without conflating it with Escape (which an editor binds to cancel/normal-mode); `ui-run` quits on `:close` automatically. The keyboard (ADR-086, ADR-441): a key is a 1-char string or a keyword spelling its modifiers in Emacs order, `[ctrl-meta-|ctrl-|alt-][shift-][super-]<name>` — `:ctrl-x`, `:alt-O`, `:super-s`, `:ctrl-super-x`, `:shift-left`, `:ctrl-f5`, `:super-f12`; the named keys are the arrows, `:enter` `:backspace` `:delete` `:insert` `:home` `:end` `:page-up` `:page-down`, `:f1`…`:f24`, `:menu` `:pause` `:scroll-lock` `:help` `:find` `:undo` `:redo` `:copy` `:cut` `:paste`, the browser and media keys, plus `:tab` `:back-tab` `:escape` — Tab takes modifiers as the other named keys do (`:ctrl-tab`, `:ctrl-shift-tab`), Shift alone being `:back-tab`; a shifted chord takes the glyph the keyboard layout gives (Alt+Shift+`.` is `:alt->` on a US layout, `:alt-:` on a German one). A chord under a layout whose character for the key is not Latin script (Russian, Greek, Hebrew, Arabic, …) names the key's US QWERTY position — Control+`ф` is `:ctrl-a` — while plain typing inserts the layout's own characters; a dead key in a chord is the accent it names (`:ctrl-^`) (ADR-541). Text a key typed through AltGr arrives as that text. On macOS `{:option-meta :left}` (the default) makes left Option Meta and lets right Option compose as the layout says (right-Option+2 types `@` on a German layout); `:right`, `:both` and `:none` are the other choices — Linux and Windows report no side, so Alt is Meta there whatever it says. A release is `[:key-up press]`, `press` the value that key's press delivered — `[:key-up \"(\"]` though Shift came up first, `[:key-up [:text \"…\"]]` for a compose sequence. By default the OS auto-repeat is dropped, so a held key is one press and one `[:key-up …]` and the app repeats it itself (gui/held-key); `{:key-repeat :os}` delivers each OS repeat as another press of the held key at the user's system delay and rate, never more than one of them undelivered at a time, and that one taken back when the key comes up, so the app stops with the key. Text an input method composes arrives as `[:preedit text range]` while it is being composed (shown at point, not inserted; `range` the IME cursor as `[from to]` character offsets, or nil; an empty `text` clears it) and `[:text text]` when committed — also what a keystroke that typed several characters (a compose sequence) delivers; a single character an IME merely passed through is the key a keyboard would have sent — the plain 1-char key, or its chord when Ctrl, Alt or Super was held (`:ctrl-a`, `:alt-f`). The IME is on unless `{:ime false}`, and its candidate window is placed at the frame's `[:cursor …]`. Focus is `:focus-in` on gain and `:blur` on loss. A fallback the display took instead of failing — the CPU painter for a GPU that would not start (`:gpu`), the bundled font for a family not installed or a font file it cannot read (`:font`), grey text for a driver that rejects subpixel text (`:lcd-text`), frames held to vsync when `{:vsync false}` cannot be had (`:vsync`) — arrives as `[:display-degraded {:what kw :reason string}]`, so the app can say it; one from before any window was open (a font registered first) goes to the next window opened (ADR-636). A mouse-wheel notch scrolls three lines at once in one scroll message (`{:wheel :lines}`, the default; notches the app has not drawn yet are summed into the next), or glides there over half a second with `{:wheel :glide}`; a trackpad tracks the finger and coasts either way. Starts the GUI thread on the first call; each call is an independent window, so several observers can run at once. Pass the id to the other gui/* functions; pair with gui/close.

    (gui/open \"Notes\" 1024 768)   ;~> the new window's integer id"
  (%gui-open title width height opts))

(defn available? ()
  "True when this runtime was built with the GUI backend, so `gui/open` and the other `gui/*` calls can succeed. The question to ask BEFORE a GUI side effect an app is happy to skip headlessly — `(when (gui/available?) (gui/font spec))` — rather than calling and catching: a `(try (gui/font …) (catch e nil))` also swallows an unbound symbol, and that is how a rename wave ran unnoticed for hours (ADR-304). Does not say whether a display is reachable; `gui/open` still errors for that.

    (gui/available?)   ;~> true in a --features gui build, false otherwise"
  (%gui-compiled?))

(defn headless? ()
  "True when this runtime's GUI is HEADLESS — `BROOD_GUI_HEADLESS` set in a --features gui build: `gui/open` hands back a fake window that draws nothing, and there is no font engine, so the questions only one can answer (`gui/font-info`, `gui/cell-size`) error — unless the runtime runs under `BROOD_GUI_HEADLESS=paint`, where every window is painted offscreen (ADR-609, gui/capture) and both answer. Ask it before such a question, as `gui/available?` is asked before a side effect, rather than calling and catching (ADR-557): an app that tells its user the font they configured is not installed asks `gui/font-info` only when this is false. False in a windowed runtime and without --features gui.

    (bool? (gui/headless?))   ;=> true"
  (%gui-headless?))

(defn close (id)
  "Close window id (the teardown for gui/open). Idempotent; an unknown id is a no-op.

    (gui/close id)   ;~> the window closed; closing again is a no-op"
  (%gui-close id))

(defn title (id text)
  "Set window id's OS title-bar text to the string text at runtime (the title gui/open gave it, or the default, otherwise). Needs --features gui; a no-op if the GUI thread never started or id isn't a live window. Returns nil.

    (gui/title id \"Notes (draft)\")   ;~> nil"
  (%gui-title! id text))

(defn icon (id rgba w h)
  "Set window id's taskbar / title-bar icon from raw RGBA pixels: rgba is a vector of w*h*4 byte ints (0-255), row-major, 4 per pixel (red, green, blue, alpha). Needs --features gui; a silent no-op if the GUI thread never started, id isn't a live window, or the data length isn't w*h*4. Where the OS shows it depends on the platform (X11/Windows use it directly; Wayland prefers a .desktop file). Returns nil.

    (gui/icon id pixels 32 32)   ;~> nil; pixels is a vector of 32*32*4 byte ints"
  (%gui-icon! id rgba w h))

(defn focus (id)
  "Raise window id to the front and give it OS keyboard focus, un-minimising it first. Lets an app surface an already-open (singleton) window instead of opening a duplicate — e.g. `(observe)` focuses its existing window rather than spawning a second. Errors only if id isn't a live window. Needs --features gui. Returns nil.

    (gui/focus id)   ;~> nil; the window is raised and focused"
  (%gui-focus id))

(defn grab-cursor (id on)
  "Confine the pointer to window id while `on` is truthy, release it otherwise — for mouse-look that shouldn't let the cursor slip out of the window and click another app. Uses the platform's `Confined` grab (cursor stays inside but keeps moving, so an absolute position-based look maps edge-to-edge), falling back to `Locked` where that's all the platform offers. Off by default; an app opts in. Errors only if id isn't a live window. Needs --features gui. Returns nil.

    (gui/grab-cursor id true)   ;~> nil; the pointer stays inside the window"
  (%gui-grab-cursor id on))

(defn fullscreen (id on)
  "Make window id borderless-fullscreen while `on` is truthy (covering the whole monitor it's on, NO title bar / decorations — distraction-free), or restore it to a normal window otherwise. For a big-but-normal window that keeps its title bar, use gui/maximize instead. The fullscreen/restore triggers a resize, so the consumer gets the usual [:resize cols rows] message and re-renders at the new size. Errors only if id isn't a live window. Needs --features gui. Returns nil.

    (gui/fullscreen id true)   ;~> nil; a [:resize cols rows] message follows"
  (%gui-fullscreen! id on))

(defn maximize (id on)
  "Maximise window id while `on` is truthy (fill the screen's work area, KEEPING the title bar / decorations), or restore it to its previous size otherwise — e.g. an editor's init file opening big without going true-fullscreen. The maximise/restore triggers a resize, so the consumer gets the usual [:resize cols rows] message and re-renders at the new size. Errors only if id isn't a live window. Needs --features gui. Returns nil.

    (gui/maximize id true)   ;~> nil; a [:resize cols rows] message follows"
  (%gui-maximize! id on))

(defn minimize (id)
  "Iconify window `id`. The counterpart of gui/maximize for an app that draws its own window controls, which a borderless window (gui/open with {:decorations false}) must.

    (gui/minimize id)   ;~> the window iconified"
  (%gui-minimize! id))

(defn drag-move (id)
  "Hand window `id` to the window manager for an interactive move, for the rest of the currently-held press. What a borderless window needs to stay movable: with no OS title bar there is nothing to grab, so the app nominates a region of its own chrome (a browser's tab strip) and calls this when a press lands there. A platform that declines the gesture is a no-op, not an error.

    (gui/drag-move id)   ;~> the window manager moves the window for the held press"
  (%gui-drag-move id))

(defn drag-resize (id dir)
  "Hand window `id` to the window manager for an interactive resize from `dir` — :north :south :east :west :north-east :north-west :south-east :south-west. The window-frame counterpart of gui/drag-move, for a borderless window that draws its own edges. A platform that declines the gesture is a no-op, not an error.

    (gui/drag-resize id :south-east)   ;~> the window manager resizes from the bottom-right corner"
  (%gui-drag-resize id dir))

(defn size (id)
  "Window id's size as [cols rows] in character cells (tracks resize / HiDPI), same shape as term/size.

    (gui/size id)   ;~> [105 35] -- columns and rows in cells"
  (%gui-size id))

(defn cell-size (id &optional px)
  "Window id's cell size as [cell-w cell-h] in PHYSICAL pixels — for the font size the window is using, or, given px (a logical font size), for the size a `cell-region` of that px would paint with. The question an app must answer before laying a region out at another size: how many of THAT size's cells fit the rect it has. It is not derivable from px — a cell is whatever shaping the reference glyph produces, rounded to whole pixels — so it is measured (on the GUI thread, memoised there). Errors when the window is not open, when this brood has no gui feature, and headless (no font engine to measure with), so a caller that also runs headless falls back to the size ratio.

    (try (gui/cell-size 0) (catch e :no-window))   ;=> :no-window   ; no window 0 is open"
  (if (nil? px)
    (%gui-cell-size id)
    (%gui-cell-size id px)))

(defn held-key (id)
  "The key window id currently sees as physically held — the same value its press delivered (a 1-char string, a keyword like :ctrl-n / :up, or `[:text \"…\"]` for a keystroke that typed several characters, a compose sequence) — or nil when none is held. Tracked from press/release transitions in the event loop (NOT winit's ke.repeat, unreliable on Wayland), so it's the source of truth for a held key: a consumer-paced auto-repeat polls it each tick and stops the instant it no longer matches, so a missed key-up (e.g. lost on focus change) can't cause runaway repeat.

    (gui/held-key id)   ;~> :up while the up arrow is held, nil when no key is"
  (%gui-held-key id))

(defn latency (id)
  "Window id's recent input-to-present samples, oldest first (at most 64), each a map of milliseconds, with `:input` — `:key` or `:pointer` (ADR-612): `:total` — from the GUI thread receiving an input (a key press, a mouse button, a wheel step) to the paint of the first frame that arrived after it returning from its present — and `:paint`, that paint's share; a frame the GPU render target drew adds its phases `:encode` `:upload` `:acquire` `:submit` `:present`. Which frame answers an input cannot be known across the app's mailbox, so the next frame drawn is taken as its answer; a present returning means the compositor has the frame, not that the panel shows it (up to one refresh more). Empty headless. `BROOD_GUI_TRACE=1` prints each sample as it is taken (ADR-440).

    (gui/latency id)   ;~> [{:total 6.1 :paint 1.2 :encode 0.3 …} …]
    (fn? gui/latency)   ;=> true"
  (%gui-latency id))

(defn key-repeats (id)
  "How window id's held keys have repeated since it opened, as a map: `:delivered`, the OS repeats delivered to the app; `:dropped`, those dropped because one was still waiting — the app fell behind the repeat rate, so a held key moved slower than the desktop asked; and, from the last key that repeated, the desktop's `:delay` before its first repeat and the `:interval` between its last two, in milliseconds (nil before any key has repeated). Set against `gui/latency`, it says whether the app answers a repeat before the next one comes. Counts under `{:key-repeat :os}`; all zero headless (ADR-441).

    (gui/key-repeats id)   ;~> {:delivered 412 :dropped 3 :delay 500.1 :interval 33.3}
    (fn? gui/key-repeats)   ;=> true"
  (%gui-key-repeats id))

(defn key-repeat? (id)
  "Whether the key press window id's app is folding is an OS auto-repeat of a key held down (under `{:key-repeat :os}`), rather than a fresh press. Each press marks it as it leaves the app's mailbox, so asked while folding that press it is exact — a double tap is two fresh presses, a held key's first press is fresh and every one after it a repeat. What an app needs to keep a held key calm: a held C-v scrolls, and the flash a single C-v earns is skipped. False before any key, under `{:key-repeat :app}`, for a window not open, and headless (ADR-612).

    (gui/key-repeat? id)   ;~> true while folding the repeats of a held key"
  (%gui-key-repeat? id))

;; ---- input→present as a distribution (ADR-612) ------------------------------------
;; A window counts every input-to-present time since it opened into log-linear buckets,
;; keys apart from the pointer. A histogram is plain data — `{:count n :max-us n :buckets
;; {upper-us n}}` — so it adds (two sessions), subtracts (a window of time between two
;; readings) and persists as it is; the percentiles are read off it here.

(defn latency-histogram (id)
  "Window id's input-to-present times since it opened, as two distributions: `{:key h :pointer h}`. Each `h` is `{:count n :max-us n :buckets {upper-us n}}` — how many inputs were answered, the slowest in microseconds, and per bucket (keyed by the largest value it holds, in microseconds; exact below 16 us, then 16 buckets per power of two, so at most 6.25% wide) how many fell in it. A key is a press, an OS repeat or an input method's commit; the pointer is a button or a wheel step. Taken as `gui/latency` takes its samples: from the GUI thread receiving the input to the present of the first frame that arrived after it. Read the percentiles with `gui/latency-percentiles`; both empty headless (ADR-612).

    (gui/latency-histogram id)   ;~> {:key {:count 412 :max-us 18211 :buckets {4351 3 …}} :pointer {…}}"
  (%gui-latency-histogram id))

(def- *empty-latency* {:count 0 :max-us 0 :buckets {}})

(defn latency-merge (a b)
  "Histograms `a` and `b` (`gui/latency-histogram`'s shape) as one: their counts and buckets added, the larger maximum. nil reads as empty, so a fold can start from nil.

    (gui/latency-merge {:count 1 :max-us 900 :buckets {911 1}} {:count 2 :max-us 4000 :buckets {911 1 4095 1}})   ;=> {:count 3 :max-us 4000 :buckets {911 2 4095 1}}
    (gui/latency-merge nil {:count 1 :max-us 5 :buckets {5 1}})   ;=> {:count 1 :max-us 5 :buckets {5 1}}"
  (let (a (or a *empty-latency*)
        b (or b *empty-latency*))
    {:count (+ (or (:count a) 0) (or (:count b) 0))
     :max-us (math/max (or (:max-us a) 0) (or (:max-us b) 0))
     :buckets (fold (or (:buckets b) {})
                (or (:buckets a) {})
                (fn (acc [upper n]) (assoc acc upper (+ n (get acc upper 0)))))}))

(defn latency-since (now before)
  "What histogram `now` counted after histogram `before` — two readings of the same window's `gui/latency-histogram`, `before` the earlier (nil for none): the inputs between them, a window of time. Its `:max-us` is the top of its slowest bucket, no higher than `now`'s maximum, since a maximum cannot be subtracted.

    (gui/latency-since {:count 3 :max-us 4000 :buckets {911 2 4095 1}} {:count 1 :max-us 900 :buckets {911 1}})   ;=> {:count 2 :max-us 4000 :buckets {911 1 4095 1}}"
  (let (before (or before *empty-latency*)
        buckets (fold (or (:buckets now) {})
                  {}
                  (fn (acc [upper n])
                    (let (left (- n (get (or (:buckets before) {}) upper 0)))
                      (if (> left 0) (assoc acc upper left) acc))))
        top (reduce (keys buckets) 0 math/max))
    {:count (math/max 0 (- (or (:count now) 0) (or (:count before) 0)))
     :max-us (math/min top (or (:max-us now) 0))
     :buckets buckets}))

(defn- latency-at (pairs total permille max-us)
  ;; the top of the first bucket (ascending `pairs`) whose running count reaches the
  ;; `permille`th input, never above the maximum; integer ranks, so p99 of 100 is the 99th
  (let (rank (math/max 1 (math/quot (math/round (+ (* total permille) 999)) 1000)))
    (letrec (walk (fn (left seen)
                    (if (empty? left)
                      max-us
                      (let ([upper n] (first left)
                            reached (+ seen n))
                        (if (>= reached rank) (math/min upper max-us) (walk (rest left) reached))))))
      (walk pairs 0))))

(defn latency-percentiles (histogram)
  "The median, p99, p99.9 and maximum of `histogram` (`gui/latency-histogram`'s shape) in milliseconds, with how many inputs it counts: `{:count :p50 :p99 :p999 :max}`. A percentile reads as the top of the bucket it lands in (at most 6.25% over the true value, never under it, never above the maximum). An empty histogram has nil percentiles. The tail is the point: at ten keys a second one input in a thousand is one every hundred seconds, which is what typing feels, and a median cannot show it (ADR-612).

    (gui/latency-percentiles {:count 4 :max-us 9000 :buckets {2047 2 4095 1 9215 1}})   ;=> {:count 4 :p50 2.047 :p99 9.0 :p999 9.0 :max 9.0}
    (:p50 (gui/latency-percentiles {:count 0 :max-us 0 :buckets {}}))   ;=> nil"
  (let (total (or (:count histogram) 0)
        max-us (or (:max-us histogram) 0)
        pairs (sort (vec (or (:buckets histogram) {})))
        ms (fn (us) (/ us 1000.0)))
    (if (<= total 0)
      {:count 0 :p50 nil :p99 nil :p999 nil :max nil}
      {:count total
       :p50 (ms (latency-at pairs total 500 max-us))
       :p99 (ms (latency-at pairs total 990 max-us))
       :p999 (ms (latency-at pairs total 999 max-us))
       :max (ms max-us)})))

;; ---- the desktop's reduced-motion preference (ADR-612) ----------------------------
;; Every platform has a switch for "show me less animation", and an app that animates is
;; asked to honour it. None of them is a window property, so it is read where each desktop
;; keeps it: GNOME's gsettings, KDE's kdeglobals, macOS's universal-access defaults, and the
;; Windows animation setting. The readers are pure over the text each source gives, so they
;; are tested on any machine.

(defn reduce-motion-from (os answers)
  "Whether `answers` — what each source said on `os` (an `os/type` keyword), as a map of strings or nil for a source that said nothing — ask for reduced motion. `:gnome` is `gsettings get org.gnome.desktop.interface enable-animations` (\"false\" asks), `:kde` the text of kdeglobals (an `AnimationDurationFactor=0` asks), `:macos` `defaults read com.apple.universalaccess reduceMotion` (\"1\" asks), `:windows` `reg query` of `MinAnimate` under the desktop's WindowMetrics (0 asks: what the \"Animation effects\" switch turns off).

    (gui/reduce-motion-from :linux {:gnome \"false\"})   ;=> true
    (gui/reduce-motion-from :linux {:gnome \"true\" :kde \"[KDE]\\nAnimationDurationFactor=0\\n\"})   ;=> true
    (gui/reduce-motion-from :macos {:macos \"0\"})   ;=> false
    (gui/reduce-motion-from :windows {:windows \"    MinAnimate    REG_SZ    0\"})   ;=> true"
  (let (said (fn (k) (string/trim (or (get answers k) ""))))
    (case os
      :macos (= (said :macos) "1")
      :windows (regex/match? "MinAnimate\\s+REG_SZ\\s+0(\\s|$)" (said :windows))
      (or (= (said :gnome) "false")
        (any? (string/split (said :kde) "\n")
          (fn (line) (regex/matches? "\\s*AnimationDurationFactor\\s*=\\s*0+(\\.0*)?\\s*" line)))))))

(defn- desktop-answer (prog args)
  ;; what `prog args` printed when it ran and succeeded, else nil — a source that is not
  ;; installed, or fails, says nothing
  (when (os/which prog)
    (let (result (os/cmd prog args))
      (when (os/cmd-ok? result) (os/cmd-out result)))))

(defn reduce-motion? ()
  "Whether the desktop asks apps for less animation: GNOME's \"Animations\" switch off, KDE's animation speed at instant, macOS's Reduce Motion, or Windows' \"Animation effects\" off (`gui/reduce-motion-from` reads each). Best-effort and synchronous — it runs the platform's settings tool, a few milliseconds — so read it once (at startup) rather than per frame; a source that is missing or fails counts as not asking, and so does any error. Needs no window and no GUI build (ADR-612).

    (bool? (gui/reduce-motion?))   ;=> true"
  (check-allow :discarded-catch
    (try
      (let (os (os/type)
            kdeglobals (path/join (or (os/env "XDG_CONFIG_HOME")
                                    (path/join (or (os/env "HOME") "") ".config"))
                         "kdeglobals"))
        (reduce-motion-from os
          (case os
            :macos
              {:macos (desktop-answer "defaults"
                        ["read" "com.apple.universalaccess" "reduceMotion"])}
            :windows
              {:windows (desktop-answer "reg"
                          ["query" "HKCU\\Control Panel\\Desktop\\WindowMetrics" "/v" "MinAnimate"])}
            {:gnome (desktop-answer "gsettings"
                      ["get" "org.gnome.desktop.interface" "enable-animations"])
             :kde (when (file/exists? kdeglobals) (file/slurp kdeglobals))})))
      (catch _ false))))

;; ---- the desktop's light or dark preference ---------------------------------------
;; The same shape as reduced motion: each desktop keeps the choice in its own settings store,
;; read through its own tool, and the readers are pure over what each tool printed.

(defn color-scheme-from (os answers)
  "The colour scheme `answers` ask for on `os` (an `os/type` keyword) — `:dark`, `:light`, or nil
when no source states one. `answers` maps each source to what it said (a string, or nil for a
source that said nothing): `:gnome` is `gsettings get org.gnome.desktop.interface color-scheme`
(`'prefer-dark'` asks dark, `'prefer-light'` light, `'default'` nothing), `:gtk-theme` the
`gtk-theme` beside it (a name ending `-dark` asks dark, the older desktops' only signal), `:kde`
the text of kdeglobals (a `ColorScheme=` naming Dark), `:macos` `defaults read -g
AppleInterfaceStyle` (`Dark`; the key is absent in light mode), `:windows` `reg query` of
`AppsUseLightTheme` (0 dark, 1 light).

    (gui/color-scheme-from :linux {:gnome \"'prefer-dark'\"})   ;=> :dark
    (gui/color-scheme-from :linux {:gnome \"'default'\" :gtk-theme \"'Adwaita-dark'\"})   ;=> :dark
    (gui/color-scheme-from :linux {:kde \"[General]\\nColorScheme=BreezeLight\\n\"})   ;=> :light
    (gui/color-scheme-from :macos {:macos \"Dark\"})   ;=> :dark
    (gui/color-scheme-from :windows {:windows \"    AppsUseLightTheme    REG_DWORD    0x1\"})   ;=> :light"
  (let (said (fn (k) (string/trim (or (get answers k) ""))))
    (case os
      :macos (if (= (said :macos) "Dark") :dark :light)
      :windows
        (cond
          (regex/find "AppsUseLightTheme\\s+REG_DWORD\\s+0x0+(\\s|$)" (said :windows)) :dark
          (regex/find "AppsUseLightTheme\\s+REG_DWORD\\s+0x0*1(\\s|$)" (said :windows)) :light
          else nil)
      (let (gnome (said :gnome)
            kde (seq/find (string/split (said :kde) "\n")
                  (fn (line) (regex/matches? "\\s*ColorScheme\\s*=.*" line))))
        (cond
          (includes? gnome "prefer-dark") :dark
          (includes? gnome "prefer-light") :light
          kde (if (regex/find "(?i)dark" kde) :dark :light)
          (regex/find "(?i)-dark'?\\s*$" (said :gtk-theme)) :dark
          else nil)))))

(defn color-scheme ()
  "The desktop's light or dark preference — `:dark`, `:light`, or nil when it states none: GNOME's
Style setting, KDE's colour scheme, macOS's Appearance, Windows' app mode (`gui/color-scheme-from`
reads each). Best-effort and synchronous — it runs the platform's settings tool, a few
milliseconds — so an app re-reading it to follow a change does so off its UI loop; a source
that is missing or fails says nothing, and so does any error. Needs no window and no GUI build.

    (includes? [:dark :light nil] (gui/color-scheme))   ;=> true"
  (check-allow :discarded-catch
    (try
      (let (os (os/type)
            kdeglobals (path/join (or (os/env "XDG_CONFIG_HOME")
                                    (path/join (or (os/env "HOME") "") ".config"))
                         "kdeglobals"))
        (color-scheme-from os
          (case os
            :macos {:macos (desktop-answer "defaults" ["read" "-g" "AppleInterfaceStyle"])}
            :windows
              {:windows (desktop-answer "reg"
                          ["query"
                            "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize"
                            "/v" "AppsUseLightTheme"])}
            {:gnome (desktop-answer "gsettings"
                      ["get" "org.gnome.desktop.interface" "color-scheme"])
             :gtk-theme (desktop-answer "gsettings"
                          ["get" "org.gnome.desktop.interface" "gtk-theme"])
             :kde (when (file/exists? kdeglobals) (file/slurp kdeglobals))})))
      (catch _ nil))))

(defn settle (id)
  "Tell window id the app finished a turn with nothing new to draw; returns nil. What a `gui/draw` would have told the window about the app's progress, without a frame: the next wheel-glide step may fire, and the input the turn answered is dropped from `gui/latency` instead of being pinned on the next unrelated frame. `ui-run` sends it on every turn it skips (ADR-444), through the display's `:settle`. No-op headless.

    (gui/settle id)   ;~> nil"
  (%gui-settle id))

(defn draw (id frame)
  "Paint a frame (the same render-op vector term/draw takes) to window id; returns nil. Unknown ops are skipped (forward-compatible). A text op's face may carry :scale n (GUI only, integer >=1, capped at 16): the text is drawn n× larger in an n×n block of cells anchored at its row/col — the per-pane/per-buffer font knob; the terminal frontend renders scale 1. A `[:cursor row col]` op may carry an optional `style` keyword (`[:cursor row col style]`) — :block (default, a 50% overlay), :bar (a thin caret on the cell's left edge), :underline (a rule along the cell bottom), or :hollow (an outline box, the cursor of an unfocused window) — and an optional colour after it (`[:cursor row col style colour]`, a face colour; `style` may be nil), the caret's colour: a block washes its cell in it at 50% and rims it solid, the other shapes are solid in it. A `[:seam row]` op says how the rows sit in the window (ADR-610): rows above `row` are anchored to the top, rows from it down to the bottom, so the last row ends exactly at the bottom inset at every window height and the leftover pixels lie between row `row - 1` and row `row`, painted by the row above (an editor names its bottom mode line; nil keeps the leftover under the last row); `[:seam row {:top-band false}]` also says row 0 is not a band, so the top gets the inset like the sides (the grid loses those rows, and the window sends a resize when this changes). Rows stay whole cells, and the mouse hit-test inverts the same map; frame state, read at the top level, skipped by the terminal. An `[:above-seam ops]` block (ADR-615) lays its ops out on the rows above the seam carried on past it and cuts them off where the seam row begins, so what it puts on the seam row shows its top in the leftover strip, the next line partly visible, once the strip is at least half a row tall (under that the strip stays the row above's, as without the block); a pointer in a strip showing the line is reported on the seam row with `:partial true` in the trailing map. 
A `[:rect row col w h face]` op fills a w×h cell block with the face's background colour — a solid panel painted directly (no glyphs), the multi-row generalisation of a status bar. An `[:image row col w h source opts]` op (editor/display/image, ADR-686) paints a raster picture — encoded PNG / JPEG bytes or a gui/image-thumb map — into a w×h cell block at the window's full pixel resolution, placed by `:fit` (`:contain`, `:scale-down`, `:fill`, `:none`) and `:align` (`:center`, `:top-left`) and clipped to the block; it is decoded once per content and resampled once per size, so a frame may carry it every time, and a terminal draws the same op in half-block cells. A `[:cursor-zone x y w h shape]` op marks a hover hot-zone: while the pointer is over it the window shows the resize cursor `shape` (:col-resize ↔ / :row-resize ↕), hit-tested on the GUI thread (ADR-080); it draws nothing and the terminal ignores it. A `[:vspans row0 col0 cols]` op is the column-renderer fast path (raycasters, spectrum bars): `cols` is a vector with one entry per cell-column (`col0`, `col0+1`, …), each a top-to-bottom stack of `[height colour]` segments painted from `row0` down — `colour` a face keyword (`:red`), an `[r g b]` triple (0..255), or nil (transparent). The per-cell fill happens natively here, so a wide scene costs the Brood side O(columns), not O(cells); GUI-only (the terminal ignores it). Two ops live in PIXEL space rather than cells — physical pixels from the window's top-left, drawn by both window painters — instanced on the GPU render target (a `--with-gui-gpu` build, which draws on the GPU unless BROOD_GUI_GPU=0), in software by the CPU painter, so a game draws on any GUI build; the terminal skips them: `[:quad x y w h color]` / `[:quad x y w h color rot]` fills a w×h rect with color (a face colour, or an [r g b a] vector for a translucent one) turned `rot` radians about its centre, and `[:sprite tex x y w h]` / `[:sprite tex x y w h uv tint rot]` draws texture `tex` (a handle from gui/texture) there, sampling `uv` (`[u0 v0 du dv]`, texture space, a negative extent mirrors; the whole texture by default) multiplied by `tint` (opaque white by default). Build them with gui/sprite and gui/line rather than by hand — the runtime knows only the quad; a sheet frame, a flip, a line are Brood over it. Text joins them with `[:text-px x y s face]`: the run shaped as a `:text` op would be (the same face keys), its top at y and its left edge at x in physical pixels — or its centre / right edge, with `:align :center` / `:align :right` in the face — so a HUD caption or a title sits where a game wants it, not on a cell row; both window painters draw it, the terminal skips it. And a frame can carry SOUND: `[:sound snd]` / `[:sound snd vol]` plays the sound gui/sound (or editor/frontend/display-sound) kept under handle snd, once, when the frame is drawn — on whichever window draws it, so it crosses the wire to a thin client and a browser tab with the frame, and a headless test sees it in the frame; `vol` is the peak amplitude 0..1 (default ~0.18). MUSIC is state rather than an event: `[:music snd]` / `[:music snd vol]` keeps that sound LOOPING for as long as the frames drawn carry the op — the same handle again keeps the track going (a new vol fades to it), another handle switches tracks, and a frame without one fades it out, so a thin client or a late joiner hears the game's music from the next frame it draws; the first music op of a frame wins. A frame can also ask for EFFECTS, painted by both window painters (on the GPU in shaders, by the CPU painter in software) and skipped by the terminal: `[:ambient color]` turns lighting on — what is drawn before the frame's `[:overlay]` (all of it, without one) is multiplied by a light map starting at that colour, to which every `[:light x y radius color]` / `[:light x y radius color intensity]` adds its colour falling smoothly to nothing at its radius; ops after `[:overlay]` are the unlit layer (a HUD, or something that glows). `[:bloom threshold intensity radius]` adds back, blurred `radius` pixels wide, what is brighter than `threshold` (0..1); `[:crt scanlines curvature vignette]` dims every other row, bulges the picture and darkens its corners — both over the finished frame. PARTICLES are state like music: `[:emitter id x y opts]` keeps emitter `id` alive at (x, y) while frames carry it — `opts` a map of `:rate` (per second), `:life [min max]` seconds, `:speed [min max]` px/s, `:angle` and `:spread` radians (0 points right, y down), `:gravity [gx gy]`, `:drag`, `:size [birth death]` px, `:color` / `:color-end`, `:blend :add`, `:shape :square`, `:max` (live particles, default 1024) — simulated in the window (a compute shader on the GPU) and drawn where the op sits, so a frame carries one op per emitter, never one per particle; a frame without it stops the emission and lets its particles live out their lives. `[:burst id n]` emits n at once from the frame's emitter `id`, once, when the frame is drawn.

    (gui/draw id [[:clear] [:text 0 0 \"hello\" {:fg :red}]])   ;~> nil"
  (%gui-draw id frame))

(defn font (id-or-spec &optional spec)
  "Set a cell font from spec, a map {:family <keyword> :height <px>} (both keys optional): :family picks a registered font family (bundled :mono, or one added by gui/font-register), :height the cell pixel size. (gui/font spec) sets the global default — every open window and ones opened later; (gui/font id spec) retunes just window id, leaving the global default and other windows alone, so two windows can run different fonts. Per-section fonts within a window come from a face's :family/:scale. Needs --features gui. Returns nil.

    (gui/font {:family :mono :height 18})   ;~> nil; every window now uses an 18 px mono cell"
  (if (nil? spec)
    (%gui-font! id-or-spec)
    (%gui-font! id-or-spec spec)))

(defn font-register (name styles)
  "Register font family name (a keyword) from styles: either an INSTALLED family by its name, {:family-name \"JetBrains Mono\"} — looked up (case-insensitively) in the system fonts, which are scanned the first time one is asked for and never at startup, with the bold / italic / bold-italic faces picked by weight and slant, and the bundled DejaVu Sans Mono standing in when nothing by that name is installed (gui/font-info says which file each style got, or :not-found) — or a map of style → TTF file path {:regular \"…\" :bold \"…\" :italic \"…\" :bold-italic \"…\"}, where only :regular is required and a missing style reuses the regular file. :family-name wins when both are given. Afterwards a face's :family <name> (or gui/font) selects it; re-registering a family a window already uses re-measures its cell. Needs --features gui. Returns name.

    (gui/font-register :code {:family-name \"JetBrains Mono\"})   ;~> :code"
  (%gui-font-register name styles))

(defn font-info (&optional family)
  "Where font family `family` (a keyword; the window default when omitted) got its faces, as a map: :name (the family shaping uses), :requested (the installed name a :family-name registration asked for, or nil), :origin (:bundled, :files, :system, or :not-found — asked for by name, not installed, the bundled DejaVu standing in), :regular / :bold / :italic / :bold-italic (the file each style resolved to), :fallbacks (a vector of {:name :file} — the installed fonts loaded so far to draw glyphs the primary font lacks, CJK or symbols, in the order first needed), :system-scanned (whether the installed fonts have been scanned yet: only on demand) and :ligatures. The diagnostic for \"I asked for Iosevka, why does it look like DejaVu\". Answered on the GUI thread after every registration sent before it. Errors headless (ask `gui/headless?` first, ADR-557) and without --features gui.

    (gui/font-info :code)   ;~> {:name \"JetBrains Mono\" :origin :system :regular \"/usr/share/fonts/…\" :fallbacks [] …}
    (fn? gui/font-info)   ;=> true"
  (%gui-font-info family))

(defn inset (px)
  "Set the window content inset to px logical pixels: a blank margin on the left, right and bottom of the cell grid, so a GUI app's text breathes instead of sitting flush against the frame. There is none above row 0 unless the frame says row 0 is not a band (`[:seam row {:top-band false}]`, ADR-610): the first row starts at the window's top edge, so a header line or tab bar is the top of the window (ADR-508). Applies to every open window and the default for ones opened later; the grid loses 2*px of width and px of height (fewer cells) and re-renders. The inset is shared by the renderer and mouse hit-testing, so clicks stay aligned. Needs --features gui. Returns nil.

    (gui/inset 12)   ;~> nil; a 12 px margin left, right and below every window's cell grid"
  (%gui-inset! px))

(defn bg (color)
  "Set the window background colour: the fill for :clear, the per-frame pre-clear, and — being outside every cell — the gui/inset margin and the cell-grid snap remainder, except beside a square background that reaches the edge of the grid, which continues across the margin to the window edge (edge bleed, ADR-508). So a GUI app's padding matches its own theme background instead of the hardcoded default. color is a keyword named colour, an [r g b] vector (0..255 per channel), or a \"#rrggbb\"/\"#rgb\" hex string; nil restores the default. Applies to every open window and the default for ones opened later (a pure repaint — no grid change). Needs --features gui. Returns nil.

    (gui/bg \"#1e1e2e\")   ;~> nil; the background fill of every window"
  (%gui-bg! color))

(defn fg (color)
  "Set the window's default text colour: what a :text or :text-px op whose face names no :fg is drawn in (and the background of a reversed face that names none) — gui/bg's partner, the colour of text no face colours, as gui/bg is the colour of what no op paints. Without it that text is the renderer's own light default, which a light theme's background all but swallows; an app with a theme sets both from it (ADR-613). color is a keyword named colour, an [r g b] vector (0..255 per channel), or a \"#rrggbb\"/\"#rgb\" hex string; nil restores the default. Applies to every open window and the default for ones opened later (a pure repaint — no grid change). Needs --features gui. Returns nil.

    (gui/fg \"#4c4f69\")   ;~> nil; plain text in every window is Catppuccin Latte's text colour"
  (%gui-fg! color))

(defn line-height (mult)
  "Set the cell height as a multiple of the font pixel size (the line height): 1.4 by default — an editor's vertical breathing room — clamped to 0.8..3.0. A metric change like gui/font: the row count moves, so every open window is told its new (cols, rows) and re-renders; also the default for windows opened later. Needs --features gui. Returns nil.

    (gui/line-height 1.2)   ;~> nil; every window re-renders at its new row count"
  (%gui-line-height! mult))

(defn ligatures (on)
  "Turn programming ligatures on (any truthy value) or off (nil / false, the default): with them on, a run of two or more punctuation chars in a :text op (-> != === <=> |> :: /* &&) is shaped as one unit so the font's ligatures form, still occupying exactly one cell per char — the grid never moves. A font without ligatures (the bundled DejaVu) draws the same either way; register one that has them (gui/font-register with :family-name \"JetBrains Mono\", \"Fira Code\", \"Iosevka\"). Every open window and the default for ones opened later; a pure repaint. Needs --features gui. Returns nil.

    (gui/ligatures true)   ;~> nil; -> and != form ligatures in a font that has them
    (fn? gui/ligatures)   ;=> true"
  (%gui-ligatures! on))

(defn text-aa (mode)
  "Set how monochrome text is anti-aliased: :gray (one coverage value per pixel), :subpixel (one per colour channel, each a third of a pixel apart — LCD text, three times the horizontal resolution of every stem, for a panel whose subpixels run red-green-blue), :bgr (the same for a blue-first panel), or :auto (the default: subpixel at a 1× scale where text has the fewest pixels to spend, gray on HiDPI where grayscale is already sharp and a scaled or rotated surface would turn subpixel fringes into colour noise). Applies to every open window and the default for ones opened later; a pure repaint. The GPU painter draws subpixel text in one pass on an adapter with dual-source blending and in three (one per colour channel) on one without; either way the same pixels as the CPU painter. Needs --features gui. Returns nil.

    (gui/text-aa :gray)   ;~> nil; grayscale anti-aliasing in every window"
  (%gui-text-aa! mode))

(defn text-contrast (gamma)
  "Set the text contrast exponent γ: 1.4 by default, clamped to 0.5..3.0. Text blends in linear light with the weight of a lerp of the encoded colours (ADR-611); a monochrome glyph's partial coverage is first lifted to cov^(1/γ) where the text is lighter than the pixel it lands on, so γ is the perceptual gamma light-on-dark text is weighted at — 1.0 the encoded lerp's weight (thin stems on a dark ground), about 2.2 linear light's (soft). A glyph's interior and exterior, dark-on-light text and colour emoji are untouched. Applies to every open window and the default for ones opened later; a pure repaint. Needs --features gui. Returns nil.

    (gui/text-contrast 1.6)   ;~> nil; light-on-dark text reads fuller"
  (%gui-text-contrast! gamma))

(defn image-thumb (bytes max-w max-h)
  "Decode an encoded image (PNG/JPEG/GIF/WebP/BMP) from a byte sequence and downscale it to fit within max-w×max-h pixels (aspect ratio preserved), returning {:width :height :rgba} where :rgba is a width*height*4 bytes value (row-major RGBA8). nil when the bytes aren't a decodable image or the dims are non-positive. Per-call decode limits bound a decompression bomb. The one image primitive; rendering (half-block cells, a GUI texture) is Brood policy over the decoded buffer.

    (gui/image-thumb (file/slurp-bytes \"photo.jpg\") 64 64)   ;~> {:width 64 :height 48 :rgba …}, or nil"
  (%image-thumb bytes max-w max-h))

;; --- frame capture: what a window paints, as pixels (ADR-609) -------------------------

(defn render-frame (frame &optional spec)
  "Paint `frame` (a gui/draw frame) into memory as a window described by `spec` would paint it, and return the picture: `{:width :height :rgba :cell [w h] :grid [cols rows] :origin [x y] :inset px :seam row :row-tops [y …]}`, `:rgba` being width*height*4 bytes (row-major, opaque) and the rest the geometry it was painted with — the cell in physical pixels, the grid in cells, where the grid's top-left sits, the inset, the frame's `[:seam row]` (nil without one) and the pixel row every grid row starts at, then where the last one ends (`:row-tops`, `rows + 1` entries — ADR-610). It is the WINDOW's own CPU painter that paints it — the same layout rule (row 0 at the top edge, or at the inset when the frame's seam says row 0 is not a band; the inset a margin left, right and below; the leftover height at the seam or under the last row), the same edge bleed, the same glyph rasteriser — so what a test asserts about the pixels is true of the window. Needs no window and no display, so it runs headless and in `nest test`. `spec` (every key optional) is the window it stands in for: `:width`/`:height` in physical pixels (840x560), `:font` (an installed family's name, as gui/font-register's `:family-name` resolves one, or a family keyword the offscreen painter knows — the bundled `:mono` by default), `:size` (the font px, 15), `:line-height` (1.4), `:inset` (logical px, 0), `:bg` (the window colour), `:fg` (the default text colour, gui/fg), `:scale` (HiDPI, 1), `:text-aa`, `:ligatures`. Read a pixel with gui/pixel, save it with gui/write-png. Needs --features gui.

    (gui/render-frame [[:clear] [:text 0 0 \"hi\" {:fg :red}]] {:width 200 :height 60 :inset 6})   ;~> {:width 200 :height 60 :rgba … :cell [9 21] :grid [20 2] :origin [6 0] :inset 6 :seam nil :row-tops [0 21 42]}"
  (%gui-render-frame frame spec))

(defn capture (id)
  "Window id's current frame painted into memory as the window paints it — the picture gui/render-frame returns, with the window's own size, font, inset and background. For a real window it is rasterised on the GUI thread by the window's renderer (a GPU window's by the CPU painter over the same frame, without its sprites). HEADLESS, a window has nothing to paint with unless the runtime runs under `BROOD_GUI_HEADLESS=paint`: then every window is painted offscreen, keeps its settings and frames, and reports the grid the real cell metrics give — so an app's real loop can be looked at with no display (gui/windows finds the window it opened). Errors for a window that is not open and for a plain headless one.

    (gui/write-png (gui/capture (first (gui/windows))) \"/tmp/editor.png\")   ;~> \"/tmp/editor.png\""
  (%gui-capture id))

(defn windows ()
  "The ids of the windows open in this runtime, oldest first — how a driver finds the window an app's loop opened, to gui/capture it. Empty without --features gui.

    (vector? (gui/windows))   ;=> true"
  (%gui-windows))

(defn write-png (image path &optional opts)
  "Write `image` — a {:width :height :rgba} map, as gui/render-frame, gui/capture and gui/image-thumb return — to `path` as a PNG, and return `path`. `opts`: `:crop [x y w h]` keeps that rectangle (clipped to the image) and `:scale n` (1..16) enlarges it n times by repeating pixels, so the spacing of a few pixels can be looked at without a blur. Errors when `:rgba` is not width*height*4 bytes or the file cannot be written.

    (gui/write-png {:width 1 :height 1 :rgba (bytes/concat (bytes/int-> 255 1) (bytes/int-> 0 1) (bytes/int-> 0 1) (bytes/int-> 255 1))} \"/tmp/red.png\")   ;~> \"/tmp/red.png\""
  (%image-write-png image path opts))

(defn pixel (image x y)
  "The colour of pixel (`x`, `y`) of `image` (a {:width :height :rgba} map) as `[r g b]`, or nil outside it. What a test reads a picture with.

    (gui/pixel {:width 1 :height 1 :rgba (bytes/concat (bytes/int-> 30 1) (bytes/int-> 30 1) (bytes/int-> 46 1) (bytes/int-> 255 1))} 0 0)   ;=> [30 30 46]"
  (when (and (>= x 0) (>= y 0) (< x (:width image)) (< y (:height image)))
    (let (rgba (:rgba image)
          at (math/round (* 4 (+ x (* y (:width image))))))
      [(bytes/at rgba at) (bytes/at rgba (+ at 1)) (bytes/at rgba (+ at 2))])))

;; --- pixel space: the sprite / quad layer ---------------------------------------------
;;
;; The runtime knows two pixel-space ops, and only those: `[:quad x y w h color rot]`, a
;; solid quad, and `[:sprite tex x y w h uv tint rot]`, a textured one sampling a UV rect
;; of a texture uploaded with %gui-texture. Everything a game builds on them — which
;; part of a sheet a frame is, a flip, a line, an animation — is policy, and lives here
;; and in the engine above, not in Rust. Physical pixels, the window's top-left as the
;; origin; both window painters draw them — the GPU render target instanced (a
;; `--with-gui-gpu` build, unless BROOD_GUI_GPU=0), the CPU painter in software.

;; The texture registry — handle → [w h] — shared by every process; the counter under
;; :next allocates handles from 1, process-wide, so a handle can never name another window's
;; texture. Created at LOAD, never on first use: the lazy `(when (nil? …) (def …))` it
;; replaced was a check-then-define race — two processes allocating their first texture at
;; once each saw nil and each `def`'d a table, the second `def` orphaned the first's handles,
;; and `texture-size` answered nil or another test's size (ui_test, in the full suite only,
;; 2026-09-21). A table global images by value (`KIND_TABLE`), empty at build.
(def *textures* (table/new))

(defn size-px (id)
  "Window id's inner size as [w h] in PHYSICAL pixels (tracks resize / HiDPI) — the frame a pixel-space app lays itself out in, where gui/size is the cell grid. Under `{:input :pixels}` the window's [:resize w h] message carries the same numbers.

    (try (gui/size-px 0) (catch e :no-window))   ;=> :no-window   ; no window 0 is open"
  (%gui-size-px id))

(defn texture "Upload an image as a texture of window id for its [:sprite …] ops and return its handle (an int). Either `(gui/texture id image)` with the {:width :height :rgba} map gui/image-thumb decodes, or `(gui/texture id rgba w h)` with raw bytes — w*h*4 of them, row-major, straight alpha (a bytes value or a vector of 0-255 ints). The handle is allocated HERE, in Brood, and the texture's size remembered beside it, which is what lets gui/sprite turn a source rect in texture pixels into the UV rect the renderer wants without asking the GUI thread. Errors when the byte count is not w*h*4; on the CPU render target (a build without `gui-gpu`, or BROOD_GUI_GPU=0) the upload is a silent no-op and a sprite naming the handle draws nothing. Pair with gui/free-texture.

    (try (gui/texture 0 {:width 1 :height 1 :rgba [1 2 3]}) (catch e :bad-size))   ;=> :bad-size   ; 1×1 needs 4 bytes"
  ((id image) (texture id (get image :rgba) (get image :width) (get image :height)))
  ((id rgba w h) (let (tex (alloc-texture w h)) (%gui-texture id tex rgba w h) tex)))

(defn alloc-texture (w h)
  "Allocate a texture handle for a `w`×`h` upload and remember the size under it — the Brood half of gui/texture, on its own for an app that uploads through a DISPLAY map's `:texture` (a window it did not open, or a thin client's over the wire — `editor/frontend/display-texture`) rather than a window id. The handle is process-wide and never reused, so it can name a texture in any window.

    (gui/texture-size (gui/alloc-texture 4 2))   ;=> [4 2]"
  (let (registry *textures*
        tex (table/incr registry :next))
    (table/put registry tex [w h])
    tex))

(defn texture-size (tex)
  "The [w h] in texture pixels a handle from gui/texture was uploaded with, or nil for an unknown handle (one this process never uploaded, or already freed).

    (gui/texture-size 0)   ;=> nil"
  (table/get *textures* tex))

;; The sound registry — handle → seconds of audio — shared by every process, created at
;; load like `*textures*` (and for the same race); the counter under :next allocates handles
;; from 1.
(def *sounds* (table/new))

(defn alloc-sound (seconds)
  "Allocate a sound handle and remember how long the sound runs — the Brood half of
gui/sound, on its own for an app that uploads through a DISPLAY map's `:sound`
(`editor/frontend/display-sound`). Process-wide, never reused.

    (gui/sound-seconds (gui/alloc-sound 0.25))   ;=> 0.25"
  (let (registry *sounds*
        snd (table/incr registry :next))
    (table/put registry snd seconds)
    snd))

(defn sound-seconds (snd)
  "How long the sound under handle `snd` runs, in seconds, or nil for an unknown handle.

    (gui/sound-seconds 0)   ;=> nil"
  (table/get *sounds* snd))

(defn sound (id pcm rate &optional channels)
  "Keep a sound for window id's `[:sound snd vol]` (once) and `[:music snd vol]` (looping)
frame ops and return its handle:
`pcm` is interleaved PCM16 little-endian samples (a bytes value or a vector of 0-255
ints) at `rate` Hz, `channels` 1 (the default) or 2. The handle is allocated in Brood
(gui/alloc-sound) beside the sound's length, so a game can time an effect. A sound
rides the display seam like a texture: it plays on the window that draws the frame
carrying its op. Errors on a bad rate, channel count or an odd byte count.

    (try (gui/sound 0 [1 2 3] 22050) (catch e :odd))   ;=> :odd   ; PCM16 is two bytes a sample"
  (let (ch (or channels 1)
        n (if (bytes? pcm) (bytes/length pcm) (count pcm))
        snd (alloc-sound (->float (/ (math/quot n 2) (* rate ch)))))
    (%gui-sound id snd rate ch pcm)
    snd))

(defn free-sound (id snd)
  "Forget sound snd of window id. Idempotent. Returns nil.

    (try (do (gui/free-sound 0 1) (gui/sound-seconds 1)) (catch e nil))   ;=> nil"
  (table/delete *sounds* snd)
  (%gui-sound-free id snd))

(defn input (id mode)
  "Deliver window id's mouse input in :pixels or :cells from now on — the `{:input …}` gui/open option, switchable after the window exists. The window then reports its size in that unit: a [:resize w h] in pixels follows a switch to :pixels, [:resize cols rows] a switch back. How a window a generic thin client opened (`nest attach --gui`) is told, by the app it attached to, which unit it wants.

    (try (gui/input :w :pixels) (catch e :bad-id))   ;=> :bad-id   ; a window id is an int"
  (%gui-input! id mode))

(defn free-texture (id tex)
  "Release texture tex of window id and forget its size; a later [:sprite …] naming it draws nothing. Idempotent. Returns nil.

    (try (do (gui/free-texture 0 1) (gui/texture-size 1)) (catch e nil))   ;=> nil   ; forgotten, whether or not a window/backend exists"
  (table/delete *textures* tex)
  (%gui-texture-free id tex))

(defn line (x0 y0 x1 y1 color &optional width)
  "The op that draws a line segment from (x0 y0) to (x1 y1) in physical pixels, `width` pixels thick (1 by default), in color — a keyword (:red), an [r g b] triple, an [r g b a] quad for a translucent line, or a \"#rrggbb\" string. A line IS a thin quad at an angle, so this is a [:quad …] whose centre is the segment's midpoint, turned to the segment's angle: put it in a frame like any other op.

    (gui/line 0 0 10 0 :red)   ;=> [:quad 0.0 -0.5 10.0 1.0 :red 0.0]"
  (let (dx (->float (- x1 x0))
        dy (->float (- y1 y0))
        len (math/sqrt (+ (* dx dx) (* dy dy)))
        w (->float (math/max 1 (or width 1)))
        cx (/ (+ (->float x0) (->float x1)) 2)
        cy (/ (+ (->float y0) (->float y1)) 2))
    [:quad (- cx (/ len 2)) (- cy (/ w 2)) len w color (math/atan2 dy dx)]))

(defn sprite (tex x y w h &optional opts)
  "The op that draws texture tex (a handle from gui/texture) with its top-left at (x y) physical pixels, w×h pixels large. `opts`, a map, picks the part and the look: `:src [sx sy sw sh]` the source rect in texture pixels (default the whole texture; needs the size gui/texture recorded, so an unknown handle draws the whole texture), `:flip-x` / `:flip-y` to mirror it, `:tint` a colour multiplied in (default opaque white, so [r g b 128] fades the sprite to half), `:rot` radians clockwise about the sprite's centre. Sheets and animation are one call: the frame is a `:src`. Returns the [:sprite …] op — which carries a UV rect, because that is all the renderer knows.

    (gui/sprite 0 10 20 32 32)   ;=> [:sprite 0 10 20 32 32 [0.0 0.0 1.0 1.0] [255 255 255 255] 0.0]"
  (let (opts (or opts {})
        src (get opts :src)
        size (texture-size tex)
        [tw th] (or size [1 1])
        [sx sy sw sh] (if (and src size) src [0 0 tw th])
        u0 (/ (->float sx) tw)
        v0 (/ (->float sy) th)
        du (/ (->float sw) tw)
        dv (/ (->float sh) th)
        [u0 du] (if (get opts :flip-x) [(+ u0 du) (- du)] [u0 du])
        [v0 dv] (if (get opts :flip-y) [(+ v0 dv) (- dv)] [v0 dv]))
    [:sprite
      tex
      x
      y
      w
      h
      [u0 v0 du dv]
      (or (get opts :tint) [255 255 255 255])
      (->float (or (get opts :rot) 0))]))
