;; std/template.blsp — simple {{var}} string templating.
;;
;; Substitutes `{{key}}` markers in a template string using values from a map.
;; Keys are trimmed; both string and keyword map lookups are tried.

(defmodule template
  "Simple `{{var}}` string templating.

    (template/render \"Hello, {{name}}!\" {\"name\" \"World\"})
    ;; => \"Hello, World!\"

    (template/render \"{{greeting}}, {{name}}!\" {:greeting \"Hi\" :name \"Alice\"})
    ;; => \"Hi, Alice!\"

    ;; Unknown keys render as empty string:
    (template/render \"{{missing}}\" {})
    ;; => \"\"")

;; ---- core render ------------------------------------------------------------

(defn render (tmpl data)
  "Substitute all `{{key}}` markers in `tmpl` with values from map `data`.
Keys in the template are trimmed of whitespace; both string and keyword keys are
tried. Unknown keys render as empty string. Nested `{{` are not supported.

    (template/render \"{{a}}!\" {:a 1})   → \"1!\""
  ;; One native split, then one join. This used to be a recursive scan that, per marker,
  ;; sliced the REST of the template (`(string/substring s (+ open 2) …)`) and re-`str`'d the
  ;; whole output so far — both O(remaining), so the whole render was O(n²): measured
  ;; 12.0× then 13.4× per 4× of input across three points, where linear is 4×.
  ;;
  ;; Note an offset scan (`index-of s "{{" from`) would NOT have fixed it: for a string
  ;; with a non-zero `from`, `index-of` searches `(string/substring coll s0 n)` — it copies the
  ;; suffix on every call, so "incremental search" over one string is quadratic too.
  ;; Splitting sidesteps the whole question: `string-split` is a single native pass, and
  ;; every `substring` below is bounded by ONE piece, so the total stays O(n).
  (let (parts (string/split tmpl "{{"))
    (apply str
      (cons (first parts)
        (map (fn (p) (template-marker p data)) (rest parts))))))

;; One piece following a `{{`: `key}}rest` → the substituted value + `rest`. A piece with
;; no closing `}}` is an unterminated marker, emitted verbatim (`{{` included) — the same
;; "leave it alone" outcome the old scan produced, and `{{` nested inside a marker stays
;; unsupported, as the docstring says.
(defn- template-marker
  (p data)
  (let (close (index-of p "}}"))
    (if (< close 0)
      (str "{{" p)
      (str (template-lookup data (string/trim (string/substring p 0 close)))
        (string/substring p (+ close 2) (string/length p))))))

(defn- template-lookup
  (data key)
  "Look up `key` in `data`, trying string key then keyword key. Returns \"\" if absent.
A substituted value is rendered with `->string` (the `Display` protocol), so a record
substitutes as the string its type defines — a money record as `$10.50`, a datetime as
its ISO form — rather than as its field map."
  (let (v (get data key))
    (cond
      (not (nil? v)) (->string v)
      else (let (kv (get data (keyword key)))
             (if (nil? kv) "" (->string kv))))))

;; ---- render-all -------------------------------------------------------------

(defn render-all (tmpl rows)
  "Apply `render` to `tmpl` for each map in list `rows`. Returns a list of strings."
  (map (fn (row) (render tmpl row)) rows))
