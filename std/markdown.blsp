;; std/markdown.blsp — a small Markdown renderer: Markdown text to HTML.
;;
;; A deliberately small subset: ATX headings, fenced ``` code, `- ` and `1. ` lists, `> `
;; quotes, `---` rules, blank-line paragraphs, and inline `code`, links, autolinks and
;; `**emphasis**` — enough for a guide, a README, a package's documentation page.
;; Everything is HTML-escaped; it is not a CommonMark parser.
;;
;; A CORE module, not tooling: it began as `docs/markdown->html` inside the doc generator
;; (a DEV module), and the hosted registry rendered package READMEs with it — which only
;; worked because the runtime it shipped on was not as lean as its build command claimed
;; (workspace feature unification). A renderer an app calls at request time belongs where
;; every runtime has it.

(defmodule markdown
  "Markdown to HTML: `->html` renders a small subset (ATX headings, fenced code, `- ` and
`1. ` lists, quotes, rules, blank-line paragraphs, inline `code`, links, autolinks and
`**emphasis**`), HTML-escaping everything.")

(defn- md-escape (s)
  (-> (str s) (string/replace "&" "&amp;") (string/replace "<" "&lt;") (string/replace ">" "&gt;")))

;; Schemes that execute rather than fetch. A link carrying one runs script the moment it is
;; clicked, with the page's own origin — which for anything rendering third-party Markdown
;; (a package README on a registry, a dependency's guide in a generated site) means whoever
;; wrote that Markdown chose the code.
(def- *md-unsafe-schemes* ["javascript:" "vbscript:" "data:"])

;; Escape a URL for an `href="…"` attribute (adds `"` to `md-escape`) and neutralise a link
;; that would execute, so a guide's Markdown can't break out of the attribute or inject
;; script into the generated site.
;;
;; The scheme is matched LOWER-CASED. It used to be compared as written, which caught
;; `javascript:` and let `JaVaScRiPt:` through — and a browser matches a scheme
;; case-insensitively, so the spelling that got through is the one an attacker would use.
;; `vbscript:` and `data:` are refused for the same reason: `data:text/html,<script>…` is a
;; document with an origin, not a document that is fetched.
(defn- md-attr (url)
  (let (trimmed (string/trim url)
        lowered (string/lower trimmed))
    (if (any? *md-unsafe-schemes* (fn (scheme) (string/starts-with? lowered scheme)))
      "#"
      (string/replace (md-escape trimmed) "\"" "&quot;"))))

;; A non-code text run: turn `[text](url)` into a link, HTML-escape everything else.

;; ---- inline ------------------------------------------------------------------------
;; A non-code text run rendered as HTML: `[text](url)` links, `<https://…>` autolinks,
;; `**strong**` and `*emphasis*`; everything else HTML-escaped. `_emphasis_` is deliberately
;; not one of them — a README names `snake_case` identifiers outside backticks far more often
;; than it emphasises with underscores, and `*` never appears in an identifier.
(defn- md-run (text)
  (apply str (reverse (md-run-acc text '()))))

;; The four characters an inline construct can begin with. `string/span-until` finds the
;; earliest of them in one native scan, so a run with no markup is one `md-escape`.
(def- *md-inline-openers* "[<*`")

;; The scanning worker: **tail**-recursive, carrying the emitted chunks newest-first (so the
;; caller reverses once) rather than nesting `str` around the recursive call. Two reasons it is
;; shaped this way and not as the obvious `(str … (md-run rest))`: that form recurses once per
;; construct in non-tail position, which the checker flags for stack headroom; and each level
;; built a fresh concatenation of everything after it, which is quadratic in the number of
;; constructs. A list of chunks plus one `apply str` is linear.
;;
;; At each opener `md-construct` either parses one construct — `[html remaining]` — or answers
;; nil, in which case the opener is literal text and the scan moves one character on. An
;; unmatched `[`, a lone `*`, a `<b>` that is a tag rather than a URL: all text, never a crash.
(defn- md-run-acc (text chunks)
  (let (at (string/span-until text 0 *md-inline-openers*)
        end (string/length text))
    (if (>= at end)
      (cons (md-escape text) chunks)
      (let (before (md-escape (string/substring text 0 at))
            rest (string/substring text at end)
            parsed (md-construct rest))
        (if parsed
          (md-run-acc (second parsed) (cons (first parsed) (cons before chunks)))
          (md-run-acc (string/substring rest 1 (string/length rest))
            (cons (md-escape (string/substring rest 0 1)) (cons before chunks))))))))

;; One inline construct at the head of `text` (which starts with an opener), as
;; `[html remaining]`, or nil when the opener is just a character.
(defn- md-construct (text)
  (cond
    (string/starts-with? text "`") (md-code text)
    (string/starts-with? text "[") (md-link text)
    (string/starts-with? text "<") (md-autolink text)
    (string/starts-with? text "**") (md-span text "**" "strong")
    else (md-span text "*" "em")))

;; A code span: everything to the closing backtick, escaped and not scanned — `**kwargs` is a
;; literal there, and so is a `[[…]]` someone is writing ABOUT. Handled by the scanner rather
;; than by splitting the run on backticks first, so `**`name`**` is bold around code: split
;; first and the two `**` fall into different runs and never meet.
(defn- md-code (text)
  (let (close (index-of text "`" 1))
    (when (> close 0)
      [(str "<code>" (md-escape (string/substring text 1 close)) "</code>")
        (string/substring text (+ close 1) (string/length text))])))

;; `[text](url)`: the link text is escaped, not re-scanned — `[**x**](u)` is rare enough that
;; a literal is the safer reading, and it keeps a `]` inside the text from ending it early.
(defn- md-link (text)
  (let (close-bracket (index-of text "]")
        end (string/length text))
    (when (and (> close-bracket 0)
            (= (string/substring text (+ close-bracket 1) (math/min (+ close-bracket 2) end)) "("))
      (let (rest (string/substring text (+ close-bracket 2) end)
            close-paren (index-of rest ")"))
        (when (>= close-paren 0)
          [(str "<a href=\""
             (md-attr (string/substring rest 0 close-paren))
             "\">"
             (md-escape (string/substring text 1 close-bracket))
             "</a>")
            (string/substring rest (+ close-paren 1) (string/length rest))])))))

;; The schemes an `<…>` autolink may carry. Anything else between angle brackets — an HTML
;; tag, a placeholder like `<your token>` — is text, and is escaped like the rest.
(def- *md-autolink-schemes* ["http://" "https://" "mailto:"])

(defn- md-autolink (text)
  (let (close (index-of text ">")
        end (string/length text))
    (when (> close 1)
      (let (url (string/substring text 1 close))
        (when (and (any? *md-autolink-schemes* (fn (scheme) (string/starts-with? url scheme)))
                (= (string/span-until url 0 " \t") (string/length url)))
          [(str "<a href=\"" (md-attr url) "\">" (md-escape url) "</a>")
            (string/substring text (+ close 1) end)])))))

;; `**…**` / `*…*`: the content is re-scanned, so a link or code-free emphasis nests inside
;; strong text. The closing marker must exist, the content must be non-empty and must not
;; begin with a space — `2 * 3 * 4` is arithmetic, not emphasis.
(defn- md-span (text marker tag)
  (let (width (string/length marker)
        end (string/length text)
        close (index-of text marker width))
    (when (and (> close width) (not (string/starts-with? (string/substring text width end) " ")))
      (let (content (string/substring text width close))
        [(str "<" tag ">" (md-run content) "</" tag ">")
          (string/substring text (+ close width) end)]))))

;; Inline Markdown for one text run.
(defn- md-inline (text) (md-run text))

;; ---- blocks ------------------------------------------------------------------------
;; The block state is `{:out :mode :buf :start}`: `out` the HTML so far, `mode` the open
;; block (`:none`, `:para`, `:list`, `:ordered`, `:quote`, `:code`), `buf` its lines
;; newest-first, `start` the first number of an ordered list (so a list that resumes after
;; a code block keeps counting: `<ol start="2">`), `indent` the column a code fence opened
;; at (a fence inside a list item is indented with the item, and its lines shed that much).

;; The code block that was buffered, its lines shed of the fence's own indentation — no more
;; than that, so a further-indented line inside the block keeps its shape.
(defn- md-close-code (state)
  (let (indent (or (get state :indent) 0)
        shed (fn (l) (string/substring l (math/min indent (string/span l 0 " ")) (string/length l))))
    (assoc state
      :out
        (str (get state :out)
          "<pre><code>"
          (md-escape (string/join (map (reverse (get state :buf)) shed) "\n"))
          "</code></pre>")
      :mode :none
      :buf nil)))

;; An indented code block, closed: trailing blank lines dropped, every line shed of the
;; block's common indentation, so an example indented for the docstring it sits in renders
;; flush-left.
(defn- md-close-indented (state)
  (let (lines (reverse (drop-while (get state :buf) (fn (l) (= (string/trim l) ""))))
        indent (fold lines
                 (string/length (or (first lines) ""))
                 (fn (least l)
                   (if (= (string/trim l) "") least (math/min least (string/span l 0 " \t")))))
        shed (fn (l) (string/substring l (math/min indent (string/length l)) (string/length l))))
    (assoc state
      :out
        (str (get state :out)
          "<pre><code>"
          (md-escape (string/join (map lines shed) "\n"))
          "</code></pre>")
      :mode :none
      :buf nil)))

;; Does `line` open (or continue) an indented code block? A tab, or at least the
;; renderer's `:code-indent` spaces — four by default (CommonMark), one for a docstring,
;; whose examples are indented by whatever their author chose.
(defn- md-indented? (state line)
  (or (string/starts-with? line "\t") (>= (string/span line 0 " ") (get state :code-indent 4))))

(defn- md-items (buf)
  (apply str (map (reverse buf) (fn (l) (str "<li>" (md-inline l) "</li>")))))

;; Emit a buffered block when it ends; a no-op for `:none`.
(defn- md-flush (state)
  (let (mode (get state :mode) buf (get state :buf) out (get state :out))
    (cond
      (= mode :para)
        (assoc state
          :out (str out "<p>" (md-inline (string/join (reverse buf) " ")) "</p>")
          :mode :none
          :buf nil)
      (= mode :list) (assoc state :out (str out "<ul>" (md-items buf) "</ul>") :mode :none :buf nil)
      (= mode :ordered)
        (let (start (get state :start))
          (assoc state
            :out
              (str out
                (if (= start 1) "<ol>" (str "<ol start=\"" start "\">"))
                (md-items buf)
                "</ol>")
            :mode :none
            :buf nil))
      (= mode :quote)
        (assoc state
          :out
            (str out
              "<blockquote><p>"
              (md-inline (string/join (reverse buf) " "))
              "</p></blockquote>")
          :mode :none
          :buf nil)
      ;; an unclosed ``` fence at end-of-input: emit what was buffered rather than drop it
      (= mode :code) (md-close-code state)
      (= mode :indented) (md-close-indented state)
      else state)))
(sig md-flush (map -> map))

;; The width of an ordered-list marker (`12. `) at the head of `t`, or 0 when there is none.
(defn- md-ordered-marker (t)
  (let (digits (string/span t 0 "0123456789")
        end (string/length t))
    (if (and (> digits 0) (= (string/substring t digits (math/min (+ digits 2) end)) ". "))
      (+ digits 2)
      0)))

(defn- md-heading (state level text)
  (let (s (md-flush state) tag (str "h" level))
    (assoc s :out (str (get s :out) "<" tag ">" (md-inline text) "</" tag ">"))))

;; A line that continues the item before it: indented, while a list is open. Lazy
;; continuation (an unindented wrapped line) is not honoured — it reads as a paragraph
;; on purpose, which is what the source most often meant.
(defn- md-continues-item? (state line t)
  (and (includes? [:list :ordered] (get state :mode))
    (not (= t ""))
    (string/starts-with? line " ")))

(defn- md-continue-item (state t)
  (let (buf (get state :buf))
    (assoc state :buf (cons (str (first buf) " " t) (rest buf)))))

(defn- md-line (state line)
  (let (mode (get state :mode)
        t (string/trim line)
        end (string/length (string/trim line))
        ordered (md-ordered-marker t))
    (cond
      (string/starts-with? t "```")
        (if (= mode :code)
          (md-close-code state)
          (assoc (md-flush state)
            :mode :code
            :buf nil
            :indent (- (string/length line) (string/length (string/triml line)))))
      (= mode :code) (assoc state :buf (cons line (get state :buf)))
      ;; an indented block continues through blank lines and ends at the first unindented
      ;; text, which is then read as the line it is
      (and (= mode :indented) (or (= t "") (md-indented? state line)))
        (assoc state :buf (cons line (get state :buf)))
      (= mode :indented) (md-line (md-close-indented state) line)
      (= t "") (md-flush state)
      (and (= mode :none) (md-indented? state line)) (assoc state :mode :indented :buf (list line))
      (string/starts-with? t "#### ") (md-heading state 4 (string/substring t 5 end))
      (string/starts-with? t "### ") (md-heading state 3 (string/substring t 4 end))
      (string/starts-with? t "## ") (md-heading state 2 (string/substring t 3 end))
      (string/starts-with? t "# ") (md-heading state 1 (string/substring t 2 end))
      (or (= t "---") (= t "***") (= t "___"))
        (let (s (md-flush state)) (assoc s :out (str (get s :out) "<hr>")))
      (md-continues-item? state line t) (md-continue-item state t)
      (or (string/starts-with? t "- ") (string/starts-with? t "* "))
        (let (s (if (= mode :list) state (md-flush state)))
          (assoc s :mode :list :buf (cons (string/substring t 2 end) (get s :buf))))
      (> ordered 0)
        (let (s (if (= mode :ordered) state (md-flush state))
              number (string/->number (string/substring t 0 (- ordered 2))))
          (assoc s
            :mode :ordered
            :start (if (= mode :ordered) (get s :start) number)
            :buf (cons (string/substring t ordered end) (get s :buf))))
      (string/starts-with? t ">")
        (let (s (if (= mode :quote) state (md-flush state))
              body (string/trim (string/substring t 1 end)))
          (assoc s :mode :quote :buf (cons body (get s :buf))))
      else
        (let (s (if (= mode :para) state (md-flush state)))
          (assoc s :mode :para :buf (cons line (get s :buf)))))))
(sig md-line (map string -> map))

(defn ->html (md &optional (opts {}))
  "Render a Markdown string to HTML — a small subset: ATX headings (`#` to `####`), fenced
  ``` and indented code, `- ` and `1. ` lists (indented continuation lines join their item),
  `> ` quotes, `---` rules, blank-line paragraphs, and inline `code`, `[text](url)` links,
  `<https://…>` autolinks, `**strong**` and `*emphasis*`. Everything is HTML-escaped; not a
  full CommonMark parser. The doc generator renders its guides and every docstring with it;
  the hosted registry its package READMEs.

  `opts` `:code-indent` is how many leading spaces make a line (after a blank one) an
  indented code block: 4 by default, as CommonMark; a docstring passes 1, since its examples
  are indented by whatever their author chose and its prose is never indented at all.

    (markdown/->html \"# hi\")   → \"<h1>hi</h1>\""
  (get (md-flush (fold (string/split md "\n")
                   {:out "" :mode :none :buf nil :start 1 :code-indent (get opts :code-indent 4)}
                   md-line))
    :out))
(sig ->html (string &optional map -> string))
