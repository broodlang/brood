;; std/tool/repl.blsp — the read-eval-print loop, written in Brood.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - The REPL is policy, not mechanism: it's a loop over `read-line` (the one
;;    irreducible I/O primitive), `reflect/eval-string`, and `pr-str`. The Rust binaries
;;    (`brood` with no args, `nest repl`) only bootstrap into `(run)`; the
;;    loop itself — prompts, multi-line reads, error formatting — lives here so
;;    it can be redefined at runtime like everything else (the project's reason
;;    for existing). Replaces the old Rust `crates/repl`.
;;  - No mutation, no loop construct: `repl-loop` is tail-recursive, so it runs
;;    forever in O(1) stack. Memory is bounded by **Stage B's automatic copying
;;    GC** (ADR-055): the loop is a depth-1 spawned-process body, so each command's
;;    transients are reclaimed at the eval safepoint between iterations, keeping
;;    only the loop fn + its args live. `run` runs the loop in a spawned
;;    process and `monitor`s it to await EOF. (Pre-ADR-055 this used an explicit
;;    `(proc/hibernate)` arena flip; automatic GC made that redundant — see ADR-048.)
;;  - Multi-line input is driven by the reader, not a hand-rolled scanner: an
;;    unclosed form or string makes `reflect/eval-string` raise the INCOMPLETE_INPUT
;;    error (code "E0002", ADR-049), the signal to read another line. Because
;;    `reflect/eval-string` reads *all* forms before evaluating any, an incomplete buffer
;;    throws at read time with nothing evaluated, so retrying the whole buffer as
;;    later lines arrive has no partial / double side effects.
;;  - Line editing: on a TTY the loop reads through `std/editor/lineedit.blsp` — a
;;    raw-mode, emacs-style editor (syntax highlighting, bracket matching,
;;    signature hints, Tab completion, ↑/↓ history) written in Brood over the
;;    inline `term-*` seam (ADR-052) — exactly the "now a Brood function to add,
;;    not Rust" point ADR-048 anticipated. Piped (non-TTY) input keeps the plain
;;    `read-line` path unchanged, so `echo … | brood` still works byte-for-byte.
;;    The editor edits one physical line and returns it (a `read-line` drop-in);
;;    multi-line forms still come from the reader-driven accumulation below, with
;;    the already-typed prefix passed in as read-only context so highlighting /
;;    matching / hints see the whole form.
;;  - Reads work piped, too: `echo '(+ 1 2)' | brood` prints `3`. Prompts and the
;;    banner are gated on `(os/stdout-tty?)`, so they never pollute a redirected
;;    stdout; results always print (matching the old plain reader).

; highlight-spans — colourised result output
(defmodule repl
  "The Brood read-eval-print loop. `(run)` reads forms from stdin (handling
multi-line input), evaluates each in the running image, and prints the result —
until end of input (Ctrl-D).

    (run)

Driven from the shell by `brood` (no arguments) and `nest repl`. Interactively:
`*1` `*2` `*3` hold the last three results and `*e` the last error; `,help` lists
the meta-commands (`,doc` `,apropos` `,search` `,expand` `,type` `,time` `,clear`);
Ctrl-C interrupts the running evaluation (the image survives; press it twice to
halt a wedged native — note user code that holds RAW mode turns Ctrl-C into a
plain byte, so a blocked TUI needs a `kill -INT` from another terminal, which
also recovers the session); results print through `pr-str-bounded` under
`*print-length*` / `*print-level*` (use `(pr-str *1)` for the whole value).
Startup files `~/.broodrc.blsp` (or `$BROOD_RC`) then `./.broodrc.blsp` load once
per runtime — the place for `lineedit-bind`, `(def *lineedit-candidates* …)`,
`(def *repl-interruptible* false)`, and other customisations.

Nestable: `pry` (std/tool/debug.blsp) calls `(run)` mid-session. The prompts
are the dynamic vars `*repl-prompt*` / `*repl-cont-prompt*`; rebind them with
`binding` around the call to customise."
  (:use editor/lineedit)
  (:use editor/highlight))
;; ---- configuration (dynamic so a session can rebind them) -------------------

(defdyn *repl-prompt* "brood> ")
(defdyn *repl-cont-prompt* "  ...   ")
(def *repl-banner*
  ;; A plain one-liner (printed only on an interactive TTY); the hint is dimmed.
  "brood — \e[90m,help for commands · Ctrl-D to exit\e[0m")

;; Persistent history: an interactive session loads its history on start and saves
;; it (capped to the most recent *repl-history-max* entries) after each submitted
;; form, so ↑/↓ and C-r span sessions. The file is `$BROOD_HISTORY`, else
;; `$HOME/.brood_history`; one entry per line, oldest first.
(def *repl-history-max* 1000)

;; The reader's INCOMPLETE_INPUT error code (error_codes::INCOMPLETE_INPUT, ADR-049)
;; — an unclosed form or string, i.e. "read another line", as opposed to a genuine
;; syntax error. A stable code, so matching it is robust (no delimiter re-scanning).
(def *repl-incomplete-code* "E0002")

;; Slow-eval timing: when an interactive eval takes at least this many ms, the loop
;; prints a dim `; N ms` note after the value — feedback on what's expensive, hidden
;; for the snappy common case.
(def *repl-slow-ms* 200)

;; ---- result history + last error ---------------------------------------------
;; `*1` `*2` `*3` are the three most recent result values (newest first) and `*e` the
;; last error, exactly as at a Clojure prompt. Without them a value you didn't think
;; to name is simply gone — you retype the expression and recompute it, which for
;; anything expensive or effectful is the wrong answer.
;;
;; They are `defdyn`s because that is the ONLY door to an ambient name (ADR-151): a
;; plain `(def *1 …)` inside `(defmodule repl …)` would define `repl/*1`, while the
;; user typing `*1` at the prompt means the bare root name. `defdyn` marks it never-
;; namespaced, and — per its own docstring — a `def` of it from any module then
;; rebinds that one root binding, which is what `repl-remember-*` below do. We `def`
;; rather than `binding` on purpose: the value has to outlive the form that produced
;; it, and a dynamic binding would unwind at the end of the very eval that set it.
(defdyn *1 nil)
(defdyn *2 nil)
(defdyn *3 nil)
(defdyn *e nil)

(defn- repl-remember-value (v)
  "Shift `v` into the result history (`*1` newest, `*3` oldest). Returns `v`."
  (do
    (def *3 *2)
    (def *2 *1)
    (def *1 v)
    v))

(defn- repl-remember-error (e)
  "Record caught value `e` as `*e` so the prompt can inspect the last failure."
  (do (def *e e) e))

;; ---- colourised output (TTY only) -------------------------------------------
;; The printed result is re-lexed with the *same* highlighter the line editor paints
;; input with (`highlight-spans`), and each span wrapped in an ANSI colour — so a
;; returned list/map/keyword reads with the syntax colours, not as flat text. Plain
;; (uncoloured) on a non-TTY so a piped/redirected session stays clean.

(def- repl-ansi-fg
  ;; the named highlight colours (highlight.blsp's faces) -> ANSI SGR foreground code
  {:red 31
   :green 32
   :yellow 33
   :blue 34
   :magenta 35
   :cyan 36
   :white 37
   :grey 90
   :dark-grey 90})

(def- repl-sgr-reset "\e[0m")

(defn- repl-sgr (face)
  "The opening ANSI escape for a `{:fg <named-colour> :bold ?}` face, or nil when the
face carries no colour we map (leave that span the default colour)."
  (let (code (get repl-ansi-fg (get face :fg)))
    (when code
      (str "\e[" (if (get face :bold) "1;" "") code "m"))))

;; check-allow: deliberately non-tail — depth = highlight spans on one line.
(check-allow :non-tail-recursion
  (defn- repl-paint-spans (src spans i)
    "Emit `src` from offset `i`, wrapping each `[start end face]` span in its ANSI colour
  and leaving the gaps between spans uncoloured."
    (if (empty? spans)
      (string/substring src i)
      (let ([s e face] (first spans)
            painted (let (chunk (string/substring src s e) sgr (repl-sgr face))
                      (if sgr (str sgr chunk repl-sgr-reset) chunk)))
        (str (string/substring src i s) painted (repl-paint-spans src (rest spans) e))))))

(defn- repl-colorize (src)
  "`src` with each lexical highlight span ANSI-coloured; unchanged when nothing
highlights. Used to colour a printed result on an interactive TTY."
  (let (spans (highlight-spans src))
    (if (empty? spans) src (repl-paint-spans src spans 0))))

;; ---- meta-commands (`,cmd` at a fresh prompt) -------------------------------
;; Guile-style `,` commands for things that aren't expressions: docs, the type of a
;; value, timing, a screen clear. `,` is unquote syntax, meaningless at top level, so
;; it's a safe prefix. Only a *known* `,cmd` is intercepted — anything else falls
;; through to the normal reader (so a real syntax error still reports normally).

;; Meta-commands live in a REGISTRY, not a hardcoded name-list + dispatch `cond`, so a
;; tool can add its own `,cmd` at runtime through one seam (`register-repl-command`).
;; Each entry is `{:names (…) :usage str :summary str :handler (fn (rest)) :hidden bool}`:
;; `:names` is the command plus any aliases, `:handler` takes the trimmed argument
;; string, `:usage`/`:summary` render the `,help` table (a `:hidden` entry is dispatched
;; but not listed). The debugger uses this seam to add `,resume`/`,step` under `pry`.
(defonce *repl-commands* (list))

(defn- repl-meta-parts (line)
  "Split a `,cmd arg…` line (sans the leading `,`) into `[cmd rest]`, `rest` trimmed."
  (let (t (string/trim line)
        sp (index-of t " "))
    (if (< sp 0)
      [t ""]
      [(string/substring t 0 sp) (string/trim (string/substring t sp))])))

(defn- repl-has-name? (names x)
  "True when command-name list `names` contains `x`."
  (any? names (fn (n) (= n x))))

(defn- repl-command-for (cmd)
  "The registered command whose `:names` include `cmd`, or nil."
  (first (filter *repl-commands* (fn (c) (repl-has-name? (get c :names) cmd)))))

(defn register-repl-command (spec)
  "Register a `,cmd` meta-command. `spec` is `{:names (->string alias…) :usage str
:summary str :handler (fn (rest)) :hidden bool?}`; `:handler` receives the trimmed
argument text. Re-registering any of `:names` replaces the earlier command (kept in
registration order, the new one last). The extension seam tools use to add commands
— e.g. the debugger registers `,resume`/`,step` under `pry`. Returns the primary name."
  (let (names (get spec :names))
    ;; Filter-then-append as ONE transform: two concurrent registrations of the same
    ;; name each used to filter the old list and each append, so the duplicate this
    ;; promises to replace survived (KI-23 — it failed `repl_test` 2 runs in 5).
    (%swap-registry! repl/*repl-commands*
      (fn (l)
        (append (filter l (fn (c) (not (any? (get c :names) (fn (n) (repl-has-name? names n))))))
          (list spec))))
    (first names)))

(defn- repl-meta? (line)
  "True when `line` is a recognised `,cmd` meta-command (a leading `,` + a registered name)."
  (and (> (string/length line) 0)
    (= (string/char-at line 0) ",")
    (let ([cmd _] (repl-meta-parts (string/substring line 1)))
      (not (nil? (repl-command-for cmd))))))

(defn- repl-pad (s n)
  "Right-pad string `s` with spaces to at least width `n`."
  (let (gap (- n (string/length s)))
    (if (<= gap 0) s (str s (apply str (map (range gap) (constantly " ")))))))
(sig repl-pad (string int -> string))

(defn- repl-command-help-line (c)
  "One aligned `  ,usage   summary` line for a registered command."
  (str "  " (repl-pad (get c :usage) 15) " " (get c :summary)))

(defn- repl-meta-help (rest)
  "Print the `,help` table — generated from the command registry (skipping `:hidden`
entries) plus the static Tab / `*1 *2 *3` footer."
  (io/puts (str "\e[90m"
             (string/join (map (filter *repl-commands* (fn (c) (not (get c :hidden))))
                            repl-command-help-line)
               "\n")
             "\n"
             "  "
             (repl-pad "Tab" 15)
             " complete the name under the cursor; again to list matches\n"
             "  "
             (repl-pad "*1 *2 *3" 15)
             " the last three result values;  *e  the last error"
             "\e[0m")))

(defn- repl-meta-doc (name)
  "Print the docstring + arglist for `name` (a function/macro/primitive), or a note.
The argument must read as exactly one symbol — it is spliced into code text, so
anything else (`,doc foo)`, `,doc (fn …)`, `,doc foo) (extra) (`) would splice extra
forms into the eval rather than fail cleanly."
  ;; check-allow :discarded-catch — best-effort history / rc / cwd / half-typed input: nothing to report yet
  (let (forms (check-allow :discarded-catch (try (reflect/read-all name) (catch _ nil)))
        sym (if (and (pair? forms) (empty? (rest forms))) (first forms) nil))
    (if (not (symbol? sym))
      (io/puts (str "\e[90m(usage: ,doc <name>)\e[0m"))
      (try
        (let (d (reflect/eval-string (str "(doc " name ")"))
              a (reflect/eval-string (str "(arglist " name ")")))
          (io/puts (str "\e[36m(" name (if a (str " " (string/join (map a str) " ")) "") ")\e[0m"))
          (io/puts (if d (str "\e[90m" d "\e[0m") "\e[90m(no documentation)\e[0m")))
        (catch e (io/puts (str "\e[90m(no such name: " name ")\e[0m")))))))

;; `,type` and `,time` EVALUATE user code, so they run through `repl-call` — the same
;; interruptible runner as ordinary forms. `,time` exists precisely for expressions
;; slow enough to wonder about, which makes an uninterruptible one a trap: Ctrl-C
;; during the timing would set a flag nobody polls. Their output goes through the
;; bounded printer for the same reason results do.

(defn- repl-meta-type (expr)
  (repl-call (fn ()
               (try
                 (io/puts (str "\e[33m" (type-of (reflect/eval-string expr)) "\e[0m"))
                 (catch e (io/write (str (repl-error-message e) "\n") :to *err*))))))

(defn- repl-meta-time (expr)
  (repl-call
    (fn ()
      (try
        (let (t0 (os/now)
              v (reflect/eval-string expr)
              ms (- (os/now) t0))
          ; value shown only interactively (piped ,time reports just the
          ; timing, as before) — and bounded, like any printed result
          (when (os/stdout-tty?) (io/puts (repl-colorize (pr-str-bounded v))))
          (io/puts (str "\e[90m; " ms " ms\e[0m")))
        (catch e (io/write (str (repl-error-message e) "\n") :to *err*))))))

;; `apropos` / `doc-search` have been in the prelude all along; the only thing missing
;; was a way to reach them without breaking your typing rhythm. `,apropos` searches
;; NAMES, `,search` searches DOCSTRINGS too and ranks — the two halves of "I know what
;; I want but not what it's called".

(defn- repl-meta-apropos (pattern)
  "Print every global whose name contains `pattern`, one per line (dim), or a note."
  (if (= pattern "")
    (io/puts "\e[90m(usage: ,apropos <pattern>)\e[0m")
    (let (hits (try
                 (apropos pattern)
                 (catch e
                   (do (io/puts (str "\e[90m(apropos failed: " (error-message e) ")\e[0m")) nil))))
      (if (empty? hits)
        (io/puts (str "\e[90m(nothing matching " pattern ")\e[0m"))
        (fold hits nil (fn (_ s) (io/puts (str "\e[36m" s "\e[0m"))))))))

(defn- repl-meta-search (query)
  "Print `doc-search` hits for `query` — `name` then a dim one-line doc summary."
  (if (= query "")
    (io/puts "\e[90m(usage: ,search <words>)\e[0m")
    (let (hits (try
                 (doc-search query)
                 (catch e
                   (do (io/puts (str "\e[90m(search failed: " (error-message e) ")\e[0m")) nil))))
      (if (empty? hits)
        (io/puts (str "\e[90m(nothing matching " query ")\e[0m"))
        (fold hits
          nil
          (fn (_ [name doc])
            (io/puts (str "\e[36m" name "\e[0m  \e[90m" (repl-first-line doc) "\e[0m"))))))))

(defn- repl-first-line (s)
  "The first line of `s`, truncated to a terminal-ish width — a docstring's summary
line, so a multi-paragraph doc doesn't turn one search hit into a screenful."
  (let (line (first (string/split (or s "") "\n"))
        max 96)
    (if (> (string/length line) max) (str (string/substring line 0 max) "…") line)))

(defn- repl-meta-expand (expr all)
  "Print `expr` macroexpanded — fully when `all`, one step otherwise — syntax-coloured
and run through the formatter, since an expansion is exactly the kind of dense nested
form that is unreadable on one line."
  (if (= expr "")
    (io/puts "\e[90m(usage: ,expand <form>)\e[0m")
    (try
      (let (form (reflect/read-first expr)
            out (if all (macroexpand form) (macroexpand-1 form))
            ;; `format` is required lazily — pretty-printing an expansion is worth a
            ;; module load the first time you ask, but not on every REPL boot.
            text (try
                   (do (string/trim (format/source (pr-str out))))
                   (catch _ (pr-str out))))
        (io/puts (if (os/stdout-tty?) (repl-colorize text) text)))
      (catch e (io/write (str (repl-error-message e) "\n") :to *err*)))))

(defn- repl-run-meta (line)
  "Dispatch a `,cmd` meta-command line (verified by `repl-meta?`) through the registry.
Returns nil; the loop just continues to the next prompt."
  (let ([cmd rest] (repl-meta-parts (string/substring line 1))
        c (repl-command-for cmd))
    (when c ((get c :handler) rest))))

;; ---- register the built-in meta-commands (in display order) -----------------
;; Registered at module load, after their handlers are defined. A tool adds more with
;; `register-repl-command` (the debugger does, under `pry`).
(register-repl-command {:names '("help" "?")
                        :usage ",help ,?"
                        :summary "this list"
                        :handler (fn (rest) (repl-meta-help rest))})
(register-repl-command {:names '("doc")
                        :usage ",doc <name>"
                        :summary "docstring + arglist of a function/macro/primitive"
                        :handler (fn (rest) (repl-meta-doc rest))})
(register-repl-command {:names '("type")
                        :usage ",type <expr>"
                        :summary "evaluate <expr> and show its runtime type"
                        :handler (fn (rest) (repl-meta-type rest))})
(register-repl-command {:names '("time")
                        :usage ",time <expr>"
                        :summary "evaluate <expr> and show elapsed time"
                        :handler (fn (rest) (repl-meta-time rest))})
(register-repl-command {:names '("clear")
                        :usage ",clear"
                        :summary "clear the screen"
                        :handler (fn (rest) (io/write "\e[2J\e[H"))})
(register-repl-command {:names '("apropos")
                        :usage ",apropos <pat>"
                        :summary "globals whose NAME contains <pat>"
                        :handler (fn (rest) (repl-meta-apropos rest))})
(register-repl-command {:names '("search")
                        :usage ",search <words>"
                        :summary "globals whose name or DOC matches <words>, best first"
                        :handler (fn (rest) (repl-meta-search rest))})
(register-repl-command {:names '("expand")
                        :usage ",expand <form>"
                        :summary "fully macroexpand <form> (once: ,expand1)"
                        :handler (fn (rest) (repl-meta-expand rest true))})
(register-repl-command {:names '("expand1")
                        :usage ",expand1 <form>"
                        :summary "macroexpand <form> one step"
                        :hidden true
                        :handler (fn (rest) (repl-meta-expand rest false))})

;; ---- whitespace / comment skip ----------------------------------------------

(defn- repl-content? (s i n in-com)
  "True if `s` holds an actual datum — i.e. some character that isn't whitespace
or part of a `;`-comment. Lets the loop ignore blank / comment-only lines at a
fresh prompt without echoing `nil`."
  (if (>= i n)
    false
    (let (c (string/char-at s i) j (inc i))
      (cond
        in-com (repl-content? s j n (not (= c "\n")))
        (= c ";") (repl-content? s j n true)
        (string/blank? c) (repl-content? s j n false)
        else true))))

;; ---- evaluation -------------------------------------------------------------

(defn- repl-incomplete? (e)
  "True when caught value `e` is the reader's *incomplete input* error (EOF inside
a form or string) — the signal to read another line. Matches the stable error
code rather than re-scanning delimiters (ADR-049)."
  (and (map? e) (= (get e :code) *repl-incomplete-code*)))

(defn- repl-trace-lines (tr)
  "Render an error map's :trace entries as `  at fn (file:line:col)` lines,
innermost frame first (each location is the call site that entered the frame)."
  (string/join (map tr
                 (fn (f)
                   (str "\n  at "
                     (or (get f :fn) "<fn>")
                     (cond
                       (contains? f :line)
                         (str " ("
                           (if (contains? f :file) (str (get f :file) ":") "")
                           (get f :line)
                           ":"
                           (get f :col)
                           ")")
                       (contains? f :file) (str " (" (get f :file) ")")
                       else ""))))
    ""))

(defn- repl-error-message (e)
  "Render a caught value for display: built-in errors arrive as a structured map
`{:kind :message [:line :col] [:trace …] …}`, a user `throw` arrives as the raw
value."
  (if (and (map? e) (contains? e :message))
    (str (if (contains? e :kind) (str (->string (get e :kind)) " error") "error")
      ": "
      (get e :message)
      (if (contains? e :line)
        (str " (line " (get e :line) ", col " (get e :col) ")")
        "")
      (if (contains? e :trace) (repl-trace-lines (get e :trace)) ""))
    (str "error: " (if (string? e) e (pr-str e)))))

(defn- repl-print-value (v)
  "Print a result value — syntax-coloured (the input highlighter, reused) on an
interactive TTY, plain on a pipe.

Printed with `pr-str-bounded`, so a huge or deeply-nested result elides with `…`
instead of scrolling the session away; `(pr-str *1)` still shows the whole thing,
and `(binding (*print-length* nil) …)` lifts the bound for a form."
  (let (s (pr-str-bounded v))
    (io/puts (if (os/stdout-tty?) (repl-colorize s) s))))

;; ---- advisory type-check (the checker, at the prompt) -----------------------
;; The REPL is the one place every `def` is already LOADED, so the checker's inference
;; applies to the whole live image — a call to a just-defined function is checked against
;; its *inferred* signature, not just its declared one. Fragment-mode `check` (no
;; operand-unbound), so a genuine typo's `unbound` isn't printed twice: `reflect/eval` raises that;
;; here we surface the type/arity misuse it can't. Advisory — printed before the result,
;; never blocks it, silent when clean, on incomplete input, or under `BROOD_NO_CHECK`.
(defn- repl-check-warnings (src)
  "The advisory type-check warning strings for REPL input `src` (each complete form checked
against the live image), or nil. Nil on incomplete input — there is nothing to check yet."
  (if (os/env "BROOD_NO_CHECK")
    nil
    ;; check-allow :discarded-catch — best-effort history / rc / cwd / half-typed input: nothing to report yet
    (mapcat (check-allow :discarded-catch (try (reflect/read-all src) (catch _ nil))) reflect/check)))

(defn- repl-warn (src)
  "Print `src`'s advisory type-check warnings to stderr — yellow on a TTY, plain on a pipe."
  (for (w (repl-check-warnings src))
    (io/write (if (os/stdout-tty?) (str "\e[33mwarning:\e[0m " w "\n") (str "warning: " w "\n"))
      :to *err*)))

(defn- repl-eval-print (src)
  "Evaluate `src` in the running image. Prints any advisory type-check warnings first, then
returns `:ok` after printing its (coloured) value — plus a dim `; N ms` note when the eval
was slow — `:more` if `src` is an incomplete form (read another line), or `:error` after
reporting a real error. Never lets an error escape the loop."
  (try
    (let (_ (repl-warn src)
          t0 (os/now)
          v (reflect/eval-string src)
          ms (- (os/now) t0))
      (repl-remember-value v)
      (repl-print-value v)
      (when (and (os/stdout-tty?) (>= ms *repl-slow-ms*))
        (io/puts (str "\e[90m; " ms " ms\e[0m")))
      :ok)
    (catch e
      ;; An incomplete form is not a failure — it's "read another line" — so it must
      ;; NOT land in `*e` and clobber the error the user is actually debugging.
      (if (repl-incomplete? e)
        :more (do
          (repl-remember-error e)
          (io/write (str (repl-error-message e) "\n") :to *err*)
          :error)))))

;; ---- interruptible evaluation ------------------------------------------------
;; Ctrl-C during a long evaluation used to terminate the runtime: the default SIGINT
;; disposition, arriving while the terminal is out of raw mode (the editor only holds
;; raw mode for the *read*). So the price of stopping one runaway expression was the
;; entire live image — every definition and every spawned process. In a language whose
;; whole premise is a long-lived redefinable image, that is the worst possible trade.
;;
;; The fix uses machinery that already existed rather than adding an interrupt path to
;; the evaluator: run each eval in its own **green process**, and `(exit pid :kill)` it
;; — the untrappable hard kill, honoured at the target's next reduction tick. The
;; kernel contributes only the signal seam it must (`%install-interrupt-handler` /
;; `%interrupt-taken?`, ADR-006: signals are mechanism), and everything else is here.
;;
;; Why this needs no evaluator changes *here*: the parent parks in `receive`, so the
;; scheduler is free to run the child, and the *scheduler* is what enforces the kill.
;; Nothing has to poll a flag inside `reflect/eval`. (It did need one kernel fix to work at
;; all: a process spinning inside a nested `reflect/eval`/`reflect/eval-string` never honoured the
;; hard kill, because the non-capturing eval paths' reduction tick was pure
;; accounting — `tick_reporting_hard_kill` in `process/scheduler.rs` closed that,
;; measured at ~4ms kill latency even on a JIT'd loop. The same fix is what makes
;; supervisors able to kill a stuck code-evaluating child, so it stands on its own.)
;;
;; Off-switch: `(def *repl-interruptible* false)` in `.broodrc.blsp` reverts to the
;; inline eval path with the default SIGINT disposition (Ctrl-C kills the runtime, as
;; before) — the rc runs before the handler would be installed, so the `and` in
;; `run` short-circuits. A redefinable global, not an env knob, like every other
;; REPL policy here. (Setting it false *at the prompt* also reroutes to inline eval,
;; but the handler is already installed by then, so Ctrl-C during a long eval becomes
;; inert rather than fatal — prefer the rc.)
;;
;; Three details that matter:
;;  - The child does its own printing and its own `*1`/`*e` bookkeeping. `def` reaches
;;    the runtime's shared code region, so a definition made in the child is visible at
;;    the next prompt — and the result value never has to be copied between heaps.
;;  - Interactive sessions ONLY. A piped `echo … | brood` keeps the plain inline path
;;    and the default SIGINT, so scripts and pipelines die on Ctrl-C like any other Unix
;;    program; taking that over would be a nasty surprise in a shell pipeline.
;;  - A second Ctrl-C **halts**. The hard kill lands at a reduction tick, so an
;;    evaluation wedged inside a single native builtin may never take it; rather than
;;    trap the user at an unresponsive prompt, the second interrupt restores the old
;;    behaviour and exits 130. Escalation, not a dead end.

;; The user-facing knob AND the armed state, one global. It defaults true ("arm if you
;; can"); `run` then resolves it to the real armed state by AND-ing in the things
;; the user can't control — an interactive session, a platform with signals — AFTER the
;; rc files load, so `(def *repl-interruptible* false)` in `.broodrc.blsp` sticks (the
;; `and` short-circuits and the handler is never installed). By the first prompt it is
;; always a plain boolean: armed or not.
(defdyn *repl-interruptible* true)

;; How long the parent parks between interrupt polls. Short enough that Ctrl-C feels
;; instant, long enough to cost nothing: the parent is parked in `receive`, so this is
;; a timer, not a spin.
(def *repl-interrupt-poll-ms* 40)

;; NESTED sessions and interrupt ownership. `pry` (std/tool/debug.blsp) launches
;; `run` *inside* an outer REPL's evaluation — so two loops are alive at once, and
;; both would poll the one read-and-clear interrupt flag every 40ms. Whoever polled
;; first would consume the Ctrl-C: if the OUTER loop won, it would hard-kill its child
;; — which is the entire pry session — when the user only meant to stop one expression
;; typed at the `debug>` prompt. So the flag has one owner at a time: the INNERMOST
;; runner. Runners register in a stack (a `Table` — the sanctioned shared-mutable store
;; — since the stack must be visible across the loop processes); only the pid at the
;; head polls. Nesting is strict — an outer runner is parked in `receive` for as long
;; as its child runs — so push/pop never race. If the head pid has *died* without
;; popping (its runner was killed rather than returning), the next poller repairs the
;; stack instead of leaving the flag permanently unowned.
(def- *repl-interrupt-owners* (table/new))

(defn- repl-interrupt-push ()
  "Register the calling process as the innermost interrupt owner."
  (table/put *repl-interrupt-owners*
    :stack (cons (self) (or (table/get *repl-interrupt-owners* :stack) '()))))

(defn- repl-interrupt-pop ()
  "Deregister the calling process (must be the current head — strict nesting)."
  (table/put *repl-interrupt-owners*
    :stack (rest (or (table/get *repl-interrupt-owners* :stack) '()))))

(defn- repl-interrupt-owner? ()
  "Is the calling process the innermost live interrupt owner? Repairs the stack past
dead heads (a runner that was killed instead of returning), so ownership can never be
wedged on a corpse."
  (let (stack (or (table/get *repl-interrupt-owners* :stack) '()))
    (cond
      (empty? stack) true
      (= (first stack) (self)) true
      ;; a dead head can't poll — drop it and re-ask
      (nil? (proc/info (first stack)))
        (do
          (table/put *repl-interrupt-owners*
            :stack (rest stack))
          (repl-interrupt-owner?))
      else false)))

(defn- repl-await-child (child ref killed)
  "Park until the spawned `child` dies, polling for Ctrl-C — but only while we are the
innermost interrupt owner, so a nested session's Ctrl-C is never stolen by an outer
loop. Returns `:ok` normally, `:interrupted` when we killed it."
  (receive
    ([:down ^ref ^child _] (if killed (do (io/puts "\e[90m; interrupted\e[0m") :interrupted) :ok))
    (after *repl-interrupt-poll-ms*
      (if (and (repl-interrupt-owner?) (%interrupt-taken?))
        (if killed
          ;; The kill didn't land — a native builtin that never reaches a reduction
          ;; tick. Don't pretend to be interruptible; give the user their Unix Ctrl-C.
          (do
            (io/write "\n; evaluation is not yielding — halting\n" :to *err*)
            (%halt 130))
          (do (exit child :kill) (repl-await-child child ref true)))
        (repl-await-child child ref killed)))))

(defn- repl-call-interruptible (thunk)
  "Run `thunk` in a spawned process so Ctrl-C can kill it without taking the image down
with it — the shared runner behind evaluation AND the evaluating meta-commands
(`,time`, `,type`), which are just as capable of running away. Returns `:ok` or
`:interrupted`."
  (do
    ;; Drain a stale request first. In raw mode Ctrl-C is byte 0x03 (ISIG is off) and
    ;; never signals — but the gap between reads is cooked, so a Ctrl-C there would set
    ;; the flag and otherwise abort the *next* expression the moment it started. Only
    ;; the innermost owner may drain: an outer runner draining here would eat a Ctrl-C
    ;; belonging to a nested session. (Unreachable in practice — an outer loop is
    ;; parked while a nested session runs — but the guard keeps the invariant local.)
    (when (repl-interrupt-owner?) (%interrupt-taken?))
    (repl-interrupt-push)
    (let (child (spawn (thunk))
          ref (monitor child)
          result (repl-await-child child ref false))
      (repl-interrupt-pop)
      result)))

(defn- repl-eval (src)
  "Evaluate + print `src`, interruptibly when this session armed it (`run` on a
TTY), else inline. The seam the loop calls."
  (if *repl-interruptible*
    (repl-call-interruptible (fn () (repl-eval-print src)))
    (repl-eval-print src)))

(defn- repl-call (thunk)
  "Run `thunk` — a meta-command body that evaluates user code — interruptibly when the
session is armed, else inline. The meta-command counterpart of `repl-eval`."
  (if *repl-interruptible*
    (repl-call-interruptible thunk)
    (do (thunk) :ok)))

;; ---- history ----------------------------------------------------------------

(defn- repl-history-path ()
  "The history file path: `$BROOD_HISTORY`, else `$HOME/.brood_history` (or, with no
`$HOME`, `.brood_history` in the current directory)."
  (let (override (os/env "BROOD_HISTORY"))
    (if override
      override
      (str (or (os/env "HOME") ".") "/.brood_history"))))

(defn- repl-history->text (history)
  "Serialize `history` (newest first) to file text: the most recent
`*repl-history-max*` entries, oldest first, one per line. (Pure — the testable core
of `repl-save-history`.)"
  (string/join (reverse (take history *repl-history-max*)) "\n"))

(defn- repl-history<-text (text)
  "Parse history-file `text` into a history list (newest first), dropping blank
lines. (Pure — the testable core of `repl-load-history`.)"
  (reverse (filter (string/split text "\n") (fn (l) (not (= l ""))))))

(defn- repl-load-history ()
  "Load saved history (newest first) from the history file, or `()` if none / on any
read error — a missing or unreadable history file must never stop the REPL starting."
  (try
    (let (path (repl-history-path))
      (if (file/exists? path) (repl-history<-text (file/slurp path)) '()))
    (catch e '())))

(defn- repl-save-history (history)
  "Write the most recent `*repl-history-max*` entries to the history file (oldest
first, one per line). Best-effort: a write failure is swallowed, never breaking the
loop."
  ;; check-allow :discarded-catch — best-effort history / rc / cwd / half-typed input: nothing to report yet
  (check-allow :discarded-catch
    (try (file/spit (repl-history-path) (repl-history->text history)) (catch e nil))))

;; ---- I/O loop ---------------------------------------------------------------

(defn- repl-complete? (src)
  "The Enter predicate for the multi-line line editor: true when `src` is a complete
form — or a genuine *syntax* error, which should submit so eval reports it — and false
only when the reader wants more input (the E0002 incomplete signal: insert a newline
and keep editing). So `(defn foo` opens a continuation line; a balanced form submits."
  (try
    (do (reflect/read-all src) true)
    (catch e (not (repl-incomplete? e)))))

(defn- repl-submit (interactive form history)
  "Act on a submitted `form`: run a `,cmd` meta-command, skip a blank/comment-only line,
else eval + print it. Remembers it for ↑/↓ (persisted only for interactive sessions).
Returns `{:eof false :history h}`."
  (let (remember (fn ()
                   (let (h2 (editor/lineedit/lineedit-remember history form))
                     (when interactive (repl-save-history h2))
                     {:eof false :history h2})))
    (cond
      (repl-meta? form) (do (repl-run-meta form) (remember))
      (not (repl-content? form 0 (string/length form) false)) {:eof false :history history}
      else (do (repl-eval form) (remember)))))

(defn- repl-read-eval-interactive (history)
  "Interactive read: the multi-line line editor reads a whole form in one session
(Enter inserts a newline while the form is incomplete, repainting every line in place
so bracket matches light up across lines), then we act on it. Ctrl-D on an empty line
ends input; Ctrl-C drops the form and re-prompts."
  (let (r (lineedit-read *repl-prompt*
            ""
            history
            {:cont-prompt *repl-cont-prompt* :complete? repl-complete?}))
    (cond
      (get r :eof) {:eof true :history history}
      (get r :cancel) {:eof false :history history}
      else (repl-submit true (get r :line) history))))

(defn- repl-read-eval-piped (acc history)
  "Piped/redirected read: accumulate physical lines (no editor) until the form is
complete, echoing the prompt only when stdout is a TTY. Recurses on an incomplete form."
  (do
    (when (os/stdout-tty?) (io/write (if (= acc "") *repl-prompt* *repl-cont-prompt*)))
    (let (line (read-line))
      (cond
        (nil? line)
          (do
            (when (and (not (= acc "")) (= (repl-eval-print acc) :more))
              (io/write "error: incomplete input at end of input\n" :to *err*))
            {:eof true :history history})
        (and (= acc "") (repl-meta? line)) (do (repl-run-meta line) {:eof false :history history})
        (and (= acc "") (not (repl-content? line 0 (string/length line) false)))
          {:eof false
           :history history}
        else
          (let (src (str acc line "\n"))
            (if (= (repl-eval-print src) :more)
              (repl-read-eval-piped src history)
              {:eof false :history history}))))))

(defn- repl-read-eval (interactive acc history)
  "Read one form and act on it, returning `{:eof <bool> :history <list>}`. Interactive
sessions use the multi-line line editor; piped input accumulates physical lines."
  (if interactive
    (repl-read-eval-interactive history)
    (repl-read-eval-piped acc history)))

(defn- repl-loop (interactive history)
  "Read-eval one form (skipping blank / comment-only input), then tail-recurse into
the next iteration. Each command's transients are reclaimed by Stage B's automatic
GC at the safepoint between iterations (this loop is a depth-1 spawned-process
body); `interactive` and `history` stay live as rooted tail-call arguments.
Returns (and the process exits) at end of input."
  (let (r (repl-read-eval interactive "" history))
    (if (get r :eof)
      (when (os/stdout-tty?) (io/write "\n"))
      (repl-loop interactive (get r :history)))))

(defn- repl-await (p)
  "Block the current process until process `p` exits."
  (let (r (monitor p))
    (receive ([:down ^r ^p _] nil))))

;; ---- startup file -----------------------------------------------------------
;; Everything in this REPL is redefinable at runtime — the prompt, the keymap, the
;; completion source, every command — which was worth nothing while there was no
;; place to *put* a redefinition: each customisation died with the session. The rc
;; file is that place, and it's the payoff on ADR-048's premise rather than a new
;; feature: `(lineedit-bind :ctrl-x 'my-cmd)`, `(def *lineedit-candidates* …)`,
;; `(def *print-length* 20)` all become permanent by living in a file.
;;
;; Two files, user then project, both optional and both loaded in that order so a
;; project can override a personal default. It is deliberately NOT a manifest key:
;; this is a script, evaluated in the live image, not configuration to be parsed.
;;
;; A broken rc must never stop the REPL starting — that would be a customisation
;; that locks you out of the tool you'd fix it with — so failure prints the error
;; and carries on.

(defn- repl-rc-paths ()
  "The startup files to load, in order: `$BROOD_RC` (else `$HOME/.broodrc.blsp`), then
`./.broodrc.blsp` for a project-local one. Duplicates collapse, so running the REPL
from your home directory doesn't load the same file twice."
  (let (user (or (os/env "BROOD_RC")
               (let (home (os/env "HOME")) (if home (path/join home ".broodrc.blsp") nil)))
        ;; Compared against the *absolute* local path, since `user` is absolute — a
        ;; bare "./.broodrc.blsp" would never match it and we'd load twice.
        local (try (path/join (file/cwd) ".broodrc.blsp") (catch _ ".broodrc.blsp")))
    (filter (if (= user local) (list user) (list user local)) (fn (p) (not (nil? p))))))

;; Loaded ONCE per runtime, not once per `run`: `pry` launches a nested `run`
;; mid-session, and re-running the user's rc there would re-execute its side effects
;; and silently re-apply defs over the live session's state.
(def- *repl-rc-loaded* false)

(defn- repl-load-rc ()
  "Load each existing startup file, reporting (but surviving) a failure in one — once
per runtime (a nested `run`, e.g. `pry`, must not re-run the rc mid-session).
Runs before the banner so anything an rc prints reads as part of startup, and before
the loop spawns so its `def`s are in place for the first prompt."
  (when (not *repl-rc-loaded*)
    (def- *repl-rc-loaded* true)
    (fold (repl-rc-paths)
      nil
      (fn (_ path)
        ;; check-allow :discarded-catch — best-effort history / rc / cwd / half-typed input: nothing to report yet
        (when (check-allow :discarded-catch (try (file/exists? path) (catch _ false)))
          (try
            (reflect/load path)
            (catch e
              (io/write (str "\e[33mwarning:\e[0m " path ": " (repl-error-message e) "\n")
                :to *err*))))))))

;; Which `run` invocation owns the installed SIGINT handler — nil when none is
;; installed. Only the invocation that *installed* it restores the default disposition
;; on exit: a nested session (pry under the REPL) must leave the outer session's
;; handler alone, while a transient session (pry under a *script*) must restore the
;; script's normal fatal Ctrl-C — otherwise every later Ctrl-C sets a flag nobody
;; polls and the script becomes uninterruptible.
(def- *repl-sigint-owner* nil)

;; If non-nil (a bare module symbol), the loop enters this namespace at startup, so a
;; bare name defined there resolves at the prompt without qualification. `nest repl`
;; sets it to the project's `:main` module (the interactive half of package rooting,
;; ADR-070); it is rooted through the ambient package context in the loop process. A
;; plain `def` (not a `defdyn`) so it reaches the spawned loop across `spawn`.
(def *repl-start-ns* nil)

(defn run ()
  "Run the read-eval-print loop on stdin until end of input (Ctrl-D). When stdin and
stdout are both a TTY it edits interactively (`std/editor/lineedit.blsp`) with the banner +
prompts; redirected stdin keeps the plain `read-line` path (prompt echoed only when
stdout is a TTY). The loop runs in a spawned process — so Stage B's automatic GC
reclaims each command's transients at the safepoint — and this call blocks (parked
in `receive`) until that process reaches end of input. Returns nil.

Loads the startup files first (`$BROOD_RC` or `~/.broodrc.blsp`, then a project-local
`./.broodrc.blsp`, once per runtime); a failure in one is reported and skipped, never
fatal. Nestable: `pry` calls this from inside a session — prompts rebound with
`binding` around the call are honoured, and the SIGINT handler is installed/restored
by the outermost invocation only."
  (let (interactive (and (os/stdin-tty?) (os/stdout-tty?))
        _rc (repl-load-rc)
        ;; Resolve `*repl-interruptible*` to the real armed state: the user's knob (the
        ;; rc has already run, so an opt-out short-circuits before the handler is ever
        ;; installed) AND an interactive session (a pipeline must keep the default
        ;; SIGINT — Ctrl-C on `echo … | brood` should kill it like any Unix program)
        ;; AND the platform actually installing a handler. `def` (not `binding`)
        ;; because the flag has to reach the spawned loop process.
        armed (and *repl-interruptible* interactive (%install-interrupt-handler))
        _set (def *repl-interruptible* armed)
        ;; The first armed invocation owns the handler (a unique token compared at
        ;; exit); a nested run sees a non-nil owner and leaves restoration to it.
        token (ref)
        owner (and armed (nil? *repl-sigint-owner*))
        _own (when owner (def- *repl-sigint-owner* token))
        ;; Capture the prompts HERE, where a caller's `binding` (pry's `debug> `) is
        ;; still in scope — dynamics do not cross `spawn`, so the loop process would
        ;; otherwise fall back to the defaults — and re-establish them in the loop.
        prompt *repl-prompt*
        cont-prompt *repl-cont-prompt*
        history (if interactive (repl-load-history) '()))
    (when (os/stdout-tty?) (io/write (str *repl-banner* "\n") :to *err*))
    ;; A process spawned at the prompt and left to crash reports itself (ADR-305).
    (%crash-report-arm-default)
    ;; `%in-ns` must run in the LOOP process (its persistent `compile_ns` is what each
    ;; `reflect/eval-string` inherits), not the parent — and only there does it see the ambient
    ;; package context that roots the module name. A no-op when `*repl-start-ns*` is nil
    ;; (the plain `brood` REPL, or `nest repl` outside a project).
    (repl-await
      (spawn
        (binding (*repl-prompt* prompt *repl-cont-prompt* cont-prompt)
          ;; Guard on `symbol?`, not on truthiness. `*repl-start-ns*` is a
          ;; redefinable global, so it types as `dynamic()`; `(when *x* …)` only
          ;; rules out nil/false, which is not enough for the checker to conclude
          ;; `%in-ns` gets a symbol — it warned on both the direct read and on a
          ;; plain `let` binding of it. A type predicate is what occurrence typing
          ;; narrows on, and it is the better guard anyway: a non-symbol value
          ;; here (someone `def`s it to a string) now skips rather than erroring.
          (let (start-ns *repl-start-ns*)
            (when (symbol? start-ns) (%in-ns start-ns)))
          (repl-loop interactive history))))
    (when (and owner (= *repl-sigint-owner* token))
      (%restore-interrupt-handler)
      (def- *repl-sigint-owner* nil)
      ;; back to the "arm if you can" intent, so a later run re-resolves afresh
      (def *repl-interruptible* true))
    nil))
