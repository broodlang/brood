;; std/repl.blsp — the read-eval-print loop, written in Brood. (require 'repl).
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - The REPL is policy, not mechanism: it's a loop over `read-line` (the one
;;    irreducible I/O primitive), `eval-string`, and `pr-str`. The Rust binaries
;;    (`brood` with no args, `nest repl`) only bootstrap into `(repl-run)`; the
;;    loop itself — prompts, multi-line reads, error formatting — lives here so
;;    it can be redefined at runtime like everything else (the project's reason
;;    for existing). Replaces the old Rust `crates/repl`.
;;  - No mutation, no loop construct: `repl--loop` is tail-recursive, so it runs
;;    forever in O(1) stack. Memory is bounded by **Stage B's automatic copying
;;    GC** (ADR-055): the loop is a depth-1 spawned-process body, so each command's
;;    transients are reclaimed at the eval safepoint between iterations, keeping
;;    only the loop fn + its args live. `repl-run` runs the loop in a spawned
;;    process and `monitor`s it to await EOF. (Pre-ADR-055 this used an explicit
;;    `(hibernate)` arena flip; automatic GC made that redundant — see ADR-048.)
;;  - Multi-line input is driven by the reader, not a hand-rolled scanner: an
;;    unclosed form or string makes `eval-string` raise the INCOMPLETE_INPUT
;;    error (code "E0002", ADR-049), the signal to read another line. Because
;;    `eval-string` reads *all* forms before evaluating any, an incomplete buffer
;;    throws at read time with nothing evaluated, so retrying the whole buffer as
;;    later lines arrive has no partial / double side effects.
;;  - Line editing: on a TTY the loop reads through `std/lineedit.blsp` — a
;;    raw-mode, emacs-style editor (syntax highlighting, bracket matching,
;;    signature hints, Tab completion, ↑/↓ history) written in Brood over the
;;    inline `term-*` seam (ADR-052) — exactly the "now a Brood function to add,
;;    not Rust" point ADR-048 anticipated. Piped (non-TTY) input keeps the plain
;;    `read-line` path unchanged, so `echo … | brood` still works byte-for-byte.
;;    The editor edits one physical line and returns it (a `read-line` drop-in);
;;    multi-line forms still come from the reader-driven accumulation below, with
;;    the already-typed prefix passed in as read-only context so highlighting /
;;    matching / hints see the whole form.
;;  - Reads work piped, too: `echo '(+ 1 2)' | brood` prints `3`. Prompts and the
;;    banner are gated on `(stdout-tty?)`, so they never pollute a redirected
;;    stdout; results always print (matching the old plain reader).

; highlight-spans — colourised result output
(defmodule repl
  "The Brood read-eval-print loop. `(repl-run)` reads forms from stdin (handling
multi-line input), evaluates each in the running image, and prints the result —
until end of input (Ctrl-D).

    (require 'repl)
    (repl-run)

Driven from the shell by `brood` (no arguments) and `nest repl`. The prompts are
the dynamic vars `*repl-prompt*` / `*repl-cont-prompt*`; rebind them with
`binding` to customise."
  (:use editor/lineedit)
  (:use editor/highlight))
;; ---- configuration (dynamic so a session can rebind them) -------------------

(defdyn *repl-prompt* "brood> ")
(defdyn *repl-cont-prompt* "  ...   ")
(def *repl-banner*
  ;; A plain one-liner (printed only on an interactive TTY); the hint is dimmed.
  "brood — \e[90m,help for commands · Ctrl-D to exit\e[0m")

;; Persistent history: an interactive session loads its history on start and saves
;; it (capped to the most recent *repl-history-max* entries) after each submitted
;; form, so ↑/↓ and C-r span sessions. The file is `$BROOD_HISTORY`, else
;; `$HOME/.brood_history`; one entry per line, oldest first.
(def *repl-history-max* 1000)

;; The reader's INCOMPLETE_INPUT error code (error_codes::INCOMPLETE_INPUT, ADR-049)
;; — an unclosed form or string, i.e. "read another line", as opposed to a genuine
;; syntax error. A stable code, so matching it is robust (no delimiter re-scanning).
(def *repl-incomplete-code* "E0002")

;; Slow-eval timing: when an interactive eval takes at least this many ms, the loop
;; prints a dim `; N ms` note after the value — feedback on what's expensive, hidden
;; for the snappy common case.
(def *repl-slow-ms* 200)

;; ---- result history + last error ---------------------------------------------
;; `*1` `*2` `*3` are the three most recent result values (newest first) and `*e` the
;; last error, exactly as at a Clojure prompt. Without them a value you didn't think
;; to name is simply gone — you retype the expression and recompute it, which for
;; anything expensive or effectful is the wrong answer.
;;
;; They are `defdyn`s because that is the ONLY door to an ambient name (ADR-151): a
;; plain `(def *1 …)` inside `(defmodule repl …)` would define `repl/*1`, while the
;; user typing `*1` at the prompt means the bare root name. `defdyn` marks it never-
;; namespaced, and — per its own docstring — a `def` of it from any module then
;; rebinds that one root binding, which is what `repl--remember-*` below do. We `def`
;; rather than `binding` on purpose: the value has to outlive the form that produced
;; it, and a dynamic binding would unwind at the end of the very eval that set it.
(defdyn *1 nil)
(defdyn *2 nil)
(defdyn *3 nil)
(defdyn *e nil)

(defn repl--remember-value (v)
  "Shift `v` into the result history (`*1` newest, `*3` oldest). Returns `v`."
  (do
    (def *3 *2)
    (def *2 *1)
    (def *1 v)
    v))

(defn repl--remember-error (e)
  "Record caught value `e` as `*e` so the prompt can inspect the last failure."
  (do (def *e e) e))

;; ---- colourised output (TTY only) -------------------------------------------
;; The printed result is re-lexed with the *same* highlighter the line editor paints
;; input with (`highlight-spans`), and each span wrapped in an ANSI colour — so a
;; returned list/map/keyword reads with the syntax colours, not as flat text. Plain
;; (uncoloured) on a non-TTY so a piped/redirected session stays clean.

(def repl--ansi-fg
  ;; the named highlight colours (highlight.blsp's faces) -> ANSI SGR foreground code
  {:red 31
   :green 32
   :yellow 33
   :blue 34
   :magenta 35
   :cyan 36
   :white 37
   :grey 90
   :dark-grey 90})

(def repl--sgr-reset "\e[0m")

(defn repl--sgr (face)
  "The opening ANSI escape for a `{:fg <named-colour> :bold ?}` face, or nil when the
face carries no colour we map (leave that span the default colour)."
  (let (code (get repl--ansi-fg (get face :fg)))
    (when code
      (str "\e[" (if (get face :bold) "1;" "") code "m"))))

(defn repl--paint-spans (src spans i)
  "Emit `src` from offset `i`, wrapping each `[start end face]` span in its ANSI colour
and leaving the gaps between spans uncoloured."
  (if (empty? spans)
    (substring src i)
    (let ([s e face] (first spans)
          painted (let (chunk (substring src s e) sgr (repl--sgr face))
                    (if sgr (str sgr chunk repl--sgr-reset) chunk)))
      (str (substring src i s) painted (repl--paint-spans src (rest spans) e)))))

(defn repl--colorize (src)
  "`src` with each lexical highlight span ANSI-coloured; unchanged when nothing
highlights. Used to colour a printed result on an interactive TTY."
  (let (spans (highlight-spans src))
    (if (empty? spans) src (repl--paint-spans src spans 0))))

;; ---- meta-commands (`,cmd` at a fresh prompt) -------------------------------
;; Guile-style `,` commands for things that aren't expressions: docs, the type of a
;; value, timing, a screen clear. `,` is unquote syntax, meaningless at top level, so
;; it's a safe prefix. Only a *known* `,cmd` is intercepted — anything else falls
;; through to the normal reader (so a real syntax error still reports normally).

(def *repl-meta-names*
  '("help" "?" "doc" "type" "time" "clear" "apropos" "search" "expand" "expand1"))

(defn repl--meta-parts (line)
  "Split a `,cmd arg…` line (sans the leading `,`) into `[cmd rest]`, `rest` trimmed."
  (let (t (trim line)
        sp (index-of t " "))
    (if (< sp 0)
      [t ""]
      [(substring t 0 sp) (trim (substring t sp))])))

(defn repl--meta? (line)
  "True when `line` is a recognised `,cmd` meta-command (a leading `,` + known name)."
  (and (> (string-length line) 0)
    (= (char-at line 0) ",")
    (let ([cmd _] (repl--meta-parts (substring line 1)))
      (any? (fn (n) (= n cmd)) *repl-meta-names*))))

(defn repl--meta-help ()
  (println (str "\e[90m"
             "  ,help ,?        this list\n"
             "  ,doc  <name>    docstring + arglist of a function/macro/primitive\n"
             "  ,type <expr>    evaluate <expr> and show its runtime type\n"
             "  ,time <expr>    evaluate <expr> and show elapsed time\n"
             "  ,clear          clear the screen\n"
             "  ,apropos <pat>  globals whose NAME contains <pat>\n"
             "  ,search <words> globals whose name or DOC matches <words>, best first\n"
             "  ,expand <form>  fully macroexpand <form> (once: ,expand1)\n"
             "  Tab             complete the name under the cursor; again to list matches\n"
             "  *1 *2 *3        the last three result values;  *e  the last error" "\e[0m")))

(defn repl--meta-doc (name)
  "Print the docstring + arglist for `name` (a function/macro/primitive), or a note."
  (try
    (let (d (eval-string (str "(doc " name ")"))
          a (eval-string (str "(arglist " name ")")))
      (println (str "\e[36m(" name (if a (str " " (join " " (map str a))) "") ")\e[0m"))
      (println (if d (str "\e[90m" d "\e[0m") "\e[90m(no documentation)\e[0m")))
    (catch e (println (str "\e[90m(no such name: " name ")\e[0m")))))

(defn repl--meta-type (expr)
  (try
    (println (str "\e[33m" (type-of (eval-string expr)) "\e[0m"))
    (catch e (eprint (str (repl--error-message e) "\n")))))

(defn repl--meta-time (expr)
  (try
    (let (t0 (now)
          v (eval-string expr)
          ms (- (now) t0))
      (when (stdout-tty?) (println (repl--colorize (pr-str v))))
      (println (str "\e[90m; " ms " ms\e[0m")))
    (catch e (eprint (str (repl--error-message e) "\n")))))

;; `apropos` / `doc-search` have been in the prelude all along; the only thing missing
;; was a way to reach them without breaking your typing rhythm. `,apropos` searches
;; NAMES, `,search` searches DOCSTRINGS too and ranks — the two halves of "I know what
;; I want but not what it's called".

(defn repl--meta-apropos (pattern)
  "Print every global whose name contains `pattern`, one per line (dim), or a note."
  (if (= pattern "")
    (println "\e[90m(usage: ,apropos <pattern>)\e[0m")
    (let (hits (try (apropos pattern) (catch _ nil)))
      (if (empty? hits)
        (println (str "\e[90m(nothing matching " pattern ")\e[0m"))
        (fold (fn (_ s) (println (str "\e[36m" s "\e[0m"))) nil hits)))))

(defn repl--meta-search (query)
  "Print `doc-search` hits for `query` — `name` then a dim one-line doc summary."
  (if (= query "")
    (println "\e[90m(usage: ,search <words>)\e[0m")
    (let (hits (try (doc-search query) (catch _ nil)))
      (if (empty? hits)
        (println (str "\e[90m(nothing matching " query ")\e[0m"))
        (fold (fn (_ [name doc])
                (println (str "\e[36m" name "\e[0m  \e[90m" (repl--first-line doc) "\e[0m")))
          nil hits)))))

(defn repl--first-line (s)
  "The first line of `s`, truncated to a terminal-ish width — a docstring's summary
line, so a multi-paragraph doc doesn't turn one search hit into a screenful."
  (let (line (first (string-split (or s "") "\n"))
        max 96)
    (if (> (string-length line) max) (str (substring line 0 max) "…") line)))

(defn repl--meta-expand (expr all)
  "Print `expr` macroexpanded — fully when `all`, one step otherwise — syntax-coloured
and run through the formatter, since an expansion is exactly the kind of dense nested
form that is unreadable on one line."
  (if (= expr "")
    (println "\e[90m(usage: ,expand <form>)\e[0m")
    (try
      (let (form (read-first expr)
            out (if all (macroexpand form) (macroexpand-1 form))
            ;; `format` is required lazily — pretty-printing an expansion is worth a
            ;; module load the first time you ask, but not on every REPL boot.
            text (try
                   (do (require 'format) (trim (format/format-source (pr-str out))))
                   (catch _ (pr-str out))))
        (println (if (stdout-tty?) (repl--colorize text) text)))
      (catch e (eprint (str (repl--error-message e) "\n"))))))

(defn repl--run-meta (line)
  "Dispatch a `,cmd` meta-command line (verified by `repl--meta?`). Returns nil; the
loop just continues to the next prompt."
  (let ([cmd rest] (repl--meta-parts (substring line 1)))
    (cond
      (or (= cmd "help") (= cmd "?")) (repl--meta-help)
      (= cmd "doc") (repl--meta-doc rest)
      (= cmd "type") (repl--meta-type rest)
      (= cmd "time") (repl--meta-time rest)
      (= cmd "apropos") (repl--meta-apropos rest)
      (= cmd "search") (repl--meta-search rest)
      (= cmd "expand") (repl--meta-expand rest true)
      (= cmd "expand1") (repl--meta-expand rest false)
      (= cmd "clear") (print "\e[2J\e[H"))))

;; ---- whitespace / comment skip ----------------------------------------------

(defn repl--content? (s i n in-com)
  "True if `s` holds an actual datum — i.e. some character that isn't whitespace
or part of a `;`-comment. Lets the loop ignore blank / comment-only lines at a
fresh prompt without echoing `nil`."
  (if (>= i n)
    false
    (let (c (char-at s i) j (inc i))
      (cond
        in-com (repl--content? s j n (not (= c "\n")))
        (= c ";") (repl--content? s j n true)
        (blank? c) (repl--content? s j n false)
        else true))))

;; ---- evaluation -------------------------------------------------------------

(defn repl--incomplete? (e)
  "True when caught value `e` is the reader's *incomplete input* error (EOF inside
a form or string) — the signal to read another line. Matches the stable error
code rather than re-scanning delimiters (ADR-049)."
  (and (map? e) (= (get e :code) *repl-incomplete-code*)))

(defn repl--trace-lines (tr)
  "Render an error map's :trace entries as `  at fn (file:line:col)` lines,
innermost frame first (each location is the call site that entered the frame)."
  (join ""
    (map (fn (f)
           (str "\n  at "
             (or (get f :fn) "<fn>")
             (cond
               (contains? f :line) (str " ("
                                     (if (contains? f :file) (str (get f :file) ":") "")
                                     (get f :line) ":" (get f :col) ")")
               (contains? f :file) (str " (" (get f :file) ")")
               else "")))
      tr)))

(defn repl--error-message (e)
  "Render a caught value for display: built-in errors arrive as a structured map
`{:kind :message [:line :col] [:trace …] …}`, a user `throw` arrives as the raw
value."
  (if (and (map? e) (contains? e :message))
    (str (if (contains? e :kind) (str (name (get e :kind)) " error") "error")
      ": " (get e :message)
      (if (contains? e :line)
        (str " (line " (get e :line) ", col " (get e :col) ")")
        "")
      (if (contains? e :trace) (repl--trace-lines (get e :trace)) ""))
    (str "error: " (if (string? e) e (pr-str e)))))

(defn repl--print-value (v)
  "Print a result value — syntax-coloured (the input highlighter, reused) on an
interactive TTY, plain on a pipe.

Printed with `pr-str-bounded`, so a huge or deeply-nested result elides with `…`
instead of scrolling the session away; `(pr-str *1)` still shows the whole thing,
and `(binding (*print-length* nil) …)` lifts the bound for a form."
  (let (s (pr-str-bounded v))
    (println (if (stdout-tty?) (repl--colorize s) s))))

(defn repl--eval-print (src)
  "Evaluate `src` in the running image. Returns `:ok` after printing its (coloured)
value — plus a dim `; N ms` note when the eval was slow — `:more` if `src` is an
incomplete form (read another line), or `:error` after reporting a real error. Never
lets an error escape the loop."
  (try
    (let (t0 (now)
          v (eval-string src)
          ms (- (now) t0))
      (repl--remember-value v)
      (repl--print-value v)
      (when (and (stdout-tty?) (>= ms *repl-slow-ms*))
        (println (str "\e[90m; " ms " ms\e[0m")))
      :ok)
    (catch e
      ;; An incomplete form is not a failure — it's "read another line" — so it must
      ;; NOT land in `*e` and clobber the error the user is actually debugging.
      (if (repl--incomplete? e)
        :more
        (do
          (repl--remember-error e)
          (eprint (str (repl--error-message e) "\n"))
          :error)))))

;; ---- interruptible evaluation ------------------------------------------------
;; Ctrl-C during a long evaluation used to terminate the runtime: the default SIGINT
;; disposition, arriving while the terminal is out of raw mode (the editor only holds
;; raw mode for the *read*). So the price of stopping one runaway expression was the
;; entire live image — every definition and every spawned process. In a language whose
;; whole premise is a long-lived redefinable image, that is the worst possible trade.
;;
;; The fix uses machinery that already existed rather than adding an interrupt path to
;; the evaluator: run each eval in its own **green process**, and `(exit pid :kill)` it
;; — the untrappable hard kill, honoured at the target's next reduction tick. The
;; kernel contributes only the signal seam it must (`%install-interrupt-handler` /
;; `%interrupt-taken?`, ADR-006: signals are mechanism), and everything else is here.
;;
;; Why this needs no evaluator changes *here*: the parent parks in `receive`, so the
;; scheduler is free to run the child, and the *scheduler* is what enforces the kill.
;; Nothing has to poll a flag inside `eval`. (It did need one kernel fix to work at
;; all: a process spinning inside a nested `eval`/`eval-string` never honoured the
;; hard kill, because the non-capturing eval paths' reduction tick was pure
;; accounting — `tick_reporting_hard_kill` in `process/scheduler.rs` closed that,
;; measured at ~4ms kill latency even on a JIT'd loop. The same fix is what makes
;; supervisors able to kill a stuck code-evaluating child, so it stands on its own.)
;;
;; Off-switch: `(def *repl-interruptible* false)` in `.broodrc.blsp` reverts to the
;; inline eval path with the default SIGINT disposition (Ctrl-C kills the runtime, as
;; before) — the rc runs before the handler would be installed, so the `and` in
;; `repl-run` short-circuits. A redefinable global, not an env knob, like every other
;; REPL policy here. (Setting it false *at the prompt* also reroutes to inline eval,
;; but the handler is already installed by then, so Ctrl-C during a long eval becomes
;; inert rather than fatal — prefer the rc.)
;;
;; Three details that matter:
;;  - The child does its own printing and its own `*1`/`*e` bookkeeping. `def` reaches
;;    the runtime's shared code region, so a definition made in the child is visible at
;;    the next prompt — and the result value never has to be copied between heaps.
;;  - Interactive sessions ONLY. A piped `echo … | brood` keeps the plain inline path
;;    and the default SIGINT, so scripts and pipelines die on Ctrl-C like any other Unix
;;    program; taking that over would be a nasty surprise in a shell pipeline.
;;  - A second Ctrl-C **halts**. The hard kill lands at a reduction tick, so an
;;    evaluation wedged inside a single native builtin may never take it; rather than
;;    trap the user at an unresponsive prompt, the second interrupt restores the old
;;    behaviour and exits 130. Escalation, not a dead end.

;; The user-facing knob AND the armed state, one global. It defaults true ("arm if you
;; can"); `repl-run` then resolves it to the real armed state by AND-ing in the things
;; the user can't control — an interactive session, a platform with signals — AFTER the
;; rc files load, so `(def *repl-interruptible* false)` in `.broodrc.blsp` sticks (the
;; `and` short-circuits and the handler is never installed). By the first prompt it is
;; always a plain boolean: armed or not.
(defdyn *repl-interruptible* true)

;; How long the parent parks between interrupt polls. Short enough that Ctrl-C feels
;; instant, long enough to cost nothing: the parent is parked in `receive`, so this is
;; a timer, not a spin.
(def *repl-interrupt-poll-ms* 40)

(defn repl--await-eval (child ref killed)
  "Park until the spawned evaluation `child` dies, polling for Ctrl-C. Returns `:ok`
normally, `:interrupted` when we killed it. Tail-recursive, so a long computation costs
one parked process and a timer, not a spin."
  (receive
    ([:down ^ref ^child _] (if killed
                             (do (println "\e[90m; interrupted\e[0m") :interrupted)
                             :ok))
    (after *repl-interrupt-poll-ms*
      (if (%interrupt-taken?)
        (if killed
          ;; The kill didn't land — a native builtin that never reaches a reduction
          ;; tick. Don't pretend to be interruptible; give the user their Unix Ctrl-C.
          (do
            (eprint "\n; evaluation is not yielding — halting\n")
            (%halt 130))
          (do (exit child :kill) (repl--await-eval child ref true)))
        (repl--await-eval child ref killed)))))

(defn repl--eval-interruptible (src)
  "Evaluate `src` in a spawned process so Ctrl-C can kill it without taking the image
down with it. Returns `:ok` or `:interrupted`."
  (do
    ;; Drain a stale request first. In raw mode Ctrl-C is byte 0x03 (ISIG is off) and
    ;; never signals — but the gap between reads is cooked, so a Ctrl-C there would set
    ;; the flag and otherwise abort the *next* expression the moment it started.
    (%interrupt-taken?)
    (let (child (spawn (repl--eval-print src))
          ref (monitor child))
      (repl--await-eval child ref false))))

(defn repl--eval (src)
  "Evaluate + print `src`, interruptibly when this session armed it (`repl-run` on a
TTY), else inline. The seam the loop calls."
  (if *repl-interruptible*
    (repl--eval-interruptible src)
    (repl--eval-print src)))

;; ---- history ----------------------------------------------------------------

(defn repl--history-path ()
  "The history file path: `$BROOD_HISTORY`, else `$HOME/.brood_history` (or, with no
`$HOME`, `.brood_history` in the current directory)."
  (let (override (getenv "BROOD_HISTORY"))
    (if override
      override
      (str (or (getenv "HOME") ".") "/.brood_history"))))

(defn repl--history->text (history)
  "Serialize `history` (newest first) to file text: the most recent
`*repl-history-max*` entries, oldest first, one per line. (Pure — the testable core
of `repl--save-history`.)"
  (join "\n" (reverse (take *repl-history-max* history))))

(defn repl--history<-text (text)
  "Parse history-file `text` into a history list (newest first), dropping blank
lines. (Pure — the testable core of `repl--load-history`.)"
  (reverse (filter (fn (l) (not (= l ""))) (string-split text "\n"))))

(defn repl--load-history ()
  "Load saved history (newest first) from the history file, or `()` if none / on any
read error — a missing or unreadable history file must never stop the REPL starting."
  (try
    (let (path (repl--history-path))
      (if (file-exists? path) (repl--history<-text (slurp path)) '()))
    (catch e '())))

(defn repl--save-history (history)
  "Write the most recent `*repl-history-max*` entries to the history file (oldest
first, one per line). Best-effort: a write failure is swallowed, never breaking the
loop."
  (try (spit (repl--history-path) (repl--history->text history)) (catch e nil)))

;; ---- I/O loop ---------------------------------------------------------------

(defn repl--complete? (src)
  "The Enter predicate for the multi-line line editor: true when `src` is a complete
form — or a genuine *syntax* error, which should submit so eval reports it — and false
only when the reader wants more input (the E0002 incomplete signal: insert a newline
and keep editing). So `(defn foo` opens a continuation line; a balanced form submits."
  (try
    (do (read-all src) true)
    (catch e (not (repl--incomplete? e)))))

(defn repl--submit (interactive form history)
  "Act on a submitted `form`: run a `,cmd` meta-command, skip a blank/comment-only line,
else eval + print it. Remembers it for ↑/↓ (persisted only for interactive sessions).
Returns `{:eof false :history h}`."
  (let (remember (fn ()
                   (let (h2 (editor/lineedit/lineedit-remember history form))
                     (when interactive (repl--save-history h2))
                     {:eof false :history h2})))
    (cond
      (repl--meta? form) (do (repl--run-meta form) (remember))
      (not (repl--content? form 0 (string-length form) false)) {:eof false :history history}
      else (do (repl--eval form) (remember)))))

(defn repl--read-eval-interactive (history)
  "Interactive read: the multi-line line editor reads a whole form in one session
(Enter inserts a newline while the form is incomplete, repainting every line in place
so bracket matches light up across lines), then we act on it. Ctrl-D on an empty line
ends input; Ctrl-C drops the form and re-prompts."
  (let (r (lineedit-read *repl-prompt*
            "" history {:cont-prompt *repl-cont-prompt* :complete? repl--complete?}))
    (cond
      (get r :eof) {:eof true :history history}
      (get r :cancel) {:eof false :history history}
      else (repl--submit true (get r :line) history))))

(defn repl--read-eval-piped (acc history)
  "Piped/redirected read: accumulate physical lines (no editor) until the form is
complete, echoing the prompt only when stdout is a TTY. Recurses on an incomplete form."
  (do
    (when (stdout-tty?) (print (if (= acc "") *repl-prompt* *repl-cont-prompt*)))
    (let (line (read-line))
      (cond
        (nil? line) (do
                      (when (and (not (= acc "")) (= (repl--eval-print acc) :more))
                        (eprint "error: incomplete input at end of input\n"))
                      {:eof true :history history})
        (and (= acc "") (repl--meta? line)) (do (repl--run-meta line) {:eof false :history history})
        (and (= acc "") (not (repl--content? line 0 (string-length line) false))) {:eof false
                                                                                   :history history}
        else (let (src (str acc line "\n"))
               (if (= (repl--eval-print src) :more)
                 (repl--read-eval-piped src history)
                 {:eof false :history history}))))))

(defn repl--read-eval (interactive acc history)
  "Read one form and act on it, returning `{:eof <bool> :history <list>}`. Interactive
sessions use the multi-line line editor; piped input accumulates physical lines."
  (if interactive
    (repl--read-eval-interactive history)
    (repl--read-eval-piped acc history)))

(defn repl--loop (interactive history)
  "Read-eval one form (skipping blank / comment-only input), then tail-recurse into
the next iteration. Each command's transients are reclaimed by Stage B's automatic
GC at the safepoint between iterations (this loop is a depth-1 spawned-process
body); `interactive` and `history` stay live as rooted tail-call arguments.
Returns (and the process exits) at end of input."
  (let (r (repl--read-eval interactive "" history))
    (if (get r :eof)
      (when (stdout-tty?) (print "\n"))
      (repl--loop interactive (get r :history)))))

(defn repl--await (p)
  "Block the current process until process `p` exits."
  (let (r (monitor p))
    (receive ([:down ^r ^p _] nil))))

;; ---- startup file -----------------------------------------------------------
;; Everything in this REPL is redefinable at runtime — the prompt, the keymap, the
;; completion source, every command — which was worth nothing while there was no
;; place to *put* a redefinition: each customisation died with the session. The rc
;; file is that place, and it's the payoff on ADR-048's premise rather than a new
;; feature: `(lineedit-bind :ctrl-x 'my-cmd)`, `(def *lineedit-candidates* …)`,
;; `(def *print-length* 20)` all become permanent by living in a file.
;;
;; Two files, user then project, both optional and both loaded in that order so a
;; project can override a personal default. It is deliberately NOT a manifest key:
;; this is a script, evaluated in the live image, not configuration to be parsed.
;;
;; A broken rc must never stop the REPL starting — that would be a customisation
;; that locks you out of the tool you'd fix it with — so failure prints the error
;; and carries on.

(defn repl--rc-paths ()
  "The startup files to load, in order: `$BROOD_RC` (else `$HOME/.broodrc.blsp`), then
`./.broodrc.blsp` for a project-local one. Duplicates collapse, so running the REPL
from your home directory doesn't load the same file twice."
  (let (user (or (getenv "BROOD_RC")
               (let (home (getenv "HOME")) (if home (path-join home ".broodrc.blsp") nil)))
        ;; Compared against the *absolute* local path, since `user` is absolute — a
        ;; bare "./.broodrc.blsp" would never match it and we'd load twice.
        local (try (path-join (cwd) ".broodrc.blsp") (catch _ ".broodrc.blsp")))
    (filter (fn (p) (not (nil? p)))
      (if (= user local) (list user) (list user local)))))

(defn repl--load-rc ()
  "Load each existing startup file, reporting (but surviving) a failure in one. Runs
before the banner so anything an rc prints reads as part of startup, and before the
loop spawns so its `def`s are in place for the first prompt."
  (fold (fn (_ path)
          (when (try (file-exists? path) (catch _ false))
            (try
              (load path)
              (catch e
                (eprint (str "\e[33mwarning:\e[0m " path ": " (repl--error-message e) "\n"))))))
    nil (repl--rc-paths)))

(defn repl-run ()
  "Run the read-eval-print loop on stdin until end of input (Ctrl-D). When stdin and
stdout are both a TTY it edits interactively (`std/lineedit.blsp`) with the banner +
prompts; redirected stdin keeps the plain `read-line` path (prompt echoed only when
stdout is a TTY). The loop runs in a spawned process — so Stage B's automatic GC
reclaims each command's transients at the safepoint — and this call blocks (parked
in `receive`) until that process reaches end of input. Returns nil.

Loads the startup files first (`$BROOD_RC` or `~/.broodrc.blsp`, then a project-local
`./.broodrc.blsp`); a failure in one is reported and skipped, never fatal."
  (let (interactive (and (stdin-tty?) (stdout-tty?))
        _rc (repl--load-rc)
        ;; Resolve `*repl-interruptible*` to the real armed state: the user's knob (the
        ;; rc has already run, so an opt-out short-circuits before the handler is ever
        ;; installed) AND an interactive session (a pipeline must keep the default
        ;; SIGINT — Ctrl-C on `echo … | brood` should kill it like any Unix program)
        ;; AND the platform actually installing a handler. `def` (not `binding`)
        ;; because the flag has to reach the spawned loop process.
        _armed (def *repl-interruptible*
                 (and *repl-interruptible* interactive (%install-interrupt-handler)))
        history (if interactive (repl--load-history) '()))
    (when (stdout-tty?) (eprint (str *repl-banner* "\n")))
    (repl--await (spawn (repl--loop interactive history)))
    nil))
