;; std/tool/test.blsp — a tiny test framework, written in Brood itself.
;;
;;   (describe "math"
;;     (test "adds"       (assert= (+ 1 2) 3))
;;     (test "multiplies" (assert= (* 2 3) 6) (assert-error (/ 1 0))))
;;   (run-tests)
;;
;; ExUnit / `mix test`-style: `describe` groups related cases, `test` names a
;; case with a string. `deftest` (one test named by a symbol, no group) is kept
;; for convenience and expands to `test`. See docs/testing.md for the full guide.
;;
;; ─────────────────────────────────────────────────────────────────────────────
;; EXECUTION MODEL — parallel by default, with opt-in serialisation
;; ─────────────────────────────────────────────────────────────────────────────
;; Every test runs concurrently, each in its own process (spawn/send/receive),
;; UNLESS its group opts out. Two opt-outs, given as a keyword right after the
;; group/name (a `:tags [kw …]` selection clause may accompany them, in either
;; order — see "test selection" further down):
;;
;;   (describe "fast stuff" ...)            ; default: each test runs in parallel
;;   (describe "uses a shared file" :serial ...)   ; its tests run one-at-a-time,
;;                                          ;   in a single worker, but still
;;                                          ;   alongside *other* groups
;;   (describe "mutates a global" :isolated ...)   ; runs ALONE, against a PRIVATE
;;                                          ;   copy of the globals: no other test
;;                                          ;   runs at the same time, and its
;;                                          ;   defs roll back when it finishes
;;   (test "touches global state" :isolated ...)   ; a lone isolated test
;;   (test "needs a live database" :skip ...)      ; registered, never run
;;   (describe "postgres" :skip ...)               ; skips every test in the group
;;
;; Why this matters here: a runtime's processes SHARE one global table (see
;; docs/shared-code.md), so two parallel tests that both redefine the same global
;; would race. Mark such a group `:serial` (serialise within the group) or
;; `:isolated` (run alone AND with a rolled-back private copy of the globals, so a
;; test's definitions can't leak to any other test). Tests that only read the
;; prelude and their own locals are safe to run in parallel — the default.
;;
;; Phases: the :isolated units run FIRST — one at a time on the runner itself,
;; each under `%isolate` (a private copy of the globals) — so each sees the clean
;; post-load baseline and nothing it defs survives. THEN all :parallel and :serial
;; units are spawned and run together.
;;
;; ─────────────────────────────────────────────────────────────────────────────
;; SHARE-SAFE TALLYING
;; ─────────────────────────────────────────────────────────────────────────────
;; Because processes share the global table, tests must NOT tally into shared
;; mutable globals (concurrent tests would clobber one another). Instead each test
;; collects its own failures into a PROCESS-LOCAL accumulator — `*fails*`, a `let`
;; binding the `test` macro establishes — and yields them as a value; the runner
;; aggregates results from returns / messages into its own local state. No shared
;; counters, no races. (Assertions are macros that push onto `*fails*`, so use
;; them lexically inside a test body, not from unrelated top-level helpers.)
;;
;; run-tests prints, once at the end, a structured `FILE:LINE:COL:` block per
;; failed assertion (the one format for humans, LLMs and editors — see
;; docs/tooling.md), then a one-line summary with timing and memory. It raises an
;; error if anything failed (non-zero exit — how `cargo test` notices). Flags are
;; documented on `test-apply-opts` below (`:slow`/`:slowest`, `:timeout`,
;; `:trace`, `:filter`, `:max-failures`, `:repeat`).

;; --- registry ----------------------------------------------------------------
;; Built once, at load time, on the main process — so touching these globals here
;; is single-threaded and safe; workers never touch them.
;;
;; A *unit* is the thing scheduled together: (mode group tests), where mode is
;; :parallel | :serial | :isolated and tests is a list of (name thunk meta) —
;; `meta` being `{:tags :file :line}`, which the selection layer below filters on.
;; A thunk runs one test body and returns its list of failure-message strings
;; (empty = passed). A default `describe` emits one :parallel unit PER test (max
;; parallelism); a :serial/:isolated `describe` emits ONE unit holding all its
;; tests (so they run in sequence, in a single process).
(defmodule test
  "A tiny ExUnit-style test framework, written in Brood. `describe` groups related
cases and `test` names one; cases run concurrently by default, with `:serial` /
`:isolated` opt-outs. `run-tests` runs the registered suite once. See
docs/testing.md for the full guide.")

(defdyn *units* nil)
; all registered units, newest first
(def *collecting* false)
; true while a describe body is being registered
(def *collected* nil)
; (name thunk) pairs gathered for the current describe

(defn- add-unit! (mode group tests) (def *units* (cons (list mode group tests) *units*)))

;; Empty the registry. A `describe`/`test` form REGISTERS by consing onto
;; `*units*`; in a fresh process that starts at nil, so a one-shot `nest test`
;; never double-counts. But a long-lived image (the `nest mcp` session, ADR-013)
;; that `load`s the same test file twice would register every unit twice and
;; report inflated counts. The project test runner calls this right before it
;; (re)loads the test files, so each run owns a clean registry regardless of how
;; many times the image has loaded them before.
(defn reset-units! ()
  "Clear the test registry (drop every registered unit). The project test runner calls this before (re)loading test files so a long-lived image — e.g. a `nest mcp` hot-reload session — doesn't accumulate duplicate registrations across runs."
  (def *units* nil))

;; --- temp fixtures -----------------------------------------------------------
;; A test that needs a real directory builds one under /tmp. Two rules keep these
;; from biting each other (learned the hard way — see docs/devlog.md):
;;   1. Name it with `(temp-dir PREFIX)`, which uses `rand/token` — unique
;;      across processes *and* runs. NOT `gensym`, whose counter resets every
;;      process, so its names recur and a leftover from a prior run contaminates
;;      the next test that draws the same number.
;;   2. Purge prior runs' leftovers at file LOAD with `(purge-stale-temp PREFIX)`,
;;      *before* any test creates a fixture — so it never races a live one and a
;;      crashed run can't accumulate forever. `file/rmdir` removes a tree.
(defn temp-dir (prefix)
  "A fresh, unique /tmp path `<prefix><random>` (NOT created — `file/mkdir` it). Unique across processes and runs, so concurrent tests never collide. Prelude's `temp-path` under a test-shaped name."
  (path/temp prefix))

(defn purge-stale-temp (prefix)
  "Best-effort remove every `/tmp/<prefix>*` left by an earlier run — a directory tree *or* a plain file (a fixture may be either). Call once at FILE LOAD (a top-level form), before any test creates fixtures, so it never deletes a live one. Bounds /tmp growth to a single run and recovers from crashed runs."
  (doseq (e (file/ls "/tmp"))
    (when (string/starts-with? e prefix)
      (let (p (path/join "/tmp" e))
        (if (file/dir? p) (file/rmdir p) (file/rm p))))))

;; Full source location of a form as (file line col), or nil. Captured at
;; macro-expansion time (by the assertion macros), while the original read form
;; still carries its position — `current-file` / `form-pos` are Rust primitives
;; (docs/tooling.md). Each failing assertion is thus self-locating, which is what
;; lets the reporter emit a clickable `FILE:LINE:COL:` anchor per failure.
(defn- fail-loc
  (form)
  (let (p (reflect/form-pos form))
    ; [line col] vector, or nil
    (if p (list (reflect/current-file) (seq/vector-ref p 0) (seq/vector-ref p 1)) nil)))

;; A failing assertion THROWS a tagged failure record rather than mutating shared
;; state — Brood data is immutable (no accumulator to push onto). The tag is a
;; `%`-internal keyword the body is exceedingly unlikely to throw itself. `loc` is
;; (file line col) or nil; `details` is a list of "label: value" strings.
;; test-record turns a caught throw back into the (loc detail-lines) record the
;; runner expects.
(defn- test-fail (loc details) (throw (list :%test-fail loc details)))
(defn- test-failure? (e) (and (pair? e) (= (first e) :%test-fail)))
(defn- test-record (e) (list (second e) (seq/third e)))

;; Run a test body that has been split into one thunk PER top-level form, in
;; order, each in its own `try` — so failures across the body's forms are all
;; collected, not just the first (a throw ends only its own form, then we move on).
;; A non-assertion (uncaught) error is recorded and STOPS the test, since later
;; forms may depend on the one that broke. Returns the failure list (empty = pass).
(defn- test-run
  (thunks fails)
  (if (empty? thunks)
    (reverse fails)
    (let (outcome (try (do ((first thunks)) :%ok) (catch e (list :%caught e))))
      (cond
        (= outcome :%ok) (test-run (rest thunks) fails)
        (test-failure? (second outcome))
          (test-run (rest thunks)
            (cons (test-record (second outcome)) fails))
        else (reverse (cons (list nil (list (str "uncaught error: " (second outcome)))) fails))))))

;; --- modifiers, tags, and per-test metadata ----------------------------------
;; A `describe`/`test` header may carry modifiers before its body, in any order:
;;
;;   (describe "db writes" :serial :tags [:db :slow] ...)
;;   (test "reconnects" :isolated :tags [:flaky] ...)
;;
;; `:serial`/`:isolated` pick the execution mode (as before); `:tags [kw …]`
;; attaches tags, which `nest test --only/--exclude/--include` select on (the
;; ExUnit `@tag` analogue). Returns `(mode tags body)`.
(defn- test-split-mods
  (forms mode tags)
  (test-split-mods-acc forms mode tags false))

;; `:skip` rides along as a fourth piece of state: a skipped test still REGISTERS
;; (so it is counted and reported, rather than vanishing) but its body is never
;; called. That is the point of a skip over deleting or commenting out the test —
;; it stays visible in the run.
(defn- test-split-mods-acc
  (forms mode tags skip)
  (cond
    (empty? forms) (list mode tags forms skip)
    (= (first forms) :isolated) (test-split-mods-acc (rest forms) :isolated tags skip)
    (= (first forms) :serial) (test-split-mods-acc (rest forms) :serial tags skip)
    (= (first forms) :skip) (test-split-mods-acc (rest forms) mode tags true)
    (= (first forms) :tags) (test-split-mods-acc (rest (rest forms)) mode (second forms) skip)
    else (list mode tags forms skip)))

;; Per-test metadata: its tags plus where it was declared. The location comes
;; from the first body form's read position (captured at macro-expansion time,
;; like `fail-loc`), which is what makes `nest test FILE:LINE` able to pick out
;; one test — so a test whose body is a bare literal (no recorded position) is
;; still runnable, just not addressable by line.
(defn- test-meta
  (tags loc skip)
  {:tags (or tags [])
   :file (if loc (first loc) nil)
   :line (if loc (second loc) nil)
   :skip (or skip false)})

(defn- test-tags (t) (let (m (seq/third t)) (if (nil? m) [] (or (get m :tags) []))))
(defn- test-file (t) (let (m (seq/third t)) (if (nil? m) nil (get m :file))))
(defn- test-line (t) (let (m (seq/third t)) (if (nil? m) nil (get m :line))))
(defn- test-skip? (t) (let (m (seq/third t)) (and (not (nil? m)) (= (get m :skip) true))))

;; Merge a `describe`'s group-level tags into one collected test's own tags. A
;; test carries the union, so `--only db` picks up a test tagged only at the
;; group level (ExUnit's `@moduletag`/`describe` tag inheritance).
;; A group-level `:skip` marks every test in it; a test-level one already set its own.
(defn- test-mark-skip
  (t group-skip)
  (if (not group-skip) t (list (first t) (second t) (assoc (or (seq/third t) {}) :skip true))))

(defn- test-add-tags
  (t group-tags)
  (if (empty? (or group-tags []))
    t
    (list (first t)
      (second t)
      (assoc (or (seq/third t) {}) :tags (append (into [] group-tags) (into [] (test-tags t)))))))

;; A test registers itself: collected into the enclosing describe if there is
;; one, otherwise emitted as its own standalone unit (:isolated if flagged).
(defn register-test! (name thunk isolated? meta)
  "Register one test. Inside a `describe` it is collected into that group's `*collected*` (carrying its `:isolated` flag in the meta); otherwise it is emitted immediately as its own standalone unit — `:isolated` if flagged, else `:parallel`."
  (if *collecting*
    ;; Inside a `describe`, a test-level `:isolated` used to be DROPPED here — the group's
    ;; mode decided and the marker did nothing, silently. That is worse than not supporting
    ;; it: you mark a test isolated, the suite reports `0 isolated`, and you believe the test
    ;; is protected. It rides in the meta now, and `emit-describe!` gives such a test its own
    ;; isolated unit. (Found 2026-08-05 while fixing a concurrency flake with the marker.)
    (def *collected*
      (cons (list name thunk (assoc (or meta {}) :isolated isolated?))
        *collected*))
    (add-unit! (if isolated? :isolated :parallel) "" (list (list name thunk meta)))))

;; Was this test marked `:isolated` individually (inside a `describe`)?
(defn- test-isolated? (t) (let (m (seq/third t)) (and (not (nil? m)) (= (get m :isolated) true))))

;; Turn a finished describe's collected tests into units according to its mode:
;; default spreads them across one :parallel unit each; :serial/:isolated keep
;; them together in a single unit.
(defn- emit-describe!
  (mode group tests group-tags group-skip)
  (let (tagged (map (fn (t) (test-mark-skip (test-add-tags t group-tags) group-skip)) tests)
        ;; A test marked `:isolated` on its own gets its own isolated unit even in a
        ;; parallel group — that is what the marker says, and honouring it per test avoids
        ;; serialising the other N-1 tests of the group to protect one.
        solo (filter test-isolated? tagged)
        rest (filter (fn (t) (not (test-isolated? t))) tagged))
    (fold (fn (_ t) (add-unit! :isolated group (list t))) nil solo)
    (if (empty? rest)
      nil
      (if (= mode :parallel)
        (fold (fn (_ t) (add-unit! :parallel group (list t))) nil rest)
        (add-unit! mode group rest)))))

;; Does a form (or anything nested within it) carry a `(test …)`/`(deftest …)`/
;; `(describe …)`? Scans RECURSIVELY, so tests wrapped in a `let`/`do`/`when` — the
;; common `(describe … (let (a …) (test …) …))` shape — are still seen. A nested
;; `(describe …)` short-circuits at its head (its own tests count for the outer group).
(defn- form-contains-test?
  (form)
  (and (pair? form)
    (or (includes? (list 'test 'deftest 'describe) (first form))
      (any? form-contains-test? (rest form)))))

;; Does a describe body carry any tests? Checked SYNTACTICALLY at expansion (the
;; runtime `*collected*` sees only direct tests, ADR-225), recursing through wrapper
;; forms so a `let`/`do`-wrapped test is not mistaken for empty. An empty describe is
;; a mistake — a heading with nothing under it — so `describe` warns when this is false.
(defn- describe-body-has-tests?
  (body)
  (any? form-contains-test? body))

(defmacro describe (group & forms)
  "Register a group of tests: `(describe \"name\" [:serial | :isolated] [:tags [kw …]] body...)`. Tests run in parallel by default; `:serial` runs them sequentially in one process, `:isolated` each against a private copy of the globals. `:tags` attaches tags to every test in the group, which `nest test --only/--exclude/--include` select on. Warns (advisory) if the group contains no tests."
  (if (keyword? group)
    (error "describe: group name must be a string, not keyword "
      (pr-str group)
      " — did you mean (describe \""
      (pr-str group)
      "\" ...) or did you accidentally omit the group name?")
    (let (parts (test-split-mods forms :parallel nil)
          mode (first parts)
          tags (second parts)
          body (seq/third parts)
          skip (nth parts 3))
      `(do
         (def *collecting* true)
         (def *collected* nil)
         (do ~@body)
         ; the (test ...) forms collect themselves
         (def *collecting* false)
         (emit-describe! ~mode ~group (reverse *collected*) ~tags ~skip)
         ;; Advisory: a describe with no tests is a heading over nothing (ADR-225).
         ~(unless (describe-body-has-tests? body)
            (list 'io/puts
              (str "warning: describe " (pr-str group) " has no tests")
              :to '*err*))
         nil))))

;; (test "name" [:isolated] body...) — register one test. Each top-level body form
;; becomes its own thunk; `test-run` runs them in order, each in its own `try`,
;; collecting a failure record from every form whose assertion fails (so a test
;; can report several failures). A non-assertion error is recorded and stops the
;; test, so a crashing test can't hang the runner (a dead worker never sends, and
;; `receive` would block forever). The thunk returns the failure list (empty = pass).
(defmacro test (name & forms)
  "Register one test: `(test \"name\" [:isolated] [:tags [kw …]] body...)`. Each body form is checked independently, so one test can report several assertion failures. `:tags` attaches tags for `nest test --only/--exclude/--include`."
  (let (parts (test-split-mods forms :parallel nil)
        iso (= (first parts) :isolated)
        tags (second parts)
        body (seq/third parts)
        skip (nth parts 3)
        loc (fail-loc (first body))
        thunks (map (fn (f) (list 'fn nil f)) body))
    ; each form -> (fn () form)
    `(register-test! ~name
       (fn () (test-run (list ~@thunks) nil))
       ~iso
       (test-meta ~tags (quote ~loc) ~skip))))

(defmacro deftest (name & body)
  "Register a single test named by the (symbol) `name`, outside any `describe` group."
  `(test (str (quote ~name)) ~@body))

;; --- assertions --------------------------------------------------------------
;; Macros, not functions: on failure each THROWS a tagged failure record (via
;; `test-fail`); on success they do nothing. They evaluate their operands once.
;; A throw ends the *body form* it's in, not the whole test — `test-run` runs each
;; top-level form separately, so a test collects a failure from every form that
;; fails (several failures per test). Multiple assertions nested inside ONE form
;; stop at the first. Each failure carries its own source location.
;; Each assertion reports the FAILING SOURCE EXPRESSION (quoted at macro time) and
;; the actual value — so a failure line is self-identifying: you (or an LLM reading
;; the captured run) see exactly which expression failed and what it produced,
;; without opening the file or guessing among look-alike assertions.
;; A failure record is (loc detail-lines): `loc` is (file line col) or nil, and
;; `detail-lines` is a list of "label: value" strings. The reporter turns each
;; into a clickable anchor line plus its indented fields (docs/tooling.md).
(defmacro is (expr)
  "Assert that `expr` is truthy; on failure record the source expression and its actual value."
  (let (v (gensym "v") loc (fail-loc expr))
    `(let (~v ~expr)
       (unless ~v
         (test-fail (quote ~loc)
           (list (str "assert: " (pr-str (quote (is ~expr)))) (str "actual: " (pr-str ~v))))))))

(defmacro refute (expr)
  "Assert that `expr` is falsy — the negation of `is`."
  (let (v (gensym "v") loc (fail-loc expr))
    `(let (~v ~expr)
       (when ~v
         (test-fail (quote ~loc)
           (list (str "assert: " (pr-str (quote (refute ~expr))))
             (str "actual: " (pr-str ~v) "  (expected falsy)")))))))

(defmacro assert= (actual expected)
  "Assert that `actual` is structurally equal to `expected`; on failure record both values."
  (let (a (gensym "a") b (gensym "b") loc (fail-loc actual))
    `(let (~a ~actual ~b ~expected)
       (unless (= ~a ~b)
         (test-fail (quote ~loc)
           (list (str "assert: " (pr-str (quote (assert= ~actual ~expected))))
             (str "actual: " (pr-str ~a))
             (str "expect: " (pr-str ~b))))))))

(defn concurrently (n f)
  "Run `(f i)` for `i` in 0..n-1, each in its OWN process, and block until all `n` have
finished. Returns a list of their results, in completion order (NOT index order — assert on
the set, or have `f` return a pair carrying its index).

For testing anything that must hold when several processes hit it at once: a shared registry,
a counter, a table, a supervisor. Prefer this to hoping the suite's own parallelism happens to
interleave the right way — a deterministic N-process test catches a lost update on the first
run, where a race that only shows under machine load is a ~1-in-5 flake nobody can debug (see
KI-22, which cost three sessions before it was cornered by a test shaped like this).

`f` runs in the child, so it may close over whatever it likes; the parent pid is captured HERE
rather than inside the spawn body. That detail is the whole reason this exists as a helper:
`(spawn (worker (self)))` evaluates `(self)` in the CHILD, so every worker messages itself and
the collector silently waits for messages that never arrive — a mistake already made twice in
this repo's own stress harnesses.

Each result is collected with the suite's per-test timeout in force, so a wedged worker fails
the test rather than hanging the run."
  (let (parent (self)
        tag (ref))
    (concurrently-spawn 0 n f parent tag)
    (concurrently-collect n tag nil)))

(defn- concurrently-spawn
  (i n f parent tag)
  (when (< i n)
    (spawn (send parent [:concurrently tag (f i)]))
    (concurrently-spawn (+ i 1) n f parent tag)))

;; The `tag` is a fresh `ref` minted by `concurrently`, so a stray message from an unrelated
;; process can never be mistaken for a worker's result — and pinning it lets the receive-mark
;; (ADR-195) skip any unrelated backlog instead of walking it per result.
(defn- concurrently-collect
  (k tag acc)
  (if (= k 0)
    acc
    (concurrently-collect (- k 1)
      tag
      (cons (receive
              ([:concurrently ^tag v] v)
              (after *test-timeout-ms*
                (test-fail nil
                  (list (str "concurrently: a worker did not finish within "
                          *test-timeout-ms* "ms")))))
        acc))))

(defmacro assert-error (& body)
  "Assert that evaluating `body` raises an error; fails if it completes normally."
  ;; Quote the body for the message: the lone form if there's one, else (do …).
  (let (form (if (= (count body) 1) (first body) (cons 'do body))
        loc (fail-loc (if (= (count body) 1) (first body) nil)))
    `(unless (try (do ~@body false) (catch e true))
       (test-fail (quote ~loc)
         (list (str "assert: " (pr-str (quote (assert-error ~form)))) "actual: no error was raised")))))

;; Pair it with assert= to pin exact failure output:
;;   (assert= (error-of (/ 1 0)) "runtime error: division by zero")
(defn- error-of-render
  (e)
  ;; Built-in errors come through `catch` as a structured map (`{:kind :code
  ;; :message :hint}`); flatten to the legacy "kind error: message" string so
  ;; tests can pin exact text. A `(throw v)` lands here as the raw value `v` —
  ;; pass it through unchanged (matches the macro's stated contract).
  (cond
    (map? e) (str (name (get e :kind)) " error: " (get e :message))
    else e))
(defmacro error-of (& body)
  "Evaluate `body` and return the error it raised — a built-in error as its `\"kind error: message\"` string, a `(throw v)` as the value `v` — or nil if `body` completes without raising."
  `(try (do ~@body nil) (catch e (error-of-render e))))

;; --- property-based testing (over the seedable PRNG) -------------------------
;; `(check-property n gen pred)` draws `n` values from `gen` (a `seed -> [value
;; next-seed]` function, e.g. built on `rand/int`/`shuffle`/`sample`) and asserts
;; `(pred value)` for each. Deterministic (fixed start seed) so a failure
;; reproduces; on the first counterexample it fails the test with the value, the
;; trial number, and the seed that produced it. A loop tested by random sampling
;; catches edge cases a single hand-written example misses.
(defn- check-property-loop
  (n gen pred loc seed i)
  (if (>= i n)
    ; all trials held
    nil
    (let ([val nxt] (gen seed))
      (if (pred val)
        (check-property-loop n gen pred loc nxt (inc i))
        (test-fail loc
          (list (str "property failed on trial " (inc i) "/" n)
            (str "counterexample: " (pr-str val))
            (str "reproduce with seed: " seed)))))))

(defmacro check-property (n gen pred)
  "Property test: run `n` trials, each drawing a value with `gen` (a `seed -> [value next-seed]` function over the PRNG) and asserting `(pred value)`. Deterministic; on the first counterexample fails with the value, trial, and seed. e.g. `(check-property 100 (fn (s) (rand/int s 1000)) (fn (x) (>= x 0)))`."
  (let (loc (fail-loc pred))
    `(check-property-loop ~n ~gen ~pred (quote ~loc) 1 0)))

;; --- small text/list helpers for the trace and slow-test output --------------
(defn opt? (flag opts)
  "True if the boolean flag `flag` is present anywhere in the `run-tests` option list `opts` (e.g. `:trace`)."
  ; is flag present in the run-tests args?
  (cond (empty? opts) false (= flag (first opts)) true else (opt? flag (rest opts))))

(defn opt-val (key opts default)
  "The value following `key` in the `run-tests` option list `opts` (e.g. `5000` for `:timeout 5000`), or `default` when `key` is absent."
  ; the value following `key` in the run-tests args (e.g. `:timeout 5000`), or default.
  (cond
    (empty? opts) default
    (= key (first opts)) (second opts)
    else (opt-val key (rest opts) default)))

;; (`pad-left` / `pad-right` are the prelude's, like `take` / `quot` — all formerly
;; redefined here, which clobbered the shared global with a worse version (the local
;; `spaces` helper was non-tail-recursive; `take` was non-tail), since the runtime
;; shares one global table across all loaded modules, so `require`-ing test would
;; re-bind them for the whole image. Use the prelude's stack-safe versions.)

;; Insertion sort of [name ms] pairs, slowest first. O(n²), but there are only
;; ever a handful of tests, so simplicity wins.
(defn- insert-by-ms
  (x sorted)
  ;; Tail-recursive: accumulate the (reversed) smaller-ms prefix and splice `x`
  ;; once, so ordering a large suite by duration can't overflow the stack.
  (letrec (go (fn (acc xs)
                (cond
                  (empty? xs) (reverse-onto acc (list x))
                  (>= (second x) (second (first xs))) (reverse-onto acc (cons x xs))
                  else (go (cons (first xs) acc) (rest xs)))))
    (go nil sorted)))
(defn- sort-by-ms (xs) (fold (fn (acc x) (insert-by-ms x acc)) nil xs))

;; A "N.N MB" formatter for the memory line (`quot` is the prelude's).
(defn- mb-str
  (bytes)
  (let (tenths (quot (+ (* bytes 10) 524288) 1048576)
        ; round to nearest 0.1 MB
        whole (quot tenths 10)
        frac (rem tenths 10))
    (str whole "." frac " MB")))

;; --- results -----------------------------------------------------------------
;; A result is (group name fails ms): `fails` is the list of failure records for
;; that test (empty = passed). A failure record is (loc detail-lines); `loc` is
;; (file line col) or nil, captured per-assertion (see `fail-loc`).
(defn r-group (r)
  "The group (describe) name of a result tuple `(group name fails ms …)`, or \"\" when ungrouped."
  (first r))
(defn r-name (r) "The test name of a result tuple `(group name fails ms …)`." (second r))
(defn r-fails (r)
  "The list of failure records for a result — empty means the test passed. Each record is `(loc detail-lines)`."
  (seq/third r))
(defn- r-ms (r) (nth r 3))
(defn r-failed? (r)
  "True if the result has at least one failed assertion (a non-empty `r-fails`)."
  (not (empty? (r-fails r))))
;; Read defensively: results synthesised elsewhere (a dead or timed-out worker) are
;; 4-element tuples, and those are never skips.
(defn r-skipped? (r)
  "True if the result is a skipped test — its 5th field is `true`. Read defensively: a 4-element result (a dead or timed-out worker) is never a skip."
  (and (> (count r) 4) (= (nth r 4) true)))
;; Where the test was declared, as `file:line`, or "" when the position wasn't
;; recorded (a body whose first form is a bare literal carries no position).
(defn r-where (r)
  "Where the test was declared, as `file:line` (the result's 6th field), or \"\" when no position was recorded."
  (if (> (count r) 5) (or (nth r 5) "") ""))
(defn label (group name)
  "Join a group and test name into one display label — `\"group › name\"`, or just `name` when `group` is \"\" (ungrouped)."
  ; "group › name", or just name if ungrouped
  (if (= group "") (str name) (str group " › " name)))
(defn- full-name (r) (label (r-group r) (r-name r)))

;; --- test selection (--only / --exclude / --include / FILE:LINE / shards) -----
;; A *filter spec* is a map; nil means "run everything" (the default, and the only
;; shape `run-tests` ever saw before selection existed):
;;
;;   {:only     (["db" ""] ["test" "adds"])   ; positive: run ONLY matches
;;    :exclude  (["slow" ""])                 ; negative: drop matches
;;    :include  (["slow" ""])                 ; re-admit something :exclude dropped
;;    :lines    (["tests/a_test.blsp" 42])    ; FILE:LINE — the covering test
;;    :names    ("math › adds")}              ; exact full labels (backs --failed)
;;
;; A *selector* is `[key value]`: `test`/`describe` match a substring of the test
;; name / group label, anything else is a tag name. Mirrors `mix test --only
;; tag`, `--only test:"name"`, `--only describe:"group"`.
(defn- test-parse-selector
  (selector-string)
  "Parse an `--only`/`--exclude`/`--include` selector into `[key value]` — `tag`, `tag:value`, `test:substring`, or `describe:substring`."
  (let (i (index-of selector-string ":"))
    (if (< i 0)
      [selector-string ""]
      [(string/substring selector-string 0 i)
        (string/substring selector-string
          (+ i 1)
          (string/length selector-string))])))

;; Build a filter spec from the raw strings a CLI hands over. Parsing lives here
;; rather than in `nest`, so the selector grammar has one definition and the Rust
;; side only forwards argv. `nil`/empty arguments mean "no constraint".
(defn- test-make-filter
  (only exclude include lines names seed shards shard)
  "Assemble a `nest test` filter spec from raw CLI values: `only`/`exclude`/`include` are selector strings (`tag`, `test:substr`, `describe:substr`), `lines` a list of `[file line]`, `names` exact full labels, `seed` a shuffle seed, and `shards`/`shard` a CI split."
  {:only (map test-parse-selector (or only (list)))
   :exclude (map test-parse-selector (or exclude (list)))
   :include (map test-parse-selector (or include (list)))
   :lines (or lines (list))
   :names names
   :seed seed
   :shards shards
   :shard (or shard 0)})

(defn- test-has-tag?
  (tags key-string)
  (fold (fn (found tag) (or found (= (name tag) key-string))) false (into [] tags)))

;; Is `needle` a trailing suffix of `path` on a PATH-COMPONENT boundary? The
;; boundary check is what stops `a_test.blsp` from matching `extra_test.blsp` —
;; a plain `ends-with?` says yes to that, so `nest test a_test.blsp:5` could
;; select a test in a completely different file.
(defn- test-path-suffix?
  (path needle)
  (and (string/ends-with? path needle)
    (let (cut (- (string/length path) (string/length needle)))
      (or (= cut 0) (= (string/substring path (- cut 1) cut) "/")))))

;; Two paths may name the same file (the CLI gets what the user typed; the meta
;; carries what `current-file` recorded), so match on a path-suffix relationship
;; rather than demanding string equality.
(defn- test-same-file?
  (a b)
  (and (not (nil? a))
    (not (nil? b))
    (or (= a b) (test-path-suffix? a b) (test-path-suffix? b a))))

(defn- test-match-selector?
  (selector group-label test-name tags)
  (let (key (first selector)
        value (second selector))
    (cond
      (= key "test") (includes? test-name value)
      (= key "describe") (includes? group-label value)
      else (test-has-tag? tags key))))

(defn- test-match-any?
  (selectors group-label test-name tags)
  (fold (fn (found selector)
          (or found (test-match-selector? selector group-label test-name tags)))
    false
    (or selectors (list))))

;; Every registered test tuple, across units — the flat view the line resolver
;; and the shard assigner walk.
(defn- test-all-tests
  (units)
  (fold (fn (acc unit) (append acc (map (fn (t) (list (second unit) t)) (seq/third unit))))
    nil units))

;; Resolve one FILE:LINE selector to the exact declared line of the test it
;; addresses: the LAST test in that file declared at or before LINE. So pointing
;; anywhere inside a test's body (not just at its header) selects that test —
;; the `mix test path:line` behaviour. nil when the file has no test at/before it.
(defn- test-resolve-line
  (units file target)
  (fold (fn (best pair)
          (let (t (second pair)
                line (test-line t))
            (if (and (not (nil? line))
                  (test-same-file? (test-file t) file)
                  (<= line target)
                  (or (nil? best) (> line best)))
              line
              best)))
    nil
    (test-all-tests units)))

;; Resolve every FILE:LINE selector, warning about any that addresses no test —
;; a typo'd path or a line above the file's first test would otherwise just run
;; zero tests and exit 0, which in CI reads as "all green".
(defn- test-resolve-lines
  (units lines)
  (fold (fn (acc entry)
          (let (resolved (test-resolve-line units (first entry) (second entry)))
            (if (nil? resolved)
              (do
                (io/puts (str "warning: no test found at "
                           (first entry)
                           ":"
                           (second entry)
                           " — that file/line addresses nothing")
                  :to *err*)
                acc)
              (cons [(first entry) resolved] acc))))
    nil
    (or lines (list))))

(defn- test-match-line?
  (t resolved-lines)
  (fold (fn (found entry)
          (or found
            (and (test-same-file? (test-file t) (first entry))
              (= (test-line t) (second entry)))))
    false
    (or resolved-lines (list))))

(defn- test-match-name?
  (t group-label names)
  (fold (fn (found n) (or found (= n (label group-label (first t))))) false (or names (list))))

;; Does this test survive the spec? Positive constraints (`:only` / `:lines` /
;; `:names`) are a whitelist — when none are given, everything is a candidate.
;; `:exclude` then drops matches, and `:include` re-admits them (so `--include`
;; overrides `--exclude`, as in ExUnit).
;;
;; NOTE the whitelist test uses the REQUESTED `:lines`, not the resolved ones. A
;; selector that resolves to nothing (typo'd path, a line above the file's first
;; test) still constrains the run to zero tests — deriving it from the resolved
;; list instead made an unresolvable `FILE:LINE` fall through to "no constraints"
;; and run the ENTIRE suite, which in CI is indistinguishable from success.
(defn- test-select?
  (group-label t spec resolved-lines)
  (let (test-name (first t)
        tags (test-tags t)
        only (get spec :only)
        names (get spec :names)
        positive? (or (not (empty? (or only (list))))
                    (not (empty? (or (get spec :lines) (list))))
                    (not (empty? (or names (list))))))
    (and (or (not positive?)
           (test-match-any? only group-label test-name tags)
           (test-match-line? t resolved-lines)
           (test-match-name? t group-label names))
      (not (and (test-match-any? (get spec :exclude) group-label test-name tags)
             (not (test-match-any? (get spec :include) group-label test-name tags)))))))

;; Apply a filter spec to the unit list, dropping units left with no tests.
(defn- test-filter-units
  (units spec)
  (if (nil? spec)
    units
    (let (resolved (test-resolve-lines units (get spec :lines)))
      (filter (fn (unit) (not (empty? (seq/third unit))))
        (map (fn (unit)
               (list (first unit)
                 (second unit)
                 (filter (fn (t) (test-select? (second unit) t spec resolved)) (seq/third unit))))
          units)))))

;; A stable hash of a test's full label — FNV-1a over its codepoints, masked to
;; 32 bits, then avalanched. Deterministic across machines and runs (no address
;; or iteration-order input), which is what CI sharding needs: every shard must
;; agree on the split, or a test gets run twice or dropped.
;;
;; The finalizer is load-bearing, not decoration. A plain polynomial hash
;; (`h*31 + c`) leaves the LOW bits barely mixed — its parity is just the parity
;; of the character sum — so `(rem h 2)` sent every test in a small suite to the
;; same shard, leaving the other empty. Shifting the high bits down before the
;; `rem` spreads that structure across the low bits, so small shard counts split
;; evenly.
(def- test-fnv-mask 4294967295)

(defn- test-label-hash
  (s)
  (let (h (fold (fn (acc c) (bit-and (* (bit-xor acc c) 16777619) test-fnv-mask))
            2166136261
            (string/->codepoints s)))
    (bit-and (bit-xor h (bit-shift-right h 15)) test-fnv-mask)))

;; Keep only the tests belonging to shard `index` of `count` (0-based) — the
;; `mix test --partitions` analogue, for splitting a suite across CI machines.
(defn- test-shard-units
  (units index total)
  (if (or (nil? total) (< total 2))
    units
    (filter (fn (unit) (not (empty? (seq/third unit))))
      (map (fn (unit)
             (list (first unit)
               (second unit)
               (filter (fn (t)
                         (= index (rem (test-label-hash (label (second unit) (first t))) total)))
                 (seq/third unit))))
        units))))

;; Randomise unit order for this run. `nil` seed keeps declaration order (the
;; default — a suite that only passes in one order is a bug worth finding, but
;; making it the default would churn every run's output).
(defn- test-order-units
  (units seed)
  (if (nil? seed) units (first (seq/shuffle seed units))))

;; The seed for this run, or nil. Read straight off the active filter so the
;; file-order shuffle below and the unit-order shuffle above can't disagree.
(defn- test-filter-seed () (if (nil? *test-filter*) nil (get *test-filter* :seed)))

;; Did this run ask for a NARROWING selector — `--only`, `FILE:LINE`, or exact
;; names (`--failed`)? Used to warn when such a selector matched nothing: "0
;; tests, 0 passed" with a zero exit is indistinguishable from success in CI, and
;; the usual causes are a typo'd selector or a stale `--failed` record naming
;; tests that no longer exist.
;;
;; `:shards` is deliberately NOT counted: an empty shard is normal and expected
;; when a small suite is fanned across many CI machines, so warning on it would be
;; noise rather than signal.
(defn- test-filter-narrows?
  ()
  (and (not (nil? *test-filter*))
    (or (not (empty? (or (get *test-filter* :only) (list))))
      (not (empty? (or (get *test-filter* :lines) (list))))
      (not (empty? (or (get *test-filter* :names) (list)))))))

;; Randomise FILE order as well, for the scoped (file-by-file) runner. Without
;; this `--seed` shuffled only WITHIN each file — the scoped path drains one file
;; at a time, so files always ran in discovery order and a cross-file order
;; dependency would never be shaken out, which is most of the point of a seed.
(defn- test-order-files
  (loaders)
  (let (seed (test-filter-seed))
    (if (nil? seed) loaders (first (seq/shuffle seed loaders)))))

;; The full selection pipeline: filter, shard, then order. One place, so
;; `run-tests` and `run-tests-scoped` can't drift on selection semantics.
(defn- test-select-units
  (units spec)
  (if (nil? spec)
    units
    (test-order-units (test-shard-units (test-filter-units units spec)
                        (or (get spec :shard) 0)
                        (get spec :shards))
      (get spec :seed))))

;; --- trace ---------------------------------------------------------------------
;; `--trace` reports each test as it FINISHES, coloured by outcome and carrying what
;; a trace is for: the duration and where the test is declared.
;;
;;   ✓ math › adds                        2ms  tests/math_test.blsp:12
;;   ✗ math › divides                     1ms  tests/math_test.blsp:18  (2 failures)
;;   ○ db › needs postgres             skipped  tests/db_test.blsp:5
;;
;; Reporting on completion rather than on start is what makes the colour possible —
;; the outcome isn't known before the body runs. A hung test still surfaces: the
;; runner hard-kills it at `*test-timeout-ms*` and reports it as a timed-out failure,
;; so it shows up as a red line rather than as a start with no end.
;;
;; Runs in the worker process, so lines from parallel workers interleave (each is one
;; flushed `io/puts`), in waves of `*parallel-batch*`.
;; The structured per-test reporting seam: a 1-arg fn (or nil) handed each result
;; tuple as its test finishes, in the WORKER process — the machine-readable
;; counterpart of `--trace`'s human line. A `defdyn`, so an external runner (an
;; editor streaming results into a buffer, a CI formatter) installs one with a
;; root-rebinding `(def *test-report-sink* f)` — the same seam shape as `*spy-sink*`,
;; and deliberately a dynamic: `trace-result` itself ships in the binary, so it is a
;; reserved name (ADR-166) and cannot be advised by redefinition.
(defdyn *test-report-sink* nil)

(defn trace-result (r)
  "Report one finished result `r` through the per-test seams, then return `r` unchanged. Feeds it to any installed `*test-report-sink*` (the machine-readable seam) and, under `*test-trace*`, prints the coloured `--trace` line (glyph, label, timing, location, failure count). Runs in the worker process."
  (when *test-report-sink* (*test-report-sink* r))
  (when *test-trace*
    (io/puts (str (trace-glyph r)
               " "
               (trace-label r)
               "  "
               (test-dim (trace-timing r))
               (if (= (r-where r) "") "" (str "  " (test-dim (r-where r))))
               (trace-failure-count r))))
  r)

(defn- trace-glyph
  (r)
  (cond
    (r-skipped? r) (test-orange "○")
    (r-failed? r) (test-red "✗")
    else (test-green "✓")))

;; The group is dimmed so the test's own name is what stands out in a long run.
(defn- trace-label
  (r)
  (str (if (= (r-group r) "") "" (test-dim (str (r-group r) " › "))) (r-name r)))

(defn- trace-timing (r) (if (r-skipped? r) "skipped" (str (r-ms r) "ms")))

(defn- trace-failure-count
  (r)
  (let (n (count (r-fails r)))
    (cond
      (= n 0) ""
      (= n 1) (test-red "  (1 failure)")
      else (test-red (str "  (" n " failures)")))))

;; A skipped test produces a result without ever calling its body — it still counts
;; and still reports, which is the difference between skipping a test and deleting it.
(defn- test-skipped-result
  (group t)
  (list group (first t) nil 0 true (test-where t)))

;; "file:line" for a test, or "" when no position was recorded. The path is shown
;; relative to the working directory: the loader records absolute paths, and a full
;; `/home/…/project/tests/x_test.blsp` on every trace line buries the part that
;; matters. Falls back to the absolute path when it isn't under the cwd.
(defn- test-where
  (t)
  (let (f (test-file t)
        l (test-line t))
    (if (or (nil? f) (nil? l)) "" (str (test-relative-path f) ":" l))))

(defn- test-relative-path
  (path)
  (let (here (str (file/cwd) "/"))
    (if (string/starts-with? path here)
      (string/substring path (string/length here) (string/length path))
      path)))

;; --- colour --------------------------------------------------------------------
;; ANSI only when stdout is an interactive terminal, so a piped run, a CI log, or an
;; LLM reading the output gets clean text (`stdout-tty?` is the same gate the REPL
;; uses). Wrapped in one place so every bit of the report agrees.
(defn- test-colour (code s) (if (os/stdout-tty?) (str "\e[" code "m" s "\e[0m") s))
(defn- test-green (s) (test-colour "32" s))
(defn- test-red (s) (test-colour "31" s))
(defn- test-dim (s) (test-colour "90" s))
(defn- test-orange (s) (test-colour "33" s))
;; Bold (not a colour) for a failure's file:line — it has to be findable in a wall of
;; output, and bold survives a terminal whose palette makes cyan or blue unreadable.
(defn- test-bold (s) (test-colour "1" s))

;; --- live progress -------------------------------------------------------------
;; One character per finished test — a green dot for a pass, a red `F` for a failure —
;; printed as results arrive, so a long suite shows movement and a failure is visible
;; immediately rather than only in the summary. `print` flushes every call, so the
;; dots appear as they happen.
;;
;; Suppressed under `:trace`, which already prints a line per test: the two together
;; would just be noise.
(defn progress-mark (results)
  "Print one live-progress character per result in `results` — a green `.` for a pass, red `F` for a failure, orange `○` for a skip — flushed as they arrive. Suppressed under `*test-trace*` (which already prints a line per test) and under a machine `*test-formatter*` (whose output must stay parseable)."
  ;; Suppressed under `:trace` (which prints a line per test) and under a machine
  ;; `--formatter` (whose output must stay parseable — no stray dots).
  (unless (or *test-trace* *test-formatter*)
    (fold (fn (_ r)
            (io/write (cond
                        (r-skipped? r) (test-orange "○")
                        (r-failed? r) (test-red "F")
                        else (test-green "."))))
      nil results)))

;; Run one (name thunk) and produce its result (group name fails ms). The thunk
;; returns its own failure list (it catches its first failing assertion), sharing
;; no mutable state — so running these concurrently is safe.
(defn run (group t)
  "Run one `(name thunk meta)` test `t` in group `group` and return its result tuple `(group name fails ms false where)`. A `:skip`-marked test is not run — it yields a skipped result instead. The thunk carries its own failures, so this is safe to run concurrently. Reports the result via `trace-result`."
  (if (test-skip? t)
    (trace-result (test-skipped-result group t))
    (let (start (os/now)
          fails ((second t))
          ms (- (os/now) start))
      (trace-result (list group (first t) fails ms false (test-where t))))))

;; Like run, but evaluate the body with a private copy of the global
;; bindings (`%isolate`): an :isolated test's `def`s are rolled back when it
;; finishes, so they can't leak to any other test. Used only in the isolated phase.
(defn- run-fresh
  (group t)
  (if (test-skip? t)
    (trace-result (test-skipped-result group t))
    (let (start (os/now)
          fails (%isolate (second t))
          ms (- (os/now) start))
      (trace-result (list group (first t) fails ms false (test-where t))))))

;; Run every test in a unit, in order, returning the list of results. This is
;; what a worker does (for a :parallel/:serial unit) and what the runner does
;; directly for an :isolated unit.
(defn run-unit (unit)
  "Run every test in `unit` (a `(mode group tests)` tuple) in order via `run`, returning the list of their results. What a worker evaluates for a `:parallel`/`:serial` unit, and what the runner does directly for an `:isolated` one."
  (let (group (second unit)) (map (fn (t) (run group t)) (seq/third unit))))

;; --- the two phases ----------------------------------------------------------
;; Parallel phase: spawn one worker per non-isolated unit (each worker captures
;; its unit and reports the unit's results back as one message), then collect.
;; Output is emitted once at the end (a single structured report), so there is no
;; per-test progress to print here.
(defn spawn-units (units me)
  "Spawn one monitored worker process per unit in `units` — each runs its unit and sends `(:unit-result pid results)` back to `me` — and return an assoc list of `(pid unit)` so the collector can correlate results. `monitor` lets a worker that dies before reporting become a failure rather than a hang."
  ;; Spawn one MONITORED worker per unit and return an assoc list of
  ;; `(pid unit)`. Each worker tags its message with its own pid (`(self)`),
  ;; which equals the pid `spawn` returns — so the collector can correlate a
  ;; result with the worker that produced it. `monitor` lets the collector
  ;; observe a worker that DIES before reporting (KI-2: a raced/crashed test
  ;; process throwing in `run-unit` itself, outside any per-form `try`) and turn
  ;; it into a failure instead of blocking forever in `receive`. The kernel fires
  ;; `[:down …]` immediately if the worker has already exited, so there is no
  ;; lost-death window between `spawn` and `monitor`.
  (fold (fn (acc unit)
          (let (pid (spawn (send me (list :unit-result (self) (run-unit unit)))))
            (monitor pid)
            (cons (list pid unit) acc)))
    nil units))

;; How many units run concurrently in the parallel phase. This BOUNDS MEMORY: the
;; GC is still a no-op (M1), so every *started* worker holds its entire allocation
;; until it exits — and reduction-preemption interleaves all started workers, so
;; spawning ALL units at once kept hundreds of heaps live simultaneously and made
;; the suite peak ~18 GiB (enough to OOM-freeze the host). The hibernating driver
;; (`run-driver`) instead spawns at most this many per group, collects them — each
;; then exits and its LOCAL heap is reclaimed wholesale — and only then spawns the
;; next group (and flips its own arena between groups), so the live set is
;; bounded by one group. The cap (`-j`) on OS threads does NOT bound this (it
;; limits threads, not started-and-suspended coroutines). Lower = less memory,
;; less parallelism; raise once the GC reclaims so a unit's transients don't pile
;; up. Within a group, a unit that itself spawns many workers still runs them
;; freely — this only bounds how many *units* are in flight at once.
(defdyn *parallel-batch* 4)

;; Two per-test wall-clock thresholds, in milliseconds — distinct on purpose:
;;
;; - `*test-slow-ms*` (default 1s) — **informational**. A test that takes longer is
;;   listed (name + duration) under the summary. It still PASSES; this only surfaces
;;   where the time goes. Override: `(run-tests :slow-over MS)`.
;; - `*test-timeout-ms*` (default 120s) — **a hard ceiling**. A test that runs longer
;;   is hard-killed (`(exit worker :kill)`, ADR-063 — stops even a tight loop that
;;   never `receive`s) and reported as a "timed out" FAILURE, so a hung/runaway test
;;   fails the suite instead of dragging or wedging it. Override: `(run-tests :timeout
;;   MS)`. Workers in a batch start together, so the deadline (`collect-start + this`)
;;   is effectively per-test (per-unit for `:serial`/`:isolated`).
;;
;; So: slow ≤ duration < timeout → listed but passes; duration ≥ timeout → killed +
;; failed. Keep `*test-slow-ms*` < `*test-timeout-ms*` (a slow test you still want to
;; see before it's a hard failure).
(def *test-slow-ms* 1000)
;; 120s: headroom for legitimately slow tests (the adversarial heap-allocation
;; cases take ~15s in a debug build, and far longer when `make test` runs the whole
;; in-language suite concurrently with the rest of the workspace under nextest).
;; Still a hard ceiling that catches a genuinely hung/runaway test. NOTE: the
;; nextest wrapper (`brood_suite_passes`, tests/suite.rs) runs this entire suite as
;; ONE case, so its per-case cap in `.config/nextest.toml` is set *above* this (300s)
;; — otherwise nextest would kill the wrapper before this inner timeout could fire.
(defdyn *test-timeout-ms* 120000)

;; The batch budget for a unit tagged `:slow` or `:conformance`. Before this, `:tags [… :slow]` was
;; documentation the runner ignored: the external conformance corpora (~19,000 UCD
;; normalisation cases x 6 forms) take ~44 s in a *release* build and comfortably
;; exceed the 120 s batch deadline in a debug one, so `nest test` hard-killed them
;; while a genuinely hung test is what that ceiling is for. A `:slow` unit now buys
;; the batch this budget instead — still a hard ceiling, just one sized for work
;; that is legitimately long rather than stuck. Untagged batches are unchanged, so a
;; runaway test is still caught in 120 s.
(defdyn *test-slow-timeout-ms* 900000)

;; The deadline for an ANTI-HANG GUARD — a `(receive … (after *test-wait-ms* :timeout))`
;; where the message is expected and the timeout means "something is wrong". Distinct
;; from `*test-timeout-ms*` (the runner's hard per-test ceiling) and from the short
;; deadlines a test uses to assert that *nothing* arrives, which must stay short.
;;
;; Why it is a named knob rather than a literal at each site: those guards were
;; written with 5s deadlines, and 5s is not a lot when the suite saturates every core —
;; one of them (`remote_spawn_test`) intermittently reddened the whole run on timing
;; alone. They are correctness tests ("did the message arrive at all"), never latency
;; tests, so the deadline exists only to stop a hang and should be generous.
;;
;; 20s: 4× the old headroom, while several compounding guards still fit inside the
;; 120s per-test ceiling, so a genuinely stuck test is still reported with its own
;; message rather than by the hard kill.
(defdyn *test-wait-ms* 20000)

;; When set, print `▶ group › name` as each test STARTS — live progress so you can
;; see which test is running (and spot the slow/hung one) before it finishes. Off by
;; default, and never set by `run-tests-structured` / the `--test` path, so machine-
;; parsed and structured output stays clean. `(run-tests :trace)` turns it on, and
;; `nest test` passes `:trace`. Lines from parallel workers interleave (each is one
;; flushed `io/puts`); they come in waves of `*parallel-batch*`.
(defdyn *test-trace* false)

;; The active output formatter name (`nest test --formatter NAME`), or nil for the
;; default human report. A `def`-global (like `*test-trace*`) so a worker reads it to
;; suppress the live progress dots under a machine formatter. See the formatter registry
;; below (`*test-formatters*`).
(def *test-formatter* nil)

;; The active filter spec (see "test selection" above) — nil runs everything.
;; A global rather than a threaded argument because `drain-current` is reached
;; through `drain-files-scoped`, several frames below the entry point, exactly
;; like `*test-trace*` / `*test-timeout-ms*`.
(defdyn *test-filter* nil)

;; Outcome of the most recent reported pass, as full `"group › name"` labels:
;; every test that RAN, and the subset that FAILED. The project layer reads these
;; to maintain the on-disk `--failed` set (it needs both: a test that ran and
;; passed must be dropped from the set, while one that never ran keeps its prior
;; state). Set outside any `%isolate`, so the values survive a scoped run.
(defdyn *test-last-ran* nil)
(defdyn *test-last-failed* nil)

;; Stop the run once this many tests have failed (0 = unlimited, the default).
;; Checked by `run-driver` between steps, so it stops at the next step boundary
;; rather than mid-flight — a batch already in progress still reports, so the
;; count can overshoot slightly. `mix test --max-failures`.
(defdyn *test-max-failures* 0)

;; The parallel/serial units run in bounded groups (see `*parallel-batch*`) — the
;; loop that does so is the `run-driver` below, which also folds in the isolated
;; phase. (It used to be a plain `run-parallel`/`run-isolated` pair; they were
;; merged into the driver so the runner collects between groups at the safepoint.)

;; The unit a monitored worker `pid` was spawned for, or nil if `pid` isn't one
;; of ours (e.g. a stale `[:down …]` from a previous run still in the mailbox).
(defn- unit-of-pid
  (pid workers)
  (cond
    (empty? workers) nil
    (= (first (first workers)) pid) (second (first workers))
    else (unit-of-pid pid (rest workers))))

;; A worker died before reporting (KI-2). Synthesize a failing result for every
;; test in its unit, carrying the exit reason — so a crashed/raced worker fails
;; fast as a visible failure instead of hanging the collector. A result tuple is
;; `(group name fails ms)`; a failure record is `(loc detail-lines)` with loc nil.
(defn- dead-unit-results
  (unit reason)
  (map (fn (t)
         (list (second unit)
           (first t)
           (list (list nil (list (str "test process died: " (pr-str reason)))))
           0))
    (seq/third unit)))

;; Account for each spawned worker exactly once — by its result if it reported,
;; otherwise by its death. A healthy worker sends `[:unit-result pid results]`
;; then exits `:normal` (its later `[:down …]` is ignored because its pid is in
;; `reported`); a crashed worker sends nothing but its monitor fires
;; `[:down mref pid reason]`, which we turn into failing results. `pending`
;; counts workers not yet accounted for. A `[:down …]` for an unknown pid (a
;; stale worker from a prior run in a long-lived session) is ignored WITHOUT
;; decrementing, so it can't corrupt the count.
;; Budget exhausted (`*test-timeout-ms*`): every worker that hasn't reported is
;; presumed hung. Hard-kill each — `(exit pid :kill)` stops even a tight non-receive
;; loop (ADR-063) — and synthesize a timeout failure for each of its tests, so a hung
;; test FAILS instead of wedging the collector. Returns the full result list.
(defn- collect-timeout
  (workers reported acc)
  (fold (fn (a w)
          (if (includes? reported (first w))
            a
            (do
              (exit (first w) :kill)
              (append (timeout-unit-results (second w)) a))))
    acc workers))

;; A timeout failure per test in a hung unit — same shape as `dead-unit-results`:
;; `(group name fails ms)`, `fails` = `((loc detail-lines))`.
(defn- timeout-unit-results
  (unit)
  (map (fn (t)
         (list (second unit)
           (first t)
           (list (list nil
                   (list (str "test timed out after "
                           (quot *test-timeout-ms* 1000)
                           "s — hard-killed (raise *test-timeout-ms* if legitimately slow)"))))
           *test-timeout-ms*))
    (seq/third unit)))

;; Tags that buy a batch the raised budget. `:slow` says it directly; `:conformance`
;; implies it — an external-corpus sweep is thousands of cases by construction (the
;; UCD normalisation file alone is ~19,000 x 6 forms), and tagging each new corpus
;; `:slow` as well is a step the next author will forget. Everything untagged keeps
;; the 120 s ceiling, which is what catches a genuinely hung test.
(def *test-long-tags* [:slow :conformance])

;; Is any unit in this batch tagged for the raised budget? (`workers` is a list of
;; `(pid unit)`, a unit is `(mode group tests)`, and a test's meta carries its tags.)
(defn- collect-slow-batch?
  (workers)
  (any? (fn (w)
          (any? (fn (t) (any? (fn (tag) (includes? *test-long-tags* tag)) (test-tags t)))
            (seq/third (second w))))
    workers))

(defn collect-units (workers acc)
  "Collect the results of one batch of spawned `workers` (a list of `(pid unit)`), accumulating onto `acc`. Waits for each worker's `:unit-result` (or its monitor `:down`) under a fresh per-batch deadline, hard-killing and failing any straggler that overruns. A `:slow`/`:conformance`-tagged batch runs under the raised `*test-slow-timeout-ms*` budget."
  ;; Fixed wall deadline for this batch — recomputed per collect, so each isolated
  ;; unit / parallel chunk gets its own full budget. A `:slow`-tagged unit raises the
  ;; budget for its batch (see `*test-slow-timeout-ms*`); rebinding the var rather
  ;; than threading a number keeps the timeout *message* accurate too.
  (if (collect-slow-batch? workers)
    (binding (*test-timeout-ms* (max *test-timeout-ms* *test-slow-timeout-ms*))
      (collect-loop (count workers) workers nil acc (+ (os/now) *test-timeout-ms*)))
    (collect-loop (count workers) workers nil acc (+ (os/now) *test-timeout-ms*))))

(defn- collect-loop
  (pending workers reported acc deadline)
  (if (= pending 0)
    acc
    ;; `(m m)` takes the next message; `(after …)` fires when the budget is spent.
    (let (msg (receive (m m) (after (max 0 (- deadline (os/now))) :%test-timeout)))
      (cond
        ;; budget spent — kill + fail the stragglers
        (= msg :%test-timeout) (collect-timeout workers reported acc)

        ;; [:unit-result pid results]
        (= (first msg) :unit-result)
          (let (pid (second msg))
            ;; Ignore a result from a pid that isn't one of THIS batch's workers, or
            ;; one already counted — a late message from a timed-out/killed worker of a
            ;; prior step must not corrupt this step's `pending` count.
            (if (or (includes? reported pid)
                  (nil? (unit-of-pid pid workers)))
              (collect-loop pending workers reported acc deadline)
              (collect-loop (- pending 1)
                workers
                (cons pid reported)
                (append (seq/third msg) acc)
                deadline)))

        ;; [:down mref pid reason]
        (= (first msg) :down)
          (let (pid (seq/third msg)
                unit (unit-of-pid pid workers))
            (cond
              (includes? reported pid) (collect-loop pending
                                         workers reported acc deadline)
              (nil? unit) (collect-loop pending workers reported acc deadline)
              else
                (collect-loop (- pending 1)
                  workers
                  reported
                  (append (dead-unit-results unit (nth msg 3)) acc)
                  deadline)))

        ;; Anything else in the runner's mailbox isn't ours — skip it.
        else (collect-loop pending workers reported acc deadline)))))

;; Run a whole unit with each test under `%isolate` (global-def rollback). This
;; is what an isolated unit's *own* worker process evaluates.
; -> results
(defn- run-unit-fresh
  (unit)
  (let (group (second unit)) (map (fn (t) (run-fresh group t)) (seq/third unit))))
;; ─── The test runner ────────────────────────────────────────────────────────
;; The runner is one long-lived process gathering every step's results. Its
;; per-step transients — worker-result copies, the `append` spine, spawn/monitor
;; machinery — are garbage that once climbed to the memory cap (the ~633-test
;; suite hit ~4 GiB) because automatic collection was off. It no longer does: the
;; driver loop is a SPAWNED process body, so it runs at the depth-1 eval safepoint
;; where **Stage B's automatic copying GC** (ADR-055) fires — each iteration's
;; garbage is reclaimed while the live `acc` is kept (it's rooted as a tail-call
;; argument). A plain tail call bounds the suite; the `(proc/hibernate)` Stage A used
;; here is gone (and the primitive itself was removed — automatic GC made it
;; redundant, docs/memory-review.md §6).
;;
;; Each isolated unit still runs in its OWN awaited worker (so its heap is dropped
;; wholesale on exit, and its mailbox can't leak stragglers into another test);
;; the parallel units still run in `*parallel-batch*`-sized groups (so the live
;; set per collection stays bounded to one group). Isolated steps come first and
;; serially, so `%isolate`'s snapshot/restore of the shared globals table can't
;; race a concurrent unit and each sees the clean post-load baseline.

;; Chunk `coll` into ≤`n`-sized groups, KEEPING a short trailing group (`partition`
;; drops it — which here would silently skip tests).
(defn- run-chunks
  (n coll acc)
  (if (empty? coll)
    (reverse acc)
    (run-chunks n (drop n coll) (cons (take n coll) acc))))

;; The driver's work list: each isolated unit as its own `(:iso unit)` step, then
;; the parallel/serial units as `(:par . units)` groups.
(defn- run-steps
  (iso par)
  (append (map (fn (u) (list :iso u)) iso)
    (map (fn (b) (cons :par b)) (run-chunks *parallel-batch* par nil))))

;; Run one step in the current (driver) process, returning its unit results. An
;; `:iso` step spawns+awaits one unit under `%isolate`; a `:par` step spawns the
;; group and collects it. A crashed worker (KI-2) becomes failing results via the
;; `monitor` inside `spawn-units`/here, never a hang.
(defn- run-step
  (step)
  (if (= (first step) :iso)
    (let (me (self)
          unit (second step)
          pid (spawn (send me (list :unit-result (self) (run-unit-fresh unit))))
          _ (monitor pid))
      (collect-units (list (list pid unit)) nil))
    (collect-units (spawn-units (rest step) (self)) nil)))

;; The driver loop: run a step, then tail-recurse into the next with its results
;; accumulated. Stage B collects the step's transients at the safepoint between
;; iterations (this is a depth-1 spawned-process body), keeping `acc` live. When
;; the work list is empty, hand the full result list to `parent` (the process
;; exits, so its heap drops too).
;; Has the `--max-failures` budget been spent? Checked between steps, so the
;; remaining steps are abandoned rather than run.
(defn- test-max-failures-hit?
  (results)
  (and (> *test-max-failures* 0) (>= (count-failed results) *test-max-failures*)))

(defn- run-driver
  (steps parent acc)
  (if (or (empty? steps) (test-max-failures-hit? acc))
    (send parent [:all-results acc])
    (let (results (run-step (first steps)))
      (progress-mark results)
      (run-driver (rest steps) parent (append results acc)))))

;; Spawn the driver and block until it reports every unit's results. Monitors it
;; so a driver crash surfaces as an error instead of hanging the suite.
(defn- drain-runner
  (iso par)
  (let (me (self)
        d (spawn (run-driver (run-steps iso par) me nil))
        mref (monitor d))
    (receive
      ([:all-results rs]
        ;; The driver exits right after sending its results, which fires a monitor
        ;; `:down`. Drop the monitor and flush that late `:down` (the call idiom,
        ;; std/proc/gen.blsp) so it can't pile up in this process's mailbox: a scoped
        ;; run calls `drain-runner` once PER FILE from one long-lived process, and a
        ;; leaked `:down` per file made every later `receive` scan past them all — O(n²)
        ;; over a large suite (100K files went from hours to seconds with this fix).
        (demonitor mref)
        (receive ([:down ^mref ^d _] :ok) (after 0 :ok))
        rs)
      ([:down ^mref ^d reason] (error (str "test runner crashed: " reason))))))

;; Split the currently-registered units into (iso par) and drain them — the shared
;; body of `run-tests` and `run-tests-scoped`.
(defn- drain-current
  ()
  (let (units (test-select-units (reverse *units*) *test-filter*)
        par (filter (fn (u) (not= (first u) :isolated)) units)
        iso (filter (fn (u) (= (first u) :isolated)) units))
    (drain-runner iso par)))

;; Run each `loader` (a 0-arg thunk that `load`s one test file) in its OWN global
;; scope and return the concatenated raw results. Wrapping a file's reset+load+run in
;; `%isolate` rolls back that file's top-level `def`s (and lets the next safepoint
;; reclaim the promoted code) once its tests finish — so a large suite's shared
;; RUNTIME region stays bounded instead of accumulating every file's code at once
;; (the test-runner leak, docs/devlog.md 2026-07-03). `%isolate` is safe to nest a
;; file's own `:isolated` units inside, and is RUNTIME-compaction-safe (the
;; `rt_collect_block` fix). Files run sequentially (each `%isolate` blocks to
;; completion); tests WITHIN a file still parallelise. The shared drain behind both
;; `run-tests-scoped` (prints) and `run-tests-scoped-structured` (returns data).
;; Load one file and run what it registered — reporting a file that FAILS TO LOAD as
;; a failure of its own rather than letting it abort the run.
;;
;; A test file that doesn't compile is an everyday situation (you are editing it), and
;; it used to take the whole suite down with a raw error structure:
;;
;;   1337:13: error: {:trace ({:col 58, :line 1093} …), :message unbound symbol: …,
;;                    :file /home/…/tests/oops_test.blsp, :kind :unbound, …}
;;
;; — three thousand passing tests thrown away, and the one fact that mattered (which
;; file, which line, what was wrong) buried inside a printed map. Now the file becomes
;; one clearly-located failure, the other files still run, and the run still exits
;; non-zero.
(defn- drain-one-file
  (loader)
  (reset-units!)
  (let (outcome (try (do (loader) :%loaded) (catch e (list :%load-failed e))))
    (if (= outcome :%loaded)
      (drain-current)
      (list (test-load-failure-result (second outcome))))))

;; A field of a raised error, which may be a structured map or a plain string.
(defn- test-error-field (e key) (if (map? e) (get e key) nil))

;; Turn a load failure into an ordinary failing result, so it flows through the same
;; reporting (and counting) as any other failure.
(defn- test-load-failure-result
  (e)
  (let (file (test-error-field e :file)
        line (test-error-field e :line)
        col (test-error-field e :col)
        message (or (test-error-field e :message) (pr-str e))
        shown (if (nil? file) "" (test-relative-path file)))
    (list (if (= shown "") "a test file" shown)
      "failed to load"
      (list (list (if (and file line col) (list file line col) nil)
              (list (str "cannot load: " message))))
      0
      false
      (if (and (not (= shown "")) (not (nil? line))) (str shown ":" line) ""))))

(defn- drain-files-scoped
  (loaders)
  ;; Accumulate each file's result LIST with `cons` (O(1)) into a reverse-order list of
  ;; lists, then flatten once — O(total results). (A naive `(append acc file-results)`
  ;; per file is O(files²): it recopies the growing accumulator every file, which made a
  ;; 100K-file suite quadratic. `cons` + one flatten keeps it linear.)
  ;;
  ;; `--max-failures` also has to be enforced HERE, across files: each file gets its
  ;; own driver (that's what per-file scoping means), so `run-driver`'s between-steps
  ;; check only ever bounds one file. The fold state carries a running failure count
  ;; — counting once per file rather than re-scanning the accumulator — and stops
  ;; loading further files once the budget is spent.
  (let (final (fold (fn (state loader)
                      (let (chunks (first state)
                            failed (second state))
                        (if (and (> *test-max-failures* 0) (>= failed *test-max-failures*))
                          state
                          (let (file-results (%isolate (fn () (drain-one-file loader))))
                            (list (cons file-results chunks)
                              (+ failed (count-failed file-results)))))))
                (list nil 0)
                ;; `--seed` randomises FILE order too, not just the units within a
                ;; file — the scoped runner drains one file at a time, so without
                ;; this files always ran in discovery order and a cross-file order
                ;; dependency could never be shaken out.
                (test-order-files loaders))
        chunks (first final))
    ;; `chunks` is reverse run order; fold back to run order with `append-two`, which copies
    ;; only its FIRST arg (the small per-file result list) and SHARES the accumulator tail —
    ;; O(total). NB: the variadic `append` copies BOTH args, so `(append c acc)` here would be
    ;; O(files²) (it recopies the growing accumulator every file); `append-two` is the fix.
    (fold (fn (acc file-results) (append-two file-results acc)) nil chunks)))

;; Run a suite file-by-file (each file in its own rolled-back scope, via
;; `drain-files-scoped`), aggregate, then report once — the memory-bounded analogue of
;; loading every file up front and running the whole registry together. Prints the
;; summary + raises exactly like `run-tests`. Backs `nest test`.
(defn run-tests-scoped (loaders & opts)
  "Run a suite file-by-file, each file in its own rolled-back global scope so its top-level defs + promoted code are reclaimed after its tests finish — bounding a large suite's memory. `loaders` is a list of 0-arg thunks that each `load` one test file. Aggregates results, prints the summary, and raises if any failed — like `run-tests`. Backs `nest test`."
  (test-apply-opts opts)
  (test-repeat (opt-val :repeat opts 1) (fn () (run-tests-scoped-pass loaders opts))))

;; One pass of a scoped (file-by-file) suite. Split out so `:repeat` can re-run
;; it — each pass re-`load`s every file in its own rolled-back scope, so a
;; repeated run is genuinely independent rather than replaying one registry.
(defn- run-tests-scoped-pass
  (loaders opts)
  (let (start (os/now)
        results (drain-files-scoped loaders))
    (test-report-pass results (- (os/now) start) opts "")))

;; Structured analogue of `run-tests-scoped` — the memory-bounded counterpart of
;; `run-tests-structured`. Same per-file scoping (so a long-lived `nest mcp` hot-reload
;; image doesn't accumulate every file's code across repeated run-tests calls), but
;; returns `{:total :passed :failed :failed-assertions :ms :results [...]}` instead of
;; printing + raising. Backs `run-tests-structured` (the `nest mcp` run-tests tool).
(defn run-tests-scoped-structured (loaders & opts)
  "Like `run-tests-scoped`, but returns the structured result `{:total :passed :failed :failed-assertions :ms :results [...]}` instead of printing and raising — the memory-bounded counterpart of `run-tests-structured`. Backs the `nest mcp` run-tests tool."
  (test-apply-opts opts)
  (let (start (os/now)
        results (drain-files-scoped loaders)
        elapsed (- (os/now) start)
        total (count results)
        failed (count-failed results)
        fails (count-failures results))
    {:total total
     :passed (- total failed)
     :failed failed
     :failed-assertions fails
     :ms elapsed
     :results (or (map (fn (r)
                         {:group (r-group r)
                          :name (r-name r)
                          :passed (not (r-failed? r))
                          :ms (r-ms r)
                          :failures (or (map (fn (f) {:loc (first f) :details (second f)})
                                          (r-fails r))
                                      [])})
                    results)
                [])}))
;; ────────────────────────────────────────────────────────────────────────────

;; --- reporting ---------------------------------------------------------------
;; A failure record is (loc detail-lines): loc is (file line col) or nil.
(defn- fail-loc-of (rec) (first rec))
(defn- fail-lines-of (rec) (second rec))

;; The anchor line for a failed assertion. With a location it's the GNU
;; `FILE:LINE:COL: message` form that compilation-mode / flymake parse and make
;; clickable; without one, just the message. The labeled fields print indented
;; under it. See docs/tooling.md.
(defn fail-anchor (r rec)
  "The anchor line for one failure record `rec` of result `r`: the bold `file:line:col` location (from `fail-where`), then `test failed: ` and the test's full `group › name`. The clickable header a reporter prints above the failure's indented fields."
  (let (where (fail-where r rec))
    (str (if (= where "") "" (str (test-bold where) ": "))
      (test-red "test failed: ")
      (full-name r))))

;; WHERE to look, as `file:line:col` — the part of a failure report you actually act
;; on, so it must always be present and short enough to read.
;;
;; Two things were wrong before. The path was ABSOLUTE, so every anchor line opened
;; with `/home/you/projects/thing/tests/…` and the location was buried in it; it is now
;; relative to the working directory (still clickable — `nest test` runs from the
;; project root, which is what compilation-mode resolves against). And when an
;; assertion carried no recorded position the location was omitted ENTIRELY, leaving
;; only `test failed: group › name` with nothing to jump to; it now falls back to the
;; test's own declaration site, which the result carries.
(defn fail-where (r rec)
  "Where a failure occurred, as `file:line:col` relative to the working directory. Uses the failure record `rec`'s own captured position when it has one; otherwise falls back to result `r`'s declaration site (`r-where`), and \"\" only when neither is known."
  (let (loc (fail-loc-of rec))
    (cond
      loc (str (test-relative-path (first loc)) ":" (second loc) ":" (seq/third loc))
      ;; No per-assertion position (a body form the reader recorded no position for) —
      ;; point at the test instead of nowhere.
      (not (= (r-where r) "")) (r-where r)
      else "")))

;; Print every failure of a result: a blank line, the anchor, then its fields
;; indented. The leading blank separates consecutive failures, which otherwise run
;; together into a wall that is hard to scan.
(defn- print-failure
  (indent r)
  (fold (fn (_ rec)
          (io/puts "")
          (io/puts (fail-anchor r rec))
          (fold (fn (_ line) (io/puts (str indent (test-dim-label line)))) nil (fail-lines-of rec)))
    nil
    (r-fails r)))

;; Dim the `label:` prefix of a detail line so the VALUE is what stands out —
;; `actual:`/`expect:`/`assert:` are scaffolding, the values are the information.
(defn- test-dim-label
  (line)
  (let (i (index-of line ": "))
    (if (< i 0)
      line
      (str (test-dim (string/substring line 0 (+ i 1)))
        (string/substring line (+ i 1) (string/length line))))))

;; Emit one editor-parseable block per failed assertion. There is a single
;; output format — structured — for humans, LLMs and Emacs alike (docs/tooling.md).
(defn- report-failures
  (results)
  (let (failed (filter r-failed? results))
    (unless (empty? failed) (fold (fn (_ r) (print-failure "    " r)) nil failed))))

(defn- report-slow
  (results n)
  (io/puts "")
  (io/puts (str "Slowest " n " tests:"))
  (let (timings (map (fn (r) [(full-name r) (r-ms r)]) results))
    (fold (fn (_ entry)
            (io/puts (str "  "
                       (string/pad-right (str (first entry)) 28)
                       (string/pad-left (str (rest entry)) 6)
                       " ms")))
      nil
      (take n (sort-by-ms timings)))))

;; "1.3s" from milliseconds — one decimal, rounded to nearest 0.1s.
(defn- secs-str
  (ms)
  (let (tenths (quot (+ ms 50) 100)) (str (quot tenths 10) "." (rem tenths 10) "s")))

;; Always-on slow-test surfacing: list every test slower than `over` ms (slowest
;; first), so a slow test is never hidden behind the one-line summary. Unlike
;; `report-slow` (the opt-in `:slow` top-5), this fires automatically. Prints
;; nothing when every test is under the threshold — the common, fast case stays
;; quiet.
(defn- report-slow-over
  (results over)
  (let (slow (filter (fn (p) (> (second p) over))
               (map (fn (r) [(full-name r) (r-ms r)]) results)))
    (unless (empty? slow)
      (io/puts "")
      (io/puts (str "Slow tests (> " (secs-str over) "):"))
      (fold (fn (_ p)
              (io/puts (str "  " (string/pad-right (str (first p)) 40) " " (secs-str (second p)))))
        nil
        (sort-by-ms slow)))))

(defn count-failed (results)
  "Count the results in `results` that have at least one failed assertion (a failing test, not the total number of failed assertions)."
  ; tests with at least one failed assertion
  (fold (fn (acc r) (if (r-failed? r) (+ acc 1) acc)) 0 results))
(defn count-skipped (results)
  "Count the results in `results` that were skipped — registered with `:skip` but never run."
  ; tests that registered but were never run (`:skip`)
  (fold (fn (acc r) (if (r-skipped? r) (+ acc 1) acc)) 0 results))
(defn- count-failures
  (results)
  ; total failed assertions across tests
  (fold (fn (acc r) (+ acc (count (r-fails r)))) 0 results))

;; --- entry point -------------------------------------------------------------
;; Every entry point takes the same option plist, so `nest test`'s flags mean the
;; same thing whether the run is whole-project (scoped, file-by-file) or a single
;; file. Applied as global rebinds because the spawned driver/workers read them
;; from the shared global table.
;;
;;   :timeout MS      hard per-test ceiling      (mix --timeout)
;;   :slow-over MS    "slow test" threshold
;;   :slowest N       list the N slowest         (mix --slowest)
;;   :slow            legacy alias for :slowest 5
;;   :trace           print each test as it starts (mix --trace)
;;   :filter SPEC     selection spec, see above  (mix --only/--exclude/--include, FILE:LINE)
;;   :max-failures N  abandon the run after N failures (mix --max-failures)
;;   :repeat N        run the suite up to N times, stopping at the first failure
;;                                               (mix --repeat-until-failure)
(defn- test-apply-opts
  (opts)
  (def *test-timeout-ms* (opt-val :timeout opts *test-timeout-ms*))
  (def *test-slow-ms* (opt-val :slow-over opts *test-slow-ms*))
  (def *test-trace* (opt? :trace opts))
  (def *test-formatter* (opt-val :formatter opts nil))
  (def *test-filter* (opt-val :filter opts nil))
  (def *test-max-failures* (opt-val :max-failures opts 0)))

;; How many slowest tests to list: `:slowest N`, or 5 for the legacy `:slow`
;; flag, else nil (list none). `:slowest 0` is nil too — otherwise the reporter
;; printed a "Slowest 0 tests:" heading with nothing under it.
(defn- test-slowest-n
  (opts)
  (let (n (opt-val :slowest opts (if (opt? :slow opts) 5 nil)))
    (if (and (not (nil? n)) (> n 0)) n nil)))

;; Run one pass thunk up to `n` times, stopping at the first failing pass. A pass
;; RAISES when the suite fails, so the raise itself ends the loop — no result
;; inspection needed. `mix test --repeat-until-failure`.
(defn- test-repeat
  (n pass)
  (if (<= n 1)
    (pass)
    (do
      (pass)
      (test-repeat (- n 1) pass))))

;; The shared tail of a printing run: the failure blocks, the slow lists, the
;; one-line summary, then raise if anything failed. `extra` is appended inside the
;; summary parens (the isolated-unit count, for the non-scoped runner).
;; --- output formatters (nest test --formatter NAME) --------------------------
;; The default report is the human one below. A machine formatter — TAP for a CI that
;; speaks it, JSON for tooling — is a named entry in this registry; `--formatter NAME`
;; selects it. Each is a fn `(results elapsed)` that PRINTS the run; raising on failure
;; (for the exit code) stays the runner's job. `register-test-formatter` is the seam an
;; external tool adds its own with — same shape as the REPL command registry.
(def *test-formatters* {})

(defn register-test-formatter (name formatter)
  "Register a named `nest test --formatter` output formatter: `name` (a string) →
`formatter`, a fn `(results elapsed)` that prints the run. The built-ins are `tap` and
`json`; the default (no `--formatter`) is the human report. Raising on failure is the
runner's job, not the formatter's. Returns `name`."
  (def *test-formatters* (assoc *test-formatters* name formatter))
  name)

(defn- test-fmt-tap
  (results elapsed)
  "TAP version 13: a `1..N` plan then one `ok`/`not ok N - name` line per test (a skip
adds `# SKIP`); a failure's detail lines follow as `#` comments. Numbered in result
order (deterministic — the results are already collected)."
  (io/puts "TAP version 13")
  (io/puts (str "1.." (count results)))
  (fold (fn (i r)
          (let (status (if (r-failed? r) "not ok" "ok"))
            (io/puts (str status
                       " "
                       (+ i 1)
                       " - "
                       (full-name r)
                       (if (r-skipped? r) " # SKIP" "")))
            (when (r-failed? r)
              (fold (fn (_ rec)
                      (fold (fn (_ line) (io/puts (str "# " line))) nil (fail-lines-of rec)))
                nil
                (r-fails r)))
            (+ i 1)))
    0 results)
  nil)

(defn- test-result->data
  (r)
  "One result as a JSON-ready map (the shape `run-tests-structured` also emits)."
  {:group (r-group r)
   :name (r-name r)
   :passed (not (r-failed? r))
   :skipped (r-skipped? r)
   :ms (r-ms r)
   :failures (or (map (fn (f) {:loc (first f) :details (second f)}) (r-fails r)) [])})

(defn- test-fmt-json
  (results elapsed)
  "One JSON object for the whole run: `{:total :passed :failed :failed-assertions :ms
:results [...]}` — the same data `run-tests-structured` returns, for a tool that consumes
the suite programmatically. Printed once, at the end, so parallel ordering is irrelevant."
  (let (total (count results)
        failed (count-failed results))
    (io/puts (json/encode {:total total
                           :passed (- total failed)
                           :failed failed
                           :failed-assertions (count-failures results)
                           :ms elapsed
                           :results (or (map test-result->data results) [])})))
  nil)

(register-test-formatter "tap" test-fmt-tap)
(register-test-formatter "json" test-fmt-json)

(defn- test-report-formatted
  (results elapsed)
  "Emit `results` through the selected `*test-formatter*`, then raise on any failure so
the exit code still reflects the run. An unknown formatter name is a clean error."
  ;; NB not `fmt` — that's the prelude string-template MACRO, and a macro in call-head
  ;; position wins over a local binding, so `(fmt …)` would expand as the template.
  (let (formatter-fn (get *test-formatters* *test-formatter*))
    (if (nil? formatter-fn)
      (error (str "unknown --formatter '"
               *test-formatter*
               "' (available: "
               (string/join ", " (sort (keys *test-formatters*)))
               ")"))
      (do
        (formatter-fn results elapsed)
        (if (> (count-failed results) 0)
          (error (str (count-failed results) " test(s) failed"))
          :ok)))))

(defn- test-report-pass
  (results elapsed opts extra)
  ;; `--failed` tracking happens on every path (the interesting run is the failing one).
  (def *test-last-ran* (map full-name results))
  (def *test-last-failed* (map full-name (filter r-failed? results)))
  (if *test-formatter*
    (test-report-formatted results elapsed)
    (test-report-human results elapsed opts extra)))

(defn- test-report-human
  (results elapsed opts extra)
  (let (total (count results)
        failed (count-failed results)
        skipped (count-skipped results)
        fails (count-failures results)
        slowest (test-slowest-n opts)
        seed (if (nil? *test-filter*) nil (get *test-filter* :seed)))
    ;; (`*test-last-ran*`/`*test-last-failed*` are set by `test-report-pass`, before
    ;; this human/formatter split, so `--failed` works on either path.)
    ;; A narrowing selector that matched nothing must not pass for success.
    (when (and (= total 0) (test-filter-narrows?))
      (io/puts "warning: no tests matched the given filters — 0 tests ran (check the selector, or a stale --failed record naming tests that no longer exist)"
        :to *err*))
    (report-failures results)
    (report-slow-over results *test-slow-ms*)
    (when slowest (report-slow results slowest))
    (io/puts "")
    ;; Built as one string rather than `io/puts`'s space-joined arguments, so the
    ;; commas land correctly whether or not the optional skipped clause is present.
    (io/puts (str total
               " tests, "
               (- total failed skipped)
               " passed, "
               failed
               " failed"
               (if (> skipped 0) (str ", " skipped " skipped") "")
               " ("
               fails
               " failed assertions"
               extra
               ")"))
    (io/puts (str "  (" elapsed " ms wall, peak " (mb-str (dev/mem-peak)) ")"))
    ;; Echo the seed whenever the order was randomised, so the run can be
    ;; reproduced. Deliberately says "same order", not "replay exactly": the seed
    ;; fixes the order tests are SCHEDULED in, but parallel tests genuinely
    ;; interleave, so a concurrency-dependent failure may not recur from the seed
    ;; alone. Promising exact replay here would be a lie.
    (when seed
      (io/puts (str "  (random order, seed "
                 seed " — same order with --seed " seed "; parallel tests still interleave)")))
    (if (> failed 0) (error (str failed " test(s) failed")) :ok)))

(defn run-tests (& opts)
  "Run every registered test once (the isolated tests first, then the parallel/serial pool), print a summary, and raise if any failed. Each test has a 120s hard timeout (killed + failed if exceeded — `:timeout MS` to change). Any test over 1s is listed automatically (`:slow-over MS` to change that threshold); `:slow` also reports the slowest 5 regardless of duration."
  ;; Option overrides are global rebinds — the spawned driver reads them from the
  ;; shared table.
  (test-apply-opts opts)
  (test-repeat (opt-val :repeat opts 1) (fn () (run-tests-pass opts))))

;; One pass of the registered suite: select, drain, report, raise. Split out of
;; `run-tests` so `:repeat` can run it more than once.
(defn- run-tests-pass
  (opts)
  (let (units (test-select-units (reverse *units*) *test-filter*)
        par (filter (fn (u) (not= (first u) :isolated)) units)
        ; parallel + serial
        iso (filter (fn (u) (= (first u) :isolated)) units)
        start (os/now))
    ;; All result-gathering runs in the hibernating driver (isolated units first
    ;; and serially, then the parallel groups), so the runner's per-step transients
    ;; are reclaimed between steps. See the Stage-A block above.
    (let (results (drain-runner iso par))
      (test-report-pass results (- (os/now) start) opts (str ", " (count iso) " isolated")))))

;; Structured analogue of `run-tests` — runs the same suite (isolated phase,
;; then parallel/serial), but **returns data** instead of printing + throwing.
;; Backs the `nest mcp` `run-tests` tool (step 1c-b). Shape:
;;   {:total :passed :failed :failed-assertions :ms
;;    :results [{:group :name :passed :ms :failures [{:loc :details} ...]}]}
;; `:loc` is `[file line col]` or nil; `:details` is a list of strings.
;; A test that uncaught-errored shows up as `:passed false` with a single
;; failure carrying the error text (consistent with the textual runner).
(defn run-tests-structured (& opts)
  "Like `run-tests`, but returns the result as data — `{:total :passed :failed :failed-assertions :ms :results [...]}` — instead of printing and raising. Backs the `nest mcp` `run-tests` tool."
  (test-apply-opts opts)
  (let (units (test-select-units (reverse *units*) *test-filter*)
        par (filter (fn (u) (not= (first u) :isolated)) units)
        iso (filter (fn (u) (= (first u) :isolated)) units)
        start (os/now))
    (let (results (drain-runner iso par)
          elapsed (- (os/now) start)
          total (count results)
          failed (count-failed results)
          fails (count-failures results))
      {:total total
       :passed (- total failed)
       :failed failed
       :failed-assertions fails
       :ms elapsed
       ;; `(or … [])` on every list field so empty results render as JSON
       ;; `[]` rather than `null`. Matters when the suite has zero tests, or
       ;; a passing test has zero failures — agents branch on `length`, not
       ;; `(= null)`.
       :results (or (map (fn (r)
                           {:group (r-group r)
                            :name (r-name r)
                            :passed (not (r-failed? r))
                            :ms (r-ms r)
                            :failures (or (map (fn (f) {:loc (first f) :details (second f)})
                                            (r-fails r))
                                        [])})
                      results)
                  [])})))
