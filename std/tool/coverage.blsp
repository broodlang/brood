;; std/tool/coverage.blsp — FUNCTION-level test coverage, written in Brood.
;;
;; Answers "which of my functions did the test suite never call?" — the question
;; that actually changes what you write next. It is NOT line coverage: a function
;; counts as covered the moment it is entered once, however little of its body ran.
;; See docs/coverage.md for why that tier, and what line coverage would need.
;;
;; ─────────────────────────────────────────────────────────────────────────────
;; HOW IT WORKS — hot reload as the instrumentation seam
;; ─────────────────────────────────────────────────────────────────────────────
;; No kernel support, no compiler flag, no special build. Before the suite runs,
;; every project function is REBOUND to a variadic shim that records a hit and
;; forwards to the original (ADR-013 late binding makes the rebind visible to
;; every already-loaded caller, including ones in other processes). Afterwards the
;; hit table is compared against the set of functions the project defines.
;;
;; Three consequences worth knowing:
;;
;;   1. The shim is **variadic** (`(fn (& args) …)`), not arity-preserving. It has
;;      to be: `arglist` reports only ONE arm of a multi-arm function, so building
;;      a shim from it would silently break the arities it didn't see. Variadic
;;      forwarding is correct for every shape — fixed, `&optional`, `& rest`, and
;;      multi-arm alike. The cost is that arity errors now surface from inside the
;;      shim rather than at the call, and that every rebind trips the hot-reload
;;      arity diagnostic (`nest test --cover` sets `BROOD_NO_RELOAD_DIAG=1`).
;;   2. A **self-recursive tail call is counted once**, not per iteration. The VM
;;      compiles it to `SelfCall`, which deliberately bypasses the global lookup
;;      (and so the shim). Fine here — coverage asks "was it entered", not "how
;;      often" — but it means the hit COUNTS are a lower bound, not a profile.
;;   3. Instrumentation is **observable**: it defeats JIT inlining of the wrapped
;;      call and adds a frame. A coverage run is not a timing run.
;;
;; Hits live in a `Value::Table` (ADR-107) — the one sanctioned mutable structure,
;; and exactly the right one here: tests run across many green processes with
;; separate heaps, and a table is shared by identity with atomic `table-incr`, so
;; concurrent hits from parallel tests can't lose an update.

(defmodule coverage
  "Function-level test coverage for a Brood project. Rebinds every project
function to a counting shim (hot reload as the instrumentation seam), runs the
suite, then reports which functions were never entered. Backs `nest test --cover`.")

;; The live hit table for the current run, or nil when not instrumenting. A table
;; handle is shared by identity, so every process that inherits this global writes
;; to the same store.
(def *coverage-hits* nil)

;; The functions instrumented for this run, as a list of
;; `{:name symbol :file string :line int}` — the DENOMINATOR. Captured before the
;; suite runs, because instrumentation itself must not change what we count.
(def *coverage-targets* nil)

;; --- discovering what to count -----------------------------------------------

;; Is `path` inside one of `dirs`? Compared by prefix on a path-component
;; boundary, so a `src` source path doesn't also claim a sibling `src-extra/`.
(defn- coverage-under?
  (path dirs)
  (fold (fn (found dir)
          (or found
            (and (not (nil? path))
              (starts-with? path dir)
              (or (= (string-length path) (string-length dir))
                (= (substring path (string-length dir) (+ (string-length dir) 1)) "/")))))
    false
    (or dirs (list))))

;; Every global that is a plain function DEFINED IN this project's source dirs.
;; Excludes macros (they are expanded, never called — a shim would break them),
;; native primitives, and non-callable data. `source-location` is what ties a
;; global back to a file, so anything the kernel didn't record a location for is
;; skipped rather than guessed at.
(defn- coverage-targets
  (source-dirs)
  (fold (fn (acc sym)
          (let (location (source-location sym))
            (if (and (not (nil? location))
                  (coverage-under? (vector-ref location 0) source-dirs)
                  (= (type-of (eval sym)) :fn))
              (cons {:name sym :file (vector-ref location 0) :line (vector-ref location 1)} acc)
              acc)))
    nil
    (global-names)))

;; --- instrumenting ------------------------------------------------------------

;; Rebind one global to a shim that records a hit then forwards. Built with `eval`
;; because the name is computed: `def` takes a literal symbol, so the rebinding
;; form is constructed and evaluated. The shim closes over the ORIGINAL value, so
;; forwarding can't recurse into itself.
(defn- coverage-instrument!
  (sym hits)
  (let (original (eval sym))
    (eval (list 'def
            sym
            (list 'quote
              (fn (& args)
                (table-incr hits (name sym) 1)
                (apply original args)))))))

(defn coverage-begin! (source-dirs)
  "Instrument every function this project defines under `source-dirs` and return the hit table. Call once, AFTER the project's sources are loaded and before the suite runs. Sets `*coverage-hits*` / `*coverage-targets*` for the reporter."
  ;; Release a previous run's table before replacing the handle. A table lives in
  ;; a runtime-wide registry, not the process heap, so dropping the reference is
  ;; NOT enough to free it — a long-lived image (`nest mcp`) instrumenting more
  ;; than once would otherwise strand one store per run.
  (when (not (nil? *coverage-hits*)) (table-drop *coverage-hits*))
  (let (targets (coverage-targets source-dirs)
        hits (table))
    (def *coverage-hits* hits)
    (def *coverage-targets* targets)
    (fold (fn (_ target) (coverage-instrument! (get target :name) hits)) nil targets)
    hits))

;; --- reporting ----------------------------------------------------------------

;; One record per instrumented function: its name, file, line, and hit count.
;; Reads the table ONCE via `table-snapshot` (atomic, O(n)) rather than probing
;; per function, so the report can't tear across a still-running process.
(defn coverage-results ()
  "The current run's coverage as a list of `{:name :file :line :hits}`, hits being the number of times the function was entered (0 = never). nil when no run was instrumented."
  (if (nil? *coverage-hits*)
    nil
    (let (snapshot (table-snapshot *coverage-hits*))
      (map (fn (target)
             (assoc target :hits (or (get snapshot (name (get target :name))) 0)))
        *coverage-targets*))))

(defn- coverage-covered (results) (filter (fn (r) (> (get r :hits) 0)) results))

;; Uncovered functions in SOURCE order. The underlying target list comes from
;; `global-names` (sorted by spelling), so without this the report reads 7, 15, 9 —
;; sorting by line is what makes it walk the file top-to-bottom.
(defn- coverage-uncovered
  (results)
  (sort-by :line (filter (fn (r) (= (get r :hits) 0)) results)))

;; Percentage as a whole number, rounded to nearest. An empty denominator is 100%
;; (nothing to cover is not a failure), which keeps a source-less project from
;; reporting 0% and failing a `--cover-min` gate.
(defn- coverage-percent
  (covered total)
  (if (= total 0) 100 (quot (+ (* covered 200) total) (* total 2))))

;; Group results by file, as a list of `[file file-results]`, in stable
;; (alphabetical) file order so the report is diffable between runs.
(defn- coverage-by-file
  (results)
  (let (files (sort (fold (fn (acc r) (if (member? (get r :file) acc) acc (cons (get r :file) acc)))
                      nil results)))
    (map (fn (f) [f (filter (fn (r) (= (get r :file) f)) results)]) files)))

;; Shorten an absolute path to a project-relative one for display.
(defn- coverage-relative
  (path root)
  (if (and (not (nil? root)) (starts-with? path root))
    (let (cut (+ (string-length root) 1))
      (if (> (string-length path) cut) (substring path cut (string-length path)) path))
    path))

(defn coverage-report (root)
  "Print the coverage report: a per-file table, then the uncovered function names, then a total line. Returns the total percentage (an int 0–100)."
  (let (results (coverage-results))
    (if (nil? results)
      (do
        (println "")
        (println "coverage: no functions were instrumented")
        100)
      (let (total (count results)
            covered (count (coverage-covered results))
            percent (coverage-percent covered total))
        (println "")
        (println "Coverage (functions entered at least once):")
        (fold (fn (_ entry)
                (let (file-results (second entry)
                      file-total (count file-results)
                      file-covered (count (coverage-covered file-results)))
                  (println (str "  "
                             (pad-right (coverage-relative (first entry) root) 44)
                             (pad-left (str (coverage-percent file-covered file-total)) 4)
                             "%  ("
                             file-covered
                             "/"
                             file-total
                             ")"))))
          nil
          (coverage-by-file results))
        (let (missed (coverage-uncovered results))
          (unless (empty? missed)
            (println "")
            (println (str "Never called (" (count missed) "):"))
            (fold (fn (_ r)
                    (println (str "  "
                               (coverage-relative (get r :file) root)
                               ":"
                               (get r :line)
                               ": "
                               (name (get r :name)))))
              nil
              ;; Report in source order within a file, files alphabetical — the
              ;; same order as the table above, so the two read together.
              (fold (fn (acc entry) (append acc (coverage-uncovered (second entry))))
                nil
                (coverage-by-file results)))))
        (println "")
        (println (str "coverage: " percent "% of " total " functions (" covered " covered)"))
        percent))))

;; ─────────────────────────────────────────────────────────────────────────────
;; LINE COVERAGE (ADR-148 tier 2) — which source LINES executed
;; ─────────────────────────────────────────────────────────────────────────────
;; The function tier above answers "was this ever entered". This answers "did this
;; line run", and needs two halves that come from opposite directions:
;;
;;   * The NUMERATOR is recorded by the kernel. `%coverage-lines` reads what the
;;     bytecode's `RecordLine` instructions logged — emitted at COMPILE time and only
;;     when coverage is armed, so an ordinary run's bytecode is unchanged. See
;;     `crates/lisp/src/coverage.rs`, including why the tree-walking evaluator is NOT
;;     a viable seam (a compiled body never goes through it).
;;   * The DENOMINATOR comes from the SAME place, not from the source text. Every
;;     `RecordLine` the compiler emits is registered as it is emitted, and
;;     `%coverage-instrumented` reads that back. Arms compile on first CALL, though, so
;;     `coverage-line-begin!` must force every project function to compile before the
;;     suite runs — otherwise a function nothing calls is missing from the denominator
;;     as well as the numerator, and the ratio flatters itself.
;;
;; Counting "lines that hold a form" instead — the obvious static approach — was tried
;; and is wrong: a `defmodule` header, a docstring and a `defn`'s own line all hold
;; forms and none is an instrumented node, so the two halves of the ratio describe
;; different populations and a fully-exercised file reported 14% of itself. Only
;; positioned nodes are instrumented (calls and inlined prims — the same set that tags a
;; runtime error with a line), so "line 12 never ran" means "no call on line 12 ran",
;; and a file of nothing but literal-bodied functions has no measurable lines at all
;; (it is omitted rather than reported as 0%).

;; Local safety net: a missing readout costs a measurement, not the report.
(defn- coverage-safely (thunk) (try (thunk) (catch _ nil)))

;; A `[file (line …)]` readout as `file -> {line -> true}`, for O(1) membership.
(defn- coverage-line-index
  (entries)
  (fold (fn (index entry)
          (assoc index
            (vector-ref entry 0) (fold (fn (lines l) (assoc lines l true)) {} (vector-ref entry 1))))
    {}
    (or entries nil)))

;; Which lines RAN.
(defn- coverage-hit-index
  ()
  (coverage-line-index (coverage-safely (fn () (%coverage-lines)))))

;; Which lines COULD run, keyed by file — the kernel's own record of what it
;; instrumented. Values stay lists: they arrive sorted and are only iterated.
(defn- coverage-instrumented-index
  ()
  (fold (fn (index entry) (assoc index (vector-ref entry 0) (vector-ref entry 1)))
    {}
    (or (coverage-safely (fn () (%coverage-instrumented))) nil)))

(defn coverage-line-begin! (source-dirs)
  "Force every project function under `source-dirs` to compile, so the lines of a function the suite never calls still count as measurable. Call once, after the sources are loaded and BEFORE the suite runs. Returns how many bodies compiled."
  ;; Arms compile on first CALL, so without this pass an uncalled function is missing
  ;; from the denominator as well as the numerator and the ratio flatters itself: the
  ;; fixture with one deliberately-dead function reported 100%.
  (fold (fn (compiled target)
          (if (coverage-safely (fn () (%coverage-precompile (eval (get target :name)))))
            (+ compiled 1)
            compiled))
    0
    (or (coverage-targets source-dirs) nil)))

(defn coverage-line-results (source-dirs)
  "Per-file line coverage as a list of `{:file :total :covered :missing}`, `missing` being the instrumented lines that never ran. Only files under `source-dirs` are measured, so std and the prelude — which the recorder also sees — can't dilute the number; files with nothing instrumented are omitted rather than counted as 0%."
  ;; `project` is required lazily here rather than in the header: `project` itself
  ;; requires `coverage` (for `nest test --cover`), so a top-level require would be
  ;; circular. This runtime require is idempotent (project is already loaded whenever
  ;; coverage runs from `nest`) and makes the `project/…` reference self-sufficient.
  (require 'project)
  (let (hits (coverage-hit-index)
        instrumented (coverage-instrumented-index)
        files (or (coverage-safely (fn ()
                                     (fold (fn (acc dir)
                                             (append acc (project/project-collect-sources dir)))
                                       nil source-dirs)))
                nil))
    (filter (fn (result) (> (get result :total) 0))
      (map (fn (path)
             (let (executable (or (get instrumented path) nil)
                   ran (or (get hits path) {})
                   missing (filter (fn (line) (not (contains? ran line))) executable))
               {:file path
                :total (count executable)
                :covered (- (count executable) (count missing))
                :missing missing}))
        files))))

(defn coverage-line-report (root source-dirs)
  "Print the line-coverage report — a per-file percentage, then each file's uncovered lines — and return the total percentage (an int 0-100)."
  (let (results (coverage-line-results source-dirs)
        total (fold (fn (n r) (+ n (get r :total))) 0 results)
        covered (fold (fn (n r) (+ n (get r :covered))) 0 results))
    (if (empty? results)
      (do
        (println "")
        (println "coverage: no instrumented lines to measure")
        100)
      (do
        (println "")
        (println "Line coverage (executable lines that ran):")
        (fold (fn (_ r)
                (println (str "  "
                           (pad-right (coverage-relative (get r :file) root) 44)
                           (pad-left (str (coverage-percent (get r :covered) (get r :total))) 4)
                           "%  ("
                           (get r :covered)
                           "/"
                           (get r :total)
                           ")")))
          nil results)
        (fold
          (fn (_ r)
            (unless (empty? (get r :missing))
              (println "")
              (println (str "Never ran in "
                         (coverage-relative (get r :file) root)
                         " ("
                         (count (get r :missing))
                         " line"
                         (if (= (count (get r :missing)) 1) "" "s")
                         "):"))
              ;; Capped: a barely-exercised file would print hundreds of numbers and
              ;; bury the summary. The count above is the truth.
              (println (str "  "
                         (join ", " (map (fn (l) (str l)) (take 24 (get r :missing))))
                         (if (> (count (get r :missing)) 24) ", …" "")))))
          nil
          results)
        (println "")
        (println (str "coverage: "
                   (coverage-percent covered total)
                   "% of "
                   total
                   " executable lines ("
                   covered
                   " ran)"))
        (coverage-percent covered total)))))

;; ---- branch coverage (ADR-148 tier 2, the third measure) --------------------
;; Line coverage answers "did this line run?"; branch coverage answers the sharper
;; question "were BOTH sides of each decision taken?" — a line with an `if` counts as
;; covered the moment it runs once, even if the else-branch never fires. The kernel
;; records each edge as `[line col taken]` (keyed by the TEST's position so sibling
;; `cond`/`match` arms on shared lines stay distinct); a branch is fully covered only
;; when both a `true` and a `false` edge appear for one `[line col]`.

(defn- coverage-branch-edges
  (edges)
  "Fold a file's `[line col taken]` edge list into `{[line col] -> {:t bool :f bool}}`."
  (fold (fn (m edge)
          (let (key [(vector-ref edge 0) (vector-ref edge 1)]
                cur (get m key {:t false :f false}))
            (assoc m key (if (vector-ref edge 2) (assoc cur :t true) (assoc cur :f true)))))
    {}
    edges))

(defn- coverage-branch-taken-index
  ()
  "`file -> {[line col] -> {:t :f}}` — which edges of each branch ran."
  (fold (fn (index entry)
          (assoc index (vector-ref entry 0) (coverage-branch-edges (vector-ref entry 1))))
    {}
    (or (coverage-safely (fn () (%coverage-branches))) nil)))

(defn- coverage-branch-sites-index
  ()
  "`file -> ([line col] …)` — every instrumented branch point (the denominator)."
  (fold (fn (index entry) (assoc index (vector-ref entry 0) (vector-ref entry 1)))
    {}
    (or (coverage-safely (fn () (%coverage-branch-instrumented))) nil)))

(defn- coverage-branch-state
  (taken site)
  "For branch point `site` (`[line col]`), given the file's taken-edge map, return
`:both` (fully covered), `:then` / `:else` (one edge), or `:none` (never reached)."
  (let (e (get taken site {:t false :f false}))
    (cond
      (and (get e :t) (get e :f)) :both
      (get e :t) :then
      (get e :f) :else
      else :none)))

(defn coverage-branch-results (source-dirs)
  "Per-file branch coverage as a list of `{:file :total :covered :partial :missing}`:
`covered` = branches with both edges taken, `partial` = the `[line col state]` triples
with exactly one edge taken, `missing` = the `[line col]` points never reached. Only
files under `source-dirs` are measured; files with no branches are omitted."
  (require 'project)
  (let (taken-by-file (coverage-branch-taken-index)
        sites-by-file (coverage-branch-sites-index)
        files (or (coverage-safely (fn ()
                                     (fold (fn (acc dir)
                                             (append acc (project/project-collect-sources dir)))
                                       nil source-dirs)))
                nil))
    (filter (fn (result) (> (get result :total) 0))
      (map (fn (path)
             (let (sites (or (get sites-by-file path) nil)
                   taken (or (get taken-by-file path) {})
                   states (map (fn (s) [s (coverage-branch-state taken s)]) sites)
                   covered (filter (fn (st) (= (second st) :both)) states)
                   partial (filter (fn (st) (or (= (second st) :then) (= (second st) :else)))
                             states)
                   missing (filter (fn (st) (= (second st) :none)) states))
               {:file path
                :total (count sites)
                :covered (count covered)
                :partial (map (fn (st) [(first (first st)) (second (first st)) (second st)])
                           partial)
                :missing (map (fn (st) (first st)) missing)}))
        files))))

(defn- coverage-branch-line
  (root r)
  (println (str "  "
             (pad-right (coverage-relative (get r :file) root) 44)
             (pad-left (str (coverage-percent (get r :covered) (get r :total))) 4)
             "%  ("
             (get r :covered)
             "/"
             (get r :total)
             ")")))

(defn- coverage-branch-detail
  (root r)
  (let (partial (get r :partial))
    (unless (empty? partial)
      (println "")
      (println (str "Half-covered branches in "
                 (coverage-relative (get r :file) root)
                 " (one edge never taken):"))
      (fold
        (fn (_ p)
          ;; p = [line col state]; state :then means the ELSE edge never fired
          (println (str "  "
                     (first p)
                     ":"
                     (second p)
                     "  "
                     (if (= (nth p 2) :then) "else-branch never taken" "then-branch never taken"))))
        nil
        (take 24 partial)))))

(defn coverage-branch-report (root source-dirs)
  "Print the branch-coverage report — a per-file percentage of fully-covered branches
(both edges taken), then each file's half-covered branches — and return the total
percentage (an int 0-100)."
  (let (results (coverage-branch-results source-dirs)
        total (fold (fn (n r) (+ n (get r :total))) 0 results)
        covered (fold (fn (n r) (+ n (get r :covered))) 0 results))
    (if (empty? results)
      (do
        (println "")
        (println "branch coverage: no branches to measure")
        100)
      (do
        (println "")
        (println "Branch coverage (both edges of each if/cond/match taken):")
        (fold (fn (_ r) (coverage-branch-line root r)) nil results)
        (fold (fn (_ r) (coverage-branch-detail root r)) nil results)
        (println "")
        (println (str "branch coverage: "
                   (coverage-percent covered total)
                   "% of "
                   total
                   " branches fully covered ("
                   covered
                   " both-edges)"))
        (coverage-percent covered total)))))
