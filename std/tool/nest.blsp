;; std/tool/nest.blsp — the `nest` command line, in Brood (ADR-322).
;;
;; `nest` is a thin shell over the project tooling, the way `brood` bootstraps into
;; `(repl/run)` (ADR-048). `main.rs` routes a subcommand whose name is in its
;; `BLSP_SUBCOMMANDS` here BEFORE clap sees it. What stays in Rust is what needs Rust: building the
;; interpreter, the exit code, the crash dump, the stdlib-image bootstrap, the process-wide
;; knobs that must be set before the interpreter exists (the scheduler pool size, the
;; coverage env flags), `stdimage` (KI-112), and `release`'s byte assembly and boot check.
;;
;; `(nest/main argv)` returns the process exit code as an int; it never exits itself, so it
;; can be called from a test in-image. Errors it does not expect propagate: the Rust side
;; reports them and exits 1.

(defmodule nest
  "The `nest` command line: argv parsing and dispatch for the subcommands implemented in
Brood (ADR-322). `(nest/main argv)` runs one and returns its exit code.")

;; ── the command table ────────────────────────────────────────────────────────────────
;;
;; One entry per subcommand: its one-line help, its flags, an optional positional, and the
;; `run` function. A flag's spec is `:bool`, the NAME of the value it takes (`"DIR"`), or a
;; map `{:value "N" :int [lo hi] :repeat true :complete "kind"}` — an integer in range
;; (either bound nil for open), repeatable (collected into a list), completed by a
;; `complete/print-candidates` kind. A flag on its way out is `{:deprecated "VERSION" :use
;; "--new"}` (or, with no replacement, `{:deprecated "VERSION" :bool true}` / `:value
;; "NAME"`): it keeps working, warns, and drops out of completion (`resolve-flag`). A positional is `[name values]`: its allowed values as a
;; list, the name of a completion kind for free text, or nil. `:many true` admits any number
;; of positionals; `:trailing true` hands every word after the first positional through
;; unparsed, hyphens included; `:arity n` demands exactly n and `:arity [lo hi]` between lo
;; and hi (hi nil for no bound), named by `:names` in usage and in the missing-argument error. The clap constraints a command had are data too: `:requires {flag
;; needed-flag}`, `:conflicts [[a b] …]` and `:no-positional-with [flag …]`. Completion
;; (`nest complete`) reads the same table, so a flag added here is completable the same day —
;; the property the Rust side got from clap's own model, kept by making the table the model.

(def- *commands*
  {"doc" {:about "Emit Markdown documentation — the whole project, or one named module."
          :flags {"--all" :bool}
          :positional ["module" "module"]
          :run (fn (options) (run-doc options))}
   "docs" {:about "Generate a browsable HTML documentation site from docstrings (default `doc/`)."
           :flags {"--all" :bool "--out" "DIR" "-o" "DIR"}
           :run (fn (options) (run-docs options))}
   "doctest" {:about "Check every `expr ;=> result` docstring example still holds, or, given markdown FILEs, run their ```clojure, ```lisp and ```brood blocks (each in a process of its own; ```clojure fragment opts one out), or, given .blsp FILEs, the docstring examples of the names those files define (FILE:LINE per failure); exit non-zero on a mismatch."
              :flags {}
              :positional ["file" nil]
              :many true
              :run (fn (options) (run-doctest options))}
   "grammar" {:about "Emit an editor syntax grammar generated from `(reflect/special-forms)` (ADR-092), to stdout."
              :flags {}
              :positional ["target" ["tmlanguage" "emacs" "tree-sitter"]]
              :run (fn (options) (run-grammar options))}
   "format" {:about "Format every `.blsp` in the project (`--check`: CI mode, `--changed`: git-narrowed)."
             :flags {"--check" :bool "-c" :bool "--changed" :bool}
             :run (fn (options) (run-format options))}
   "check" {:about "Advisory type-check the project (every `.blsp` under `src/` + `tests/`), or specific files; exit non-zero on any warning."
            :flags {"--fix-renames" :bool
                    "--dry-run" :bool
                    "--suggest-sigs" :bool
                    "--fix-sigs" :bool
                    "--strict" :bool}
            :positional ["file" "blsp-file"]
            :many true
            :requires {"--dry-run" "--fix-renames"}
            :conflicts [["--suggest-sigs" "--fix-renames"]
                         ["--fix-sigs" "--fix-renames"]
                         ["--fix-sigs" "--suggest-sigs"]]
            ;; The rewrite is project-wide, so scoping it to a file list would fix one
            ;; caller and leave the rest.
            :no-positional-with ["--fix-renames"]
            :run (fn (options) (run-check options))}
   "test" {:about "Run the project's tests (every `tests/**/*_test.blsp`), or specific test files — `FILE`, or `FILE:LINE` for the one test at that line. `--watch` stays up and reruns on every save: the named files, or the test files a change reaches. `--doc FILE…` checks the `form ;=> result` docstring examples of those SOURCE files instead, each failure as FILE:LINE."
           :flags {"--only" {:value "SELECTOR" :repeat true :complete "selector"}
                   "--exclude" {:value "SELECTOR" :repeat true :complete "selector"}
                   "--include" {:value "SELECTOR" :repeat true :complete "selector"}
                   "--failed" :bool
                   "--max-failures" {:value "N" :int [1 nil]}
                   "--repeat-until-failure" {:value "N" :int [1 nil]}
                   "--seed" {:value "N" :int [0 nil]}
                   "--timeout" {:value "MS" :int [1 nil]}
                   "--slowest" {:value "N" :int [1 nil]}
                   "--partitions" {:value "N" :int [1 nil]}
                   "--shard" {:value "K" :int [0 nil]}
                   "--trace" :bool
                   "--formatter" "NAME"
                   "--stale" :bool
                   "--cover" :bool
                   "--cover-lines" :bool
                   "--cover-branches" :bool
                   "--cover-min" {:value "PCT" :int [0 100]}
                   ;; keep the real XDG config / state / data homes, not a scratch one (ADR-602)
                   "--real-home" :bool
                   "--watch" :bool}
           :positional ["file" "test-file"]
           :many true
           ;; a watch reruns per save; these each want one run's whole result
           :conflicts [["--watch" "--cover"]
                        ["--watch" "--cover-lines"]
                        ["--watch" "--cover-branches"]
                        ["--watch" "--cover-min"]
                        ["--watch" "--repeat-until-failure"]
                        ["--watch" "--stale"]]
           :run (fn (options) (run-test options))}
   "run" {:about "Run the project's entry point (`:main`, default `main/main`), or a `.blsp` FILE with the project's sources reachable; a non-`.blsp` FILE is handed to `:main` as a document. Outside a project FILE is required and runs like `brood FILE`. Trailing words go to the entry function as strings."
          :flags {"--watch" {:value "PATH" :repeat true}
                  "--for" "DURATION"
                  "--main" {:value "MODULE[/FN]" :complete "project-module"}
                  "--name" "NAME"
                  "--check-boot" :bool
                  "--no-check" :bool}
          :positional ["file" "blsp-file"]
          :many true
          ;; After FILE every word is the program's, hyphens included (clap's
          ;; `trailing_var_arg` + `allow_hyphen_values`).
          :trailing true
          :conflicts [["--check-boot" "--watch"]
                       ["--check-boot" "--for"]
                       ["--check-boot" "--no-check"]]
          :no-positional-with ["--check-boot"]
          :run (fn (options) (run-run options))}
   "new" {:about "Scaffold a new project: NAME becomes the directory and the manifest's `:name` (`.` scaffolds into the current directory). `--template` picks the starter code; an unknown name lists the set. `--from SOURCE` takes the starter from a package instead — a path, a git URL (`url#ref`) or a registry name — whose manifest declares `:templates` (ADR-424); `--template` then names one of those."
          :flags {"--template" {:value "NAME" :complete "template"}
                  "-t" {:value "NAME" :complete "template"}
                  "--from" "SOURCE"}
          :positional ["name" nil]
          :arity 1
          :run (fn (options) (run-new options))}
   "update-tooling" {:about "Refresh the AI-assistant tooling `nest new` drops into a project — `docs/brood-for-claude.md` and the `.claude/skills/writing-brood` skill — from THIS binary. Run it after upgrading Brood; code, manifest and `CLAUDE.md` are left untouched."
                     :flags {}
                     :run (fn (options) (run-update-tooling options))}
   "update-brood" {:about "Update the installed `brood`, `nest` and `brood-lsp` to the latest GitHub release (what `install.sh` installs), checked against its SHA-256 and written into the directory this `nest` runs from. `--check` only reports; `--version TAG` installs that release; `--dir DIR` installs somewhere else."
                   :flags {"--check" :bool
                           "--version" "TAG"
                           "--dir" "DIR"}
                   :conflicts [["--check" "--version"]]
                   :run (fn (options) (run-update-brood options))}
   "rename" {:about "Context-aware rename of an identifier across the project's `.blsp` sources: OLD → NEW, leaving docstrings, comments and quoted data alone unless asked."
             :flags {"--swap" :bool
                     "--refs-only" :bool
                     "--defs-only" :bool
                     "--in-quote" :bool
                     "--text" :bool}
             :positional ["old" nil]
             :names ["old" "new"]
             :arity 2
             :conflicts [["--refs-only" "--defs-only"]
                          ["--refs-only" "--swap"]
                          ["--defs-only" "--swap"]
                          ["--in-quote" "--swap"]
                          ["--text" "--refs-only"]
                          ["--text" "--defs-only"]
                          ["--text" "--in-quote"]]
             :run (fn (options) (run-rename options))}
   "move" {:about "Move definitions to another module: `nest move FROM.blsp TO.blsp NAME…` takes each NAME's top-level definition (with its `sig`, the comments above it and any `check-allow` around it) out of FROM and appends it to TO (created, `:use`-ing what FROM does, when missing), then points every reference at TO — `from/NAME` in code and quoted data, a bare NAME in a file that `:use`s FROM. The moved code reaches what it left behind as `from/HELPER`; a private name reached across is made public. Says when the two modules would reach each other."
           :flags {}
           :positional ["from" nil]
           :names ["from" "to" "names"]
           :arity [3 nil]
           :trailing true
           :run (fn (options) (run-move options))}
   "fetch" {:about "Resolve the project's dependencies and write project.lock.blsp (ADR-037): a `:path` dep must exist and records its content hash."
            :flags {}
            :run (fn (options) (run-fetch options))}
   "update" {:about "Re-resolve dependency refs and re-lock, advancing moving refs. With no NAMES every dependency; with NAMES only those, the rest keep their pins."
             :flags {}
             :positional ["name" "dep"]
             :many true
             :run (fn (options) (run-update options))}
   "tree" {:about "Print the project's resolved dependency tree (root → direct → transitive)."
           :flags {}
           :run (fn (options) (run-tree options))}
   "add" {:about "Add a dependency to project.blsp and re-lock: `nest add NAME :path PATH` (NAME is the local require-name; the manifest is rewritten preserving its comments)."
          :flags {}
          :positional ["name" nil]
          :names ["name" "spec"]
          :arity [1 nil]
          :trailing true
          :run (fn (options) (run-add options))}
   "remove" {:about "Remove a dependency from project.blsp and re-lock."
             :flags {}
             :positional ["name" "dep"]
             :arity 1
             :run (fn (options) (run-remove options))}
   "publish" {:about "Publish this project's release to the hosted package registry (a source tarball + sha256, Bearer-authenticated; releases are immutable). `--source-url` publishes an EXTERNAL release — metadata only, the URL fetched once for its checksum. `--bump LEVEL` bumps the project's own :version (patch/minor/major), commits, then publishes."
              :flags {"--source-url" "URL" "--bump" "LEVEL"}
              :positional ["index" nil]
              :arity [0 1]
              :run (fn (options) (run-publish options))}
   "search" {:about "Search the package registry for a term (name or description). INDEX overrides the configured `:registry`; `--enhances APP` keeps only packages that declare they plug into that application."
             :flags {"--enhances" "APP"}
             :positional ["query" nil]
             :names ["query" "index"]
             :arity [1 2]
             :run (fn (options) (run-search options))}
   "key" {:about "Manage the ed25519 signing key `nest publish` uses (ADR-212): `nest key gen` writes it 0600 under the config dir and prints the public key to share; `--force` replaces an existing one."
          :flags {"--force" :bool}
          :positional ["action" ["gen"]]
          :arity 1
          :run (fn (options) (run-key options))}
   "ws" {:about "Drive every sibling Brood repo in the workspace at once: list | status | check | commit \"MESSAGE\" | push. Discovers the siblings of the current directory (a `.git` + `project.blsp`, plus `brood`)."
         :flags {}
         :positional ["action" ["list" "status" "check" "commit" "push"]]
         :names ["action" "message"]
         :arity [1 2]
         :run (fn (options) (run-ws options))}
   "repl" {:about "Start a REPL. Inside a project every source file is pre-loaded and the prompt starts in the project's main namespace, so its functions are callable bare; outside one, the plain language REPL (`brood` would do the same). Ctrl-D exits."
           :flags {}
           :run (fn (options) (run-repl options))}
   "eval" {:about "Evaluate EXPRESSION once, with the project loaded as `nest repl` loads it, and print the value: a question about the project answered without a probe file. `--in MODULE` evaluates inside that module, its private names visible as they are to its own code (what a test's `:use-internals` gives). `--test` runs it as a test sees the world: a test run's mark (`test/running?`) and its scratch home, so nothing it does reaches your real config. `-` reads the expression from stdin, so a heredoc needs no shell quoting. Every form is evaluated and the last one's value printed, re-readable (`pr-str`); what the code prints comes first. An error is reported as `nest run` reports one, exit 1."
           :flags {"--in" "MODULE"
                   "--test" :bool}
           :positional ["expression" nil]
           :many true
           ;; everything after the first word of the expression is the expression's, so
           ;; `--` and hyphens inside it are never read as flags
           :trailing true
           :run (fn (options) (run-eval options))}
   "observe" {:about "Open a live process observer — a full-screen TUI of processes, status, mailbox and memory (ADR-046). With no `--connect`, a standalone demo over a fresh runtime's own processes; with `--connect name@host:port`, attach to a RUNNING program over the node link (it must have called `node-start` + `observe-serve`). `q`/Esc/Ctrl-C quits."
              :flags {"--connect" "NODE" "--cookie" "COOKIE"}
              :run (fn (options) (run-observe options))}
   "attach" {:about "Attach this terminal — or, with `--gui`, a native window — to a `ui-run` app served by a running daemon — the `emacsclient` to its `--daemon` (ADR-090). SPEC is the served node: a bare `name` over the local Unix socket, or `name@host:port` over TCP. The cookie comes from `--cookie`, `$BROOD_COOKIE`, else the shared `~/.config/brood/cookie`. The app's own quit key detaches; the window's X does too. `--gui` is the frontend as its own process: the app runs headless in the daemon and this window is all the display it has (a game served by b2d, an editor served by bedit)."
             :flags {"--cookie" "COOKIE" "--gui" :bool}
             :positional ["spec" nil]
             :arity 1
             :run (fn (options) (run-attach options))}
   "profile" {:about "Run a `.blsp` FILE under the sampling CPU profiler (`dev/profile-start`) and write the samples as folded stacks — the format flamegraph.pl, inferno and speedscope read — to `--out` (default FILE.folded). The file is loaded, then `--function` (default its `main`) is called; `--hz` sets the rate (default 199)."
              :flags {"--out" "PATH" "--hz" "N" "--function" "NAME"}
              :positional ["file" nil]
              :arity 1
              :run (fn (options) (run-profile options))}
   "dap" {:about "Serve the Debug Adapter Protocol on 127.0.0.1 (ADR-452), so VS Code, Emacs (dape), Neovim and Zed can debug a Brood program: function and line breakpoints, the paused processes as threads, their locals, evaluate, continue. Prints the port (`--port` picks it); point the editor at it — VS Code `\"debugServer\": PORT`. Runs until killed."
          :flags {"--port" "PORT"}
          :run (fn (options)
                 (let (port (string/->number (or (get (get options :flags) "--port") "0")))
                   (if (int? port)
                     (dap/main port)
                     (do (io/puts "nest dap: --port wants a number" :to *err*) 2))))}
   "mcp" {:about "Serve the project over Model Context Protocol on stdio, so an agent (Claude Code etc.) can eval / lookup / format / expand / run tests / read docs against its live image (ADR-036, docs/mcp.md)."
          :flags {}
          :run (fn (_options) (if (require-project "mcp" nil) (mcp/main) 2))}
   "completions" {:about "Print a shell integration script enabling TAB completion for `nest` — install it by sourcing: bash `eval \"$(nest completions bash)\"`, zsh `eval \"$(nest completions zsh)\"`, fish `nest completions fish | source`."
                  :flags {}
                  :positional ["shell" ["bash" "zsh" "fish"]]
                  :arity 1
                  :run (fn (options) (run-completions options))}
   ;; Hidden: the candidate engine the shell scripts call on every keypress
   ;; (`nest complete -- <words…>`), not a command a person types.
   "complete" {:about "Print completion candidates for a partial command line, one per line (used by the scripts from `nest completions`; not usually run by hand). Always exits 0 — a completion must never fail."
               :hidden true
               :flags {}
               :positional ["words" nil]
               :many true
               :trailing true
               :run (fn (options) (run-complete options))}})

;; Short flags are aliases; canonicalise on parse so handlers read one spelling.
(def- *short-aliases* {"-c" "--check" "-o" "--out" "-t" "--template"})

(defn subcommands ()
  "The subcommands this module implements, sorted — hidden ones (`complete`) excluded.

    (nest/subcommands)   ;~> (\"add\" \"check\" \"reflect/doc\" … \"ws\")"
  (sort (seq/filter (keys *commands*) (fn (cmd) (not (get (get *commands* cmd) :hidden))))))

(defn- command-spec (cmd)
  "`cmd`'s table entry: this module's, else the Rust-side mirror's (flags only), else nil."
  (or (get *commands* cmd) (get *rust-commands* cmd)))

(defn flags-of (cmd)
  "The flag spellings of `cmd` — Brood-side or Rust-side — sorted; `()` for an unknown one.

    (includes? (nest/flags-of \"format\") \"--check\")  ;=> true
    (nest/flags-of \"no-such-command\")              ;=> nil"
  ;; a deprecated flag still parses, but is not offered: no one should learn it new
  (let (spec (command-spec cmd))
    (if spec
      (sort (seq/filter (keys (get spec :flags))
              (fn (flag) (not (flag-deprecated (get (get spec :flags) flag))))))
      (list))))

(defn- positional-values-of (spec)
  "The allowed values of `spec`'s positional — `()` when it is free text or absent."
  (let (values (and spec (get spec :positional) (nth (get spec :positional) 1)))
    (if (or (list? values) (vector? values)) values (list))))

(defn- positional-kind (spec)
  "The `complete/print-candidates` kind of `spec`'s free-text positional, or nil."
  (let (values (and spec (get spec :positional) (nth (get spec :positional) 1)))
    (if (string? values) values nil)))

(defn positional-values (cmd)
  "The allowed values of `cmd`'s positional, or `()` when it is free text or absent.

    (nest/positional-values \"grammar\")  ;=> [\"tmlanguage\" \"emacs\" \"tree-sitter\"]"
  (positional-values-of (get *commands* cmd)))

(defn- positional-names (spec)
  "The positional names, in order: `:names` for an `:arity` command, else the one positional."
  (or (get spec :names) (if (get spec :positional) (list (nth (get spec :positional) 0)) (list))))

;; ── argv → options ───────────────────────────────────────────────────────────────────

(defn- flag-kind (spec word)
  (let (flags (get spec :flags))
    (or (get flags word) (get flags (get *short-aliases* word)))))

(defn- flag-value-name (kind)
  "The `<NAME>` a valued flag shows in usage and errors."
  (if (map? kind) (get kind :value) kind))

(defn- flag-repeat? (kind)
  (and (map? kind) (get kind :repeat)))

(defn- flag-complete-kind (kind)
  (and (map? kind) (get kind :complete)))

(defn- flag-deprecated (kind)
  (and (map? kind) (get kind :deprecated)))

;; A flag on its way out (road-to-1.0 §B5): `{:deprecated "0.52.0" :use "--new"}` keeps
;; working with a warning on stderr, its value stored under `--new` so the command reads one
;; name; without `:use`, the map says its own shape (`:bool true`, or `:value "NAME"`). Help
;; marks it and completion stops offering it, so no one learns it new.
(defn- resolve-flag (spec word)
  "`[canon kind warning]` for `word` under `spec`, or nil for a flag `spec` does not have.
`kind` is `:bool` or a valued spec; `warning` is nil unless the flag is deprecated."
  (let (kind (flag-kind spec word)
        canon (or (get *short-aliases* word) word))
    (cond
      (nil? kind) nil
      (flag-deprecated kind)
        (let (replacement (get kind :use)
              target-kind (if replacement (flag-kind spec replacement) nil))
          [(or replacement canon)
            (cond
              target-kind target-kind
              (get kind :bool) :bool
              else kind)
            (str "'"
              word
              "' is deprecated since "
              (flag-deprecated kind)
              (if replacement (str " — use '" replacement "'") ""))])
      else [canon kind nil])))

(defn- store-flag (acc canon kind value)
  "Record `value` for `canon`: a repeatable flag collects a list, any other keeps the last."
  (let (flags (get acc :flags))
    (assoc acc
      :flags
        (assoc flags
          canon (if (flag-repeat? kind) (append (or (get flags canon) (list)) (list value)) value)))))

(defn- split-eq (word)
  "`--out=DIR` → `[\"--out\" \"DIR\"]`; anything else → `[word nil]`."
  ;; `index-of` answers -1 for a miss, not nil.
  (let (i (index-of word "="))
    (if (and (>= i 0) (string/starts-with? word "--"))
      [(string/substring word 0 i) (string/substring word (+ i 1))]
      [word nil])))

(defn- parse-words (spec words acc)
  "Fold `words` into `{:flags {} :positionals () :error nil}`. Unknown flag → `:error`; a
`--help`/`-h` read as nest's own flag sets `:help`."
  (if (empty? words)
    acc
    (let ([word inline] (split-eq (first words))
          rest-words (rest words))
      (cond
        (= word "--") (assoc acc :positionals (append (get acc :positionals) rest-words))
        (or (= word "--help") (= word "-h")) (parse-words spec rest-words (assoc acc :help true))
        ;; a lone `-` is a positional — stdin, by the Unix convention clap follows too
        (and (string/starts-with? word "-") (not (= word "-")))
          (let (resolved (resolve-flag spec word)
                [canon kind warning] (or resolved [nil nil nil])
                acc (if warning (assoc acc :warnings (conj (get acc :warnings []) warning)) acc))
            (cond
              (nil? resolved) (assoc acc :error (str "unexpected argument '" word "'"))
              (and (= kind :bool) inline)
                (assoc acc
                  :error
                    (str "unexpected value '"
                      inline "' for '" word "' found; no more were expected"))
              (= kind :bool)
                (parse-words spec rest-words (assoc acc :flags (assoc (get acc :flags) canon true)))
              inline (parse-words spec rest-words (store-flag acc canon kind inline))
              (empty? rest-words)
                (assoc acc
                  :error
                    (str "a value is required for '"
                      word
                      " <"
                      (flag-value-name kind)
                      ">' but none was supplied"))
              else
                (parse-words spec (rest rest-words) (store-flag acc canon kind (first rest-words)))))
        (get spec :trailing)
          (assoc acc :positionals (append (get acc :positionals) (cons word rest-words)))
        else
          (parse-words spec
            rest-words
            (assoc acc :positionals (append (get acc :positionals) (list word))))))))

(defn- arity-bounds (spec)
  "`:arity` as `[lo hi]` — `n` is `[n n]`, `[lo nil]` is unbounded above; nil when unset."
  (let (arity (get spec :arity))
    (cond (nil? arity) nil (int? arity) [arity arity] else [(nth arity 0) (nth arity 1)])))

(defn- check-positional (spec parsed)
  "Reject a second positional (unless `:many`/`:arity`), one outside the allowed set, more
than `:arity` admits, or fewer than it demands."
  (let (positional (get spec :positional)
        positionals (get parsed :positionals)
        given (count positionals)
        allowed (positional-values-of spec)
        bounds (arity-bounds spec)
        lo (if bounds (nth bounds 0) 0)
        hi (if bounds (nth bounds 1) nil))
    (cond
      (get parsed :error) parsed
      (and (nil? positional) (not (empty? positionals)))
        (assoc parsed :error (str "unexpected argument '" (first positionals) "'"))
      (and (> given 1) (not (get spec :many)) (nil? bounds))
        (assoc parsed :error (str "unexpected argument '" (nth positionals 1) "'"))
      (and bounds hi (> given hi))
        (assoc parsed :error (str "unexpected argument '" (nth positionals hi) "'"))
      (and bounds (< given lo))
        (assoc parsed
          :error
            (str "the following required arguments were not provided:\n  "
              (string/join (map (take (drop (positional-names spec) given) (- lo given))
                             (fn (name) (str "<" (string/upper name) ">")))
                "\n  ")))
      (and (not (empty? allowed))
        (not (empty? positionals))
        (not (contains? (into #{} allowed) (first positionals))))
        (assoc parsed
          :error
            (str "invalid value '"
              (first positionals)
              "' for <"
              (string/upper (nth positional 0))
              ">\n  [possible values: "
              (string/join allowed ", ")
              "]"))
      else parsed)))

(defn- check-constraints (spec parsed)
  "The cross-flag rules clap enforced declaratively: `:requires`, `:conflicts`,
`:no-positional-with`. First violation wins, in clap's words."
  (let (flags (get parsed :flags)
        on? (fn (flag) (get flags flag))
        conflict (seq/find (get spec :conflicts)
                   (fn (pair) (and (on? (nth pair 0)) (on? (nth pair 1)))))
        missing (seq/find (seq (get spec :requires))
                  (fn ([flag needed]) (and (on? flag) (not (on? needed)))))
        lonely (seq/find (get spec :no-positional-with)
                 (fn (flag) (and (on? flag) (not (empty? (get parsed :positionals)))))))
    (cond
      (get parsed :error) parsed
      conflict
        (assoc parsed
          :error
            (str "the argument '" (nth conflict 0) "' cannot be used with '" (nth conflict 1) "'"))
      missing
        (assoc parsed
          :error (str "the following required arguments were not provided:\n  " (second missing)))
      lonely
        (assoc parsed
          :error
            (str "the argument '"
              lonely
              "' cannot be used with '["
              (string/upper (nth (get spec :positional) 0))
              "]...'"))
      else parsed)))

(defn- check-int-flag (acc flag kind)
  "One `:int [lo hi]` flag: its raw string becomes an int in range, or the parse fails in
clap's words."
  ;; `(and (map? kind) …)` would answer FALSE for a `:bool` or `"NAME"` spec, which a
  ;; `nil?` guard lets through to `nth` — so ask the map question first.
  (let (raw (get (get acc :flags) flag)
        range (if (map? kind) (get kind :int) nil))
    (if (or (get acc :error) (nil? range) (nil? raw))
      acc
      (let (n (string/->number raw)
            lo (nth range 0)
            hi (nth range 1)
            label (str "'" flag " <" (get kind :value) ">'"))
        (cond
          (not (int? n))
            (assoc acc
              :error (str "invalid value '" raw "' for " label ": invalid digit found in string"))
          (or (and lo (< n lo)) (and hi (> n hi)))
            (assoc acc
              :error
                (str "invalid value '"
                  raw
                  "' for "
                  label
                  ": "
                  n
                  " is not in "
                  (or lo "")
                  "..="
                  (or hi "")))
          else (assoc acc :flags (assoc (get acc :flags) flag n)))))))

(defn- check-int-flags (spec parsed)
  (fold (get spec :flags) parsed (fn (acc [flag kind]) (check-int-flag acc flag kind))))

(defn parse (cmd words)
  "Parse `words` (argv after the subcommand) against `cmd`'s table entry:
`{:flags {\"--all\" true …} :positionals (…) :error nil-or-message}`. An `:int` flag's value
arrives as an int; a `:repeat` flag's as a list. A deprecated flag adds its notice to
`:warnings`, which `main` prints before running the command.

    (nest/parse \"format\" [\"--check\"])  ;=> {:positionals nil, :flags {\"--check\" true}, :error nil}
    (get (nest/parse \"format\" [\"--bogus\"]) :error)  ;=> \"unexpected argument '--bogus'\""
  (parse-against (get *commands* cmd) words))

(defn- parse-against (spec words)
  "`parse` over a command table entry `spec` itself."
  (check-int-flags spec
    (check-constraints spec
      (check-positional spec (parse-words spec words {:flags {} :positionals (list) :error nil})))))

;; ── the plumbing the Rust arms had ───────────────────────────────────────────────────

(defn- eputs (& parts)
  (%eprint (str (apply str parts) "\n")))

(defn- positional-usage (spec)
  "`<REQUIRED>` up to `lo`, `[OPTIONAL]` up to `hi`, `[LAST]...` when unbounded."
  (let ([lo hi] (arity-bounds spec)
        names (positional-names spec)
        required (map (take names lo) (fn (name) (str " <" (string/upper name) ">")))
        optional (if hi
                   (map (drop (take names hi) lo) (fn (name) (str " [" (string/upper name) "]")))
                   (list (str " ["
                           (string/upper (if (> (count names) lo) (nth names lo) (last names)))
                           "]..."))))
    (apply str (append required optional))))

(defn- usage-line (cmd)
  (let (spec (get *commands* cmd) positional (get spec :positional))
    (str "Usage: nest "
      cmd
      (if (empty? (get spec :flags)) "" " [OPTIONS]")
      (cond
        (get spec :arity) (positional-usage spec)
        positional (str " [" (string/upper (nth positional 0)) "]" (if (get spec :many) "..." ""))
        else ""))))

(defn- usage (cmd)
  (let (spec (get *commands* cmd)
        positional (get spec :positional)
        allowed (positional-values-of spec))
    (io/puts (get spec :about))
    (io/puts "")
    (io/puts (usage-line cmd))
    (when (not (empty? allowed))
      (io/puts (str "  " (string/upper (nth positional 0)) ": one of " (string/join allowed ", "))))
    (when (not (empty? (get spec :flags)))
      (io/puts "Options:")
      (doseq (flag (sort (keys (get spec :flags))))
        (let ([_ kind warning] (resolve-flag spec flag))
          (io/puts (str "  "
                     flag
                     (if (= kind :bool) "" (str " <" (flag-value-name kind) ">"))
                     (if warning (str "  (" warning ")") ""))))))
    0))

(defn- require-project (cmd hint)
  "The project guard the Rust arms shared: outside a project, say so on stderr and return
false (the caller exits 2 — clap's usage-error code)."
  (if (project/find-root (file/cwd))
    true
    (do
      (eputs "nest " cmd ": no project.blsp in " (file/cwd) " or any parent directory.")
      (eputs "  Create one with `nest new <name>`, or cd into an existing project.")
      (when hint (eputs "  " hint))
      false)))

(defn- readable-files? (cmd files)
  "The boundary guard for a FILE list: every path must exist and not be a directory. Says
so at the CLI boundary and returns false (exit 2), rather than a trace from deep inside."
  (let (bad (seq/find files (fn (path) (not (file/regular? path)))))
    (cond
      (nil? bad) true
      (file/dir? bad)
        (do
          (eputs "nest " cmd ": " bad " is a directory, not a .blsp file.")
          (eputs "  Name the files, or omit them to cover the whole project.")
          false)
      else (do (eputs "nest " cmd ": cannot read " bad ": No such file or directory") false))))

;; ── the subcommands ──────────────────────────────────────────────────────────────────

(defn- run-doc (options)
  (let (all (get (get options :flags) "--all") module (first (get options :positionals)))
    (cond
      all (do (io/puts (docs/document-all)) 0)
      module (do (io/puts (docs/generate module)) 0)
      (require-project "doc"
        "For the builtin reference: nest doc --all; for one module: nest doc <module>")
        (do (io/puts (docs/generate)) 0)
      else 2)))

(defn- run-docs (options)
  (let (all (get (get options :flags) "--all") out (get (get options :flags) "--out"))
    (if (or all (require-project "docs" "For the language reference: nest docs --all"))
      (do
        (if all
          (if out (docs/generate-site-all out) (docs/generate-site-all))
          (if out (docs/generate-site out) (docs/generate-site)))
        0)
      2)))

(defn- run-doctest (options)
  (if (require-project "doctest" nil)
    (let (files (get options :positionals)
          sources (seq/filter files (fn (f) (string/ends-with? f ".blsp")))
          markdown (seq/filter files (fn (f) (not (string/ends-with? f ".blsp"))))
          failures (if (empty? files)
                     (docs/run-doctests)
                     (+ (if (empty? sources) 0 (run-source-doctests sources))
                       (if (empty? markdown) 0 (docs/run-markdown-doctests markdown)))))
      (if (and (int? failures) (> failures 0)) 1 0))
    2))

(defn- run-source-doctests (files)
  "The docstring examples of the source `files` (`nest doctest FILE.blsp`):
inside a project its image is loaded first, so a file's examples see the modules it uses.
Returns the failure count."
  (load-project-image)
  (require-one 'doctest)
  (docs/run-file-doctests files))

(defn- run-grammar (options)
  (let (target (or (first (get options :positionals)) "tmlanguage"))
    (io/puts (cond
               (= target "emacs") (grammar/emacs)
               (= target "tree-sitter") (grammar/tree-sitter-highlights)
               else (grammar/tmlanguage)))
    0))

(defn- run-format (options)
  (if (require-project "format" nil)
    (do
      (project/load-config)
      (let (flags (get options :flags))
        (cond
          ;; --check is CI's clean-tree gate: it must see the whole project, so --changed
          ;; does not narrow it (a stale committed file would slip by).
          (get flags "--check") (format/project-check)
          (get flags "--changed") (format/project-changed)
          else (format/project)))
      0)
    2))

(defn- checker-exit-code (result)
  "`project-check/check` and friends return a warning (or unresolved-name) count: 0 is clean."
  (cond
    (= result 0) 0
    (int? result) 1
    else (do (eputs "nest check: checker returned a non-integer (" (str result) ")") 1)))

(defn- run-check (options)
  (let (flags (get options :flags) files (get options :positionals))
    ;; Strict is a process-wide checker mode, not an argument, so it is set before the
    ;; first file is read. Only the flag is set here: the env spelling (`BROOD_CHECK_STRICT`)
    ;; is the kernel flag's own default, so every checker entry point reads it alike.
    (when (get flags "--strict") (%check-strict! true))
    (cond
      (get flags "--suggest-sigs")
        (do
          (project/load-config)
          (require-one 'test)
          (checker-exit-code (project-check/suggest-sigs files)))
      (get flags "--fix-sigs")
        (do
          (project/load-config)
          (require-one 'test)
          (checker-exit-code (project-check/fix-sigs files true)))
      (get flags "--fix-renames")
        (do
          (project/load-config)
          (require-one 'test)
          (checker-exit-code (project-check/fix-renames (not (get flags "--dry-run")))))
      (and (empty? files)
        (not (require-project "check" "To check one file outside a project: nest check <file>.blsp")))
        2
      (not (readable-files? "check" files)) 2
      ;; One checker, one path: both forms go through `project.blsp`, which loads the
      ;; project image first so cross-module names resolve (the single-file path once
      ;; skipped that and false-flagged every `:use`d name as unbound).
      (empty? files)
        (do (project/load-config) (require-one 'test) (checker-exit-code (project-check/check)))
      else (do (require-one 'test) (checker-exit-code (project-check/check-files files))))))

;; `nest test` ------------------------------------------------------------------------

(defn- split-file-line (arg)
  "`FILE:LINE` → `[FILE LINE]`; anything else → `[arg nil]`. A trailing `:N` is a line
selector; a name that merely contains a colon still loads."
  (let (i (string/last-index-of arg ":"))
    (if (and (int? i) (> i 0))
      (let (n (string/->number (string/substring arg (+ i 1) (count arg))))
        (if (int? n) [(string/substring arg 0 i) n] [arg nil]))
      [arg nil])))

(defn- file-lines (args)
  "The positional FILE list as `[paths lines]`: the distinct bare paths, in order, and the
`[path line]` selectors the `:LINE` suffixes named."
  (fold args
    [(list) (list)]
    (fn (acc arg)
      (let ([path line] (split-file-line arg) [paths lines] acc)
        [(if (includes? paths path) paths (append paths (list path)))
          (if line (append lines (list [path line])) lines)]))))

(defn- shard-error (flags)
  "A shard selection that would silently run nothing — `--shard` without `--partitions`, or
out of range — exits 0 having run zero tests, which in CI reads as green. Say so instead."
  (let (partitions (get flags "--partitions") shard (or (get flags "--shard") 0))
    (cond
      (and (nil? partitions) (not (= shard 0)))
        (str "--shard " shard " needs --partitions N (it is ignored without it)")
      (and partitions (>= shard partitions))
        (str "--shard "
          shard
          " is out of range for --partitions "
          partitions
          " (shards are 0-based, so use 0.."
          (- partitions 1)
          ")")
      else nil)))

(defn- test-opts (flags lines)
  "The option list `project-run/run-tests` and friends take, from the parsed flags: bare
keywords for switches, `keyword value` pairs otherwise, and a `:filter` only when something
narrows or reorders the run — the plain case passes none, so the runner keeps its fast path."
  (let (flag (fn (name) (get flags name))
        cover-lines (flag "--cover-lines")
        cover-branches (flag "--cover-branches")
        cover-min (flag "--cover-min")
        plain? (and (nil? (flag "--only"))
                 (nil? (flag "--exclude"))
                 (nil? (flag "--include"))
                 (empty? lines)
                 (nil? (flag "--seed"))
                 (nil? (flag "--partitions")))
        filter (if plain?
                 nil
                 (test-select/test-make-filter (flag "--only")
                   (flag "--exclude")
                   (flag "--include")
                   lines
                   nil
                   (flag "--seed")
                   (flag "--partitions")
                   (or (flag "--shard") 0)))
        when-flag (fn (name & items) (if (flag name) items (list))))
    (append (when-flag "--trace" :trace)
      (when-flag "--formatter" :formatter (flag "--formatter"))
      (when-flag "--stale" :stale)
      (when-flag "--failed" :failed)
      ;; `--cover-min` implies `--cover`: a floor without a measurement is never what
      ;; someone means. A line/branch run reports its own (stricter) number.
      (if (or (flag "--cover") (and cover-min (not cover-lines) (not cover-branches)))
        (list :cover)
        (list))
      (when-flag "--cover-lines" :cover-lines)
      (when-flag "--cover-branches" :cover-branches)
      (when-flag "--cover-min" :cover-min cover-min)
      (when-flag "--max-failures" :max-failures (flag "--max-failures"))
      (when-flag "--repeat-until-failure" :repeat (flag "--repeat-until-failure"))
      (when-flag "--timeout" :timeout (flag "--timeout"))
      (when-flag "--slowest" :slowest (flag "--slowest"))
      (if filter (list :filter filter) (list)))))

(defn- run-suite (thunk)
  "Run the suite and turn its verdict into an exit code. A red run throws the runner's
`:suite-failed` verdict (so `brood --test` exits non-zero); its failures are already
printed, so here it is a silent exit 1. Anything else (a broken manifest, an unloadable
file) propagates for the normal error report."
  (try
    (do (thunk) 0)
    (catch e (if (test/suite-failed? e) 1 (throw e)))))

(defn- run-test (options)
  (let (flags (get options :flags)
        [paths lines] (file-lines (get options :positionals))
        problem (shard-error flags))
    (cond
      problem (do (eputs "nest test: " problem) 2)
      (and (empty? paths)
        (not (require-project "test"
               "To run one file outside a project: nest test <file>_test.blsp")))
        2
      (not (readable-files? "test" paths)) 2
      (get flags "--watch")
        (do
          (if (empty? paths) (project/load-config) (load-project-image-lazily))
          (require-one 'test)
          (apply project-run/watch-tests paths (test-opts flags lines)))
      (empty? paths)
        (do
          (require-one 'test)
          (project/load-config)
          (run-suite (fn () (apply project-run/run-tests (test-opts flags lines)))))
      else
      ;; Named files, each in its own rolled-back scope (`run-named-tests`). Inside a
      ;; project its image is installed first, LAZILY: a test file's header and its first
      ;; use of a name materialise what it reaches, so one file of a large project does not
      ;; pay to materialise all of it (hatch: 90 ms of a 220 ms one-file run, 2026-11-13).
        (do
          (load-project-image-lazily)
          (require-one 'test)
          (run-suite (fn () (apply project-run/run-named-tests paths (test-opts flags lines))))))))

(defn- load-project-image ()
  "Inside a project, load its config and its sources (image-backed) and return the root;
outside one, nil."
  (let (root (project/find-root (file/cwd)))
    (when root
      (project/load-config)
      (project/setup-tooling-image root))))

(defn- load-project-image-lazily ()
  "Inside a project, load its config and install its image WITHOUT materialising a module —
`require` brings each in on first use, as `nest run` does — and return the root; outside one,
nil. With no current image the sources load (and write one) as usual."
  (let (root (project/find-root (file/cwd)))
    (when root
      (project/load-config)
      (project/setup root)
      (when (nil? (project-image/setup-lazy-image root))
        (project-image/load-sources-cached root :lazy))
      root)))

;; `nest run` -------------------------------------------------------------------------

(defn duration-ms (s)
  "`--for`'s DURATION as milliseconds: `2s`, `500ms`, `1.5s`, or a bare count of
milliseconds; nil for anything else (garbage, a negative).

    (nest/duration-ms \"1.5s\")   ;=> 1500
    (nest/duration-ms \"500ms\")  ;=> 500
    (nest/duration-ms \"soon\")   ;=> nil"
  (let (text (string/trim s)
        [digits scale] (cond
                         (string/ends-with? text "ms")
                           [(string/substring text 0 (- (count text) 2)) 1]
                         (string/ends-with? text "s")
                           [(string/substring text 0 (- (count text) 1)) 1000]
                         else [text 1])
        amount (string/->number (string/trim digits)))
    ;; `failure?` first and alone: the checker narrows `amount` on that test, not through an `or`.
    (if (failure? amount)
      nil
      (if (or (not (number? amount)) (< amount 0)) nil (math/floor (* amount scale))))))

(defn- run-wrapped (thunk timed-ms label)
  "`--watch`/`--for`: run the program as a linked process and park here on its exit. The link
is made before the child runs (`%spawn-link`, not spawn-then-`monitor`, whose `:noproc` race
read a finished program as a failure ~1 run in 6), and `proc/trap-exit` turns the exit into a
message. A `:normal` exit and the `--for` cap are success; a program that DIED is exit 1 — its
reason was already printed, so the caller exits silently."
  (proc/trap-exit true)
  (let (program (%spawn-link thunk))
    (if timed-ms
      (receive
        ([:EXIT ^program reason] (io/puts "[exit]" reason) (if (= reason :normal) 0 1))
        (after timed-ms (io/puts (str "[stopped after " label "]")) 0))
      (receive
        ([:EXIT ^program reason] (io/puts "[exit]" reason) (if (= reason :normal) 0 1))))))

(defn- run-program (root options)
  "`nest run` past the guards: `root` is the project root (nil outside one), `options` the
parsed command line."
  (let (flags (get options :flags)
        file (first (get options :positionals))
        args (rest (get options :positionals))
        watch (or (get flags "--watch") (list))
        for-spec (get flags "--for")
        main (get flags "--main")
        node-name (get flags "--name")
        in-project (not (nil? root))
        ;; A non-`.blsp` FILE inside a project is a DOCUMENT for the entry point (the editor
        ;; opens it), not a script: `nest run notes.txt` edits notes.txt. It need not exist —
        ;; creating a file is the ordinary editor case — so only a script path is checked.
        doc-arg (if (and file in-project (not (string/ends-with? file ".blsp"))) file nil)
        file (if doc-arg nil file)
        timed-ms (and for-spec (duration-ms for-spec)))
    (cond
      (and file (not (readable-files? "run" (list file)))) 2
      (and for-spec (nil? timed-ms))
        (do
          (eputs "nest run: invalid --for duration '" for-spec "' (use e.g. 2s, 500ms, or 1500)")
          2)
      else
        (let (
              ;; With no FILE, a single watched *file* is promoted to the entry to run.
              ;; Several can't be, so `:main` runs — say so once, since the user may have
              ;; expected one of them to run; a watched directory is the ordinary dev loop.
              promoted (if (and (nil? file)
                             (nil? doc-arg)
                             (= (count watch) 1)
                             (file/regular? (first watch)))
                         (first watch)
                         nil)
              watched-a-file (not (empty? (seq/filter watch file/regular?))))
          (when (and (nil? file) (nil? doc-arg) (nil? promoted) watched-a-file)
            (eputs "nest run: watching "
              (count watch)
              " files and running :main — none was run directly. (A single watched *file* is "
              "promoted to the entry to run; multiple files can't be, so :main runs.)"))
          (let (file (or file promoted)
                all-args (if doc-arg (cons doc-arg args) args)
                wrap (or (not (empty? watch)) (not (nil? timed-ms))))
            ;; Project setup. With no FILE `:main` runs, and `--main` overrides the manifest for
            ;; this run only; with a FILE the override is meaningless — warn rather than ignore
            ;; silently. Inside a project a FILE gets `src/` on the load path but no eager load
            ;; (a file under `src/` would otherwise run twice).
            (cond
              (nil? file) (do (project/load-config) (when main (project/set-project-main main)))
              in-project (do (project/load-config) (project/setup root))
              else nil)
            (when (and main file) (eputs "nest run: --main is ignored when a FILE is given"))
            ;; Advisory single-file pre-flight for an explicit FILE (`:main` runs check via
            ;; `project-run/run`); `BROOD_NO_CHECK=1` opts out, as everywhere.
            (when (and file (not (= (os/env "BROOD_NO_CHECK") "1")))
              (doseq (warning (%check-file file)) (io/puts warning :to *err*)))
            ;; `--name`: a local Unix-socket node before the program runs (the Emacs
            ;; `--daemon` model), so the file is pure app logic.
            (when node-name (node/start (keyword node-name)))
            ;; `--watch`: re-`load` on save; inside a project also re-check the sources (the
            ;; live trigger for ADR-123's soundness-under-reload).
            (when (not (empty? watch))
              (require-one 'reload)
              (let (on-reload (if in-project (fn (_path) (project-check/check-sources)) nil))
                (doseq (path watch) (reload/on-change path on-reload))))
            (let (thunk (cond
                          (nil? file)
                            (fn ()
                              (project-run/run all-args
                                (get flags "--no-check")
                                (not (empty? watch))))
                          ;; Unwrapped, a FILE runs as its own green process (ADR-135) so it
                          ;; matches `brood FILE`; wrapped it is already inside a spawn, and a
                          ;; nested program-process spawn+block would native-nest.
                          (not wrap) (fn () (%run-program-file file))
                          else (fn () (reflect/load file))))
              (if wrap
                (run-wrapped thunk timed-ms (and for-spec (string/trim for-spec)))
                (do (thunk) 0))))))))

(defn- run-run (options)
  (let (flags (get options :flags)
        file (first (get options :positionals))
        main (get flags "--main")
        root (project/find-root (file/cwd)))
    (cond
      (and (nil? file) (nil? root))
        (do
          (require-project "run" "To run one file outside a project: nest run <file>.blsp")
          2)
      ;; Load every module and resolve `:main`, run NOTHING (KI-66). `--main` still applies:
      ;; checking that a *specific* entry boots is the point when a project ships several.
      (get flags "--check-boot")
        (do
          (project/load-config)
          (when main (project/set-project-main main))
          (project-run/check-boot)
          0)
      else (run-program root options))))

;; `nest new`, `update-tooling`, `rename` ---------------------------------------------------

(defn- run-new (options)
  ;; `load-config` first: the user config decides e.g. whether the scaffold runs `git init`.
  (let (name (first (get options :positionals))
        flags (get options :flags)
        template (or (get flags "--template") (get flags "-t")))
    (project/load-config)
    (require-one 'scaffold)
    (scaffold/new-project name template (get flags "--from"))
    0))

(defn- run-update-tooling (options)
  (if (require-project "update-tooling" nil)
    (do (project/load-config) (scaffold/update-tooling) 0)
    2))

(defn- run-update-brood (options)
  ;; Not a project command: it updates the toolchain, from anywhere.
  (let (flags (get options :flags))
    (require-one 'update-brood)
    (update-brood/update {:version (get flags "--version")
                          :dir (get flags "--dir")
                          :check (get flags "--check")})))

(defn- run-rename (options)
  ;; The positionals are a LIST, so `[old new]` would not match — take them by position.
  (let (flags (get options :flags)
        old (first (get options :positionals))
        new (second (get options :positionals)))
    (cond
      ;; The context-blind whole-token replace, for a rename that must touch prose.
      (get flags "--text") (codemod/rename (list (list old new)))
      else
      ;; the flags compose: `--refs-only --in-quote` renames the references, quoted ones too
        (let (modes (seq/keep [["--swap" :swap]
                                ["--refs-only" :refs-only]
                                ["--defs-only" :defs-only]
                                ["--in-quote" :in-quote]]
                      (fn ([flag mode]) (when (get flags flag) mode))))
          (codemod/cst-rename old new (if (empty? modes) :all modes))))
    0))

(defn- run-move (options)
  (let (positionals (vec (get options :positionals)))
    (codemod/move (first positionals) (second positionals) (vec (drop positionals 2)))))

;; The package manager (ADR-037) ------------------------------------------------------

(defn- with-package (cmd module body)
  "The bootstrap every package command shares — the project, its config, `module` (`package`
or a verb module over it) — then `body`. `load-config` is load-bearing: the user config
supplies `:registry`, which a `:version` dependency resolves against."
  (if (require-project cmd nil)
    (do (project/load-config) (require-one module) (body) 0)
    2))

(defn- run-fetch (options)
  (with-package "fetch" 'package (fn () (package/fetch))))

(defn- run-update (options)
  (with-package "update" 'package (fn () (apply package/update (get options :positionals)))))

(defn- run-tree (options)
  (with-package "tree" 'package (fn () (package/tree))))

(defn- run-add (options)
  ;; `(add NAME & SPEC)` — the positionals are already in that shape.
  (with-package "add"
    'package-manifest
    (fn () (apply package-manifest/add (get options :positionals)))))

(defn- run-remove (options)
  (with-package "remove"
    'package-manifest
    (fn () (package-manifest/remove-dep (first (get options :positionals))))))

(defn- plist-when (key value)
  (if value (list key value) (list)))

(defn- run-publish (options)
  (with-package "publish"
    'package-publish
    (fn ()
      (let (flags (get options :flags)
            opts (append (plist-when :index (first (get options :positionals)))
                   (plist-when :source-url (get flags "--source-url"))))
        (if (get flags "--bump")
          (apply package-publish/release (get flags "--bump") opts)
          (apply package-publish/publish opts))))))

(defn- run-search (options)
  ;; `package-publish/search` resolves the registry through the project's config, so it needs
  ;; a project today — guard it for a clean message rather than an internal trace.
  (with-package "search"
    'package-publish
    (fn ()
      (let (query (first (get options :positionals))
            opts (append (plist-when :index (second (get options :positionals)))
                   (plist-when :enhances (get (get options :flags) "--enhances"))))
        (apply package-publish/search query opts)))))

(defn- run-key (options)
  ;; A user-level operation (a signing key in the config dir), not a project one.
  (project/load-config)
  (require-one 'package-publish)
  (if (get (get options :flags) "--force")
    (package-publish/key-gen :force true)
    (package-publish/key-gen))
  0)

(defn- run-ws (options)
  ;; A workspace command, not a project one — it drives the SIBLING repos. Exit 1 when any
  ;; repo's step failed.
  (if (> (workspace/run (first (get options :positionals)) (second (get options :positionals))) 0)
    1
    0))

;; `nest repl` ------------------------------------------------------------------------

(defn- run-repl (options)
  ;; The REPL is Brood (`std/tool/repl.blsp`, ADR-048), the same loop `brood` bootstraps
  ;; into. Inside a project, load its sources and start the prompt in the `:main` module so
  ;; a bare project fn resolves without qualification (the interactive half of package
  ;; rooting, ADR-070); other project modules still need their `mod/fn`. The raw-mode line
  ;; editor's normal teardown is its own `term-raw-leave`; the Rust router also holds a
  ;; terminal guard for a panic unwind.
  (if (load-project-image)
    (do
      (repl/start-in (first project/*main*))
      (eputs "nest repl — project sources loaded, in the project's main namespace; Ctrl-D to exit"))
    (eputs "nest repl — no project.blsp here; plain REPL (`brood` would do the same)"))
  (repl/run)
  0)

;; `nest eval` ------------------------------------------------------------------------
;; One expression, answered: what an agent (or a person at a shell) wants to know about a
;; project without writing a throwaway test file to ask it. The project loads as `nest repl`
;; loads it; `--in` moves into a module first; `--test` (armed in Rust before the runtime
;; exists, `arm_test_env`) gives a test run's scratch home.

(defn- stdin-text ()
  ;; all of stdin, its lines joined back with newlines
  (letrec (gather (fn (lines)
                    (let (line (io/read-line))
                      (if (nil? line) (string/join (reverse lines) "\n") (gather (cons line lines))))))
    (gather '())))

(defn eval-source (words)
  "The source `nest eval` evaluates, from its expression `words`: the words joined by spaces,
or all of stdin when the one word is `-`.

    (nest/eval-source (list \"(+\" \"1\" \"2)\"))   ;=> \"(+ 1 2)\""
  (if (= (vec words) ["-"]) (stdin-text) (string/join words " ")))

(defn- run-eval (options)
  (let (flags (get options :flags)
        source (eval-source (or (get options :positionals) []))
        module (get flags "--in"))
    (if (= (string/trim source) "")
      (do
        (eputs "nest eval: nothing to evaluate — give an expression, or `-` to read one from stdin")
        2)
      (do
        (load-project-image)
        ;; into the module, loaded first: its private names and its imports resolve bare
        (when (string? module)
          (let (name (symbol module))
            (require-one name)
            (%in-ns name)))
        (io/puts (pr-str (reflect/eval-string source)))
        0))))

;; `nest observe` / `nest attach` — the full-screen frontends -------------------------

(defn- require-terminal (cmd)
  "A full-screen TUI cannot be piped or redirected: say so at the boundary (exit 2) instead
of failing deep in the render loop with `terminal: No such device or address (os error 6)`
and an `editor/ui/ui-run` frame — technically true, and useless."
  (if (os/stdout-tty?)
    true
    (do
      (eputs "nest " cmd ": needs an interactive terminal — stdout is not a tty.")
      (eputs "  It draws a full-screen view, so it can't be piped or redirected.")
      (eputs "  To capture output for a test, run it under a pty: script -qec 'nest "
        cmd "' /dev/null")
      false)))

(defn- link-cookie (flag)
  "Cookie precedence for a node link: `--cookie`, then a non-empty `$BROOD_COOKIE`, else nil —
and nil means the connect function falls back to the shared cookie file itself (ADR-068),
so a matching local setup needs no flag."
  (let (env (os/env "BROOD_COOKIE"))
    (or flag (if (and env (not (= env ""))) env nil))))

(defn- run-observe (options)
  (let (flags (get options :flags)
        connect (get flags "--connect")
        cookie (link-cookie (get flags "--cookie")))
    (cond
      (not (require-terminal "observe")) 2
      ;; Remote attach: `observe-connect` dials the peer BEFORE taking the terminal, so a bad
      ;; host or wrong cookie is a clean error with the screen never entered.
      connect
        (do
          (if cookie (observer/observe-connect connect cookie) (observer/observe-connect connect))
          0)
      else
        (do
          ;; `--cookie` only authenticates a link, and the local demo makes none — say so
          ;; rather than accept a flag that does nothing.
          (when (get flags "--cookie")
            (eputs "nest observe: --cookie is ignored without --connect (the local demo opens no link)"))
          (observer/observe-run)
          0))))

(defn- run-profile (options)
  ;; load FILE, call its entry under the profiler, write the folded stacks
  (let (file (first (get options :positionals))
        flags (get options :flags)
        hz (string/->number (or (get flags "--hz") "199"))
        out (or (get flags "--out") (str file ".folded")))
    (cond
      (not (and (string? file) (file/exists? file)))
        (do (io/puts (str "nest profile: no such file: " file) :to *err*) 2)
      (not (int? hz)) (do (io/puts "nest profile: --hz wants a number" :to *err*) 2)
      else
        (let (_ (dev/profile-start hz)
              outcome (try
                        (do
                          (reflect/load file)
                          (let (module (profile-module file)
                                name (or (get flags "--function") "main")
                                entry (symbol (if (or (nil? module) (includes? name "/"))
                                                name
                                                (str module "/" name))))
                            (when (and (bound? entry) (fn? (reflect/eval entry)))
                              ((reflect/eval entry))))
                          :ok)
                        (catch e (failure (error-message e))))
              histogram (dev/profile-stop))
          (file/spit out (dev/profile->folded histogram))
          (io/puts (str "nest profile: "
                     (count histogram)
                     " stacks, "
                     (fold histogram 0 (fn (n entry) (+ n (:count entry))))
                     " samples -> "
                     out)
            :to *err*)
          (if (failure? outcome) (do (io/puts (error-message outcome) :to *err*) 1) 0)))))

(defn- profile-module (file)
  ;; the module a `.blsp` file declares on its `(defmodule NAME` line, or nil
  (let (line (seq/find (string/split (file/slurp file) "\n")
               (fn (l) (string/starts-with? l "(defmodule "))))
    (when line
      (first (string/split (first (string/split (string/trim (string/substring line 11 (count line)))
                                    ")"))
               " ")))))

(defn- run-attach (options)
  (let (spec (first (get options :positionals))
        cookie (link-cookie (get (get options :flags) "--cookie")))
    (cond
      ;; A window needs no terminal: the frontend is its own process, and the app it
      ;; attaches to tells it what kind of window it wants (`[:window …]`, ADR-374).
      (get (get options :flags) "--gui")
        (do
          (editor/attach/attach-display spec
            (editor/frontend/gui-display {:title (str "brood — " spec)})
            cookie)
          0)
      (require-terminal "attach")
        (do (if cookie (editor/attach/attach spec cookie) (editor/attach/attach spec)) 0)
      else 2)))

;; ── entry points ─────────────────────────────────────────────────────────────────────

;; Trusted, not verified: the exit code comes back through the command table's `:run`
;; closure, which the checker cannot type; every subcommand answers an int.
(check-allow :trusted
  (defn main (argv)
    "Run `argv` — the subcommand and its words, as a list of strings (what `main.rs` builds
with `blsp_string_list`) — and return the exit code. `--help`/`-h` where nest reads its own
flags prints the command's usage; after `--`, or among a `:trailing` command's program
words, it is the program's.

    (nest/main [\"check\" \"src/app.blsp\"])   ;~> 0 — the exit code"
    (let (cmd (first argv) spec (get *commands* cmd))
      (if (nil? spec)
        (do (eputs "nest: '" cmd "' is not implemented in std/tool/nest.blsp") 2)
        (let (options (parse cmd (rest argv)))
          (cond
            (get options :help) (usage cmd)
            (get options :error)
              (do
                (eputs "error: " (get options :error))
                (eputs "")
                (eputs (usage-line cmd))
                (eputs "")
                (eputs "For more information, try '--help'.")
                2)
            else
              (do
                (doseq (warning (seq/distinct (get options :warnings [])))
                  (eputs "nest " cmd ": warning: " warning))
                ((get spec :run) options))))))))
;; `list`, not `vector`: the router passes `(list "check" …)`, so a `vector` contract would
;; refuse every Brood-routed subcommand when contracts are armed (KI-113).
(sig main ((list string) -> int))

(defn- print-matching (candidates current)
  "Print each of `candidates` that starts with `current`, one per line, skipping empties."
  (doseq (candidate candidates)
    (when (and (not (= candidate "")) (string/starts-with? candidate current))
      (io/puts candidate))))

(defn complete (cmd prior current)
  "Print the completion candidates for `cmd` (a Brood-side or Rust-side subcommand) given
the words typed so far: the value of a flag left pending by the previous word (its
`:complete` kind, or nothing — the shell then falls back to filenames, which beats a wrong
list), flags when `current` starts with `-` (the command's own plus the global
`--max-parallel`), else the positional's allowed values or the candidates of its
kind (`doc`'s module names, `check`'s `.blsp` files, `test`'s test files). Never raises;
prints nothing when it cannot tell.

    (nest/complete \"test\" [\"--only\"] \"sl\")   ;~> nil — prints \"slow\", the matching selector"
  (try
    (let (spec (command-spec cmd)
          previous (last prior)
          pending (and previous
                    (string/starts-with? previous "-")
                    (not (includes? previous "="))
                    (let (kind (flag-kind spec previous)) (and kind (not (= kind :bool)) kind))))
      (when spec
        (cond
          pending
            (when (flag-complete-kind pending)
              (complete/print-candidates (flag-complete-kind pending) current))
          (string/starts-with? current "-")
            (print-matching (sort (append (flags-of cmd) *global-flags*)) current)
          (not (empty? (positional-values cmd))) (print-matching (positional-values cmd) current)
          (positional-kind spec) (complete/print-candidates (positional-kind spec) current)
          else nil)))
    (catch _ (check-allow :discarded-catch nil))))

;; ── completion: the whole command line ───────────────────────────────────────────────
;;
;; `nest complete -- <words…>` is what the shell scripts call on every keypress. The model
;; is `*commands*`; the two Rust-side commands (`release`, `stdimage`) are
;; mirrored below — a mirror that
;; `crates/nest/tests/complete.rs` asserts against clap's definition through the binary, so
;; a flag added on one side fails the build until the other side has it.

;; The subcommands still implemented in Rust, with the flags clap defines for them.
(def *rust-commands*
  {"release" {:flags {"--out" "PATH"
                      "-o" "PATH"
                      "--runtime" "PATH"
                      "--target" "TRIPLE"
                      "--no-smoke" :bool}}
   "stdimage" {:flags {}}})

;; The one option clap owns for every subcommand (`-j` is its short form; only `--long`
;; spellings are offered, as before).
(def- *global-flags* (list "--max-parallel"))

(defn all-subcommands ()
  "Every subcommand `nest` accepts, hidden ones excluded, sorted: this module's plus the
ones still implemented in Rust.

    (nest/all-subcommands)   ;~> (\"add\" \"attach\" \"check\" … \"ws\")"
  (sort (append (subcommands) (keys *rust-commands*))))

(defn complete-words (words)
  "Print the candidates for `words` — everything typed after `nest`, the (possibly empty)
partial word last, one candidate per line. With no settled subcommand yet, the subcommand
names; a settled one completes through [[complete]] — from `*commands*`, or a Rust-side
one from its mirror in `*rust-commands*`. Never raises.

    (nest/complete-words [\"te\"])   ;~> nil — prints \"test\", the matching subcommand"
  (try
    (let (current (or (last words) "")
          prior (if (empty? words) (list) (seq/drop-last words 1))
          known (into #{} (all-subcommands))
          cmd (seq/find prior
                (fn (word) (and (not (string/starts-with? word "-")) (contains? known word)))))
      (if (nil? cmd)
        (print-matching (all-subcommands) current)
        (complete cmd (rest (drop prior (index-of prior cmd))) current)))
    (catch _ (check-allow :discarded-catch nil))))

(defn- run-complete (options)
  (complete-words (get options :positionals))
  0)

;; ── completion: the shell scripts ────────────────────────────────────────────────────
;;
;; Deliberately thin: each script forwards the current words to `nest complete` and offers
;; whatever comes back, so there is exactly ONE implementation of completion logic and the
;; shells cannot disagree with it (or go stale when a flag is added). Each also falls back
;; to the shell's own filename completion when `nest complete` returns nothing, so a path
;; is always typeable.

;; `-o default` is the fallback: with no candidates, bash resumes normal filename
;; completion instead of offering nothing.
(def- *bash-script*
  "# nest completion for bash — eval \"$(nest completions bash)\"
_nest_complete() {
    local IFS=$'\\n'
    local words=(\"${COMP_WORDS[@]:1:COMP_CWORD}\")
    # An empty trailing word means \"completing a fresh word\": keep it, so
    # `nest test <TAB>` differs from `nest tes<TAB>`.
    [[ ${#words[@]} -eq 0 ]] && words=(\"\")
    COMPREPLY=($(nest complete -- \"${words[@]}\" 2>/dev/null))
    return 0
}
complete -o default -o bashdefault -F _nest_complete nest
")

;; NB the locals are `parts`/`candidates`, NOT `words`: zsh's completion context provides
;; `$words`, so declaring `local -a words` would blank it before it could be read and every
;; completion would see an empty command line.
(def- *zsh-script*
  "# nest completion for zsh — eval \"$(nest completions zsh)\"
_nest_complete() {
    local -a candidates parts
    parts=(\"${(@)words[2,$CURRENT]}\")
    (( ${#parts} == 0 )) && parts=(\"\")
    candidates=(\"${(@f)$(nest complete -- \"${parts[@]}\" 2>/dev/null)}\")
    # `_files` is the fallback when nest has no opinion, so paths stay completable.
    if (( ${#candidates} == 0 )) || [[ -z \"${candidates[1]}\" ]]; then
        _files
    else
        compadd -- \"${candidates[@]}\"
    fi
}
compdef _nest_complete nest
")

;; fish has no "fall back to files" switch, so ask for both: nest's candidates plus the
;; usual file list.
(def- *fish-script*
  "# nest completion for fish — nest completions fish | source
function __nest_complete
    set -l tokens (commandline -opc) (commandline -ct)
    nest complete -- $tokens[2..-1] 2>/dev/null
end
complete -c nest -f -a '(__nest_complete)'
complete -c nest -a '(__fish_complete_path)'
")

(defn- run-completions (options)
  (io/write (case (first (get options :positionals))
              "bash" *bash-script*
              "zsh" *zsh-script*
              "fish" *fish-script*))
  0)
