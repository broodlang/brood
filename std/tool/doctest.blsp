;; std/tool/doctest.blsp — a documented example is a promise; run it.
;;
;; An example in a docstring is a claim about behaviour, and a wrong one is worse than no
;; example at all: it reads as authoritative and it is invisible to every other gate — the
;; checker does not evaluate docstrings, and no test covers prose. Two of the first batch
;; written for `std/` were already wrong when this machinery was first applied there.
;;
;; The engine lived as six private functions inside `tests/doc_examples_test.blsp`, hard-wired
;; to `reflect/builtin-modules`, so it could gate the standard library and nothing else. It is the
;; same code here, made public and pointed at whichever names you ask for — which is what
;; `nest test` needs to gate a *project's* docstrings the way this repo gates its own.

(defmodule doctest
  "Run the examples in docstrings and report the ones that do not hold.

The convention, and the one to write new examples in:

    \"…prose…

        (count [1 2 3])   ;=> 3
        (get {:a 1} :zz)  ;=> nil\"

An **indented** line holding a form followed by ` ;=> ` is a case: the form is evaluated and
must equal the result after the marker. The result is a comment, so the line stays valid
Brood you can paste. A further `; comment` after the result is ignored. Only indented lines
count — inline `e.g. …` prose is left alone deliberately, since much of it names values that
do not exist outside the sentence.

An **illustration** is the same shape with ` ;~> ` — for a function whose result depends on
the world (a file, the clock, a socket, a pid) and so cannot be pinned. It is not evaluated,
but it is still held to something: its form must read as one form, and the function it calls
must exist with an arity that takes the arguments — so a rename or a typo fails here too.

    (file/slurp \"notes.txt\")   ;~> \"…the file's text…\"

An example runs at the top level, not inside its module, so it is written with the full
namespace — `(myapp/parse \"x\")`, never `(parse \"x\")` — and pastes into any REPL as it
stands. Only public names are checked, so the qualified name is always callable.

An indented line still carrying the old ` → ` marker is reported, never skipped.

    (doctest/failures-under \"myapp/\")   ;; the examples that do not hold
    (doctest/failures)                    ;; …across every public name in the image")

(defn- comment-index (line)
  ;; The index of `line`'s first `;` OUTSIDE a string literal, or nil. Both markers are
  ;; comments, so this one scan finds where the form ends and the result begins — and a
  ;; result like `("a; b")` keeps its semicolon. Cutting at the first `;` unconditionally
  ;; would truncate such a result into something that no longer reads as a value.
  (letrec (go (fn (cs i in-string escaped)
                (cond
                  (empty? cs) nil
                  escaped (go (rest cs) (+ i 1) in-string false)
                  ;; A backslash escapes the next character, but only inside a string.
                  (= (first cs) "\\") (go (rest cs) (+ i 1) in-string in-string)
                  (= (first cs) "\"") (go (rest cs) (+ i 1) (not in-string) false)
                  (and (= (first cs) ";") (not in-string)) i
                  else (go (rest cs) (+ i 1) in-string false))))
    (go (string/->list line) 0 false false)))

(defn- strip-comment (line)
  (let (i (comment-index line))
    (if i (string/substring line 0 i) line)))

(defn- opens-with-marker? (s)
  (or (string/starts-with? s ";=>") (string/starts-with? s ";~>")))

(defn- marked (line marker)
  ;; `[:example form result]` when `line` is indented, holds a form, and its first comment
  ;; opens with `marker` (`;=>` a case, `;~>` an illustration); nil otherwise. A line that
  ;; starts with `;` continues the form on the line above, which is prose. `[:malformed]` when
  ;; there is nothing after a `;=>`, or a second marker follows the first — a typo that would
  ;; otherwise drop the case in silence, since the second marker reads as a comment.
  (when (string/starts-with? line "    ")
    (let (i (comment-index line))
      (when i
        (let (form (string/trim (string/substring line 0 i))
              tail (string/substring line i (count line)))
          (when (and (not (= form "")) (string/starts-with? tail marker))
            (let (after (string/drop-prefix tail marker)
                  j (comment-index after)
                  result (string/trim (strip-comment after)))
              (cond
                (and j (opens-with-marker? (string/substring after j (count after)))) [:malformed]
                (and (= result "") (= marker ";=>")) [:malformed]
                else [:example form result]))))))))

(defn- outside-strings (code)
  ;; `code` with every string literal's contents removed, so a search finds only what is
  ;; written outside them. The same scan as `comment-index`.
  (letrec (go (fn (cs in-string escaped kept)
                (cond
                  (empty? cs) (string/join kept "")
                  escaped (go (rest cs) in-string false kept)
                  (= (first cs) "\\")
                    (go (rest cs) in-string in-string (if in-string kept (append kept ["\\"])))
                  (= (first cs) "\"") (go (rest cs) (not in-string) false kept)
                  in-string (go (rest cs) true false kept)
                  else (go (rest cs) false false (append kept [(first cs)])))))
    (go (string/->list code) false false [])))

(defn- old-marker? (line)
  ;; Indented, with ` → ` outside any string or comment: an example written in the retired
  ;; convention. Reported rather than skipped, so a missed line cannot fall out of the gate.
  (and (string/starts-with? line "    ") (includes? (outside-strings (strip-comment line)) " → ")))

(defn example-lines (d)
  "The indented ` ;=> ` lines of docstring `d` — the example cases it carries.

    (count (doctest/example-lines \"x\\n    (+ 1 1)   ;=> 2\"))   ;=> 1"
  (seq/filter (string/split (str d) "\n") (fn (l) (marked l ";=>"))))

(defn illustration-lines (d)
  "The indented ` ;~> ` lines of docstring `d` — illustrations: examples that are read and
whose callee must exist, but that are not evaluated.

    (doctest/illustration-lines (reflect/doc file/slurp))   ;~> (…its illustration lines…)

    (count (doctest/illustration-lines \"x\\n    (file/slurp \\\"a\\\")   ;~> \\\"…\\\"\"))   ;=> 1"
  (seq/filter (string/split (str d) "\n") (fn (l) (marked l ";~>"))))

(defn- arm-accepts? (params n)
  ;; Does one arm's parameter list take `n` arguments?
  (let (fixed (count (seq/take-while params (fn (p) (not (string/starts-with? (->string p) "&")))))
        optional (count (seq/take-while (rest (seq/drop-while params
                                                (fn (p) (not (= p '&optional)))))
                          (fn (p) (not (= p '&)))))
        rest? (includes? params '&))
    (and (>= n fixed) (or rest? (<= n (+ fixed optional))))))

(defn- arity-fault (head form)
  ;; A message when no arm of the function `head` names takes the illustration's argument
  ;; count; nil when one does, or when the count is not knowable — a `…` placeholder stands for
  ;; any number of arguments, and a macro's arity is its own business.
  (let (value (reflect/eval head)
        arms (if (fn? value) (reflect/arglists value) nil)
        args (rest form)
        n (count args))
    (cond
      (nil? arms) nil
      (any? args (fn (a) (and (symbol? a) (string/starts-with? (->string a) "…")))) nil
      (any? arms (fn (params) (arm-accepts? params n))) nil
      else
        (str "illustration passes "
          n
          " argument"
          (if (= n 1) "" "s")
          " to `"
          head
          "`, which takes "
          (string/join (map arms pr-str) " or ")))))

(defn- qualify-hint (name-str bare)
  ;; An example runs at the top level, not inside the module of the name it documents —
  ;; so it is written with the full namespace, so it pastes into any
  ;; REPL as it stands. The slip that rule invites is the module's own bare name: when
  ;; `bare` is unbound here but bound in that module, say what to write instead.
  ;; A nil `name-str` is an example with no owning name — a markdown block — so no hint.
  (let (owner (or name-str "")
        slash (string/last-index-of owner "/")
        qualified (if (< slash 0) nil (str (string/substring owner 0 slash) "/" bare)))
    (if (and qualified (bound? (symbol qualified)))
      (str " — examples run at the top level: write `" qualified "`")
      "")))

(defn- illustration-fault (label owner src form)
  ;; nil when the illustration's read `form` has a head that is bound or a special form and,
  ;; for a function head, an argument count one of its arms takes. `label` opens the message,
  ;; `owner` is the documented name a qualify hint is drawn from (nil for none).
  (let (head (if (pair? form) (first form) nil))
    (cond
      (and (symbol? head)
        (not (bound? head))
        (not (includes? (reflect/special-forms) (->string head))))
        (str label
          ": "
          src
          "  ;~> illustration calls `"
          head
          "`, which is not defined"
          (qualify-hint owner (->string head)))
      (and (symbol? head) (bound? head) (arity-fault head form))
        (str label ": " src "  ;~> " (arity-fault head form))
      else nil)))

(defn- check-illustration (name-str src)
  ;; nil when the illustration's form `src` reads as one form whose head is bound or a special
  ;; form, and, for a function head, is called with an argument count one of its arms takes.
  ;; Never run — so after a rename or a reorder this is the only thing that notices it went
  ;; stale.
  ;; check-allow :discarded-catch — a form that does not read is the failure reported below
  (let (parsed (check-allow :discarded-catch (try [:ok (reflect/read-string src)] (catch _ nil))))
    (if (nil? parsed)
      (str name-str ": " src "  ;~> illustration does not read as one form")
      (illustration-fault name-str name-str src (second parsed)))))

(defn- holds? (value expected)
  ;; Does `value` satisfy the documented result text `expected`?
  ;;
  ;; Compared as a VALUE when `expected` reads as one, and only then as text. A printed map
  ;; or set is in the trie's order, and that order depends on the ids the symbol interner
  ;; handed out — so it moves when anything else in the image changes, *including adding an
  ;; unrelated kernel primitive*. That is how this fired once: `%codepoints->string` shifted
  ;; the interning and `(seq/frequencies [:a :b :a])` began printing `{:a 2, :b 1}` where the
  ;; docstring recorded the equally-correct `{:b 1, :a 2}`. The same example passed when
  ;; evaluated on its own, which is the tell that the comparison and not the example was
  ;; wrong.
  ;;
  ;; Reading rather than evaluating is deliberate: a documented list result is written
  ;; `(:a :b)`, which as a *form* would call `:a`. Read, it is the list value it depicts.
  ;; Anything that does not read — `#<fn>`, a `RAISED …` line — falls back to comparing
  ;; `pr-str`, so nothing is silently accepted.
  ;; check-allow :discarded-catch — an expected value that does not read falls back to a pr-str comparison
  (let (parsed (check-allow :discarded-catch
                 (try [:ok (reflect/read-string expected)] (catch _ nil))))
    (if parsed (= value (second parsed)) (= (pr-str value) expected))))

(defn- case-fault (label owner src run expected)
  ;; nil when calling `run` — the case's evaluation — gives a value `expected` describes, or
  ;; raises exactly the `RAISED …` text it documents; else how it failed. `owner` as for
  ;; `illustration-fault`.
  (let (outcome (try [:ok (run)] (catch e [:raised (str "RAISED " (error-message e))]))
        ok (if (= (first outcome) :raised)
             (= (second outcome) expected)
             (holds? (second outcome) expected)))
    (when (not ok)
      (str label
        ": "
        src
        "  ;=> got "
        (if (= (first outcome) :raised) (second outcome) (pr-str (second outcome)))
        ", documented "
        expected
        (if (and (= (first outcome) :raised)
              (string/starts-with? (second outcome) "RAISED unbound symbol: "))
          (qualify-hint owner
            (string/substring (second outcome)
              (count "RAISED unbound symbol: ")
              (count (second outcome))))
          "")))))

(defn- check-case (name-str src expected)
  (case-fault name-str name-str src (fn () (reflect/eval (reflect/read-string src))) expected))

(defn check (name-str line)
  "nil when `line` is not an example at all, or when the example it carries holds; else a
description of how it failed — a wrong result, a line that looks like an example and does
not parse as one, an illustration (` ;~> `) that does not read or calls nothing defined, or
a line still written with the retired ` → ` marker.

`name-str` only labels the message — it is the name the example was found on.

    (doctest/check \"x\" \"plain prose\")  ;=> nil"
  (let (malformed (fn ()
                    (str name-str
                      ": "
                      (string/trim line)
                      "  — malformed example: expected one form, a marker, one result")))
    (if (old-marker? line)
      ;; Silence for a line in the old convention would drop it from the gate unnoticed.
      (str name-str
        ": "
        (string/trim line)
        "  — old marker: write ` ;=> ` for a case, ` ;~> ` for an illustration")
      ;; A line selected as an example that does not split into one form and one result is
      ;; reported: that is the difference between an unchecked promise and a known one.
      (match (marked line ";=>")
        ([:malformed] (malformed))
        ([:example src expected] (check-case name-str src expected))
        (_ (match (marked line ";~>")
             ([:malformed] (malformed))
             ([:example src _] (check-illustration name-str src))
             (_ nil)))))))

(defn- example-or-stale? (l)
  ;; Any line `check` has something to say about: a case, an illustration, or a line still
  ;; in the old convention. Selecting only the first two would let an unconverted docstring
  ;; drop out of the gate without a word.
  (or (marked l ";=>") (marked l ";~>") (old-marker? l)))

(defn- documented? (s)
  ;; check-allow :discarded-catch — a name whose value or docstring cannot be read is not documented
  (let (d (check-allow :discarded-catch (try (reflect/doc (reflect/eval s)) (catch _ nil))))
    (and d (any? (string/split (str d) "\n") example-or-stale?))))

(defn documented-names-under (prefix)
  "Every public name starting with `prefix` whose docstring carries at least one indented
example — `\"myapp/\"` for one package's own surface. A nil `prefix` means every public name.

    (doctest/documented-names-under \"myapp/\")   ;~> (myapp/parse …) — that package's names with examples"
  ;; Narrow by PREFIX before looking for examples, not after: `documented?` evaluates a
  ;; global to read its docstring, so filtering last makes a scoped run pay that for every
  ;; one of the thousands of names it is about to discard.
  (let (public (seq/filter (reflect/global-names) (fn (s) (not (reflect/private? s))))
        scoped (if (nil? prefix)
                 public
                 (seq/filter public (fn (s) (string/starts-with? (->string s) prefix)))))
    (seq/filter scoped documented?)))

(defn documented-names ()
  "Every public name in the image whose docstring carries at least one indented example.

    (doctest/documented-names)   ;~> (count/… string/join …) — every public name with an indented example"
  (documented-names-under nil))

(defn- failures-of (s)
  (let (d (reflect/doc (reflect/eval s)))
    (seq/keep (string/split (str d) "\n") (fn (l) (check (->string s) l)))))

(defn failures-under (prefix)
  "Every documented example that does not hold, for public names under `prefix` (nil = the
whole image). A vector of descriptions, empty when every example holds — the caller decides
whether that is a failure, so this is usable as a report as well as a gate.

    (doctest/failures-under \"no-such-module/\")   ;=> []"
  (apply vector
    (fold (documented-names-under prefix) [] (fn (acc s) (append acc (failures-of s))))))

(defn failures ()
  "Every documented example in the image that does not hold.

    (doctest/failures)   ;~> [] — or one description per example that does not hold"
  (failures-under nil))

;; ── One source file's examples ───────────────────────────────────────────────────────────
;;
;; The whole-image gate above answers "does every example hold", minutes into a suite. While
;; a file is being edited the question is narrower: do THIS file's examples hold, and where is
;; the one that does not. The names come from the file itself (its top-level defs, read
;; natively), the values from the image the caller loaded, and each failure is placed at the
;; source line of its example, so an editor can jump there.

(defn- source-escaped (text)
  ;; A docstring line as it is written inside the string literal in the source.
  (string/replace (string/replace text "\\" "\\\\") "\"" "\\\""))

(defn- bare-name (qualified)
  (let (slash (string/last-index-of qualified "/"))
    (if (> slash 0) (string/substring qualified (+ slash 1) (count qualified)) qualified)))

(defn- defines? (line bare)
  ;; Does the source line open a top-level def form for `bare`?
  (let (text (string/trim line)
        words (seq/filter (string/split text " ") (fn (w) (not (= w "")))))
    (and (string/starts-with? text "(def") (= (second words) bare))))

(defn- index-where (lines from pred)
  ;; The first index at or after `from` whose line satisfies `pred`, or nil.
  (cond
    (empty? lines) nil
    (pred (first lines)) from
    else (index-where (rest lines) (+ from 1) pred)))

(defn- example-line-number (source-lines qualified example)
  ;; The 1-based line `example` (a docstring line of `qualified`) sits on, searched from the
  ;; definition down; the definition's own line when the text cannot be found, 1 when neither.
  (let (definition (or (index-where source-lines 0 (fn (l) (defines? l (bare-name qualified)))) 0)
        wanted (source-escaped (string/trim example))
        found (index-where (drop source-lines definition)
                definition
                (fn (l) (string/starts-with? (string/trim l) wanted))))
    (+ 1 (or found definition))))

(defn failures-in-file (path &optional label)
  "Every documented example that does not hold among the names (private ones too) the source file
`path` defines at top level, each as `LABEL:LINE: description` — `LINE` the example's own
line in the file, `label` defaulting to `path`. Reads the file for its names and their
lines; the values are the image's, so load the file's module first. A vector, empty when
every example holds (or the file defines nothing documented).

    (doctest/failures-in-file \"/no/such/file.blsp\")   ;=> []"
  (let (text (if (file/exists? path) (file/slurp path) nil))
    (if (not (string? text))
      []
      (let (source-lines (string/split text "\n")
            names (seq/filter (map (nth (reflect/scan-source-extract text) 2) reflect/read-string)
                    (fn (s) (and (bound? s) (documented? s)))))
        (apply vector
          (fold names
            []
            (fn (acc s)
              (fold (string/split (str (reflect/doc (reflect/eval s))) "\n")
                acc
                (fn (inner line)
                  (let (fault (check (->string s) line))
                    (if fault
                      (append inner
                        [(str (or label path)
                           ":"
                           (example-line-number source-lines (->string s) line)
                           ": "
                           fault)])
                      inner)))))))))))

;; ── Markdown: fenced blocks ──────────────────────────────────────────────────────────────
;;
;; A fenced block in a document is an example the same way a docstring line is, and it drifts
;; the same way — ADR-308's argument reorder survived in docs/language.md because nothing ran
;; it. A block is a small program: its unmarked lines are setup, run in order, and each
;; ` ;=> ` or ` ;~> ` line is checked as in a docstring. A marked line may close a form opened
;; by the lines above it, so a multi-line `let` ending in ` ;=> 3` is one case.
;;
;; Each block runs in a child process of its own, under a timeout. In-process, a block's
;; `def` would land in the image every later block shares — one that redefines `map` breaks
;; the rest of the run — and a block that serves a socket or sleeps would stall it.

(def- *runnable-fences* ["clojure" "lisp" "brood"])

(def- *block-timeout-ms* 10000)

(def- *faults-prefix* "doctest-faults: ")

(defn- indent-of (line)
  (- (count line) (count (string/trim-left line))))

(defn- dedent (line indent)
  ;; `line` without the fence's own indent, or without whatever indent it has when that is
  ;; less — a block inside a list item is indented with the item.
  (if (string/starts-with? line (string/repeat " " indent))
    (string/substring line indent (count line))
    (string/trim-left line)))

(defn- runnable-fence? (info)
  (let (words (seq/filter (string/split info " ") (fn (w) (not (= w "")))))
    (and (not (empty? words))
      (includes? *runnable-fences* (first words))
      (not (includes? words "fragment")))))

(defn fenced-blocks (text)
  "The runnable fenced blocks of markdown `text`, in order, each `{:line n :source s}` with
`n` the 1-based line of its first line of code. A block runs when its info string opens with
`clojure`, `lisp` or `brood` and does not carry the word `fragment`; an untagged block or any
other language is never run. A block indented inside a list item loses that indent.

    (doctest/fenced-blocks \"x\\n```clojure\\n(+ 1 1)\\n```\")   ;=> [{:line 3 :source \"(+ 1 1)\"}]
    (doctest/fenced-blocks \"```clojure fragment\\n(f …)\\n```\")   ;=> []"
  (letrec (walk (fn (lines n open blocks)
                  (if (empty? lines)
                    blocks
                    (let (line (first lines)
                          trimmed (string/trim-left line)
                          fence? (string/starts-with? trimmed "```"))
                      (cond
                        (and (nil? open) fence?)
                          (walk (rest lines)
                            (+ n 1)
                            {:start (+ n 1)
                             :indent (indent-of line)
                             :runnable (runnable-fence? (string/drop-prefix trimmed "```"))
                             :lines []}
                            blocks)
                        (nil? open) (walk (rest lines) (+ n 1) nil blocks)
                        fence?
                          (walk (rest lines)
                            (+ n 1)
                            nil
                            (if (:runnable open)
                              (append blocks
                                [{:line (:start open)
                                  :source (string/join (:lines open) "\n")}])
                              blocks))
                        else
                          (walk (rest lines)
                            (+ n 1)
                            (assoc open
                              :lines (append (:lines open) [(dedent line (:indent open))]))
                            blocks))))))
    (apply vector (walk (string/split text "\n") 1 nil []))))

(defn- read-forms (text)
  ;; `[:ok forms]`, or `[:unreadable message]` when `text` does not read.
  (try
    [:ok (apply vector (reflect/read-all text))]
    (catch e [:unreadable (error-message e)])))

(defn- run-setup (label forms)
  ;; nil when every form evaluates; else the fault naming the one that raised.
  (if (empty? forms)
    nil
    (let (fault (try
                  (do (reflect/eval (first forms)) nil)
                  (catch e
                    (str label ": setup raised: " (error-message e) " — in " (pr-str (first forms))))))
      (or fault (run-setup label (rest forms))))))

(defn- inside-string? (lines)
  ;; Do `lines`, read in order, end inside an open string literal? A line continuing a
  ;; multi-line string — a docstring's second line — is text, not an example, whatever
  ;; it holds. A `;` outside a string comments out the rest of its line.
  (letrec (go (fn (cs in-string escaped in-comment)
                (cond
                  (empty? cs) in-string
                  in-comment (go (rest cs) false false (not (= (first cs) "\n")))
                  escaped (go (rest cs) in-string false false)
                  (= (first cs) "\\") (go (rest cs) in-string in-string false)
                  (= (first cs) "\"") (go (rest cs) (not in-string) false false)
                  (and (= (first cs) ";") (not in-string)) (go (rest cs) false false true)
                  else (go (rest cs) in-string false false))))
    (go (string/->list (string/join lines "\n")) false false false)))

(defn block-faults (label start source)
  "How the fenced block `source` fails, as a vector of descriptions — empty when it holds.
`label` names the document and `start` is the line the block's code begins on, so each
description points at its line. Unmarked lines are setup, evaluated in order; a setup line
that raises stops the block, since the cases after it depend on it. Evaluates the block in
THIS process — `markdown-failures` gives each block a process of its own.

    (doctest/block-faults \"a.md\" 1 \"(def x 2)\\n(+ x 1)   ;=> 3\")   ;=> []
    (count (doctest/block-faults \"a.md\" 1 \"(+ 1 1)   ;=> 3\"))   ;=> 1"
  (letrec (walk (fn (lines n buffer faults)
                  (if (empty? lines)
                    (let (pending (read-forms (string/join buffer "\n")))
                      (cond
                        (= (first pending) :unreadable)
                          (append faults
                            [(str label ":" n ": setup does not read: " (second pending))])
                        else
                          (let (fault (run-setup (str label ":" n) (second pending)))
                            (if fault (append faults [fault]) faults))))
                    (let (line (first lines)
                          padded (str "    " line)
                          here (str label ":" n)
                          continue (fn (fault)
                                     (walk (rest lines)
                                       (+ n 1)
                                       []
                                       (if fault (append faults [fault]) faults)))
                          checked (fn (form-text check)
                                    ;; The setup above this line, then the line's own form —
                                    ;; which may close a form the setup opened.
                                    (let (parsed (read-forms (string/join (append buffer
                                                                            [form-text])
                                                               "\n")))
                                      (if (= (first parsed) :unreadable)
                                        (continue (str here
                                                    ": "
                                                    form-text
                                                    "  — does not read: "
                                                    (second parsed)))
                                        (let (forms (second parsed)
                                              fault (run-setup here (seq/drop-last forms 1)))
                                          (if fault
                                            (append faults [fault])
                                            (continue (check (last forms)))))))))
                      (cond
                        ;; A line continuing a multi-line string is text, whatever it holds.
                        (inside-string? buffer)
                          (walk (rest lines) (+ n 1) (append buffer [line]) faults)
                        (old-marker? padded)
                          (continue (str here
                                      ": "
                                      (string/trim line)
                                      "  — old marker: write ` ;=> ` for a case, ` ;~> ` for an illustration"))
                        else
                          (match (marked padded ";=>")
                            ([:malformed] (continue (str here
                                                      ": "
                                                      (string/trim line)
                                                      "  — malformed example: expected one form, a marker, one result")))
                            ([:example form-text expected] (checked form-text
                                                             (fn (form)
                                                               (case-fault here
                                                                 nil
                                                                 (pr-str form)
                                                                 (fn () (reflect/eval form))
                                                                 expected))))
                            (_ (match (marked padded ";~>")
                                 ([:malformed] (continue (str here
                                                           ": "
                                                           (string/trim line)
                                                           "  — malformed example: expected one form, a marker, one result")))
                                 ([:example form-text _] (checked form-text
                                                           (fn (form)
                                                             (illustration-fault here
                                                               nil
                                                               (pr-str form)
                                                               form))))
                                 (_ (walk (rest lines) (+ n 1) (append buffer [line]) faults))))))))))
    (apply vector (walk (string/split source "\n") start [] []))))

(defn run-block (label start source)
  "The child half of `markdown-failures`: check one block with `block-faults` and print the
faults on a last line the parent reads back.

    (doctest/run-block \"a.md\" 1 \"(+ 1 1)   ;=> 2\")   ;~> prints doctest-faults: []"
  (io/puts (str *faults-prefix* (pr-str (block-faults label start source)))))

(defn- brood-beside (exe)
  ;; A `brood` binary in `exe`'s directory or one of its five nearest ancestors — cargo keeps
  ;; the binaries in `target/<profile>/`, a harness runs from `target/<profile>/deps/`, and
  ;; a cross-target build runs the suite from `target/<triple>/release/build/brood/<hash>/out/`
  ;; — or on PATH; nil if none. Only a regular file counts: one of those ancestors is a
  ;; directory called `brood`.
  (or (brood-in-ancestors (path/dirname exe) 6) (os/which "brood")))

(defn- brood-in-ancestors (dir levels)
  (let (candidate (path/join dir "brood")
        parent (path/dirname dir))
    (cond
      (file/regular? candidate) candidate
      (or (<= levels 1) (= parent dir)) nil
      else (brood-in-ancestors parent (dec levels)))))

(defn- child-command (file)
  ;; Run `file` with the binary running now when it is `nest` or `brood`: `nest run` keeps a
  ;; project's sources reachable, so a block in a project's guide can call the project;
  ;; `brood` runs a file as it is. Any other host — the cargo test harness running the
  ;; in-language suite, an embedding application — cannot run a file, so the block runs
  ;; under a `brood` found beside it. The name is matched whole: a unit-test binary is
  ;; called `brood-<hash>`.
  (let (exe (or (os/exe-path) "brood")
        name (path/stem exe))
    (cond
      (= name "nest") [exe ["run" "--no-check" file]]
      (= name "brood") [exe [file]]
      else
        (let (brood (brood-beside exe))
          (if brood
            [brood [file]]
            (error "doctest: "
              exe
              " cannot run a markdown block, and no `brood` binary was found beside it or on PATH"))))))

(defn- block-outcome (label result)
  ;; The faults a child reported on its last `doctest-faults:` line, or one fault saying why
  ;; there is no such line — a timeout, a crash, a block that exited the process.
  (let (reported (seq/filter (string/split (:stdout result) "\n")
                   (fn (l) (string/starts-with? l *faults-prefix*))))
    (if (empty? reported)
      [(str label
         ": block did not finish — "
         (if (:timed-out result)
           (str "timed out after " *block-timeout-ms* " ms")
           (str "exit " (:exit result)))
         (let (stderr (string/trim (:stderr result)))
           (if (= stderr "") "" (str ": " (last (string/split stderr "\n"))))))]
      (reflect/read-string (string/drop-prefix (last reported) *faults-prefix*)))))

(defn markdown-failures (path &optional label)
  "Every fenced block example in the markdown file at `path` that does not hold, each block
run in a child process of its own under a timeout. A vector of descriptions, empty when every
block holds. `label` names the file in them (default `path`).

    (doctest/markdown-failures \"docs/guide.md\")   ;~> [] — or one description per failure"
  (let (blocks (fenced-blocks (file/slurp path)))
    (apply vector
      (fold blocks
        []
        (fn (faults block)
          (let (block-label (str (or label path) ":" (:line block))
                file (str (path/temp "brood-doctest-") ".blsp")
                [program arguments] (child-command file))
            (file/spit file
              (str "(doctest/run-block "
                (pr-str (or label path))
                " "
                (:line block)
                " "
                (pr-str (:source block))
                ")\n"))
            (let (result (os/cmd program arguments {:timeout-ms *block-timeout-ms*}))
              (file/rm file)
              (append faults (block-outcome block-label result)))))))))
