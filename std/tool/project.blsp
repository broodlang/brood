;; std/tool/project.blsp — the project model (ADR-020), in Brood.
;;
;;   project/…                ; loaded on demand; baked into the binary
;;   (run-tests)      ; find project.blsp, discover tests, run them once
;;
;; This is the policy behind `nest test`. Convention over configuration: `src/`
;; holds the project's source (added to *load-path*), `tests/` holds tests
;; discovered as <name>_test.blsp. A `project.blsp` manifest declares identity
;; and may override the conventional paths. Rust supplies only the filesystem
;; mechanism (file/cwd / file-exists? / dir? / list-dir) and `reflect/load`; everything here
;; is ordinary Brood.

(defmodule project
  "The project model behind `nest` (ADR-020), written in Brood: the manifest and its
dependencies, finding the root, discovering sources and tests, `setup`, and the
user-config loader. Convention over configuration: `src/` holds source (added to
*load-path*), `tests/` holds <name>_test.blsp cases; a `project.blsp` manifest declares
identity and may override those paths. The rest of the tool is its siblings:
`project-image`, `project-check`, `project-run`, `project-release`."
  ;; NOT `(:use test)`: that would load `test` at *load* time, so a lean
  ;; release runtime (which strips the test framework, ADR-038) couldn't even
  ;; load `project` to boot a bundle. The test runner needs test only when it
  ;; actually runs — `run-tests` loads `test` itself and qualifies it.
)

;; --- the project, as set by the manifest -------------------------------------

(defdyn *project-root* nil)
(defdyn *project-name* nil)
(defdyn *project-version* nil)
;; namespace → owning package name (ADR-172 package identity). Populated at project setup
;; by a static scan of each provider's `(defmodule …)` names: the project's own `src/`
;; modules map to `*project-name*`, a dependency's modules to that dep's `:name`. It is the
;; ability system's app-vs-library seam — an impl whose module's package is `*project-name*`
;; is the app (top precedence tier). A module absent here (embedded std, or none) is not the
;; app. Purely identity: no name-rooting/prefixing (that stays the deferred ADR-070 upgrade).
(defdyn *ns-package* {})

(defn ns-package (ns-or-name)
  "The owning package of a namespace or a qualified `mod/fn` name (ADR-172 package identity).
  Resolves the MODULE either way — a module namespace (`widget`, `editor/display`) directly,
  or the module of a qualified name (`widget/w` → `widget`, `editor/display/draw` →
  `editor/display`). Returns the package name, or nil for an unrecorded/embedded (std)
  module, a root (unqualified) name, or when no project is loaded. This is the seam for
  surfacing package in stack traces — `(ns-package (get frame :fn))` — introspection, and
  tooling. `nil` in (an anonymous / top-level trace frame has no `:fn`) yields `nil` out."
  (when ns-or-name
    (let (s (if (symbol? ns-or-name) ns-or-name (symbol ns-or-name)))
      (or (get *ns-package* s)
        ;; not a module directly — treat it as a qualified name, strip the last `/`-segment
        ;; (the def/fn name) and look up its module.
        (let (parts (string/split (str s) "/"))
          (if (> (count parts) 1)
            (get *ns-package* (symbol (string/join (take parts (- (count parts) 1)) "/")))
            nil))))))
(sig ns-package ((or symbol string nil) -> any))

(defn trace-with-packages (trace)
  "Annotate each stack-trace frame (`{:fn :file :line :col}`) with `:package` — the owning
  package of its function (ADR-172). `trace` is the `:trace` on a caught kernel-error map.
  Frames whose function is root/std/unrecorded get `:package nil`."
  (map trace (fn (frame) (assoc frame :package (ns-package (get frame :fn))))))
(sig trace-with-packages (seqable -> (or nil (list any))))
;; Only ever set inside `setup` (from the manifest) and read by
;; `package` when it publishes — so they must be declared ambient here, like the
;; slots above: ambient is a `defdyn` declaration now, not an earmuff spelling.
(defdyn *project-description* nil)
(defdyn *project-repository* nil)
;; `:brood` — the runtime-version constraint this project needs (a `std/version` string,
;; e.g. `">= 0.2"`, `"^0.1"`). Checked at `setup` against `(system/brood-version)`; an
;; unmet constraint is a hard, clear error (ADR-209), the way `mix.exs`'s `elixir:`
;; requirement refuses an incompatible Elixir. Absent = runs on any runtime.
(defdyn *project-brood* nil)
;; `:enhances` — which APPLICATIONS this package adds functionality to, as a map of
;; name → version constraint (`{bedit ">= 0.3"}`). Debian's `Enhances:` field: a
;; plugin declares what it plugs into, and the *application* checks the constraint
;; against its own version when it loads the package (`std/version`
;; `version/satisfies-all?`). Distinct from dependency resolution (ADR-209): `:enhances`
;; is a load-time compatibility check a host runs against a plugin it already has —
;; nothing here is fetched or version-selected.
;;
;; Kept generic on purpose: the names are DATA, so nothing in brood/nest/hive
;; enumerates them or knows any application by name. An editor plugin says
;; `{bedit ">= 0.3"}`, a web-framework plugin `{hatch ">= 1.0"}`, and a registry can
;; index and filter on the key (`nest search --enhances bedit`) without learning
;; either. Absent = an ordinary library.
(defdyn *project-enhances* {})
;; `:kind` — whether this package is an APPLICATION (`:app`, something you run) or a generic
;; LIBRARY (`:library`, the default — the reusable packages everything else depends on). The
;; hive lists them differently. Optional; absent = `:library`. Orthogonal to `:enhances`,
;; which marks a plugin (a library that plugs into an app) regardless of kind.
(defdyn *project-kind* :library)
;; `:bundled-packages` — the FULL rooted-package set `bundle-collect` baked into a release
;; (`project-release` reads it at bundle boot); nil outside a bundle.
(defdyn *project-bundled-packages* nil)
(defdyn *project-source-paths* (list "src"))
; conventional default
(defdyn *project-test-paths* (list "tests"))
; conventional default
(defdyn *project-main* (list 'main 'main))
; (module fn) — `nest run` entry, as declared by the manifest's `:main`
(defdyn *project-main-override* nil)
; (module fn) or nil — a `nest run --main` override that wins over the manifest.
; A separate slot (not `*project-main*`) because the manifest is re-applied
; inside `run` (via `setup`), which would otherwise clobber an
; override set before the run.
(defdyn *project-dependencies* nil)
; list of dep records from the manifest's :dependencies (ADR-037)
(defdyn *project-dev-dependencies* nil)
; dev/test-only dep records from the manifest's :dev-dependencies (ADR-172): resolved for
; `nest test`/dev and on the dev load path, but excluded from a release bundle. Each
; carries `:dev true`. Kept separate from *project-dependencies* so a release build (and
; a published package's declared deps) never pulls a test-only dependency.
(def *project-format-headers* nil)
; the manifest's :format-headers map ({head-symbol → header-count}) — extra formatter
; rules for this project's own macros; nil when unset
(def *project-format-plugins* nil)
; the manifest's :format-plugins vector ([dep-name …]) — deps whose own
; :format-headers this project pulls in (so a framework ships its macro shapes)
(defdyn *project-format-paths* nil)
; the manifest's :format-paths (a vector of directories) — EXTRA trees `nest format`
; owns, beyond :source-paths and :test-paths. nil = just those two. `nest format` walks
; a whitelist, so a directory holding .blsp the project authors but does not build from
; (`std/`, `examples/`, `scripts/`) has to be named here to be formatted. Ambient so
; `std/format.blsp` reads it without importing the manifest.
(defdyn *project-width* nil)
; the manifest's :width (an integer column budget for `nest format`, e.g. 80);
; nil = use the formatter's built-in default. Ambient so `std/format.blsp` reads it
; directly, like the other project knobs the formatter consults.

;; (plist-get '(:a 1 :b 2) :b) => 2 — the value after key k in a flat kv list, or nil.
(defn plist-get (kvs k)
  "Read the value paired with key `k` from a flat property-list `kvs` (`k1 v1 k2 v2 …`); nil if `k` is absent."
  (cond (empty? kvs) nil (= (first kvs) k) (second kvs) else (plist-get (rest (rest kvs)) k)))

;; Normalise the manifest's `:main` value into a `(module fn)` pair of symbols.
;;   'foo           => '(foo main)        ; module foo, default fn name `main`
;;   '(foo bar)     => '(foo bar)         ; module foo, fn bar
;;   anything else  => error
(defn- project-parse-main (v)
  (cond
    (symbol? v) (list v 'main)
    ;; `:main 'app` / `:main '(app start)` reads as `(quote …)` — the manifest is
    ;; data and never evaluated, so the quote is literal, not stripped. Catch it
    ;; with a fix-it instead of silently parsing module `quote`.
    (and (pair? v) (= (first v) 'quote))
      (error "project: :main takes a bare symbol, not a quoted one — write `:main "
        (second v)
        "` (the manifest is data, so drop the leading quote)")
    (and (pair? v) (symbol? (first v)) (pair? (rest v)) (symbol? (second v)) (nil? (rest (rest v))))
      (list (first v)
        (second v))
    else (error "project: :main must be a module symbol or '(module fn), got " v)))

;; Parse a CLI entry spec — "module" or "module/fn" — into a `(module fn)` pair.
;; The `nest run --main` override: a one-off entry without editing the manifest.
;;   "app"        => (app main)
;;   "app/start"  => (app start)
(defn- project-parse-main-spec (spec)
  (let (parts (string/split spec "/")
        ; reject blank module/fn halves so a typo like "" or "/start" errors
        ; cleanly here, not as a malformed load downstream.
        ok? (fn (p) (not (string/blank? p))))
    (cond
      (and (= (count parts) 1) (ok? (first parts))) (list (symbol (first parts)) 'main)
      (and (= (count parts) 2) (ok? (first parts)) (ok? (second parts)))
        (list (symbol (first parts))
          (symbol (or (second parts) "")))
      else (error "nest run --main: expected \"module\" or \"module/fn\", got " spec))))

(defn set-project-main (spec)
  "Override the `nest run` entry point from a CLI spec string (`\"module\"` or `\"module/fn\"`), without editing the manifest's `:main`. Sets a dedicated override slot that wins over the manifest even though `run` re-applies the manifest internally. Backs `nest run --main`."
  (def *project-main-override* (project-parse-main-spec spec)))

;; --- dependency manifest parsing (ADR-037, packages.md) ----------------------
;; Each :dependencies entry is a vector: `[name :git URL :ref REF]` or
;; `[name :path PATH]` — `name` is the local symbol `require` will see. Parsed
;; into one of the four **dep records** below for the package manager
;; (std/tool/package.blsp) to consume. The reserved opts :branch/:dir/:features
;; are recognised but rejected in v1, so the manifest shape stays forward-compatible.
;;
;; A dep's KIND is its record identity, not a `:kind` field: the package manager
;; dispatches every per-kind behaviour (resolve, lock entry, manifest entry,
;; compatibility) through the `Dependency` ability it declares over these four types,
;; which is `:sealed` over exactly this set — so `nest check` flags a new kind that
;; forgets one of them. This module owns the *types* (it parses the manifest);
;; std/tool/package.blsp owns the *behaviour*. A resolved entry is one of these records with
;; the resolution fields (`:resolved-path`/`:sha256`/`:commit`/`:deps`) assoc'd on, so it
;; dispatches identically to the dep it came from.

(def- *project-reserved-dep-opts* (list :branch :dir :features))

(defrecord dep-path (name path))
;; A git dep pins EITHER an exact `:ref` (tag/branch/commit) OR a `:version` range
;; (`^1.2.0`, resolved to the newest matching tag, ADR-209). Exactly one is set; the
;; other is nil.
(defrecord dep-git (name url ref version))
(defrecord dep-tarball (name url sha256))
(defrecord dep-registry (name version))

;; A dep's display form is its `nest tree` line — one place, so `(io/puts dep)` and the
;; tree agree. Registered here (the type owner) rather than in the package manager.
(impl Display
  project/dep-path
  (->string [d] (str (get d :name) "  (path \"" (get d :path) "\")")))
(impl Display
  project/dep-git
  (->string [d]
    (str (get d :name) "  (git " (get d :url) " @ " (or (get d :ref) (get d :version)) ")")))
(impl Display
  project/dep-tarball
  (->string [d] (str (get d :name) "  (tarball " (get d :url) ")")))
(impl Display
  project/dep-registry
  (->string [d] (str (get d :name) "  (registry v" (get d :version) ")")))

(def- *project-dep-ids*
  (list :project/dep-path :project/dep-git :project/dep-tarball :project/dep-registry))

(defn dep? (x)
  "True if `x` is a dependency record (any of the four kinds)."
  (and (record? x) (includes? *project-dep-ids* (record-id x))))

(defn dep-path? (x)
  "True if `x` is a `:path` dependency — the one kind that loads **in place** rather
than being fetched into `_deps/<name>/`."
  (and (record? x) (= (record-id x) :project/dep-path)))

;; The elements of vector `v` from index `start` onward, as a list (tail-recursive).
(defn- project-vec-drop (v start) (project-vec-drop-acc v start (dec (seq/vector-length v)) nil))
(defn- project-vec-drop-acc (v start i acc)
  (if (< i start) acc (project-vec-drop-acc v start (dec i) (cons (seq/vector-ref v i) acc))))

;; The keys of a flat plist (every other element from the head).
;; check-allow: deliberately non-tail — depth = the manifest plist's key count.
(check-allow :non-tail-recursion
  (defn- project-plist-keys (kvs)
    (if (empty? kvs) nil (cons (first kvs) (project-plist-keys (rest (rest kvs)))))))

;; Reject any reserved opt key present in `opts`, naming the offending dep.
(defn- project-reject-reserved-opts (name opts)
  (fold (project-plist-keys opts)
    nil
    (fn (_ k)
      (when (includes? *project-reserved-dep-opts* k)
        (error "project: dependency "
          name " uses " k ", which is reserved for a future version")))))

(defn- project-parse-git-dep (name entry)
  (let (url (seq/vector-ref entry 2)
        opts (project-vec-drop entry 3)
        ref (plist-get opts :ref)
        version (plist-get opts :version))
    (when (not (string? url))
      (error "project: :git dependency " name " URL must be a string, got " url))
    (when (and ref version)
      (error "project: :git dependency "
        name
        " cannot give both a :ref and a :version — pin an exact ref or track a version range, not both"))
    (when (and (not ref) (not version))
      (error "project: :git dependency "
        name " needs a :ref \"<tag-or-commit>\" or a :version \"<range>\""))
    (when (and ref (not (string? ref)))
      (error "project: :git dependency " name " :ref must be a string, got " ref))
    (when (and version (not (string? version)))
      (error "project: :git dependency " name " :version range must be a string, got " version))
    (project-reject-reserved-opts name opts)
    (dep-git name url ref version)))

(defn- project-parse-path-dep (name entry)
  (let (path (seq/vector-ref entry 2)
        opts (project-vec-drop entry 3))
    (when (not (string? path))
      (error "project: :path dependency " name " path must be a string, got " path))
    (project-reject-reserved-opts name opts)
    (dep-path name path)))

(defn- project-parse-registry-dep (name entry)
  (let (version (seq/vector-ref entry 2)
        opts (project-vec-drop entry 3))
    (when (not (string? version))
      (error "project: registry dependency " name " version must be a string, got " version))
    (project-reject-reserved-opts name opts)
    (dep-registry name version)))

(defn- project-parse-tarball-dep (name entry)
  (let (url (seq/vector-ref entry 2)
        opts (project-vec-drop entry 3)
        sha (plist-get opts :sha256))
    (when (not (string? url))
      (error "project: :tarball dependency " name " URL must be a string, got " url))
    ;; A tarball has no commit to trust, so a :sha256 is MANDATORY — it's the only
    ;; thing pinning the fetched bytes to reviewed content (ADR-037 supply-chain).
    (when (not (string? sha))
      (error "project: :tarball dependency "
        name " needs a :sha256 \"<hex>\" (the archive's SHA-256 — the only integrity pin)"))
    (project-reject-reserved-opts name opts)
    (dep-tarball name url sha)))

;; Normalise one `[name kind spec & opts]` entry into the dep record for its kind.
(defn parse-dep (entry)
  "Parse one `:dependencies` vector entry `[name kind & opts]` into a normalised dep record, dispatching on `kind` (`:git`/`:path`/`:tarball`/`:version`) and recording the `:optional` flag (ADR-172)."
  (when (not (vector? entry))
    (error "project: each :dependencies entry must be a vector, got " entry))
  (when (< (seq/vector-length entry) 3) (error "project: dependency entry is too short: " entry))
  (let (name (seq/vector-ref entry 0)
        kind (seq/vector-ref entry 1)
        opts (project-vec-drop entry 3))
    (when (not (symbol? name)) (error "project: dependency name must be a symbol, got " name))
    (let (base (cond
                 (= kind :git) (project-parse-git-dep name entry)
                 (= kind :path) (project-parse-path-dep name entry)
                 (= kind :tarball) (project-parse-tarball-dep name entry)
                 (= kind :version) (project-parse-registry-dep name entry)
                 else
                   (error "project: dependency "
                     name " must be :git, :path, :tarball, or :version, got " kind))
          ;; `:optional` (ADR-172) — a dep declared but not force-installed. Recognised on
          ;; every dep kind; defaults false. (Resolution semantics — peer presence — are
          ;; deferred: this normalises the manifest flag. The bridge/glue motivation was
          ;; dropped in the 2026-07-28 amendment, so `:optional` is now the generic
          ;; Cargo/Elixir optional dependency, decoupled from abilities.)
          optional (if (plist-get opts :optional) true false))
      (assoc base :optional optional))))

;; Parse the manifest's :dependencies value into a list of dep records.
;; Omitted/nil => empty list.
(defn parse-deps (deps)
  "Parse the manifest's `:dependencies` vector into a list of dep records; an omitted/nil value yields the empty list."
  (cond
    (nil? deps) nil
    (vector? deps) (map deps parse-dep)
    else (error "project: :dependencies must be a vector of dep entries, got " deps)))

;; The (project ...) manifest form: records identity, and overrides the
;; conventional source/test paths, the `nest run` entry, and the dependency set
;; when given. Missing keys keep their defaults. Called when a project.blsp is loaded.
;;
;; It is a macro that treats its arguments as **literal data** (it quotes them and
;; hands them to `apply`), so a manifest writes bare symbols — dep names
;; and the `:main` pair — without quoting. Manifests are static data; nothing in
;; them is ever evaluated.
(defmacro project (& opts)
  "Declare the project manifest (ADR-020/037): `:name` `:version` `:description` `:repository` `:source-paths` `:test-paths` `:format-paths` `:main`, `:dependencies` and `:dev-dependencies` (test/dev-only, excluded from a release bundle — ADR-172). `:format-paths` names EXTRA directories `nest format` owns beyond `:source-paths`/`:test-paths` — needed for a tree the project authors but does not build from (`std/`, `examples/`); the formatter walks a whitelist, so a fetched dependency under `_deps/` is never rewritten. A dep entry may carry `:optional true` (declared but not force-installed). `:brood` names the runtime-version constraint this project needs (`:brood \">= 0.2\"`), checked against `(system/brood-version)` at setup — an unmet requirement stops with a clear error (ADR-209). `:enhances` declares the applications this package plugs into as a map of name → version constraint (`:enhances {bedit \">= 0.3\"}`) — the application checks it when it loads the package; nothing is fetched. `:kind` is the package's kind — `:app` (an application you run) or `:library` (the default, an ordinary reusable package); optional, and the registry lists the two differently. Arguments are literal data — write dep names, `:enhances` keys and the `:main` pair as bare symbols."
  ;; quasiquote (not `(list 'apply …)`) so α qualifies `apply`
  ;; to `project/apply-config` at this macro's definition (ADR-065 §7).
  `(apply-config (quote ~opts)))

;; `:source-paths` / `:test-paths` must be a vector (or list) of strings — they are
;; handed straight to `map`/`path-join`. A bare string (`:source-paths "src"`, an
;; easy mistake since one path is the common case) used to surface as
;; a bare `type error: first: … got string ("src")` raised from
;; inside `map`, with nothing pointing at the manifest. Name the key and show what
;; was written instead.
(defn- project-check-paths (key value)
  ;; `example` keeps the fix-it accurate per key — suggesting ["src"] for
  ;; :test-paths would be actively misleading.
  (let (example (cond
                  (= key :test-paths) "[\"tests\"]"
                  (= key :format-paths) "[\"examples\"]"
                  else "[\"src\"]"))
    (cond
      (or (vector? value) (pair? value))
        (if (fold value true (fn (ok p) (and ok (string? p))))
          value
          (error "project: "
            key
            " must contain only strings, got "
            (pr-str value)
            " — write it as "
            key
            " "
            example))
      (string? value)
        (error "project: "
          key " must be a VECTOR of paths, not a bare string — write it as " key " [\"" value "\"]")
      else
        (error "project: "
          key
          " must be a vector of path strings, got "
          (pr-str value)
          " — write it as "
          key
          " "
          example))))

(defn- project-parse-kind (value)
  "`:kind` as `:app` or `:library` (the default when absent — it is optional). Any other
value is a manifest error, caught here at load so a typo can't reach a publish. Orthogonal
to `:enhances`: a plugin is an ordinary `:library` that also declares what it enhances."
  (cond
    (nil? value) :library
    (= value :app) :app
    (= value :library) :library
    else
      (error "project: "
        ":kind must be :app or :library, got "
        (pr-str value)
        " — write :kind :app for an application, or omit it (the default is :library)")))

(defn- project-parse-enhances (value)
  "`:enhances` as a `{name-symbol -> constraint-string}` map. Absent is `{}` (an
ordinary library). Names may be written as symbols (`{bedit \">= 0.3\"}`, matching
how dep names are written) or strings; both normalize to symbols, so a consumer
looks a name up one way. A constraint of `\"\"` means \"this application, any
version\", which `version/satisfies?` accepts.

Validated here rather than at load time: a manifest typo should fail when the
manifest is read, naming the key, not later inside whoever consumes the map."
  (cond
    (nil? value) {}
    (not (map? value))
      (error "project: "
        ":enhances must be a MAP of application → version constraint, got "
        (pr-str value)
        " — write it as :enhances {bedit \">= 0.3\"}")
    else
      (fold (%map-pairs value)
        {}
        (fn (acc kv)
          (let ([nm constraint] kv)
            (when (not (string? constraint))
              (error "project: "
                ":enhances constraint for "
                (pr-str nm)
                " must be a string, got "
                (pr-str constraint)
                " — write it as {"
                (pr-str nm)
                " \">= 0.3\"}"))
            (assoc acc (if (symbol? nm) nm (symbol (str nm))) constraint))))))

(defn apply-config (opts)
  "Apply a parsed manifest `opts` (a plist) by `def`ing the `*project-*` globals — name, version, description, paths, `:main` entry, dependencies and formatter settings; returns the project name."
  (def *project-name* (plist-get opts :name))
  (def *project-version* (plist-get opts :version))
  ;; Package-registry metadata (ADR-147): human summary + the git URL this package
  ;; is published from. Optional in general; `nest publish` requires both.
  (def *project-description* (plist-get opts :description))
  (def *project-repository* (plist-get opts :repository))
  (def *project-brood* (plist-get opts :brood))
  ;; Release-bundle only (ADR-070): the FULL set of dependency packages rooted in the bundle
  ;; — transitive included — written by `bundle-collect` so `run-bundle` roots every one, not
  ;; just the direct deps `:dependencies` lists. nil for an ordinary (non-bundle) manifest.
  (def *project-bundled-packages* (plist-get opts :bundled-packages))
  (def *project-enhances* (project-parse-enhances (plist-get opts :enhances)))
  (def *project-kind* (project-parse-kind (plist-get opts :kind)))
  (let (src (plist-get opts :source-paths)
        tst (plist-get opts :test-paths)
        fmt (plist-get opts :format-paths)
        m (plist-get opts :main))
    (when src (def *project-source-paths* (project-check-paths :source-paths src)))
    (when tst (def *project-test-paths* (project-check-paths :test-paths tst)))
    (when fmt (def *project-format-paths* (project-check-paths :format-paths fmt)))
    (when m (def *project-main* (project-parse-main m))))
  (def *project-dependencies* (parse-deps (plist-get opts :dependencies)))
  ;; `:dev-dependencies` (ADR-172) — parsed exactly like `:dependencies`, each tagged
  ;; `:dev true` so the resolver can include them for dev/test and a release bundle can
  ;; drop them. Kept in their own slot, never mixed into *project-dependencies*.
  (def *project-dev-dependencies*
    (map (parse-deps (plist-get opts :dev-dependencies)) (fn (d) (assoc d :dev true))))
  (def *project-format-headers* (plist-get opts :format-headers))
  (def *project-format-plugins* (plist-get opts :format-plugins))
  (def *project-width* (plist-get opts :width))
  *project-name*)

;; --- finding the project + discovering tests ---------------------------------
;; Walk up from `dir` toward the filesystem root, looking for project.blsp.
;; parent-directory is its own fixed point at "/" and ".", which terminates the walk.
(defn find-root (dir)
  "Walk up from `dir` toward the filesystem root, returning the first directory that contains a `project.blsp`, or nil if none is found."
  (cond
    (file/exists? (path/join dir "project.blsp")) dir
    (= dir (path/dirname dir)) nil
    else (find-root (path/dirname dir))))
(sig find-root (string -> (or nil string)))

(defn abs-paths (root rels)
  "Resolve each relative path in `rels` against `root`, returning the list of absolute paths."
  (map rels (fn (r) (path/join root r))))
(sig abs-paths (any seqable -> (or nil (list string))))

;; Recursively collect every <name>_test.blsp path under `dir` (skipping nothing
;; else). Returns a list of full paths; nil if `dir` isn't a directory.
(defn project-collect-tests (dir)
  "Every `<name>_test.blsp` under `dir`, recursively, as a list of full paths — nil when
`dir` is not a directory."
  ;; `cons` a file (O(1)); splice a subdir's list with `%append-two` (copies only the small
  ;; subdir list, SHARES `acc`). A plain `(append acc …)` recopies the growing accumulator
  ;; per entry — O(files²), which made discovery quadratic on a large project. Order is
  ;; reversed (prepend), which is fine: the file list feeds order-independent per-file work.
  (if (file/dir? dir)
    (fold (file/ls dir)
      nil
      (fn (acc entry)
        (let (p (path/join dir entry))
          (cond
            (file/dir? p) (%append-two (project-collect-tests p) acc)
            (string/ends-with? entry "_test.blsp") (cons p acc)
            else acc))))
    nil))

;; Recursively collect every .blsp under `dir` (the project's source files).
(defn collect-sources (dir)
  "Recursively collect every `.blsp` file under `dir` (the project's source files); nil when `dir` is not a directory."
  (if (file/dir? dir)
    ;; Same O(files²)→O(files) fix as `project-collect-tests`: `cons` files, `%append-two`
    ;; subdir lists (copies the small list, shares `acc`) instead of `(append acc …)`.
    (fold (file/ls dir)
      nil
      (fn (acc entry)
        (let (p (path/join dir entry))
          (cond
            (file/dir? p) (%append-two (collect-sources p) acc)
            (string/ends-with? entry ".blsp") (cons p acc)
            else acc))))
    nil))
(sig collect-sources (string -> list))

;; A source file that carries co-located tests (ADR-225): it has a top-level
;; `deftest` or `describe` form. Detection is by FORM — not filename, not module
;; name — so a test written beside the code it exercises is found wherever it
;; lives. Read-only parse; a parse error yields false (the file's real error
;; surfaces when the suite loads it, as with any test file).
(defn- project-file-has-tests? (path)
  ;; check-allow :discarded-catch — a best-effort cache, manifest or git read/write: absence is the answer
  (any? (check-allow :discarded-catch (try (reflect/read-all (file/slurp path)) (catch _ nil)))
    (fn (form)
      (and (pair? form)
        (let (head (first form))
          (or (= head 'describe) (= head 'deftest)))))))

;; Project source files carrying co-located tests (ADR-225), added to the `nest
;; test` corpus so a `deftest`/`describe` written beside the code runs without a
;; `tests/` file. Scans the source paths only; `tests/` files come from
;; `project-collect-tests`.
(defn project-colocated-test-files (root)
  "The project's source files that carry co-located tests (ADR-225), so a `describe` written
beside the code runs under `nest test` without a `tests/` file. Scans the source paths
only; `tests/` files come from `project-collect-tests`."
  (seq/filter (fold (abs-paths root *project-source-paths*)
                nil
                (fn (acc d) (append acc (collect-sources d))))
    project-file-has-tests?))

;; The feature a source file provides — the name of its top-level `(defmodule NAME …)`
;; as a string, or nil when it declares none. Parses the file read-only (never
;; evaluates it), so the loader can tell whether a file is already loaded (its module
;; on `*features*`) without running it. A parse error yields nil → the file is loaded,
;; and the load surfaces the real error.
(defn- project-file-feature (path)
  ;; ROOTED (ADR-070): the key `defmodule` will `provide` is the rooted name when the
  ;; project is rooted (`(defmodule interactive)` in project `bedit` provides
  ;; `bedit/interactive`), and `*features*` is what `project-should-load?` compares
  ;; against. Returning the short name would never match, so every file would re-load —
  ;; and a module an earlier file already `require`d would be evaluated TWICE, resetting
  ;; any registry it builds by rebinding a global (`(def *commands* (assoc *commands* …))`
  ;; starts over, silently emptying it). `%root-module-name` is a no-op for a nameless
  ;; project, so the short name is still the answer there.
  ;; check-allow :discarded-catch — a best-effort cache, manifest or git read/write: absence is the answer
  (check-allow :discarded-catch
    (try
      (fold (reflect/read-all (file/slurp path))
        nil
        (fn (acc f)
          (if (and (nil? acc) (pair? f) (= (first f) 'defmodule) (symbol? (second f)))
            (->string (%root-module-name (second f)))
            acc)))
      (catch e nil))))

;; Whether to (re-)load a source file that provides feature `feat`, given the
;; `*features*` snapshot `before` taken at the start of this walk:
;;   - no module header (`feat` nil) → always load (can't dedup it).
;;   - `skip-all?` (the check pre-flight) → load only if not already provided.
;;   - otherwise → load unless `feat` was provided *during this walk* (in `*features*`
;;     now but not in `before`): that means an earlier file already `require`d it, so
;;     re-loading would wipe its just-built state (e.g. an interactive-command
;;     registry) and re-`defmacro` it. A module provided in a PRIOR walk (so present
;;     in `before`) is still reloaded — that's the long-lived-image re-run picking up
;;     edits.
(defn- project-should-load? (feat skip-all? before)
  (cond
    (nil? feat) true
    skip-all? (not (contains? *features* feat))
    else (or (not (contains? *features* feat)) (contains? before feat))))

;; Load every source file under the project's source paths, so tests and other
;; code can use the project's definitions directly — no per-file `require`. Within
;; one walk each module loads once even when an earlier file `require`d it (its
;; `defmodule` `provide` is the load-once key — see `project-should-load?`); across
;; separate walks a file is re-loaded, so a re-run in a long-lived image picks up
;; edits (the hot-reload contract; the file watcher in std/reload uses `system/reload-defs`).
;; With `:skip-loaded`, any module already on `*features*` is skipped (the check
;; pre-flight, which runs *after* the image is loaded and must not re-evaluate it).
(defn load-sources (root & opts)
  "Load every source file under `root`'s source paths, attributing each file's load-time requires to the root section (KI-37). `:skip-loaded` skips files whose feature is already loaded."
  (let (skip-all? (includes? opts :skip-loaded)
        before *features*)
    (fold (abs-paths root *project-source-paths*)
      nil
      (fn (_ dir)
        (fold (collect-sources dir)
          nil
          (fn (_ f)
            (when (project-should-load? (project-file-feature f) skip-all? before)
              ;; Attribute this file's load-time requires to the ROOT section (KI-37).
              ;; A file WITH a `(defmodule …)` header sets `reflect/current-ns`, which wins and
              ;; keys its edges by its own module. A file WITHOUT one establishes no
              ;; namespace, so its defs are root-level globals that ride the
              ;; always-materialised `""` section — and its requires belong there too,
              ;; or an imaged start restores its functions and never loads what they
              ;; call. `project-install-image` replays the `""` edges.
              (binding (*require-parent* "")
                (reflect/load f)))))))))

;; ═══ Startup image (ADR-218) ═══════════════════════════════════════════════
;; Loading a big project from source costs ~1.1 ms per FILE, almost all of it
;; evaluating and materialising code (read 9% / macroexpand 20% / eval+promote 70%).
;; Rebuilding the same bindings structurally is ~9x faster, so a project that has not
;; changed since its last run starts from a binary image instead of its sources.
;;
;; This is the POLICY half; `%image-write` / `%image-read` are the mechanism. The
;; image only affects STARTUP: it defines exactly the globals a source load would have
;; defined, so `def`, hot reload and late binding behave identically afterwards — a
;; running process picks up a later redefinition the same way either way.

;; --- formatter rules from the manifest (+ its :format-plugins deps) ----------
;; A package declares `:format-headers {head-symbol count …}` in its own manifest;
;; a project pulls a dep's rules in with `:format-plugins [dep …]`, and may add its
;; own `:format-headers`. The effective EXTRA table (layered over format's built-ins)
;; is plugin deps' rules in declaration order, then this project's own on top.
;; Every dep KIND can be a plugin: a `:path` dep's manifest is read in place, and a
;; fetched dep's (`:git`/`:tarball`/`:registry`) from its `_deps/<name>/` checkout.

(defn- project-dep-manifest-path (dep-name root)
  "Path to dependency `dep-name`'s own manifest, for a `:format-plugins` lookup.
A `:path` dep loads in place, so its manifest sits at its `:path`; a `:git` /
`:tarball` / `:registry` dep is fetched into `_deps/<name>/`. Both carry a
`project.blsp`. nil if the project declares no such dep."
  (fold *project-dependencies*
    nil
    (fn (acc d)
      (cond
        (not (nil? acc)) acc
        (not (= (get d :name) dep-name)) acc
        (dep-path? d) (path/join (path/join root (get d :path)) "project.blsp")
        else (path/join (path/join (path/join root "_deps") (->string dep-name)) "project.blsp")))))

(defn- project-manifest-format-headers (manifest-path)
  "Read the `:format-headers` map declared in the manifest at `manifest-path`; {} if
the file is missing or declares none."
  (if (file/exists? manifest-path)
    (let (form (reflect/read-first (file/slurp manifest-path)))
      (if (and (pair? form) (= (first form) 'project))
        (or (plist-get (rest form) :format-headers) {})
        {}))
    {}))

(defn- manifest-enhances (manifest-path)
  "The `:enhances` map declared in the manifest at `manifest-path` — `{app-symbol ->
constraint-string}`, or {} if the file is missing or declares none. The sibling of
`project-manifest-format-headers`, feeding the plugin-discovery query below."
  (if (file/exists? manifest-path)
    (let (form (reflect/read-first (file/slurp manifest-path)))
      (if (and (pair? form) (= (first form) 'project))
        (or (plist-get (rest form) :enhances) {})
        {}))
    {}))

(defn enhancers-in (dir app app-version)
  "The names of packages directly under `dir` (each at `dir/<name>/project.blsp`) that declare
they enhance the application `app` with a constraint satisfied by `app-version`. The general
form of `installed-enhancers`, over ANY package directory — a project's `_deps`, or an app's
own user-package dir (the Emacs `elpa` model), so a running host can discover plugins wherever
it keeps them. Requires nothing, fetches nothing. An absent `dir` is [].

`app`/`app-version` are the host's own name and version: a package whose `:enhances` names
`app` but demands a newer host than `app-version` is excluded, via the same
`version/satisfies-all?` the resolver and `nest search` use. Naming `app` is what gates — an
empty `:enhances` (an ordinary library) satisfies-all vacuously, so it must not count."
  (let (app-symbol (symbol app)
        host {app-symbol app-version})
    (if (not (file/exists? dir))
      []
      (vec (seq/filter (file/ls dir)
             (fn (dep-name)
               (let (enhances (manifest-enhances (path/join (path/join dir dep-name) "project.blsp")))
                 (and (get enhances app-symbol)
                   (version/satisfies-all? host enhances)))))))))
(sig enhancers-in (string (or keyword string symbol) any -> (vector string)))

(defn installed-enhancers (root app app-version)
  "The names of packages installed under `root/_deps` that enhance `app` at a satisfied
`app-version` — `enhancers-in` over a project's dependency dir. The runtime sibling of the
registry's `?enhances=` query (`nest search --enhances`)."
  (enhancers-in (path/join root "_deps") app app-version))
(sig installed-enhancers (string any any -> (vector string)))

(defn- project-plugin-format-headers (root plugin-name)
  "The `:format-headers` a `:format-plugins` entry contributes — read from that
dep's own project.blsp, whatever kind of dep it is. {} when the project declares
no such dep, or when it isn't fetched yet (so an offline image still formats).

An entry naming a dep the manifest doesn't declare is a typo that would otherwise
reformat the project against rules it thinks it pulled in, so it WARNS to stderr.
A declared-but-unfetched dep stays silent — that's the ordinary offline case."
  (let (manifest (project-dep-manifest-path plugin-name root))
    (if (nil? manifest)
      (do
        (io/puts (str "warning: :format-plugins names "
                   plugin-name
                   ", which is not in :dependencies — its formatter rules are not applied")
          :to *err*)
        {})
      (project-manifest-format-headers manifest))))

(defn- project-effective-format-headers (root)
  "The extra formatter-header table for this project: each `:format-plugins` dep's
rules merged in declaration order, then this project's own `:format-headers` on top
(so a project can retune a framework rule). {} when none are declared."
  (let (from-plugins (fold (or *project-format-plugins* (list))
                       {}
                       (fn (acc plugin) (merge acc (project-plugin-format-headers root plugin))))
        own (or *project-format-headers* {}))
    (merge from-plugins own)))

;; Read + apply one manifest file, with errors that point AT THE MANIFEST.
;;
;; Two failure modes used to be silent or cryptic:
;;   - An unparseable manifest raised the bare reader error ("2:1: parse error:
;;     unexpected end of input") with no indication of which file, so a stray
;;     paren in project.blsp looked like a bug in the user's own source.
;;   - A first form that ISN'T `(project …)` — a typo like `(porject …)`, or a
;;     manifest someone wrapped in something — was silently skipped, so every
;;     setting in it was quietly ignored and the project ran on defaults. That is
;;     the worst kind of failure: it looks like it worked.
(defn- project-apply-manifest (manifest-path)
  (let (form (try
               (reflect/read-first (file/slurp manifest-path))
               ;; A parse error arrives as a structured map; unwrap it to a
               ;; readable `file: line L, column C: message` rather than printing
               ;; the raw `{:message … :code … :kind :parse}` at the user.
               (catch e
                 (error "project: cannot parse "
                   manifest-path
                   (if (map? e)
                     (str " at line "
                       (get e :line)
                       ", column "
                       (get e :col)
                       ": "
                       (get e :message))
                     (str ": " e))))))
    (cond
      (and (pair? form) (= (first form) 'project)) (apply-config (rest form))
      (nil? form) (error "project: " manifest-path " is empty — it must hold one (project …) form")
      else
        (error "project: "
          manifest-path
          " must begin with a (project …) form, got "
          (pr-str (if (pair? form) (first form) form))
          " — every setting in it is being ignored"))))

;; The `:brood` runtime gate (ADR-209): if the manifest names a constraint and this
;; runtime doesn't satisfy it, stop with a clear error rather than failing obscurely
;; deeper in on whatever newer feature the project assumed. Policy in Brood; the only
;; kernel input is the `(system/brood-version)` primitive.
(defn- project-check-brood-version ()
  (when *project-brood*
    (when (not (string? *project-brood*))
      (error "project: :brood must be a version-constraint string (e.g. \">= 0.2\"), got "
        (pr-str *project-brood*)))
    (when (not (version/satisfies? (system/brood-version) *project-brood*))
      (error "project: this project requires Brood "
        (pr-str *project-brood*)
        " but you are running "
        (system/brood-version)
        " — upgrade brood, or relax the :brood constraint in project.blsp"))))

(defn setup (root)
  "Initialise the project rooted at `root`: reset the path conventions, apply its `project.blsp` manifest, refuse an incompatible runtime, put its sources and dependencies on the load path, and enable package rooting; returns `root`."
  (def *project-root* root)
  ;; Restore the path conventions BEFORE applying the manifest. `apply`
  ;; only assigns these when the manifest names them, so without the reset a root
  ;; with no manifest — or one that omits :source-paths — silently inherits the
  ;; paths of whichever project was set up before it. That is wrong in any
  ;; long-lived tooling image (the LSP and `nest mcp` set up a second project in
  ;; the same image), and it is the same "always reset stale state" discipline as
  ;; *format-headers-extra* below.
  (def *project-source-paths* (list "src"))
  (def *project-test-paths* (list "tests"))
  ;; Reset `*project-name*` too, for the same reason (a manifest without `:name`, or none
  ;; at all, must NOT inherit a prior setup's name). This matters more since package-rooting
  ;; (ADR-070): a leaked name would make `project-root-project-rooting` wrongly root a
  ;; nameless project's modules under the previous project's prefix. `apply` re-sets
  ;; it when the manifest names it.
  (def *project-name* nil)
  ;; Reset the runtime-version gate too: a manifest with no `:brood` must not inherit a
  ;; prior setup's constraint in a long-lived tooling image (`apply` re-sets it,
  ;; but only when a manifest is applied — a bare/manifest-less setup skips that).
  (def *project-brood* nil)
  ;; Read the manifest as *data* and apply it — rather than `reflect/load`ing it, which
  ;; would need the `(project …)` macro bound bare in the (root) manifest file
  ;; (it now lives in this namespace). Manifests stay written `(project …)`.
  (let (mf (path/join root "project.blsp"))
    (when (file/exists? mf) (project-apply-manifest mf)))
  ;; Refuse an incompatible runtime BEFORE doing any project work (ADR-209).
  (project-check-brood-version)
  (reflect/set-load-path (append (abs-paths root *project-source-paths*) *load-path*))
  (project-ensure-deps-on-path root)
  ;; Root-project rooting (ADR-070, Elixir-uniform model): the project's OWN modules
  ;; root under its `:name` — `(defmodule buffer)` in project `myeditor` becomes the
  ;; global `myeditor/buffer`, with the prefix *implied* (intra-project refs stay short:
  ;; `(:use buffer)` roots to `myeditor/buffer`). This is the dep mechanism (above)
  ;; applied to the root package. Set as an AMBIENT context — not restored — so every
  ;; project source loaded after this point roots; a dependency load nests its own
  ;; context over it and restores back to this. Skipped for a nameless/bare run.
  (project-root-project-rooting root)
  ;; Hand the formatter this project's (+ its plugins') macro-shape rules, so
  ;; `nest format`/LSP/MCP indent framework macros correctly. Always set (resetting
  ;; any stale value from a prior setup in a long-lived tooling image).
  (def *format-headers-extra* (project-effective-format-headers root))
  root)
(sig setup (string -> string))

;; Register the project's OWN modules as package-rooted under its `:name`, and set the
;; ambient package context so every source loaded from here on roots (ADR-070). A no-op
;; when the project is nameless (a bare `brood file.blsp`, or a manifest with no :name):
;; then modules stay short, exactly as before rooting. `module-files` is the
;; same static `(defmodule …)`-name scan the dep path uses.
(defn- project-root-project-rooting (root)
  (if *project-name*
    (do
      ;; `:name` may be written as a symbol (`:name demo`) or a string (`:name "demo"`)
      ;; — the manifest is read as data. Normalise to a string so the registry keys
      ;; (and `%require-force-package`'s string-keyed lookup of them) always agree.
      (let (pkg (->string *project-name*)
            dirs (abs-paths root *project-source-paths*)
            module-files (/apply append (map dirs package/module-files))
            short-modules (map module-files first))
        (%register-package-modules! pkg short-modules)
        (map module-files
          (fn (mf) (%register-package-module! (str pkg "/" (->string (first mf))) (second mf))))
        ;; Ambient: not restored — the project's default context for the whole run. A dep
        ;; load nests its own context over this and restores back to it.
        (%set-package-context (symbol pkg) short-modules)
        nil))
    ;; Nameless project (a bare run, or a manifest with no :name): clear any ambient
    ;; context a *prior* setup left in a long-lived tooling image, so this
    ;; project's short modules don't get wrongly rooted under the previous name.
    (%set-package-context nil nil)))

;; Load a full project image for **tooling** (the LSP and the `nest mcp` server):
;; put the project's sources on *load-path* and load them (so cross-module names
;; resolve), then require the `test` and `format` frameworks so their macros and
;; functions (`describe`/`test`/`assert=`/`is`, `source`) are bound too —
;; otherwise a buffer that uses them false-positives as "unbound" in the advisory
;; checker the tooling runs. One definition both servers share, so they can't
;; drift on which frameworks a tooling image carries. Returns `root`.
(defn setup-tooling-image (root)
  "Bootstrap a project image for tooling (LSP / MCP): load the project's sources
plus the test + format frameworks, so cross-module names and framework macros
resolve in the advisory checker. Returns the project root."
  (setup root)
  ;; Image-backed (ADR-218): a tooling image starts from the artifact when the tree
  ;; is unchanged, and writes one when it isn't — no separate build step, ever.
  (project-image/load-sources-cached root)
  root)
(sig setup-tooling-image (string -> string))

;; If the manifest declared :dependencies, resolve them (writing/refreshing
;; project.lock.blsp) and append each dep's source dir to *load-path* so its
;; modules are require-able. Deferred to the package module (ADR-037), required
;; lazily so a depless project never loads it. Dep dirs go at the END of the path,
;; after the project's own sources, so the project's modules win on a name clash.
(defn- project-ensure-deps-on-path (root)
  ;; `package` is required here (not `:use`d) to avoid a project↔package load cycle;
  ;; qualify its entry points. It's needed for BOTH package-identity recording and deps.
  ;; Package identity (ADR-172): the project's own modules → its package name, so the
  ;; ability system can tell an app module from a library. Always — even a depless project.
  ;; Load `package` explicitly (via the loader, not a bare qualified ref) to control the
  ;; project↔package load cycle: the auto-require a qualified ref triggers would load it
  ;; mid-cycle, leaving its defs unbound. `require-one` here loads it in a controlled order.
  (require-one 'package)
  (when *project-name*
    (package/record-ns-packages (map (abs-paths root *project-source-paths*)
                                  (fn (d) (list *project-name* d)))))
  ;; Dev/test setup sees BOTH the production deps and the `:dev-dependencies` (ADR-172):
  ;; a `nest test`/`nest run` in a dev image resolves and load-paths them all, exactly
  ;; like Cargo's dev-dependencies being available for tests locally. The release bundle
  ;; (`bundle-collect`) reads `*project-dependencies*` alone, so dev-deps are excluded
  ;; from a shipped binary — the whole reason they live in their own slot. `ensure-deps`
  ;; also records each dep's modules → the dep's name in `*ns-package*`.
  (let (deps (append *project-dependencies* *project-dev-dependencies*))
    (when deps
      (reflect/set-load-path (append *load-path* (package/ensure-deps root deps))))))

;; --- user config (~/.config/brood/config.blsp) -------------------------------
;; A user-level Brood file of tooling preferences — the sibling of project.blsp.
;; It's auto-created with documented defaults on first tool use, then loaded by
;; the `nest` subcommands. Rust mechanism: os/env (locate it) + os/run-process.
(defdyn *config-git-init* false)
; nest new: run `git init` in the new project?

;; The default package registry — the base URL of a hosted registry (hive) speaking
;; the JSON API `nest search`/`publish` and `:version` deps use. Override via
;; `:registry` in the user config, or pass an explicit base URL to the registry
;; functions (tests do). The publish auth token comes from $HIVE_TOKEN or
;; `:registry-token` (never baked into a default).
(defdyn *config-registry* "https://brood.fly.dev")
(defdyn *config-registry-token* nil)

(defn config (& opts)
  "Set user-level tooling preferences — the form the user config file (`~/.config/brood/config.blsp`) contains. Recognized keys: `:git-init` (whether `nest new` runs `git init`), `:registry` (the package-registry base URL), and `:registry-token` (the Bearer token `nest publish` sends; $HIVE_TOKEN overrides it). Sets only the keys given; returns nil."
  (let (gi (plist-get opts :git-init)) (unless (nil? gi) (def *config-git-init* gi)))
  (let (rg (plist-get opts :registry)) (unless (nil? rg) (def *config-registry* rg)))
  (let (tok (plist-get opts :registry-token)) (unless (nil? tok) (def *config-registry-token* tok)))
  nil)

(defn- config-base-dir ()
  ; $XDG_CONFIG_HOME, else ~/.config
  (let (xdg (os/env "XDG_CONFIG_HOME"))
    (if (nil? xdg)
      (path/join (or (os/env "HOME")
                   (error "config-base-dir: neither XDG_CONFIG_HOME nor HOME is set"))
        ".config")
      xdg)))
(defn- config-dir () (path/join (config-base-dir) "brood"))
(defn- config-path () (path/join (config-dir) "config.blsp"))

(def *config-default-source*
  (str ";; Brood user config — tooling preferences (the sibling of project.blsp).\n"
    ";; Edit to taste; any `nest` command re-reads it.\n" "(config\n"
    "  :git-init false)   ; run `git init` in projects made by `nest new`\n"))

;; Ensure the config exists (writing a documented default the first time), then
;; apply it. Called by the `brood` subcommands, so a tool use always leaves an
;; editable config behind.
(defn load-config ()
  "Ensure the user config (`~/.config/brood/config.blsp`) exists — writing a documented default on first use — then apply it. Called by the `nest` subcommands."
  (let (p (config-path))
    (unless (file/exists? p)
      (file/mkdir (config-dir))
      (file/spit p *config-default-source*)
      (io/puts (str "Created " p)))
    ;; Read the config as DATA and apply the `(config …)` form directly, rather
    ;; than `(reflect/load)`-ing it as code. `reflect/load` evaluates a file at the *root*
    ;; namespace with a fresh (empty) import table (ADR-065), so a bare
    ;; `(config …)` written in the user file would not resolve to this module's
    ;; `project/config`. Reading-as-data keeps the user config a clean bare DSL
    ;; (the project manifest is read the same way, ADR-020) and decouples it from
    ;; namespace resolution — `config` here is `project/config` (this body is
    ;; compiled in the `project` namespace), so the apply resolves.
    (let (form (reflect/read-first (file/slurp p)))
      (when (and (pair? form) (= (first form) 'config))
        (/apply config (rest form)))))
  nil)
