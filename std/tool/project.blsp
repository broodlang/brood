;; std/project.blsp — the project model + test runner (ADR-020), in Brood.
;;
;;   (require 'project)       ; loaded on demand; baked into the binary
;;   (run-project-tests)      ; find project.blsp, discover tests, run them once
;;
;; This is the policy behind `nest test`. Convention over configuration: `src/`
;; holds the project's source (added to *load-path*), `tests/` holds tests
;; discovered as <name>_test.blsp. A `project.blsp` manifest declares identity
;; and may override the conventional paths. Rust supplies only the filesystem
;; mechanism (cwd / file-exists? / dir? / list-dir) and `load`; everything here
;; is ordinary Brood.

(defmodule project
  "The project model and test runner behind `nest` (ADR-020), written in Brood.
Convention over configuration: `src/` holds source (added to *load-path*),
`tests/` holds <name>_test.blsp cases; a `project.blsp` manifest declares
identity and may override those paths. Also home to the user-config loader and
the `nest new` scaffolder."
  ;; NOT `(:use test)`: that would `(require 'test)` at *load* time, so a lean
  ;; release runtime (which strips the test framework, ADR-038) couldn't even
  ;; load `project` to boot a bundle. The test runner needs test only when it
  ;; actually runs — `run-project-tests` `(require 'test)`s and qualifies it.
)

;; --- the project, as set by the manifest -------------------------------------

(defdyn *project-root* nil)
(defdyn *project-name* nil)
(defdyn *project-version* nil)
;; namespace → owning package name (ADR-172 package identity). Populated at project setup
;; by a static scan of each provider's `(defmodule …)` names: the project's own `src/`
;; modules map to `*project-name*`, a dependency's modules to that dep's `:name`. It is the
;; ability system's app-vs-library seam — an impl whose module's package is `*project-name*`
;; is the app (top precedence tier). A module absent here (embedded std, or none) is not the
;; app. Purely identity: no name-rooting/prefixing (that stays the deferred ADR-070 upgrade).
(defdyn *ns-package* {})

(defn ns-package (ns-or-name)
  "The owning package of a namespace or a qualified `mod/fn` name (ADR-172 package identity).
  Resolves the MODULE either way — a module namespace (`widget`, `editor/display`) directly,
  or the module of a qualified name (`widget/w` → `widget`, `editor/display/draw` →
  `editor/display`). Returns the package name, or nil for an unrecorded/embedded (std)
  module, a root (unqualified) name, or when no project is loaded. This is the seam for
  surfacing package in stack traces — `(ns-package (get frame :fn))` — introspection, and
  tooling. `nil` in (an anonymous / top-level trace frame has no `:fn`) yields `nil` out."
  (when ns-or-name
    (let (s (if (symbol? ns-or-name) ns-or-name (symbol ns-or-name)))
      (or (get *ns-package* s)
        ;; not a module directly — treat it as a qualified name, strip the last `/`-segment
        ;; (the def/fn name) and look up its module.
        (let (parts (string-split (str s) "/"))
          (if (> (count parts) 1)
            (get *ns-package* (symbol (join "/" (take (- (count parts) 1) parts))))
            nil))))))

(defn trace-with-packages (trace)
  "Annotate each stack-trace frame (`{:fn :file :line :col}`) with `:package` — the owning
  package of its function (ADR-172). `trace` is the `:trace` on a caught kernel-error map.
  Frames whose function is root/std/unrecorded get `:package nil`."
  (map (fn (frame) (assoc frame :package (ns-package (get frame :fn)))) trace))
;; Only ever set inside `project-setup` (from the manifest) and read by
;; `package` when it publishes — so they must be declared ambient here, like the
;; slots above: ambient is a `defdyn` declaration now, not an earmuff spelling.
(defdyn *project-description* nil)
(defdyn *project-repository* nil)
(defdyn *project-source-paths* (list "src"))
; conventional default
(defdyn *project-test-paths* (list "tests"))
; conventional default
(defdyn *project-main* (list 'main 'main))
; (module fn) — `nest run` entry, as declared by the manifest's `:main`
(defdyn *project-main-override* nil)
; (module fn) or nil — a `nest run --main` override that wins over the manifest.
; A separate slot (not `*project-main*`) because the manifest is re-applied
; inside `run-project` (via `project-setup`), which would otherwise clobber an
; override set before the run.
(defdyn *project-dependencies* nil)
; list of dep records from the manifest's :dependencies (ADR-037)
(defdyn *project-dev-dependencies* nil)
; dev/test-only dep records from the manifest's :dev-dependencies (ADR-172): resolved for
; `nest test`/dev and on the dev load path, but excluded from a release bundle. Each
; carries `:dev true`. Kept separate from *project-dependencies* so a release build (and
; a published package's declared deps) never pulls a test-only dependency.
(def *project-format-headers* nil)
; the manifest's :format-headers map ({head-symbol → header-count}) — extra formatter
; rules for this project's own macros; nil when unset
(def *project-format-plugins* nil)
; the manifest's :format-plugins vector ([dep-name …]) — deps whose own
; :format-headers this project pulls in (so a framework ships its macro shapes)

;; (plist-get '(:a 1 :b 2) :b) => 2 — the value after key k in a flat kv list, or nil.
(defn plist-get (kvs k)
  (cond (empty? kvs) nil (= (first kvs) k) (second kvs) else (plist-get (rest (rest kvs)) k)))

;; Normalise the manifest's `:main` value into a `(module fn)` pair of symbols.
;;   'foo           => '(foo main)        ; module foo, default fn name `main`
;;   '(foo bar)     => '(foo bar)         ; module foo, fn bar
;;   anything else  => error
(defn project--parse-main (v)
  (cond
    (symbol? v) (list v 'main)
    ;; `:main 'app` / `:main '(app start)` reads as `(quote …)` — the manifest is
    ;; data and never evaluated, so the quote is literal, not stripped. Catch it
    ;; with a fix-it instead of silently parsing module `quote`.
    (and (pair? v) (= (first v) 'quote)) (error "project: :main takes a bare symbol, not a quoted one — write `:main "
                                           (second v)
                                           "` (the manifest is data, so drop the leading quote)")
    (and (pair? v) (symbol? (first v)) (pair? (rest v)) (symbol? (second v)) (nil? (rest (rest v)))) (list (first v)
                                                                                                       (second v))
    else (error "project: :main must be a module symbol or '(module fn), got " v)))

;; Parse a CLI entry spec — "module" or "module/fn" — into a `(module fn)` pair.
;; The `nest run --main` override: a one-off entry without editing the manifest.
;;   "app"        => (app main)
;;   "app/start"  => (app start)
(defn project--parse-main-spec (spec)
  (let (parts (string-split spec "/")
        ; reject blank module/fn halves so a typo like "" or "/start" errors
        ; cleanly here, not as a malformed `(require '||)` downstream.
        ok? (fn (p) (not (blank? p))))
    (cond
      (and (= (count parts) 1) (ok? (first parts))) (list (symbol (first parts)) 'main)
      (and (= (count parts) 2) (ok? (first parts)) (ok? (second parts))) (list (symbol (first parts))
                                                                           (symbol (second parts)))
      else (error "nest run --main: expected \"module\" or \"module/fn\", got " spec))))

(defn set-project-main (spec)
  "Override the `nest run` entry point from a CLI spec string (`\"module\"` or `\"module/fn\"`), without editing the manifest's `:main`. Sets a dedicated override slot that wins over the manifest even though `run-project` re-applies the manifest internally. Backs `nest run --main`."
  (def *project-main-override* (project--parse-main-spec spec)))

;; --- dependency manifest parsing (ADR-037, packages.md) ----------------------
;; Each :dependencies entry is a vector: `[name :git URL :ref REF]` or
;; `[name :path PATH]` — `name` is the local symbol `require` will see. Parsed
;; into one of the four **dep records** below for the package manager
;; (std/package.blsp) to consume. The reserved opts :branch/:dir/:features
;; are recognised but rejected in v1, so the manifest shape stays forward-compatible.
;;
;; A dep's KIND is its record identity, not a `:kind` field: the package manager
;; dispatches every per-kind behaviour (resolve, lock entry, manifest entry,
;; compatibility) through the `Dependency` ability it declares over these four types,
;; which is `:sealed` over exactly this set — so `nest check` flags a new kind that
;; forgets one of them. This module owns the *types* (it parses the manifest);
;; std/package.blsp owns the *behaviour*. A resolved entry is one of these records with
;; the resolution fields (`:resolved-path`/`:sha256`/`:commit`/`:deps`) assoc'd on, so it
;; dispatches identically to the dep it came from.

(def *project--reserved-dep-opts* (list :branch :dir :features))

(defrecord dep-path (name path))
(defrecord dep-git (name url ref))
(defrecord dep-tarball (name url sha256))
(defrecord dep-registry (name version))

;; A dep's display form is its `nest tree` line — one place, so `(println dep)` and the
;; tree agree. Registered here (the type owner) rather than in the package manager.
(impl Display
  project/dep-path (to-str [d] (str (get d :name) "  (path \"" (get d :path) "\")")))
(impl Display
  project/dep-git (to-str [d] (str (get d :name) "  (git " (get d :url) " @ " (get d :ref) ")")))
(impl Display
  project/dep-tarball (to-str [d] (str (get d :name) "  (tarball " (get d :url) ")")))
(impl Display
  project/dep-registry (to-str [d] (str (get d :name) "  (registry v" (get d :version) ")")))

(def *project--dep-ids*
  (list :project/dep-path :project/dep-git :project/dep-tarball :project/dep-registry))

(defn dep? (x)
  "True if `x` is a dependency record (any of the four kinds)."
  (and (record? x) (includes? *project--dep-ids* (record-id x))))

(defn dep-path? (x)
  "True if `x` is a `:path` dependency — the one kind that loads **in place** rather
than being fetched into `_deps/<name>/`."
  (and (record? x) (= (record-id x) :project/dep-path)))

;; The elements of vector `v` from index `start` onward, as a list (tail-recursive).
(defn project--vec-drop (v start) (project--vec-drop--acc v start (dec (vector-length v)) nil))
(defn project--vec-drop--acc (v start i acc)
  (if (< i start) acc (project--vec-drop--acc v start (dec i) (cons (vector-ref v i) acc))))

;; The keys of a flat plist (every other element from the head).
;; check-allow: deliberately non-tail — depth = the manifest plist's key count.
(check-allow :non-tail-recursion
  (defn project--plist-keys (kvs)
    (if (empty? kvs) nil (cons (first kvs) (project--plist-keys (rest (rest kvs)))))))

;; Reject any reserved opt key present in `opts`, naming the offending dep.
(defn project--reject-reserved-opts (name opts)
  (fold (fn (_ k)
          (when (includes? *project--reserved-dep-opts* k)
            (error "project: dependency "
              name " uses " k ", which is reserved for a future version")))
    nil (project--plist-keys opts)))

(defn project--parse-git-dep (name entry)
  (let (url (vector-ref entry 2)
        opts (project--vec-drop entry 3)
        ref (plist-get opts :ref))
    (when (not (string? url))
      (error "project: :git dependency " name " URL must be a string, got " url))
    (when (not (string? ref))
      (error "project: :git dependency " name " needs a :ref \"<tag-or-commit>\""))
    (project--reject-reserved-opts name opts)
    (dep-git name url ref)))

(defn project--parse-path-dep (name entry)
  (let (path (vector-ref entry 2)
        opts (project--vec-drop entry 3))
    (when (not (string? path))
      (error "project: :path dependency " name " path must be a string, got " path))
    (project--reject-reserved-opts name opts)
    (dep-path name path)))

(defn project--parse-registry-dep (name entry)
  (let (version (vector-ref entry 2)
        opts (project--vec-drop entry 3))
    (when (not (string? version))
      (error "project: registry dependency " name " version must be a string, got " version))
    (project--reject-reserved-opts name opts)
    (dep-registry name version)))

(defn project--parse-tarball-dep (name entry)
  (let (url (vector-ref entry 2)
        opts (project--vec-drop entry 3)
        sha (plist-get opts :sha256))
    (when (not (string? url))
      (error "project: :tarball dependency " name " URL must be a string, got " url))
    ;; A tarball has no commit to trust, so a :sha256 is MANDATORY — it's the only
    ;; thing pinning the fetched bytes to reviewed content (ADR-037 supply-chain).
    (when (not (string? sha))
      (error "project: :tarball dependency "
        name " needs a :sha256 \"<hex>\" (the archive's SHA-256 — the only integrity pin)"))
    (project--reject-reserved-opts name opts)
    (dep-tarball name url sha)))

;; Normalise one `[name kind spec & opts]` entry into the dep record for its kind.
(defn project-parse-dep (entry)
  (when (not (vector? entry))
    (error "project: each :dependencies entry must be a vector, got " entry))
  (when (< (vector-length entry) 3) (error "project: dependency entry is too short: " entry))
  (let (name (vector-ref entry 0)
        kind (vector-ref entry 1)
        opts (project--vec-drop entry 3))
    (when (not (symbol? name)) (error "project: dependency name must be a symbol, got " name))
    (let (base (cond
                 (= kind :git) (project--parse-git-dep name entry)
                 (= kind :path) (project--parse-path-dep name entry)
                 (= kind :tarball) (project--parse-tarball-dep name entry)
                 (= kind :version) (project--parse-registry-dep name entry)
                 else (error "project: dependency "
                        name " must be :git, :path, :tarball, or :version, got " kind))
          ;; `:optional` (ADR-172) — a dep declared but not force-installed. Recognised on
          ;; every dep kind; defaults false. (Resolution semantics — peer presence — are
          ;; deferred: this normalises the manifest flag. The bridge/glue motivation was
          ;; dropped in the 2026-07-28 amendment, so `:optional` is now the generic
          ;; Cargo/Elixir optional dependency, decoupled from abilities.)
          optional (if (plist-get opts :optional) true false))
      (assoc base :optional optional))))

;; Parse the manifest's :dependencies value into a list of dep records.
;; Omitted/nil => empty list.
(defn project-parse-deps (deps)
  (cond
    (nil? deps) nil
    (vector? deps) (map project-parse-dep deps)
    else (error "project: :dependencies must be a vector of dep entries, got " deps)))

;; The (project ...) manifest form: records identity, and overrides the
;; conventional source/test paths, the `nest run` entry, and the dependency set
;; when given. Missing keys keep their defaults. Called when a project.blsp is loaded.
;;
;; It is a macro that treats its arguments as **literal data** (it quotes them and
;; hands them to `project-apply`), so a manifest writes bare symbols — dep names
;; and the `:main` pair — without quoting. Manifests are static data; nothing in
;; them is ever evaluated.
(defmacro project (& opts)
  "Declare the project manifest (ADR-020/037): `:name` `:version` `:description` `:repository` `:source-paths` `:test-paths` `:main`, `:dependencies` and `:dev-dependencies` (test/dev-only, excluded from a release bundle — ADR-172). A dep entry may carry `:optional true` (declared but not force-installed). Arguments are literal data — write dep names and the `:main` pair as bare symbols."
  ;; quasiquote (not `(list 'project-apply …)`) so α qualifies `project-apply`
  ;; to `project/project-apply` at this macro's definition (ADR-065 §7).
  `(project-apply (quote ~opts)))

;; `:source-paths` / `:test-paths` must be a vector (or list) of strings — they are
;; handed straight to `map`/`path-join`. A bare string (`:source-paths "src"`, an
;; easy mistake since one path is the common case) used to surface as
;; a bare `type error: first: … got string ("src")` raised from
;; inside `map`, with nothing pointing at the manifest. Name the key and show what
;; was written instead.
(defn project--check-paths (key value)
  ;; `example` keeps the fix-it accurate per key — suggesting ["src"] for
  ;; :test-paths would be actively misleading.
  (let (example (if (= key :test-paths) "[\"tests\"]" "[\"src\"]"))
    (cond
      (or (vector? value) (pair? value)) (if (fold (fn (ok p) (and ok (string? p))) true value)
                                           value
                                           (error "project: "
                                             key " must contain only strings, got " (pr-str value)
                                             " — write it as " key " " example))
      (string? value) (error "project: "
                        key " must be a VECTOR of paths, not a bare string — write it as " key
                        " [\"" value "\"]")
      else (error "project: "
             key " must be a vector of path strings, got " (pr-str value) " — write it as " key " "
             example))))

(defn project-apply (opts)
  (def *project-name* (plist-get opts :name))
  (def *project-version* (plist-get opts :version))
  ;; Package-registry metadata (ADR-147): human summary + the git URL this package
  ;; is published from. Optional in general; `nest publish` requires both.
  (def *project-description* (plist-get opts :description))
  (def *project-repository* (plist-get opts :repository))
  (let (src (plist-get opts :source-paths)
        tst (plist-get opts :test-paths)
        m (plist-get opts :main))
    (when src (def *project-source-paths* (project--check-paths :source-paths src)))
    (when tst (def *project-test-paths* (project--check-paths :test-paths tst)))
    (when m (def *project-main* (project--parse-main m))))
  (def *project-dependencies* (project-parse-deps (plist-get opts :dependencies)))
  ;; `:dev-dependencies` (ADR-172) — parsed exactly like `:dependencies`, each tagged
  ;; `:dev true` so the resolver can include them for dev/test and a release bundle can
  ;; drop them. Kept in their own slot, never mixed into *project-dependencies*.
  (def *project-dev-dependencies*
    (map (fn (d) (assoc d :dev true))
      (project-parse-deps (plist-get opts :dev-dependencies))))
  (def *project-format-headers* (plist-get opts :format-headers))
  (def *project-format-plugins* (plist-get opts :format-plugins))
  *project-name*)

;; --- finding the project + discovering tests ---------------------------------
;; Walk up from `dir` toward the filesystem root, looking for project.blsp.
;; parent-dir is its own fixed point at "/" and ".", which terminates the walk.
(defn project-find-root (dir)
  (cond
    (file-exists? (path-join dir "project.blsp")) dir
    (= dir (parent-dir dir)) nil
    else (project-find-root (parent-dir dir))))

(defn project-abs-paths (root rels) (map (fn (r) (path-join root r)) rels))

;; Recursively collect every <name>_test.blsp path under `dir` (skipping nothing
;; else). Returns a list of full paths; nil if `dir` isn't a directory.
(defn project--collect-tests (dir)
  ;; `cons` a file (O(1)); splice a subdir's list with `append-two` (copies only the small
  ;; subdir list, SHARES `acc`). A plain `(append acc …)` recopies the growing accumulator
  ;; per entry — O(files²), which made discovery quadratic on a large project. Order is
  ;; reversed (prepend), which is fine: the file list feeds order-independent per-file work.
  (if (dir? dir)
    (fold (fn (acc entry)
            (let (p (path-join dir entry))
              (cond
                (dir? p) (append-two (project--collect-tests p) acc)
                (ends-with? entry "_test.blsp") (cons p acc)
                else acc)))
      nil (list-dir dir))
    nil))

;; Recursively collect every .blsp under `dir` (the project's source files).
(defn project-collect-sources (dir)
  (if (dir? dir)
    ;; Same O(files²)→O(files) fix as `project--collect-tests`: `cons` files, `append-two`
    ;; subdir lists (copies the small list, shares `acc`) instead of `(append acc …)`.
    (fold (fn (acc entry)
            (let (p (path-join dir entry))
              (cond
                (dir? p) (append-two (project-collect-sources p) acc)
                (ends-with? entry ".blsp") (cons p acc)
                else acc)))
      nil (list-dir dir))
    nil))

;; The feature a source file provides — the name of its top-level `(defmodule NAME …)`
;; as a string, or nil when it declares none. Parses the file read-only (never
;; evaluates it), so the loader can tell whether a file is already loaded (its module
;; on `*features*`) without running it. A parse error yields nil → the file is loaded,
;; and the load surfaces the real error.
(defn project--file-feature (path)
  (try
    (fold (fn (acc f)
            (if (and (nil? acc) (pair? f) (= (first f) 'defmodule) (symbol? (second f)))
              (name (second f))
              acc))
      nil (read-all (slurp path)))
    (catch e nil)))

;; Whether to (re-)load a source file that provides feature `feat`, given the
;; `*features*` snapshot `before` taken at the start of this walk:
;;   - no module header (`feat` nil) → always load (can't dedup it).
;;   - `skip-all?` (the check pre-flight) → load only if not already provided.
;;   - otherwise → load unless `feat` was provided *during this walk* (in `*features*`
;;     now but not in `before`): that means an earlier file already `require`d it, so
;;     re-loading would wipe its just-built state (e.g. an interactive-command
;;     registry) and re-`defmacro` it. A module provided in a PRIOR walk (so present
;;     in `before`) is still reloaded — that's the long-lived-image re-run picking up
;;     edits.
(defn project--should-load? (feat skip-all? before)
  (cond
    (nil? feat) true
    skip-all? (not (member? feat *features*))
    else (or (not (member? feat *features*)) (member? feat before))))

;; Load every source file under the project's source paths, so tests and other
;; code can use the project's definitions directly — no per-file `require`. Within
;; one walk each module loads once even when an earlier file `require`d it (its
;; `defmodule` `provide` is the load-once key — see `project--should-load?`); across
;; separate walks a file is re-loaded, so a re-run in a long-lived image picks up
;; edits (the hot-reload contract; the file watcher in std/reload uses `reload-defs`).
;; With `:skip-loaded`, any module already on `*features*` is skipped (the check
;; pre-flight, which runs *after* the image is loaded and must not re-evaluate it).
(defn project-load-sources (root & opts)
  (let (skip-all? (member? :skip-loaded opts)
        before *features*)
    (fold (fn (_ dir)
            (fold (fn (_ f)
                    (when (project--should-load? (project--file-feature f) skip-all? before)
                      (load f)))
              nil (project-collect-sources dir)))
      nil (project-abs-paths root *project-source-paths*))))

;; Load the manifest (if present) and put the project's source dirs on *load-path*
;; so its modules are require-able by name.
;; --- formatter rules from the manifest (+ its :format-plugins deps) ----------
;; A package declares `:format-headers {head-symbol count …}` in its own manifest;
;; a project pulls a dep's rules in with `:format-plugins [dep …]`, and may add its
;; own `:format-headers`. The effective EXTRA table (layered over format's built-ins)
;; is plugin deps' rules in declaration order, then this project's own on top.
;; Every dep KIND can be a plugin: a `:path` dep's manifest is read in place, and a
;; fetched dep's (`:git`/`:tarball`/`:registry`) from its `_deps/<name>/` checkout.

(defn project--dep-manifest-path (dep-name root)
  "Path to dependency `dep-name`'s own manifest, for a `:format-plugins` lookup.
A `:path` dep loads in place, so its manifest sits at its `:path`; a `:git` /
`:tarball` / `:registry` dep is fetched into `_deps/<name>/`. Both carry a
`project.blsp`. nil if the project declares no such dep."
  (fold (fn (acc d)
          (cond
            (not (nil? acc)) acc
            (not (= (get d :name) dep-name)) acc
            (dep-path? d) (path-join (path-join root (get d :path)) "project.blsp")
            else (path-join (path-join (path-join root "_deps") (name dep-name)) "project.blsp")))
    nil *project-dependencies*))

(defn project--manifest-format-headers (manifest-path)
  "Read the `:format-headers` map declared in the manifest at `manifest-path`; {} if
the file is missing or declares none."
  (if (file-exists? manifest-path)
    (let (form (read-first (slurp manifest-path)))
      (if (and (pair? form) (= (first form) 'project))
        (or (plist-get (rest form) :format-headers) {})
        {}))
    {}))

(defn project--plugin-format-headers (root plugin-name)
  "The `:format-headers` a `:format-plugins` entry contributes — read from that
dep's own project.blsp, whatever kind of dep it is. {} when the project declares
no such dep, or when it isn't fetched yet (so an offline image still formats).

An entry naming a dep the manifest doesn't declare is a typo that would otherwise
reformat the project against rules it thinks it pulled in, so it WARNS to stderr.
A declared-but-unfetched dep stays silent — that's the ordinary offline case."
  (let (manifest (project--dep-manifest-path plugin-name root))
    (if (nil? manifest)
      (do
        (eprintln (str "warning: :format-plugins names "
                    plugin-name
                    ", which is not in :dependencies — its formatter rules are not applied"))
        {})
      (project--manifest-format-headers manifest))))

(defn project--effective-format-headers (root)
  "The extra formatter-header table for this project: each `:format-plugins` dep's
rules merged in declaration order, then this project's own `:format-headers` on top
(so a project can retune a framework rule). {} when none are declared."
  (let (from-plugins (fold (fn (acc plugin)
                             (merge acc (project--plugin-format-headers root plugin)))
                       {} (or *project-format-plugins* (list)))
        own (or *project-format-headers* {}))
    (merge from-plugins own)))

;; Read + apply one manifest file, with errors that point AT THE MANIFEST.
;;
;; Two failure modes used to be silent or cryptic:
;;   - An unparseable manifest raised the bare reader error ("2:1: parse error:
;;     unexpected end of input") with no indication of which file, so a stray
;;     paren in project.blsp looked like a bug in the user's own source.
;;   - A first form that ISN'T `(project …)` — a typo like `(porject …)`, or a
;;     manifest someone wrapped in something — was silently skipped, so every
;;     setting in it was quietly ignored and the project ran on defaults. That is
;;     the worst kind of failure: it looks like it worked.
(defn project--apply-manifest (manifest-path)
  (let (form (try
               (read-first (slurp manifest-path))
               ;; A parse error arrives as a structured map; unwrap it to a
               ;; readable `file: line L, column C: message` rather than printing
               ;; the raw `{:message … :code … :kind :parse}` at the user.
               (catch e
                 (error "project: cannot parse "
                   manifest-path
                   (if (map? e)
                     (str " at line "
                       (get e :line) ", column " (get e :col) ": " (get e :message))
                     (str ": " e))))))
    (cond
      (and (pair? form) (= (first form) 'project)) (project-apply (rest form))
      (nil? form) (error "project: " manifest-path " is empty — it must hold one (project …) form")
      else (error "project: "
             manifest-path " must begin with a (project …) form, got "
             (pr-str (if (pair? form) (first form) form)) " — every setting in it is being ignored"))))

(defn project-setup (root)
  (def *project-root* root)
  ;; Restore the path conventions BEFORE applying the manifest. `project-apply`
  ;; only assigns these when the manifest names them, so without the reset a root
  ;; with no manifest — or one that omits :source-paths — silently inherits the
  ;; paths of whichever project was set up before it. That is wrong in any
  ;; long-lived tooling image (the LSP and `nest mcp` set up a second project in
  ;; the same image), and it is the same "always reset stale state" discipline as
  ;; *format-headers-extra* below.
  (def *project-source-paths* (list "src"))
  (def *project-test-paths* (list "tests"))
  ;; Read the manifest as *data* and apply it — rather than `load`ing it, which
  ;; would need the `(project …)` macro bound bare in the (root) manifest file
  ;; (it now lives in this namespace). Manifests stay written `(project …)`.
  (let (mf (path-join root "project.blsp"))
    (when (file-exists? mf) (project--apply-manifest mf)))
  (set-load-path! (append (project-abs-paths root *project-source-paths*) *load-path*))
  (project--ensure-deps-on-path root)
  ;; Hand the formatter this project's (+ its plugins') macro-shape rules, so
  ;; `nest format`/LSP/MCP indent framework macros correctly. Always set (resetting
  ;; any stale value from a prior setup in a long-lived tooling image).
  (def *format-headers-extra* (project--effective-format-headers root))
  root)

;; Load a full project image for **tooling** (the LSP and the `nest mcp` server):
;; put the project's sources on *load-path* and load them (so cross-module names
;; resolve), then require the `test` and `format` frameworks so their macros and
;; functions (`describe`/`test`/`assert=`/`is`, `format-source`) are bound too —
;; otherwise a buffer that uses them false-positives as "unbound" in the advisory
;; checker the tooling runs. One definition both servers share, so they can't
;; drift on which frameworks a tooling image carries. Returns `root`.
(defn setup-tooling-image (root)
  "Bootstrap a project image for tooling (LSP / MCP): load the project's sources
plus the test + format frameworks, so cross-module names and framework macros
resolve in the advisory checker. Returns the project root."
  (project-setup root)
  (project-load-sources root)
  (require 'test)
  (require 'format)
  root)

;; If the manifest declared :dependencies, resolve them (writing/refreshing
;; project.lock.blsp) and append each dep's source dir to *load-path* so its
;; modules are require-able. Deferred to the package module (ADR-037), required
;; lazily so a depless project never loads it. Dep dirs go at the END of the path,
;; after the project's own sources, so the project's modules win on a name clash.
(defn project--ensure-deps-on-path (root)
  ;; `package` is required here (not `:use`d) to avoid a project↔package load cycle;
  ;; qualify its entry points. It's needed for BOTH package-identity recording and deps.
  (require 'package)
  ;; Package identity (ADR-172): the project's own modules → its package name, so the
  ;; ability system can tell an app module from a library. Always — even a depless project.
  (when *project-name*
    (package/package-record-ns-packages (map (fn (d) (list *project-name* d))
                                          (project-abs-paths root *project-source-paths*))))
  ;; Dev/test setup sees BOTH the production deps and the `:dev-dependencies` (ADR-172):
  ;; a `nest test`/`nest run` in a dev image resolves and load-paths them all, exactly
  ;; like Cargo's dev-dependencies being available for tests locally. The release bundle
  ;; (`bundle-collect`) reads `*project-dependencies*` alone, so dev-deps are excluded
  ;; from a shipped binary — the whole reason they live in their own slot. `ensure-deps`
  ;; also records each dep's modules → the dep's name in `*ns-package*`.
  (let (deps (append *project-dependencies* *project-dev-dependencies*))
    (when deps
      (set-load-path! (append *load-path* (package/ensure-deps root deps))))))

;; Every .blsp file the project owns — its source files plus its test files.
;; The set the advisory type-checker walks for `(check-project)`.
(defn project--all-files (root)
  (let (src-dirs (project-abs-paths root *project-source-paths*)
        test-dirs (project-abs-paths root *project-test-paths*))
    (append (fold (fn (a d) (append a (project-collect-sources d))) nil src-dirs)
      (fold (fn (a d) (append a (project--collect-tests d))) nil test-dirs))))

;; ── KI-17 reachability: each file's transitive require-closure ────────────────
;; A file that names `mod/foo` must be able to REACH `mod`; otherwise the reference
;; resolves only by load-order luck (another file pulled `mod` in first) and breaks
;; the moment that file moves — the KI-17 bug (docs/known-issues.md). `check-file`
;; flags such a reference, but only when told which modules the file may reach. That
;; set must be the *transitive* closure of the file's own requires (a file reaches
;; `mod` if it, or a module it requires, recursively, `:use`s / `(require 'mod)`s it):
;; e.g. a test that `(:use editor/treesit)` legitimately names `face/…` because
;; treesit itself requires `editor/face`. Only the whole-project driver sees every
;; header, so it builds the module→direct-deps graph (one native `%module-direct-requires`
;; parse per file) and closes it per file, then hands each file's set to `check-file`.

;; {file -> {:module name :requires [dep …]}} for every file — one native parse each.
(defn project--module-infos (files)
  (fold (fn (acc f)
          (map-assoc acc f
            (try (%module-direct-requires f) (catch e {:module nil :requires []}))))
    {} files))

;; The transitive set of module names reachable from `seeds` (a list/vector of module
;; names) over `module->deps` (module-name -> [direct-dep …]). Breadth-first; a module
;; absent from the graph is treated as a leaf.
(defn project--close-modules (seeds module->deps)
  (letrec (go (fn (frontier seen)
                (if (empty? frontier)
                  seen
                  (let (m (first frontier))
                    (if (contains? seen m)
                      (go (rest frontier) seen)
                      (go (append (rest frontier) (or (map-get module->deps m nil) []))
                        (conj seen m)))))))
    (go seeds #{})))

;; {file -> [reachable-module-name …]} : each file's transitive require-closure
;; (including its own module), built from the whole `files` universe. Passed to
;; `check-file` as its KI-17 reachability set.
(defn project--require-closures (files)
  (let (infos (project--module-infos files)
        module->deps (fold (fn (m kv)
                             (let ([_f info] kv
                                   name (map-get info :module nil))
                               (if name
                                 (map-assoc m name (map-get info :requires nil))
                                 m)))
                       {} infos))
    (fold (fn (acc kv)
            (let ([f info] kv
                  own (map-get info :module nil)
                  closed (project--close-modules (map-get info :requires nil) module->deps)
                  with-own (if own (conj closed own) closed))
              (map-assoc acc f (vec with-own))))
      {} infos)))

;; Pair each file with its closure (from the map) — the `[file closure]` element the
;; parallel check ops carry, so the closure rides along as DATA to each worker (never a
;; shipped closure value; see `project--pfold-run`).
(defn project--with-closures (files closures)
  (map (fn (f) [f (map-get closures f nil)]) files))

;; (check-project) — advisory pre-flight: run `check-file` over every source +
;; test file in the project, printing each warning to stderr as a GNU
;; `FILE:LINE:COL: warning: …` line (editor-parseable, matches `brood --check`).
;; Returns the total warning count. Advisory only — never raises, never stops a
;; run. Called by `run-project-tests` and `run-project` before they hand off to
;; the test runner / entry-point, so users see type-misuse / arity / unbound
;; diagnostics without an extra command (`docs/types.md` — Step 4 auto-run).
;;
;; Runs *after* the project's sources are loaded (in the caller), so
;; cross-module names resolve through the heap's globals — `(check-file p)`
;; sees every prelude / std / project-source definition. File-local defns are
;; handled by `check-file`'s own per-file accumulator. The trade-off: a
;; file whose load fails never reaches the check; that error surfaces through
;; the normal eval path instead.
;; Internal: walk a list of files with `check-file`, print each warning to
;; stderr (GNU FILE:LINE:COL format), return the total count. Honors the
;; `BROOD_NO_CHECK=1` opt-out — the same flag the `brood` CLI respects, so
;; callers' "exit non-zero on warning" gating gets 0 (no print) under it.
;; ── bounded parallel fan-out over a file list ────────────────────────────────
;; `check-file` and the CST parse passes below are embarrassingly parallel: each
;; only READS the shared globals / parses text — all sources are loaded first, in
;; the caller (`project--ensure-loaded`), and none of these passes `def`s — so N
;; worker processes can each handle a slice of the files against the *same* shared
;; image with no races (the cross-process global visibility that backs hot reload,
;; docs/shared-code.md). The single-threaded folds these drivers replaced left all
;; but one core idle, so `nest check` on a large project was wall-clock-bound on a
;; single core (a 100K-file project: ~17s in `check-files` + ~17s in the
;; unused-private parse pass, all serial).
;;
;; `project--pfold-files` slices `files` into a SMALL number of big chunks —
;; `cores * *check-oversample*` of them — and runs the chunks across the pool.
;;
;; Why few big chunks and not many small ones: `check-file`'s first call on a
;; fresh heap builds the checker's per-heap caches by scanning ALL globals —
;; `known_ns_prefixes` / `module_public_exports`, each O(globals) (heap.rs). That
;; scan is cached (count-keyed) so a *process* pays it once, but every spawned
;; worker has its OWN heap and so rebuilds it on its first file. With one worker
;; per handful of files that O(globals) rebuild recurs per chunk → O(files·globals)
;; ≈ O(files²), which swamped the parallel win entirely (a 100K project got
;; *slower*). Sizing chunks to the core count caps the rebuild at `~cores` times
;; total, amortised over `files/cores` files each — so the redundant setup is
;; negligible against the per-file check.
;;
;; Chunks run in `*check-batch*`-sized groups (each group collected before the next
;; spawns, so peak live worker heaps — hence memory — is bounded by one group, like
;; the test runner's `*parallel-batch*`); each chunk's result folds into `acc` via
;; `combine` as it reports. A crashed worker (a check-file / parse that itself
;; throws) is folded via `on-death` instead of hanging the collector (mirrors the
;; test runner's KI-2 `monitor` handling). A small file set runs in-process — no
;; spawn overhead, no pool warm-up, stable (filename-sorted) output order.
; below this many files, check in-process
(def *check-min-parallel* 2000)
; chunks per core (load-balancing headroom)
(def *check-oversample* 2)
;; The scheduler's worker-pool size (≈ nproc), clamped ≥1. `worker-threads` is 0
;; until the first spawn, so warm the pool and poll briefly for the threads to spin.
(defn project--await-pool (tries)
  (let (n (worker-threads))
    (if (or (> n 0) (<= tries 0))
      (max 1 n)
      (do (sleep 1) (project--await-pool (dec tries))))))
(defn project--pool-size ()
  (spawn (fn () nil))
  (project--await-pool 50))

;; Slice `coll` into ≤`n`-sized chunks, KEEPING a short trailing chunk.
(defn project--chunk-list (n coll acc)
  (if (empty? coll)
    (reverse acc)
    (project--chunk-list n (drop n coll) (cons (take n coll) acc))))

;; The `(pid chunk)` worker entry for `pid`, or nil if `pid` isn't one of ours.
(defn project--pfold-entry (pid workers)
  (cond
    (empty? workers) nil
    (= (first (first workers)) pid) (first workers)
    else (project--pfold-entry pid (rest workers))))

;; The per-chunk operation, dispatched IN THE WORKER by keyword. `op` is a
;; keyword (plain data) and `project--pfold-run` is a global — so the spawned
;; worker body ships only data and resolves the operation through the global
;; table, exactly like the test runner calls the global `run-unit`. It must NOT
;; take the operation as a passed-in closure: `spawn`'s move of a body whose
;; captured env holds a closure value deep-copies that nested closure to the new
;; process, and that path intermittently corrupts the closure's arity (observed:
;; a worker dying with a bogus "fn: expected 0 arguments" arity error ~1 run in 3;
;; docs/known-issues.md). Add a case here per parallel pass.
(defn project--pfold-run (op chunk)
  (cond
    (= op :check) (project--check-chunk chunk)
    (= op :scan-entries) (project--scan-entries-chunk chunk)
    (= op :check-deps) (project--check-deps-chunk chunk)
    else (error "project--pfold-run: unknown op " op)))

;; Spawn one MONITORED worker per chunk; each runs `(project--pfold-run op chunk)`
;; and sends `[:chunk pid value]` tagged with its own pid (so the collector can
;; correlate a result / a death with its chunk). Returns an assoc list `(pid chunk)`.
(defn project--pfold-spawn (chunks op me)
  (fold (fn (acc chunk)
          (let (pid (spawn (send me (list :chunk (self) (project--pfold-run op chunk)))))
            (monitor pid)
            (cons (list pid chunk) acc)))
    nil chunks))

;; Collect one group: fold each chunk value into `acc` via `combine`; a worker
;; that DIES before reporting is folded via `(on-death acc chunk reason)`. A
;; message from a pid not in this group, or already accounted, is ignored without
;; touching `pending` (a stale `[:down …]` can't corrupt the count).
(defn project--pfold-collect (pending workers reported acc combine on-death)
  (if (= pending 0)
    acc
    (let (msg (receive (m m)))
      (cond
        (= (first msg) :chunk) (let (pid (second msg) entry (project--pfold-entry pid workers))
                                 (if (or (member? pid reported) (nil? entry))
                                   (project--pfold-collect pending
                                     workers reported acc combine on-death)
                                   (project--pfold-collect (- pending 1)
                                     workers (cons pid reported) (combine acc (third msg)) combine
                                     on-death)))
        (= (first msg) :down) (let (pid (third msg) entry (project--pfold-entry pid workers))
                                (if (or (member? pid reported) (nil? entry))
                                  (project--pfold-collect pending
                                    workers reported acc combine on-death)
                                  (project--pfold-collect (- pending 1)
                                    workers (cons pid reported)
                                    (on-death acc (second entry) (nth msg 3)) combine on-death)))
        else (project--pfold-collect pending workers reported acc combine on-death)))))

;; Run every group, one `*check-batch*`-sized batch in flight at a time.
(defn project--pfold-groups (groups op combine on-death acc me)
  (if (empty? groups)
    acc
    (let (workers (project--pfold-spawn (first groups) op me)
          acc2 (project--pfold-collect (count workers) workers nil acc combine on-death))
      (project--pfold-groups (rest groups) op combine on-death acc2 me))))

;; Fan operation `op` (a keyword; see `project--pfold-run`) across the worker pool
;; over `files`, folding each chunk's value into `init` via `(combine acc value)`;
;; `(on-death acc chunk reason)` folds in a dead worker. `combine`/`on-death` run
;; only in this (driver) process, so they may be closures — only `op` crosses to a
;; worker, and it is data. A small file set runs in-process (no spawn, stable
;; order); a large one is sliced into `cores * *check-oversample*` chunks.
(defn project--pfold-files (files op combine on-death init)
  (let (n (count files))
    (if (< n *check-min-parallel*)
      (combine init (project--pfold-run op files))
      (let (cores (project--pool-size)
            nchunks (min n (* cores *check-oversample*))
            ; ceil(n / nchunks)
            csize (quot (+ n nchunks -1) nchunks)
            chunks (project--chunk-list csize files nil))
        ;; Group size = `cores`: at most `cores` worker heaps live at once (bounds
        ;; peak memory), and with `*check-oversample*` chunks per core the groups
        ;; still keep every core fed. All cores busy, live set ≈ one core-wide wave.
        (project--pfold-groups (project--chunk-list cores chunks nil)
          op combine on-death init (self))))))

;; Internal: run `check-file` over every file, print each warning to stderr (GNU
;; FILE:LINE:COL format), return the total count. Fanned across the worker pool
;; (see `project--pfold-files`). Each worker PRINTS its own chunk's warnings and
;; ships back only the integer count — NOT the warning list: a list would be
;; deep-copied across process heaps (message passing), which on a warning-heavy
;; project costs more than the check itself. `eprintln` writes one line per call,
;; so lines from concurrent workers interleave only between warnings, never
;; mid-line (like the test runner's `:trace`); warning *order* is no longer sorted
;; by filename, which is fine for advisory GNU `FILE:LINE:COL` diagnostics. Honors
;; the `BROOD_NO_CHECK=1` opt-out — the same flag the `brood` CLI respects, so
;; callers' "exit non-zero on warning" gating gets 0 (no print) under it.
;; A warning the checker reports but that does NOT gate the build (`nest check`'s
;; exit code). Currently only the non-tail-recursion lint: since deep recursion
;; became a catchable `MAX_BC_FRAMES` error rather than a silent stack overflow,
;; that lint is an advisory perf/robustness hint — and it fires on correct code
;; (inherently-tree recursion like merge-sort or a window tree, and bounded
;; compile-time macro helpers, none of which can overflow). So it stays visible
;; but must never fail CI. Classified by message text for now, pending structured
;; warning severities (a fuller fix — see the roadmap).
(defn project--advisory-warning? (w)
  (includes? w "recursive call in non-tail position"))

;; Print warning `w` and return the running gate count `n`, incremented only when
;; `w` gates the build. An advisory warning prints with an `(advisory)` marker and
;; leaves the count untouched — visible in the output, never a CI failure. Both
;; the fresh and the cached check paths tally through this.
(defn project--tally-warning (n w)
  (if (project--advisory-warning? w)
    (do (eprintln (str w "  (advisory — not gating)")) n)
    (do (eprintln w) (+ n 1))))

;; The `:check` op (runs in a worker): check every file in `chunk`, PRINT each
;; file's warnings, return the GATING count. A global (not a shipped closure) so
;; the worker resolves it through the global table — see `project--pfold-run`.
;; `chunk` is a list of `[file closure]` pairs (the closure = the file's KI-17
;; reachability set, carried as data so it reaches the worker).
(defn project--check-chunk (chunk)
  (fold (fn (k pair)
          (let ([f cl] pair)
            (fold project--tally-warning k (check-file f cl))))
    0 chunk))

;; The from-scratch parallel path: fan `check-file` (print-in-worker) across the
;; pool. Used when the cache is off, absent, or the project is over the file cap.
(defn project--check-files-fresh (files closures)
  (project--pfold-files (project--with-closures files closures)
    :check (fn (n c) (+ n c))
    (fn (n chunk reason)
      (eprintln (str "warning: check worker died on " (count chunk) " file(s): " (pr-str reason)))
      (+ n 1))
    0))

;; ── incremental check-result cache (Phase 2, ADR-119) ────────────────────────
;; Cache each file's `check-file` warnings on disk, keyed by (file mtime + a
;; dependency fingerprint). A file's warnings are reused iff BOTH are unchanged, so
;; a change to any global the check observed — directly, or transitively through
;; inference (which walks a callee's body and thereby records the callee's own
;; references) — flips the fingerprint (`check-deps-fp`) and forces a re-check of
;; exactly that file. `check-file-deps` uses a thread-local dependency recorder, so
;; the RE-CHECK runs SEQUENTIALLY in this process (never across the green-process
;; pool — two concurrent checks would clobber the shared recorder). A warm re-check
;; touches only changed files + their dependents, so the sequential cost is small; a
;; cold run pays a one-time full sequential check (parallel dep-capture is deferred —
;; it needs the recorder moved into the per-process context). Manifest = `{path ->
;; [mtime warnings dep-keys fp]}`, merged like the extract cache (anti-thrash).
(defn project--check-files-cached (files root closures)
  (let (cache (project--read-cache root "checks")
        parts (fold
                ; else re-check
                (fn (acc p)
                  (let ([reuse recheck] acc
                        c (map-get cache p nil)
                        cl (map-get closures p nil))
                    ;; Reuse iff mtime + dep-fingerprint AND the KI-17 closure (5th
                    ;; entry field) are unchanged — a closure shift (another file's
                    ;; requires changed) can add/remove a reachability warning without
                    ;; this file's mtime moving, so it must invalidate the cache too.
                    (if (and c
                          (= (nth c 0) (file-mtime p)) (= (check-deps-fp (nth c 2)) (nth c 3))
                          (= (nth c 4 nil) cl))
                      ; unchanged file + deps + closure → reuse
                      [(map-assoc reuse p c) recheck]
                      [reuse (cons [p cl] recheck)])))
                [{} nil] files)
        [reuse recheck] parts
        ;; re-check the dirty set in PARALLEL across the worker pool — safe now that
        ;; the dependency recorder is per-process (Heap::check_dep_rec). Each entry is
        ;; [mtime warnings dep-keys fp closure].
        fresh (fold (fn (m pair) (let ([p e] pair) (map-assoc m p e)))
                {} (project--pcheck-deps recheck))
        entries (fold (fn (m kv) (let ([p e] kv) (map-assoc m p e))) reuse fresh)
        ;; print every file's warnings (reused + fresh) and count them
        n (fold (fn (n kv) (let ([_ e] kv) (fold project--tally-warning n (nth e 1))))
            0 entries))
    (when (not (empty? recheck))
      (project--write-cache root
        "checks" (fold (fn (m kv) (let ([p e] kv) (map-assoc m p e))) cache entries)))
    n))

(defn project--check-files (files root)
  (if (= (getenv "BROOD_NO_CHECK") "1")
    0
    ;; Build the KI-17 reachability closures from the WHOLE project (every file's
    ;; header), not just `files` — a `nest check FILE` still needs the full graph to
    ;; resolve `FILE`'s transitive requires, else a transitively-reached module would
    ;; false-positive. Outside a project (no root) the checked files are the universe;
    ;; there the lint is inert anyway (only the file's own requires are loaded).
    (let (closures (project--require-closures (if root (project--all-files root) files)))
      (cond
        ;; No cache when it's disabled, there's no project root, or the project is over
        ;; the file cap (the manifest read would rival re-checking) — parallel fresh path.
        (or (project--cache-off?) (nil? root) (>= (count files) (project--cache-max-files)))
          (project--check-files-fresh files closures)
        else (project--check-files-cached files root closures)))))

;; Make sure the project is set up and all its sources are loaded — the
;; precondition for the checker to resolve cross-file names through the
;; heap's globals. Loads with `:skip-loaded`, so a module already on
;; `*features*` (loaded by the `run-project`/`run-project-tests` that called the
;; check pre-flight, or by a prior require) is NOT re-evaluated — which would
;; re-run its `defmacro`s and trip the hot-reload "macro redefined" warning.
;; Standalone callers (`nest check`, an interactive `(check-project)`) start from
;; an image with nothing loaded, so this still loads every source.
(defn project--ensure-loaded (root) (project-setup root) (project-load-sources root :skip-loaded))

;; Structured analogue of `check-project` — returns a flat list of
;; `{:file :line :col :message}` maps instead of printing GNU lines + a
;; count. Backs the `nest mcp` `check` tool (`std/mcp.blsp`, step 1c-a).
;; Honors `BROOD_NO_CHECK=1` the same way `check-project` does: returns
;; an empty list under the flag.
(defn check-project-structured ()
  "Advisory type-check the whole project, returning a list of `{:file :line :col :message}` diagnostic maps (one per warning) instead of printing. Returns nil under `BROOD_NO_CHECK=1`. Errors if not in a project. Backs the `nest mcp` `check` tool."
  (let (root (project-find-root (cwd)))
    (when (nil? root)
      (error "check-project-structured: not in a Brood project (no project.blsp found from "
        (cwd) ")"))
    (project--ensure-loaded root)
    (if (= (getenv "BROOD_NO_CHECK") "1")
      nil
      ;; `append-two` (copy the small per-file diagnostic list, share `acc`) not
      ;; `(append acc …)` (recopies the growing accumulator each file → O(files²)).
      ;; `%mcp-progress` streams per-file progress under `nest mcp` (a no-op — a
      ;; cheap thread-local check — otherwise), so a large project's `check`
      ;; reports live instead of one silent wait.
      (let (files (project--all-files root)
            closures (project--require-closures files)
            total (count files))
        (project--check-fold files closures total 0 nil)))))

(defn project--check-fold (files closures total done acc)
  (if (nil? files)
    acc
    (let (f (first files)
          diags (check-file-structured f (map-get closures f nil))
          done2 (inc done))
      (%mcp-progress done2 total (str "checked " (path-basename f)))
      (project--check-fold (rest files) closures total done2 (append-two diags acc)))))

;; --- duplicate-global detection (flat namespace, ADR-019) --------------------
;; The project shares one flat global table: exactly one binding per name across
;; every source file. If two files each `(defn main …)`, the last loaded silently
;; wins with no error — an expensive, invisible failure (a real one hit in
;; docs/feedback-retro-game-of-life.md). This advisory pass parses each source
;; file's top-level def-style forms (via `parse-source`'s CST — no eval) and
;; warns when one name is defined in more than one file.

;; CST node accessors (see the `parse-source` doc in builtins.rs): a node is
;; `[kind v]` — for a leaf `v` is the raw source text, for a container
;; (`[:list …]`, `[:root …]`) `v` is the vector of child nodes.
(defn project--node-kind (n) (vector-ref n 0))
(defn project--node-val (n) (vector-ref n 1))

;; Top-level heads that bind a global (each expands to `def`). `defmodule` is
;; excluded — it registers a module feature, not a clashing value binding.
(def *project--def-heads* ["def" "defn" "defmacro" "defdyn" "defonce"])

;; `[head name]` for a recognised def-style form (both strings), else nil. The head
;; is what says whether the name is ambient, so the two travel together.
(defn project--def-entry (list-node)
  (let (kids (filter (fn (c) (not (includes? [:whitespace :comment] (project--node-kind c))))
               (project--node-val list-node)))
    (when (>= (count kids) 2)
      (let (head (first kids) nm (second kids))
        (when (and (= (project--node-kind head) :symbol)
                (includes? *project--def-heads* (project--node-val head))
                (= (project--node-kind nm) :symbol))
          [(project--node-val head) (project--node-val nm)])))))

;; An **ambient** name — root regardless of any enclosing namespace, mirroring the
;; kernel resolver's `is_ambient`. It is a *declaration*, not a spelling: `defdyn`
;; declares one (an `*earmuffed*` name no longer gets it for free — two modules that
;; each wrote `(def *width* …)` used to share, and clobber, one root binding).
(defn project--ambient? (head name)
  (or (= head "defdyn") (dynamic? (symbol name))))

;; The namespace a top-level `(defmodule ns …)` node declares (a string), or nil
;; if the node isn't a `defmodule`. The file-level shape of `project--def-entry`.
(defn project--module-name (list-node)
  (let (kids (filter (fn (c) (not (includes? [:whitespace :comment] (project--node-kind c))))
               (project--node-val list-node)))
    (when (>= (count kids) 2)
      (let (head (first kids) nm (second kids))
        (when (and (= (project--node-kind head) :symbol)
                (= (project--node-val head) "defmodule") (= (project--node-kind nm) :symbol))
          (project--node-val nm))))))

;; The effective *global* key a def binds, mirroring the kernel resolver
;; (`eval::macros`): `ns/name` under a file's `(defmodule ns)` (ADR-065), but
;; left bare for an already-qualified name, an ambient `*earmuff*`, or a file
;; with no module header (the root namespace). This is what makes the duplicate
;; check namespace-sound — two files' same short name in different namespaces no
;; longer collide.
(defn project--qualify (ns head name)
  (if (or (nil? ns) (project--ambient? head name) (includes? name "/"))
    name
    (str ns "/" name)))

;; Every global *key* defined at top level in the file at `path` — each a fully
;; resolved `ns/name` (or bare, per `project--qualify`), in source order.
;; `parse-source` never raises — malformed input just yields fewer recognised
;; defs — so a syntax error in one file can't abort the scan.
(defn project--file-def-names (path)
  (let (nodes (filter (fn (c) (= (project--node-kind c) :list))
                (project--node-val (parse-source (slurp path))))
        ns (first (keep project--module-name nodes)))
    (map (fn (entry) (project--qualify ns (first entry) (second entry)))
      (keep project--def-entry nodes))))

;; The project's source files (no tests) — the set the flat-namespace rule binds.
(defn project--source-files (root)
  (fold (fn (acc d) (append acc (project-collect-sources d)))
    nil (project-abs-paths root *project-source-paths*)))

;; Warning strings for a *qualified* global key (`ns/name`, per
;; `project--file-def-names`) defined across more than one source file. Under
;; namespaces (ADR-065) this fires only on a genuine collision — two files in
;; the *same* namespace binding the same name, or an ambient `*earmuff*` / root
;; name bound twice — not on a short name reused across distinct namespaces.
;; `extracts` is `{path -> [mtime counts privs def-names]}`; `source-set` is
;; `{source-path -> true}` (only SOURCE files bind the flat namespace — a test
;; file's defs don't clash). Aggregates each source file's `def-names` (extract
;; slot 3) and warns on any qualified name bound in more than one source file.
(defn project--duplicate-def-warnings (extracts source-set)
  (let (by-name (fold (fn (acc kv)
                        (let ([path entry] kv)
                          (if (map-get source-set path false)
                            (fold (fn (m nm) (map-assoc m nm (cons path (map-get m nm nil))))
                              acc (nth entry 3))
                            acc)))
                  {} extracts))
    (keep (fn (entry)
            (let ([nm paths] entry
                  where (sort (distinct paths)))
              (when (> (count where) 1)
                (str "warning: global '"
                  nm "' is defined in " (count where) " source files (" (join ", " where)
                  ") — same namespace; the last loaded wins (ADR-065)"))))
      by-name)))

;; Print the duplicate-def warnings to stderr and return the count. Advisory
;; (never raises, never stops a run) and honors `BROOD_NO_CHECK=1` like the
;; type-check pre-flight. Shared by `check-project` / `check-project-sources`.
(defn project--check-duplicate-defs (extracts source-set)
  (if (= (getenv "BROOD_NO_CHECK") "1")
    0
    (fold (fn (n w) (eprintln w) (+ n 1)) 0 (project--duplicate-def-warnings extracts source-set))))

;; SEQUENTIAL duplicate-defs over `files` (over-cap / cache-off path): parse each
;; source file's def-names directly (no extract map, no cache). The original path;
;; source-file counts are usually modest, so a plain fold is fine at any scale.
(defn project--duplicate-def-warnings-seq (files)
  (let (by-name (fold (fn (acc path)
                        (fold (fn (m nm) (map-assoc m nm (cons path (map-get m nm nil))))
                          acc (project--file-def-names path)))
                  {} files))
    (keep (fn (entry)
            (let ([nm paths] entry
                  where (sort (distinct paths)))
              (when (> (count where) 1)
                (str "warning: global '"
                  nm "' is defined in " (count where) " source files (" (join ", " where)
                  ") — same namespace; the last loaded wins (ADR-065)"))))
      by-name)))

;; --- unused module-private defns (whole-project, ADR-065 `--` convention) -----
;; A `--` name is private *by convention*, not enforced: the editor legitimately
;; references it from another module or a test by its qualified `mod/name`. So
;; "is it used?" can only be answered across the *whole* project — a single-file
;; check (the kind `check-file` runs) false-flags every cross-module-referenced
;; private name. This pass parses every source + test file's CST (no eval), counts
;; each symbol reference project-wide, and warns for a private def whose name is
;; never referenced beyond its own definition — neither as a same-module bare call
;; nor a cross-module / test `mod/name` reference. Comments don't count (the CST
;; tags them `:comment`, not `:symbol`).

;; Fold every `:symbol` node value that CONTAINS "--" in CST `node` into `acc`
;; (name→count, keyed by the symbol's *string* — node values may be symbols, but
;; qualified names are built with `str`, so both sides normalise the same way).
;; Only `--` names are counted because that is all the unused-private decision ever
;; looks up: a private def's bare name is `--` by convention, and its qualified
;; `mod/name` therefore contains `--` too, so a reference counts toward "used" only
;; if it is a `--` name. Skipping the rest shrinks the count map from every symbol
;; in the project to just the private-related ones — far less to build, ship back
;; from a scan worker, and merge (was O(all symbols) ≈ O(files)). Recurses
;; through a node's value, which is one of: raw text (a leaf — nothing to do), a
;; single child node (a wrapper like `:quote`, whose value is itself a `[:kind …]`
;; node-vector), or a vector of child nodes (`:list`/`:vector`/`:map`/`:root`).
;; A node-vector's first element is itself a node (a vector); a single child
;; node's first element is its kind *keyword* — that's how the two are told apart,
;; so a dispatch `{:tag mod/handler}` map or a quoted `'sym` is counted correctly.
; val is a node-vector
(defn project--walk-val (val acc)
  (cond
    (not (vector? val)) acc
    (empty? val) acc
    (keyword? (first val)) (project--node-syms--acc val acc)
    ; val IS one node
    else (fold (fn (a c) (project--node-syms--acc c a)) acc val)))
(defn project--node-syms--acc (node acc)
  (if (= (project--node-kind node) :symbol)
    (let (nm (str (project--node-val node)))
      (if (includes? nm "--") (map-assoc acc nm (inc (map-get acc nm 0))) acc))
    (project--walk-val (project--node-val node) acc)))

;; Merge symbol-count map `b` into `a` (name→count), summing counts. The reduce
;; step for the parallel scan workers' per-chunk partial counts. Folding a map
;; yields its `[k v]` entries.
(defn project--merge-counts (a b)
  (fold (fn (m entry) (let ([k v] entry) (map-assoc m k (+ (map-get m k 0) v)))) a b))

;; Parse `path` ONCE and return its extract `[counts privs def-names]`:
;;   - `counts`   : name→count of every `--`-containing `:symbol` reference (the
;;                  only names the unused-private verdict looks up).
;;   - `privs`    : this file's `--`-private defs as `[bare qual]` (qualified via its
;;                  `defmodule` namespace).
;;   - `def-names`: every top-level def's qualified global key (for duplicate-defs).
;; One parse feeds BOTH whole-project passes (unused-private + duplicate-defs) and
;; is what the on-disk cache stores per file. Delegates to the native
;; `scan-source-extract` — the interpreted-Brood CST walk this replaced was ~120ms
;; on a 1000-line file (the dominant cost of a cold whole-project check), vs a few
;; ms in Rust. `project--node-syms--acc`/`--def-name`/`--qualify` (below) remain the
;; reference the native path mirrors, and still back `mcp--shadows-for`.
(defn project--scan-file-entry (path)
  (scan-source-extract (slurp path)))

;; The `:scan-entries` op (runs in a worker): return `[path [mtime counts privs
;; def-names]]` for each file in `chunk` — the cache entry. mtime is read BEFORE the
;; parse, so if a write races the read the stored mtime is the pre-write one and the
;; next run (seeing the newer mtime) re-scans rather than trusting a stale extract.
(defn project--scan-entries-chunk (chunk)
  (map
    (fn (path)
      ;; a proper 4-VECTOR [mtime counts privs def-names] — NOT `(cons mtime …)`
      ;; onto the vector (that would make an improper list).
      (let (mt (file-mtime path)
            [counts privs def-names] (project--scan-file-entry path))
        [path [mt counts privs def-names]]))
    chunk))

;; The `:check-deps` op (runs in a worker): for each `[path closure]` pair, run
;; `check-file-deps` and return `[path [mtime warnings dep-keys fp closure]]` — the
;; Phase-2 check-result cache entry (the closure is the KI-17 reachability set, stored
;; so a closure shift invalidates the entry). Safe in a worker now that the dependency
;; recorder is per-process (`Heap::check_dep_rec`), so dep-capture parallelises across
;; the pool. mtime read BEFORE the check (same race-safety as `:scan-entries`).
(defn project--check-deps-chunk (chunk)
  (map (fn (pair)
         (let ([p cl] pair
               mt (file-mtime p)
               r (check-file-deps p cl))
           [p [mt (nth r 0) (nth r 1) (nth r 2) cl]]))
    chunk))

;; ── incremental check cache (Phase 1, ADR-119) ───────────────────────────────
;; The two whole-project CST passes below (unused-private, duplicate-defs) are pure
;; functions of file text. Cache each file's parse extract on disk keyed by its
;; mtime, so an unchanged file is neither read nor parsed next run — only stat'd.
;; Every run still re-aggregates the global counts / def multiset from ALL extracts
;; and re-derives every verdict (only the PARSE is cached, never a verdict) — so a
;; change in one file correctly shifts another's verdict via the always-recomputed
;; aggregate. Sound with mtime alone; the advisory contract (types.md #5, never
;; rejects a runnable program) makes mtime's rare imprecision harmless. The whole
;; cache carries a `(build-id)`+version stamp and is dropped on mismatch (the
;; extract depends on the Rust `parse-source`, so it isn't portable across binaries).
;; Opt out with `BROOD_NO_CHECK_CACHE=1`.
; v2: check-result entries gained a 5th field, the KI-17 require-closure (ADR-189).
(def *check-cache-version* "v2")
(defn project--cache-stamp () (str (build-id) "|" *check-cache-version*))
(defn project--cache-off? () (= (getenv "BROOD_NO_CHECK_CACHE") "1"))

;; The cache directory for `root` (created if absent), or nil if no cache base is
;; available: `$XDG_CACHE_HOME` (or `~/.cache`) `/brood/check/<sha256 of root>`.
;; Never inside the project tree (mirrors the image-cache convention).
(defn project--cache-dir (root)
  (require 'hash)
  (let (xdg (getenv "XDG_CACHE_HOME")
        home (getenv "HOME")
        base (cond
               (and xdg (not (= xdg ""))) xdg
               (and home (not (= home ""))) (path-join home ".cache")
               else nil))
    (when base
      (let (dir (path-join (path-join (path-join base "brood") "check") (hash/sha256 root)))
        (make-dir dir)
        dir))))

;; `name` selects which on-disk manifest under the project's cache dir — Phase 1's
;; parse extracts (`"extracts"`) and Phase 2's check results (`"checks"`) are
;; separate files keyed by the same paths.
(defn project--cache-file (root name)
  (let (dir (project--cache-dir root)) (when dir (path-join dir (str name ".blsp")))))

;; The cached `{path -> entry}` map for manifest `name`, or `{}` if the cache is off
;; / missing / stamp-mismatched / unreadable (any failure falls back to a cold
;; recompute — the cache is an optimization, never a correctness dependency).
(defn project--read-cache (root name)
  (if (project--cache-off?)
    {}
    (let (f (project--cache-file root name))
      (if (and f (file-exists? f))
        (try
          (let (data (read-string (slurp f)))
            (if (= (map-get data :stamp nil) (project--cache-stamp))
              (map-get data :entries {})
              {}))
          (catch e {}))
        {}))))

;; Write the merged cache for manifest `name`. Best-effort — a write failure just
;; means no caching.
(defn project--write-cache (root name entries)
  (when (not (project--cache-off?))
    (let (f (project--cache-file root name))
      (when f
        (try
          (spit f (pr-str {:stamp (project--cache-stamp) :entries entries}))
          (catch e nil))))))

;; Parse `files` in parallel (`:scan-entries`), returning a list of
;; `[path [mtime counts privs def-names]]`. A dead worker's chunk is re-scanned in
;; the driver so no file is silently dropped. Shared by the cached and uncached paths.
(defn project--pscan (files)
  (if (empty? files)
    nil
    (project--pfold-files files
      :scan-entries (fn (acc chunk-results) (append-two chunk-results acc))
      (fn (acc chunk reason)
        (eprintln (str "warning: check scan worker died on "
                    (count chunk) " file(s), re-scanning: " (pr-str reason)))
        (append-two (project--scan-entries-chunk chunk) acc))
      nil)))

;; Run `check-file-deps` over `files` in PARALLEL (`:check-deps`), returning a list
;; of `[path [mtime warnings dep-keys fp]]`. The dependency recorder is per-process
;; (`Heap::check_dep_rec`), so concurrent dep-capture is race-free — this is what
;; makes a cold cache-build at scale fast instead of a sequential grind. A dead
;; worker's chunk is re-checked in the driver so no file is silently dropped.
(defn project--pcheck-deps (files)
  (if (empty? files)
    nil
    (project--pfold-files files
      :check-deps (fn (acc chunk-results) (append-two chunk-results acc))
      (fn (acc chunk reason)
        (eprintln (str "warning: check worker died on "
                    (count chunk) " file(s), re-checking: " (pr-str reason)))
        (append-two (project--check-deps-chunk chunk) acc))
      nil)))

;; Above this many files the on-disk cache is SKIPPED and the fast from-scratch
;; parallel path runs instead. The single manifest is a `pr-str`/`read-string`
;; s-expression whose read+write cost (and the per-entry dep-keys it holds) grows
;; with the file count; measured on 1000-line files a ~10K-entry manifest turned
;; the cache into a net loss (cold slower + multi-GB RSS + a pathologically slow
;; warm read). So the ceiling is deliberately low — the cache is for the common
;; small-project edit→recheck loop, where its manifest stays tiny; large projects
;; ride the from-scratch path (fast now that the per-file scan is native —
;; `scan-source-extract`). Lifting this needs a scalable manifest (binary / sharded
;; / per-file), noted as future work (ADR-119). Tunable via `BROOD_CHECK_CACHE_MAX`.
(defn project--cache-max-files ()
  (let (e (getenv "BROOD_CHECK_CACHE_MAX"))
    (if (and e (not (= e ""))) (or (string->number e) 50000) 50000)))

;; Return `{path -> [mtime counts privs def-names]}` for `files` by scanning them
;; all, in parallel. NOT disk-cached: the per-file scan is now native
;; (`scan-source-extract`, ~2.5ms even on a 1000-line file), so re-scanning is
;; *cheaper* than reading a per-file extract manifest — that manifest is dominated
;; by each file's def-names (needed for duplicate-defs), so at scale reading it
;; (rebuilding millions of Brood values) cost far more than re-scanning (a 63MB
;; manifest → a 23s read at 3K files, vs ~0.6s to re-scan). The EXPENSIVE pass
;; (per-file type-check) is what earns a disk cache; this cheap one just re-runs.
(defn project--gather-extracts (files)
  (fold (fn (m pair) (let ([p e] pair) (map-assoc m p e))) {} (project--pscan files)))

;; Warning strings for private defs unreferenced anywhere in `files`. `used` =
;; the bare name appears ≥2× (its own def, plus a same-module call) OR — when a
;; module qualifies it — the qualified `mod/name` appears at all (a cross-module /
;; test reference). The parse + per-file scan is fanned across the worker pool
;; upstream (`project--gather-extracts`, `:scan-entries`), producing the `extracts`
;; map this consumes; here the driver `project--merge-counts`s the per-file counts
;; into a GLOBAL merged count that decides each private def's fate (so cross-module
;; references are seen). A scan
;; worker that dies leaves the counts under-complete for its slice — which could
;; only suppress a real warning or add a false one — so it is surfaced rather than
;; dropped silently.
;; `extracts` is `{path -> [mtime counts privs def-names]}` (from
;; `project--gather-extracts`). The GLOBAL merged counts decide each private def's
;; fate (so cross-module references are seen), then each file's `privs` are judged.
(defn project--unused-private-warnings (extracts)
  (let (counts (fold (fn (m kv) (project--merge-counts m (nth (second kv) 1))) {} extracts))
    ;; `append-two file-warnings acc` copies only the small per-file list and SHARES
    ;; the accumulator tail → O(total); a plain `(append acc …)` would be O(files²).
    (fold (fn (acc kv)
            (let ([path entry] kv)
              (append-two (keep (fn (pd)
                                  (let ([bare qual] pd
                                        used (or (>= (map-get counts bare 0) 2)
                                               (and (not (= qual bare))
                                                 (>= (map-get counts qual 0) 1))))
                                    (when (not used)
                                      (str path ": warning: unused private function: " bare))))
                            (nth entry 2))
                acc)))
      '() extracts)))

;; Print the unused-private warnings to stderr and return the count. Advisory;
;; honors `BROOD_NO_CHECK=1` like the other whole-project passes.
(defn project--check-unused-private (extracts)
  (if (= (getenv "BROOD_NO_CHECK") "1")
    0
    (fold (fn (n w) (eprintln w) (+ n 1)) 0 (project--unused-private-warnings extracts))))

(defn check-project ()
  "Advisory type-check the whole project (every source + test file), printing GNU-style `FILE:LINE:COL:` warnings to stderr. Errors if not in a Brood project. Backs `nest check`."
  (let (root (project-find-root (cwd)))
    (when (nil? root)
      (error "check-project: not in a Brood project (no project.blsp found from " (cwd) ")"))
    (project--ensure-loaded root)
    (let (files (project--all-files root)
          ;; Phase 1 (unused-private + duplicate-defs): native parallel scan every
          ;; run — cheaper than any disk cache (see `project--gather-extracts`).
          extracts (project--gather-extracts files)
          source-set (fold (fn (m p) (map-assoc m p true)) {} (project--source-files root)))
      (project--check-duplicate-defs extracts source-set)
      (project--check-unused-private extracts)
      ;; Phase 2 (per-file type-check): the EXPENSIVE pass — disk-cached per file
      ;; (dep-fingerprint) so a warm re-check reuses everything unchanged.
      (project--check-files files root))))

;; (check-files paths) — advisory-check a specific list of files, the entry
;; behind `nest check FILE…`. Loads the project image *first* (same
;; `project--ensure-loaded` as `check-project`) so cross-module / namespace
;; imports resolve through the heap's globals exactly as in a whole-project
;; check — without it a single-file check of a namespaced file false-flags every
;; `:use`d / qualified name as unbound. Then runs the *same* per-file walk
;; (`project--check-files`: GNU stderr lines + BROOD_NO_CHECK opt-out + count),
;; so both `nest check` forms share one checker, not two divergent paths.
;; Outside a project (no project.blsp) it skips loading and checks each file
;; against the prelude alone — the standalone-file behaviour.
(defn check-files (paths)
  "Advisory type-check the listed files with the project image loaded first (so cross-module/namespace imports resolve), printing GNU `FILE:LINE:COL:` warnings to stderr and returning the total count. The entry behind `nest check FILE…`; shares its loader and per-file walk with `check-project`. Outside a project, checks against the prelude alone."
  (let (root (project-find-root (cwd)))
    (when root (project--ensure-loaded root))
    (project--check-files paths root)))

;; Sources-only variant for `run-project`'s auto pre-flight: skip `tests/`,
;; because test files depend on the test-framework macros (`describe`/`test`/
;; `assert=`/`is`) loaded by `(require 'test)`, which `nest run` doesn't
;; do — so checking them there would emit spurious "unbound symbol" warnings.
;; `nest test` keeps using `check-project` (full coverage; `test` is loaded).
(defn check-project-sources ()
  "Like `check-project`, but checks only the project's source paths (skips `tests/`, whose files reference test-framework macros). Used by `nest run`'s pre-flight."
  (let (root (project-find-root (cwd)))
    (when (nil? root)
      (error "check-project-sources: not in a Brood project (no project.blsp found from " (cwd) ")"))
    (project--ensure-loaded root)
    (let (srcs (project--source-files root)
          extracts (project--gather-extracts srcs)
          source-set (fold (fn (m p) (map-assoc m p true)) {} srcs))
      (project--check-duplicate-defs extracts source-set)
      (project--check-files srcs root))))

;; (run-project-tests & opts) — find the project from the cwd, set it up, load
;; every <name>_test.blsp under its test paths (which only REGISTER tests via the
;; test framework), then run the whole suite once. opts pass through to run-tests
;; (e.g. :trace / :slow). Raises if there's no project here, or if any test fails.
;;
;; A `(check-project)` advisory pre-flight runs after all loads but before
;; `(run-tests)`, so the checker sees every source + test file once
;; cross-module names are resolvable through the loaded heap.
;; --- the `--failed` set (mix test --failed) -----------------------------------
;; Which tests failed last time, as full `"group › name"` labels, persisted beside
;; the check caches. Maintained as a SET-DIFFERENCE, not an overwrite: a test that
;; just ran and passed leaves the set, a test that just failed joins it, and a test
;; that wasn't run at all (because of a filter) keeps its previous state. That's
;; what makes `nest test --failed` usable repeatedly — fix one test, re-run, and
;; only the still-broken ones remain.
(defn project--failed-file (root)
  (let (dir (project--cache-dir root)) (if (nil? dir) nil (path-join dir "last-failed.blsp"))))

;; Stored as a `{:failed (label …)}` record rather than a bare list, because an
;; empty list IS nil in a Lisp — a bare list can't distinguish "never run" from
;; "last run was green", and those two want different messages.
(defn project--read-failed-record (root)
  "The previous run's `{:failed (label …)}` record, or nil when there is none (no cache dir, never run here, or an unreadable/corrupt file)."
  (let (f (project--failed-file root))
    (if (or (nil? f) (not (file-exists? f)))
      nil
      (let (form (try (read-first (slurp f)) (catch _ nil)))
        (if (map? form) form nil)))))

(defn project--write-failed! (root ran failed)
  "Update the on-disk `--failed` set: drop everything in `ran` that isn't in `failed`, then add `failed`. Best-effort — a project with no writable cache dir simply keeps no record."
  (let (f (project--failed-file root))
    (when (not (nil? f))
      (let (previous (or (get (project--read-failed-record root) :failed) (list))
            kept (filter (fn (l) (not (member? l (or ran (list))))) previous)
            merged (append kept (or failed (list))))
        (try (spit f (pr-str {:failed merged})) (catch _ nil))))))

;; --- `--stale`: skip test files whose dependencies are unchanged ---------------
;; `mix test --stale`: a test file only re-runs when it, or one of the source files it
;; transitively requires, has changed since it last ran. The dependency graph is the KI-17
;; require-closure already computed for the checker (`project--require-closures`); the
;; "changed" signal is the newest mtime across a test file + its dependency source files,
;; compared to what was recorded last run. Stored `{test-file -> max-dep-mtime}` in the
;; project cache dir, like `--failed`. Only project files carry an mtime — a std/prelude
;; module in the closure has no file to track and can't change under a --stale run.
(defn project--stale-file (root)
  (let (dir (project--cache-dir root)) (if (nil? dir) nil (path-join dir "last-run-mtimes.blsp"))))

(defn project--read-stale-record (root)
  "The previous run's `{test-file -> max-dep-mtime}` map, or `{}` when there is none."
  (let (f (project--stale-file root))
    (if (or (nil? f) (not (file-exists? f)))
      {}
      (let (form (try (read-first (slurp f)) (catch _ nil)))
        (if (map? form) form {})))))

(defn project--module-file-index (infos)
  "`module-name -> file` from a module-infos map (`{file -> {:module :requires}}`)."
  (fold (fn (acc kv)
          (let ([f info] kv name (get info :module))
            (if name (assoc acc name f) acc)))
    {} infos))

(defn project--test-dep-files (test-file closures module->file)
  "Every project file `test-file` transitively depends on (mapping its reachable module
names back to files), including itself. Modules with no project file (std/prelude) drop."
  (conj (into #{} (keep (fn (m) (get module->file m)) (or (get closures test-file) [])))
    test-file))

(defn project--file-max-mtime (files)
  "The newest mtime across `files` (0 when none exist)."
  (fold (fn (mx f) (let (mt (or (file-mtime f) 0)) (if (> mt mx) mt mx))) 0 files))

(defn project--stale-mtimes (root files)
  "`test-file -> current max-dep-mtime` for each test file in `files`, over the whole
project's require-closure."
  (let (all (project--all-files root)
        infos (project--module-infos all)
        closures (project--require-closures all)
        module->file (project--module-file-index infos))
    (fold (fn (acc tf)
            (assoc acc tf
              (project--file-max-mtime (project--test-dep-files tf closures module->file))))
      {} files)))

(defn project--stale-filter (root files)
  "The subset of `files` whose transitive dependencies changed since they last ran (or
that were never recorded) — the `--stale` run set."
  (let (prev (project--read-stale-record root)
        current (project--stale-mtimes root files))
    (filter (fn (tf)
              (let (was (get prev tf) now (get current tf 0))
                (or (nil? was) (> now was))))
      files)))

(defn project--write-stale! (root files)
  "Record the current max-dep-mtime of each file in `files`, merged over the previous
record so a skipped (unchanged) file keeps its stamp. Best-effort; no writable cache dir
simply keeps no record."
  (let (f (project--stale-file root))
    (when (not (nil? f))
      (let (merged (fold (fn (acc kv) (assoc acc (first kv) (second kv)))
                     (project--read-stale-record root)
                     (project--stale-mtimes root files)))
        (try (spit f (pr-str merged)) (catch _ nil))))))

(defn project--stale-run-set (root files)
  "The `--stale` subset of `files` to run, with a one-line note of how many were skipped
as unchanged (only when some were)."
  (let (run (project--stale-filter root files)
        skipped (- (count files) (count run)))
    (when (> skipped 0)
      (println (str "stale: " (count run) " of " (count files) " test files changed ("
                 skipped " unchanged, skipped)")))
    run))

;; Build the `:filter` spec for `--failed`. With nothing to narrow to, run
;; everything and say why — a command that silently runs zero tests reads as
;; broken, and "re-run the failures" on a green suite most usefully means "run it".
(defn project--failed-filter (root spec)
  (let (record (project--read-failed-record root)
        failed (get record :failed))
    (cond
      (nil? record) (do
                      (eprintln "warning: --failed: no record of a previous run here — running every test")
                      spec)
      (empty? failed) (do
                        (eprintln "warning: --failed: nothing failed on the last run — running every test")
                        spec)
      else (assoc (or spec {}) :names failed))))

(defn run-project-tests (& opts)
  "Discover, load (register-only), and run the project's whole test suite once, from the cwd. `opts` pass through to `run-tests` (e.g. `:slow`). Runs an advisory `check-project` pre-flight. Errors if not in a project or if any test fails. Backs `nest test`."
  (let (root (project-find-root (cwd)))
    (when (nil? root)
      (error "run-project-tests: not in a Brood project (no project.blsp found from " (cwd) ")"))
    (project-setup root)
    (require 'test)
    (project-load-sources root)
    ; the project's own src/, so tests use it directly
    (test/reset-units!)
    ; drop any stale registrations from a prior run (long-lived image / hot reload)
    (let (dirs (project-abs-paths root *project-test-paths*)
          files-all (fold (fn (acc d) (append acc (project--collect-tests d))) nil dirs)
          ;; `--stale` drops any test file whose transitive deps are unchanged since it
          ;; last ran; the record is refreshed after the run (below). Whole-project only.
          files (if (test/opt? :stale opts)
                  (project--stale-run-set root files-all)
                  files-all))
      ;; Advisory type-check (warnings to stderr). Run it INSIDE `%isolate`: `check-project`
      ;; loads every source + test file into the image for cross-file checking, which would
      ;; otherwise leave all N test modules bound in the global table — and the scoped run
      ;; below `snapshot-globals`-clones that table once PER FILE, so an O(N) baseline makes
      ;; the run O(N²). Rolling the check's loads back keeps the run's baseline small (just
      ;; prelude + src + the test framework), so each file's snapshot is O(1) → linear.
      ;; (Warnings are stderr I/O, unaffected by the global rollback.)
      (%isolate (fn () (check-project)))
      ;; Run file-by-file, each in its own rolled-back global scope, so a large
      ;; suite's promoted code + top-level defs are reclaimed per file instead of
      ;; accumulating every file's code in one image (the shared-RUNTIME test-runner
      ;; leak, docs/devlog.md 2026-07-03). Each loader `load`s one file (registering
      ;; its units) inside the `%isolate` that `run-tests-scoped` wraps it in.
      ;; `BROOD_TEST_NO_SCOPE` reverts to the legacy load-all-then-run-all path (the
      ;; escape hatch, e.g. for a suite that relies on cross-file top-level defs).
      ;; Instrument for coverage BEFORE the suite and AFTER the sources are loaded
      ;; (and after `check-project`, whose `%isolate` would roll the rebindings
      ;; back). Opt-in: `:cover` in the option plist, from `nest test --cover`.
      (when (test/opt? :cover opts) (project--coverage-begin! root))
      ;; The line/branch tiers' pre-pass, same timing and for the same reason: it must
      ;; see the project's functions loaded, and it must not be rolled back. One pass
      ;; serves both (a precompiled arm records line AND branch denominators).
      (when (or (test/opt? :cover-lines opts) (test/opt? :cover-branches opts))
        (project--coverage-lines-begin! root))
      ;; Persist the `--failed` set whichever way the run goes: the interesting
      ;; case is precisely the failing one, and `run-tests-scoped` RAISES on
      ;; failure, so catch, record, then re-raise to keep the non-zero exit.
      (let (resolved (project--resolve-test-opts root opts)
            outcome (try (project--run-suite files resolved) (catch e (list :%suite-raised e))))
        (project--write-failed! root *test-last-ran* *test-last-failed*)
        ;; Refresh the --stale record for the files that ran (skipped files keep theirs).
        (when (test/opt? :stale opts) (project--write-stale! root files))
        ;; Report coverage before propagating a suite failure — a red run is
        ;; exactly when you still want to see what went unexercised.
        (let (percent (project--coverage-report! root opts))
          (if (and (pair? outcome) (= (first outcome) :%suite-raised))
            (throw (second outcome))
            (project--coverage-gate percent opts)))))))

;; Whichever coverage tier was asked for. Both may be on at once — they measure
;; different things (was a function entered vs did a line run) — in which case the
;; LINE percentage is what `--cover-min` gates on, being the stricter number.
(defn project--coverage-report! (root opts)
  (let (fn-percent (if (test/opt? :cover opts) (project--coverage-finish! root) nil)
        line-percent (if (test/opt? :cover-lines opts)
                       (project--coverage-lines-finish! root)
                       nil)
        branch-percent (if (test/opt? :cover-branches opts)
                         (project--coverage-branches-finish! root)
                         nil))
    ;; `--cover-min` gates on the strictest number present: branch > line > function.
    (or branch-percent line-percent fn-percent)))

(defn project--coverage-lines-begin! (root)
  (require 'coverage)
  (coverage/coverage-line-begin! (project-abs-paths root *project-source-paths*)))

(defn project--coverage-lines-finish! (root)
  (require 'coverage)
  (coverage/coverage-line-report root (project-abs-paths root *project-source-paths*)))

(defn project--coverage-branches-finish! (root)
  (require 'coverage)
  (coverage/coverage-branch-report root (project-abs-paths root *project-source-paths*)))

;; --- coverage wiring (nest test --cover) --------------------------------------
;; `coverage` is required lazily, like `package`: a run without `--cover` never
;; loads it, and the module is pure policy over `source-location`/`table` (see
;; std/tool/coverage.blsp).
(defn project--coverage-begin! (root)
  (require 'coverage)
  (coverage/coverage-begin! (project-abs-paths root *project-source-paths*)))

(defn project--coverage-finish! (root)
  (require 'coverage)
  (coverage/coverage-report root))

;; Enforce `--cover-min N`: a coverage floor is only useful if it can fail the
;; build, so falling short raises (non-zero exit) exactly like a failing test.
;; Runs AFTER the suite-failure re-raise, so a red suite reports its own failure
;; first rather than being masked by a coverage complaint.
(defn project--coverage-gate (percent opts)
  (let (minimum (test/opt-val :cover-min opts nil))
    (if (and (not (nil? percent)) (not (nil? minimum)) (< percent minimum))
      ;; Print the verdict, THEN raise the bare signal `nest` recognises. Falling short
      ;; of a floor is an expected outcome, not a crash: raising the sentence itself
      ;; appended `1:58: error: …`, `at error` and a version banner to a report the user
      ;; had already read. Same treatment as a failing suite (`run_expecting_failure_signal`).
      (do
        (println "")
        (println (str "FAILED: coverage " percent "% is below the required minimum " minimum "%"))
        (error "coverage below minimum"))
      :ok)))

;; Expand `:failed` in a `nest test` option plist into the `:filter` spec's
;; `:names`. The resolved `:filter` is CONSed on the front: `opt-val` returns the
;; first match, so a prepended entry shadows the original without rebuilding the
;; plist.
(defn project--resolve-test-opts (root opts)
  (if (not (test/opt? :failed opts))
    opts
    (cons :filter
      (cons (project--failed-filter root (test/opt-val :filter opts nil)) opts))))

(defn run-loaded-tests (& opts)
  "Run the ALREADY-REGISTERED suite — the `nest test FILE…` path, where the CLI has loaded the named files itself. Inside a project this resolves `:failed` against the project's record, updates that record afterwards, and honours `:cover`, so the flags mean the same thing as on a whole-project run; outside a project it is just `run-tests` (with a warning if coverage was asked for, since there are no project sources to instrument)."
  (let (root (project-find-root (cwd)))
    (if (nil? root)
      (do
        (when (test/opt? :cover opts)
          (eprintln "warning: --cover needs a project (no project.blsp found) — running without coverage"))
        (apply test/run-tests opts))
      (let (_ (when (test/opt? :cover opts) (project--coverage-begin! root))
            resolved (project--resolve-test-opts root opts)
            outcome (try (apply test/run-tests resolved) (catch e (list :%suite-raised e))))
        (project--write-failed! root *test-last-ran* *test-last-failed*)
        (let (percent (project--coverage-report! root opts))
          (if (and (pair? outcome) (= (first outcome) :%suite-raised))
            (throw (second outcome))
            (project--coverage-gate percent opts)))))))

;; Run the discovered suite — scoped file-by-file (the default) or the legacy
;; load-all-then-run-all path under `BROOD_TEST_NO_SCOPE`.
(defn project--run-suite (files opts)
  (if (getenv "BROOD_TEST_NO_SCOPE")
    (do
      (fold (fn (_ f) (load f)) nil files)
      (apply test/run-tests opts))
    (apply test/run-tests-scoped (map (fn (f) (fn () (load f))) files) opts)))

;; Structured analogue of `run-project-tests` — same bootstrap (discovery,
;; load, type-check pre-flight) but `(run-tests-structured)` at the end, so
;; the caller gets `{:total :passed :failed :ms :results [...]}` instead of
;; printed output + a throw on failure. Backs the `nest mcp` `run-tests`
;; tool (step 1c-b).
(defn run-project-tests-structured (& opts)
  "Like `run-project-tests`, but returns the structured result `{:total :passed :failed :ms :results [...]}` instead of printing and raising on failure. Backs the `nest mcp` `run-tests` tool."
  (let (root (project-find-root (cwd)))
    (when (nil? root)
      (error "run-project-tests-structured: not in a Brood project (no project.blsp found from "
        (cwd) ")"))
    (project-setup root)
    (require 'test)
    (project-load-sources root)
    (test/reset-units!)
    ; drop any stale registrations so a re-run in a long-lived `nest mcp` image
    ; (each `load` re-registers, ADR-013) counts each test once, not N times
    (let (dirs (project-abs-paths root *project-test-paths*)
          files (fold (fn (acc d) (append acc (project--collect-tests d))) nil dirs))
      ;; Per-file scoped run (see `run-project-tests`) — matters most here: `nest mcp`
      ;; is a long-lived hot-reload image, so a load-all-then-run would accumulate every
      ;; file's promoted code on EVERY run-tests call. `BROOD_TEST_NO_SCOPE` reverts.
      (if (getenv "BROOD_TEST_NO_SCOPE")
        (do
          (fold (fn (_ f) (load f)) nil files)
          (apply test/run-tests-structured opts))
        (apply test/run-tests-scoped-structured (map (fn (f) (fn () (load f))) files) opts)))))

;; (run-project args) — find the project from the cwd, set it up (which may
;; override *project-main* via the manifest), `require` the entry module, and
;; call its entry fn with `args` (a list of strings from the CLI). The default
;; entry is `(main main)` — module `main`, fn `main` — so most projects ship a
;; bare manifest and a `(defn main () ...)` in src/main.blsp. Errors if there's
;; no project here, or if the entry fn isn't defined or callable.
(defn run-project (args)
  "Run the project's entry point (default module `main`, fn `main`; overridable via the manifest's `:main`), passing `args` (a list of CLI string arguments). Runs an advisory sources-only pre-flight. Errors if not in a project or the entry fn is missing/uncallable. Backs `nest run`."
  (let (root (project-find-root (cwd)))
    (when (nil? root)
      (error "run-project: not in a Brood project (no project.blsp found from " (cwd) ")"))
    (project-setup root)
    ;; A `--main` override (set via `set-project-main`) wins over the manifest's
    ;; `:main`, which `project-setup` just re-applied into `*project-main*`.
    (let (entry (or *project-main-override* *project-main*)
          modname (first entry)
          fname (second entry))
      (require modname)
      ;; A `(defmodule …)` entry defines its fn as `modname/fname` (ADR-065); a
      ;; module file with no `defmodule` header defines it bare. Prefer the
      ;; qualified name, fall back to bare.
      (let (qual (symbol (str (name modname) "/" (name fname))))
        (let (target (cond (bound? qual) qual (bound? fname) fname else nil))
          (when (nil? target)
            (error "run-project: entry fn '" fname "' is not defined (module '" modname "')"))
          ;; Advisory pre-flight: warnings go to stderr so they don't pollute the
          ;; entry point's own stdout. After `require` so cross-module names see
          ;; the heap's globals (see `check-project`). Sources only — `tests/` is
          ;; out of scope for `nest run`, and its files reference test-framework
          ;; macros that `(require 'test)` introduces (which we don't run here).
          (check-project-sources)
          (let (f (eval target))
            (unless (fn? f)
              (error "run-project: entry '" fname "' is not callable (" (type-of f) ")"))
            (apply f args)))))))

;; --- single-binary release (ADR-038) -----------------------------------------
;; `nest release` appends a project's source to a copy of the `brood` binary;
;; the resulting executable boots `:main` with no interpreter, project dir, or
;; source files on the target. Two halves: `bundle-collect` (here) gathers the
;; source for `nest` to embed, and `run-bundle` (below) boots it inside the
;; embedded runtime. Mechanism (append/extract the archive) is Rust; this is the
;; policy (ADR-006).

;; The module name `require` knows a source file by — its path **relative to the
;; source dir it lives under**, without the `.blsp` extension. For a top-level file
;; that's just the stem (`src/main.blsp` → `main`); for a namespaced module it keeps
;; the namespace (`…/net/sse.blsp` under `…/src` → `net/sse`), exactly the key
;; `require 'net/sse` looks up. So a bundle keyed this way resolves through the same
;; `%builtin-module` path as the baked-in std (whose table is likewise keyed by full
;; name, e.g. `editor/buffer`) — with no load-path on disk.
(defn project--bundle-name (dir path)
  (let (prefix (if (ends-with? dir "/") dir (str dir "/"))
        rel (if (starts-with? path prefix)
              (substring path (string-length prefix) (string-length path))
              (path-basename path)))
    (if (ends-with? rel ".blsp")
      (substring rel 0 (- (string-length rel) 5))
      rel)))

(defn bundle-collect (root)
  "Collect a project's shippable source for `nest release`: a flat list of
strings `(manifest-src name0 src0 name1 src1 …)` the `nest` side embeds in the
binary (ADR-038). Includes resolved dependency sources; excludes `tests/`. Modules
are keyed by their require-name — the path relative to the source dir, sans `.blsp`,
so a namespaced module (`net/sse`) keeps its namespace and resolves like the baked-in
std. Errors if `root` is nil (not in a project)."
  (when (nil? root)
    (error "bundle-collect: not in a Brood project (no project.blsp found)"))
  (let (manifest (slurp (path-join root "project.blsp")))
    ;; Apply the manifest as DATA (not `load`) to learn its source paths + deps,
    ;; mirroring `project-setup`. We don't load any source here — just read it.
    (let (form (read-first manifest))
      (when (and (pair? form) (= (first form) 'project)) (project-apply (rest form))))
    ;; Project source dirs first, then resolved dependency dirs (so a project
    ;; module wins a stem clash with a dep — matches `*load-path*` ordering).
    ;; `*project-dependencies*` only — never `*project-dev-dependencies*` (ADR-172): a
    ;; `:dev-dependencies` is test/dev-only, so it is deliberately excluded from the
    ;; shipped bundle. (This is the payoff of keeping dev-deps in their own slot.)
    (let (src-dirs (project-abs-paths root *project-source-paths*)
          dep-dirs (if *project-dependencies*
                     (do (require 'package) (package/ensure-deps root *project-dependencies*))
                     nil)
          all-dirs (append src-dirs dep-dirs))
      ;; Pair each file with the source dir it was found under, so its require-name
      ;; (relative to that dir) keeps any namespace — `src/main.blsp` → `main`,
      ;; `src/net/sse.blsp` → `net/sse`. Dir order (project dirs first)
      ;; is preserved, so a project module still wins a name clash with a dep.
      (cons manifest
        (fold (fn (acc d)
                (fold (fn (a f) (append a (list (project--bundle-name d f) (slurp f))))
                  acc (project-collect-sources d)))
          nil all-dirs)))))

;; (run-bundle args) — boot an embedded release bundle. The `brood` binary,
;; detecting its appended archive, calls this instead of starting a REPL. No
;; disk/cwd: every module comes from the embedded archive via `%builtin-module`
;; (which `require-one` consults). Mirrors `run-project`'s entry resolution minus
;; the project walk and the advisory checker (a shipped app isn't a dev image).
(defn run-bundle (args)
  "Run an embedded release bundle's entry point, passing `args` (a list of CLI
string arguments). The `brood` binary calls this when it detects it is a `nest
release` bundle. Loads the embedded manifest + modules and invokes `:main`
(default module `main`, fn `main`). Errors if the entry fn is missing/uncallable."
  (let (form (read-first (%bundle-manifest)))
    (when (and (pair? form) (= (first form) 'project)) (project-apply (rest form))))
  ;; Load every embedded module once. Order-independent: cross-module
  ;; `:use`/`require` resolve through the same embedded table, and require is
  ;; idempotent — so a `(:use foo)` in the first module pulls `foo` on demand.
  (map require-one (%bundle-module-names))
  (let (entry (or *project-main-override* *project-main*)
        modname (first entry)
        fname (second entry))
    (require modname)
    (let (qual (symbol (str (name modname) "/" (name fname))))
      (let (target (cond (bound? qual) qual (bound? fname) fname else nil))
        (when (nil? target)
          (error "run-bundle: entry fn '" fname "' is not defined (module '" modname "')"))
        (let (f (eval target))
          (unless (fn? f)
            (error "run-bundle: entry '" fname "' is not callable (" (type-of f) ")"))
          (apply f args))))))

;; --- user config (~/.config/brood/config.blsp) -------------------------------
;; A user-level Brood file of tooling preferences — the sibling of project.blsp.
;; It's auto-created with documented defaults on first tool use, then loaded by
;; the `nest` subcommands. Rust mechanism: getenv (locate it) + run-process.
(defdyn *config-git-init* false)
; nest new: run `git init` in the new project?

;; The default package-registry index — a git repo of package metadata (ADR-147).
;; `nest search`/`publish` and `:version` deps read it; override via `:registry` in
;; the user config, or pass an explicit index to the registry functions (tests do).
(defdyn *config-registry* "https://github.com/broodlang/registry")

(defn config (& opts)
  "Set user-level tooling preferences — the form the user config file (`~/.config/brood/config.blsp`) contains. Recognized keys: `:git-init` (whether `nest new` runs `git init`) and `:registry` (the package-registry index git URL). Sets only the keys given; returns nil."
  (let (gi (plist-get opts :git-init)) (unless (nil? gi) (def *config-git-init* gi)))
  (let (rg (plist-get opts :registry)) (unless (nil? rg) (def *config-registry* rg)))
  nil)

(defn config--base-dir ()
  ; $XDG_CONFIG_HOME, else ~/.config
  (let (xdg (getenv "XDG_CONFIG_HOME")) (if (nil? xdg) (path-join (getenv "HOME") ".config") xdg)))
(defn config--dir () (path-join (config--base-dir) "brood"))
(defn config--path () (path-join (config--dir) "config.blsp"))

(def *config-default-source*
  (str ";; Brood user config — tooling preferences (the sibling of project.blsp).\n"
    ";; Edit to taste; any `nest` command re-reads it.\n" "(config\n"
    "  :git-init false)   ; run `git init` in projects made by `nest new`\n"))

;; Ensure the config exists (writing a documented default the first time), then
;; apply it. Called by the `brood` subcommands, so a tool use always leaves an
;; editable config behind.
(defn load-config ()
  "Ensure the user config (`~/.config/brood/config.blsp`) exists — writing a documented default on first use — then apply it. Called by the `nest` subcommands."
  (let (p (config--path))
    (unless (file-exists? p)
      (make-dir (config--dir))
      (spit p *config-default-source*)
      (println (str "Created " p)))
    ;; Read the config as DATA and apply the `(config …)` form directly, rather
    ;; than `(load)`-ing it as code. `load` evaluates a file at the *root*
    ;; namespace with a fresh (empty) import table (ADR-065), so a bare
    ;; `(config …)` written in the user file would not resolve to this module's
    ;; `project/config`. Reading-as-data keeps the user config a clean bare DSL
    ;; (the project manifest is read the same way, ADR-020) and decouples it from
    ;; namespace resolution — `config` here is `project/config` (this body is
    ;; compiled in the `project` namespace), so the apply resolves.
    (let (form (read-first (slurp p)))
      (when (and (pair? form) (= (first form) 'config))
        (apply config (rest form)))))
  nil)
