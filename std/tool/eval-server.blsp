;; std/tool/eval-server.blsp — a persistent, image-isolated evaluator: run this
;; module's loop in a DEDICATED runtime (`nest run` a two-line script) and feed it
;; eval requests over stdin, one per line; each reply comes back on stdout, one per
;; line. The parent gets REPL-grade evaluation — value, captured output, errors,
;; per-request timeout — without ever exposing its own global table to the code
;; being evaluated. This is the missing middle between in-image `reflect/eval-string`
;; (fast, but a stray `def` rewrites the live parent — unacceptable for evaluating
;; *untrusted-by-construction* text like an editor playground) and spawn-per-run
;; subprocesses (safe, but a full runtime start per eval).
;;
;; Session semantics: definitions persist across requests — the child is one live
;; image, so `(defn f …)` in request 1 is callable in request 2. That is a feature
;; (a tutorial lesson builds on its own defs); the RESET is the client's job:
;; respawn the child. There is deliberately no in-child `%isolate` — ADR-017's
;; wholesale global-table swap is unsound next to concurrent writers, which is
;; exactly why a live editor can never run one (see myedit's testrun preamble).
;;
;; Caveats, documented rather than fought (the threat model is "isolate the PARENT
;; image", not a security sandbox — evaluated code owns the child):
;;  - a request killed on timeout may have run some of its forms (evaluation is
;;    sequential), so the session may hold partial defs — acceptable in a sandbox,
;;    and any client that re-sends whole units of source is self-healing;
;;  - a process the evaluated code spawns inherits the request's capture, so its
;;    LATE prints (after the capture pops) are silently swallowed, never printed;
;;  - evaluated code CAN corrupt the channel deliberately — pop the capture with
;;    `(%capture-take)` and print a decodable forged reply line, or steal the next
;;    request with `(read-line)`. Clients must treat replies as advisory display
;;    data (they are), skip lines that don't decode, and use UNIQUE, monotonic ids
;;    per session so a late or forged line can't be mis-attributed to a live request.

(defmodule eval-server
  "A line-protocol eval server for a dedicated runtime, plus the pure codec its
client shares. Run `(run)` as the child's whole program; it prints
`{:ready true}` and then answers one `pr-str`ed request map per stdin line —
`{:id 7 :src \"(+ 1 2)\" :timeout-ms 2000}` — with one reply line:
`{:id 7 :ok true :value \"3\" :output \"\" :ms 0}` (or `:ok false` with `:error`,
or `:timeout true`). A request carrying `:check true` asks the CHECKER instead of the
evaluator and is answered `{:id 7 :ok true :diagnostics ({:line :col :message} …) :ms}`,
the list whole — an editor's buffer diagnostics, run in the child's image and project
so nothing of that project is loaded into the editor. A request may carry `:trace
[\"fn-name\" …]`: those globals
are boundary-traced (`debug/trace-fn`) for the duration of the request — installed
as soon as each name becomes a function, so a `defn` and its call in one request
still trace — and the reply gains `:spy [{:kind :fn :args :value} …]` (bounded).
`:trace :all` traces every global the SESSION has defined ([[session-globals]] — the
image diffed against its pristine baseline), which is the only way to catch a helper
called by your code but never named in the source a client can see.
`eval-capturing` is the reusable core: evaluate a source string and keep BOTH
halves a REPL shows — the value and what it printed.")

;; The deadline applied when a request doesn't carry one. Module-scoped (plain
;; `def`, not `defdyn`): the server honours the per-request `:timeout-ms` first,
;; so a client that wants a different policy sends it rather than reaching in.
(def *default-timeout-ms* 5000)

;; ---- the wire codec (pure; shared by server and client) ----------------------
;; One `pr-str`ed map per physical line. Both ends are Brood, so the reader IS the
;; parser and `pr-str`'s string escaping keeps any multi-line `:src` on one line —
;; no JSON dependency, no Content-Length framing (that machinery earns its keep
;; only when the peer is foreign, as in LSP). Decoders return nil on any line that
;; isn't a well-formed message, so both sides can skip noise instead of dying.

(defn evsrv-encode-request (id src timeout-ms &optional trace)
  "One request line (no trailing newline): `id` an int, `src` the Brood source to
evaluate (may span lines — it's escaped), `timeout-ms` an int or nil for the
server default, `trace` an optional vector of fn-name strings to boundary-trace — or
`:all` for every global the session has defined, resolved in the server's own image."
  (pr-str (if (or (nil? trace) (and (not (= trace :all)) (empty? trace)))
            {:id id :src src :timeout-ms timeout-ms}
            {:id id :src src :timeout-ms timeout-ms :trace trace})))

(defn evsrv-encode-check (id src timeout-ms)
  "One CHECK request line: `{:id :src :timeout-ms :check true}` — the server answers with
the advisory type-checker's verdict on `src` (`reflect/check-string-structured`), as
`{:id :ok true :diagnostics ({:line :col :message} …) :ms}`, the list whole rather than
display-bounded. What an editor sends for a buffer's diagnostics: the check runs in the
child — its image, its project — and nothing of that project is loaded into the editor."
  (pr-str {:id id :src src :timeout-ms timeout-ms :check true}))

(defn evsrv-encode-test (id specs timeout-ms)
  "One TEST request line: `{:id :specs :timeout-ms :test true}` — run this project's tests
in the session's own image and stream the verdicts back.

`specs` is a vector of `[file line-or-nil]` pairs; empty means the whole project suite.
The server answers a `{:id :more true :test {…}}` line per finished test as it lands and
then one final `{:id :ok true :summary {…}}`, which is `editor/evalsession`'s streaming
protocol — so a caller watches a suite go by rather than waiting for it.

Worth having in a SESSION rather than a fresh process for one measured reason: a one-shot
`nest test` of a single file in a project of sixty modules spends most of its second
loading the project, not running tests. Held open, that is paid once — the same trade the
`:check` request makes for the type checker.

Shown through the decoder rather than as the line itself, deliberately: the line is a
rendered map, and a map's rendering is not the thing to pin (KI-166). What a caller cares
about is the request that comes back out.

    (:specs (eval-server/evsrv-decode-request (eval-server/evsrv-encode-test 4 [[\"a_test.blsp\" 12]] 60000)))   → [[\"a_test.blsp\" 12]]"
  (pr-str {:id id :specs (into [] specs) :timeout-ms timeout-ms :test true}))

(defn evsrv-encode-attach (id spec cookie)
  "One ATTACH request line: `{:id :attach spec :cookie}` — route every later evaluation to
the node `spec` names rather than running it here.

`spec` is `node/connect`'s: `\"name\"` for a local node over its Unix socket,
`\"name@host:port\"` over TCP. The target must have called `(node/serve-spawns)`, which is
the opt-in — an editor cannot reach into a program that has not said it may be reached
into, and that is the right default for the feature.

Answered `{:id :ok true :node \"…\"}`, or `:ok false` with `:error`. The editor must show
which: an attach that silently did not happen leaves you evaluating locally while believing
you are not.

    (:attach (eval-server/evsrv-decode-request (eval-server/evsrv-encode-attach 6 \"worker\" nil)))   → \"worker\""
  (pr-str {:id id :attach spec :cookie cookie}))

(defn evsrv-encode-detach (id)
  "One DETACH request line: `{:id :detach true}` — route evaluation back to this runtime.

    (:detach (eval-server/evsrv-decode-request (eval-server/evsrv-encode-detach 7)))   → true"
  (pr-str {:id id :detach true}))

(defn evsrv-encode-teststop (id)
  "One TESTSTOP request line: `{:id :teststop true}` — abandon the test run in flight.

Answered `{:id :ok true :stopped true|false}`, and the ABANDONED run is answered too
(`:ok false :stopped true`), because a client that has recorded it as in flight is
otherwise waiting on a reply that is never coming. Two replies for one keystroke, and both
are owed.

    (:teststop (eval-server/evsrv-decode-request (eval-server/evsrv-encode-teststop 5)))   → true"
  (pr-str {:id id :teststop true}))

(defn evsrv-decode-request (line)
  "The request map in `line`, or nil when the line isn't one (garbage, blank, a
stray print). A request must carry an int `:id` and, unless it is a `:test`, a string
`:src`; a present `:timeout-ms` must be an int (a malformed field is a nil, never a raise
later — one bad line must not kill the server), a present `:trace` a vector, a present
`:check` a boolean, and a `:test`'s `:specs` a vector.

A `:test` carries `:specs` instead of `:src` because what it names is FILES, not source:
the tests already exist on disk, and sending their text would evaluate a copy rather than
run the thing you are looking at."
  ;; check-allow :discarded-catch — a line that is not the expected map, or a not-yet-defined trace target, is skipped
  (check-allow :discarded-catch
    (try
      (let (v (reflect/read-string line))
        (if (and (map? v)
              (int? (get v :id))
              (cond
                (or (get v :test) (get v :teststop))
                  (or (nil? (get v :specs)) (vector? (get v :specs)))
                (get v :attach) (string? (get v :attach))
                (get v :detach) true
                else (string? (get v :src)))
              (let (t (get v :timeout-ms)) (or (nil? t) (int? t)))
              (let (tr (get v :trace)) (or (nil? tr) (vector? tr) (= tr :all)))
              (let (c (get v :check)) (or (nil? c) (bool? c)))
              (let (tt (get v :test)) (or (nil? tt) (bool? tt)))
              (let (ts (get v :teststop)) (or (nil? ts) (bool? ts))))
          v
          nil))
      (catch _ nil))))

(defn evsrv-encode-reply (reply)
  "One reply line (no trailing newline) for `reply`, a map. The boot banner
`{:ready true}` and the per-request replies all travel through here."
  (pr-str reply))

(defn- evsrv-read-map (s)
  ;; check-allow :discarded-catch — a line that is not a map is the documented nil case
  (check-allow :discarded-catch
    (try
      (let (v (reflect/read-string s))
        (if (map? v) v nil))
      (catch _ nil))))

(defn evsrv-decode-reply (line)
  "The reply map in `line`, or nil when the line isn't one — a client skips nil
lines (see the module preamble on stray output).

A reply that something PREFIXED is salvaged from its first `{`. The child's stdout is
shared with whatever the evaluated code prints, and a print without a trailing newline
does not get a line of its own — it gets the front of the next one. That cost six of
twenty-seven streamed test verdicts before the runner's progress marks were silenced, and
silencing them fixes the runner rather than the case: a test is still free to print."
  (or (evsrv-read-map line)
    (let (i (index-of line "{"))
      (when (> i 0) (evsrv-read-map (string/substring line i (string/length line)))))))

;; ---- the evaluation core ------------------------------------------------------

;; The most captured-output characters a reply carries — the `:value` bound's
;; rationale applies verbatim to `:output` (one io/puts loop must not pump
;; megabytes into a single reply line the client reads whole).
(def *output-cap-chars* 8192)

;; The most spy entries a traced request collects — a traced deep recursion emits
;; two entries per call; past this the trace has made its pedagogical point. The
;; sink answers `:spy-stop` when it is reached, which is how the *traced program*
;; stops paying too (`debug/trace-fn` reverts to a plain tail call) rather than
;; running instrumented for another quarter-million calls we would only discard.
(def *spy-entry-cap* 200)

(defn- eval-server-bound-output (s)
  (if (<= (string/length s) *output-cap-chars*)
    s
    (str (string/substring s 0 *output-cap-chars*) "\n…[output truncated]")))

(defn- eval-server-process-report (before)
  "What the evaluation LEFT BEHIND: `{:alive n}` — processes that did not exist
before it and are still running when it returned.

Deliberately not a spawn *count*: a child that finishes before the evaluation does
is already gone from `proc/list`, so snapshots cannot see it, and guessing
would be worse than saying nothing. What survives is the half worth showing anyway
— concurrency is the one part of an evaluation with no return value to look at, so
`(spawn (receive …))` that parks forever reads as `1 still running` instead of
looking identical to a round-trip that cleaned up after itself."
  (let (after (proc/list))
    {:alive (count (seq/filter after (fn (p) (not (includes? before p)))))}))

(defn- eval-server-spy-entry (e)
  ;; One collected `*spy-sink*` entry, display-bounded for the wire. Shared by the eval
  ;; path (collected into a reply's `:spy`) and the test path (streamed as chunks of the
  ;; run) — one shape, so the *Spy* pane reads the same whichever produced it.
  {:kind (->string (or (get e :spy) :event))
   :fn (when (get e :fn) (str (get e :fn)))
   :args (when (get e :args) (pr-str-bounded (get e :args)))
   :value (when (contains? e :value) (pr-str-bounded (get e :value)))
   :form (when (get e :form) (pr-str-bounded (get e :form)))})

;; The global names that existed before this image ran anything of the user's. A
;; Rust-backed `table` rather than a `def`: it is written once, from whichever entry point
;; gets there first, and read on every traced request — the one shape Brood has for
;; write-once process state that isn't worth a process.
(def- *baseline-globals* (table/new))

(defn- eval-server-baseline ()
  ;; The baseline set, captured on first use. On the server path `run` captures it before
  ;; the banner, so it is a genuinely pristine image; an in-image caller captures it at its
  ;; first traced request, which is the best that path can do and still correct for the
  ;; case that matters (a session's own definitions).
  (or (table/get *baseline-globals* :names)
    (let (names (into #{} (map (reflect/global-names) ->string)))
      (do (table/put *baseline-globals* :names names) names))))

(defn baseline-globals ()
  "Capture the pristine global-name set NOW, so a later `:trace :all` can tell the session's
own definitions from the language's. Idempotent — the first call wins. [[run]] calls it
before the banner; anything embedding [[eval-capturing]] should call it at startup, or
accept a baseline taken at the first traced request."
  (do (eval-server-baseline) nil))
(defn- eval-server-own-name? (n)
  ;; A name the SESSION wrote, as opposed to one a module brought with it. Bare only:
  ;; a module's globals are namespaced (`foo/bar`), so requiring `std/csv` mid-session
  ;; would otherwise make its whole surface "yours" and trace all of it. `%`-hidden
  ;; primitives and earmuffed dynvars are excluded for the same reason they are excluded
  ;; everywhere — neither is a function you called.
  (and (not (includes? n "/"))
    (not (string/starts-with? n "%"))
    (not (and (string/starts-with? n "*") (string/ends-with? n "*")))))

(defn session-globals ()
  "Every global name defined since the baseline was captured — the session's own top-level
definitions, with the language's and any later-required module's excluded. What
`:trace :all` resolves to."
  (let (base (eval-server-baseline))
    (into []
      (seq/filter (map (reflect/global-names) ->string)
        (fn (n) (and (not (contains? base n)) (eval-server-own-name? n)))))))

(defn- eval-server-trace-names (trace)
  ;; A request's `:trace` as a concrete name vector. `:all` is resolved HERE, at install
  ;; time, rather than by the client: only this image knows what it has defined, which is
  ;; exactly why a client asking for "everything I defined" had to guess at it by walking
  ;; its own source text for call heads — and so never saw a helper the source doesn't name.
  (if (= trace :all) (session-globals) (or trace [])))

;; ---- holds a killed evaluator can no longer release --------------------------
;; A traced request holds its wrappers and releases them at teardown — but an evaluator the
;; parent KILLS never reaches its teardown, and its held set died with it. The parent used to
;; answer that with `debug/untrace-all`, "the trace registry is shared globals, so the parent
;; can", and that is the KI-107 mechanism restated one level up: a timeout in one request
;; wiped every wrapper in the image, including those a CONCURRENT request was still using.
;; The `answer` tests include a deliberate timeout, so this is not hypothetical — it is the
;; residual that survived scoping the ordinary teardown.
;;
;; So the held set lives where the parent can reach it: a registry keyed by the evaluator's
;; pid. The child records as it holds; it clears its own entry on a normal teardown; the
;; parent releases exactly that pid's holds when it kills or buries the child. Nothing
;; image-wide, and a leaked entry is bounded by the child's lifetime rather than forever.
(def- *trace-holders* {}) ; evaluator pid -> {name true} it currently holds
(defn- eval-server-note-hold (pid name)
  (%swap-registry! eval-server/*trace-holders*
    (fn (m) (assoc m pid (assoc (or (get m pid) {}) name true))))
  nil)

(defn- eval-server-forget-holds (pid)
  (%swap-registry! eval-server/*trace-holders* (fn (m) (dissoc m pid)))
  nil)

(defn release-holds-of (pid)
  "Release every trace hold recorded for evaluator `pid` and forget it; returns how many.

The parent's cleanup after a child that could not run its own teardown — a kill on deadline,
or an abnormal death. Replaces `debug/untrace-all` on those paths, which restored the whole
image and so took wrappers away from requests that were still running (KI-107)."
  (let (names (keys (or (get *trace-holders* pid) {})))
    ;; check-allow :discarded-catch — best-effort release; a name redefined since is reported by `untrace-fn`
    (doseq (n names)
      (check-allow :discarded-catch (try (debug/trace-release (symbol n)) (catch _ nil))))
    (eval-server-forget-holds pid)
    (count names)))

(defn- eval-server-try-traces (names acc)
  ;; Install a boundary trace on every requested name that is a function right now;
  ;; a name that isn't (yet) defined is skipped.
  ;;
  ;; Takes a HOLD on each name (`debug/trace-hold`) rather than a bare `trace-fn`, and records
  ;; the held set in `acc` so teardown can release exactly those. The registry is shared
  ;; globals, so two requests tracing the same name are otherwise invisible to each other —
  ;; the second `trace-fn` is a documented no-op, and the first request`s teardown then pulls
  ;; the wrapper out from under it. That is KI-107. A hold makes the second user countable,
  ;; and the wrapper survives until the last one lets go.
  ;;
  ;; Two different periods, and conflating them broke a test the first time round. The HOLD is
  ;; once per name per REQUEST — teardown releases each held name once, so a per-form hold
  ;; would leak holders the single release cannot match. The INSTALL stays per form, because
  ;; that is what re-wraps a name the previous form redefined (and wraps one that did not
  ;; exist yet); skipping it for an already-held name left a mid-request redefinition
  ;; untraced, which `tracing must never resurrect a stale definition` catches by name.
  (doseq (s (eval-server-trace-names names))
    ;; check-allow :discarded-catch — a line that is not the expected map, or a not-yet-defined trace target, is skipped
    (check-allow :discarded-catch
      (try
        (let (held (or (table/get acc :held) {}))
          (if (contains? held s)
            ;; already ours — re-wrap if the name was redefined since (`trace-fn` is
            ;; generation-aware, and a no-op when the wrapper is still current)
            (debug/trace-fn (symbol s))
            (do
              (debug/trace-hold (symbol s))
              (table/put acc :held (assoc held s true))
              ;; …and where the PARENT can see it, in case this process is killed before
              ;; it can release (see `release-holds-of`).
              (eval-server-note-hold (self) s))))
        (catch _ nil)))))

(defn- eval-server-release-traces (acc)
  ;; Teardown: let go of exactly the names this request held. The wrapper is restored only if
  ;; no one else is still holding it.
  ;;
  ;; This used to be `debug/untrace-all`, and that is KI-107. The trace registry is shared
  ;; GLOBALS — deliberately, so a parent can clean up after a child it killed — so a request
  ;; tearing down restored every wrapper in the image, including one a CONCURRENT request had
  ;; just installed. The victim's own trace then stopped mid-recursion and its reply came back
  ;; with an empty `:spy`, about 1 run in 17, with no error anywhere: the evidence showed the
  ;; wrapper installed and then lost, and no refusal for the name that lost it.
  ;;
  ;; `:isolated` does not prevent it. A test step awaits its worker, not the processes that
  ;; worker spawned, so the PREVIOUS unit's evaluator can still be alive and tearing down
  ;; while this one installs — which is why quiescing before each isolated step was measured
  ;; and did not move the rate.
  (doseq (s (keys (or (table/get acc :held) {})))
    ;; check-allow :discarded-catch — best-effort release; a name redefined since is reported by `untrace-fn` itself
    (check-allow :discarded-catch (try (debug/trace-release (symbol s)) (catch _ nil))))
  ;; released by us, so the parent has nothing left to clean up for this process
  (eval-server-forget-holds (self))
  nil)

(defn- eval-server-eval-traced (src names acc)
  ;; Evaluate `src` form by form (not `reflect/eval-string`), (re)installing the requested
  ;; traces before EVERY form. `trace-fn` is generation-aware: a name already wrapped is
  ;; left alone, a name the previous form REDEFINED is wrapped afresh around its new
  ;; body, and a name that does not exist yet is skipped until the form that defines it
  ;; has run. So `(defn f …) (f 5)` traces `f`, and so does `(defn f …)` in one request
  ;; followed by `(f 5)` in the next, whatever the definition form was spelled — this
  ;; used to hinge on a list of definition heads, and the day `defn-` was not on it a
  ;; playground evaluated the previous definition of every private function it traced.
  ;; …and once more AFTER the last form: a request whose final form redefined a traced
  ;; name would otherwise hand `untrace-all` a moved generation, which it (rightly)
  ;; refuses to restore over — and reports. Re-wrapping the new body first makes the
  ;; teardown an ordinary restore, so an edit to a traced function is not a warning.
  (let (value (fold (reflect/read-all src)
                nil
                (fn (_ form) (do (eval-server-try-traces names acc) (reflect/eval form)))))
    (eval-server-try-traces names acc)
    value))

(defn check-structured (src)
  "Advisory type-check `src` (the `:check` request's core): `{:ok true :diagnostics
(…) :ms}` with the checker's `{:line :col :message}` maps whole — `()` for a source that
does not parse — or `:ok false` with `:error` when the checker itself raised. Never throws."
  (let (t0 (os/now))
    (try
      {:ok true :diagnostics (or (reflect/check-string-structured src) ()) :ms (- (os/now) t0)}
      (catch e {:ok false :error (error-message e) :ms (- (os/now) t0)}))))

(defn eval-capturing (src &optional trace-names)
  "Evaluate source string `src` (all its forms, in order) with stdout captured;
return `{:ok true :value <pr-str-bounded> :output <string> :ms <int>}` or
`{:ok false :error <message> :output <string> :ms <int>}`. Never throws, and pops
the capture buffer on every path, so a failed eval can't leave a dangling capture.
Keeps BOTH halves a REPL shows — the value and what was printed — which
`with-out-str` can't (it discards the value). `:value` is display-bounded and
`:output` capped (`*output-cap-chars*` + a truncation marker), so no reply can
flood the pipe.

With `trace-names` (a vector of fn-name strings, or `:all` for every global the session
has defined — see [[session-globals]]), each name is boundary-traced for the
duration (`debug/trace-fn`, installed once before the first non-definition form,
restored by `untrace-all` after) and the result carries `:spy` — up to
`*spy-entry-cap*` collected entries, after which the sink answers `:spy-stop` and
the tracer gets out of the way: the rest of the run is uninstrumented, in constant
stack, at full speed. So a traced tail loop of any depth is safe here — it reports
its first `*spy-entry-cap*` entries and then simply runs. (Before that contract
existed, tracing a 250 000-deep tail loop cost a frame per level and 11× the
runtime, and a 4-million-deep one came back as `recursion too deep`.) One caveat
remains: a traced name is wrapped exactly once per request, so the definition the
source itself provides is always the one that runs.

In-image caveat for long-lived callers: evaluated source that calls
`(%capture-begin)` without a matching take strands OUR buffer on the calling
process's capture stack (later prints are swallowed). Irrelevant on the server
path — the per-request evaluator process dies — but worth knowing when embedding."
  (let (t0 (os/now)
        pids-before (proc/list)
        ;; `:all` is truthy and not a collection, so it counts as traced without being
        ;; measured — it resolves to a name list only at install time, in the image.
        traced (and trace-names (or (= trace-names :all) (not (empty? trace-names))))
        acc (when traced (table/new))
        sink (when acc
               (fn (e)
                 (let (n (or (table/get acc :n) 0))
                   (if (< n *spy-entry-cap*)
                     (do
                       (table/put acc :n (inc n))
                       (table/put acc
                         :entries (cons (eval-server-spy-entry e)
                           (or (table/get acc :entries) '())))
                       ;; the entry that FILLS the budget already answers stop: nothing
                       ;; after it would be kept, so nothing after it should be paid for
                       (when (>= (inc n) *spy-entry-cap*) :spy-stop))
                     :spy-stop))))
        run (fn ()
              (try
                {:ok true
                 :value (pr-str-bounded (if traced
                                          (eval-server-eval-traced src trace-names acc)
                                          (reflect/eval-string src)))}
                (catch e {:ok false :error (error-message e)})))
        _ (%capture-begin)
        r (if traced (binding (*spy-sink* sink) (run)) (run))
        out (eval-server-bound-output (or (%capture-take) ""))
        r2 (assoc r
             :output out
             :ms (- (os/now) t0)
             :procs (eval-server-process-report pids-before)))
    (if acc
      (do
        (eval-server-release-traces acc)
        (assoc r2 :spy (reverse (or (table/get acc :entries) '()))))
      r2)))

;; ---- per-request timeout: eval in a child process, kill on deadline ----------
;; The same shape as the REPL's interruptible eval (std/tool/repl.blsp): run the
;; eval in its own green process and park in `receive` with an `after` deadline;
;; the untrappable `(exit child :kill)` lands at the child's next reduction tick
;; (~4ms even mid-JIT-loop), so a runaway `(loop-forever)` costs one deadline, not
;; the image. `def`s the child makes reach the shared global table (ADR-013), so
;; the session survives its own timeouts.

(defn- eval-server-flush-stale ()
  ;; Reap what earlier requests may have left in the mailbox: a result a killed
  ;; child managed to send before the kill landed (results are also matched by
  ;; pinned id — this just keeps corpses from accreting), and `[:down …]` letters
  ;; from completed evaluators — `demonitor` here is best-effort (a DOWN already
  ;; queued is NOT recalled), so without this every successful request would leak
  ;; one forever and every later selective receive would scan the pile.
  (receive
    ([:evsrv-result _ _ _] (eval-server-flush-stale))
    ([:down _ _ _] (eval-server-flush-stale))
    (after 0 nil)))

(defn answer (req &optional (attached nil))
  "The reply map for request map `req` (`:id` `:src`, optional `:timeout-ms` and
`:trace`), evaluating in a spawned green process: the eval's own result on
completion, `{:id id :ok false :timeout true}` after the deadline (the evaluator
is hard-killed; the session image survives — and any traces the killed evaluator
installed are restored here), or `:ok false` with `:error` if the evaluator
process died without answering."
  (let (id (get req :id)
        src (get req :src)
        raw-timeout (get req :timeout-ms)
        timeout (if (int? raw-timeout) raw-timeout *default-timeout-ms*)
        trace (get req :trace)
        me (self)
        ;; The compile context — the namespace AND the `(:use …)` imports — is PER
        ;; PROCESS, and every request evaluates in a fresh one: without this hand-over
        ;; a `(defmodule calc)` request set the namespace of a child that then exited,
        ;; the next request's `(defn eval …)` defined a bare `eval`, and `(calc/eval …)`
        ;; was unbound — form-at-a-time evaluation from an editor could never build a
        ;; module. The child adopts the session's context before it evaluates and
        ;; reports where it ended; the loop process adopts that below, so the next
        ;; child inherits it (the REPL's `%in-ns`-in-the-loop-process discipline,
        ;; spread over two processes). A snapshot, not just the namespace: carrying
        ;; `%in-ns` alone left `(defmodule calc (:use test))`'s `assert=` unbound one
        ;; request later.
        session-ctx (%compile-context)
        _ (eval-server-flush-stale)
        ;; a `:check` request asks the checker, not the evaluator: the same child,
        ;; deadline and kill, a structured reply
        ;; …and when this session is ATTACHED, the evaluation happens on the peer instead.
        ;; Still inside the same spawned child with the same deadline and kill, so a node
        ;; that stops answering costs one request rather than the session.
        work (cond
               (get req :check) (fn () (check-structured src))
               attached (fn () (evsrv-remote-eval attached src trace))
               else (fn () (eval-capturing src trace)))
        child (spawn (do
                       (%restore-compile-context session-ctx)
                       (send me [:evsrv-result id (work) (%compile-context)])))
        ref (monitor child))
    (receive
      ([:evsrv-result ^id r ctx]
        (do
          (demonitor ref)
          ;; the child dies :normal right after its send, so its DOWN is usually
          ;; already queued when we demonitor — drain it now (flush-stale is the
          ;; belt for the delivery-mid-demonitor sliver)
          (receive ([:down ^ref _ _] nil) (after 0 nil))
          ;; unconditional: a request that returns to root (`(%in-ns nil)`) must not
          ;; leave the session stuck in the last module
          (%restore-compile-context ctx)
          (assoc r :id id)))
      ([:down ^ref ^child reason] (do
                                    (release-holds-of child)
                                    {:id id
                                     :ok false
                                     :error (str "evaluator died: " (pr-str reason))
                                     :ms 0}))
      (after timeout
        (do
          (exit child :kill)
          (demonitor ref)
          ;; A killed traced evaluator never reached its own release, so the parent does it
          ;; — but only for THAT child. This was `debug/untrace-all`, which restored the whole
          ;; image and so pulled wrappers out from under requests that were still running: the
          ;; KI-107 mechanism one level up, and the residual that survived scoping the ordinary
          ;; teardown (the `answer` tests time out on purpose, so it fires in this very file).
          (release-holds-of child)
          {:id id :ok false :timeout true :ms timeout})))))

;; ---- attaching to a node that is already running ------------------------------
;; The session is an ordinary Brood runtime, so the thing that turns an editor from a view
;; of a PROJECT into a view of a RUNNING SYSTEM is `node/connect`: evaluation routes to the
;; peer with `node/spawn-sync`, and everything built on evaluation — a playground buffer,
;; a scratch expression, whatever reads the reply — follows it there.
;;
;; The peer must have called `(node/serve-spawns)`. That is the opt-in, and it is the right
;; default: an editor cannot reach into a program that has not said it may be reached into.

;; How long a peer gets to answer work it has accepted. Generous: an attached node is a
;; real system doing real work, and the request's own deadline is the outer bound.
(def *remote-eval-timeout-ms* 60000)

(defn- evsrv-attach (spec cookie)
  "Connect to the node `spec` names, starting distribution here first if this runtime is
not yet a node. Answers its authoritative name, or raises with why not."
  (when (= (node/name) :nonode)
    ;; A name of our own is needed before anyone can be dialled, and it is not taken at
    ;; boot: an unnamed runtime costs nothing and cannot be reached, which is what a child
    ;; that usually only talks to its editor should be.
    (node/start (keyword (str "bedit-sandbox-" (os/now)))
      nil
      (when (and cookie (not (= cookie ""))) cookie)))
  (node/connect spec))

(defn- evsrv-remote-eval (target src trace)
  "Run `src` ON `target`, captured there, and bring the reply map back.

`eval-capturing` itself is what travels: a free global re-resolves on the receiver, so the
peer runs its OWN copy and what crosses the wire is the finished map of strings and
numbers. Rendering remotely is not an optimisation — a value holding a pid or a handle
means nothing once copied, and the peer is the only place it can be read.

The reply comes back by MESSAGE rather than as the spawn's return: `node/spawn-sync`
answers the remote child's PID (it is synchronous about the spawn, not about the work), so
the pid of this process rides along in the closure and the child sends its map here. This
process is freshly spawned per request by [[answer]], so its mailbox holds nothing else."
  (let (me (self))
    (node/spawn-sync (keyword target) (fn () (send me (eval-server/eval-capturing src trace))))
    (receive
      (r r)
      ;; Bounded so a peer that accepts the spawn and then never answers is a failed
      ;; request rather than a wedged session. The request's own deadline would eventually
      ;; kill this child anyway; saying WHY is better than being killed.
      (after *remote-eval-timeout-ms*
        {:ok false :error (str "the node accepted the work but did not answer: " target)}))))

;; ---- running this project's tests in the session ------------------------------
;; The third request kind, and the one that streams. `:check` and an ordinary eval each
;; answer once; a suite has something to say per test, and holding it all until the end
;; would turn the only part a reader watches into a wait.

(defn- evsrv-test-result (r)
  "One finished test in the structured shape a client renders — the same fields
`*test-report-sink*`'s consumers already read."
  {:group (test/r-group r)
   :name (test/r-name r)
   :passed (not (test/r-failed? r))
   :skipped (test/r-skipped? r)
   :ms (test/r-ms r)
   :where (test/r-where r)
   :failures (or (map (test/r-fails r) (fn (f) {:loc (first f) :details (second f)})) [])})

(defn- evsrv-test-load (specs)
  "Clear the registry and (re)load each spec's file, answering the `[file line]` pairs that
carry a line.

The reset is what makes a session legitimate for this at all: `describe`/`test` REGISTER by
consing onto `*units*`, so a long-lived image that loads the same file twice reports every
unit twice. Measured before it was called here: a 27-test file answered 27, then 54, then
81 — a runner that is wrong in a way that looks like a passing suite."
  (test/reset-units)
  (doseq (s specs) (reflect/load (first s)))
  (into [] (seq/keep specs (fn (s) (when (second s) [(first s) (second s)])))))

(defn- evsrv-refresh-project ()
  "Reload the project sources that have changed since this image loaded them, answering how
many — so a warm session tests the code on disk rather than the code it booted with.

Without this the session is wrong in the direction that costs most: green for a function
you have already broken, red for one you have already fixed. The no-op case is one `stat`
per source file, which is what makes doing it on every run affordable."
  ;; check-allow :discarded-catch — a project that cannot be re-read should still run the
  ;; tests it has, rather than turning a stale image into no image at all
  (check-allow :discarded-catch
    (try
      (let (root (project/find-root (file/cwd)))
        (if (nil? root) 0 (count (project/reload-changed root))))
      (catch e
        (do (log/warn (str "eval-server: could not refresh the project: " (error-message e))) 0)))))

(defn- evsrv-run-tests (id specs)
  "Run `specs` (empty = the whole project suite), streaming one `:more` line per finished
test, and answer the summary. Runs in THIS process: `run-tests-structured` isolates each
unit itself, so a test's `def`s roll back without the session having to."
  (let (reloaded (evsrv-refresh-project)
        lines (evsrv-test-load specs)
        ;; Silence the live progress marks for the duration. They are one character per
        ;; result, flushed WITHOUT a newline, onto the same stdout the replies travel on —
        ;; so a batch of them lands as a `....` prefix on the next reply line and the
        ;; client's reader, seeing dots where a map should start, drops that reply. Six of
        ;; twenty-seven verdicts went missing that way before this line, and the six were
        ;; whichever ones happened to follow a flush.
        ;;
        ;; `*test-formatter*` is the documented switch for exactly this: "a machine
        ;; formatter, whose output must stay parseable" (`test/progress-mark`). This is one.
        _ (def *test-formatter* :evsrv)
        ;; a `defdyn` set outside any `%isolate`, so it survives into the isolated units —
        ;; which is the whole reason a verdict can be reported as it lands
        _ (def *test-report-sink*
            (fn (r) (io/puts (evsrv-encode-reply {:id id :more true :test (evsrv-test-result r)}))))
        ;; …and `spy` INSIDE a test streams the same way. A one-shot runner gets this for
        ;; free by printing to a stdout nobody else is using; here the channel is a
        ;; protocol, so the entries travel as chunks of the run like the verdicts do.
        ;; Without it the warm runner and the cold one disagree about what `spy` does in a
        ;; test — the same project, the same key, different output — which is exactly the
        ;; drift a shared runner exists to prevent.
        _ (def *spy-sink*
            (fn (e)
              (io/puts (evsrv-encode-reply {:id id :more true :spy (eval-server-spy-entry e)}))))
        summary (if (empty? specs)
                  (project-run/run-tests-structured)
                  (if (empty? lines)
                    (test/run-tests-structured)
                    (test/run-tests-structured :filter {:lines lines}))))
    (def *test-report-sink* nil)
    (def *test-formatter* nil)
    {:id id
     :ok true
     :summary {:total (get summary :total 0)
               :passed (get summary :passed 0)
               :failed (get summary :failed 0)
               :ms (get summary :ms 0)
               ;; how many sources this run had to pick up first — what lets a client say
               ;; "warm · 2 reloaded" instead of leaving the reader to wonder whether the
               ;; answer is about the code they are looking at
               :reloaded reloaded}}))

(defn- evsrv-clear-sinks ()
  "Put the reporting seams back. Called on every way out of a test run — finished, raised,
or killed — because they are ROOT globals: left installed, the next run's verdicts would be
streamed against an id that has already been answered."
  (def *test-report-sink* nil)
  (def *spy-sink* nil)
  (def *test-formatter* nil))

(defn answer-test (req)
  "The reply map for a `:test` request — see [[evsrv-encode-test]]. The per-test lines have
already gone out by the time this returns; this is the final one.

Run in a spawned process by [[eval-server-loop]] rather than called inline, so the suite
can be ABANDONED: a run is the one request that legitimately lasts minutes, and a server
that cannot be interrupted during one is a server you can only escape by killing the image
that made it worth keeping.

The example is the failure, because it is the one answer that does not depend on which
project the image holds: a spec naming a file that is not there comes back as a REPLY,
never as a dead server.

    (:ok (eval-server/answer-test {:id 9 :test true :specs [[\"/no/such/file_test.blsp\" nil]]}))   → false"
  (let (id (get req :id))
    (try
      (evsrv-run-tests id (or (get req :specs) []))
      (catch e
        (do
          (evsrv-clear-sinks)
          {:id id :ok false :error (str "test run failed: " (error-message e))})))))

;; ---- the server loop ----------------------------------------------------------

;; The loop is a RECEIVE loop over two sources, not a read-line loop, and that is entirely
;; so a test run can be stopped.
;;
;; `read-line` blocks the process that calls it, so a server that reads its own stdin is
;; deaf for as long as it is busy. For an eval that is right — they are milliseconds, and
;; the deadline belongs to the client. For a suite it is not: a run lasts minutes by
;; design, and a stop request sent during one would sit unread in the pipe until the thing
;; it was meant to abandon had finished.
;;
;; So a READER process owns `read-line` and forwards each line, and the server selects
;; between "a line arrived" and "the run I spawned finished". While a run is in flight
;; every request except a stop is QUEUED rather than answered: the session is one image,
;; the runner swaps globals under `%isolate`, and answering an eval in the middle of that
;; is the unsoundness this module's preamble already refuses to have.

(defn- eval-server-reader (server)
  (let (line (read-line))
    (if (nil? line)
      (send server [:evsrv-eof])
      (do (send server [:evsrv-line line]) (eval-server-reader server)))))

(defn- evsrv-stop-run (state id)
  "Abandon the run in flight when `id` names it (or names nothing in particular), answering
the stop request. A stop for a run that has already finished is answered `false` rather
than ignored: the client asked a question and is owed the answer, not a timeout."
  (let (run (:run state))
    (if (nil? run)
      (do (io/puts (evsrv-encode-reply {:id id :ok true :stopped false})) state)
      (do
        (exit (:child run) :kill)
        (demonitor (:ref run))
        ;; the killed runner never reached its own teardown, so the parent does it
        (evsrv-clear-sinks)
        ;; …and the run it abandoned is still owed a final reply, or the client waits for
        ;; one that is never coming
        (io/puts (evsrv-encode-reply {:id (:id run) :ok false :stopped true}))
        (io/puts (evsrv-encode-reply {:id id :ok true :stopped true}))
        (assoc state :run nil)))))

(defn- evsrv-start-run (state req)
  (let (me (self)
        id (get req :id)
        child (spawn (send me [:evsrv-test-done id (answer-test req)]))
        ref (monitor child))
    (assoc state :run {:id id :child child :ref ref})))

(defn- evsrv-handle (state req)
  "Dispatch one decoded request: a stop is always answered, a test starts a run, and
anything arriving while a run is in flight waits its turn."
  (cond
    (get req :teststop) (evsrv-stop-run state (get req :id))
    (:run state) (update state :queue (fn (q) (into [] (append (or q []) [req]))))
    (get req :test) (evsrv-start-run state req)
    (get req :attach)
    ;; Reported rather than assumed, and the model of this is `beam-attach`: an attach
    ;; that silently did not happen leaves you evaluating locally while believing you
    ;; are not, which is the one failure the feature must never have.
      (let (r (check-allow :discarded-catch
                (try
                  {:node (->string (evsrv-attach (get req :attach) (get req :cookie)))}
                  (catch e {:error (error-message e)}))))
        (if (get r :error)
          (do
            (io/puts (evsrv-encode-reply {:id (get req :id) :ok false :error (get r :error)}))
            state)
          (do
            (io/puts (evsrv-encode-reply {:id (get req :id) :ok true :node (get r :node)}))
            (assoc state :attached (get r :node)))))
    (get req :detach)
      (do
        (io/puts (evsrv-encode-reply {:id (get req :id) :ok true :node nil}))
        (assoc state :attached nil))
    else (do (io/puts (evsrv-encode-reply (answer req (:attached state)))) state)))

(defn- evsrv-drain (state)
  "Take the next queued request now that nothing is in flight."
  ;; `into []` at both ends so the queue is a VECTOR and says so. `append` answers a list
  ;; and `(or … [])` a union of the two, which leaves `first`/`rest` here taking something
  ;; the checker cannot call seqable — a finding rather than a bug, and one the shape
  ;; should not have had in the first place.
  (let (q (into [] (or (:queue state) [])))
    (if (or (empty? q) (:run state))
      state
      (evsrv-drain (evsrv-handle (assoc state :queue (into [] (rest q))) (first q))))))

(defn- eval-server-loop (state)
  (receive
    ([:evsrv-line line] (let (req (evsrv-decode-request line))
                          (eval-server-loop (if req (evsrv-drain (evsrv-handle state req)) state))))
    ([:evsrv-test-done id reply] (do
                                   (when (:run state) (demonitor (get (:run state) :ref)))
                                   (io/puts (evsrv-encode-reply reply))
                                   (eval-server-loop (evsrv-drain (assoc state :run nil)))))
    ;; the runner died without answering — a crash, or the kill in `evsrv-stop-run` racing
    ;; its own demonitor. Either way the id is owed a reply, and only if it is still ours.
    ([:down ref child reason] (if (and (:run state) (= ref (get (:run state) :ref)))
                                (do
                                  (evsrv-clear-sinks)
                                  (io/puts (evsrv-encode-reply {:id (get (:run state) :id)
                                                                :ok false
                                                                :error (str "the test runner died: "
                                                                         (pr-str reason))}))
                                  (eval-server-loop (evsrv-drain (assoc state :run nil))))
                                (eval-server-loop state)))
    ;; nil from read-line = EOF: the parent closed stdin — done
    ([:evsrv-eof] nil)))

(defn run ()
  "Run the eval server: print the `{:ready true}` banner, then answer one request
per stdin line until EOF. This is the child's whole program — a client spawns
`nest run <script>` where the script references `eval-server/…`
`(run)`, and drives it over stdin/stdout."
  (baseline-globals) ; before the banner: nothing of the user's has run yet
  (io/puts (evsrv-encode-reply {:ready true}))
  (let (me (self))
    (spawn (eval-server-reader me)))
  (eval-server-loop {:run nil :queue [] :attached nil}))
