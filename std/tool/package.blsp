;; std/tool/package.blsp — the package manager (ADR-037, docs/packages.md).
;;
;; Third-party Brood deps: source pinned in the manifest's :dependencies, cached
;; per-project, locked for reproducibility. Policy is here; the kernel adds only thin
;; mechanism (`%git-clone`/`%git-resolve-ref`/`%file-swap`, …). `:path` deps load IN PLACE
;; (no _deps/ copy), so edits to a path-dep's tree are live; `:git`/`:tarball`/registry
;; deps are fetched into `_deps/<name>/`.
;;
;; Manifest parsing (`project/parse-deps`) lives in std/tool/project.blsp — the manifest
;; owner — and we reuse it both for the root manifest and for each dep's own.

(defmodule package
  "The package manager behind `nest fetch` and friends (ADR-037). Resolves the project's
:dependencies (`:path`, `:git`, `:tarball` and registry `:version`) into a flat,
transitively-closed lock file and puts each dep's source on *load-path*."
  (:use format)
  (:use project)
  ;; `project-cache-dir` is module-private (ADR-146); the manifest lock lives there
  ;; (beside the project's other derived state) rather than in the project tree.
  (:use-internals project))

; tree hashing over hash/sha256 + hash/sha256-bytes
; version-range predicates + the backtracking version resolver (ADR-209)
;; --- canonical directory content hash (ADR-037 reproducibility) --------------
;; A directory's hash is Brood over the `hash/sha256` digest: walk files in
;; sorted order, and for each emit "<rel-path>\0<file-hash>\n", then hash the lot.
;; Approximates `git archive | sha256sum` without depending on git. Skips _deps/
;; and .git/ (a dep's nested cache / VCS data is not part of its content).

;; Skip _deps/ and .git/ (a dep's nested cache / VCS data isn't part of its
;; content) and .brood-pkg.blsp (the cache stamp we write *into* the dir post-clone
;; — excluding it keeps the tree hash invariant whether or not the stamp is present,
;; so a re-resolve of an unchanged commit produces the same hash).
(def- *hash-skip* (list "_deps" ".git" ".brood-pkg.blsp"))

;; The file paths under `dir`, relative to it, sorted. Recurses into subdirs.
(defn- package-tree-files (dir) (sort (package-tree-files-walk dir "" nil)))
(defn- package-tree-files-walk (dir prefix found)
  ;; Threads one accumulator through the whole walk, so it stays linear in the file count.
  (fold (file/ls dir)
    found
    (fn (acc entry)
      (if (includes? *hash-skip* entry)
        acc
        (let (full (path/join dir entry)
              relative (if (= prefix "") entry (str prefix "/" entry)))
          (if (file/dir? full)
            (package-tree-files-walk full relative acc)
            (cons relative acc)))))))

;; Hash the file's raw bytes, not a UTF-8 string: `file/slurp` throws on a binary
;; asset (image, font, …). For a text file the hash is identical to hashing the
;; string (its UTF-8 bytes are the file bytes).
(defn- package-sha256-file (path) (hash/sha256-bytes (file/slurp-bytes path)))

(defn tree-hash (dir)
  "The canonical SHA-256 (hex) of a directory's file contents — order-independent of the filesystem, stable across machines (ADR-037).

    (package/tree-hash \"/path/to/proj/_deps/json\")   ;~> \"9f2c…\" — 64 hex digits"
  (hash/sha256 (string/join (map (package-tree-files dir)
                              (fn (rel)
                                (str rel "\0" (package-sha256-file (path/join dir rel)) "\n")))
                 "")))

;; --- reading a dependency's own manifest -------------------------------------
;; A dep declares its own deps in its project.blsp. We read (not eval) the first
;; form; if it's a `(project …)` call, pull :dependencies from its plist and
;; normalise with the manifest parser. Avoids `reflect/load`, which would clobber the
;; root project's *project-* globals.
(defn- package-manifest-deps (manifest-path)
  (if (not (file/exists? manifest-path))
    nil
    (let (form (reflect/read-first (file/slurp manifest-path)))
      (if (and (pair? form) (= (first form) 'project))
        (project/parse-deps (plist-get (rest form) :dependencies))
        nil))))

;; --- resolution --------------------------------------------------------------
;; Resolve the transitive dep set into a flat list of resolved entries. Two phases,
;; because the two dep families answer "which version?" differently (ADR-209):
;;
;;   1. `:path`/`:git`/`:tarball` deps pin an EXACT source, so they resolve in a lazy
;;      depth-first walk — resolve one, read its manifest, queue its sub-deps. A name
;;      required twice at different exact sources is a loud, pin-it-yourself error.
;;
;;   2. `:registry` deps name a version RANGE, so they can't be fetched until a version
;;      is chosen. The walk COLLECTS every registry requirement it meets (from the root
;;      and from each resolved path/git manifest) instead of resolving it inline; the
;;      backtracking resolver (`std/resolver`) then picks one concrete version per
;;      registry package across the whole closure, and those get fetched + locked.
;;
;; A published package's own deps are registry-only (`nest publish` omits local kinds),
;; so the registry sub-graph is closed under the registry and the resolver's provider
;; can walk all of it from the API — the phase-1 walk never descends into a registry dep.

(defn resolve-deps (root:any deps:seqable lock:any -> any)
  "Resolve `deps` (dep records from the manifest) and everything they transitively pull in, into a flat list of resolved entries — each its dep record with `:resolved-path`/`:sha256`/`:deps` (and `:commit`/`:version`) assoc'd on, so it keeps the dep's identity and dispatches through the same `Dependency` impls. `lock` is the prior project.lock.blsp :dependencies (or nil). `:path`/`:git`/`:tarball` deps resolve to their exact source (a matching lock entry reuses the pinned commit/sha, network-free); `:registry` deps carry a version RANGE resolved to a concrete version by the backtracking resolver (ADR-209) — a fully-covering lock reuses the prior solution network-free, so pass nil (or drop names via `nest update`) to force a re-solve.

    (package/resolve-deps \"/path/to/proj\" project/*dependencies* (package/read-lockfile \"/path/to/proj\"))   ;~> (…each dep record with :resolved-path :sha256 :deps…)"
  (let (lock-index (package-lock-index lock)
        ;; Direct git/path/tarball pins override a same-named *transitive* registry
        ;; request (ADR-238): a root that pins a dep to an exact source wins over any
        ;; deeper `:version` request for that name, so the registry is never consulted
        ;; for it. This lets an app (e.g. the registry server itself) pin its whole
        ;; closure to git and build with zero registry contact. Empty in the common
        ;; all-registry case, where resolution is unchanged.
        direct-non-registry (map (seq/filter deps (fn (dep) (not (package-registry-dep? dep))))
                              :name)
        walked (package-resolve-loop root
                 deps
                 {}
                 nil
                 lock-index
                 (map deps :name)
                 direct-non-registry
                 nil)
        non-registry (first walked)
        registry-reqs (second walked)
        registry-entries (package-resolve-registry-closure root registry-reqs lock-index lock))
    (append non-registry registry-entries)))

;; Returns `[non-registry-entries registry-reqs]`: the resolved path/git/tarball entries
;; in resolution order, and the (unresolved) registry dep records to hand to the solver.
(defn- package-resolve-loop
  (root queue resolved order lock-index direct direct-non-registry registry-reqs)
  (cond
    (empty? queue) [(map (reverse order) (fn (name) (get resolved name))) registry-reqs]
    ;; A registry dep is collected, not resolved here — its version is a range the
    ;; solver picks over the whole registry closure (phase 2), so fetching it now
    ;; would mean fetching a version nobody has chosen yet. (The `dep-kind` ability op
    ;; is reached through a `defn` so this forward reference resolves — an ability op
    ;; used bare before its `defability` does not pre-scan, a `defn` does.)
    ;;
    ;; UNLESS the root pins this name to an exact source (`direct-non-registry`): a
    ;; direct git/path/tarball dep overrides a deeper `:version` request for the same
    ;; name (ADR-238), so we drop the registry request entirely rather than collect it.
    ;; The direct dep resolves this name through phase 1; the registry is never asked.
    (package-registry-dep? (first queue))
      (package-resolve-loop root
        (rest queue)
        resolved
        order
        lock-index
        direct
        direct-non-registry
        (if (includes? direct-non-registry (get (first queue) :name))
          registry-reqs
          (cons (first queue) registry-reqs)))
    (contains? resolved (get (first queue) :name))
      (do
        ;; A name already resolved: if it's a direct dep, the root's pin wins and we
        ;; ignore the transitive re-request silently; otherwise the two requesters
        ;; must agree on the source (else a loud, pin-it-yourself error).
        (when (not (includes? direct (get (first queue) :name)))
          (package-check-compatible (get resolved (get (first queue) :name))
            (first queue)))
        (package-resolve-loop root
          (rest queue)
          resolved
          order
          lock-index
          direct
          direct-non-registry
          registry-reqs))
    else
      (let (dep (first queue)
            name (get dep :name)
            entry (package-resolve-one root dep lock-index))
        (package-resolve-loop root
          (append (rest queue) (get entry :deps))
          (assoc resolved name entry)
          (cons name order)
          lock-index
          direct
          direct-non-registry
          registry-reqs))))

;; --- phase 2: solve the registry closure (ADR-209) --------------------------------
;; The collected registry requirements are the solver's roots (a name may appear more
;; than once with different ranges — the solver intersects them). The result is one
;; concrete version per registry package across the transitive closure; each is then
;; fetched + extracted exactly like a pinned `:version` dep was before.
;;
;; Network is confined to a bounded PRE-FETCH: before solving, the registry closure is
;; walked once (each package fetched a single time) into an immutable map, and the solve
;; then runs as a PURE function over it — the very injected-provider shape the resolver is
;; built around. So backtracking never re-hits the registry, however many versions it tries.

(defn- package-resolve-registry-closure (root registry-reqs lock-index lock)
  (if (empty? registry-reqs)
    nil
    (let (locked (package-lock-registry-solution lock))
      (if (package-lock-covers-reqs? locked registry-reqs)
        ;; The lock already pins a solution that still satisfies the manifest's ranges —
        ;; reuse it network-free (each fetch hits the `_deps/` cache), the fast path that
        ;; keeps a plain `nest run`/`test` from re-querying the registry every time.
        (package-fetch-registry-solution root locked lock-index nil)
        ;; Not fully covered (a dep was added/changed, or `nest update` dropped names) →
        ;; solve fresh, but hand the solver the still-locked versions as PREFERENCES so
        ;; the deps that didn't change keep their pins instead of jumping to newest.
        (package-solve-registry root registry-reqs lock-index locked)))))

(defn- package-solve-registry (root registry-reqs lock-index preferred)
  (let (base (registry-base-for nil)
        roots (map registry-reqs (fn (d) [(get d :name) (get d :version)]))
        prefetched (package-prefetch-registry base (map registry-reqs (fn (d) (get d :name)))))
    ;; Brood-version gate BEFORE the solve, so a runtime mismatch reports as one (ADR-209)
    ;; rather than as an opaque "no version satisfies" from deep in the backtracker.
    (package-check-brood-compat prefetched)
    (let (solution (resolver/resolve roots (package-prefetched-provider prefetched) preferred))
      (if (failure? solution)
        (error "package: could not resolve dependency versions — " (error-message solution))
        (package-fetch-registry-solution root solution lock-index base)))))

;; Fetch + extract every package of a resolved `{name → version}` solution into entries.
;; `base` is nil on the lock-reuse path (each fetch is served from the `_deps/` cache, and
;; only falls back to the configured registry when the cache is cold) and the resolved base
;; on a fresh solve. The one place a chosen concrete version becomes an on-disk dependency.
(defn- package-fetch-registry-solution (root solution lock-index base)
  (map (%map-pairs solution)
    (fn ([name version])
      (package-resolve-registry root
        (project/dep-registry name version)
        (get lock-index name)
        base))))

;; --- the registry pre-fetch (ADR-209) -------------------------------------------
;; Walk the registry closure from `names` into `{name → [{:version V :dependencies
;; [[dep-name range]...]} ...]}`, each package fetched exactly once. This is the ONLY
;; network resolution does, and at scale (300+ packages) it is the whole cost — so it is
;; parallelised: each breadth-first LEVEL is fetched CONCURRENTLY. Brood's HTTP is
;; non-blocking (ADR-062), so a spawned fetcher parks on socket I/O rather than pinning a
;; worker, and a level's fetches overlap end-to-end instead of summing. A 300-package
;; closure resolves in a handful of round-trip-bounded rounds, not 300 sequential GETs.
(defn- package-prefetch-registry (base names)
  (package-prefetch-bfs base (seq/distinct names) {}))

(defn- package-prefetch-bfs (base frontier fetched)
  (if (empty? frontier)
    fetched
    (let (results (package-fetch-frontier base frontier)
          fetched2 (fold results fetched (fn (m pair) (assoc m (first pair) (second pair))))
          discovered (seq/distinct (apply append
                                     (map results
                                       (fn (pair) (package-release-dep-names (second pair))))))
          next-frontier (seq/filter discovered (fn (name) (not (contains? fetched2 name)))))
      (package-prefetch-bfs base next-frontier fetched2))))

;; Fetch every package in `frontier` CONCURRENTLY — one spawned process each, results
;; gathered by mailbox. A failed fetch comes back tagged so a dead worker can't hang the
;; gather; the first failure raises with the package named. Returns `[[name releases]...]`.
(defn- package-fetch-frontier (base frontier)
  (let (me (self))
    (doseq (name frontier)
      (spawn (send me
               [:fetched
                 name
                 (try
                   [:ok (registry-fetch-releases base name)]
                   (catch e [:error (error-message e)]))])))
    (package-gather-frontier me (count frontier) nil)))

(defn- package-gather-frontier (me remaining acc)
  (if (= remaining 0)
    acc
    (receive
      ([:fetched name result] (match result
                                ([:ok releases] (package-gather-frontier me
                                                  (- remaining 1)
                                                  (cons [name releases] acc)))
                                ([:error message] (error "package: fetching "
                                                    (->string name)
                                                    " from the registry failed: "
                                                    message)))))))

;; The distinct dep-name symbols across a package's releases — the frontier to prefetch next.
(defn- package-release-dep-names (releases)
  (seq/distinct (apply append (map releases (fn (release) (map (get release :dependencies) first))))))

;; A PURE provider over the prefetched map (no I/O), so the resolver's backtracking is free:
;; Whether a release's `:brood` runtime constraint (ADR-209) is satisfied by the brood we
;; are running. A nil/empty constraint is unconstrained — releases published before the
;; registry served `:brood` carry none, so this stays backward-compatible.
(defn- package-release-brood-ok? (release)
  (let (constraint (get release :brood))
    (or (nil? constraint)
      (= constraint "")
      (version/satisfies? (system/brood-version) constraint))))

;; Guard: raise a CLEAR, brood-specific error if any package in the closure has releases but
;; NONE the running brood can satisfy. Without this the resolver reports an opaque "no version
;; of X satisfies …" for what is really a runtime-version mismatch — the exact confusing
;; failure the `:brood` constraint exists to prevent. A package with at least one compatible
;; release is left to the solver, which (via the provider below) only ever sees the compatible
;; ones. This makes the resolver care about the brood version, not just the root-project setup gate.
(defn- package-check-brood-compat (fetched)
  (doseq (entry (%map-pairs fetched))
    (let ([name releases] entry)
      (when (and (not (empty? releases)) (empty? (seq/filter releases package-release-brood-ok?)))
        (let (needed (seq/distinct (seq/filter (map releases (fn (r) (get r :brood)))
                                     (fn (c) (and c (not (= c "")))))))
          (error "package: no published release of "
            (->string name)
            " is compatible with the brood you are running ("
            (system/brood-version)
            "). "
            (->string name)
            "'s releases require Brood "
            (string/join needed " / ")
            " — upgrade brood, or depend on an older "
            (->string name)
            " that predates the requirement."))))))

;; `versions` reads the release list — filtered to the brood-compatible releases, so the
;; solver never selects a version the running runtime can't load; `deps` finds the matching
;; release's declared deps.
(defn- package-prefetched-provider (fetched)
  (resolver/make-provider (fn (name)
                            (map (seq/filter (get fetched name) package-release-brood-ok?)
                              (fn (release) (get release :version))))
    (fn (name version)
      (get (seq/find (get fetched name) (fn (r) (= (get r :version) version))) :dependencies))))

;; {name → locked concrete version} for every `:registry` row of the prior lock — the
;; previously-computed solution, reused when it still satisfies the manifest.
(defn- package-lock-registry-solution (lock)
  (fold lock
    {}
    (fn (m v)
      (let (row (vec->list v)
            plist (rest row))
        (if (plist-get plist :registry)
          (assoc m (first row) (plist-get plist :registry))
          m)))))

;; Whether the locked solution still satisfies every collected registry requirement —
;; the manifest hasn't asked for a range the pinned version misses. (Transitive
;; constraints are not re-checked: the lock is authoritative until `nest update`.)
(defn- package-lock-covers-reqs? (locked registry-reqs)
  (every? registry-reqs
    (fn (d)
      (let (pinned (get locked (get d :name)))
        (and pinned (version/satisfies? pinned (get d :version)))))))

;; --- the Dependency ability (ADR-172) ---------------------------------------
;; A dependency's KIND is its record identity (`project/dep-path` / `-git` / `-tarball`
;; / `-registry`, defined by the manifest owner, std/tool/project.blsp), and every per-kind
;; behaviour is an op of this one ability rather than a `(get dep :kind)` `cond` repeated
;; per behaviour. That was the actual bug risk here: adding a fifth kind meant finding
;; five scattered chains, and missing one failed late (a resolvable dep that couldn't be
;; written to the lock, or an `else` branch quietly treating it as a `:path`).
;;
;; `:sealed` names the closed set, so `nest check` reports a member missing any op — the
;; exhaustiveness the `cond` chains could never give. Runtime dispatch is unchanged by
;; sealing; a kind is still resolved by identity.
;;
;; A resolved *entry* is its dep record with the resolution fields assoc'd on, so it
;; carries the same identity and dispatches through the same impls (`dep-lock-vec`
;; below is called on entries, `dep-resolve` on deps).
(defability Dependency
  "A project dependency: where its source comes from, and how it is resolved, locked,
  written back to the manifest, and reconciled with another request for the same name.
  Sealed over the four manifest kinds.

    (package/dep-kind (project/parse-dep '[foo :path \"../foo\"]))  ;=> :path"
  :sealed [project/dep-path project/dep-git project/dep-tarball project/dep-registry]
  (dep-kind (self) :-> keyword)
  (dep-resolve (self root locked))
  (dep-check-compatible (self other))
  (dep-lock-vec (self) :-> vector)
  (dep-entry-node (self) :-> vector))

(impl Dependency
  project/dep-path
  (dep-kind (d) :path)
  (dep-resolve (d root locked) (package-resolve-path root d))
  (dep-check-compatible (d other)
    (when (not (= (get d :path) (get other :path)))
      (package-conflict other
        (str "required at both \"" (get d :path) "\" and \"" (get other :path) "\""))))
  (dep-lock-vec (e)
    (apply vector
      (list (get e :name)
        :path (get e :path)
        :sha256 (get e :sha256)
        :deps (package-dep-names-vec (get e :deps)))))
  (dep-entry-node (d)
    [:vector
      (vector [:symbol (->string (get d :name))]
        [:keyword ":path"]
        [:str (package-str-lit (get d :path))])]))

(impl Dependency
  project/dep-git
  (dep-kind (d) :git)
  (dep-resolve (d root locked) (package-resolve-git root d locked))
  ;; `d` is the already-resolved entry (a concrete `:ref`, plus `:resolved-version`
  ;; if it came from a range); `other` is a fresh request (an exact `:ref`, or a
  ;; `:version` range). Same repo required both ways; then the entry's pin must
  ;; satisfy the new request — a range is checked against the pinned version, an
  ;; exact ref must match the pinned ref (the greedy first-wins reconciliation).
  (dep-check-compatible (d other)
    (when (not (= (get d :url) (get other :url)))
      (package-conflict other
        (str "required from two different git URLs (" (get d :url) " and " (get other :url) ")")))
    (let (other-range (get other :version))
      (if other-range
        (let (pin (package-git-pin-version d))
          (when (or (nil? pin) (not (version/satisfies? pin other-range)))
            (package-conflict other
              (str "pinned to " (get d :ref) ", which does not satisfy \"" other-range "\""))))
        (when (not (= (get d :ref) (get other :ref)))
          (package-conflict other
            (str "required at both " (get d :ref) " and " (get other :ref) " (same repo)"))))))
  ;; A ranged dep also records its resolved concrete `:version` in the lock, so a
  ;; later run can range-check it without hitting the network (an exact-ref dep omits it).
  (dep-lock-vec (e)
    (apply vector
      (append (list (get e :name) :git (get e :url) :ref (get e :ref))
        (if (get e :resolved-version) (list :version (get e :resolved-version)) nil)
        (list :commit
          (get e :commit)
          :sha256 (get e :sha256)
          :deps (package-dep-names-vec (get e :deps))))))
  ;; Manifest writeback (`nest add`): a ranged dep writes `:version <range>`, an
  ;; exact one writes `:ref <ref>`.
  (dep-entry-node (d)
    (let (ranged (get d :version))
      [:vector
        (vector [:symbol (->string (get d :name))]
          [:keyword ":git"]
          [:str (package-str-lit (get d :url))]
          [:keyword (if ranged ":version" ":ref")]
          [:str (package-str-lit (or ranged (get d :ref)))])])))

;; The concrete version an already-resolved git entry is pinned at: its
;; `:resolved-version` (a ranged dep), else its `:ref` read as a version when the
;; tag is a plain `vX.Y.Z` (an exact pin to a version tag), else nil (an opaque
;; ref — a branch or commit — that a range cannot be checked against).
(defn- package-git-pin-version (entry)
  (or (get entry :resolved-version)
    (let (v (package-git-tag-version (get entry :ref)))
      (if (version/valid? v) v nil))))

(impl Dependency
  project/dep-tarball
  (dep-kind (d) :tarball)
  (dep-resolve (d root locked) (package-resolve-tarball root d))
  (dep-check-compatible (d other)
    (when (not (and (= (get d :url) (get other :url)) (= (get d :sha256) (get other :sha256))))
      (package-conflict other
        (str "required as two different tarballs (" (get d :url) " and " (get other :url) ")"))))
  (dep-lock-vec (e)
    (apply vector
      (list (get e :name)
        :tarball (get e :url)
        :sha256 (get e :sha256)
        :deps (package-dep-names-vec (get e :deps)))))
  (dep-entry-node (d)
    [:vector
      (vector [:symbol (->string (get d :name))]
        [:keyword ":tarball"]
        [:str (package-str-lit (get d :url))]
        [:keyword ":sha256"]
        [:str (package-str-lit (get d :sha256))])]))

(impl Dependency
  project/dep-registry
  (dep-kind (d) :registry)
  (dep-resolve (d root locked) (package-resolve-registry root d locked nil))
  (dep-check-compatible (d other)
    (when (not (= (get d :version) (get other :version)))
      (package-conflict other
        (str "required at two registry versions ("
          (get d :version)
          " and "
          (get other :version)
          ")"))))
  (dep-lock-vec (e)
    ;; `:pubkey` is recorded only for a SIGNED package (ADR-212) — the TOFU pin a later
    ;; install checks against; an unsigned package omits it, so the lock stays uncluttered.
    (apply vector
      (append (list (get e :name) :registry (get e :version) :sha256 (get e :sha256))
        (append (if (get e :pubkey) (list :pubkey (get e :pubkey)) nil)
          (list :deps (package-dep-names-vec (get e :deps)))))))
  ;; The manifest spells a registry dep `:version` (the kind keyword is `:registry`
  ;; only inside the lock, which also records the tarball's sha256 integrity pin).
  (dep-entry-node (d)
    [:vector
      (vector [:symbol (->string (get d :name))]
        [:keyword ":version"]
        [:str (package-str-lit (get d :version))])]))

(defn- package-resolve-one (root dep lock-index)
  (dep-resolve dep root (get lock-index (get dep :name))))

;; Whether `d` is a registry dep — the phase-1 walk collects these for the solver rather
;; than resolving them inline. Wrapping the `dep-kind` ability op in a `defn` lets the
;; earlier `package-resolve-loop` reach it (a `defn` forward reference pre-scans; a bare
;; ability op does not).
(defn- package-registry-dep? (d) (= (dep-kind d) :registry))

;; Index a lock's :dependencies vector by dep name → its plist (the :git/:ref/
;; :commit/… key-values), for reuse during resolution. nil lock → empty index.
(defn- package-lock-index (lock)
  (fold lock
    {}
    (fn (m v) (let (lst (vec->list v)) (assoc m (first lst) (rest lst))))))

;; A resolved entry is the DEP RECORD with the resolution fields assoc'd on — same
;; identity, so it dispatches through the same `Dependency` impls (that is what lets one
;; ability serve both `dep-resolve` on a dep and `dep-lock-vec` on an entry).
(defn- package-resolve-path (root dep)
  (let (abs (path/join root (get dep :path)))
    (when (not (file/dir? abs))
      (error "package: :path dependency " (get dep :name) " not found at " abs))
    (assoc dep
      :resolved-path abs
      :sha256 (tree-hash abs)
      :deps (package-manifest-deps (path/join abs "project.blsp")))))

;; --- git deps (ADR-037 Slice 2) ---------------------------------------------
;; A git dep is cloned into _deps/<name>/ and pinned to an exact commit. The
;; commit comes from the lock when the manifest's url+ref still match (no network);
;; otherwise `%git-resolve-ref` resolves the ref via `git ls-remote`. The clone is
;; skipped when the cache's .brood-pkg.blsp already records that commit. The dep's
;; own project.blsp is read (post-clone) for its transitive deps.

(defn- package-deps-dir (root) (path/join root "_deps"))
;; Every fetched dep's directory is computed here, and every one of them may be deleted
;; and re-created, so the name is re-checked at the point it becomes a path: a name that
;; slipped past an entry point (a lock, a registry, a caller of a public verb) must not
;; aim `%rm-rf` outside `_deps/`.
(defn- package-git-target (root name)
  (let (name-str (->string name))
    (when (not (project/valid-dep-name? name-str))
      (error "package: refusing dependency name "
        (pr-str name-str)
        " — it is not a single plain directory name, so _deps/"
        name-str
        " would point outside _deps/"))
    (path/join (package-deps-dir root) name-str)))

;; The commit to pin: reuse the lock's when it still matches the manifest's
;; url+ref (avoids a network round-trip); otherwise resolve via ls-remote.
(defn- package-git-commit-for (dep locked)
  (if (and locked
        (= (plist-get locked :git) (get dep :url))
        (= (plist-get locked :ref) (get dep :ref))
        (plist-get locked :commit))
    (plist-get locked :commit)
    ;; Network-bound (git ls-remote) → the offload pool, so a fetch doesn't
    ;; pin a scheduler worker (ADR-144).
    (or (proc/offload %git-resolve-ref (get dep :url) (get dep :ref))
      (error "package: cannot resolve git ref \""
        (get dep :ref)
        "\" for "
        (get dep :name)
        " at "
        (get dep :url)
        " (no such tag/branch/commit on the remote?)"))))

;; .brood-pkg.blsp is the cache's source of truth: a clone is current when it
;; records the same commit we want.
(defn- package-pkg-meta-path (target) (path/join target ".brood-pkg.blsp"))
(defn- package-cache-current? (target commit)
  (let (meta (package-pkg-meta-path target))
    (and (file/dir? target)
      (file/exists? meta)
      (let (form (reflect/read-first (file/slurp meta)))
        (and (pair? form)
          (= (first form) 'brood-pkg)
          (= commit (plist-get (rest form) :commit)))))))

(defn- package-write-pkg-meta (target url ref commit sha)
  (file/spit (package-pkg-meta-path target)
    (str ";; .brood-pkg.blsp — written by the package manager. Do not edit by hand.\n"
      (pr-str (list 'brood-pkg :git url :ref ref :commit commit :sha256 sha :fetched-at (os/now)))
      "\n")))

;; --- git-tag semver ranges (ADR-209) ----------------------------------------
;; A git dep may track a `:version` RANGE instead of pinning an exact `:ref`. The
;; range is resolved GREEDILY to the newest published tag that satisfies it — one
;; `ls-remote` (no per-candidate manifest fetch); the chosen tag then flows through
;; the exact-ref clone path unchanged. `version/match?` gives plain-range
;; excludes-prerelease for free, so a `1.4.0-rc.1` tag is skipped by `^1.2.0`.

;; A tag's candidate version: strip one optional leading `v` (so `v1.2.0` and
;; `1.2.0` both read as the version 1.2.0). Returns the string as-is otherwise.
(defn- package-git-tag-version (tag:string -> string)
  (if (and (> (count tag) 0) (= (string/substring tag 0 1) "v"))
    (string/substring tag 1)
    tag))

;; PURE: from a remote's `tags` (names) pick the NEWEST that satisfies `range`,
;; as `[tag version]` (the original tag name + its numeric version), or nil if
;; none match. A tag whose stripped form isn't a valid MAJOR.MINOR.PATCH version
;; (`latest`, `nightly`) is ignored. Offline-testable — the range-selection unit.
(defn- package-select-git-version (tags range)
  (let (compiled (version/compile range)
        candidates (fold tags
                     nil
                     (fn (acc tag)
                       (let (v (package-git-tag-version tag))
                         (if (and (version/valid? v) (version/match? compiled v))
                           (cons [tag v] acc)
                           acc)))))
    (if (empty? candidates)
      nil
      (fold (rest candidates)
        (first candidates)
        (fn (best cand) (if (> (version/compare (second cand) (second best)) 0) cand best))))))

;; Resolve a git dep to a concrete tag. An exact-`:ref` dep is returned unchanged.
;; A ranged dep gets `:ref` (the chosen tag) + `:resolved-version` (its version)
;; assoc'd on: reuse the lock's pinned tag when its resolved version still
;; satisfies the range (network-free — keeps a plain `nest run` offline); else
;; `%git-list-tags` and pick the newest match (or error, naming the range + tags).
(defn- package-git-concrete-ref (dep:map locked:any -> map)
  (let (range (get dep :version))
    (if (nil? range)
      dep
      (let (url (get dep :url)
            locked-version (and locked
                             (= (plist-get locked :git) url)
                             (plist-get locked :version)))
        (if (and locked-version (version/satisfies? locked-version range))
          (assoc dep :ref (plist-get locked :ref) :resolved-version locked-version)
          (let (tags (or (proc/offload %git-list-tags url) nil)
                chosen (package-select-git-version tags range))
            (if (nil? chosen)
              (error "package: no git tag of "
                (get dep :name)
                " at "
                url
                " satisfies \""
                range
                "\" (tags: "
                (if (empty? tags) "none" (string/join tags ", "))
                ")")
              (assoc dep :ref (first chosen) :resolved-version (second chosen)))))))))

(defn- package-resolve-git (root raw-dep raw-locked)
  (let (locked raw-locked
        dep (package-git-concrete-ref raw-dep locked)
        name (get dep :name)
        url (get dep :url)
        ref (get dep :ref)
        target (package-git-target root name)
        commit (package-git-commit-for dep locked))
    (if (package-cache-current? target commit)
      ;; Cache hit: don't re-clone, re-hash, or rewrite meta — that would make a
      ;; plain `nest run`/`test` (which auto-resolves via ensure-deps) walk and
      ;; SHA-256 every dep file each invocation. Reuse the locked hash; only read
      ;; the dep's manifest (one small file) for its transitive deps.
      (assoc dep
        :commit commit
        :resolved-path target
        :sha256 (package-reuse-or-hash locked commit target)
        :deps (package-manifest-deps (path/join target "project.blsp")))
      ;; Cache miss: (re)clone the pinned commit, hash the tree, record the meta.
      (do
        (when (file/dir? target) (%rm-rf target))
        ;; The clone (network, possibly minutes) runs on the offload pool —
        ;; parks only this process, never a scheduler worker (ADR-144).
        (proc/offload %git-clone url target ref commit)
        (let (sha (tree-hash target))
          (package-write-pkg-meta target url ref commit sha)
          (assoc dep
            :commit commit
            :resolved-path target
            :sha256 sha
            :deps (package-manifest-deps (path/join target "project.blsp"))))))))

;; The locked sha when it's for this exact commit; otherwise hash the tree.
(defn- package-reuse-or-hash (locked commit target)
  (if (and locked (= (plist-get locked :commit) commit) (plist-get locked :sha256))
    (plist-get locked :sha256)
    (tree-hash target)))

;; --- tarball deps (ADR-037 v2) ----------------------------------------------
;; A :tarball dep names a URL and a MANDATORY :sha256 of the archive bytes — the
;; integrity pin standing in for git's commit (there is no reviewed ref to trust).
;; The archive is downloaded, its bytes verified against the declared sha256, then
;; extracted into _deps/<name>/, stripping the single wrapper directory (the standard
;; `tar czf pkg-x.y.z/` / GitHub-archive layout). A `file://` URL is read directly —
;; offline tests and local artifacts; http(s) follows a bounded number of redirects
;; (release assets 302 to a CDN). Like git, the cache's .brood-pkg.blsp stamp lets a
;; plain `nest run` skip a re-download when the locked sha still matches.

(def- *max-redirects* 5)

(defn- package-http-fetch (url redirects-left)
  (let (resp (http/fetch url)
        status (if (failure? resp) 0 (get resp :status)))
    (cond
      (failure? resp) (error "package: cannot fetch " url ": " (error-message resp))
      (and (>= status 200) (< status 300)) (get resp :body)
      (and (>= status 300) (< status 400) (> redirects-left 0))
        (let (loc (get (get resp :headers)
                    "location"))
          (if (nil? loc)
            (error "package: "
              url " returned HTTP " status " with no Location header")
            (package-http-fetch loc
              (dec redirects-left))))
      else (error "package: fetching " url " returned HTTP " status))))

(defn fetch-bytes (url)
  "The bytes at `url`: a `file://` path is read directly (offline / local artifact);
an http(s) URL is GET'd (following up to *max-redirects* redirects) and its
2xx body returned. Throws on a non-2xx status or a transport error. Shared by the
package manager and `nest release --target`'s runtime download.

    (package/fetch-bytes \"https://github.com/broodlang/brood/releases/download/v0.51.0/x.sha256\")   ;~> #b\"…\""
  (if (string/starts-with? url "file://")
    (file/slurp-bytes (string/substring url 7))
    (package-http-fetch url *max-redirects*)))

(defn- package-tarball-cache-current? (target sha)
  (let (meta (package-pkg-meta-path target))
    (and (file/dir? target)
      (file/exists? meta)
      (let (form (reflect/read-first (file/slurp meta)))
        (and (pair? form)
          (= (first form) 'brood-pkg)
          (= sha (plist-get (rest form) :sha256)))))))

(defn- package-write-tarball-meta (target url sha)
  (file/spit (package-pkg-meta-path target)
    (str ";; .brood-pkg.blsp — written by the package manager. Do not edit by hand.\n"
      (pr-str (list 'brood-pkg :tarball url :sha256 sha :fetched-at (os/now)))
      "\n")))

(defn- package-resolve-tarball (root dep)
  (let (name (get dep :name)
        url (get dep :url)
        sha (get dep :sha256)
        target (package-git-target root name))
    (if (package-tarball-cache-current? target sha)
      (assoc dep
        :resolved-path target
        :deps (package-manifest-deps (path/join target "project.blsp")))
      (do
        (when (file/dir? target) (%rm-rf target))
        (let (bytes (fetch-bytes url)
              got (hash/sha256-bytes bytes))
          (when (not (= got sha))
            (error "package: :tarball "
              name " sha256 mismatch — the manifest pins " sha " but the download hashed to " got
              " (tampered, wrong URL, or a moved artifact — verify and re-pin)"))
          (let (archive (path/join (package-deps-dir root) (str (->string name) ".tar.gz")))
            (file/mkdir (package-deps-dir root))
            (file/spit-bytes archive bytes)
            ;; Extraction (large archives) runs on the offload pool, like the clone.
            (proc/offload %untar-gz archive target 1)
            (file/rm archive)
            (package-write-tarball-meta target url sha)
            (assoc dep
              :resolved-path target
              :deps (package-manifest-deps (path/join target "project.blsp")))))))))

;; --- package registry (hive): a hosted HTTP registry ------------------------
;; The registry is a hosted service (hive) speaking a small JSON API over HTTP.
;; `:registry` is its base URL. `nest search` GETs /api/v1/packages?q=; a
;; `[name :version "x"]` dep GETs the release metadata, downloads the immutable
;; source tarball, verifies its sha256, and extracts it into _deps/<name>/ — an
;; EXACT version match, no semver solver (ADR-037's direct-refs-only invariant).
;; `nest publish` builds a source tarball and POSTs it (Bearer-token authed);
;; releases are immutable, so the server refuses a re-publish. A base URL override
;; may be passed to the registry functions (tests point it at a loopback server).

(defn- registry-trim (url)
  "`url` without a trailing slash."
  (if (string/ends-with? url "/") (string/substring url 0 (- (count url) 1)) url))

(defn- registry-base-for (index)
  "The registry base URL: `index` when given, else the configured `:registry`."
  (registry-trim (or index project/*config-registry*)))

(defn- registry-token ()
  "The publish auth token: `$HIVE_TOKEN`, else the `:registry-token` config."
  (let (env (os/env "HIVE_TOKEN"))
    (if (or (nil? env) (= env "")) project/*config-registry-token* env)))

(defn- registry-release-url (base name version)
  (str base "/api/v1/packages/" (->string name) "/releases/" version))
(defn- registry-tarball-url (base name version)
  (str (registry-release-url base name version) "/tarball"))

(defn- registry-error-text (resp)
  "The server's `:error` message from a JSON error body, or a generic HTTP line."
  ;; check-allow :discarded-catch — a body / signature / name that does not parse or verify is the negative answer
  (let (parsed (check-allow :discarded-catch
                 (try (json/decode (http/body-text resp)) (catch _ nil))))
    (if (and (map? parsed) (get parsed :error))
      (get parsed :error)
      (str "HTTP " (get resp :status)))))

(defn- registry-get-json (url)
  "GET `url` and parse its JSON body: on 2xx, the decoded JSON OBJECT (every registry
  endpoint answers one; a body that is not an object is an error like any other, not a map
  the callers then `get` from). Otherwise a `failure`: one whose fields carry the `:status`
  for an answer the registry gave (with the server's `:error` text as the message when
  present), and a plain one when the registry could not be reached."
  (let (resp (http/fetch url)
        status (if (failure? resp) 0 (get resp :status)))
    (cond
      (failure? resp) (failure "cannot reach the registry at " url ": " (error-message resp))
      (and (>= status 200) (< status 300))
      ;; a body that is not JSON at all (a proxy's HTML page, a truncated answer) is the
      ;; registry answering badly, an error like the rest — never a raise out of here
        (let (data (try (json/decode (http/body-text resp)) (catch e (failure (error-message e)))))
          (cond
            (map? data) data
            (failure? data)
              (failure/with {:status status}
                "the registry at "
                url
                " answered with no JSON: "
                (error-message data))
            else
              (failure/with {:status status}
                "the registry at " url " answered with a JSON value that is not an object")))
      else (failure/with {:status status} (registry-error-text resp)))))

(defn- registry-not-found? (answer)
  ;; whether `registry-get-json` came back with the registry's 404
  (and (failure? answer) (= (get (fields answer) :status) 404)))

;; --- the resolver's registry provider (ADR-209) ---------------------------------
;; The resolver needs, per package, its versions AND each release's deps. That is ONE
;; request: the `/releases` list carries each release's `:dependencies` (the registry-index
;; model — Cargo's index, npm's packument — so resolving N packages is N requests, not
;; N×versions). Names cross as symbols; the URL wants the string, so `(->string name)`.

;; A dependency name the REGISTRY serves becomes `_deps/<name>/` exactly like one the user
;; typed, but nobody reviewed it: a compromised registry answering `"../.."` must not get
;; that far. Refused at the boundary, naming the release that carried it.
(defn- registry-dep-name (package-name dep-name)
  (when (not (project/valid-dep-name? dep-name))
    (error "package: the registry lists a dependency of "
      (->string package-name)
      " named "
      (pr-str dep-name)
      ", which is not a plain package name — refusing it"))
  (symbol dep-name))

;; A registry-supplied external URL must be http(s). Unlike a `:tarball` MANIFEST dep (where
;; the user typed the URL and `file://` is a legitimate offline/local source), this URL comes
;; from the registry's JSON — a compromised or MITM'd (plain-http) registry must NOT be able to
;; point the client at a `file://` (or other) local resource to read + extract (the sha256 pin
;; is no defence, since the same party supplies the checksum). Every path that downloads a
;; release's `:source_url` goes through this check (ADR-211).
(defn- registry-check-source-url (name version source-url)
  (when (and (not (string/starts-with? source-url "https://"))
          (not (string/starts-with? source-url "http://")))
    (error "package: "
      (->string name)
      " "
      version
      " declares a non-http(s) source URL — refusing (a registry release's external bytes must"
      " come from http(s), got: "
      source-url
      ")")))

(defn- registry-releases-url (base name)
  (str base "/api/v1/packages/" (->string name) "/releases"))

(defn- registry-fetch-releases (base name)
  "Every published release of `name` at `base` as `[{:version V :dependencies [[dep-name
range]...]} ...]`, in ONE request. An unknown package (404) is nil (the resolver reports it
as having no versions rather than raising mid-search); any other error raises."
  (let (data (registry-get-json (registry-releases-url base name)))
    (cond
      (registry-not-found? data) nil
      (failure? data)
        (error "package: listing releases of "
          (->string name)
          " failed: "
          (error-message data))
      else
        (map (or (get data :releases) nil)
          (fn (release)
            {:version (get release :version)
             ;; the release's runtime-version constraint (ADR-209), nil/"" if the
             ;; release predates it or the registry doesn't serve it — treated as
             ;; unconstrained, so this stays backward-compatible with old releases.
             :brood (get release :brood)
             :dependencies (map (or (get release :dependencies) nil)
                             (fn (d) [(registry-dep-name name (get d :name)) (get d :version)]))})))))

;; Thin views over the one-request release list, for callers that want just one slice.
(defn- registry-list-versions (base name)
  "The published version strings of `name` (any order — the resolver sorts)."
  (map (registry-fetch-releases base name) (fn (release) (get release :version))))

(defn- registry-release-deps (base name version)
  "The `[dep-name constraint]` requirements of `name`@`version`; empty when absent."
  (get (seq/find (registry-fetch-releases base name) (fn (r) (= (get r :version) version)))
    :dependencies))

;; A registry dep names a package + a version RANGE, resolved to a concrete version by
;; the backtracking resolver (ADR-209). Resolution here fetches that concrete version:
;; reuse the cached
;; extraction when the lock's sha still stamps _deps/<name>/ (network-free), else GET
;; the release metadata for its checksum, download the tarball, verify the sha256, and
;; extract it. The lock records the version + the checksum (the integrity pin, standing
;; in for git's commit).
(defn- package-resolve-registry (root dep locked index)
  (let (name (get dep :name)
        version (get dep :version)
        target (package-git-target root name)
        locked-sha (and locked
                     (= (plist-get locked :registry) version)
                     (plist-get locked :sha256))
        ;; the pubkey TOFU-pinned by a prior install (nil if the package was unsigned then).
        locked-pubkey (and locked (plist-get locked :pubkey)))
    (if (and locked-sha (package-tarball-cache-current? target locked-sha))
      ;; cache hit: reuse the pinned sha + carry the pinned key forward into the lock.
      (registry-resolved dep target version locked-sha locked-pubkey)
      (registry-fetch-release root dep (registry-base-for index) target name version locked-pubkey))))

(defn- registry-resolved (dep target version checksum pubkey)
  "A resolved registry entry: the dep with its resolution fields assoc'd on (`:pubkey` the
TOFU-pinned signing key, nil for an unsigned package)."
  (assoc dep
    :resolved-path target
    :version version
    :sha256 checksum
    :pubkey pubkey
    :deps (package-manifest-deps (path/join target "project.blsp"))))

(defn- registry-fetch-release (root dep base target name version locked-pubkey)
  (let (meta (registry-get-json (registry-release-url base name version)))
    (cond
      (registry-not-found? meta)
        (error "package: no registry entry for "
          name
          " "
          version
          " (run `nest search "
          (->string name)
          "` to see what's published)")
      (failure? meta) (error "package: " (error-message meta))
      else
        (let (checksum (get meta :checksum))
          (when (nil? checksum)
            (error "package: registry release " name " " version " has no checksum"))
          (registry-download-extract root
            dep
            base
            target
            name
            version
            checksum
            (get meta :source_url)
            (get meta :signature)
            (get meta :pubkey)
            locked-pubkey)))))

;; The hive-hosted tarball bytes for a release (root-level layout), erroring on a non-2xx.
(defn- registry-download-hosted (base name version)
  (let (resp (http/fetch (registry-tarball-url base name version))
        status (if (failure? resp) 0 (get resp :status)))
    ;; the reason, not just the number: the transport's complaint, or the server's text
    (cond
      (failure? resp)
        (error "package: downloading " name " " version " failed: " (error-message resp))
      (not (and (>= status 200) (< status 300)))
        (error "package: downloading " name " " version " failed: " (registry-error-text resp))
      else (get resp :body))))

(defn- registry-download-extract
  (root dep
    base target name version checksum source-url signature pubkey locked-pubkey)
  (when (file/dir? target) (%rm-rf target))
  ;; A release may host its bytes EXTERNALLY — a `:source_url` (a GitHub/S3/CDN tarball),
  ;; in which case the registry holds only metadata + the checksum and the bytes are
  ;; fetched from there. An external archive follows the `tar czf pkg-x.y.z/` / GitHub
  ;; convention (one wrapper dir → strip 1); a hive-hosted tarball is root-level (strip 0).
  ;; EITHER WAY the sha256 is verified before anything is extracted — the registry is never
  ;; trusted for the bytes, so an external URL is exactly as safe as a hosted one.
  (let (external (and source-url (not (= source-url ""))))
    (when external (registry-check-source-url name version source-url))
    (let (bytes (if external
                  (fetch-bytes source-url)
                  (registry-download-hosted base name version))
          got (hash/sha256-bytes bytes))
      (when (not (= got checksum))
        (error "package: "
          name " " version " sha256 mismatch — the registry declares " checksum
          " but the download hashed to " got " (tampered or corrupted — do not trust it)"))
      ;; Signature (ADR-212): advisory TOFU check over the verified checksum. Returns the pubkey
      ;; to PIN in the lock (the pinned one wins — TOFU is sticky, first-seen).
      (let (pinned (package-verify-signature name version checksum signature pubkey locked-pubkey)
            archive (path/join (package-deps-dir root) (str (->string name) ".tar.gz")))
        (file/mkdir (package-deps-dir root))
        (file/spit-bytes archive bytes)
        ;; Extraction of a large archive runs on the offload pool, like a clone.
        (proc/offload %untar-gz archive target (if external 1 0))
        (file/rm archive)
        (registry-write-meta target base name version checksum)
        (registry-resolved dep target version checksum pinned)))))

;; Advisory signature + TOFU check (ADR-212). NEVER errors — every problem is a warning, so a
;; signing issue can't block an install (the type-checker stance). The decision is a VERDICT,
;; `{:status :pin :warning}`, so the two callers say it their own way: the lock path prints it,
;; and a runtime install (an editor's plugin) returns it for the user to see — stdout is
;; nowhere an editor's user is looking.
;;
;; `:pin` is the pubkey to keep: the already-pinned key when there is one (TOFU keeps the
;; first-seen key and only WARNS on a change — it does not silently adopt a new one), else the
;; release's key IF its signature verified (never pin a key that hasn't proven control by
;; producing a valid signature). `:status` is one of `:verified`, `:bad-signature`,
;; `:key-changed`, `:signature-dropped`, `:unsigned`.
(defn signature-verdict
  (name:any version:any checksum:any signature:any pubkey:any pinned-pubkey:any -> map)
  "The ADR-212 verdict on a release: whether its signature verifies, against the key
pinned on first use. `{:status :pin :warning}` — `:pin` the key to keep, `:warning` a sentence
for the user or nil. Never raises: every input here comes from a registry or a file.

    (get (package/signature-verdict \"p\" \"1.0.0\" \"abc\" nil nil nil) :status)   ;=> :unsigned"
  ;; `signature`/`pubkey`/`pinned-pubkey` are attacker-controlled (registry JSON / the lock), so
  ;; type-guard to STRINGS before touching hex-decode — a non-string (a JSON number/array) would
  ;; otherwise throw out of hex-decode and turn this advisory check into a hard install block. The
  ;; verify itself is wrapped in a `try` as belt-and-suspenders: nothing may escape this function.
  (let (signed (and (string? signature) (string? pubkey) (not (= signature "")) (not (= pubkey "")))
        had-pin (and (string? pinned-pubkey) (not (= pinned-pubkey "")))
        label (str (->string name) " " version)
        verified (and signed
                   ;; check-allow :discarded-catch — a body / signature / name that does not parse or verify is the negative answer
                   (check-allow :discarded-catch
                     (try
                       (crypto/verify (encoding/hex-decode-bytes pubkey)
                         (package-signing-payload (->string name) version checksum)
                         (encoding/hex-decode-bytes signature))
                       (catch _ false)))))
    (cond
      (and signed (not verified))
      ;; establish no new trust: keep the old pin (nil when there was none), so a later good
      ;; install pins it
        {:status :bad-signature
         :pin (when had-pin pinned-pubkey)
         :warning (str label
                    " carries a signature that does NOT verify against its key (possible tampering).")}
      ;; a genuine key change is only meaningful when the new signature actually verifies
      (and verified had-pin (not (= pinned-pubkey pubkey)))
        {:status :key-changed
         :pin pinned-pubkey
         :warning (str label
                    " is signed by a DIFFERENT key than the one pinned"
                    " — a legitimate key rotation, or a compromise. Delete the pin to re-pin.")}
      verified {:status :verified :pin (if had-pin pinned-pubkey pubkey) :warning nil}
      ;; unsigned now, but a prior release was signed → a dropped signature (downgrade).
      had-pin
        {:status :signature-dropped
         :pin pinned-pubkey
         :warning (str label
                    " is unsigned, but a previous release was signed (a dropped signature).")}
      ;; unsigned, never pinned — the common case in a mostly-unsigned ecosystem; stay quiet.
      else {:status :unsigned :pin nil :warning nil})))

(defn- package-verify-signature (name version checksum signature pubkey locked-pubkey)
  ;; the lock path: print the verdict's warning, return the key to pin in the lock
  (let (verdict (signature-verdict name version checksum signature pubkey locked-pubkey))
    (when (:warning verdict) (io/puts "package: WARNING — " (:warning verdict)))
    (:pin verdict)))

(defn- registry-write-meta (target base name version checksum)
  (file/spit (package-pkg-meta-path target)
    (str ";; .brood-pkg.blsp — written by the package manager. Do not edit by hand.\n"
      (pr-str (list 'brood-pkg
                :registry (->string name)
                :version version
                :sha256 checksum
                :registry-url base
                :fetched-at (os/now)))
      "\n")))

;; ---- runtime package install (the user-package model, Emacs `elpa`) ---------
;; `add`/`fetch` above install into a project's `_deps` by editing the manifest + lock. These
;; install a SINGLE package into an arbitrary directory at RUNTIME — no manifest, no lock — so
;; a running app (an editor) can let a user add/remove plugins live. The sha256 verify is
;; identical to the resolver's: the registry is never trusted for the bytes.

;; A runtime install is driven by an APP — an editor's package browser — and every way it can
;; go wrong short of a bug (the registry unreachable or erroring, the package unpublished, a
;; refused source URL, a failed download, a checksum that does not match) is an outcome its
;; user has to be TOLD, with the reason. So these three answer a `failure` carrying that
;; reason (ADR-310) rather than raising or answering nil: `registry-enhancers` said nil for
;; "the registry is down" and the editor showed an empty list (ADR-559).

(defn registry-latest-version (name)
  "The newest published version string of package `name` (a symbol or string) at the configured
registry, nil if it is unpublished, or a `failure` carrying the reason when the registry could
not be asked (unreachable, or answering an error). Backs an app's 'is there an update?' check.

    (package/registry-latest-version 'json)   ;~> \"1.4.2\", nil when unpublished, a failure when the registry is down"
  (let (base (registry-base-for nil)
        name-sym (if (symbol? name) name (symbol name)))
    (let (data (registry-get-json (registry-releases-url base name-sym)))
      (cond
        (registry-not-found? data) nil
        (failure? data)
          (failure "package: listing releases of "
            (->string name-sym)
            " failed: "
            (error-message data))
        else
          (fold (or (get data :releases) nil)
            nil
            (fn (best release)
              (let (version (get release :version))
                (if (or (nil? best) (version/newer? version best)) version best))))))))

(defn registry-enhancers (app)
  "The packages published to the configured registry that ENHANCE application `app` — a list of
`{:name :latest_version :description :kind :enhances}` maps — or a `failure` carrying the reason
when the registry could not be asked (unreachable, or answering an error). The runtime side of
`nest search --enhances`: an app lists its own installable plugins, and says why it cannot.

    (package/registry-enhancers 'bedit)   ;~> ({:name \"bedit-git\" :latest_version \"0.3.1\" :description \"…\" :kind … :enhances …} …)"
  (let (base (registry-base-for nil))
    (let (data (registry-get-json (registry-search-url base "" (->string app))))
      (if (failure? data)
        (failure "package: listing the packages that enhance "
          (->string app)
          " failed: "
          (error-message data))
        (or (get data :packages) nil)))))

;; A runtime install has no lock to pin a signing key in (ADR-212's TOFU), so the install
;; directory keeps its own: `.signing-pins.blsp`, `{name pubkey}`. Without it, the user-package
;; path — an editor's plugins — checked the bytes against a checksum from the same registry
;; response and nothing else: whoever could publish under a name could replace the plugin.

(defn- runtime-pins-path (dest-dir) (path/join dest-dir ".signing-pins.blsp"))

(defn- runtime-pins (dest-dir)
  ;; the pinned keys, `{}` when there are none or the file does not read as a map
  (let (path (runtime-pins-path dest-dir))
    (if (not (file/exists? path))
      {}
      ;; check-allow :discarded-catch — an unreadable pin file pins nothing; the next verified install rewrites it
      (let (form (check-allow :discarded-catch
                   (try (reflect/read-first (file/slurp path)) (catch _ nil))))
        (if (map? form) form {})))))

(defn- runtime-pin! (dest-dir name pubkey)
  ;; remember `pubkey` for `name`, once it is the key the verdict says to keep
  (let (pins (runtime-pins dest-dir))
    (when (and (string? pubkey) (not (= (get pins name) pubkey)))
      (file/mkdir dest-dir)
      (file/spit (runtime-pins-path dest-dir)
        (str ";; .signing-pins.blsp — package signing keys pinned on first use (ADR-212).\n"
          ";; Delete an entry to trust a package's new key.\n"
          (pr-str (assoc pins name pubkey))
          "\n")))))

(defn registry-install (name: (or keyword string symbol) dest-dir:any -> any)
  "Download, sha-VERIFY, and extract the newest release of package `name` into `dest-dir/<name>/`
at runtime — the user-package install path, independent of any project `_deps`/manifest. Returns
`{:name :version :path :checksum :signature :warning}`, or a `failure` carrying the reason
(ADR-559): a name that is not one path component, an unpublished package, the registry
unreachable or erroring, a refused source URL, a failed download, a checksum mismatch (the same
integrity guarantee `nest add` gives — the registry is never trusted for the bytes), an archive
that does not extract. A failure before extraction leaves an installed copy as it was.
The signature is checked as the lock path checks it (ADR-212, `signature-verdict`), with the key
pinned on first use in `dest-dir/.signing-pins.blsp`: `:signature` is the verdict's status and
`:warning` its sentence (nil when there is nothing to say). Advisory, like every signing check:
a bad or changed signature is reported, not refused.

    (package/registry-install \"bedit-git\" \"/home/me/.local/share/bedit/packages\")   ;~> {:name \"bedit-git\" :version \"0.3.1\" :path \"…/bedit-git\" :checksum \"…\" :signature … :warning nil}"
  (let (base (registry-base-for nil)
        name-sym (if (symbol? name) name (symbol name))
        name-str (if (string? name) name (->string name)))
    (if (not (project/valid-dep-name? name-str))
      (failure "package: "
        (pr-str name-str)
        " is not a plain package name — refusing to install it into "
        dest-dir)
      (let (version (registry-latest-version name-sym))
        (cond
          (failure? version) version
          (nil? version)
            (failure "package: "
              name-str " is not published on " base " (run `nest search " name-str
              "` to see what is)")
          else (registry-install-release base name-sym name-str version dest-dir))))))

(defn- registry-install-release (base name-sym name-str version dest-dir)
  ;; `registry-install` past the name and version: the release's metadata, its bytes, the
  ;; checksum, the extraction, the signature verdict — a failure at any step answered as one
  (let (meta (registry-get-json (registry-release-url base name-sym version)))
    (cond
      (registry-not-found? meta) (failure "package: no release " name-str " " version)
      (failure? meta)
        (failure "package: fetching the release "
          name-str
          " "
          version
          " failed: "
          (error-message meta))
      else
        (let (checksum (get meta :checksum)
              bytes (registry-install-bytes base
                      name-sym
                      name-str
                      version
                      (get meta :source_url)))
          (cond
            (failure? bytes) bytes
            (not (= (hash/sha256-bytes bytes) checksum))
              (failure "package: "
                name-str
                " "
                version
                " sha256 mismatch — declared "
                checksum
                ", got "
                (hash/sha256-bytes bytes)
                " (tampered or corrupted — not installed)")
            else (registry-install-extract name-str version checksum bytes meta dest-dir))))))

(defn- registry-install-bytes (base name-sym name-str version source-url)
  ;; The release's archive bytes — from its external `:source_url` when it has one (refused
  ;; unless http(s), ADR-211), else from the registry — or a failure saying why not. The
  ;; fetchers raise on a refused URL, an error status or a transport failure, each with a
  ;; sentence naming the package or URL; at a runtime install each of those is an outcome to
  ;; report, so that sentence becomes the failure's reason.
  (let (external (and source-url (not (= source-url ""))))
    (try
      (if external
        (do
          (registry-check-source-url name-str version source-url)
          (fetch-bytes source-url))
        (registry-download-hosted base name-sym version))
      (catch e (failure (error-message e))))))

(defn- registry-install-extract (name-str version checksum bytes meta dest-dir)
  ;; Unpack verified `bytes` into `dest-dir/<name>/`, pin the signing key, answer the result.
  ;; `file/rmdir`, not `%rm-rf`: that one deletes only inside a `_deps/`, which a runtime
  ;; install directory (an editor's plugins) is not — so a REINSTALL failed. The name was
  ;; checked as one path component, so `target` is `dest-dir/<name>` and nothing else.
  (let (source-url (get meta :source_url)
        external (and source-url (not (= source-url "")))
        target (path/join dest-dir name-str)
        archive (path/join dest-dir (str name-str ".tar.gz")))
    (when (file/dir? target) (file/rmdir target))
    (file/mkdir dest-dir)
    (file/spit-bytes archive bytes)
    (let (extracted (try
                      (do (proc/offload %untar-gz archive target (if external 1 0)) true)
                      (catch e
                        (failure "package: extracting "
                          name-str
                          " "
                          version
                          " failed: "
                          (error-message e)))))
      (file/rm archive)
      (if (failure? extracted)
        (do (when (file/dir? target) (file/rmdir target)) extracted)
        (let (verdict (signature-verdict name-str
                        version
                        checksum
                        (get meta :signature)
                        (get meta :pubkey)
                        (get (runtime-pins dest-dir) name-str)))
          (runtime-pin! dest-dir name-str (:pin verdict))
          {:name name-str
           :version version
           :path target
           :checksum checksum
           :signature (:status verdict)
           :warning (:warning verdict)})))))

;; Two resolutions of the same name must agree on their source. Different kinds can
;; never agree (checked here, since it is the one rule that is *about* the pair rather
;; than about either kind); same-kind agreement is the `dep-check-compatible` op, so each
;; kind states what "the same source" means for it.
(defn- package-conflict (dep detail)
  (error "package: conflicting dependency "
    (get dep :name)
    " "
    detail
    " — pin it explicitly in your root manifest"))

(defn- package-check-compatible (existing dep)
  (if (not (= (record-id existing) (record-id dep)))
    (package-conflict dep
      (str "required as both " (dep-kind existing) " and " (dep-kind dep)))
    (dep-check-compatible existing dep)))

;; --- namespace-collision detection (ADR-070) --------------------------------
;; Namespaces aren't package-rooted yet (a deferred upgrade — ADR-070): every
;; module lands in the one flat global table under its own (defmodule …) name. So
;; two reachable providers of the same module name — two deps, or a dep and your
;; own project — would silently clobber: `require` loads whichever `<name>.blsp`
;; is first on *load-path* and the other never loads, so code depending on the
;; loser binds the wrong module (the failure demoed in docs/packages.md). We
;; can't prevent it structurally yet, so we DETECT it at resolution time and error
;; loudly, naming both providers; the fix is to rename one.

;; Every (defmodule X) name a source file declares, in source order (symbols) — the
;; global-table namespaces it claims, which is what clobbers on collision, NOT the
;; filename. A file may open more than one module (ADR-223); each is registered so a
;; co-located secondary module is `require`able across files by its own name. Answered by
;; the project's module index (ADR-380): a file whose size and mtime match its entry is not
;; read at all, so a warm start of a large project learns its module graph without opening
;; a source file. A parse error yields `()` — the file is treated as declaring nothing and
;; the load surfaces the real error, matching `project-file-feature`'s tolerance.
(defn- package-modules-by-file (files)
  (module-index/index-files project/*root* files))

;; Every `.blsp` file at or under `dir`, recursively (full paths). A hierarchical
;; module `(defmodule gui/window)` lives at `gui/window.blsp` in a SUBdirectory
;; (that's how `%require-find` locates it), so the collision scan must recurse —
;; a top-level-only listing would never open it and two providers of the same
;; nested namespace would collide undetected (ADR-070).
(defn- package-blsp-files (dir)
  (apply append
    (map (file/ls dir)
      (fn (entry)
        (let (full (path/join dir entry))
          (cond
            (file/dir? full) (package-blsp-files full)
            (string/ends-with? entry ".blsp") (list full)
            else nil))))))

;; Every module name a source dir provides: each `(defmodule …)` of each `.blsp`
;; file in it, recursively (so nested `gui/window` and co-located secondary modules
;; are both included). Feeds collision detection (ADR-070), so it must see every
;; declared module, not just each file's first.
(defn- package-provided-modules (src-dir)
  (if (not (file/dir? src-dir))
    nil
    (let (files (package-blsp-files src-dir)
          by-file (package-modules-by-file files))
      (apply append (map files (fn (file) (get by-file file)))))))

;; `[module-symbol file-path]` for each MODULE the dir provides (recursively) —
;; every `(defmodule …)` paired with the file it lives in. Package-rooting
;; (ADR-070) needs the FILE, not just the name: a dep module `foo/b` maps to that
;; dep's `b.blsp`, and `%require-force` loads it from there under `foo`'s context. A
;; file declaring more than one module contributes one pair per module (ADR-223), so
;; a co-located secondary module is registered and thus `require`able across files.
;; PUBLIC (no `--`): the project loader (`project-root-project-rooting`) also scans
;; its own source dirs with it to root the root project's modules, a legitimate
;; cross-module use.
(defn module-files (src-dir)
  "List `[module-name file]` pairs for every module defined under `src-dir`, or
  nil if `src-dir` is not a directory.

    (package/module-files \"/path/to/proj/src\")   ;~> ((… \"/path/to/proj/src/app.blsp\") …) — [module-name file] pairs"
  (if (not (file/dir? src-dir))
    nil
    (let (files (package-blsp-files src-dir)
          by-file (package-modules-by-file files))
      (apply append
        (map files (fn (file) (map (get by-file file) (fn (m) (list m file)))))))))

;; The [label src-dir] providers to check for a *module-name* collision. Deps are
;; package-rooted (ADR-070) — a dep `foo`'s `b` is the global `foo/b` — so a dep cannot
;; collide with another dep or with your own module; the only real clash
;; is two of YOUR OWN source files declaring the same `(defmodule …)`. So only the
;; project's own source dirs are checked; `entries` is kept for signature stability.
(defn- package-collision-sources (root entries)
  (map (project/abs-paths root project/*source-paths*) (fn (d) ["your project" d])))

;; `main` is a project's ENTRY POINT, not part of its library surface: `nest run` only
;; ever uses the ROOT project's `:main`, and nothing `require`s a dependency's. So two
;; projects each having one is not a conflict — reporting it would mean no project
;; scaffolded by `nest new` could be used as a dependency (both provide `main`).
(defn- package-entry-module? (mod) (= (str mod) "main"))

;; Walk the providers, accumulating module-name -> first provider; error on the
;; first name a second provider also declares.
(defn- package-check-namespace-collisions (sources)
  (package-collision-loop sources {}))
(defn- package-collision-loop
  (sources: (or nil (list (tuple string string))) seen:map -> (or nil map))
  (if (empty? sources)
    nil
    (let (label (first (first sources))
          dir (second (first sources)))
      (package-collision-loop (rest sources)
        (fold (package-provided-modules dir)
          seen
          (fn (m mod)
            (if (and (contains? m mod) (not (package-entry-module? mod)))
              (error "package: module name collision — '"
                mod
                "' is declared by two of your own source files ("
                (get m mod)
                " and "
                label
                "); rename one module (a `(defmodule …)` name must be"
                " unique within a package)")
              (assoc m mod label))))))))

;; A dependency may not be NAMED after a standard-library module (ADR-070/166): its
;; name becomes a load-time package prefix, so a dep called `net` would provide `tcp`
;; — the baked-in module — and even a stdlib name that would not collide (`json`, `set`)
;; is a trap. Reject at resolution so a `:path`/`:git`/registry dep fails fast at
;; `nest fetch`/`add`, not only when its module is first `require`d (`reserved-package-name?`
;; is the same predicate the load-time and publish guards use).
(defn- package-guard-reserved-names (entries)
  (fold entries
    nil
    (fn (_ e)
      (when (reflect/reserved-package-name? (get e :name))
        (error "package: dependency '"
          (->string (get e :name))
          "' is named after a standard-library module — the stdlib owns the '"
          (->string (get e :name))
          "' namespace, so this dependency cannot be used until its author renames it")))))

;; A module of YOUR project that a dependency also declares. A dev run roots the two apart
;; (`myapp/web/endpoint` beside hatch's), but a release bundle keeps the root project
;; unrooted and loads a uniquely-named dependency module at ROOT as well, so both bind the
;; same globals and whichever loads last wins. mur-forge's `web/endpoint` was replaced by
;; hatch's exactly so, and the released machine did not boot, with every dev run and test
;; green. Refused here, at resolution, so `nest check`/`test`/`run` fail the way the release
;; would. `own` is the project's module names; `providers` the `[dep-name src-dir]` pairs.
(defn- package-check-dependency-shadowing (own providers)
  (fold providers
    nil
    (fn (_ provider)
      (let (clash (seq/find (package-provided-modules (second provider))
                    (fn (mod) (and (includes? own mod) (not (package-entry-module? mod))))))
        (when clash
          (error "package: module name collision — your project's '"
            clash
            "' is also a module of dependency '"
            (first provider)
            "'; a release would load one in place of the other. Rename your module"))))))

;; The guard the verbs share: reject a dep named after the stdlib, then any
;; cross-provider module-name collision, then a project module a dependency also declares.
(defn- package-guard-collisions (root entries)
  (package-guard-reserved-names entries)
  (let (sources (package-collision-sources root entries))
    (package-check-namespace-collisions sources)
    (package-check-dependency-shadowing (apply append
                                          (map sources
                                            (fn (source) (package-provided-modules (second source)))))
      (map entries (fn (entry) [(->string (get entry :name)) (package-dep-src-dir entry)])))))

;; --- the lock file -----------------------------------------------------------
;; project.lock.blsp is generated, committed, and plain Brood data so a PR diff is
;; reviewable. Each entry is a vector `[name :path PATH :sha256 HASH :deps [names…]]`;
;; :deps records the dep's own direct deps (by name) for traceability / `nest tree`.

(defn- package-dep-names-vec (deps) (apply vector (map deps :name)))

;; The lock format this build writes, and the newest it reads (ADR-673 §3: versioned,
;; refused on mismatch, never silently misread). A lock without `:version` is format 1.
;; Raise it when an entry changes shape, and keep reading every older one.
(def- *lock-format* 1)

(defn- package-lockfile-content (entries)
  ;; Sort by name so the lock is a CANONICAL, order-stable artifact. Resolution order is
  ;; NOT deterministic across runs — the registry closure (`package-resolve-registry-closure`)
  ;; yields its entries in solver/fetch order, which varies — so serializing `entries` as-is
  ;; rewrote the committed file (and churned its git diff) on every `nest fetch`/`test`/`run`,
  ;; even when the resolved set was identical. Sorting makes the same solution serialize the
  ;; same way every time; the lock is read back by name lookup, so order carries no meaning.
  (let (sorted (seq/sort-by entries (fn (e) (->string (get e :name)))))
    (str ";; project.lock.blsp — generated by `nest fetch`. Do not edit by hand.\n"
      (pr-str (list 'lock
                :version *lock-format*
                :dependencies (apply vector (map sorted dep-lock-vec))))
      "\n")))

(defn- package-lockfile-path (root) (path/join root "project.lock.blsp"))

(defn write-lockfile (root entries)
  "Write project.lock.blsp under `root` from resolved `entries` — whole or not at all: a
sibling temp file renamed over the lock, so a concurrent `nest add` resolving against it
never reads it half-written. A plain spit truncates first, and a `read-lockfile` landing in
that window failed to parse, which made the add roll its own manifest edit back — how
`manifest_race` lost an add on a CI runner (2026-09-24; reproduced with a plain spit, 1 run in
360, the add's output `parse error: unexpected end of input at package/read-lockfile`). The
temp name is random, not a timestamp: two writers sharing a name would truncate each other's
temp, and the second rename would find it gone.

    (package/write-lockfile \"/path/to/proj\" entries)   ;~> project.lock.blsp atomically replaced"
  (let (path (package-lockfile-path root)
        tmp (str path "." (uuid/v4) ".tmp"))
    (file/spit tmp (package-lockfile-content entries))
    (file/rename tmp path)))

(defn read-lockfile (root)
  "The :dependencies vector from project.lock.blsp under `root`, or nil if absent. Raises on a lock this build cannot read — a newer format, or a file that is not a `(lock …)` form — rather than treating it as absent, which would re-resolve and overwrite it.

    (package/read-lockfile \"/path/to/proj\")   ;~> [{:name json …} …] — the :dependencies of project.lock.blsp, or nil"
  (let (path (package-lockfile-path root))
    (if (not (file/exists? path))
      nil
      (let (form (reflect/read-first (file/slurp path)))
        (cond
          (nil? form) nil
          (not (and (pair? form) (= (first form) 'lock)))
            (error path
              " is not a lock file (it must hold one (lock …) form) — delete it and run `nest fetch` to write a fresh one")
          else
            (let (lock-format (or (plist-get (rest form) :version) 1))
              (when (not (and (int? lock-format) (<= 1 lock-format *lock-format*)))
                (error path
                  " is lock format "
                  (pr-str lock-format)
                  ", and this nest reads formats 1 to "
                  *lock-format*
                  " — it was written by a newer Brood; upgrade brood to use it"))
              (plist-get (rest form) :dependencies)))))))

;; Rewrite the lock only when its content actually changes — so a plain
;; `nest test`/`run` doesn't churn the file (or git) on every invocation. The rewrite is
;; `write-lockfile`'s temp-and-rename, never a plain spit: `ensure-deps` runs this under
;; `nest run`/`test`, which can overlap a `nest add` resolving against the same lock.
(defn- package-write-lockfile-if-changed (root entries)
  (let (path (package-lockfile-path root)
        new (package-lockfile-content entries)
        old (if (file/exists? path) (file/slurp path) nil))
    (when (not (= old new)) (write-lockfile root entries))))

;; --- load-path integration ---------------------------------------------------
;; A dep's source dir (its <resolved>/src by default). :path deps load here in
;; place; no copy into _deps/.
(defn- package-dep-src-dir (e) (path/join (get e :resolved-path) "src"))

;; Record each `[package-name src-dir]` provider's `(defmodule …)` names under its package
;; in `project/*ns-package*` (ADR-172 package identity). A static scan — the same `defmodule`-name
;; reads the collision check does — so it never touches the `require`/`defmodule` hot path.
(defn record-ns-packages (pkg-dir-pairs)
  "Record the modules of each `[package-name src-dir]` pair under that package name in the
  ambient `project/*ns-package*` map. The ability system's app-vs-library seam; called at setup.

    (package/record-ns-packages [[\"json\" \"/path/to/proj/_deps/json/src\"]])   ;~> the modules under that dir now owned by package json in project/*ns-package*"
  (def project/*ns-package*
    (fold pkg-dir-pairs
      project/*ns-package*
      (fn (m pair)
        (let (pkg (first pair)
              dir (second pair))
          (fold (package-provided-modules dir) m (fn (mm mod) (assoc mm mod pkg))))))))

;; Register each dependency's modules as PACKAGE-ROOTED (ADR-070): a dep `foo`
;; providing `b.blsp` (`(defmodule b)`) becomes the global namespace `foo/b`, so two
;; deps can both provide a `parser` with no collision. `%require-force` loads the file
;; under `foo`'s package context (its `%in-ns`/`(:use …)` root); the root project's own
;; modules are NOT registered here, so they stay short (the asymmetry ADR-070 records —
;; uniform root-project rooting is the recorded next step).
(defn- package-register-rooting (entries)
  (map entries
    (fn (e)
      (let (pkg (->string (get e :name))
            module-files (module-files (package-dep-src-dir e)))
        (%register-package-modules! pkg (map module-files first))
        (map module-files
          (fn (mf)
            (%register-package-module! (str pkg "/" (->string (first mf))) (second mf))))))))

(defn ensure-deps (root deps)
  "Resolve `deps`, refresh the lock file, and return the list of source dirs to add to *load-path* (one per resolved dep). Called from `setup`; a no-op when there are no deps.

    (package/ensure-deps \"/path/to/proj\" project/*dependencies*)   ;~> (\"/path/to/proj/_deps/json/src\" …) — one source dir per resolved dep"
  (if (empty? deps)
    nil
    (let (entries (resolve-deps root deps (read-lockfile root)))
      (package-guard-collisions root entries)
      ;; A dependency may NOT share your project's package name (ADR-172): package identity
      ;; keys the ability app tier on it, so a same-named dep would silently gain app-override
      ;; rights over your own types. Detect-and-reject, like the module-collision check.
      (when (and project/*name* (includes? (map entries :name) project/*name*))
        (error "package: a dependency shares your project's package name '"
          project/*name*
          "' — rename one (package identity keys the ability app tier on it, ADR-172)"))
      (package-write-lockfile-if-changed root entries)
      ;; identity: each dep's modules → the dep's `:name`.
      (record-ns-packages (map entries (fn (e) (list (get e :name) (package-dep-src-dir e)))))
      ;; package-rooting: each dep's modules → `depname/module`, loadable from its file.
      (package-register-rooting entries)
      (map entries package-dep-src-dir))))

;; --- the `nest` verbs --------------------------------------------------------
;; Read the project manifest as *data* and apply it (populating the `*project-*`
;; globals, incl. project/*dependencies*), rather than `(reflect/load)`-ing it as code:
;; the manifest's `(project …)` declaration lives in the `project` namespace now
;; (ADR-065), so loading it bare wouldn't resolve. Mirrors `project/setup`'s
;; own manifest read.
(defn- package-load-manifest (path)
  (when (file/exists? path)
    (let (form (reflect/read-first (file/slurp path)))
      (when (and (pair? form) (= (first form) 'project))
        (project/apply-config (rest form))))))

;; Locate the project root, load its manifest (so project/*dependencies* is set),
;; and hand the root to `body-fn`. Shared preamble for the verbs below.
(defn- package-in-project (body-fn)
  (let (root (project/require-root "package"))
    (package-load-manifest (path/join root "project.blsp"))
    (body-fn root)))

(defn fetch ()
  "Resolve and lock the current project's dependencies, (re)writing project.lock.blsp. Reuses the existing lock's pins where the manifest still matches (so a re-run is network-free); :git deps whose ref changed are re-resolved and (re)cloned into _deps/, :path deps are re-hashed. Returns the resolved entries (nil when none are declared). Backs `nest fetch`.

    (package/fetch)   ;~> the resolved lock entries, or nil when no deps are declared"
  (package-in-project (fn (root)
                        (if (empty? project/*dependencies*)
                          (do (io/puts "package: no dependencies declared") nil)
                          (let (entries (resolve-deps root
                                          project/*dependencies*
                                          (read-lockfile root)))
                            (package-guard-collisions root entries)
                            (write-lockfile root entries)
                            (io/puts (str "package: locked "
                                       (count entries)
                                       " dependencies in project.lock.blsp"))
                            entries)))))

(defn update (& names)
  "Re-resolve dependency refs and re-lock, ignoring the locked commits so moving refs (a branch or floating tag) advance. With no NAMES, re-resolves every dep; with NAMES, only those (others keep their locked pins). Re-clones any :git dep whose commit changed. Backs `nest update`.

    (package/update \"json\")   ;~> the re-resolved lock entries; prints \"package: updated json (3 locked)\""
  (package-in-project
    (fn (root)
      (if (empty? project/*dependencies*)
        (do (io/puts "package: no dependencies declared") nil)
        (let (lock (package-lock-without (read-lockfile root)
                     (map names symbol))
              entries (resolve-deps root project/*dependencies* lock))
          ;; Reject a namespace collision before writing the lock —
          ;; same guard `fetch`/`add` run (ADR-070). Without it,
          ;; `nest update` would write a lock for a colliding dep set
          ;; and only surface it at the next run.
          (package-guard-collisions root entries)
          (write-lockfile root entries)
          (io/puts (str "package: updated "
                     (if (empty? names) "all dependencies" (string/join names ", "))
                     " ("
                     (count entries)
                     " locked)"))
          entries)))))

;; The lock's :dependencies with `names` (symbols) dropped, so they re-resolve.
;; Empty `names` drops everything → a full update.
(defn- package-lock-without (lock names)
  (if (empty? names)
    nil
    (apply vector
      (seq/filter lock (fn (v) (not (includes? names (first v))))))))

;; --- `nest tree` -------------------------------------------------------------
(defn- package-index-by-name (entries)
  (fold entries {} (fn (m e) (assoc m (get e :name) e))))

;; Print `deps` (a list of dep records) as an indented tree, recursing into each
;; dep's resolved direct deps via `index`. `seen` breaks cycles / shared deps:
;; a name already printed is shown once more, marked, without re-descending.
(defn- package-print-tree (deps index prefix seen)
  (doseq (d deps)
    (let (name (get d :name)
          dup (includes? seen name)
          entry (get index name))
      ;; a dep's tree label is its DISPLAY form (`impl Display` per kind, in
      ;; std/tool/project.blsp beside the records), so this and `(io/puts dep)` can't drift
      (io/puts (str prefix "- " (->string d) (if dup " (already shown)" "")))
      (when (and entry (not dup) (not (empty? (get entry :deps))))
        (package-print-tree (get entry :deps) index (str prefix "  ") (cons name seen))))))

(defn tree ()
  "Print the resolved dependency tree of the current project (root → direct → transitive). Backs `nest tree`."
  (package-in-project (fn (root)
                        (io/puts (or project/*name* "(this project)"))
                        (if (empty? project/*dependencies*)
                          (io/puts "  (no dependencies)")
                          (package-print-tree project/*dependencies*
                            (package-index-by-name (resolve-deps root
                                                     project/*dependencies*
                                                     (read-lockfile root)))
                            "  "
                            nil))
                        nil)))

;; Build a CST entry node from a dep record — `[name :path "p"]` /
;; `[name :git "url" :ref "ref"]` as nested [kind payload] vectors. (String specs
;; carry no quotes, so the simple `"…"` wrapping is exact for v1.)
(defn- package-str-lit (s) (str "\"" s "\""))

;; The canonical bytes a release signature covers (ADR-212): the package NAME, VERSION, and
;; checksum bound together (newline-separated), so a valid `(signature, pubkey)` can't be lifted
;; onto a different package or version — only the exact release it was made for verifies. The
;; checksum still binds the tarball bytes (the downloader verifies bytes→checksum first), so the
;; chain is signature → (name, version, checksum) → bytes.
(defn- registry-search-url (base term enhances)
  "The search URL for `term`, narrowed to packages that ENHANCE `enhances` when that
is given (a plain application name — the registry matches it against each package's
published `:enhances` names and knows nothing else about it)."
  (str base
    "/api/v1/packages?q="
    (url/percent-encode term)
    (if (or (nil? enhances) (= enhances ""))
      ""
      (str "&enhances=" (url/percent-encode enhances)))))

(defn- package-signing-payload (name-str version checksum)
  (string/->bytes (str name-str "\n" version "\n" checksum)))
