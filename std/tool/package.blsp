;; std/package.blsp — the package manager (ADR-037, docs/packages.md). (require 'package).
;;
;; Third-party Brood deps: source pinned in the manifest's :dependencies, cached
;; per-project, locked for reproducibility. Policy is here; the kernel adds only
;; thin mechanism (`%digest`, later `%git-clone`/`%git-resolve-ref`/`%http-get`).
;;
;; Slice 1 (this file): `:path` deps end-to-end — resolve a sibling-directory dep,
;; hash its tree, write project.lock.blsp, and add its `src/` to *load-path* so
;; `(require 'dep)` finds it. `:path` deps load IN PLACE (no _deps/ copy), so edits
;; to a path-dep's tree are live. `:git` deps (the _deps/ cache + clone) land in
;; Slice 2 and error cleanly here.
;;
;; Manifest parsing (`project/project-parse-deps`) lives in std/project.blsp — the manifest
;; owner — and we reuse it both for the root manifest and for each dep's own.

(defmodule package
  "The package manager behind `nest fetch` (ADR-037). Resolves the project's
:dependencies into a flat, transitively-closed lock file and puts each dep's
source on *load-path*. Slice 1 handles `:path` (local/sibling) deps; `:git` deps
land in a later slice."
  (:use format)
  (:use project)
  ;; `project--cache-dir` is module-private (ADR-146); the manifest lock lives there
  ;; (beside the project's other derived state) rather than in the project tree.
  (:use-internals project))

; tree hashing over hash/sha256 + hash/sha256-bytes
(require 'hash)
;; --- canonical directory content hash (ADR-037 reproducibility) --------------
;; A directory's hash is Brood over the `hash/sha256` digest: walk files in
;; sorted order, and for each emit "<rel-path>\0<file-hash>\n", then hash the lot.
;; Approximates `git archive | sha256sum` without depending on git. Skips _deps/
;; and .git/ (a dep's nested cache / VCS data is not part of its content).

;; Skip _deps/ and .git/ (a dep's nested cache / VCS data isn't part of its
;; content) and .brood-pkg.blsp (the cache stamp we write *into* the dir post-clone
;; — excluding it keeps the tree hash invariant whether or not the stamp is present,
;; so a re-resolve of an unchanged commit produces the same hash).
(def *package--hash-skip* (list "_deps" ".git" ".brood-pkg.blsp"))

;; The file paths under `dir`, relative to it, sorted. Recurses into subdirs.
(defn package--tree-files (dir) (sort (package--tree-files--walk dir "")))
(defn package--tree-files--walk (dir prefix)
  (fold
    (fn (acc entry)
      (if (includes? *package--hash-skip* entry)
        acc
        (let (full (path-join dir entry)
              rel (if (= prefix "") entry (str prefix "/" entry)))
          ;; `cons`/`append-two` (share the accumulator tail) not `(append acc …)`
          ;; (recopies the growing accumulator per entry → O(files²) on a large tree).
          (if (dir? full)
            (append-two (package--tree-files--walk full rel) acc)
            (cons rel acc)))))
    nil (list-dir dir)))

;; Hash the file's raw bytes, not a UTF-8 string: `slurp` throws on a binary
;; asset (image, font, …), so the old `(hash/sha256 (slurp path))` couldn't hash a
;; tree that contained one. For a text file the hash is identical (its UTF-8
;; bytes are the file bytes), so existing lock hashes don't churn.
(defn package--sha256-file (path) (hash/sha256-bytes (slurp-bytes path)))

(defn package-tree-hash (dir)
  "The canonical SHA-256 (hex) of a directory's file contents — order-independent of the filesystem, stable across machines (ADR-037)."
  (hash/sha256 (join ""
                 (map (fn (rel) (str rel "\0" (package--sha256-file (path-join dir rel)) "\n"))
                   (package--tree-files dir)))))

;; --- reading a dependency's own manifest -------------------------------------
;; A dep declares its own deps in its project.blsp. We read (not eval) the first
;; form; if it's a `(project …)` call, pull :dependencies from its plist and
;; normalise with the manifest parser. Avoids `load`, which would clobber the
;; root project's *project-* globals.
(defn package--manifest-deps (manifest-path)
  (if (not (file-exists? manifest-path))
    nil
    (let (form (read-first (slurp manifest-path)))
      (if (and (pair? form) (= (first form) 'project))
        (project/project-parse-deps (plist-get (rest form) :dependencies))
        nil))))

;; --- resolution --------------------------------------------------------------
;; Resolve the transitive dep set into a flat list of resolved entry-maps
;; (depth-first; direct deps first, then their deps). A name required twice at
;; different sources is a loud error — the user pins it in the root manifest.

(defn resolve-deps (root deps lock)
  "Resolve `deps` (normalised dep maps from the manifest) and everything they transitively pull in, into a flat list of resolved entry-maps. `lock` is the prior project.lock.blsp :dependencies (or nil) — a matching git entry reuses its pinned commit instead of re-running `git ls-remote`; pass nil to force re-resolution (`nest update`). A root (direct) dep wins over a transitive one at a different ref (Go-style MVS-without-the-solver); two *transitive* deps at differing refs are a loud error the user pins explicitly."
  ;; `deps` is the direct (root-manifest) set; it's queued first, so every direct
  ;; dep is resolved before any transitive one (the loop appends sub-deps to the
  ;; queue's tail). That ordering is what makes "direct wins" a simple lookup.
  (package--resolve-loop root
    deps {} nil (package--lock-index lock) (map :name deps)))

(defn package--resolve-loop (root queue resolved order lock-index direct)
  (cond
    (empty? queue) (map (fn (nm) (get resolved nm)) (reverse order))
    (contains? resolved (get (first queue) :name)) (do
                                                     ;; A name already resolved: if it's a direct dep, the root's pin wins and we
                                                     ;; ignore the transitive re-request silently; otherwise the two requesters
                                                     ;; must agree on the source (else a loud, pin-it-yourself error).
                                                     (when (not (includes? direct
                                                                  (get (first queue) :name)))
                                                       (package--check-compatible (get resolved
                                                                                    (get (first queue)
                                                                                      :name))
                                                         (first queue)))
                                                     (package--resolve-loop root
                                                       (rest queue) resolved order lock-index direct))
    else (let (dep (first queue)
               nm (get dep :name)
               entry (package--resolve-one root dep lock-index))
           (package--resolve-loop root
             (append (rest queue) (get entry :deps)) (assoc resolved nm entry) (cons nm order)
             lock-index direct))))

(defn package--resolve-one (root dep lock-index)
  (cond
    (= (get dep :kind) :path) (package--resolve-path root dep)
    (= (get dep :kind) :git) (package--resolve-git root dep (get lock-index (get dep :name)))
    (= (get dep :kind) :tarball) (package--resolve-tarball root dep)
    (= (get dep :kind) :registry) (package--resolve-registry root
                                    dep (get lock-index (get dep :name)) nil)
    else (error "package: unknown dependency kind " (get dep :kind))))

;; Index a lock's :dependencies vector by dep name → its plist (the :git/:ref/
;; :commit/… key-values), for reuse during resolution. nil lock → empty index.
(defn package--lock-index (lock)
  (fold (fn (m v) (let (lst (vec->list v)) (assoc m (first lst) (rest lst))))
    {} (if (nil? lock) nil (vec->list lock))))

(defn package--resolve-path (root dep)
  (let (abs (path-join root (get dep :path)))
    (when (not (dir? abs))
      (error "package: :path dependency " (get dep :name) " not found at " abs))
    {:name (get dep :name)
     :kind :path
     :path (get dep :path)
     :resolved-path abs
     :sha256 (package-tree-hash abs)
     :deps (package--manifest-deps (path-join abs "project.blsp"))}))

;; --- git deps (ADR-037 Slice 2) ---------------------------------------------
;; A git dep is cloned into _deps/<name>/ and pinned to an exact commit. The
;; commit comes from the lock when the manifest's url+ref still match (no network);
;; otherwise `%git-resolve-ref` resolves the ref via `git ls-remote`. The clone is
;; skipped when the cache's .brood-pkg.blsp already records that commit. The dep's
;; own project.blsp is read (post-clone) for its transitive deps.

(defn package--deps-dir (root) (path-join root "_deps"))
(defn package--git-target (root nm) (path-join (package--deps-dir root) (name nm)))

;; The commit to pin: reuse the lock's when it still matches the manifest's
;; url+ref (avoids a network round-trip); otherwise resolve via ls-remote.
(defn package--git-commit-for (dep locked)
  (if (and locked
        (= (plist-get locked :git) (get dep :url)) (= (plist-get locked :ref) (get dep :ref))
        (plist-get locked :commit))
    (plist-get locked :commit)
    ;; Network-bound (git ls-remote) → the offload pool, so a fetch doesn't
    ;; pin a scheduler worker (ADR-144).
    (or (offload %git-resolve-ref (get dep :url) (get dep :ref))
      (error "package: cannot resolve git ref \""
        (get dep :ref) "\" for " (get dep :name) " at " (get dep :url)
        " (no such tag/branch/commit on the remote?)"))))

;; .brood-pkg.blsp is the cache's source of truth: a clone is current when it
;; records the same commit we want.
(defn package--pkg-meta-path (target) (path-join target ".brood-pkg.blsp"))
(defn package--cache-current? (target commit)
  (let (meta (package--pkg-meta-path target))
    (and (dir? target)
      (file-exists? meta)
      (let (form (read-first (slurp meta)))
        (and (pair? form)
          (= (first form) 'brood-pkg) (= commit (plist-get (rest form) :commit)))))))

(defn package--write-pkg-meta (target url ref commit sha)
  (spit (package--pkg-meta-path target)
    (str ";; .brood-pkg.blsp — written by the package manager. Do not edit by hand.\n"
      (pr-str (list 'brood-pkg :git url :ref ref :commit commit :sha256 sha :fetched-at (now))) "\n")))

(defn package--resolve-git (root dep locked)
  (let (nm (get dep :name)
        url (get dep :url)
        ref (get dep :ref)
        target (package--git-target root nm)
        commit (package--git-commit-for dep locked))
    (if (package--cache-current? target commit)
      ;; Cache hit: don't re-clone, re-hash, or rewrite meta — that would make a
      ;; plain `nest run`/`test` (which auto-resolves via ensure-deps) walk and
      ;; SHA-256 every dep file each invocation. Reuse the locked hash; only read
      ;; the dep's manifest (one small file) for its transitive deps.
      {:name nm
       :kind :git
       :url url
       :ref ref
       :commit commit
       :resolved-path target
       :sha256 (package--reuse-or-hash locked commit target)
       :deps (package--manifest-deps (path-join target "project.blsp"))}
      ;; Cache miss: (re)clone the pinned commit, hash the tree, record the meta.
      (do
        (when (dir? target) (%rm-rf target))
        ;; The clone (network, possibly minutes) runs on the offload pool —
        ;; parks only this process, never a scheduler worker (ADR-144).
        (offload %git-clone url target ref commit)
        (let (sha (package-tree-hash target))
          (package--write-pkg-meta target url ref commit sha)
          {:name nm
           :kind :git
           :url url
           :ref ref
           :commit commit
           :resolved-path target
           :sha256 sha
           :deps (package--manifest-deps (path-join target "project.blsp"))})))))

;; The locked sha when it's for this exact commit; otherwise hash the tree.
(defn package--reuse-or-hash (locked commit target)
  (if (and locked (= (plist-get locked :commit) commit) (plist-get locked :sha256))
    (plist-get locked :sha256)
    (package-tree-hash target)))

;; --- tarball deps (ADR-037 v2) ----------------------------------------------
;; A :tarball dep names a URL and a MANDATORY :sha256 of the archive bytes — the
;; integrity pin standing in for git's commit (there is no reviewed ref to trust).
;; The archive is downloaded, its bytes verified against the declared sha256, then
;; extracted into _deps/<name>/, stripping the single wrapper directory (the standard
;; `tar czf pkg-x.y.z/` / GitHub-archive layout). A `file://` URL is read directly —
;; offline tests and local artifacts; http(s) follows a bounded number of redirects
;; (release assets 302 to a CDN). Like git, the cache's .brood-pkg.blsp stamp lets a
;; plain `nest run` skip a re-download when the locked sha still matches.

(def *package--max-redirects* 5)

(defn package--http-fetch (url redirects-left)
  (require 'net/http)
  (let (resp (net/http/http-get url)
        status (get resp :status))
    (cond
      (and (>= status 200) (< status 300)) (get resp :body)
      (and (>= status 300) (< status 400) (> redirects-left 0)) (let (loc (get (get resp :headers)
                                                                            "location"))
                                                                  (if (nil? loc)
                                                                    (error "package: "
                                                                      url " returned HTTP " status
                                                                      " with no Location header")
                                                                    (package--http-fetch loc
                                                                      (dec redirects-left))))
      (= status 0) (error "package: cannot fetch " url ": " (get resp :error))
      else (error "package: fetching " url " returned HTTP " status))))

(defn package--fetch-bytes (url)
  "The bytes at `url`: a `file://` path is read directly (offline / local artifact);
an http(s) URL is GET'd (following up to *package--max-redirects* redirects) and its
2xx body returned. Throws on a non-2xx status or a transport error."
  (if (starts-with? url "file://")
    (slurp-bytes (substring url 7))
    (package--http-fetch url *package--max-redirects*)))

(defn package--tarball-cache-current? (target sha)
  (let (meta (package--pkg-meta-path target))
    (and (dir? target)
      (file-exists? meta)
      (let (form (read-first (slurp meta)))
        (and (pair? form)
          (= (first form) 'brood-pkg) (= sha (plist-get (rest form) :sha256)))))))

(defn package--write-tarball-meta (target url sha)
  (spit (package--pkg-meta-path target)
    (str ";; .brood-pkg.blsp — written by the package manager. Do not edit by hand.\n"
      (pr-str (list 'brood-pkg :tarball url :sha256 sha :fetched-at (now))) "\n")))

(defn package--resolve-tarball (root dep)
  (let (nm (get dep :name)
        url (get dep :url)
        sha (get dep :sha256)
        target (package--git-target root nm))
    (if (package--tarball-cache-current? target sha)
      {:name nm
       :kind :tarball
       :url url
       :sha256 sha
       :resolved-path target
       :deps (package--manifest-deps (path-join target "project.blsp"))}
      (do
        (when (dir? target) (%rm-rf target))
        (let (bytes (package--fetch-bytes url)
              got (hash/sha256-bytes bytes))
          (when (not (= got sha))
            (error "package: :tarball "
              nm " sha256 mismatch — the manifest pins " sha " but the download hashed to " got
              " (tampered, wrong URL, or a moved artifact — verify and re-pin)"))
          (let (archive (path-join (package--deps-dir root) (str (name nm) ".tar.gz")))
            (make-dir (package--deps-dir root))
            (spit-bytes archive bytes)
            ;; Extraction (large archives) runs on the offload pool, like the clone.
            (offload %untar-gz archive target 1)
            (delete-file archive)
            (package--write-tarball-meta target url sha)
            {:name nm
             :kind :tarball
             :url url
             :sha256 sha
             :resolved-path target
             :deps (package--manifest-deps (path-join target "project.blsp"))}))))))

;; --- package registry (ADR-147): a git-backed metadata index ----------------
;; The registry is just a git repo of package metadata — no hosted server, no
;; account (ADR-037's "no central infrastructure" property, kept). Layout: one file
;; per package, `packages/<name>.blsp`, holding a vector of published version entries
;; `{:version :git :ref :description}` (newest last). `nest search` greps it; `nest
;; publish` appends the current project's entry; a `[name :version "x"]` dep resolves
;; the named version to its git source and pins it — EXACT version match, no semver
;; solver (ADR-037's direct-refs-only invariant). A URL index is cloned into a
;; project-local `_deps/.registry-<hash>/` cache; a local-path index is read in place
;; (dev, self-hosted, and the offline test path).

(defn package--registry-index (index) (or index *config-registry*))
(defn registry--url? (loc) (includes? loc "://"))

;; The human-readable reason out of a caught error, whatever shape it arrived in: a
;; plain string, an error map, or the `[:error <map>]` pair an `offload`ed primitive
;; propagates. Without this the raw structure reached the user's terminal.
(defn package--error-reason (e)
  (cond
    (string? e) e
    (map? e) (or (get e :message) (pr-str e))
    (and (vector? e) (= (count e) 2) (map? (vector-ref e 1))) (or (get (vector-ref e 1) :message)
                                                                (pr-str e))
    else (pr-str e)))

;; `%git-resolve-ref` THROWS on an unreachable or nonexistent remote — it does not
;; return nil — so the `(or … (error …))` this replaces could never fire, and
;; `nest search` greeted the user with the raw `[:error {:kind :runtime, :message
;; …}]` structure plus a Brood trace. Catch it and say the one thing that helps.
(defn registry--resolve-index-head (url)
  (let (outcome (try (list :%ok (offload %git-resolve-ref url "main")) (catch e (list :%err e))))
    (if (and (= (first outcome) :%ok) (not (nil? (second outcome))))
      (second outcome)
      (error "package: cannot reach the registry index at "
        url
        " — check the :registry setting in your project or user config, and that the URL exists and is reachable"
        (if (= (first outcome) :%err)
          (str " (" (package--error-reason (second outcome)) ")")
          "")))))

(defn registry--clone-index (root url)
  (let (target (path-join (package--deps-dir root) (str ".registry-" (hash/sha256 url)))
        commit (registry--resolve-index-head url))
    (unless (package--cache-current? target commit)
      (when (dir? target) (%rm-rf target))
      (offload %git-clone url target "main" commit)
      (package--write-pkg-meta target url "main" commit ""))
    target))

(defn registry--read-dir (root index)
  "A local directory to read the index from: a local path is used in place; a URL is
cloned/updated into `_deps/.registry-<hash>/`."
  (let (loc (package--registry-index index))
    (if (registry--url? loc) (registry--clone-index root loc) loc)))

(defn registry--package-file (index-dir nm)
  (path-join (path-join index-dir "packages") (str (name nm) ".blsp")))

(defn registry--versions (index-dir nm)
  "The published version entries for `nm` (a list of maps, newest last); nil if the
package is unknown to this index."
  (let (f (registry--package-file index-dir nm))
    (if (file-exists? f)
      (let (form (read-first (slurp f))) (if (vector? form) (vec->list form) nil))
      nil)))

(defn registry--find-version (index-dir nm version)
  (find (fn (e) (= (get e :version) version)) (registry--versions index-dir nm)))

;; A registry dep names a package + an EXACT version; we look the version up in the
;; index, then delegate to git resolution (clone + pin) and re-tag the resolved entry
;; as `:registry` so the lock records the version alongside the resolved commit/sha.
(defn package--resolve-registry (root dep locked index)
  (let (nm (get dep :name)
        version (get dep :version)
        idx (registry--read-dir root index)
        entry (registry--find-version idx nm version))
    (when (nil? entry)
      (error "package: no registry entry for "
        nm " " version " (run `nest search " (name nm) "` to see what's published)"))
    (when (nil? (get entry :git))
      (error "package: registry entry " nm " " version " has no :git source"))
    (let (git-dep {:name nm :kind :git :url (get entry :git) :ref (get entry :ref)}
          resolved (package--resolve-git root git-dep locked))
      (assoc (assoc resolved :kind :registry) :version version))))

;; Two resolutions of the same name must agree on their source (kind + location).
(defn package--check-compatible (existing dep)
  (cond
    (not (= (get existing :kind) (get dep :kind))) (error "package: conflicting dependency "
                                                     (get dep :name) " required as both "
                                                     (get existing :kind) " and " (get dep :kind)
                                                     " — pin it explicitly in your root manifest")
    (= (get dep :kind) :git) (when (not (and (= (get existing :url) (get dep :url))
                                          (= (get existing :ref) (get dep :ref))))
                               (error "package: conflicting dependency "
                                 (get dep :name) " required at both " (get existing :url) " @ "
                                 (get existing :ref) " and " (get dep :url) " @ " (get dep :ref)
                                 " — pin it explicitly in your root manifest"))
    (= (get dep :kind) :tarball) (when (not (and (= (get existing :url) (get dep :url))
                                              (= (get existing :sha256) (get dep :sha256))))
                                   (error "package: conflicting dependency "
                                     (get dep :name) " required as two different tarballs ("
                                     (get existing :url) " and " (get dep :url)
                                     ") — pin it explicitly in your root manifest"))
    (= (get dep :kind) :registry) (when (not (= (get existing :version) (get dep :version)))
                                    (error "package: conflicting dependency "
                                      (get dep :name) " required at two registry versions ("
                                      (get existing :version) " and " (get dep :version)
                                      ") — pin it explicitly in your root manifest"))
    else (when (not (= (get existing :path) (get dep :path)))
           (error "package: conflicting dependency "
             (get dep :name) " required at both \"" (get existing :path) "\" and \"" (get dep :path)
             "\" — pin it explicitly in your root manifest"))))

;; --- namespace-collision detection (ADR-070) --------------------------------
;; Namespaces aren't package-rooted yet (a deferred upgrade — ADR-070): every
;; module lands in the one flat global table under its own (defmodule …) name. So
;; two reachable providers of the same module name — two deps, or a dep and your
;; own project — would silently clobber: `require` loads whichever `<name>.blsp`
;; is first on *load-path* and the other never loads, so code depending on the
;; loser binds the wrong module (the failure demoed in docs/packages.md). We
;; can't prevent it structurally yet, so we DETECT it at resolution time and error
;; loudly, naming both providers; the fix is to rename one.

;; The (defmodule X) name a source file claims (a symbol), or nil if it declares
;; none. That name — not the filename — is the global-table namespace that clobbers.
(defn package--module-name-of (file)
  (let (form (read-first (slurp file)))
    (if (and (pair? form) (= (first form) 'defmodule)) (second form) nil)))

;; The module names a source dir provides: the (defmodule …) name of each
;; top-level *.blsp file in it.
(defn package--provided-modules (src-dir)
  (if (not (dir? src-dir))
    nil
    (filter (fn (m) (not (nil? m)))
      (map (fn (f) (package--module-name-of (path-join src-dir f)))
        (filter (fn (f) (ends-with? f ".blsp")) (list-dir src-dir))))))

;; The [label src-dir] providers to check: the project's own source dirs first
;; (so a dep colliding with your own module is caught), then each resolved dep.
(defn package--collision-sources (root entries)
  (append (map (fn (d) (list "your project" d))
            (project/project-abs-paths root *project-source-paths*))
    (map (fn (e) (list (str "dependency '" (name (get e :name)) "'") (package--dep-src-dir e)))
      entries)))

;; `main` is a project's ENTRY POINT, not part of its library surface: `nest run` only
;; ever uses the ROOT project's `:main`, and nothing `require`s a dependency's. So two
;; projects each having one is not a conflict — yet it used to be reported as one, which
;; meant any project scaffolded by `nest new` could never be used as a dependency
;; (it provides `main`, and so does its consumer).
(defn package--entry-module? (mod) (= (str mod) "main"))

;; Walk the providers, accumulating module-name -> first provider; error on the
;; first name a second provider also declares.
(defn package--check-namespace-collisions (sources)
  (package--collision-loop sources {}))
(defn package--collision-loop (sources seen)
  (if (empty? sources)
    nil
    (let (label (first (first sources))
          dir (second (first sources)))
      (package--collision-loop (rest sources)
        (fold (fn (m mod)
                (if (and (contains? m mod) (not (package--entry-module? mod)))
                  (error "package: module name collision — '"
                    mod "' is provided by both " (get m mod) " and " label
                    "; rename one (namespaces aren't package-rooted yet — ADR-070)")
                  (assoc m mod label)))
          seen (package--provided-modules dir))))))

;; The guard the verbs share: reject any cross-provider module-name collision.
(defn package--guard-collisions (root entries)
  (package--check-namespace-collisions (package--collision-sources root entries)))

;; --- the lock file -----------------------------------------------------------
;; project.lock.blsp is generated, committed, and plain Brood data so a PR diff is
;; reviewable. Each entry is a vector `[name :path PATH :sha256 HASH :deps [names…]]`;
;; :deps records the dep's own direct deps (by name) for traceability / `nest tree`.

(defn package--dep-names-vec (deps) (apply vector (map :name deps)))

(defn package--entry->lock-vec (e)
  (apply vector
    (cond
      (= (get e :kind) :git) (append (list (get e :name)
                                       :git (get e :url) :ref (get e :ref) :commit (get e :commit)
                                       :sha256 (get e :sha256))
                               (list :deps (package--dep-names-vec (get e :deps))))
      (= (get e :kind) :tarball) (append (list (get e :name)
                                           :tarball (get e :url) :sha256 (get e :sha256))
                                   (list :deps (package--dep-names-vec (get e :deps))))
      (= (get e :kind) :registry) (append (list (get e :name)
                                            :registry (get e :version) :git (get e :url) :ref
                                            (get e :ref) :commit (get e :commit) :sha256
                                            (get e :sha256))
                                    (list :deps (package--dep-names-vec (get e :deps))))
      else (append (list (get e :name) :path (get e :path) :sha256 (get e :sha256))
             (list :deps (package--dep-names-vec (get e :deps)))))))

(defn package--lockfile-content (entries)
  (str ";; project.lock.blsp — generated by `nest fetch`. Do not edit by hand.\n"
    (pr-str (list 'lock
              :version 1 :dependencies (apply vector (map package--entry->lock-vec entries))))
    "\n"))

(defn package--lockfile-path (root) (path-join root "project.lock.blsp"))

(defn write-lockfile (root entries)
  "Write project.lock.blsp under `root` from resolved `entries`."
  (spit (package--lockfile-path root) (package--lockfile-content entries)))

(defn read-lockfile (root)
  "The :dependencies vector from project.lock.blsp under `root`, or nil if absent."
  (let (path (package--lockfile-path root))
    (if (not (file-exists? path))
      nil
      (let (form (read-first (slurp path)))
        (if (and (pair? form) (= (first form) 'lock))
          (plist-get (rest form) :dependencies)
          nil)))))

;; Rewrite the lock only when its content actually changes — so a plain
;; `nest test`/`run` doesn't churn the file (or git) on every invocation.
(defn package--write-lockfile-if-changed (root entries)
  (let (path (package--lockfile-path root)
        new (package--lockfile-content entries)
        old (if (file-exists? path) (slurp path) nil))
    (when (not (= old new)) (spit path new))))

;; --- load-path integration ---------------------------------------------------
;; A dep's source dir (its <resolved>/src by default). :path deps load here in
;; place; no copy into _deps/.
(defn package--dep-src-dir (e) (path-join (get e :resolved-path) "src"))

;; Record each `[package-name src-dir]` provider's `(defmodule …)` names under its package
;; in `*ns-package*` (ADR-172 package identity). A static scan — the same `defmodule`-name
;; reads the collision check does — so it never touches the `require`/`defmodule` hot path.
(defn package-record-ns-packages (pkg-dir-pairs)
  "Record the modules of each `[package-name src-dir]` pair under that package name in the
  ambient `*ns-package*` map. The ability system's app-vs-library seam; called at setup."
  (def *ns-package*
    (fold (fn (m pair)
            (let (pkg (first pair)
                  dir (second pair))
              (fold (fn (mm mod) (assoc mm mod pkg)) m (package--provided-modules dir))))
      *ns-package* pkg-dir-pairs)))

(defn ensure-deps (root deps)
  "Resolve `deps`, refresh the lock file, and return the list of source dirs to add to *load-path* (one per resolved dep). Called from `project-setup`; a no-op when there are no deps."
  (if (empty? deps)
    nil
    (let (entries (resolve-deps root deps (read-lockfile root)))
      (package--guard-collisions root entries)
      ;; A dependency may NOT share your project's package name (ADR-172): package identity
      ;; keys the ability app tier on it, so a same-named dep would silently gain app-override
      ;; rights over your own types. Detect-and-reject, like the module-collision check.
      (when (and *project-name* (includes? (map :name entries) *project-name*))
        (error "package: a dependency shares your project's package name '"
          *project-name*
          "' — rename one (package identity keys the ability app tier on it, ADR-172)"))
      (package--write-lockfile-if-changed root entries)
      ;; identity: each dep's modules → the dep's `:name`.
      (package-record-ns-packages (map (fn (e) (list (get e :name) (package--dep-src-dir e)))
                                    entries))
      (map package--dep-src-dir entries))))

;; --- the `nest` verbs --------------------------------------------------------
;; Read the project manifest as *data* and apply it (populating the `*project-*`
;; globals, incl. *project-dependencies*), rather than `(load)`-ing it as code:
;; the manifest's `(project …)` declaration lives in the `project` namespace now
;; (ADR-065), so loading it bare wouldn't resolve. Mirrors `project/project-setup`'s
;; own manifest read.
(defn package--load-manifest (path)
  (when (file-exists? path)
    (let (form (read-first (slurp path)))
      (when (and (pair? form) (= (first form) 'project))
        (project/project-apply (rest form))))))

;; Locate the project root, load its manifest (so *project-dependencies* is set),
;; and hand the root to `body-fn`. Shared preamble for the verbs below.
(defn package--in-project (body-fn)
  (let (root (project/project-find-root (cwd)))
    (when (nil? root) (error "package: not inside a Brood project (no project.blsp found)"))
    (package--load-manifest (path-join root "project.blsp"))
    (body-fn root)))

(defn fetch ()
  "Resolve and lock the current project's dependencies, (re)writing project.lock.blsp. Reuses the existing lock's pins where the manifest still matches (so a re-run is network-free); :git deps whose ref changed are re-resolved and (re)cloned into _deps/, :path deps are re-hashed. Returns the resolved entries (nil when none are declared). Backs `nest fetch`."
  (package--in-project (fn (root)
                         (if (empty? *project-dependencies*)
                           (do (println "package: no dependencies declared") nil)
                           (let (entries (resolve-deps root
                                           *project-dependencies* (read-lockfile root)))
                             (package--guard-collisions root entries)
                             (write-lockfile root entries)
                             (println (str "package: locked "
                                        (count entries) " dependencies in project.lock.blsp"))
                             entries)))))

(defn update (& names)
  "Re-resolve dependency refs and re-lock, ignoring the locked commits so moving refs (a branch or floating tag) advance. With no NAMES, re-resolves every dep; with NAMES, only those (others keep their locked pins). Re-clones any :git dep whose commit changed. Backs `nest update`."
  (package--in-project (fn (root)
                         (if (empty? *project-dependencies*)
                           (do (println "package: no dependencies declared") nil)
                           (let (lock (package--lock-without (read-lockfile root)
                                        (map symbol names))
                                 entries (resolve-deps root *project-dependencies* lock))
                             (write-lockfile root entries)
                             (println (str "package: updated "
                                        (if (empty? names) "all dependencies" (join ", " names))
                                        " (" (count entries) " locked)"))
                             entries)))))

;; The lock's :dependencies with `names` (symbols) dropped, so they re-resolve.
;; Empty `names` drops everything → a full update.
(defn package--lock-without (lock names)
  (if (empty? names)
    nil
    (apply vector
      (filter (fn (v) (not (includes? names (first (vec->list v)))))
        (if (nil? lock) nil (vec->list lock))))))

;; --- `nest tree` -------------------------------------------------------------
(defn package--index-by-name (entries)
  (fold (fn (m e) (assoc m (get e :name) e)) {} entries))

(defn package--dep-label (dep)
  (cond
    (= (get dep :kind) :path) (str (get dep :name) "  (path \"" (get dep :path) "\")")
    (= (get dep :kind) :git) (str (get dep :name) "  (git " (get dep :url) " @ " (get dep :ref) ")")
    (= (get dep :kind) :tarball) (str (get dep :name) "  (tarball " (get dep :url) ")")
    (= (get dep :kind) :registry) (str (get dep :name) "  (registry v" (get dep :version) ")")
    else (str (get dep :name))))

;; Print `deps` (a list of dep maps) as an indented tree, recursing into each
;; dep's resolved direct deps via `index`. `seen` breaks cycles / shared deps:
;; a name already printed is shown once more, marked, without re-descending.
(defn package--print-tree (deps index prefix seen)
  (dolist (d deps)
    (let (nm (get d :name)
          dup (includes? seen nm)
          entry (get index nm))
      (println (str prefix "- " (package--dep-label d) (if dup " (already shown)" "")))
      (when (and entry (not dup) (not (empty? (get entry :deps))))
        (package--print-tree (get entry :deps) index (str prefix "  ") (cons nm seen))))))

(defn tree ()
  "Print the resolved dependency tree of the current project (root → direct → transitive). Backs `nest tree`."
  (package--in-project (fn (root)
                         (println (or *project-name* "(this project)"))
                         (if (empty? *project-dependencies*)
                           (println "  (no dependencies)")
                           (package--print-tree *project-dependencies*
                             (package--index-by-name (resolve-deps root
                                                       *project-dependencies* (read-lockfile root)))
                             "  " nil))
                         nil)))

;; --- editing the manifest: `nest add` / `nest remove` -----------------------
;; These mutate project.blsp's :dependencies clause while preserving the rest of
;; the file — crucially its comments. We do it over the lossless CST (parse-source
;; + std/format.blsp): parse → splice an entry node in/out of the :dependencies
;; vector → re-render with `format/format-cst-root` (which keeps comments). The
;; manifest is reformatted in the process, which is fine for a tool-managed file.
;; The pure text transforms (`package--manifest-add`/`-remove`) take a manifest
;; string and return a new one, so they unit-test without touching the filesystem.

;; Build a CST entry node from a normalised dep map — `[name :path "p"]` /
;; `[name :git "url" :ref "ref"]` as nested [kind payload] vectors. (String specs
;; carry no quotes, so the simple `"…"` wrapping is exact for v1.)
(defn package--str-lit (s) (str "\"" s "\""))
(defn package--dep->entry-node (dep)
  (cond
    (= (get dep :kind) :path) [:vector (vector [:symbol (name (get dep :name))]
                                         [:keyword ":path"]
                                         [:str (package--str-lit (get dep :path))])]
    (= (get dep :kind) :git) [:vector (vector [:symbol (name (get dep :name))]
                                        [:keyword ":git"] [:str (package--str-lit (get dep :url))]
                                        [:keyword ":ref"] [:str (package--str-lit (get dep :ref))])]
    (= (get dep :kind) :tarball) [:vector (vector [:symbol (name (get dep :name))]
                                            [:keyword ":tarball"]
                                            [:str (package--str-lit (get dep :url))]
                                            [:keyword ":sha256"]
                                            [:str (package--str-lit (get dep :sha256))])]
    (= (get dep :kind) :registry) [:vector (vector [:symbol (name (get dep :name))]
                                             [:keyword ":version"]
                                             [:str (package--str-lit (get dep :version))])]
    else (error "package: cannot build a manifest entry for kind " (get dep :kind))))

;; Is `n` the manifest's top-level (project …) list node?
(defn package--project-list? (n)
  (and (= (node-kind n) :list)
    (let (forms (filter (fn (c) (not (trivia? c))) (vec->list (node-children n))))
      (and (not (empty? forms))
        (= (node-kind (first forms)) :symbol) (= (node-text (first forms)) "project")))))

;; The list index of the node *following* the :dependencies keyword (its value
;; vector), or nil if the manifest has no :dependencies clause.
(defn package--deps-value-index (children)
  (package--deps-value-index--scan children 0 false))
(defn package--deps-value-index--scan (children i after-kw)
  (cond
    (empty? children) nil
    after-kw (if (trivia? (first children))
               (package--deps-value-index--scan (rest children) (inc i) true)
               i)
    (and (= (node-kind (first children)) :keyword) (= (node-text (first children)) ":dependencies")) (package--deps-value-index--scan (rest children)
                                                                                                       (inc i)
                                                                                                       true)
    else (package--deps-value-index--scan (rest children) (inc i) false)))

;; Functional list update: `lst` with element `i` replaced by `(f element)`.
(defn package--list-update (lst i f) (package--list-update--acc lst i f 0 nil))
(defn package--list-update--acc (lst i f j acc)
  (if (empty? lst)
    (reverse acc)
    (package--list-update--acc (rest lst)
      i f (inc j) (cons (if (= j i) (f (first lst)) (first lst)) acc))))

;; The dep name (symbol) of an entry node `[:vector [[:symbol "name"] …]]`, or nil.
(defn package--entry-name (entry-node)
  (let (forms (filter (fn (c) (not (trivia? c))) (vec->list (node-children entry-node))))
    (if (and (not (empty? forms)) (= (node-kind (first forms)) :symbol))
      (symbol (node-text (first forms)))
      nil)))

;; Append `entry-node` to the project node's :dependencies vector, creating the
;; clause if absent. `children` is the project list's child-node list.
(defn package--children-add-dep (children entry-node)
  (let (didx (package--deps-value-index children))
    (if (nil? didx)
      (append children
        (list [:whitespace " "]
          [:keyword ":dependencies"] [:whitespace " "] [:vector (vector entry-node)]))
      (package--list-update children
        didx
        (fn (vecnode)
          [:vector (apply vector (append (vec->list (node-children vecnode)) (list entry-node)))])))))

;; Drop the entry named `nm` from the project node's :dependencies vector.
(defn package--children-remove-dep (children nm)
  (let (didx (package--deps-value-index children))
    (if (nil? didx)
      children
      (package--list-update children
        didx
        (fn (vecnode)
          [:vector (apply vector
                     (filter (fn (c)
                               (not (and (= (node-kind c) :vector) (= (package--entry-name c) nm))))
                       (vec->list (node-children vecnode))))])))))

;; Re-render `src` after applying `f` to its (project …) node. Comments survive.
(defn package--manifest-transform (src f)
  (require 'format)
  (let (kids (vec->list (node-children (parse-source src))))
    (format/format-cst-root (apply vector
                              (map (fn (n) (if (package--project-list? n) (f n) n)) kids)))))

(defn package--manifest-add (src entry-node)
  "Return manifest `src` with `entry-node` added to its :dependencies (pure)."
  (package--manifest-transform src
    (fn (proj)
      [:list (apply vector (package--children-add-dep (vec->list (node-children proj)) entry-node))])))

(defn package--manifest-remove (src nm)
  "Return manifest `src` with the dep named `nm` removed from :dependencies (pure)."
  (package--manifest-transform src
    (fn (proj)
      [:list (apply vector (package--children-remove-dep (vec->list (node-children proj)) nm))])))

;; A CLI spec token: ":path"/":git"/":ref" → keyword; anything else → the string.
(defn package--spec-token (tok)
  (if (starts-with? tok ":") (keyword (substring tok 1 (string-length tok))) tok))

(defn package--has-dep? (deps nm) (any? (fn (d) (= (get d :name) nm)) deps))

;; A dependency name is written VERBATIM into project.blsp (unquoted, as a
;; symbol), so it has to be one that reads back as itself. Without this check
;; `nest add "" :path ../x` wrote `:dependencies [[ :path "../x"]]` — a manifest
;; that no longer parses — and every later `nest` command in that project failed
;; with an internal parse error until the file was repaired by hand. Any name
;; containing a space, quote, bracket or paren did the same.
;;
;; The round-trip IS the property we need: whatever survives `read-first`
;; unchanged is safe to write back out. That also correctly rejects a numeric name
;; ("5" reads as an int, not a symbol) without a hand-maintained character list.
(defn package--valid-dep-name? (nm)
  (and (string? nm)
    (not (= nm "")) (= (try (read-first nm) (catch _ nil)) (symbol nm))))

;; --- editing project.blsp safely --------------------------------------------
;; The manifest edit is a read-modify-write: read the source, splice an entry in or
;; out (Brood code), write it back. Done with a plain `slurp`/`spit` that LOSES an
;; update under concurrency — two `nest add`s both read the original, both append,
;; the second write erases the first, and both report success. Measured before the
;; fix: three concurrent adds landed between one and three of them.
;;
;; `%file-swap` closes it: the write only lands if the file still holds exactly what
;; we read, serialised across processes by an exclusive lock, and crash-atomic. When
;; the compare fails, someone edited in between — so re-read and recompute the edit
;; against the new content rather than clobbering it. That retry is the whole reason
;; a CAS is the right shape here: the "modify" step is Brood, so it cannot run inside
;; the locked primitive.

;; The lock lives beside the project's other derived state (the check caches), NOT in
;; the project directory — no stray file appears next to the user's source, and the
;; inode is stable across manifest rewrites. `/tmp` is the fallback when there is no
;; cache dir (no HOME), so an edit is always serialised.
(defn package--manifest-lock (root)
  (require 'hash)
  (let (dir (or (project/project--cache-dir root) "/tmp"))
    (path-join dir (str "manifest-" (hash/sha256 root) ".lock"))))

;; Attempts are bounded so a pathological writer can't spin here forever; each retry
;; re-reads, so progress is real and 8 is far beyond any plausible contention.
(def *package--manifest-edit-attempts* 8)

(defn package--edit-manifest! (root transform)
  "Apply `transform` (old manifest source -> new source) to project.blsp atomically, retrying if a concurrent edit lands in between. Returns `[old new]` so the caller can roll its own edit back. Raises if it cannot win within `*package--manifest-edit-attempts*` tries."
  (package--edit-manifest--try (path-join root "project.blsp")
    (package--manifest-lock root) transform *package--manifest-edit-attempts*))

(defn package--edit-manifest--try (manifest lock transform attempts)
  (if (<= attempts 0)
    (error "package: project.blsp kept changing while this command tried to edit it — "
      "is another `nest add`/`nest remove` running? Nothing was written; re-run it.")
    (let (old (slurp manifest)
          new (transform old))
      (if (%file-swap lock manifest old new)
        [old new]
        (package--edit-manifest--try manifest lock transform (- attempts 1))))))

;; Undo an edit this command made, without stomping a concurrent one: the swap only
;; lands if the manifest still holds exactly what we wrote. If it doesn't, someone
;; else has edited since and their content wins — say so rather than overwrite it.
(defn package--revert-manifest! (root written original)
  (let (manifest (path-join root "project.blsp"))
    (if (%file-swap (package--manifest-lock root) manifest written original)
      true
      (do
        (eprintln "warning: could not undo the project.blsp edit — it changed again in the meantime; check :dependencies by hand")
        false))))

(defn add (nm & spec)
  "Add a dependency to project.blsp and re-lock. `nm` is the require-name; `spec` is `:path PATH`, `:git URL :ref REF`, or `:tarball URL :sha256 HEX` (strings). A :git/:tarball dep is fetched into _deps/ as part of the re-lock. Backs `nest add`."
  ;; Checked BEFORE anything is written, so a bad name can't leave a half-edited
  ;; manifest behind.
  (when (not (package--valid-dep-name? nm))
    (error "package: "
      (pr-str nm)
      " is not a usable dependency name — it must be a plain symbol written verbatim into project.blsp (no spaces, quotes, brackets, parens, and not a number)"))
  (package--in-project
    (fn (root)
      (let (dep (project/project-parse-dep (apply vector
                                             (cons (symbol nm)
                                               (map package--spec-token spec)))))
        (when (package--has-dep? *project-dependencies* (get dep :name))
          (error "package: " nm " is already a dependency"))
        ;; ATOMIC: the manifest edit has to happen before
        ;; resolution (resolution reads the loaded manifest), so a
        ;; failure afterwards is rolled back. Without this, `nest
        ;; add foo :path ../nonexistent` left an unresolvable dep
        ;; in project.blsp and EVERY later command failed on it —
        ;; the project needed hand-repair after one typo.
        ;; The edit is a locked compare-and-swap (see package--edit-manifest!), so a
        ;; concurrent `nest add` can no longer erase this one.
        (let (manifest (path-join root "project.blsp")
              edit (package--edit-manifest! root
                     (fn (src) (package--manifest-add src (package--dep->entry-node dep))))
              original (vector-ref edit 0)
              written (vector-ref edit 1))
          (let (outcome (try
                          (do
                            (package--load-manifest manifest)
                            (let (entries (resolve-deps root
                                            *project-dependencies* (read-lockfile root)))
                              (package--guard-collisions root entries)
                              (write-lockfile root entries))
                            :%added)
                          (catch e (list :%add-failed e))))
            (if (and (pair? outcome) (= (first outcome) :%add-failed))
              (do
                (package--revert-manifest! root written original)
                (package--load-manifest manifest)
                (throw (second outcome)))
              (println (str "package: added " nm)))))))))

(defn remove-dep (nm)
  "Remove dependency `nm` from project.blsp and re-lock (an empty lock if no deps remain). Backs `nest remove`."
  (package--in-project
    (fn (root)
      (let (name-sym (symbol nm))
        (when (not (package--has-dep? *project-dependencies* name-sym))
          (error "package: " nm " is not a dependency"))
        (let (manifest (path-join root "project.blsp")
              target (package--git-target root name-sym))
          ;; Same locked compare-and-swap as `add`: a concurrent edit must not be
          ;; erased by this removal (or vice versa).
          (package--edit-manifest! root (fn (src) (package--manifest-remove src name-sym)))
          (package--load-manifest manifest)
          ; drop its _deps/ cache, if any
          (when (dir? target) (%rm-rf target))
          (write-lockfile root (resolve-deps root *project-dependencies* (read-lockfile root)))
          (println (str "package: removed " nm)))))))

;; --- `nest search` / `nest publish` (ADR-147) -------------------------------

(defn registry--list-packages (index-dir)
  "The package names (symbols) published in `index-dir`."
  (let (dir (path-join index-dir "packages"))
    (if (dir? dir)
      (map (fn (f) (symbol (substring f 0 (- (string-length f) 5))))
        ; strip ".blsp"
        (filter (fn (f) (ends-with? f ".blsp")) (list-dir dir)))
      nil)))

(defn registry--matches? (index-dir nm term)
  (let (latest (last (registry--versions index-dir nm)))
    (or (includes? (name nm) term)
      (and latest
        (get latest :description) (includes? (get latest :description) term)))))

(defn registry--search-line (index-dir nm)
  (let (latest (last (registry--versions index-dir nm)))
    (str (name nm)
      "  " (if latest (get latest :version) "?")
      (if (and latest (get latest :description)) (str "  — " (get latest :description)) ""))))

(defn search (term & rest)
  "Search the package registry index for `term` (matched against each package's name
and latest description), printing name / latest version / description per hit. An
optional index location overrides the configured `:registry`. Backs `nest search`."
  (package--in-project (fn (root)
                         (let (index (if (empty? rest) nil (first rest))
                               dir (registry--read-dir root index)
                               hits (filter (fn (nm) (registry--matches? dir nm term))
                                      (registry--list-packages dir)))
                           (if (empty? hits)
                             (println (str "No packages matching \"" term "\"."))
                             (dolist (nm hits) (println (registry--search-line dir nm))))
                           nil))))

;; Append a version entry for package `nm-str` to the index, refusing a duplicate
;; version. Arg-driven (no project globals) so it's testable without mutating shared
;; state. Returns the package file path.
(defn registry--append-entry (index-dir nm-str version desc repo)
  (when (nil? version) (error "package: nothing to publish — the project has no :version"))
  (when (nil? repo)
    (error "package: publishing needs a :repository \"<git-url>\" in project.blsp"))
  (when (nil? desc)
    (error "package: publishing needs a :description in project.blsp"))
  (let (sym (symbol nm-str)
        existing (registry--versions index-dir sym))
    (when (find (fn (e) (= (get e :version) version)) existing)
      (error "package: "
        nm-str " " version " is already published — bump :version in project.blsp"))
    (let (entry {:version version :git repo :ref (str "v" version) :description desc}
          updated (apply vector (append existing (list entry)))
          file (registry--package-file index-dir sym))
      (make-dir (path-join index-dir "packages"))
      (spit file
        (str ";; "
          nm-str " — registry entries (managed by `nest publish`, ADR-147).\n" (pr-str updated) "\n"))
      file)))

(defn registry--publish-into (index-dir)
  (when (nil? *project-name*) (error "package: project has no :name"))
  ;; Deliberately no auto-commit: the user owns the index repo (its commit policy,
  ;; signing, review). We write the entry; they commit + push.
  (let (file (registry--append-entry index-dir
               *project-name* *project-version* *project-description* *project-repository*))
    (println (str "package: wrote " *project-name* " " *project-version* " to " file))
    (println (str "  review it, then commit and `git push` the index to share it."))
    file))

(defn publish (& rest)
  "Publish the current project's :version to the registry index — appends an entry
built from project.blsp's :name/:version/:description/:repository to the index's
`packages/<name>.blsp` and commits it (you then `git push`). The index must be a
LOCAL checkout you can push (an optional argument, else `:registry`); a URL, or a
version already published, is refused. Backs `nest publish`."
  (package--in-project (fn (root)
                         (let (loc (package--registry-index (if (empty? rest) nil (first rest))))
                           (when (registry--url? loc)
                             (error "package: `nest publish` needs a local index checkout to write + push — clone the registry and pass its path (or set :registry to it), not a URL"))
                           (registry--publish-into loc)))))
