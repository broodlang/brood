;; codemod — identifier-aware whole-token rewrites over a project's Brood sources.
;;
;; Drives `nest rename`. A plain text replace corrupts substrings (`map/get` sits inside
;; `multimap/get`, `%map-pairs` inside `%assoc-map-pairs`); this rewrites only whole Brood
;; identifiers, using the Brood identifier character set for the word boundary, so those are
;; never touched. Pure Brood over `file/slurp` / `file/spit` / `file/walk-files`.
(defmodule codemod
  "Identifier-aware whole-token rewrites over a project's Brood sources — what `nest rename`
  drives. A plain text replace corrupts substrings (`map/get` sits inside `multimap/get`);
  this rewrites only whole Brood identifiers."
  (:use file))

;; The Brood identifier boundary set — letters, digits, and the symbol chars a name may
;; contain, but NOT ":" or "/" (so `name:` and `mod/name` boundaries match), while letters
;; and `-` protect a longer identifier (`multimap-`, `%assoc-map-pairs`).
(def- *ident*
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_?!*<>=+.%&~^-")

(defn- ident-at? (text pos)
  (and (>= pos 0)
    (< pos (string/length text))
    (includes? *ident* (string/char-at text pos))))

(defn- boundary? (text pos) (not (ident-at? text pos)))

(defn- tr-loop (text:string old:any new:any olen:int from:int parts:any -> any)
  (let (i (index-of text old from))
    (if (< i 0)
      (cons (string/substring text from (string/length text)) parts)
      (if (and (boundary? text (dec i)) (boundary? text (+ i olen)))
        (tr-loop text
          old
          new
          olen
          (+ i olen)
          (cons new (cons (string/substring text from i) parts)))
        (tr-loop text
          old
          new
          olen
          (inc i)
          (cons (string/substring text from (inc i)) parts))))))

(defn token-replace (text:any old:string new:any -> string)
  "`text` with every whole-token `old` replaced by `new` (substrings left alone).

    (codemod/token-replace \"(foo x) (foo-bar y)\" \"foo\" \"baz\")  ;=> \"(baz x) (foo-bar y)\""
  (apply str (reverse (tr-loop text old new (string/length old) 0 nil))))

(defn- apply-pairs (text pairs)
  (fold pairs text (fn (t p) (token-replace t (first p) (second p)))))

(defn- rewrite-file (pairs f)
  "Rewrite `f` in place if any pair changes it; returns f when changed, else nil."
  (let (before (file/slurp f)
        after (apply-pairs before pairs))
    (if (= before after)
      nil
      (do (file/replace f after) f))))

(defn- nested-checkouts (files)
  "The directories under the current one that are checkouts of their own — a `.git` file or
directory below the top (a git worktree an agent or a tool left there, a vendored repo): their
sources are another tree's, which a rename here must not rewrite."
  (seq/distinct (seq/keep files
                  (fn (f)
                    (let (at (index-of f "/.git"))
                      (when (and (>= at 0) (not (= (string/substring f 0 at) ".")))
                        (str (string/substring f 0 at) "/")))))))

(defn- project-blsp ()
  "Every .blsp file under the current directory, skipping .git, vendored _deps and any nested
checkout ([[nested-checkouts]])."
  (let (files (walk-files ".")
        nested (nested-checkouts files))
    (seq/filter files
      (fn (f)
        (and (string/ends-with? f ".blsp")
          (not (includes? f "/.git/"))
          (not (includes? f "/_deps/"))
          (not (any? nested (fn (dir) (string/starts-with? f dir)))))))))

(defn rename (pairs)
  "Apply `[[old new] …]` token renames across the project's own .blsp sources. Prints each
  changed file and returns the count.

    (codemod/rename [[\"old-parse\" \"parse\"] [\"mk-user\" \"user/new\"]])   ;~> 3 — files changed, each one printed"
  (let (changed (seq/filter (map (project-blsp) (fn (f) (rewrite-file pairs f)))
                  (fn (f) (not (nil? f)))))
    (for (f changed) (io/puts "  changed: " f))
    (io/puts (count changed) " file(s) changed")
    (count changed)))

;; ---- CST-backed rename (context-aware) ---------------------------------------
;; `token-replace` above is boundary-aware but CONTEXT-blind: it rewrites a name
;; wherever the characters appear — inside a docstring, inside a `;` comment, inside
;; `(quote …)` data, and on a module's own `defn` head. That is how a rename wave
;; corrupts prose ("the offload pool" -> "the proc/offload pool") and clobbers the very
;; definition it should leave alone.
;;
;; `parse-source` gives a LOSSLESS CST whose leaves are typed — `:symbol` / `:str` /
;; `:comment` / `:whitespace` — and concatenating every leaf's raw text reproduces the
;; file byte-for-byte. So renaming only `:symbol` leaves is exact by construction: a
;; docstring is a `:str`, a comment is a `:comment`, and neither can be touched.
;;
;; On top of that the walk tracks two things a flat replace cannot know:
;;   - DEFINITION heads — the name in `(defn NAME …)` / `(def NAME …)` / `(defmacro …)`
;;     etc. `:refs-only` leaves them alone (renaming callers of a function whose own
;;     definition stays put — the `sse/connect` case), `:defs-only` renames just them.
;;   - QUOTED data — inside `(quote …)` / `'…`, a symbol is inert data, not a call. It is
;;     skipped unless `:in-quote` is passed (a `'name` in a registry table often DOES
;;     need renaming, so it is opt-in rather than never).

(def- *def-heads*
  ["defn"
    "defn-" "def" "def-" "defmacro" "defdyn" "defrecord" "defability" "defmodule" "defserver"
    "defbehaviour" "defalias"])

;; Node shapes `parse-source` produces (all vectors):
;;   leaf       [:symbol "foo"] [:str "\"…\""] [:comment "; …\n"] [:whitespace " "] [:int "1"]
;;   container  [:list [kid …]] [:vector […]] [:map […]] [:set […]] [:root […]]
;;   wrapper    [:quote NODE] [:quasi NODE] [:unquote NODE] — payload is ONE node
(def- *container-kinds* [:root :list :vector :map :set])
;; Reader-macro wrappers: kind -> the sigil the reader consumed (the CST keeps the kind,
;; not the text, so it must be re-emitted). A wrapper NOT listed here still round-trips —
;; `rename-node` falls back to emitting its subtree — but its sigil would be lost, so
;; `wrapper-sigil` returning nil for a payload-wrapping node is treated as a hard error
;; rather than a silent drop. That is exactly how `~@` (kind `:splice`, which an earlier
;; guess called `:unquote-splice`) silently deleted itself from 24 stdlib files.
(def- *wrapper-sigils*
  {:quote "'" :quasi "`" :unquote "~" :splice "~@" :pin "^"})

(defn- mode? (mode wanted)
  ;; whether `mode` (one keyword, or a vector of them that compose — `[:refs-only :in-quote]`)
  ;; includes `wanted`
  (if (keyword? mode) (= mode wanted) (includes? mode wanted)))

(defn- node-kind (node) (first node))
(defn- node-payload (node) (second node))

(defn- rename-kids (container kids old new mode in-quote?)
  "Rewrite a vector of sibling CST nodes, the children of a `container` node; returns the
rewritten text."
  ;; A definition head is the SECOND significant (non-whitespace, non-comment) item of a
  ;; form whose first significant item is a def-head symbol.
  (let (significant (seq/filter kids
                      (fn (k) (not (includes? [:whitespace :comment] (node-kind k)))))
        positions (significant-indices kids)
        head (first significant)
        head-name (if (and head (= (node-kind head) :symbol)) (node-payload head) nil)
        def-form? (and head-name (includes? *def-heads* head-name))
        ;; `(quote x)` in list form quotes its arguments, as the `'x` wrapper does.
        quote-form? (= head-name "quote")
        ;; Index (within `kids`, not `significant`) of the definition's NAME node — the
        ;; 2nd significant item of a def form. Positional, since CST nodes are plain
        ;; immutable vectors with no identity to compare.
        name-index (if (and def-form? (> (count significant) 1)) (nth positions 1) nil)
        quoted-kids? (or in-quote? quote-form?)
        ;; `:swap` — a two-argument CALL `(old a b)` becomes `(new b a)`: the head renamed
        ;; and the two argument nodes exchanged, the whitespace and comments between them
        ;; left where they were.
        swap? (and (mode? mode :swap)
                (= container :list)
                (not in-quote?)
                (= head-name old)
                (= (count significant) 3))
        ;; `swap?` holds exactly three significant nodes, so the defaults never apply.
        first-argument (nth positions 1 0)
        second-argument (nth positions 2 0)
        kids (if swap?
               (-> kids
                 (assoc first-argument (nth kids second-argument))
                 (assoc second-argument (nth kids first-argument)))
               kids))
    (apply str
      (map (range 0 (count kids))
        (fn (i)
          (if (and swap? (= i (first positions)))
            new
            (rename-node (nth kids i) old new mode quoted-kids? (= i name-index))))))))

(defn- significant-indices (kids)
  "The indices in `kids` of the nodes that are neither whitespace nor comments."
  (seq/filter (range 0 (count kids))
    (fn (i) (not (includes? [:whitespace :comment] (node-kind (nth kids i)))))))

;; check-allow: a CST walk is inherently non-tail — the recursion depth is the
;; source's NESTING depth (a handful of levels), not its length.
(check-allow :non-tail-recursion
  (defn- rename-node (node old new mode in-quote? is-def-name?)
    "Rewrite one CST node, returning its (possibly rewritten) source text."
    (let (kind (node-kind node)
          payload (node-payload node))
      (cond
        ;; A symbol leaf is the ONLY thing this rewrites — strings, comments, whitespace
        ;; and every other leaf pass through byte-for-byte, which is what makes a
        ;; docstring mentioning the name safe.
        ;; Under `:swap` a symbol is renamed only as the head of a call `rename-kids`
        ;; swaps; every other mention stays.
        (= kind :symbol)
          (if (and (= payload old)
                (or (not in-quote?) (mode? mode :in-quote))
                (cond
                  (mode? mode :swap) false
                  (mode? mode :defs-only) is-def-name?
                  (mode? mode :refs-only) (not is-def-name?)
                  else true))
            new
            payload)
        ;; A container's delimiters are not leaves — the CST records them in the kind, so
        ;; they have to be re-emitted around the rewritten kids to stay lossless.
        (includes? *container-kinds* kind)
          (str (open-delim kind)
            (rename-kids kind payload old new mode in-quote?)
            (close-delim kind))
        ;; Any other LEAF (string, comment, whitespace, number, keyword…): unchanged.
        ;; Checked before the wrapper case, since a leaf's payload is a string.
        (string? payload) payload
        ;; A wrapper holds ONE node. `'x`/`` `x `` quote their subtree; `~x`/`~@x` unquote
        ;; back into live code, so they leave quoted context.
        else
          (let (sigil (get *wrapper-sigils* kind))
            (if (nil? sigil)
              (error "codemod: unknown CST node kind "
                (pr-str kind)
                " — add it to *wrapper-sigils* (or *container-kinds*); emitting it blind"
                " would silently drop source text")
              (str sigil
                (rename-node payload
                  old
                  new
                  mode
                  (cond
                    (includes? [:unquote :splice] kind) false
                    (includes? [:quote :quasi] kind) true
                    else in-quote?)
                  false))))))))

(defn- open-delim (kind)
  (cond
    (= kind :list) "("
    (= kind :vector) "["
    (= kind :map) "{"
    (= kind :set) "#{"
    else ""))

(defn- close-delim (kind)
  (cond
    (= kind :list) ")"
    (= kind :vector) "]"
    (includes? [:map :set] kind) "}"
    else ""))

(defn cst-rename-text (text old new &optional mode)
  "`text` with the symbol `old` renamed to `new`, rewriting ONLY symbol tokens — never
a docstring, a `;` comment, or any other leaf. `mode` is `:all` (default — every symbol
reference and definition outside quoted data), `:refs-only` (leave the `defn`/`def` head
alone — for renaming callers when the definition stays), `:defs-only` (only the
definition head), `:in-quote` (also rewrite symbols inside `(quote …)`/`'…` data), or
`:swap` (a reversed-arguments rename: every two-argument call `(old a b)` becomes
`(new b a)`, and nothing else changes). Lossless: an unmatched file comes back
byte-identical.

    (codemod/cst-rename-text \"(foo x) ; foo\" \"foo\" \"bar\")  ;=> \"(bar x) ; foo\"
    (codemod/cst-rename-text \"(defn foo (x) (foo x))\" \"foo\" \"bar\" :refs-only)  ;=> \"(defn foo (x) (bar x))\"
    (codemod/cst-rename-text \"(old a b)\" \"old\" \"new\" :swap)  ;=> \"(new b a)\""
  (rename-kids :root (node-payload (reflect/parse-source text)) old new (or mode :all) false))

(defn cst-rename (old new &optional mode)
  "Apply `cst-rename-text` across the project's own .blsp sources — the context-aware
counterpart to `rename`. Prints each changed file and returns the count.

    (codemod/cst-rename \"old-parse\" \"parse\" :refs-only)   ;~> 3 — files changed, each one printed"
  (let (changed (seq/filter (map (project-blsp)
                              (fn (f)
                                (let (before (file/slurp f)
                                      after (cst-rename-text before old new mode))
                                  (if (= before after) nil (do (file/spit f after) f)))))
                  (fn (f) (not (nil? f)))))
    (for (f changed) (io/puts "  changed: " f))
    (io/puts (count changed) " file(s) changed")
    (count changed)))

;; ---- moving definitions between modules (`nest move`) ------------------------------
;; Splitting a large module by hand is a rename wave in disguise: every definition cut out
;; of `from` and pasted into `to` leaves `from/NAME` (and `'from/NAME` in a keymap or a
;; registry table) pointing at nothing, every file that `:use`s `from` calling a name it no
;; longer has, and the moved code calling helpers it left behind. `move-text` does the
;; moving as data over the lossless CST, and `move` applies it across the project:
;;   - each named definition leaves `from` with its `sig`, the comments above it and any
;;     `check-allow` around it, and lands at the end of `to`;
;;   - the moved code's own references come back bare, and the helpers it still needs from
;;     `from` become `from/HELPER` (made public if they were private);
;;   - what is left of `from`, and every other file — quoted data included, since a keymap
;;     binds `'from/NAME` — reaches a moved name as `to/NAME`;
;;   - a moved private name another module now reaches is made public.

(defn- significant-kids (kids)
  (seq/reject kids (fn (k) (includes? [:whitespace :comment] (node-kind k)))))

(defn- node-text (node)
  "The source text of a CST node, byte for byte."
  (map-symbols node (fn (name _) name) false))

;; check-allow: a CST walk recurses to the source's nesting depth, not its length.
(check-allow :non-tail-recursion
  (defn- map-symbols (node f quoted?)
    "The source text of `node` with every symbol token passed through `(f name quoted?)` — a
name in, a name out; `quoted?` is true when the token is quoted DATA (`'x`, `(quote x)`), where
a qualified name is a value rather than a reference and must stay qualified, and `:quasi` in a
template, which is code a macro will emit, so a name in it still calls what it names. Strings, comments
and every other leaf come back byte for byte. A `(:use …)` clause is left as it is: a name in
its `:only` list names what the module had."
    (let (kind (node-kind node)
          payload (node-payload node)
          head (when (= kind :list) (first (significant-kids payload))))
      (cond
        (= kind :symbol) (f payload quoted?)
        (and head (= (node-kind head) :keyword) (= (node-payload head) ":use"))
          (str "("
            (apply str (map payload (fn (kid) (map-symbols kid (fn (name _) name) quoted?))))
            ")")
        (includes? *container-kinds* kind)
          (let (inner (if (and head (= (node-kind head) :symbol) (= (node-payload head) "quote"))
                        true
                        quoted?))
            (str (open-delim kind)
              (apply str (map payload (fn (kid) (map-symbols kid f inner))))
              (close-delim kind)))
        (string? payload) payload
        else
          (let (sigil (get *wrapper-sigils* kind))
            (if (nil? sigil)
              (error "codemod: unknown CST node kind "
                (pr-str kind)
                " — add it to *wrapper-sigils*")
              (str sigil
                (map-symbols payload
                  f
                  (cond
                    (includes? [:unquote :splice] kind) false
                    (= kind :quote) true
                    (= kind :quasi) (or quoted? :quasi)
                    else quoted?)))))))))

(defn rewrite-symbols-text (text f)
  "`text` with every symbol token passed through `(f name quoted?)` ([[map-symbols]]):
lossless otherwise.

    (codemod/rewrite-symbols-text \"(a/x \\\"a/x\\\" 'a/x) ; a/x\" (fn (s _) (if (= s \"a/x\") \"b/x\" s)))   ;=> \"(b/x \\\"a/x\\\" 'b/x) ; a/x\""
  (map-symbols (reflect/parse-source text) f false))

(def- reference-mark "%moved-ref%")

(defn- line-starts (text)
  ;; the offset each line of `text` starts at
  (fold (string/split text "\n")
    [0]
    (fn (starts line)
      (conj starts (+ (nth starts (dec (count starts))) (string/length line) 1)))))

(defn- marked-references (text names)
  "`text` with [[reference-mark]] in front of each symbol that reads a global among `names`:
scope analysis decides, so a parameter or a pattern that shadows one is left unmarked."
  (let (starts (line-starts text)
        offsets (sort (mapcat names
                        (fn (name)
                          (map (reflect/references-in-source name text)
                            (fn (at) (+ (nth starts (dec (first at)) 0) (dec (second at))))))))
        cut (fold offsets
              [[] 0]
              (fn (acc offset)
                [(conj (first acc) (string/substring text (second acc) offset) reference-mark)
                  offset])))
    (str (apply str (first cut)) (string/substring text (second cut) (string/length text)))))

(defn- rewrite-references (text names f)
  "`text` with symbol tokens through `(f name quoted?)`, as [[rewrite-symbols-text]], but for a
bare one of `names` (strings) that a local shadows, which stays what it is."
  (let (shadowable (into #{} names)
        unmarked-from (string/length reference-mark)
        rewritten (rewrite-symbols-text (marked-references text names)
                    (fn (name quoted?)
                      (cond
                        (string/starts-with? name reference-mark)
                          (f (string/substring name unmarked-from) quoted?)
                        (contains? shadowable name) name
                        else (f name quoted?)))))
    ;; `map-symbols` leaves a `(:use …)` clause as it found it, marks included
    (string/replace rewritten reference-mark "")))

(defn- docstring-index (kids)
  "The index in `kids` of a definition's docstring, or nil: after the name in a `defmodule`,
before or after the parameters in a function, after the value otherwise. `(def route \"/x\")`
holds a value, not prose."
  (let (positions (significant-indices kids)
        head (when (not (empty? positions)) (nth kids (first positions)))
        head-name (when (and head (= (node-kind head) :symbol)) (node-payload head))
        string-at (fn (slot)
                    (when (< slot (count positions))
                      (let (index (nth positions slot))
                        (when (= (node-kind (nth kids index)) :str) index)))))
    (cond
      (nil? head-name) nil
      (= head-name "defmodule") (string-at 2)
      (includes? ["defn" "defn-" "defmacro"] head-name) (or (string-at 2) (string-at 3))
      (string/starts-with? head-name "def") (string-at 3)
      else nil)))

;; check-allow: a CST walk recurses to the source's nesting depth, not its length.
(check-allow :non-tail-recursion
  (defn- map-prose (node f)
    "The source text of `node` with each comment and docstring through `(f text)`, and
everything else byte for byte."
    (let (kind (node-kind node)
          payload (node-payload node))
      (cond
        (= kind :comment) (f payload)
        (includes? *container-kinds* kind)
          (let (doc (docstring-index payload))
            (str (open-delim kind)
              (apply str
                (map (range 0 (count payload))
                  (fn (i)
                    (if (= i doc)
                      (f (node-payload (nth payload i)))
                      (map-prose (nth payload i) f)))))
              (close-delim kind)))
        (string? payload) payload
        (get *wrapper-sigils* kind) (str (get *wrapper-sigils* kind) (map-prose payload f))
        else (node-text node)))))

(defn- lossless? (text)
  ;; does the CST hold `text` as written? `parse-source` closes what an unbalanced file left
  ;; open, so writing such a file back would add what was never there
  (= (node-text (reflect/parse-source text)) text))

(defn- defining-form (node)
  "`[head name]` of the definition a top-level form makes — `(defX NAME …)`, seen through a
`(check-allow … FORM)` wrapper — or `[\"sig\" NAME]` for a signature, either spelling, or nil."
  (when (= (node-kind node) :list)
    (let (kids (significant-kids (node-payload node))
          head (first kids)
          named (second kids))
      (when (and head (= (node-kind head) :symbol))
        (let (head-name (node-payload head))
          (cond
            (= head-name "check-allow") (defining-form (last kids))
            (and named (= (node-kind named) :symbol) (includes? ["sig" "sig!"] head-name))
              ["sig" (node-payload named)]
            (and named
              (= (node-kind named) :symbol)
              (string/starts-with? head-name "def")
              (not (= head-name "defmodule")))
              [head-name (node-payload named)]
            else nil))))))

(defn- bundled-definitions? (node)
  ;; a `(check-allow … A B)` wrapping several definitions cannot move one of them
  (let (kids (when (= (node-kind node) :list) (significant-kids (node-payload node)))
        head (when kids (first kids)))
    (and head
      (= (node-kind head) :symbol)
      (= (node-payload head) "check-allow")
      (> (count (seq/filter (rest kids) defining-form)) 1))))

(defn- top-level-names (text)
  ;; every name `text` defines at its top level
  (into #{}
    (seq/keep (node-payload (reflect/parse-source text))
      (fn (node) (let (form (defining-form node)) (when form (second form)))))))

(defn- private-head? (head) (string/ends-with? head "-"))

(defn module-name (text)
  "The module a source text declares (`(defmodule NAME …)`), or nil.

    (codemod/module-name \"(defmodule shop/cart (:use x))\")   ;=> \"shop/cart\""
  (let (found (regex/find text "\\(defmodule\\s+([^\\s()]+)"))
    (when found (:text (first (:groups found))))))

(defn- attached-comments (kids index)
  "The indices of the comment lines directly above `kids[index]` — a run of `;` lines each
starting its own line, with no blank line between them and the form."
  (letrec (walk (fn (at found)
                  (let (before (dec at))
                    (cond
                      (< before 0) found
                      (= (node-kind (nth kids before)) :comment)
                        (let (earlier (when (> before 0) (nth kids (dec before))))
                          ;; a comment that ends the line of the form above is that form's
                          (if (or (nil? earlier)
                                (= (node-kind earlier) :comment)
                                (and (= (node-kind earlier) :whitespace)
                                  (includes? (node-payload earlier) "\n")))
                            (walk before (cons before found))
                            found))
                      ;; indentation before a comment, never a line break
                      (and (= (node-kind (nth kids before)) :whitespace)
                        (not (includes? (node-payload (nth kids before)) "\n"))
                        (> before 0)
                        (= (node-kind (nth kids (dec before))) :comment))
                        (walk before found)
                      else found))))
    (walk index '())))

(defn- trailing-comment (kids index)
  "The indices of a comment that ends the line of `kids[index]` (`(defn f …) ; why`) and the
spaces before it, which go wherever the form goes."
  (let (space (nth kids (inc index) nil)
        comment (nth kids (+ index 2) nil))
    (cond
      (and space (= (node-kind space) :comment)) [(inc index)]
      (and space
        comment
        (= (node-kind space) :whitespace)
        (not (includes? (node-payload space) "\n"))
        (= (node-kind comment) :comment))
        [(inc index) (+ index 2)]
      else [])))

(defn- squeeze-blank-lines (nodes)
  "The text of `nodes`, at most one blank line between forms now some have been taken out. Only
the whitespace between them is touched: a string keeps its blank lines."
  (let (squeezed (fn (space) (regex/replace space "\n[ \t]*\n(?:[ \t]*\n)+" "\n\n"))
        joined (fold nodes
                 ["" ""]
                 (fn (acc node)
                   (if (= (node-kind node) :whitespace)
                     [(first acc) (str (second acc) (node-text node))]
                     [(str (first acc) (squeezed (second acc)) (node-text node)) ""]))))
    (str (first joined) (squeezed (second joined)))))

;; check-allow: a CST walk recurses to the source's nesting depth, not its length.
(check-allow :non-tail-recursion
  (defn- symbols-in (node)
    "Every symbol token in `node`, quoted data included, as a vector of names."
    (let (kind (node-kind node)
          payload (node-payload node))
      (cond
        (= kind :symbol) [payload]
        (includes? *container-kinds* kind) (into [] (mapcat payload symbols-in))
        (string? payload) []
        else (symbols-in payload)))))

(defn- unqualified-in (name module)
  ;; `name` without `module/` in front, or nil when it is not that module's
  (let (prefix (str module "/"))
    (when (string/starts-with? name prefix) (string/substring name (string/length prefix)))))

(defn- publicized (text names heads)
  "`text` with the definition of each of `names` whose head (in `heads`, name -> head) is
private — `defn-`, `def-` — made public: another module reaches it now."
  (fold names
    text
    (fn (acc name)
      (let (head (get heads name))
        (if (and head (private-head? head))
          (regex/replace acc
            (str "\\(" (regex/escape head) "(\\s+)" (regex/escape name) "([\\s)])")
            (str "(" (string/substring head 0 (dec (string/length head))) "$1" name "$2"))
          acc)))))

(defn- prose-follows (text from to names)
  "`text` with what its comments and docstrings say of a moved name, qualified (`\\\\[from/cmd-x]`,
a `from/NAME` in prose), following it. Whole tokens only: `shop/from/NAME` and `:from/NAME` are
other things, and a string or a keyword in the code is data."
  (let (moved (fold names {} (fn (acc name) (assoc acc (str from "/" name) (str to "/" name)))))
    (map-prose (reflect/parse-source text)
      (fn (prose)
        (regex/replace prose
          "[A-Za-z0-9_*+!?<>=%/:-]+"
          (fn (found) (or (get moved (:text found)) (:text found))))))))

(defn move-text (source destination names)
  "Move the top-level definitions of `names` (strings) from the module source `source` to the
module source `destination`, as data: `{:source :destination :moved :missing :clashing :bundled
:helpers :cycle?}` — the two texts rewritten, the names found and not found, those `destination`
already defines, those sharing a `check-allow` with another definition, and the names left in
`source` the moved code still calls (now `from/NAME`). `:cycle?` when it calls back into `source` while
`source` calls the moved code: the two modules would reach each other, which the checker cannot
order — move the helpers too. Other files are [[move-references-text]]'s.

    (:destination (codemod/move-text \"(defmodule a)\\n(defn f (x) x)\\n(defn g (x) (f x))\" \"(defmodule b)\" [\"f\"]))   ;=> \"(defmodule b)\\n\\n(defn f (x) x)\\n\""
  (let (from (module-name source)
        to (module-name destination)
        wanted (into #{} names)
        kids (node-payload (reflect/parse-source source))
        indices (range 0 (count kids))
        chosen (seq/filter indices
                 (fn (i)
                   (let (form (defining-form (nth kids i)))
                     (and form (contains? wanted (second form))))))
        taken (into #{}
                (mapcat chosen
                  (fn (i) (into (into [i] (attached-comments kids i)) (trailing-comment kids i)))))
        staying (seq/reject indices (fn (i) (contains? taken i)))
        heads-of (fn (selected)
                   (fold selected
                     {}
                     (fn (acc i)
                       (let (form (defining-form (nth kids i)))
                         (if (and form (not (= (first form) "sig")))
                           (assoc acc (second form) (first form))
                           acc)))))
        moved-heads (heads-of chosen)
        staying-heads (heads-of staying)
        moved? (fn (name) (contains? moved-heads name))
        moved-in (fn (name module)
                   (let (bare (unqualified-in name module)) (when (and bare (moved? bare)) bare)))
        rest-text (squeeze-blank-lines (map staying (fn (i) (nth kids i))))
        referenced? (fn (name text) (not (empty? (reflect/references-in-source name text))))
        ;; what is left of `source` reaches a moved name in `to`
        remaining (rewrite-references rest-text
                    (keys moved-heads)
                    (fn (name quoted?)
                      ;; a bare name in quoted data is a value of its own, left alone
                      (let (bare (or (moved-in name from)
                                   (when (and (moved? name) (not (= quoted? true))) name)))
                        (if bare (str to "/" bare) name))))
        reached-later (seq/filter (keys moved-heads)
                        (fn (name)
                          (or (referenced? name rest-text)
                            (referenced? (str from "/" name) rest-text))))
        ;; the moved code: its own names bare, the helpers it leaves behind `from/NAME`
        helper? (fn (name) (and (contains? staying-heads name) (not (moved? name))))
        moved-forms (map chosen
                      (fn (i)
                        (str (apply str
                               (map (attached-comments kids i) (fn (c) (node-text (nth kids c)))))
                          (string/trim-right (str (node-text (nth kids i))
                                               (apply str
                                                 (map (trailing-comment kids i)
                                                   (fn (c) (node-text (nth kids c))))))))))
        moved-source (string/join moved-forms "\n\n")
        helpers (sort (seq/filter (keys staying-heads)
                        (fn (name) (and (helper? name) (referenced? name moved-source)))))
        moved-text (rewrite-references moved-source
                     (keys staying-heads)
                     (fn (name quoted?)
                       (cond
                         ;; quoted, a qualified name is the value a keymap or a dispatcher holds:
                         ;; it follows the move but stays qualified
                         (and quoted? (moved-in name from)) (str to "/" (moved-in name from))
                         (= quoted? true) name
                         (moved-in name from) (moved-in name from)
                         (moved-in name to) (moved-in name to)
                         (helper? name) (str from "/" name)
                         else name))))
    {:source (prose-follows (publicized remaining helpers staying-heads) from to (keys moved-heads))
     ;; what the destination already said of a moved name (`from/NAME`) is its own name now
     :destination (str (string/trim-right (rewrite-symbols-text destination
                                            (fn (name quoted?)
                                              (cond
                                                (and quoted? (moved-in name from))
                                                  (str to "/" (moved-in name from))
                                                quoted? name
                                                else
                                                  (or (moved-in name from) (moved-in name to) name)))))
                    "\n\n"
                    (prose-follows (publicized moved-text reached-later moved-heads)
                      from
                      to
                      (keys moved-heads))
                    "\n")
     :moved (vec (seq/filter names moved?))
     :missing (vec (seq/reject names moved?))
     ;; a moved name `to` already defines would be defined twice there
     :clashing (vec (seq/filter (keys moved-heads)
                      (fn (name)
                        (any? (node-payload (reflect/parse-source destination))
                          (fn (node)
                            (let (form (defining-form node)) (and form (= (second form) name))))))))
     ;; `(check-allow … A B)` holds a definition that would move with it, unasked for
     :bundled (vec (mapcat chosen
                     (fn (i)
                       (if (bundled-definitions? (nth kids i))
                         [(second (defining-form (nth kids i)))]
                         []))))
     :helpers (vec helpers)
     :cycle? (and (not (empty? helpers)) (not (empty? reached-later)))}))

(defn move-references-text (text from to names)
  "Another file's `text` with its references to the moved `names` (strings, moved from module
`from` to `to`) pointed at `to`: every `from/NAME` and `short/NAME` under `(:alias from :as
short)` — in quoted data too — and, when the file `:use`s `from` and the name is not its own or
left out of `:only`, every bare NAME no local shadows; a moved name leaves a `(:use from :only
[…])` list. A file that reaches `from`'s internals (`:use-internals`) keeps its bare names and gains
`(:use-internals to)`, since a moved private name is still one.

    (codemod/move-references-text \"(:use a) (f 1) '(a/f)\" \"a\" \"b\" [\"f\"])   ;=> \"(:use a) (b/f 1) '(b/f)\"
    (codemod/move-references-text \"(:use a :only [f g]) (f 1)\" \"a\" \"b\" [\"f\"])   ;=> \"(:use a :only [g]) (b/f 1)\""
  (let (moved (into #{} names)
        module (regex/escape from)
        internals? (regex/find text (str "\\(:use-internals\\s+" module "[\\s)]"))
        uses-from? (regex/find text (str "\\(:use\\s+" module "[\\s)]"))
        only (regex/find text (str "\\(:use\\s+" module "\\s+:only\\s+\\[([^\\]]*)\\]"))
        listed (when only (regex/split (string/trim (:text (first (:groups only)))) "\\s+"))
        short (regex/find text (str "\\(:alias\\s+" module "\\s+:as\\s+([^\\s)]+)"))
        own (top-level-names text)
        referred (if (and uses-from? (not internals?))
                   (seq/filter names
                     (fn (name)
                       (and (not (contains? own name)) (or (nil? listed) (includes? listed name)))))
                   [])
        referred? (into #{} referred)
        qualifiers (if short [from (:text (first (:groups short)))] [from])
        rewritten (rewrite-references text
                    referred
                    (fn (name quoted?)
                      (let (bare (seq/find (map qualifiers
                                             (fn (module) (unqualified-in name module)))
                                   (fn (candidate) (contains? moved candidate))))
                        (cond
                          bare (str to "/" bare)
                          (and (contains? referred? name) (not (= quoted? true))) (str to "/" name)
                          else name))))
        ;; prose follows a qualified name too
        rewritten (prose-follows rewritten from to names)
        ;; a moved name leaves the `:only` list that named it
        trimmed (regex/replace rewritten
                  (str "(\\(:use\\s+" module "\\s+:only\\s+\\[)([^\\]]*)(\\])")
                  (fn (found)
                    (let ([open listed close] (vec (map (:groups found) (fn (group) (:text group))))
                          listed-names (regex/split (string/trim listed) "\\s+"))
                      ;; a list naming nothing moved stays as it was written
                      (if (any? listed-names (fn (name) (contains? moved name)))
                        (str open
                          (string/join (seq/reject listed-names (fn (name) (contains? moved name)))
                            " ")
                          close)
                        (:text found)))))
        reaches-moved? (any? (symbols-in (reflect/parse-source trimmed))
                         (fn (name)
                           (or (contains? moved name) (contains? moved (unqualified-in name to))))))
    (if (and internals?
          reaches-moved?
          (nil? (regex/find trimmed (str "\\(:use-internals\\s+" (regex/escape to) "[\\s)]"))))
      (regex/replace trimmed
        (str "(\\(:use-internals\\s+" module "\\))")
        (str "$1\n  (:use-internals " to ")"))
      trimmed)))

(defn missing-uses (source destination)
  "The `(:use …)` clauses of module source `source` naming a module `destination` does not
:use — what code moved from one to the other may need there.

    (codemod/missing-uses \"(defmodule a (:use x) (:use y :only [f]))\" \"(defmodule b (:use x))\")   ;=> (\"(:use y :only [f])\")"
  (seq/reject (map (regex/find-all source "\\(:use [^()]*\\)") (fn (found) (:text found)))
    (fn (clause)
      (let (module (:text (first (:groups (regex/find clause "^\\(:use\\s+([^\\s()]+)")))))
        (regex/find destination (str "\\(:use\\s+" (regex/escape module) "[\\s)]"))))))

(defn move (source-file destination-file names)
  "Move the definitions `names` from the module in `source-file` to the one in
`destination-file` ([[move-text]]) and point every other project source at their new home
([[move-references-text]]). A destination that does not exist yet is created as a module named
after its file, `:use`-ing what the source does. Everything is worked out before anything is
written, and the source goes last, so a failed write can leave a definition in two places but
never in none. Prints what changed and what needs a look; returns 0, or 1 when the move cannot
be made (nothing is written then).

    (codemod/move \"src/commands.blsp\" \"src/motion.blsp\" [\"cmd-forward-word\"])   ;~> 0"
  (let (source (file/slurp source-file)
        from (module-name source)
        new? (not (file/exists? destination-file))
        destination (if new?
                      (let (stem (path/stem destination-file)
                            uses (map (regex/find-all source "\\(:use [^()]*\\)")
                                   (fn (found) (:text found))))
                        (str "(defmodule "
                          stem
                          (apply str (map uses (fn (use) (str "\n  " use))))
                          ")\n"))
                      (file/slurp destination-file))
        to (module-name destination)
        result (when (and from to (lossless? source) (lossless? destination))
                 (move-text source destination names)))
    (cond
      (nil? result)
        (do
          (io/puts (str "nest move: "
                     source-file " and " destination-file
                     " must each parse and open with a (defmodule …)"))
          1)
      (not (empty? (:missing result)))
        (do
          (io/puts (str "nest move: not defined at the top of "
                     source-file
                     ": "
                     (string/join (:missing result) ", ")))
          1)
      (not (empty? (:clashing result)))
        (do
          (io/puts (str "nest move: "
                     destination-file
                     " already defines "
                     (string/join (:clashing result) ", ")
                     " — rename one first"))
          1)
      (not (empty? (:bundled result)))
        (do
          (io/puts (str "nest move: "
                     (string/join (:bundled result) ", ")
                     " shares a check-allow with another definition — give each its own first"))
          1)
      else
        (let (same-file? (fn (a b)
                           (= (path/normalize (path/absolute a))
                             (path/normalize (path/absolute b))))
              others (seq/filter (project-blsp)
                       (fn (f)
                         (and (not (same-file? f source-file))
                           (not (same-file? f destination-file))
                           (let (text (file/slurp f))
                             (any? (:moved result) (fn (name) (includes? text name)))))))
              unreadable (seq/reject others (fn (f) (lossless? (file/slurp f))))
              rewrites (seq/keep (seq/filter others (fn (f) (lossless? (file/slurp f))))
                         (fn (f)
                           (let (before (file/slurp f)
                                 after (move-references-text before from to (:moved result)))
                             (when (not (= before after)) [f after]))))
              changed (map rewrites first))
          (do
            (file/mkdir (path/dirname destination-file))
            (file/replace destination-file (:destination result))
            (doseq (rewrite rewrites) (file/replace (first rewrite) (second rewrite)))
            (file/replace source-file (:source result))
            (io/puts (str "moved "
                       (count (:moved result))
                       " definition(s) "
                       from
                       " -> "
                       to
                       (if new? (str " (new file " destination-file ")") "")))
            (for (f changed) (io/puts (str "  references: " f)))
            (for (f unreadable) (io/puts (str "  does not parse, not rewritten: " f)))
            ;; an existing module keeps its own imports: say which of the source's it lacks
            (when (not new?)
              (let (missing (missing-uses source destination))
                (when (not (empty? missing))
                  (io/puts (str "  "
                             to
                             " may need what "
                             from
                             " imports: "
                             (string/join missing " "))))))
            (when (not (empty? (:helpers result)))
              (io/puts (str "  "
                         to
                         " now calls back into "
                         from
                         ": "
                         (string/join (:helpers result) ", "))))
            (when (:cycle? result)
              (io/puts (str "  warning: "
                         from " and " to " now reach each other — move those helpers too")))
            0)))))
