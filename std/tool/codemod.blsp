;; codemod — identifier-aware whole-token rewrites over a project's Brood sources.
;;
;; Drives `nest rename`. A plain text replace corrupts substrings (`map/get` sits inside
;; `multimap/get`, `map-pairs` inside `assoc-map-pairs`); this rewrites only whole Brood
;; identifiers, using the Brood identifier character set for the word boundary, so those are
;; never touched. Pure Brood over `file/slurp` / `file/spit` / `file/walk-files`.
(defmodule codemod
  (:use file))

;; The Brood identifier boundary set — letters, digits, and the symbol chars a name may
;; contain, but NOT ":" or "/" (so `name:` and `mod/name` boundaries match), while letters
;; and `-` protect a longer identifier (`multimap-`, `assoc-map-pairs`).
(def- *ident*
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_?!*<>=+.%&~^-")

(defn- ident-at?
  (text pos)
  (and (>= pos 0)
    (< pos (string/length text))
    (includes? *ident* (string/char-at text pos))))

(defn- boundary? (text pos) (not (ident-at? text pos)))

(defn- tr-loop
  (text old new olen from parts)
  (let (i (index-of text old from))
    (if (< i 0)
      (cons (string/substring text from (string/length text)) parts)
      (if (and (boundary? text (dec i)) (boundary? text (+ i olen)))
        (tr-loop text
          old
          new
          olen
          (+ i olen)
          (cons new (cons (string/substring text from i) parts)))
        (tr-loop text
          old
          new
          olen
          (inc i)
          (cons (string/substring text from (inc i)) parts))))))

(defn token-replace (text old new)
  "`text` with every whole-token `old` replaced by `new` (substrings left alone)."
  (apply str (reverse (tr-loop text old new (string/length old) 0 nil))))

(defn- apply-pairs
  (text pairs)
  (fold (fn (t p) (token-replace t (first p) (second p))) text pairs))

(defn- rewrite-file
  (pairs f)
  "Rewrite `f` in place if any pair changes it; returns f when changed, else nil."
  (let (before (file/slurp f)
        after (apply-pairs before pairs))
    (if (= before after)
      nil
      (do (file/spit f after) f))))

(defn- project-blsp
  ()
  "Every .blsp file under the current directory, skipping .git and vendored _deps."
  (filter (fn (f)
            (and (string/ends-with? f ".blsp")
              (not (includes? f "/.git/"))
              (not (includes? f "/_deps/"))))
    (walk-files ".")))

(defn rename (pairs)
  "Apply `[[old new] …]` token renames across the project's own .blsp sources. Prints each
  changed file and returns the count."
  (let (changed (filter (fn (f) (not (nil? f)))
                  (map (fn (f) (rewrite-file pairs f)) (project-blsp))))
    (for (f changed) (println "  changed: " f))
    (println (count changed) " file(s) changed")
    (count changed)))

(defn rename-from-file (path)
  "Load `[old new]` pairs from a file of `OLD NEW` lines and apply them (see `rename`)."
  (rename (filter (fn (p) (= (count p) 2))
            (map (fn (l) (string/split (string/trim l) " "))
              (filter (fn (l) (not (string/blank? l))) (string/split (file/slurp path) "\n"))))))

;; ---- CST-backed rename (context-aware) ---------------------------------------
;; `token-replace` above is boundary-aware but CONTEXT-blind: it rewrites a name
;; wherever the characters appear — inside a docstring, inside a `;` comment, inside
;; `(quote …)` data, and on a module's own `defn` head. That is how a rename wave
;; corrupts prose ("the offload pool" -> "the proc/offload pool") and clobbers the very
;; definition it should leave alone.
;;
;; `parse-source` gives a LOSSLESS CST whose leaves are typed — `:symbol` / `:str` /
;; `:comment` / `:whitespace` — and concatenating every leaf's raw text reproduces the
;; file byte-for-byte. So renaming only `:symbol` leaves is exact by construction: a
;; docstring is a `:str`, a comment is a `:comment`, and neither can be touched.
;;
;; On top of that the walk tracks two things a flat replace cannot know:
;;   - DEFINITION heads — the name in `(defn NAME …)` / `(def NAME …)` / `(defmacro …)`
;;     etc. `:refs-only` leaves them alone (renaming callers of a function whose own
;;     definition stays put — the `sse/connect` case), `:defs-only` renames just them.
;;   - QUOTED data — inside `(quote …)` / `'…`, a symbol is inert data, not a call. It is
;;     skipped unless `:in-quote` is passed (a `'name` in a registry table often DOES
;;     need renaming, so it is opt-in rather than never).

(def- *def-heads*
  ["defn" "defn-" "def" "def-" "defmacro" "defdyn" "defrecord" "defability" "defmodule"
   "defprocess" "defbehaviour" "defalias"])

;; Node shapes `parse-source` produces (all vectors):
;;   leaf       [:symbol "foo"] [:str "\"…\""] [:comment "; …\n"] [:whitespace " "] [:int "1"]
;;   container  [:list [kid …]] [:vector […]] [:map […]] [:set […]] [:root […]]
;;   wrapper    [:quote NODE] [:quasi NODE] [:unquote NODE] — payload is ONE node
(def- *container-kinds* [:root :list :vector :map :set])
;; Reader-macro wrappers: kind -> the sigil the reader consumed (the CST keeps the kind,
;; not the text, so it must be re-emitted). A wrapper NOT listed here still round-trips —
;; `rename-node` falls back to emitting its subtree — but its sigil would be lost, so
;; `wrapper-sigil` returning nil for a payload-wrapping node is treated as a hard error
;; rather than a silent drop. That is exactly how `~@` (kind `:splice`, which an earlier
;; guess called `:unquote-splice`) silently deleted itself from 24 stdlib files.
(def- *wrapper-sigils*
  {:quote "'" :quasi "`" :unquote "~" :splice "~@" :pin "^"})

(defn- node-kind (node) (first node))
(defn- node-payload (node) (second node))

(defn- rename-kids
  (kids old new mode in-quote?)
  "Rewrite a vector of sibling CST nodes; returns the rewritten text."
  ;; A definition head is the SECOND significant (non-whitespace, non-comment) item of a
  ;; form whose first significant item is a def-head symbol.
  (let (significant (filter (fn (k) (not (includes? [:whitespace :comment] (node-kind k))))
                      kids)
        head (if (empty? significant) nil (first significant))
        head-name (if (and head (= (node-kind head) :symbol)) (node-payload head) nil)
        def-form? (and head-name (includes? *def-heads* head-name))
        ;; `(quote x)` in list form quotes its arguments, as the `'x` wrapper does.
        quote-form? (= head-name "quote")
        ;; Index (within `kids`, not `significant`) of the definition's NAME node — the
        ;; 2nd significant item of a def form. Positional, since CST nodes are plain
        ;; immutable vectors with no identity to compare.
        name-index (if (and def-form? (> (count significant) 1))
                     (nth (significant-indices kids) 1)
                     nil)
        quoted-kids? (or in-quote? quote-form?))
    (apply str
      (map (fn (i)
             (rename-node (nth kids i) old new mode quoted-kids? (= i name-index)))
        (range 0 (count kids))))))

(defn- significant-indices
  (kids)
  "The indices in `kids` of the nodes that are neither whitespace nor comments."
  (filter (fn (i) (not (includes? [:whitespace :comment] (node-kind (nth kids i)))))
    (range 0 (count kids))))

(defn- rename-node
  (node old new mode in-quote? is-def-name?)
  "Rewrite one CST node, returning its (possibly rewritten) source text."
  (let (kind (node-kind node)
        payload (node-payload node))
    (cond
      ;; A symbol leaf is the ONLY thing this rewrites — strings, comments, whitespace
      ;; and every other leaf pass through byte-for-byte, which is what makes a
      ;; docstring mentioning the name safe.
      (= kind :symbol)
        (if (and (= payload old)
              (or (not in-quote?) (= mode :in-quote))
              (cond
                (= mode :defs-only) is-def-name?
                (= mode :refs-only) (not is-def-name?)
                else true))
          new
          payload)
      ;; A container's delimiters are not leaves — the CST records them in the kind, so
      ;; they have to be re-emitted around the rewritten kids to stay lossless.
      (includes? *container-kinds* kind)
        (str (open-delim kind) (rename-kids payload old new mode in-quote?) (close-delim kind))
      ;; Any other LEAF (string, comment, whitespace, number, keyword…): unchanged.
      ;; Checked before the wrapper case, since a leaf's payload is a string.
      (string? payload) payload
      ;; A wrapper holds ONE node. `'x`/`` `x `` quote their subtree; `~x`/`~@x` unquote
      ;; back into live code, so they leave quoted context.
      else
        (let (sigil (get *wrapper-sigils* kind))
          (if (nil? sigil)
            (error "codemod: unknown CST node kind " (pr-str kind)
              " — add it to *wrapper-sigils* (or *container-kinds*); emitting it blind"
              " would silently drop source text")
            (str sigil
              (rename-node payload old new mode
                (cond
                  (includes? [:unquote :splice] kind) false
                  (includes? [:quote :quasi] kind) true
                  else in-quote?)
                false)))))))

(defn- open-delim
  (kind)
  (cond
    (= kind :list) "("
    (= kind :vector) "["
    (= kind :map) "{"
    (= kind :set) "#{"
    else ""))

(defn- close-delim
  (kind)
  (cond
    (= kind :list) ")"
    (= kind :vector) "]"
    (includes? [:map :set] kind) "}"
    else ""))

(defn cst-rename-text
  (text old new &optional mode)
  "`text` with the symbol `old` renamed to `new`, rewriting ONLY symbol tokens — never
a docstring, a `;` comment, or any other leaf. `mode` is `:all` (default — every symbol
reference and definition outside quoted data), `:refs-only` (leave the `defn`/`def` head
alone — for renaming callers when the definition stays), `:defs-only` (only the
definition head), or `:in-quote` (also rewrite symbols inside `(quote …)`/`'…` data).
Lossless: an unmatched file comes back byte-identical."
  (rename-kids (node-payload (parse-source text)) old new (or mode :all) false))

(defn cst-rename
  (old new &optional mode)
  "Apply `cst-rename-text` across the project's own .blsp sources — the context-aware
counterpart to `rename`. Prints each changed file and returns the count."
  (let (changed (filter (fn (f) (not (nil? f)))
                  (map (fn (f)
                         (let (before (file/slurp f)
                               after (cst-rename-text before old new mode))
                           (if (= before after) nil (do (file/spit f after) f))))
                    (project-blsp))))
    (for (f changed) (println "  changed: " f))
    (println (count changed) " file(s) changed")
    (count changed)))

;; ---- 2-arg swap (for a reversed-args rename like member? -> includes?) --------
;; `(old A B)` -> `(new B A)`, reading A and B as balanced s-expressions so nested
;; forms swap intact. Only touches real 2-arg CALL forms (head followed by whitespace,
;; exactly two args before the close); anything else is left byte-for-byte.

(defn- ws? (c) (includes? " \t\n" c))
(defn- opener? (c) (includes? "([{" c))
(defn- closer? (c) (includes? ")]}" c))

(defn- skip-ws
  (text i)
  (if (and (< i (string/length text)) (ws? (string/char-at text i)))
    (skip-ws text (inc i))
    i))

(defn- skip-str
  (text i)
  ;; i just past the opening quote; returns index after the closing quote
  (if (>= i (string/length text))
    i
    (let (c (string/char-at text i))
      (cond
        (= c "\\") (skip-str text (+ i 2))
        (= c "\"") (inc i)
        else (skip-str text (inc i))))))

(defn- scan-close
  (text i depth)
  ;; i inside a bracketed form; returns index after the matching close at depth 0
  (if (>= i (string/length text))
    i
    (let (c (string/char-at text i))
      (cond
        (= c "\"") (scan-close text (skip-str text (inc i)) depth)
        (opener? c) (scan-close text (inc i) (inc depth))
        (closer? c) (if (= depth 1) (inc i) (scan-close text (inc i) (dec depth)))
        else (scan-close text (inc i) depth)))))

(defn- atom-end
  (text i)
  (if (>= i (string/length text))
    i
    (let (c (string/char-at text i))
      (if (or (ws? c) (opener? c) (closer? c) (= c "\"") (= c ";"))
        i
        (atom-end text (inc i))))))

(defn- read-one
  (text i)
  ;; i at the start of an s-expr (non-ws); returns its end index (exclusive)
  (let (c (string/char-at text i))
    (cond
      (opener? c) (scan-close text (inc i) 1)
      (= c "\"") (skip-str text (inc i))
      else (atom-end text i))))

(defn- swap-loop
  (text old new from parts)
  (let (needle (str "(" old)
        i (index-of text needle from)
        nlen (string/length needle)
        len (string/length text))
    (if (< i 0)
      (cons (string/substring text from len) parts)
      (let (after (+ i nlen))
        (if (or (>= after len) (not (ws? (string/char-at text after))))
          (swap-loop text old new (inc i) (cons (string/substring text from (inc i)) parts))
          (let (a1s (skip-ws text after)
                a1e (read-one text a1s)
                a2s (skip-ws text a1e)
                a2e (read-one text a2s)
                closep (skip-ws text a2e))
            (if (or (>= closep len) (not (= (string/char-at text closep) ")")))
              (swap-loop text old new (inc i) (cons (string/substring text from (inc i)) parts))
              (swap-loop text
                old
                new
                (inc closep)
                (cons (str "("
                        new
                        " "
                        (string/substring text a2s a2e)
                        " "
                        (string/substring text a1s a1e)
                        ")")
                  (cons (string/substring text from i) parts))))))))))

(defn swap2 (old new)
  "Rewrite every 2-arg call `(old A B)` to `(new B A)` across the project's own .blsp
  sources, reading A/B as balanced s-expressions. For a reversed-args rename."
  (let (changed (filter (fn (f) (not (nil? f)))
                  (map (fn (f)
                         (let (before (file/slurp f)
                               after (apply str (reverse (swap-loop before old new 0 nil))))
                           (if (= before after) nil (do (file/spit f after) f))))
                    (project-blsp))))
    (for (f changed) (println "  swapped: " f))
    (println (count changed) " file(s) changed")))
