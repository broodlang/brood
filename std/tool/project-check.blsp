;; std/tool/project-check.blsp

(defmodule project-check
  "The `nest check` driver: which files to check, the per-file result cache (ADR-129),
the parallel fold over file chunks, the whole-project lints (duplicate globals, unused
module-private defns) and the two migration aids, `--fix-renames` (ADR-304) and
`--suggest-sigs`.")

(defn all-files (root)
  "Every `.blsp` file the project at `root` owns — its source files plus its test files.
The set the advisory type-checker walks for `(check)`; the sibling of [[source-files]],
which gives the source half alone. Public because the MCP `callers` tool scans the whole
project, and a `defn-` here is exactly the dead call site KI-67 found four of (this was
the fifth, and it hid inside a map literal until the checker learned to walk one)."
  (let (src-dirs (project/abs-paths root *project-source-paths*)
        test-dirs (project/abs-paths root *project-test-paths*))
    (append (fold src-dirs nil (fn (a d) (append a (project/collect-sources d))))
      (fold test-dirs nil (fn (a d) (append a (project/project-collect-tests d)))))))

;; ── KI-17 reachability: each file's transitive require-closure ────────────────
;; A file that names `mod/foo` must be able to REACH `mod`; otherwise the reference
;; resolves only by load-order luck (another file pulled `mod` in first) and breaks
;; the moment that file moves — the KI-17 bug (docs/known-issues.md). `check-file`
;; flags such a reference, but only when told which modules the file may reach. That
;; set must be the *transitive* closure of the file's own requires (a file reaches
;; `mod` if it, or a module it loads, recursively, `:use`s / references it):
;; e.g. a test that `(:use editor/treesit)` legitimately names `face/…` because
;; treesit itself requires `editor/face`. Only the whole-project driver sees every
;; header, so it builds the module→direct-deps graph (one native `%module-direct-requires`
;; parse per file) and closes it per file, then hands each file's set to `check-file`.

;; {file -> {:module name :requires [dep …]}} for every file — one native parse each.
(defn project-module-infos (files)
  "`{file -> {:module name :requires [dep …]}}` for every file in `files` — one native
`%module-direct-requires` parse each; the graph `project-require-closures` closes."
  (fold files
    {}
    (fn (acc f)
      (%map-assoc acc
        f
        (try (%module-direct-requires f) (catch e {:module nil :requires []}))))))

;; The transitive set of module names reachable from `seeds` (a list/vector of module
;; names) over `module->deps` (module-name -> [direct-dep …]). Breadth-first; a module
;; absent from the graph is treated as a leaf.
(defn- project-close-modules (seeds module->deps)
  (letrec (go (fn (frontier seen)
                (if (empty? frontier)
                  seen
                  (let (m (first frontier))
                    (if (contains? seen m)
                      (go (rest frontier) seen)
                      (go (append (rest frontier) (or (%map-get module->deps m nil) []))
                        (conj seen m)))))))
    (go seeds #{})))

;; {file -> [reachable-module-name …]} : each file's transitive require-closure
;; (including its own module), built from the whole `files` universe. Passed to
;; `check-file` as its KI-17 reachability set.
(defn project-require-closures (files)
  "`{file -> [reachable-module-name …]}`: each file's transitive require-closure (its own
module included), built from the whole `files` universe — the KI-17 reachability set
`check-file` and `nest run`'s pre-flight read."
  (let (infos (project-module-infos files)
        module->deps (fold infos
                       {}
                       (fn (m kv)
                         (let ([_f info] kv
                               name (%map-get info :module nil))
                           (if name
                             (%map-assoc m name (%map-get info :requires nil))
                             m)))))
    (fold infos
      {}
      (fn (acc kv)
        (let ([f info] kv
              own (%map-get info :module nil)
              closed (project-close-modules (%map-get info :requires nil) module->deps)
              with-own (if own (conj closed own) closed))
          ;; Sorted: the closure is stored in the verdict cache and compared with
          ;; `=` against the next run's, and set order follows symbol interning,
          ;; which differs per process — unsorted, the comparison never held and
          ;; every launch re-checked every file (2026-08-30).
          (%map-assoc acc f (vec (sort with-own))))))))

;; Pair each file with its closure (from the map) — the `[file closure]` element the
;; parallel check ops carry, so the closure rides along as DATA to each worker (never a
;; shipped closure value; see `project-pfold-run`).
(defn- project-with-closures (files closures)
  (map files (fn (f) [f (%map-get closures f nil)])))

;; (check) — advisory pre-flight: run `check-file` over every source +
;; test file in the project, printing each warning to stderr as a GNU
;; `FILE:LINE:COL: warning: …` line (editor-parseable, matches `brood --check`).
;; Returns the total warning count. Advisory only — never raises, never stops a
;; run. Called by `run-tests` and `run` before they hand off to
;; the test runner / entry-point, so users see type-misuse / arity / unbound
;; diagnostics without an extra command (`docs/types.md` — Step 4 auto-run).
;;
;; Runs *after* the project's sources are loaded (in the caller), so
;; cross-module names resolve through the heap's globals — `(check-file p)`
;; sees every prelude / std / project-source definition. File-local defns are
;; handled by `check-file`'s own per-file accumulator. The trade-off: a
;; file whose load fails never reaches the check; that error surfaces through
;; the normal eval path instead.
;; Internal: walk a list of files with `check-file`, print each warning to
;; stderr (GNU FILE:LINE:COL format), return the total count. Honors the
;; `BROOD_NO_CHECK=1` opt-out — the same flag the `brood` CLI respects, so
;; callers' "exit non-zero on warning" gating gets 0 (no print) under it.
;; ── bounded parallel fan-out over a file list ────────────────────────────────
;; `check-file` and the CST parse passes below are embarrassingly parallel: each
;; only READS the shared globals / parses text — all sources are loaded first, in
;; the caller (`project-ensure-loaded`), and none of these passes `def`s — so N
;; worker processes can each handle a slice of the files against the *same* shared
;; image with no races (the cross-process global visibility that backs hot reload,
;; docs/shared-code.md). The single-threaded folds these drivers replaced left all
;; but one core idle, so `nest check` on a large project was wall-clock-bound on a
;; single core (a 100K-file project: ~17s in `check-files` + ~17s in the
;; unused-private parse pass, all serial).
;;
;; `project-pfold-files` slices `files` into a SMALL number of big chunks —
;; `cores * *check-oversample*` of them — and runs the chunks across the pool.
;;
;; Why few big chunks and not many small ones: `check-file`'s first call on a
;; fresh heap builds the checker's per-heap caches by scanning ALL globals —
;; `known_ns_prefixes` / `module_public_exports`, each O(globals) (heap.rs). That
;; scan is cached (count-keyed) so a *process* pays it once, but every spawned
;; worker has its OWN heap and so rebuilds it on its first file. With one worker
;; per handful of files that O(globals) rebuild recurs per chunk → O(files·globals)
;; ≈ O(files²), which swamped the parallel win entirely (a 100K project got
;; *slower*). Sizing chunks to the core count caps the rebuild at `~cores` times
;; total, amortised over `files/cores` files each — so the redundant setup is
;; negligible against the per-file check.
;;
;; Chunks run in `*check-batch*`-sized groups (each group collected before the next
;; spawns, so peak live worker heaps — hence memory — is bounded by one group, like
;; the test runner's `*parallel-batch*`); each chunk's result folds into `acc` via
;; `combine` as it reports. A crashed worker (a check-file / parse that itself
;; throws) is folded via `on-death` instead of hanging the collector (mirrors the
;; test runner's KI-2 `monitor` handling). A small file set runs in-process — no
;; spawn overhead, no pool warm-up, stable (filename-sorted) output order.
; below this many files, check in-process
(def *check-min-parallel* 2000)
; chunks per core (load-balancing headroom)
(def *check-oversample* 2)
(sig *check-oversample* int)
;; The scheduler's worker-pool size (≈ nproc), clamped ≥1. `worker-threads` is 0
;; until the first spawn, so warm the pool and poll briefly for the threads to spin.
(defn- project-await-pool (tries)
  (let (n (dev/worker-threads))
    (if (or (> n 0) (<= tries 0))
      (math/max 1 n)
      (do (sleep 1) (project-await-pool (dec tries))))))
(sig project-await-pool (int -> int))
(defn- project-pool-size ()
  (spawn (fn () nil))
  (project-await-pool 50))
(sig project-pool-size (-> int))

;; Slice `coll` into ≤`n`-sized chunks, KEEPING a short trailing chunk.
;; A list-returning chunker that KEEPS the trailing partial chunk. Neither bare
;; `partition` (drops the partial) nor `seq/chunk-every` (returns VECTORS) can stand in:
;; the caller conses onto each chunk, and `(cons x [1 2])` is the improper pair
;; `(x . [1 2])`, not a list. `std/tool/test.blsp:run-chunks` is the same five lines for
;; the same reason — two tool modules independently hitting one gap in `seq`.
(defn- project-chunk-list (n coll acc)
  (if (empty? coll)
    (reverse acc)
    (project-chunk-list n (drop coll n) (cons (take coll n) acc))))

;; The `(pid chunk)` worker entry for `pid`, or nil if `pid` isn't one of ours.
(defn- project-pfold-entry (pid workers)
  (cond
    (empty? workers) nil
    (= (first (first workers)) pid) (first workers)
    else (project-pfold-entry pid (rest workers))))

;; The per-chunk operation, dispatched IN THE WORKER by keyword. `op` is a
;; keyword (plain data) and `project-pfold-run` is a global — so the spawned
;; worker body ships only data and resolves the operation through the global
;; table, exactly like the test runner calls the global `run-unit`. It must NOT
;; take the operation as a passed-in closure: `spawn`'s move of a body whose
;; captured env holds a closure value deep-copies that nested closure to the new
;; process, and that path intermittently corrupts the closure's arity (observed:
;; a worker dying with a bogus "fn: expected 0 arguments" arity error ~1 run in 3;
;; docs/known-issues.md). Add a case here per parallel pass.
(defn- project-pfold-run (op chunk)
  (cond
    (= op :check) (project-check-chunk chunk)
    (= op :check-shared) (project-check-chunk-shared chunk)
    (= op :scan-entries) (project-scan-entries-chunk chunk)
    (= op :check-deps) (project-check-deps-chunk chunk)
    else (error "project-pfold-run: unknown op " op)))

;; Spawn one MONITORED worker per chunk; each runs `(project-pfold-run op chunk)`
;; and sends `[:chunk pid value]` tagged with its own pid (so the collector can
;; correlate a result / a death with its chunk). Returns an assoc list `(pid chunk)`.
(defn- project-pfold-spawn (chunks op me)
  (fold chunks
    nil
    (fn (acc chunk)
      (let (pid (spawn (send me (list :chunk (self) (project-pfold-run op chunk)))))
        (monitor pid)
        (cons (list pid chunk) acc)))))

;; Collect one group: fold each chunk value into `acc` via `combine`; a worker
;; that DIES before reporting is folded via `(on-death acc chunk reason)`. A
;; message from a pid not in this group, or already accounted, is ignored without
;; touching `pending` (a stale `[:down …]` can't corrupt the count).
(defn- project-pfold-collect (pending workers reported acc combine on-death)
  (if (= pending 0)
    acc
    (let (msg (receive (m m)))
      (cond
        (= (first msg) :chunk)
          (let (pid (second msg) entry (project-pfold-entry pid workers))
            (if (or (includes? reported pid) (nil? entry))
              (project-pfold-collect pending
                workers reported acc combine on-death)
              (project-pfold-collect (- pending 1)
                workers
                (cons pid reported)
                (combine acc (third msg))
                combine
                on-death)))
        (= (first msg) :down)
          (let (pid (third msg) entry (project-pfold-entry pid workers))
            (if (or (includes? reported pid) (nil? entry))
              (project-pfold-collect pending
                workers reported acc combine on-death)
              (project-pfold-collect (- pending 1)
                workers
                (cons pid reported)
                (on-death acc (second entry) (nth msg 3))
                combine
                on-death)))
        else (project-pfold-collect pending workers reported acc combine on-death)))))

;; Run every group, one `*check-batch*`-sized batch in flight at a time.
(defn- project-pfold-groups (groups op combine on-death acc me)
  (if (empty? groups)
    acc
    (let (workers (project-pfold-spawn (first groups) op me)
          acc2 (project-pfold-collect (count workers) workers nil acc combine on-death))
      (project-pfold-groups (rest groups) op combine on-death acc2 me))))

;; Fan operation `op` (a keyword; see `project-pfold-run`) across the worker pool
;; over `files`, folding each chunk's value into `init` via `(combine acc value)`;
;; `(on-death acc chunk reason)` folds in a dead worker. `combine`/`on-death` run
;; only in this (driver) process, so they may be closures — only `op` crosses to a
;; worker, and it is data. A small file set runs in-process (no spawn, stable
;; order); a large one is sliced into `cores * *check-oversample*` chunks.
;; `project-pfold-files` where every file shares one payload (`shared`), which is prepended
;; to each chunk instead of being paired with each file — so a worker's captured body carries
;; it once, not once per file. The op sees `(shared file …)`.
(defn- project-pfold-files-shared (files shared op combine on-death init)
  (let (n (count files))
    (if (< n *check-min-parallel*)
      (combine init (project-pfold-run op (cons shared files)))
      (let (cores (project-pool-size)
            nchunks (math/min n (* cores *check-oversample*))
            csize (math/quot (+ n nchunks -1) nchunks)
            chunks (map (project-chunk-list csize files nil) (fn (c) (cons shared c))))
        (project-pfold-groups (project-chunk-list cores chunks nil)
          op
          combine
          on-death
          init
          (self))))))

(defn- project-pfold-files (files op combine on-death init)
  (let (n (count files))
    (if (< n *check-min-parallel*)
      (combine init (project-pfold-run op files))
      (let (cores (project-pool-size)
            nchunks (math/min n (* cores *check-oversample*))
            ; ceil(n / nchunks)
            csize (math/quot (+ n nchunks -1) nchunks)
            chunks (project-chunk-list csize files nil))
        ;; Group size = `cores`: at most `cores` worker heaps live at once (bounds
        ;; peak memory), and with `*check-oversample*` chunks per core the groups
        ;; still keep every core fed. All cores busy, live set ≈ one core-wide wave.
        (project-pfold-groups (project-chunk-list cores chunks nil)
          op
          combine
          on-death
          init
          (self))))))

;; Internal: run `check-file` over every file, print each warning to stderr (GNU
;; FILE:LINE:COL format), return the total count. Fanned across the worker pool
;; (see `project-pfold-files`). Each worker PRINTS its own chunk's warnings and
;; ships back only the integer count — NOT the warning list: a list would be
;; deep-copied across process heaps (message passing), which on a warning-heavy
;; project costs more than the check itself. `io/puts` writes one line per call,
;; so lines from concurrent workers interleave only between warnings, never
;; mid-line (like the test runner's `:trace`); warning *order* is no longer sorted
;; by filename, which is fine for advisory GNU `FILE:LINE:COL` diagnostics. Honors
;; the `BROOD_NO_CHECK=1` opt-out — the same flag the `brood` CLI respects, so
;; callers' "exit non-zero on warning" gating gets 0 (no print) under it.
;; A warning the checker reports but that does NOT gate the build (`nest check`'s
;; exit code). Currently only the non-tail-recursion lint: since deep recursion
;; became a catchable `MAX_BC_FRAMES` error rather than a silent stack overflow,
;; that lint is an advisory perf/robustness hint — and it fires on correct code
;; (inherently-tree recursion like %merge-sort or a window tree, and bounded
;; compile-time macro helpers, none of which can overflow). So it stays visible
;; but must never fail CI. Classified by message text for now, pending structured
;; warning severities (a fuller fix — see the roadmap).
(defn- project-advisory-warning? (w)
  (or (includes? w "recursive call in non-tail position")
    ;; Stability diagnostics (ADR-283). A deprecation that FAILS the build is a removal
    ;; with extra steps — the point is to say "this is going away" while the code still
    ;; works, so it prints and does not gate. Same for a beta notice.
    (includes? w "is deprecated since")
    (includes? w "is beta —")))

;; Print warning `w` and return the running gate count `n`, incremented only when
;; `w` gates the build. An advisory warning prints with an `(advisory)` marker and
;; leaves the count untouched — visible in the output, never a CI failure. Both
;; the fresh and the cached check paths tally through this.
;;
;; The tally is a pair `[gating unbound]`, not one count: `nest run`'s launch gate
;; (ADR-304) refuses to start over an UNBOUND symbol only — the one category that is a
;; dead call, not advice — while every other gating warning still prints and, under
;; `nest check`, still fails CI. `project-tally-add` merges two tallies (a worker's chunk
;; result into the running total, or a dead worker as one gating warning).
(def- *project-tally-zero* [0 0])

(defn- project-tally-add (a b)
  [(+ (first a) (first b)) (+ (second a) (second b))])

(defn- project-unbound-warning? (w)
  (includes? w "unbound symbol: "))

(defn- project-tally-warning (tally w)
  (if (project-advisory-warning? w)
    (do (io/puts (str w "  (advisory — not gating)") :to *err*) tally)
    (do
      (io/puts w :to *err*)
      (project-tally-add tally [1 (if (project-unbound-warning? w) 1 0)]))))

;; The `:check` op (runs in a worker): check every file in `chunk`, PRINT each
;; file's warnings, return the GATING count. A global (not a shipped closure) so
;; the worker resolves it through the global table — see `project-pfold-run`.
;; `chunk` is a list of `[file closure]` pairs (the closure = the file's KI-17
;; reachability set, carried as data so it reaches the worker).
(defn- project-check-chunk (chunk)
  (fold chunk
    *project-tally-zero*
    (fn (k pair) (let ([f cl] pair) (fold (reflect/check-file f cl) k project-tally-warning)))))

;; The same pass for the case where every file shares ONE reachability set, which is what
;; `check-run-closure` has: the loaded features are the closure, identically for all
;; of them. The chunk is `(closure file …)` rather than a list of `[file closure]` pairs, so
;; the set crosses to the worker ONCE instead of once per file.
;;
;; That is not a micro-optimisation. A chunk is captured by the spawned worker's body, and a
;; `spawn` DEEP-COPIES what it captures — so pairing each file with the same 16 302-element
;; list meant copying that list ~100 times per chunk. Measured on a cold `nest run` over
;; 16 302 modules: the pre-flight cost 24 GB of the run's 26.5 GB peak, and its memory grew
;; ~4x per doubling of the project (quadratic), while the check itself is ~3.7 ms/file.
(defn- project-check-chunk-shared (chunk)
  (let (cl (first chunk))
    (fold (rest chunk)
      *project-tally-zero*
      (fn (k f) (fold (reflect/check-file f cl) k project-tally-warning)))))

;; The from-scratch parallel path: fan `check-file` (print-in-worker) across the
;; pool. Used when the cache is off, absent, or the project is over the file cap.
(defn- project-check-files-fresh (files closures)
  (project-pfold-files (project-with-closures files closures)
    :check project-tally-add
    (fn (n chunk reason)
      (io/puts (str "warning: check worker died on " (count chunk) " file(s): " (pr-str reason))
        :to *err*)
      (project-tally-add n [1 0]))
    *project-tally-zero*))

;; `project-check-files-fresh` for one shared reachability set (see
;; `project-check-chunk-shared`). Same files, same warnings — only the amount copied to each
;; worker changes, from one closure per FILE to one per CHUNK.
(defn- project-check-files-shared (files closure)
  (project-pfold-files-shared files
    closure
    :check-shared project-tally-add
    (fn (n chunk reason)
      (io/puts (str "warning: check worker died on " (count chunk) " file(s): " (pr-str reason))
        :to *err*)
      (project-tally-add n [1 0]))
    *project-tally-zero*))

;; ── incremental check-result cache (Phase 2, ADR-119) ────────────────────────
;; Cache each file's `check-file` warnings on disk, keyed by (file mtime + a
;; dependency fingerprint). A file's warnings are reused iff BOTH are unchanged, so
;; a change to any global the check observed — directly, or transitively through
;; inference (which walks a callee's body and thereby records the callee's own
;; references) — flips the fingerprint (`check-deps-fp`) and forces a re-check of
;; exactly that file. `check-file-deps` uses a thread-local dependency recorder, so
;; the RE-CHECK runs SEQUENTIALLY in this process (never across the green-process
;; pool — two concurrent checks would clobber the shared recorder). A warm re-check
;; touches only changed files + their dependents, so the sequential cost is small; a
;; cold run pays a one-time full sequential check (parallel dep-capture is deferred —
;; it needs the recorder moved into the per-process context). Manifest = `{path ->
;; [mtime warnings dep-keys fp]}`, merged like the extract cache (anti-thrash).
;; The on-disk manifest name for a check-result cache, keyed by the CHECKING MODE.
;; A verdict depends on the mode that produced it, so a plain run's entries are not a
;; strict run's to reuse — without this key `nest check` poisoned the cache and the
;; following `nest check --strict` reported what the plain run had found (measured on a
;; four-warning probe file: 1 warning instead of 5, and CI runs the two gates back to
;; back over the same files). Two names rather than one invalidating key so each mode
;; keeps its own warm cache, the way `"checks"` and `"checks-run"` already do.
(defn- project-check-manifest (base)
  (if (reflect/strict-checking?) (str base "-strict") base))

(defn- project-check-files-cached (files root closures manifest strict?)
  ;; `manifest` names the on-disk verdict manifest: `"checks"` for `nest check`,
  ;; `"checks-run"` for `nest run`'s pre-flight. Separate because the two commands see
  ;; the same global through different facts — a module `nest run` materialised from
  ;; the startup image has no definition site, so its fact reads `F` where `nest
  ;; check`'s reads `D<file>@<mtime>` — and one manifest had each command rewriting
  ;; the other's entries on every invocation (2026-08-30). Each command is warm
  ;; against itself.
  ;;
  ;; `strict?` selects the reuse test. `nest check` (true) reuses an entry only when
  ;; the file's mtime, its dependency FINGERPRINT and its closure are all unchanged —
  ;; ADR-119's soundness core. The launch pre-flight (false) reuses on mtime alone:
  ;; its heap view is not even stable between write and read of the same process
  ;; kind (the image materialises modules lazily, so a global's fact can move between
  ;; the check and the next launch), which made the fingerprint fail on every launch
  ;; and the pre-flight cost the whole launch — 2.2 s of 2.5 s on bedit. A dependent's
  ;; verdict that shifts without its own file changing is `nest check`'s to report;
  ;; the pre-flight is advisory and scoped to what is about to run.
  (let (cache (project-read-cache root manifest)
        parts (fold files
                [{} nil]
                ; else re-check
                (fn (acc p)
                  (let ([reuse recheck] acc
                        c (%map-get cache p nil)
                        cl (%map-get closures p nil))
                    ;; Reuse iff mtime + dep-fingerprint AND the KI-17 closure (5th
                    ;; entry field) are unchanged — a closure shift (another file's
                    ;; requires changed) can add/remove a reachability warning without
                    ;; this file's mtime moving, so it must invalidate the cache too.
                    (if (and c
                          (= (nth c 0) (file/mtime p))
                          (or (not strict?)
                            (and (= (reflect/check-deps-fp (nth c 2)) (nth c 3))
                              (= (nth c 4 nil) cl))))
                      ; unchanged file + deps + closure → reuse
                      [(%map-assoc reuse p c) recheck]
                      [reuse (cons [p cl] recheck)]))))
        [reuse recheck] parts
        ;; re-check the dirty set in PARALLEL across the worker pool — safe now that
        ;; the dependency recorder is per-process (Heap::check_dep_rec). Each entry is
        ;; [mtime warnings dep-keys fp closure].
        ;; Each fresh entry's fingerprint is re-stamped HERE, in this process, from the
        ;; dep-keys the worker returned: the reuse test above runs here too, and a
        ;; worker's view of the heap can differ from ours (a module the launcher
        ;; materialised from the startup image carries no definition site, so the same
        ;; global's fact reads `F` in one and `D<file>@<mtime>` in the other). Stamped in
        ;; the worker, `nest run`'s pre-flight re-checked every file on every launch.
        fresh (fold (project-pcheck-deps recheck)
                {}
                (fn (m pair)
                  (let ([p e] pair
                        keys (nth e 2 nil)
                        restamped [(nth e 0 nil)
                                    (nth e 1 nil)
                                    keys
                                    (reflect/check-deps-fp keys)
                                    (nth e 4 nil)])
                    (%map-assoc m p restamped))))
        entries (fold fresh reuse (fn (m kv) (let ([p e] kv) (%map-assoc m p e))))
        ;; print every file's warnings (reused + fresh) and tally them
        n (fold entries
            *project-tally-zero*
            (fn (n kv) (let ([_ e] kv) (fold (nth e 1) n project-tally-warning)))))
    (when (not (empty? recheck))
      (project-write-cache root
        manifest
        (fold entries cache (fn (m kv) (let ([p e] kv) (%map-assoc m p e))))))
    n))

(defn- project-check-files (files root)
  (if (= (os/env "BROOD_NO_CHECK") "1")
    *project-tally-zero*
    ;; Build the KI-17 reachability closures from the WHOLE project (every file's
    ;; header), not just `files` — a `nest check FILE` still needs the full graph to
    ;; resolve `FILE`'s transitive requires, else a transitively-reached module would
    ;; false-positive. Outside a project (no root) the checked files are the universe;
    ;; there the lint is inert anyway (only the file's own requires are loaded).
    (let (closures (project-require-closures (if root (all-files root) files)))
      (cond
        ;; No cache when it's disabled, there's no project root, or the project is over
        ;; the file cap (the manifest read would rival re-checking) — parallel fresh path.
        (or (project-cache-off?) (nil? root) (>= (count files) (project-cache-max-files)))
          (project-check-files-fresh files
            closures)
        else (project-check-files-cached files root closures (project-check-manifest "checks") true)))))

;; Make sure the project is set up and all its sources are loaded — the
;; precondition for the checker to resolve cross-file names through the
;; heap's globals. Loads with `:skip-loaded`, so a module already on
;; `*features*` (loaded by the `run`/`run-tests` that called the
;; check pre-flight, or by a prior require) is NOT re-evaluated — which would
;; re-run its `defmacro`s and trip the hot-reload "macro redefined" warning.
;; Standalone callers (`nest check`, an interactive `(check)`) start from
;; an image with nothing loaded, so this still loads every source.
(defn- project-ensure-loaded (root)
  (project/setup root)
  (project-image/load-sources-cached root :skip-loaded))

;; Structured analogue of `check` — returns a flat list of
;; `{:file :line :col :message}` maps instead of printing GNU lines + a
;; count. Backs the `nest mcp` `check` tool (`std/tool/mcp.blsp`, step 1c-a).
;; Honors `BROOD_NO_CHECK=1` the same way `check` does: returns
;; an empty list under the flag.
(defn check-structured (&optional from)
  "Advisory type-check a project, returning a list of `{:file :line :col :message}` diagnostic maps (one per warning) instead of printing. Returns nil under `BROOD_NO_CHECK=1`. `from` is the directory to find the project from — it defaults to `(file/cwd)`, and naming one lets a caller check a project other than the ambient one. Errors if there is no project there. Backs the `nest mcp` `check` tool."
  ;; `from` exists because cwd was the ONLY way in, which made this function
  ;; untestable without process-global state: the case covering the `check` MCP tool
  ;; had to run wherever `cargo test` happened to be, so it type-checked the whole
  ;; brood repository and took 87s in CI against a 120s cap (KI-46). The alternatives
  ;; were all worse — a `set_current_dir` races sibling tests in the same binary under
  ;; plain `cargo test`, and raising the budget is what hid KI-39 for weeks. A caller
  ;; that names its root needs neither.
  (let (root (project/find-root (or from (file/cwd))))
    (when (nil? root)
      (error "check-structured: not in a Brood project (no project.blsp found from "
        (or from (file/cwd))
        ")"))
    (project-ensure-loaded root)
    (if (= (os/env "BROOD_NO_CHECK") "1")
      nil
      ;; `%append-two` (copy the small per-file diagnostic list, share `acc`) not
      ;; `(append acc …)` (recopies the growing accumulator each file → O(files²)).
      ;; `%mcp-progress` streams per-file progress under `nest mcp` (a no-op — a
      ;; cheap thread-local check — otherwise), so a large project's `check`
      ;; reports live instead of one silent wait.
      (let (files (all-files root)
            closures (project-require-closures files)
            total (count files))
        (project-check-fold files closures total 0 nil)))))

(defn- project-check-fold (files closures total done acc)
  (if (nil? files)
    acc
    (let (f (first files)
          diags (reflect/check-file-structured f (%map-get closures f nil))
          done2 (inc done))
      (%mcp-progress done2 total (str "checked " (path/basename f)))
      (project-check-fold (rest files) closures total done2 (%append-two diags acc)))))
(sig project-check-fold ((or list nil) map int int any -> any))

;; --- duplicate-global detection (flat namespace, ADR-019) --------------------
;; The project shares one flat global table: exactly one binding per name across
;; every source file. If two files each `(defn main …)`, the last loaded silently
;; wins with no error — an expensive, invisible failure (a real one hit in
;; docs/feedback-retro-game-of-life.md). This advisory pass parses each source
;; file's top-level def-style forms (via `parse-source`'s CST — no eval) and
;; warns when one name is defined in more than one file.

;; CST node accessors (see the `parse-source` doc in builtins.rs): a node is
;; `[kind v]` — for a leaf `v` is the raw source text, for a container
;; (`[:list …]`, `[:root …]`) `v` is the vector of child nodes.
(defn- project-node-kind (n) (seq/vector-ref n 0))
(defn- project-node-val (n) (seq/vector-ref n 1))

;; Top-level heads that bind a global (each expands to `def`). `defmodule` is
;; excluded — it registers a module feature, not a clashing value binding.
(def- *project-def-heads* ["def" "def-" "defn" "defn-" "defmacro" "defdyn" "defonce"])

;; `[head name]` for a recognised def-style form (both strings), else nil. The head
;; is what says whether the name is ambient, so the two travel together.
(defn- project-def-entry (list-node)
  (let (kids (filter (project-node-val list-node)
               (fn (c) (not (includes? [:whitespace :comment] (project-node-kind c))))))
    (when (>= (count kids) 2)
      (let (head (first kids) nm (second kids))
        (when (and (= (project-node-kind head) :symbol)
                (includes? *project-def-heads* (project-node-val head))
                (= (project-node-kind nm) :symbol))
          [(project-node-val head) (project-node-val nm)])))))

;; An **ambient** name — root regardless of any enclosing namespace, mirroring the
;; kernel resolver's `is_ambient`. It is a *declaration*, not a spelling: `defdyn`
;; declares one (an `*earmuffed*` name no longer gets it for free — two modules that
;; each wrote `(def *width* …)` used to share, and clobber, one root binding).
(defn- project-ambient? (head name)
  (or (= head "defdyn") (reflect/dynamic? (symbol name))))

;; The namespace a top-level `(defmodule ns …)` node declares (a string), or nil
;; if the node isn't a `defmodule`. The file-level shape of `project-def-entry`.
(defn- project-module-name (list-node)
  (let (kids (filter (project-node-val list-node)
               (fn (c) (not (includes? [:whitespace :comment] (project-node-kind c))))))
    (when (>= (count kids) 2)
      (let (head (first kids) nm (second kids))
        (when (and (= (project-node-kind head) :symbol)
                (= (project-node-val head) "defmodule")
                (= (project-node-kind nm) :symbol))
          (project-node-val nm))))))

;; The effective *global* key a def binds, mirroring the kernel resolver
;; (`eval::macros`): `ns/name` under a file's `(defmodule ns)` (ADR-065), but
;; left bare for an already-qualified name, an ambient `*earmuff*`, or a file
;; with no module header (the root namespace). This is what makes the duplicate
;; check namespace-sound — two files' same short name in different namespaces no
;; longer collide.
(defn- project-qualify (ns head name)
  (if (or (nil? ns) (project-ambient? head name) (includes? name "/"))
    name
    (str ns "/" name)))

;; Every global *key* defined at top level in the file at `path` — each a fully
;; resolved `ns/name` (or bare, per `project-qualify`), in source order.
;; `parse-source` never raises — malformed input just yields fewer recognised
;; defs — so a syntax error in one file can't abort the scan.
(defn- project-file-def-names (path)
  (let (nodes (filter (project-node-val (reflect/parse-source (file/slurp path)))
                (fn (c) (= (project-node-kind c) :list)))
        ns (first (seq/keep nodes project-module-name)))
    (map (seq/keep nodes project-def-entry)
      (fn (entry) (project-qualify ns (first entry) (second entry))))))

;; The project's source files (no tests) — the set the flat-namespace rule binds.
(defn- source-files (root)
  (fold (project/abs-paths root *project-source-paths*)
    nil
    (fn (acc d) (append acc (project/collect-sources d)))))

;; Warning strings for a *qualified* global key (`ns/name`, per
;; `project-file-def-names`) defined across more than one source file. Under
;; namespaces (ADR-065) this fires only on a genuine collision — two files in
;; the *same* namespace binding the same name, or an ambient `*earmuff*` / root
;; name bound twice — not on a short name reused across distinct namespaces.
;; `extracts` is `{path -> [mtime counts privs def-names]}`; `source-set` is
;; `{source-path -> true}` (only SOURCE files bind the flat namespace — a test
;; file's defs don't clash). Aggregates each source file's `def-names` (extract
;; slot 3) and warns on any qualified name bound in more than one source file.
(defn- project-duplicate-def-warnings (extracts source-set)
  (let (by-name (fold extracts
                  {}
                  (fn (acc kv)
                    (let ([path entry] kv)
                      (if (%map-get source-set path false)
                        (fold (nth entry 3)
                          acc
                          (fn (m nm) (%map-assoc m nm (cons path (%map-get m nm nil)))))
                        acc)))))
    (seq/keep by-name
      (fn (entry)
        (let ([nm paths] entry
              where (sort (seq/distinct paths)))
          (when (> (count where) 1)
            (str "warning: global '"
              nm
              "' is defined in "
              (count where)
              " source files ("
              (string/join where ", ")
              ") — same namespace; the last loaded wins (ADR-065)")))))))

;; Print the duplicate-def warnings to stderr and return the count. Advisory
;; (never raises, never stops a run) and honors `BROOD_NO_CHECK=1` like the
;; type-check pre-flight. Shared by `check` / `check-sources`.
(defn file-shadow-warnings (file root)
  "The duplicate-def warnings (ADR-065 flat-namespace shadowing) that mention a global
`file` itself defines, for the project at `root`. Public because the MCP server reports
them per open file, while every helper it needs is module-private — the alternative was
`mcp` reaching for four `defn-` names, which is exactly the dead call site KI-67 found.
Returns nil when there is nothing to report."
  (let (defined (project-file-def-names file)
        srcs (source-files root)
        extracts (project-gather-extracts srcs)
        source-set (fold srcs {} (fn (m p) (%map-assoc m p true))))
    (filter (project-duplicate-def-warnings extracts source-set)
      (fn (w) (any? defined (fn (nm) (includes? w (str "'" nm "'"))))))))

(defn- project-check-duplicate-defs (extracts source-set)
  (if (= (os/env "BROOD_NO_CHECK") "1")
    0
    (fold (project-duplicate-def-warnings extracts source-set)
      0
      (fn (n w) (io/puts w :to *err*) (+ n 1)))))

;; SEQUENTIAL duplicate-defs over `files` (over-cap / cache-off path): parse each
;; source file's def-names directly (no extract map, no cache). The original path;
;; source-file counts are usually modest, so a plain fold is fine at any scale.
(defn- project-duplicate-def-warnings-seq (files)
  (let (by-name (fold files
                  {}
                  (fn (acc path)
                    (fold (project-file-def-names path)
                      acc
                      (fn (m nm) (%map-assoc m nm (cons path (%map-get m nm nil))))))))
    (seq/keep by-name
      (fn (entry)
        (let ([nm paths] entry
              where (sort (seq/distinct paths)))
          (when (> (count where) 1)
            (str "warning: global '"
              nm
              "' is defined in "
              (count where)
              " source files ("
              (string/join where ", ")
              ") — same namespace; the last loaded wins (ADR-065)")))))))

;; --- unused module-private defns (whole-project, ADR-146 def-site privacy) ----
;; A `defn-`/`def-` name is private, but a grant (`:use-internals`) or a test can
;; reference it by its qualified `mod/name`. So "is it used?" can only be answered
;; across the *whole* project — a single-file check (the kind `check-file` runs)
;; false-flags every cross-module-referenced private name. This pass parses every
;; source + test file's CST (no eval), counts each symbol reference project-wide, and
;; warns for a `defn-`/`def-` private whose name is never referenced beyond its own
;; definition — neither as a same-module bare call nor a cross-module / test
;; `mod/name` reference. Comments don't count (the CST tags them `:comment`).

;; Fold every `:symbol` node value in CST `node` into `acc` (name→count, keyed by the
;; symbol's *string* — node values may be symbols, but qualified names are built with
;; `str`, so both sides normalise the same way). Since privacy is now a def-site fact
;; with a CLEAN name (ADR-146 step 2), the count can no longer be restricted to `--`
;; names: the verdict looks up each private's bare and qualified name, both ordinary
;; symbols. The bare count is project-global — a name shared across modules reads as
;; "used" (a false negative, never a false positive — safe for the advisory
;; zero-false-positive contract). Recurses
;; through a node's value, which is one of: raw text (a leaf — nothing to do), a
;; single child node (a wrapper like `:quote`, whose value is itself a `[:kind …]`
;; node-vector), or a vector of child nodes (`:list`/`:vector`/`:map`/`:root`).
;; A node-vector's first element is itself a node (a vector); a single child
;; node's first element is its kind *keyword* — that's how the two are told apart,
;; so a dispatch `{:tag mod/handler}` map or a quoted `'sym` is counted correctly.
; val is a node-vector
(defn- project-walk-val (val acc)
  (cond
    (not (vector? val)) acc
    (empty? val) acc
    (keyword? (first val)) (project-node-syms-acc val acc)
    ; val IS one node
    else (fold val acc (fn (a c) (project-node-syms-acc c a)))))
(defn- project-node-syms-acc (node acc)
  (if (= (project-node-kind node) :symbol)
    (let (nm (str (project-node-val node)))
      (%map-assoc acc nm (inc (%map-get acc nm 0))))
    (project-walk-val (project-node-val node) acc)))

;; Merge symbol-count map `b` into `a` (name→count), summing counts. The reduce
;; step for the parallel scan workers' per-chunk partial counts. Folding a map
;; yields its `[k v]` entries.
(defn- project-merge-counts (a b)
  (fold b a (fn (m entry) (let ([k v] entry) (%map-assoc m k (+ (%map-get m k 0) v))))))

;; Parse `path` ONCE and return its extract `[counts privs def-names]`:
;;   - `counts`   : name→count of every `:symbol` reference (the unused-private
;;                  verdict looks up each private's bare and qualified name).
;;   - `privs`    : this file's `defn-`/`def-` private defs as `[bare qual]`
;;                  (qualified via its `defmodule` namespace).
;;   - `def-names`: every top-level def's qualified global key (for duplicate-defs).
;; One parse feeds BOTH whole-project passes (unused-private + duplicate-defs) and
;; is what the on-disk cache stores per file. Delegates to the native
;; `scan-source-extract` — the interpreted-Brood CST walk this replaced was ~120ms
;; on a 1000-line file (the dominant cost of a cold whole-project check), vs a few
;; ms in Rust. `project-node-syms-acc`/`project-def-name`/`project-qualify` (below)
;; remain as the interpreted reference the native path mirrors — dead in the live
;; check path (only the native `scan-source-extract` runs), kept for documentation.
(defn- project-scan-file-entry (path)
  (reflect/scan-source-extract (file/slurp path)))

;; The `:scan-entries` op (runs in a worker): return `[path [mtime counts privs
;; def-names]]` for each file in `chunk` — the cache entry. mtime is read BEFORE the
;; parse, so if a write races the read the stored mtime is the pre-write one and the
;; next run (seeing the newer mtime) re-scans rather than trusting a stale extract.
(defn- project-scan-entries-chunk (chunk)
  (map chunk
    (fn (path)
      ;; a proper 4-VECTOR [mtime counts privs def-names] — NOT `(cons mtime …)`
      ;; onto the vector (that would make an improper list).
      (let (mt (file/mtime path)
            [counts privs def-names] (project-scan-file-entry path))
        [path [mt counts privs def-names]]))))

;; The `:check-deps` op (runs in a worker): for each `[path closure]` pair, run
;; `check-file-deps` and return `[path [mtime warnings dep-keys fp closure]]` — the
;; Phase-2 check-result cache entry (the closure is the KI-17 reachability set, stored
;; so a closure shift invalidates the entry). Safe in a worker now that the dependency
;; recorder is per-process (`Heap::check_dep_rec`), so dep-capture parallelises across
;; the pool. mtime read BEFORE the check (same race-safety as `:scan-entries`).
(defn- project-check-deps-chunk (chunk)
  (map chunk
    (fn (pair)
      (let ([p cl] pair
            mt (file/mtime p)
            r (reflect/check-file-deps p cl))
        [p [mt (nth r 0) (nth r 1) (nth r 2) cl]]))))

;; ── incremental check cache (Phase 1, ADR-119) ───────────────────────────────
;; The two whole-project CST passes below (unused-private, duplicate-defs) are pure
;; functions of file text. Cache each file's parse extract on disk keyed by its
;; mtime, so an unchanged file is neither read nor parsed next run — only stat'd.
;; Every run still re-aggregates the global counts / def multiset from ALL extracts
;; and re-derives every verdict (only the PARSE is cached, never a verdict) — so a
;; change in one file correctly shifts another's verdict via the always-recomputed
;; aggregate. Sound with mtime alone; the advisory contract (types.md #5, never
;; rejects a runnable program) makes mtime's rare imprecision harmless. The whole
;; cache carries a `(system/build-id)`+version stamp and is dropped on mismatch (the
;; extract depends on the Rust `parse-source`, so it isn't portable across binaries).
;; Opt out with `BROOD_NO_CHECK_CACHE=1`.
; v2: check-result entries gained a 5th field, the KI-17 require-closure (ADR-189).
(def *check-cache-version* "v2")
(defn- project-cache-stamp () (str (system/build-id) "|" *check-cache-version*))
(defn- project-cache-off? () (= (os/env "BROOD_NO_CHECK_CACHE") "1"))

;; The cache directory for `root` (created if absent), or nil if no cache base is
;; available: `$XDG_CACHE_HOME` (or `~/.cache`) `/brood/check/<sha256 of root>`.
;; Never inside the project tree (mirrors the image-cache convention).
;; Drop check-cache directories nothing has touched for a week.
;;
;; The cache is keyed by a hash of the project ROOT, so every ephemeral project leaves a
;; directory behind for good — a test fixture in /tmp, a scratch build, a checkout that
;; moved. Measured on one dev machine: 6458 directories and 83 MB accumulated over twelve
;; days, none of them ever reachable again. The boot cache has always pruned by age
;; (`prelude_image_prune` in boot.rs); this is the same policy for its sibling.
;;
;; Once per run, not per file: `*project-cache-pruned*` latches. Never prunes the directory
;; in use. Best-effort throughout — a cache is an optimisation, so a prune that cannot read
;; the directory or delete an entry simply leaves it (and a concurrent `nest` deleting the
;; same entry is a no-op, since `file/rmdir` treats NotFound as success).
;; Milliseconds: both `now` and `file/mtime` report ms since the epoch.
(def *project-cache-max-age-ms* (* 7 24 3600 1000))
(def *project-cache-pruned* false)

(defn- project-cache-prune (base seq/keep)
  (when (not *project-cache-pruned*)
    (def *project-cache-pruned* true)
    (check-allow :discarded-catch
      (try
        (let (cutoff (- (os/now) *project-cache-max-age-ms*))
          (fold (file/ls base)
            nil
            (fn (_ entry)
              (let (p (path/join base entry))
                (when (and (not (= p seq/keep)) (file/dir? p) (< (or (file/mtime p) 0) cutoff))
                  ;; check-allow :discarded-catch — a best-effort cache, manifest or git read/write: absence is the answer
                  (check-allow :discarded-catch (try (file/rmdir p) (catch _ nil))))))))
        (catch _ nil)))))

(defn project-cache-dir (root)
  "The per-project cache directory (`$XDG_CACHE_HOME/brood/<project>` or `~/.cache/…`) the
check-result cache and the `--failed`/`--stale` records live in; created on demand."
  (let (xdg (os/env "XDG_CACHE_HOME")
        home (os/env "HOME")
        base (cond
               (and xdg (not (= xdg ""))) xdg
               (and home (not (= home ""))) (path/join home ".cache")
               else nil))
    (when base
      (let (checks (path/join (path/join base "brood") "check")
            dir (path/join checks (hash/sha256 root)))
        (file/mkdir dir)
        (project-cache-prune checks dir)
        dir))))

;; `name` selects which on-disk manifest under the project's cache dir — Phase 1's
;; parse extracts (`"extracts"`) and Phase 2's check results (`"checks"`) are
;; separate files keyed by the same paths.
(defn- project-cache-file (root name)
  (let (dir (project-cache-dir root)) (when dir (path/join dir (str name ".blsp")))))

;; The cached `{path -> entry}` map for manifest `name`, or `{}` if the cache is off
;; / missing / stamp-mismatched / unreadable (any failure falls back to a cold
;; recompute — the cache is an optimization, never a correctness dependency).
(defn- project-read-cache (root name)
  (if (project-cache-off?)
    {}
    (let (f (project-cache-file root name))
      (if (and f (file/exists? f))
        (try
          (let (data (reflect/read-string (file/slurp f)))
            (if (= (%map-get data :stamp nil) (project-cache-stamp))
              (%map-get data :entries {})
              {}))
          (catch e {}))
        {}))))

;; Write the merged cache for manifest `name`. Best-effort — a write failure just
;; means no caching.
(defn- project-write-cache (root name entries)
  (when (not (project-cache-off?))
    (let (f (project-cache-file root name))
      (when f
        ;; check-allow :discarded-catch — a best-effort cache, manifest or git read/write: absence is the answer
        (check-allow :discarded-catch
          (try
            (file/spit f (pr-str {:stamp (project-cache-stamp) :entries entries}))
            (catch e nil)))))))

;; Parse `files` in parallel (`:scan-entries`), returning a list of
;; `[path [mtime counts privs def-names]]`. A dead worker's chunk is re-scanned in
;; the driver so no file is silently dropped. Shared by the cached and uncached paths.
(defn- project-pscan (files)
  (if (empty? files)
    nil
    (project-pfold-files files
      :scan-entries (fn (acc chunk-results) (%append-two chunk-results acc))
      (fn (acc chunk reason)
        (io/puts (str "warning: check scan worker died on "
                   (count chunk)
                   " file(s), re-scanning: "
                   (pr-str reason))
          :to *err*)
        (%append-two (project-scan-entries-chunk chunk) acc))
      nil)))

;; Run `check-file-deps` over `files` in PARALLEL (`:check-deps`), returning a list
;; of `[path [mtime warnings dep-keys fp]]`. The dependency recorder is per-process
;; (`Heap::check_dep_rec`), so concurrent dep-capture is race-free — this is what
;; makes a cold cache-build at scale fast instead of a sequential grind. A dead
;; worker's chunk is re-checked in the driver so no file is silently dropped.
(defn- project-pcheck-deps (files)
  (if (empty? files)
    nil
    (project-pfold-files files
      :check-deps (fn (acc chunk-results) (%append-two chunk-results acc))
      (fn (acc chunk reason)
        (io/puts (str "warning: check worker died on "
                   (count chunk)
                   " file(s), re-checking: "
                   (pr-str reason))
          :to *err*)
        (%append-two (project-check-deps-chunk chunk) acc))
      nil)))

;; Above this many files the on-disk cache is SKIPPED and the fast from-scratch
;; parallel path runs instead. The single manifest is a `pr-str`/`reflect/read-string`
;; s-expression whose read+write cost (and the per-entry dep-keys it holds) grows
;; with the file count; measured on 1000-line files a ~10K-entry manifest turned
;; the cache into a net loss (cold slower + multi-GB RSS + a pathologically slow
;; warm read). So the ceiling is deliberately low — the cache is for the common
;; small-project edit→recheck loop, where its manifest stays tiny; large projects
;; ride the from-scratch path (fast now that the per-file scan is native —
;; `scan-source-extract`). Lifting this needs a scalable manifest (binary / sharded
;; / per-file), noted as future work (ADR-119). Tunable via `BROOD_CHECK_CACHE_MAX`.
(defn- project-cache-max-files ()
  (let (e (os/env "BROOD_CHECK_CACHE_MAX"))
    (if (and e (not (= e "")))
      (let (n (string/->number e)) (if (failure? n) 50000 n))
      50000)))

;; Return `{path -> [mtime counts privs def-names]}` for `files` by scanning them
;; all, in parallel. NOT disk-cached: the per-file scan is now native
;; (`scan-source-extract`, ~2.5ms even on a 1000-line file), so re-scanning is
;; *cheaper* than reading a per-file extract manifest — that manifest is dominated
;; by each file's def-names (needed for duplicate-defs), so at scale reading it
;; (rebuilding millions of Brood values) cost far more than re-scanning (a 63MB
;; manifest → a 23s read at 3K files, vs ~0.6s to re-scan). The EXPENSIVE pass
;; (per-file type-check) is what earns a disk cache; this cheap one just re-runs.
(defn- project-gather-extracts (files)
  (fold (project-pscan files) {} (fn (m pair) (let ([p e] pair) (%map-assoc m p e)))))

;; Warning strings for private defs unreferenced anywhere in `files`. `used` =
;; the bare name appears ≥2× (its own def, plus a same-module call) OR — when a
;; module qualifies it — the qualified `mod/name` appears at all (a cross-module /
;; test reference). The parse + per-file scan is fanned across the worker pool
;; upstream (`project-gather-extracts`, `:scan-entries`), producing the `extracts`
;; map this consumes; here the driver `project-merge-counts`s the per-file counts
;; into a GLOBAL merged count that decides each private def's fate (so cross-module
;; references are seen). A scan
;; worker that dies leaves the counts under-complete for its slice — which could
;; only suppress a real warning or add a false one — so it is surfaced rather than
;; dropped silently.
;; `extracts` is `{path -> [mtime counts privs def-names]}` (from
;; `project-gather-extracts`). The GLOBAL merged counts decide each private def's
;; fate (so cross-module references are seen), then each file's `privs` are judged.
(defn- project-unused-private-warnings (extracts)
  (let (counts (fold extracts {} (fn (m kv) (project-merge-counts m (nth (second kv) 1)))))
    ;; `%append-two file-warnings acc` copies only the small per-file list and SHARES
    ;; the accumulator tail → O(total); a plain `(append acc …)` would be O(files²).
    (fold extracts
      '()
      (fn (acc kv)
        (let ([path entry] kv)
          (%append-two (seq/keep (nth entry 2)
                         (fn (pd)
                           (let ([bare qual] pd
                                 used (or (>= (%map-get counts bare 0) 2)
                                        (and (not (= qual bare))
                                          (>= (%map-get counts qual 0) 1))))
                             (when (not used)
                               (str path ": warning: unused private function: " bare)))))
            acc))))))

;; Print the unused-private warnings to stderr and return the count. Advisory;
;; honors `BROOD_NO_CHECK=1` like the other whole-project passes.
(defn- project-check-unused-private (extracts)
  (if (= (os/env "BROOD_NO_CHECK") "1")
    0
    (fold (project-unused-private-warnings extracts) 0 (fn (n w) (io/puts w :to *err*) (+ n 1)))))

(defn check ()
  "Advisory type-check the whole project (every source + test file), printing GNU-style `FILE:LINE:COL:` warnings to stderr. Errors if not in a Brood project. Backs `nest check`."
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "check: not in a Brood project (no project.blsp found from " (file/cwd) ")"))
    (project-ensure-loaded root)
    (let (files (all-files root)
          ;; Phase 1 (unused-private + duplicate-defs): native parallel scan every
          ;; run — cheaper than any disk cache (see `project-gather-extracts`).
          extracts (project-gather-extracts files)
          source-set (fold (source-files root) {} (fn (m p) (%map-assoc m p true))))
      (project-check-duplicate-defs extracts source-set)
      (project-check-unused-private extracts)
      ;; Phase 2 (per-file type-check): the EXPENSIVE pass — disk-cached per file
      ;; (dep-fingerprint) so a warm re-check reuses everything unchanged.
      (first (project-check-files files root)))))

;; (check-files paths) — advisory-check a specific list of files, the entry
;; behind `nest check FILE…`. Loads the project image *first* (same
;; `project-ensure-loaded` as `check`) so cross-module / namespace
;; imports resolve through the heap's globals exactly as in a whole-project
;; check — without it a single-file check of a namespaced file false-flags every
;; `:use`d / qualified name as unbound. Then runs the *same* per-file walk
;; (`project-check-files`: GNU stderr lines + BROOD_NO_CHECK opt-out + count),
;; so both `nest check` forms share one checker, not two divergent paths.
;; Outside a project (no project.blsp) it skips loading and checks each file
;; against the prelude alone — the standalone-file behaviour.
(defn check-files (paths)
  "Advisory type-check the listed files with the project image loaded first (so cross-module/namespace imports resolve), printing GNU `FILE:LINE:COL:` warnings to stderr and returning the total count. The entry behind `nest check FILE…`; shares its loader and per-file walk with `check`. Outside a project, checks against the prelude alone."
  (let (root (project/find-root (file/cwd)))
    (when root (project-ensure-loaded root))
    (first (project-check-files paths root))))

;; Sources-only variant for `run`'s auto pre-flight: skip `tests/`,
;; because test files depend on the test-framework macros (`describe`/`test`/
;; `assert=`/`is`) loaded with the `test` module, which `nest run` doesn't
;; do — so checking them there would emit spurious "unbound symbol" warnings.
;; `nest test` keeps using `check` (full coverage; `test` is loaded).
(defn check-sources ()
  "Like `check`, but checks only the project's source paths (skips `tests/`, whose files reference test-framework macros). Used by `nest run`'s pre-flight."
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "check-sources: not in a Brood project (no project.blsp found from "
        (file/cwd)
        ")"))
    (project-ensure-loaded root)
    (let (srcs (source-files root)
          extracts (project-gather-extracts srcs)
          source-set (fold srcs {} (fn (m p) (%map-assoc m p true))))
      (project-check-duplicate-defs extracts source-set)
      (first (project-check-files srcs root)))))

;; `nest run`'s pre-flight, scaled to what is actually about to run.
;;
;; Checking is ~3.7 ms per file and verdicts are deliberately NOT cached (only the parse
;; is — a change in one file can shift another's verdict, so verdicts are re-derived every
;; run). Over a 16 300-file project that is 60-120 s, against a 143 ms image-backed load:
;; the advisory check was 99.9% of `nest run`.
;;
;; The closure is not recomputed — `*features*` already IS it. The caller has just
;; `require`d the entry point, so the project features now loaded are exactly the modules
;; about to run. Deriving the file from the feature name (the same path `%require-find`
;; walks) keeps this O(closure); building a module graph would mean parsing every file in
;; the project, which is the cost being avoided. Nothing here re-loads: `nest run` has
;; already materialised its closure, and `project-ensure-loaded` would drag in the whole
;; project and undo the laziness.
(defn- project-feature-file (feat srcdirs)
  "The source file a loaded project feature came from, or nil if it is not one of this
project's own sources. The `srcdirs` guard matters: a feature like `project` (the std
tooling module) otherwise resolves to the manifest `./project.blsp` sitting in the cwd,
and the pre-flight would 'check' the manifest and warn on it."
  (let (n (->string feat)
        prefix (cond (nil? *project-name*) nil else (str *project-name* "/"))
        rel (cond
              (and prefix (string/starts-with? n prefix))
                (string/substring n (string/length prefix))
              else n)
        p (%require-find (str rel ".blsp") *load-path*))
    (when (and p (any? srcdirs (fn (d) (string/starts-with? p d)))) p)))

;; The project source files reachable from module `entry`, and the module names the walk
;; passed through. Walks OUTWARD from the entry through module headers, so it costs one
;; `%module-direct-requires` parse per module *in the closure* — never one per file in the
;; project, which is what `project-require-closures` costs and why the pre-flight cannot
;; use it (parsing 16 300 headers to check eleven files measured 34 s of a 35 s run).
;;
;; A name that resolves outside `srcdirs` — a std module, a dependency, an unresolvable
;; name — terminates the walk rather than failing it: its contents are its own project's
;; business, and it cannot require one of ours back. It stays in the returned name set,
;; because that set is the KI-17 reachability closure and a reference to it is legitimate.
;;
;; Why this is not `(keys *features*)`, which it replaced. On a WARM start the loaded
;; features really are the entry's closure and reading them off is exact. On a COLD start
;; `load-sources-cached` has just loaded every module to build the startup image,
;; so `*features*` is the whole project — and the pre-flight silently checked all of it
;; (~3.7 ms/file, uncached: ~50 s of an 85 s cold run on 16 302 modules). The closure has
;; to be DERIVED from the requires graph, or the same command checks a different file set
;; depending on whether an image happened to be fresh, which is a cache leaking into
;; advisory output.
(defn- project-entry-closure (entry srcdirs)
  (letrec (go (fn (frontier seen files)
                (if (empty? frontier)
                  ;; sorted, so a cold and a warm run print in the same order too
                  [(sort (vec files)) (vec seen)]
                  (let (m (->string (first frontier)))
                    (if (contains? seen m)
                      (go (rest frontier) seen files)
                      (let (seen2 (conj seen m)
                            p (project-feature-file m srcdirs))
                        (if (nil? p)
                          (go (rest frontier) seen2 files)
                          (let (info (try
                                       (%module-direct-requires p)
                                       (catch e {:module nil :requires []})))
                            (go (append (rest frontier) (or (%map-get info :requires nil) []))
                              seen2
                              (conj files p))))))))))
    (go [(->string entry)] #{} #{})))

(defn check-run-closure (entry)
  "Advisory pre-flight over the entry point's require-closure — the modules the program is
about to run actually reaches, walked from module `entry` through the require graph.
Returns `[gating unbound]` — the gating warning count and, of those, how many are unbound
symbols (the count `run`'s launch gate refuses over, ADR-304). A module the program never
reaches is `nest check`/`nest test`'s business."
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "check-run-closure: not in a Brood project (no project.blsp found from "
        (file/cwd)
        ")"))
    (if (= (os/env "BROOD_NO_CHECK") "1")
      *project-tally-zero*
      (let ([want reach] (project-entry-closure entry
                           (project/abs-paths root *project-source-paths*))
            extracts (project-gather-extracts want)
            source-set (fold want {} (fn (m p) (%map-assoc m p true)))
            ;; `reach` is one closure for the whole set rather than one per file: every file
            ;; in it is reachable from the entry, so the entry's closure is a superset of each
            ;; member's own — sound in the permissive direction, and it crosses to each check
            ;; worker once per CHUNK instead of once per file (`project-check-files-shared`).
            ;; Pairing a closure per file made this quadratic in project size — a `spawn`
            ;; deep-copies its captured chunk, so the list was copied ~100 times per chunk.
            ;; Measured on 16 302 modules: 24 GB of a 26.5 GB peak.
            )
        (project-check-duplicate-defs extracts source-set)
        (if (or (project-cache-off?) (>= (count want) (project-cache-max-files)))
          (project-check-files-shared want reach)
          (project-check-files-cached want
            root
            (project-require-closures want)
            (project-check-manifest "checks-run")
            false))))))

;; --- `nest check --fix-renames` — the migration aid --------------------------
;; A rename wave breaks every downstream repo, and the recovery was a manual loop: run
;; `nest check`, read ONE hint, run `nest rename`, repeat — a dozen rounds per repo, five
;; repos deep in hive's dependency closure. Every round is mechanical and the checker
;; already knows the answer, so running the loop is the tool's job.
;;
;; Three rules. The first two are what make it safe rather than merely fast:
;;
;;   1. **Only unambiguous fixes are applied** — exactly one public `mod/name` for the
;;      bare name, or nothing happens. Two candidates is a decision, not a rename.
;;   2. **A name this project itself defines is never touched.** `nest rename` is NOT
;;      scope-aware: renaming `register` in hive also renamed hive's own sign-up handler,
;;      producing `(defn proc/register …)` — a reserved name, so the module stopped
;;      defining anything at all. That cost a revert. Rewriting only REFERENCES
;;      (`:refs-only`, so no `defn` head moves) removes half that hazard; declining a name
;;      the project owns removes the other half.
;;   3. **A `%`-private target is named, never applied.** `map-pairs` → `%map-pairs` has
;;      no hint precisely because the name was withdrawn on purpose. Printing the target
;;      ends the guesswork against `std/` — which was the actual complaint — without
;;      quietly rewriting a caller onto something the stdlib took away.

(defn- unbound-names (diags)
  "The set of every name `diags` reported unbound — bare and qualified alike. The
diagnostic may carry a trailing ` — hint`, so the name is the first word after the prefix."
  (let (prefix "unbound symbol: ")
    (fold diags
      #{}
      (fn (acc d)
        (let (msg (get d :message))
          (if (not (string/starts-with? msg prefix))
            acc
            ;; `index-of` answers -1, not nil, when the needle is absent.
            (let (tail (string/substring msg (string/length prefix))
                  space (index-of tail " ")
                  nm (if (< space 0) tail (string/substring tail 0 space)))
              (if (string/blank? nm) acc (conj acc nm)))))))))

(defn- unbound-bare-names (diags)
  "The set of BARE names `diags` reported unbound. A QUALIFIED miss (`mod/foo`) is excluded:
there the module is wrong, not the name, and no single-name rewrite can be inferred."
  (fold (unbound-names diags) #{} (fn (acc nm) (if (includes? nm "/") acc (conj acc nm)))))

(defn- rename-index (wanted)
  "Map `bare → #{module …}` for every bare name in the set `wanted`, built in ONE pass over
the global table. A scan per name would be O(names × globals) against a table of thousands."
  (fold (reflect/global-names)
    {}
    (fn (acc sym)
      (let (spelling (->string sym)
            ;; -1, not nil, for an unqualified name — see `index-of`.
            slash (string/last-index-of spelling "/"))
        (if (< slash 0)
          acc
          (let (bare (string/substring spelling (+ slash 1))
                modname (string/substring spelling 0 slash))
            (if (and (contains? wanted bare)
                  ;; A private target cannot be referred to at all, so it is not a
                  ;; candidate — read the recorded privacy fact (ADR-146), not the name.
                  (not (reflect/private? sym))
                  (not (includes? modname "--")))
              (%map-assoc acc bare (conj (%map-get acc bare #{}) modname))
              acc)))))))

(defn- project-owned-module? (modname pname)
  (and pname (or (= modname pname) (string/starts-with? modname (str pname "/")))))

(defn- rename-plan (bare mods pname)
  "The decision for one unbound bare name: `[:fix qualified]` to rewrite, or `[:skip why]`."
  (let (owned (filter (vec mods) (fn (m) (project-owned-module? m pname)))
        withdrawn (symbol (str "%" bare)))
    (cond
      (not (empty? owned))
        [:skip
          (str "this project defines it as `"
            (first owned)
            "/"
            bare
            "` — a missing import, not a rename")]
      (= (count mods) 1) [:fix (str (first (vec mods)) "/" bare)]
      (> (count mods) 1)
        [:skip
          (str "defined in "
            (count mods)
            " namespaces ("
            (string/join (sort (vec mods)) ", ")
            ") — pick one by hand")]
      (bound? withdrawn)
        [:skip
          (str "moved behind `%` as `"
            (->string withdrawn)
            "` — withdrawn deliberately, so not rewritten for you")]
      else [:skip "not defined anywhere — rot, not a rename"])))

(defn fix-renames (apply?)
  "Apply the unambiguous half of a rename wave's recovery. For each BARE name `nest check`
reports unbound, find the single public `mod/name` that now defines it and rewrite this
project's REFERENCES (never a definition head) to the qualified name. With `apply?` false,
print the plan and change nothing. Returns the count of names left for a human.

Declines — with the reason printed — a name this project itself defines, a name defined in
more than one namespace, and a name that moved behind `%`. Backs `nest check --fix-renames`."
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "fix-renames: not in a Brood project (no project.blsp found from "
        (file/cwd)
        ")"))
    (let (diags (check-structured)
          ledger (renames/ledger)
          ;; The ledger first (ADR-304): a deliberate rename is exact and unambiguous —
          ;; bare or qualified — and needs no search. Whatever it does not cover goes to
          ;; the image-search heuristic below, bare names only.
          ledgered (filter (sort (vec (unbound-names diags))) (fn (nm) (contains? ledger nm)))
          names (fold ledgered (unbound-bare-names diags) (fn (acc nm) (disj acc nm)))
          pname (if *project-name* (->string *project-name*) nil))
      (if (and (empty? names) (empty? ledgered))
        (do (io/puts "fix-renames: no unbound names — nothing to do") 0)
        (let (index (rename-index names)
              plans (append (map ledgered
                              (fn (nm)
                                (let (entry (get ledger nm))
                                  [nm [:fix (get entry :to) (str " (" (get entry :adr) ")")]])))
                      (map (sort (vec names))
                        (fn (bare) [bare (rename-plan bare (%map-get index bare #{}) pname)])))
              fixes (filter plans (fn (p) (= (first (second p)) :fix)))
              skips (filter plans (fn (p) (= (first (second p)) :skip))))
          (for (p fixes)
            (io/puts (str (if apply? "  fix:  " "  would fix: ")
                       (first p)
                       " → "
                       (second (second p))
                       (or (nth (second p) 2 nil) "")))
            (when apply? (codemod/cst-rename (first p) (second (second p)) :refs-only)))
          (for (p skips) (io/puts (str "  skip: " (first p) " — " (second (second p)))))
          (io/puts (str "fix-renames: "
                     (count fixes)
                     (if apply? " applied" " applicable")
                     ", "
                     (count skips)
                     " left for you"))
          (count skips))))))

;; --- `nest check --suggest-sigs` — the `sig` adoption aid ---------------------
;;
;; Adopting `(sig …)` across a large library is the type system's longest-standing
;; backlog item, and the expensive part was never the typing — it was guessing what the
;; checker already knows. It knows a lot: it infers a domain per parameter and a type
;; per return, and `reflect/file-signatures` renders both back in source syntax. This
;; prints the ones worth writing down, so adoption is review-and-paste rather than
;; derive-from-scratch.
;;
;; Deliberately conservative about what it offers:
;;   • a function whose `(sig …)` is already written is skipped — nothing to add;
;;   • an all-`any` signature is skipped — true, and worth nothing to declare;
;;   • a signature the grammar cannot write comes back nil and is skipped.
;; Declaring an inferred signature is SOUND: the inferred parameter domain
;; over-approximates the real one (ADR-261, and the soundness oracle asserts it), so a
;; call this rejects would have failed anyway. It is still advice, not a patch — nothing
;; is written to disk, because a signature is documentation and deserves a human's eye.

(defn- suggestion-line (entry)
  "One `(sig name type)` line for a signature worth declaring, or nil."
  (let (rendered (get entry :sig))
    (when (and (not (get entry :declared?))
            (not (nil? rendered))
            ;; An all-`any` arrow says nothing a reader doesn't already have.
            ;; Decided on the types, not on the rendered text — `(string any -> any)`
            ;; contains the *text* of `(any -> any)` and is worth declaring.
            (get entry :informative?))
      (str "(sig " (get entry :name) " " rendered ")"))))

(defn- sig-head-token (line kw name)
  "Does `line` open `(defn name …)` / `(defn- name …)` for `kw`? Returns `name` when it
does, so the caller writes the sig under the spelling the SOURCE uses."
  (let (t (string/triml line)
        head (str kw name)
        n (string/length head))
    (when (string/starts-with? t head)
      (let (after (if (> (string/length t) n) (string/substring t n (inc n)) ""))
        (when (or (= after "") (= after " ") (= after "(")) name)))))

(defn- sig-defn-name-at (line name)
  "The spelling of `name` this line declares, or nil. `file-signatures` reports names
QUALIFIED (`regex/regex-peek`) while the definition is usually written bare — except
in `std/reflect.blsp` and friends, where the `defn` head carries the module itself
(`(defn reflect/read-string …)`). Try both, and keep whichever the file actually
wrote, so the sig names the function the way its definition does."
  (let (bare (let (i (index-of name "/"))
               (if (and i (>= i 0)) (string/substring name (inc i) (string/length name)) name)))
    (or (sig-head-token line "(defn " name)
      (sig-head-token line "(defn- " name)
      (sig-head-token line "(defn " bare)
      (sig-head-token line "(defn- " bare))))

(defn- sig-line-indent (line)
  (let (t (string/triml line)) (string/substring line 0 (- (string/length line) (string/length t)))))

(defn- sig-insertions (path lines)
  "`[[line-number sig-text] …]` for `path`, one per signature worth declaring, in file
order. A signature whose definition cannot be located is dropped — and counted by the
caller, which would rather write nothing than guess a line."
  (seq/keep (reflect/file-signatures path)
    (fn (entry)
      (when (not (nil? (suggestion-line entry)))
        (let (name (get entry :name)
              hit (seq/find (range (count lines))
                    (fn (k) (not (nil? (sig-defn-name-at (nth lines k) name))))))
          (when hit
            [hit
              (str (sig-line-indent (nth lines hit))
                "(sig "
                (sig-defn-name-at (nth lines hit) name)
                " "
                (get entry :sig)
                ")")]))))))

(defn- sig-splice (lines at text)
  (into (into (into [] (take lines at)) [text]) (drop lines at)))

(defn- sig-apply-all (lines insertions)
  "Insert every `[line text]`, LAST FIRST.

Order is the whole correctness argument. Each insertion pushes every later line down
by one, so applying them top-down writes the second sig one line early, the third two
early, and so on — which is exactly how the editor's declare-sig action corrupted
`std/regex.blsp` when several were accepted against one snapshot (the head of the
following definition ended up spliced onto the tail of the previous one, and the file
stopped parsing). Applied bottom-up, no edit can move another's target."
  (fold (reverse (sort insertions (fn (a b) (< (first a) (first b)))))
    lines
    (fn (acc entry) (sig-splice acc (first entry) (second entry)))))

(defn- sig-fix-file (path write?)
  "Add the missing signatures to one file. Returns `[added skipped]`; writes nothing
and reports `skipped` when the result would not parse, or when a definition could not
be located."
  (let (text (file/slurp path)
        lines (into [] (string/split text "\n"))
        wanted (count (filter (reflect/file-signatures path)
                        (fn (e) (not (nil? (suggestion-line e))))))
        insertions (sig-insertions path lines)
        found (count insertions))
    (if (= found 0)
      [0 (- wanted found)]
      (let (updated (string/join (sig-apply-all lines insertions) "\n")
            ;; The gate: a rewrite that does not parse is never written. This is the
            ;; check the editor action had no way to make — it edits a buffer, not a
            ;; file, and cannot see the result before the client applies it.
            parses (check-allow :discarded-catch
                     (try (do (reflect/read-all updated) true) (catch _ false))))
        (if (not parses)
          (do
            (io/puts (str "  " path ": REFUSED — the result would not parse; nothing written"))
            [0 wanted])
          (do
            (when write? (file/spit path updated))
            (io/puts (str "  "
                       path
                       ": "
                       found
                       " signature"
                       (if (= found 1) "" "s")
                       (if write? " written" " (dry run)")
                       (if (> (- wanted found) 0)
                         (str ", " (- wanted found) " skipped — definition not located")
                         "")))
            [found (- wanted found)]))))))

(defn fix-sigs (files write?)
  "Write the checker's inferred `(sig …)` above every function that lacks one, in
place. With `files` empty, the whole project. Backs `nest check --fix-sigs`.

The bulk, safe counterpart of the editor's declare-sig action. That action is correct
for ONE signature; accepting several against a single snapshot drifts, because every
insertion moves the lines below it. This applies them last-first, and re-parses each
file before writing it, so a file is either correct or untouched.

`nest check --suggest-sigs` prints the same set and changes nothing."
  (let (targets (if (empty? files)
                  (let (root (project/find-root (file/cwd)))
                    (when (nil? root)
                      (error "fix-sigs: not in a Brood project (no project.blsp found from "
                        (file/cwd)
                        ")"))
                    (source-files root))
                  files)
        totals (fold targets
                 [0 0]
                 (fn (acc path)
                   (let ([added skipped] (sig-fix-file path write?))
                     [(+ (first acc) added) (+ (second acc) skipped)]))))
    (io/puts (str "\nfix-sigs: "
               (first totals)
               " signature"
               (if (= (first totals) 1) "" "s")
               (if write? " written across " " would be written across ")
               (count targets)
               " file"
               (if (= (count targets) 1) "" "s")
               (if (> (second totals) 0)
                 (str "; "
                   (second totals)
                   " skipped (definition not located, or the file would not parse)")
                 "")))
    0))

(defn suggest-sigs (files)
  "Print the `(sig …)` declarations the checker would write for every function that
lacks one, grouped by file. With `files` empty, the whole project. Writes nothing.
Backs `nest check --suggest-sigs`."
  (let (targets (if (empty? files)
                  (let (root (project/find-root (file/cwd)))
                    (when (nil? root)
                      (error "suggest-sigs: not in a Brood project (no project.blsp found from "
                        (file/cwd)
                        ")"))
                    (source-files root))
                  files)
        total (fold targets
                0
                (fn (acc path)
                  (let (lines (filter (map (reflect/file-signatures path) suggestion-line)
                                (fn (x) (not (nil? x)))))
                    (if (empty? lines)
                      acc
                      (do
                        (io/puts (str "\n" path))
                        (for (line lines) (io/puts (str "  " line)))
                        (+ acc (count lines))))))))
    ;; "across 0 files" is a true sentence that answers nothing — the same shape
    ;; `nest doc <module>` had until today, where a command succeeds, produces nothing,
    ;; and leaves the reader to guess whether that is the answer or a misfire. Say which.
    (when (empty? targets)
      (io/puts (str "suggest-sigs: no .blsp files under this project's source paths "
                 (->string *project-source-paths*)
                 " — name the files explicitly (`nest check --suggest-sigs a.blsp …`), "
                 "or run it where the project lists them")))
    (io/puts (str "\nsuggest-sigs: "
               total
               " undeclared signature"
               (if (= total 1) "" "s")
               " the checker can already write, across "
               (count targets)
               " file"
               (if (= (count targets) 1) "" "s")))
    0))

;; (run-tests & opts) — find the project from the cwd, set it up, load
;; every <name>_test.blsp under its test paths (which only REGISTER tests via the
;; test framework), then run the whole suite once. opts pass through to run-tests
;; (e.g. :trace / :slow). Raises if there's no project here, or if any test fails.
;;
;; A `(check)` advisory pre-flight runs after all loads but before
;; `(run-tests)`, so the checker sees every source + test file once
;; cross-module names are resolvable through the loaded heap.
