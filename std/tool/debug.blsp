(defmodule debug
  "A process-native tracing debugger — the actor-model answer to Elixir's `dbg`.

Elixir's `dbg`/`IEx.pry` is a synchronous, single-session, terminal-bound pause: it
blocks the process waiting for the one IEx session, so it needs a TIMEOUT, and a
second process hitting the same point queues behind the first. Both limits come from
one root cause — the debugger is a terminal, not a process.

Here the debugger IS a process. A paused worker `send`s its snapshot to the debugger
and blocks on `receive` for a resume — parking indefinitely at zero cost, no timeout.
Many workers hitting the same `break` each park independently and fan into the
debugger's mailbox as a QUEUE of paused processes, each inspectable and resumable.

Causal context propagates TRANSPARENTLY: the debugger endpoint + current span live in a
settable per-process slot (`%trace-context`), which the kernel copies across `spawn` and
carries on a `send` for the receiver to adopt (opt-in, `#[cfg(dev-tools)]` so a lean
release compiles it out — see scheduler/lifecycle.rs and process/mailbox.rs). So a plain
`(spawn (fn () (break …)))` inside a `with-debugger` scope inherits the debugger and parks
— no re-wiring — and a server handles a request in the *sender's* context; the debugger
reconstructs a cross-process causal TREE, something `dbg` cannot do.

Wire it up with `with-debugger`; trace with `spy` (its `*spy-sink*` is routed here),
pause with `break`, and correlate with `span` (`span-spawn` is now just
`(spawn (span …))` sugar). `debug-watch` gives a live terminal view."
  (:use editor/ansi)
  (:use enum))

;; ---- ambient wiring: ONE propagating context (a durable per-process slot) ---
;; The debugger endpoint + current span live in `(%trace-context)` = {:debugger pid
;; :span id} (or nil) — a settable per-process slot (not a `binding`) that the KERNEL
;; propagates: across `spawn` (the child inherits it, lifecycle.rs) and, for the
;; send-level slice, across `send`→`receive` (so a long-lived server adopts the
;; sender's context per message). So `break`/`span` just work and nest under the
;; parent with no explicit hand-off. Zero cost + fully compiled out when unused
;; (`#[cfg(dev-tools)]` slot + primitives). Both accessors are nil-safe.
(defn tc-debugger () (get (%trace-context) :debugger))
(defn tc-span () (get (%trace-context) :span))

;; Scope a trace context around `thunk`, restoring the previous one even on error —
;; the slot isn't a dynamic, so this is the manual `binding` equivalent for it.
(defn with-trace-context (ctx thunk)
  (let (saved (%trace-context))
    (%set-trace-context ctx)
    (let (result (try (thunk) (catch e (do (%set-trace-context saved) (throw e)))))
      (%set-trace-context saved)
      result)))

;; ---- the debugger process ---------------------------------------------------
;; State: {:events [ordered event maps] :paused {pid -> snapshot} :seq n}. The
;; debugger's own mailbox order IS a global linearisation of concurrent events, so
;; stamping each with an incrementing :seq gives a deterministic, mergeable log.
(defn- debug-record
  (state event)
  (let (seq (get state :seq))
    (assoc state
      :seq (inc seq)
      :events (conj (get state :events) (assoc event :seq seq)))))

(defn- debug-loop
  (state)
  (receive
    ([:trace entry from] (debug-loop (debug-record state {:kind :trace :pid from :entry entry})))
    ([:span-enter span parent pid label] (debug-loop (debug-record state
                                                       {:kind :span-enter
                                                        :span span
                                                        :parent parent
                                                        :pid pid
                                                        :label label})))
    ([:span-exit span pid value] (debug-loop (debug-record state
                                               {:kind :span-exit :span span :pid pid :value value})))
    ([:break pid snapshot]
      ;; The worker is now blocked on receive awaiting [:resume] — record it as paused.
      (debug-loop (debug-record (assoc-in state [:paused pid] snapshot)
                    {:kind :break :pid pid :label (get snapshot :label)})))
    ([:resume pid] (send pid [:resume])
      (debug-loop (assoc state :paused (dissoc (get state :paused) pid))))
    ([:resume-all reply] (doseq (p (keys (get state :paused))) (send p [:resume]))
      (when reply (send reply [:resumed (count (get state :paused))]))
      (debug-loop (assoc state :paused {})))
    ([:query reply] (send reply [:state state])
      (debug-loop state))
    ([:stop reply] (when reply (send reply [:stopped]))
      :stopped)))

(defn start-debugger ()
  "Spawn a fresh debugger process and return its pid. Wire it in with `with-debugger`, then `spy` / `break` / `span` stream to it."
  (spawn (debug-loop {:events [] :paused {} :seq 0})))

(defn debugger-sink ()
  "A `*spy-sink*` value that forwards each `spy` entry to the debugger in the current `*trace-context*` (read at emit time, so it follows the context into spawned children)."
  (fn (entry) (let (dbg (tc-debugger)) (when dbg (send dbg [:trace entry (self)])))))

(defn with-debugger (dbg thunk)
  "Run `thunk` wired to debugger `dbg`: the trace-context slot carries it (and the current span) and `*spy-sink*` routes `spy` to it. Because the kernel propagates the slot across `spawn` (and `send`→`receive`), children and message handlers inherit the wiring with NO re-setup — a plain `(spawn (fn () (break …)))` inside here parks at `dbg`."
  (binding (*spy-sink* (debugger-sink))
    (with-trace-context {:debugger dbg :span nil} thunk)))

;; ---- break: park without a timeout, fan into the paused queue ----------------
;; `break` is a MACRO (ADR-174 path B): it injects `(%scope)` at the CALL SITE so the
;; snapshot carries EVERY in-scope local automatically — `eval-at` then evaluates in the
;; full local scope, not just the values you named. `(%scope)` is a compiler intrinsic
;; (a fresh `{name → value}` map straight from the lexical-scope table under the VM; the
;; env-frame builtin under the tree-walker), and it must expand at the breakpoint's
;; lexical site, which only a macro can do. The named `vals` still ride alongside — they
;; override a captured local of the same name and let you snapshot a *computed* value.
(defn- debug-break*
  (label scope explicit)
  "The runtime half of `break`: send the snapshot (`:scope` = the auto-captured locals,
`:vals` = the explicitly-named ones) to the debugger in context and park until resumed.
A no-op when no debugger is in context. `break`/`break-when` expand to a call to this."
  (let (ctx (%trace-context) dbg (get ctx :debugger))
    (when dbg
      (send dbg
        [:break
          (self)
          {:label label
           :vals (debug-pairs->map explicit)
           :scope scope
           :span (get ctx :span)}])
      (receive ([:resume] nil)))))

(defmacro break (label & vals)
  "Park THIS process at a breakpoint: snapshot `label`, EVERY in-scope local (captured
automatically via `%scope`), any explicitly-named `vals`, and the current causal span to
the debugger in the process's trace context, then block until it sends `[:resume]` — with
**no timeout** (a parked process costs nothing). Many processes hitting the same `break`
each park independently and queue in the debugger. A no-op when no debugger is in context,
so it's safe to leave in place. `eval-at` evaluates against the full captured scope.
Returns nil. (A macro so the local capture happens in YOUR lexical scope, not `break`'s.)"
  `(debug-break* ~label (%scope) (list ~@vals)))

;; Turn a `:name value …` argument list into a `{:name value}` map — the captured
;; locals of a breakpoint, keyed for display AND for `%eval-in` (a keyword key `:n`
;; binds the symbol `n`, so `(eval-at … "(* n n)")` resolves them).
(defn- debug-pairs->map
  (kvs)
  (letrec (go (fn (ks m)
                (if (or (empty? ks) (empty? (rest ks)))
                  m
                  (go (rest (rest ks)) (assoc m (first ks) (second ks))))))
    (go kvs {})))

;; ---- eval in a paused process's captured scope (ADR-174 §5, path A) ----------
;; Evaluate an expression with a breakpoint's captured locals in scope — the
;; explicit-capture form: only the values NAMED at `break` are available (the VM keeps
;; locals in positional slots, not by name, so a runtime primitive can't recover the
;; rest — the automatic version is a compiler intrinsic, deferred; see the roadmap).
(defn locals-of (dbg n)
  "The in-scope bindings of the Nth parked process (1-based), as a `{:name value}` map:
the automatically-captured lexical scope (`:scope`) overlaid with the values explicitly
named at `break` (`:vals`, which win on a name clash). A step-park has no `:scope`, just
the traced node's `value`."
  (let (entries (vec (get (dbg-state dbg) :paused)))
    (when (and (>= n 1) (<= n (count entries)))
      (let (snap (second (nth entries (dec n))))
        (merge (or (get snap :scope) {}) (or (get snap :vals) {}))))))
(defn eval-at (dbg n src)
  "Evaluate `src` (a Brood expression string) in the captured scope of the Nth parked
process (1-based, as shown by `paused` / `debug-repl`). EVERY local in scope at the
breakpoint is available (auto-captured via `%scope`), plus any values explicitly named at
`break`: `(debug/eval-at d 1 \"(* n n)\")`."
  (let (locals (locals-of dbg n))
    (if (nil? locals)
      (error "eval-at: no parked process " n)
      (%eval-in src locals))))

(defmacro break-when (pred label & vals)
  "A data-driven breakpoint: `break` (auto-capturing the local scope) only when `pred` is
truthy, else return nil untouched — `(break-when (< x 0) \"neg\" :x x)`. Conditional breaks
are just a Brood predicate, so no recompile and no cost on the false path. (A macro, like
`break`, so the scope capture happens at the call site.)"
  `(when ~pred (debug-break* ~label (%scope) (list ~@vals))))

;; ---- function-boundary instrumentation (trace-fn / break-fn) -----------------
;; `spy` instruments a FORM in source; these instrument a FUNCTION in the live image
;; with no source edit — the Erlang `dbg:tpl` / Emacs `trace-function` move. The name
;; is rebound to a wrapper (late binding, ADR-013: every existing call site takes the
;; new definition on its next call — the same def-rebinding seam `nest test --cover`
;; instruments with); the original fn value is kept in `*traced-fns*` and restored by
;; `untrace-fn`. Traffic goes through the same `*spy-sink*` seam `spy` uses, so it
;; follows the sink wherever it points (stderr, the debugger, an editor buffer).
;; Reserved names (ADR-166) mean a prelude/std name cannot be rebound — these are for
;; YOUR functions. The wrapper is variadic, so every arity of a multi-clause fn goes
;; through it; its `arglist` reads `(& args)` while traced.

(defonce *traced-fns* {}) ; sym -> the original fn value (`untrace-fn` restores it)
(defn- debug-original
  (sym)
  ;; The pre-instrumentation fn for `sym`: the registry entry when already traced
  ;; (re-tracing must not capture a wrapper as the original), else the live value.
  (or (get *traced-fns* sym)
    (if (bound? sym) (eval sym) (error "trace-fn: unbound symbol " sym))))

(defn- debug-rebind
  (sym replacement)
  ;; Rebind global `sym` to the fn value `replacement` — built as data and eval'd,
  ;; so the module-privacy walk (which reads hand-written source) is not in play and
  ;; a qualified name rebinds like it does from the REPL.
  (eval (list 'def sym replacement))
  nil)

(defn trace-fn (sym)
  "Trace function `sym` (a quoted, usually qualified symbol) at its boundary: rebind it
to a wrapper that emits `{:spy :call :fn sym :args …}` before delegating and
`{:spy :return :fn sym :value …}` after, through `*spy-sink*`. The value is returned
unchanged and a thrown error passes through untraced. Idempotent; `untrace-fn`
restores the original. Not for a macro or a builtin (there is no fn value to wrap),
nor a reserved prelude/std name (ADR-166).

**Tail calls survive a sink that says when it is full.** Emitting the `:return` entry
is work AFTER the call, so a self-call in tail position stops being one and each level
costs a VM frame — instrumenting a tail loop turns O(1) stack into O(n) and can trip
the frame limit. A sink that answers `:spy-stop` (the bounded-sink contract on
`*spy-sink*`) makes that cost stop with it: the wrapper puts the original back and
delegates in TAIL position, so every call after that one is uninstrumented — real
speed, constant stack, nothing built to be discarded. What you lose is the trace past
the sink's own budget, which the sink just told us it was throwing away.

The uninstall is the same rebind `untrace-fn` does, and the registry entry stays, so a
later `untrace-fn`/`untrace-all` is still correct (it restores what is already there)
and a later `trace-fn` still finds the true original. It IS globally visible, like
every other thing instrumentation does here: a second process running the same
function stops being traced too."
  (let (orig (debug-original sym))
    (when (not (fn? orig)) (error "trace-fn: not a function: " sym))
    ;; REBIND FIRST, register second. A rebind can still be refused after every check
    ;; above passes — a reserved prelude/std name is the case (E0030, ADR-166) — and a
    ;; registry entry written before that refusal is a trap: the name is not traced, yet
    ;; `untrace-fn`/`untrace-all` will try to restore it and raise the same refusal
    ;; again, out of a caller that has long since handled the failed install. Ordering it
    ;; this way makes a failed `trace-fn` leave nothing behind, so callers that offer
    ;; names speculatively (an editor tracing whatever a snippet calls) can simply catch.
    (debug-rebind sym
      (fn (& args)
        ;; `:spy-stop` from the sink = "everything from here is discarded". Put the
        ;; original back (so no later call even builds an entry) and delegate in TAIL
        ;; position — no post-call emit, no frame — so a traced tail loop is a tail loop
        ;; again for the rest of its run.
        (if (= :spy-stop (spy-emit {:spy :call :fn sym :args args}))
          (do (debug-rebind sym orig) (apply orig args))
          (let (value (apply orig args))
            (spy-emit {:spy :return :fn sym :value value})
            value))))
    (swap-registry! debug/*traced-fns* (fn (m) (assoc m sym orig)))
    sym))

(defn break-fn (sym)
  "A function-boundary breakpoint: rebind `sym` so every call first parks the calling
process (`break`, label = the fn name, `:args` = the argument list in scope for
`eval-at`) and then delegates to the original. A no-op park when no debugger is in
context (`break`'s own rule), so a break-fn'd function still works un-debugged.
`untrace-fn` restores the original."
  (let (orig (debug-original sym))
    (when (not (fn? orig)) (error "break-fn: not a function: " sym))
    ;; rebind before registering, for the reason `trace-fn` explains
    (debug-rebind sym
      (fn (& args)
        (break (str sym) :args args)
        (apply orig args)))
    (swap-registry! debug/*traced-fns* (fn (m) (assoc m sym orig)))
    sym))

(defn untrace-fn (sym)
  "Restore `sym` to its pre-`trace-fn`/`break-fn` definition and drop it from the
registry. Unknown/untraced syms are a no-op (returns nil)."
  (let (orig (get *traced-fns* sym))
    (when orig
      (debug-rebind sym orig)
      (swap-registry! debug/*traced-fns* (fn (m) (dissoc m sym)))
      sym)))

(defn untrace-all ()
  "Restore every traced/broken function (`untrace-fn` each); returns how many.

Restoring one name never stops the others: this is the *teardown* path — an eval
server runs it after every traced request — and a single stubborn entry must not leave
the rest of the image instrumented. So each restore is guarded, and the count is what
was attempted."
  (let (syms (keys *traced-fns*))
    (doseq (s syms) (try (untrace-fn s) (catch _ nil)))
    (count syms)))

(defn traced-fns ()
  "The symbols currently instrumented by `trace-fn`/`break-fn`."
  (keys *traced-fns*))

;; ---- causal spans: correlate work across the share-nothing boundary ---------
(defn span (label thunk)
  "Run `thunk` inside a fresh causal span (a child of the current context's span), emitting enter/exit to the debugger; returns `thunk`'s value. Nested `span`s and spawned/`send`-reached children link to this one, so the debugger can rebuild the causal tree."
  ;; pid-qualified so two processes' gensym counters can't collide into one node.
  (let (ctx (%trace-context)
        dbg (get ctx :debugger)
        parent (get ctx :span)
        id [(self) (gensym "s")])
    (when dbg (send dbg [:span-enter id parent (self) label]))
    ;; Set the whole context (new span) for the body AND bind the spy sink, so `spy`
    ;; inside this span routes to the debugger even in a child that only inherited it.
    (binding (*spy-sink* (debugger-sink))
      (with-trace-context {:debugger dbg :span id}
        (fn ()
          (let (value (thunk))
            (when dbg (send dbg [:span-exit id (self) value]))
            value))))))

(defn span-spawn (label thunk)
  "`spawn` `thunk` wrapped in a `span`. With transparent context propagation (the kernel copies `*trace-context*` into the child) a plain `(spawn (span label thunk))` already inherits the debugger + parent span, so this is now just sugar for that."
  (spawn (span label thunk)))

;; ---- inspection / control (round-trip queries to the debugger) --------------
(defn dbg-state (dbg)
  "The debugger's full state snapshot: `{:events :paused :seq}`."
  (let (me (self)) (send dbg [:query me]) (receive ([:state s] s))))
(defn paused (dbg)
  "The map of currently parked processes: `pid -> snapshot`."
  (get (dbg-state dbg) :paused))
(defn dbg-events (dbg)
  "The ordered event log the debugger has collected."
  (get (dbg-state dbg) :events))
(defn resume (dbg pid)
  "Release one parked process."
  (send dbg [:resume pid])
  nil)
(defn resume-all (dbg)
  "Release every parked process; returns how many were waiting."
  (let (me (self)) (send dbg [:resume-all me]) (receive ([:resumed n] n))))
(defn dbg-stop (dbg)
  "Stop the debugger process."
  (let (me (self)) (send dbg [:stop me]) (receive ([:stopped] :ok))))

;; ---- aggregate / statistical querying (debug the population, not one hit) ----
;; When thousands of processes hit the same trace point you don't want thousands of
;; dumps (Elixir's failure mode) — you want the DISTRIBUTION and the OUTLIERS. Because
;; traces are data, not text, these are plain folds over the debugger's event log.
(defn trace-entries (dbg)
  "The raw `:trace` events the debugger collected (each `{:pid :entry :seq …}`)."
  (filter (fn (e) (= (get e :kind) :trace)) (dbg-events dbg)))

(defn observations (dbg)
  "Every `spy` node observation, flattened to `{:pid :form :value}`."
  (keep (fn (e)
          (let (entry (get e :entry))
            (when (= (get entry :spy) :node)
              {:pid (get e :pid) :form (get entry :form) :value (get entry :value)})))
    (trace-entries dbg)))

(defn hits (dbg)
  "How many times each traced form was observed, `{form-string -> count}`."
  ;; `pr-str`, deliberately, not the bounded printer: this string is a KEY (matched
  ;; against by `value-distribution`), and a key that elides is a key that collides.
  ;; Bounding belongs on the paths that paint, not the ones that identify.
  (frequencies (map (fn (o) (pr-str (get o :form))) (observations dbg))))

(defn value-distribution (dbg form-string)
  "The distribution of observed values for one traced form, `{value -> count}`."
  (frequencies (keep (fn (o) (when (= (pr-str (get o :form)) form-string) (get o :value)))
                 (observations dbg))))

(defn modal-value (dbg form-string)
  "The most-common observed value for a form (nil if never seen) — the population's 'normal'."
  (let (dist (value-distribution dbg form-string))
    (if (empty? dist)
      nil
      (first (first (sort-by (fn (kv) (- (second kv))) dist))))))

(defn outliers (dbg form-string)
  "The observations of `form-string` whose value is NOT the modal one — the few rows to inspect when the population mostly agrees. Each is `{:pid :form :value}`."
  (let (modal (modal-value dbg form-string))
    (filter (fn (o)
              (and (= (pr-str (get o :form)) form-string)
                (not (= (get o :value) modal))))
      (observations dbg))))

;; ---- causal tree reconstruction ---------------------------------------------
(defn causal-tree (dbg)
  "Reconstruct the cross-process causal tree from the debugger's span events: a
list of root nodes, each `{:span :label :pid :value :children [...]}`. A span still
running shows `:value :running`."
  (let (events (dbg-events dbg)
        enters (filter (fn (e) (= (get e :kind) :span-enter)) events)
        exits (filter (fn (e) (= (get e :kind) :span-exit)) events)
        value-of (fn (id)
                   (let (ex (first (filter (fn (e) (= (get e :span) id)) exits)))
                     (if ex (get ex :value) :running)))
        children-of (fn (parent-id)
                      (filter (fn (e) (= (get e :parent) parent-id)) enters)))
    (letrec (build (fn (e)
                     {:span (get e :span)
                      :label (get e :label)
                      :pid (get e :pid)
                      :value (value-of (get e :span))
                      :children (map build (children-of (get e :span)))}))
      (map build (filter (fn (e) (nil? (get e :parent))) enters)))))

(defn- causal-lines
  (nodes depth)
  "The causal tree as a flat list of indented, pid-tagged strings (one per span)."
  (mapcat (fn (node)
            (cons (str (apply str (map (constantly "  ") (range depth)))
                    (get node :label)
                    " ["
                    (get node :pid)
                    "] => "
                    (pr-str-bounded (get node :value)))
              (causal-lines (get node :children) (inc depth))))
    nodes))
(defn print-causal (dbg)
  "Pretty-print the causal tree (`causal-tree`) as an indented, pid-tagged outline."
  (doseq (line (causal-lines (causal-tree dbg) 0)) (println line)))

;; ---- one-glance session report ----------------------------------------------
(defn- debug-report-lines
  (dbg)
  "The session summary as a list of strings: parked processes (the break queue), the
cross-process causal tree, and the hottest traced forms. Rendered by both the
`println`-based `debug-report` (cooked mode) and the cursor-positioned `debug-attach`
(raw mode, where `\\n` would not return to column 0)."
  (let (state (dbg-state dbg))
    (append (cons "── parked processes ──"
              (map (fn (entry)
                     (str "  "
                       (first entry)
                       "  "
                       (get (second entry) :label)
                       "  "
                       (pr-str-bounded (get (second entry) :vals))))
                (get state :paused)))
      (cons "── causal tree ──" (causal-lines (causal-tree dbg) 0))
      (cons "── hot traced forms ──"
        (map (fn (kv) (str "  " (second kv) "×  " (first kv)))
          (sort-by (fn (kv) (- (second kv))) (hits dbg)))))))
(defn debug-report (dbg)
  "Print a session summary: parked processes (the break queue), the cross-process
causal tree, and the hottest traced forms by hit count. The one-call overview."
  (doseq (line (debug-report-lines dbg)) (println line)))

;; ---- live terminal view -----------------------------------------------------
(defn- debug-watch-loop
  (dbg frames)
  (print (str (ansi-clear) (ansi-home)))
  (println "── debug-watch  (Ctrl-C to exit) ──")
  (debug-report dbg)
  (if (= frames 1)
    :done
    (do (sleep 500) (debug-watch-loop dbg (dec frames)))))
(defn debug-watch (dbg & frames)
  "Live, read-only terminal view of the debug session — clears the screen and
reprints `debug-report` every 500ms. Runs until Ctrl-C, or for a fixed frame count
if one is given (used by tests). Watch the paused queue fill/drain and the causal
tree grow as a workload runs; drive resume from another session or a timer."
  (debug-watch-loop dbg (if (empty? frames) -1 (first frames))))

;; ---- interactive terminal attach (key-driven) -------------------------------
;; The driveable sibling of `debug-watch`: same live view, but it reads the keyboard
;; (raw mode) so you resume parked processes without a timer. Pure IO shell over the
;; same `debug-report`; input via `term-poll` (nil on the 400ms timeout → just redraw).
(defn- debug-attach-render
  (dbg)
  ;; In raw mode `\n` moves down but NOT to column 0, so a `println` frame staircases.
  ;; Clear, then place every line absolutely at (row, col 1) with `ansi-cursor`.
  (print (ansi-clear))
  (letrec (place (fn (lines row)
                   (when (not (empty? lines))
                     (print (str (ansi-cursor row 1) (first lines)))
                     (place (rest lines) (inc row)))))
    (place (cons "── debug-attach    [r] resume all parked    [q] quit ──"
             (debug-report-lines dbg))
      1)))
(defn- debug-attach-loop
  (dbg)
  (debug-attach-render dbg)
  (let (key (term-poll 400))
    (cond
      (or (= key "q") (= key :escape) (= key :ctrl-c)) :quit
      (= key "r") (do (resume-all dbg) (debug-attach-loop dbg))
      else (debug-attach-loop dbg))))
(defn debug-attach (dbg)
  "Interactive terminal view of the debug session: refreshes ~2×/s and handles keys —
`r` resumes every parked process, `q` (or Esc / Ctrl-C) quits. Needs a real terminal
(enters raw mode); `debug-watch` is the non-interactive read-only sibling. `term-leave`
always runs, even on error, so the terminal is restored."
  (term-enter)
  (let (result (try (debug-attach-loop dbg) (catch _ :error)))
    (term-leave)
    result))

;; ---- single-step evaluation (spy + break fusion) ----------------------------
;; `spy` instruments every evaluated subexpression; if the sink PARKS at each node
;; instead of just recording it, you step through an expression's evaluation node by
;; node. Because the value is emitted post-order, each pause shows a subexpression's
;; *result* — resume to advance to the next. Run under `with-debugger` and drive the
;; steps from `debug-repl` / `debug-attach`.
(defn stepping-sink ()
  "A `*spy-sink*` that parks the process at each `spy` node (one breakpoint per
subexpression). Non-node entries (`:enter`/`:exit`) pass through."
  (fn (entry)
    (when (= (get entry :spy) :node)
      (let (dbg (tc-debugger))
        (when dbg
          (send dbg
            [:break
              (self)
              ;; :vals is a MAP, same as `break`'s (`debug-pairs->map`) — so
              ;; `locals-of` / `eval-at` work on a step-park too: the traced node's
              ;; value is in scope as `value` (`(eval-at d 1 "value")`).
              {:label (str "step " (pr-str-bounded (get entry :form)))
               :vals {:value (get entry :value)}
               :span (tc-span)}])
          (receive ([:resume] nil)))))))
(defmacro step (expr)
  "Evaluate `expr` in single-step mode: each `spy`-traced subexpression parks at a
breakpoint until resumed, so you step through evaluation one node at a time. Run it
under `with-debugger`; advance the steps from `debug-repl` (`r`) or `debug-attach`."
  `(binding (*spy-sink* (stepping-sink)) (spy ~expr)))

;; ---- pry: drop into the REAL REPL at a debug point --------------------------
;; The `binding.pry` / `IEx.pry` move, done right: instead of a bespoke prompt, launch
;; the actual `(repl-run)` — the fully-styled Brood REPL (syntax highlighting, history,
;; `,help` / `,doc`, Tab-complete). It reuses the whole REPL wholesale (zero duplication),
;; so it inherits every REPL improvement for free. Debugger control is ordinary eval:
;; `(debug/paused d)`, `(debug/resume-all d)`, `(debug/step …)`; Ctrl-D leaves and
;; continues. Runs in the process that OWNS the terminal (a script's main flow, or the
;; REPL) — a parked worker can't take stdin, so you pry from there and inspect the queue.
;; The debugger `pry` is driving under `repl-run` — `,resume`/`,step` need to know WHICH
;; debugger without you passing it each time, so `pry` binds it here for their handlers.
(defdyn *debug-session* nil)

(defn- debug-repl-resume
  (rest)
  "`,resume` handler: resume all parked processes in the current `*debug-session*`, or
the Nth if a number is given (`,resume 2`). No-op note when no session is active."
  (let (dbg *debug-session*)
    (if (nil? dbg)
      (println "\e[90m(no active debug session)\e[0m")
      (let (r (trim rest))
        (if (= r "")
          (println (str "resumed " (resume-all dbg) " parked"))
          (let (entries (vec (get (dbg-state dbg) :paused)))
            (println (debug-resume-nth dbg entries (try (eval-string r) (catch _ nil))))))))))

(defn- debug-repl-step
  (rest)
  "`,step` handler: advance a single parked process one step (resume the first parked;
under `step`/`stepping-sink` it re-parks at the next node). Note when nothing is parked."
  (let (dbg *debug-session*)
    (if (nil? dbg)
      (println "\e[90m(no active debug session)\e[0m")
      (let (entries (vec (get (dbg-state dbg) :paused)))
        (if (empty? entries)
          (println "\e[90m(nothing parked)\e[0m")
          (do
            (resume dbg (first (first entries)))
            (sleep 30)
            (println (str "stepped [" (first (first entries)) "]"))))))))

(defn pry (dbg)
  "Drop into the REAL Brood REPL — fully styled (highlighting, history, `,help`, Tab) —
to inspect this debug session interactively. Prints the paused queue + causal tree first,
then hands you the prompt. Drive the session with the `,resume` / `,step` meta-commands
(or any expression — `(debug/paused d)`, `(debug/resume-all d)`, `(debug/step …)`).
Ctrl-D leaves and continues. Reuses `repl-run` — so it's the real REPL, not a
re-implementation; it registers the `,resume`/`,step` commands via the REPL registry."
  (require 'repl)
  (repl/register-repl-command {:names '("resume")
                               :usage ",resume [N]"
                               :summary "resume all parked (or the Nth) in this debug session"
                               :handler debug-repl-resume})
  (repl/register-repl-command {:names '("step")
                               :usage ",step"
                               :summary "advance one parked process a single step"
                               :handler debug-repl-step})
  (doseq (line (debug-report-lines dbg)) (println line))
  (println "── pry: the real REPL. `,resume` / `,step` to drive the session · Ctrl-D to continue ──")
  (binding (*debug-session* dbg *repl-prompt* "debug> ")
    (repl/repl-run)))

;; ---- interactive debugger prompt (a REPL for the session) -------------------
;; A TYPING interface (cooked mode — no raw terminal, works even piped): prints the
;; state, then a `debug>` prompt. Line commands:
;;   <Enter>  refresh      r    resume ALL parked     r N   resume the Nth parked
;;   q        quit         (any Brood expr) evaluate it — e.g. (debug/dbg-events d)
(defn- debug-numbered
  (entries)
  (letrec (go (fn (es i acc)
                (if (empty? es)
                  (reverse acc)
                  (go (rest es)
                    (inc i)
                    (cons (str "  ["
                            i
                            "] "
                            (first (first es))
                            "  "
                            (get (second (first es)) :label)
                            " "
                            (pr-str-bounded (get (second (first es)) :vals)))
                      acc)))))
    (go entries 1 ())))
(defn- debug-resume-nth
  (dbg entries n)
  (if (and (int? n) (>= n 1) (<= n (count entries)))
    (do (resume dbg (first (nth entries (dec n)))) (str "resumed [" n "]"))
    (str "no parked process [" n "]")))
(defn debug-repl (dbg)
  "An interactive debugger prompt — a REPL for `dbg`. Prints the numbered paused queue
and the causal tree, then reads a line: `r` resume all, `r N` resume the Nth parked,
Enter refresh, `q` quit, or any Brood expression to evaluate. Cooked mode, so it needs
no raw-terminal setup and works when piped."
  (let (entries (vec (get (dbg-state dbg) :paused)))
    (println "── parked processes ──")
    (doseq (line (debug-numbered entries)) (println line))
    (doseq (line (cons "── causal tree ──" (causal-lines (causal-tree dbg) 0))) (println line))
    (print "debug> ")
    (let (raw (read-line))
      (if (nil? raw)
        :done
        (let (line (trim raw) parts (string-split line " ") cmd (first parts))
          (cond
            (= line "q") :done
            (or (= line "") (= line "p")) (debug-repl dbg)
            (= cmd "r")
              (do
                (if (> (count parts) 1)
                  (println (debug-resume-nth dbg
                             entries
                             (try (eval-string (second parts)) (catch _ nil))))
                  (do (resume-all dbg) (println "resumed all")))
                ; let a resumed process reach its next break before redraw
                (sleep 30)
                (debug-repl dbg))
            else
              (do
                (try
                  (println (str "=> " (pr-str-bounded (eval-string line))))
                  (catch e (println (str "! " (pr-str-bounded e)))))
                (debug-repl dbg))))))))
