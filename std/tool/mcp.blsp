(defmodule mcp
  "The `nest mcp` server: the Model Context Protocol over stdio (ADR-036, docs/mcp.md) —
the JSON-RPC loop, its dispatch and error mapping, and the tool catalogue it serves.

`(main)` bootstraps the project image and serves until the client hangs up. The
dispatcher reads `(tools)` on every `tools/list` *and* `tools/call`, so a `def` in a
previous `reflect/eval` (hot reload, ADR-013) reshapes the surface immediately — and a
project's own `mcp.blsp`, loaded at startup, can rebind the catalogue.

Each catalogue entry is a map: `:name` (string, the MCP tool name),
`:description` (optional, agent-visible), `:schema` (JSON Schema for the
arguments — a Brood map projected to JSON by the dispatcher), and `:handler`
(a function `(handler args-map)` returning the tool's result; the dispatcher
JSON-ifies the return value and wraps it in MCP's content envelope).

Args arrive as a *keyword-keyed* Brood map (JSON object keys become Brood
keywords, arrays become lists) — so `(get args :source)` is the idiomatic accessor.
Handlers return Brood data (nil, bool, number, string, keyword/symbol, list/vector/set,
map, pid, ref). Closures, tables, bytes etc. can't be JSON-ified and surface as errors."
  (:use format)
  (:use project)
  (:use explain :exclude [error]))

;; ---- handlers --------------------------------------------------------------
;; Each handler is `(handler args-map) -> result-map`. Handlers `throw` on
;; argument-shape problems (the dispatcher renders the throw as a JSON-RPC
;; error); soft failures (an unbound name in `lookup`, a parse error in `reflect/eval`)
;; become a typed field in the returned map so the agent can branch on it
;; without re-parsing an error string.

;; Coerce a caught value into the structured error shape MCP tools return.
;; Built-in errors are already maps (`{:kind :code :message :file :line :col
;; :hint :trace}` — see `LispError::to_value_map` in the kernel); user `(throw v)`s
;; come through as the value itself, so we wrap them as `{:kind :user :payload
;; v}` to keep `:error` always a map for the agent's JSON consumers. The
;; asymmetry — built-in vs user — is deliberate per `docs/archive/llm-native.md` §4.
;; Either way the raise site (`error`, from `%try-described`) fills in any of
;; `:file :line :col :trace` the value lacks: a `catch` binds a user throw verbatim,
;; and an agent debugging its own call needs to know where it came from.
(defn- error-shape (e error)
  (merge (dissoc error :kind :message :code :hint) (if (map? e) e {:kind :user :payload e})))

(defn- attempt (thunk on-error)
  "Call `thunk`; if it raises, call `on-error` with the raise's `error-shape`, which
carries the position and trace whatever was thrown."
  (%try-described thunk (fn (caught error) (on-error (error-shape caught error)))))

(defn eval-tool (args)
  "`reflect/eval` — evaluate `:source` in the session's global env. State persists
across calls (hot reload, ADR-013): a `def` here is visible to the next call
and to spawned processes. Returns `{:value pr-str-of-result}` on success and
`{:error msg}` on failure; the dispatcher catches `throw`s, but a parse/eval
error inside the user expression surfaces here as the `:error` branch.

**Unsandboxed by design.** `:source` runs with the full builtin set — `file/spit`,
`file/slurp`, `run-process`, `%os-cmd`, sockets — so it is not confined to the
project the way `write`/`edit` are, and the `write`/`edit` sandbox does not
constrain it. Anyone who can call this tool can do anything the `nest mcp`
process's OS user can; that process is the trust boundary.

    (mcp/eval-tool {:source \"(+ 1 2)\"})   ;=> {:value \"3\"}"
  (let (src (get args :source))
    (when (not (string? src))
      (throw "eval: :source must be a string"))
    ;; Evaluate *every* form and return the last value — so pasting a multi-form
    ;; block (a batch of `defn`s, say) runs all of them, not just the first.
    (attempt (fn () {:value (pr-str (reflect/eval-string src))}) (fn (shape) {:error shape}))))

;; Cross-file shadow warnings involving `file`: the *qualified* names
;; (`ns/name`) this file defines that another
;; project source file also defines. Namespace-sound (ADR-065) — a short name
;; reused across distinct namespaces is not a collision, only a same-namespace
;; (or ambient/root) rebinding is. Empty (and silent) outside a project.
;; Best-effort — never raises.
(defn- shadows-for (file)
  ;; check-allow :discarded-catch — shadow warnings are advisory: no project root means none
  (check-allow :discarded-catch
    (try
      (let (root (project/find-root (file/cwd)))
        (if (nil? root) nil (project-check/file-shadow-warnings file root)))
      (catch _ nil))))

(defn- load-checked (file)
  "Load `file` into the session image and report the result as `{:ok true
:diagnostics [...] :shadows [...]}` (or `{:ok false :error ...}` on failure) —
the shared body of the `reflect/load`/`write`/`edit` tools. `def`s persist (hot reload,
ADR-013); `diagnostics` are `check-file-structured` warnings, `shadows` the
cross-file flat-namespace collisions."
  (attempt (fn ()
             (reflect/load file)
             {:ok true
              :diagnostics (or (reflect/check-file-structured file) [])
              :shadows (or (shadows-for file) [])})
    (fn (shape) {:ok false :error shape})))

(defn load-tool (args)
  "`reflect/load` — load a `.blsp` file into the session and check it. Side-effects
(`def`, `defn`, `defmacro`) persist. Returns `{:ok true :diagnostics [...]
:shadows [...]}` — `diagnostics` are advisory `{:file :line :col :message}`
type/arity/unbound/non-tail-recursion warnings from `check-file-structured`;
`shadows` flags names this file defines that another project source file also
defines (the silent flat-namespace collision). On a load error:
`{:ok false :error msg}`.

`:file` is **not** run through the `write`/`edit` project sandbox — any path this
process can read, it will load (and loading executes the file's top-level forms).
Like `reflect/eval`, this tool is bounded by the `nest mcp` process, not by the project.

    (mcp/load-tool {:file \"src/app.blsp\"})   ;~> {:ok true :diagnostics [] :shadows []}"
  (let (file (get args :file))
    (when (not (string? file))
      (throw "load: :file must be a string"))
    (load-checked file)))

;; ---- the project sandbox for write/edit -----------------------------------
;; Every path the `write`/`edit` tools resolve goes through `project-path`, which
;; refuses anything outside `project/*root*` — both lexically (no absolute path,
;; `~`, or `..` segment) and after `canonicalize`, so a symlinked directory inside
;; the project that points outside cannot be used to escape either.
;;
;; **This is an ergonomic guardrail on `write`/`edit`, NOT a containment boundary
;; for the server.** Do not read it as one, and do not build a trust decision on
;; it. `reflect/eval` sits beside these tools and runs arbitrary Brood source with the
;; **full builtin set** — including `file/spit`, `run-process` and `%os-cmd` — and
;; `reflect/load` takes an unsandboxed path; neither goes through `project-path`. So an
;; agent driving `nest mcp` can already write anywhere the *process* can, and the
;; sandbox only keeps `write`/`edit` from doing it by accident.
;;
;; The security boundary that actually holds is therefore the one around the whole
;; `nest mcp` process — who may connect to it, and what that OS user can reach —
;; exactly as for any other tool that offers an eval endpoint. Sandboxing `reflect/eval`
;; and `reflect/load` would be a deliberate design change (and gutting `reflect/eval` would break
;; the tool), not a bug fix; it is the owner's call, not something this comment
;; should pretend has already happened.

(defn- safe-rel? (rel)
  "Whether `rel` passes the LEXICAL bar for a project-relative path: a non-empty
string, not absolute (`/…`) or home-anchored (`~…`), with no `..` segment. The
first (cheap) of two gates; the second is the symlink-resolving check in
`project-path`."
  (and (string? rel)
    (> (string/length rel) 0)
    (not (string/starts-with? rel "/"))
    (not (string/starts-with? rel "~"))
    (not (includes? (string/split rel "/") ".."))))

(defn- under-root? (abs)
  "Whether real path `abs` is the project root itself or lies strictly under it —
compared after `os/canonicalize` on both sides, so a **symlinked directory inside
the project that points outside** cannot be used to escape (the lexical check
alone misses this — a purely-relative, `..`-free path can still resolve out of
the tree through a symlink)."
  (let (real (os/canonicalize abs)
        root (os/canonicalize project/*root*))
    (and (string? real)
      (string? root)
      (or (= real root) (string/starts-with? real (str root "/"))))))

(defn- project-path (rel)
  "Resolve project-relative `rel` to an absolute path under `project/*root*`, or
`throw` if it would escape the project — a lexical violation (absolute/`~`/`..`,
or no project root), OR a **symlink** whose real target is outside the tree.

Shared by `write` and `edit`, and by **only** those two: it is a guardrail on the
file-writing tools, not a containment boundary for the server (`reflect/eval` runs
arbitrary code with full filesystem access, and `reflect/load` takes an unsandboxed
path). See the section comment above."
  (when (nil? project/*root*)
    (throw "no project root — nest mcp must run inside a Brood project"))
  (when (not (safe-rel? rel))
    (throw (str "path must be project-relative — no leading '/' or '~', no '..': " (pr-str rel))))
  (let (abs (path/join project/*root* rel))
    (when (not (under-root? abs))
      (throw (str "path escapes the project sandbox — its real target (following symlinks) "
               "is outside the project root: "
               (pr-str rel))))
    abs))

(defn- write-result (rel abs)
  "The shared tail of `write`/`edit`: a `.blsp` file at absolute `abs` is loaded
+ checked (so the result mirrors `reflect/load`'s `:diagnostics`/`:shadows`) and tagged
with its project-relative `:path`; any other file just confirms the write."
  (if (string/ends-with? rel ".blsp")
    (assoc (load-checked abs) :path rel)
    {:ok true :path rel}))

(defn write-tool (args)
  "`write` — create or overwrite a project file through the live image. `:path`
is **project-relative** (sandboxed under the project root — an absolute path,
`~`, or any `..` segment is rejected); `:content` is the full new file contents.
Missing parent directories are created. A `.blsp` file is then loaded into the
session and checked, so the result carries `:diagnostics` and `:shadows` exactly
like the `reflect/load` tool — closing the edit→load→check loop in one call; any other
file is written verbatim. Returns `{:ok true :path rel :diagnostics [...]
:shadows [...]}` or `{:ok false :error ...}`. This is the intended way for an
agent to write code — through nest mcp, so the session image stays in sync with
disk.

The project-relative restriction is a **guardrail, not a containment
guarantee**: the `reflect/eval` tool beside it runs arbitrary Brood with the full builtin
set (`file/spit` included) and `reflect/load` takes an unsandboxed path, so the server as
a whole can already reach the wider filesystem. Treat the `nest mcp` process
itself as the trust boundary."
  (let (rel (get args :path)
        content (get args :content))
    (when (not (string? content))
      (throw "write: :content must be a string"))
    (attempt (fn ()
               (let (abs (project-path rel)
                     _dir (file/mkdir (path/dirname abs))
                     _w (file/spit abs content))
                 (write-result rel abs)))
      (fn (shape) {:ok false :error shape}))))

(defn edit-tool (args)
  "`edit` — exact-string replacement in a project file through the live image.
`:path` is **project-relative** (the same sandbox as `write`); `:old` must occur
**exactly once** in the file (so the edit is unambiguous) and is replaced by
`:new`. A `.blsp` file is reloaded and checked afterwards (result carries
`:diagnostics`/`:shadows`, like `reflect/load`). Returns `{:ok true :path rel ...}`, or
`{:ok false :error msg}` when the file is missing, or `:old` is absent or not
unique. The editor's exact-replace Edit, routed through nest mcp so the session
image stays in sync with disk.

    (mcp/edit-tool {:path \"src/app.blsp\" :old \"(defn parse (s)\" :new \"(defn parse (s opts)\"})   ;~> {:ok true :path \"src/app.blsp\" :diagnostics […] …}"
  (let (rel (get args :path)
        old (get args :old)
        new (get args :new))
    (when (not (string? old))
      (throw "edit: :old must be a string"))
    (when (not (string? new))
      (throw "edit: :new must be a string"))
    (when (= old "")
      (throw "edit: :old must be non-empty"))
    (attempt (fn ()
               (let (abs (project-path rel))
                 (if (not (file/exists? abs))
                   {:ok false :error (str "edit: no such file: " rel)}
                   (let (text (file/slurp abs)
                         hits (- (count (string/split text old)) 1))
                     (cond
                       (= hits 0) {:ok false :error (str "edit: :old not found in " rel)}
                       (> hits 1)
                         {:ok false
                          :error (str "edit: :old occurs "
                                   hits " times in " rel " — make it unique")}
                       else
                         (let (_w (file/spit abs (string/replace text old new)))
                           (write-result rel abs)))))))
      (fn (shape) {:ok false :error shape}))))

(defn lookup-tool (args)
  "`lookup` — describe a global name. Returns `{:name :arglist :doc :type
:source-location}` (reflect/arglist a list of param symbols incl. `&optional`/`&`
markers; doc a string or nil; type the checker's arrow signature string or nil;
source-location `[file line col]` or nil).
Unbound names come back as `{:name :error}` rather than a thrown error, so
the agent can branch on `(get r :error)` cleanly.

    (mcp/lookup-tool {:name \"string/join\"})   ;~> {:name \"string/join\" :arglist (…) :doc \"…\" :type \"…\" :source-location [\"…\" 12 1]}"
  (let (name (get args :name))
    (when (not (string? name))
      (throw "lookup: :name must be a string"))
    (let (sym (reflect/read-string name))
      ;; `arglist` and `doc` want the *function value*; `(reflect/eval sym)`
      ;; resolves the name. `source-location` wants the symbol itself.
      (attempt (fn ()
                 (let (value (reflect/eval sym))
                   {:name name
                    :arglist (reflect/arglist value)
                    :doc (reflect/doc value)
                    :type (reflect/type-signature sym)
                    :source-location (reflect/source-location sym)}))
        (fn (shape) {:name name :error shape})))))

(defn macroexpand-tool (args)
  "`macroexpand` — expand `:form` (a source string) once (`:mode \"1\"`, the
default) or recursively (`:mode \"all\"`). Returns `{:expanded pr-str}`.
Reads the form ourselves rather than letting it interpolate into surrounding
text — unbalanced parens in `:form` can't break the host expression.

    (mcp/macroexpand-tool {:form \"(when a b)\"})   ;=> {:expanded \"(if a (do b) nil)\"}"
  (let (src (get args :form)
        mode (get args :mode))
    (when (not (string? src))
      (throw "macroexpand: :form must be a string"))
    (attempt (fn ()
               (let (form (reflect/read-first src)
                     expanded (if (= mode "all")
                                (reflect/macroexpand form)
                                (reflect/macroexpand-1 form)))
                 {:expanded (pr-str expanded)}))
      (fn (shape) {:error shape}))))

(defn format-tool (args)
  "`format` — reformat `:source` via `std/format.blsp`'s `(source ...)`.
Idempotent. The require is lazy and cached, so the per-call cost is a hash
check after the first invocation.

    (mcp/format-tool {:source \"(+ 1   2)\"})   ;=> {:formatted \"(+ 1 2)\\n\"}"
  (let (src (get args :source))
    (when (not (string? src))
      (throw "format: :source must be a string"))
    (attempt (fn () {:formatted (source src)}) (fn (shape) {:error shape}))))

(defn check-tool (args)
  "`check` — advisory type-check the project. Returns
`{:diagnostics [{:file :line :col :message} ...]}` (one entry per warning,
position omitted when the checker can't supply one — ADR-024). Backed by
`(project-check/check-structured project/*root*)` in `std/tool/project-check.blsp` (step 1c-a). `(or … [])`
so a clean project renders as `{:diagnostics []}` rather than `{:diagnostics
null}` — agents shouldn't have to disambiguate \"no warnings\" from
\"missing field\".

    (mcp/check-tool {})   ;~> {:diagnostics [{:file \"src/app.blsp\" :line 12 :col 5 :message \"…\"} …]} — [] when clean"
  ;; `project/*root*`, not `(file/cwd)`: the server serves ONE project, and the write
  ;; sandbox and every other project-scoped tool read that root (KI-46). A nil root
  ;; makes `check-structured` fall back to the cwd and report "not in a Brood project".
  (attempt (fn () {:diagnostics (or (project-check/check-structured project/*root*) [])})
    (fn (shape) {:error shape})))

(defn run-tests-tool (args)
  "`run-tests` — run the project test suite. Returns the structured runner
result from `(project-run/run-tests-structured)` — `{:total :passed :failed
:failed-assertions :ms :results [{:group :name :passed :ms :failures ...}]}`.
Outside a Brood project, returns `{:error msg}`.

    (mcp/run-tests-tool {})   ;~> {:total 42 :passed 42 :failed 0 :failed-assertions 0 :ms 830 :results […]}"
  (attempt project-run/run-tests-structured (fn (shape) {:error shape})))

(defn- process-infos ()
  "A `(proc/info pid)` stat map for every live process, dropping any that died
mid-scan. The shared snapshot behind both the `processes` and `proc/info`
tools — one definition of \"what we know about a process\"."
  (seq/reject (map (or (proc/list) []) proc/info) nil?))

(defn processes-tool (args)
  "`processes` — snapshot every live green process with its runtime stats.
Returns `{:processes [{:id :pid :node :name :status :mailbox :memory
:collections :reductions :monitored-by :parent} ...]}` — the same
`(proc/info pid)` map the observer reads, so an agent sees mailbox
backlog, cumulative reductions (the work counter — is it busy?),
heap bytes, GC count and monitors per process, not just the id. Order
is unspecified — sort by `:id` (or `:reductions` to find the busiest)
if you need stability.

    (mcp/processes-tool {})   ;~> {:processes [{:id 1 :pid … :name … :status … :mailbox 0 …} …]}"
  {:processes (process-infos)})

(defn process-info-tool (args)
  "`proc/info` — the full stat map for a single process by `:id` (an
integer from a `processes` listing). Returns the `(proc/info pid)`
map (`{:id :pid :node :name :status :mailbox :memory :collections
:reductions :monitored-by :parent}`), or `{:error msg}` if no live
process carries that id.

    (mcp/process-info-tool {:id 42})   ;~> {:id 42 :pid … :status :waiting :mailbox 0 :memory … :reductions … …}"
  (let (id (get args :id))
    (when (not (int? id))
      (throw "proc/info: :id must be an integer"))
    (or (seq/find (process-infos) (fn (p) (= (get p :id) id)))
      {:error (str "no live process with id " id)})))

(defn node-tool (args)
  "`node` — runtime-wide stats, the header the observer shows: which node
this is, the scheduler's worker-thread pool size, the high-water marks
for concurrency and memory, the total processes spawned since start,
the current live-process count, current/peak memory, and connected
peers. Returns `{:node :workers :peak-threads :spawned :process-count
:mem-bytes :mem-peak :peers}`. The \"is the runtime healthy / busy?\"
overview, complementing per-process `processes`.

    (mcp/node-tool {})   ;~> {:node … :workers 8 :peak-threads … :spawned 120 :process-count 9 :mem-bytes … :mem-peak … :peers []}"
  {:node (node/name)
   :workers (dev/worker-threads)
   :peak-threads (dev/peak-threads)
   :spawned (dev/spawn-count)
   :process-count (count (or (proc/list) []))
   :mem-bytes (dev/mem-bytes)
   :mem-peak (dev/mem-peak)
   :peers (or (node/list) [])})

(defn vitals-tool (args)
  "`vitals` — the unified runtime snapshot (`telemetry/runtime-snapshot`): GC, scheduler,
and VM stats plus the live-process count and the current telemetry metrics, all behind ONE
call instead of scraping the individual stat builtins. Returns `{:gc :sched :vm :processes
:metrics}`. The point-in-time companion to `watch-runtime` (which streams events); folds
what `node`/`processes` expose behind one telemetry-fed view.

    (mcp/vitals-tool {})   ;~> {:gc {…} :sched {…} :vm {…} :processes … :metrics …}"
  (telemetry/runtime-snapshot))

(defn- collect-runtime (acc)
  "Drain the `[:system kind pid detail]` runtime events already in this process's
mailbox into a list of maps (chronological). Non-blocking: stops at the first empty
receive."
  (receive
    ([:system kind pid detail] (collect-runtime (cons {:kind kind :pid pid :detail detail} acc)))
    (after 0 (reverse acc))))

(defn watch-runtime-tool (args)
  "`watch-runtime` — collect the kernel runtime-event STREAM (a trace, not a
snapshot) for a bounded window, then return it. Arms `proc/system-monitor` on this
handler process, sleeps `:ms`, disarms, and drains the collected
`[:system kind pid detail]` events. Kinds: `:gc` (detail `{:pause-us :collections
:live}`), `:spawn` (detail = parent pid), `:exit` (detail = the structured exit
reason), `:deopt` (detail = the JIT arm's fn name or nil). This is how an agent
WATCHES the runtime (GC pauses, spawn/exit churn, JIT deopts) over an interval,
complementing the point-in-time `processes`/`node` snapshots.

    (mcp/watch-runtime-tool {:ms 1000 :filter {:gc true}})   ;~> {:events [{:kind :gc :pid … :detail {:pause-us 140 …}} …] :count 3 :ms 1000}"
  (let (
        ; self-cap the window at 5 s
        ms (math/min (or (get args :ms) 500) 5000)
        opt (get args :filter))
    ; e.g. {:gc true :gc-min-pause-us 1000}
    ;; Our own subscription (one per pid, ADR-305 — it coexists with the crash
    ;; reporter's); arm on ourselves, then clear ours on the way out so we never leak
    ;; it across calls. Events about the subscriber itself are never sent, so we only
    ;; ever collect OTHER processes' activity.
    (if opt (proc/system-monitor (self) opt) (proc/system-monitor (self)))
    (proc/sleep ms)
    ; disarm before draining
    (proc/system-monitor nil)
    (let (events (into [] (collect-runtime '())))
      ; [] (not nil) when empty
      {:events events :count (count events) :ms ms})))

(defn callers-tool (args)
  "`callers` — every reference to the global `:name` across the project's source
and test files, as `{:references [{:file :line :col} ...]}` (1-based line/col).
Cross-file under the flat module model (ADR-019): a global is one binding
everywhere, so this is the union over every project file; locals that merely
share the spelling are excluded. Source-occurrence based (ADR-031) — references
synthesised by macros aren't included. Complements `lookup` (which gives the
*definition* site): this gives the *use* sites.

    (mcp/callers-tool {:name \"app/parse\"})   ;~> {:references [{:file \"src/app.blsp\" :line 40 :col 7} …]}"
  (let (name (get args :name))
    (when (not (string? name))
      (throw "callers: :name must be a string"))
    {:references (mapcat (project-check/all-files project/*root*)
                   (fn (f)
                     (try
                       (map (reflect/references-in-source name (file/slurp f))
                         (fn (lc) {:file f :line (first lc) :col (second lc)}))
                       (catch _ nil))))}))

(defn apropos-tool (args)
  "`apropos` — discover globals whose name contains a pattern. Returns
`{:matches [name ...]}` (names as strings, sorted). The way to answer \"does X
exist?\" without guessing names one at a time.

    (mcp/apropos-tool {:pattern \"starts-with\"})   ;~> {:matches (\"string/starts-with?\" …)}"
  (let (pattern (get args :pattern))
    (when (not (string? pattern))
      (throw "apropos: :pattern must be a string"))
    {:matches (map (reflect/apropos pattern) ->string)}))

(defn all-globals-tool (args)
  "`all-globals` — every globally bound name in the image. Returns
`{:globals [name ...]}` (sorted strings).

    (mcp/all-globals-tool {})   ;~> {:globals […every bound name, as sorted strings…]}"
  {:globals (map (reflect/global-names) ->string)})

(defn doc-search-tool (args)
  "`doc-search` — find globals whose docstring contains a query string. Returns
`{:results [{:name :doc} ...]}` — searches behaviour, not just names.

    (mcp/doc-search-tool {:query \"grapheme\"})   ;~> {:results [{:name \"string/graphemes\" :doc \"…\"} …]}"
  (let (query (get args :query))
    (when (not (string? query))
      (throw "doc-search: :query must be a string"))
    {:results (map (reflect/doc-search query)
                (fn (pair) {:name (->string (first pair)) :doc (second pair)}))}))

(defn explain-error-tool (args)
  "`error` — explain a Brood error code (or a caught error's `:code`).
Returns `{:code :summary :causes :fix :example}` from the curated catalogue
(`std/tool/explain.blsp`). The teach-the-error tool: an agent that hits `E0044`
gets the tail-recursion fix, not just the message.

    (mcp/explain-error-tool {:code \"E0044\"})   ;~> {:code \"E0044\" :summary \"…\" :causes … :fix \"…\" :example \"…\"}"
  (let (code (get args :code))
    (when (not (string? code))
      (throw "error: :code must be a string (e.g. \"E0030\")"))
    (explain/error code)))

(defn find-pattern-tool (args)
  "`find-pattern` — the idiomatic Brood pattern for a task/intent (a keyword
search over the intent→idiom cookbook). Returns `{:matches [{:intent :idiom
:example :see} ...]}`. Use it BEFORE writing non-obvious code — 'how do I loop /
mutate / build a string / spawn a worker' — to get the Brood way instead of a
Clojure/Scheme reflex."
  (let (query (get args :query))
    (when (not (string? query))
      (throw "find-pattern: :query must be a string"))
    (find-pattern query)))

(defn- bench-loop (form n)
  "Eval `form` `n` more times for timing, discarding the results; returns nil."
  (when (> n 0)
    (reflect/eval form)
    (bench-loop form (- n 1))))

(defn bench-tool (args)
  "`bench` — time evaluating `:source` in the session image. Runs it
`:iterations` times (default 1) and returns `{:ms total :iterations n
:per-iter-ms float :value pr-str-of-last-result}`. Resolution is the
millisecond `now` clock, so time a sub-millisecond expression with a larger
`:iterations` to amortise it. Side effects persist — it really runs the code,
like `reflect/eval`. Returns `{:error msg}` on failure.

    (mcp/bench-tool {:source \"(sort (range 1000))\" :iterations 100})   ;~> {:ms 12 :iterations 100 :per-iter-ms 0.12 :value \"(0 1 2 …)\"}"
  (let (src (get args :source)
        iters (or (get args :iterations) 1))
    (when (not (string? src))
      (throw "bench: :source must be a string"))
    (when (not (and (int? iters) (> iters 0)))
      (throw "bench: :iterations must be a positive integer"))
    (attempt (fn ()
               (let (form (reflect/read-first src)
                     started (os/now)
                     value (reflect/eval form)
                     _done (bench-loop form (- iters 1))
                     total (- (os/now) started))
                 {:ms total
                  :iterations iters
                  :per-iter-ms (/ (* 1.0 total) iters)
                  :value (pr-str value)}))
      (fn (shape) {:error shape}))))

;; ---- ability / record introspection ----------------------------------------

(defn- op-provided? (spec)
  "Does an op spec `(->string (params) :-> ret? body…)` carry a body (a provided
default) rather than being a bare required op? Skip the name + params, then the
optional `:-> ret`, and check whether anything remains."
  (let (tail (drop spec 2)
        tail (if (= (first tail) :->) (drop tail 2) tail))
    (not (empty? tail))))

(defn- ability-impls (aname ops)
  "The type keys (as strings) that implement any op of ability `aname`, unioned
across its ops via the `*impls*` registry."
  (let (op-names (map ops first)
        type-keys (fold op-names
                    #{}
                    (fn (acc op)
                      (let (methods (get *impls* [aname op]))
                        (if methods (into acc (keys methods)) acc)))))
    (sort (map (vec type-keys) ->string))))

(defn abilities-tool (args)
  "`abilities` — list every ability defined in the image, sorted. Returns
`{:abilities [name …]}`. The discovery entry point for `ability`.

    (mcp/abilities-tool {})   ;~> {:abilities (…every ability name, sorted…)}"
  {:abilities (sort (map (keys *abilities*) str))})

(defn ability-tool (args)
  "`ability` — describe one ability: its ops (each with params and whether it's a
provided default), whether it's sealed and its member types, what it `:requires`,
its owner namespace, whether it's derivable, and which types implement it. Returns
`{:name :ops :sealed :members :requires :owner :derivable :impls}`, or
`{:name :error}` when `:name` isn't a known ability.

    (mcp/ability-tool {:name \"Display\"})   ;~> {:name … :ops […] :sealed false :members … :requires … :owner … :derivable … :impls […]}"
  (let (name-str (get args :name))
    (when (not (string? name-str))
      (throw "ability: :name must be a string"))
    (let (aname (reflect/read-string name-str))
      (if (not (contains? *abilities* aname))
        {:name name-str :error (str "not an ability: " name-str)}
        (let (ops (%ability-ops aname)
              members (%sealed-members aname)
              reqs (%ability-requires aname)
              owner (%ability-owner-ns aname))
          {:name name-str
           :ops (map ops
                  (fn (spec)
                    {:op (str (first spec))
                     :params (map (second spec) str)
                     :provided (op-provided? spec)}))
           :sealed (not (nil? members))
           :members (if members (map members ->string) [])
           :requires (if reqs (map reqs str) [])
           :owner (if owner (str owner) nil)
           :derivable (not (nil? (%ability-derive-recipe aname)))
           :impls (ability-impls aname ops)})))))

(defn check-source-tool (args)
  "`check-source` — advisory type-check a source STRING (not the whole project),
for iterating on a snippet before committing it to a file. Returns
`{:diagnostics [{:line :col :message} …]}` — empty when clean or when `:source`
doesn't parse (incomplete input). Backed by `check-string-structured`.

    (mcp/check-source-tool {:source \"(defn f (x) (+ x \\\"a\\\"))\"})   ;~> {:diagnostics [{:line 1 :col 17 :message \"…\"}]}"
  (let (src (get args :source))
    (when (not (string? src))
      (throw "check-source: :source must be a string"))
    (attempt (fn () {:diagnostics (or (reflect/check-string-structured src) [])})
      (fn (shape) {:error shape}))))

;; ---- catalogue -------------------------------------------------------------

(defn tools ()
  "The tool catalogue `nest mcp` reads on every `tools/list`/`tools/call`.
A project's own `mcp.blsp` (loaded after this) can replace `tools` with
its own list that conses additional entries onto this one — `def` rebinds
globals (ADR-013), so the dispatcher sees the project's version on its next
fetch.

Twenty-four tools work today (in a project context — `write`/`edit` need a root):
the eight v0 tools, the ability/type introspection trio `abilities` / `ability`
(describe an ability's ops, sealed members, `:requires`, impls) / `check-source`
(type-check a snippet string), `callers` (cross-file
find-references), the three discovery tools `apropos` / `all-globals` /
`doc-search` (search the flat namespace by name or docstring rather than
looking up a name you already know), `bench` (time an expression in the
live image), the runtime-introspection pair `proc/info` (one process's
stats by id) and `node` (runtime-wide stats) plus `watch-runtime` (the
runtime-event STREAM — GC/spawn/exit/deopt over an interval, a trace not a
snapshot) — which, with the now-enriched
`processes`, give an agent the same live view the observer
(`std/tool/observer.blsp`) shows — the project-scoped editing pair `write`
(create/overwrite a file) and `edit` (exact-string replace), both sandboxed
under `project/*root*` so an agent writes code *through* nest mcp rather than
the raw filesystem, and the LLM-native pair `error` (a stable error
code → its Brood-idiomatic fix) and `find-pattern` (an intent → the idiomatic
Brood pattern, `std/tool/explain.blsp`)."
  (list {:name "eval"
         :description "Evaluate a Brood expression in the session's global environment. State persists across calls (hot reload — `def` mutates the runtime image, ADR-013)."
         :schema {:type "object"
                  :properties {:source {:type "string" :description "Brood source to evaluate"}}
                  :required ["source"]}
         :handler eval-tool}
    {:name "load"
     :description "Load a `.blsp` file into the session's image. Side-effects (def/defn/defmacro) persist."
     :schema {:type "object"
              :properties {:file {:type "string" :description "Path to a .blsp file"}}
              :required ["file"]}
     :handler load-tool}
    {:name "write"
     :description "Create or overwrite a project file (the way to write code through nest mcp, not the raw filesystem). :path is project-relative and sandboxed under the project root — absolute paths, '~', and '..' are rejected. A .blsp file is loaded into the session and checked, so the result carries :diagnostics + :shadows like `reflect/load`. Returns {:ok true :path :diagnostics :shadows} or {:ok false :error}."
     :schema {:type "object"
              :properties {:path {:type "string"
                                  :description "Project-relative file path (no leading '/' or '~', no '..')"}
                           :content {:type "string" :description "Full new file contents"}}
              :required ["path" "content"]}
     :handler write-tool}
    {:name "edit"
     :description "Exact-string replacement in a project file (sandboxed like `write`). :old must occur exactly once in the file and is replaced by :new. A .blsp file is reloaded and checked (result carries :diagnostics/:shadows). Returns {:ok true :path ...} or {:ok false :error}."
     :schema {:type "object"
              :properties {:path {:type "string"
                                  :description "Project-relative file path (no leading '/' or '~', no '..')"}
                           :old {:type "string"
                                 :description "Exact text to replace — must be unique in the file"}
                           :new {:type "string" :description "Replacement text"}}
              :required ["path" "old" "new"]}
     :handler edit-tool}
    {:name "lookup"
     :description "Look up a global name: returns its arglist, docstring, type signature (the checker's arrow string, e.g. \"(int -> int)\"), and source location (file/line/col)."
     :schema {:type "object"
              :properties {:name {:type "string"
                                  :description "The name to look up (no leading quote)"}}
              :required ["name"]}
     :handler lookup-tool}
    {:name "abilities"
     :description "List every ability (generic-function interface) defined in the image, sorted. Returns {:abilities [name ...]}. The discovery entry point — pass a name to `ability` for details."
     :schema {:type "object" :properties {}}
     :handler abilities-tool}
    {:name "ability"
     :description "Describe an ability: its ops (each with params and whether it's a provided default), whether it's :sealed and its member types, what it :requires (super-abilities), its owner namespace, whether it's derivable (:derives), and which types implement it. Returns {:name :ops :sealed :members :requires :owner :derivable :impls}, or {:name :error} for an unknown name. Use it to understand a dispatch point before writing an `impl`."
     :schema {:type "object"
              :properties {:name {:type "string"
                                  :description "The ability name (no leading quote), e.g. \"Display\""}}
              :required ["name"]}
     :handler ability-tool}
    {:name "check-source"
     :description "Advisory type-check a source STRING (not the whole project) — for iterating on a snippet before writing it to a file. Returns {:diagnostics [{:line :col :message} ...]}, empty when clean. Complements `check` (whole project) and `reflect/eval` (which runs code without type advice)."
     :schema {:type "object"
              :properties {:source {:type "string" :description "Brood source to type-check"}}
              :required ["source"]}
     :handler check-source-tool}
    {:name "macroexpand"
     :description "Macro-expand a form. Default is one step (`:mode \"1\"`); pass `:mode \"all\"` for full expansion."
     :schema {:type "object"
              :properties {:form {:type "string" :description "Source for the form to expand"}
                           :mode {:type "string"
                                  :seq ["1" "all"]
                                  :description "\"1\" (default) or \"all\""}}
              :required ["form"]}
     :handler macroexpand-tool}
    {:name "format"
     :description "Reformat Brood source. Idempotent — formatting the result is a fixed point."
     :schema {:type "object"
              :properties {:source {:type "string" :description "Brood source to reformat"}}
              :required ["source"]}
     :handler format-tool}
    {:name "check"
     :description "Advisory type-check the project. Returns one diagnostic per warning ({:diagnostics [...]})."
     :schema {:type "object" :properties {}}
     :handler check-tool}
    {:name "run-tests"
     :description "Run the project test suite. Returns the structured runner result ({:total :passed :failed ...})."
     :schema {:type "object" :properties {}}
     :handler run-tests-tool}
    {:name "processes"
     :description "Snapshot every live green process with its runtime stats — id, name, status, mailbox backlog, memory, GC collections, cumulative reductions (the work counter), monitors and parent. The same per-process view the observer shows. Returns {:processes [{:id :status :mailbox :reductions ...} ...]}. Sort by :reductions to find the busiest process."
     :schema {:type "object" :properties {}}
     :handler processes-tool}
    {:name "process-info"
     :description "Full stat map for one process by numeric :id (from a `processes` listing): status, mailbox, memory, collections, reductions, monitors, parent. Returns the proc/info map, or {:error msg} if no live process has that id."
     :schema {:type "object"
              :properties {:id {:type "integer"
                                :description "The numeric process id (as shown in `processes`)"}}
              :required ["id"]}
     :handler process-info-tool}
    {:name "node"
     :description "Runtime-wide stats (the observer's header): node name, scheduler worker count, peak concurrency, total spawned, current live-process count, current/peak memory, connected peers. Returns {:node :workers :peak-threads :spawned :process-count :mem-bytes :mem-peak :peers}."
     :schema {:type "object" :properties {}}
     :handler node-tool}
    {:name "vitals"
     :description "The unified runtime snapshot behind ONE call (telemetry/runtime-snapshot): {:gc {…} :sched {…} :vm {…} :processes N :metrics {…}} — GC, scheduler and VM stats plus the live-process count and current telemetry metrics, instead of scraping the individual stat builtins. The point-in-time companion to `watch-runtime` (which streams events over an interval)."
     :schema {:type "object" :properties {}}
     :handler vitals-tool}
    {:name "watch-runtime"
     :description "Watch the kernel runtime-event STREAM (a trace, not a snapshot) for :ms milliseconds (default 500, capped 5000), then return the collected events: {:events [{:kind :pid :detail} ...] :count :ms}. Kinds: :gc (detail {:pause-us :collections :live}), :spawn (detail=parent pid), :exit (detail=exit reason), :deopt (detail=JIT fn name or nil). Use it to SEE runtime activity over an interval — GC pauses, spawn/exit churn, JIT deopts — that a point-in-time `processes`/`node` snapshot can't show. Pass :filter (e.g. {:gc true :gc-min-pause-us 1000 :exit true}) to select kinds. Events about the watcher itself are excluded."
     :schema {:type "object"
              :properties {:ms {:type "integer"
                                :description "How long to watch, in milliseconds (default 500, capped at 5000)"}
                           :filter {:type "object"
                                    :description "Optional kind selector, e.g. {\"gc\": true, \"exit\": true, \"gc-min-pause-us\": 1000}; omit to collect every kind"}}}
     :handler watch-runtime-tool}
    {:name "callers"
     :description "Find every reference to a global name across the project's source and test files (cross-file find-references). Returns {:references [{:file :line :col} ...]}. Complements `lookup`, which gives the definition site."
     :schema {:type "object"
              :properties {:name {:type "string"
                                  :description "The global name to find references to (no leading quote)"}}
              :required ["name"]}
     :handler callers-tool}
    {:name "apropos"
     :description "Discover globals whose name contains a pattern (string/substring search over the flat namespace). Returns {:matches [name ...]}. Use this to find out whether something exists before guessing exact names."
     :schema {:type "object"
              :properties {:pattern {:type "string"
                                     :description "Substring to search for in global names"}}
              :required ["pattern"]}
     :handler apropos-tool}
    {:name "all-globals"
     :description "List every globally bound name in the image (prelude + project), sorted. Returns {:globals [name ...]}."
     :schema {:type "object" :properties {}}
     :handler all-globals-tool}
    {:name "doc-search"
     :description "Find globals whose docstring contains a query string — searches behaviour, not just names. Returns {:results [{:name :doc} ...]}. Complements apropos (which matches names)."
     :schema {:type "object"
              :properties {:query {:type "string" :description "Text to search for in docstrings"}}
              :required ["query"]}
     :handler doc-search-tool}
    {:name "bench"
     :description "Time evaluating a Brood expression in the session image. Runs it :iterations times (default 1) and returns {:ms :iterations :per-iter-ms :value}. Side effects persist (it really runs the code). Raise :iterations to amortise sub-millisecond expressions against the ms clock."
     :schema {:type "object"
              :properties {:source {:type "string" :description "Brood source to time"}
                           :iterations {:type "integer"
                                        :description "How many times to run it (default 1); raise to amortise sub-ms expressions"}}
              :required ["source"]}
     :handler bench-tool}
    {:name "error"
     :description "Explain a Brood error code (e.g. \"E0030\", \"E0044\") — or the :code from a caught error map. Returns {:code :summary :causes :fix :example}: what it means, why it happens, and the Brood-idiomatic fix. Call it when a tool result or the check tool surfaces an error code you want to resolve, not just describe."
     :schema {:type "object"
              :properties {:code {:type "string" :description "The error code, e.g. \"E0030\""}}
              :required ["code"]}
     :handler explain-error-tool}
    {:name "find-pattern"
     :description "The idiomatic Brood pattern for a task — a keyword search over the intent→idiom cookbook. Returns {:matches [{:intent :idiom :example :see} ...]}. Query with a task word like \"loop\", \"mutate\", \"build a string\", \"set\", \"spawn\", \"error\", \"parse binary\". Use it BEFORE writing non-obvious code to get the Brood way instead of a Clojure/Scheme reflex."
     :schema {:type "object"
              :properties {:query {:type "string"
                                   :description "A task/intent word, e.g. \"loop\" or \"mutable state\""}}
              :required ["query"]}
     :handler find-pattern-tool}))

;; ---- the server: JSON-RPC 2.0 over stdio ------------------------------------
;;
;; The MCP stdio transport is newline-delimited JSON — one message per line, NOT LSP's
;; `Content-Length` framing (a real client never completes `initialize` against that).
;; One reply per request, none for a notification; a line that does not parse is
;; answered `-32700` and the session keeps serving.
;;
;; A `tools/call` handler runs in a process of its own, monitored by the dispatcher: its
;; stdout is captured there (the channel stays pure JSON; the text rides back as a second
;; content block), `eval`/`load` are killed past a deadline, and a handler process that
;; dies — a Rust panic in a primitive included — becomes an error reply while the session
;; keeps serving.

(def- protocol-version "2024-11-05")

;; The tools whose handler runs arbitrary, possibly-runaway code, so runs under the
;; deadline. The rest are fast, or legitimately long (`run-tests`), and run unbounded.
(def- deadline-tools #{"eval" "load"})
(def- tool-deadline-ms 30000)

;; How long an unbounded handler is waited on before the dispatcher re-arms its wait.
(def- unbounded-wait-ms 60000)

;; The reference texts `resources/read` and `prompts/get` serve, keyed by name. `nest`
;; binds it around the server with the documents its binary embeds (the docs and the
;; prelude source), so an agent reads them without filesystem access.
(defdyn mcp/*documents* {})

;; Inside a handler whose `tools/call` carried `_meta.progressToken`: `{:to dispatcher
;; :call handler-pid}`, where [[progress]] sends its reports. Nil otherwise.
(defdyn mcp/*progress-sink* nil)

(def- resources
  [{:uri "brood://docs/brood-for-claude"
    :name "Brood for Claude (pocket reference)"
    :document "brood-for-claude"}
    {:uri "brood://docs/incarnations"
     :name "Incarnations — what tripped up prior agents"
     :document "incarnations"}
    {:uri "brood://docs/llm-native"
     :name "Making Brood LLM-native (forward-looking plan)"
     :document "llm-native"}
    {:uri "brood://docs/claude-demo-findings"
     :name "Claude Opus 4.7 — concurrent Mandelbrot findings (2026-05-28)"
     :document "claude-demo-findings"}
    {:uri "brood://docs/language" :name "Brood language reference" :document "language"}
    {:uri "brood://docs/decisions" :name "Architecture decision records" :document "decisions"}
    {:uri "brood://docs/types" :name "Type system contract" :document "types"}
    {:uri "brood://docs/error-codes"
     :name "Stable error codes (`E0010`, `E0030`, …) and the catch shape"
     :document "error-codes"}
    {:uri "brood://prelude" :name "Brood prelude source" :document "prelude"}])

(defn progress (progress &optional (total nil) (message nil))
  "Report incremental progress from a `nest mcp` tool handler: `progress` units done,
optional `total` (the denominator) and `message` (a label). Streams a
`notifications/progress` to the client when the current `tools/call` carried a
`_meta.progressToken`; a no-op otherwise, so it is safe to call from any handler.
Returns true if a report was sent.

    (mcp/progress 1 3 \"step one\")   ;=> false"
  (let (sink mcp/*progress-sink*)
    (if (nil? sink)
      false
      (do
        (send (get sink :to)
          [:mcp-progress (get sink :call) {:progress progress :total total :message message}])
        true))))
;; Declared so `nest check` types the call in `project-check` from the image, without
;; loading this module.
(sig progress (int &optional (or int nil) (or string nil) -> bool))

;; ---- Brood data -> JSON data ------------------------------------------------

(defn- json-key (k)
  "The JSON object key for map key `k`: a string as-is, a keyword or symbol by name."
  (cond
    (string? k) k
    (or (keyword? k) (symbol? k)) (->string k)
    else (error "mcp: a JSON object key must be a string, keyword or symbol, got a " (type-of k))))

(defn- handle-spelling (v kind)
  "The inside of a handle's printed form `#<kind …>`."
  (let (printed (str v))
    (string/substring printed (+ 3 (string/length kind)) (- (string/length printed) 1))))

(defn- pid-data (pid)
  "A pid as the tagged object `{\"$type\" \"pid\" \"node\" … \"id\" …}`: recognisable to an
agent, never something it could turn back into a live mailbox."
  (let (spelling (handle-spelling pid "pid")
        slash (string/last-index-of spelling "/"))
    {"$type" "pid"
     "node" (string/substring spelling 0 slash)
     "id" (string/->number (string/substring spelling (+ slash 1)))}))

(defn- json-object (m)
  "Map `m` as a JSON object. String, keyword and symbol keys share one JSON key, so a
collision is an error rather than a silently dropped entry."
  (fold m
    {}
    (fn (acc [k v])
      (let (key (json-key k))
        (if (contains? acc key)
          (error "mcp: map has colliding JSON key "
            (pr-str key)
            " (string/keyword/symbol keys share one JSON key — one would silently win)")
          (assoc acc key (json-data v)))))))

(defn- json-data (v)
  "`v` projected onto what JSON carries, ready for `json/encode`: keywords and symbols by
name, an exact number JSON cannot hold (bignum, ratio, decimal) and a failure's message as
strings, any sequence or set as an array, a pid or ref as a `$type`-tagged object. Errors on
a value with no JSON shape — a function, a table, a non-finite float — so a tool returning
one fails loudly instead of dropping data."
  (cond
    ;; First: a range reads as a pair to the checker, and `range?` does not narrow.
    (range? v) (into [] (map v json-data))
    (or (nil? v) (bool? v) (string? v)) v
    (failure? v) (error-message v)
    (float? v)
      (if (or (math/nan? v) (math/infinite? v))
        (error "mcp: non-finite float " v " can't be represented in JSON")
        v)
    (and (int? v) (>= v -9223372036854775808) (<= v 9223372036854775807)) v
    (number? v) (str v)
    (or (keyword? v) (symbol? v)) (->string v)
    (pid? v) (pid-data v)
    (ref? v) {"$type" "ref" "id" (string/->number (handle-spelling v "ref"))}
    (map? v) (json-object v)
    (or (list? v) (vector? v) (set? v)) (into [] (map v json-data))
    else (error "mcp: a " (type-of v) " has no JSON representation")))

(defn- pretty-json (v indent)
  "JSON data `v` as indented text — two spaces a level, object keys sorted — the form a
tool result takes in its content block."
  (let (inner (str indent "  "))
    (cond
      (and (map? v) (not (empty? v)))
        (str "{\n"
          (string/join (map (sort (keys v))
                         (fn (k) (str inner (json/encode k) ": " (pretty-json (get v k) inner))))
            ",\n")
          "\n"
          indent
          "}")
      (and (vector? v) (not (empty? v)))
        (str "[\n"
          (string/join (map v (fn (x) (str inner (pretty-json x inner)))) ",\n")
          "\n"
          indent
          "]")
      else (json/encode v))))

(defn- brood-arguments (v)
  "Decoded JSON `arguments` as a handler receives them: arrays as lists, so a handler can
walk them with `first`/`rest`."
  (cond
    (map? v) (into {} (map v (fn ([k x]) [k (brood-arguments x)])))
    (vector? v) (apply list (map v brood-arguments))
    else v))

;; ---- replies ----------------------------------------------------------------

(defn- rpc-error (code message) {:code code :message message})

(def- error-labels
  {:user "error:"
   :parse "parse error:"
   :unbound "unbound error:"
   :arity "arity error:"
   :type "type error:"
   :runtime "runtime error:"})

(defn- raised-error (e error)
  "The JSON-RPC error for value `e` a handler raised and did not catch, `error` the raise's
description from `%try-described`. A kernel error is a map (`{:kind :message :code …}`, the
shape `catch` binds) and travels whole in `data`, so an agent branches on
`error.data.kind`; anything else a handler threw is `:user`, with the raise's
`file`/`line`/`col`/`trace` beside its message."
  (if (and (map? e) (contains? e :kind) (contains? e :message))
    {:code -32603
     :message (str (or (get error-labels (get e :kind)) "error:") " " (get e :message))
     :data (try
             (json-data e)
             (catch _ {"kind" (str (get e :kind)) "message" (str (get e :message))}))}
    (let (message (if (string? e) e (pr-str e)))
      {:code -32603
       :message (str "error: " message)
       :data (json-data (assoc (dissoc error :code :hint) :kind "user" :message message))})))

(defn- died-error (reason)
  "The JSON-RPC error for a handler process that died rather than answering — a Rust panic
inside a primitive kills only that process (exit reason `:killed`)."
  (let (detail (str "the handler's process died ("
                 (pr-str reason)
                 ") — the panic message is on the server's stderr and in .brood_crash_dump"))
    {:code -32603
     :message (str "panic in tool handler: " detail)
     :data {"kind" "panic"
            "message" detail
            "hint" "interpreter bug — the tool handler triggered a Rust panic. Subsequent calls on this session continue to work."}}))

(defn- tool-content (data output)
  "MCP's `tools/call` result for handler result `data`: one text block (a string as-is,
anything else as indented JSON), plus a labelled block of whatever the handler printed.
A map with a non-null `error` is a soft failure, so the result says `isError`."
  (let (text (if (string? data) data (pretty-json data ""))
        blocks (if (empty? output)
                 [{:type "text" :text text}]
                 [{:type "text" :text text} {:type "text" :text (str "[captured stdout]\n" output)}]))
    (if (and (map? data) (not (nil? (get data "error"))))
      {:content blocks :isError true}
      {:content blocks})))

(defn- progress-notification (token report)
  "The `notifications/progress` message for `report` under the request's progress `token`."
  (let (base {:progressToken token :progress (get report :progress)}
        with-total (if (nil? (get report :total)) base (assoc base :total (get report :total)))
        params (if (nil? (get report :message))
                 with-total
                 (assoc with-total :message (get report :message))))
    {:jsonrpc "2.0" :method "notifications/progress" :params params}))

;; ---- tools/call ----------------------------------------------------------------

(defn- run-handler (handler arguments dispatcher reports-progress)
  "The body of a handler's own process: run `handler` on `arguments` with stdout captured
and send the outcome to `dispatcher`, already projected to JSON data."
  (%capture-begin)
  (let (sink (if reports-progress {:to dispatcher :call (self)} nil)
        outcome (%try-described (fn ()
                                  (let (value (binding (mcp/*progress-sink* sink)
                                                (handler arguments)))
                                    (try
                                      [:ok (json-data value)]
                                      (catch e [:unencodable (error-message e)]))))
                  (fn (caught error) [:raised caught error]))
        output (or (%capture-take) ""))
    (send dispatcher [:mcp-outcome (self) outcome output])))

(defn- await-outcome (call)
  "Wait for the handler process in `call`, forwarding its progress reports, until it
answers, dies, or overruns `:deadline` (epoch ms, nil for none) and is killed."
  (let (pid (get call :pid)
        ref (get call :ref)
        deadline (get call :deadline))
    (receive
      ([:mcp-progress ^pid report] ((get call :emit) (progress-notification (get call :token)
                                                       report))
        (await-outcome call))
      ([:mcp-outcome ^pid outcome output] (receive ([:down ^ref _ _] nil))
        (if (= (first outcome) :ok) [:ok (second outcome) output] outcome))
      ([:down ^ref _ reason] [:died reason])
      (after (if (int? deadline) (math/max 0 (- deadline (os/now))) unbounded-wait-ms)
        (if deadline
          (do
            (exit pid :kill)
            (receive ([:down ^ref _ _] nil))
            [:timed-out])
          (await-outcome call))))))

(defn- call-reply (outcome)
  "The `[status payload]` reply for a handler's outcome."
  (case (first outcome)
    :ok [:ok (tool-content (nth outcome 1) (nth outcome 2))]
    :raised [:error (raised-error (nth outcome 1) (nth outcome 2))]
    :unencodable [:error (rpc-error -32603 (nth outcome 1))]
    :died [:error (died-error (nth outcome 1))]
    [:ok
      (tool-content {"error" {"kind" "runtime"
                              "message" "evaluation exceeded its time limit (MCP tool watchdog)"}}
        "")]))

(defn- catalogue (session)
  "The session's current tool catalogue, re-read on every request so a hot-reloaded
`tools` takes effect at once; empty if building it fails."
  ;; check-allow :discarded-catch — a broken catalogue serves no tools rather than no server
  (check-allow :discarded-catch
    (try (into [] ((get session :catalogue))) (catch _ []))))

(defn- listed-tool (entry)
  "Catalogue `entry` in the `tools/list` shape, or nil when it is malformed — one bad entry
does not hide the rest."
  (when (and (map? entry) (string? (get entry :name)) (contains? entry :schema))
    ;; check-allow :discarded-catch — an entry whose schema has no JSON shape is skipped
    (check-allow :discarded-catch
      (try
        (let (listed {:name (get entry :name) :inputSchema (json-data (get entry :schema))}
              description (get entry :description))
          (if (string? description) (assoc listed :description description) listed))
        (catch _ nil)))))

(defn- call-tool (params session)
  "`tools/call`: run the named tool's handler on the request's `arguments`."
  (let (name (get params :name)
        entry (and (string? name)
                (seq/find (catalogue session) (fn (e) (and (map? e) (= (get e :name) name))))))
    (cond
      (not (string? name)) [:error (rpc-error -32602 "missing 'name'")]
      (not entry) [:error (rpc-error -32602 (str "no such tool: " name))]
      else
        (let (meta (get params :_meta)
              token (if (map? meta) (get meta :progressToken) nil)
              arguments (brood-arguments (if (contains? params :arguments)
                                           (get params :arguments)
                                           {}))
              handler (get entry :handler)
              dispatcher (self)
              [pid ref] (spawn-monitor (run-handler handler arguments dispatcher (not (nil? token)))))
          (call-reply (await-outcome {:pid pid
                                      :ref ref
                                      :token token
                                      :emit (get session :emit)
                                      :deadline (if (contains? deadline-tools name)
                                                  (+ (os/now) (get session :deadline-ms))
                                                  nil)}))))))

;; ---- the other methods ------------------------------------------------------

(defn- initialize-result ()
  {:protocolVersion protocol-version
   :capabilities {:tools {} :resources {} :prompts {}}
   :serverInfo {:name "nest-mcp" :version (system/brood-version)}})

(defn- read-resource (params)
  (let (uri (get params :uri)
        resource (seq/find resources (fn (r) (= (get r :uri) uri)))
        text (if resource (get mcp/*documents* (get resource :document)) nil))
    (cond
      (not (string? uri)) [:error (rpc-error -32602 "missing 'uri'")]
      (not (string? text)) [:error (rpc-error -32602 (str "no such resource: " uri))]
      else [:ok {:contents [{:uri uri :mimeType "text/markdown" :text text}]}])))

;; The orientation prompt an agent fetches first (ADR-036): `docs/prompts/brood-task.md`,
;; a file other agent harnesses can drop into their own system prompts too.
(defn- get-prompt (params)
  (let (name (get params :name))
    (cond
      (not (string? name)) [:error (rpc-error -32602 "missing 'name'")]
      (not (= name "brood-task")) [:error (rpc-error -32602 (str "no such prompt: " name))]
      else
        [:ok
          {:description "Orient an agent for editing this Brood project"
           :messages [{:role "user"
                       :content {:type "text" :text (get mcp/*documents* "brood-task")}}]}])))

(defn- handle (message session)
  "The reply to one decoded JSON-RPC `message`: a response map, nil for a notification
(never answered), or `:exit`. A request for a method this server lacks is answered
`-32601`; an unknown notification is dropped, as JSON-RPC says."
  (cond
    (not (map? message)) nil
    (not (contains? message :id)) (if (= (get message :method) "exit") :exit nil)
    else
      (let (method (get message :method)
            raw-params (get message :params)
            params (if (map? raw-params) raw-params {})
            [status payload] (case method
                               "initialize" [:ok (initialize-result)]
                               "tools/list"
                                 [:ok
                                   {:tools (into []
                                             (seq/reject (map (catalogue session) listed-tool) nil?))}]
                               "tools/call" (call-tool params session)
                               "resources/list"
                                 [:ok
                                   {:resources (into []
                                                 (map resources
                                                   (fn (r)
                                                     {:uri (get r :uri)
                                                      :name (get r :name)
                                                      :mimeType "text/markdown"})))}]
                               "resources/read" (read-resource params)
                               "prompts/list"
                                 [:ok
                                   {:prompts [{:name "brood-task"
                                               :description "Orient an agent for editing this Brood project: language quirks, MCP tool list, and project conventions pointer."}]}]
                               "prompts/get" (get-prompt params)
                               "ping" [:ok {}]
                               "shutdown" [:ok nil]
                               [:error (rpc-error -32601 (str "method not found: " method))]))
        (if (= status :ok)
          {:jsonrpc "2.0" :id (get message :id) :result payload}
          {:jsonrpc "2.0" :id (get message :id) :error payload}))))

(defn- respond (line session)
  "The reply to one transport line — a line that is not JSON is answered `-32700`."
  (let (decoded (try [:ok (json/decode line)] (catch e [:unparsed (error-message e)])))
    (if (= (first decoded) :ok)
      (handle (second decoded) session)
      {:jsonrpc "2.0" :id nil :error {:code -32700 :message "Parse error" :data (second decoded)}})))

;; ---- staleness: a server whose binary was rebuilt under it ---------------------

(defn- rebuilt-since? (exe started)
  "Whether the executable at path `exe` was modified after `started` (epoch ms). False when
it cannot be read — never a false alarm."
  (let (mtime (if (string? exe) (file/mtime exe) nil))
    (and (int? mtime) (> mtime started))))

(defn- staleness-warning (exe)
  (str "⚠ nest mcp is serving a STALE runtime: "
    (or exe "the nest binary")
    " was rebuilt after this server started, so it is still running the old, pre-rebuild"
    " code. Restart the `nest mcp` server to pick up the new build — a stale server on a"
    " pre-fix binary caused the GC flush_oob crashes (docs/gc-flush-panic-2026-05-31.md)."
    " Results from this session may reflect the old runtime."))

(defn- with-warning (reply warning)
  "`reply` with `warning` appended as one more content block, when it is a successful
`tools/call` reply — the agent never sees the server's stderr. Nil for any other reply,
which leaves the warning pending for the next one that can carry it."
  (let (content (map/get-in reply [:result :content]))
    (if (vector? content)
      (map/assoc-in reply [:result :content] (conj content {:type "text" :text warning}))
      nil)))

(defn- notice-rebuild (session:map -> map)
  "`session`, with a staleness warning pending (and said once on stderr) the first time its
binary is seen rebuilt."
  (if (and (not (get session :warned)) (rebuilt-since? (get session :exe) (get session :started)))
    (let (warning (staleness-warning (get session :exe)))
      (io/puts warning :to *err*)
      (assoc (assoc session :warned true) :pending-warning warning))
    session))

;; ---- the loop -------------------------------------------------------------------

(defn- write-message (message)
  (io/write (str (json/encode message) "\n")))

(defn- serve-loop (session)
  (let (line (io/read-line))
    (cond
      (nil? line) 0
      (string/blank? line) (serve-loop session)
      else
        (let (noticed (notice-rebuild session)
              reply (respond line noticed))
          (cond
            (= reply :exit) 0
            (nil? reply) (serve-loop noticed)
            else
              (let (warning (get noticed :pending-warning)
                    carried (if warning (with-warning reply warning) nil))
                (write-message (or carried reply))
                (serve-loop (if carried (assoc noticed :pending-warning nil) noticed))))))))

(defn- project-catalogue ()
  "The served catalogue: the project's own `mcp-tools` when its `mcp.blsp` defines one —
typically `(defn mcp-tools () (cons {…} (mcp/tools)))`, extending this one — else [[tools]]."
  (if (bound? 'mcp-tools) ((reflect/eval 'mcp-tools)) (tools)))

(defn main ()
  "Serve the current project over MCP on stdin/stdout until the client hangs up or sends
`exit`, and return the exit code — what `nest mcp` runs. Loads the project's sources and
the tooling frameworks first (`project/setup-tooling-image`, shared with the LSP), then the
project's own `mcp.blsp` if it has one, which may define `mcp-tools` to extend or replace
the catalogue; anything that prints is discarded, since stdout is the JSON-RPC channel.

    (mcp/main)   ;~> 0 — the exit code once the client hangs up"
  (project/load-config)
  (let (root (project/require-root "nest mcp"))
    (project/setup-tooling-image root)
    (let (extensions (path/join root "mcp.blsp"))
      (when (file/exists? extensions)
        (with-out-str (reflect/load extensions))))
    (serve-loop {:catalogue project-catalogue
                 :emit write-message
                 :deadline-ms tool-deadline-ms
                 :exe (os/exe-path)
                 :started (os/now)
                 :warned false
                 :pending-warning nil})))
