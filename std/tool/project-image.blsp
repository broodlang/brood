;; std/tool/project-image.blsp

(defmodule project-image
  "The project startup image (ADR-218 for a project): fingerprint the project's sources,
write every module's bindings to one sectioned image, and materialise them on the next
run instead of re-evaluating source. `load-sources-cached` is the entry `project/setup`
takes; everything else is the mechanism behind it.")

(def *project-image-file* ".brood/image.bin")

;; The files the modules in the image spliced in with `include-str`, one absolute path per
;; line, written beside the image. Part of the staleness key (KI-275): the image holds what
;; a module built from that text, and a `.blsp`-only key served the old text after an edit.
;; Read before anything loads — which is why it is a file, not something the image carries.
(def- *project-image-includes-file* ".brood/image.includes")

;; What the partial rebuild needs to know about the image beside it (ADR-419), one readable
;; map: the fingerprint the image was stamped with (to open it after the tree moved on), its
;; global key (the build, the contract mode, the dependency and included files), each source
;; file's stamp, the registrations each project module's load wrote, and the modules whose
;; load evaluated source text. Read only when the full fingerprint misses.
(def- *project-image-modules-file* ".brood/image.modules")

;; A registry global is one that LOADING mutates rather than creates — `*impls*`,
;; `*methods*`, `*module-docs*`, … They already exist after the prelude, so the "names that
;; appeared" diff below cannot see them, and an image without them is silently wrong.
;;
;; Never NAME them here: a hand-maintained inclusion list fails in the silent direction,
;; because nothing about adding a registry reminds you the list exists.
;;
;; So the set is DERIVED: `%registry-update!` / `%registry-cas!` are the only ways a registry
;; is written, and the kernel records the names they write (`%registry-names`). A registry
;; added later is carried without anyone remembering to, and what is left below is an
;; EXCLUSION list — where forgetting an entry costs speed or a redundant load, never a wrong
;; answer.
(def *project-image-registry-exclusions*
  ;; `*features*` — with a sectioned image (ADR-218) `require` is what materialises a
  ;; module, so restoring a `*features*` that already lists every module makes `require-one`
  ;; early-return: nothing is ever loaded and the modules silently do not exist. `require`
  ;; re-provides each feature as it materialises it, and a feature with no section (a std
  ;; module pulled in during the build) is re-required from the embedded source, which is
  ;; idempotent and cheap.
  ['*features*
    ;; In-flight loads, keyed to the loader's pid — empty by the time an image is written,
    ;; and a pid is meaningless in the next process anyway.
    '*features-loading*
    ;; …and the processes parked on them (`%require-await`). Only a RACING requirer writes
    ;; it, so a sequential build never had one to carry — the parallel cold load (2026-10-23)
    ;; does, and pids of a finished build mean nothing in the next process.
    '*features-waiting*
    ;; ADR-070's dependency-module maps. The image already carries a dep's bindings, and
    ;; restoring these would only send `require` down the source-load branch for modules the
    ;; image can serve directly.
    '*module-files* '*package-modules-of*
    ;; ADR-606: the running project's own modules — registered by `setup` or a bundle's boot
    ;; before the image installs, and true of THIS run rather than the one that wrote it.
    '*project-modules*])

(defn image-path (root)
  "Where `root`'s startup image lives.

    (project-image/image-path \"/app\")   ;=> \"/app/.brood/image.bin\""
  (path/join root *project-image-file*))

;; The staleness key: every source file's path + size + mtime, plus the running
;; binary's build id. Any edit, add or delete changes it, as does a new `brood`.
;; Cheap — one `stat` per file, ~20 ms for 16 000 files — and it never says "fresh"
;; for a tree that has changed, which is the only direction that matters.
;; The project's source files, sorted so the fingerprint is stable across
;; directory-listing order.
(defn- sorted-source-files (root)
  (sort (project/source-files root)))

(defn- project-image-fingerprint (root)
  (fingerprint-of (sorted-source-files root)))

;; Split from `project-image-fingerprint` so a caller that already has the file list
;; (the loader, which wants to report the count) does not walk and stat the tree twice.
;; Public: `nest check`'s whole-project verdict replay (ADR-382) keys on the same string
;; over the project's source AND test files, so "nothing changed" means one thing.
(defn fingerprint-of (files)
  "The staleness key of the project as `files` plus its dependency files describe it: the
running binary's build id, then each file's path, size and mtime, one per line. Equal
strings mean nothing an image or a cached verdict depends on has changed; any edit, add,
delete or rebuild changes it. Requires `project/setup` to have run (the dependency files
come from `*module-files*`).

    (string/starts-with? (project-image/fingerprint-of nil) (system/build-id))   ;=> true"
  ;; Not hashed: the fingerprint is only ever compared for equality, and hashing
  ;; would pull `hash` into the loader's dependencies for nothing. Even 16 000 files
  ;; make ~1.5 MB, which is noise beside the image itself.
  ;;
  ;; DEPENDENCY files count too, because their bindings are in the image (ADR-070/218): a
  ;; dep lives outside `:source-paths` — in `_deps/`, or anywhere at all for a `:path` dep —
  ;; so the source-tree walk alone cannot see one change, and an imaged start would go on
  ;; serving the old code. They come from `*module-files*`, which `setup`
  ;; populates before any fingerprint is taken, on the cold and warm paths alike.
  ;;
  ;; INCLUDED files count for the same reason (KI-275): the image holds what a module built
  ;; from their text. The list is the one the last image write recorded; a missing one is
  ;; listed as missing, which changes the key just as an edit does.
  ;;
  ;; And the CONTRACT MODE (KI-276): an armed load binds each `sig`'d function to its contract
  ;; shim, so an image written armed and materialised unarmed ran the shims, and one written
  ;; unarmed served an armed run without its contracts. `nest test` arms by default and a
  ;; smoke or `nest run` may not, so the two met in one checkout and read wrong answers.
  (str (system/build-id)
    (if (%contracts-armed?) " contracts" "")
    "\n"
    (string/join (map (append files (project-dep-module-files) (project-included-files)) stamp-of)
      "\n")))

;; One file's part of the staleness key.
(defn- stamp-of (f)
  (if (file/exists? f) (str f ":" (file/size f) ":" (file/mtime f)) (str f ":missing")))

;; The part of the staleness key a partial rebuild cannot work around (ADR-419): the build, the
;; contract mode, and the dependency and included files. When it moved, every section may be
;; wrong — a new binary, or a dependency every module could have read — and the image is
;; rebuilt whole. Only the project's own source files are allowed to differ.
(defn- image-global-key ()
  (str (system/build-id)
    (if (%contracts-armed?) " contracts" "")
    "\n"
    (string/join (map (append (project-dep-module-files) (project-included-files)) stamp-of) "\n")))

;; The included files the last image write recorded for this project, or none.
(defn- project-included-files ()
  (let (root (when (bound? 'project/*root*) project/*root*)
        listing (when root (path/join root *project-image-includes-file*)))
    (if (and listing (file/exists? listing))
      (seq/reject (string/split (file/slurp listing) "\n") empty?)
      (list))))

;; The file behind every DEPENDENCY module, sorted for a stable fingerprint. A project roots
;; its own modules under its `:name` too (ADR-070), so both live in `*module-files*`
;; and the prefix is what separates them — the project's own files are already in the source
;; walk, and listing them twice would only make the key longer.
(defn- project-dep-module-files ()
  ;; `distinct`: a dep file declaring more than one module (ADR-223) now has one
  ;; `*module-files*` entry per module, all pointing at the same path — the
  ;; fingerprint wants each file once, not once per module it declares.
  (sort (seq/distinct (map (seq/reject (seq *module-files*)
                             (fn (entry) (not (project-image-dep-module? (first entry)))))
                        second))))

;; `before` as a SET. As a list, `member?` is a linear scan run once per global —
;; quadratic on a big project, the shape ADR-216 removed from `*features*`. Built once
;; and passed to both users below.
(defn- project-image-seen (before)
  (fold before {} (fn (m n) (assoc m n true))))

;; The globals the load CREATED: everything bound now that was not bound before it ran.
(defn- project-image-fresh-names (seen)
  (seq/reject (reflect/global-names) (fn (n) (contains? seen n))))

;; The registries the load MUTATED — derived from the funnel, minus the exclusions above,
;; minus any that ride their OWN materialised section (writing them here too would double
;; the entry). A registry the load created sections with its own module — but ONLY a
;; project/dep module's section is ever materialised from the image. A registry in a STD
;; module (`editor/layers/*type-layers*`, served from embedded source — its section is never
;; read back, see `project-image-sections`) or a root-level one has no section to ride, so it
;; MUST stay in root even though the load created it. Excluding it — as a bare `seen` test
;; did — dropped it from the image entirely: a deferred module's buffer type vanished on an
;; imaged start (register-type-layers runs at that module's load, which materialising skips).
(defn- project-image-registry-names (seen carried?)
  (seq/reject (%registry-names)
    (fn (n)
      (or (includes? *project-image-registry-exclusions* n)
        (and (not (contains? seen n))
          (let (mod (project-image-section-of n))
            (and mod (carried? mod))))))))

;; The module a global belongs to: its name minus the last segment, which IS the feature
;; name `require` uses (a global `myproj/shapes/area` comes from feature `myproj/shapes`).
;; nil for a root-level name — a registry, or a def from a file with no `defmodule`.
(defn- project-image-section-of (n)
  ;; One scan and one substring per name: this runs for every global the build created —
  ;; 208 000 on the 302-module rig — and splitting each name into a list and re-joining it
  ;; made the section grouping the largest step of a cold build after the load itself.
  ;; `/` alone (division) has its slash at 0: root, as the split made it.
  (let (s (->string n)
        i (%str-last-index-of s "/"))
    (if (> i 0) (string/substring s 0 i) nil)))

;; Whether module key `k` belongs to a DEPENDENCY rather than to this project. A project
;; roots its own modules under its `:name` (ADR-070) exactly as a dep's are rooted under
;; theirs, so both appear in `*module-files*` and membership alone does not separate
;; them — the prefix does. Used for the fingerprint (a dep's files are outside the source
;; walk, so they must be stat'd from the registry) rather than to exclude anything: a dep's
;; modules ARE imaged, which is why its files have to be in the staleness key.
(defn- project-image-dep-module? (k)
  (and (contains? *module-files* k)
    (not (= (first (string/split k "/")) (if project/*name* (->string project/*name*) nil)))))

;; Whether module `k` is one a project image carries: the project's own or a dependency's —
;; both live in `*module-files*` (a project roots its own modules under its `:name` too,
;; ADR-070). A release bundle's image (ADR-484) asks the same question of its own module
;; set, which is why every writer below takes the predicate rather than reading the registry.
(defn- project-module-carried? (k) (contains? *module-files* k))

;; Group the image's globals into per-module sections, so `require` can materialise one
;; module at a time (ADR-218). The `""` section is the one the loader always materialises,
;; and it carries the registries, the root-level defs (a file with no `defmodule`) and — added
;; by `%image-write` — the declared sigs. It is built even when every other name is
;; module-qualified.
;;
;; Registries go to `""` by NAME, not by spelling: a module-qualified one (a std module's
;; registry that this load happened to write) would otherwise be grouped into that module's
;; section, and a std feature is served from its embedded source rather than the image — so
;; the section would never be materialised and the registry silently lost, which is the whole
;; class this is guarding against.
(defn- image-sections (before carried?)
  (let (seen (project-image-seen before)
        fresh (project-image-fresh-names seen)
        grouped (fold fresh
                  {}
                  (fn (m n)
                    (let (k (or (project-image-section-of n) ""))
                      (assoc m k (cons n (or (get m k) nil))))))
        registries (project-image-registry-names seen carried?)
        _ (%set-project-image-credits! (image-credits registries carried?))
        root (append registries (get grouped "") ['*project-image-credits*]))
    (cons ["" root]
      (map
        (seq/reject (keys grouped)
          (fn (k)
            ;; A non-root section is materialised from the image only for a module the
            ;; image carries (`carried?`: the project's own and its dependencies). A
            ;; std/embedded module (regex, editor/ui, …) always loads from its baked-in
            ;; source, so its section would never be read back — writing it is dead
            ;; weight, and it is exactly where a runtime-only value like
            ;; `regex/regex-states-cache` (a mutable cache table) makes the whole image
            ;; write fail. Skip it. (Its bare globals still ride the always-materialised
            ;; root section; a builtin there images by name.)
            (or (= k "") (not (carried? k)))))
        (fn (k) [k (get grouped k)])))))

;; ── Who wrote what the image carries (ADR-595) ────────────────────────────────
;; The root section installs every registry's value WHOLE, so an entry a carried module's
;; load wrote is live from the install on — and the writer journal, a property of the loads
;; THIS process ran, had no writer for it: `registry/written-by` of an imaged module answered
;; nothing (KI-357). So the image carries who wrote each entry, and the install credits them
;; (`%registry-update! … :credit`) the moment the values land, while a list member's position
;; is still the one it was written at.

(defn- image-credit-writer? (writer carried?)
  ;; a carried module's load, or a namespace-less file's (its defs ride the root section)
  (or (string? writer) (and (symbol? writer) (carried? (->string writer)))))

(defn- image-credits (registries carried?)
  "`[registry path writer]` for every entry of `registries` a carried load wrote — a map
entry one or two keys deep by its key path, a list member by `[index]`."
  (fold registries
    []
    (fn (credits registry)
      (let (value (if (bound? registry) (reflect/eval registry) nil)
            credit (fn (found path)
                     (let (writer (%registry-writer registry path))
                       (if (image-credit-writer? writer carried?)
                         (conj found [registry path writer])
                         found))))
        (cond
          (map? value)
            (fold (%map-pairs value)
              credits
              (fn (found entry)
                (let ([outer inner] entry
                      writer (%registry-writer registry [outer]))
                  (cond
                    (image-credit-writer? writer carried?) (conj found [registry [outer] writer])
                    (and (nil? writer) (map? inner))
                      (fold (%map-pairs inner)
                        found
                        (fn (deeper pair) (credit deeper [outer (first pair)])))
                    else found))))
          (list? value)
            (second (fold (%registry-members registry)
                      [0 credits]
                      (fn (state row)
                        (let ([index found] state
                              writer (get row 1))
                          [(inc index)
                            (if (image-credit-writer? writer carried?)
                              (conj found [registry [index] writer])
                              found)]))))
          else credits)))))

(defn- image-entry-present? (value path)
  ;; whether registry value `value` holds an entry at key `path`, or any member at all
  (cond
    (map? value)
      (and (contains? value (first path))
        (or (= (count path) 1)
          (let (inner (get value (first path))) (and (map? inner) (contains? inner (second path))))))
    else (not (nil? value))))

(defn- image-credit-writes! (live)
  "Credit the writes the root section just installed to the loads that made them, except an
entry the registries held before the install (`live`, `[registry value]` pairs): the merge
after this gives that one back its live value, which is not the image's write."
  (let (before (fold live {} (fn (table pair) (%map-assoc table (first pair) (second pair)))))
    (doseq (credit (or (%project-image-credits) []))
      (let ([registry path writer] credit)
        (when (not (image-entry-present? (%map-get before registry nil) path))
          (%registry-update! registry :credit path nil writer))))))

(defn image-prune-foreign-registrations (before-regs:map &optional carried?:any -> int)
  "Remove from the live registries every registration OWNED by a module this project's
image does not carry — a std module (or anything else outside `*module-files*`) that
happened to be loaded in the session that built the image. Returns how many were removed.
`carried?` says which modules the image carries; it defaults to the project's (`*module-files*`),
and a release bundle passes its own module set (ADR-484).

The registries travel in the image's root section as whole values, and a value snapshot
carries the build session's load state with it: on 2026-09-03 the image of this very repo
held `:tempo/tempo`, `:pq/pq`, `:queue/queue`, `:multimap/multimap`, `:log/line-backend`
… — record ids of std modules the BUILD had loaded but an imaged boot never does — so
every scoped `nest test` started with seven registered record ids whose constructors did
not exist, an ability table that disagreed with the modules present, and any test asserting
over the registries (`ability_test.blsp:471`) red from its first instruction. That was
KI-89's residual. A registration is data about a module: it must arrive with that module,
which the stdlib image already gets right by replaying each module's registrations as it
materialises (`stdimage/registrations-by-module`, `%replay-std-regs!`). Pruning the
foreign ones here is the project-image half of the same rule — the std module re-registers
its own entries when it loads, from source or from its image. Root-level registrations
(an unqualified key, no owner) and project/dependency-owned ones are kept.

Ownership is the WRITER the kernel journalled (KI-136), not a key's qualifier: the prelude's
`(defmulti num/mul :commutative)` has no writer, so it is never a module's registration and
never pruned (KI-106, which an exemption for everything registered before the project
loaded used to cover). That exemption is gone (ADR-604): a std module the BUILD loaded
before the project — `nest`'s own toolchain from source, when no stdlib image existed yet —
wrote `:http/response`, `:log/line-backend` … before a single project file loaded, the
exemption baked them into the image, and the next, imaged run started with record ids whose
constructors no module had defined. `before-regs` is no longer consulted; it stays in the
signature for its callers.

`write-image` calls this inside an `%isolate`, so the pruning is rolled back the moment
the image is written and the running session keeps every registration it had — but the
image on disk keeps whatever the prune left, which is why pruning too much is silent and
permanent rather than transient.

    (project-image/image-prune-foreign-registrations (stdimage/registrations-by-module))   ;~> 7 — foreign registrations removed"
  (let (carried? (or carried? project-module-carried?)
        foreign? (fn (m) (not (carried? m)))
        regs (stdimage/registrations-by-module)
        impls (stdimage/%std-impls-by-module)
        n-regs (fold (seq/filter (keys regs) foreign?)
                 0
                 (fn (n m)
                   (fold (get regs m)
                     n
                     (fn (n2 registration)
                       (do (stdimage/retract-registration! registration) (+ n2 1))))))
        n-impls (fold (seq/filter (keys impls) foreign?)
                  0
                  (fn (n m)
                    (fold (get impls m)
                      n
                      (fn (n2 r)
                        (let (aname (get r 0)
                              op (get r 1)
                              key (get r 2))
                          (%registry-update! '*impls* :dissoc [[aname op] key] nil)
                          (%registry-update! '*impl-from* :dissoc [[aname op key]] nil)
                          (%registry-update! '*impl-tiers*
                            :dissoc [[aname op key] (%impl-rank aname key (get r 4))]
                            nil)
                          (+ n2 1)))))))
    (+ n-regs n-impls)))

;; The sections to write: everything this load produced, except that a section the partial
;; rebuild KEPT is copied from the image on disk instead — even when it was materialised along
;; the way, since its bytes are already right.
(defn- project-partial-sections (before kept)
  (let (fresh (image-sections before project-module-carried?))
    (if (or (nil? kept) (empty? kept))
      fresh
      (append (seq/reject fresh (fn (sec) (contains? kept (first sec))))
        (map (sort (keys kept))
          (fn (k) (let ([off len] (get kept k)) [k [:copy off len]])))))))

(defn write-image (root:string before:any before-regs:map &optional reloaded:any kept:any -> any)
  "Snapshot the bindings this project load produced into `root`'s image, grouped into
per-module sections. `before` is the `(reflect/global-names)` list captured *before* the sources
were loaded. Returns the entry count. Written from a scope in which registrations owned by
modules the image does not carry are pruned (`image-prune-foreign-registrations`); the
`%isolate` puts them back once the file is on disk.

`reloaded` is the set of modules a partial rebuild loaded from source (ADR-419); nil means
every module was. `kept` maps each section the partial rebuild kept to its `[offset length]`
in the image now on disk: those are copied byte for byte rather than re-encoded, so a module
the rebuild did not touch need not be materialised to be written again. Beside the image goes
the record the next partial rebuild reads.

    (project-image/write-image \"/path/to/proj\" before (stdimage/registrations-by-module))   ;~> 5310 — entries written to /path/to/proj/.brood/image.bin"
  (let (dir (path/dirname (image-path root)))
    (when (not (file/dir? dir)) (file/mkdir dir))
    ;; Before the fingerprint below, which reads this list back.
    (file/spit (path/join root *project-image-includes-file*)
      (string/join (%included-files) "\n"))
    (let (fp (project-image-fingerprint root)
          previous (if reloaded (read-modules-record root) nil)
          n (%isolate (fn ()
                        (image-prune-foreign-registrations before-regs)
                        (%image-write (image-path root) (project-partial-sections before kept) fp))))
      (write-modules-record! root fp reloaded previous)
      n)))

;; The registrations each project or dependency module's load wrote, as `module -> [[registry
;; key-path] …]` — what a partial rebuild removes before that module loads again, so an entry
;; the edited module no longer makes does not survive in the image's registry values. The
;; kernel journals the writer of every entry (KI-136), but only for loads in THIS process: a
;; module the partial rebuild materialised wrote nothing here, so its previous record is kept.
(defn- project-module-owners (reloaded previous)
  (let (live (fold (%map-pairs (stdimage/registrations-by-module))
               {}
               (fn (m entry)
                 (let ([mod triples] entry)
                   (if (contains? *module-files* mod)
                     ;; map entries only: a list member is a value, which the record (printed
                     ;; data) cannot always carry — a closure prints `#<fn>`
                     (%map-assoc m
                       mod
                       (vec (seq/keep triples (fn (t) (when (get t 1) [(get t 0) (get t 1)])))))
                     m)))))
    (if (nil? reloaded)
      live
      (fold (%map-pairs (or (get previous :owners) {}))
        live
        (fn (m entry)
          (let ([mod regs] entry)
            ;; A materialised module's live attribution is only its key-attributed doc: its
            ;; registrations were restored, not written by it here, so the previous record
            ;; is the whole truth for it.
            (if (or (contains? reloaded mod) (not (contains? *module-files* mod)))
              m
              (%map-assoc m mod regs))))))))

;; The modules whose load evaluated source text (`%dynamic-loaders`), kept across partial
;; rebuilds for the ones that were materialised rather than loaded.
(defn- project-pinned-modules (reloaded previous)
  (let (live (seq/filter (%dynamic-loaders) (fn (m) (contains? *module-files* m))))
    (sort (seq/distinct (if (nil? reloaded)
                          live
                          (append live
                            (seq/filter (or (get previous :pinned) nil)
                              (fn (m)
                                (and (not (contains? reloaded m)) (contains? *module-files* m))))))))))

(defn- modules-record-path (root) (path/join root *project-image-modules-file*))

;; Best-effort, like the image: a record that cannot be written costs the next edit a full
;; rebuild, never a wrong answer.
(defn- write-modules-record! (root fp reloaded previous)
  ;; check-allow :discarded-catch — a best-effort cache write: the next edit rebuilds whole
  (check-allow :discarded-catch
    (try
      ;; Written beside and renamed over, as the image is: concurrent runs of one project
      ;; each write this, and a reader must never see half a record.
      (file/spit-atomic (modules-record-path root)
        (pr-str
          {:fingerprint fp
           :global (image-global-key)
           :files (fold (sorted-source-files root)
                    {}
                    (fn (m f) (%map-assoc m f (stamp-of f))))
           :owners (project-module-owners reloaded previous)
           ;; the registries the root section carries — see `project-redeclare-registries!`
           :registries (seq/filter (%registry-names)
                         (fn (n) (not (includes? *project-image-registry-exclusions* n))))
           :pinned (project-pinned-modules reloaded previous)}))
      (catch _ nil))))

(defn- read-modules-record (root)
  ;; check-allow :discarded-catch — an absent or unreadable record is "rebuild whole"
  (check-allow :discarded-catch
    (try
      (let (p (modules-record-path root))
        (if (file/exists? p) (reflect/read-string (file/slurp p)) nil))
      (catch _ nil))))

;; Install `root`'s image as a source of features, if it is current. Materialises the root
;; section (registries + declared sigs — small, and needed before anything else) and hands
;; `require` the directory for everything else, so each module materialises on first use.
;; Returns the section count, or nil for a miss (absent, stale, corrupt).
;; `[registry-symbol value]` for every registry the kernel knows in this process — the
;; state a root-section load is about to overwrite.
(defn- project-registry-snapshot ()
  (map (%registry-names) (fn (r) [r (reflect/eval r)])))

;; Union of two registry values, `live` winning on a key both hold; a two-level registry
;; (`*impls*` `{[ability op] {id f}}`, `*methods*`) unions its inner maps too.
(defn- project-registry-merge-values (image live)
  (cond
    (nil? live) image
    (nil? image) live
    (and (map? image) (map? live))
      (fold (%map-pairs live)
        image
        (fn (acc entry)
          (let ([k v] entry
                current (%map-get acc k nil))
            (%map-assoc acc
              k
              (if (and (map? v) (map? current))
                (fold (%map-pairs v) current (fn (a2 kv2) (%map-assoc a2 (first kv2) (second kv2))))
                v)))))
    else live))

;; Re-merge the pre-load registrations into whatever the root section installed. Through
;; `%registry-cas!` — the registry write path — never `def`, which in module code would
;; bind `project/*impls*` and leave the real registry untouched.
(defn- project-registry-merge-live! (live)
  (doseq (entry live)
    (let ([r before] entry
          after (reflect/eval r))
      (when (not (= after before))
        (%registry-cas! r after (project-registry-merge-values after before))))))

(defn- project-install-image (root fp &optional choose)
  (image-install (image-path root) fp choose))

;; Install the image at `path` (a file, or a `mem:` path a host provided) when its stamp is
;; `fp` — the project's, or a release bundle's (ADR-484), which have no root on disk.
(defn- image-install (path fp &optional choose)
  (let (idx (%image-index path fp))
    (cond
      (nil? idx) nil
      else
        (do
          ;; Through the prelude's setter, not `def`: this is module code, and a `def` here
          ;; would bind `project/*image-sections*` while `%require-force` kept reading the
          ;; empty root one — which is how an imaged start came to restore the root section
          ;; and then load every module from source anyway.
          (%set-image-source! path (dissoc idx ""))
          (let (root-sec (get idx ""))
            (when root-sec
              ;; The root section REPLACES every registry global with the image's value —
              ;; which cannot be allowed to erase what modules loaded BEFORE this point had
              ;; registered (KI-89): `nest` boots with `datetime`, `io`, `project` … already
              ;; loaded, and their impls were being wiped by an image whose `*impls*` did not
              ;; happen to contain them (it did by accident before write-time pruning; with
              ;; it, `Temporal/->iso` lost its `:datetime/date` impl on every imaged boot).
              ;; So: snapshot the live registries, load the section, merge the live entries
              ;; back — live wins on a conflict, because it is the loaded module's own word.
              (let (live (project-registry-snapshot))
                (%image-load-section path (first root-sec) (second root-sec))
                ;; Before the merge: a list member's credit names its position as written.
                (image-credit-writes! live)
                (project-registry-merge-live! live))
              ;; A partial rebuild (ADR-419) decides which sections to keep HERE: it needs the
              ;; recorded edges the root section just brought, and the replay below must not
              ;; materialise a section it is about to drop.
              (when choose (%set-image-source! path (choose (dissoc idx ""))))
              ;; The root section carries the registries, so `*require-edges*` only exists
              ;; after that load — and it is also where a headerless file's defs live, so its
              ;; own load-time requires are recorded under `""` and have to be replayed here
              ;; (KI-37). A module's edges are replayed by `require` when its section
              ;; materialises; the root section has no `require` to hang them on.
              (fold (or (get *require-edges* "") nil) nil (fn (_ d) (require-one d)))))
          (count idx)))))

;; ── The partial rebuild (ADR-419) ─────────────────────────────────────────────
;; An edit used to throw the whole image away: the next start loaded every module from source
;; — 33 s of a 40 s edit loop at 1 000 × 3k lines — to re-derive one file. A module's section is
;; still right after an edit when nothing it was built from moved: its own file, and every
;; module its load could have read. So the partial rebuild reloads the edited modules and
;; everything that depends on them, materialises the rest, and writes the image again.
;;
;; "Depends on" is read wide, because a miss here is a stale value no error ever reports:
;; the modules a file requires, every module prefix that appears ANYWHERE in its text
;; (`module-index/mentions-of` — code, quoted data, keywords, the insides of strings), and the
;; requires its load actually performed (`*require-edges*`). A module whose load evaluated
;; source text (`%dynamic-loaders`) depends on what no scan sees, so it always reloads. Any
;; other change — a new binary, the contract mode, a dependency or included file, a source
;; file with no `defmodule`, a deleted file — rebuilds the image whole.

;; The project's own module keys (rooted under its name, ADR-070) and the file behind each.
(defn- project-own-module-files ()
  (fold (%map-pairs *module-files*)
    {}
    (fn (m entry)
      (if (project-image-dep-module? (first entry)) m (%map-assoc m (first entry) (second entry))))))

;; A name as a source file spells it — `shapes`, `demo/shapes` — as the project module key it
;; denotes, or nil for any other module.
(defn- project-module-key (own s)
  (let (rooted (if project/*name* (str (->string project/*name*) "/" s) nil))
    (cond
      (contains? own s) s
      (and rooted (contains? own rooted)) rooted
      else nil)))

;; `module -> (modules whose load may have read it)`, over the project's own modules.
(defn- project-dependents (root own)
  (let (paths (seq/distinct (vals own))
        mentions (module-index/mentions-of root paths)
        infos (module-index/infos-of root paths))
    (fold (%map-pairs own)
      {}
      (fn (acc entry)
        (let ([m f] entry
              named (append (or (get mentions f) nil)
                      (or (get (get infos f) :requires) nil)
                      (or (get *require-edges* m) nil))
              deps (seq/distinct (seq/keep named (fn (s) (project-module-key own (->string s))))))
          (fold deps
            acc
            (fn (a d) (if (= d m) a (%map-assoc a d (cons m (%map-get a d nil)))))))))))

;; Everything reachable from `seeds` over `dependents`.
(defn- project-reverse-closure (seeds dependents)
  (let (step (fn (seen frontier)
               (if (empty? frontier)
                 seen
                 (let (m (first frontier))
                   (if (contains? seen m)
                     (step seen (rest frontier))
                     (step (conj seen m) (append (rest frontier) (or (get dependents m) nil))))))))
    (step #{} seeds)))

;; A registry enters `(%registry-names)` — the set the image writer carries in the root
;; section — only when this process WRITES it. A partial rebuild restores the registries from the
;; root section and materialises the modules that fill them, so a registry only an unchanged
;; module writes (`registry/*registries*` filled by a module's `registry/put!` at load) is never
;; written here and would be left out of the image this rebuild writes: the run after lost every
;; row in it. Declare each one the record names, the way the prelude declares `*require-edges*`
;; — a write that marks the name and leaves the value as it was.
(defn- project-redeclare-registries! (names)
  (doseq (r (or names nil))
    (when (and (bound? r) (map? (reflect/eval r)))
      (%registry-update! r :assoc ["%declare"] nil)
      (%registry-update! r :dissoc ["%declare"] nil))))

;; Take module `m`'s registrations out of the live registries before it loads again: the
;; non-impl ones its previous load recorded (`owners`), its ability impls (`*impl-from*` names
;; their declaring module, and the image carries it), its require edges and its doc.
(defn- project-forget-module! (m owners impls)
  (doseq (r (or (get owners m) nil))
    (%registry-update! (get r 0) :dissoc (get r 1) nil))
  (doseq (r (or (get impls m) nil))
    ;; `[ability op key f from]`, `%register-impl`'s argument list
    (let (aname (get r 0)
          op (get r 1)
          key (get r 2))
      (%registry-update! '*impls* :dissoc [[aname op] key] nil)
      (%registry-update! '*impl-from* :dissoc [[aname op key]] nil)
      (%registry-update! '*impl-tiers*
        :dissoc [[aname op key] (%impl-rank aname key (get r 4))]
        nil)))
  (%registry-update! '*require-edges* :dissoc [m] nil))

;; The partial rebuild, or nil when this change needs a whole one. Returns the set of modules
;; it loaded from source, with the image rewritten; the caller reports.
(defn- project-partial-load (root files lazy?)
  (let (rec (read-modules-record root)
        own (project-own-module-files)
        file-modules (fold (%map-pairs own)
                       {}
                       (fn (m entry)
                         (%map-assoc m
                           (second entry)
                           (cons (first entry) (%map-get m (second entry) nil)))))
        old-files (or (get rec :files) {})
        now (fold files {} (fn (m f) (%map-assoc m f (stamp-of f))))
        changed (seq/filter (seq/distinct (append (keys now) (keys old-files)))
                  (fn (f) (not (= (get now f) (get old-files f))))))
    (cond
      (nil? rec) nil
      (not (= (get rec :global) (image-global-key))) nil
      (empty? changed) nil
      ;; a deleted file, or one with no `defmodule`: its globals are root-level or gone
      (any? changed (fn (f) (or (nil? (get now f)) (empty? (or (get file-modules f) nil))))) nil
      else
        (let (edited (fold changed nil (fn (acc f) (append (get file-modules f) acc)))
              pinned (seq/filter (or (get rec :pinned) nil) (fn (m) (contains? own m)))
              ;; set by `choose`, which runs once the root section's registries are live
              chosen (table/new)
              n (project-install-image root
                  (get rec :fingerprint)
                  (fn (sections)
                    (let (invalid (project-reverse-closure (append edited pinned)
                                    (project-dependents root own))
                          impls (stdimage/%std-impls-by-module))
                      (project-redeclare-registries! (get rec :registries))
                      (doseq (m invalid)
                        (project-forget-module! m (or (get rec :owners) {}) impls))
                      (let (kept (fold invalid sections (fn (secs m) (dissoc secs m))))
                        (table/put chosen :invalid invalid)
                        (table/put chosen :kept kept)
                        kept)))))
          (when n
            (let (invalid (table/get chosen :invalid))
              ;; A tool that needs the whole project (check, test) gets it; a lazy caller (`nest
              ;; run`) materialises only what the reloaded modules require. Either way the
              ;; image is written with the unchanged sections COPIED, not re-encoded.
              (when (not lazy?) (materialize-all))
              (doseq (m (sort (seq invalid)))
                (require-one (symbol m)))
              {:reloaded invalid :kept (table/get chosen :kept)}))))))

(defn materialize-all ()
  "Materialise every module the installed image holds — for tools that genuinely need the
whole project in the heap (`nest test`, `nest check`, the LSP). `nest run` deliberately does
NOT call this: it requires its entry point and lets the rest stay on disk.

    (project-image/materialize-all)   ;~> 120 — the number of image sections materialised"
  (let (ks (keys *image-sections*))
    (fold ks nil (fn (_ k) (require-one k)))
    (count ks)))

;; Whether an image may be used at all this run. Line coverage (ADR-148 tier 2)
;; instruments at COMPILE time — the compiler prefixes positioned nodes with a
;; `RecordLine` opcode — so code restored from an image was never compiled in this
;; process and carries no instrumentation, and the report would silently come back
;; empty. An instrumented run therefore always loads from source. Silent wrong output
;; is exactly the failure mode worth a special case.
(defn image-usable? ()
  "Whether a cached startup image may be used — false under `BROOD_COVERAGE`, whose instrumentation an image cannot represent.

    (project-image/image-usable?)   ;~> true — false under BROOD_COVERAGE"
  (nil? (os/env "BROOD_COVERAGE")))

;; Milliseconds as "12.3s" / "845ms" — build output should read at a glance.
(defn- project-ms-str (ms)
  (if (< ms 1000)
    (str ms "ms")
    (str (math/quot ms 1000) "." (math/quot (math/mod ms 1000) 100) "s")))

(defn setup-lazy-image (root)
  "Install `root`'s startup image WITHOUT materialising its modules, so `require` pulls each
one in on first use (ADR-218). Returns the section count, or nil when there is no current
image — in which case the caller must fall back to a source load.

This is what makes `nest run` pay only for the modules its entry point actually reaches: on
a 16 300-module project an entry touching twenty of them materialises twenty, not 16 300.

    (project-image/setup-lazy-image \"/path/to/proj\")   ;~> 120 — the section count, or nil with no current image"
  (cond
    (not (image-usable?)) nil
    else (project-install-image root (project-image-fingerprint root))))

;; CONTRACT for tools that instrument the live image (trace-fn/break-fn, ADR-184, or
;; any global rebind): build FIRST, then instrument, then run. On a COLD run this fn
;; re-evaluates clean source to build the image, which overwrites any rebinding done
;; before it — so a trace installed first is silently wiped on a project's first run
;; (and only the first: a warm run hits the image and skips the reload). The image
;; itself is always clean (the snapshot is taken right after this reload), so this is a
;; wipe, never a leak. See ADR-218 §"Runtime instrumentation must follow the build".
(defn load-sources-cached (root & opts)
  "Load the project the fast way: from its startup image when that is current,
otherwise from source — and in that case write the image, so the NEXT run is fast.
This is what `nest run` / `nest test` / `nest check` use, which is why none of them
ever require a separate build step to have been run first (ADR-218). Image writing is
best-effort: a read-only or full disk costs speed, never correctness.

Reports the build on stderr when it actually builds, and says nothing on an image
hit — a cold load of a large project takes tens of seconds, and silence there is
indistinguishable from a hang. stderr, not stdout, so `nest run`'s output stays the
program's and the LSP's protocol channel stays clean.

    (project-image/load-sources-cached \"/path/to/proj\")   ;~> the project loaded, from its image when current, else from source (writing a new image)"
  (let (t-a (os/now-ns)
        files (sorted-source-files root)
        t-b (os/now-ns)
        fp (fingerprint-of files)
        t-c (os/now-ns)
        hit (cond
              (image-usable?)
                (let (n (project-install-image root fp))
                  (cond
                    (nil? n) nil
                    ;; Everything, because this entry point is for the tools that need the
                    ;; whole project. `nest run` uses `setup-lazy-image` instead.
                    else (do (materialize-all) n)))
              else nil)
        t-d (os/now-ns)
        _ (when (os/env "BROOD_IMAGE_TRACE")
            (io/puts (str "[loader] collect "
                       (math/quot (- t-b t-a) 1000000)
                       " ms, fingerprint "
                       (math/quot (- t-c t-b) 1000000)
                       " ms, image-read "
                       (math/quot (- t-d t-c) 1000000)
                       " ms")
              :to *err*)))
    (cond
      hit hit
      else
        (let (name (or project/*name* (path/basename root))
              started (os/now-ns)
              before (reflect/global-names)
              ;; Captured HERE, beside `before`, and for the same reason: what the prune may
              ;; remove is decided by what this load introduced, so both baselines have to be
              ;; taken before a single source file is read (KI-106).
              before-regs (stdimage/registrations-by-module)
              ;; An edit to some modules reloads those and their dependents (ADR-419).
              partial (if (image-usable?)
                        (project-partial-load root files (includes? opts :lazy))
                        nil))
          (if partial
            (project-report-partial root name partial before before-regs started)
            (project-build-whole root opts files name started before before-regs))))))

;; The partial rebuild's tail: write the image again and say what was reloaded.
(defn- project-report-partial (root name partial before before-regs started)
  (let (reloaded (get partial :reloaded)
        t-load (math/quot (- (os/now-ns) started) 1000000)
        ;; check-allow :discarded-catch — best-effort, as on a whole build: the next edit rebuilds whole
        wrote (check-allow :discarded-catch
                (try
                  (write-image root before before-regs reloaded (get partial :kept))
                  (catch _ nil)))
        t-all (math/quot (- (os/now-ns) started) 1000000)
        n (count reloaded))
    (io/puts (str "Rebuilt "
               name
               ": "
               n
               " module"
               (if (= n 1) "" "s")
               " from source in "
               (project-ms-str t-load)
               (if wrote (str " (+" (project-ms-str (- t-all t-load)) " image)") ""))
      :to *err*)
    nil))

(defn- project-build-whole (root opts files name started before before-regs)
  (let (n (count files)
        _ (io/puts (str "Building " name " (" n " file" (if (= n 1) "" "s") ")") :to *err*)
        _ (/apply project/load-sources (cons root opts))
        t-load (math/quot (- (os/now-ns) started) 1000000)
        ;; A project whose globals are not all portable — a `table` global is the
        ;; documented mutable-state idiom, and a table is deliberately local to its
        ;; runtime — simply cannot be imaged. That is correct (loading from source is
        ;; always right), but swallowing it meant such a project silently loaded cold
        ;; forever with no way to find out why. Say so, once, and carry on.
        wrote (cond
                (image-usable?)
                  (try
                    (write-image root before before-regs)
                    (catch e
                      ;; No once-per-key guard needed: this is the cold path, which
                      ;; already prints Building/Built exactly once per build.
                      (do
                        (io/puts (str "note: "
                                   name
                                   " cannot use a startup image, so it loads from"
                                   " source every time — "
                                   (get e :message))
                          :to *err*)
                        nil)))
                else nil)
        t-all (math/quot (- (os/now-ns) started) 1000000))
    (io/puts (str "Built "
               name
               " in "
               (project-ms-str t-load)
               (cond
                 wrote (str " (+" (project-ms-str (- t-all t-load)) " image)")
                 else ""))
      :to *err*)
    nil))

;; Load the manifest (if present) and put the project's source dirs on *load-path*
;; so its modules are require-able by name.
