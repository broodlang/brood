;; std/tool/complete.blsp — project-aware candidates for `nest` shell completion.
;;
;; Only the VALUE half of completion lives here. Subcommand names and flag names
;; are derived from the command table in `std/tool/nest.blsp`, because that is already
;; their single source of truth: re-listing them here would guarantee drift the
;; first time a flag is added. What Brood owns is the part that depends on the
;; project — which tags exist, which deps are declared, which test files there are.
;;
;; ─────────────────────────────────────────────────────────────────────────────
;; TWO HARD RULES, because this runs on every TAB press
;; ─────────────────────────────────────────────────────────────────────────────
;; 1. NEVER raise. A completion that errors would splatter a stack trace into the
;;    user's command line mid-typing. Every entry point here returns a list —
;;    empty when it cannot tell — and swallows failures. A broken project must
;;    still complete flags and filenames.
;; 2. NEVER load the project image. Booting + loading sources costs far more than
;;    a keypress budget allows, and a project whose sources don't compile would
;;    complete nothing. Everything here is filesystem reads and textual scanning.
;;    That rule binds this module's OWN dependencies too — see below.
;;
;; Consequence of rule 2: tags are found by scanning test source TEXT for
;; `:tags [...]`, not by registering the suite. That can't see a tag computed at
;; runtime — an acceptable trade, since a completion list is a hint, not a
;; specification, and a wrong hint costs nothing but a wrong pause costs every
;; keystroke.

(defmodule complete
  "Project-aware candidate lists for `nest` shell completion — tags, dependency
names, module names, test files. Every function returns a (possibly empty) list
and never raises: it runs on each TAB press, so a failure must degrade to \"no
suggestions\", never to an error on the user's command line."
  ;; DELIBERATELY DEPENDENCY-FREE: loading `project` costs most of a TAB press's budget.
  ;; What completion needs from the project — its root, its declared directories, the
  ;; files under them — is read straight off the filesystem below. A new `foo/bar`
  ;; reference to a std module here silently re-introduces a load (ADR-229).
)

;; --- safety net ---------------------------------------------------------------
;; Run `thunk`, yielding nil on any failure. Wrapped around every filesystem or
;; parse operation below so a half-written manifest or an unreadable directory
;; costs a suggestion, not an error.
;; check-allow :discarded-catch — the documented safety net: a failure costs one suggestion, never the completion
(defn- complete-safely (thunk) (check-allow :discarded-catch (try (thunk) (catch _ nil))))

;; --- the project's shape, read not loaded --------------------------------------
;; Walk up from `dir` looking for project.blsp. A copy of `project/find-root` ON PURPOSE:
;; calling that one would load `project` on every TAB press (see the module header).
(defn- complete-find-root (dir)
  (cond
    (file/exists? (path/join dir "project.blsp")) dir
    (= dir (path/dirname dir)) nil
    else (complete-find-root (path/dirname dir))))

(defn- complete-root () (complete-safely (fn () (complete-find-root (file/cwd)))))

;; Every path under `dir` (recursively) whose filename ends in `suffix`, in no particular
;; order (callers sort or filter). One accumulator threads the whole walk, so it stays
;; linear in the file count. A symlinked directory is not entered — `file/walk-files`'
;; rule, copied with the walk: `dir?` follows the link, so a cycle (`a/up -> ..`) was
;; walked until the kernel refused the path, listing every file once per level.
(defn- complete-under (dir suffix) (complete-under-into dir suffix nil))
(defn- complete-under-into (dir suffix found)
  (if (file/dir? dir)
    (fold (file/ls dir)
      found
      (fn (acc entry)
        (let (path (path/join dir entry)
              stat (file/stat path))
          (cond
            (and stat (get stat :dir?) (not (get stat :symlink?)))
              (complete-under-into path suffix acc)
            (string/ends-with? entry suffix) (cons path acc)
            else acc))))
    found))

;; The value after key `k` in a flat kv list, or nil — the manifest is a plist.
;;
;; A local copy of `project`'s two-line `plist-get` on purpose: reaching for that one
;; is what made this module require all of `project` in the first place. Two lines
;; duplicated is the cheaper half of that trade, and it keeps rule 2 enforceable by
;; inspection — this file has no `foo/bar` references at all.
(defn- complete-plist-get (kvs k)
  (cond
    (empty? kvs) nil
    (= (first kvs) k) (second kvs)
    else (complete-plist-get (rest (rest kvs)) k)))

;; The manifest as DATA. `project` is a macro over literal data (it quotes its
;; arguments), so the form can be read and inspected without evaluating anything —
;; which is what rule 1 needs: a manifest that is half-typed or invalid yields nil
;; here instead of raising.
(defn- complete-manifest (root)
  (complete-safely (fn ()
                     (let (form (reflect/read-first (file/slurp (path/join root "project.blsp"))))
                       (if (and (pair? form) (= (first form) 'project)) form nil)))))

;; The directories the manifest declares under `key`, as absolute paths, falling back
;; to `default` when it declares none.
;;
;; Read from the manifest, not the `project/*source-paths*` / `project/*test-paths*`
;; settings: only `project`'s manifest loader sets those, and completion never runs it, so
;; a project declaring `:test-paths ["spec"]` would complete none of its own test files.
(defn- complete-manifest-dirs (root key default)
  (let (form (complete-manifest root)
        declared (if (nil? form) nil (complete-safely (fn () (complete-plist-get (rest form) key))))
        rels (if (or (vector? declared) (pair? declared)) declared default))
    (map rels (fn (r) (path/join root r)))))

;; Strip `root/` from an absolute path so completions read as the relative paths a
;; user actually types.
(defn- complete-relative (path root)
  (if (and (not (nil? root)) (string/starts-with? path root) (> (count path) (+ (count root) 1)))
    (string/substring path (+ (count root) 1) (count path))
    path))

;; --- files --------------------------------------------------------------------
(defn test-files ()
  "Project-relative paths of every `*_test.blsp` under the project's test paths. Empty outside a project.

    (complete/test-files)   ;~> (\"tests/app_test.blsp\" …)"
  (let (root (complete-root))
    (if (nil? root)
      nil
      (or (complete-safely (fn ()
                             (map (fold (complete-manifest-dirs root :test-paths ["tests"])
                                    nil
                                    (fn (acc dir) (append acc (complete-under dir "_test.blsp"))))
                               (fn (p) (complete-relative p root)))))
        nil))))

(defn blsp-files ()
  "Project-relative paths of every `.blsp` under the project's source AND test paths — the candidates for `nest check` / `nest run` / `nest format`.

    (complete/blsp-files)   ;~> (\"src/app.blsp\" \"src/app/util.blsp\" \"tests/app_test.blsp\" …)"
  (let (root (complete-root))
    (if (nil? root)
      nil
      (or (complete-safely (fn ()
                             (map (append (fold (complete-manifest-dirs root :source-paths ["src"])
                                            nil
                                            (fn (acc dir)
                                              (append acc (complete-under dir ".blsp"))))
                                    (fold (complete-manifest-dirs root :test-paths ["tests"])
                                      nil
                                      (fn (acc dir) (append acc (complete-under dir "_test.blsp")))))
                               (fn (p) (complete-relative p root)))))
        nil))))

;; --- tags ---------------------------------------------------------------------
;; Pull `:tags [...]` out of source TEXT. Deliberately textual (rule 2): the
;; alternative is registering the suite, which means loading the project.
;;
;; Scans for the literal `:tags` then takes what is between the following `[` and
;; `]`. A `:tags` inside a string or comment would be picked up — harmless, since
;; the worst case is one spurious suggestion.
(defn- complete-tags-in (text:string acc:any from:int -> any)
  (let (i (index-of-from text ":tags" from))
    (if (< i 0)
      acc
      (let (open (index-of-from text "[" i)
            close (if (< open 0) -1 (index-of-from text "]" open))
            newline (index-of-from text "\n" i))
        (cond
          ;; No bracket at all, or no closing bracket anywhere after it: nothing
          ;; addressable here, and nothing further to find.
          (or (< open 0) (< close 0)) acc
          ;; The `]` is on a LATER line, so this `[` never closes on this line —
          ;; almost certainly not a tag vector (an unclosed bracket, or a `:tags`
          ;; mentioned in prose). Capturing to the far-away `]` would swallow the
          ;; rest of the file and offer every keyword in it as a "tag". Skip past
          ;; this occurrence and keep looking.
          (and (>= newline 0) (< newline close)) (complete-tags-in text acc (+ i 5))
          ;; Inside a string literal — prose or a test fixture, not a declaration.
          (complete-in-string? text i) (complete-tags-in text acc (+ i 5))
          else
            (complete-tags-in text
              (append acc (complete-keywords (string/substring text (+ open 1) close)))
              (+ close 1)))))))

;; `index-of` has no start offset, so scan a suffix and re-base the result.
(defn- index-of-from (text:string needle:string from:int -> int)
  (if (>= from (count text))
    -1
    (let (i (index-of (string/substring text from (count text)) needle))
      (if (< i 0) -1 (+ from i)))))

;; Is index `i` inside a string literal? Checked within `i`'s own LINE, using native
;; string ops only (this runs per `:tags` occurrence, on a keypress budget).
;;
;; Why it matters: the scan is textual, so a `:tags [...]` written *inside a string* —
;; which is exactly what this module's own tests are full of — was being harvested as
;; real tags, offering names like `a` and `unit` that no test actually carries. A
;; multi-line string could fool the line-local check; that costs one wrong hint.
(defn- complete-line-start (text i) (inc (string/last-index-of text "\n" i)))

(defn- complete-in-string? (text:string i:int -> bool)
  (let (prefix (string/substring text (complete-line-start text i) i)
        ;; An escaped \" neither opens nor closes, so drop those pairs first.
        cleaned (string/replace prefix "\\\"" ""))
    ;; Odd number of quotes before the position ⇒ still inside one.
    (= 1 (math/rem (- (count (string/split cleaned "\"")) 1) 2))))

;; The bare names of the `:keyword`s in a whitespace-separated fragment.
(defn- complete-keywords (fragment)
  (fold (seq/filter (string/split (string/trim fragment) " ") (fn (s) (not (= s ""))))
    nil
    (fn (acc token)
      (if (and (string/starts-with? token ":") (> (count token) 1))
        (let (name (string/substring token 1 (count token)))
          (if (complete-tag-name? name) (append acc (list name)) acc))
        acc))))

;; Could `name` be a keyword's name? A tag is written `:name`, so anything holding a
;; quote, bracket, paren or backslash came from surrounding syntax rather than from a
;; tag — the scan is textual, so it can pick up a `:tags` inside a string literal and
;; produce a candidate like `fast"`. Offering that is worse than offering nothing.
(def- *tag-reject* "\"'()[]{}\\;`,")

(defn- complete-tag-name? (name)
  (and (not (= name ""))
    (fold (string/split name "")
      true
      (fn (ok ch) (and ok (not (includes? *tag-reject* ch)))))))

(defn tags ()
  "Every tag name declared with `:tags [...]` anywhere in the project's test files, de-duplicated and sorted. Textual scan — see the file header on why.

    (complete/tags)   ;~> (\"net\" \"slow\" …)"
  (let (files (test-files)
        root (complete-root))
    ;; Two nested guards, not one `(or …)`: the checker narrows a single-variable
    ;; nil test, so `root` reads `string` (not `nil | string`) past its own guard.
    (if (nil? files)
      nil
      (if (nil? root)
        nil
        (sort (keys (fold (fold files
                            nil
                            (fn (acc rel)
                              (append acc
                                (or (complete-safely (fn ()
                                                       (complete-tags-in (file/slurp (path/join root
                                                                                       rel))
                                                         nil 0)))
                                  nil))))
                      {}
                      (fn (seen name) (assoc seen name true)))))))))

;; --- selectors ----------------------------------------------------------------
(defn selectors ()
  "Candidates for `--only` / `--exclude` / `--include`: every declared tag, plus the `test:` and `describe:` pseudo-selector prefixes.

    (complete/selectors)   ;~> (\"slow\" \"net\" … \"test:\" \"describe:\")"
  (append (tags) (list "test:" "describe:")))

;; --- dependencies -------------------------------------------------------------
(defn dep-names ()
  "The names of the dependencies this project declares — the candidates for `nest remove` and `nest update`. Read straight from the manifest as data, so it works even when the deps are not fetched.

    (complete/dep-names)   ;~> (\"json\" \"hatch\" …) — the manifest's declared deps"
  (let (root (complete-root))
    (if (nil? root)
      nil
      ;; The NAME only, straight off each entry (element 0 of `[name :kind …]`), rather
      ;; than through `project`'s validating parser. Two reasons beyond the load cost:
      ;; that parser raises on the first malformed entry, which under rule 1 means one
      ;; typo'd dep silently costs candidates for every valid one; and a name is all a
      ;; completion needs, so validating kinds and URLs here is work with no output.
      (or (complete-safely (fn ()
                             (let (form (complete-manifest root)
                                   deps (if (nil? form)
                                          nil
                                          (complete-plist-get (rest form) :dependencies)))
                               (if (or (vector? deps) (pair? deps))
                                 (seq/filter (map deps
                                               (fn (d)
                                                 (complete-safely (fn ()
                                                                    (->string (if (or (vector? d)
                                                                                    (pair? d))
                                                                                (first d)
                                                                                d))))))
                                   (fn (n) (not (nil? n))))
                                 nil))))
        nil))))

;; --- modules ------------------------------------------------------------------
(defn modules ()
  "Candidates for `nest doc MODULE`: every baked-in std module plus this project's own source modules (by file basename, which is how `require` names them).

    (complete/modules)   ;~> (\"json\" \"string\" … \"app\" …) — std modules plus the project's own"
  (let (root (complete-root))
    (sort (keys (fold (append (or (complete-safely (fn () (reflect/builtin-modules))) nil)
                        (if (nil? root)
                          nil
                          (or (complete-safely (fn ()
                                                 (map (fold (complete-manifest-dirs root
                                                              :source-paths ["src"])
                                                        nil
                                                        (fn (acc dir)
                                                          (append acc
                                                            (complete-under dir ".blsp"))))
                                                   (fn (p)
                                                     (complete-strip-extension (path/basename p))))))
                            nil)))
                  {}
                  (fn (seen m) (assoc seen m true)))))))

(defn project-modules ()
  "Just THIS project's own source modules (by file basename, which is how `require` names them) — the candidates for `nest run --main`, where a std module would never be a valid entry point.

    (complete/project-modules)   ;~> (\"app\" \"util\" …)"
  (let (root (complete-root))
    (if (nil? root)
      nil
      (sort (or (complete-safely (fn ()
                                   (map (fold (complete-manifest-dirs root :source-paths ["src"])
                                          nil
                                          (fn (acc dir) (append acc (complete-under dir ".blsp"))))
                                     (fn (p) (complete-strip-extension (path/basename p))))))
              nil)))))

;; The scaffolder owns the template list, so read it from there rather than
;; restating it — a new template becomes completable with no change here.
(defn templates ()
  "The `nest new --template` names, from the scaffolder's own list.

    (includes? (complete/templates) \"default\")  ;=> true"
  ;; `scaffold/*templates*` is a `scaffold` dynamic variable, so `scaffold` must be loaded
  ;; for it to be bound — but only HERE, on the one completion that needs it. Naming an
  ;; export (`scaffold/new-project`) instead would auto-require it at load time
  ;; (ADR-229), which is what made every unrelated TAB press pay for `scaffold` and,
  ;; behind it, all of `project`. `require-one` at call time keeps that cost on the
  ;; `nest new --template` path; the qualified read below then finds the variable that
  ;; `require-one` just bound.
  ;; `:unbound` because that is exactly this lint's documented case: a global bound at
  ;; RUNTIME (by the `require-one` on the line above) which the source checker, reading
  ;; only this file, cannot see.
  (or (complete-safely (fn ()
                         (require-one 'scaffold)
                         (check-allow :unbound (into [] scaffold/*templates*))))
    nil))

(defn- complete-strip-extension (filename)
  (string/drop-suffix filename ".blsp"))

;; --- dispatch -----------------------------------------------------------------
;; One entry point so `nest` needs only a single eval per completion request, and
;; an unknown kind is "no suggestions" rather than an error.
(defn for-kind (kind)
  "Candidates for a completion `kind` (a string, from `nest complete`): \"selector\", \"tag\", \"test-file\", \"blsp-file\", \"dep\", or \"module\". Any other kind yields nil, so a new flag that forgets to add a kind degrades to filename completion instead of failing.

    (complete/for-kind \"no-such-kind\")  ;=> nil"
  (cond
    (= kind "selector") (selectors)
    (= kind "tag") (tags)
    (= kind "test-file") (test-files)
    (= kind "blsp-file") (blsp-files)
    (= kind "dep") (dep-names)
    (= kind "module") (modules)
    (= kind "project-module") (project-modules)
    (= kind "template") (templates)
    else nil))

(defn print-candidates (kind prefix)
  "Print one candidate per line for `kind`, keeping only those starting with `prefix` — the form `nest complete` consumes. Prints nothing (and never raises) when there is nothing to suggest, so the shell falls back to filename completion.

    (complete/print-candidates \"no-such-kind\" \"\")   ;=> :ok"
  (fold (seq/filter (or (complete-safely (fn () (for-kind kind))) nil)
          (fn (c) (or (= prefix "") (string/starts-with? c prefix))))
    nil
    (fn (_ c) (io/puts c)))
  :ok)
