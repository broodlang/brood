;; std/tool/docs.blsp — documentation extraction (`nest doc`), in Brood.
(defmodule docs
  "Generate Markdown documentation for a module by loading it and introspecting
the definitions it adds to the global table.

`(generate)` documents the whole project (every source file under it);
`(generate name)` documents a single module — a baked-in std module, or one
found as <name>.blsp on `*load-path*`. This is policy built on the introspection
primitives (`doc` / `arglist` / `reflect/global-names`), `file/slurp`, and the project model
in `std/tool/project.blsp`; Rust supplies only that mechanism (ADR-006).

Attribution uses a `(reflect/global-names)` delta around loading the module, so it can't
document a module already loaded before the snapshot (the delta is empty). For
that reason `project` is required lazily, inside `document-project`, rather than
at the top — keeping it out of the snapshot when it is itself the doc target.

`(:use-internals project)` grants access to `project-file-feature` (the rooted
module name of a source file), which `model-file` needs to attribute a project
module's namespace-rooted globals (ADR-070) back to it."
  (:use project)
  (:use-internals project))

;; --- module source + leading docstring ---------------------------------------

;; The source text of module `key` (a string): a baked-in module if there is one,
;; else the first <key>.blsp found on *load-path*, else nil.
(defn- docs-source (key)
  (let (embedded (%builtin-module key))
    (if embedded
      embedded
      (let (path (%require-find (str key ".blsp") *load-path*)) (when path (file/slurp path))))))

;; The module docstring: the string right after the name in the file's leading
;; `(defmodule NAME "doc" …)`, or nil. Read from source.
(defn- docs-leading-doc (src)
  (let (form (reflect/read-first src))
    (when (and (pair? form) (= (first form) 'defmodule) (string? (nth form 2)))
      (nth form 2))))

;; The bare module title from a file path: "a/b/foo.blsp" -> "foo".
(defn- docs-basename (path)
  (let (file (path/basename path))
    (if (string/ends-with? file ".blsp") (path/stem file) file)))

(defn- docs-setup-root (who)
  "Find the project above the cwd (or raise naming `who`), set it up, and return its root."
  (let (root (project/require-root who))
    (setup root)
    root))

;; --- which names a module defines (global-table delta) -----------------------

;; Names present in `after` but not `before` — the bindings a module introduced
;; between two (reflect/global-names) snapshots. global-names is sorted, so this is too.
(defn- docs-added (before after) (seq/filter after (fn (s) (not (includes? before s)))))

;; --- rendering ---------------------------------------------------------------

;; A `[[name]]` cross-reference in a docstring (ADR-331). The docsite renders these as real
;; anchor links; this file emits GitHub-flavoured Markdown that is mostly READ IN A TERMINAL,
;; where an anchor into a page that is not open is worse than no link at all — and the heading
;; slug a renderer would generate from `### \`(seq/reject coll pred)\`` is not something this
;; module can predict. So here the reference renders as the code span it is: `reject`. The
;; brackets never reach the reader in either surface.
;;
;; The scan and its guards (an unclosed `[[` is prose; a bracketed run with a space is a
;; literal vector) are the docsite's `render-refs`; only the rendering differs.

(defn- docs-module-prefix (sym)
  "The `mod/` a bare `[[name]]` in `sym`'s docstring should be read against, or nil for a
bare-surface (prelude) name, whose references are bare already."
  (let (name (->string sym)
        slash (index-of name "/"))
    (if (< slash 0) nil (string/substring name 0 (inc slash)))))

(defn- docs-links (text &optional prefix)
  "Render `[[name]]` cross-references in `text` as code spans, qualifying bare ones with
`prefix` (a `mod/` string) when there is one."
  (docsite/render-refs text
    (fn (raw)
      ;; QUALIFY a bare reference with the citing definition's own module. The docsite can
      ;; leave `[[reject]]` reading as "reject" because it is a link on the page that
      ;; defines it; here there is no link and no page, so the bare spelling is all the
      ;; reader gets — and for a namespaced module the bare spelling is one they cannot
      ;; type. `seq/filter`'s docstring citing [[reject]] must print `seq/reject`, not
      ;; `reject`, which is unbound.
      (str "`" (if (or (nil? prefix) (>= (index-of raw "/") 0)) raw (str prefix raw)) "`"))))

;; A value worth a full entry (signature + docstring): a function or a macro.
(defn- docs-documentable? (v) (or (fn? v) (= (type-of v) :macro)))

;; Module-private, as the image recorded it at the def form (`defn-`/`def-`,
;; ADR-146). These are skipped by (:use) refer-all and omitted from generated docs.
;; `sym` is already the qualified name, which is what `reflect/private?` keys on.
(defn- docs-private? (sym) (reflect/private? sym))

;; One definition's Markdown: a `### (->string args…)` heading (with a *(macro)* tag
;; for macros) followed by its docstring, or a placeholder when undocumented. A name a
;; `(meta … :deprecated …)` marks gets its heading STRUCK THROUGH as well as the note
;; below it: the note is what a reader learns after deciding to read the entry, and the
;; strikethrough is what tells them not to reach for the name while skimming the module.
(defn- docs-entry (sym v)
  (let (sig (pr-str (cons sym (reflect/arglist v)))
        d (reflect/doc v)
        suffix (if (= (type-of v) :macro) "  *(macro)*" "")
        ;; The TYPE, when anything knows one — a `(sig …)` the author declared, or the
        ;; curated signature a primitive carries. `nil` for a name nothing types, which
        ;; is most of them, and that line is simply omitted. Guarded like the structured
        ;; record's: a name the checker cannot type must not fail the whole doc build.
        ;; check-allow :discarded-catch — a name nothing can type / describe / locate is simply omitted from the docs
        arrow (check-allow :discarded-catch (try (reflect/type-signature sym) (catch _ nil)))
        type-line (if (nil? arrow) "" (str "`" arrow "`\n\n"))
        ;; The EFFECT the body reaches, when the checker's purity walk finds one (C15) —
        ;; the analysis that until now only ever graded a `:pure` DECLARATION, asked as a
        ;; question. Printed only when there IS one: the effectful-primitive list is a
        ;; deny-list, so a described effect is one the body reaches, while nothing found
        ;; means *not known to perform one* — which is not the same as pure, and these docs
        ;; must not say it is.
        ;; check-allow :discarded-catch — a name nothing can type / describe / locate is simply omitted from the docs
        effect (check-allow :discarded-catch (try (%function-effect sym) (catch _ nil)))
        effect-line (if (nil? effect) "" (str "*Effects:* " effect "\n\n"))
        ;; Stability metadata (ADR-283), where a `(meta …)` recorded any: when the name
        ;; appeared, whether it is going away, whether the surface is settled. `:since` is
        ;; documentation and this is the place it is spent.
        ;; check-allow :discarded-catch — a name nothing can type / describe / locate is simply omitted from the docs
        m (check-allow :discarded-catch (try (%meta-of sym) (catch _ nil)))
        deprecated (when m (get m :deprecated))
        ;; `~~…~~` around the signature, inside the heading, when the name is going
        ;; away — GitHub-flavoured strikethrough, which is what every renderer of these
        ;; files speaks. The backticks stay INSIDE the tildes: `~~`x`~~` strikes the code
        ;; span, `` `~~x~~` `` would print the tildes as part of the name.
        heading (if deprecated (str "~~`" sig "`~~") (str "`" sig "`"))
        stability (if (nil? m)
                    ""
                    (str (if deprecated
                           (str "> **Deprecated** since "
                             deprecated
                             (if (get m :use)
                               (str " — use `" (->string (get m :use)) "` instead.")
                               ".")
                             "\n\n")
                           "")
                      (if (get m :beta) (str "> **Beta** — " (get m :beta) "\n\n") "")
                      (if (get m :since) (str "*Since " (get m :since) ".*\n\n") ""))))
    (str "### "
      heading
      suffix
      "\n\n"
      stability
      type-line
      effect-line
      (if (nil? d) "_Undocumented._\n" (str (docs-links d (docs-module-prefix sym)) "\n")))))

;; The "Definitions" section: every public function/macro the module added.
(defn- docs-section-defs (syms)
  (let (defs (seq/filter syms
               (fn (s) (and (docs-documentable? (reflect/eval s)) (not (docs-private? s))))))
    (if (empty? defs)
      ""
      ;; `(apply str (map …))` joins once. A `(str acc …)` fold recopies the whole
      ;; accumulator per entry, so a module's Definitions section was O(output²) in the
      ;; markdown it generates — the same shape that made `write-lines` take 1888 ms for
      ;; 16 000 lines (std/file.blsp).
      (str "## Definitions\n\n"
        (apply str (map defs (fn (s) (str (docs-entry s (reflect/eval s)) "\n"))))))))

;; The "Variables" section: public names the module bound to non-function values.
(defn- docs-section-vars (syms)
  (let (vars (seq/filter syms
               (fn (s)
                 (and (not (docs-documentable? (reflect/eval s)))
                   (not (docs-private? s))))))
    (if (empty? vars)
      ""
      (str "## Variables\n\n" (apply str (map vars (fn (s) (str "- `" (->string s) "`\n"))))))))

;; The "Types" section: every `(deftype name T)` the module declares (ADR-327), as its
;; bare name over the type as written. A `deftype` binds no global, so the module's name
;; walk cannot see it — `reflect/type-aliases` enumerates the checker's store by module.
;; Nothing for a module whose namespace is unknown (the load-delta fallback).
(defn- docs-section-types (ns)
  (let (types (if (nil? ns) nil (reflect/type-aliases ns)))
    (if (empty? types)
      ""
      (str "## Types\n\n"
        (apply str
          (map types
            (fn (t) (str "### `" (docs-bare (:name t)) "`\n\n`" (:type t) "`\n\n"))))))))

;; Assemble one module's Markdown from its title, module doc, and added names; `ns` is
;; the module's namespace when known, which is what its types are listed under.
(defn- docs-render (title mdoc syms &optional ns)
  (str "# module "
    title
    "\n\n"
    (if (nil? mdoc) "" (str mdoc "\n\n"))
    (docs-section-types ns)
    (docs-section-defs syms)
    (docs-section-vars syms)))

;; --- public entry points -----------------------------------------------------

;; Markdown for the module loaded from `path`: snapshot the globals, load the
;; file, and attribute every newly-bound name to it.
(defn document-file (path)
  "The Markdown documentation for the module in the file at `path`: load it and document
  the definitions in its own namespace. Attribution is by namespace (`project-file-feature`,
  ADR-070 rooting), like `model-file` — a `(reflect/global-names)` delta mis-credits a module already
  bound (transitively loaded, or materialised from a startup image, ADR-218) and modules the
  file's own load pulls in. Files with no module header, or read outside a project, fall back
  to the delta.

    (docs/document-file \"/path/to/proj/src/app.blsp\")   ;~> \"# app …\" — Markdown for that file's module"
  (let (src (file/slurp path)
        declared (docs-module-name src)
        ;; check-allow :discarded-catch — a name nothing can type / describe / locate is simply omitted from the docs
        feature (check-allow :discarded-catch
                  (try (project/project-file-feature path) (catch _ nil)))
        before (reflect/global-names))
    (reflect/load path)
    (if feature
      (docs-render (or declared (docs-basename path))
        (docs-leading-doc src)
        (docs-namespace-syms feature)
        feature)
      (docs-render (docs-basename path)
        (docs-leading-doc src)
        (docs-added before (reflect/global-names))))))

;; Markdown for a module named `modname` (symbol or string): resolve its source
;; (baked-in or on *load-path*), snapshot the globals, `require` it, and document
;; the names it added.
(defn document-module (modname)
  "The Markdown documentation for the module named `modname` (a symbol or string), resolved baked-in or on `*load-path*`. Errors if it can't be found.

    (docs/document-module 'json)   ;~> \"# json …\" — Markdown for the module's public definitions"
  (let (key (->string modname) src (docs-source key))
    (if (nil? src)
      (error "doc: cannot find module '" key "'")
      (let (before (reflect/global-names))
        (require-one modname)
        ;; Attribute by NAMESPACE, not by a `(reflect/global-names)` delta — the same correction
        ;; `document-file` already carries, for the same reason. The delta credits a module
        ;; with only the names its own `require` happened to add, so a module ALREADY bound
        ;; — transitively loaded by the tool's own bootstrap, or materialised from a startup
        ;; image (ADR-218) — documented as EMPTY, silently. `nest doc math`, `nest doc json`
        ;; and `nest doc text` all rendered a header and nothing else; `nest doc uuid`
        ;; worked only because nothing else pulls uuid in.
        ;;
        ;; The delta stays as the fallback for a module whose names are not under its own
        ;; namespace (a bare-rooted module), where the prefix filter finds nothing.
        (let (owned (docs-namespace-syms key)
              syms (if (empty? owned) (docs-added before (reflect/global-names)) owned))
          (docs-render key (docs-leading-doc src) syms key))))))

;; Markdown for the whole project: find it from the cwd, put its sources on the
;; load-path, and document each source file in turn.
(defn document-project ()
  "The Markdown documentation for the whole project (every source file under it), found from the cwd. Errors if not in a project.

    (docs/document-project)   ;~> \"# myapp …\" — Markdown for every source file of the project"
  ; project/find-root / --collect-sources / setup
  (let (files (project/source-files (docs-setup-root "doc")))
    ;; One join over the whole project, not a per-file recopy of everything emitted
    ;; so far — this is the outermost of the three, so it was O(total-docs²).
    (apply str (map files (fn (f) (str (document-file f) "\n"))))))

;; --- the complete builtin/prelude reference (`nest doc --all`) ---------------

;; Is `sym` part of the public surface worth listing in the all-globals
;; reference? Drops private `foo-bar` helpers and raw `%primitive`s (the
;; bootstrap layer the prelude builds variadic ops on top of) — what's left is
;; what a user/agent actually calls.
(defn- docs-public? (sym)
  (let (nm (->string sym))
    (and (not (includes? nm "--")) (not (string/starts-with? nm "%")))))

(defn document-all ()
  "The Markdown reference for every *public* global currently bound in the image — each builtin and prelude function/macro with its signature and one-line summary. The complete primitive reference (`nest doc --all`); read this once instead of probing names one at a time. Opt-in std modules (`display`, `buffer`, `ansi`, …) aren't loaded here — `nest doc <module>` documents those.

    (docs/document-all)   ;~> \"# Brood reference …\" — Markdown over every public global in the image"
  (let (syms (seq/filter (reflect/global-names) docs-public?))
    (str "# Brood — global reference\n\n"
      "Every public global bound in a fresh image: the Rust builtins plus the "
      "`std/prelude` functions and macros — i.e. everything callable without a "
      "`(require …)`. Generated from the live image (`nest doc --all`), so it is "
      "always in sync. Use `apropos`/`doc-search` to search it interactively; use "
      "`nest doc <module>` for an opt-in module (`display`, `buffer`, `ansi`, …).\n\n"
      (docs-section-defs syms)
      (docs-section-vars syms))))

;; --- structured doc model (`nest docs` — HTML site via `docsite`) ------------

;; The bare (unqualified) name of a symbol: the last "/"-separated segment, e.g.
;; `http/fetch` -> `get`. Bare-named operators like `/` have an empty last segment,
;; so those keep their whole name.
(defn- docs-bare (sym)
  (let (nm (->string sym) segments (string/split nm "/"))
    (if (= (last segments) "") nm (last segments))))

;; One definition as a data record for the model: bare name (for anchors/headings),
;; a bare-named signature, docstring, macro flag, type-arrow, and source location.
;; type-signature/source-location are guarded — a name the checker can't type or the
;; image can't locate yields nil rather than failing the whole build.
(defn- docs-def-record (sym v)
  (let (bare (docs-bare sym))
    {:name bare
     :sig (pr-str (cons (symbol bare) (reflect/arglist v)))
     :doc (reflect/doc v)
     :macro (= (type-of v) :macro)
     :meta (try (%meta-of sym) (catch _ nil))
     :type (try (reflect/type-signature sym) (catch _ nil))
     :source (try (reflect/source-location sym) (catch _ nil))}))

;; The public documentable definitions among `syms`, as records (in `syms` order).
(defn- docs-def-records (syms)
  (apply vector
    (map (seq/filter syms
           (fn (s) (and (docs-documentable? (reflect/eval s)) (not (docs-private? s)))))
      (fn (s) (docs-def-record s (reflect/eval s))))))

;; One module entry of the doc model: `{:module :doc :defs :qualified?}`. `:qualified? true`
;; — a project/library module IS a namespace, so its defs render as their call form
;; (`math/sqrt`, `web/endpoint/handler`), not bare (a bare `sqrt` is unbound; you reference
;; the qualified name or `(:use)`). The prelude-category pseudo-modules the reference adds
;; leave it false (their names — `+`, `map` — are genuinely bare).
(defn- docs-module-model (title mdoc syms &optional ns)
  {:module title
   :doc mdoc
   :types (apply vector
            (map (if (nil? ns) nil (reflect/type-aliases ns))
              (fn (t) {:name (docs-bare (:name t)) :type (:type t)})))
   :defs (docs-def-records syms)
   :qualified? true})

;; A file's declared module name — the `(defmodule NAME …)` symbol — or nil if the file
;; has no module header. Read from source (the form is discarded once loaded).
(defn- docs-module-name (src)
  ;; check-allow :discarded-catch — a name nothing can type / describe / locate is simply omitted from the docs
  (let (form (check-allow :discarded-catch (try (reflect/read-first src) (catch _ nil))))
    (when (and (pair? form) (= (first form) 'defmodule)) (->string (nth form 1)))))

;; Every global bound in module `modname`'s namespace (`modname/…`). Order-independent,
;; so a module's own definitions are attributed to it no matter what loaded first — the
;; robust alternative to a `(reflect/global-names)` delta, which mis-credits transitively-loaded
;; dependencies to whichever file pulled them in.
(defn- docs-namespace-syms (modname)
  (let (prefix (str modname "/"))
    (seq/filter (reflect/global-names) (fn (s) (string/starts-with? (->string s) prefix)))))

(defn model-file
  (path:string -> (record :defs any :doc any :module any :types vector :qualified? true))
  "The doc-model module entry for the file at `path`: load it, then collect its module's
  own public definitions (by namespace, not a load-order-sensitive delta), each a
  `{:name :sig :doc :macro :type :source}` record. The globals a project module binds are
  rooted under the project name (ADR-070) — e.g. `web/endpoint` -> `hive/web/endpoint/…` —
  so the namespace is taken from `project-file-feature` (the rooted name) while the
  module is *displayed* under its declared name. A file with no module header, or read
  outside a project, falls back to the load delta.

    (docs/model-file \"/path/to/proj/src/app.blsp\")   ;~> {:module … :doc \"…\" :defs [{:name … :sig … :doc … :macro false :type … :source …} …] …}"
  (let (src (file/slurp path)
        declared (docs-module-name src)
        ;; check-allow :discarded-catch — a name nothing can type / describe / locate is simply omitted from the docs
        feature (check-allow :discarded-catch
                  (try (project/project-file-feature path) (catch _ nil)))
        before (reflect/global-names))
    (reflect/load path)
    (if feature
      (docs-module-model (or declared feature)
        (docs-leading-doc src)
        (docs-namespace-syms feature)
        feature)
      (docs-module-model (docs-basename path)
        (docs-leading-doc src)
        (docs-added before (reflect/global-names))))))

(defn model-project ()
  "The whole-project doc model — `{:name :version :modules […]}` — found from the cwd,
  documenting every source file under it. Errors if not in a Brood project.

    (docs/model-project)   ;~> {:name \"myapp\" :version \"0.1.0\" :guides … :modules […]}"
  (let (root (docs-setup-root "docs"))
    {:name project/*name*
     :version project/*version*
     :guides (collect-guides root)
     :modules (apply vector (map (project/source-files root) model-file))}))

;; The full builtin+prelude reference (for `nest docs --all`), grouped by the category
;; `doc-catalog` derives from each name's definition site — Math, Strings, Filesystem,
;; Processes, … — so the CLI reference and hive's hosted `/reference` present the language
;; identically.
(defn- model-all ()
  ;; The language surface is the builtins and prelude — NOT the tooling modules
  ;; (`docs`/`project`/…) loaded to run this command. Those are namespaced (`docs/foo`);
  ;; exclude any name whose `/` has a non-empty prefix. A bare operator like `/` (its `/`
  ;; is at position 0) stays in. (Source-location can't tell them apart: an image-restored
  ;; module binding has no def-site, ADR-218.)
  (let (namespaced? (fn (nm) (let (i (index-of nm "/")) (and i (> i 0))))
        language? (fn (s) (and (docs-public? s) (not (namespaced? (->string s)))))
        by-category (seq/group-by (seq/filter (reflect/global-names) language?)
                      (fn (s) (doc-catalog/category-of (docs-bare s)))))
    {:name "Brood"
     :version (try (system/brood-version) (catch _ nil))
     :modules (apply vector
                (seq/filter (map doc-catalog/*category-order*
                              (fn (pair)
                                (let ([key title] pair)
                                  (docs-module-model title nil (get by-category key)))))
                  (fn (group) (not (empty? (get group :defs))))))}))

(defn- write-site (out-dir model title)
  (when (not (file/dir? out-dir)) (file/mkdir out-dir))
  (file/spit (path/join out-dir "index.html") (docsite/render model {:title title}))
  (file/spit (path/join out-dir "model.json") (json/encode model))
  (io/puts (str "Wrote "
             (path/join out-dir "index.html")
             " and model.json ("
             (count (get model :modules))
             " modules)")))

(defn generate-site (& args)
  "Generate an HTML documentation site for the current project into `doc/` (or the
  directory named by the first argument): a rendered `index.html` plus the structured
  `model.json`. The policy behind `nest docs`.

    (docs/generate-site \"site\")   ;~> site/index.html and site/model.json written"
  (let (out-dir (if (empty? args) "doc" (first args)) model (model-project))
    (write-site out-dir model (get model :name))))

(defn generate-site-all (& args)
  "Generate an HTML site for the whole builtin + prelude reference into `doc/` (or the
  first-argument directory) — the language reference. Backs `nest docs --all`.

    (docs/generate-site-all)   ;~> doc/index.html and doc/model.json for the whole language reference"
  (let (out-dir (if (empty? args) "doc" (first args)))
    (write-site out-dir (model-all) "Brood — reference")))

;; --- guides (narrative Markdown pages) ---------------------------------------
;; A `guides/*.md` file becomes a narrative page in the generated site, alongside the API
;; reference, rendered by `markdown/->html` — a CORE module, because the
;; hosted registry renders package READMEs with the same renderer at request time and an
;; app's runtime does not carry this module.

;; A guide's display title from its filename: `getting-started.md` -> `Getting started`.
(defn- guide-title (path)
  (let (file (last (string/split path "/"))
        stem (string/drop-suffix file ".md"))
    (string/capitalize (string/replace stem "-" " "))))

;; Every `guides/*.md` under the project root, rendered — `[{:title :html}]`, sorted by
;; filename. Empty when there is no `guides/` directory.
(defn- collect-guides (root)
  (let (dir (path/join root "guides"))
    (if (not (file/dir? dir))
      []
      (apply vector
        (map (sort (seq/filter (map (file/ls dir) (fn (f) (path/join dir f)))
                     (fn (p) (string/ends-with? p ".md"))))
          (fn (path) {:title (guide-title path) :html (markdown/->html (file/slurp path))}))))))

;; --- doctests (`nest doctest`) -----------------------------------------------
;; One engine checks every documented example: `std/tool/doctest.blsp`, the same one
;; `nest test` gates a project's docstrings with. This is only its front end.

(defn doc-files (root entries)
  "The markdown files the `:doc-paths` `entries` name, relative to `root`, sorted:
`[files missing]`. An entry is a file, a directory (every `.md` under it), or a `!`-prefixed
path whose files are left out. `missing` lists the entries that name nothing, so a typo in
the manifest is said rather than checking nothing.

    (docs/doc-files \".\" [\"README.md\" \"docs\" \"!docs/decisions\"])   ;~> [(\"README.md\" \"docs/language.md\" …) ()]"
  (let (excluded (map (seq/filter entries (fn (e) (string/starts-with? e "!")))
                   (fn (e) (string/drop-prefix e "!")))
        included (seq/filter entries (fn (e) (not (string/starts-with? e "!"))))
        relative (fn (full) (string/drop-prefix full (str root "/")))
        left-out? (fn (p)
                    (any? excluded (fn (x) (or (= p x) (string/starts-with? p (str x "/"))))))
        expand (fn (e)
                 (let (full (path/join root e))
                   (cond
                     (file/dir? full)
                       (map (seq/filter (file/walk-files full) (fn (f) (string/ends-with? f ".md")))
                         relative)
                     (file/exists? full) (list e)
                     else nil))))
    [(sort (seq/filter (seq/distinct (fold included [] (fn (acc e) (append acc (expand e)))))
             (fn (p) (not (left-out? p)))))
      (seq/filter included (fn (e) (not (file/exists? (path/join root e)))))]))

(defn- markdown-doctests (files)
  ;; Run `files`, each a `[path label]` pair, print each failure and a summary, and return
  ;; the failure count.
  (if (empty? files)
    0
    (let (fails (fold files
                  []
                  (fn (acc [path label]) (append acc (doctest/markdown-failures path label)))))
      (each fails (fn (f) (io/puts (str "  FAIL " f))))
      (io/puts (str (count files)
                 " markdown file(s), "
                 (fold files
                   0
                   (fn (n [path _]) (+ n (count (doctest/fenced-blocks (file/slurp path))))))
                 " block(s) checked, "
                 (count fails)
                 " failing example(s)"))
      (count fails))))

(defn run-doctests ()
  "Check every documented example in the current project: its docstrings with `doctest` — a
`form ;=> result` case is evaluated and compared, a `form ;~> result` illustration is read
and its callee checked — then the fenced blocks of the markdown its `:doc-paths` names
(default `README.md` when there is one). Loads the project's sources, prints each failure
and a summary, and returns the failure count (0 = all hold). The policy behind
`nest doctest`."
  (let (root (docs-setup-root "doctest")
        prefix (str project/*name* "/"))
    (project-image/load-sources-cached root)
    (let (fails (doctest/failures-under prefix))
      (each fails (fn (f) (io/puts (str "  FAIL " f))))
      (io/puts (str (count (doctest/documented-names-under prefix))
                 " documented names checked, "
                 (count fails)
                 " failing example(s)"))
      (let ([files missing] (doc-files root (or project/*doc-paths* ["README.md"]))
            ;; The default names a file a project may not have; only a path the manifest
            ;; wrote is an error when it is missing.
            not-found (if project/*doc-paths* missing [])
            markdown (markdown-doctests (map files (fn (f) [(path/join root f) f]))))
        (each not-found
          (fn (e) (io/puts (str "  FAIL :doc-paths names " e ", which does not exist"))))
        (+ (count fails) (count not-found) markdown)))))

(defn run-markdown-doctests (paths)
  "Run the fenced examples in the markdown files `paths` with `doctest/markdown-failures`,
each block in a process of its own. Prints each failure and a summary, and returns the
failure count (0 = all hold). The policy behind `nest doctest FILE.md…`."
  (markdown-doctests (map paths (fn (p) [p p]))))

(defn- doctest-load (path)
  ;; Bring the definitions of source file `path` into the image: a standard-library module
  ;; by name (the binary's own copy — rebuild after editing std/), nothing when the project
  ;; image already holds every name the file defines, else the file itself from disk.
  (let (modules (map (or (module-index/modules-of nil path) nil) ->string)
        builtin (reflect/builtin-modules)
        names (nth (reflect/scan-source-extract (file/slurp path)) 2))
    (cond
      (and (not (empty? modules)) (every? modules (fn (m) (includes? builtin m))))
        (each modules require-one)
      (every? names (fn (n) (bound? (reflect/read-string n)))) nil
      else (reflect/load path))))

(defn run-file-doctests (paths)
  "Check the documented examples of the Brood source files `paths` with
`doctest/failures-in-file`: each file's module is loaded (a std module by name, a file the
project image already holds as it is, any other from disk), then every `form ;=> result`
case and `form ;~> result` illustration in the docstrings of every name it defines (private ones too) is
checked. Prints each failure as `FILE:LINE: …` (the example's own line) and a summary, and
returns the failure count (0 = all hold). The policy behind `nest test --doc FILE…` and
`nest doctest FILE.blsp…`.

    (docs/run-file-doctests [\"src/app.blsp\"])   ;~> 0 — after printing `1 source file(s) checked, 0 failing example(s)`"
  (let (problems (fold paths
                   []
                   (fn (acc path)
                     (cond
                       (not (file/exists? path)) (append acc [(str path ": no such file")])
                       else
                         (let (outcome (try
                                         (do (doctest-load path) nil)
                                         (catch e
                                           (str path ": could not be loaded: " (error-message e)))))
                           (if outcome
                             (append acc [outcome])
                             (append acc (doctest/failures-in-file path))))))))
    (each problems (fn (f) (io/puts (str "  FAIL " f))))
    (io/puts (str (count paths) " source file(s) checked, " (count problems) " failing example(s)"))
    (count problems)))
(defn generate (& args)
  "Print Markdown documentation to stdout: the whole project with no args, or a single module given its name. The policy behind `nest doc`.

    (docs/generate \"app\")   ;~> module app's Markdown printed to stdout"
  (if (empty? args) (io/puts (document-project)) (io/puts (document-module (first args)))))
