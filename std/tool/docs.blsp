;; std/tool/docs.blsp — documentation extraction (`nest doc`), in Brood.
(defmodule docs
  "Generate Markdown documentation for a module by loading it and introspecting
the definitions it adds to the global table.

`(generate)` documents the whole project (every source file under it);
`(generate name)` documents a single module — a baked-in std module, or one
found as <name>.blsp on `*load-path*`. This is policy built on the introspection
primitives (`doc` / `arglist` / `global-names`), `file/slurp`, and the project model
in `std/tool/project.blsp`; Rust supplies only that mechanism (ADR-006).

Attribution uses a `(global-names)` delta around loading the module, so it can't
document a module already loaded before the snapshot (the delta is empty). For
that reason `project` is required lazily, inside `document-project`, rather than
at the top — keeping it out of the snapshot when it is itself the doc target.

`(:use-internals project)` grants access to `project-file-feature` (the rooted
module name of a source file), which `model-file` needs to attribute a project
module's namespace-rooted globals (ADR-070) back to it."
  (:use project)
  (:use-internals project)
  (:use math))

;; --- module source + leading docstring ---------------------------------------

;; The source text of module `key` (a string): a baked-in module if there is one,
;; else the first <key>.blsp found on *load-path*, else nil.
(defn- docs-source
  (key)
  (let (embedded (%builtin-module key))
    (if embedded
      embedded
      (let (path (%require-find (str key ".blsp") *load-path*)) (when path (file/slurp path))))))

;; The module docstring: a module's first top-level form, when it is a string
;; literal (mirrors the function-docstring rule). nil if there's no leading
;; string. The form is discarded when the module is *loaded*, so it is read here
;; from source.
(defn- docs-leading-doc
  (src)
  (let (form (reflect/read-first src))
    (cond
      (string? form) form
      ; bare-string (legacy)
      (and (pair? form) (= (first form) 'defmodule))
        (let (more (rest (rest form)))
          (when (string? (first more)) (first more)))
      else nil)))

;; The bare module title from a file path: "a/b/foo.blsp" -> "foo".
(defn- docs-basename
  (path)
  (let (i (%path-last-slash path (dec (string/length path)))
        file (if (< i 0) path (string/substring path (inc i) (string/length path))))
    (if (string/ends-with? file ".blsp") (string/substring file 0 (- (string/length file) 5)) file)))

;; --- which names a module defines (global-table delta) -----------------------

;; Names present in `after` but not `before` — the bindings a module introduced
;; between two (global-names) snapshots. global-names is sorted, so this is too.
(defn- docs-added (before after) (filter (fn (s) (not (includes? before s))) after))

;; --- rendering ---------------------------------------------------------------

;; A value worth a full entry (signature + docstring): a function or a macro.
(defn- docs-documentable? (v) (or (fn? v) (= (type-of v) :macro)))

;; Module-private, as the image recorded it at the def form (`defn-`/`def-`,
;; ADR-146). These are skipped by (:use) refer-all and omitted from generated docs.
;; `sym` is already the qualified name, which is what `private?` keys on.
(defn- docs-private? (sym) (private? sym))

;; One definition's Markdown: a `### (->string args…)` heading (with a *(macro)* tag
;; for macros) followed by its docstring, or a placeholder when undocumented.
(defn- docs-entry
  (sym v)
  (let (sig (pr-str (cons sym (arglist v)))
        d (doc v)
        suffix (if (= (type-of v) :macro) "  *(macro)*" "")
        ;; The TYPE, when anything knows one — a `(sig …)` the author declared, or the
        ;; curated signature a primitive carries. `nil` for a name nothing types, which
        ;; is most of them, and that line is simply omitted. Guarded like the structured
        ;; record's: a name the checker cannot type must not fail the whole doc build.
        arrow (try (reflect/type-signature sym) (catch _ nil))
        type-line (if (nil? arrow) "" (str "`" arrow "`\n\n")))
    (str "### `" sig "`" suffix "\n\n" type-line (if (nil? d) "_Undocumented._\n" (str d "\n")))))

;; The "Definitions" section: every public function/macro the module added.
(defn- docs-section-defs
  (syms)
  (let (defs (filter (fn (s)
                       (and (docs-documentable? (eval s))
                         (not (docs-private? s))))
               syms))
    (if (empty? defs)
      ""
      ;; `(apply str (map …))` joins once. A `(str acc …)` fold recopies the whole
      ;; accumulator per entry, so a module's Definitions section was O(output²) in the
      ;; markdown it generates — the same shape that made `write-lines` take 1888 ms for
      ;; 16 000 lines (std/file.blsp).
      (str "## Definitions\n\n" (apply str (map (fn (s) (str (docs-entry s (eval s)) "\n")) defs))))))

;; The "Variables" section: public names the module bound to non-function values.
(defn- docs-section-vars
  (syms)
  (let (vars (filter (fn (s)
                       (and (not (docs-documentable? (eval s)))
                         (not (docs-private? s))))
               syms))
    (if (empty? vars)
      ""
      (str "## Variables\n\n" (apply str (map (fn (s) (str "- `" (->string s) "`\n")) vars))))))

;; Assemble one module's Markdown from its title, module doc, and added names.
(defn- docs-render
  (title mdoc syms)
  (str "# module "
    title
    "\n\n"
    (if (nil? mdoc) "" (str mdoc "\n\n"))
    (docs-section-defs syms)
    (docs-section-vars syms)))

;; --- public entry points -----------------------------------------------------

;; Markdown for the module loaded from `path`: snapshot the globals, load the
;; file, and attribute every newly-bound name to it.
(defn document-file (path)
  "The Markdown documentation for the module in the file at `path`: load it and document
  the definitions in its own namespace. Attribution is by namespace (`project-file-feature`,
  ADR-070 rooting), like `model-file` — a `(global-names)` delta mis-credits a module already
  bound (transitively loaded, or materialised from a startup image, ADR-218) and modules the
  file's own load pulls in. Files with no module header, or read outside a project, fall back
  to the delta."
  (let (src (file/slurp path)
        declared (docs-module-name src)
        feature (try (project/project-file-feature path) (catch _ nil))
        before (global-names))
    (load path)
    (if feature
      (docs-render (or declared (docs-basename path))
        (docs-leading-doc src)
        (docs-namespace-syms feature))
      (docs-render (docs-basename path) (docs-leading-doc src) (docs-added before (global-names))))))
(sig document-file (string -> string))

;; Markdown for a module named `modname` (symbol or string): resolve its source
;; (baked-in or on *load-path*), snapshot the globals, `require` it, and document
;; the names it added.
(defn document-module (modname)
  "The Markdown documentation for the module named `modname` (a symbol or string), resolved baked-in or on `*load-path*`. Errors if it can't be found."
  (let (key (->string modname) src (docs-source key))
    (when (nil? src) (error "doc: cannot find module '" key "'"))
    (let (before (global-names))
      (require-one modname)
      ;; Attribute by NAMESPACE, not by a `(global-names)` delta — the same correction
      ;; `document-file` already carries, for the same reason. The delta credits a module
      ;; with only the names its own `require` happened to add, so a module ALREADY bound
      ;; — transitively loaded by the tool's own bootstrap, or materialised from a startup
      ;; image (ADR-218) — documented as EMPTY, silently. `nest doc math`, `nest doc json`
      ;; and `nest doc text` all rendered a header and nothing else; `nest doc uuid`
      ;; worked only because nothing else pulls uuid in.
      ;;
      ;; The delta stays as the fallback for a module whose names are not under its own
      ;; namespace (a bare-rooted module), where the prefix filter finds nothing.
      (let (owned (docs-namespace-syms key)
            syms (if (empty? owned) (docs-added before (global-names)) owned))
        (docs-render key (docs-leading-doc src) syms)))))

;; Markdown for the whole project: find it from the cwd, put its sources on the
;; load-path, and document each source file in turn.
(defn document-project ()
  "The Markdown documentation for the whole project (every source file under it), found from the cwd. Errors if not in a project."
  ; project/find-root / --collect-sources / setup
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "doc: not in a Brood project (no project.blsp found from " (file/cwd) ")"))
    (setup root)
    (let (dirs (project/abs-paths root *project-source-paths*)
          files (fold (fn (acc d) (append acc (project/collect-sources d))) nil dirs))
      ;; One join over the whole project, not a per-file recopy of everything emitted
      ;; so far — this is the outermost of the three, so it was O(total-docs²).
      (apply str (map (fn (f) (str (document-file f) "\n")) files)))))

;; --- the complete builtin/prelude reference (`nest doc --all`) ---------------

;; Is `sym` part of the public surface worth listing in the all-globals
;; reference? Drops private `foo-bar` helpers and raw `%primitive`s (the
;; bootstrap layer the prelude builds variadic ops on top of) — what's left is
;; what a user/agent actually calls.
(defn- docs-public?
  (sym)
  (let (nm (->string sym))
    (and (not (includes? nm "--")) (not (string/starts-with? nm "%")))))

(defn document-all ()
  "The Markdown reference for every *public* global currently bound in the image — each builtin and prelude function/macro with its signature and one-line summary. The complete primitive reference (`nest doc --all`); read this once instead of probing names one at a time. Opt-in std modules (`display`, `buffer`, `ansi`, …) aren't loaded here — `nest doc <module>` documents those."
  (let (syms (filter docs-public? (global-names)))
    (str "# Brood — global reference\n\n"
      "Every public global bound in a fresh image: the Rust builtins plus the "
      "`std/prelude` functions and macros — i.e. everything callable without a "
      "`(require …)`. Generated from the live image (`nest doc --all`), so it is "
      "always in sync. Use `apropos`/`doc-search` to search it interactively; use "
      "`nest doc <module>` for an opt-in module (`display`, `buffer`, `ansi`, …).\n\n"
      (docs-section-defs syms)
      (docs-section-vars syms))))

;; --- structured doc model (`nest docs` — HTML site via `docsite`) ------------

;; The bare (unqualified) name of a symbol: the last "/"-separated segment, e.g.
;; `http/fetch` -> `get`. Bare-named operators like `/` have an empty last segment,
;; so those keep their whole name.
(defn- docs-bare
  (sym)
  (let (nm (->string sym) segments (string/split nm "/"))
    (if (= (last segments) "") nm (last segments))))

;; One definition as a data record for the model: bare name (for anchors/headings),
;; a bare-named signature, docstring, macro flag, type-arrow, and source location.
;; type-signature/source-location are guarded — a name the checker can't type or the
;; image can't locate yields nil rather than failing the whole build.
(defn- docs-def-record
  (sym v)
  (let (bare (docs-bare sym))
    {:name bare
     :sig (pr-str (cons (symbol bare) (arglist v)))
     :doc (doc v)
     :macro (= (type-of v) :macro)
     :type (try (reflect/type-signature sym) (catch _ nil))
     :source (try (reflect/source-location sym) (catch _ nil))}))

;; The public documentable definitions among `syms`, as records (in `syms` order).
(defn- docs-def-records
  (syms)
  (apply vector
    (map (fn (s) (docs-def-record s (eval s)))
      (filter (fn (s) (and (docs-documentable? (eval s)) (not (docs-private? s)))) syms))))

;; One module entry of the doc model: `{:module :doc :defs :qualified?}`. `:qualified? true`
;; — a project/library module IS a namespace, so its defs render as their call form
;; (`math/sqrt`, `web/endpoint/handler`), not bare (a bare `sqrt` is unbound; you reference
;; the qualified name or `(:use)`). The prelude-category pseudo-modules the reference adds
;; leave it false (their names — `+`, `map` — are genuinely bare).
(defn- docs-module-model
  (title mdoc syms)
  {:module title :doc mdoc :defs (docs-def-records syms) :qualified? true})

;; A file's declared module name — the `(defmodule NAME …)` symbol — or nil if the file
;; has no module header. Read from source (the form is discarded once loaded).
(defn- docs-module-name
  (src)
  (let (form (try (reflect/read-first src) (catch _ nil)))
    (when (and (pair? form) (= (first form) 'defmodule)) (->string (nth form 1)))))

;; Every global bound in module `modname`'s namespace (`modname/…`). Order-independent,
;; so a module's own definitions are attributed to it no matter what loaded first — the
;; robust alternative to a `(global-names)` delta, which mis-credits transitively-loaded
;; dependencies to whichever file pulled them in.
(defn- docs-namespace-syms
  (modname)
  (let (prefix (str modname "/"))
    (filter (fn (s) (string/starts-with? (->string s) prefix)) (global-names))))

(defn model-file (path)
  "The doc-model module entry for the file at `path`: load it, then collect its module's
  own public definitions (by namespace, not a load-order-sensitive delta), each a
  `{:name :sig :doc :macro :type :source}` record. The globals a project module binds are
  rooted under the project name (ADR-070) — e.g. `web/endpoint` -> `hive/web/endpoint/…` —
  so the namespace is taken from `project-file-feature` (the rooted name) while the
  module is *displayed* under its declared name. A file with no module header, or read
  outside a project, falls back to the load delta."
  (let (src (file/slurp path)
        declared (docs-module-name src)
        feature (try (project/project-file-feature path) (catch _ nil))
        before (global-names))
    (load path)
    (if feature
      (docs-module-model (or declared feature) (docs-leading-doc src) (docs-namespace-syms feature))
      (docs-module-model (docs-basename path)
        (docs-leading-doc src)
        (docs-added before (global-names))))))
(sig model-file (string -> (record :defs any :doc any :module any :qualified? true)))

(defn model-module (modname)
  "The doc-model module entry for the module named `modname` (a symbol or string),
  resolved baked-in or on `*load-path*`. Errors if it can't be found."
  (let (key (->string modname) src (docs-source key))
    (when (nil? src) (error "docs: cannot find module '" key "'"))
    (let (before (global-names))
      (require-one modname)
      (docs-module-model key (docs-leading-doc src) (docs-added before (global-names))))))

(defn model-project ()
  "The whole-project doc model — `{:name :version :modules […]}` — found from the cwd,
  documenting every source file under it. Errors if not in a Brood project."
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "docs: not in a Brood project (no project.blsp found from " (file/cwd) ")"))
    (setup root)
    (let (dirs (project/abs-paths root *project-source-paths*)
          files (fold (fn (acc d) (append acc (project/collect-sources d))) nil dirs))
      {:name *project-name*
       :version *project-version*
       :guides (collect-guides root)
       :modules (apply vector (map model-file files))})))

;; The full builtin+prelude reference (for `nest docs --all`), grouped by function
;; category via the shared `doc-catalog` — Math, Strings, Filesystem, Processes, … — so
;; the CLI reference and hive's hosted `/reference` present the language identically. A
;; name the catalogue doesn't know falls into the `:other` group.
(defn- model-all
  ()
  ;; The language surface is the builtins and prelude — NOT the tooling modules
  ;; (`docs`/`project`/…) loaded to run this command. Those are namespaced (`docs/foo`);
  ;; exclude any name whose `/` has a non-empty prefix. A bare operator like `/` (its `/`
  ;; is at position 0) stays in. (Source-location can't tell them apart: an image-restored
  ;; module binding has no def-site, ADR-218.)
  (let (namespaced? (fn (nm) (let (i (index-of nm "/")) (and i (> i 0))))
        language? (fn (s) (and (docs-public? s) (not (namespaced? (->string s)))))
        syms (filter language? (global-names))
        category-of (fn (s) (doc-catalog/category-of (docs-bare s))))
    {:name "Brood"
     :version (try (system/brood-version) (catch _ nil))
     :modules (apply vector
                (filter (fn (group) (not (empty? (get group :defs))))
                  (map (fn (pair)
                         (let ([key title] pair)
                           (docs-module-model title
                             nil
                             (filter (fn (s) (= (category-of s) key)) syms))))
                    doc-catalog/*category-order*)))}))

(defn- write-site
  (out-dir model title)
  (when (not (file/dir? out-dir)) (file/mkdir out-dir))
  (file/spit (path/join out-dir "index.html") (docsite/render model {:title title}))
  (file/spit (path/join out-dir "model.json") (json/encode model))
  (io/puts (str "Wrote "
             (path/join out-dir "index.html")
             " and model.json ("
             (count (get model :modules))
             " modules)")))

(defn generate-site (& args)
  "Generate an HTML documentation site for the current project into `doc/` (or the
  directory named by the first argument): a rendered `index.html` plus the structured
  `model.json`. The policy behind `nest docs`."
  (let (out-dir (if (empty? args) "doc" (first args)) model (model-project))
    (write-site out-dir model (get model :name))))

(defn generate-site-all (& args)
  "Generate an HTML site for the whole builtin + prelude reference into `doc/` (or the
  first-argument directory) — the language reference. Backs `nest docs --all`."
  (let (out-dir (if (empty? args) "doc" (first args)))
    (write-site out-dir (model-all) "Brood — reference")))

;; --- guides (narrative Markdown pages) ---------------------------------------
;; A `guides/*.md` file becomes a narrative page in the generated site, alongside the API
;; reference. A small Markdown subset: ATX headings, fenced code, `- ` lists, blank-line
;; paragraphs, and inline `code`/[text](url) links — enough for a getting-started guide.

(defn- md-escape
  (s)
  (-> (str s) (string/replace "&" "&amp;") (string/replace "<" "&lt;") (string/replace ">" "&gt;")))

;; Escape a URL for an `href="…"` attribute (adds `"` to `md-escape`) and neutralise a
;; `javascript:` link, so a guide's Markdown can't break out of the attribute or inject
;; script into the generated site.
(defn- md-attr
  (url)
  (if (string/starts-with? (string/trim url) "javascript:")
    "#"
    (string/replace (md-escape url) "\"" "&quot;")))

;; A non-code text run: turn `[text](url)` into a link, HTML-escape everything else.
(defn- md-links
  (text)
  (apply str (reverse (md-links-acc text '()))))

;; The scanning worker: **tail**-recursive, carrying the emitted chunks newest-first (so the
;; caller reverses once) rather than nesting `str` around the recursive call. Two reasons it is
;; shaped this way and not as the obvious `(str … (md-links rest))`: that form recurses once per
;; link in non-tail position, which the checker flags for stack headroom; and each level built a
;; fresh concatenation of everything after it, which is quadratic in the number of links. A list
;; of chunks plus one `apply str` is linear. Behaviour is unchanged — `tests/docs_test.blsp`
;; characterised every branch against the previous implementation before this was written.
(defn- md-links-acc
  (text chunks)
  (let (open-bracket (index-of text "[")
        close-bracket (index-of text "]"))
    (cond
      ;; no `[`, or a `]` before any `[` with no closing `]` after — no link, escape all.
      ;; (`index-of` returns -1 when absent, so both bounds are guarded — missing the `]`
      ;; guard recursed on the same text and stack-overflowed.)
      (or (not (number? open-bracket)) (< open-bracket 0)) (cons (md-escape text) chunks)
      (or (not (number? close-bracket)) (< close-bracket open-bracket))
        (cons (md-escape text) chunks)
      ;; `[text](url)` — a real link
      (= (string/substring text
           (+ close-bracket 1)
           (math/min (+ close-bracket 2) (string/length text)))
        "(")
        (let (rest (string/substring text (+ close-bracket 2) (string/length text))
              close-paren (index-of rest ")"))
          (if (and (number? close-paren) (>= close-paren 0))
            (md-links-acc (string/substring rest (+ close-paren 1) (string/length rest))
              (cons "</a>"
                (cons (md-escape (string/substring text (+ open-bracket 1) close-bracket))
                  (cons "\">"
                    (cons (md-attr (string/substring rest 0 close-paren))
                      (cons "<a href=\""
                        (cons (md-escape (string/substring text 0 open-bracket)) chunks)))))))
            (cons (md-escape text) chunks)))
      ;; a `[…]` that isn't a link — emit it literally, continue past the `]`
      else
        (md-links-acc (string/substring text (+ close-bracket 1) (string/length text))
          (cons (md-escape (string/substring text 0 (+ close-bracket 1))) chunks)))))

;; Inline Markdown for one text run: `code` spans (backtick pairs) plus links via `md-links`.
(defn- md-inline
  (text)
  (let (parts (string/split text "`"))
    (apply str
      (map (fn (pair)
             (let ([i seg] pair)
               (if (odd? i) (str "<code>" (md-escape seg) "</code>") (md-links seg))))
        (seq/zip (range (count parts)) parts)))))

;; Emit a buffered paragraph or list when a block ends; a no-op for other modes.
(defn- md-flush
  (state)
  (let (mode (get state :mode) buf (get state :buf) out (get state :out))
    (cond
      (= mode :para)
        (assoc state
          :out (str out "<p>" (md-inline (string/join " " (reverse buf))) "</p>")
          :mode :none
          :buf nil)
      (= mode :list)
        (assoc state
          :out
            (str out
              "<ul>"
              (apply str (map (fn (l) (str "<li>" (md-inline l) "</li>")) (reverse buf)))
              "</ul>")
          :mode :none
          :buf nil)
      ;; an unclosed ``` fence at end-of-input: emit what was buffered rather than drop it
      (= mode :code)
        (assoc state
          :out (str out "<pre><code>" (md-escape (string/join "\n" (reverse buf))) "</code></pre>")
          :mode :none
          :buf nil)
      else state)))

(defn- md-line
  (state line)
  (let (mode (get state :mode) t (string/trim line) end (string/length (string/trim line)))
    (cond
      (string/starts-with? t "```")
        (if (= mode :code)
          (assoc state
            :mode :none
            :buf nil
            :out
              (str (get state :out)
                "<pre><code>"
                (md-escape (string/join "\n" (reverse (get state :buf))))
                "</code></pre>"))
          (assoc (md-flush state) :mode :code :buf nil))
      (= mode :code) (assoc state :buf (cons line (get state :buf)))
      (string/starts-with? t "### ")
        (let (s (md-flush state))
          (assoc s :out (str (get s :out) "<h3>" (md-inline (string/substring t 4 end)) "</h3>")))
      (string/starts-with? t "## ")
        (let (s (md-flush state))
          (assoc s :out (str (get s :out) "<h2>" (md-inline (string/substring t 3 end)) "</h2>")))
      (string/starts-with? t "# ")
        (let (s (md-flush state))
          (assoc s :out (str (get s :out) "<h1>" (md-inline (string/substring t 2 end)) "</h1>")))
      (or (string/starts-with? t "- ") (string/starts-with? t "* "))
        (let (s (if (= mode :list) state (md-flush state)))
          (assoc s :mode :list :buf (cons (string/substring t 2 end) (get s :buf))))
      (= t "") (md-flush state)
      else
        (let (s (if (= mode :para) state (md-flush state)))
          (assoc s :mode :para :buf (cons line (get s :buf)))))))

(defn markdown->html (md)
  "Render a Markdown string to HTML — a small subset (ATX headings, fenced ``` code, `- `
  lists, blank-line paragraphs, inline `code`/links). Everything is HTML-escaped; not a
  full CommonMark parser. Used for doc guides.

    (docs/markdown->html \"# hi\")   → \"<h1>hi</h1>\""
  (get (md-flush (fold md-line {:out "" :mode :none :buf nil} (string/split md "\n"))) :out))
(sig markdown->html (string -> any))

;; A guide's display title from its filename: `getting-started.md` -> `Getting started`.
(defn- guide-title
  (path)
  (let (file (last (string/split path "/"))
        stem (if (string/ends-with? file ".md")
               (string/substring file 0 (- (string/length file) 3))
               file))
    (string/capitalize (string/replace stem "-" " "))))

;; Every `guides/*.md` under the project root, rendered — `[{:title :html}]`, sorted by
;; filename. Empty when there is no `guides/` directory.
(defn- collect-guides
  (root)
  (let (dir (path/join root "guides"))
    (if (not (file/dir? dir))
      []
      (apply vector
        (map (fn (path) {:title (guide-title path) :html (markdown->html (file/slurp path))})
          (sort (filter (fn (p) (string/ends-with? p ".md"))
                  (map (fn (f) (path/join dir f)) (file/ls dir)))))))))

;; --- doctests (`nest doctest`) -----------------------------------------------
;; A doctest is a docstring line of the form `<expr> ;=> <expected>` (the expression
;; alone before the marker, on its own line). `nest doctest` evaluates each and checks it
;; equals `<expected>`, so a documented example can't silently drift from behaviour.

;; Parse one line into `[expr-str expected-str]`, or nil if it holds no `;=>` example.
(defn- doctest-of-line
  (line)
  (let (i (index-of line ";=>"))
    (when (and (number? i) (> i 0))
      (let (expr (string/trim (string/substring line 0 i))
            expected (string/trim (string/substring line (+ i 3) (string/length line))))
        (when (and (not (= expr "")) (not (= expected ""))) [expr expected])))))

;; Every `expr ;=> expected` example in a docstring, in source order.
(defn- doctests-in
  (docstring)
  (filter (fn (x) (not (nil? x))) (map doctest-of-line (string/split docstring "\n"))))

;; Evaluate one example: `[:ok]`, `[:fail actual expected]`, or `[:error message]`.
(defn- run-one-doctest
  (expr-str expected-str)
  (try
    (let (actual (eval (reflect/read-first expr-str))
          expected (eval (reflect/read-first expected-str)))
      (if (= actual expected) [:ok] [:fail actual expected]))
    (catch e [:error (error-message e)])))

;; Collect every example from the *project's own* documented globals (those namespaced
;; under `prefix`, e.g. `myproj/`), evaluated. Scoping to the project keeps the tooling's
;; own docstrings (this module's `;=>` examples, in prose) and the builtins out.
(defn- collect-doctests
  (prefix)
  (fold (fn (acc sym)
          (if (not (string/starts-with? (->string sym) prefix))
            acc
            (let (v (try (eval sym) (catch _ nil))
                  d (when v (try (doc v) (catch _ nil))))
              (if (and (string? d) (includes? d ";=>"))
                (append acc
                  (map (fn (ex) [sym (nth ex 0) (nth ex 1) (run-one-doctest (nth ex 0) (nth ex 1))])
                    (doctests-in d)))
                acc))))
    nil
    (global-names)))

(defn- doctest-report
  (results)
  (let (fails (filter (fn (r) (not (= (first (nth r 3)) :ok))) results))
    (doseq (r results)
      (let ([sym expr expected outcome] r)
        (match outcome
          ([:ok] (io/puts (str "  ok   " (->string sym) ": " expr " ;=> " expected)))
          ([:fail actual _] (io/puts (str "  FAIL "
                                       (->string sym)
                                       ": "
                                       expr
                                       " ;=> "
                                       expected
                                       " — got "
                                       (pr-str actual))))
          ([:error msg] (io/puts (str "  ERR  " (->string sym) ": " expr " — " msg))))))
    (io/puts (str (count results)
               " doctests, "
               (- (count results) (count fails))
               " passed, "
               (count fails)
               " failed"))
    (count fails)))

(defn run-doctests ()
  "Evaluate every `expr ;=> result` example in the current project's docstrings and check
  it equals `result`, so documentation examples can't drift from behaviour. Loads the
  project's sources, prints a line per example, and returns the failure count (0 = all
  passed). The policy behind `nest doctest`."
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "doctest: not in a Brood project (no project.blsp found from " (file/cwd) ")"))
    (setup root)
    (project/load-sources-cached root)
    (doctest-report (collect-doctests (str *project-name* "/")))))

(defn generate (& args)
  "Print Markdown documentation to stdout: the whole project with no args, or a single module given its name. The policy behind `nest doc`."
  (if (empty? args) (io/puts (document-project)) (io/puts (document-module (first args)))))
