;; std/tool/scaffold.blsp — `nest new` project scaffolding.
;; Templates + new-project, split out of tool/project.blsp (which keeps project
;; analysis: manifest parsing, test discovery, lints, release, config).
; for project/*config-git-init*
(defmodule scaffold
  "`nest new` project scaffolding — templates and new-project creation, split
out of the `project` module (which keeps project analysis: manifest parsing,
test discovery, lints, release, config)."
  (:use project))
;; --- scaffolding a new project (`nest new <name>`) ---------------------------
;; True if the 1-char string `ch` occurs in `s` (a short scan — Brood has no char
;; index yet, and project names/paths are short).
(defn- str-contains? (s ch)
  (cond
    (= (string/length s) 0) false
    (= (string/substring s 0 1) ch) true
    else (str-contains? (string/substring s 1 (string/length s)) ch)))

;; A project name must be a single, fresh path component in the current
;; directory: non-empty, no path separators or whitespace, no NUL, and not
;; one of the path-traversal / hidden / flag-shaped names (`.`, `..`, leading
;; `.`/`-`/`~`/`\`). This blocks `nest new ..` and friends from scaffolding
;; into a parent or hidden directory — see CLAUDE.md / docs/devlog.md.
;; The module name the scaffolded LIBRARY module gets: the project's own name, made
;; safe to write as a bare symbol and as a filename.
;;
;; Not a fixed name: two scaffolded projects must be able to depend on each other without
;; a module-name collision (ADR-070). A dependency called `greeter` provides `greeter`.
;;
;; `project-valid-name?` only rejects path separators, whitespace and a leading dot,
;; so a legal project name can still hold punctuation a symbol shouldn't; anything
;; outside [a-z A-Z 0-9 - _] becomes `-`. A leading digit gets a `p-` prefix (a symbol
;; must not read as a number), and the reserved `main` becomes `main-lib` so the
;; library module can't collide with the project's own entry module.
(defn- project-module-name (nm)
  (let (cleaned (string/join (map (string/split nm "") project-name-char) "")
        prefixed (if (and (> (string/length cleaned) 0)
                       (includes? "0123456789"
                         (string/substring cleaned 0 1)))
                   (str "p-" cleaned)
                   cleaned))
    (cond
      ;; No letters or digits survived (a name of pure punctuation): `---` is a legal
      ;; symbol but a meaningless module name and an odd filename, so fall back.
      (not (project-has-alnum? prefixed)) "lib"
      (= prefixed "main") "main-lib"
      else prefixed)))

(defn- project-has-alnum? (s)
  (fold (string/split s "")
    false
    (fn (found ch)
      (or found (includes? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" ch)))))

(defn- project-name-char (ch)
  (if (includes? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" ch) ch "-"))

(defn- project-valid-name? (nm)
  (and (> (string/length nm) 0)
    (not (= nm "."))
    (not (= nm ".."))
    (not (str-contains? nm "/"))
    (not (str-contains? nm "\\"))
    (not (str-contains? nm " "))
    (not (str-contains? nm "\t"))
    (not (str-contains? nm "\n"))
    (not (str-contains? nm "\0"))
    (not (= (string/substring nm 0 1) "."))
    (not (= (string/substring nm 0 1) "-"))
    (not (= (string/substring nm 0 1) "~"))))

;; --- file templates (the starter skeleton) ---
(defn- project-manifest-template (nm)
  (str ";; "
    nm " — a Brood project.\n" "(project\n" "  :name \"" nm "\"\n" "  :version \"0.1.0\")\n" "\n"
    ";; To depend on other Brood packages, add a :dependencies vector to the form\n"
    ";; above (ADR-037). Dep names are bare symbols (no quoting):\n" ";;\n"
    ";;   :dependencies [[pretty :git \"https://github.com/you/brood-pretty.git\" :ref \"v1.0.0\"]\n"
    ";;                  [shared :path \"../shared\"]]\n" ";;\n"
    ";; Then any `nest` command resolves them. project.lock.blsp is committed;\n"
    ";; _deps/ (the cache) is gitignored.\n"))

(defn- project-main-template (nm)
  (str "(defmodule main \"The "
    nm
    " project's entry-point module — wired up as\n"
    "the `nest run` entry by default (module `main`, fn `main`).\"\n"
    "  (:use "
    (project-module-name nm)
    ")\n"
    ;; NB: comment goes ABOVE the form, not trailing the `(:use log)` clause — a
    ;; comment inside a list is re-emitted on its own line by the formatter, which
    ;; would hoist it above the whole `defmodule` and leave `nest new` output
    ;; failing `nest format --check` on the very first run.
    ;;
    ;; `:exclude [error]` because `log/error` shadows the prelude's `error`, and a plain
    ;; `(:use log)` made a freshly scaffolded project print a shadowing warning on its very
    ;; first `nest test` — the first thing a new user sees, about code they did not write.
    ;; Excluding it is also the honest default: `error` RAISES and `log/error` records a
    ;; line, so the two are not interchangeable and the prelude's is the one a body reaches
    ;; for. The scaffold thus doubles as the worked example of the escape hatch.
    "  ;; `log` is the async, safe logger (std/log). `error` is excluded because\n"
    "  ;; `log/error` would shadow the prelude's raising `error`; reach it as `log/error`.\n"
    "  (:use log :exclude [error]))\n"
    "\n"
    "(defn main ()\n"
    "  \"Entry point: start the logger and print the project's greeting.\"\n"
    "  ;; `start-logger` spawns a logging process (async — each `log-*` call is\n"
    "  ;; fire-and-forget, and one process serialises every write, so lines never\n"
    "  ;; interleave). The default backend writes to stdout at :info and up.\n"
    "  (start-logger)\n"
    "  (info \"starting "
    nm
    "\")\n"
    "  ;; Add backends to fan output out — e.g. to a file, or to a process that\n"
    "  ;; owns a buffer (an editor's *Messages*); the line is sent as [:write s]:\n"
    "  ;;   (add-backend (file-backend \"app.log\"))\n"
    "  ;;   (add-backend (process-backend buffer-pid))\n"
    "  ;; To redirect plain `io/puts` the same way, reference `io/with-out` — a\n"
    "  ;; qualified name loads its module, so there is nothing to require:\n"
    "  ;;   (io/with-out (process-port buffer-pid) (io/puts \"…\")).\n"
    "  (io/puts (greeting)))\n"))

(defn- project-hello-template (nm)
  (let (mod (project-module-name nm))
    (str "(defmodule "
      mod " \"The " nm " project's library module — `main` does\n" "`(:use " mod
      ")` to call `greeting`. Showcases the module/namespace system\n"
      "(ADR-065): this defines `greeting` as `" mod "/greeting`; `(:use " mod ")`\n"
      "imports it so `main` can call it bare.\n" "\n"
      "Named after the package on purpose: a dependency should provide a module named\n"
      "for itself, so two projects can depend on each other without a name clash\n"
      "(namespaces aren't package-rooted yet — ADR-070).\")\n" "\n" "(defn greeting ()\n"
      "  \"Return the project's greeting string.\"\n" "  \"hello " nm "\")\n")))

(defn- project-main-test-template (nm)
  (str ";; Tests for the main module. `(:use main)` brings `main` into scope;\n"
    ";; `(:use test)` the describe/test/is macros. `nest test` loads src/ first.\n"
    "(defmodule main-test (:use main) (:use test))\n" "\n" "(describe \"main\"\n"
    "  (test \"main is callable\" (is (fn? main))))\n"))

(defn- project-hello-test-template (nm)
  (let (mod (project-module-name nm))
    (str ";; Tests for the "
      mod " module. `(:use " mod ")` brings `greeting` into\n"
      ";; scope; `(:use test)` the describe/test/assert= macros.\n" "(defmodule " mod "-test (:use "
      mod ") (:use test))\n" "\n" "(describe \"" mod "\"\n"
      "  (test \"greeting\" (assert= (greeting) \"hello " nm "\")))\n")))

;; --- alternate starter templates (`nest new --template …`) ------------------

;; `tui-loop`: a terminal-animation loop — the cellular-automaton / roguelike /
;; game genre. A pure state tuple threaded through a tail-recursive loop (Brood
;; has no `while`), one frame per tick. Pairs with `nest run --for 2s` to run it
;; for a bounded time. Kept to plain stdout for portability; for a real
;; full-screen UI use the `term-*` seam (docs/building-an-editor.md).
(defn- project-tui-main-template (nm)
  (str "(defmodule main \""
    nm " — a terminal animation loop.\n"
    "Run it bounded:  nest run --for 2s   (Ctrl-C also stops it).\")\n" "\n"
    ";; State is threaded through a tail-recursive loop — no mutation, no `while`.\n" "\n"
    "(defn render (pos width)\n"
    "  \"One frame: a marker at column `pos` on a `width`-wide track.\"\n"
    "  (str \"[\" (string/repeat \" \" pos) \"*\" (string/repeat \" \" (- width pos 1)) \"]\"))\n"
    "\n" "(defn step (pos dir width)\n"
    "  \"Advance one cell, bouncing off either wall. Returns [pos dir].\"\n"
    "  (let (nxt (+ pos dir))\n" "    (cond\n" "      (< nxt 0)      [1 1]\n"
    "      (>= nxt width) [(- width 2) -1]\n" "      else           [nxt dir])))\n" "\n"
    ";; The loop is a tail-recursive function: it threads the state (pos, dir) and\n"
    ";; calls itself in tail position, so it runs in O(1) stack — no mutation, no\n"
    ";; `while`. (Brood has proper tail calls, so recursion *is* the loop; for a loop\n"
    ";; local to one function, `letrec` binds one inline instead.)\n"
    "(defn animate (pos dir width)\n" "  (io/puts (render pos width))\n" "  (proc/sleep 80)\n"
    "  (let ([p d] (step pos dir width))\n" "    (animate p d width)))\n" "\n" "(defn main ()\n"
    "  \"Entry point: animate a bouncing marker.\"\n" "  (animate 0 1 20))\n"))

(defn- project-tui-test-template (nm)
  (str ";; Test the pure frame logic directly — the loop itself is exercised by\n"
    ";; `nest run --for`, its pure functions by `nest test`.\n"
    "(defmodule main-test (:use main) (:use test))\n" "\n" "(describe \"animation\"\n"
    "  (test \"step bounces off the left wall\" (assert= (step 0 -1 20) [1 1]))\n"
    "  (test \"step bounces off the right wall\" (assert= (step 19 1 20) [18 -1]))\n"
    "  (test \"step advances in open space\" (assert= (step 5 1 20) [6 1]))\n"
    "  (test \"render marks the right column\" (assert= (render 0 3) \"[*  ]\")))\n"))

;; `gen`: a stateful server process via the `gen` framework.
;; Genuine mutable state lives in a process's loop, not a variable (ADR-026):
;; async `cast` threads new state, synchronous `call` reads/updates it.
(defn- project-gen-main-template (nm)
  (str "(defmodule main \""
    nm " — a stateful process built with the gen framework.\"\n"
    "  ;; `(:use gen)` refers defserver / start / cast / call bare.\n" "  (:use gen))\n" "\n"
    ";; A counter server. State `n` is the process's; messages drive it.\n" "(defserver counter\n"
    "  (n)\n" "  ;; async: bump the count\n" "  (cast :inc (+ n 1))\n" "  ;; async: add m\n"
    "  (cast [:add m] (+ n m))\n" "  ;; sync: reply n, state unchanged\n" "  (call :value [n n]))\n"
    "\n" "(defn main ()\n" "  \"Entry point: start a counter, drive it, read the result.\"\n"
    "  (let (c (start counter 0))\n" "    (cast c :inc)\n" "    (cast c :inc)\n"
    "    (cast c [:add 10])\n" "    (io/puts \"counter =\" (call c :value))))\n"))

(defn- project-gen-test-template (nm)
  (str ";; `(:use main)` brings `counter`; `(:use gen)` the `cast`/`call` API;\n"
    ";; `(:use test)` the macros. :isolated — these spawn processes.\n"
    "(defmodule main-test (:use main) (:use gen) (:use test))\n" "\n" "(describe \"counter\"\n"
    "  :isolated\n" "  (test \"casts thread state; a call reads it\"\n"
    "    (let (c (start counter 0))\n" "      (cast c :inc) (cast c :inc) (cast c [:add 10])\n"
    "      (assert= (call c :value) 12))))\n"))

;; `editor`: a tiny text editor on the `ui` framework (std/editor/ui.blsp) — a `ui-run`
;; client like the observer. The buffer is a list of line strings + a [row col]
;; cursor; every edit is a pure `(model -> model)` function (testable without a
;; terminal); `view`/`update` plug into `ui-run`, which owns the loop + teardown.
;; Runs in the terminal (`editor/frontend/*term-display*`) or, with `--features gui`, a window.
(defn- project-editor-main-template (nm)
  (str "(defmodule main \""
    nm " — a tiny text editor built on the `ui` framework.\n" "\n"
    "Run it:  nest run   (type to edit, arrows move, Enter splits a line, Backspace\n"
    "deletes, Ctrl-C quits). The buffer is a list of line strings with a [row col]\n"
    "cursor; every edit is a pure (model -> model) function and `ui-run` drives the\n"
    "loop — render `view`, poll a key, fold it with `update`, repeat. Swap\n"
    "`editor/frontend/*term-display*` for `(gui-display)` (a --features gui build) to run in a window.\"\n"
    "  ;; the app framework: the `ui-run` loop, then the display frontends\n" "  (:use editor/ui)\n"
    "  (:use editor/frontend)\n" "  ;; the render-op constructors (clear / text / cursor / frame)\n"
    "  (:use editor/display)\n" "  ;; the seq module's sequence helpers (enumerate)\n"
    "  (:use seq))\n" "\n" "(def *welcome*\n" "  (list \"hello, world\"\n" "        \"\"\n"
    "        \"a tiny editor — grow it from here.\"))\n" "\n" "(defn ed-init ()\n"
    "  \"The starting model: the welcome buffer, cursor at the top-left.\"\n"
    "  {:lines *welcome* :row 0 :col 0 :done false :tick-ms 30000})\n" "\n"
    "(defn ed-line (m) \"The line the cursor is on.\" (nth (get m :lines) (get m :row)))\n" "\n"
    "(defn ed-set-line (lines row s)\n"
    "  \"`lines` with line `row` replaced by `s` (lists are immutable — rebuild it).\"\n"
    "  (append (take lines row) (cons s (drop lines (inc row)))))\n" "\n"
    "(defn ed-move (m drow dcol)\n"
    "  \"Move the cursor by [drow dcol], clamped to the buffer and the target line.\"\n"
    "  (let (lines (get m :lines)\n"
    "        row (math/max 0 (math/min (dec (count lines)) (+ (get m :row) drow)))\n"
    "        col (math/max 0 (math/min (string/length (nth lines row)) (+ (get m :col) dcol))))\n"
    "    (assoc m :row row :col col)))\n" "\n" "(defn ed-insert (m ch)\n"
    "  \"Insert the printable string `ch` at the cursor.\"\n"
    "  (let (ln (ed-line m) col (get m :col)\n"
    "        ln2 (str (string/substring ln 0 col) ch (string/substring ln col (string/length ln))))\n"
    "    (assoc m :lines (ed-set-line (get m :lines) (get m :row) ln2)\n"
    "             :col (+ col (string/length ch)))))\n" "\n" "(defn ed-newline (m)\n"
    "  \"Split the current line at the cursor into two lines.\"\n"
    "  (let (ln (ed-line m) row (get m :row) col (get m :col) lines (get m :lines))\n"
    "    (assoc m\n" "           :lines (append (take lines row)\n"
    "                          (list (string/substring ln 0 col) (string/substring ln col (string/length ln)))\n"
    "                          (drop lines (inc row)))\n" "           :row (inc row) :col 0)))\n"
    "\n" "(defn ed-backspace (m)\n"
    "  \"Delete the char before the cursor; at column 0, join with the previous line.\"\n"
    "  (let (row (get m :row) col (get m :col) lines (get m :lines))\n" "    (cond\n"
    "      (> col 0)\n" "        (let (ln (ed-line m))\n"
    "          (assoc m :lines (ed-set-line lines row\n"
    "                            (str (string/substring ln 0 (dec col)) (string/substring ln col (string/length ln))))\n"
    "                   :col (dec col)))\n" "      (> row 0)\n"
    "        (let (prev (nth lines (dec row)))\n" "          (assoc m\n"
    "                 :lines (append (take lines (dec row))\n"
    "                                (cons (str prev (ed-line m)) (drop lines (inc row))))\n"
    "                 :row (dec row) :col (string/length prev)))\n" "      else m)))\n" "\n"
    "(defn ed-fit (s w) \"Clip `s` to `w` columns.\" (if (> (string/length s) w) (string/substring s 0 w) s))\n"
    "\n" "(defn ed-view (m cols rows)\n"
    "  \"ui-run view: a `text` op per line, a reverse-video status bar, cursor at point.\"\n"
    "  (apply frame\n" "    (append\n" "      [(clear)]\n"
    "      (map (enumerate (get m :lines)) (fn ([i ln]) (text i 0 (ed-fit ln cols))))\n"
    "      [(text (dec rows) 0\n"
    "             (ed-fit (str \" \" (inc (get m :row)) \":\" (get m :col) \"  —  Ctrl-C to quit\") cols)\n"
    "             {:reverse true})\n" "       (cursor (get m :row) (get m :col))])))\n" "\n"
    "(defn ed-update (m input cols rows)\n"
    "  \"ui-run update: printable keys insert, specials move/edit, Ctrl-C (or Esc)\n"
    "quits. `:tick` (the refresh beat) is a no-op here — nothing animates.\"\n" "  (cond\n"
    "    (= input :tick) m\n" "    (or (= input :ctrl-c) (= input :escape)) (assoc m :done true)\n"
    "    (= input :up)    (ed-move m -1 0)\n" "    (= input :down)  (ed-move m 1 0)\n"
    "    (= input :left)  (ed-move m 0 -1)\n" "    (= input :right) (ed-move m 0 1)\n"
    "    (= input :enter)     (ed-newline m)\n" "    (= input :backspace) (ed-backspace m)\n"
    "    (string? input)      (ed-insert m input)\n" "    else m))\n" "\n" "(defn main ()\n"
    "  \"Run the editor in the terminal (Ctrl-C quits). For a window, build with\n"
    "--features gui and pass `(gui-display)` instead of `editor/frontend/*term-display*`.\"\n"
    "  (ui-run (ed-init) ed-view ed-update editor/frontend/*term-display*))\n"))

(defn- project-editor-test-template (nm)
  (str ";; `(:use main)` brings the pure edit fns (ed-insert, …); `(:use test)` the macros.\n"
    ";; The loop is `ui-run`'s; here we test the edits — pure `(model -> model)`.\n"
    "(defmodule main-test (:use main) (:use test))\n" "\n" "(describe \"editor edits\"\n"
    "  (test \"insert puts a char at the cursor\"\n"
    "    (assert= (get (ed-insert {:lines (list \"ac\") :row 0 :col 1} \"b\") :lines) (list \"abc\")))\n"
    "  (test \"backspace deletes the char before the cursor\"\n"
    "    (assert= (get (ed-backspace {:lines (list \"abc\") :row 0 :col 2}) :lines) (list \"ac\")))\n"
    "  (test \"backspace at column 0 joins with the previous line\"\n"
    "    (let (m (ed-backspace {:lines (list \"ab\" \"cd\") :row 1 :col 0}))\n"
    "      (assert= (get m :lines) (list \"abcd\"))\n" "      (assert= (get m :row) 0)\n"
    "      (assert= (get m :col) 2)))\n" "  (test \"newline splits the line at the cursor\"\n"
    "    (let (m (ed-newline {:lines (list \"abcd\") :row 0 :col 2}))\n"
    "      (assert= (get m :lines) (list \"ab\" \"cd\"))\n" "      (assert= (get m :row) 1)))\n"
    "  (test \"move clamps the column onto a shorter line\"\n"
    "    (assert= (get (ed-move {:lines (list \"ab\" \"c\") :row 0 :col 2} 1 0) :col) 1)))\n"))

;; `gui`: a windowed app on the `ui` framework — like `editor`, a `ui-run` client,
;; but opened in a NATIVE WINDOW via `(gui-display)` (needs a `--features gui`
;; runtime) and styled through the shared `face` registry (define the look once,
;; restyle in one place). The model is a plain map threaded through `ui-run`'s
;; loop; the starting point for a real GUI app (e.g. a daemon dashboard).
(defn- project-gui-main-template (nm)
  (str "(defmodule main \""
    nm " — a windowed GUI app on the `ui` framework.\n" "\n"
    "Run it:  nest run   (opens a native window — needs the runtime built with the\n"
    "GUI backend: `./configure --with-gui && make install`, or run with\n"
    "`--features brood/gui`). ↑/↓ change the counter, Enter resets, Ctrl-C or the\n"
    "window's close button quits. The model is a plain map; `ui-run` drives the loop\n"
    "— render `view`, poll a key, fold it with `update`, repeat — over a window from\n"
    "`(gui-display)`. Swap that for `editor/frontend/*term-display*` to run in the terminal instead.\"\n"
    "  ;; the app framework: the `ui-run` loop, then the display frontends\n" "  (:use editor/ui)\n"
    "  (:use editor/frontend)\n" "  ;; the render-op constructors (clear / text / cursor / frame)\n"
    "  (:use editor/display)\n" "  ;; named text faces — style the sections in one place\n"
    "  (:use editor/face))\n" "\n"
    ";; Faces: define the look once. Restyle by editing these (or, live, e.g.\n"
    ";; `(face-set :app/count {:fg :magenta})`). On the GUI a face may also carry a\n"
    ";; font `:family` / `:italic`; the terminal honours the colours + bold/reverse.\n"
    "(def-face :app/title {:inherit :ui/header})\n" "(def-face :app/count {:fg :cyan :bold true})\n"
    "(def-face :app/hint  {:inherit :ui/dim})\n" "\n" "(defn app-init ()\n"
    "  \"The starting model (`:done` quits; `:tick-ms` is the refresh beat).\"\n"
    "  {:count 0 :done false :tick-ms 1000})\n" "\n"
    "(defn app-step (m d) \"Change the counter by `d` (pure).\" (assoc m :count (+ (get m :count) d)))\n"
    "\n" "(defn app-center (s cols) \"Left column that centres `s` in `cols`.\"\n"
    "  (math/max 0 (math/quot (- cols (string/length s)) 2)))\n" "\n"
    "(defn app-view (m cols rows)\n"
    "  \"ui-run view: a centred title, the counter, and key hints (pure).\"\n"
    "  (let (mid   (math/quot rows 2)\n" "        title \"" nm "\"\n"
    "        count (str \"count: \" (get m :count))\n"
    "        hint  \"up/down change · enter reset · ctrl-c quit\")\n" "    (frame\n"
    "      (clear)\n" "      (text (- mid 2) (app-center title cols) title (face :app/title))\n"
    "      (text mid       (app-center count cols) count (face :app/count))\n"
    "      (text (+ mid 2) (app-center hint cols)  hint  (face :app/hint)))))\n" "\n"
    "(defn app-update (m input cols rows)\n"
    "  \"ui-run update: arrows change the count, Enter resets, Ctrl-C/Esc quit. The\n"
    "window's close button (the X) quits on its own — it arrives as a `:close` input\n"
    "and `ui-run` quits on that automatically, so you never wire it up here (and it\n"
    "stays distinct from the Esc *key*, which an app is free to bind elsewhere).\n"
    "`:tick` (the refresh beat) is a no-op here — nothing animates yet.\"\n" "  (cond\n"
    "    (= input :up)    (app-step m 1)\n" "    (= input :down)  (app-step m -1)\n"
    "    (= input :enter) (assoc m :count 0)\n"
    "    (or (= input :ctrl-c) (= input :escape)) (assoc m :done true)\n" "    else m))\n" "\n"
    "(defn main ()\n"
    "  \"Open the app in a native window. Needs a --features gui build (see the module\n"
    "doc); for the terminal instead, pass `editor/frontend/*term-display*` for `(gui-display)`.\"\n"
    "  (ui-run (app-init) app-view app-update (gui-display)))\n"))

(defn- project-gui-test-template (nm)
  (str ";; `(:use main)` brings the pure fns; `(:use test)` the macros. The window loop is\n"
    ";; `ui-run`'s (untested here — it needs a display); we test the pure `update` and\n"
    ";; `view` — `(model -> model)` / `(model -> frame)`.\n"
    "(defmodule main-test (:use main) (:use test))\n" "\n" "(describe \"" nm " counter\"\n"
    "  (test \"up increments, down decrements\"\n"
    "    (assert= (get (app-update {:count 5} :up 80 24) :count) 6)\n"
    "    (assert= (get (app-update {:count 5} :down 80 24) :count) 4))\n"
    "  (test \"enter resets to zero\"\n"
    "    (assert= (get (app-update {:count 9} :enter 80 24) :count) 0))\n"
    "  (test \"ctrl-c and escape quit\"\n"
    "    (is (get (app-update {:count 0} :ctrl-c 80 24) :done))\n"
    "    (is (get (app-update {:count 0} :escape 80 24) :done)))\n"
    "  (test \"view shows the counter value\"\n" "    (let (f (app-view {:count 3} 80 24))\n"
    "      (is (> (count (seq/filter f (fn (op) (and (= (first op) :text)\n"
    "                                            (includes? (nth op 3) \"count: 3\")))))\n"
    "             0)))))\n"))

;; `CLAUDE.md` for a fresh project — short project-specific intro that points
;; at the language reference (which `nest new` also drops into `docs/`, so the
;; project is self-contained and an AI assistant has everything it needs in-tree).
(defn- project-claude-md-template (nm)
  (str "# "
    nm " — guidance for Claude\n" "\n"
    "This is a Brood (`.blsp`) project scaffolded by `nest new`. Replace this stub\n"
    "with project-specific guidance — commands, conventions, gotchas.\n" "\n" "## Running\n" "\n"
    "- `nest test`   — run the test suite (each test runs in its own green process).\n"
    "- `nest run`    — invoke the entry point. Defaults to the `main` function in\n"
    "  the `main` module; override in `project.blsp` with `:main` (bare symbols,\n"
    "  the manifest is data — `:main app` runs `app/main`; `:main (app start)`\n"
    "  runs `app/start`; never quote them).\n"
    "  Each module is a namespace (ADR-065): a file's `defmodule name` makes its\n"
    "  `def`/`defn` define `name/foo`; a bare reference resolves in the current\n"
    "  namespace, then through `(:use …)` imports, then root/prelude. So the same\n"
    "  short name in two modules is fine (`a/parse` vs `b/parse`) — only earmuffed\n"
    "  `*foo*` vars are ambient/bare and must stay unique.\n"
    "- `nest run --for 2s` — run a loop / full-screen TUI for a bounded time, then\n"
    "  exit cleanly (`2s`, `500ms`, or a bare integer of ms). The way to exercise\n"
    "  a never-returning program end-to-end or in CI.\n" "- `nest format` — format Brood source.\n"
    "\n" "## Writing Brood\n" "\n"
    "`docs/brood-for-claude.md` is the language reference geared for AI assistants\n"
    "— syntax, idioms, and the patterns that aren't shared with other Lisps. Read\n"
    "it before generating Brood code. The `.claude/skills/writing-brood` skill\n"
    "carries the short version and auto-loads when Claude Code edits `.blsp` files.\n" "\n"
    "Brood ships randomness (`rand/int`/`rand/float`/`shuffle`/`sample` — pure and\n"
    "seedable, thread the seed), bitwise ops (`bit/and`/`bit/or`/`bit/xor`/...),\n"
    "and discovery (`apropos`, `all-globals`, `doc-search`) — use the last three to\n"
    "find what exists instead of guessing names.\n" "\n" "## MCP integration\n" "\n"
    "`.mcp.json` points Claude Code at this project's `nest mcp` server, so `cd " nm " && claude`\n"
    "auto-attaches an agent that can `reflect/eval`, `reflect/load`, `lookup`, `macroexpand`, `format`,\n"
    "and discover the image with `apropos` / `all-globals` / `doc-search`, against the\n"
    "live image (ADR-036, `docs/mcp.md` upstream).\n"))

;; `.mcp.json` for a fresh project — points Claude Code (and other MCP-aware
;; agents) at this project's `nest mcp` server. The dispatcher runs from the
;; project root (which is wherever the agent invoked `claude`), so a relative
;; `command: nest` works as long as `nest` is on PATH. Keeping the file
;; minimal: a single `brood` server entry. Users can add more (their own
;; MCP servers) without losing the scaffold.
(defn- project-mcp-json-template (nm)
  (str "{\n"
    "  \"mcpServers\": {\n" "    \"brood\": {\n" "      \"command\": \"nest\",\n"
    "      \"args\": [\"mcp\"]\n" "    }\n" "  }\n" "}\n"))

;; The scaffolded .gitignore: the package cache is regenerable from the lock
;; file (which IS committed), so it's ignored (ADR-037). So is `.brood/`, the
;; startup-image cache (ADR-218) — it is a build artifact, rebuilt by any `nest`
;; command that loads the project. Omitting it here meant every scaffolded project
;; committed `.brood/image.bin` and then re-committed it on every check: eight
;; ecosystem repos carried a churning binary before this line existed.
(defn- project-gitignore-template ()
  (str "# Brood package cache — regenerable from project.lock.blsp (which is committed)\n"
    "_deps/\n" "\n" "# Startup-image cache — a build artifact, rebuilt on demand\n" ".brood/\n" "\n"
    "# Editor / OS cruft\n" "*.swp\n" ".DS_Store\n"))

;; The scaffolded .gitattributes: GitHub's Linguist doesn't know the `.blsp`
;; extension, so it renders Brood source as plain text. Until Brood is its own
;; Linguist language, map `.blsp` to Clojure — the closest common Lisp grammar
;; (it highlights [] vectors, {} maps, and :keywords, all of which Brood uses).
;; `linguist-detectable=false` keeps `.blsp` out of the repo's language stats
;; (so a Brood project isn't mislabelled "Clojure") while still highlighting.
(defn- project-gitattributes-template ()
  (str "# Brood source (.blsp) is a Lisp; until it's its own Linguist language,\n"
    "# highlight it as Clojure on GitHub — the closest common grammar — but keep\n"
    "# it out of the language stats (it's Brood, not Clojure).\n"
    "*.blsp linguist-language=Clojure linguist-detectable=false\n"))

;; --- templates a package provides (`nest new NAME --from SOURCE`, ADR-424) ------------------
;; A framework's starter project belongs to the framework. Until ADR-424 std carried a Hatch
;; app and a Hatch API as string concatenations, tied to Hatch's module names and to sibling
;; `:path` checkouts that a fresh machine does not have. A package now declares its own in
;; its manifest — `:templates {"app" {:dir "templates/app" :about "…" :next ["…"]}}` — as
;; plain FILES under `:dir`, and `nest new` copies them. Nothing in the package runs: a
;; template is data, so scaffolding from one trusts it no more than reading it would.
;;
;; Two placeholders are filled in every file: `{{name}}`, the new project's name, and
;; `{{package}}`, the dependency entry that reaches the package the way `--from` named it (a
;; path, a git URL or a registry name) — so a template's manifest depends on its own
;; framework without guessing where it lives.

(defn- template-source-kind (source)
  "How `--from SOURCE` names its package: `:git` (a URL, `git@…`, or `….git`, each with an
optional `#ref`), `:path` (an existing directory, or one spelled as a path), else
`:registry` (a published package's name)."
  (let (url (first (string/split source "#")))
    (cond
      (or (includes? url "://") (string/starts-with? url "git@") (string/ends-with? url ".git"))
        :git
      (or (string/starts-with? source ".")
        (string/starts-with? source "/")
        (string/starts-with? source "~")
        (file/dir? source))
        :path
      else :registry)))

(defn- template-fetch (source)
  "The package `source` names, on disk: `{:root <its directory> :pin <how a manifest reaches
it, after the name> :temporary <a directory to remove afterwards, or nil>}`."
  (let (kind (template-source-kind source))
    (cond
      (= kind :path)
        (let (root (path/absolute source))
          {:root root :pin (str ":path " (pr-str root)) :temporary nil})
      (= kind :git)
        (let (parts (string/split source "#")
              url (first parts)
              ref (second parts)
              commit (%git-resolve-ref url (or ref "HEAD"))
              dest (path/temp "brood-template-"))
          (when (nil? commit) (error "new: " url " has no ref " (or ref "HEAD")))
          (%git-clone url dest (or ref "HEAD") commit)
          ;; a named ref is what the user asked to track; with none, pin what was read
          {:root dest
           :pin (str ":git " (pr-str url) " :ref " (pr-str (or ref commit)))
           :temporary dest})
      else
        (let (dest (path/temp "brood-template-"))
          (when (not (project/valid-dep-name? source))
            (error "new: --from " (pr-str source) " is not a path, a git URL or a package name"))
          (file/mkdir dest)
          (let (installed (package/registry-install source dest))
            ;; a failed install is a value carrying its reason (ADR-559); `nest new` stops on it
            (when (failure? installed) (error "new: " (error-message installed)))
            {:root (:path installed)
             :pin (str ":version " (pr-str (str "^" (:version installed))))
             :temporary dest})))))

(defn- template-manifest (root source)
  "The manifest of the package at `root`, as a plist read as DATA — nothing in it evaluated."
  (let (path (path/join root "project.blsp")
        form (and (file/exists? path) (reflect/read-first (file/slurp path))))
    (if (and (pair? form) (= (first form) 'project))
      (rest form)
      (error "new: " source " is not a Brood package (no project.blsp with a (project …) form)"))))

(defn- template-choose (templates wanted source)
  "`[name row]` for the template `wanted` names among `templates` — or, with none named, the
only one, else the one called \"default\"."
  (let (names (sort (map (keys (or templates {})) ->string))
        pick (fn (name) [name (or (get templates name) (get templates (keyword name)))]))
    (cond
      (empty? names) (error "new: " source " declares no :templates in its project.blsp")
      wanted
        (if (includes? names wanted)
          (pick wanted)
          (error "new: "
            source
            " has no template '"
            wanted
            "' (it has: "
            (string/join names ", ")
            ")"))
      (= (count names) 1) (pick (first names))
      (includes? names "default") (pick "default")
      else
        (error "new: "
          source
          " has several templates — choose one with --template ("
          (string/join names ", ")
          ")"))))

(defn- template-files (root row name dependency)
  "The template's files as `[relative-path content]` pairs, each with `{{name}}` and
`{{package}}` filled in."
  (let (relative (:dir row)
        dir (path/join root (or relative ""))
        prefix (str dir "/"))
    (when (or (not (string? relative)) (includes? relative ".."))
      (error "new: a template's :dir must be a path inside its package, got " (pr-str relative)))
    (when (not (file/dir? dir)) (error "new: the template directory " dir " does not exist"))
    (map (sort (or (file/walk-files dir) (list)))
      (fn (path)
        [(string/substring path (string/length prefix))
          (string/replace (string/replace (file/slurp path) "{{name}}" name)
            "{{package}}" dependency)]))))

(defn- package-template (source wanted name)
  "What `nest new NAME --from SOURCE [--template WANTED]` scaffolds: `{:label :files :next}`."
  (let (fetched (template-fetch source))
    (try
      (let (manifest (template-manifest (:root fetched) source)
            package (plist-get manifest :name)
            [chosen row] (template-choose (plist-get manifest :templates) wanted source)
            dependency (str "[" package " " (:pin fetched) "]"))
        {:label (str package " " chosen)
         :files (template-files (:root fetched) row name dependency)
         :next (or (:next row) [])})
      (finally (when (:temporary fetched) (file/rmdir (:temporary fetched)))))))

;; (new-project "foobar") — scaffold ./foobar with a runnable two-module
;; skeleton: project.blsp + src/main.blsp + src/<project>.blsp (where main `require`s
;; hello and calls into it) + a paired test file for each, so `cd foobar && nest
;; test` *and* `nest run` both pass immediately. Also drops CLAUDE.md +
;; docs/brood-for-claude.md (the baked-in language guide) + a
;; .claude/skills/writing-brood skill, so the project is self-contained for
;; AI-assisted editing. Errors on a bad name; an existing folder is reused (its
;; scaffold files overwritten), not rejected.
(defdyn scaffold/*templates* ["default" "tui-loop" "gen" "editor" "gui"])

;; The template-specific files, as `[path content]` pairs with `path` relative to the
;; project directory. The shared files (manifest, CLAUDE.md, guide, …) are written by the
;; caller; only the starter code varies by template — and a template's own
;; `project.blsp` replaces the shared manifest.
(defn- project-template-files (tmpl actual-name)
  (cond
    (= tmpl "tui-loop")
      [["src/main.blsp" (project-tui-main-template actual-name)]
        ["tests/main_test.blsp" (project-tui-test-template actual-name)]]
    (= tmpl "gen")
      [["src/main.blsp" (project-gen-main-template actual-name)]
        ["tests/main_test.blsp" (project-gen-test-template actual-name)]]
    (= tmpl "editor")
      [["src/main.blsp" (project-editor-main-template actual-name)]
        ["tests/main_test.blsp" (project-editor-test-template actual-name)]]
    (= tmpl "gui")
      [["src/main.blsp" (project-gui-main-template actual-name)]
        ["tests/main_test.blsp" (project-gui-test-template actual-name)]]
    else
      (let (module (project-module-name actual-name))
        [["src/main.blsp" (project-main-template actual-name)]
          [(str "src/" module ".blsp") (project-hello-template actual-name)]
          ["tests/main_test.blsp" (project-main-test-template actual-name)]
          [(str "tests/" module "_test.blsp") (project-hello-test-template actual-name)]])))

;; Write each `[path content]` under project directory `nm`, creating the directories it
;; needs; return the written paths, each prefixed with `nm/` (for the summary and the
;; formatter). The ONE place template files are written, so a file cannot be written
;; without also being listed.
(defn- scaffold-write-files (nm files)
  (map files
    (fn ([relative content])
      (let (path (str nm "/" relative))
        (file/mkdir (path/dirname path))
        (file/spit path content)
        path))))

;; Run every generated `.blsp` through the formatter.
;;
;; Templates are built by string concatenation, so their layout is whatever the
;; author typed — and it drifted: every template shipped code that `nest format
;; --check` immediately rejected, which meant a brand-new project failed its own
;; CI format gate on the first run and the starter code modelled non-canonical
;; style. Formatting here rather than hand-tuning each template means a NEW
;; template cannot reintroduce the drift, and a change to the formatter's style is
;; picked up for free.
;;
;; `file` leaves a file it cannot parse untouched, so a malformed template
;; degrades to "written as-is" rather than mangled; failures are swallowed because a
;; cosmetic pass must never break scaffolding.
(defn- scaffold-format-generated (paths)
  (dolist (p paths)
    ;; check-allow :discarded-catch — a cosmetic formatting pass must never break scaffolding
    (when (string/ends-with? p ".blsp")
      (check-allow :discarded-catch (try (format/file p) (catch _ nil))))))

(defn new-project (nm &optional template from)
  "Scaffold a new project named `nm` (or `\".\"` for the current directory, taking the project name from the cwd's basename): a `project.blsp` manifest, the baked-in language guide, and starter code. Without `from`, `template` picks a built-in starter — `\"default\"` (a `main`+`hello` module pair, the default), `\"tui-loop\"` (a tail-recursive animation loop), `\"gen\"` (a stateful gen_server process), `\"editor\"` (a tiny text editor on the `ui` framework) or `\"gui\"` (a windowed app on the `ui` framework, opened with `(gui-display)` — needs a `--features gui` runtime). With `from` — a package's path, git URL (`url#ref`) or registry name — the starter is one of the templates that package declares (`:templates` in its manifest, ADR-424), `template` naming which when it has several; its files fill in `{{name}}` and `{{package}}` (the dependency entry that reaches the package). Existing scaffold files are overwritten, not rejected. Backs `nest new [--template …] [--from …]`.

    (scaffold/new-project \"myapp\" \"gen\")   ;~> myapp/ created — project.blsp, the language guide and a `gen` server starter
    (scaffold/new-project \"shop\" \"app\" \"hatch\")   ;~> shop/ created from hatch's app template, depending on hatch from the registry"
  ;; `nest new .` scaffolds into the current directory (cargo init's shape);
  ;; the project name is then the cwd's basename. Both forms — `nest new .` and
  ;; `nest new foobar` — *overwrite* existing scaffold files rather than
  ;; refusing on an existing folder: re-running `new` re-stamps the skeleton.
  ;; `reusing-dir` only drives the printed summary.
  (let (in-place (= nm ".")
        actual-name (if in-place (path/basename (file/cwd)) nm)
        reusing-dir (file/exists? nm)
        tmpl (or template "default"))
    (unless (or from (includes? scaffold/*templates* tmpl))
      (error "new: unknown template '"
        tmpl
        "' (use one of: "
        (string/join scaffold/*templates* ", ")
        "; a package's own templates come with --from <package>)"))
    (unless (or in-place (project-valid-name? nm))
      (error "new: invalid project name '" nm "' (no '/' or spaces, and not empty)"))
    (when (and in-place (= actual-name ""))
      (error "new: cwd has no basename — cannot derive a project name"))
    (when (reflect/reserved-package-name? actual-name)
      (error "new: project name '"
        actual-name "' is reserved by the standard library (it owns the '" actual-name
        "' module namespace); choose another name"))
    ;; resolved BEFORE anything is written, so a bad --from leaves no half-made project
    (let (starter (if from
                    (package-template from template actual-name)
                    {:label (if (= tmpl "default") nil tmpl)
                     :files (project-template-files tmpl actual-name)
                     :next []})
          src-dir (path/join nm "src")
          tests-dir (path/join nm "tests")
          docs-dir (path/join nm "docs")
          skill-dir (path/join nm ".claude/skills/writing-brood"))
      (file/mkdir src-dir)
      (file/mkdir tests-dir)
      (file/mkdir docs-dir)
      (file/mkdir skill-dir)
      (file/spit (path/join nm "project.blsp") (project-manifest-template actual-name))
      (file/spit (path/join nm ".gitignore") (project-gitignore-template))
      (file/spit (path/join nm ".gitattributes") (project-gitattributes-template))
      (file/spit (path/join nm "CLAUDE.md") (project-claude-md-template actual-name))
      (file/spit (path/join nm ".mcp.json") (project-mcp-json-template actual-name))
      (file/spit (path/join docs-dir "brood-for-claude.md") (%builtin-doc 'brood-for-claude))
      (file/spit (path/join skill-dir "SKILL.md") (%builtin-doc 'writing-brood-skill))
      (let (manifest (str nm "/project.blsp")
            ;; a template's own manifest is printed on the summary's fixed manifest line
            code-files (seq/reject (scaffold-write-files nm (:files starter))
                         (fn (path) (= path manifest)))
            _ (scaffold-format-generated (cons manifest code-files)))
        (io/puts (str "Created Brood project '"
                   actual-name
                   "'"
                   (if (:label starter) (str " [" (:label starter) " template]") "")
                   (cond
                     in-place " (in-place — files in current directory overwritten)"
                     reusing-dir " (existing files overwritten)"
                     else "")))
        (io/puts (str "  " nm "/project.blsp"))
        (io/puts (str "  " nm "/.gitignore"))
        (io/puts (str "  " nm "/.gitattributes"))
        (io/puts (str "  " nm "/CLAUDE.md"))
        (io/puts (str "  " nm "/.mcp.json"))
        (io/puts (str "  " nm "/docs/brood-for-claude.md"))
        (io/puts (str "  " nm "/.claude/skills/writing-brood/SKILL.md"))
        (dolist (f code-files) (io/puts (str "  " f))))
      (when project/*config-git-init*
        (if (= 0 (os/run-process "git" (list "init" "-q" nm)))
          (io/puts "  initialized a git repository")
          (io/puts "  (git init failed)")))
      (scaffold-print-next-steps (:next starter) nm in-place)
      nm)))

;; `nest update-tooling` — rewrite the AI-assistant files `nest new` drops into a
;; project (the language reference + the writing-brood skill) from THIS `brood`
;; binary. They are baked in via `%builtin-doc`, so they drift as the language
;; evolves; this re-syncs them to the installed version. Everything else the project
;; owns (its code, manifest, CLAUDE.md) is left alone.
(defn update-tooling ()
  "Rewrite this project's AI-assistant tooling — `docs/brood-for-claude.md` and the `.claude/skills/writing-brood` skill — from THIS `brood` binary, so the shipped language reference matches the installed language. Run it after upgrading Brood. Backs `nest update-tooling`.

    (scaffold/update-tooling)   ;~> docs/brood-for-claude.md and .claude/skills/writing-brood/SKILL.md rewritten, both paths printed"
  ;; `nest update-tooling` runs `require-project` first, so the CLI never reaches here
  ;; without a project — but guard directly too, so a bare `(scaffold/update-tooling)`
  ;; at the REPL errors clearly instead of writing into the cwd.
  (let (root (require-root "update-tooling")
        docs-dir (path/join root "docs")
        skill-dir (path/join root ".claude/skills/writing-brood"))
    (file/mkdir docs-dir)
    (file/mkdir skill-dir)
    (file/spit (path/join docs-dir "brood-for-claude.md") (%builtin-doc 'brood-for-claude))
    (file/spit (path/join skill-dir "SKILL.md") (%builtin-doc 'writing-brood-skill))
    (io/puts "Refreshed AI tooling from this brood build:")
    (io/puts (str "  " (path/join docs-dir "brood-for-claude.md")))
    (io/puts (str "  " (path/join skill-dir "SKILL.md")))))

;; What to do next: the template's own `:next` commands when it declares them (a database to
;; create first, say), else test and run — which every built-in starter and a package
;; template without its own steps can do at once (`nest test` fetches the dependencies).
(defn- scaffold-print-next-steps (steps nm in-place)
  (let (enter (if in-place "" (str "cd " nm " && ")))
    (io/puts (str "Next:  "
               enter
               (if (empty? steps) "nest test && nest run" (string/join steps " && "))))))
