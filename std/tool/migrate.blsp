;; migrate — the source rewrites behind `nest format --migrate` (ADR-674).
;;
;; A deprecation that changes a form's SHAPE cannot ride the rename ledger: `--fix-renames`
;; swaps one name for another, and `(dotimes (i n) …)` → `(doseq (i (range n)) …)` moves
;; an argument. These rewrites walk the lossless CST (`reflect/parse-source`), so strings,
;; comments and layout come back byte for byte, and quoted data is never touched: only code,
;; and the code a template emits, is rewritten. `nest format --migrate` runs them, then the
;; formatter, over every project file.
;;
;; Each migration is one entry in `*migrations*` and one clause in `rewrite-call`. A
;; migration stays here for as long as the deprecated form exists, and goes with it.
(defmodule migrate
  "The source rewrites behind `nest format --migrate` (ADR-674): a deprecated form whose
replacement has a different shape, rewritten over the lossless CST. Strings, comments and
layout are kept; quoted data is never touched.")

;; Every migration `nest format --migrate` applies, as `{:from :to :since :adr}`.
(def *migrations*
  [{:from "dotimes" :to "(doseq (i (range n)) …)" :since "0.51.0" :adr 674}
    {:from "dolist" :to "(doseq (x xs) …)" :since "0.51.0" :adr 674}
    {:from "unless" :to "(when (not test) …)" :since "0.51.0" :adr 674}
    {:from "match*" :to "%match (or write match)" :since "0.51.0" :adr 674}])

(def- *container-kinds* [:root :list :vector :map :set])
(def- *wrapper-sigils* {:quote "'" :quasi "`" :unquote "~" :splice "~@" :pin "^"})

(defn- kind (node) (first node))
(defn- payload (node) (second node))
(defn- trivia? (node) (includes? [:whitespace :comment] (kind node)))

(defn- open-delim (k) (get {:list "(" :vector "[" :map "{" :set "#{"} k ""))
(defn- close-delim (k) (get {:list ")" :vector "]" :map "}" :set "}"} k ""))

(defn- significant (kids)
  "The indices in `kids` of the nodes that are not whitespace or comments."
  (seq/filter (range 0 (count kids)) (fn (i) (not (trivia? (nth kids i))))))

(defn- symbol-named (node names)
  "The spelling of `node` with a leading root `/` dropped, when it is a symbol whose name is
one of `names`; else nil."
  (when (= (kind node) :symbol)
    (let (bare (if (string/starts-with? (payload node) "/")
                 (string/substring (payload node) 1 (string/length (payload node)))
                 (payload node)))
      (when (includes? names bare) bare))))

(defn- root-prefix (node)
  (if (and (= (kind node) :symbol) (string/starts-with? (payload node) "/")) "/" ""))

;; check-allow: a CST walk recurses to the source's nesting depth, not its length.
(check-allow :non-tail-recursion
  (defn- emit (node code?)
    "The source text of `node`, migrated. `code?` is false inside quoted data, where nothing
is rewritten; a template (`:quasi`) is code a macro emits, so it stays true."
    (let (k (kind node) p (payload node))
      (cond
        (= k :symbol) p
        (= k :list)
          (let (kids p head-i (first (significant kids)))
            (str "("
              (cond
                (nil? head-i) (emit-kids kids code?)
                (symbol-named (nth kids head-i) ["quote"]) (emit-kids kids false)
                code? (rewrite-call kids head-i)
                else (emit-kids kids false))
              ")"))
        (includes? *container-kinds* k) (str (open-delim k) (emit-kids p code?) (close-delim k))
        (string? p) p
        else
          (let (sigil (get *wrapper-sigils* k))
            (when (nil? sigil)
              (error "migrate: unknown CST node kind "
                (pr-str k)
                " — emitting it blind would drop source text"))
            (str sigil
              (emit p
                (cond
                  (= k :quote) false
                  (includes? [:quasi :unquote :splice] k) true
                  else code?))))))))

(check-allow :non-tail-recursion
  (defn- emit-kids (kids code?) (apply str (map kids (fn (kid) (emit kid code?))))))

(check-allow :non-tail-recursion
  (defn- rewrite-call (kids head-i)
    "The inside of a list in code position, `kids` its children and `head-i` its head's index,
with the call migrated when its head is a deprecated form."
    (let (head (nth kids head-i)
          sig (significant kids)
          name (symbol-named head ["dotimes" "dolist" "unless" "match*"])
          root (root-prefix head)
          arg-i (second sig)
          arg (when arg-i (nth kids arg-i))
          ;; the whole list re-emitted, with the head spelled `new` and the node at `at`
          ;; replaced by the text `replacement`
          rebuilt (fn (new at replacement)
                    (apply str
                      (map (range 0 (count kids))
                        (fn (i)
                          (cond
                            (= i head-i) (str root new)
                            (= i at) replacement
                            else (emit (nth kids i) true)))))))
      (cond
        (= name "dolist") (rebuilt "doseq" nil nil)
        ;; only a CALL is rewritten: `(defmacro match* …)` or `'match*` names the old form
        (= name "match*") (rebuilt "%match" nil nil)
        ;; (dotimes (i n) …) → (doseq (i (range n)) …); a bind of any other shape is left to
        ;; the macro's own error
        (and (= name "dotimes") arg (= (kind arg) :list) (= (count (significant (payload arg))) 2))
          (let (bind (payload arg)
                n-i (second (significant bind)))
            (rebuilt "doseq"
              arg-i
              (str "("
                (apply str
                  (map (range 0 (count bind))
                    (fn (i)
                      (if (= i n-i)
                        (str "(range " (emit (nth bind i) true) ")")
                        (emit (nth bind i) true)))))
                ")")))
        ;; (unless t …) → (when (not t) …), and (unless (not x) …) → (when x …)
        (and (= name "unless") arg)
          (rebuilt "when" arg-i (or (negated-test arg) (str "(" root "not " (emit arg true) ")")))
        else (emit-kids kids true)))))

(check-allow :non-tail-recursion
  (defn- negated-test (arg)
    "The migrated text of `x` when the node `arg` is `(not x)`, else nil."
    (when (= (kind arg) :list)
      (let (kids (payload arg) sig (significant kids))
        (when (= (count sig) 2)
          (let (not-i (first sig) x-i (second sig))
            (when (and (int? not-i) (int? x-i) (symbol-named (nth kids not-i) ["not"]))
              (emit (nth kids x-i) true))))))))

(defn text (source:string)
  "`source` with every deprecated form in `*migrations*` rewritten to its replacement.
Strings, comments, layout and quoted data come back unchanged, so a file with nothing to
migrate is returned byte for byte.

    (migrate/text \"(dotimes (i 3) (f i))\")        ;=> \"(doseq (i (range 3)) (f i))\"
    (migrate/text \"(unless ok (warn))\")           ;=> \"(when (not ok) (warn))\"
    (migrate/text \"(unless (not ok) (go))\")       ;=> \"(when ok (go))\"
    (migrate/text \"(dolist (x xs) (f x)) ; dolist\")  ;=> \"(doseq (x xs) (f x)) ; dolist\"
    (migrate/text \"'(unless a b)\")                ;=> \"'(unless a b)\""
  (emit (reflect/parse-source source) true))
