;; std/tool/update-brood.blsp — `nest update-brood`: replace this Brood with a release.
;; What `scripts/install.sh` does (latest GitHub release, this platform's tarball, its
;; .sha256, then brood + nest + brood-lsp), from the binary already installed, into the
;; directory it was installed to.

(defmodule update-brood
  "`nest update-brood` — update the installed `brood`, `nest` and `brood-lsp` to the latest
GitHub release (or a named one), verified against the release's SHA-256, into the directory
the running `nest` lives in. The pure parts (`release-target`, `version-newer?`,
`asset-url`) decide; `update` does the fetching and the file work.")

(def- *repository* "broodlang/brood")
(def- *binaries* ["brood" "nest" "brood-lsp"])
;; A release tarball is ~45 MB; room to grow without letting a runaway body fill memory.
(def- *max-download-bytes* (* 256 1024 1024))
(def- *max-redirects* 5)
;; The targets a release publishes (ADR-714; `release.yml`'s matrix).
(def- *published-targets*
  #{"x86_64-unknown-linux-gnu"
    "aarch64-unknown-linux-gnu" "x86_64-unknown-linux-musl" "aarch64-apple-darwin"
    "x86_64-apple-darwin" "x86_64-pc-windows-msvc"})

;; ---- pure ------------------------------------------------------------------------

(defn release-target (target)
  "`target` (what `system/target` says this runtime was built for) when a release publishes
that build, else a failure naming it. Asking the binary rather than `uname` keeps a musl
install on musl and works where there is no `uname`.

    (update-brood/release-target \"x86_64-unknown-linux-musl\")   ;=> \"x86_64-unknown-linux-musl\"
    (failure? (update-brood/release-target \"riscv64gc-unknown-linux-gnu\"))   ;=> true"
  (if (contains? *published-targets* target)
    target
    (failure (str "update-brood: no release is built for " target))))

(defn- windows? (target) (includes? target "windows"))

(defn- version-parts (version)
  ;; "v0.34.0" / "0.34.0" / "0.34.0-rc1" → [0 34 0]; a part that is not a number counts 0.
  (let (plain (string/drop-prefix version "v")
        core (first (string/split plain "-")))
    (vec (map (string/split core ".")
           (fn (part) (let (n (string/->number part)) (if (int? n) n 0)))))))

(defn version-newer? (candidate current)
  "True when release `candidate` is a later version than `current`; a leading `v` is ignored.

    (update-brood/version-newer? \"v0.34.0\" \"0.33.0\")   ;=> true
    (update-brood/version-newer? \"v0.9.0\" \"0.10.0\")   ;=> false"
  (letrec (compare (fn (left right)
                     (cond
                       (and (empty? left) (empty? right)) false
                       else
                         (let (a (or (first left) 0) b (or (first right) 0))
                           (cond
                             (> a b) true
                             (< a b) false
                             else (compare (rest left) (rest right)))))))
    (compare (seq (version-parts candidate)) (seq (version-parts current)))))

(defn asset-url (tag target)
  "The download URL of release `tag`'s archive for `target`, a `.zip` for Windows and a
`.tar.gz` for the rest (add `.sha256` for its checksum).

    (update-brood/asset-url \"v0.34.0\" \"x86_64-unknown-linux-gnu\")   ;=> \"https://github.com/broodlang/brood/releases/download/v0.34.0/brood-v0.34.0-x86_64-unknown-linux-gnu.tar.gz\"
    (update-brood/asset-url \"v0.52.0\" \"x86_64-pc-windows-msvc\")   ;=> \"https://github.com/broodlang/brood/releases/download/v0.52.0/brood-v0.52.0-x86_64-pc-windows-msvc.zip\""
  (str "https://github.com/"
    *repository*
    "/releases/download/"
    tag
    "/brood-"
    tag
    "-"
    target
    (if (windows? target) ".zip" ".tar.gz")))

;; ---- effects ---------------------------------------------------------------------

(defn- say (& parts) (io/puts (apply str "update-brood: " parts)))

(defn- fetch-following (url redirects)
  ;; GitHub answers a release download with a redirect to its CDN; `http/fetch` does not
  ;; follow one, so this does, a bounded number of times.
  (let (response (binding (http/*max-response-bytes* *max-download-bytes*) (http/fetch url))
        status (if (failure? response) 0 (get response :status)))
    (cond
      (failure? response) (failure "update-brood: " url ": " (error-message response))
      (and (>= status 300) (< status 400))
        (let (location (get (get response :headers) "location"))
          (cond
            (nil? location) (failure (str "update-brood: " url ": redirect without a location"))
            (>= redirects *max-redirects*)
              (failure (str "update-brood: " url ": too many redirects"))
            else (fetch-following location (inc redirects))))
      (not (= status 200)) (failure (str "update-brood: " url ": HTTP " status))
      else (get response :body))))

(defn- fetch (url) (fetch-following url 0))

(defn- latest-tag ()
  (with (body (fetch (str "https://api.github.com/repos/" *repository* "/releases/latest")))
    (let (release (json/decode (string/bytes-> body))
          tag (if (map? release) (get release :tag_name) nil))
      (if (string? tag) tag (failure "update-brood: the latest release has no tag")))))

(defn- install-directory (explicit)
  ;; The directory the running `nest` is in: `install.sh` put all three binaries there.
  ;; A build tree's binary is not an install, and overwriting it would be a surprise.
  (let (exe (os/exe-path))
    (cond
      (string? explicit) explicit
      (nil? exe) (failure "update-brood: cannot tell where this nest is installed; pass --dir")
      (or (includes? exe "/target/") (includes? exe "\\target\\"))
        (failure (str "update-brood: "
                   exe " is a build tree, not an install; pass --dir to install elsewhere"))
      else (path/dirname exe))))

(defn- verify (tarball checksum-text)
  (let (expected (first (string/split (string/trim checksum-text) " "))
        actual (hash/sha256-bytes tarball))
    (if (= expected actual)
      tarball
      (failure (str "update-brood: checksum mismatch (expected " expected ", got " actual ")")))))

(defn- unpack (archive-bytes tag target scratch)
  ;; → the directory in `scratch` holding the three binaries. `tar -xf` reads the format
  ;; itself, so it unpacks the `.tar.gz` and, on Windows (whose `tar` is bsdtar), the `.zip`.
  (let (archive (path/join scratch (if (windows? target) "brood.zip" "brood.tar.gz")))
    (file/spit-bytes archive archive-bytes)
    (let (result (os/cmd "tar" ["-xf" archive "-C" scratch]))
      (if (os/cmd-ok? result)
        (path/join scratch (str "brood-" tag "-" target))
        (failure (str "update-brood: tar failed: " (get result :stderr)))))))

(defn- replace-binaries (from directory target)
  ;; Each binary is copied next to its target and renamed over it, so a running `nest`
  ;; (this one) keeps its old inode and nothing sees a half-written file. Windows will not
  ;; replace a running executable, but it will rename one: the old file steps aside to
  ;; `.old` first (the one a previous update left is removed when nothing runs it).
  (let (suffix (if (windows? target) ".exe" ""))
    (fold *binaries*
      []
      (fn (installed binary)
        (let (staged (path/join directory (str "." binary ".new" suffix))
              destination (path/join directory (str binary suffix))
              aside (str destination ".old"))
          (file/cp (path/join from (str binary suffix)) staged)
          (when (and (windows? target) (file/exists? destination))
            (check-allow :discarded-catch
              ;; still running from the last update: it stays until the next one
              (try (file/rm aside) (catch _ nil)))
            (file/rename destination aside))
          (file/rename staged destination)
          (conj installed destination))))))

(defn- install-release (tag target directory)
  (let (url (asset-url tag target)
        scratch (path/temp "brood-update-"))
    (say "downloading " tag " for " target "…")
    (file/mkdir scratch)
    (let (outcome (try
                    (with (tarball (fetch url)
                            checksum
                            (fetch (str url ".sha256"))
                            verified
                            (verify tarball (string/bytes-> checksum))
                            unpacked
                            (unpack verified tag target scratch))
                      (replace-binaries unpacked directory target)
                      (say "installed brood " tag " to " directory)
                      :installed)
                    (catch problem (file/rmdir scratch) (throw problem))))
      (file/rmdir scratch)
      outcome)))

(defn update (&optional (options {}))
  "Update the installed Brood to the latest release, or to `:version` (a tag like
`\"v0.34.0\"`), into `:dir` (default: the directory of the running `nest`). With `:check`
true, only says whether a newer release exists. Returns 0 when done or already current, and
1 with a message on stderr on any failure. Backs `nest update-brood`.

    (update-brood/update {:check true})   ;~> 0 — says whether a newer release exists, installs nothing"
  (let ({:keys [version dir check]} options
        current (system/brood-version)
        outcome (with (tag (if (string? version) version (latest-tag))
                        target
                        (release-target (system/target)))
                  (cond
                    (and (nil? version) (not (version-newer? tag current)))
                      (do (say "brood " current " is the latest release") :current)
                    check (do (say tag " is available (installed: " current ")") :available)
                    else
                      (with (directory (install-directory dir))
                        (install-release tag target directory)))))
    (if (failure? outcome)
      (do (io/puts (error-message outcome) :to *err*) 1)
      0)))
