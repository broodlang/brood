;; std/tool/test-select.blsp — which registered tests a run runs, and in what order: the
;; `--only` / `--exclude` / `--include` / FILE:LINE / `--failed` / shard selection behind
;; `nest test` (docs/testing.md). Split out of std/tool/test.blsp, the runner over it; every
;; function here is a pure function of the units and the filter spec.

(defmodule test-select
  "Test selection for the test runner: parse `nest test`'s selectors into a filter spec
(`test-make-filter`), then filter, shard and order the registered units by it
(`test-select-units`). Also each test's recorded tags, file and line, and `label`, the
`group › name` display label a run names a test by.")

(defn- test-tags (t) (or (get (third t) :tags) []))
(defn- test-file (t) (get (third t) :file))
(defn- test-line (t) (get (third t) :line))

(defn label (group name)
  "Join a group and test name into one display label — `\"group › name\"`, or just `name` when `group` is \"\" (ungrouped).

    (test-select/label \"math\" \"adds\")   ;=> \"math › adds\"
    (test-select/label \"\" \"adds\")   ;=> \"adds\""
  ; "group › name", or just name if ungrouped
  (if (= group "") (str name) (str group " › " name)))

;; --- test selection (--only / --exclude / --include / FILE:LINE / shards) -----
;; A *filter spec* is a map; nil means "run everything" (the default, and the only
;; shape `run-tests` ever saw before selection existed):
;;
;;   {:only     (["db" ""] ["test" "adds"])   ; positive: run ONLY matches
;;    :exclude  (["slow" ""])                 ; negative: drop matches
;;    :include  (["slow" ""])                 ; re-admit something :exclude dropped
;;    :lines    (["tests/a_test.blsp" 42])    ; FILE:LINE — the covering test
;;    :names    ("math › adds")}              ; exact full labels (backs --failed)
;;
;; A *selector* is `[key value]`: `test`/`describe` match a substring of the test
;; name / group label, anything else is a tag name: `--only tag`,
;; `--only test:"name"`, `--only describe:"group"`.
(defn- test-parse-selector (selector-string)
  "Parse an `--only`/`--exclude`/`--include` selector into `[key value]` — `tag`, `tag:value`, `test:substring`, or `describe:substring`."
  (let (i (index-of selector-string ":"))
    (if (< i 0)
      [selector-string ""]
      [(string/substring selector-string 0 i)
        (string/substring selector-string
          (+ i 1)
          (count selector-string))])))

;; Build a filter spec from the raw strings a CLI hands over. Parsing lives here
;; rather than in `nest`, so the selector grammar has one definition and the Rust
;; side only forwards argv. `nil`/empty arguments mean "no constraint".
(defn test-make-filter (only exclude include lines names seed shards shard)
  "Assemble a `nest test` filter spec from raw CLI values: `only`/`exclude`/`include` are selector strings (`tag`, `test:substr`, `describe:substr`), `lines` a list of `[file line]`, `names` exact full labels, `seed` a shuffle seed, and `shards`/`shard` a CI split.

    (test-select/test-make-filter [\"slow\"] nil nil nil nil 42 nil nil)   ;=> {:only ([\"slow\" \"\"]) :exclude nil :include nil :lines nil :names nil :seed 42 :shards nil :shard 0}"
  {:only (map (or only (list)) test-parse-selector)
   :exclude (map (or exclude (list)) test-parse-selector)
   :include (map (or include (list)) test-parse-selector)
   :lines (or lines (list))
   :names names
   :seed seed
   :shards shards
   :shard (or shard 0)})

(defn- test-has-tag? (tags key-string)
  (any? tags (fn (tag) (= (->string tag) key-string))))

;; Is `needle` a trailing suffix of `path` on a PATH-COMPONENT boundary? The
;; boundary check is what stops `a_test.blsp` from matching `extra_test.blsp` —
;; a plain `ends-with?` says yes to that, so `nest test a_test.blsp:5` could
;; select a test in a completely different file.
(defn- test-path-suffix? (path needle)
  (and (string/ends-with? path needle)
    (let (cut (- (count path) (count needle)))
      (or (= cut 0) (= (string/substring path (- cut 1) cut) "/")))))

;; Two paths may name the same file (the CLI gets what the user typed; the meta
;; carries what `current-file` recorded), so match on a path-suffix relationship
;; rather than demanding string equality.
(defn- test-same-file? (a b)
  (and (not (nil? a))
    (not (nil? b))
    (or (= a b) (test-path-suffix? a b) (test-path-suffix? b a))))

(defn- test-match-selector? (selector group-label test-name tags)
  (let (key (first selector)
        value (second selector))
    (cond
      (= key "test") (includes? test-name value)
      (= key "describe") (includes? group-label value)
      else (test-has-tag? tags key))))

(defn- test-match-any? (selectors group-label test-name tags)
  (fold (or selectors (list))
    false
    (fn (found selector) (or found (test-match-selector? selector group-label test-name tags)))))

;; Every registered test tuple, across units — the flat view the line resolver
;; and the shard assigner walk.
(defn- test-all-tests (units)
  (fold units nil (fn (acc unit) (append acc (map (third unit) (fn (t) (list (second unit) t)))))))

;; Resolve one FILE:LINE selector to the exact declared line of the test it
;; addresses. A test's recorded line is its FIRST BODY FORM's (a macro sees its arguments'
;; positions, not its own), so the line of its `(test "…"` header lies above it — and the
;; "last test declared at or before LINE" rule picked the test BEFORE it for that line. So the
;; file is read: a LINE inside a `(test …)` form, header included, addresses the test whose
;; recorded line lies inside that form. A LINE outside every test form falls back to the last
;; test declared at or before it. nil when neither finds one.
(defn- test-resolve-line (units file target)
  (let (in-file (seq/filter (map (test-all-tests units) second)
                  (fn (test-tuple)
                    (and (not (nil? (test-line test-tuple)))
                      (test-same-file? (test-file test-tuple) file))))
        ;; the file the matched tests recorded, not the path as typed: a typed path may be a
        ;; suffix of it, or relative to somewhere else
        span (when (not (empty? in-file)) (test-form-span-at (test-file (first in-file)) target))
        inside (when span
                 (seq/find in-file
                   (fn (test-tuple)
                     (and (>= (test-line test-tuple) (first span))
                       (<= (test-line test-tuple) (second span)))))))
    (if inside
      (test-line inside)
      (fold in-file
        nil
        (fn (best test-tuple)
          (let (line (test-line test-tuple))
            (if (and (<= line target) (or (nil? best) (> line best))) line best)))))))

;; `[first-line last-line]` of the innermost `(test …)` form in `file` that includes line
;; `target`, or nil — no such form, or a file that cannot be read. Nodes are compared by
;; character offset against the target line's range; only a matching test form's ends are
;; turned into lines.
(defn- test-form-span-at (file target)
  (let (text (check-allow :discarded-catch (try (file/slurp file) (catch _ nil))))
    (when (string? text)
      (let (starts (test-line-starts text))
        (when (and (>= target 1) (< target (count starts)))
          (test-span-in (reflect/parse-source-positioned text)
            starts
            [(nth starts (dec target)) (nth starts target)]
            nil))))))

;; The character offset each line starts at, line 1 first, and one past the last line's end.
(defn- test-line-starts (text)
  (vec (seq/scan (string/split text "\n") 0 (fn (start line) (+ start (count line) 1)))))

;; The 1-based line of character offset `offset`.
(defn- test-line-at (starts offset)
  (count (seq/take-while starts (fn (start) (<= start offset)))))

;; check-allow: deliberately non-tail — recursion over a parse tree; depth is source nesting.
(defn- test-span-in (node starts line-range found)
  (let (covers (and (< (get node :start) (second line-range))
                 (> (get node :end) (first line-range)))
        kids (get node :kids)
        head (when (and covers (= (get node :kind) :list))
               (seq/find (or kids [])
                 (fn (kid) (not (includes? [:whitespace :comment] (get kid :kind))))))
        here (if (and head (= (get head :kind) :symbol) (= (get head :text) "test"))
               [(test-line-at starts (get node :start))
                 (test-line-at starts (math/max 0 (dec (get node :end))))]
               found))
    (if (and covers kids)
      (fold kids here (fn (acc kid) (test-span-in kid starts line-range acc)))
      here)))

;; Resolve every FILE:LINE selector, warning about any that addresses no test —
;; a typo'd path or a line above the file's first test would otherwise just run
;; zero tests and exit 0, which in CI reads as "all green".
(defn- test-resolve-lines (units lines)
  (fold (or lines (list))
    nil
    (fn (acc entry)
      (let (resolved (test-resolve-line units (first entry) (second entry)))
        (if (nil? resolved)
          (do
            (io/puts (str "warning: no test found at "
                       (first entry)
                       ":"
                       (second entry)
                       " — that file/line addresses nothing")
              :to *err*)
            acc)
          (cons [(first entry) resolved] acc))))))

(defn- test-match-line? (t resolved-lines)
  (fold (or resolved-lines (list))
    false
    (fn (found entry)
      (or found
        (and (test-same-file? (test-file t) (first entry))
          (= (test-line t) (second entry)))))))

(defn- test-match-name? (t group-label names)
  (fold (or names (list)) false (fn (found n) (or found (= n (label group-label (first t)))))))

;; Does this test survive the spec? Positive constraints (`:only` / `:lines` /
;; `:names`) are a whitelist — when none are given, everything is a candidate.
;; `:exclude` then drops matches, and `:include` re-admits them (so `--include`
;; overrides `--exclude`, as in ExUnit).
;;
;; NOTE the whitelist test uses the REQUESTED `:lines`, not the resolved ones. A
;; selector that resolves to nothing (typo'd path, a line above the file's first
;; test) still constrains the run to zero tests — deriving it from the resolved
;; list instead made an unresolvable `FILE:LINE` fall through to "no constraints"
;; and run the ENTIRE suite, which in CI is indistinguishable from success.
(defn- test-select? (group-label t spec resolved-lines)
  (let (test-name (first t)
        tags (test-tags t)
        only (get spec :only)
        names (get spec :names)
        positive? (or (not (empty? (or only (list))))
                    (not (empty? (or (get spec :lines) (list))))
                    (not (empty? (or names (list))))))
    (and (or (not positive?)
           (test-match-any? only group-label test-name tags)
           (test-match-line? t resolved-lines)
           (test-match-name? t group-label names))
      (not (and (test-match-any? (get spec :exclude) group-label test-name tags)
             (not (test-match-any? (get spec :include) group-label test-name tags)))))))

;; Apply a filter spec to the unit list, dropping units left with no tests.
(defn- test-filter-units (units spec)
  (if (nil? spec)
    units
    (let (resolved (test-resolve-lines units (get spec :lines)))
      (seq/filter (map units
                    (fn (unit)
                      (list (first unit)
                        (second unit)
                        (seq/filter (third unit)
                          (fn (t) (test-select? (second unit) t spec resolved))))))
        (fn (unit) (not (empty? (third unit))))))))

;; A stable hash of a test's full label — FNV-1a over its codepoints, masked to
;; 32 bits, then avalanched. Deterministic across machines and runs (no address
;; or iteration-order input), which is what CI sharding needs: every shard must
;; agree on the split, or a test gets run twice or dropped.
;;
;; The finalizer is load-bearing, not decoration. A plain polynomial hash
;; (`h*31 + c`) leaves the LOW bits barely mixed — its parity is just the parity
;; of the character sum — so `(math/rem h 2)` sent every test in a small suite to the
;; same shard, leaving the other empty. Shifting the high bits down before the
;; `rem` spreads that structure across the low bits, so small shard counts split
;; evenly.
(def- test-fnv-mask 0xFFFFFFFF)

(defn- test-label-hash (s)
  (let (h (fold (string/->codepoints s)
            0x811C9DC5
            (fn (acc c) (bit/and (* (bit/xor acc c) 0x01000193) test-fnv-mask))))
    (bit/and (bit/xor h (bit/shift-right h 15)) test-fnv-mask)))

;; Keep only the tests belonging to shard `index` of `count` (0-based) — the
;; Partitions, for splitting a suite across CI machines.
(defn- test-shard-units (units index total)
  (if (or (nil? total) (< total 2))
    units
    (seq/filter (map units
                  (fn (unit)
                    (list (first unit)
                      (second unit)
                      (seq/filter (third unit)
                        (fn (t)
                          (= index
                            (math/rem (test-label-hash (label (second unit) (first t))) total)))))))
      (fn (unit) (not (empty? (third unit)))))))

;; Randomise unit order for this run. `nil` seed keeps declaration order (the
;; default — a suite that only passes in one order is a bug worth finding, but
;; making it the default would churn every run's output).
(defn- test-order-units (units seed)
  (if (nil? seed) units (first (seq/shuffle seed units))))

;; The full selection pipeline: filter, shard, then order. One place, so
;; `run-tests` and `run-tests-scoped` can't drift on selection semantics.
(defn- test-select-units (units spec)
  (if (nil? spec)
    units
    (test-order-units (test-shard-units (test-filter-units units spec)
                        (or (get spec :shard) 0)
                        (get spec :shards))
      (get spec :seed))))
