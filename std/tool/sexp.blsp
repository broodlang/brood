;; std/sexp.blsp — structural (s-expression) navigation over Brood's own CST.
;;
;; The "tree-sitter" for Brood code is the reader itself: `parse-source` returns a
;; lossless CST (typed nodes — :list/:vector/:map/:symbol/:str/:comment/:quote…),
;; and because concatenating every leaf's raw text reproduces the source, char
;; positions are recoverable by one walk. This module annotates that tree with
;; absolute [start,end) positions and navigates it by structure.
;;
;; Navigation is written against an abstract NODE shape — `{:kind :start :end
;; :kids}` (`:kids` only on containers/wrappers) — so a different parser backend
;; (e.g. tree-sitter, for foreign languages, living in the editor crate) can later
;; produce the same shape and reuse these commands unchanged. Today the only
;; backend is `parse-source` (Brood code). Pure over (text, point); the buffer
;; commands at the end are the only buffer-aware part. Framework tier, opt-in,
;; zero kernel surface (ADR-045).

(defmodule sexp
  "Structural s-expression navigation over Brood's CST (`parse-source`). Pure
position functions `(text point) -> point` — `point-forward` / `point-backward`
(every form), `point-list-forward` / `point-list-backward` (lists only, Emacs'
`forward-list`), `point-up` / `point-up-forward` / `point-down`, and
`point-defun-start` / `point-defun-end` — and pure edit functions
`(text point) -> [new-text new-point]` (nil when inapplicable) —
`point-slurp-forward` / `point-barf-forward` / `point-slurp-backward` /
`point-barf-backward` / `point-raise` / `point-splice` / `point-wrap-round` /
`point-transpose`, plus `point-kill-end (text point) -> point` (a
structure-capped kill bound). Buffer commands `(buf key) -> buf` wrap each for a
keymap: `forward` / `backward` / `list-forward` / `list-backward` / `up` /
`up-forward` / `down` / `beginning-of-defun` / `end-of-defun` and
`slurp-forward` / `barf-forward` / `slurp-backward` / `barf-backward` / `raise`
/ `splice` / `wrap-round` / `transpose`."
  (:use editor/buffer))

;; ---- node-kind predicates ---------------------------------------------------

(defn container-kind? (k)
  "Kinds whose payload is a child vector (we descend into these).

    (sexp/container-kind? :list)     ;=> true
    (sexp/container-kind? :symbol)   ;=> false"
  (or (= k :root) (= k :list) (= k :vector) (= k :map)))

(defn form? (anode)
  "A real s-expression node — anything but whitespace and comments.

    (count (seq/filter (get (sexp/tree \"(a) ; c\\n(b)\") :kids) sexp/form?))   ;=> 2"
  (let (k (get anode :kind))
    (and (not (= k :whitespace)) (not (= k :comment)))))

;; ---- the position-annotated CST ---------------------------------------------

(defn tree (text)
  "The annotated CST root for `text` (a `{:kind :root :kids …}` node), every node
carrying half-open character `:start`/`:end` positions. The kernel's
`parse-source-positioned` projects the positions it already tracks in one pass —
the structure queries below navigate the result directly. (This replaced an
in-Brood `annotate` walk that re-derived positions by summing leaf lengths: O(n)
interpreted and the bottleneck in structural navigation.)

    (get (sexp/tree \"(a)\") :kind)   ;=> :root"
  (reflect/parse-source-positioned text))

;; ---- structure queries ------------------------------------------------------

(defn enclosing (anode:map point:number -> map)
  "The deepest container node strictly containing `point` (descending into
list/vector/map children); the root if none. Reader-macro wrappers are navigated
as a unit — descending through them is a deferred refinement.

    (get (sexp/enclosing (sexp/tree \"(a (b c))\") 5) :start)   ;=> 3"
  (let (hit (seq/find (or (get anode :kids) (list))
              (fn (k)
                (and (container-kind? (get k :kind))
                  (< (get k :start) point)
                  (< point (get k :end))))))
    (if (nil? hit) anode (enclosing hit point))))

;; A tree node — a positioned CST node `{:kind :start :end …}` with half-open character
;; offsets; its `:kids` are nodes too. Stated once here, so the offset accessors and the
;; walks below are verified against it rather than trusted.
(deftype sexp-node (record &open :start int :end int))

;; Trusted, not verified: a `:kids` entry is a node by the reader's construction, which a
;; bare `get` on the parent cannot say.
(check-allow :trusted
  (defn forms-of (anode)
    "The form (non-whitespace, non-comment) children of `anode`.

    (count (sexp/forms-of (sexp/tree \"(a) ; c\\n(b)\")))   ;=> 2"
    (seq/filter (or (get anode :kids) (list)) form?)))
(sig forms-of (map -> (list sexp-node)))

(defn top-level-forms (text:string -> seqable)
  "The top-level forms of `text`, in order, each a positioned node `{:kind :start
:end …}` with half-open character offsets. Error-tolerant (the reader's CST
recovers), so it answers over source someone is mid-typing — which form contains
point, where each form ends — without a completeness gate; whether the text
*evaluates* is a separate `reflect/read-all` question. Note recovery means a node may be
`:kind :error` (e.g. an unterminated string swallowing the rest of the text) —
fine for position queries, but don't feed the returned spans to `reflect/eval` unchecked.

    (count (sexp/top-level-forms \"(a)\n(b)\n\"))   ;=> 2"
  (forms-of (tree text)))

;; ---- narrowing: bound structural queries to the forms around point ----------
;; `parse-source-positioned` plus the CST walk below are O(buffer): at the bottom of a
;; large file a single `forward-sexp` parses every top-level form and filters the root's
;; whole child list. Structural motion is LOCAL, though — it never reaches past the form
;; before point or the form after it. So `narrow` slices the text to that neighbourhood
;; (the previous, enclosing, and next top-level forms) and the queries run on the slice,
;; shifting positions back by its base. O(buffer) → O(neighbouring forms). A top-level form
;; start is a top-level (depth-0) open bracket that lies OUTSIDE any string or comment
;; (`highlight/safe-restart` is the same idea) — found by the native `scan-form-start`:
;; the awareness needs a forward lexical pass from the top (a backward char-scan can't know
;; whether a `(` sits inside an unterminated string), and interpreted that pass would make
;; every structural query O(pos) at char-recursion cost. The window END — the forward scan
;; over the ~3-form window, skipping strings/comments and tracking bracket depth — is
;; likewise native (`scan-form-end`), since it runs on every keystroke-driven motion.

(defn narrow (text: (or string rope) point:int -> (tuple int string))
  "`[base sub]` — `text` sliced to the top-level forms around `point` (the previous,
enclosing, and next form), with `base` the slice's offset in `text`. `text` is a string or
the rope an editor holds (ADR-488): a rope is scanned in place and only the window is copied
out, so a motion in a large buffer costs its neighbouring forms, not the document. Structural motion
from `point` stays inside this window, so running the CST queries on `sub` (with `point`
shifted by `base`, the result shifted back) matches running them on all of `text` — at a
cost of ~three forms, not the whole buffer.

    (sexp/narrow \"(a)\\n(b)\\n(c)\\n(d)\" 9)   ;=> [4 \"(b)\\n(c)\\n(d)\"]
    (sexp/narrow (text/from-string \"(a)\\n(b)\\n(c)\\n(d)\") 9)   ;=> [4 \"(b)\\n(c)\\n(d)\"]"
  (let (n (text/length text)
        p (math/max 0 (math/min point n))
        ;; ONE lexical pass for both offsets — two `scan-form-start` calls would re-walk
        ;; the same prefix, the dominant cost of every structural motion.
        [base _start] (reflect/scan-form-start-2 text (math/min p (math/max 0 (dec n))))
        ;; The window END: the lexical scan (strings/comments skipped, bracket depth
        ;; tracked) in one native byte pass.
        end (reflect/scan-form-end text base 3))
    [base (text/slice text base end)]))

;; ---- pure navigation: (text point) -> point ---------------------------------

;; The sibling walk is one shape parameterised by which siblings count: `forward-sexp`
;; steps over every form, `forward-list` over the containers only (Emacs' sexp/list pair).

(defn- sexp-anything? (anode) "Every form counts — the `forward-sexp` sibling filter." true)
(defn- sexp-list? (anode)
  "A container form — the `forward-list` sibling filter (and what `down-list` descends)."
  (container-kind? (get anode :kind)))

;; ---- the site: everything a motion asks about the point, computed once --------
;; Every structural motion needs the same triple — `narrow` the text, `tree` the window,
;; `enclosing` the point — so it is derived once, with the base-offset arithmetic in one
;; place. A motion is a SELECTION over one value: the enclosing container, its forms, and
;; where the point sits among them.

(defn- sexp-site (text: (or string rope) point:int -> (record &open :base int :rp int))
  "`{:base :rp :enc}` for `point` in `text`: the narrowed window's offset, the point
relative to it, and the deepest container node holding it (the window's root at top
level). Positions the motions read off `:enc`'s forms are window-relative — [[sexp-abs]]
puts one back."
  (let ([base sub] (narrow text point)
        rp (- point base))
    {:base base :rp rp :enc (enclosing (tree sub) rp)}))

(defn- sexp-abs (site: (record &open :base int) p:int -> int)
  "A window-relative position of `site` back in the text."
  (+ (:base site) p))

(defn- sexp-top-level? (site:map -> bool)
  (= (get (:enc site) :kind) :root))

(defn- sexp-atom-around (enc:map rp:int keep?:fn -> (or nil map))
  "The non-container form of `enc` that STRADDLES `rp` (start < rp < end) and satisfies
`keep?`, or nil. A point inside a symbol or a string is inside an atom, not between two
siblings: the sibling walks see only forms starting after / ending before it, so from
`(calc/ev|al \"1 1 +\")` forward skipped the rest of the symbol AND the string, backward
stayed put, and from inside the string forward stayed put while backward jumped to before
`calc/eval` — read as \"C-M-f does nothing / C-M-b jumps up one expression\" (2026-08-30).
Emacs and paredit move to the atom's own edge; so does this."
  (seq/find (forms-of enc)
    (fn (f)
      (and (not (container-kind? (get f :kind)))
        (< (sexp-start f) rp)
        (< rp (sexp-end f))
        (keep? f)))))

(defn- sexp-sibling-forward (text point keep?)
  "End of the next sibling form satisfying `keep?` starting at or after `point`, within the
enclosing list — or the end of the atom `point` is inside; `point` when there is none. The
shared body of the forward motions."
  (let (site (sexp-site text point)
        rp (:rp site)
        enc (:enc site)
        nxt (or (sexp-atom-around enc rp keep?)
              (seq/find (forms-of enc) (fn (f) (and (>= (sexp-start f) rp) (keep? f))))))
    (if (nil? nxt) point (sexp-abs site (sexp-end nxt)))))

(defn- sexp-sibling-backward (text point keep?)
  "Start of the previous sibling form satisfying `keep?` ending at or before `point`, within
the enclosing list — or the start of the atom `point` is inside; `point` when there is none.
The shared body of the backward motions."
  (let (site (sexp-site text point)
        rp (:rp site)
        enc (:enc site)
        prev (or (sexp-atom-around enc rp keep?)
               (last (seq/filter (forms-of enc) (fn (f) (and (<= (sexp-end f) rp) (keep? f)))))))
    (if (nil? prev) point (sexp-abs site (sexp-start prev)))))

(defn point-forward (text point)
  "End of the next sexp at or after `point` within the enclosing list; unchanged if
there is none (the Emacs `forward-sexp`).

    (sexp/point-forward \"(a b)\" 0)    ;=> 5"
  (sexp-sibling-forward text point sexp-anything?))

(defn point-backward (text point)
  "Start of the previous sexp ending at or before `point` (Emacs `backward-sexp`).

    (sexp/point-backward \"(a b)\" 5)   ;=> 0"
  (sexp-sibling-backward text point sexp-anything?))

(defn point-list-forward (text point)
  "End of the next LIST at or after `point` within the enclosing list — atoms are stepped
over, not stopped at (Emacs `forward-list`, C-M-n); unchanged if there is none.

    (sexp/point-list-forward \"(a) (b)\" 0)   ;=> 3"
  (sexp-sibling-forward text point sexp-list?))

(defn point-list-backward (text point)
  "Start of the previous LIST ending at or before `point` — atoms stepped over (Emacs
`backward-list`, C-M-p); unchanged if there is none.

    (sexp/point-list-backward \"(a) (b)\" 7)  ;=> 4"
  (sexp-sibling-backward text point sexp-list?))

;; The keys get these two; the pure pair above keeps Emacs' exact contract (`forward-sexp`
;; at the end of a list ERRORS, i.e. does not move) because the edits are built on it —
;; `kill-sexp` at `(a b|)` must kill nothing, not the `)`; `mark-sexp` must not mark past
;; the list. A MOTION that stalls there feels broken, and paredit's answer is the right
;; one: step out of the list. So `C-M-f` at `(a b|)` lands after the `)`, `C-M-b` at
;; `(|a b)` lands before the `(`, and at top level with nothing further both stay put.

(defn point-forward-out (text point)
  "`point-forward`, escaping the enclosing list when no sibling follows (paredit
`forward`): the end of the next sexp, else just past the enclosing list's close
delimiter, else `point`.
    (sexp/point-forward-out \"(a b) c\" 4)   ;=> 5"
  (let (q (point-forward text point))
    (if (= q point) (point-up-forward text point) q)))

(defn point-backward-out (text point)
  "`point-backward`, escaping the enclosing list when no sibling precedes (paredit
`backward`): the start of the previous sexp, else before the enclosing list's open
delimiter, else `point`.
    (sexp/point-backward-out \"(a b) c\" 1)   ;=> 0"
  (let (q (point-backward text point))
    (if (= q point) (point-up text point) q)))

(defn point-up (text point)
  "Start of the enclosing list — before its opening delimiter (Emacs
`backward-up-list`); unchanged at top level.

    (sexp/point-up \"(a (b))\" 4)       ;=> 3"
  (let (site (sexp-site text point))
    (if (sexp-top-level? site) point (sexp-abs site (sexp-start (:enc site))))))

(defn point-up-forward (text point)
  "Just past the enclosing list's closing delimiter — the forward counterpart of
`point-up` (Emacs `up-list`); unchanged at top level.

    (sexp/point-up-forward \"(a (b))\" 4)   ;=> 6"
  (let (site (sexp-site text point))
    (if (sexp-top-level? site) point (sexp-abs site (sexp-end (:enc site))))))

(defn point-down (text point)
  "Just inside the next list at or after `point` (Emacs `down-list`); unchanged if
none.

    (sexp/point-down \"(a b)\" 0)       ;=> 1"
  (let (site (sexp-site text point)
        rp (:rp site)
        lst (seq/find (forms-of (:enc site)) (fn (f) (and (sexp-list? f) (>= (sexp-start f) rp)))))
    (if (nil? lst) point (sexp-abs site (inc (sexp-start lst))))))

(defn- sexp-defun-edge (text: (or string rope) point:int edge:keyword -> int)
  "The `edge` (`:start` / `:end`) of the top-level form containing `point`; `point` when
`point` isn't within one. The shared body of `point-defun-start` / `point-defun-end`."
  (let ([base sub] (narrow text point)
        rp (- point base)
        top (seq/find (forms-of (tree sub))
              (fn (f) (and (<= (sexp-start f) rp) (<= rp (sexp-end f))))))
    (if (nil? top)
      point
      (+ base (if (= edge :start) (sexp-start top) (sexp-end top))))))

(defn point-defun-start (text point)
  "Start of the top-level form containing `point` (Emacs `beginning-of-defun`);
unchanged if `point` isn't within one.

    (sexp/point-defun-start \"(a)\\n(b (c))\" 8)   ;=> 4"
  (sexp-defun-edge text point :start))

(defn point-defun-end (text point)
  "End of the top-level form containing `point` (Emacs `end-of-defun`, C-M-e);
unchanged if `point` isn't within one.

    (sexp/point-defun-end \"(defn f (x)\n  (+ x 1))\n\" 0)   ;=> 22"
  (sexp-defun-edge text point :end))

;; ---- pure structural edits: (text point) -> [new-text new-point] ------------
;; The paredit family. Each computes the whole new text plus where point should land,
;; or nil when the op doesn't apply (no sibling to slurp, top level for splice, …) —
;; the buffer wrappers below treat nil as a no-op, mirroring how the motions above
;; return `point` unchanged. Unlike the motions these read the FULL-text `tree` (not
;; `narrow`): an edit fires once per explicit chord, not per cursor move, so the
;; O(buffer) parse is fine (the fontify/diagnostics passes already parse per frame).
;; `parent` is found with the same `(enclosing tr (sexp-start enc))` idiom the indenter
;; uses — a top-level form's parent is the root, so slurp/barf reach the next top form.

;; Typed offset accessors over a tree node (`sexp-node`, above) — a node's `:start`/`:end`
;; are int offsets, which a bare `get` cannot say; the shape says it, and the accessors verify.
(defn- sexp-start (anode:sexp-node -> int) (get anode :start))
(defn- sexp-end (anode:sexp-node -> int) (get anode :end))

(defn- sexp-enc-of (text point)
  "The deepest container enclosing `point`, or nil when that's the root (no list to
edit). Wrapped in `[tr enc]` so callers reuse the one tree for parent/child lookups."
  (let (tr (tree text)
        enc (enclosing tr point))
    (if (= (get enc :kind) :root) nil [tr enc])))

(defn point-slurp-forward (text point)
  "Pull the sibling form *after* the enclosing list inside it — move the close
delimiter past that form (Emacs/paredit `forward-slurp-sexp`).

    (sexp/point-slurp-forward \"(a) b\" 1)   ;=> [\"(a b)\" 1]"
  (let (ctx (sexp-enc-of text point))
    (if (nil? ctx)
      nil
      (let ([tr enc] ctx
            ee (sexp-end enc)
            parent (enclosing tr (sexp-start enc))
            nxt (seq/find (forms-of parent) (fn (f) (>= (get f :start) ee))))
        (if (nil? nxt)
          nil
          (let (ne (get nxt :end))
            [(str (string/substring text 0 (dec ee))
               (string/substring text ee ne)
               (string/char-at text (dec ee))
               (string/substring text ne))
              point]))))))

(defn point-barf-forward (text point)
  "Expel the last form of the enclosing list — move the close delimiter in past the
form before it (paredit `forward-barf-sexp`); point stays inside the list.

    (sexp/point-barf-forward \"(a b)\" 1)    ;=> [\"(a) b\" 1]"
  (let (ctx (sexp-enc-of text point))
    (if (nil? ctx)
      nil
      (let ([_tr enc] ctx
            es (sexp-start enc)
            ee (sexp-end enc)
            fs (forms-of enc))
        (if (empty? fs)
          nil
          (let (n (count fs)
                ;; `n - 2` is inside `fs` when `n ≥ 2` — a relation between two locals the
                ;; checker does not hold (C12); the `or` states it in a form it reads.
                new-close (if (>= n 2)
                            (sexp-end (or (nth fs (- n 2)) (error "sexp: no form before the last")))
                            (inc es)))
            [(str (string/substring text 0 new-close)
               (string/char-at text (dec ee))
               (string/substring text new-close (dec ee))
               (string/substring text ee))
              (math/min point
                new-close)]))))))

(defn point-slurp-backward (text point)
  "Pull the sibling form *before* the enclosing list inside it — move the open
delimiter back over that form (paredit `backward-slurp-sexp`).

    (sexp/point-slurp-backward \"a (b)\" 3)  ;=> [\"(a b)\" 3]"
  (let (ctx (sexp-enc-of text point))
    (if (nil? ctx)
      nil
      (let ([tr enc] ctx
            es (sexp-start enc)
            parent (enclosing tr es)
            prev (last (seq/filter (forms-of parent) (fn (f) (<= (get f :end) es)))))
        (if (nil? prev)
          nil
          (let (previous-start (get prev :start))
            [(str (string/substring text 0 previous-start)
               (string/char-at text es)
               (string/substring text previous-start es)
               (string/substring text (inc es)))
              point]))))))

(defn point-barf-backward (text point)
  "Expel the first form of the enclosing list — move the open delimiter in past the
form after it (paredit `backward-barf-sexp`); point stays inside the list.

    (sexp/point-barf-backward \"(a b)\" 1)   ;=> [\"a (b)\" 3]"
  (let (ctx (sexp-enc-of text point))
    (if (nil? ctx)
      nil
      (let ([_tr enc] ctx
            es (sexp-start enc)
            ee (sexp-end enc)
            fs (forms-of enc))
        (if (empty? fs)
          nil
          (let (new-open (if (>= (count fs) 2) (get (second fs) :start) (dec ee)))
            [(str (string/substring text 0 es)
               (string/substring text (inc es) new-open)
               (string/char-at text es)
               (string/substring text new-open))
              (if (< point new-open)
                new-open
                point)]))))))

(defn point-raise (text point)
  "Replace the enclosing list with the child form point is in/on, deleting that
form's siblings (paredit `raise-sexp`).

    (sexp/point-raise \"(a (b))\" 3)      ;=> [\"(b)\" 0]"
  (let (ctx (sexp-enc-of text point))
    (if (nil? ctx)
      nil
      (let ([_tr enc] ctx
            current (seq/find (forms-of enc)
                      (fn (f) (and (<= (get f :start) point) (<= point (get f :end))))))
        (if (nil? current)
          nil
          (let (cs (get current :start) ce (get current :end))
            [(str (string/substring text 0 (sexp-start enc))
               (string/substring text cs ce)
               (string/substring text (sexp-end enc)))
              (+ (get enc :start)
                (- point
                  cs))]))))))

(defn point-splice (text point)
  "Remove the enclosing list's delimiters, keeping its contents (paredit
`splice-sexp`).

    (sexp/point-splice \"(a (b c))\" 4)   ;=> [\"(a b c)\" 3]"
  (let (ctx (sexp-enc-of text point))
    (if (nil? ctx)
      nil
      (let ([_tr enc] ctx
            es (sexp-start enc)
            ee (sexp-end enc))
        [(str (string/substring text 0 es)
           (string/substring text (inc es) (dec ee))
           (string/substring text ee))
          (math/max es
            (dec point))]))))

(defn point-wrap (text:string point:int open:string close:string -> (or nil (tuple string int)))
  "Wrap the form at or after `point` in a fresh `open … close`, point landing just inside
the new open — paredit's `wrap-round` for any delimiter pair (`wrap-square`, `wrap-curly`).

    (sexp/point-wrap \"a b\" 0 \"[\" \"]\")   ;=> [\"[a] b\" 1]"
  (let (tr (tree text)
        enc (enclosing tr point)
        nxt (seq/find (forms-of enc) (fn (f) (>= (get f :end) point))))
    (if (nil? nxt)
      nil
      (let (ns (sexp-start nxt) ne (sexp-end nxt))
        [(str (string/substring text 0 ns)
           open
           (string/substring text ns ne)
           close
           (string/substring text ne))
          (+ ns (string/length open))]))))

(defn point-wrap-round (text point)
  "Wrap the form at or after `point` in a fresh `( … )`, point landing just inside the
new open (paredit `wrap-round`).

    (sexp/point-wrap-round \"a b\" 0)     ;=> [\"(a) b\" 1]"
  (point-wrap text point "(" ")"))

(defn span-wrap (text:string lo:int hi:int open:string close:string -> (tuple string int))
  "Wrap the span `[lo, hi)` of `text` in `open … close`, point landing just inside the new
open — what an opening bracket typed over an ACTIVE REGION does (paredit's `wrap-round`
on a selection, Emacs's `electric-pair-mode` with a region). No structure is consulted:
the selection IS the form the user means.

    (sexp/span-wrap \"a b c\" 2 3 \"(\" \")\")   ;=> [\"a (b) c\" 3]"
  [(str (string/substring text 0 lo)
     open
     (string/substring text lo hi)
     close
     (string/substring text hi))
    (+ lo (string/length open))])

(defn point-transpose (text:string point:any -> (or nil (vector any)))
  "Interchange the sexp before `point` with the one after it, point landing just past both
(Emacs `transpose-sexps`, C-M-t); nil when there isn't a form on each side within the same
enclosing list. When `point` sits *inside* a form, that form is the one \"after\" — so the
chord mid-symbol swaps it with its predecessor, as it does in Emacs. Only the span
`[prev.start, next.end)` is rearranged and its length is unchanged, so point lands exactly
at `next.end` (the whitespace between the two forms is preserved in place).

    (sexp/point-transpose \"(a b)\" 2)   ;=> [\"(b a)\" 4]"
  (let (enc (enclosing (tree text) point)
        sibs (forms-of enc)
        inside (seq/find sibs (fn (f) (and (< (get f :start) point) (< point (get f :end)))))
        next (if (nil? inside) (seq/find sibs (fn (f) (>= (get f :start) point))) inside)
        prev (if (nil? next)
               nil
               (last (seq/filter sibs (fn (f) (<= (get f :end) (get next :start)))))))
    (if (or (nil? prev) (nil? next))
      nil
      (let (previous-start (get prev :start)
            pe (get prev :end)
            ns (get next :start)
            ne (get next :end))
        [(str (string/substring text 0 previous-start)
           (string/substring text ns ne) ; the later form, moved before …
           (string/substring text pe ns) ; … the separator between them, kept as-is …
           (string/substring text previous-start pe) ; … then the earlier form
           (string/substring text ne))
          ne]))))

;; ---- structure-aware kill bound ---------------------------------------------

(defn- sexp-line-end (text: (or string rope) at:int -> int)
  "Offset of the next newline at or after `at`, or the end of `text`. A rope is read only to
that newline — not through its line index, which also breaks lines at a form feed or a lone
CR, where this asks for a `\\n` alone."
  (if (rope? text)
    (text/skip-forward text at "\n" false)
    (let (newline (index-of text "\n" at)) (if (< newline 0) (string/length text) newline))))

; list spans lines → kill to end of line
(defn point-kill-end (text point)
  "End offset for a structure-aware kill from `point` (paredit `kill`): the line end,
but never past the enclosing list's closing delimiter — so a kill never breaks the
parens. At end of line, kills the newline. At least `point` (a no-op at the close). `text` is a
string or a rope.

    (sexp/point-kill-end \"(a b c)\" 3)  ;=> 6
    (sexp/point-kill-end (text/from-string \"(a\\n b)\") 1)  ;=> 2"
  ;; The enclosing list from the narrowed window around point ([[sexp-site]]), not a parse
  ;; of the whole text: a C-k in a 44k-line file parsed all of it, 140-230 ms a keystroke.
  (let (n (text/length text)
        le (sexp-line-end text point)
        site (sexp-site text point))
    (if (sexp-top-level? site)
      (if (= point le) (math/min n (inc point)) le)
      (let (cp (sexp-abs site (dec (sexp-end (:enc site)))))
        (cond
          (<= cp le) (math/max point cp)
          ; close on this line → kill up to (not incl) it
          (= point le) (math/min n (inc point))
          ; empty rest of line → kill the newline
          else le)))))
;; ---- buffer commands: (buf key) -> buf (bind these in a keymap) -------------

(defn- sexp-apply-edit (buf result)
  "Apply a pure edit `[new-text new-point]` to `buf` as one whole-buffer splice (a
single undo unit), leaving point at `new-point`; `buf` unchanged when `result` is nil."
  (if (nil? result)
    buf
    (let ([t p] result)
      (goto-char (replace-region buf 0 (buffer-length buf) t) p))))

(defn forward (buf key)
  "Move point over the next sexp (Emacs `forward-sexp`); buffer command.

    (editor/buffer/buffer-point (sexp/forward (editor/buffer/make-buffer \"(a b) c\") nil))   ;=> 5"
  (goto-char buf (point-forward (buffer-rope buf) (get buf :point))))
(defn backward (buf key)
  "Move point back over the previous sexp (Emacs `backward-sexp`); buffer command.

    (editor/buffer/buffer-point (sexp/backward (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"a (b c)\")) nil))   ;=> 2"
  (goto-char buf (point-backward (buffer-rope buf) (get buf :point))))
(defn forward-out (buf key)
  "`forward`, stepping out of the list when nothing follows (paredit); the motion to
bind to C-M-f — `forward` stays the edit primitive (kill/mark).

    (editor/buffer/buffer-point (sexp/forward-out (editor/buffer/goto-char (editor/buffer/make-buffer \"(a b) c\") 4) nil))   ;=> 5"
  (goto-char buf (point-forward-out (buffer-rope buf) (get buf :point))))
(defn backward-out (buf key)
  "`backward`, stepping out of the list when nothing precedes (paredit); the motion to
bind to C-M-b.

    (editor/buffer/buffer-point (sexp/backward-out (editor/buffer/goto-char (editor/buffer/make-buffer \"x (a b)\") 3) nil))   ;=> 2"
  (goto-char buf (point-backward-out (buffer-rope buf) (get buf :point))))
(defn up (buf key)
  "Move point out of the enclosing list, before its open delimiter (Emacs
`backward-up-list`); buffer command.

    (editor/buffer/buffer-point (sexp/up (editor/buffer/goto-char (editor/buffer/make-buffer \"x (a b)\") 5) nil))   ;=> 2"
  (goto-char buf (point-up (buffer-rope buf) (get buf :point))))
(defn down (buf key)
  "Move point into the next list, just past its open delimiter (Emacs `down-list`);
buffer command.

    (editor/buffer/buffer-point (sexp/down (editor/buffer/make-buffer \"x (a b)\") nil))   ;=> 3"
  (goto-char buf (point-down (buffer-rope buf) (get buf :point))))
(defn list-forward (buf key)
  "Move point over the next LIST, stepping past atoms (Emacs `forward-list`); buffer
command.

    (editor/buffer/buffer-point (sexp/list-forward (editor/buffer/make-buffer \"a b (c)\") nil))   ;=> 7"
  (goto-char buf (point-list-forward (buffer-rope buf) (get buf :point))))
(defn list-backward (buf key)
  "Move point back over the previous LIST, stepping past atoms (Emacs `backward-list`);
buffer command.

    (editor/buffer/buffer-point (sexp/list-backward (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"(a) b c\")) nil))   ;=> 0"
  (goto-char buf (point-list-backward (buffer-rope buf) (get buf :point))))
(defn up-forward (buf key)
  "Move point out of the enclosing list, past its close delimiter (Emacs `up-list`);
buffer command.

    (editor/buffer/buffer-point (sexp/up-forward (editor/buffer/goto-char (editor/buffer/make-buffer \"(a b) c\") 2) nil))   ;=> 5"
  (goto-char buf (point-up-forward (buffer-rope buf) (get buf :point))))
(defn beginning-of-defun (buf key)
  "Move point to the start of the enclosing top-level form (Emacs `beginning-of-defun`);
buffer command.

    (editor/buffer/buffer-point (sexp/beginning-of-defun (editor/buffer/goto-char (editor/buffer/make-buffer \"(a)\\n(b c)\") 7) nil))   ;=> 4"
  (goto-char buf (point-defun-start (buffer-rope buf) (get buf :point))))
(defn end-of-defun (buf key)
  "Move point to the end of the enclosing top-level form (Emacs `end-of-defun`); buffer
command.

    (editor/buffer/buffer-point (sexp/end-of-defun (editor/buffer/goto-char (editor/buffer/make-buffer \"(a)\\n(b c)\") 5) nil))   ;=> 9"
  (goto-char buf (point-defun-end (buffer-rope buf) (get buf :point))))

(defn slurp-forward (buf key)
  "Grow the enclosing list to swallow the sibling form after it (paredit
`forward-slurp-sexp`); buffer command, no-op when there's none.

    (editor/buffer/buffer-text (sexp/slurp-forward (editor/buffer/goto-char (editor/buffer/make-buffer \"(a b) c\") 2) nil))   ;=> \"(a b c)\""
  (sexp-apply-edit buf (point-slurp-forward (buffer-text buf) (get buf :point))))
(defn barf-forward (buf key)
  "Shrink the enclosing list, expelling its last form (paredit `forward-barf-sexp`);
buffer command, no-op when it's empty.

    (editor/buffer/buffer-text (sexp/barf-forward (editor/buffer/goto-char (editor/buffer/make-buffer \"(a b c)\") 2) nil))   ;=> \"(a b) c\""
  (sexp-apply-edit buf (point-barf-forward (buffer-text buf) (get buf :point))))
(defn slurp-backward (buf key)
  "Grow the enclosing list to swallow the sibling form before it (paredit
`backward-slurp-sexp`); buffer command, no-op when there's none.

    (editor/buffer/buffer-text (sexp/slurp-backward (editor/buffer/goto-char (editor/buffer/make-buffer \"a (b c)\") 4) nil))   ;=> \"(a b c)\""
  (sexp-apply-edit buf (point-slurp-backward (buffer-text buf) (get buf :point))))
(defn barf-backward (buf key)
  "Shrink the enclosing list, expelling its first form (paredit `backward-barf-sexp`);
buffer command, no-op when it's empty.

    (editor/buffer/buffer-text (sexp/barf-backward (editor/buffer/goto-char (editor/buffer/make-buffer \"(a b c)\") 4) nil))   ;=> \"a (b c)\""
  (sexp-apply-edit buf (point-barf-backward (buffer-text buf) (get buf :point))))
(defn raise (buf key)
  "Replace the enclosing list with the form point is on, deleting its siblings (paredit
`raise-sexp`); buffer command, no-op at top level.

    (editor/buffer/buffer-text (sexp/raise (editor/buffer/goto-char (editor/buffer/make-buffer \"(f (g x))\") 6) nil))   ;=> \"(f x)\""
  (sexp-apply-edit buf (point-raise (buffer-text buf) (get buf :point))))
(defn splice (buf key)
  "Remove the enclosing list's delimiters, splicing its contents up a level (paredit
`splice-sexp`); buffer command, no-op at top level.

    (editor/buffer/buffer-text (sexp/splice (editor/buffer/goto-char (editor/buffer/make-buffer \"(f (g x))\") 5) nil))   ;=> \"(f g x)\""
  (sexp-apply-edit buf (point-splice (buffer-text buf) (get buf :point))))
(defn wrap-round (buf key)
  "Wrap the form at or after point in a fresh `( … )` (paredit `wrap-round`); buffer
command, no-op when there's no following form.

    (editor/buffer/buffer-text (sexp/wrap-round (editor/buffer/make-buffer \"a b\") nil))   ;=> \"(a) b\""
  (sexp-apply-edit buf (point-wrap-round (buffer-text buf) (get buf :point))))
(defn wrap (buf:buffer open:string close:string -> buffer)
  "Wrap the form at or after point in a fresh `open … close` (`point-wrap`); buffer
command, no-op when there's no following form.

    (editor/buffer/buffer-text (sexp/wrap (editor/buffer/make-buffer \"a b\") \"[\" \"]\"))   ;=> \"[a] b\""
  (sexp-apply-edit buf (point-wrap (buffer-text buf) (get buf :point) open close)))
(defn wrap-region (buf:buffer open:string close:string -> buffer)
  "Wrap the buffer's active region in `open … close` (`span-wrap`), point landing just
inside the new open and the region deactivated — what an opening bracket typed over a
selection does. `buf` unchanged when no region is active.

    (editor/buffer/buffer-text (sexp/wrap-region (editor/buffer/goto-char (editor/buffer/set-mark (editor/buffer/make-buffer \"a b c\")) 3) \"{\" \"}\"))   ;=> \"{a b} c\""
  (let (bounds (buffer-region-bounds buf))
    (if (nil? bounds)
      buf
      (let ([lo hi] bounds)
        (clear-mark (sexp-apply-edit buf (span-wrap (buffer-text buf) lo hi open close)))))))
(defn transpose (buf key)
  "Swap the sexps before and after point (Emacs `transpose-sexps`); buffer command,
no-op without a form on each side.

    (editor/buffer/buffer-text (sexp/transpose (editor/buffer/goto-char (editor/buffer/make-buffer \"a b\") 1) nil))   ;=> \"b a\""
  (sexp-apply-edit buf (point-transpose (buffer-text buf) (get buf :point))))
