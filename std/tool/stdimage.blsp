;; std/tool/stdimage.blsp — a startup image for the STANDARD LIBRARY (ADR-218 applied to
;; `std/*` rather than to a project's own modules).
;;
;; The problem it solves: a stdlib module is `include_str!`'d source, so `(require 'format)`
;; re-reads and re-EVALUATES it on every run. Measured on 0.11.0, loading `format` costs
;; 82 ms — of which 1.1 ms is reading and **81 ms is eval + promote**, i.e. materialising
;; closures into the heap. An image skips exactly that: the same 81 bindings restore from a
;; section in ~1–2 ms, a 40–57x difference, and they come back as real closures (a restored
;; function still enforces its own arity).
;;
;; It is the same mechanism `std/tool/project.blsp` already uses, pointed at a different set
;; of modules, and the two coexist through `%add-image-source!` — the prelude consults the
;; project's sections first, then any additional source, so a project can still shadow a
;; stdlib module name.
;;
;; **Staleness is `system/stdlib-id`** — version + git sha + a content hash of every baked-in
;; `.blsp`, computed at build time. Deliberately NOT `system/build-id`, which embeds the running
;; executable's mtime: that would give `brood`, `nest` and `brood-lsp` three different keys
;; for one identical stdlib, and three ~2 MB images. It still changes on any edit to any
;; `.blsp`, committed or not, so a stale image can never be read.
;;
;; Policy only (ADR-006): `%image-write` / `%image-index` / `%image-load-section` are the
;; mechanism; what to snapshot, where it lives and when it is rebuilt is here.

(defmodule stdimage
  "A startup image for the standard library: std modules are pre-evaluated and promoted once
  at build time rather than re-read and re-evaluated on every run."
  (:use seq)
  (:use file))

(defn- cache-dir ()
  "`$XDG_CACHE_HOME/brood` (or `~/.cache/brood`), or nil when neither is set."
  (let (xdg (os/env "XDG_CACHE_HOME")
        home (os/env "HOME")
        base (cond
               (and xdg (not (= xdg ""))) xdg
               (and home (not (= home ""))) (path/join home ".cache")
               else nil))
    (when base (path/join base "brood"))))

(defn image-path ()
  "Where this binary's stdlib image lives, or nil if there is no cache directory.
Named by `system/stdlib-id` — a hash of what is BAKED IN, not of this executable. `system/build-id`
embeds the binary's own mtime, so `brood`, `nest` and `brood-lsp` from one tree would each
write their own ~2 MB copy of an identical image; keyed this way they share one.

The computation lives in the PRELUDE (`%std-image-path`), not here: an image has to be
installed before the first `require`, and this module is itself reached BY a require. One
definition, called from both ends."
  (%std-image-path))

(defn- prefixed-by-any? (nm names)
  "Whether global `nm` is qualified by ANY module in `names` — i.e. some module already
claims it by prefix."
  (not (empty? (seq/filter names (fn (m) (string/starts-with? nm (str m "/")))))))

(defn- %add-reg (acc m triple)
  "`triple` (`[registry-symbol key-path value]`) appended to module `m`'s entries."
  (%map-assoc acc m (append (or (%map-get acc m nil) []) [triple])))

;; The registries a load WRITES that are not registrations: runtime state (`*features*`,
;; `*features-loading*`), the require edges and impls the image carries in their own
;; sections, and `*module-files*`, which maps a PACKAGE's modules to disk paths and so
;; never describes baked-in std.
(def- %std-regs-skip
  #{'*features* '*features-loading* '*require-edges* '*module-files* '*impls* '*impl-from*})

(defn- %reg-owner (reg path kv)
  "The module that OWNS registry `reg`'s entry at `path`: the module whose load WROTE it
(`%registry-writer`, KI-136) — or, for `*module-docs*`, the key itself, which is the module
name by construction (the doc is recorded before `defmodule` opens the namespace, so it has
no writer). Nil for an entry nobody owns: a prelude or root write, which no module load ever
replays and so stays in the registry's own value."
  (cond
    (= reg '*module-docs*) (first kv)
    else (let (w (%registry-writer reg path)) (when w (->string w)))))

(defn- %std-regs-by-module ()
  "Every non-impl registration a std module load performs, grouped by the module whose LOAD
performed it — `[registry-symbol key-path value]` triples.

The registries are enumerable — `(%registry-names)` is every global a `%registry-update!`
has written — and each entry's owner is the module that wrote it, which the kernel journals
at the write (KI-136). Ownership used to be read off the KEY's qualifier, and a key names
its owner only sometimes: `:syntax/comment` in `*faces*` names no module and landed in the
registry's own module's section, so materialising `editor/face` registered the eight faces
`editor/highlight` declares, and a module that resolved them through `editor/face` worked
from the image and not from source. A two-level registry (`*methods*`: `{k1 {k2 v}}`) is
attributed per inner entry when its outer key has no writer."
  (fold (%registry-names)
    {}
    (fn (acc reg)
      (let (v (if (bound? reg) (reflect/eval reg) nil))
        (if (or (contains? %std-regs-skip reg) (not (map? v)))
          acc
          (fold (%map-pairs v)
            acc
            (fn (a kv)
              (let ([k1 v1] kv
                    m (%reg-owner reg [k1] kv))
                (cond
                  m (%add-reg a m [reg [k1] v1])
                  (map? v1)
                    (fold (%map-pairs v1)
                      a
                      (fn (a2 kv2)
                        (let ([k2 v2] kv2
                              m2 (%reg-owner reg [k1 k2] kv2))
                          (if m2 (%add-reg a2 m2 [reg [k1 k2] v2]) a2))))
                  else a)))))))))

(defn- %prune-attributed-registrations! ()
  "Remove from the live registries every entry some module's load wrote, so the values
the image snapshots hold only what NO module load replays — the prelude's and the root's
writes. Each module's own entries come back when it materialises (`%replay-std-regs!`) or
when its source loads, so a value that still carried them would double the ones of the
registry's own module and smuggle in every other module's (KI-136). Called inside an
`%isolate` by `build`, so the running session keeps every registration it had."
  (doseq (kv (%map-pairs (%std-regs-by-module)))
    (doseq (t (second kv))
      (%registry-update! (get t 0) :dissoc (get t 1) nil))))

(defn registrations-by-module ()
  "Every live non-impl registration, grouped by the module that OWNS it: module name →
vector of `[registry-symbol key-path value]` triples (the grouping the stdlib image is
built from, see `%std-regs-by-module`). Public so the PROJECT image can ask the same
question at write time: a registration whose owner is a module the project image does not
carry must not travel in it (KI-89)."
  (%std-regs-by-module))

(defn- prune (dir keep)
  "Delete all but the `max-keep` most recently modified `std-image-*.bin` under `dir`,
never touching `keep`. Returns how many were removed.

Bounded by COUNT rather than by age, for the reason the prelude boot cache learned the hard
way (`prelude_image_prune`): the name carries `system/stdlib-id`, a content hash, so **every edit
to any baked-in `.blsp` mints a new ~2 MB file**. On a machine that is editing the standard
library — the only machine that builds these — nothing is ever old enough for an age rule to
catch, and measured 2026-08-27 this directory held **35 images, 74 MB**, all of them from that
day. Dropping a live one is harmless: its binary rebuilds the image, or loads from source."
  (let (max-keep 4
        mine (seq/filter (file/ls dir)
               (fn (e)
                 (and (string/starts-with? e "std-image-")
                   (string/ends-with? e ".bin")
                   (not (= (path/join dir e) keep)))))
        ;; newest first, so everything past the cap is the tail
        newest (sort-by mine (fn (e) (- 0 (or (file/mtime (path/join dir e)) 0))))
        doomed (drop newest max-keep))
    ;; check-allow :discarded-catch — image-cache housekeeping; a module that will not load stays out of the image (the ADR-280 differential catches it)
    (doseq (e doomed)
      (check-allow :discarded-catch (try (file/rm (path/join dir e)) (catch _ nil))))
    (count doomed)))

(defn %std-impls-by-module ()
  "The live ability registrations, grouped by the module that declared each: module name →
vector of `[ability op key f from]`, the exact argument list `%register-impl` takes.

`*impl-from*` maps `[ability op key]` → the declaring namespace, which is what makes
per-module attribution exact — there is no need to guess from the ability's or the id's
owner. A registration whose `from` is nil came from the root/REPL and belongs to no module;
it is dropped, since nothing materialises it back."
  (fold (%map-pairs *impl-from*)
    {}
    (fn (acc kv)
      (let ([prov from] kv
            [aname op key] prov
            f (get (get *impls* [aname op]) key))
        (if (or (nil? from) (nil? f))
          acc
          (let (mn (->string from))
            (%map-assoc acc mn (append (or (%map-get acc mn nil) []) [[aname op key f from]]))))))))

(defn build (&optional modules)
  "Build (or rebuild) this binary's stdlib image and return `[path entry-count]`, or nil
when there is no cache directory. `modules` defaults to every baked-in module.

A binding is attributed to the module that DEFINES it, by two different routes:

  - by PREFIX — `format/…` belongs to `format`, which is exact and needs no probing;
  - by PROBE, for the globals a module defines at ROOT and so carries no prefix
    (`*1`/`*2`/`*3` from `repl`, `*lineedit-keymap*` from the line editor,
    `*config-…*` from the project tooling) — 52 names in all.

Root globals cannot be attributed from a plain sequential load: whichever module pulls a
dependency in FIRST is credited with everything that dependency defined, so
`*lineedit-keymap*` landed in `repl`'s section and `(require 'editor/lineedit)` restored
the module without it. So each module is probed inside `%isolate` for what it introduces
ON ITS OWN, and a root global goes to the SMALLEST such set containing it — the module
that defines it, never one that merely depends on that module. All 95 probes cost ~0.7 s,
paid once per build. A root global no probe claims belongs to the prelude and is skipped,
since the prelude is always present."
  (let (path (image-path))
    (when path
      (let (dir (path/dirname path)
            _ (when (not (file/dir? dir)) (file/mkdir dir))
            ;; Drop older images before writing this one — see `prune`.
            _ (prune dir path)
            names (or modules (reflect/builtin-modules))
            probed (fold names
                     {}
                     (fn (acc m)
                       (%map-assoc acc
                         (->string m)
                         ;; `-discard-loads`: this probe exists to learn what `m` introduces
                         ;; and then UNDO the load, so the next probe starts clean. A plain
                         ;; `%isolate` keeps a module load (KI-134, ADR-339) — which is right
                         ;; for a test and would credit every later probe with this one's
                         ;; globals here.
                         (%isolate-discard-loads
                           (fn ()
                             (let (before (into #{} (reflect/global-names))
                                   ;; check-allow :discarded-catch — image-cache housekeeping; a module that will not load stays out of the image (the ADR-280 differential catches it)
                                   _ (check-allow :discarded-catch
                                       (try (require-one m) (catch _ nil))))
                               (into #{}
                                 (seq/filter (reflect/global-names)
                                   (fn (s) (not (contains? before s)))))))))))
            ;; now load them for real, so the globals being imaged are live in THIS heap
            ;; check-allow :discarded-catch — image-cache housekeeping; a module that will not load stays out of the image (the ADR-280 differential catches it)
            _ (doseq (m names) (check-allow :discarded-catch (try (require-one m) (catch _ nil))))
            ;; The edges every restored module needs replayed, held in a ROOT global so the
            ;; section that carries them belongs to no module — named `stdimage/…` it made
            ;; `stdimage` look already-loaded at boot, and its source then never loaded.
            _ (%set-std-require-edges! *require-edges*)
            ;; …and the ability registrations, partitioned by the module that DECLARED each
            ;; (`*impl-from*`'s tag), so a materialised module replays its own and only its
            ;; own. An `impl` form is a top-level CALL: materialising defines bindings and
            ;; evaluates nothing, so without this a restored `http` is bound but not
            ;; dispatchable, and the failure surfaces at `(send-response r)`, not at load.
            _ (%set-std-impls! (%std-impls-by-module))
            _ (%set-std-regs! (%std-regs-by-module))
            roots (seq/filter (reflect/global-names)
                    (fn (s) (not (prefixed-by-any? (->string s) names))))
            owner-of (fold roots
                       {}
                       (fn (acc g)
                         (let (best (fold names
                                      nil
                                      (fn (winner m)
                                        (let (probe (%map-get probed (->string m) nil))
                                          (if (and probe
                                                (contains? probe g)
                                                (or (nil? winner)
                                                  (< (count probe) (second winner))))
                                            [m (count probe)]
                                            winner)))))
                           (if best (%map-assoc acc g (->string (first best))) acc))))
            ;; KI-112. A root global no probe claimed is dropped from the image, and the
            ;; probe claims nothing for a module this process had ALREADY loaded when it ran
            ;; (`require-one` is a no-op then, and the diff sees no introductions). That is
            ;; how `nest stdimage`, dispatched from `std/tool/nest.blsp` — whose load pulls the
            ;; toolchain in — wrote an image with none of `project`'s 31 root globals, and
            ;; every later `nest check` died on an unbound `*ns-package*`. A root the PRELUDE
            ;; binds (its own definitions, the kernel's natives, the registries it seeds) is
            ;; always present and needs no section; any other unowned root is a std module's
            ;; that the probe missed. Refuse — a missing image costs one source boot, a wrong
            ;; one costs a day.
            ;; Only the FULL build can judge: with an explicit `modules` subset, a root may
            ;; belong to a module outside it and has no section by design; and only names
            ;; with no prefix at all — `roots` also holds the prefixed globals of modules
            ;; outside `names`, which were always the prelude's business here.
            orphans (if modules
                      (list)
                      (seq/filter roots
                        (fn (g)
                          (and (not (includes? (->string g) "/"))
                            (nil? (%map-get owner-of g nil))
                            (not (%prelude-global? g))))))
            _ (when (not (empty? orphans))
                (error "stdimage/build: "
                  (count orphans)
                  " root global(s) belong to no module — a std module was already loaded "
                  "when the probe ran, so its root globals cannot be attributed: "
                  (string/join (sort (map orphans ->string)) " ")
                  ". Build from a fresh process (`nest stdimage`); nothing was written."))
            sections (append [["%std-edges" ['*std-require-edges*]]
                               ["%std-impls" ['*std-impls*]]
                               ["%std-regs" ['*std-regs*]]]
                       (seq/keep names
                         (fn (m)
                           (let (mn (->string m)
                                 pfx (str mn "/")
                                 owned (seq/filter (reflect/global-names)
                                         (fn (s) (string/starts-with? (->string s) pfx)))
                                 mine (seq/filter roots (fn (g) (= (%map-get owner-of g nil) mn)))
                                 syms (apply vector (append owned mine)))
                             ;; A module contributing nothing would image as materialisable-but-empty,
                             ;; and a later require would restore no bindings rather than fall back.
                             (when (> (count syms) 0) [mn syms]))))))
        ;; Written from a scope in which every module-owned registration is pruned, so a
        ;; registry's snapshot holds only what no load replays (KI-136); the `%isolate`
        ;; puts them back once the file is on disk.
        [path
          (%isolate (fn ()
                      (%prune-attributed-registrations!)
                      (%image-write path sections (system/stdlib-id))))]))))

(defn install ()
  "Install this binary's stdlib image as an additional feature source, if one exists and is
current. Returns the section count, or nil on a miss (absent, stale, unreadable) — in which
case `require` keeps loading stdlib modules from source exactly as before.

The body is the prelude's `%std-image-install`, for the reason `image-path` records. Note
what calling it from HERE can and cannot do: requiring this module has already loaded its
dependency tree from source, so an install at this point serves only modules not yet
touched. The boot install (`BROOD_STDIMAGE=1`, the last line of the prelude) is the one that
serves everything."
  (%std-image-install))

(defn status ()
  "Why this binary is, or is not, using a stdlib image — as
`{:state :live|:absent|:stale|:no-cache :installed <n>|nil :want <id> :path <path> :sections <n> :others [<id>…]}`.

**`:installed` and `:state` answer different questions, and confusing them has cost real
time.** `:state` reads what is on DISK NOW; `:installed` is how many sections THIS process
actually materialised at boot, or nil if it ran from source. They disagree whenever anything
writes an image mid-command — which `nest` does on *every* command after a `std/` edit, so
the very run that triggers the rebuild loads from source while `:state` already says `:live`.
They also disagree under `BROOD_NO_STDIMAGE=1`, where a perfectly good image is on disk and
deliberately unused. When you want to know what a measurement or a test run actually did,
read `:installed`.

`%std-image-install` answers `nil` for **absent**, **stale** and **unreadable** alike, and
that single silence is the most expensive thing about this feature. Every wrong measurement
in KI-72's history came from it: the id carries the git sha and a hash of every baked-in
`.blsp`, so a commit — or somebody else editing `std/` while your loop runs — makes the
image stale, the install misses, and the arm you believe is measuring the image is quietly
measuring source. That happened three times in one session, once inside the differential
test written to catch exactly this.

`:stale` is the answer worth having: it reports the id this binary WANTS beside the ids that
are actually on disk, so `built for 7dc4da8e, running fb7f000f` reads off the two directly
instead of being inferred from a run that looked wrong."
  (let (want (system/stdlib-id)
        path (image-path))
    (if (nil? path)
      ;; Two different nils: a build with the image compiled out, and a machine with no
      ;; cache directory. Reporting both as `:no-cache` would send a reader looking for a
      ;; directory that was never going to be consulted.
      {:state (if (%build-stdimage?) :no-cache :disabled)
       :installed (%std-image-installed)
       :want want
       :path nil
       :sections 0
       :others []}
      (let (dir (path/dirname path)
            present (if (file/dir? dir)
                      (seq/filter (file/list-files dir)
                        (fn (e) (string/starts-with? e "std-image-")))
                      [])
            ;; The id sits between the `std-image-` prefix and the `.bin` suffix.
            ids (apply vector
                  (map present (fn (e) (string/substring e 10 (- (string/length e) 4)))))
            idx (%image-index path want)
            inst (%std-image-installed)
            sections (if (nil? idx) nil (count idx)))
        (cond
          (not (nil? sections))
            {:state :live :installed inst :want want :path path :sections sections :others ids}
          (file/exists? path)
            {:state :unreadable :installed inst :want want :path path :sections 0 :others ids}
          (empty? ids)
            {:state :absent :installed inst :want want :path path :sections 0 :others ids}
          else {:state :stale :installed inst :want want :path path :sections 0 :others ids})))))

(defn ensure-built ()
  "Build this binary's stdlib image if there is not already a CURRENT one on disk, and say
which happened: `:built`, `:present`, or nil when there is no cache directory.

This is the \"make it standard\" entry point, and it is deliberately not `ensure`: by the time
any module can call this, the prelude has already installed whatever image existed at boot, so
re-installing would register a second source for the same file. What is left worth doing is
the half a running process cannot do for itself — writing the image the NEXT process will boot
with.

`nest` calls it, because a project tool can afford ~1 s once per stdlib change and every later
`brood` and `nest` invocation on that machine reads the result: the image is keyed on
`system/stdlib-id`, the same for every binary built from one tree."
  (let (path (image-path))
    (when path
      ;; check-allow :discarded-catch — image-cache housekeeping; a module that will not load stays out of the image (the ADR-280 differential catches it)
      (if (check-allow :discarded-catch
            (try (not (nil? (%image-index path (system/stdlib-id)))) (catch _ false)))
        :present (do (build) :built)))))

(defn ensure ()
  "Install the stdlib image, building it first if this binary has none yet. Returns the
section count. The build cost is paid once per binary; every later process just indexes."
  (or (install)
    (do (build) (install))))
