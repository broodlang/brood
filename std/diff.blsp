;; std/diff.blsp — LCS-based sequence diff.
;;
;; Computes the shortest edit script (SES) between two sequences using a
;; classic O(m*n) dynamic-programming LCS table, then backtracks to produce
;; a list of `[:keep v]`, `[:delete v]`, and `[:insert v]` operations.
;; Suitable for diffing small-to-medium sequences (up to a few hundred items).

(defmodule diff
  "LCS-based diff: compute the shortest edit script between two sequences.

    (diff/lines \"hello\\nworld\" \"hello\\nearth\")
    ;; => ([:keep \"hello\"] [:delete \"world\"] [:insert \"earth\"])

    (diff/seq [1 2 3 4] [1 3 4 5])
    ;; => ([:keep 1] [:delete 2] [:keep 3] [:keep 4] [:insert 5])

    (diff/summary ops)
    ;; => {:keeps 2 :deletes 1 :inserts 1}")

;; ---- LCS table --------------------------------------------------------------
;;
;; table is a vector of (m+1) vectors, each of length (n+1).
;; table[i][j] = LCS length of a[0..i-1] and b[0..j-1].

(defn- diff-zero-row (n:int -> vector)
  (into [] (map (range (+ n 1)) (fn (_) 0))))

(defn- diff-build-table (a b m n)
  "Build the full LCS DP table; returns a vector of (m+1) rows."
  (into [] (diff-build-rows a b m n (diff-zero-row n) (list (diff-zero-row n)) 1)))

(defn- diff-build-rows (a b m n prev acc i)
  (if (> i m)
    (reverse acc)
    (let (ai (nth a (- i 1))
          row (diff-build-row ai b n prev 1 '(0)))
      (diff-build-rows a b m n row (cons row acc) (+ i 1)))))

(defn- diff-build-row (ai b n prev j acc)
  ;; acc is built right-to-left; (first acc) is the previously computed cell.
  (if (> j n)
    (into [] (reverse acc))
    (let (bj (nth b (- j 1))
          pj-1 (nth prev (- j 1))
          pj (nth prev j)
          cj-1 (first acc)
          val (if (= ai bj) (+ pj-1 1) (math/max cj-1 pj)))
      (diff-build-row ai b n prev (+ j 1) (cons val acc)))))

;; ---- backtracking -----------------------------------------------------------

(defn- diff-backtrack (table a b i j acc)
  "Walk the LCS table from (i,j) to (0,0), accumulating ops in reverse order."
  (cond
    (and (= i 0) (= j 0)) acc
    (= i 0) (diff-backtrack table a b 0 (- j 1) (cons [:insert (nth b (- j 1))] acc))
    (= j 0) (diff-backtrack table a b (- i 1) 0 (cons [:delete (nth a (- i 1))] acc))
    (= (nth a (- i 1)) (nth b (- j 1)))
      (diff-backtrack table
        a
        b
        (- i 1)
        (- j 1)
        (cons [:keep (nth a (- i 1))] acc))
    (>= (nth (nth table (- i 1)) j) (nth (nth table i) (- j 1)))
      (diff-backtrack table
        a
        b
        (- i 1)
        j
        (cons [:delete (nth a (- i 1))]
          acc))
    else (diff-backtrack table a b i (- j 1) (cons [:insert (nth b (- j 1))] acc))))

;; ---- public API -------------------------------------------------------------

(defn seq (a b)
  "Diff two sequences (lists or vectors) by value equality. Returns a list of
`[:keep v]`, `[:delete v]`, and `[:insert v]` operations that transform `a` into `b`.

    (diff/seq [1 2 3] [1 3])   ;=> ([:keep 1] [:delete 2] [:keep 3])"
  (let (av (into [] (/seq a))
        bv (into [] (/seq b))
        m (count av)
        n (count bv))
    (cond
      (= m 0) (map bv (fn (v) [:insert v]))
      (= n 0) (map av (fn (v) [:delete v]))
      else
        (let (table (diff-build-table av bv m n))
          (diff-backtrack table av bv m n nil)))))

(defn lines (a:string b:string -> any)
  "Diff two strings line-by-line. `a` and `b` are split on `\\n` first.
Returns a list of `[:keep line]`, `[:delete line]`, `[:insert line]` ops.

    (count (diff/lines \"a\nb\" \"a\nc\"))   ;=> 3"
  (seq (string/split a "\n") (string/split b "\n")))

;; ---- the line diff of two whole texts, native (ADR-468) ---------------------
;; `seq` above is an O(m·n) table: right for a few hundred items, wrong for a source file,
;; which is why a change gutter used to shell out to `git diff --no-index` per idle beat.
;; `line-hunks` is the kernel's Myers diff with git's indent-heuristic compaction — the
;; same hunks `git diff --unified=0` prints, 0-based — and `line-status` reads them the way
;; a change gutter does.

(defn line-hunks (old new)
  "The line diff of `old` and `new` (strings or ropes) as git's zero-context hunks, in
order: `[old-start old-count new-start new-count]`, 0-based. Lines `old-start..+old-count`
became lines `new-start..+new-count`; a count of 0 is a pure insertion or deletion whose
start is the line it sits before. A final newline ends the last line rather than starting
an empty one, so a lone trailing-newline difference is no change. Placed where `git diff`
places it: a line added in a run of equal ones (closing brackets, blank lines) is marked
where a reader sees it added.

    (diff/line-hunks \"a\\nb\\nc\\n\" \"a\\nx\\nc\\n\")   ;=> [[1 1 1 1]]
    (diff/line-hunks \"a\\nc\" \"a\\nb\\nc\\n\")   ;=> [[1 0 1 1]]"
  (%diff-line-hunks old new))

(defn hunks-status (hunks)
  "The change-gutter reading of zero-context `hunks` (`line-hunks`' shape,
`[old-start old-count new-start new-count]`, 0-based): a `{new-line -> :added | :modified |
:deleted}` map. In a hunk the first lines that replace removed ones are `:modified` and the
rest `:added`; a pure deletion marks the line that follows it `:deleted`. Diff-hl's reading
of a hunk, shared by a diff of two texts (`line-status`) and a parsed one (`hunk-changes`).

    (diff/hunks-status [[1 1 1 2] [4 1 5 0]])   ;=> {1 :modified 2 :added 5 :deleted}"
  (fold hunks
    {}
    (fn (status hunk)
      (let ([_ old-count new-start new-count] hunk
            modified (math/min old-count new-count))
        (if (= new-count 0)
          (assoc status new-start :deleted)
          (fold (range new-count)
            status
            (fn (acc j) (assoc acc (+ new-start j) (if (< j modified) :modified :added)))))))))

(defn line-status (old new)
  "What happened to each line of `new` against `old`, as a change gutter shows it: the
`hunks-status` of their `line-hunks`.

    (diff/line-status \"a\\nb\\nc\\n\" \"a\\nx\\ny\\nc\\n\")   ;=> {1 :modified 2 :added}
    (diff/line-status \"a\\nb\\nc\\n\" \"a\\nc\\n\")   ;=> {1 :deleted}"
  (hunks-status (line-hunks old new)))

;; ---- following a line through an edit (ADR-499) -----------------------------
;; A mark kept across a reload — point after a file changed on disk, a note anchored to a
;; form, the line a time machine shows in the next revision — is a line of the OLD text
;; that must be found in the NEW one. Counting lines is wrong as soon as anything above it
;; was added or removed; the line diff says exactly where each surviving line went.

(defn- hunks-map-line (hunks line)
  "0-based `line` of the old side followed through zero-context `hunks`: shifted by what
the hunks above it added and removed; inside a hunk, the replacing line at the same offset
(the last one when fewer replaced it), or for a pure deletion the line that followed it."
  (letrec (walk (fn (remaining delta)
                  (if (empty? remaining)
                    (+ line delta)
                    (let ([old-start old-count new-start new-count] (first remaining))
                      (cond
                        (< line old-start) (+ line delta)
                        (< line (+ old-start old-count))
                          (+ new-start (math/min (- line old-start) (math/max 0 (dec new-count))))
                        else (walk (rest remaining) (+ delta (- new-count old-count))))))))
    (walk hunks 0)))

(defn- last-line (text)
  "The 0-based index of the last line of `text` (a string or rope) a cursor can be on: the
empty one after a final newline counts, so the end of a text maps to the end of the next."
  (dec (if (string? text) (count (string/split text "\n")) (text/line-count text))))

(defn map-lines (old new lines)
  "Each 0-based line of `lines` in `old` (a string or rope), followed into `new`: one line
diff serves every position. An unchanged line lands exactly where it went, however much
was added or removed above it. A changed line lands on the line that replaced it at the
same offset in its block (the block's last line when fewer replaced it); a deleted line on
the line that followed the deletion. Always a line of `new` a cursor can be on — clamped to
its last, the empty line after a final newline included — so a caller can put point there
without checking, and the end of `old` maps to the end of `new`.

    (diff/map-lines \"a\\nb\\nc\\n\" \"x\\na\\nb\\nc\\n\" [0 2])   ;=> [1 3]"
  (let (hunks (line-hunks old new)
        top (last-line new))
    (into [] (map lines (fn (line) (math/max 0 (math/min top (hunks-map-line hunks line))))))))

(defn map-line (old new line)
  "The 0-based line of `new` that line `line` of `old` became — `map-lines` for one line.

    (diff/map-line \"a\\nb\\nc\\n\" \"x\\na\\nb\\nc\\n\" 2)   ;=> 3
    (diff/map-line \"a\\nb\\nc\\n\" \"a\\nB\\nc\\n\" 1)   ;=> 1
    (diff/map-line \"a\\nb\\nc\\n\" \"a\\nc\\n\" 1)   ;=> 1"
  (first (map-lines old new [line])))

;; ---- utilities --------------------------------------------------------------

(defn summary (ops:seqable -> (or map vector))
  "Count `[:keep]`, `[:delete]`, and `[:insert]` operations in a diff result.
Returns `{:keeps n :deletes n :inserts n}`.

    (diff/summary (diff/lines \"a\\nb\\nc\" \"a\\nx\\nc\"))   ;=> {:keeps 2 :deletes 1 :inserts 1}"
  (fold ops
    {:keeps 0 :deletes 0 :inserts 0}
    (fn (acc op)
      (let (tag (first op))
        (cond
          (= tag :keep) (assoc acc :keeps (+ (get acc :keeps) 1))
          (= tag :delete) (assoc acc :deletes (+ (get acc :deletes) 1))
          else (assoc acc :inserts (+ (get acc :inserts) 1)))))))

(defn patch (a ops)
  "Apply diff `ops` to sequence `a`, producing sequence `b`. `a` is provided
only for verification (`:delete` and `:keep` ops are expected to match `a` in
order); the output is built from `:keep` and `:insert` ops.

    (diff/patch [1 2 3] (diff/seq [1 2 3] [1 3]))   ;=> (1 3)"
  (map (seq/filter ops (fn (op) (not (= (first op) :delete)))) second))

;; ---- reading a unified diff -------------------------------------------------
;; The other direction: git (or `diff -u`) PRODUCES the text, and a tool wants to act on
;; it — stage one hunk, stage three lines of a hunk, jump from a `+` line to the line of
;; the file it became. Each of those needs the same three things: the diff parsed into
;; files and hunks with their line numbers, a hunk turned back into a patch `git apply`
;; accepts, and a hunk CUT DOWN to a chosen run of its lines with its counts recomputed.
;; Magit's line-level staging is the last of those, and it is a pure function of the hunk.
;;
;; A hunk ends when its counts are used up, not at the next line that looks like a
;; header: `--- a/x` is a legal REMOVED line (the text `-- a/x` deleted), and only the
;; counts can tell the two apart.

(defn- header-int (x:any default:int -> int)
  "`x` as an int — a string is read, an int passes — or `default` when it is neither."
  (let (n (if (string? x) (string/->number x) x)) (if (int? n) n default)))

(defn- header-range (s)
  "`[start count]` from a hunk header range like `-12,5` or `+3` (count 1 when absent)."
  (let (body (string/substring s 1 (string/length s))
        parts (string/split body ","))
    [(header-int (first parts) 0)
      (if (> (count parts) 1) (header-int (second parts) 0) 1)]))

(defn hunk-header (line:string -> any)
  "The numbers of a hunk header line: `{:old-start :old-count :new-start :new-count
:context}` (the text after the closing `@@`, usually the enclosing function), or nil when
`line` is not a two-way hunk header.

    (:new-start (diff/hunk-header \"@@ -10,3 +12,4 @@ defn f\"))   ;=> 12"
  (if (not (string/starts-with? line "@@ -"))
    nil
    (let (parts (string/split line " "))
      (if (or (< (count parts) 4) (not (= (nth parts 3) "@@")))
        nil
        (let ([os oc] (header-range (nth parts 1))
              [ns nc] (header-range (nth parts 2))
              close (index-of (string/substring line 2 (string/length line)) "@@"))
          {:old-start os
           :old-count oc
           :new-start ns
           :new-count nc
           :context (string/trim (string/substring line (+ close 4) (string/length line)))})))))

(defn- strip-prefix-path (s)
  "A path from a `--- a/x` / `+++ b/x` line: the `a/` or `b/` dropped, nil for /dev/null."
  (let (p (string/trimr (string/substring s 4 (string/length s)))
        ;; `diff -u` appends a tab and a timestamp to the path
        tab (index-of p "\t")
        p (if (< tab 0) p (string/substring p 0 tab)))
    (cond
      (= p "/dev/null") nil
      (or (string/starts-with? p "a/") (string/starts-with? p "b/"))
        (string/substring p 2 (string/length p))
      else p)))

(defn- git-header-paths (line)
  "`[old new]` from a `diff --git a/x b/y` line (the split is at ` b/`, so a path with a
space survives when the two sides are equal, which is every case but a rename)."
  (let (body (string/substring line 11 (string/length line))
        i (index-of body " b/"))
    (if (< i 0)
      [nil nil]
      [(string/substring body 0 i) (string/substring body (+ i 3) (string/length body))])))

(defn- close-file (st)
  "The parse state with the file in progress (if any) finished onto `:files`."
  (if (nil? (:file st))
    st
    (assoc st
      :files (cons (assoc (:file st) :hunks (into [] (reverse (:hunks (:file st))))) (:files st))
      :file nil)))

(defn- file-line (st line)
  "Fold a line that is not inside a hunk: a `diff ` line starts a file; `---`/`+++` name
its sides; `@@` opens a hunk; anything else is a header line of the current file. A line
before any file (a commit message above `git show`'s diff) or after a file's last hunk
(the blank a trailing newline leaves) belongs to no file and is dropped — kept, it would
become a header line and corrupt every patch built from that file."
  (let (file (:file st)
        hunks? (and file (not (empty? (:hunks file)))))
    (cond
      (string/starts-with? line "diff ")
        (let ([o n] (if (string/starts-with? line "diff --git ") (git-header-paths line) [nil nil]))
          (assoc (close-file st) :file {:headers [line] :hunks '() :old-path o :new-path n}))
      ;; `---` with no file open, or after a file's hunks with no `diff ` line between: a
      ;; plain `diff -u`, where the next file starts here
      (and (string/starts-with? line "--- ") (or (nil? file) hunks?))
        (assoc (close-file st)
          :file {:headers [line] :hunks '() :old-path (strip-prefix-path line) :new-path nil})
      (nil? file) st
      (string/starts-with? line "--- ")
        (assoc st
          :file
            (assoc file :headers (into (:headers file) [line]) :old-path (strip-prefix-path line)))
      (and (string/starts-with? line "+++ ") (not hunks?))
        (assoc st
          :file
            (assoc file :headers (into (:headers file) [line]) :new-path (strip-prefix-path line)))
      (not (nil? (hunk-header line)))
        (let (h (hunk-header line))
          (assoc st
            :file (assoc file :hunks (cons (assoc h :header line :lines '()) (:hunks file)))
            :old-left (:old-count h)
            :new-left (:new-count h)))
      hunks? st
      else (assoc st :file (assoc file :headers (into (:headers file) [line]))))))

(defn- push-hunk-line (st line old? new?)
  "The parse state with `line` appended to the open hunk, spending its counts."
  (let (file (or (:file st) {:hunks '()})
        h (first (:hunks file)))
    (assoc st
      :file (assoc file :hunks (cons (assoc h :lines (cons line (:lines h))) (rest (:hunks file))))
      :old-left (if old? (dec (:old-left st)) (:old-left st))
      :new-left (if new? (dec (:new-left st)) (:new-left st)))))

(defn- in-hunk? (st)
  "Whether the open hunk still has lines to come."
  (and (:file st) (or (> (:old-left st) 0) (> (:new-left st) 0))))

(defn- parse-line (st line)
  "Fold one line of a unified diff into the parse state."
  (cond
    ;; `\ No newline at end of file` annotates the line before it, whichever side
    (and (string/starts-with? line "\\") (:file st) (not (empty? (:hunks (:file st)))))
      (push-hunk-line st line false false)
    (not (in-hunk? st)) (file-line st line)
    (string/starts-with? line "+") (push-hunk-line st line false true)
    (string/starts-with? line "-") (push-hunk-line st line true false)
    ;; a context line; an EMPTY one is a context line whose trailing space was stripped
    else (push-hunk-line st line true true)))

(defn- finish-hunks (file)
  "A parsed file with each hunk's lines put back in order as a vector."
  (assoc file
    :hunks (into [] (map (:hunks file) (fn (h) (assoc h :lines (into [] (reverse (:lines h)))))))))

(defn parse-unified (text:any -> vector)
  "Parse unified-diff `text` — git's, one file or many, or `diff -u`'s — into a vector of
files `{:old-path :new-path :headers :hunks}`. `:headers` are the lines before the first
hunk (`diff --git`, `index`, `---`, `+++`, mode and rename lines); each hunk is
`{:header :old-start :old-count :new-start :new-count :context :lines}`, `:lines` its
body lines with their ` `/`+`/`-` prefix. A path is nil on the /dev/null side of an added
or deleted file.

    (count (:hunks (first (diff/parse-unified \"--- a/f\\n+++ b/f\\n@@ -1 +1 @@\\n-a\\n+b\\n\"))))   ;=> 1"
  (if (or (nil? text) (= (string/trim text) ""))
    []
    (let (st (fold (string/split text "\n")
               {:files '() :file nil :old-left 0 :new-left 0}
               parse-line))
      (into [] (map (reverse (:files (close-file st))) finish-hunks)))))

;; ---- writing one back -----------------------------------------------------------

(defn hunk-patch (file:map hunk:map -> string)
  "A patch of `hunk` alone: `file`'s header lines, the hunk's header and its lines,
newline-terminated — `git apply` calls a patch whose last line has no newline corrupt.
Hand it to `git apply --cached` to stage the hunk, add `--reverse` to unstage it.

    (diff/hunk-patch {:headers [\"--- a/f\" \"+++ b/f\"]} {:header \"@@ -1 +1 @@\" :lines [\"-a\" \"+b\"]})   ;=> \"--- a/f\\n+++ b/f\\n@@ -1 +1 @@\\n-a\\n+b\\n\""
  (str (string/join (append (:headers file) [(:header hunk)] (:lines hunk)) "\n") "\n"))

(defn- header-line (os oc ns nc context)
  "A hunk header from its four numbers and trailing context."
  (str "@@ -"
    os
    (if (= oc 1) "" (str "," oc))
    " +"
    ns
    (if (= nc 1) "" (str "," nc))
    " @@"
    (if (or (nil? context) (= context "")) "" (str " " context))))

(defn hunk-select (hunk:map from:int to:int &optional (reverse?:any false) -> any)
  "`hunk` cut down to the changes in its body lines `[from, to)` — Magit's line-level
staging. Every change outside the range is neutralised so the patch still applies:
applied FORWARD (staging), an unselected `+` is dropped and an unselected `-` becomes
context; for a patch applied in REVERSE (`reverse?` — unstaging, discarding) the roles
swap, an unselected `-` dropped and an unselected `+` kept as context. The header's
counts are recomputed; nil when the range holds no change at all.

    (:lines (diff/hunk-select {:header \"@@ -1,2 +1,2 @@\" :old-start 1 :new-start 1 :lines [\"-a\" \"-b\" \"+c\"]} 1 3))   ;=> [\" a\" \"-b\" \"+c\"]"
  (let (lines (:lines hunk)
        kept (fold (range (count lines))
               {:out '() :dropped? false :changes 0}
               (fn (acc i)
                 (let (line (nth lines i)
                       tag (if (= line "") " " (string/substring line 0 1))
                       inside? (and (>= i from) (< i to))
                       body (string/substring line
                              (math/min 1 (string/length line))
                              (string/length line)))
                   (cond
                     ;; the no-newline marker follows its line in or out
                     (= tag "\\") (if (:dropped? acc) acc (assoc acc :out (cons line (:out acc))))
                     (= tag " ") (assoc acc :out (cons line (:out acc)) :dropped? false)
                     inside?
                       (assoc acc
                         :out (cons line (:out acc))
                         :dropped? false
                         :changes (inc (:changes acc)))
                     ;; outside the range: the side the patch ADDS is dropped, the side it
                     ;; would REMOVE stays as it is, i.e. as context
                     (= tag (if reverse? "-" "+")) (assoc acc :dropped? true)
                     else (assoc acc :out (cons (str " " body) (:out acc)) :dropped? false)))))
        out (into [] (reverse (:out kept)))
        old-n (count (seq/filter out
                       (fn (l)
                         (or (string/starts-with? l " ") (string/starts-with? l "-") (= l "")))))
        new-n (count (seq/filter out
                       (fn (l)
                         (or (string/starts-with? l " ") (string/starts-with? l "+") (= l ""))))))
    (if (= (:changes kept) 0)
      nil
      (assoc hunk
        :lines out
        :old-count old-n
        :new-count new-n
        :header (header-line (:old-start hunk) old-n (:new-start hunk) new-n (:context hunk))))))

(defn- side-line (hunk i start-key skip-tag)
  "The line number on one side of body line `i`: that side's start plus the lines before
`i` that exist on it (every line but `skip-tag` ones and no-newline markers)."
  (+ (header-int (get hunk start-key) 0)
    (count (seq/filter (take (:lines hunk) i)
             (fn (l) (not (or (string/starts-with? l skip-tag) (string/starts-with? l "\\"))))))))

(defn hunk-new-line (hunk:map i:int -> int)
  "The line of the NEW file that body line `i` of `hunk` is, or sits at — for a removed
line, the line after which it was removed. What a jump from a diff to its file lands on.

    (diff/hunk-new-line {:new-start 10 :lines [\" a\" \"-b\" \"+c\"]} 2)   ;=> 11"
  (side-line hunk i :new-start "-"))

(defn hunk-old-line (hunk:map i:int -> int)
  "The line of the OLD file that body line `i` of `hunk` is, or sits at.

    (diff/hunk-old-line {:old-start 10 :lines [\" a\" \"-b\" \"+c\"]} 1)   ;=> 11"
  (side-line hunk i :old-start "+"))

(defn hunk-changes (hunk:map)
  "The changes inside a parsed unified-diff `hunk` (`parse-unified`'s) as zero-context
hunks, `line-hunks`' shape — `[old-start old-count new-start new-count]`, 0-based, one per
run of `-`/`+` lines between context. What lets a diff git printed be read by everything
written for `line-hunks`: a change gutter is `(hunks-status (mapcat hunks hunk-changes))`.

    (diff/hunk-changes {:old-start 1 :old-count 2 :new-start 1 :new-count 3 :lines [\" a\" \"-b\" \"+B\" \"+C\"]})   ;=> [[1 1 1 2]]
    (diff/hunks-status (diff/hunk-changes {:old-start 3 :old-count 2 :new-start 3 :new-count 1 :lines [\" c\" \"-d\"]}))   ;=> {3 :deleted}"
  (let (start (fn (start-key count-key)
                ;; a side with no lines names the line BEFORE the change, 1-based — which is
                ;; the 0-based line it sits before; otherwise its first line, 1-based
                (let (s (header-int (get hunk start-key) 1))
                  (if (= (header-int (get hunk count-key) 1) 0) s (dec s))))
        flush (fn (state)
                (let ({:keys [out old new removed added]} state)
                  (if (= (+ removed added) 0)
                    state
                    (assoc state
                      :out (conj out [(- old removed) removed (- new added) added])
                      :removed 0
                      :added 0))))
        final (fold (:lines hunk)
                {:out []
                 :old (start :old-start :old-count)
                 :new (start :new-start :new-count)
                 :removed 0
                 :added 0}
                (fn (state line)
                  (cond
                    (string/starts-with? line "\\") state
                    (string/starts-with? line "-")
                      (assoc state :old (inc (:old state)) :removed (inc (:removed state)))
                    (string/starts-with? line "+")
                      (assoc state :new (inc (:new state)) :added (inc (:added state)))
                    else
                      (let (flushed (flush state))
                        (assoc flushed :old (inc (:old flushed)) :new (inc (:new flushed))))))))
    (:out (flush final))))

;; ---- printing a unified diff ------------------------------------------------
;; Two texts as `diff -u` prints them: `---`/`+++` naming the sides, then each run of changes
;; with `:context` unchanged lines around it as a hunk under its `@@ -a,b +c,d @@` header.
;; Hunks whose context would touch or overlap are one hunk, as git prints them. The changes
;; are `line-hunks`', with one adjustment: a last line that ends with no newline is a
;; different line from the same text ending with one, so a newline added or removed at the
;; end is a change, marked `\ No newline at end of file` — `line-hunks` alone calls it none.

(def- no-newline-marker "\\ No newline at end of file")

;; Appended to a last line that has no newline before the texts go to `line-hunks`, so that
;; line compares unequal to the same text with a newline (and equal to itself).
(def- no-newline-sentinel "\u{0}\u{fffe}no-newline")

(defn- text-lines (text:string)
  "`text`'s lines as a vector of `[line newline?]`: a final newline ends the last line rather
than starting an empty one, and only a last line can lack one."
  (if (= text "")
    []
    (let (pieces (into [] (string/split text "\n"))
          ends-with-newline (string/ends-with? text "\n")
          lines (if ends-with-newline (seq/subvec pieces 0 (dec (count pieces))) pieces)
          last-index (dec (count lines)))
      (into []
        (map (range (count lines))
          (fn (i) [(nth lines i) (or ends-with-newline (< i last-index))]))))))

(defn- sentinel-text (text:string)
  (if (or (= text "") (string/ends-with? text "\n")) text (str text no-newline-sentinel "\n")))

;; Zero-context changes, `[old-start old-count new-start new-count]` 0-based, grouped into the
;; hunks `context` lines of context make of them: two changes share a hunk when no more than
;; 2·context unchanged lines lie between them.
(defn- group-changes (changes context:int)
  (reverse (fold changes
             '()
             (fn (groups change)
               (let (previous (first (first groups)))
                 (if (and previous
                       (<= (- (first change) (+ (first previous) (second previous))) (* 2 context)))
                   (cons (cons change (first groups)) (rest groups))
                   (cons (list change) groups)))))))

;; The body lines of one side's line `i` as printed with `prefix`, the no-newline marker
;; after it when it has none.
(defn- printed (prefix entry)
  (let ([line newline?] entry)
    (if newline? [(str prefix line)] [(str prefix line) no-newline-marker])))

(defn- context-lines (old from:int to:int)
  (mapcat (seq/subvec old from to) (fn (entry) (printed " " entry))))

;; One change printed after the context lines from `at` up to it.
(defn- change-lines (old new at:int old-at:int old-count:int new-at:int new-count:int)
  (append (context-lines old at old-at)
    (mapcat (seq/subvec old old-at (+ old-at old-count)) (fn (entry) (printed "-" entry)))
    (mapcat (seq/subvec new new-at (+ new-at new-count)) (fn (entry) (printed "+" entry)))))

(defn- hunk-body (old new changes previous-end:int previous-count:int end:int lines)
  (if (empty? changes)
    (into lines (context-lines old (+ previous-end previous-count) end))
    (let ([old-at old-count new-at new-count] (first changes))
      (hunk-body old
        new
        (rest changes)
        old-at
        old-count
        end
        (into lines
          (change-lines old new (+ previous-end previous-count) old-at old-count new-at new-count))))))

;; A hunk over `changes` (in order): `first-old`/`first-new` where the first starts,
;; the last one's starts and counts, widened by `context` and clamped to the texts.
(defn- hunk-of
  (old new
    changes context:int first-old:int first-new:int last-start:int last-old-count:int
    last-new-start:int last-new-count:int)
  (let (last-old (+ last-start last-old-count)
        last-new (+ last-new-start last-new-count)
        widened-start (- first-old context)
        old-start (if (< widened-start 0) 0 widened-start)
        widened-end (+ last-old context)
        old-end (if (> widened-end (count old)) (count old) widened-end)
        new-start (- first-new (- first-old old-start))
        new-end (+ last-new (- old-end last-old))
        old-count (- old-end old-start)
        new-count (- new-end new-start))
    (cons (header-line (if (= old-count 0) old-start (inc old-start))
            old-count
            (if (= new-count 0) new-start (inc new-start))
            new-count
            nil)
      (hunk-body old new changes old-start 0 old-end []))))

(defn- hunk-lines (old new group context:int)
  (let (changes (reverse group)
        [first-old _ first-new _] (first changes)
        [last-old last-old-count last-new last-new-count] (last changes))
    (hunk-of old
      new changes context first-old first-new last-old last-old-count last-new last-new-count)))

(defn unified "The unified diff that turns text `a` into text `b`, as `diff -u` prints it: `---` and
`+++` lines naming the sides, then each change with `:context` unchanged lines around it
(default 3) under its `@@ -start,count +start,count @@` header — a side with no lines counts
0 from the line before it (`-0,0` for a file that was empty), changes whose context would
meet share one hunk, and a last line with no newline is followed by `\\ No newline at end of
file`. `options`: `:context`, `:from-label` (default `\"a\"`) and `:to-label` (default
`\"b\"`). The empty string when the texts are equal. `parse-unified` reads it back and
`apply-unified` applies it.

    (diff/unified \"a\\nb\\nc\\n\" \"a\\nx\\nc\\n\")   ;=> \"--- a\\n+++ b\\n@@ -1,3 +1,3 @@\\n a\\n-b\\n+x\\n c\\n\"
    (diff/unified \"a\\nb\\nc\\n\" \"a\\nx\\nc\\n\" {:context 0 :from-label \"old\" :to-label \"new\"})   ;=> \"--- old\\n+++ new\\n@@ -2 +2 @@\\n-b\\n+x\\n\"
    (diff/unified \"\" \"a\\n\")   ;=> \"--- a\\n+++ b\\n@@ -0,0 +1 @@\\n+a\\n\"
    (diff/unified \"a\" \"a\\n\")   ;=> \"--- a\\n+++ b\\n@@ -1 +1 @@\\n-a\\n\\\\ No newline at end of file\\n+a\\n\"
    (diff/unified \"same\\n\" \"same\\n\")   ;=> \"\""
  ((a b) (unified a b {}))
  ((a b options) (let (context (get options :context 3)
                       old (text-lines a)
                       new (text-lines b)
                       changes (line-hunks (sentinel-text a) (sentinel-text b)))
                   (if (empty? changes)
                     ""
                     (str (string/join (append [(str "--- " (get options :from-label "a"))
                                                 (str "+++ " (get options :to-label "b"))]
                                         (mapcat (group-changes changes context)
                                           (fn (group) (hunk-lines old new group context))))
                            "\n")
                       "\n")))))

;; ---- applying one -----------------------------------------------------------

;; A hunk's body applied at the old text's `index`: the lines it emits as `[line newline?]`, a
;; no-newline marker taking the newline off the line emitted just before it (nothing, after a
;; removed line), and the old index past the hunk. Raises on a line that does not match.
(defn- apply-hunk (old index hunk)
  (fold (:lines hunk)
    {:out [] :at index :last nil}
    (fn (state line)
      (let (tag (if (= line "") " " (string/substring line 0 1))
            body (string/substring line (math/min 1 (string/length line)) (string/length line))
            expect (fn ()
                     (let (entry (nth old (:at state)))
                       (when (or (nil? entry) (not (= (first entry) body)))
                         (error "diff/apply-unified: the text does not match the hunk at line "
                           (inc (:at state))
                           ": "
                           line)))))
        (cond
          (= tag "\\")
            (if (= (:last state) :emitted)
              (assoc state
                :out
                  (assoc (:out state)
                    (dec (count (:out state))) [(first (last (:out state))) false]))
              state)
          (= tag "+") (assoc state :out (conj (:out state) [body true]) :last :emitted)
          (= tag "-") (do (expect) (assoc state :at (inc (:at state)) :last :removed))
          else
            (do
              (expect)
              (assoc state
                :out (conj (:out state) [body true])
                :at (inc (:at state))
                :last :emitted)))))))

(defn apply-unified (text:string patch-text:string -> string)
  "`text` with the unified diff `patch-text` (one file's, as `unified` prints it or `diff -u`
and git do) applied, its no-newline markers honoured. Raises when a context or removed line
does not match `text`.

    (diff/apply-unified \"a\\nb\\nc\\n\" (diff/unified \"a\\nb\\nc\\n\" \"a\\nx\\nc\"))   ;=> \"a\\nx\\nc\"
    (diff/apply-unified \"same\" \"\")   ;=> \"same\""
  (let (old (text-lines text)
        hunks (mapcat (parse-unified patch-text) :hunks)
        applied (fold hunks
                  {:out [] :at 0}
                  (fn (state hunk)
                    (let (start (header-int (:old-start hunk) 0)
                          index (if (= (header-int (:old-count hunk) 1) 0) start (dec start))
                          copied (into (:out state) (seq/subvec old (:at state) index))
                          result (apply-hunk old index hunk))
                      {:out (into copied (:out result)) :at (:at result)})))
        lines (into (:out applied) (seq/subvec old (:at applied) (count old))))
    (string/join (map lines (fn ([line newline?]) (if newline? (str line "\n") line))) "")))
