(defmodule docsite
  "Render a documentation model to a browsable HTML site — the shared renderer behind
  `nest docs` and hive's per-package doc builds. Pure `model -> HTML string`: it takes
  data and returns markup, so a trusted local build (introspection) and an untrusted
  registry build (parse-don't-eval) can feed it the same shape and get the same site.

  The model is a map:

      {:name    \"my-project\"        ; project / package name
       :version \"0.1.0\"             ; optional
       :modules [{:module \"my/mod\"  ; module (namespace) name
                  :doc    \"…\"        ; moduledoc, or nil
                  :defs   [{:name  \"foo\"          ; bare definition name (for anchors)
                            :sig   \"(foo x y)\"     ; rendered signature
                            :doc   \"…\"             ; docstring, or nil
                            :macro false           ; true for defmacro
                            :type  \"(int -> int)\"  ; type-arrow, or nil
                            :source [\"f.blsp\" 3 1]}]}]}  ; [file line col], or nil

  Every field except `:module`/`:sig` may be nil; the renderer degrades gracefully, so
  a thin parse-only model (no `:type`/`:source`) renders fine. `render` returns a
  self-contained HTML string: with `:wrap? true` (the default) a whole `<html>` page
  with inlined CSS + a client-side filter; with `:wrap? false` just the content
  fragment (sidebar + main), for embedding in a host layout (e.g. hive's themed page).

  Docstrings are treated as light Markdown — blank-line paragraphs and inline `code`
  spans — and every value is HTML-escaped, so a docstring can never inject markup."
  (:use math))

;; ---- escaping + inline prose ------------------------------------------------

(defn escape (raw)
  "HTML-escape `&`, `<`, `>` in `raw` (coerced to a string). `&` must go first."
  (-> (str raw)
    (string/replace "&" "&amp;")
    (string/replace "<" "&lt;")
    (string/replace ">" "&gt;")))

(defn- inline
  ;; One paragraph as HTML: split on backticks, wrap the odd (inside-a-pair) segments
  ;; in <code>, escape every segment. An unbalanced backtick just leaves a stray token.
  (para)
  (let (parts (string/split para "`"))
    (apply str
      (map (fn (pair)
             (let ([index segment] pair)
               (if (odd? index)
                 (str "<code>" (escape segment) "</code>")
                 (escape segment))))
        (seq/zip (range (count parts)) parts)))))

(defn- leading-space-count
  (line i)
  "The number of leading space/tab characters in `line`, scanning from `i`."
  (if (and (< i (string/length line))
        (let (c (string/substring line i (+ i 1))) (or (= c " ") (= c "\t"))))
    (leading-space-count line (+ i 1))
    i))

(defn- code-block?
  (block)
  "True if `block` is an indented code example — its first non-blank line starts with
  whitespace. Such a block's newlines are significant (each example on its own line), so it must
  render as `<pre>` rather than a `<p>` whose newlines HTML would collapse into one run-on line."
  (let (lines (filter (fn (l) (not (= (string/trim l) ""))) (string/split block "\n")))
    (and (not (empty? lines)) (> (leading-space-count (first lines) 0) 0))))

(defn- dedent
  (block)
  "Strip the common leading indentation from every line of `block`, so an indented docstring
  code example renders flush-left in its `<pre>` rather than doubly indented."
  (let (lines (string/split block "\n")
        non-blank (filter (fn (l) (not (= (string/trim l) ""))) lines)
        n (if (empty? non-blank) 0 (apply min (map (fn (l) (leading-space-count l 0)) non-blank))))
    (string/join "\n"
      (map (fn (l) (if (>= (string/length l) n) (string/substring l n (string/length l)) l)) lines))))

(defn prose (text)
  "Render a docstring as safe HTML: blank-line-separated blocks become `<p>` paragraphs (with
  inline `code` spans), except an indented block, which becomes a `<pre>` code example with its
  line breaks preserved. Every value is HTML-escaped. Empty/nil text renders to the empty string."
  (if (or (nil? text) (= (string/trim (str text)) ""))
    ""
    (apply str
      (map (fn (block)
             (if (code-block? block)
               (str "<pre class=\"doc-example\"><code>" (escape (dedent block)) "</code></pre>")
               (str "<p>" (inline block) "</p>")))
        (filter (fn (block) (not (= (string/trim block) "")))
          (string/split (str text) "\n\n"))))))

;; ---- anchors ----------------------------------------------------------------

(defn- slug (raw) (string/replace (string/replace (str raw) "/" "-") " " "-"))
(defn module-anchor (module-name)
  "The HTML anchor id for `module-name`'s section (`m-<slug>`)."
  (str "m-" (slug module-name)))
(defn def-anchor (module-name definition-name)
  "The HTML anchor id for a definition within a module (`d-<module>-<name>`)."
  (str "d-" (slug module-name) "-" (slug definition-name)))

;; ---- one definition ---------------------------------------------------------

;; Prefix a signature's leading name with `module/` so a namespaced module's defs read as
;; their qualified CALL form — `(sqrt x)` → `(math/sqrt x)` — since that is how you invoke
;; them (bare `sqrt` is unbound; you write `math/sqrt` or `(:use math)`). Applied only when
;; the module is a real namespace (`:qualified?`), never to the prelude/category pseudo-modules.
(defn- qualify-sig
  (module-name sig)
  (cond
    (nil? sig) sig
    (string/starts-with? sig "(") (str "(" module-name "/" (string/substring sig 1))
    else (str module-name "/" sig)))

(defn- definition-html
  (module-name qualified? definition)
  (let (macro? (get definition :macro)
        type-arrow (get definition :type)
        docstring (get definition :doc)
        raw-sig (get definition :sig)
        sig (if qualified? (qualify-sig module-name raw-sig) raw-sig))
    (str "<div class=\"def\" id=\""
      (def-anchor module-name (get definition :name))
      "\">"
      "<div class=\"def-head\">"
      "<code class=\"sig\">"
      (escape sig)
      "</code>"
      (if macro? " <span class=\"tag\">macro</span>" "")
      "</div>"
      (if type-arrow (str "<div class=\"type\">" (escape type-arrow) "</div>") "")
      (if docstring
        (str "<div class=\"doc\">" (prose docstring) "</div>")
        "<p class=\"undoc\">Undocumented.</p>")
      "</div>")))

;; ---- one module -------------------------------------------------------------

(defn- module-html
  (module)
  (let (module-name (get module :module)
        qualified? (get module :qualified?)
        defs (get module :defs))
    (str "<section class=\"module\" id=\""
      (module-anchor module-name)
      "\">"
      "<h2>"
      (escape module-name)
      "</h2>"
      (let (moduledoc (get module :doc))
        (if moduledoc (str "<div class=\"moduledoc\">" (prose moduledoc) "</div>") ""))
      (if (empty? defs)
        "<p class=\"empty\">No public definitions.</p>"
        (str "<div class=\"defs\">"
          (apply str (map (fn (d) (definition-html module-name qualified? d)) defs))
          "</div>"))
      "</section>")))

;; Render the module sections, emitting a top-level `<h2 class="doc-section">` heading each
;; time a module's `:section` changes — so the model groups (e.g. "Core language" then
;; "Standard library") read as distinct bands, not one flat run of sections. A module with
;; no `:section` renders exactly as before (no heading).
(defn- modules-html
  (modules)
  (get (fold (fn (acc m)
               (let (sec (get m :section)
                     head (if (and sec (not (= sec (get acc :section))))
                            (str "<h2 class=\"doc-section\">" (escape sec) "</h2>")
                            ""))
                 {:section (or sec (get acc :section))
                  :html (str (get acc :html) head (module-html m))}))
         {:section nil :html ""}
         modules)
    :html))

;; ---- sidebar navigation -----------------------------------------------------

(defn- sidebar-def
  (module-name definition)
  (str "<li><a href=\"#"
    (def-anchor module-name (get definition :name))
    "\">"
    (escape (get definition :name))
    "</a></li>"))

(defn- sidebar-module
  (module)
  (let (module-name (get module :module))
    (str "<div class=\"nav-module\">"
      "<a class=\"nav-module-link\" href=\"#"
      (module-anchor module-name)
      "\">"
      (escape module-name)
      "</a>"
      "<ul class=\"nav-defs\">"
      (apply str (map (fn (d) (sidebar-def module-name d)) (get module :defs)))
      "</ul>"
      "</div>")))

;; Sidebar nav grouped by `:section`, mirroring `modules-html` — a `.nav-section` label
;; introduces each group so the core/library split is visible in the nav too.
(defn- sidebar-modules
  (modules)
  (get (fold (fn (acc m)
               (let (sec (get m :section)
                     head (if (and sec (not (= sec (get acc :section))))
                            (str "<div class=\"nav-section\">" (escape sec) "</div>")
                            ""))
                 {:section (or sec (get acc :section))
                  :html (str (get acc :html) head (sidebar-module m))}))
         {:section nil :html ""}
         modules)
    :html))

(defn- sidebar-html
  (model)
  (str "<nav class=\"sidebar\">"
    "<div class=\"brand\">"
    (escape (or (get model :name) "Documentation"))
    (let (v (get model :version)) (if v (str " <span class=\"ver\">" (escape v) "</span>") ""))
    "</div>"
    "<input id=\"docsite-filter\" type=\"search\" placeholder=\"Filter…\" autocomplete=\"off\" spellcheck=\"false\">"
    (apply str (map sidebar-guide (or (get model :guides) [])))
    (sidebar-modules (get model :modules))
    "</nav>"))

;; ---- page assembly ----------------------------------------------------------

(defn- header-html
  (model)
  (let (v (get model :version))
    (str "<header class=\"page-head\">"
      "<h1>"
      (escape (or (get model :name) "Documentation"))
      "</h1>"
      (if v (str "<span class=\"badge\">" (escape v) "</span>") "")
      "</header>")))

;; ---- guides (narrative pages) -----------------------------------------------

(defn- guide-anchor (title) (str "g-" (slug title)))

;; A guide's body is already HTML (Markdown-rendered by the caller), so emit it raw inside
;; a `.module`-styled section — it shares the page's spacing and heading treatment.
(defn- guide-html
  (guide)
  (str "<section class=\"module guide\" id=\""
    (guide-anchor (get guide :title))
    "\">"
    "<h2>"
    (escape (get guide :title))
    "</h2>"
    "<div class=\"guide-body\">"
    (get guide :html)
    "</div>"
    "</section>"))

(defn- sidebar-guide
  (guide)
  (str "<div class=\"nav-module\"><a class=\"nav-module-link\" href=\"#"
    (guide-anchor (get guide :title))
    "\">"
    (escape (get guide :title))
    "</a></div>"))

(defn- content-html
  (model)
  (let (guides (or (get model :guides) []) modules (get model :modules))
    (str (sidebar-html model)
      "<main class=\"content\">"
      (header-html model)
      (apply str (map guide-html guides))
      (cond
        (not (empty? modules)) (modules-html modules)
        (empty? guides) "<p class=\"empty\">No documented modules.</p>"
        else "")
      "</main>")))

;; The base reset for a standalone page (`:wrap? true`) only — it restyles `body`, so it
;; is NOT emitted into an embedding host (hive), whose own body styling must win.
(defn- page-reset-css
  ()
  (str "*{box-sizing:border-box}"
    "body{margin:0;font:15px/1.55 system-ui,-apple-system,Segoe UI,sans-serif;color:#1f2933;background:#fff}"
    "@media (prefers-color-scheme:dark){body{color:#cbd2d9;background:#1a1f26}}"))

;; ── The palette, as CSS custom properties ───────────────────────────────────
;; Every colour the component uses, declared once on `.docsite` so a host can retheme the
;; fragment by redefining variables instead of overriding rules.
;;
;; This is the fix for the second incomplete hand-off in this API (`render-js` was the
;; first). `render-css` emitted a hard-coded LIGHT palette and `component-dark-css` was
;; reachable only from the wrapped page, so a `:wrap? false` host had exactly two options:
;; take the light palette, or override ~30 selectors by hand — which is what hive did to
;; put the reference on a dark page. Neither is a hand-off. A host now writes:
;;
;;     .docsite { --docsite-surface: #12161c; --docsite-fg: #e4e7eb; … }
;;
;; and every rule follows, because there is no colour literal left in `component-css` to
;; fight with. The defaults below are the previous light palette exactly, so a host that
;; sets nothing renders byte-identically to before.
;;
;; `prefers-color-scheme` is the OS's opinion, not the host's, which is why the dark block
;; stays out of `render-css`: an embedded fragment must follow the page it is embedded in.
;; A standalone page owns its whole background and so may follow the OS — it now does that
;; by redefining these same variables, rather than by carrying a second copy of the rules
;; that could drift from the first.
(defn- component-vars-css
  ()
  (str ".docsite{"
    "--docsite-fg:#1f2933;" ; headings, signatures — the strongest text
    "--docsite-text:#3e4c59;" ; body prose
    "--docsite-muted:#52606d;" ; secondary text (nav entries, section labels, tags)
    "--docsite-faint:#9aa5b1;" ; tertiary (undocumented markers, empty states)
    "--docsite-dim:#7b8794;" ; dimmest (version suffix, type lines)
    "--docsite-accent:#2563eb;" ; links, module headings, the badge fill
    "--docsite-accent-fg:#fff;" ; text ON the accent
    "--docsite-border:#e4e7eb;" ; panel/box borders, and the tag fill
    "--docsite-border-strong:#cbd2d9;" ; the heavier rules (section underline, input)
    "--docsite-rule:#eef1f4;" ; the lightest rule (module heading underline)
    "--docsite-surface:#f8fafc;" ; the sidebar
    "--docsite-code-bg:#f0f4f8;" ; inline code, examples, guide `pre`
    "--docsite-input-bg:#fff}")) ; the filter box
;; The component styles — every selector scoped under `.docsite`, so the fragment can be
;; embedded in any host page (hive's daisyUI theme) without a class collision (`.badge`,
;; `.sidebar`, … are all namespaced). Two columns: a sticky sidebar + scrolling content,
;; monospace signatures. No colour literals: every one is a `--docsite-*` variable from
;; `component-vars-css`, so the host owns the theme (see the note there).
(defn- component-css
  ()
  (str ".docsite code,.docsite .sig,.docsite .type{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}"
    ".docsite a{color:var(--docsite-accent);text-decoration:none}.docsite a:hover{text-decoration:underline}"
    ".docsite .layout{display:flex;align-items:flex-start}"
    ".docsite .sidebar{width:16rem;flex:0 0 16rem;position:sticky;top:0;height:100vh;overflow-y:auto;"
    "padding:1rem;border-right:1px solid var(--docsite-border);background:var(--docsite-surface)}"
    ".docsite .brand{font-weight:700;margin-bottom:.5rem}.docsite .ver{color:var(--docsite-dim);font-weight:400}"
    ".docsite #docsite-filter{width:100%;padding:.35rem .5rem;margin-bottom:.75rem;border:1px solid var(--docsite-border-strong);border-radius:.375rem;background:var(--docsite-input-bg);color:inherit}"
    ".docsite .nav-module{margin-bottom:.4rem}.docsite .nav-module-link{font-weight:600}"
    ".docsite .nav-defs{list-style:none;margin:.15rem 0 .5rem;padding-left:.75rem}"
    ".docsite .nav-defs li{margin:.05rem 0}.docsite .nav-defs a{color:var(--docsite-muted);font-size:.86rem}"
    ".docsite .content{flex:1 1 auto;min-width:0;max-width:52rem;padding:1.5rem 2rem}"
    ".docsite .page-head{display:flex;align-items:baseline;gap:.75rem;border-bottom:1px solid var(--docsite-border);padding-bottom:.75rem;margin-bottom:1.5rem}"
    ".docsite .page-head h1{margin:0;font-size:1.6rem}"
    ".docsite .badge{background:var(--docsite-accent);color:var(--docsite-accent-fg);border-radius:.375rem;padding:.1rem .5rem;font-size:.8rem}"
    ".docsite .module{margin-bottom:2.5rem}.docsite .module h2{font-size:1.3rem;color:var(--docsite-accent);border-bottom:1px solid var(--docsite-rule);padding-bottom:.3rem}"
    ".docsite .doc-section{font-size:1.05rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--docsite-muted);margin:3rem 0 1.4rem;padding-bottom:.45rem;border-bottom:2px solid var(--docsite-border-strong)}.docsite .doc-section:first-child{margin-top:.5rem}"
    ".docsite .nav-section{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--docsite-faint);margin:1.1rem 0 .45rem}"
    ".docsite .moduledoc{color:var(--docsite-text);margin-bottom:1rem}"
    ".docsite .def{border:1px solid var(--docsite-border);border-radius:.5rem;padding:.75rem 1rem;margin:.6rem 0;scroll-margin-top:1rem}"
    ".docsite .sig{font-weight:600;color:var(--docsite-fg)}.docsite .tag{background:var(--docsite-border);color:var(--docsite-muted);border-radius:.25rem;padding:0 .35rem;font-size:.72rem;vertical-align:middle}"
    ".docsite .type{color:var(--docsite-dim);font-size:.85rem;margin-top:.15rem}"
    ".docsite .doc{margin-top:.4rem;color:var(--docsite-text)}.docsite .doc p{margin:.4rem 0}.docsite .undoc{color:var(--docsite-faint);font-style:italic;margin:.4rem 0 0}"
    ".docsite .doc code,.docsite .moduledoc code{background:var(--docsite-code-bg);border-radius:.25rem;padding:.05rem .3rem;font-size:.9em}"
    ".docsite .doc-example{background:var(--docsite-code-bg);border-radius:.375rem;padding:.6rem .8rem;margin:.5rem 0;overflow-x:auto;font-size:.85rem;line-height:1.45}"
    ".docsite .doc-example code{background:none;padding:0;white-space:pre}"
    ".docsite .empty{color:var(--docsite-faint)}" ".docsite .guide-body{color:var(--docsite-text)}"
    ;; The guide headings follow `--docsite-fg` rather than a literal. They used to be a
    ;; hard `#1f2933` that the dark block never overrode, so a dark standalone page drew
    ;; near-black headings on a near-black background; routing them through the variable
    ;; fixes that as a consequence of having one palette instead of two.
    ".docsite .guide-body h1{font-size:1.5rem;margin:1rem 0 .5rem;color:var(--docsite-fg)}"
    ".docsite .guide-body h2{font-size:1.2rem;border:0;margin:1rem 0 .4rem;color:var(--docsite-fg)}"
    ".docsite .guide-body h3{font-size:1.05rem;margin:.8rem 0 .3rem;color:var(--docsite-fg)}"
    ".docsite .guide-body p{margin:.5rem 0}.docsite .guide-body ul{margin:.5rem 0;padding-left:1.4rem}"
    ".docsite .guide-body pre{background:var(--docsite-code-bg);border-radius:.4rem;padding:.6rem .8rem;overflow-x:auto}"
    ".docsite .guide-body code{background:var(--docsite-code-bg);border-radius:.25rem;padding:.05rem .3rem;font-size:.9em}"
    ".docsite .guide-body pre code{background:none;padding:0}"))

;; The dark palette, as a variables-only override — the same twelve names, different
;; values. Emitted for a STANDALONE page only (`:wrap? true`), which owns its whole
;; background and so may follow the viewer's OS; an embedding host is handed
;; [[render-css-dark]] and decides for itself when (or whether) to apply it, because
;; `prefers-color-scheme` answers a question about the OS and the host's theme is not
;; the OS's business. That distinction is why hive's reference rendered light-on-light.
(defn- component-dark-vars
  ()
  (str "--docsite-fg:#e4e7eb;"
    "--docsite-text:#b0b8c1;" "--docsite-muted:#9aa5b1;" "--docsite-accent:#63b3ed;"
    "--docsite-border:#2b3138;" "--docsite-border-strong:#3e4c59;" "--docsite-rule:#2b3138;"
    "--docsite-surface:#12161c;" "--docsite-code-bg:#2b3138;" "--docsite-input-bg:#1a1f26;"))

(defn- component-dark-css
  ()
  (str "@media (prefers-color-scheme:dark){.docsite{" (component-dark-vars) "}}"))

;; A dependency-free filter: hide any definition, module, and sidebar entry whose text
;; doesn't contain the query. Empty query restores everything.
(defn- filter-script
  ()
  (str "<script>(function(){"
    "var q=document.getElementById('docsite-filter');if(!q)return;"
    "function norm(s){return s.toLowerCase()}"
    "function hits(el,t){return !!el&&norm(el.textContent).indexOf(t)>=0}"
    "q.addEventListener('input',function(){" "var t=norm(q.value.trim());"
    ;; `whole`: the MODULE itself matched, so everything in it is a result. Without this a
    ;; module-name search showed the heading with all its definitions hidden — each `.def`
    ;; had already failed its own text test — so searching `agent` gave you a bare header
    ;; instead of agent's functions, which is the opposite of what you asked it for.
    "document.querySelectorAll('.module').forEach(function(m){"
    "var whole=!t||hits(m.querySelector('h2'),t);var any=false;"
    "m.querySelectorAll('.def').forEach(function(d){"
    "var hit=whole||hits(d,t);d.style.display=hit?'':'none';if(hit)any=true;});"
    "m.style.display=(whole||any)?'':'none';});"
    ;; The sidebar follows the same rule, so the nav and the content never disagree about
    ;; what the query matched.
    "document.querySelectorAll('.nav-module').forEach(function(n){"
    "var whole=!t||hits(n.querySelector('.nav-module-link'),t);var any=false;"
    "n.querySelectorAll('.nav-defs li').forEach(function(li){"
    "var hit=whole||hits(li,t);li.style.display=hit?'':'none';if(hit)any=true;});"
    "n.style.display=(whole||any)?'':'none';});" "});})();</script>"))

(defn render (model opts)
  "Render `model` to an HTML string. `opts` is a map:

  - `:wrap?` (default true) — emit a whole self-contained `<html>` page (inlined CSS +
    filter script). When false, emit only the `<div class=\"layout\">…</div>` content
    fragment, for embedding inside a host page (the CSS/script are the caller's job).
  - `:title` — the `<title>`/page heading; defaults to the model's `:name`."
  (let (fragment (str "<div class=\"docsite\"><div class=\"layout\">"
                   (content-html model)
                   "</div></div>"))
    (if (get opts :wrap? true)
      (str "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
        "<title>"
        (escape (or (get opts :title) (get model :name) "Documentation"))
        "</title>"
        "<style>"
        (page-reset-css)
        (component-vars-css)
        (component-css)
        (component-dark-css)
        "</style></head><body>"
        fragment
        (filter-script)
        "</body></html>")
      fragment)))

(defn render-css ()
  "The `.docsite`-scoped component stylesheet a `:wrap? false` fragment needs, for a host
  that inlines it once. Every rule is namespaced under `.docsite`, so it never touches the
  host's own styles; the host supplies its page chrome, this styles the doc content.

  **Themeable.** The sheet opens by declaring its whole palette as custom properties on
  `.docsite` and every rule after that reads one — there is no colour literal left to
  fight. To retheme, redefine the ones you care about *after* this sheet:

      .docsite { --docsite-surface: #12161c; --docsite-fg: #e4e7eb }

  The twelve names, with their light defaults: `--docsite-fg` (#1f2933, headings and
  signatures), `--docsite-text` (#3e4c59, prose), `--docsite-muted` (#52606d, nav and
  section labels), `--docsite-faint` (#9aa5b1), `--docsite-dim` (#7b8794),
  `--docsite-accent` (#2563eb, links and module headings), `--docsite-accent-fg` (#fff),
  `--docsite-border` (#e4e7eb, boxes and tag fill), `--docsite-border-strong` (#cbd2d9),
  `--docsite-rule` (#eef1f4), `--docsite-surface` (#f8fafc, sidebar),
  `--docsite-code-bg` (#f0f4f8) and `--docsite-input-bg` (#fff).

  For a ready-made dark set see [[render-css-dark]]. This sheet deliberately carries **no**
  `prefers-color-scheme` rule: that is the viewer's OS talking, and an embedded fragment
  must follow the page it sits in, not the desktop it is viewed on.

      (includes? (docsite/render-css) \"--docsite-accent\") → true"
  (str (component-vars-css) (component-css)))

(defn render-css-dark ()
  "The dark palette for an embedded fragment: the same custom-property names as
  [[render-css]] with dark values, scoped to `.docsite` and wrapped in **no** media query —
  so the host applies it on its own terms. Inline it after `render-css`, under whatever
  selector expresses the host's theme:

      <style>.docsite { … }</style>                    <!-- always dark -->
      <style>[data-theme=dark] .docsite { … }</style>  <!-- host-driven -->

  It exists because the alternative was hive's: override ~30 selectors by hand, because
  the dark styles were reachable only from the standalone page. Only the names that
  actually differ are redefined; the rest inherit from `render-css`.

      (includes? (docsite/render-css-dark) \"--docsite-surface\") → true"
  (str ".docsite{" (component-dark-vars) "}"))

(defn render-js ()
  "The `<script>` the `Filter…` box needs, for a host embedding a `:wrap? false` fragment —
  the script half of the hand-off [[render-css]] already does for styles. A `:wrap? true`
  page inlines this itself.

  Without it a host renders the filter input (it is part of the fragment) and nothing wires
  it up, so the box accepts typing and does nothing. Nothing looks wrong from the server's
  side — the page is complete, correct HTML — which is how the hosted reference came to
  ship an inert search box: `render-css` existed to be called and this had no counterpart.

      (includes? (docsite/render-js) \"docsite-filter\") → true"
  (filter-script))
