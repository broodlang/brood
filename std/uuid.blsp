;; std/uuid.blsp — UUID generation.
;;
;; Versions: v3 (MD5 name-based), v4 (random), v5 (SHA-1 name-based),
;;           v7 (time-ordered random, RFC 9562).

(defmodule uuid
  "UUID generation: v3 (MD5), v4 (random), v5 (SHA-1), v7 (time-ordered).

    (uuid/v4)                          ;; random
    (uuid/v7)                          ;; time-ordered random (RFC 9562)
    (uuid/v5 uuid/ns-dns \"example.com\") ;; deterministic from a name
    (uuid/v3 uuid/ns-url \"https://x\")  ;; same, using MD5
    (uuid/valid? s)                          ;; => true/false
    (uuid/zero)                         ;; => \"00000000-0000-0000-0000-000000000000\"

v4 and v7 are random; v7 also embeds a ms timestamp prefix for chronological
sort order. v3 and v5 are deterministic: same namespace + name → same UUID,
always — useful for content-based IDs and idempotent generation.")

;; ---- layout -----------------------------------------------------------------
;;
;; Every version lays 32 hex digits out as xxxxxxxx-xxxx-Vxxx-Yxxx-xxxxxxxxxxxx: digit 12
;; is replaced by the version, and digit 16 becomes the RFC 4122 variant nibble (10xx,
;; so one of 8/9/a/b).

(defn- layout (hex version)
  (let (variant (string/char-at "89ab"
                  (math/rem (index-of "0123456789abcdef" (string/char-at hex 16)) 4)))
    (str (string/substring hex 0 8)
      "-"
      (string/substring hex 8 12)
      "-"
      version
      (string/substring hex 13 16)
      "-"
      variant
      (string/substring hex 17 20)
      "-"
      (string/substring hex 20 32))))

(defn v4 ()
  "Generate a random RFC 4122 version 4 UUID string.

    (count (uuid/v4))   ;=> 36"
  (layout (rand/token 16) "4"))

(defn zero ()
  "The nil UUID: all zeros.

    (uuid/zero)   ;=> \"00000000-0000-0000-0000-000000000000\""
  "00000000-0000-0000-0000-000000000000")

(defn v7 ()
  "Generate an RFC 9562 version 7 UUID. The first 48 bits encode the current
Unix timestamp in milliseconds, giving chronological sort order. The rest is
random. Use v7 for database keys and time-ordered IDs; use v4 for privacy.

    (count (uuid/v7))   ;=> 36"
  (layout (str (string/pad-left (string/number-> (os/now) 16) 12 "0") (rand/token 10)) "7"))

;; ---- validation -------------------------------------------------------------

(defn valid? (s)
  "True if `s` is a well-formed UUID string (8-4-4-4-12 hex, any case, with dashes).

    (uuid/valid? (uuid/v4))   ;=> true
    (uuid/valid? \"nope\")      ;=> false"
  (and (= (count s) 36)
    (every? (range 36)
      (fn (i)
        (let (c (string/char-at s i))
          (if (includes? [8 13 18 23] i) (= c "-") (includes? "0123456789abcdefABCDEF" c)))))))

;; ---- name-based UUIDs (v3 and v5) -------------------------------------------
;;
;; v3 uses MD5; v5 uses SHA-1. Both take a namespace UUID + a name string and
;; produce the same UUID deterministically every time.
;;
;; RFC 4122 §4.3: hash the namespace's 16 bytes followed by the name's UTF-8 bytes, and
;; lay the first 16 bytes of the digest out with the version and variant set.
;;
;; Standard namespace UUIDs (RFC 4122 appendix C):

(def ns-dns "6ba7b810-9dad-11d1-80b4-00c04fd430c8")
(def ns-url "6ba7b811-9dad-11d1-80b4-00c04fd430c8")
(def ns-oid "6ba7b812-9dad-11d1-80b4-00c04fd430c8")
(def ns-x500 "6ba7b814-9dad-11d1-80b4-00c04fd430c8")

(defn- name-based (ns-uuid name hash-fn version)
  (let (namespace-bytes (encoding/hex-decode-bytes (string/replace ns-uuid "-" "")))
    (layout (hash-fn (append (seq namespace-bytes) (seq (string/->bytes name)))) version)))

(defn v3 (ns-uuid name)
  "Generate a name-based UUID v3 (MD5). Given the same `ns-uuid` and `name`,
always returns the same UUID. Use `uuid/ns-dns`, `uuid/ns-url`, `uuid/ns-oid`,
or `uuid/ns-x500` as the namespace, or supply your own UUID string.

    (uuid/v3 uuid/ns-dns \"example.com\")   ;=> \"9073926b-929f-31c2-abc9-fad77ae3e8eb\""
  (name-based ns-uuid name hash/md5-bytes 3))

(defn v5 (ns-uuid name)
  "Generate a name-based UUID v5 (SHA-1). Given the same `ns-uuid` and `name`,
always returns the same UUID. Prefer v5 over v3 (SHA-1 > MD5). Use
`uuid/ns-dns`, `uuid/ns-url`, `uuid/ns-oid`, or `uuid/ns-x500` as the
namespace, or supply your own UUID string.

    (uuid/v5 uuid/ns-dns \"example.com\")   ;=> \"cfbff0d1-9375-5685-968c-48ce8b15ae17\""
  (name-based ns-uuid name hash/sha1-bytes 5))
