;; ---- symbol / keyword conversions -------------------------------------------
;; `symbol` and `keyword` (Rust) are lenient — they take string/symbol/keyword.
;; The symbol → string direction is the polymorphic `->string` (display) op, or the
;; kernel `name`/`str`; only the strict string → symbol wrapper below is a named
;; conversion (it errors on the wrong input shape). Thin Brood wrapper, no new kernel.

(defn string/->symbol (s)
  "The symbol whose spelling is the string `s`. Errors if `s` isn't a string."
  (if (string? s) (symbol s) (error "string/->symbol: expected a string, got " (type-of s))))

;; ---- strings ----------------------------------------------------------------
;; The string library, written over the kernel primitives `substring` /
;; `string-length` / `str` and `upper` / `lower` / `string/->number`. Brood has no
;; distinct char type, so a "character" is a 1-char string; all indices are
;; char-based, matching `string-length`. The helpers below are tail-recursive
;; (stack-safe over long strings).
;;
;; Cost note, corrected 2026-08-02: `substring` used to be O(index) — plus a copy of the
;; WHOLE source string per call — so a char-by-char scan was O(n²) regardless of content.
;; It now takes a byte-slice fast path when the string is pure ASCII (a char index is then
;; its byte offset, tested in O(1) against the cached char count), making it O(result). So
;; a full scan is **linear on ASCII text** and still O(n²) on text with any multi-byte
;; character, where the `chars().skip(index)` walk remains. Measured, char-by-char over
;; 4k/16k/64k chars: ASCII 6/7/27 ms (ratios 1.16, 3.85) vs non-ASCII 2/21/242 ms (10.50,
;; 11.52). Either way the rope/buffer engine (M2) is still the home for large-text editing.

(defn- %index-of-seq-from
  (coll x i from)
  ;; scan from the head; only start matching once the running index reaches `from`
  (cond
    (empty? coll) -1
    (and (>= i from) (= (first coll) x)) i
    else (%index-of-seq-from (rest coll) x (inc i) from)))
(defn index-of (coll x &optional from)
  "The 0-based index of `x` in `coll` at or after `from` (default 0), or -1 if absent.
For a string, `x` is a substring (multi-char ok; the empty string matches at `from`);
for a list or vector, `x` is an element compared structurally. The `from` offset is
what incremental search rides on (formerly the separate `index-of`).

    (index-of \"hello\" \"ll\")     → 2
    (index-of \"hello\" \"zz\")     → -1
    (index-of [:a :b :c] :b)     → 1
    (index-of \"abab\" \"ab\" 1)    → 2   ; search resumes at `from`"
  (let (start (or from 0))
    (cond
      ;; Strings ride on the `%str-index-of` kernel primitive — linear; a pure-Brood
      ;; scan would be O(n²) (char indexing is O(index)), which is too slow for
      ;; whole-namespace `doc-search`/`apropos` use. The `from` offset goes to the
      ;; primitive, which searches in place. It used to be `(%str-index-of (string/substring
      ;; coll s0 n) x)` — which COPIED the suffix on every call, so the incremental
      ;; search this offset exists for was itself quadratic. `last-index-of` is where that
      ;; measurably mattered (540 ms → 1 ms at 6400 matches); `fuzzy-next` also calls it
      ;; per query char per candidate, but making the scan cheap barely moved ranking —
      ;; see the note there before assuming this is anyone's bottleneck. The empty needle
      ;; still matches at `from`, and a `from` past the end still finds nothing.
      (string? coll) (%str-index-of coll x (%max 0 start))
      else (%index-of-seq-from coll x 0 start))))

(defn last-index-of (s needle &optional before)
  "The 0-based char index of the **last** occurrence of `needle` in string `s` whose
start is strictly **before** `before` (default `(string/length s)`), or -1 if there is
none. The backward counterpart of `(index-of s needle from)` — what reverse
incremental search rides on."
  ;; One native pass. This used to walk forward in Brood calling `(index-of s needle i)`
  ;; per match; every one of those re-derives a char offset (and, before `index-of` took a
  ;; `from`, allocated a copy of the suffix), so a reverse search was O(matches × length) —
  ;; measured 16.5× then 16.4× per 4× of input, where linear is 4×. It is on an editor hot
  ;; path in both directions: `buffer`'s reverse search runs over whole buffer text, and
  ;; `lineedit` finds the current line's start on every keystroke. The empty-needle rule
  ;; (matches at every position, so the answer is `before - 1` clamped) lives in the
  ;; primitive now, unchanged.
  (%str-last-index-of s needle (or before (string/length s))))

(defn includes? (coll x)
  "True if `coll` contains `x`. Works on lists, vectors, strings (string/substring), and maps (membership among values — use `contains?` for keys).

    (includes? [1 2 3] 2)         → true
    (includes? \"hello\" \"ell\")     → true
    (includes? {:a 1} 1)          → true    ; VALUES, not keys
    (includes? {:a 1} :a)         → false   ; use contains? for that"
  (cond
    (map? coll) (includes? (vals coll) x)
    else (>= (index-of coll x) 0)))

;; Collect `coll`'s elements interleaved with `sep` into a parts list (tail-
;; recursively, reversed), then build the string in one `apply str` pass.

;; `string-split` is now a native builtin (crates/lisp/src/builtins/mod.rs) — one O(n)
;; pass via Rust's `str::split`. The former pure-Brood version re-`substring`ed the
;; tail each step, which is O(n²) (char-indexed substring is O(index)); a 174 KB
;; `git ls-files` output took ~840 ms in the editor's project scan, now ~10 ms.

;; ---- string padding & repetition --------------------------------------------
;; Column formatting for tabular/console output. `pad-*` left unchanged when the
;; string already meets the width (they never truncate).

;; ---- strings & paths --------------------------------------------------------
;; Helpers over `substring` (char-indexed, like `string-length`). Generic enough
;; to live in core; the module system and the project tooling build on them.

;; The bootstrap `path-*` subset (path-join/path-basename/path-absolute/parent-directory):
;; the minimal path ops tooling needs *before* any module can be required. The full
;; path library is `std/path.blsp` (`path/dirname`/`normalize`/`relative-to`/…) — a
;; deliberate layer on top, with its own (slightly different) contracts. Not a dup.
;;
;; Index of the last `/` in `s`, scanning down from `i`, or -1 if none. (Brood has
;; no char accessor yet; paths are short, so a substring scan is fine.)
(defn- %path-last-slash
  (s i)
  (cond (< i 0) -1 (= (string/substring s i (inc i)) "/") i else (%path-last-slash s (dec i))))

;; The directory containing `path`: "/a/b/c" -> "/a/b", "/foo" -> "/", "rel" -> ".".
;; A path that is its own parent ("/" or ".") is the fixed point a walk-up stops at.

;; The loader calls this during boot, BEFORE any module can load, so a bootstrap copy has
;; to live here. `%`-prefixed to say so: the public spelling is `path/join`, and this one
;; exists only because `require` needs to build a path before `require` works.
(defn %path-join (a b)
  "Join path segments `a` and `b` with a single `/` separator."
  (if (string/ends-with? a "/") (str a b) (str a "/" b)))

;; ---- pseudo-random numbers (xorshift32, pure & seedable) --------------------
;; Brood has no global mutable state, so randomness is *threaded*: every step
;; takes a seed and returns `[value next-seed]`. Pass `next-seed` to the next
;; call; thread the seed through your loop state exactly like any other value.
;; Seed a fresh stream from any integer (e.g. `(%now)`) via `%rand-seed`.
;;
;; The generator is Marsaglia's xorshift32 — fast and good enough for
;; simulations, sampling, shuffling, jitter, and ids; NOT for cryptography. Each
;; left shift can exceed 32 bits, so we mask back to 32 bits with `*rand-mask*`,
;; which also keeps every intermediate well within i64 (no overflow).

; 2^32 - 1
(def- *rand-mask* 4294967295)
(defn %rand-seed (n)
  "Normalize integer `n` into a valid nonzero 32-bit PRNG seed (xorshift32 cannot start from 0)."
  (let (m (bit/and n *rand-mask*))
    (if (= m 0) 2463534242 m)))

(defn- %rand-step
  (state)
  ;; One xorshift32 transition over a nonzero 32-bit `state`.
  (let (x (bit/and (bit/xor state (bit/shift-left state 13)) *rand-mask*)
        x (bit/xor x (bit/shift-right x 17))
        x (bit/and (bit/xor x (bit/shift-left x 5)) *rand-mask*))
    x))

;; The seeded PRNG public API (rand/rng / rand/int / rand/float / rand/seed) lives in the
;; `rand` module (std/rand.blsp); the `%rand-seed`/`%rand-step` mechanism above stays here
;; because the sequence ops `sample`/`shuffle` (in std/seq.blsp) build on it.

;; ---- bounded printing -------------------------------------------------------
;; `pr-str` is *faithful*: whatever it returns reads back as the same value, so it
;; can never elide anything. That's the right contract for serialization and the
;; wrong one for a screen — one 100k-element list at a REPL prompt scrolls your
;; session away, and there is no way to ask for less.
;;
;; So bounding is a SEPARATE function rather than a flag on `pr-str`: nothing that
;; round-trips data can accidentally acquire an eliding printer, and `pr-str`
;; remains the escape hatch for seeing everything (`(pr-str *1)` after a truncated
;; result). The two knobs are `defdyn`s, so they are ambient (usable bare from any
;; namespace) and scopable with `binding`.
;;
;; Both markers are `…`, meaning "elided here" — for length as a trailing item, for
;; depth in place of the subform. Deliberately ONE marker rather than Clojure's
;; `…`/`#` pair: two symbols for one concept is a thing to learn for no gain, and a
;; bare `#` would read as the start of a `#{…}` set to anything re-lexing the output
;; (the REPL's result highlighter does exactly that).
;;
;; Only *containers* are traversed; every leaf and every value this doesn't know
;; about (records with an `impl display`, ropes, tables, functions) is handed to
;; `pr-str` unchanged, so custom printing keeps working and this stays small.

(defdyn *print-length* 100)
(defdyn *print-level* 8)
;; The third bound, and in practice the one that saves a display: a TEXT leaf's
;; length. Neither bound above touches a leaf, so a single 10 MB string sails past
;; both — `*print-length*` counts a collection's items and a string is one item.
;; 4096 matches Elixir's `inspectable` `:printable_limit`, which exists for exactly this.
(defdyn *print-string-length* 4096)

(defn- %pr-elide
  (parts over)
  "`parts` joined for display, with the `…` length marker appended when `over`."
  (string/join " " (if over (append parts (list "…")) parts)))

(defn- %pr-limit
  (items)
  "`[shown over?]` for `items` under `*print-length*` — at most that many items,
plus whether any were dropped. Takes one extra item to detect the overflow, so a
long collection is never walked past the limit."
  (let (lim *print-length*)
    (if (nil? lim)
      [items false]
      (let (taken (take (inc lim) items)
            over (> (count taken) lim))
        [(if over (take lim taken) taken) over]))))

(defn- %pr-safely
  (thunk x)
  "Run `thunk`, falling back to `(pr-str x)` if it raises. The guard for a value
that looks like a container but doesn't walk like one — an improper/dotted pair
such as `(cons 1 2)` is the real case. Per-node, so one odd subtree degrades to
faithful printing instead of losing the bound on the whole value."
  (try (thunk) (catch _ (pr-str x))))

(defn- %pr-bounded-seq
  (x level open close)
  (let ([shown over] (%pr-limit x))
    (str open (%pr-elide (map (fn (i) (%pr-bounded i (inc level))) shown) over) close)))

(defn- %pr-bounded-map
  (x level)
  (let ([shown over] (%pr-limit (%map-pairs x)))
    (str "{"
      (%pr-elide (map (fn ([k v])
                        (str (%pr-bounded k (inc level)) " " (%pr-bounded v (inc level))))
                   shown)
        over)
      "}")))

(defn- %pr-bounded-text
  (x)
  "A text leaf — a string or a byte string — under `*print-string-length*`: at most
that many characters (bytes) print, with the `…` marker inside the closing quote
(`\"abc…\"`, `#b\"ab…\"`).

The VALUE is cut before it is printed, never `pr-str`'s output: truncating the
printed form could halve an escape (`\\n`) or drop the closing quote, and a byte
string costs four output characters per byte, so cutting after the fact would still
have built the flood this bound exists to prevent."
  (let (limit *print-string-length*
        bytes (= :bytes (type-of x))
        length (if bytes (count x) (string/length x)))
    (if (or (nil? limit) (<= length limit))
      (pr-str x)
      (let (printed (pr-str (if bytes (%subbytes x 0 limit) (string/substring x 0 limit))))
        ;; drop the closing quote, mark the elision, close again
        (str (string/substring printed 0 (dec (string/length printed))) "…\"")))))

(defn- %pr-bounded
  (x level)
  "`x` printed at nesting `level`, honouring every bound. Containers recurse, text
leaves are length-bounded, anything else goes to `pr-str`.

The depth bound is tested on *entering a container*, never on a leaf — so
`*print-level*` 2 on `{:a {:b {:c 1}}}` elides the whole third map (`{:a {:b …}}`)
rather than each of its keys and values separately (`{:a {:b {… …}}}`). A non-text
leaf always prints whole: eliding an atom would cost a character and save nothing,
and the values that print unboundedly LONG are the text ones (a rope and a table
already print as a summary handle, `#<rope :chars 11 :lines 1>`)."
  (let (t (type-of x)
        container (or (= t :pair) (= t :vector) (= t :set) (= t :map)))
    (cond
      (and container *print-level* (>= level *print-level*)) "…"
      (= t :pair) (%pr-safely (fn () (%pr-bounded-seq x level "(" ")")) x)
      (= t :vector) (%pr-safely (fn () (%pr-bounded-seq x level "[" "]")) x)
      (= t :set) (%pr-safely (fn () (%pr-bounded-seq x level "#{" "}")) x)
      (= t :map) (%pr-safely (fn () (%pr-bounded-map x level)) x)
      (or (= t :string) (= t :bytes)) (%pr-safely (fn () (%pr-bounded-text x)) x)
      else (pr-str x))))

(defn pr-str-bounded (x)
  "Like `pr-str`, but eliding with `…` past `*print-length*` items per collection,
`*print-level*` levels of nesting, and `*print-string-length*` characters of a
string or byte string (`nil` for any of them means no limit). For *display* — the
result does not read back, so use `pr-str` when you need the whole value.

**Every display protocol should print through this**, not `pr-str`: the REPL's
results, `spy`'s trace entries, an editor's echo area. A protocol whose job is to
show a value to a human has no business flooding the screen (or a pipe, or a log)
with a megabyte, and one bounded printer is how that stays true everywhere instead
of each consumer inventing its own cap."
  (%pr-bounded x 0))
