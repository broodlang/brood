;; Brood prelude / core library
;; ------------------------------
;; Most of the language lives here, in Brood itself. Rust provides only a small
;; primitive kernel (see crates/lisp/src/builtins/mod.rs — the `%`-prefixed ops and
;; a few constructors/predicates); everything below is ordinary Brood.
;;
;; Style note: code is made of lists, so parameter lists are written as lists —
;; (defn f (x y) ...). Vectors [ ] are a *data* type (O(1) indexing); they are
;; still accepted in parameter/binding positions, but lists are idiomatic.
;;
;; The very first definition is `defn`, a macro. Everything after it is written
;; with `defn`, so the library is defined exactly the way you would define your
;; own functions — including `+`, which is "just a function".

;; ---- bootstrap: the list builders the quasiquote expander emits ----
;; `quasiquote` is a compile/eval-time transform: `` `(a ~b ~@c) `` becomes builder
;; code `(append (list 'a) (list b) c)`. The very first macro below (`defn`) already
;; uses a backtick template, so the symbols that builder code names must be bound
;; before any prelude form runs. `cons`/`vector`/`hash-map`/`apply` are kernel
;; builtins; `list` and `append` are not — so seed minimal versions here (raw
;; `def`/`fn`, no backtick, no quasiquote dependency). The full seq-generic,
;; tail-recursive `list`/`append` further down simply `def`-rebind these.
(def list (fn (& xs) "A list of the given arguments." xs))
(def %append-empty?
  (fn (x)
    (if (%eq (type-of x) :nil)
      true
      (if (%eq (type-of x) :vector) (%eq (%vector-length x) 0) false))))
(def %append-rev
  (fn (src acc)
    ;; Reverse seq `src` (a list or vector) onto list `acc`. Tail-recursive.
    (if (%append-empty? src) acc (%append-rev (rest src) (cons (first src) acc)))))
(def %append-2
  (fn (a b)
    ;; Cons every element of seq `a` (a list or vector) onto list `b` — via a
    ;; double reverse, so even the bootstrap builder is O(1) stack like the full
    ;; `append` below that rebinds it (`check-allow` doesn't exist yet up here).
    (%append-rev (%append-rev a nil) b)))
(def append
  (fn (& lists)
    ;; Concatenate any number of sequences into one list, left to right.
    (if (%append-empty? lists)
      nil
      (%append-2 (first lists) (apply append (rest lists))))))

;; `defmacro` itself — a macro, not a core special form. A macro is just a `fn`
;; the expander calls on the *unexpanded* argument forms; `%make-macro` (the one
;; Rust primitive this needs) tags a closure as one. Bootstrapped with raw
;; `def`/`fn` because `defmacro` can't define itself; every later `(defmacro …)`
;; expands through this into `(def name (%make-macro (fn …)))`.
(def defmacro
  (%make-macro (fn (name & body)
                 "Define `name` as a macro: a `fn` run at expansion time on the unevaluated argument forms, whose returned form replaces the call."
                 `(def ~name (%make-macro (fn ~@body))))))

;; Reject a non-symbol in the NAME position at expansion time. Without it the mistake
;; reaches `def`, whose complaint is about `def` — a form the author never typed — and the
;; commonest slip has an obvious diagnosis worth stating: `(defn (expr) expr)` is a
;; parameter list sitting where the name belongs, i.e. the name was simply left out.
;;
;; Written on PRIMITIVES only (`%eq`/`type-of`/`str`/`pr-str`/`throw`) and bound with a
;; plain `(def … (fn …))`: this file is the first the prelude concatenates, so `symbol?`
;; (predicates.blsp) and `defn-` itself do not exist yet — the same bootstrap reason the
;; append helpers above take that shape.
(def %defn-check-name
  (fn (who name)
    (if (%eq (type-of name) :symbol)
      nil
      (throw (str who
               ": the name must be a symbol, got "
               (pr-str name)
               (if (%eq (type-of name) :pair)
                 " — that is a parameter list where the name belongs; the shape is "
                 " — the shape is ")
               "("
               who
               " NAME (params...) body...)")))))

;; `defn` itself: forwards everything after the name to `fn`, so it inherits
;; both single-clause — (defn f (x) ...) => (def f (fn (x) ...)) — and the
;; multi-clause pattern form — (defn f ((0) 1) ((n) ...)) => (def f (fn ((0) 1) ((n) ...))).
(defmacro defn (name & clauses)
  "Define a global function `name`, forwarding the clauses to `fn` — so it supports both the single-clause form `(defn f (x) body...)` and multi-clause pattern dispatch."
  (%defn-check-name 'defn name)
  `(def ~name (fn ~@clauses)))

;; `defn-` / `def-` — the PRIVATE variants (ADR-146). Identical to `defn`/`def`
;; except the defined name is module-private: a qualified reference from another
;; module is a compile error (unless granted with `(:use-internals mod)`), and a
;; `(:use mod)` refer-all skips it. Privacy is a property the def form declares —
;; recorded via `%mark-private` — not a marker in the name, so the name stays clean
;; at the definition and at every call site. The `def` runs first so the global
;; exists when `%mark-private` qualifies it.
(defmacro defn- (name & clauses)
  "Define a MODULE-PRIVATE function `name` (ADR-146) — like `defn`, but the name is not exported and a cross-module reference to it is a compile error."
  (%defn-check-name 'defn- name)
  `(do (def ~name (fn ~@clauses)) (%mark-private '~name)))
(defmacro def- (name value)
  "Define a MODULE-PRIVATE global `name` (ADR-146) — like `def`, but the name is not exported outside its module."
  `(do (def ~name ~value) (%mark-private '~name)))

;; The bootstrap append helpers above are defined before `def-` exists (they are plain
;; `(def name (fn …))` because `defn` itself is not available that early), so they are
;; marked private here instead — the same `%mark-private` fact `def-` records, just stated
;; once the macro layer is up. Without this they were published as core vocabulary: three
;; internal list builders nobody can meaningfully call.
(%mark-private '%append-empty?)
(%mark-private '%append-rev)
(%mark-private '%append-2)

;; ---- logic ----
(defn not (x)
  "Logical negation: `nil`/`false` become `true`, everything else `false`.

    (not nil)     → true
    (not 0)       → false   ; only nil and false are falsy"
  (if x false true))

;; `empty?` — true for the empty value of any collection. Defined here, before
;; `fold`/`reduce` use it, so it's written with the raw kernel ops (`%eq`,
;; `type-of`, `string-length`, `vector-length`, `%map-count`) rather than the type
;; predicates / `cond`, which are defined further down. (Not a Rust primitive: the
;; empty list is `nil`, and every other collection's emptiness is a length the
;; kernel already exposes.)
;; `empty?` is a native builtin (builtins.rs) for Prim1-level dispatch speed.

;; ---- ->string: the value → display string conversion ----
;; ONE name for this operation, from here to user code. This is the BOOTSTRAP
;; implementation; `defability Display` (std/prelude/tools.blsp) rebinds the same
;; name to a dispatching version far below, so a record can define its own display.
;; The rebind is the whole point of defining it here rather than beside the ability:
;; the prelude's own machinery — `defmodule`, `require`, package rooting, `defrecord`
;; — needs this operation ~60 times *before* `defability` has been evaluated, and a
;; second `%`-prefixed spelling for those callers would be two names for one idea.
;;
;; Written with kernel natives only (`type-of`/`%eq`/`str`/`string/substring`), since
;; `keyword?` and `cond` are not defined until `predicates.blsp`, which concatenates
;; after this file.
;;
;; A symbol or keyword yields its SPELLING, with no sigil: `(->string :foo)` is "foo".
;; This is the one kind where `->string` and `str` deliberately disagree — `(str :foo)`
;; is ":foo", and `pr-str` must also stay ":foo" because it has to round-trip. It was
;; the bare `name` primitive until 2026-08-27; that spelling is now a user's to take.
(defn ->string (x)
  "The display string of `x`: a symbol or keyword yields its spelling with no sigil
(`(->string :foo)` → \"foo\"), and everything else is `str`. A record may customise
this by implementing the `Display` ability, which takes over this name below.

    (->string :foo)   → \"foo\"
    (->string 'foo)   → \"foo\"
    (->string 42)     → \"42\"
    (str :foo)        → \":foo\"   ; `str` keeps the sigil; this does not"
  (if (%eq (type-of x) :keyword) (string/substring (str x) 1) (str x)))

;; ---- universal list view ----
;; `seq` is what lets every list-shaped op (map/filter/fold/reduce/…) walk a
;; *map* without callers reaching for `(seq/zip (keys m) (vals m))`: a map becomes
;; its `[k v]` pairs in one O(n) `%map-pairs` pass; lists, vectors, strings, and
;; `nil` pass through unchanged. Defined here with raw kernel ops (`%eq`,
;; `type-of`, `%map-pairs`) because `fold` calls it before the `map?` predicate /
;; `cond` macro are available.
(defn seq (coll)
  "A list view of `coll`. A map becomes its `[k v]` pairs; a lazy range or seq-view is realised to a list; a bytes value becomes its list of ints; lists, vectors, strings, and `nil` pass through. Used by `map`/`filter`/`fold` so they accept any collection.

    (seq (range 3))   → (0 1 2)     ; realised
    (seq {:a 1})      → ([:a 1])    ; a map becomes its [k v] pairs
    (seq [1 2 3])     → [1 2 3]     ; already a sequence — passes through
    (seq nil)         → nil"
  (if (range? coll)
    (%range->list coll)
    (if (seqview? coll)
      (%seqview-realize coll)
      (let (t (type-of coll))
        ;; A `bytes` value is realised to a list ONCE here: without this, fold/map/
        ;; filter/reduce would walk it with `first`/`rest`, and `(rest bytes)` copies
        ;; all-but-the-first byte — O(n) per step, O(n^2) total (a 50k-byte reduce
        ;; spiked ~1.3 GB RSS). `bytes->list` is a single O(n) native pass.
        (if (%eq t :map)
          ;; A record (a map carrying `:__id__`) takes its `Seqable` view — the fields,
          ;; id-free, by default — so it never leaks `:__id__` into map/fold/keys and a
          ;; custom collection can define its own iteration. `->seq` is only reached for
          ;; records (never at boot, which has none), so its late definition is fine.
          (if (%map-get coll :__id__ nil)
            (->seq coll)
            (%map-pairs coll))
          (if (%eq t :bytes)
            (%bytes->list coll)
            ;; Lists and nil ARE their own seq view and take the hot path untouched. Any
            ;; other kind reaching here is one `seq` has no native view of — a rope, a
            ;; table — and used to be returned UNCHANGED, so `(seq rope)` silently answered
            ;; the rope itself. Consult `Seqable`, but only where an impl exists for that
            ;; kind SPECIFICALLY: its `:default` is a record's fields, meaningless here.
            ;;
            ;; ONLY what is available at line 106 of the prelude. `get` and `%identity-of`
            ;; re-enter `seq` (they are built on the protocol `seq` provides), and `or` is a
            ;; MACRO defined 550 lines further down — used here it compiles as a call to a
            ;; not-yet-macro and recurses until the stack budget trips, during prelude
            ;; expansion, before anything can report which function did it. So: `if`, `%eq`,
            ;; `bound?` and `%map-get`, nothing else. (ADR-253)
            (if (%eq t :pair)
              coll
              (if (%eq t :nil)
                coll
                (if (bound? (quote *impls*))
                  (let (methods (%map-get *impls* (quote [Seqable ->seq]) nil))
                    (if methods
                      (if (%map-get methods t nil) (->seq coll) coll)
                      coll))
                  coll)))))))))

;; ---- folding (the workhorse; tail-recursive, so it is stack-safe) ----
;; The public entry coerces once via `seq`; the inner `%fold-loop` then stays in
;; list form for the recursion, so a map costs one extra `%map-pairs` pass total
;; rather than O(n) per step.
(defn fold (coll acc f)
  "Left-fold: combine the items of `coll` left-to-right with `(f acc item)`, starting from `acc`. Tail-recursive, so it is stack-safe. Maps fold as their `[k v]` pairs. A lazy range folds in a counted loop with no list materialised; a lazy seq-view fuses — its transducer wraps `f` and folds straight over the source, so `(reduce (map (filter (range n) p) sq) 0 +)` walks the range once with no intermediate lists.

    (fold [1 2 3 4] 0 +)                      → 10
    (fold [1 2 3] nil (fn (a x) (cons x a)))  → (3 2 1)
    (fold [3 9 4] 0 math/max)                 → 9"
  ;; DISPATCH ORDER IS LOAD-BEARING. A vector is tested first, with the one-call
  ;; `vector?` predicate rather than `type-of` + `%eq` from the bottom of the chain.
  ;; The branches are disjoint (`type-of` is `:vector` for a vector and `:pair` for a
  ;; range, a seq-view AND a list), so no value changes branch — this is pure ordering.
  ;;
  ;; Measured 2026-08-10, 300k small folds of a 16-cell container, containers hoisted
  ;; out of the loop so only dispatch + reduce is timed (median of 3):
  ;;
  ;;     vector 533 -> 410 ns   range 230 -> 183 ns   list 3595 -> 3248 ns
  ;;
  ;; Note the range row IMPROVES even though a range now pays an extra `vector?` first:
  ;; flattening the chain is worth more than the check costs. That is why this is not
  ;; the trade it looks like — nothing regresses. On the spawn-live shape (each unit
  ;; folds a 16-cell payload in a cold process) the rung went 28.3 -> 27.1 us/unit.
  (if (vector? coll)
    (%vector-reduce f acc coll)
    (if (range? coll)
      (%range-reduce f acc coll)
      (if (seqview? coll)
        ;; Fuse: `(xform f)` is the wrapped reducer; fold it over the source (a
        ;; range → counted loop, a list → %fold-loop, a nested view → fuses again).
        ;; Raw kernel ops (`if`/`let`/`vector-ref`) only — `fold` is defined before
        ;; `cond`/`second`.
        (let (parts (%seqview-parts coll))
          (fold (%vector-ref parts 0) acc ((%vector-ref parts 1) f)))
        (%fold-loop f acc (seq coll))))))
(defn- %fold-loop (f acc coll)
  ;; ADR-313: a fold STOPS once the accumulator is a failure. Neither `with` nor `ok->`
  ;; can reach this case — the accumulator is threaded by the combinator, not by the
  ;; caller, so there is no binding or pipe step to put a sentinel on. Without it, a
  ;; callback that returns a failure hands it to the NEXT step, which raises
  ;; (`conj: not a collection`) one item later, naming the wrong thing. This is the
  ;; short-circuiting fold ADR-312 deferred pending evidence; the calculator is it.
  (if (failure? acc)
    acc
    (if (empty? coll) acc (%fold-loop f (f acc (first coll)) (rest coll)))))

;; `cons` with its arguments flipped — the workhorse passed to `fold` to build a
;; list in reverse (then reversed once at the end). Hoisted to the top level so
;; the list builders that reverse-accumulate don't each allocate a fresh closure
;; on every call.
(defn- %flip-cons (acc x) (cons x acc))

;; A dedicated loop, not `(fold %flip-cons …)`: `reverse` is the final pass of
;; nearly every sequence builder (`map`/`filter`/`take`/`zip`/`range`/…), so
;; dropping the per-element `%flip-cons` `apply` frame here pays off across the
;; whole library. Coerce a map to its pairs once via `seq`, as `fold` did.
(defn- %reverse-acc (coll acc)
  (if (empty? coll) acc (%reverse-acc (rest coll) (cons (first coll) acc))))
(defn reverse (coll)
  "The items of `coll` in reverse order, as a list.

    (reverse [1 2 3])  → (3 2 1)
    (reverse nil)      → nil

A string is not a sequence here — reverse its `string/->list` if you need that."
  (%reverse-acc (seq coll) nil))

;; `but-last` lives HERE, in core, rather than with the rest of the sequence library —
;; the position is load-bearing. `receive`'s macro body calls it, and `sleep` (in
;; process.blsp) is a `receive`, so the call happens while the PRELUDE ITSELF is booting.
;; With `but-last` defined in seq.blsp — concatenated after process.blsp — `receive` could
;; not expand at compile time at all; it expanded lazily at first call instead, on a path
;; that runs no namespace-resolve pass, which is what made `receive` the one prelude macro
;; whose template could not use the `/name` root escape (KI-73). It needs only `reverse`
;; (just above) and the kernel `rest`, so it costs nothing to define this early.
(defn but-last (xs)
  "All but the last item of `xs`, as a list.

    (but-last [1 2 3])   → (1 2)"
  (reverse (rest (reverse xs))))

(defn- %reverse-onto (coll tail)
  "The items of `coll` reversed, prepended onto `tail`. `(%reverse-onto xs ys)` is
`(append (reverse xs) ys)` — but it walks `xs` **once**, so it is the spelling to
reach for when a tail-recursive loop has accumulated a reversed prefix and wants to
splice it back in front of the remainder."
  ;; This is THE shape every tail-recursive rewrite lands in: walk a list building a
  ;; reversed accumulator, then splice at the stopping point. Written as
  ;; `(append (reverse acc) tail)` it costs four passes — `reverse` walks `acc`, then
  ;; `append` folds both lists onto nil and reverses the result — and the checker's
  ;; non-tail-recursion advice produces more of these every time it is followed. So
  ;; the idiom gets a name and one pass. Measured, 20k splices of a 500-element
  ;; prefix: `(append (reverse acc) tail)` 2739 ms, `(fold %flip-cons tail acc)`
  ;; 1674 ms, this 601 ms (4.6x). The `fold` form loses because of the per-element
  ;; `%flip-cons` apply frame, which is exactly why `%reverse-acc` is a dedicated loop.
  (%reverse-acc (seq coll) tail))

;; Realise a lazy seq-view to a concrete list by running its transducer. Folding
;; `%flip-cons` over the view hits `fold`'s seq-view branch, which wraps the
;; transducer around `%flip-cons` and folds over the source — producing the
;; transduced items in reverse, so one `reverse` puts them in order. The kernel
;; `first`/`rest`/`apply` builtins call this (by name) for a view that escapes the
;; fusing path; `seq` calls it to coerce. No intermediate list beyond the result.
(defn %seqview-realize (sv)
  "Realise the lazy seq-view `sv` to a concrete list by running its transducer. Internal:
the kernel `first`/`rest`/`apply` builtins call this by name for a view that escapes the
fusing path, and `seq` calls it to coerce — use `seq` or `into` in your own code."
  (reverse (fold sv nil %flip-cons)))

;; reduce supports both (reduce coll acc f) and (reduce coll f) — data-first
;; (ADR-308), matching `Enum.reduce/3` and `/2`. The 2-arg form must seq-coerce
;; `coll` itself before splitting head/tail, because the bare `(first coll)`/
;; `(rest coll)` calls bypass fold's coercion and a map would error.
(defn reduce (coll x & more)
  "Reduce a collection with `f`. Either `(reduce coll acc f)` or `(reduce coll f)` (using the first item as the initial value). Maps reduce as their `[k v]` pairs.

    (reduce [1 2 3] +)    → 6
    (reduce [1 2] 10 +)   → 13   ; with an explicit start
    (reduce [] +)         → nil  ; no items and no start"
  (if (empty? more)
    (let (s (seq coll)) (fold (rest s) (first s) x))
    (fold coll x (first more))))

;; ---- arithmetic (variadic, built on the 2-arg primitives) ----
;; Multi-arity (ADR-047): the 0/1/2-argument clauses bind their parameters
;; *directly* and call the primitive — no `& xs` rest-list, no `fold`, just one
;; env frame — so the overwhelmingly common 2-argument call (`(+ a b)`) is ~40×
;; cheaper than folding over a variadic rest-list. Only the 3+-argument fallback
;; folds, starting from the first two combined so it never re-walks them. (This
;; is the dogfooding payoff: writing `+` in Brood surfaced the missing
;; multi-arity dispatch; we built that capability rather than moving `+` to Rust
;; — CLAUDE.md "dogfood first; optimize by building the language up".)
(defn + "Sum of all arguments (0 with none).

    (+ 1 2 3)   → 6
    (+)         → 0   ; the identity"
  (() 0)
  ((a) a)
  ((a b) (%add a b))
  ((a b & more) (fold more (%add a b) %add)))
(defn * "Product of all arguments (1 with none).

    (* 2 3 4)   → 24
    (*)         → 1   ; the identity"
  (() 1)
  ((a) a)
  ((a b) (%mul a b))
  ((a b & more) (fold more (%mul a b) %mul)))
(defn - "Subtract the rest from `x`; negate `x` if it's the only argument.

    (- 10 3 2)  → 5
    (- 5)       → -5"
  ((x) (%sub 0 x))
  ((a b) (%sub a b))
  ((x & xs) (fold xs x %sub)))
(defn / "Divide `x` by the rest; reciprocal of `x` if it's the only argument. Errors on division by zero.

    (/ 6 3)     → 2
    (/ 1 2)     → 1/2   ; integer division is EXACT, not truncating"
  ((x) (%div 1 x))
  ((a b) (%div a b))
  ((x & xs) (fold xs x %div)))

(defn inc (n)
  "Return `n` + 1.

    (inc 1)   → 2"
  (%add n 1))
(defn dec (n)
  "Return `n` - 1.

    (dec 1)   → 0"
  (%sub n 1))

;; ---- comparison & equality (variadic chains over %lt / %eq) ----
;; %chain? checks a predicate holds for every adjacent pair: (%chain? < (1 2 3)).
(defn %chain? (pred xs)
  "True when `pred` holds for every ADJACENT pair of `xs` — the engine behind the variadic
comparison chains, so `(< 1 2 3)` is `(%chain? < (1 2 3))`. Vacuously true for a sequence of
fewer than two items.

    (%chain? < (list 1 2 3))    → true
    (%chain? < (list 1 3 2))    → false
    (%chain? = (list 7))        → true"
  (if (empty? xs)
    true
    (if (empty? (rest xs))
      true
      (if (pred (first xs) (first (rest xs))) (%chain? pred (rest xs)) false))))

;; Binary comparison kernels, hoisted to the top level so the variadic chains
;; below pass an *existing* function to `%chain?` rather than allocating a fresh
;; closure on every call. `<` and `=` reuse the `%lt`/`%eq` primitives directly;
;; the swapped/negated ones get a named Brood helper (still policy in Brood).
(defn- %cmp-gt (a b) (%lt b a))
(defn- %cmp-le (a b) (not (%lt b a)))
(defn- %cmp-ge (a b) (not (%lt a b)))

;; Multi-arity like arithmetic above: a direct 2-argument clause (the common
;; case — `(< a b)`, `(= a b)`) calls the primitive with one env frame; the
;; variadic clause chains over adjacent pairs for 3+ (or 0/1, trivially true).
(defn < "True if the arguments are in strictly increasing order.

    (< 1 2 3)   → true
    (< 1 1)     → false

A single argument is vacuously in order — `(< x)` is true — but `x` is still checked to be
something that CAN be ordered: `(< '(1 2))` raises rather than silently answering true."
  ((a b) (%lt a b))
  ((a) (do (%lt a a) true))
  ((& xs) (%chain? %lt xs)))
(defn > "True if the arguments are in strictly decreasing order.

    (> 3 1)     → true
    (> 3 3)     → false
    (> 3 2 1)   → true    ; chained, i.e. each neighbouring pair in turn"
  ((a b) (%lt b a))
  ((a) (do (%lt a a) true))
  ((& xs) (%chain? %cmp-gt xs)))
(defn <= "True if the arguments are in non-decreasing order.

    (<= 1 2)     → true
    (<= 1 1 2)   → true    ; equal neighbours are allowed
    (<= 2 1)     → false"
  ;; 2-arg body is a direct primitive call (a <= b) so the ADR-069 thin-wrapper
  ;; elision reaches it — the old `(not (%lt b a))` was a nested call it couldn't.
  ((a b) (%le a b))
  ((a) (do (%le a a) true))
  ((& xs) (%chain? %cmp-le xs)))
(defn >= "True if the arguments are in non-increasing order.

    (>= 2 2)   → true
    (>= 1 2)   → false"
  ;; a >= b  ==  b <= a — still a single passthrough (%le with args swapped).
  ((a b) (%le b a))
  ((a) (do (%le a a) true))
  ((& xs) (%chain? %cmp-ge xs)))
(defn = "True if all arguments are structurally equal.

    (= 1 1 1)   → true
    (= [1 2] [1 2])   → true   ; by value, not identity"
  ((a b) (%eq a b))
  ((& xs) (%chain? %eq xs)))
(defn not= "**Deprecated since 0.19.1 — write `(not (= a b))`.** True if the arguments are
not all equal.

    (not= 1 2)  → true

Deprecated because it buys a *spelling*, not a capability: `(not= a b)` is by definition
`(not (= a b))`. The long form is also the faster one — `=` folds into its caller and `not`
inlines, while this wrapper stays a call — and it does not mislead past two arguments:
`(not= 1 2 1)` is `true`, because it negates the whole `=` chain rather than meaning
\"pairwise different\"."
  ((a b) (not (%eq a b)))
  ((& xs) (not (apply = xs))))
;; `%register-meta` rather than the `(meta …)` macro that wraps it: `meta` is defined ~80
;; lines below and the prelude is evaluated top to bottom, so the macro does not exist yet.
;;
;; Three reasons this name is going away, none of them "it is redundant" alone:
;;   1. It buys a spelling. `(not= a b)` IS `(not (= a b))` — the body above says so — and
;;      nothing in the kernel, the compiler or the checker knows the name (no special form,
;;      no primitive, no opcode, no guard). ADR-011's bar for a name is a capability.
;;   2. It is SLOWER than what it abbreviates, and structurally so. `=`'s 2-arg body is a
;;      direct primitive call, so ADR-069's thin-wrapper elision collapses `(= i 7)` to a
;;      `Prim2Slot*`; `not`'s body is a leaf, so the leaf inliner splices it. `not=`'s body
;;      is a NESTED call — the exact shape the `<=` note above says the elision cannot reach,
;;      and not a leaf either — so it stays a boxed `Call` forever and the caller never gets
;;      the inlined upgrade. Measured on a 5M-iteration tail loop: 218 ms vs 132 ms native
;;      (1.65x), 1067 ms vs 771 ms on the VM (1.38x).
;;   3. Its variadic reading is a trap. `(not= 1 2 1)` is TRUE — `=` chains pairwise and
;;      `not=` negates the whole chain, so the name reads "pairwise different" and means
;;      "not all equal". Written out, the scope of the negation is on the page.
;; `:use` takes a symbol, so the diagnostic can only name `not`; the docstring carries the
;; full replacement. Kept defined (and tested) until the removal — deprecation is advisory,
;; so nothing downstream breaks yet.
(%register-meta 'not= [:deprecated "0.19.1" :use 'not])

;; ---- control-flow macros ----
;; These read like special forms but are ordinary macros over `if`/`do`/`let`.
;; The compile pass (macroexpand-all) expands them once, so they cost nothing at
;; runtime while the evaluator's core stays just `if`/`do`/`let`/`fn`/… — policy
;; in Brood, mechanism in Rust (ADR-006/008). There is no `while`: data is
;; immutable and there's no local mutation (ADR-026), so loops are recursion (TCO
;; keeps the stack O(1)) or processes.

(defmacro when (test & body)
  "Evaluate `body` (returning the last) when `test` is truthy, else `nil`.

    (when true :yes)    → :yes
    (when false :yes)   → nil"
  `(if ~test (do ~@body) nil))

(defmacro unless (test & body)
  "Evaluate `body` (returning the last) when `test` is falsy, else `nil`.

    (unless false :yes)   → :yes
    (unless true :yes)    → nil"
  `(if ~test nil (do ~@body)))

;; `defonce` — define only if the name is not already bound. The point is
;; hot-reload: re-evaluating a file (via `system/reload-defs` or `reflect/load`) re-runs every
;; `def…` form, which would reset top-level state and re-create singletons (a
;; fresh `(spawn …)`, a reopened connection) on every save. `defonce` makes the
;; init run *once* — the value survives reload, exactly like Emacs `defvar`.
;; Idiomatic for global state and resources: (defonce *server* (spawn (serve))),
;; (defonce *registry* {}). Plain behaviour stays `defn`/`def`. To force re-init,
;; restart or re-`def` explicitly. (`bound?` returns false on an unbound symbol,
;; so this is safe on first definition — docs/live-editing.md Stage 1.)

;; The name a module-level `def` of `sym` actually BINDS — `sym` prefixed with the
;; loading module's namespace. `defonce`'s bound? check must name the same binding the
;; `def` writes, and inside a module `(def *x* v)` writes `mod/*x*` while a bare quoted
;; `'*x*` is data the resolver never rewrites (it would read at root, never see the
;; binding, and re-def every reload — the bug this fixes). Computed at LOAD time, where
;; `reflect/current-ns` is the module being loaded; a bare/root context (no current-ns) or an
;; already-qualified name passes through, matching `def`.
(defn- %defonce-qualified-name (sym)
  (let (ns (reflect/current-ns))
    (if (or (nil? ns) (includes? (str sym) "/"))
      sym
      (symbol (str (->string ns) "/" (str sym))))))

(defmacro defonce (name val)
  "Bind `name` to `val` only if it isn't already bound, so the value survives
hot-reload (cf. Emacs `defvar`). Once bound, re-evaluating is a no-op; restart
or re-`def` to force re-init. Works for a module-level name: the bound? check is
resolved against the LOADING module's namespace (`%defonce-qualified-name`), the same
binding `def` writes — a bare `(bound? '~name)` would read at root and miss it."
  `(unless (/bound? (%defonce-qualified-name '~name)) (def ~name ~val)))

;; `(comment …)` — the dev-scratch block every Lisp has. Its body is read (so it
;; must still be balanced sexps) but never evaluated, which is the point: a
;; worked example, a REPL snippet, or a disabled call can sit next to the code it
;; documents without being commented out line by line. Brood has no `#_`
;; form-discard reader macro, so this is the only form-level "don't run this".
(defmacro comment (& _body)
  "Ignore the body entirely and return nil — a scratch block for examples and
disabled snippets. The body is still *read*, so it must be balanced sexps; use
`;` for prose or anything that wouldn't parse.

    (comment (this is never evaluated))   → nil"
  nil)

;; `(sig name (params… -> ret))` — a type-signature declaration the advisory
;; checker reads (it parses the type-expression and treats it as `name`'s
;; authoritative signature, ahead of inferred/curated ones). Normally a runtime
;; no-op (expands to `nil`); set BROOD_CONTRACTS=1 to enforce every `(sig …)`
;; as a runtime contract (same as `(sig! …)`) for a dev/test run. See
;; `docs/type-annotations.md`. NOTE: the checker reads the *un-expanded* form, so
;; this macro intentionally discards its arguments.
(defmacro meta (name & clauses)
  "Record stability metadata for `name` (ADR-283) — three independent facts, each optional:

    (meta parse       :since \"0.9.0\")
    (meta old-parse   :deprecated \"0.14.0\" :use 'parse)
    (meta try-this    :beta \"the options map may still change\")

`:since` is documentation — `nest doc` and hover show it, nothing warns. `:deprecated`
makes every use an ADVISORY checker diagnostic naming `:use`'s replacement, so it is
visible without failing a build; suppress a deliberate one with
`(check-allow :deprecated …)`. `:beta` says the surface is not settled yet.

Written beside the definition, like `(sig …)`, and cleared if the name is redefined — a
`def` that rebinds mid-run must not inherit the old name's facts."
  ;; A VECTOR literal, not `(list …)`: a prelude macro template must not emit a bare
  ;; capturable name, or a user module defining `list` would capture it (KI-73). A literal
  ;; is not a name at all, and `%register-meta` reads a list or a vector alike.
  `(%register-meta '~name [~@clauses]))

(defmacro sig (name type)
  "Declare a type signature for `name`, e.g. `(sig area (number -> number))`.
Read by the advisory type checker; a runtime no-op unless `BROOD_CONTRACTS=1`
is set, in which case it installs a runtime contract like `(sig! …)`. Type
grammar: base names (`int` `string` `number` `list` `vector` `map` `fn` `any` …),
arrows `(p… -> r)`, `(list E)`/`(vector E)`, `(or A B)`, and `(& rest-type)`
for variadic tails."
  ;; Always register the declaration on the heap (keyed by the module-qualified
  ;; global name, resolved as `def` would) so the checker treats it as `name`'s
  ;; authoritative signature everywhere — intra-module and cross-module — not just
  ;; in a bare file's per-file ctx. Then keep the existing semantics: a runtime
  ;; no-op, or a `sig!` runtime contract under BROOD_CONTRACTS=1.
  `(do
     ~(if (= (%getenv "BROOD_CONTRACTS") "1") nil `(%register-sig '~name '~type))
     ~(if (= (%getenv "BROOD_CONTRACTS") "1")
        ;; Contracts mode turns this *declaration* into an *action*: `sig!` rebinds
        ;; `name` to a checking wrapper, so the definition must already exist. A
        ;; `sig` written above its `defn` — the natural place, since a signature is
        ;; documentation, and the style the strict sweep adopted across std/ — used
        ;; to abort the whole module load here. It now DEFERS instead: the pending
        ;; contract is queued and installed at the next `provide`, when the module's
        ;; defs all exist (`%contract-defer!` / `%contracts-apply-pending!` in
        ;; tools.blsp — late-bound, so this expansion referencing them from an
        ;; earlier prelude file is fine). In a bare file with no module (no provide)
        ;; an above-defn sig stays a pure declaration, which is what it was before
        ;; contracts mode existed.
        ;; `bound?` on a QUOTED symbol is not namespace-resolved — inside
        ;; `(defmodule path)` it would ask about bare `basename` while the
        ;; definition is `path/basename`, and report "not defined yet" for a
        ;; perfectly-placed sig. `%register-sig` already returns the qualified
        ;; symbol it keyed the declaration under, so ask about *that*. NO `let`
        ;; around this — `sig!` expands to `def`s of a shim `fn`, and a binding
        ;; frame here makes that shim capture a local env, which the prelude
        ;; freeze hard-rejects (KI-81's other half). The defer branch calls
        ;; `%register-sig` a second time instead: cold, idempotent.
        `(if (bound? (%register-sig '~name '~type))
           (sig! ~name ~type)
           (%contract-defer! (%register-sig '~name '~type) '~type))
        nil)))

;; ---- checker suppression: `(check-allow :category form…)` -------------------
;; A form-level opt-out for an advisory lint the author deliberately trips — a
;; non-tail-recursive function written to exercise the deep-recursion path, a
;; redundant `match` clause under test. The reader strips comments before the
;; checker runs, so a `;;`-directive can't reach it; this macro expands to a
;; marker (`%lint-allow`) that survives macroexpansion and that `nest check`
;; reads. A pure runtime no-op — it just yields the wrapped body's value.
;; Recognised categories: `:non-tail-recursion`, `:unreachable-clause`,
;; `:type-mismatch` (a `sig`-declared return/argument the body deliberately
;; violates — e.g. a negative test proving a `sig!` runtime contract throws),
;; `:unbound`, `:unrequired`, `:deprecated`, and `:discarded-catch` (a
;; `(catch e nil)` whose constant is genuinely the answer).
;; Wraps one or many forms (top-level defns or an inner expression).
;; See docs/type-annotations.md.
(defn %lint-allow (category value)
  "Identity on `value` — the runtime side of `check-allow` (a checker marker)."
  value)
(defmacro check-allow (category & body)
  "Suppress an advisory checker lint over the wrapped forms. `category` is a
keyword: `:non-tail-recursion`, `:unreachable-clause`, `:type-mismatch`, or
`:unbound` (globals defined at runtime — a `reflect/eval`-driven `def`, the wasm
`use-native` binding — that the checker cannot see in source). A runtime
no-op; the marker is read only by the type checker (`nest check`)."
  `(%lint-allow ~category (do ~@body)))

;; ---- runtime contracts: `(sig! …)` enforces a signature at call time --------
;; The opt-in *sound* half of the type system (the paper's "strong arrow", done
;; Brood-side). `(sig …)` informs only the checker; `(sig! …)` *also* wraps the
;; function so each argument and the result are checked at run time and a
;; mismatch throws — so a value the static checker trusted can never silently
;; slip through. All policy, no new primitive. See `docs/type-annotations.md`.

; unknown base name → accept
(defn type-matches? (t v)
  "True if value `v` inhabits the (sig …) type-expression `t`. Unknown type
names accept anything, so a contract never throws on a type it can't interpret.

    (type-matches? 'int 5)      → true
    (type-matches? 'string 5)   → false"
  (cond
    (nil? t) (nil? v)
    ; the `nil` type reads as the nil literal
    (pair? t)
      (let (h (first t))
        (cond
          ;; `(is T)` — a type guard's result (ADR-301): the VALUE is a bool; what it
          ;; proves about the argument is the checker's business, not the contract's.
          (%eq h 'is) (bool? v)
          (%eq h 'or) (any? (rest t) (fn (s) (type-matches? s v)))
          (%eq h 'and) (every? (rest t) (fn (s) (type-matches? s v)))
          (%eq h 'not) (not (any? (rest t) (fn (s) (type-matches? s v))))
          (%eq h 'list)
            (and (list? v)
              (let (elem (first (rest t)))
                (or (nil? elem)
                  (every? v (fn (x) (type-matches? elem x))))))
          (%eq h 'vector)
            (and (vector? v)
              (let (elem (first (rest t)))
                (or (nil? elem)
                  (every? v (fn (x) (type-matches? elem x))))))
          (%eq h 'map)
            (and (map? v)
              (let (ktype (first (rest t))
                    vtype (first (rest (rest t))))
                (or (and (nil? ktype) (nil? vtype))
                  (every? (%map-pairs v)
                    (fn (kv)
                      (and (type-matches? ktype (first kv))
                        (type-matches? vtype (second kv))))))))
          (%eq h 'record)
          ;; A field's type may be wrapped `(optional T)` — allowed to
          ;; be absent/nil. Every other field is required: `(get v k)`
          ;; on a missing key is nil, so `type-matches?` on the bare
          ;; field type naturally fails unless that type accepts nil —
          ;; no separate presence check needed.
          ;;
          ;; A record is **closed** unless it opens with `&open` (ADR-264):
          ;; a key it does not declare must be absent. That is what makes a
          ;; record say what a value is *not*, which is what discriminates
          ;; a tagged union — and the contract has to agree with the checker
          ;; about it or `sig!` and `nest check` would disagree on the same
          ;; declaration.
            (let (open? (%eq (second t) '&open)
                  flds (partition (if open? (rest (rest t)) (rest t)) 2))
              (and (map? v)
                (every? flds
                  (fn (field)
                    (let (k (first field)
                          ftype (second field))
                      (if (and (pair? ftype) (%eq (first ftype) 'optional))
                        (or (nil? (get v k))
                          (type-matches? (second ftype) (get v k)))
                        (type-matches? ftype (get v k))))))
                (or open?
                  (every? (%map-pairs v)
                    (fn (kv) (any? flds (fn (field) (%eq (first field) (first kv)))))))))
          (%eq h
            'tuple)
          ;; A fixed-arity positional vector shape (ADR-128): exact
          ;; arity, then each position checked against its own
          ;; declared type.
            (and (vector? v)
              (= (count v) (count (rest t)))
              (every? (range (count v)) (fn (i) (type-matches? (nth (rest t) i) (nth v i)))))
          else true))
    ; arrow param / unknown compound → accept
    (keyword? t) (= t v)
    ; a keyword type-expr is a literal: match it exactly
    (int? t) (= t v)
    ; an int type-expr is a literal too (ADR-117)
    (bool? t) (= t v)
    ; likewise for bool and string (ADR-120)
    (string? t) (= t v)
    (%eq t 'any) true
    (%eq t 'number) (number? v)
    (%eq t 'int) (int? v)
    (%eq t 'float) (float? v)
    (%eq t 'decimal) (decimal? v)
    (%eq t 'ratio) (ratio? v)
    (%eq t 'string) (string? v)
    (%eq t 'bool) (bool? v)
    (%eq t 'keyword) (keyword? v)
    (%eq t 'symbol) (symbol? v)
    (%eq t 'pair) (pair? v)
    (%eq t 'map) (map? v)
    (%eq t 'fn) (fn? v)
    (%eq t 'list) (list? v)
    (%eq t 'vector) (vector? v)
    else true))
(defn- %contract-check-args (name ptypes args i)
  "Throw if any argument fails its declared type. Pairwise over the overlap —
arity itself is the static checker's job."
  (when (and (pair? ptypes) (pair? args))
    (unless (type-matches? (first ptypes) (first args))
      (throw (str name
               ": argument "
               i
               " expected "
               (first ptypes)
               ", got "
               (type-of (first args))
               " ("
               (pr-str (first args))
               ")")))
    (%contract-check-args name (rest ptypes) (rest args) (inc i))))

(defn- %contract-check-rest (name rtype args)
  "Throw if any rest argument fails its declared rest type."
  (when (pair? args)
    (unless (type-matches? rtype (first args))
      (throw (str name
               ": rest argument expected "
               rtype
               ", got "
               (type-of (first args))
               " ("
               (pr-str (first args))
               ")")))
    (%contract-check-rest name rtype (rest args))))

(defn- %sig-pos (xs x n)
  "Position of `x` in the list `xs` (from index `n`), or -1. Expansion-time helper
for `sig!` that predates `index-of` in the prelude's own load order."
  (cond
    (nil? xs) -1
    (%eq (first xs) x) n
    else (%sig-pos (rest xs) x (%add n 1))))

(defn- %sig-rev (xs acc)
  "`xs` reversed onto `acc`. Expansion-time helper — see `%sig-take`."
  (if (nil? xs) acc (%sig-rev (rest xs) (cons (first xs) acc))))

(defn- %sig-take-acc (n xs acc)
  (if (or (%le n 0) (nil? xs))
    (%sig-rev acc nil)
    (%sig-take-acc (%sub n 1) (rest xs) (cons (first xs) acc))))

(defn- %sig-take (n xs)
  "The first `n` elements of `xs`. Expansion-time helper for `sig!`, for the same
reason `%sig-pos` is one: this runs while the PRELUDE is being expanded, and
`take` is defined in `seq.blsp`, which the prelude concatenates AFTER this file
(`core → predicates → map → control → match → process → seq → string → tools`).
So the name is perfectly ordinary at run time and simply does not exist yet here.
Calling it made `BROOD_CONTRACTS=1` panic — `prelude expand: unbound symbol:
take` — on every COLD boot cache, i.e. the first run after any rebuild, while a
warm cache skipped expansion and looked fine (KI-81)."
  (%sig-take-acc n xs nil))

(defn- %sig-drop (n xs)
  "`xs` without its first `n` elements. Expansion-time helper for `sig!` — see
`%sig-take` for why the general `drop` cannot be called here."
  (if (or (%le n 0) (nil? xs)) xs (%sig-drop (%sub n 1) (rest xs))))

(defn- %sig-nth (xs n)
  "The `n`th element of `xs`, or nil. Expansion-time helper for `sig!` — see
`%sig-take` for why the general `nth` cannot be called here."
  (cond
    (nil? xs) nil
    (%le n 0) (first xs)
    else (%sig-nth (rest xs) (%sub n 1))))

(defn- %sig-gensyms-acc (n acc)
  (if (%le n 0) acc (%sig-gensyms-acc (%sub n 1) (cons (gensym "arg") acc))))

(defn- %sig-gensyms (n)
  "A list of `n` fresh argument symbols. Expansion-time helper for `sig!`,
replacing `(map (fn (_) (gensym \"arg\")) (range (count ptypes)))` — `map`,
`range` and `count` are all as unreachable during prelude expansion as `take`
was."
  (%sig-gensyms-acc n nil))

(defmacro sig! (name type)
  "Like `(sig …)` but also installs a *runtime* contract: each argument and the
result are checked at every call and a mismatch throws (an opt-in 'strong
arrow'). Place it AFTER the function's definition — it rebinds `name`, preserving
arity (so introspection and the reload-arity check are undisturbed). The checker
reads it exactly like `(sig …)`. Supports a `&` rest marker:
`(sig! f (int & number -> string))` checks fixed args then every rest arg, and an
`&optional` marker: `(sig! f (string int &optional string -> string))` checks each
optional that was actually supplied and leaves the callee's own defaults alone. That
one shim IS variadic, so `arity-of` reports `2+` where the function reads `2-3`."
  ;; Register the declaration on the heap for the checker (keyed by the
  ;; module-qualified global name) — same as `(sig …)` — then install the runtime
  ;; contract. The `(do …)` keeps both effects at top level.
  `(do
     (%register-sig '~name '~type)
     ~(let (i (%sig-pos type '-> 0))
        (if (%lt i 0)
          ; not a (… -> …) type — nothing to enforce
          nil
          (let (ptypes (%sig-take i type)
                rtype (%sig-nth type (%add i 1))
                amp-pos (%sig-pos ptypes '& 0)
                opt-pos (%sig-pos ptypes '&optional 0))
            (cond
              ;; `(fixed… &optional o… -> ret)`. Checked before the two below because an
              ;; `&optional` list has neither an `&` nor a fixed count: read as fixed it
              ;; counts the MARKER as a parameter, which is how `(sig pad-left (string int
              ;; &optional string -> string))` armed a 4-arity shim over a 2-3-arity
              ;; function and made every `(string/pad-left s 10)` an arity error under
              ;; BROOD_CONTRACTS=1. The shim is variadic and `apply`s only the arguments it
              ;; actually received, so the callee's own defaults still apply — passing an
              ;; explicit `nil` for an absent optional would override them. The cost is that
              ;; `arity-of` reports `2+` rather than `2-3` for the wrapped name, which the
              ;; reload check notes on stderr; contracts mode is a dev switch and the
              ;; alternative (a sentinel default per optional) buys accuracy nothing reads.
              (%le 0 opt-pos)
                (let (fixed-ptypes (%sig-take opt-pos ptypes)
                      opt-ptypes (%sig-drop (%add opt-pos 1) ptypes)
                      fixed-params (%sig-gensyms opt-pos)
                      more (gensym "more")
                      orig (gensym "orig")
                      r (gensym "ret"))
                  `(do
                     (def ~orig ~name)
                     (def ~name
                       (fn (~@fixed-params & ~more)
                         (%contract-check-args '~name '~fixed-ptypes (list ~@fixed-params) 1)
                         (%contract-check-args '~name '~opt-ptypes ~more ~(%add opt-pos 1))
                         (let (~r (apply ~orig (append (list ~@fixed-params) ~more)))
                           (unless (type-matches? '~rtype ~r)
                             (throw (str '~name
                                      ": result expected "
                                      '~rtype
                                      ", got "
                                      (type-of ~r)
                                      " ("
                                      (pr-str ~r)
                                      ")")))
                           ~r)))))
              (%lt amp-pos 0)
              ;; fixed arity
                (let (params (%sig-gensyms i)
                      orig (gensym "orig")
                      r (gensym "ret"))
                  ;; Hold the original in a GLOBAL, not a `let`-bound local. A shim written
                  ;; as `(let (orig name) (fn …))` closes over a local frame, and the prelude's
                  ;; freeze step rejects exactly that ("shared closures must capture the global
                  ;; env") — so arming contracts over the prelude's own sigs aborted the boot
                  ;; before this could check anything. The name is a gensym, so nothing can
                  ;; reach or rebind it, and the shim now captures only globals (KI-81).
                  `(do
                     (def ~orig ~name)
                     (def ~name
                       (fn (~@params)
                         (%contract-check-args '~name '~ptypes (list ~@params) 1)
                         (let (~r (~orig ~@params))
                           (unless (type-matches? '~rtype ~r)
                             (throw (str '~name
                                      ": result expected "
                                      '~rtype
                                      ", got "
                                      (type-of ~r)
                                      " ("
                                      (pr-str ~r)
                                      ")")))
                           ~r)))))
              ;; variadic: (fixed… & rest-type -> ret)
              else
                (let (fixed-ptypes (%sig-take amp-pos ptypes)
                      rest-ptype (%sig-nth ptypes (%add amp-pos 1))
                      fixed-params (%sig-gensyms amp-pos)
                      rest-param (gensym "rest")
                      orig (gensym "orig")
                      r (gensym "ret"))
                  ;; Same global-capture reasoning as the fixed-arity shim above.
                  `(do
                     (def ~orig ~name)
                     (def ~name
                       (fn (~@fixed-params & ~rest-param)
                         (%contract-check-args '~name '~fixed-ptypes (list ~@fixed-params) 1)
                         (%contract-check-rest '~name '~rest-ptype ~rest-param)
                         (let (~r (apply ~orig (append (list ~@fixed-params) ~rest-param)))
                           (unless (type-matches? '~rtype ~r)
                             (throw (str '~name
                                      ": result expected "
                                      '~rtype
                                      ", got "
                                      (type-of ~r)
                                      " ("
                                      (pr-str ~r)
                                      ")")))
                           ~r)))))))))))

;; `and`/`or` short-circuit left-to-right and return the deciding value, with
;; each subexpression evaluated at most once (a gensym holds it across the test).
(defmacro and (& xs)
  "Logical AND: evaluate left-to-right, short-circuiting on the first falsy value (which it returns); `true` if none. Each argument is evaluated at most once.

    (and 1 2)       → 2      ; the last value, when nothing is falsy
    (and 1 nil 3)   → nil    ; the falsy value itself — 3 is never evaluated
    (and)           → true"
  (if (empty? xs)
    true
    (if (empty? (rest xs))
      (first xs)
      (let (g (gensym "and")) `(let (~g ~(first xs)) (if ~g (and ~@(rest xs)) ~g))))))

(defmacro or (& xs)
  "Logical OR: evaluate left-to-right, short-circuiting on the first truthy value (which it returns); `nil` if none. Each argument is evaluated at most once.

    (or nil :fallback)   → :fallback
    (or false 0)         → 0     ; 0 is truthy — only nil and false are falsy
    (or nil nil)         → nil"
  (if (empty? xs)
    nil
    (if (empty? (rest xs))
      (first xs)
      (let (g (gensym "or")) `(let (~g ~(first xs)) (if ~g ~g (or ~@(rest xs))))))))

;; cond: flat test/expr pairs (ADR-004); a final `else` is the catch-all.
;;
;; `else` needs the special case below: a bare symbol would otherwise be an unbound
;; reference. `:else` never did — a keyword is self-evaluating and truthy, so it
;; already worked the way `true` or any other truthy test does. Special-casing it
;; too made the language carry a second blessed spelling for no gain, so that case
;; is gone (2026-07-26). `(cond … :else x)` still returns `x` — as an ordinary
;; truthy test, via `if` — but `else` is the spelling the language knows.
;; Bootstrap helper for cond's guard: walks clauses two at a time, returning
;; the orphan last element when count is odd, nil when even. Uses only
;; `if`/`empty?`/`first`/`rest` — all kernel primitives — so it's safe to call
;; during prelude loading before `odd?`/`count`/`last` are defined.
(defn- %cond-orphan (clauses)
  (if (empty? clauses)
    nil
    (if (empty? (rest clauses))
      (first clauses)
      (%cond-orphan (rest (rest clauses))))))

(defmacro cond (& clauses)
  "Multi-way branch over `test expr` pairs: return the `expr` of the first truthy `test`. A final `else` test always matches; `nil` if none do.

    (cond (> 2 1) :yes else :no)   → :yes
    (cond false :a else :b)        → :b
    (cond false :a)                → nil   ; nothing matched, and no else"
  (let (orphan (%cond-orphan clauses))
    (if (and (not (nil? orphan)) (not (%eq orphan 'else)))
      (error "cond: odd number of clauses — expected test/expression pairs. "
        "Did you forget an expression for '"
        (pr-str orphan)
        "'?")
      (if (empty? clauses)
        nil
        (let (test (first clauses) expr (first (rest clauses)) more (rest (rest clauses)))
          ;; compare with the `%eq` primitive, not the variadic `=` — `=` builds a
          ;; lambda, and doing that *at expansion time* during the prelude's own
          ;; compile pass would strand a local-env closure (breaks the freeze).
          (if (%eq test 'else) expr `(if ~test ~expr (cond ~@more))))))))

;; ---- macro expansion --------------------------------------------------------
;; Fully expand `form`'s head macro by iterating the single-step `macroexpand-1`
;; primitive to a fixpoint. Written in Brood, not Rust (ADR-064): the loop's state
;; is an env-bound local the evaluator already roots, so it can't strand a handle
;; across a GC safepoint the way a hand-rooted Rust loop could. `macroexpand-1` is
;; the irreducible single-shot primitive (one expansion, holding nothing across
;; its `apply`); this just drives it. Tail-recursive, so it is O(1) stack.
;; Bounded (kernel audit): a macro that forever expands to another macro call
;; would otherwise spin here. Mirrors the kernel expander's own cap
;; (`MAX_EXPAND_ROUNDS` in eval/macros.rs) — keep the two in step.
(def- %macroexpand-max-rounds 256)

(defn- %macroexpand-loop (form n)
  (if (= n 0)
    (error "macroexpand: no fixpoint after "
      %macroexpand-max-rounds " rounds (a macro that expands to itself?)")
    (let (stepped (macroexpand-1 form))
      (if (= stepped form) form (%macroexpand-loop stepped (- n 1))))))

(defn macroexpand (form)
  "Repeatedly expand `form`'s head macro until the head is no longer a macro call.

    (macroexpand '(when true 1))   → (if true (do 1) nil)"
  (%macroexpand-loop form %macroexpand-max-rounds))
