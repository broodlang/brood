;; ---- spawn: run an expression as a new green process ------------------------
;; (spawn expr) runs `expr` in a fresh process and returns its pid. The expression
;; is wrapped in a 0-arg thunk, so its free *locals* are captured lexically (the
;; closure carries them) and its free *globals* resolve in the child — which is why
;; the thunk is shippable to another node (a closure serialises as data; see
;; docs/decisions.md). Note `(self)` inside `expr` is the *child's* pid: to hand the
;; parent's pid in, capture it first — `(let (me (self)) (spawn (work me)))`.
;; `spawn` has two shapes:
;;   (spawn expr)          → anonymous; always creates a fresh process.
;;   (spawn name expr)     → **named & idempotent**. If a process is already
;;                            registered under `name` (a keyword/symbol) and
;;                            is still alive, the call is a no-op and returns
;;                            the existing pid; `expr` is never evaluated.
;;                            Otherwise spawns fresh and registers the new
;;                            pid under `name`.
;;
;; The named form is the replacement for the old `(defonce *worker* (spawn
;; (worker)))` hot-reload pattern (ADR-039). A file containing
;; `(spawn :worker (worker))` reloaded by a hot-reload supervisor sees the
;; name is alive and does nothing — the running worker keeps going with its
;; current state, picking up the new code via the next global lookup of
;; `worker`. When the process dies, its registered name is reaped automatically
;; (`process::deregister` calls `dist::unregister_dead_pid`), so a fresh
;; reload spawns again — no stale entries.
;; spawn — two shapes via arity dispatch:
;;   (spawn expr)         → (%spawn (fn () expr))             — anonymous
;;   (spawn name expr)    → (%spawn-named name (fn () expr))  — idempotent on name
;; The named form replaces the `defonce *worker* (spawn …)` hot-reload
;; pattern (ADR-039). The reloaded file sees the name is alive and the
;; second `(spawn :worker …)` is a no-op — the running worker keeps going,
;; picking up the new code via the next global lookup. When the process
;; dies, its registered name is reaped (`process::deregister` →
;; `dist::unregister_dead_pid`), so a later reload re-spawns cleanly.
;; A literal zero-arg lambda `(fn () …)` is *already* a process thunk. Re-wrapping
;; it (`(fn () (fn () …))`) would make the process merely build a closure and
;; discard it — a silent no-op. So pass such a form through unwrapped:
;; `(spawn (fn () body))` and `(spawn body)` then mean the same. (The dual footgun —
;; a bare function *name* like `(spawn worker)`, which used to yield the closure and
;; exit — is handled by `spawn-body-thunk` below, which wraps a symbol as a *call*.)
(defn- spawn-thunk-form?
  (form)
  (and (list? form)
    (not (empty? form))
    (= (first form) 'fn)
    (let (params (second form)) (and (list? params) (empty? params)))))

;; The process-body thunk a `spawn`-family macro wraps its body form in. Three cases,
;; each closing off a footgun so no `spawn` shape can silently do nothing:
;;   - a literal `(fn () …)` is already the thunk → pass it through (re-wrapping it
;;     would build-and-discard a closure);
;;   - a **bare symbol** is a function *name* → wrap it as a CALL `(fn () (name))`,
;;     so `(spawn worker)` runs `worker` (Erlang's `spawn(fun name/0)`) instead of
;;     yielding the closure and exiting. A process body that merely *evaluates* a
;;     symbol has no effect, so this is never a legitimate use — the call either
;;     works or raises a loud "not callable", never a silent no-op;
;;   - anything else is the body expression → `(fn () expr)`.
(defn- spawn-body-thunk
  (form)
  (cond
    (spawn-thunk-form? form) form
    (symbol? form) `(fn () (~form))
    else `(fn () ~form)))

(defmacro spawn (head & more)
  "Run an expression in a new green process; returns its pid. Shapes:
  - `(spawn expr)` — anonymous; `expr` is the process body.
  - `(spawn (fn () expr))` — same as above (a zero-arg lambda is the body too, so
    the Erlang `spawn(fun() -> … end)` habit just works, no silent no-op).
  - `(spawn fn-name)` — a bare function name is **called**: `(spawn worker)` runs
    `(worker)` (Erlang's `spawn(fun name/0)`), not `worker`-then-exit.
  - `(spawn name expr)` — named & idempotent: returns the existing pid if
    a live process is already registered under `name`. The hot-reload-friendly
    form (reloading the file doesn't fire a second worker).

  Erlang **let-it-crash** (`spawn/1`): an uncaught throw kills the process and
  any monitors see `[:down pid [:error {:kind :message … :trace}]]` immediately
  (the reason carries the structured error map, call trace included)."
  ;; Param name is `more` (not `rest`) so the body can still call the
  ;; prelude's `rest` function without param-shadowing itself.
  (if (empty? more)
    `(%spawn ~(spawn-body-thunk head))
    (if (empty? (rest more))
      `(%spawn-named ~head ~(spawn-body-thunk (first more)))
      (throw "spawn: expected (spawn expr) or (spawn name expr)"))))

(defmacro spawn-link (expr)
  "Spawn a new green process running `expr` and `link` it to the caller **atomically**
(Erlang `spawn_link`, ADR-067) — returns its pid. The link is symmetric: if either
process dies abnormally the other is taken down too (or receives a trappable `[:EXIT …]`
if it `(trap-exit true)`'d). The link is established *before* the child runs, so even an
instant exit reaches the caller with its **true** reason — unlike a separate
`(let (p (spawn expr)) (link p) p)`, where a child that exits in the gap is linked dead
and reports `:noproc` (losing `:normal`). Supervised children should use this so a fast
`:normal` exit isn't misread as a crash. A zero-arg lambda `(fn () …)` body is
passed through (not re-wrapped), like `spawn`."
  `(%spawn-link ~(spawn-body-thunk expr)))

;; A long-lived `:remote-spawn` server: the receiver-side machinery behind the
;; `remote-spawn` macro. Receives `[:run thunk]` messages and applies the thunk
;; in a fresh local process — that's "the receiver runs my code". A permanent
;; loop so it stays a stable address; the closure crosses the wire as data
;; (ADR-033), so any peer node running the same prelude can run it.
(defn- remote-spawn-server
  ()
  (receive
    ([:run thunk] (do (spawn (thunk)) (remote-spawn-server)))
    ;; Synchronous variant: spawn the thunk and reply with the child's pid (a
    ;; remote pid, carrying this node's `name@host`) to the requester, keyed by
    ;; the ref it supplied so its `receive` can pin the reply.
    ([:run-sync thunk from r] (do (send from [:spawned r (spawn (thunk))]) (remote-spawn-server)))
    (_ (remote-spawn-server))))

(defn start-remote-spawn ()
  "Idempotently start + register the local `:remote-spawn` server so peers can `(remote-spawn this-node …)` against this node. Safe to call multiple times — only the first call spawns a server. Typically called once at startup, after `(node-start …)`."
  (when (nil? (whereis :remote-spawn))
    (register :remote-spawn (spawn (remote-spawn-server))))
  nil)

(defmacro remote-spawn (node expr)
  "Run `expr` in a fresh process on `node` (a node-name keyword/symbol — `(node-name)` for the local node, or a connected peer's). Returns `nil`; the spawned process lives on the remote and runs detached (capture the parent's pid in a `let` and `(send parent (self))` from inside `expr` if you need its pid). `expr` ships as a closure (ADR-033) — free locals ride along, free globals re-resolve on the receiver. A zero-arg lambda `(fn () …)` body is passed through (not re-wrapped), like `spawn`. The **receiver** must have called `(start-remote-spawn)` (typically right after `node-start`); the macro itself does no setup on either side."
  `(do
     (send {:name :remote-spawn :node ~node}
       [:run ~(spawn-body-thunk expr)])
     nil))

(defmacro remote-spawn-sync (node expr)
  "Like `remote-spawn`, but **synchronous**: run `expr` in a fresh process on
`node` and return the child's pid (a remote pid carrying `node`'s `name@host`).
Blocks until the receiver replies (5s timeout → throws). The receiver must have
called `(start-remote-spawn)`. A zero-arg lambda `(fn () …)` body is passed
through (not re-wrapped), like `spawn`. Use this when you need the child's pid —
e.g. to `monitor`/`link` a remote child — rather than fire-and-forget."
  `(let (r# (ref))
     (send {:name :remote-spawn :node ~node}
       [:run-sync ~(spawn-body-thunk expr) (self) r#])
     (receive
       ([:spawned got# child#] :when (= got# r#) child#)
       (after 5000
         (throw "remote-spawn-sync: no reply (is start-remote-spawn running on the peer?)")))))

;; ---- node identity: name-addressing + the shared cookie (ADR-068) ----------
;; A node is addressed by NAME on the local machine (a Unix-domain socket — no
;; port to pick) and by "name@host:port" across machines (TCP). The shared secret
;; lives in ~/.config/brood/cookie, auto-generated on first use. All of this is
;; policy in Brood over the %node-listen / %node-connect / random-token /
;; spit-private primitives — the kernel only carries bytes.

(defn- node-config-dir
  ()
  (str (or (getenv "XDG_CONFIG_HOME") (str (getenv "HOME") "/.config")) "/brood"))

(defn- node-cookie-path () (str (node-config-dir) "/cookie"))

;; Strip trailing newlines so a hand-edited cookie file (or one written by a
;; tool that appends "\n") still matches the bytes we minted.
(defn- node-chomp
  (s)
  (let (n (string/length s))
    (if (and (> n 0) (= (string/substring s (dec n) n) "\n"))
      (node-chomp (string/substring s 0 (dec n)))
      s)))

(defn node-cookie ()
  "The shared secret authenticating node links, resolved as: `$BROOD_COOKIE` →
`~/.config/brood/cookie` → freshly generated and persisted (0600). All your nodes
on this machine share one cookie, Erlang-style; set `$BROOD_COOKIE` to override."
  (or (getenv "BROOD_COOKIE")
    (let (path (node-cookie-path))
      (if (file/exists? path)
        (node-chomp (file/slurp path))
        (let (secret (random-token 32))
          (file/spit-private path secret)
          secret)))))

;; The per-user dir holding local node sockets. $XDG_RUNTIME_DIR is the right
;; home (tmpfs, cleared on logout); fall back to /tmp/brood-<user> when a bare /
;; cron / ssh session leaves it unset.
(defn- node-runtime-dir
  ()
  (str (or (getenv "XDG_RUNTIME_DIR")
         (str "/tmp/brood-" (or (getenv "USER") (getenv "LOGNAME") "shared")))
    "/brood"))

(defn- node-socket-path (s) (str (node-runtime-dir) "/" s ".sock"))

;; Index of the first "@" in s, or -1. No string-split primitive — and a node
;; spec only ever has the one separator — so a small char scan is plenty.
(defn- node-at
  (s i n)
  (cond
    (>= i n) -1
    (= (string/substring s i (inc i)) "@") i
    else (node-at s (inc i) n)))

;; Last index of `:` in s (or -1) — needed to split "name@host:port" into the
;; node name "name@host" and the port, IPv6-host-safe (the port colon is last).
(defn- node-last-colon
  (s i n last)
  (cond
    (>= i n) last
    (= (string/substring s i (inc i)) ":") (node-last-colon s (inc i) n i)
    else (node-last-colon s (inc i) n last)))

;; The bare name-part of a node name (before any `@`). Used for the local Unix
;; socket filename — the socket is same-machine, so the host qualifier is
;; identity only, not part of the path.
(defn- node-name-part
  (s)
  (let (at (node-at s 0 (string/length s)))
    (if (>= at 0) (string/substring s 0 at) s)))

;; The host part of a "host:port" address (everything before the last colon),
;; IPv6-safe. So a TCP node's name host == the host peers dial, keeping
;; `connect`/`reconnect` name-derivation consistent with the node's identity.
(defn- node-addr-host
  (addr)
  (let (lc (node-last-colon addr 0 (string/length addr) -1))
    (if (>= lc 0) (string/substring addr 0 lc) addr)))

;; Qualify a node name to `name@host` (ADR-073), Erlang-style:
;;   - already `name@host` → verbatim (an explicit long/FQDN name);
;;   - TCP node (addr given) → `name@<addr-host>`, so it matches how peers reach it;
;;   - local Unix node → `name@<short hostname>`.
;; The result is the node's global identity, carried in every pid.
(defn- node-qualify
  (nm addr)
  (let (s (name nm))
    (cond
      (>= (node-at s 0 (string/length s)) 0) (keyword s)
      (nil? addr) (keyword (str s "@" (hostname)))
      else (keyword (str s "@" (node-addr-host addr))))))

(defn node-start (nm &optional addr cookie)
  "Start this runtime as a node so peers can reach it. The node's identity is
`name@host` (ADR-073): a bare `name` becomes `name@host` where `host` is the
listen address's host for a TCP node, or this machine's short `(hostname)` for a
local node; pass an already-qualified `:name@host` to override (a long/FQDN name).
`(node-start name)` listens on a local Unix-domain socket (no port) — the common
same-machine case; `(node-start name \"host:port\")` listens over TCP for remote
peers. The cookie defaults to `(node-cookie)`. Returns the qualified node name.
Errors if this runtime is already a node."
  (%node-listen (node-qualify nm addr)
    (if (nil? addr)
      (str "unix:" (node-socket-path (node-name-part (name nm))))
      (str "tcp:" addr))
    (or cookie (node-cookie))))

(defn connect (spec)
  "Link to a peer node. `(connect \"name\")` dials a local node by name over its
Unix socket; `(connect \"name@host:port\")` dials a remote node over TCP. Cookie-
authenticated with this runtime's `(node-cookie)`. Returns the peer's authoritative
`name@host` node name (from the handshake) — address the peer with that value
(`{:name … :node <that>}`), not a bare literal. This runtime must already be a
node — call `(node-start …)` first."
  (when (= (node-name) :nonode)
    (error "connect: this runtime is not a node yet — call (node-start name) first"))
  (let (n (string/length spec)
        at (node-at spec 0 n))
    (if (< at 0)
      ;; Bare name → local Unix node. The peer's real name is `name@thishost`;
      ;; pass that as the claimed name (the handshake confirms it).
      (%node-connect (keyword (str spec "@" (hostname)))
        (str "unix:" (node-socket-path spec)))
      ;; Qualified → remote TCP: "name@host:port". The node name is everything
      ;; before the (last) port colon; the dial address is everything after `@`.
      (let (lc (node-last-colon spec 0 n -1))
        (when (<= lc at)
          (error "connect: a remote node needs \"name@host:port\" (a bare name is local), got "
            spec))
        (%node-connect (keyword (string/substring spec 0 lc))
          (str "tcp:" (string/substring spec (inc at) n)))))))

(defn node-also-listen (&optional addr)
  "Add another listener to this (already-started) node so it serves several
transports at once — **dual-listen** (ADR-074). `(node-also-listen)` opens the
local Unix socket (reachable by name); `(node-also-listen \"host:port\")` opens a
TCP endpoint (reachable remotely). Both share the node's identity + cookie. The
shape behind a local+remote editor daemon — e.g. `(node-start :ed@host
\"0.0.0.0:9001\")` then `(node-also-listen)` is reachable as `(connect \"ed\")`
locally and `(connect \"ed@host:9001\")` from another machine. Errors if this
runtime isn't a node yet."
  (when (= (node-name) :nonode)
    (error "node-also-listen: this runtime is not a node yet — call (node-start name) first"))
  (%node-also-listen (if (nil? addr)
                       (str "unix:" (node-socket-path (node-name-part (name (node-name)))))
                       (str "tcp:" addr))))

;; ---- sleep: park on the scheduler timer (policy in Brood) ---------------
;; Sleep `ms` milliseconds in the current process. A bare `(receive (after ms …))`
;; would *consume* the next queued message — an empty clause list matches anything,
;; so `%receive` grabs whatever is in the mailbox and returns immediately instead of
;; waiting. We pin a fresh, unforgeable `(ref)` as the only real clause (`~never`):
;; no message can ever match it, so selective receive leaves every real message
;; queued and the timeout always fires. Parks the green process on the scheduler's
;; timer (it does NOT block a worker thread) — which is why sleep is pure Brood
;; rather than a Rust primitive.
(defn sleep (ms)
  "Park the current process for `ms` milliseconds without touching its mailbox — every queued message stays queued. Parks on the scheduler timer; it does not block a worker thread."
  (let (never (ref)) (receive (^never nil) (after ms nil))))

;; ---- timers: send-after / send-interval / cancel-timer (Erlang parity) -----
;; Pure Brood policy: a timer is a tiny green process parked on the scheduler's
;; timer wheel (the same mechanism `sleep` rides), so a pending timer costs no
;; worker thread. The handle is the timer's pid — inspectable with
;; `process-info`, cancellable with `cancel-timer` (a hard exit, so it stops
;; even mid-fire).

(defn send-after (ms pid msg)
  "Send `msg` to `pid` after `ms` milliseconds (Erlang `send_after/3` — same
argument order). Returns a timer handle; `(cancel-timer h)` stops it if it
hasn't fired. One-shot; fires even if `pid` is already dead (the send is then
a silent no-op, like any send to a dead process)."
  (spawn (do (sleep ms) (send pid msg))))

(defn send-interval (ms pid msg)
  "Send `msg` to `pid` every `ms` milliseconds (Erlang `timer:send_interval/3`)
until cancelled. Returns a timer handle for `(cancel-timer h)`. Self-cleaning:
the timer monitors `pid` and exits when it dies, so a forgotten interval can't
tick against a dead process forever."
  (spawn
    (let (target pid interval ms payload msg)
      (monitor target)
      (letrec (tick (fn ()
                      (receive
                        ; target died — stop ticking
                        ([:down _ ^target _] nil)
                        (after interval (do (send target payload) (tick))))))
        (tick)))))

(defn cancel-timer (timer)
  "Cancel a `send-after`/`send-interval` timer by its handle. Idempotent (a
fired or already-cancelled timer is a dead process; the exit is a no-op).
Returns nil. Note: like Erlang, cancellation races an in-flight fire — a
message already sent stays sent."
  (exit timer :kill)
  nil)

;; Node-link auto-reconnect moved to `std/net/reconnect` (2026-07-18):
;; `(reconnect/watch "name@host:port")` — the reference loads the module —
;; exponential backoff, [:nodeup]/[:nodedown] subscriber events, idempotent
;; named watchers. It supersedes the old prelude `ensure-link`.

;; ---- receive: selective, pattern-matched message receipt --------------------
;; (receive clause...) where each clause is (pattern [:when guard] body...), with an
;; optional trailing (after ms body...) timeout clause. Reuses the match compiler
;; (match-build-from) to build a *matcher* fn: given a message it returns the clause
;; body as a thunk on a match, or nil on no match. The %receive primitive runs that
;; over the mailbox — scanning in order, removing+running the first match, leaving
;; non-matching messages queued (true Erlang selective receive).
;;
;;   (receive
;;     ([:say text]      (println text))
;;     (n :when (int? n) (handle n))
;;     (after 5000       (throw [:timeout])))   ; catchable via try/catch
;;
;; (receive) with no clauses blocks for the next message and returns it.
;; (after 0 ...) is a non-blocking poll; (after ms>0 ...) waits up to ms.

;; The bodies do NOT live in the matcher. The matcher's job is only to pick a clause
;; and hand back what that clause's pattern bound; the body itself is emitted at the
;; *call site* (see `receive` below). Two reasons, both measured:
;;
;;   * A `(fn () body…)` thunk cost a closure + captured-env allocation and a second
;;     closure activation on every received message (~235 ns/message against ~50 ns
;;     for the small-vector protocol used instead).
;;   * `Inst::MakeClosure` is not in the JIT subset, so building that thunk made the
;;     WHOLE matcher arm ineligible for the JIT — the hot message path ran with no
;;     native code at all. A vector literal (`Inst::MakeVector`) is in the subset.
;;
;; Emitting the body at the call site also puts it in the owning arm's bytecode, so a
;; receive loop's `(recur …)`/self-call is an ordinary tail call in that arm rather
;; than a call through a thunk — Erlang's "receive clauses compile into the enclosing
;; function", reached from the Brood side.

;; The variables a clause's pattern binds, de-duplicated: a non-linear pattern (`[a a]`)
;; lists `a` twice, but binds it once (the repeat compiles to an equality check).
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- receive-dedupe
    (vars seen)
    (cond
      (empty? vars) nil
      (match-member? (first vars) seen) (receive-dedupe (rest vars) seen)
      else (cons (first vars) (receive-dedupe (rest vars) (cons (first vars) seen))))))
(defn- receive-clause-vars (pat) (receive-dedupe (pattern-vars pat) nil))

;; Pair each clause with the variables its pattern binds and its index, ONCE. Both
;; halves below (the matcher's result vector and the call site's rebinding) need that
;; same list in that same order, and `pattern-vars` walks the whole pattern — so
;; deriving them from a shared prep keeps expansion to one walk per clause instead of
;; two. Shape: `[clause vars idx]`.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- receive-prep
    (clauses idx)
    (if (empty? clauses)
      nil
      (cons [(first clauses) (receive-clause-vars (first (first clauses))) idx]
        (receive-prep (rest clauses) (+ idx 1))))))

;; Replace a clause's body with `[idx var…]` — the clause's index plus the values its
;; pattern bound. Keeps the :when guard in place, so the match compiler still gates on
;; it and the guard still runs exactly once, during the scan.
(defn- receive-result-clause
  (prep)
  (let (clause (nth prep 0)
        vars (nth prep 1)
        idx (nth prep 2)
        pat (first clause)
        more (rest clause))
    (if (= (first more) :when)
      `(~pat :when ~(second more) [~idx ~@vars])
      `(~pat [~idx ~@vars]))))

;; `(v0 (nth r 1) v1 (nth r 2) …)` — the flat `let` binding list that unpacks the
;; matcher's result vector back into the clause's pattern variables.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- receive-binds
    (vars r i)
    (if (empty? vars)
      nil
      (cons (first vars)
        (cons `(nth ~r ~i) (receive-binds (rest vars) r (+ i 1)))))))

;; One clause's call-site code: rebind its pattern variables from the result vector,
;; then run its body.
(defn- receive-body-code
  (prep r)
  (let (clause (nth prep 0)
        more (rest clause)
        body (if (= (first more) :when) (rest (rest more)) more)
        binds (receive-binds (nth prep 1) r 1))
    (if (empty? binds) `(do ~@body) `(let ~binds ~@body))))

;; The call-site dispatch: `(if (= (nth r 0) 0) body0 (if (= (nth r 0) 1) body1 …))`.
;; The last clause is reached by elimination (%receive only ever returns a result a
;; clause matched), so it needs no test — and a single-clause receive, the common
;; shape, collapses to its body with no dispatch at all. Every body sits in tail
;; position, so a receive loop stays O(1) stack.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- receive-dispatch
    (preps r)
    (if (empty? (rest preps))
      (receive-body-code (first preps) r)
      `(if (= (nth ~r 0) ~(nth (first preps) 2))
         ~(receive-body-code (first preps) r)
         ~(receive-dispatch (rest preps) r)))))

;; Walk the clause list and error if an `(after ...)` clause appears before the last
;; position — a non-last `after` would silently become a pattern clause matching the
;; symbol `after`, which is almost certainly a mistake.
(defn- receive-check-after
  (clauses)
  (if (or (empty? clauses) (empty? (rest clauses)))
    nil
    (if (and (pair? (first clauses)) (%eq (first (first clauses)) 'after))
      (error "receive: (after ...) must be the last clause, but it appears before "
        (count (rest clauses))
        " more clause(s)")
      (receive-check-after (rest clauses)))))

;; Split clauses into [real-clauses ms-or-nil timeout-body-or-nil], peeling an
;; optional trailing (after ms body...). `after` as a final clause head is reserved.
(defn- receive-split
  (clauses)
  (let (lst (last clauses))
    (if (and (pair? lst) (= (first lst) 'after))
      [(but-last clauses) (second lst) `(do ~@(rest (rest lst)))]
      ;; no `after`: ms nil (wait forever), so `%receive` can never return its
      ;; timeout answer and the timeout branch is provably dead — the macro omits it.
      [clauses nil nil])))

;; The set of leading keyword tags a `receive`'s clauses can match, or nil when the
;; filter cannot be used. Passed to `%receive` as a THIRD argument so the mailbox scan
;; can reject a non-matching message by peeking its tag, without first rebuilding it
;; into the heap (`from_message`) and running the matcher — the cost that makes a
;; selective receive against a backlog O(rounds x backlog). Measured 2026-07-29 at
;; ~0.4us per rescanned message.
;;
;; Conservative by construction: it answers nil (no filtering, scan everything) unless
;; EVERY clause is a vector pattern whose head is a literal keyword. A catch-all
;; pattern, a bare symbol, a map/list pattern or a non-keyword head all disable it, so
;; the filter can never skip a message some clause would have matched. Guards are
;; irrelevant to it — a `:when` can only reject a message the tag already admitted.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- receive-tags
    (clauses)
    (if (empty? clauses)
      nil
      (let (pat (first (first clauses))
            tag (if (and (vector? pat) (> (count pat) 0) (keyword? (first pat)))
                  (first pat)
                  nil))
        (if (nil? tag)
          nil ; one un-taggable clause disables the filter
          (let (rest-tags (receive-tags (rest clauses)))
            (if (and (nil? rest-tags) (not (empty? (rest clauses))))
              nil ; a later clause disabled it
              (cons tag rest-tags))))))))

;; The receive-mark hint (ADR-195): the expression EVERY clause pins, when they all pin the
;; same one — `([:reply ^r v] …)` yields `r`. Any clause that pins nothing, or pins something
;; different, disables it (nil), exactly like `receive-tags`. The kernel only acts on it when
;; the value turns out to be a `ref` this process minted, so a false positive here costs
;; nothing but a wasted comparison.
(defn- receive-pinned-in
  (pat)
  "The single pinned expression inside `pat`, or nil if it pins none or several."
  (cond
    (match-pin? pat) (second pat)
    (vector? pat)
      (fold (fn (acc p)
              (let (inner (receive-pinned-in p))
                (cond
                  (nil? inner) acc
                  (nil? acc) inner
                  (= acc inner) acc
                  else :none)))
        nil
        (seq pat))
    else nil))

;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- receive-pin
    (clauses)
    "The **symbol** pinned by every clause, or nil when they do not agree.

  Restricted to a symbol deliberately. The hint is emitted as a form that the call site
  evaluates *in addition to* the matcher's own evaluation of the same pin, so anything with a
  side effect (or a value that could differ between the two evaluations) would be run twice.
  A pinned symbol — `^r`, which is the whole idiom this exists for — reads a binding and cannot
  differ. Any other pinned expression declines the hint and scans from the front."
    (if (empty? clauses)
      nil
      (let (first-pin (receive-pinned-in (first (first clauses))))
        (if (or (nil? first-pin) (= first-pin :none) (not (symbol? first-pin)))
          nil
          (if (empty? (rest clauses))
            first-pin
            (let (rest-pin (receive-pin (rest clauses)))
              (if (= rest-pin first-pin) first-pin nil))))))))

(defmacro receive (& clauses)
  "Selectively receive a message from the mailbox: run the first `(pattern [:when guard] body...)` clause that matches, leaving others queued. An optional final `(after ms body...)` clause fires on timeout; `(receive)` blocks for the next message."
  (do
    (receive-check-after clauses)
    (let (parts (receive-split clauses)
          real (nth parts 0)
          ms (nth parts 1)
          on-time (nth parts 2)
          msg (gensym "msg")
          r (gensym "rcv")
          ;; Walk each pattern once; both halves below read the same prep.
          preps (receive-prep real 0)
          ;; The matcher answers "which clause, and what did it bind?" as `[idx var…]`,
          ;; or nil for no match. No clauses: take the next message as-is.
          matcher (if (empty? real)
                    `(fn (~msg) [0 ~msg])
                    `(fn (~msg)
                       ~(match-build-from (map receive-result-clause preps) msg nil)))
          dispatch (if (empty? real) `(nth ~r 1) (receive-dispatch preps r))
          ;; nil when the filter can't apply (see `receive-tags`). Built as a vector
          ;; FORM (`[~@tags]`), not by calling a function: a plain list would expand to
          ;; `(:tag …)`, which evaluates as a keyword accessor call (ADR-165) rather
          ;; than data — and calling `vec` here would run at macro-expansion time
          ;; *during the prelude build*, where its own dependency (`into`, defined
          ;; ~2000 lines later) does not exist yet.
          tag-list (if (empty? real) nil (receive-tags real))
          tags (if (nil? tag-list) nil `[~@tag-list])
          ;; The receive-mark hint — see `receive-pin`. Emitted as the pinned FORM, so it
          ;; evaluates at the call site to the same value the pattern compares against.
          pin (if (empty? real) nil (receive-pin real)))
      ;; `%receive` returns the matcher's result vector, or nil on timeout (only
      ;; reachable with an `after` clause — nil is unambiguous because a match always
      ;; answers with a vector). The bodies run HERE, in the caller's tail position.
      (if (nil? ms)
        `(let (~r (%receive ~matcher nil ~tags ~pin)) ~dispatch)
        `(let (~r (%receive ~matcher ~ms ~tags ~pin))
           (if (nil? ~r) ~on-time ~dispatch))))))

;; ---- dirty-native offload (ADR-144) -----------------------------------------
;; The BEAM dirty-scheduler shape: a long/blocking native runs on a small OS
;; pool and only THIS process waits — its scheduler worker keeps running other
;; processes. Mechanism is `%offload` (kernel: copy args out, run on the pool,
;; deliver the result as a message); this wrapper is the policy — park in a
;; selective receive on the job's token, rethrow errors as ordinary throws.
;; Sits AFTER the `receive` macro because it uses it. It USED to double as a
;; boot-time exerciser of the freeze's reachability-aware dangling-env check:
;; the old expansion nested a body-thunk `(fn () …)` inside the matcher, so
;; expanding it left a dead captured-frame closure in the builder heap for the
;; freeze to scrub. ADR-155 removed that thunk, so no prelude form produces one
;; any more (`BROOD_BOOT_TRACE=1` now reports 0 scrubbed, was 1) and that
;; incidental coverage is GONE — the scrub branch in `Heap::to_prelude` is no
;; longer reached at boot. The hard assert for *reachable* env-capturing
;; closures still runs on every closure, so the invariant itself is unchanged.
;; (The original observation is devlog 2026-07-22.)
(defn offload (f & args)
  "Run the blocking native `f` (e.g. `file/slurp-bytes`, `%git-clone`,
`%pbkdf2-sha256-bytes`) with `args` on the dirty-offload OS pool and wait for
the result — parking only this process, never a scheduler worker. An error in
the native rethrows here, catchable as usual. Only long/blocking
data-in/data-out natives are allowed (`%offload` refuses the rest); other
mailbox messages stay queued while waiting (selective receive)."
  (let (tok (%offload f (into [] args)))
    (receive
      ([:offload ^tok result] result)
      ([:offload-error ^tok e] (throw e)))))

;; ---- a general membership test ----------------------------------------------
(defn member? (x xs)
  "True if `x` is equal to some item of list `xs`."
  (cond (empty? xs) false (= x (first xs)) true else (member? x (rest xs))))
