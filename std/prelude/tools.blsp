;; ---- discovery / introspection ----------------------------------------------
;; "What's in this image, and where?" — name- and doc-based search over the flat
;; global table, on top of the `reflect/global-names`/`doc` primitives. The first thing
;; to reach for when exploring rather than guessing names one at a time.

;; The candidate set for name-based discovery: every global MINUS the plumbing. A `%`
;; name is a kernel primitive or a prelude internal (ADR-250) and a `defn-` name is
;; module-private. Neither is something a user should be offered: they would bury the
;; callable answers. `bound?` guards the `reflect/private?` probe against a name in the
;; table with no value yet.
(defn- %discoverable-names ()
  "Every global worth OFFERING to a human: no `%` plumbing, no module-private names."
  (%filter (reflect/global-names)
    (fn (s) (and (not (string/starts-with? (->string s) "%")) (not (reflect/private? s))))))

(defn reflect/apropos (pattern)
  "Every PUBLIC global whose name contains `pattern` (a string, symbol, or keyword), as a
sorted list of symbols. `%`-prefixed plumbing and module-private names are excluded — they
are not callable vocabulary.

    (reflect/apropos \"gensy\")   ;=> (reflect/gensym)"
  ;; `name` (not `str`) so a keyword pattern drops its leading colon, matching
  ;; the bare global names; a string passes through unchanged.
  (let (needle (if (string? pattern) pattern (->string pattern)))
    (%filter (%discoverable-names) (fn (s) (includes? (->string s) needle)))))

;; Whitespace-split a query into lowercased terms (blanks dropped) — the unit
;; doc-search ranks by. A single-word query yields one term, so it degrades to
;; the old "docstring contains this word" search.
(defn- %doc-search-terms (query)
  "Lowercased, whitespace-separated terms of `query`, with blanks removed."
  (%filter (string/split (string/lower query) " ") (fn (t) (not (string/blank? t)))))

(defn reflect/doc-search (query)
  "Globals whose name or docstring matches `query`, ranked by how many of its
whitespace-separated terms they contain (case-insensitive substring) — most
matches first, ties broken by name. A list of `[name doc]` pairs. Searches
behaviour, not just names: `(reflect/doc-search \"node up down\")` finds `monitor-node`
even when no single docstring holds that exact phrase. A single-word query
degrades to a plain case-insensitive name/docstring search, e.g.
`(reflect/doc-search \"random\")`.

    (reflect/doc-search \"node up down\")   ;~> ([monitor-node \"…\"] …whatever the loaded image documents…)"
  (let (terms (%doc-search-terms query))
    (when (not (empty? terms))
      (map
        (seq/sort-by
          (seq/keep (%discoverable-names)
            (fn (s)
              ;; check-allow :discarded-catch — a best-effort probe (doc / parse / ls / image index): absence is the answer
              (let (d (check-allow :discarded-catch
                        (try (reflect/doc (reflect/eval s)) (catch _ nil))))
                (when (string? d)
                  (let (hay (string/lower (str s " " d))
                        hits (count (%filter terms (fn (t) (includes? hay t)))))
                    (when (> hits 0) [hits s d]))))))
          (fn (e) [(- (first e)) (str (second e))]))
        (fn (e) [(second e) (nth e 2)])))))

;; ---- spy: homoiconic tree-tracing debug (ADR-173) ---------------------------
;; `(spy expr)` evaluates `expr`, traces every evaluated subexpression's value in
;; evaluation order, and returns the value UNCHANGED — so it is referentially
;; transparent: wrap or unwrap `spy` around any form with zero behavioural change
;; Rather than special-casing a fixed handful of constructs, `spy` leans on
;; homoiconicity: it fully macroexpands the form
;; (re-expanding at every node, since `macroexpand` only resolves the outer head)
;; and instruments each evaluated position IN PLACE, so laziness is preserved —
;; an untaken `if` branch or a short-circuited `and` tail never traces. A pipeline
;; needs no special case: `(-> x f g)` expands to `(g (f x))`, and the ordinary
;; call rule traces each stage for free. Trace entries flow through the swappable
;; `*spy-sink*`, so a host (the editor, the observer) can capture the trace as
;; DATA rather than text; the default sink pretty-prints an indented tree to
;; stderr. `fn` bodies, `quote`, and `quasiquote` are left opaque (a closure body
;; runs later/elsewhere, quoted data never evaluates).

;; The sink `spy` routes trace entries to (a 1-arg fn), or nil for the default
;; stderr tree. Entries are maps: `{:spy :enter :form f}`,
;; `{:spy :node :form f :value v :depth d}`, `{:spy :exit :value v}`. Rebind it
;; (via `binding`) to capture a trace as data.
;;
;; A sink's RETURN VALUE is part of the contract, and it has exactly one meaning:
;; **`:spy-stop` says "I have all I want — stop tracing"**. Anything else (nil,
;; whatever `io/puts` returned) means "keep going". A bounded sink — one that keeps
;; the first N entries, which every display sink should be — answers `:spy-stop` once
;; it is full, and the tracer then stops paying for instrumentation it can see will be
;; thrown away (`debug/trace-fn` reverts to a plain tail call; see its wrapper). The
;; alternative is a sink that silently drops entries while the traced program still
;; pays a frame per level for every one of them.
(defdyn *spy-sink* nil)

(defn- %spy-indent (depth) (apply str (map (range depth) (combinator/constantly "  "))))
(defn- %spy-default-sink (entry)
  "Default `*spy-sink*`: pretty-print one trace entry as an indented stderr line.
`:call`/`:return` are the function-boundary entries `debug/trace-fn` emits.

Values print through `pr-str-bounded`, not `pr-str`: this is a display protocol, and
one traced call carrying a megabyte string must not paint a megabyte to stderr. Lift
the bound for a run with `(binding (*print-string-length* nil) …)`."
  (case (:spy entry)
    :enter (%write-err (str "spy: " (debug/pr-str-bounded (:form entry)) "\n"))
    :node
      (%write-err (str "  "
                    (%spy-indent (:depth entry))
                    (debug/pr-str-bounded (:form entry))
                    " => "
                    (debug/pr-str-bounded (:value entry))
                    "\n"))
    :exit (%write-err (str "=> " (debug/pr-str-bounded (:value entry)) "\n"))
    :call (%write-err (str "trace: " (debug/pr-str-bounded (cons (:fn entry) (:args entry))) "\n"))
    :return
      (%write-err (str "trace: "
                    (pr-str (:fn entry))
                    " => "
                    (debug/pr-str-bounded (:value entry))
                    "\n"))
    nil))
(defn- %spy-emit (entry) ((or *spy-sink* %spy-default-sink) entry))
(defn- %spy-node (form value depth)
  ;; Runtime: emit a traced node's value, then return it untouched.
  (%spy-emit {:spy :node :form form :value value :depth depth})
  value)
(defn- %spy-run (form thunk)
  (%spy-emit {:spy :enter :form form})
  (let (value (thunk)) (%spy-emit {:spy :exit :value value}) value))

;; Core forms whose heads must NOT be treated as function calls (their arguments
;; are not plain eager operands). After a full macroexpand only these survive; the
;; macro entries are belt-and-suspenders in case one reaches a node unexpanded.
;;
;; Because they are belt-and-suspenders, a head that stops existing goes unnoticed here —
;; nothing fails, the entry simply never matches — so prune this set on every rename.
(def- %spy-special-forms
  #{'if
    'do 'def 'fn 'let 'letrec 'quote 'quasiquote 'defmacro 'defn 'defdyn 'defrecord 'defmodule 'when
    'unless 'cond 'and 'or 'match 'match* 'case 'comment 'try 'catch 'throw 'receive 'binding
    'dolist 'doseq 'dotimes 'for '-> 'spawn 'spawn-link 'error 'with-out-str 'with-err-str 'bench})

(defn- %spy-walk-seq (forms depth) (map forms (fn (form) (%spy-walk form depth))))
(defn- %spy-walk-binds (binds depth)
  ;; A flat `(name expr …)` binding list — instrument the RHS positions only.
  (letrec (go (fn (bs acc)
                (cond
                  (empty? bs) (reverse acc)
                  (empty? (rest bs)) (reverse (cons (first bs) acc))
                  else
                    (go (rest (rest bs))
                      (cons (%spy-walk (second bs) depth) (cons (first bs) acc))))))
    (go binds ())))
(defn- %spy-walk-if (form depth)
  ;; Instrument test + both branches in place; the branches stay lazy, so only the
  ;; taken one ever traces.
  ;; Each instrumented form is the user's form rebuilt, so it keeps the original's position:
  ;; an error under `spy` reports where it was written.
  (let (parts (rest form) test (first parts) then (second parts) d (inc depth))
    (%copy-form-pos (if (> (count parts) 2)
                      `(if ~(%spy-walk test d) ~(%spy-walk then d) ~(%spy-walk (nth parts 2) d))
                      `(if ~(%spy-walk test d) ~(%spy-walk then d)))
      form)))
(defn- %spy-walk-let (form depth)
  (let (head (first form) binds (second form) body (rest (rest form)) d (inc depth))
    (%copy-form-pos `(~head ~(%spy-walk-binds binds d) ~@(%spy-walk-seq body d)) form)))
(defn- %spy-walk-call (form depth)
  ;; (f a…) — every operand is eager, unconditional, once; instrument them all and
  ;; trace this call node's value.
  `(%spy-node '~form ~(%copy-form-pos (%spy-walk-seq form (inc depth)) form) ~depth))
(defn- %spy-walk (form depth)
  (if (not (pair? form))
    form
    (let (form (reflect/macroexpand form))
      ; resolve the (outer) macro head
      (if (not (pair? form))
        ; a macro expanded to an atom
        (%spy-walk form depth)
        (let (head (first form))
          (cond
            (or (= head 'fn) (= head 'quote) (= head 'quasiquote)) form
            (= head 'if) (%spy-walk-if form depth)
            (= head 'do) `(do ~@(%spy-walk-seq (rest form) (inc depth)))
            (or (= head 'let) (= head 'letrec)) (%spy-walk-let form depth)
            (contains? %spy-special-forms head) `(%spy-node '~form ~form ~depth)
            else (%spy-walk-call form depth)))))))

(defmacro debug/spy (expr)
  "Evaluate `expr`, trace every evaluated subexpression's value (in evaluation order) to `*spy-sink*` — default: an indented tree on stderr — and return the value unchanged. Referentially transparent: wrap or drop `spy` around any form with no behavioural change. Homoiconic: fully macroexpands and instruments in place, so laziness (an untaken branch, a short-circuited `and`) is preserved and pipelines trace stage-by-stage for free. `fn` bodies and quoted data are left opaque."
  `(%spy-run '~expr (fn () ~(%spy-walk expr 0))))
