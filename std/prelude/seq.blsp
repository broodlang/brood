;; ---- sequence library -------------------------------------------------------
;; All in Brood over the list primitives (`first`/`rest`/`cons`/`empty?`) and
;; `take`/`drop`. Every builder is tail-recursive (it accumulates a reversed list
;; and reverses once at the end), so these stay stack-safe on long inputs — which
;; matters because a `test` body runs in a green process with a small coroutine
;; stack. Sequences are cons-lists; `zip` pairs are 2-vectors (the tuple idiom).

;; (range hi) -> 0..hi-1 ; (range lo hi) -> lo..hi-1 ; (range lo hi step).
(defn range "A range of integers: `(range hi)` is 0..hi-1, `(range lo hi)` is lo..hi-1, `(range lo hi step)` strides by `step`. The result is a *lazy* range — `fold`/`reduce`/`sum`/`count` walk it without building a list (O(1) memory); every other op treats it as the list of those integers. Empty ranges are `nil`.

    (range 4)        ;=> (0 1 2 3)
    (range 2 5)      ;=> (2 3 4)
    (range 0 10 3)   ;=> (0 3 6 9)
    (range 0)        ;=> nil"
  ((hi) (%range 0 hi 1))
  ((lo hi) (%range lo hi 1))
  ((lo hi step) (%range lo hi step)))
;; Declared: a multi-arity function has no single inferred parameter signature. This is
;; what the variadic definition inferred — the first bound an int, which lets the checker
;; flag `(range (/ n 2))`; the rest unconstrained.
(sig range (int &optional any any -> list))

;; (take n coll) -> the first n elements (fewer if coll is shorter).
(defn take (coll n)
  "The first `n` items of `coll` (fewer if it is shorter), as a list.

    (take [1 2 3 4] 2)  ;=> (1 2)
    (take [1 2] 9)      ;=> (1 2)
    (take [1 2] 0)      ;=> nil"
  (%take-acc n coll nil))
(defn- %take-acc (n coll acc)
  (if (or (<= n 0) (empty? coll))
    (reverse acc)
    (%take-acc (- n 1) (rest coll) (cons (first coll) acc))))

;; (drop n coll) -> coll without its first n elements.
(defn drop (coll n)
  "`coll` without its first `n` items.

    (drop [1 2 3 4] 2)  ;=> (3 4)
    (drop [1 2] 9)      ;=> nil"
  (if (or (<= n 0) (empty? coll)) coll (drop (rest coll) (- n 1))))

;; (seq/take-while pred coll) / (seq/drop-while pred coll) split on the first failure.
(defn seq/take-while (coll pred)
  "The leading items of `coll` for which `(pred x)` holds, as a list — like `take`, which
also returns a list whatever it was given.

    (seq/take-while [1 2 3 1] (fn (x) (< x 3)))   ;=> (1 2)
    (seq/take-while [5 1] (fn (x) (< x 3)))       ;=> nil

Works on any collection `take` does — vectors and strings included."
  (%take-while-acc pred coll nil))
(defn- %take-while-acc (pred coll acc)
  ;; `empty?`, not `pair?` — the guard `take`/`drop` use. `pair?` is false for a VECTOR and
  ;; a STRING, so it would walk zero items of either and answer `nil`.
  ;; Two `if`s, not `(and (not (empty? …)) …)`: `not` is a prelude closure, a call per
  ;; element on this path (KI-182).
  (if (empty? coll)
    (reverse acc)
    (if (pred (first coll))
      (%take-while-acc pred (rest coll) (cons (first coll) acc))
      (reverse acc))))

;; (any? pred coll) -> true if pred holds for any element; (every? pred coll) ->
;; true if it holds for all (vacuously true on the empty list). Booleans, by the
;; `?` convention — use `find` to recover the matching element itself.
(defn any? (coll pred)
  "True if `(pred x)` holds for at least one item of `coll`.

    (any? [1 3 4] math/even?)   ;=> true
    (any? [1 3] math/even?)     ;=> false"
  (cond (empty? coll) false (pred (first coll)) true else (any? (rest coll) pred)))
(defn every? (coll pred)
  "True if `(pred x)` holds for every item of `coll` (vacuously true if empty).

    (every? [2 4] math/even?)   ;=> true"
  (cond (empty? coll) true (pred (first coll)) (every? (rest coll) pred) else false))

;; (index-of coll x [from]) -> the 0-based index of `x`, or -1. The index-returning
;; sibling of `includes?`, and BARE rather than `string/index-of` for the reason ADR-230
;; draws the boundary on: a module name claims the ops whose *subject* is that type, and
;; this one's subject is any collection — it dispatches on `(string? coll)` and falls
;; through to a list/vector scan. (`last-index-of` looked like its twin and is not: that
;; one is string-only, so it lives in `string/`.) It lives here, in the sequence file, so
;; that where it is defined and how the reference categorises it both say "collection".

(defn- %index-of-seq-from (coll x i from)
  ;; scan from the head; only start matching once the running index reaches `from`
  (cond
    (empty? coll) -1
    (and (>= i from) (= (first coll) x)) i
    else (%index-of-seq-from (rest coll) x (inc i) from)))
(defn index-of (coll: (or nil string seqable) x:any &optional from: (or nil int) -> int)
  "The 0-based index of `x` in `coll` at or after `from` (default 0), or -1 if absent.
For a string, `x` is a substring (multi-char ok; the empty string matches at `from`);
for a list or vector, `x` is an element compared structurally. The `from` offset is
what incremental search rides on (formerly the separate `index-of`).

    (index-of \"hello\" \"ll\")     ;=> 2
    (index-of \"hello\" \"zz\")     ;=> -1
    (index-of [:a :b :c] :b)     ;=> 1
    (index-of \"abab\" \"ab\" 1)    ;=> 2   ; search resumes at `from`

**-1 is TRUTHY.** Only `nil` and `false` are falsy in Brood, so `(when (index-of hay x) …)`
runs its body every time, including when `x` is absent — test the sentinel, as
`(>= (index-of hay x) 0)` or `(includes? hay x)`, and never the value. `nest check` reports
the shape (`this test is always true`); this line is here because the checker is advisory
and the reader is not."
  (let (start (or from 0))
    (cond
      ;; Strings ride on the `%str-index-of` kernel primitive — linear; a pure-Brood
      ;; scan would be O(n²) (char indexing is O(index)), which is too slow for
      ;; whole-namespace `doc-search`/`apropos` use. The `from` offset goes to the
      ;; primitive, which searches in place — slicing a `string/substring` first would copy
      ;; the suffix on every call and make the incremental search quadratic. The empty needle
      ;; still matches at `from`, and a `from` past the end still finds nothing.
      (string? coll) (%str-index-of coll x (%max 0 start))
      else (%index-of-seq-from coll x 0 start))))

;; `includes?` follows it for the same reason — the membership question over any
;; collection, string included, not a string op that happens to accept a vector.
;; The RETURN is an index or -1, never anything else: inferred, it would be `number`, and
;; that width would travel into every caller's arithmetic (`string/substring` and `bytes/at`
;; want an int). The collection is what the body accepts: a string, or anything
;; `first`/`rest` walk — every seqable, a bytes value included — or nil (-1). An int or a
;; keyword raises inside `%index-of-seq-from`; declaring `any` here would infer every
;; caller's parameter handed to `index-of` as `any`.
(defn includes? (coll x)
  "True if `coll` contains `x`. Works on lists, vectors, strings (string/substring), sets, and maps (membership among values — use `contains?` for keys).

    (includes? [1 2 3] 2)         ;=> true
    (includes? \"hello\" \"ell\")     ;=> true
    (includes? #{1 2 3} 2)        ;=> true    ; O(log n), the trie — same as contains?
    (includes? {:a 1} 1)          ;=> true    ; VALUES, not keys
    (includes? {:a 1} :a)         ;=> false   ; use contains? for that"
  (cond
    ;; A set answers from its trie, never by scanning itself: falling through to
    ;; `index-of` gives the right answer the slow way, which no test catches. `includes?`
    ;; is the membership question people reach for first; it has to be the fast one
    ;; wherever a fast one exists.
    (set? coll) (%set-has? coll x)
    (map? coll) (includes? (vals coll) x)
    else (>= (index-of coll x) 0)))

;; (%zip a b) -> a list of [x y] vectors, stopping at the shorter input.
;; Internal: `zipmap` below builds on it and the prelude cannot `require` a module.
;; The published name is `seq/zip` (ADR-251) — see std/seq.blsp.
(defn %zip (a b)
  "A list of `[x y]` pairs from `a` and `b`, stopping at the shorter input.
Internal — the published name is `seq/zip`."
  (%zip-acc a b nil))
(defn- %zip-acc (a b acc)
  (if (or (empty? a) (empty? b))
    (reverse acc)
    (%zip-acc (rest a) (rest b) (cons [(first a) (first b)] acc))))

;; (seq/partition n coll) -> consecutive n-sized chunks; a trailing partial chunk is
;; dropped (Clojure `partition` semantics). `%has-at-least?` avoids re-counting.
(defn- %has-at-least? (n coll)
  "True when `coll` has at least `n` items, walking only that far — the O(n) test that lets
`partition` and friends check a chunk without counting the whole (possibly long) sequence.
Always true for `n` <= 0.

    (%has-at-least? 2 (list 1 2 3))   ;=> true
    (%has-at-least? 4 (list 1 2 3))   ;=> false"
  (cond (<= n 0) true (empty? coll) false else (%has-at-least? (- n 1) (rest coll))))
(defn- %partition-acc (n coll acc)
  (if (%has-at-least? n coll)
    (%partition-acc n (drop coll n) (cons (take coll n) acc))
    (reverse acc)))

;; (sort coll) ascending via `<` (numbers) or structural order (anything else);
;; (sort coll less?) with a strict less-than predicate. (seq/sort-by coll key-fn)
;; sorts by `(< (key-fn x) (key-fn y))`. A stable, O(n log n) merge sort: the
;; merge prefers the left run on ties (stable) and is tail-recursive; recursion
;; depth is O(log n), so it's stack-safe.
;;
;; The single-arg `(sort coll)` case has two Rust fast paths: `%sort-asc` for
;; the all-numeric case (~50× faster than the in-Brood mergesort because every
;; comparison is a Rust `match` instead of an `eval::apply` round-trip), and
;; `%sort-cmp` for the heterogeneous / structural case (vectors, strings,
;; keywords, …). Dispatch checks the first item — non-empty fast since
;; `(number? (first a))` is one tag-of compare. Empty coll → empty list.
;; Custom-comparator `(sort coll less?)` stays on the Brood-side `%merge-sort`.
(defn sort (coll & more)
  "Sort a collection (stable). `(sort coll)` is ascending by `<` for numbers, or by structural order (lexicographic on vectors/lists, text order on strings/symbols/keywords) for anything else. `(sort coll less?)` uses a strict less-than predicate.

    (sort [3 1 2])              ;=> (1 2 3)
    (sort [\"b\" \"a\"])            ;=> (\"a\" \"b\")
    (sort [3 1 2] >)            ;=> (3 2 1)"
  (cond
    (not (empty? more)) (%merge-sort (first more) coll)
    (empty? coll) nil
    (number? (first coll)) (%sort-asc coll)
    ;; a record element sorts by its `compare-to` method (STRICT — no structural default,
    ;; ADR-179: sorting records without a method is a %no-method error), so a type can
    ;; define its own order; every built-in keeps the native `%sort-cmp` path.
    (record? (first coll)) (%merge-sort (fn (x y) (< (%ord-compare x y) 0)) coll)
    else (%sort-cmp coll)))
;; The comparator goes LAST (ADR-308), like every other combinator.
;;
;; The comparator is declared as an ARROW rather than a bare `fn` so the argument-order
;; audit can see it: `audit/arrow-type?` is `(includes? t "->")`, and with `fn` the
;; subject would be found by neither type nor name (`more` is not in `subject-params`), so
;; a flipped order would pass vacuously. With the arrow, `audit/reversed-args` names it.
;; `(or list vector set)`, not `seqable`: `seqable` additionally admits a string, a map
;; and bytes, and `sort` RAISES on all three (`%sort-asc`/`%sort-cmp` both materialise
;; through `Heap::seq_items`, which takes nil/pair/vector/set and nothing else). A range
;; needs no mention — it materialises as a pair. The wider `seqable` would (rightly) warn
;; inside sort's own body.
(sig sort ((or list vector set) &optional (any any -> bool) -> any))
;; Split `coll` into its first `n` items and the rest in ONE pass — what `%merge-sort`
;; needs instead of a separate `take` + `drop` (two walks). Private: the published
;; spelling is `seq/split-at`, a wrapper over this in std/seq.blsp.
(defn- %split-at-acc (n coll acc)
  (if (or (<= n 0) (empty? coll))
    [(reverse acc) coll]
    (%split-at-acc (dec n) (rest coll) (cons (first coll) acc))))

;; Length-carrying merge sort: count once up front and halve `n` down the
;; recursion, and split each run in a single `split-at` pass. The previous form
;; re-`count`ed and ran a separate `take`+`drop` at every level — three O(n)
;; walks per level, O(n log n) wasted overall — purely to find the midpoint.
(defn- %merge-sort (less? coll) (%merge-sort-n less? coll (count coll)))
;; check-allow: deliberately non-tail — depth = log2 of the length — ~60 frames for any feasible list.
(check-allow :non-tail-recursion
  (defn- %merge-sort-n (less? coll n)
    (if (<= n 1)
      coll
      ;; `%split-at-acc`, NOT `seq/split-at`. The module function is a one-line wrapper
      ;; over this very helper three lines above, and reaching it through the qualified
      ;; name meant every `sort` of a non-trivial list loaded `seq` at the lookup miss and
      ;; loaded the whole `seq` module — to call back into the prelude. `sort` is core and
      ;; now pulls in nothing.
      (let (h (%quot n 2)
            parts (%split-at-acc h coll nil))
        (%merge-runs less?
          (%merge-sort-n less? (nth parts 0) h)
          (%merge-sort-n less? (nth parts 1) (- n h)))))))
(defn- %merge-runs (less? a b) (%merge-acc less? a b nil))
(defn- %merge-acc (less? a b acc)
  (cond
    ;; `acc` holds the merged prefix reversed; `%reverse-onto` splices it in front of
    ;; the remaining run in ONE pass, with no per-element apply frame (see
    ;; `%reverse-onto`).
    (empty? a) (%reverse-onto acc b)
    (empty? b) (%reverse-onto acc a)
    ;; strict `<` on b-vs-a: equal elements take from `a` first, so it's stable.
    (less? (first b) (first a)) (%merge-acc less? a (rest b) (cons (first b) acc))
    else (%merge-acc less? (rest a) b (cons (first a) acc))))

;; `mapcat` uses `%append-onto` instead of `cons` to splice each sublist straight
;; onto the reversed accumulator, then reverse once — so we never materialise the
;; intermediate list-of-sublists nor spread it through `apply append`.

(defn into (to:seqable from:seqable -> any)
  "Pour each item of `from` into `to`. For a map, items are `[k v]` pairs (assoc'd, map result); for a **set**, items are added and duplicates collapse (set result); for a vector, items are appended (vector result); otherwise items are appended (list result). Maps in `from` are read as their entries, so `(into [] some-map)` and `(into {} other-map)` both work.

    (into [] '(1 2 3))        ;=> [1 2 3]
    (into [1] [2 3])          ;=> [1 2 3]
    (into #{} [1 1 2])        ;=> #{1 2}
    (into {} [[:a 1]])        ;=> {:a 1}
    (into [] {:a 1})          ;=> [[:a 1]]"
  (cond
    ;; Map target: build via the kernel's GC-quiet CHAMP builder (`%map-into`) —
    ;; an implementation detail of *constructing* a fresh immutable map (it writes
    ;; only build-local trie nodes inside one GC-quiet builtin; no `Value` is ever
    ;; mutable), so O(result-nodes) allocation, not O(n) fresh path-copies. A map
    ;; `from` is read as its entries first (`%map-into` takes a list/vector of `[k v]`).
    ;; a record target conj's each item via `Conjable` (a custom collection defines how);
    ;; a plain map uses the GC-quiet CHAMP builder.
    ;; A plain map poured into an EMPTY map is the answer itself, as with vectors below.
    ;; A record target (ADR-542) conj's each item through `Conjable` (a custom collection
    ;; defines how); a record `from` is read through `seq`, its fields by default.
    (%record? to) (fold (seq from) to %conj-one)
    (map? to)
      (cond
        (%record? from) (%map-into to (seq from))
        (not (map? from)) (%map-into to from)
        (empty? to) from
        else (%map-into to (%map-pairs from)))
    ;; Set target: add each item (duplicates collapse). Without this branch the
    ;; `else` would pour a set into a LIST — `(into #{} [1 1 2])` as `(1 1 2)`.
    (set? to) (fold from to %set-add)
    ;; Vector target. Pouring into an EMPTY vector is what `vec`, and almost every
    ;; `(into [] …)` at a call site, actually asks for — and it needs no `append` at all.
    ;; Going through `append` would build a whole intermediate list only to re-vectorise
    ;; it, several times slower. An already-
    ;; vector `from` is the answer itself — vectors are immutable, so there is nothing to
    ;; copy. Only a non-empty `to` still needs the concatenation.
    (vector? to)
      (cond
        (empty? to) (if (vector? from) from (apply vector (seq from)))
        ;; the kernel copies once for the shapes it walks; a map (its entries) or any
        ;; other seqable still goes through `append`
        (or (vector? from) (pair? from) (nil? from) (range? from) (set? from))
          (%vector-concat to from)
        else (apply vector (append to from)))
    else (append to from)))

;; conj's per-element step: each collection kind has a natural insertion point.
(defn- %conj-one (coll x)
  (cond
    (nil? coll) (list x)
    ;; a flat copy plus one: the kernel op, not a trip through `into`/`append`
    (vector? coll) (%vector-concat coll [x])
    (set? coll) (%set-add coll x)
    ;; a record (ADR-542) dispatches to its `Conjable` impl (default: the map behaviour
    ;; below); a custom-collection record defines its own insertion. `conj-onto` is only
    ;; reached for records, so its late definition is fine.
    (%record? coll) (conj-onto coll x)
    (map? coll)
      (cond
        (map? x) (merge coll x)
        (and (vector? x) (= (count x) 2)) (assoc coll (nth x 0) (nth x 1))
        else
          (error "conj: adding to a map takes a [k v] pair or a map, got "
            (pr-str x)))
    (pair? coll) (cons x coll)
    ;; A built-in kind with a `Conjable` impl of its own — the third of the collection
    ;; seams, matching `seq` and `count` (ADR-253). Gated on `%impl-exact?` so a kind
    ;; nobody has answered for keeps the clear error below rather than being handed
    ;; `Conjable`'s `:default`, which is the MAP behaviour and means nothing here.
    (%impl-exact? '[Conjable conj-onto] (%identity-of coll)) (conj-onto coll x)
    else (error "conj: not a collection: " (pr-str coll))))

(defn conj (coll: (or list vector set map) & xs:any -> any)
  "Add element(s) to `coll` at its natural insertion point (Clojure-style):
APPEND to a vector, PREPEND to a list (`nil` counts as an empty list), ADD to a
set (a duplicate is a no-op), and `assoc` a `[k v]` pair — or merge a map — into
a map. Returns a fresh collection; `coll` is untouched.

    (conj [1 2] 3)      ;=> [1 2 3]   ; a vector appends
    (conj '(2 3) 1)     ;=> (1 2 3)   ; a list prepends
    (conj nil 1)        ;=> (1)       ; nil is the empty list
    (conj #{1} 2)       ;=> #{1 2}
    (conj {} [:b 2])    ;=> {:b 2}

`set/disj` is the inverse (ADR-506); `conj` stays core, so a set takes the collection
protocol without an import."
  (fold xs coll %conj-one))

(defn set/disj (s & xs)
  "A fresh set like `s` with each of `xs` removed (removing an absent element is a
no-op). The set counterpart of `dissoc`, and `conj`'s inverse — both live here
rather than in `std/set` so a set works with the collection protocol without an
import (and so `(:use set)` can't shadow them).

    (set/disj #{1 2 3} 2)   ;=> #{1 3}
    (set/disj #{1} 9)       ;=> #{1}   ; removing what isn't there is a no-op"
  (fold xs s %set-remove))

;; ---- more sequence operations -----------------------------------------------
;; The eager counterparts of the `x*` transducers, plus the common Clojure-ish
;; builders. All tail-recursive (reverse-accumulate, reverse once) so they stay
;; stack-safe on long inputs — see the sequence-library note above.

;; ---- records: named, optionally-typed maps (defrecord — ADR-130) ------------
;; A record is a plain immutable map with a positional constructor and one
;; accessor per field. `(defrecord point (x y))` defines:
;;   (defn point   (x y) {:x x :y y})   ; constructor, named after the record
;;   (defn point-x (p)   (get p :x))    ; accessor per field
;;   (defn point-y (p)   (get p :y))
;; The accessors are the point: `(point-x p)` names the field, and a typo
;; `(point-witdh p)` is an undefined-function error the checker catches — where
;; `(get p :witdh)` silently returns nil. A record is its own value kind (ADR-542): its
;; fields update with `assoc`/`merge`, its identity lives in the value, so
;; `(= (point 1 2) {:x 1 :y 2})` is false and dispatch reads the id. No generated
;; `point?` predicate; write one over `record-id` if needed.
;;
;; A field may carry a type: `(defrecord point ((x int) (y int)))`. When *every*
;; field is typed, `sig`s are emitted too — the constructor's `(record …)` return
;; type and each accessor's field type — so the advisory checker gets field-type
;; and field-presence checking from the existing record-type machinery (ADR-115).

;; A field spec is a bare `name` (untyped) or `(->string type)` (typed).
(defn- %defrecord-fname (f) (if (pair? f) (first f) f))
(defn- %defrecord-ftype (f) (if (pair? f) (second f) nil))
(defn- %defrecord-acc-sym (rec fld) (symbol (str (->string rec) "-" (->string fld))))
;; The form following keyword `kw` in a macro's flat option list, or nil — how `defrecord`
;; reads `:derives` and `defability` (abilities.blsp) reads `:sealed`/`:requires`/`:derive-record`.
(defn- %form-after (opts kw)
  (cond
    (empty? opts) nil
    (= (first opts) kw) (second opts)
    else (%form-after (rest opts) kw)))
(defn- %defrecord-check-opts (rec opts)
  "Refuse anything after a `defrecord`'s field list but `:derives [Ability …]`. It used to
  be ignored: `(defrecord pt (x int) (y int))` — typed fields written one list each —
  defined a record with fields `x` and `int` and dropped `(y int)` without a word."
  (cond
    (empty? opts) nil
    (and (= (first opts) :derives) (seq (rest opts))) (%defrecord-check-opts rec (rest (rest opts)))
    else
      (error "defrecord "
        rec
        ": unexpected "
        (pr-str (first opts))
        " after the field list — fields are ONE list, typed ones as `(name type)` pairs: "
        "(defrecord "
        rec
        " ((x int) (y int))); the only option is `:derives [Ability …]`")))
(defn- %defrecord-qualify (nm)
  "Qualify bare name `nm` (a string) against the current ns → a `:<ns>/nm` keyword; at
root/REPL (no ns) there is no prefix, so it is a bare `:nm`. Shared by `defrecord` (which
bakes a record's id) and `%ability-id-kw` (an impl's bare id) so the two AGREE — a
record built at root and an impl for it at root must land on the same dispatch id."
  (let (ns (reflect/current-ns))
    (if ns (keyword (str (->string ns) "/" nm)) (keyword nm))))

;; The `(sig …)` forms for an all-typed record: the constructor arrow, then one
;; accessor arrow per field. Built as plain data — `sig` reads the un-expanded type.
;; id-keyword → record name: the set of nominal ids that are GENUINE `defrecord`
;; identities. The compiler's direct-constructor devirtualization (ADR-182) reads it: a
;; constructor call `(circle 2)` is devirtualized only when its baked id
;; (`:module/circle`) is registered here AND the head's closure builds that id.
(def- *record-ids* {})
(defn %record-register (id nm)
  "Record that `id` (a `:module/name` keyword) is a `defrecord`'s nominal identity."
  (%registry-update! '*record-ids* :assoc [id] nm)
  nil)

(defmacro defrecord (rec fields & opts)
  "Define record `rec` with `fields` — a positional constructor `(rec …)` plus a
`rec-field` accessor per field. A record is its own immutable value kind (ADR-542): named
fields plus a **nominal identity** — a `:module/name` keyword baked in at definition and
held in the value, never among the fields — so `ability` dispatch tells it apart from a
map and from other records (a record is NOT `=` to a map with the same fields).
`record?`/`record-id`/`fields` are the identity API; `get`/`assoc` work on the fields.

A field is a bare symbol or `(field type)`; the constructor result is inferred as a
record type carrying its id, so a value's identity flows through
the checker to dispatch sites (`(let (c (circle 2)) (area c))` is checkable). When every
field is typed, per-accessor signatures are emitted too.

A trailing `:derives [Ability …]` clause auto-generates an impl of each named ability
(like Rust's `#[derive]`, ADR-185): each ability's `:derive-record` recipe is
called with the field names at expansion, and the methods it returns are spliced into an
`(impl Ability rec …)`. The ability must declare a recipe (else a clean expansion error),
and it must be loaded before this `defrecord`.

    (defmodule geometry)
    (defrecord circle (r))          ; (circle 2) → #geometry/circle{:r 2}
    (impl Shape circle (area (c) (* 3.14 (get c :r) (get c :r))))

    ;; deriving: the ability supplies the recipe, the record just names it
    (defability Columns
      (columns (self) :-> vector)
      :derive-record (fn (flds)
        (list `(columns (r) [~@(map flds (fn (f) `(get r ~(keyword (->string f)))))]))))
    (defrecord point (x y) :derives [Columns])   ; columns synthesised field-wise

Note the example defines the ability *with* a `:derive-record` recipe: no ability in the
prelude declares one, so `:derives` always names an ability from your own code."
  (let (
        ;; An optional leading docstring, like `defn`/`defability`/`defmulti` — carried
        ;; onto the generated constructor.
        rec-doc (if (and (seq opts) (string? (first opts))) (first opts) nil)
        opts (if rec-doc (rest opts) opts)
        _ (%defrecord-check-opts rec opts)
        fnames (map fields %defrecord-fname)
        fkws (map fnames (fn (n) (keyword (->string n))))
        ;; the nominal id — a `:module/name` KEYWORD (a keyword literal is what the
        ;; checker tracks via `Ty::keyword_lit`), captured at definition.
        id (%defrecord-qualify (->string rec))
        ;; ctor body: a record of the id over a MAP LITERAL of the fields (built here, at
        ;; macro time) — its own value kind (ADR-542), so nothing that operates on a map
        ;; can see or write the id. The literal is what lets the checker infer each
        ;; field's type at the call.
        body (list '%record id (%zipmap fkws fnames))
        ;; Generated bindings carry a docstring: a constructor and its accessors are
        ;; public surface, and one with no `(doc …)` at all is a hole in `nest doc`,
        ;; the LSP and `(audit/undocumented)` alike. The record's own docstring, when it
        ;; wrote one, follows.
        ctor `(defn ~rec (~@fnames)
                ~(str "Construct a `"
                   (->string rec)
                   "` record"
                   (if (empty? fnames) "" (str " from " (string/join (map fnames ->string) ", ")))
                   ".\n\n    ("
                   (->string id)
                   (string/join (map fnames (fn (n) (str " " (->string n)))) "")
                   ")   ;~> a "
                   (->string rec)
                   " record"
                   (if rec-doc (str "\n\n" rec-doc) ""))
                ~body)
        accs (map fields
               (fn (f)
                 (let (fnm (%defrecord-fname f))
                   `(defn ~(%defrecord-acc-sym rec fnm) (r)
                      ~(str "The `"
                         (->string fnm)
                         "` field of a `"
                         (->string rec)
                         "` record.\n\n    ("
                         (->string id)
                         "-"
                         (->string fnm)
                         " r)   ;~> the "
                         (->string fnm)
                         " field of a "
                         (->string rec)
                         " record")
                      (/get r ~(keyword (->string fnm)))))))
        ;; the record-shaped constructor sig (always — this is the dispatch-inference
        ;; seam): each field keeps its declared type, else `any`.
        ;; An undeclared field type is a TYPE VARIABLE named after the field (`?x`), not
        ;; `any`: the checker binds it to the argument at each constructor call, so
        ;; `(pt 1 2)` is the shape `{__id__: :pt, x: 1, y: 2}` and `(:x (pt 1 2))` is `1`.
        ;; With `any` every field of every constructed record would be unknown at the call.
        ;; A declared type stays declared — it is a contract, checked at the call.
        field-ty (fn (f)
                   (or (%defrecord-ftype f)
                     (symbol (str "?" (->string (%defrecord-fname f))))))
        arg-tys (map fields field-ty)
        rec-ty (cons 'record
                 (cons :__id__
                   (cons id
                     (mapcat fields
                       (fn (f) (list (keyword (->string (%defrecord-fname f))) (field-ty f)))))))
        ctor-sig (list '/sig rec (append arg-tys (list '-> rec-ty)))
        ;; per-accessor sigs only when every field is typed (else an accessor call on a
        ;; bare map would false-warn), mirroring the pre-unification behaviour.
        acc-sigs (if (every? fields pair?)
                   (map fields
                     (fn (f)
                       (let (fnm (%defrecord-fname f))
                         (list '/sig
                           (%defrecord-acc-sym rec fnm)
                           ;; `&open` (ADR-264): an accessor takes any record CARRYING
                           ;; this field — a real value also has `:__id__` and every
                           ;; sibling field, so a closed one-field shape would describe
                           ;; no record at all. The constructor's RESULT stays closed:
                           ;; the ctor builds exactly those keys, which is what lets a
                           ;; field read through a union of records resolve.
                           (list (list 'record '&open (keyword (->string fnm)) (%defrecord-ftype f))
                             '->
                             (%defrecord-ftype f))))))
                   nil)
        ;; `:derives [A …]` → one `(%derive-into 'A id 'fields (reflect/current-ns))` per ability. The
        ;; recipe is run at LOAD (not expansion), because the checker expands this `defrecord`
        ;; WITHOUT first evaluating the ability's `defability`, so the recipe isn't registered
        ;; at expand time. `%derive-into` registers the impls at load; the checker reads these
        ;; forms statically (they mark the ability's ops as implemented for `id`).
        ;; Each named ability must declare a `:derive-record` recipe (ADR-185).
        derives (%form-after opts :derives)
        derive-calls (if derives
                       (map derives
                         (fn (a)
                           (list '%derive-into
                             (list 'quote a)
                             id
                             (list 'quote fnames)
                             (list '/reflect/current-ns))))
                       nil))
    ;; The constructor's `sig` follows its `defn`, exactly as the accessor sigs already
    ;; follow theirs. The order is not load-bearing (ADR-381: a contract is installed
    ;; whenever the binding lands, either side of the declaration).
    `(do ~ctor ~ctor-sig ~@accs ~@acc-sigs ~@derive-calls (%record-register ~id '~rec) nil)))

(defn- %repeat-acc (n x acc) (if (<= n 0) acc (%repeat-acc (dec n) x (cons x acc))))
(defn seq/repeat (n x)
  "A list of `x` repeated `n` times (empty if `n` <= 0).

    (seq/repeat 3 :a)   ;=> (:a :a :a)
    (seq/repeat 0 :a)   ;=> nil"
  ;; The same ceiling a range is realised under (`MAX_REALISED_RANGE`, 2^26): past it
  ;; the list is a single call eating the machine, and the allocation failure it ends
  ;; in is an abort, not an error anything can catch.
  (if (> n 67108864)
    (error "seq/repeat: " n " elements is too many to build (limit 67108864)")
    (%repeat-acc n x nil)))

;; ---- lazy / fusing seq-views (compute-frontier lever 3) ---------------------
;; `map`/`seq/filter`/`seq/keep`/`seq/reject` are EAGER — they return a concrete list, and
;; running them for side effects (`(map require-one mods)`, `(map run ts)`)
;; works as it always has. Fusion is **opt-in**, via `seq/lmap`/`seq/lfilter`/`seq/lkeep`/
;; `seq/lreject` composed with `->`. Each returns a lazy seq-view (`%seqview`): a
;; non-materialising value carrying a transducer over a source. Chaining
;; composes the transducers onto one view, so a `->` pipeline folds/reduces in
;; a **single pass with no intermediate lists**:
;;
;;   (-> xs (seq/lmap sq) (seq/lfilter even?) (reduce 0 +))    ; one pass, no temp lists
;;
;; Consume a view with `fold`/`reduce`/`sum`/`count`/`into`/`join`/`seq`/`nth`/
;; `first`/`rest`; `seq`/`into`/`str`/`=` materialise it to a concrete value. A
;; view is heap-local: **`send` refuses to ship one** (a view references its
;; source process's heap), so realise it first (`(seq v)`/`(into [] v)`) before
;; crossing a process or the network. Footgun: like any lazy value, a view
;; defers the work in its fns (and a `throw` therein) until realised — so don't
;; build a view for side effects; use eager `map`/`doseq` for that.

;; Composition — general right-to-left function composition; also the glue that
;; fuses a view's stages.
(defn- %comp-compose (f g) (fn (x) (f (g x))))
(defn comp (& fns)
  "Right-to-left function composition. `((comp f g) x)` is `(f (g x))`; with no
arguments, `identity`.

    ((comp inc inc) 1)   ;=> 3"
  (cond
    (empty? fns) identity
    (empty? (rest fns)) (first fns)
    else (fold (rest fns) (first fns) %comp-compose)))

;; The rest of the combinator family, so a partially-applied call has a spelling
;; other than `(map xs (fn (x) (f a x)))`.
(defn partial (f & bound)
  "`f` with its leading arguments fixed: `((partial f a b) c)` is `(f a b c)`.
The workhorse for handing a configured function to a higher-order op.

    ((partial + 10) 5)   ;=> 15"
  (fn (& later) (apply f (append bound later))))

(defn combinator/complement (pred)
  "A predicate that returns the logical negation of `pred`: `((complement odd?) 2)`
is `true`. The named form of `(fn (& args) (not (apply pred args)))`.

    ((combinator/complement math/even?) 3)   ;=> true"
  (fn (& args) (not (apply pred args))))

(defn combinator/constantly (x)
  "A function of any arguments that always returns `x` — the placeholder callback
for a higher-order op that wants a fixed answer.

    ((combinator/constantly 7) 1 2)   ;=> 7"
  (fn (& _ignored) x))

;; The rest of the combinator family (ADR-379): `juxt`, `fnil`. `memoize` is gone (ADR-522):
;; memoisation lives at a definition, `memo/defmemo`.
(defn combinator/juxt (& fns)
  "A function that applies each of `fns` to its arguments and returns the results as a
vector, in order: `((juxt f g) x)` is `[(f x) (g x)]`. The named form of \"the same
arguments, several views\" — a sort key of two fields, a split of a value into parts.

    ((combinator/juxt first count) [7 8 9])                 ;=> [7 3]
    (seq/sort-by [\"bb\" \"a\" \"ab\"] (combinator/juxt count identity))   ;=> (\"a\" \"ab\" \"bb\")"
  (fn (& args) (seq/mapv fns (fn (f) (apply f args)))))

(defn combinator/fnil (f default)
  "`f` with a `nil` FIRST argument replaced by `default` — the other arguments pass
through. Reads a map's missing entry as a starting value without spelling the `or` at every
call: `(update m :n (fnil inc 0))`.

    ((combinator/fnil inc 0) nil)              ;=> 1
    ((combinator/fnil inc 0) 5)                ;=> 6
    ((combinator/fnil conj []) nil :a)         ;=> [:a]"
  (fn (x & more) (apply f (if (nil? x) default x) more)))

;; Internal stateless transducer constructors — the fused stages behind the
;; `l*` combinators. A transducer is `(xf rf) -> rf'`; composing them (`comp`)
;; fuses a pipeline into one per-step reducing function. Named `%x*` because they
;; are plumbing: the public surface is `seq/lmap`/`seq/lfilter`/`seq/lkeep`/`seq/lreject`, not
;; raw transducers. Fixed-arity (no rest-list) so they keep the fast call path.
;; The four built-in stages. Internal: the `l*` combinators below build on them and
;; the prelude cannot `require` a module. Published as `seq/xmap` … (ADR-251) — the
;; stage constructors belong with `seq/transduce`, the only thing that runs them.
;;
;; DON'T RELOCATE THIS BLOCK INTO `std/seq.blsp`. It reads as a pure move — nothing in
;; the prelude calls an `l*` combinator, and the four `seq/x*` names there are one-line
;; wrappers over these — and ADR-291 considered exactly that and DECIDED AGAINST it: the
;; `l*` names stay defined in the PRELUDE under their qualified spelling, because the
;; prelude is the boot image and relocating a definition changes boot order for no
;; established gain. If you reopen it, reopen the
;; ADR: the premise to re-test is "no gain", which predates the prelude image (ADR-314).
;; The run's state table while `seq/transduce` builds a transducer stack (ADR-421) — read by
;; `seq/stage-slot`. Declared here, not in `std/seq`, because a `defdyn` is an ambient root name
;; and the stdlib image attributes root globals to modules: the prelude is the root's home.
(defdyn *transduce-run* nil)

(defn %xmap (f)
  "The `map` stage as a transducer — internal; published as `seq/xmap`."
  (fn (rf) (fn (acc x) (rf acc (f x)))))
(defn %xfilter (pred)
  "The `filter` stage as a transducer — internal; published as `seq/xfilter`."
  (fn (rf) (fn (acc x) (if (pred x) (rf acc x) acc))))
(defn %xreject (pred)
  "The `reject` stage as a transducer — internal; published as `seq/xreject`."
  (fn (rf) (fn (acc x) (if (pred x) acc (rf acc x)))))
(defn %xkeep (f)
  "The `keep` stage as a transducer — internal; published as `seq/xkeep`."
  (fn (rf) (fn (acc x) (let (y (f x)) (if (nil? y) acc (rf acc y))))))

;; ---- transducers, as public surface (ADR-161) -------------------------------
;; The stage constructors above stayed private for a reason that expired: the `l*`
;; combinators cover the built-in stages, but a user who wants a stage of their OWN
;; (`take-while`-as-a-stage, a stateful de-duplicator, a windower) had no way to
;; write one and no way to run it. The contract is small enough to publish:
;;
;;   A TRANSDUCER is a function `(rf) -> rf'` where a REDUCING FUNCTION `rf` is
;;   `(acc x) -> acc`. It wraps `rf` and may call it zero, one, or many times per
;;   input. Compose stages with `comp` — LEFT to RIGHT in data-flow order, the
;;   reverse of ordinary function composition, because each stage wraps the *next*
;;   one's reducer.
;;
;; `seq/xmap`/`xfilter`/`xreject`/`xkeep` are the built-in stages (the same functions
;; the `l*` combinators use), and `seq/transduce` runs a stack over any collection.
(defn- %seqview-wrap (coll xf)
  "Wrap `coll` in a lazy seq-view applying transducer `xf`. If `coll` is already a
view, compose `xf` onto its transducer (same source) so the stages fuse."
  (if (seqview? coll)
    (let (parts (%seqview-parts coll))
      (%seqview (%vector-ref parts 0) (comp (%vector-ref parts 1) xf)))
    (%seqview coll xf)))

(defn seq/lmap (coll f)
  "Lazy, fusing `map`: a seq-view of `(f x)` for each `x` in `coll`. Composes with
adjacent `l*` stages (thread them with `->`) and folds/reduces in one pass with
no intermediate lists. Realise with `seq`/`into`, or just consume it
(`fold`/`reduce`/`count`/…). Use eager `map` when you want a concrete list or are
iterating for side effects.

    (-> [1 2 3] (seq/lmap inc) (into [] $))   ;=> [2 3 4]"
  (%seqview-wrap coll (%xmap f)))

(defn seq/lfilter (coll pred)
  "Lazy, fusing `seq/filter` — see `seq/lmap`. The complement is `seq/lreject`.

    (seq (seq/lfilter [1 2 3 4] math/even?))   ;=> (2 4)   ; `seq` realises the view"
  (%seqview-wrap coll (%xfilter pred)))

(defn seq/lkeep (coll f)
  "Lazy, fusing `seq/keep` (map + filter of non-nil `(f x)`) — see `seq/lmap`.

    (seq (seq/lkeep [1 2 3 4] (fn (x) (when (math/even? x) (* x 10)))))   ;=> (20 40)"
  (%seqview-wrap coll (%xkeep f)))

(defn seq/lreject (coll pred)
  "Lazy, fusing `seq/reject` — see `seq/lmap`. The complement is `seq/lfilter`.

    (seq (seq/lreject [1 2 3 4] math/even?))   ;=> (1 3)"
  (%seqview-wrap coll (%xreject pred)))

;; ---- iteration combinators --------------------------------------------------
;; Hide the hand-rolled counter/accumulator recursion behind names that read as
;; intent (the way `defserver` hides a receive loop). All ordinary Brood.

;; One tail pass pairing each item with a running index — the old
;; `(seq/zip (range (count coll)) coll)` made three passes (count, build the range
;; list, then zip). `seq` coerces a map to its `[k v]` pairs, as `zip` did.
;; ---- comprehensions ---------------------------------------------------------
;; `for` builds a list by walking one or more bindings, with `:when` guards —
;; a macro over `mapcat`, so the map/filter/fold plumbing disappears from view.
;;   (for (x xs) expr)               -> a list of expr for each x
;;   (for (x xs :when p) expr)       -> … only where p holds
;;   (for (x xs y ys) [x y])         -> nested (y varies fastest)
;; Bindings may destructure: (for ([k v] (%map-pairs m)) …). Build a map from the
;; result with `(into {} (for …))`. Bindings are a list — code is lists, vectors
;; are data (ADR-010); a vector is still accepted in binding position.

;; Compile the binding forms (a list: alternating pattern/coll, plus :when pred)
;; from the inside out, threading a single accumulator `acc` through. Each
;; binding becomes a `fold` over its collection that conses the body onto `acc`;
;; each :when an `if` that passes `acc` through unchanged when the guard fails;
;; the body a single `(cons body acc)`. The whole thing builds the result in
;; reverse with no intermediate per-element lists (a `mapcat` lowering would
;; allocate a one-element `(list body)` per item) — so a final `reverse` restores order in one extra O(n) pass. `fold` is tail-
;; recursive, so deep comprehensions don't grow the stack.
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
;;
;; `leaf` is the innermost form — what one iteration does to `acc`: `(cons body acc)` for
;; `for`, `(conj acc body)` under `:into`, the body itself for `fold-for` (ADR-377). The
;; walk over the bindings is the same for all three.
(check-allow :non-tail-recursion
  (defn- %for-fold (acc binds leaf)
    (cond
      (empty? binds) leaf
      (= (first binds) :when) `(if ~(second binds) ~(%for-fold acc (rest (rest binds)) leaf) ~acc)
      else
        `(fold ~(second binds)
           ~acc
           (fn (~acc ~(first binds)) ~(%for-fold acc (rest (rest binds)) leaf))))))

;; `(x xs :when p :into coll)` → `[(x xs :when p) (coll)]`; without `:into`, `[binds nil]`.
;; The target rides in a one-element list so that `:into nil` — a list built by `conj`,
;; i.e. in reverse — is told apart from no `:into` at all. `:into` is accepted only as the
;; LAST pair: it names the result, not a binding, and a guard after it would read as a
;; guard on nothing.
;; check-allow: deliberately non-tail — expansion-time recursion over the binding list.
(check-allow :non-tail-recursion
  (defn- %for-split-into (binds)
    (cond
      (empty? binds) [nil nil]
      (%eq (first binds) :into)
        (cond
          (empty? (rest binds))
            (error "for: :into has no collection. Syntax: (for (x xs :into coll) body)")
          (empty? (rest (rest binds))) [nil (list (second binds))]
          else
            (error "for: :into must be the last clause of the bindings, got "
              (pr-str binds)
              ". Syntax: (for (x xs :when p :into coll) body)"))
      else
        (let (r (%for-split-into (rest (rest binds))))
          [(cons (first binds) (cons (second binds) (first r))) (second r)]))))

;; Validate that binding pairs are complete — each variable has a collection, and each
;; :when has a guard expression. An odd-count suffix silently produces an empty result
;; (the missing coll becomes nil), which is almost always a mistake.
(defn- %for-check-binds (binds)
  (cond
    (empty? binds) nil
    (%eq (first binds) :when)
      (if (empty? (rest binds))
        (error "for: :when at end of bindings has no guard expression")
        (%for-check-binds (rest (rest binds))))
    ;; `:into coll` is checked by `%for-split-into` (last clause, has a value).
    (%eq (first binds) :into) (%for-check-binds (rest (rest binds)))
    (empty? (rest binds))
      (error "for: binding '"
        (pr-str (first binds))
        "' has no collection — bindings must be paired as (var coll ...)")
    else (%for-check-binds (rest (rest binds)))))

(defmacro for (binds & body)
  "List comprehension: `(for (x xs) expr)` yields `expr` for each `x`; supports `:when guard` filters and multiple bindings (last varies fastest). Bindings may destructure. Multiple body forms are evaluated in order and the LAST one is collected (like `let`/`when`/`doseq`).

A trailing `:into coll` collects with `conj` onto `coll` instead of building a list, so the target's kind decides the result — a vector appends, a map takes `[k v]` pairs, a set drops duplicates (ADR-377).

    (for (x [1 2 3]) (* x x))                  ;=> (1 4 9)
    (for (x (range 5) :when (math/even? x)) x)   ;=> (0 2 4)
    (for (x '(1 2) y '(:a :b)) [x y])          ;=> ([1 :a] [1 :b] [2 :a] [2 :b])
    (for (x [1 2 3] :into []) (* x x))         ;=> [1 4 9]
    (for (x [1 2] :into {}) [x (* x x)])       ;=> {1 1, 2 4}"
  (do
    (when (vector? binds)
      (error "for: bindings must be a list, not a vector: write (for (x xs) expr)."
        " Brood is lists-for-code, vectors-for-data (unlike Clojure) — a vector"
        " *inside* a binding position is still destructuring: (for ([k v] pairs) k)."))
    (%for-check-binds binds)
    (let (split (%for-split-into binds)
          binds (first split)
          into (second split)
          acc (reflect/gensym "acc")
          body (if (empty? (rest body)) (first body) (cons 'do body)))
      (if (nil? into)
        `(/reverse (let (~acc nil) ~(%for-fold acc binds `(cons ~body ~acc))))
        `(%for-into ~(first into)
           (/reverse (let (~acc nil) ~(%for-fold acc binds `(cons ~body ~acc)))))))))

;; `:into`'s collection step. The items arrive as a list in order, and a VECTOR target takes
;; them in one `into` — `conj` onto a vector copies it, so collecting element by element was
;; quadratic. Every other target is `conj`'d item by item, exactly as before: a list
;; prepends, a map takes `[k v]` pairs, a set drops duplicates, a record its own way.
(defn- %for-into (target items) (if (vector? target) (into target items) (fold items target conj)))

;; (fold-for (acc init x xs …) body…) — the accumulating comprehension: `for`'s walk
;; with the body as the STEP. The first pair names the accumulator and its start; the
;; rest are `for`'s bindings and guards; the body's value is the next accumulator, and
;; the last one is the result. Racket's `for/fold`, on the same expander as `for`.
(defmacro fold-for (binds & body)
  "Accumulate over one or more bindings: the FIRST pair of `binds` names the accumulator and its initial value, the rest are [[for]] bindings (with `:when` guards); `body` is evaluated with both in scope and its value is the next accumulator. The last accumulator is the result (ADR-377).

    (fold-for (sum 0 x [1 2 3]) (+ sum x))                          ;=> 6
    (fold-for (m {} x [:a :b] :when (not (= x :b))) (assoc m x 1))   ;=> {:a 1}
    (fold-for (best nil x [3 9 4]) (if (or (nil? best) (> x best)) x best))   ;=> 9"
  (do
    (when (vector? binds)
      (error "fold-for: bindings must be a list, not a vector: write (fold-for (acc init x xs) body)."))
    (when (or (empty? binds) (empty? (rest binds)) (not (symbol? (first binds))))
      (error "fold-for: the first pair must name the accumulator and its start, got "
        (pr-str binds)
        ". Syntax: (fold-for (acc init x xs :when p) body)"))
    (%for-check-binds (rest (rest binds)))
    (when (second (%for-split-into (rest (rest binds))))
      (error "fold-for: :into is for's clause — the accumulator IS the result here."
        " Syntax: (fold-for (acc init x xs :when p) body)"))
    (let (acc (first binds)
          init (second binds)
          body (if (empty? (rest body)) (first body) (cons 'do body)))
      `(let (~acc ~init) ~(%for-fold acc (rest (rest binds)) body)))))

;; (doseq (pat coll) body...) — run `body` for its side effects over each item,
;; returning nil. Just `for` run for effect (the result list is discarded). The
;; param is `bind`, not `binding` — the latter is the dynamic-variable form.
(defmacro doseq (bind & body)
  "Run `body` for its side effects over each item of the binding (like `for`, but discards the result and returns `nil`).

    (with-out-str (doseq (x [1 2 3]) (io/write x)))   ;=> \"123\"
    (doseq (x [1 2]) x)                               ;=> nil"
  `(do (for ~bind (do ~@body)) nil))

;; (dotimes (i n) body...) — run `body` for `i` = 0, 1, …, n-1; returns nil. The
;; lean iteration primitive: a plain tail-recursive walker, no result list built
;; (unlike `doseq`, which routes through `for`/`mapcat`). For effects only.
(defn- %dotimes-loop (n f i) (when (< i n) (f i) (%dotimes-loop n f (+ i 1))))
(defmacro dotimes (bind & body)
  "Run `body` with the bound name set to 0, 1, …, n-1 for side effect; returns `nil`. `bind` is `(var n)`.

    (with-out-str (dotimes (i 3) (io/write i)))   ;=> \"012\"
    (dotimes (i 3) i)                             ;=> nil"
  (if (not (and (pair? bind) (pair? (rest bind))))
    (error "dotimes: bind must be (var n), got "
      (pr-str bind)
      ". Syntax: (dotimes (i n) body...)")
    `(do (%dotimes-loop ~(second bind) (fn (~(first bind)) ~@body) 0) nil)))

;; (dolist (x xs) body...) — run `body` for each element of `xs`; returns nil.
;; The list-only counterpart to `dotimes`: lean and tail-recursive, no discard
;; list built. Use `doseq` when you need destructuring or `:when` filters; reach
;; for `dolist` for the common "do this for each item" loop.
(defn- %dolist-loop (xs f)
  (if (nil? xs) nil (do (f (first xs)) (%dolist-loop (rest xs) f))))
(defmacro dolist (bind & body)
  "Run `body` with the bound name set to each element of the collection for side effect; returns `nil`. `bind` is `(var coll)`.

    (with-out-str (dolist (x '(1 2 3)) (io/write x)))   ;=> \"123\"
    (dolist (x '(1 2)) x)                               ;=> nil   ; the value is discarded"
  (if (not (and (pair? bind) (pair? (rest bind))))
    (error "dolist: bind must be (var coll), got "
      (pr-str bind)
      ". Syntax: (dolist (x xs) body...)")
    `(do (%dolist-loop ~(second bind) (fn (~(first bind)) ~@body)) nil)))

;; `bench` moved to the `dev` module (`dev/bench`) with the other diagnostics.

;; ---- kept in the prelude: used at MACRO-EXPANSION time -----------------------
;; A prelude macro that calls these runs during boot, before `(require-one 'seq)`,
;; so they cannot live in the module however late-bound the reference is. `defrecord` uses
;; `mapcat`, `defmethod` uses `mapv`, and those pull in the rest transitively.
;; (`but-last` moved to core.blsp — `receive` expands during the prelude's own boot,
;; which is earlier than this file. See the note at its definition.) Everything else in the sequence library moved to `seq/`.

(defn seq/drop-while (coll pred)
  "`coll` with its leading items for which `(pred x)` holds removed. Returns `coll` itself
when nothing is dropped, exactly as `(drop [1 2 3] 0)` does.

    (seq/drop-while [1 2 3 1] (fn (x) (< x 3)))   ;=> (3 1)
    (seq/drop-while [5 1] (fn (x) (< x 3)))       ;=> [5 1]   ; nothing dropped, so `coll` itself

Works on any collection `drop` does — vectors and strings included."
  (if (empty? coll)
    coll
    (if (pred (first coll)) (seq/drop-while (rest coll) pred) coll)))

(%defseq mapcat
  (f)
  "Map `f` over `coll` and concatenate the resulting lists into one.

    (mapcat [1 2] (fn (n) (list n n)))   ;=> (1 1 2 2)"
  (%append-onto acc (f item)))

(defn seq/mapv (coll f)
  "A VECTOR of `(f x)` for each `x` in `coll` — `map` when the caller needs
indexed access or a vector literal shape (`(into [] (map coll f))`, named).

    (seq/mapv [1 2 3] inc)   ;=> [2 3 4]
    (map [1 2 3] inc)    ;=> (2 3 4)   ; the list-returning sibling"
  (into [] (map coll f)))

(defn seq/partition (coll:seqable n:number -> any)
  "Split `coll` into consecutive `n`-sized chunks; a trailing partial chunk is dropped.
`n` must be positive — a size of zero or less is an error, never an endless run of
empty chunks.

    (seq/partition [1 2 3 4] 2)    ;=> ((1 2) (3 4))
    (seq/partition [1 2 3] 2)      ;=> ((1 2))          ; the odd 3 is dropped
    (seq/partition [1 2] 5)        ;=> nil"
  ;; A size <= 0 never shrinks `coll` (`(drop coll 0)` is `coll`, and a zero-sized chunk
  ;; always "fits"), so the accumulator would grow until memory ran out.
  (if (> n 0)
    (%partition-acc n coll nil)
    (error "seq/partition: chunk size must be positive, got " n)))

(defn seq/sort-by (coll key-fn)
  "Sort `coll` (stable, ascending) by comparing `(key-fn x)` of each item with the
structural order (`compare`) — or a key's own `compare-to` if the key is a record. Numeric,
string, keyword, vector, and record keys all work.

    (seq/sort-by [\"aaa\" \"b\"] count)   ;=> (\"b\" \"aaa\")"
  ;; Each key is computed ONCE, paired with its item, and the pairs sorted — rather than
  ;; `key-fn` running on both sides of every comparison, ~2·n·log n calls, which is what
  ;; a completion menu sorting by a computed score paid.
  ;; A collection of one item or none comes back as `%merge-sort` returns it — itself, and
  ;; typed as it always was (the test is on the keyed list, so `coll` is never narrowed by a
  ;; `count`); the comparator is never called for it.
  (let (keyed (map coll (fn (item) [(key-fn item) item])))
    (if (empty? (rest keyed))
      (%merge-sort < coll)
      (map (%merge-sort (fn (x y) (< (%ord-compare (%vector-ref x 0) (%vector-ref y 0)) 0)) keyed)
        (fn (pair) (%vector-ref pair 1))))))
