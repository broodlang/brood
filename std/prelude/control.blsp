;; ---- I/O --------------------------------------------------------------------
;; Output is redirectable. A *port* is just a 1-arg fn that consumes a ready
;; string (`(fn (s) …)`); `*out*`/`*err*` are dynamic vars holding the current
;; stdout/stderr ports, and the `io/` writers render their
;; args (Rust `%render` — the exact text stdout would show) and hand the string to
;; the port. The defaults are the kernel writers `%write-out`/`%write-err`; rebind
;; with `binding` (or `std/io`'s `with-out`/`with-err`) to send output to a
;; process, a buffer, or any callback — see std/io.blsp. The default `*out*` stays
;; `%write-out`, which honours the capture stack, so `with-out-str` is unaffected.
;;
;; Declared with the `%declare-dynamic` primitive directly because the `defdyn`
;; macro isn't defined until further down the prelude (and `print` lives here).
(%declare-dynamic '*out*)
(def *out* %write-out)
(%declare-dynamic '*err*)
(def *err* %write-err)
;; `*show*` — a late-bound per-argument display transform for the SCREEN printers
;; (the `io/` writers). Declared here; the Display protocol (core,
;; defined at the end of this prelude) sets it to `%show-print-hook`, which routes a
;; *record* through the `Display` ability's `->string` op so a record can define how it
;; prints while built-ins keep the fast native render.
;; An ordinary dynamic var, so `(binding (*show* nil) …)` disables the transform for a
;; scope. Only the screen printers consult it; `str`/`pr-str`/`fmt` stay native.
(%declare-dynamic '*show*)
(def *show* nil)
; The printing functions live in `std/io.blsp` as `io/write` / `io/puts` / `io/inspect`,
; beside the `Port` ability they write through. `*out*`/`*err*` stay here: they are the dynamic
; vars a port is installed into, and the kernel's own diagnostics reach them without
; loading a module. The prelude itself never calls `io/…` on a path that can run while
; a module is loading — it writes with `%write-err` directly (see `spy`/`deprecation`),
; so a warning during a require cannot re-enter the loader.

;; `with-out-str` runs `body` for effect with stdout diverted into a capture
;; buffer, and returns the captured text (a string) instead of `body`'s value —
;; the standard "what did this print?" sink. Capture is process-scoped *and*
;; inherited by anything `body` spawns, so a printer running in a child process is
;; captured too. Captures nest (the buffer is a stack), so a `with-out-str` inside
;; an outer capture — e.g. a `nest mcp` tool handler — drains only its own output.
;; The buffer is popped even if `body` throws (the `catch` re-raises), so a thrown
;; error never leaves a dangling capture diverting all later output.
(defmacro with-out-str (& body)
  "Evaluate `body` with stdout captured, and return everything it printed as a
string (`\"\"` if it printed nothing), discarding `body`'s own value. Output from
processes `body` spawns is captured too; nested `with-out-str`s compose.

    (with-out-str (io/write \"a\"))   ;=> \"a\""
  `(do
     (%capture-begin)
     (try
       (do ~@body (%capture-take))
       (catch e (do (%capture-take) (throw e))))))

;; The stderr counterpart of `with-out-str`. It works differently, and has to:
;; stdout capture is a kernel buffer (`%capture-begin`), while a write targeting `*err*`
;; goes through the `*err*` PORT — so this rebinds that port to a collecting sink
;; instead. Consequences worth knowing: it captures only what goes through `*err*`
;; (a Rust-side `eprintln!`, e.g. a kernel reload diagnostic, is NOT interceptable
;; this way), and it does not follow into spawned processes the way `with-out-str`
;; does. Accumulation uses a `Table` because data is immutable — the one sanctioned
;; mutable structure, and a local one that never escapes.
(defmacro with-err-str (& body)
  "Evaluate `body` with the `*err*` port captured, returning everything written to it as a string (`\"\"` if nothing was), discarding `body`'s own value. For asserting on a warning — and for keeping an expected warning out of a test run's output. Only intercepts writes through `*err*` (an `io/` writer with `:to *err*`), not stderr written by the kernel itself.

    (with-err-str (io/write \"oops\" :to *err*))   ;=> \"oops\"
    (with-err-str 1)                            ;=> \"\"     ; nothing written"
  (let (sink (reflect/gensym "err-sink"))
    `(let (~sink (%table))
       (try
         (do
           (binding (*err* (fn (s)
                             (%table-put ~sink :text (/str (%table-get ~sink :text "") s))
                             nil))
             ~@body)
           (let (text (%table-get ~sink :text ""))
             (%table-drop ~sink)
             text))
         (catch e (do (%table-drop ~sink) (throw e)))))))

;; ---- embedding a file's text in the source that ships ------------------------
;; A Brood program that needs a file it did not write — an SQL schema, a shader, a
;; template, a helper program in another language — has two bad options today. Read it
;; at run time and the program now depends on a path that a release does not carry: a
;; bundle is CODE ONLY (ADR-038), so nothing follows the binary but module source.
;; Paste it into a string literal and every quote and backslash in it has to be escaped
;; by hand, which un-runs it — the file can no longer be formatted, linted, or executed
;; by its own language's tools, and it drifts from whatever it was copied out of.
;;
;; `include-str` is the third option: the file stays a file on disk, and its TEXT is
;; spliced into the program as a string literal before the program runs. In development
;; that happens at macro-expansion time, here; in a release it happens when
;; `nest release` collects the module source (`project-release/inline-includes`), so
;; the bundle carries the contents and the bundle is still nothing but code.

(defn %include-str-path (rel &optional (root nil))
  "The absolute path `include-str` and `include-bytes` read `rel` from: `rel` itself when it
is absolute, else `rel` under `root` — which defaults to the root of the PACKAGE the file
being loaded belongs to (see [[%include-package-root]]), then the project root, then the
working directory.

Package-relative, because the two readers of this — macro expansion here, and `nest
release`'s source collection — must agree on the answer, and the release resolves a
dependency's include against that dependency (`bundle-dep-root`). Resolving it here against
the consuming project instead made a package's `(include-str \"priv/x.sql\")` read the
consumer's `priv/` in development and its own in a release.

`root` is passed explicitly by the release path, which knows the project it is collecting
but does not go through `project/setup` and so has no `project/*root*` bound. Without it a
release run from a subdirectory resolved every embedded file against the wrong place.

    (%include-str-path \"/etc/hostname\")   ;=> \"/etc/hostname\""
  (cond
    (%include-absolute? rel) rel
    else
      (let (base (or root
                   (%include-package-root)
                   (when (and (bound? 'project/*root*) project/*root*) project/*root*)
                   (file/cwd)))
        (%include-under base rel))))

;; Windows's roots, for the prelude, which cannot load `path` (ADR-592): `C:/` / `C:\` and
;; a UNC `\\server`. `path/absolute?` is the public rule; this is its bootstrap copy.
(defn- %include-drive-rooted? (path)
  (and (= (%os-type) :windows)
    (>= (string/length path) 3)
    (= (string/substring path 1 2) ":")
    (or (= (string/substring path 2 3) "/") (= (string/substring path 2 3) "\\"))))

(defn- %include-absolute? (path)
  (or (string/starts-with? path "/")
    (%include-drive-rooted? path)
    (and (= (%os-type) :windows) (string/starts-with? path "\\\\"))))

(defn- %include-under (base rel)
  (if (or (string/ends-with? base "/") (string/ends-with? base "\\"))
    (/str base rel)
    (/str base "/" rel)))

(defn %include-package-root ()
  "The root of the package the file being loaded belongs to — the nearest directory at or
above it that holds a `project.blsp` — or nil when nothing is being loaded from a file (a
REPL form, an `eval`) or the file is in no project.

    (%include-package-root)   ;~> \"/home/me/app\" while loading /home/me/app/src/x.blsp"
  (let (file (%current-file))
    (when (string? file)
      (%include-root-above (%include-dirname (if (%include-absolute? file)
                                               file
                                               (%include-under (file/cwd) file)))))))

;; The directory of `path`; a root (`/`, and on Windows `C:/`) is its own.
(defn- %include-dirname (path)
  (let (slash (%str-last-index-of path "/")
        backslash (if (= (%os-type) :windows) (%str-last-index-of path "\\") -1)
        at (if (> backslash slash) backslash slash))
    (cond
      (and (%include-drive-rooted? path) (<= at 2)) (string/substring path 0 3)
      (> at 0) (string/substring path 0 at)
      else "/")))

(defn- %include-root? (dir)
  (or (= dir "/") (and (%include-drive-rooted? dir) (= (string/length dir) 3))))

(defn- %include-root-above (dir)
  (cond
    (file/exists? (%include-under dir "project.blsp")) dir
    (%include-root? dir) nil
    else (%include-root-above (%include-dirname dir))))

;; Every file an `include-str` or `include-bytes` read in this runtime, as `{path true}`. A
;; cached project image holds what a module built from that content, so its staleness key has
;; to cover these files as well as the sources (KI-275); `project-image` reads them through
;; [[%included-files]]. A registry, so the write goes through `%registry-update!`, the
;; registry write path.
(def- *included-files* {})

(defn %included-files ()
  "The absolute paths every `include-str` and `include-bytes` in this runtime has read,
sorted."
  (sort (keys *included-files*)))

;; The path an include reads, checked and recorded: a missing file is an error at expansion.
(defn- %include-read-path (who rel)
  (let (path (%include-str-path rel))
    (unless (file/exists? path)
      (error who ": no file at " path))
    (%registry-update! '*included-files* :assoc [path] true)
    path))

(defmacro include-str (rel)
  "Splice the contents of the file at `rel` into the program as a string literal, read
at expansion time — `rel` relative to the root of the package that names it (see
[[%include-str-path]]).

    (def *schema* (include-str \"priv/schema.sql\"))

The file is read once, where the program is built, and nothing looks for it when the
program runs. That is the whole point: a released bundle carries module source and no
asset files, so a string literal is the only form in which a foreign file can travel
with an application — and writing that literal by hand means escaping a file that then
cannot be run by the tools that understand it.

A missing file is an error at expansion, not a nil at run time: the program cannot be
built without it, and the failure should say so where it can still be fixed.

`(include-str \"priv/schema.sql\")` → that file's text, verbatim, as a string. (Not written
as an indented example, because the answer is whatever the file says — the case that can
be asserted lives in `tests/project_test.blsp`.)"
  (file/slurp (%include-read-path "include-str" rel)))

(defmacro include-bytes (rel)
  "Splice the contents of the file at `rel` into the program as a `bytes` literal, read at
expansion time — `include-str` for a file that is not text: a compiled WASM component
(`(wasm/instantiate (include-bytes \"native/codec.wasm\"))`), an image, a font. Resolved,
recorded and archived by `nest release` exactly as `include-str` is.

`(include-bytes \"native/codec.wasm\")` → that file's bytes. (Not an indented example, for
the reason `include-str` gives.)"
  (file/slurp-bytes (%include-read-path "include-bytes" rel)))

;; ---- threading macros (demonstrate that macros compute at expansion time) ----
;; (-> x (f a) (g b))  =>  (g (f x a) b)   ; thread as FIRST argument

;; The PLACEHOLDER `$` overrides the default position in either macro: a step form
;; containing `$` — at any depth, inside nested calls, vector and map literals —
;; puts the threaded value exactly where the `$` is, instead of first or last.
;; `(-> 100 (- $ 1))` is 99, not -99.
;;
;; It exists because Brood, like Clojure, has two argument conventions — subject-first
;; (`string/split`) and collection-last (`map`) — so a pipeline that crosses the
;; boundary can be threaded correctly by NEITHER macro. `as->` was the only answer and
;; it renames the value at every step. `$` is the same escape hatch, in place, and it
;; keeps its use even once the collection-last half is gone: the subject is genuinely
;; not the first argument in `(- 100 $)`, `(str "n=" $)`, `(cons $ xs)`.
;;
;; The threaded value is bound ONCE to a gensym and the binding substituted, so a
;; step may name `$` any number of times without re-evaluating the expression:
;; `(-> (expensive) (+ $ $))` calls `expensive` once.
(check-allow :non-tail-recursion
  (defn- %thread-slot? (form)
    ;; expansion-time recursion over macro-body syntax — depth is source nesting.
    (cond
      (= form '$) true
      ;; `'$` is the SYMBOL $, not the slot — a quoted form is data, never a hole.
      (and (pair? form) (= (first form) 'quote)) false
      (pair? form) (any? form %thread-slot?)
      (vector? form) (any? form %thread-slot?)
      (map? form) (any? (keys form) (fn (k) (or (%thread-slot? k) (%thread-slot? (get form k)))))
      else false)))
(check-allow :non-tail-recursion
  (defn- %thread-fill (form g)
    (cond
      (= form '$) g
      (and (pair? form) (= (first form) 'quote)) form
      (pair? form) (map form (fn (x) (%thread-fill x g)))
      (vector? form) (seq/mapv form (fn (x) (%thread-fill x g)))
      (map? form)
        (fold (keys form)
          {}
          (fn (acc k) (assoc acc (%thread-fill k g) (%thread-fill (get form k) g))))
      else form)))
(defn- %thread-slot-step (acc form)
  (let (g (reflect/gensym "thread"))
    `(let (~g ~acc) ~(%thread-fill form g))))

(defn- %thread-first-step (acc form)
  (cond
    (%thread-slot? form) (%thread-slot-step acc form)
    (pair? form) (cons (first form) (cons acc (rest form)))
    else (list form acc)))
(defmacro -> (x & forms)
  "Thread `x` through the forms as each one's *first* argument: `(-> x (f a) (g b))` is `(g (f x a) b)`. A form naming the placeholder `$` receives `x` at that position instead, any number of times, evaluated once.

    (-> 1 inc inc)        ;=> 3
    (-> 1 (- 10 $))       ;=> 9"
  (reduce forms x %thread-first-step))

;; (as-> x name (f a name) (g name b)) — thread `x` as `name`, in ANY position.
;; Brood's `let` is sequential and re-binds a repeated name, so this is one `let`:
;;   (as-> 5 $ (+ $ 1) (* $ 2))  =>  (let ($ 5  $ (+ $ 1)  $ (* $ 2)) $)  =>  12
(defmacro as-> (expr name & forms)
  "Thread `expr` through `forms`, re-binding it to `name` at each step so it can sit in *any* argument position: `(as-> 5 $ (+ $ 1) (* $ 2))` is `12`.

    (as-> 1 x (+ x 2))   ;=> 3"
  (let (steps (reduce forms (list name expr) (fn (acc form) (append acc (list name form)))))
    `(let ~steps ~name)))

;; ---- conditional threading ---------------------------------------------------
;; `cond->` threads `x` only through the forms whose guard is truthy, on the
;; `%thread-first-step` placement helper above, so "where does the value go" is defined
;; once. The thread-LAST variants are gone with ADR-308: one argument convention needs
;; only one pipe, and `$` covers a step wanting the value elsewhere.
;;
;; `some->` is gone (ADR-315): it stopped on `nil`, which since ADR-310 means only "the
;; lookup found nothing" and is an ordinary value everywhere else in the language — a pipe
;; for a channel that is not one. `get-in` covers the nil-chaining it existed for.

;; `ok->` — the FAILURE pipe. The steps after a failure never run, and the failure itself
;; falls out, because the message is the whole reason a failure exists (ADR-310); collapsing
;; to nil would discard exactly what the caller built it to read. Its sibling is `with`
;; below: `ok->` is for a pipeline with nothing to name, `with` for a chain of named steps.
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %ok-thread-build (place forms step)
    (if (empty? forms)
      place
      `(if (failure? ~place)
         ~place
         (let (~place ~(step place (first forms)))
           ~(%ok-thread-build place (rest forms) step))))))
(defmacro ok-> (x & forms)
  "Thread `x` through `forms` as each one's *first* argument (like `->`), but stop as soon as a step yields a **failure**, which then falls out as the result.

The steps after a failure never run, so a pipe does not have to end in `(if (failure? $) $ (step $))` to keep a bad value out of the last call. `nil` is not a sentinel here — absence and failure are separate channels (ADR-310), so `ok->` threads straight through a nil.

    (ok-> \"12\" string/->number inc)   ;=> 13
    (failure? (ok-> \"q\" string/->number inc))   ;=> true   ; `inc` never runs"
  (let (v (reflect/gensym "v")) `(let (~v ~x) ~(%ok-thread-build v forms %thread-first-step))))
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %cond-thread-build (place clauses step)
    (if (empty? clauses)
      place
      `(let (~place (if ~(first clauses) ~(step place (second clauses)) ~place))
         ~(%cond-thread-build place (rest (rest clauses)) step)))))
(defmacro cond-> (x & clauses)
  "Thread `x` through the `test form` clause pairs, applying each `form` (as its *first* argument, like `->`) only when its `test` is truthy: `(cond-> {} add-a? (assoc :a 1))`.

    (cond-> 1 true inc)    ;=> 2
    (cond-> 1 false inc)   ;=> 1"
  (let (v (reflect/gensym "v")) `(let (~v ~x) ~(%cond-thread-build v clauses %thread-first-step))))

(defmacro doto (x & forms)
  "Evaluate `x` once, run each `form` with it spliced in as the *first* argument (for side effects), then return `x`.

    (table/get (doto (table/new) (table/put :a 1) (table/put :b 2)) :b)   ;=> 2
    (doto [1] (conj 2))   ;=> [1]   ; data is immutable — `conj`'s result is discarded"
  (let (v (reflect/gensym "v"))
    `(let (~v ~x)
       ~@(map forms (fn (form) (%thread-first-step v form)))
       ~v)))

;; `tap`/`then` — the single-function pipe helpers.
;; `doto` splices *forms* (`->`-style); these take a *function value*, so they compose
;; with `->` where a plain function or a one-off closure is what you have in hand.
(defn debug/tap (x f)
  "Call `(f x)` for its side effects and return `x` unchanged — a pass-through probe for a `->` pipeline: `(-> v (debug/tap log) (process))` logs `v` and keeps threading it.

    (with-out-str (debug/tap 5 io/write))   ;=> \"5\"
    (debug/tap 5 (fn (n) nil))              ;=> 5     ; the value passes through unchanged"
  (do (f x) x))
(defn then (x f)
  "Return `(f x)` — apply `f` to `x`. Lets a `->` pipeline step call an arbitrary function on the threaded value, not only splice it as a first argument: `(-> v (then (fn (n) (g n other))))`.

    (then 5 (fn (n) (* n 3)))   ;=> 15"
  (f x))

;; ---- binding-conditionals: bind, test the *source* value, branch -------------
;; `if-let`/`when-let` evaluate the binding expression once, branch on its
;; truthiness, and bind the target (a symbol or destructuring pattern) to it in
;; the truthy branch. Testing a fresh temp (not the pattern) is what makes
;; destructuring targets — `(when-let ([k v] (first-entry m)) …)` — behave.
(defmacro if-let (binding then & else)
  "Bind `(name expr)`; if `expr` is truthy, evaluate `then` with `name` bound to it, else evaluate `else` (or `nil`). `name` may be a destructuring pattern.

    (if-let (x 1) x :none)     ;=> 1
    (if-let (x nil) x :none)   ;=> :none"
  (let (name (first binding) expr (second binding) v (reflect/gensym "v"))
    `(let (~v ~expr) (if ~v (let (~name ~v) ~then) ~@else))))
(defmacro when-let (binding & body)
  "Bind `(name expr)`; when `expr` is truthy, evaluate `body` (returning the last) with `name` bound to it, else `nil`. `name` may be a destructuring pattern.

    (when-let (x 1) x)   ;=> 1"
  (let (name (first binding) expr (second binding) v (reflect/gensym "v"))
    `(let (~v ~expr) (when ~v (let (~name ~v) ~@body)))))

;; `if-some`/`when-some` — the same shapes testing for PRESENCE (`nil`) rather than truth,
;; so a bound `false` takes the then-branch: the binding form for a lookup whose value may
;; legitimately be `false` (a flag in a config map, a boolean field). ADR-379.
(defmacro if-some (binding then & else)
  "Bind `(name expr)`; if `expr` is not `nil`, evaluate `then` with `name` bound to it, else `else` (or `nil`). Unlike [[if-let]], a `false` value is PRESENT and takes the then-branch.

    (if-some (x false) x :absent)   ;=> false
    (if-some (x nil) x :absent)     ;=> :absent"
  (let (name (first binding) expr (second binding) v (reflect/gensym "v"))
    `(let (~v ~expr) (if (/nil? ~v) (do ~@else) (let (~name ~v) ~then)))))
(defmacro when-some (binding & body)
  "Bind `(name expr)`; when `expr` is not `nil`, evaluate `body` with `name` bound to it, else `nil`. The presence-testing [[when-let]]: a `false` value runs the body.

    (when-some (x false) [:got x])   ;=> [:got false]
    (when-some (x nil) [:got x])     ;=> nil"
  (let (name (first binding) expr (second binding) v (reflect/gensym "v"))
    `(let (~v ~expr) (if (/nil? ~v) nil (let (~name ~v) ~@body)))))

;; `condp` — `cond` with the test factored out: `(condp expr pred t1 r1 t2 r2 … [default])`
;; evaluates `expr` once and takes the first clause whose `(pred expr t)` is truthy. The
;; shape `case` cannot be — `case` compares literals, `condp` asks a predicate: `(condp n <
;; 10 :small 100 :medium :large)`, `(condp line string/starts-with? "#" :heading "-" :item
;; :text)`. The subject comes first, as in `case` and `match`, so each clause reads in the order
;; its test runs (ADR-507). A lone trailing form is the default; with none, no match raises,
;; as `case` and `match` do. ADR-379.
;; check-allow: deliberately non-tail — expansion-time recursion over the clause list.
(check-allow :non-tail-recursion
  (defn- %condp-clauses (p e clauses)
    (cond
      (empty? clauses) `(error "condp: no clause matched " (pr-str ~e))
      (empty? (rest clauses)) (first clauses)
      else
        `(if (~p ~e ~(first clauses)) ~(second clauses) ~(%condp-clauses p e (rest (rest clauses)))))))
;; The message for a `condp` whose second argument is not a function: it names the value
;; (once, when the argument is that value spelled out) and the spelling with the first two
;; arguments swapped.
(defn %condp-swap-message (expr pred shown)
  (str "condp: the second argument, "
    (if (= (pr-str pred) shown) shown (str (pr-str pred) " (" shown ")"))
    ", is not a function — the subject comes first: write (condp "
    (pr-str pred)
    " "
    (pr-str expr)
    " …), which asks ("
    (pr-str expr)
    " "
    (pr-str pred)
    " test)"))
;; `condp`'s run-time half of that check: `p` is the evaluated predicate. A function, so the
;; template emits one call and no name a caller could capture.
(defn %condp-check (p expr pred)
  (when (not (or (fn? p) (keyword? p)))
    (error (%condp-swap-message expr pred (pr-str p)))))
(defmacro condp (expr pred & clauses)
  "Evaluate `expr` once, then take the first `test result` pair whose `(pred expr test)` is truthy; a lone trailing form is the default, and with none a miss raises. `cond` with the predicate factored out — `case` compares literals, this asks a function. The subject comes first, as in `case` and `match`, and each clause reads in the order its test runs: `(condp line string/starts-with? \"#\" …)` asks `(string/starts-with? line \"#\")`, value first like every data-first predicate.

    (condp 15 < 10 :small 100 :medium :large)   ;=> :medium
    (condp :b = :a 1 :b 2)                      ;=> 2
    (condp \"# Title\" string/starts-with? \"#\" :heading \"-\" :item :text)   ;=> :heading"
  ;; The likeliest slip is the other order, `(condp = x …)`: the predicate slot then holds
  ;; the subject. A constant there is refused as the form expands; any other non-function
  ;; raises before the first test, naming the swap — rather than `cannot call
  ;; non-function` from inside the first clause. A keyword is callable, so it stays allowed.
  (when (and (%cond-constant? pred) (not (keyword? pred)))
    (error (%condp-swap-message expr pred (pr-str pred))))
  (let (e (reflect/gensym "e") p (reflect/gensym "p"))
    `(let (~e ~expr ~p ~pred)
       (%condp-check ~p '~expr '~pred)
       ~(%condp-clauses p e clauses))))

;; ---- with: sequential match-binding with fall-through -----------------------
;; `with` — the FAILURE let. Bindings read exactly like `let`'s; the first value that is a
;; failure short-circuits the whole form to that failure, so the steps after it never run.
;;
;; This is deliberately NOT a `with` of `pattern <- expr` steps, which we had and removed
;; (ADR-315). That form needs a pattern because without a failure kind a tuple SHAPE carries
;; the signal, so every step must spell out a pattern for "kept going", and an `:else` section
;; must then re-match the shapes that did not. Brood has a failure kind, so the pattern is
;; redundant and so is `:else`: what falls out is always a failure, and `if`/`match`/
;; `failure?` handle it at the call site in the language you already have.
;;
;; The binding target may still destructure (`(with ([a b] (pair-of x)) …)`) — the value is
;; bound to a temporary, tested, and only then destructured, so a failure never reaches a
;; pattern that could not match it.
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %with-build (bindings body)
    (if (empty? bindings)
      `(do ~@body)
      (let (target (first bindings)
            expr (second bindings)
            more (rest (rest bindings))
            v (reflect/gensym "w"))
        `(let (~v ~expr)
           (if (failure? ~v)
             ~v
             (let (~target ~v)
               ~(%with-build more body))))))))
(defmacro with (bindings & body)
  "Bind each `name value` pair in order, like `let` — but the first value that is a **failure** short-circuits the whole form to that failure, so the steps after it never run. The body runs only when every step produced a value, with all bindings in scope.

Where `ok->` is the failure pipe for steps with nothing to name, `with` is the failure `let` for a chain of named ones — including steps that are your own functions, which `ok->` cannot reach because it threads a value rather than binding it.

Bindings are ONE flat list, exactly like `let`'s — not a list per pair. `(with (a e1) (b e2) body)` binds only `a`, and `(b e2)` becomes a body form that calls `b`, which is the confusing `unbound symbol: b` that shape produces.

    (with (n (string/->number \"12\")) (inc n))   ;=> 13
    (with (n (string/->number \"4\") d (* n 2)) d)   ;=> 8   ; two bindings, ONE list
    (failure? (with (n (string/->number \"q\")) (inc n)))   ;=> true   ; `inc` never runs"
  (%with-build bindings body))
;; ---- local loops: just use `letrec` -----------------------------------------
;; Brood has no `loop`/`recur` macro. A self-contained *local* loop is a `letrec`-
;; bound closure you call by name:
;;   (letrec (go (fn (i acc) (if (= i n) acc (go (inc i) (+ acc i))))) (go 0 0))
;; It closes over the enclosing scope (thread only the *changing* state; the loop's
;; params are exactly what evolves), and a tail call to `go` is a proper tail call —
;; O(1) stack. A top-level `defn` works too when the loop needs no enclosing locals.
;; (`loop`/`recur` were prototyped then dropped: `recur` is a workaround for runtimes
;; without tail calls — which Brood has — and `loop` was just `letrec` sugar not worth
;; a reserved word. See ADR-154 / deferred.md.)

;; ---- side-effecting iteration (function form of `doseq`) --------------------
(defn each (coll f)
  "Apply `f` to each item of `coll` for its side effects, returning `nil`. The function-valued counterpart of `doseq`: `(each io/puts xs)`.

    (with-out-str (each [1 2 3] io/write))   ;=> \"123\"
    (each [1 2 3] (fn (n) nil))              ;=> nil   ; the results are discarded"
  (fold coll nil (fn (acc x) (f x) acc))
  nil)

;; ---- error handling ----
;; The kernel gives us `throw` (raise) and `%try` (low-level catch). Everything
;; user-facing — `error`, `try`/`catch` — is written here in Brood.
(defn last (xs:seqable -> any)
  "The last item of `xs`.

    (last [1 2 3])   ;=> 3
    (last nil)       ;=> nil"
  ;; A vector answers by index; anything else is walked to its end. Both skip the
  ;; `reverse` that used to build a whole list just to read its head. The `seqable`
  ;; domain is declared, because the checker used to derive it from that `reverse` call
  ;; — `(last :k)` must still read as the error it is (`element_types` tests).
  (if (vector? xs)
    (let (n (%vector-length xs)) (if (= n 0) nil (%vector-ref xs (- n 1))))
    (%last-walk (seq xs))))
(defn- %last-walk (xs) (if (empty? (rest xs)) (first xs) (%last-walk (rest xs))))

(defn error (& parts)
  "Raise an error whose message is the concatenated display forms of `parts`: an error map
`{:kind :error :message …}` with the `:code`, position and trace every error carries.

    (try (error \"bad \" 42) (catch e (error-message e)))   ;=> \"bad 42\"
    (try (error \"bad\") (catch {:kind kind} kind))        ;=> :error"
  (%raise {:kind :error :code "E0090" :message (apply str parts)}))

(defn reflect/error-at (form & parts)
  "Raise an error like `error`, located at `form`'s source position instead of the call that
raised it — how a macro points at the sub-form it is complaining about rather than at the
whole call. A form the reader gave no position (a symbol, a number, one built at runtime)
leaves the error at the macro call.

    (defmacro twice (n) (if (int? n) `(* 2 ~n) (reflect/error-at n \"twice: expected an int\")))
    (try (reflect/error-at '(x) \"bad\") (catch e (error-message e)))   ;=> \"bad\""
  (%raise {:kind :error :code "E0090" :message (apply str parts) :at form}))

(defn failure (& parts)
  "**Return** a failure carrying the concatenated display forms of `parts` — the
other channel from `error`, which *raises*.

Reach for `failure` when the caller asked something whose honest answer is \"that
cannot be interpreted\": a parse of text that is not a number, a decode of bytes that
are not base64. Reach for `error` when the caller made a mistake — wrong type, wrong
arity, a broken invariant — because that is a bug and should unwind to the supervisor.

The two cannot be confused, because they do not travel the same way: one comes back
as a value, the other unwinds. A failure is truthy, so `(or (parse s) 0)` keeps the
failure rather than quietly defaulting — test it with `failure?`; it is not `nil`, so
absence and failure stay distinct; and `error-message` reads it.

    (failure \"not a range: \" (pr-str s))
    (failure? (failure \"nope\"))            ;=> true
    (if (failure \"nope\") :yes :no)         ;=> :yes   ; truthy — never silently absent"
  (%failure (apply str parts)))

(defn failure/with (fields & parts)
  "**Return** a failure that carries the map `fields` beside its message, so a caller can
branch on *which* failure it got without parsing the text: an HTTP status, the offset a
parse stopped at. The message is the concatenated display forms of `parts`, as for
`failure`; `fields` may not name `:message`. Read the fields back with `fields`.

    (:status (fields (failure/with {:status 404} \"not found: \" \"/x\")))   ;=> 404
    (error-message (failure/with {:status 404} \"not found\"))            ;=> \"not found\"
    (failure? (failure/with {} \"nope\"))                                 ;=> true"
  (%failure (apply str parts) fields))

;; The form's printed text is baked into the expansion, so a failure names what was
;; asserted without the caller restating it. The message parts sit in the failing branch
;; only: an `(assert ok? "context " (expensive))` pays for `expensive` when it raises.
(defmacro assert (test & message)
  "Raise an error naming `test` when it is falsy — an error map of kind `:assert` —
otherwise return its value. Any `message` parts follow the form in the error, joined like
`error`'s.

    (assert (+ 1 2))                                      ;=> 3
    (try (assert (= 1 2)) (catch e (error-message e)))    ;=> \"assert failed: (= 1 2)\"
    (try (assert (> -1 0) \"got \" -1) (catch e (error-message e)))   ;=> \"assert failed: (> -1 0): got -1\""
  (let (v (reflect/gensym "v"))
    `(let (~v ~test)
       (if ~v
         ~v
         (%raise {:kind :assert
                  :code "E0091"
                  :message (str ~(str "assert failed: " (pr-str test))
                             ~@(when message (cons ": " message)))})))))

;; `(catch Type e body…)` — Clojure/Java's *typed* catch. Brood's `catch` takes a
;; PATTERN and has no exception class, so this shape is not an error the
;; reader can see: the class name silently becomes the binding and the intended
;; binder is evaluated as a statement. It produces a WRONG PROGRAM, not a
;; diagnostic — `(catch Exception e (io/puts "caught" e))` binds the value to
;; `Exception` and prints the prelude's `e` (2.718…). Detected by shape: a symbol
;; binder whose handler *starts* with a bare symbol and has more forms after it.
;; There is no legitimate reading to protect — a leading bare symbol followed by
;; more body is dead code in every case — so this is a zero-false-positive guard.
(defn- %try-class-catch? (clause)
  (let (handler (rest (rest clause)))
    (and (symbol? (second clause))
      (> (count handler) 1)
      (symbol? (first handler)))))

;; (try body... (catch e handler...)) => (%try (fn () body...) (fn (e) handler...))
;; With no catch clause, it's just (do body...).
;;
;; (try body... [(catch e handler...)] (finally cleanup...)) — ADR-306 — runs
;; `cleanup` after the body (and after the handler, when there is one) whether the
;; try completes or throws, then yields the try's value or rethrows what escaped:
;;
;;   (let (o (%try (fn () [:ok <try-without-finally>]) (fn (e) [:threw e])))
;;     cleanup...
;;     (if (= (nth o 0) :threw) (throw (nth o 1)) (nth o 1)))
;;
;; `cleanup`'s value is discarded; a throw from `cleanup` replaces the pending one
;; (the Java/Clojure rule). A rethrown built-in error map is rebuilt into the error
;; it describes by `throw` (`LispError::from_error_map`), so what escapes a `finally`
;; prints and propagates as the original did. `%try` never catches a control
;; signal (a `receive` suspend) or an untrappable kill, so `finally` does not run
;; on `(exit pid :kill)`.
(defn- %try-finally-split (body)
  "Split `body` into `[forms finally-forms]` when its last form is a `(finally …)`
clause, else `[body nil]`. A `finally` anywhere but last is an error."
  (let (clause (last body))
    (if (and (pair? clause) (= (first clause) 'finally))
      (do
        (when (empty? (rest clause))
          (reflect/error-at clause
            "try: `(finally)` has no body — write `(finally cleanup…)` or drop the clause."))
        [(seq/but-last body) (rest clause)])
      (do
        ;; `any?` lives in seq.blsp, concatenated AFTER this file — walk by hand.
        (letrec (misplaced? (fn (forms)
                              (cond
                                (empty? forms) false
                                (and (pair? (first forms)) (= (first (first forms)) 'finally)) true
                                else (misplaced? (rest forms)))))
          (when (misplaced? body)
            (error "try: `(finally …)` must be the LAST clause — after `(catch …)`, if there is one.")))
        [body nil]))))

(defmacro try (& body)
  "Evaluate `body`; when it raises, run the first `(catch pattern [:when guard] handler…)`
clause whose pattern matches what was raised, with the pattern's bindings; when none
matches, the error propagates, raised again from where it was first raised. If a final
`(finally cleanup…)` clause is present, run `cleanup` afterwards whether or not anything
raised, then yield the try's value or rethrow what escaped.

An error the language raises is a map with `:kind` and `:message` (`:type`, `:arity`,
`:error` from `error`, `:match` from a failed pattern, …); `throw` raises any value as it
is. The clauses use the one pattern grammar, so `(catch e …)` catches everything.

    (try (risky) (catch e :failed))                    ;=> :failed
    (try (/ 1 0) (catch {:kind :type} :type) (catch {:kind :runtime :message m} m))   ;=> \"division by zero\"
    (try (throw :found) (catch :found :got-it))       ;=> :got-it
    (try 41 (finally nil))                             ;=> 41       ; cleanup ran, value survives
    (try (throw :x) (catch e :failed) (finally nil))   ;=> :failed   ; cleanup ran after the handler

`cleanup`'s own value is discarded; write the release there — `(finally (release r))` — and
it runs on both paths. The examples above keep it `nil` because an indented `form ;=> result`
line is EXECUTED by `doctest` (tests/doc_examples_test.blsp), so it has to be runnable."
  (let ([body cleanup] (%try-finally-split body))
    (if cleanup
      `(let (outcome (%try (fn () [:ok (try ~@body)]) (fn (escaped) [:threw escaped])))
         ~@cleanup
         (if (/= (/nth outcome 0) :threw)
           (throw (/nth outcome 1))
           (/nth outcome 1)))
      (%try-expand body))))

(defn- %try-catches (body)
  ;; `[forms catches]`: the trailing `(catch …)` clauses of `body`, in order, and the forms
  ;; before them.
  (letrec (split (fn (forms catches)
                   (let (clause (last forms))
                     (if (and (pair? clause) (= (first clause) 'catch))
                       (split (seq/but-last forms) (cons clause catches))
                       [forms catches]))))
    (split body ())))

(defn- %try-class-catch-error (clause)
  (let (binder (second clause) handler (rest (rest clause)))
    (reflect/error-at clause
      "try: `(catch "
      (str binder)
      " "
      (str (first handler))
      " …)` looks like Clojure's typed catch, which Brood does not have. "
      "`catch` takes a PATTERN and no exception class: write `(catch "
      (str (first handler))
      " …)`, or match the error's kind — `(catch {:kind :type} …)`. As written, `"
      (str binder)
      "` would be bound to the raised value and `"
      (str (first handler))
      "` evaluated as a statement.")))

(defn- %try-catch-all? (clause)
  ;; Does this `(catch pattern [:when guard] body…)` catch everything? Then it is the last
  ;; clause there can be, and the expansion needs no rethrow after it.
  (let (pattern (second clause)
        after (rest (rest clause))
        guard (if (= (first after) :when) (second after) nil))
    (%match-irrefutable? pattern guard)))

(defn- %try-expand (body)
  "The `try` expansion for a body with no `finally`: `(%try …)` when it has `catch` clauses,
else a `do`. One catch-all `(catch e …)` binds the caught error directly; otherwise the
clauses are `match` clauses over it, tried in order, and an error none of them matches is
raised again — from where it was first raised."
  (let ([init catches] (%try-catches body))
    (letrec (misplaced? (fn (forms)
                          (cond
                            (empty? forms) false
                            (and (pair? (first forms)) (= (first (first forms)) 'catch)) true
                            else (misplaced? (rest forms)))))
      (when (misplaced? init)
        (error "try: every `(catch …)` clause must come after the body, together at the end.")))
    (cond
      (empty? catches)
        (let (clause (last body))
          (cond
            (and (pair? clause) (= (first clause) 'fn))
            ;; Common mistake: (try body (fn (e) handler)) instead of (try body (catch e handler)).
            ;; Fail loud at macro-expansion time so the bug is caught before it silently becomes
            ;; (do body (fn (e) ...)) — a handler that is never installed.
              (reflect/error-at clause
                "try: last form is `"
                (pr-str clause)
                "` — did you mean `(catch "
                (let (params (second clause))
                  ;; `pair?` alone: `nil` is the empty list and is not a pair, so the `nil?`
                  ;; arm could never run.
                  (if (pair? params)
                    (str (first params))
                    "e"))
                " ...)`? Syntax: (try body... (catch e handler...))")
            else `(do ~@body)))
      else
        (do
          (letrec (check (fn (clauses)
                           (when (not (empty? clauses))
                             (when (%try-class-catch? (first clauses))
                               (%try-class-catch-error (first clauses)))
                             (check (rest clauses)))))
            (check catches))
          (let (only (first catches))
            (if (and (= (count catches) 1)
                  (symbol? (second only))
                  (not (= (first (rest (rest only))) :when)))
              `(%try (fn () ~@init) (fn (~(second only)) ~@(rest (rest only))))
              (let (caught (reflect/gensym "caught")
                    clauses (map catches rest)
                    rethrow (if (%try-catch-all? (last catches)) () `((_ (throw ~caught)))))
                `(%try (fn () ~@init) (fn (~caught) (match ~caught ~@clauses ~@rethrow))))))))))

;; Every error the language raises is a `{:kind :message [:code :file :line :col :hint
;; :trace]}` map (ADR-501), but `(throw x)` hands `catch` the value `x` verbatim — a
;; keyword, a string, a program's own map. `error-message` is the one accessor that turns any of
;; them into a human string, so a `(catch e …)` handler never has to branch on
;; the shape itself.
(defn error-message (e)
  "A human-readable message string for a caught value `e` — or for a **failure**, the
value a strict function returns when it cannot interpret its input. A raised string
comes back as-is, a structured error map yields its `:message`, a failure yields the
message it carries, and anything else its printed form.

    (error-message (try (error \"b\") (catch e e)))   ;=> \"b\"
    (error-message (string/->number \"abc\"))         ;=> \"string/->number: not a number: \\\"abc\\\"\""
  (cond
    (string? e) e
    (failure? e) (%failure-message e)
    (and (map? e) (get e :message)) (get e :message)
    else (pr-str e)))

;; ---- dynamic variables ------------------------------------------------------
;; Process-scoped, dynamically-bound variables (Lisp "special" vars), for
;; config-style knobs like *print-depth*. `defdyn` declares one with a default;
;; `binding` rebinds it for the dynamic extent of a body, restoring on exit (even
;; on error). A reference to the var resolves to the innermost active `binding`,
;; else the default. Bindings are per-process — they do NOT reach a `spawn`ed
;; child (it starts from the defaults). The kernel supplies only `%declare-dynamic`,
;; `%binding`, and `reflect/dynamic?`; the surface is these two macros (the `try` precedent).

;; (defdyn *x* 10) => declare *x* dynamic, then def its default.
(defmacro defdyn (name default)
  "Declare `name` a dynamic (process-scoped special) variable with the given default, rebindable via `binding`. Also marks the name **ambient** — never namespaced, so a `def` of it from any module rebinds this one root binding."
  (do
    ;; Declare at EXPANSION time as well as at run time. `defdyn` is the *only* door
    ;; to an ambient (never-namespaced) name, and the compile pass resolves
    ;; namespaces AFTER macroexpansion — so the mark has to exist before the `def`
    ;; head below is qualified, or `(defdyn *x* 0)` inside a module would define
    ;; `mod/*x*` while `binding` and every reader looked for bare `*x*`. The runtime
    ;; `%declare-dynamic` stays for a `defdyn` form built and `reflect/eval`'d dynamically.
    (%declare-dynamic name)
    `(do (%declare-dynamic '~name) (def ~name ~default))))

;; Split a flat binding list (*a* va *b* vb) into its names and value forms, at
;; expansion time (like the threading-macro helpers above).
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %binding-names (b) (if (nil? b) nil (cons (first b) (%binding-names (rest (rest b)))))))
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %binding-vals (b) (if (nil? b) nil (cons (second b) (%binding-vals (rest (rest b)))))))

;; (binding (*a* 1 *b* 2) body...) => (%binding '(*a* *b*) [1 2] (fn () body...))
;; The names go out as a quoted list and the values as a vector literal — both
;; reader/evaluator syntax, never function calls — so a locally-shadowed `list`
;; or `map` can't break the expansion (`fn`/`quote` are special forms).
(defmacro binding (bindings & body)
  "Rebind the dynamic variables in `bindings` (a flat `name value ...` list) for the dynamic extent of `body`, restoring them on exit (even on error).

    (with-out-str (binding (*err* *out*) (io/puts \"oops\" :to *err*)))   ;=> \"oops\\n\""
  (if (vector? bindings)
    (error "binding: bindings must be a list, not a vector: write (binding (*a* 1 *b* 2) …)."
      " Brood is lists-for-code, vectors-for-data (unlike Clojure).")
    (if (= 1 (%rem (count bindings) 2))
      (reflect/error-at bindings "binding: bindings must be name/value pairs, got " bindings)
      `(%binding (quote ~(%binding-names bindings)) [~@(%binding-vals bindings)] (fn () ~@body)))))
