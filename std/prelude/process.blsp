;; ---- spawn: run an expression as a new green process ------------------------
;; (spawn expr) runs `expr` in a fresh process and returns its pid. The expression
;; is wrapped in a 0-arg thunk, so its free *locals* are captured lexically (the
;; closure carries them) and its free *globals* resolve in the child — which is why
;; the thunk is shippable to another node (a closure serialises as data; see
;; docs/decisions.md). Note `(self)` inside `expr` is the *child's* pid: to hand the
;; parent's pid in, capture it first — `(let (me (self)) (spawn (work me)))`.
;; `spawn` has two shapes:
;;   (spawn expr)          → (%spawn (fn () expr)) — anonymous; always a fresh process.
;;   (spawn name expr)     → (%spawn-named name (fn () expr)) — **named & idempotent**.
;;                            If a process is already registered under `name` (a
;;                            keyword/symbol) and is still alive, the call is a no-op
;;                            and returns the existing pid; `expr` is never evaluated.
;;                            Otherwise spawns fresh and registers the new pid.
;;
;; The named form is the hot-reload-safe way to start a long-lived worker, replacing
;; the `defonce *worker* (spawn …)` pattern (ADR-039). A file containing
;; `(spawn :worker (worker))` reloaded by a hot-reload supervisor sees the
;; name is alive and does nothing — the running worker keeps going with its
;; current state, picking up the new code via the next global lookup of
;; `worker`. When the process dies, its registered name is reaped automatically
;; (`process::deregister` calls `dist::unregister_dead_pid`), so a fresh
;; reload spawns again — no stale entries.
;;
;; A literal zero-arg lambda `(fn () …)` is *already* a process thunk. Re-wrapping
;; it (`(fn () (fn () …))`) would make the process merely build a closure and
;; discard it — a silent no-op. So pass such a form through unwrapped:
;; `(spawn (fn () body))` and `(spawn body)` then mean the same. (The dual footgun —
;; a bare function *name* like `(spawn worker)`, which would yield the closure and
;; exit — is handled by `%spawn-body-thunk` below, which wraps a symbol as a *call*.)
(defn- %spawn-thunk-form? (form)
  ;; `(fn)`/`(fn () …)` only: an empty parameter list is `nil`, and a vector `[]` is not one.
  (and (pair? form) (= (first form) 'fn) (nil? (second form))))

;; The process-body thunk a `spawn`-family macro wraps its body form in. Three cases,
;; each closing off a footgun so no `spawn` shape can silently do nothing:
;;   - a literal `(fn () …)` is already the thunk → pass it through (re-wrapping it
;;     would build-and-discard a closure);
;;   - a **bare symbol** is a function *name* → wrap it as a CALL `(fn () (name))`,
;;     so `(spawn worker)` runs `worker` instead of
;;     yielding the closure and exiting. A process body that merely *evaluates* a
;;     symbol has no effect, so this is never a legitimate use — the call either
;;     works or raises a loud "not callable", never a silent no-op;
;;   - anything else is the body expression → `(fn () expr)`.
(defn %spawn-body-thunk (form)
  "Normalise a `spawn`/`spawn-link` body `form` into the 0-arg thunk the kernel wants: an
explicit `(fn () …)` passes through, a bare symbol becomes `(fn () (sym))` so `(spawn worker)`
CALLS the named function, and anything else is wrapped as the body expression. Expansion-time
plumbing for the `spawn` special forms."
  (cond
    (%spawn-thunk-form? form) form
    (symbol? form) `(fn () (~form))
    else `(fn () ~form)))

(defmacro spawn (head & more)
  "Run an expression in a new green process; returns its pid. Shapes:
  - `(spawn expr)` — anonymous; `expr` is the process body.
  - `(spawn (fn () expr))` — same as above (a zero-arg lambda is the body too, so
    passing a thunk just works, no silent no-op).
  - `(spawn fn-name)` — a bare function name is **called**: `(spawn worker)` runs
    `(worker)`, not `worker`-then-exit.
  - `(spawn name expr)` — named & idempotent: returns the existing pid if
    a live process is already registered under `name`. The hot-reload-friendly
    form (reloading the file doesn't fire a second worker).

  **Let it crash**: an uncaught throw kills the process and
  any monitors see `[:down ref pid [:error {:kind :message … :trace}]]` immediately
  (the reason carries the structured error map, call trace included).

    (pid? (spawn :done))   ;=> true
    (let (me (self)) (spawn (send me [:doc-from-child 42])) (receive ([:doc-from-child n] n)))   ;=> 42"
  ;; Param name is `more` (not `rest`) so the body can still call the
  ;; prelude's `rest` function without param-shadowing itself.
  (if (empty? more)
    `(%spawn ~(%spawn-body-thunk head))
    (if (empty? (rest more))
      ;; `(spawn (defn f …) (f …))` READS as a two-form body and is not one: the name
      ;; position takes any expression, `defn` returns its own name symbol, so every
      ;; spawn registers under that one name and — this form being idempotent — only
      ;; the FIRST actually starts a process. Silent, and it cost `breakage/
      ;; chaos2_process_genserver` its P43 assertion for a long time (100 clients, 1
      ;; running). Naming a process after a definition form is never meaningful, so
      ;; refuse it at expansion rather than run one process and look like a hundred.
      (if (and (pair? head) (contains? #{'def 'def- 'defn 'defn- 'defmacro} (first head)))
        (throw "spawn: a definition form cannot be a process name. (spawn name expr) is the NAMED, idempotent form, so (spawn (defn f ...) (f ...)) registers every spawn under the same name and only the first one runs. Move the definition out of the spawn, or wrap the body in (do ...).")
        `(%spawn-named ~head ~(%spawn-body-thunk (first more))))
      (throw "spawn: expected (spawn expr) or (spawn name expr)"))))

(defmacro spawn-link (expr)
  "Spawn a new green process running `expr` and `link` it to the caller **atomically**
(ADR-067) — returns its pid. The link is symmetric: if either
process dies abnormally the other is taken down too (or receives a trappable `[:EXIT …]`
if it `(proc/trap-exit true)`'d). The link is established *before* the child runs, so even an
instant exit reaches the caller with its **true** reason — unlike a separate
`(let (p (spawn expr)) (link p) p)`, where a child that exits in the gap is linked dead
and reports `:noproc` (losing `:normal`). Supervised children should use this so a fast
`:normal` exit isn't misread as a crash. A zero-arg lambda `(fn () …)` body is
passed through (not re-wrapped), like `spawn`.

    (pid? (spawn-link :done))   ;=> true   ; a :normal exit does not reach the caller"
  `(%spawn-link ~(%spawn-body-thunk expr)))

(defmacro spawn-monitor (expr)
  "Spawn a new green process running `expr` and `monitor` it from the caller
**atomically** — returns `[pid ref]`. When the child dies the
caller receives `[:down ref pid reason]`, one-shot and unidirectional (contrast
`spawn-link`, which is symmetric and kills).

The monitor is established *before* the child runs, and that is the whole point. The
idiomatic-looking `(let (p (spawn expr) r (monitor p)) …)` is only reliable while the
spawner does not yield between the two calls: let any gap open — a loaded scheduler, or a
boundary trace wrapping the code — and a short-lived child exits first, `monitor` takes
its already-dead branch, and the DOWN arrives carrying **`:noproc` instead of the real
exit reason**. Nothing raises — the receive fires with a reason that says
only \"already gone\" — so prefer this form whenever the reason matters.

    (let ([p r] (spawn-monitor :ok)) (receive ([:down ^r _ reason] reason) (after 500 :lost)))   ;=> :normal

A zero-arg lambda `(fn () …)` body is passed through (not re-wrapped), like `spawn`."
  `(%spawn-monitor ~(%spawn-body-thunk expr)))

;; ---- sleep: park on the scheduler timer (policy in Brood) ---------------
;; Sleep `ms` milliseconds in the current process. A bare `(receive (after ms …))` does
;; the same since ADR-520 (it used to consume the next queued message); `sleep` keeps its
;; own never-matching clause — a fresh, unforgeable `(ref)` — so it says what it means
;; and checks its argument by name. Parks the green process on the scheduler's
;; timer (it does NOT block a worker thread) — which is why sleep is pure Brood
;; rather than a Rust primitive.
;; `sleep` is defined AFTER `receive`, below — see the note at its definition.

;; ---- timers ----------------------------------------------------------------
;; `timer/send-after` / `timer/send-interval` / `cancel` moved to `std/timer.blsp`: they SCHEDULE a
;; message, which is a different job from parking the current process, and they now sit
;; with their own cancel instead of being split across the prelude and `proc/`.
;; `sleep` stays here — it parks THIS process (a peer of `receive`), and the module loader
;; itself sleeps between polls, so rooting it in a module would make the loader require
;; one mid-require.

;; Node-link auto-reconnect lives in `std/net/reconnect`:
;; `(reconnect/watch "name@host:port")` — the reference loads the module —
;; exponential backoff, [:nodeup]/[:nodedown] subscriber events, idempotent
;; named watchers.

;; ---- receive: selective, pattern-matched message receipt --------------------
;; (receive clause...) where each clause is (pattern [:when guard] body...), with an
;; optional trailing (after ms body...) timeout clause. Reuses the match compiler
;; (%match-build-chain) to build a *matcher* fn: given a message it returns which clause
;; matched and what it bound (see below), or nil on no match. The %receive primitive runs that
;; over the mailbox — scanning in order, removing+running the first match, leaving
;; non-matching messages queued (true selective receive).
;;
;;   (receive
;;     ([:say text]      (%write-out (str text "\n")))
;;     (n :when (int? n) (handle n))
;;     (after 5000       (throw [:timeout])))   ; catchable via try/catch
;;
;; (receive) with no clauses blocks for the next message and returns it.
;; (after 0 ...) is a non-blocking poll; (after ms>0 ...) waits up to ms.

;; The bodies do NOT live in the matcher. The matcher's job is only to pick a clause
;; and hand back what that clause's pattern bound; the body itself is emitted at the
;; *call site* (see `receive` below). Two reasons:
;;
;;   * A `(fn () body…)` thunk costs a closure + captured-env allocation and a second
;;     closure activation on every received message, several times the small-vector
;;     protocol used instead.
;;   * `Inst::MakeClosure` is not in the JIT subset, so building that thunk would make
;;     the WHOLE matcher arm ineligible for the JIT. A vector literal (`Inst::MakeVector`) is in the subset.
;;
;; Emitting the body at the call site also puts it in the owning arm's bytecode, so a
;; receive loop's `(recur …)`/self-call is an ordinary tail call in that arm rather
;; than a call through a thunk — the receive clauses compile into the enclosing
;; function.

;; The variables a clause's pattern binds, de-duplicated: a non-linear pattern (`[a a]`)
;; lists `a` twice, but binds it once (the repeat compiles to an equality check).
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-dedupe (vars seen)
    (cond
      (empty? vars) nil
      (%match-member? (first vars) seen) (%receive-dedupe (rest vars) seen)
      else (cons (first vars) (%receive-dedupe (rest vars) (cons (first vars) seen))))))
(defn- %receive-clause-vars (pat) (%receive-dedupe (%pattern-vars pat) nil))

;; Pair each clause with the variables its pattern binds and its index, ONCE. Both
;; halves below (the matcher's result vector and the call site's rebinding) need that
;; same list in that same order, and `%pattern-vars` walks the whole pattern — so
;; deriving them from a shared prep keeps expansion to one walk per clause instead of
;; two. Shape: `[clause vars idx]`.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-prep (clauses idx)
    (if (empty? clauses)
      nil
      (cons [(first clauses) (%receive-clause-vars (first (first clauses))) idx]
        (%receive-prep (rest clauses) (+ idx 1))))))

;; Replace a clause's body with `[idx var…]` — the clause's index plus the values its
;; pattern bound. Keeps the :when guard in place, so the match compiler still gates on
;; it and the guard still runs exactly once, during the scan.
(defn- %receive-result-clause (prep)
  (let (clause (nth prep 0)
        vars (nth prep 1)
        idx (nth prep 2)
        pat (first clause)
        more (rest clause))
    (if (= (first more) :when)
      `(~pat :when ~(second more) [~idx ~@vars])
      `(~pat [~idx ~@vars]))))

;; `(v0 (nth r 1) v1 (nth r 2) …)` — the flat `let` binding list that unpacks the
;; matcher's result vector back into the clause's pattern variables.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-binds (vars r i)
    (if (empty? vars)
      nil
      (cons (first vars)
        (cons `(nth ~r ~i) (%receive-binds (rest vars) r (+ i 1)))))))

;; One clause's call-site code: rebind its pattern variables from the result vector,
;; then run its body.
(defn- %receive-body-code (prep r)
  (let (clause (nth prep 0)
        more (rest clause)
        body (if (= (first more) :when) (rest (rest more)) more)
        binds (%receive-binds (nth prep 1) r 1))
    (if (empty? binds) `(do ~@body) `(let ~binds ~@body))))

;; The call-site dispatch: `(if (= (nth r 0) 0) body0 (if (= (nth r 0) 1) body1 …))`.
;; The last clause is reached by elimination (%receive only ever returns a result a
;; clause matched), so it needs no test — and a single-clause receive, the common
;; shape, collapses to its body with no dispatch at all. Every body sits in tail
;; position, so a receive loop stays O(1) stack.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-dispatch (preps r)
    (if (empty? (rest preps))
      (%receive-body-code (first preps) r)
      `(if (= (nth ~r 0) ~(nth (first preps) 2))
         ~(%receive-body-code (first preps) r)
         ~(%receive-dispatch (rest preps) r)))))

;; The native pattern spec (ADR-409).
;; When every clause is a simple shape, the matcher is not a closure but a SPEC the kernel
;; matches itself (`process/receive_spec.rs`): no closure is built per `receive`, and none is
;; called per scanned message. The patterns (one per clause) are named by a KEYWORD,
;; `%receive-spec-key` — an immediate, so the arm embeds no heap constant and stays shareable
;; across processes — and a `receive` that pins passes `[key pin0 …]`, the pinned values read
;; at the call site: once per `receive`, where the closure read them per candidate. That is
;; why only a pinned SYMBOL qualifies (it cannot differ between the two, as `%receive-pin`
;; argues). With no pins a `receive` allocates nothing to say how it matches.
;; A pattern spec is `[:any]`, `[:bind]`, `[:same k]` (a repeated binder: equal to binding k),
;; `[:eq v]` (a literal), `[:pin i]` (equal to pinned value i), or `[:vec p…]`; anything else
;; — a guard, a list/map/`or`/`and`/record/bytes pattern, a pinned expression — answers
;; `:none`, and one `:none` keeps the closure for the whole `receive`. The walk threads
;; `st = [bound pins]`: the clause's binders so far, in first-occurrence order (the order the
;; closure's `[idx var…]` answer lists them in), and the `receive`'s pinned symbols so far.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-spec-pat (pat st)
    "`[spec st]` for `pat`, or `[:none st]`."
    (let (bound (first st) pins (second st))
      (cond
        (%match-wildcard? pat) [[:any] st]
        (%match-bind-sym? pat)
          (let (k (%receive-index-of pat bound 0))
            (if (nil? k) [[:bind] [(append bound (list pat)) pins]] [[:same k] st]))
        (%match-quoted? pat) [[:eq (second pat)] st]
        (%match-pin? pat)
          (if (symbol? (second pat))
            [[:pin (count pins)] [bound (append pins (list (second pat)))]]
            [:none st])
        (vector? pat) (%receive-spec-vec (%match-vec->list pat) st (list))
        (or (keyword? pat) (string? pat) (number? pat) (nil? pat) (= pat true) (= pat false))
          [[:eq pat] st]
        else [:none st]))))

;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-spec-vec (elems st acc)
    (cond
      (empty? elems) [(%receive-cons-vec :vec (reverse acc)) st]
      (= (first elems) '&) [:none st]
      else
        (let (r (%receive-spec-pat (first elems) st))
          (if (= (first r) :none)
            [:none st]
            (%receive-spec-vec (rest elems) (second r) (cons (first r) acc)))))))

;; `[head x…]` as a vector VALUE — the patterns are data, quoted whole, never a form.
(defn- %receive-cons-vec (head xs) (apply vector (cons head xs)))

(defn- %receive-index-of (x xs i)
  (cond (empty? xs) nil (= x (first xs)) i else (%receive-index-of x (rest xs) (+ i 1))))

;; `any?`, which is defined later in the prelude than this.
(defn- %receive-some? (xs pred)
  (cond (empty? xs) false (pred (first xs)) true else (%receive-some? (rest xs) pred)))

;; Every clause's pattern spec, threading the pins across clauses: `[specs pins]`, or nil.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-spec-clauses (clauses pins acc)
    (if (empty? clauses)
      [(reverse acc) pins]
      (let (r (%receive-spec-pat (first (first clauses)) [(list) pins]))
        (if (= (first r) :none)
          nil
          (%receive-spec-clauses (rest clauses) (second (second r)) (cons (first r) acc)))))))

;; The whole `receive`'s spec FORM — the spec key (a keyword the kernel parses once,
;; `%receive-spec-key`) when it pins nothing, else `[key pin0 …]` — or nil to keep the
;; closure. A clause with a `:when` guard keeps it: the guard is Brood code.
(defn- %receive-spec (clauses)
  (if (%receive-some? clauses (fn (clause) (= (second clause) :when)))
    nil
    (let (r (%receive-spec-clauses clauses (list) (list))
          ;; nil when the kernel cannot interpret a pattern this walk admitted (a decimal
          ;; literal, a quoted list): the kernel's parse, not this walk, decides what a spec is
          key (if (nil? r) nil (%receive-spec-key (apply vector (first r)))))
      (cond
        (nil? key) nil
        (empty? (second r)) key
        else `[~key ~@(second r)]))))

;; Walk the clause list and error if an `(after ...)` clause appears before the last
;; position — a non-last `after` would silently become a pattern clause matching the
;; symbol `after`, which is almost certainly a mistake.
(defn- %receive-check-after (clauses)
  ;; Every clause is a list — `(pattern body…)` or the trailing `(after ms body…)`. A
  ;; bare `:after 100 …` would otherwise fall through to the pattern walk and report
  ;; "first: expected list … got keyword" from a helper nobody wrote.
  (when (and (not (empty? clauses)) (not (pair? (first clauses))))
    (error "receive: each clause must be a (pattern body...) list, and the timeout clause (after ms body...), got "
      (pr-str (first clauses))))
  (if (or (empty? clauses) (empty? (rest clauses)))
    nil
    (if (and (pair? (first clauses)) (%eq (first (first clauses)) 'after))
      (reflect/error-at (first clauses)
        "receive: (after ...) must be the last clause, but it appears before "
        (count (rest clauses))
        " more clause(s)")
      (%receive-check-after (rest clauses)))))

;; Split clauses into [real-clauses ms-or-nil timeout-body-or-nil], peeling an
;; optional trailing (after ms body...). `after` as a final clause head is reserved.
(defn- %receive-split (clauses)
  (let (lst (last clauses))
    (if (and (pair? lst) (= (first lst) 'after))
      [(seq/but-last clauses) (second lst) `(do ~@(rest (rest lst)))]
      ;; no `after`: ms nil (wait forever), so `%receive` can never return its
      ;; timeout answer and the timeout branch is provably dead — the macro omits it.
      [clauses nil nil])))

;; The set of leading keyword tags a `receive`'s clauses can match, or nil when the
;; filter cannot be used. Passed to `%receive` as a THIRD argument so the mailbox scan
;; can reject a non-matching message by peeking its tag, without first rebuilding it
;; into the heap (`from_message`) and running the matcher — the cost that makes a
;; selective receive against a backlog O(rounds x backlog).
;;
;; Conservative by construction: it answers nil (no filtering, scan everything) unless
;; EVERY clause is a vector pattern whose head is a literal keyword. A catch-all
;; pattern, a bare symbol, a map/list pattern or a non-keyword head all disable it, so
;; the filter can never skip a message some clause would have matched. Guards are
;; irrelevant to it — a `:when` can only reject a message the tag already admitted.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-tags (clauses)
    (if (empty? clauses)
      nil
      (let (pat (first (first clauses))
            tag (if (and (vector? pat) (> (count pat) 0) (keyword? (first pat)))
                  (first pat)
                  nil))
        (if (nil? tag)
          nil ; one un-taggable clause disables the filter
          (let (rest-tags (%receive-tags (rest clauses)))
            (if (and (nil? rest-tags) (not (empty? (rest clauses))))
              nil ; a later clause disabled it
              (cons tag rest-tags))))))))

;; The receive-mark hint (ADR-195): the expression EVERY clause pins, when they all pin the
;; same one — `([:reply ^r v] …)` yields `r`. Any clause that pins nothing, or pins something
;; different, disables it (nil), exactly like `%receive-tags`. The kernel only acts on it when
;; the value turns out to be a `ref` this process minted, so a false positive here costs
;; nothing but a wasted comparison.
(defn- %receive-pinned-in (pat)
  "The single pinned expression inside `pat`, or nil if it pins none or several."
  (cond
    (%match-pin? pat) (second pat)
    (vector? pat)
      (fold (seq pat)
        nil
        (fn (acc p)
          (let (inner (%receive-pinned-in p))
            (cond
              (nil? inner) acc
              (nil? acc) inner
              (= acc inner) acc
              else :none))))
    else nil))

;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %receive-pin (clauses)
    "The **symbol** pinned by every clause, or nil when they do not agree.

  Restricted to a symbol deliberately. The hint is emitted as a form that the call site
  evaluates *in addition to* the matcher's own evaluation of the same pin, so anything with a
  side effect (or a value that could differ between the two evaluations) would be run twice.
  A pinned symbol — `^r`, which is the whole idiom this exists for — reads a binding and cannot
  differ. Any other pinned expression declines the hint and scans from the front."
    (if (empty? clauses)
      nil
      (let (first-pin (%receive-pinned-in (first (first clauses))))
        (if (or (nil? first-pin) (= first-pin :none) (not (symbol? first-pin)))
          nil
          (if (empty? (rest clauses))
            first-pin
            (let (rest-pin (%receive-pin (rest clauses)))
              (if (= rest-pin first-pin) first-pin nil))))))))

(defmacro receive (& clauses)
  "Selectively receive a message from the mailbox: run the first `(pattern [:when guard] body...)` clause that matches, leaving others queued. An optional final `(after ms body...)` clause fires on timeout; `(receive)` blocks for the next message, and `(receive (after ms body...))` waits `ms` without touching the mailbox.

    (do (send (self) [:doc-ping 1]) (receive ([:doc-ping n] n)))   ;=> 1
    (receive ([:doc-never-sent] :got) (after 0 :timed-out))       ;=> :timed-out"
  (do
    (%receive-check-after clauses)
    ;; Before the pin/tag/prep scans below, none of which bounds its walk.
    (each (first (%receive-split clauses)) (fn (clause) (%match-refuse-too-deep (first clause))))
    (let (parts (%receive-split clauses)
          real (nth parts 0)
          ms (nth parts 1)
          on-time (nth parts 2)
          msg (reflect/gensym "msg")
          r (reflect/gensym "rcv")
          ;; Walk each pattern once; both halves below read the same prep.
          preps (%receive-prep real 0)
          ;; The matcher answers "which clause, and what did it bind?" as `[idx var…]`,
          ;; or nil for no match. No clauses at all — `(receive)` — takes the next message
          ;; as-is. Only an `after` — `(receive (after ms body))` — matches NOTHING: it
          ;; waits, leaving the mailbox alone, which is what everyone who wrote it meant
          ;; (ADR-520). It used to take the next queued message and return it instead of
          ;; the body, so as a pause it ate a message and returned at once.
          ;; A native spec when every clause is a simple shape (ADR-409); else the closure.
          waits-only (and (empty? real) (not (nil? ms)))
          spec (cond
                 waits-only nil
                 (empty? real) (%receive-spec-key [[:bind]])
                 else (%receive-spec real))
          matcher (cond
                    spec spec
                    waits-only `(fn (~msg) nil)
                    (empty? real) `(fn (~msg) [0 ~msg])
                    else
                      `(fn (~msg)
                         ~(%match-build-chain (map preps %receive-result-clause) msg nil true)))
          dispatch (if (empty? real) `(/nth ~r 1) (%receive-dispatch preps r))
          ;; nil when the filter can't apply (see `%receive-tags`). Built as a vector
          ;; FORM (`[~@tags]`), not by calling a function: a plain list would expand to
          ;; `(:tag …)`, which evaluates as a keyword accessor call (ADR-165) rather
          ;; than data — and calling `vec` here would run at macro-expansion time
          ;; *during the prelude build*, where its own dependency (`into`, defined
          ;; ~2000 lines later) does not exist yet.
          tag-list (if (empty? real) nil (%receive-tags real))
          tags (if (nil? tag-list) nil `[~@tag-list])
          ;; The receive-mark hint — see `%receive-pin`. Emitted as the pinned FORM, so it
          ;; evaluates at the call site to the same value the pattern compares against.
          pin (if (empty? real) nil (%receive-pin real)))
      ;; `%receive` returns the matcher's result vector, or nil on timeout (only
      ;; reachable with an `after` clause — nil is unambiguous because a match always
      ;; answers with a vector). The bodies run HERE, in the caller's tail position.
      (if (nil? ms)
        `(let (~r (%receive ~matcher nil ~tags ~pin)) ~dispatch)
        `(let (~r (%receive ~matcher ~ms ~tags ~pin))
           (if (/nil? ~r) ~on-time ~dispatch))))))

;; `sleep` is defined HERE, below `receive`, and the order is load-bearing. Its body IS a
;; `receive`, and a macro that is not yet defined when a form is compiled does not expand
;; then — it expands LAZILY, at first call, on a path that runs no namespace-resolve pass.
;; `receive`'s template uses the `/name` root escape (so a user module defining `nil?` or
;; `nth` cannot capture it), and an escape that reaches the evaluator unresolved is an
;; unbound symbol — defined above `receive`, every `(sleep …)` would raise `unbound
;; symbol: /nil?`. Defined after it, it expands at compile time where the escape
;; resolves (KI-73). Keep it here.
(defn proc/sleep (ms)
  "Park the current process for `ms` milliseconds without touching its mailbox — every queued message stays queued. Parks on the scheduler timer; it does not block a worker thread.

    (proc/sleep 0) ;=> nil"
  ;; Checked here, not left to `receive`'s timeout check, so the error names `sleep` — a
  ;; form the caller actually wrote.
  (if (or (nil? ms) (and (int? ms) (>= ms 0) (<= ms 9223372036854775807)))
    (let (never (ref)) (receive (^never nil) (after ms nil)))
    (error "proc/sleep: expected a non-negative whole number of milliseconds (or nil to park for good), got "
      ms)))

;; ---- dirty-native offload (ADR-144) -----------------------------------------
;; A long/blocking native runs on a small OS
;; pool and only THIS process waits — its scheduler worker keeps running other
;; processes. Mechanism is `%offload` (kernel: copy args out, run on the pool,
;; deliver the result as a message); this wrapper is the policy — park in a
;; selective receive on the job's token, rethrow errors as ordinary throws.
;; Sits AFTER the `receive` macro because it uses it. Note: no prelude form leaves a
;; dead captured-frame closure for the freeze to scrub (ADR-155), so the scrub branch in
;; `Heap::to_prelude` is not exercised at boot; the hard assert for *reachable*
;; env-capturing closures still runs on every closure.
(defn proc/offload (f & args)
  "Run the blocking native `f` (e.g. `file/slurp-bytes`, `%git-clone`,
`%pbkdf2-sha256-bytes`) with `args` on the dirty-offload OS pool and wait for
the result — parking only this process, never a scheduler worker. An error in
the native rethrows here, catchable as usual. Only long/blocking
data-in/data-out natives are allowed (`%offload` refuses the rest); other
mailbox messages stay queued while waiting (selective receive).

    (proc/offload file/slurp-bytes \"big.bin\")   ;~> …the file's bytes, read off the scheduler…"
  (let (tok (%offload f (into [] args)))
    (receive
      ([:offload ^tok result] result)
      ([:offload-error ^tok e] (throw e)))))

;; `read-line` is the same seam as `offload`, for terminal input (ADR-059 Phase 2): the
;; kernel's stdin reader thread does the blocking read and delivers the line, so a process
;; waiting on a terminal holds no scheduler worker. Before this the read took the global
;; stdin lock on the calling worker, and a few processes waiting for input nobody typed
;; pinned the whole pool (KI-97 item 2).
;; Trusted, not verified: the line arrives as a kernel message, which the checker cannot
;; type — the stdin reader sends a string or nil.
(check-allow :trusted
  (defn io/read-line ()
    "Read one line from stdin, returning it as a string with the trailing newline
stripped, or `nil` at end of input (EOF / Ctrl-D). Parks only this process — the
read happens on the kernel's stdin reader thread, which serves callers in request
order — so other mailbox messages stay queued while waiting (selective receive)."
    (let (tok (%read-line-start))
      (receive
        ([:stdin ^tok line] line)
        ([:stdin-error ^tok e] (throw e))))))
(sig io/read-line (-> (or nil string)))

;; Membership is `includes?` (value in a sequence, `(includes? coll x)`) and `contains?`
;; (key in a map). There is deliberately no `member?` duplicate.

;; ---- the default crash reporter, armed lazily (ADR-305, ADR-313) -------------
;; The reporter itself is `std/proc/crash-report.blsp`, and CALLING into it pulls a
;; nine-module require closure — `io/puts` alone brings `io`, `file`, `path`, `string`,
;; `reflect` and `math`, and `os/env` another four — a large share of a short run, paid
;; whether or not anything crashes. That is the wrong trade for a reporter whose whole job is to be
;; ready for a rare event, on a runtime that explicitly cares about short-lived work
;; (`nest check`, a one-shot script, a request handler).
;;
;; So the ARM is split from the REPORTING. What genuinely must happen before the program
;; starts is the kernel SUBSCRIPTION: `sysmon::crash_reported_elsewhere` reads it to stand
;; the kernel's own `process N died: …` one-liner down, and a crash that happens before we
;; subscribe is a crash nobody reports. That costs one `proc/*` load and nothing else.
;;
;; Everything that formats a report is reached only through the qualified name in
;; `%crash-reporter-shim` below, and a qualified reference loads its module at the first
;; lookup that misses (ADR-335) — so a run that never crashes never loads the module, and the
;; first crash loads it before rendering anything. Semantics are unchanged either way: same
;; subscription, same registered name, same reports.

(defn- %crash-reporter-shim (starter)
  "The armed-but-unloaded crash reporter: subscribed to the kernel's abnormal exits while
holding no reference to `crash-report` until one fires. The first event loads the module
and hands off to `crash-report/take-over`, which never returns. `:stop` disarms without
ever loading it, so stopping a run that never crashed stays free.

`crash-report/take-over` is bound by nothing at boot: the first lookup that misses loads
`std/proc/crash-report.blsp` (ADR-335), so a run that never crashes never pays for the
reporter's nine-module closure (ADR-313). If that load ever fails here, the reporter dies
silently at the exact moment it is needed — it is the one process whose own death nobody
reports."
  (receive
    (:stop (do (proc/system-monitor nil) nil))
    (m (crash-report/take-over starter m))))

(defn %crash-report-arm-default ()
  "Arm the default crash reporter (ADR-305) unless `BROOD_NO_CRASH_REPORT` is set, and
unless one is already running. Returns the listener pid, or nil when opted out.
`brood file`, `nest run`, `project-release/run-bundle` and the REPL call this before the program
starts; `nest test` deliberately does not.

Lives in the prelude rather than in `crash-report` because a function that decides
*whether* to arm must not load the nine modules it might not arm. The env read is
`%getenv` for the same reason:
`os/env` is `(%getenv name)` behind four modules.

The registered name is duplicated as a literal in `crash-report`'s `crash-report-name`;
`stop`/`running?` find this listener through it, and `crash_report_test`'s stop-after-arm
case fails if the two ever disagree."
  (if (%getenv "BROOD_NO_CRASH_REPORT")
    nil
    (let (running (proc/whereis :crash-reporter))
      (if running
        running
        (let (starter (self)
              listener (spawn (%crash-reporter-shim starter)))
          (proc/register :crash-reporter listener)
          (proc/system-monitor listener {:exit-abnormal true})
          listener)))))

;; Copy an immutable map into a fresh mutable table. Used only by the compiler's
;; linear-map-accumulator rewrite (ADR-112, ADR-360 in docs/decisions.md) to seed the
;; private table from the accumulator's input map; never surfaced to user code. Lives
;; here, after control.blsp, because it needs `try`: a prelude body that names a macro
;; defined LATER in the boot order compiles to nothing the VM can run and defers to the
;; tree-walker on every call (it did, from predicates.blsp — 12M instructions per call).
(defn %table-from-map (m)
  "Copy the immutable map `m` into a fresh mutable table, or `nil` when a table cannot
stand in for it — a value a table cannot hold (a rope, a builtin, a lazy view, a
self-referential closure) or a record, whose misses go through `Lookup` where a table's
do not. Internal: used only by the compiler's linear-map-accumulator rewrite (ADR-112,
ADR-360 in docs/decisions.md) to seed its private table — `nil` sends the wrapper down the
unrewritten copy of the loop, so the rewrite is exact on every input — and never surfaced to
user code; reach for `table/new` instead."
  ;; The refusal IS the answer: a put that raises names a value the table cannot hold,
  ;; and nil is what the wrapper reads as "run the loop as written".
  (if (not (map? m))
    nil
    (check-allow :discarded-catch
      (try
        (reduce (%map-pairs m) (%table) (fn (t kv) (%table-put t (first kv) (second kv))))
        (catch _e nil)))))
