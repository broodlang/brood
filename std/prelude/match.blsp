;; ---- pattern matching -------------------------------------------------------
;; The matcher is written in Brood, not Rust: a pattern->code compiler (a macro
;; plus expand-time helper `defn`s, exactly like the threading macros compute at
;; expansion time) that emits nested `if`/`let` over existing primitives —
;; `pair?`, `first`, `rest`, `nil?`, `vector?`, `vector-ref`, `vector-length`,
;; and `%eq` (the kernel equality op, used by convention over `=` so a local
;; binding named `=` can't hijack a generated match). No new special form (the
;; `try`/`catch` precedent: a macro over primitives). One compiler serves `match`
;; here, and the `let` / `fn` special forms delegate to it for destructuring.
;; See docs/pattern-matching.md.
;; (Note: the other emitted primitives — `first`/`rest`/`pair?`/… — are still
;; ordinary names a local binding could shadow; full macro hygiene is deferred.)
;;
;; THE ONE TRAP: a bare symbol in a pattern *binds* (and shadows); it does not
;; test against a same-named value. Match a known value with a keyword (:ok), a
;; quoted symbol ('none), or a pin (~x). The grammar:
;;   _              wildcard (matches anything, binds nothing)
;;   x              binds x  (a repeated x is an equality constraint — non-linear)
;;   42 "s" :k nil  a literal, matched by =
;;   'sym           the literal symbol sym
;;   ~expr          the current value of expr (a pin)
;;   (p1 p2 ...)    a list of that exact length, element-wise
;;   (p1 & rest)    head(s) + tail bound (the & rest marker)
;;   [p1 p2 ...]    a vector of that exact length (the tagged-data / tuple idiom)

;; -- pattern shape predicates --
(defn- %match-wildcard? (p) (= p '_))
(defn- %match-bind-sym? (p) (and (symbol? p) (not (= p '_)) (not (= p '&))))
(defn- %match-quoted? (p) (and (pair? p) (= (first p) 'quote)))
;; A **pin** — `^expr`, read as `(%pin expr)`: match the current *value* of `expr`
;; rather than binding a name.
(defn- %match-pin? (p) (and (pair? p) (= (first p) '%pin)))
;; `~expr` in pattern position — the pre-`^` pin spelling. `~` now belongs to
;; quasiquote alone (a pin written `~expr` IS `(unquote expr)`, so a macro template
;; consumed it before the pattern compiler ever saw it, making pinned patterns
;; unemittable from a macro). Left as a list pattern it would silently try to match
;; a 2-element list headed by the symbol `unquote`, so name it instead.
(defn- %match-stale-pin? (p) (and (pair? p) (= (first p) 'unquote)))
;; `(or p q …)` — an ALTERNATIVE pattern: try each in order, first match wins
;; (ADR-160). `(and p q …)` — a CONJUNCTION: every pattern must match the same
;; value, which is also how you capture the whole while destructuring it (Clojure's
;; `:as`, Rust's `x @ pat`): `(and whole {:keys [a]})`.
(defn- %match-or-pattern? (p) (and (pair? p) (= (first p) 'or)))
(defn- %match-and-pattern? (p) (and (pair? p) (= (first p) 'and)))
;; `(not …)` stays rejected: it binds nothing and reads as a *guard*, which is what
;; `:when` is for. Read as a plain list pattern it would silently bind a variable
;; named `not`, so name it (ADR-152).
(defn- %match-not-pattern? (p) (and (pair? p) (= (first p) 'not)))
(defn- %match-not-pattern-error (p)
  (error (str "match: `(not …)` is not a pattern — a negative match binds nothing,"
           " so put the test in a `:when` guard instead:"
           " (x :when (not "
           (pr-str (second p))
           ") body…)."
           " (Read as a list pattern it would BIND a variable named `not`.)")))

;; `(record name {map-pattern}?)` — a RECORD pattern (ADR-186): matches a `defrecord` value
;; whose nominal id is `name` (a bare symbol qualified to the current ns, or a `mod/name`),
;; then matches the optional map pattern against its fields. A record is a map, so this is an
;; id assertion plus an ordinary map pattern — `:keys`/`:or`/nested `{:k p}` all compose. The
;; id is derived SYNTACTICALLY from `name` (via `%ability-id-kw`), so no registry lookup is
;; needed at expansion (unlike a positional pattern, which would need the definition's field
;; order — deferred). Named, like `and`/`or`/`bytes`, so a plain list pattern isn't stolen.
(defn- %match-record-pattern? (p) (and (pair? p) (= (first p) 'record)))

;; Every alternative of an `or` must bind the SAME names — otherwise the body could
;; reference a name only some alternatives bind, and which one it is depends on the
;; input. Rust enforces the same rule for the same reason.
(defn- %match-or-check (alts)
  (let (name-sets (map (fn (a) (sort (map ->string (%pattern-vars a)))) alts))
    (when (not (every? (fn (ns) (= ns (first name-sets))) name-sets))
      (error (str "match: every alternative of an `(or …)` pattern must bind the same"
               " names, got "
               (pr-str (map (fn (ns) ns) name-sets))
               " — a body can't reference a name only some alternatives bind."
               " Use separate clauses when the bindings differ.")))))

;; -- expand-time helpers --
(defn- %match-member? (x xs)
  (cond (empty? xs) false (= x (first xs)) true else (%match-member? x (rest xs))))

(defn- %match-vec->list (v) (%match-vec-collect v (dec (%vector-length v)) nil))
(defn- %match-vec-collect (v i acc)
  (if (< i 0) acc (%match-vec-collect v (dec i) (cons (%vector-ref v i) acc))))

;; The variables a pattern binds. Threaded as `bound` through the compiler so a
;; variable that recurs becomes an equality check (non-linear patterns).
(defn %pattern-vars (pat)
  "The variables the pattern `pat` binds, as a list of symbols. Threaded through the pattern
compiler as `bound` so a variable that recurs becomes an equality check — which is how
NON-LINEAR patterns (the same name twice) work.

    (%pattern-vars '[a b])     → (a b)
    (%pattern-vars '[a a])     → (a a)
    (%pattern-vars '_)         → nil"
  (cond
    (%match-wildcard? pat) nil
    (%match-bind-sym? pat) (list pat)
    (%match-quoted? pat) nil
    (%match-pin? pat) nil
    (%match-stale-pin? pat) nil
    (%match-bytes-pattern? pat) (%match-bytes-vars (rest pat))
    ;; `or` binds the same names in every alternative (checked at compile), so the
    ;; first alternative's set is the whole set; `and` binds the union.
    (%match-or-pattern? pat) (%pattern-vars (second pat))
    (%match-and-pattern? pat) (%match-seq-vars (rest pat))
    ;; a record pattern binds whatever its (optional) inner map pattern binds
    (%match-record-pattern? pat) (let (mp (first (rest (rest pat)))) (if mp (%pattern-vars mp) nil))
    (pair? pat) (%match-seq-vars pat)
    (vector? pat) (%match-seq-vars (%match-vec->list pat))
    (map? pat) (%match-map-vars pat)
    else nil))
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-seq-vars (pats)
    (cond
      (empty? pats) nil
      (= (first pats) '&) (%match-seq-vars (rest pats))
      else (append (%pattern-vars (first pats)) (%match-seq-vars (rest pats))))))

;; The core: compile `pat` against the value of the symbol `target`, given the
;; already-`bound` names; on a match run `success`, else `fail`. Returns code.
(defn- %match-compile (pat target bound success fail)
  (cond
    (%match-wildcard? pat) success
    (%match-bind-sym? pat)
      (if (%match-member? pat bound)
        `(if (%eq ~target ~pat) ~success ~fail)
        ; non-linear: equal to earlier binding
        `(let (~pat ~target) ~success))
    ; fresh bind
    (%match-quoted? pat) `(if (%eq ~target ~pat) ~success ~fail)
    ; 'sym self-evaluates to the symbol
    (%match-pin? pat) `(if (%eq ~target ~(second pat)) ~success ~fail)
    ; ^expr: match the value of expr
    (%match-stale-pin? pat)
      (error "match: `~"
        (pr-str (second pat))
        "` is not a pattern — a pin is written `^"
        (pr-str (second pat))
        "` (`~` belongs to quasiquote alone). To match the literal"
        " 2-element list (unquote x), quote the head: ('unquote x).")
    (%match-bytes-pattern? pat) (%match-compile-bytes (rest pat) target bound success fail)
    ; (bytes seg…): destructure a bytes value, Elixir-style binary matching
    (%match-not-pattern? pat) (%match-not-pattern-error pat)
    ; (not …): rejected — a negative match binds nothing; use a :when guard
    (%match-or-pattern? pat) (%match-compile-or (rest pat) target bound success fail)
    ; (or p q …): first alternative that matches wins
    (%match-and-pattern? pat) (%match-compile-and (rest pat) target bound success fail)
    ; (and p q …): every pattern must match the same value (capture-and-destructure)
    (%match-record-pattern? pat) (%match-compile-record pat target bound success fail)
    ; (record name {…}): a defrecord value of nominal id `name`, then a map pattern
    (pair? pat) (%match-compile-list pat target bound success fail)
    (vector? pat) (%match-compile-vector pat target bound success fail)
    (map? pat) (%match-compile-map pat target bound success fail)
    else `(if (%eq ~target ~pat) ~success ~fail)))
; literal (number/string/keyword/bool/nil)

;; ---- bytes integer decode/encode: byte-aligned, big-endian by default ----
;; The workhorses behind the typed (bytes …) pattern segments (:u16, :i32-le, …)
;; below, and useful directly when parsing at explicit offsets. Widths are in
;; bytes (1–8); reads are bounds-checked by byte-at. An unsigned 8-byte read
;; whose top bit is set exceeds the i64 range and widens to a big integer
;; (arithmetic auto-promotes) — read :i64 to get the raw two's complement.

;; ---- bytes patterns: (bytes seg…) — Elixir-style binary destructuring ----
;; Each `seg` consumes bytes left-to-right from the target:
;;   int / #b"…" literal   match those exact byte(s)
;;   symbol                bind exactly one byte (as an int 0–255); `_` skips one
;;   (sym n)               bind `n` bytes (as a bytes value); n may be an int OR a
;;                         symbol bound by an earlier segment (dynamic size); `(_ n)` skips n
;;   (sym :u16)            bind a typed integer segment: :u8/:u16/:u32/:u64 unsigned,
;;                         :i8/:i16/:i32/:i64 signed two's complement; big-endian by
;;                         default, with explicit :uN-be/:uN-le (:iN-…) variants;
;;                         `(_ :u32)` skips the segment's width
;;   & rest                bind the remaining bytes (must be the last segment)
;; Without a trailing `& rest`, the bytes must be consumed exactly (count match).

(defn- %match-bytes-pattern? (pat)
  (and (pair? pat) (= (first pat) (quote bytes))))

; literal → binds nothing
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-bytes-vars (segs)
    (cond
      (empty? segs) nil
      (= (first segs) '&) (%match-bytes-vars (rest segs))
      (pair? (first segs))
        (let (s (first (first segs)))
          ; (sym n) sized
          (if (%match-wildcard? s)
            (%match-bytes-vars (rest segs))
            (cons s (%match-bytes-vars (rest segs)))))
      (%match-bind-sym? (first segs)) (cons (first segs) (%match-bytes-vars (rest segs)))
      else (%match-bytes-vars (rest segs)))))
;; typed integer segment spec: :u8/:i8/:u16[-be/-le]/…/:i64[-be/-le] → [width signed? little?]
(defn- %match-bytes-int-spec (kw)
  (cond
    (= kw :u8) [1 false false]
    (= kw :i8) [1 true false]
    (= kw :u16) [2 false false]
    (= kw :u16-be) [2 false false]
    (= kw :u16-le) [2 false true]
    (= kw :i16) [2 true false]
    (= kw :i16-be) [2 true false]
    (= kw :i16-le) [2 true true]
    (= kw :u32) [4 false false]
    (= kw :u32-be) [4 false false]
    (= kw :u32-le) [4 false true]
    (= kw :i32) [4 true false]
    (= kw :i32-be) [4 true false]
    (= kw :i32-le) [4 true true]
    (= kw :u64) [8 false false]
    (= kw :u64-be) [8 false false]
    (= kw :u64-le) [8 false true]
    (= kw :i64) [8 true false]
    (= kw :i64-be) [8 true false]
    (= kw :i64-le) [8 true true]
    else nil))

;; (sym :u16) — a typed integer segment: fixed width, endianness + signedness
;; from the spec keyword, value read via the bytes-uint/bytes-int family.
(defn- %match-bytes-typed-seg (seg more target off bound success fail)
  (let (s (first seg)
        spec (%match-bytes-int-spec (second seg)))
    (if (nil? spec)
      (error (str "match: unknown bytes segment spec "
               (pr-str (second seg))
               " (expected :u8/:i8/:u16[-be/-le]/…/:i64[-be/-le])"))
      (let (w (%vector-ref spec 0)
            reader (cond
                     (and (%vector-ref spec 1) (%vector-ref spec 2)) 'bytes/int-le
                     (%vector-ref spec 1) 'bytes/int
                     (%vector-ref spec 2) 'bytes/uint-le
                     else 'bytes/uint)
            noff (gensym "off"))
        (cond
          ;; (_ :u32) — skip the segment's width
          (%match-wildcard? s)
            `(if (<= (+ ~off ~w) (%byte-length ~target))
               (let (~noff (+ ~off ~w))
                 ~(%match-bytes-segs more target noff bound success fail))
               ~fail)
          ;; non-linear: an already-bound binder requires an equal value
          (%match-member? s bound)
            `(if (and (<= (+ ~off ~w) (%byte-length ~target)) (%eq (~reader ~target ~off ~w) ~s))
               (let (~noff (+ ~off ~w))
                 ~(%match-bytes-segs more target noff bound success fail))
               ~fail)
          else
            `(if (<= (+ ~off ~w) (%byte-length ~target))
               (let (~s (~reader ~target ~off ~w) ~noff (+ ~off ~w))
                 ~(%match-bytes-segs more target noff (append bound (list s)) success fail))
               ~fail))))))

(defn- %match-compile-bytes (segs target bound success fail)
  `(if (bytes? ~target)
     ~(%match-bytes-segs segs target 0 bound success fail)
     ~fail))

(defn- %match-bytes-segs (segs target off bound success fail)
  (cond
    ;; exhausted: require the bytes were consumed exactly
    (empty? segs) `(if (%eq ~off (%byte-length ~target)) ~success ~fail)
    ;; & rest — bind everything left (the tail must be exactly `& sym`)
    (= (first segs) '&)
      (if (= (count segs) 2)
        `(let (~(second segs) (%subbytes ~target ~off)) ~success)
        (error "match: bytes pattern '&' must be followed by exactly one rest binding"))
    else (%match-bytes-seg (first segs) (rest segs) target off bound success fail)))

(defn- %match-bytes-seg (seg more target off bound success fail)
  (let (noff (gensym "off"))
    (cond
      ;; (sym :u16) — a typed integer segment (spec keyword in size position)
      (and (pair? seg) (keyword? (second seg)))
        (%match-bytes-typed-seg seg
          more target off bound success fail)
      ;; (sym n) — bind n bytes as a sub-bytes value; n is an int or an earlier binding
      (pair? seg)
        (let (s (first seg) szv (gensym "sz"))
          `(let (~szv ~(second seg))
             (if (and (>= ~szv 0) (<= (+ ~off ~szv) (%byte-length ~target)))
               (let (~@(if (%match-wildcard? s)
                         []
                         (list s `(%subbytes ~target ~off (+ ~off ~szv)))) ~noff
                     (+ ~off ~szv))
                 ~(%match-bytes-segs more
                    target
                    noff
                    (if (%match-wildcard? s) bound (append bound (list s)))
                    success
                    fail))
               ~fail)))
      ;; _ — skip one byte
      (%match-wildcard? seg)
        `(if (< ~off (%byte-length ~target))
           (let (~noff (+ ~off 1))
             ~(%match-bytes-segs more target noff bound success fail))
           ~fail)
      ;; symbol — bind one byte as an int (or, if already bound, require equality —
      ;; non-linear patterns, consistent with the vector/list matchers)
      (%match-bind-sym? seg)
        (if (%match-member? seg bound)
          `(if (and (< ~off (%byte-length ~target)) (%eq (%byte-at ~target ~off) ~seg))
             (let (~noff (+ ~off 1))
               ~(%match-bytes-segs more target noff bound success fail))
             ~fail)
          `(if (< ~off (%byte-length ~target))
             (let (~seg (%byte-at ~target ~off) ~noff (+ ~off 1))
               ~(%match-bytes-segs more
                  target
                  noff
                  (append bound (list seg))
                  success
                  fail))
             ~fail))
      ;; #b"…" literal — match those exact bytes (count known at expand time)
      (bytes? seg)
        (let (n (%byte-length seg))
          `(if (and (<= (+ ~off ~n) (%byte-length ~target))
                 (%eq (%subbytes ~target ~off (+ ~off ~n)) ~seg))
             (let (~noff (+ ~off ~n))
               ~(%match-bytes-segs more target noff bound success fail))
             ~fail))
      ;; int literal — match one exact byte
      (int? seg)
        `(if (and (< ~off (%byte-length ~target)) (%eq (%byte-at ~target ~off) ~seg))
           (let (~noff (+ ~off 1)) ~(%match-bytes-segs more target noff bound success fail))
           ~fail)
      else (error (str "match: invalid bytes-pattern segment " (pr-str seg))))))

;; list pattern: split off an optional `& rest` tail, then bind element-wise.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-split (pats)
    (cond
      (empty? pats) [nil nil false]
      (= (first pats) '&)
        (if (= (count (rest pats)) 1)
          [nil (second pats) true]
          (error "match: '&' must be followed by exactly one tail pattern"))
      else
        (let (sub (%match-split (rest pats)))
          [(cons (first pats) (nth sub 0)) (nth sub 1) (nth sub 2)]))))

(defn- %match-compile-list (pat target bound success fail)
  (let (parts (%match-split pat))
    (%match-compile-seq (nth parts 0) (nth parts 1) (nth parts 2) target bound success fail)))

;; `(or p q …)`: chain the alternatives, each falling through to the next. `success`
;; is duplicated per alternative rather than hoisted into a thunk — that keeps every
;; alternative's body in TAIL position (a `match` in tail position must stay O(1)
;; stack), and alternatives are nearly always literals, so the duplication is small.
(defn- %match-compile-or (alts target bound success fail)
  (do
    (%match-or-check alts)
    (%match-compile-or-chain alts target bound success fail)))
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-compile-or-chain (alts target bound success fail)
    (if (empty? alts)
      fail
      (%match-compile (first alts)
        target
        bound
        success
        (%match-compile-or-chain (rest alts) target bound success fail)))))

;; `(and p q …)`: match every pattern against the SAME value, left to right, so
;; later patterns see the names earlier ones bound (a repeated name is an equality
;; constraint, as everywhere else). `(and whole {:keys [a]})` is the `:as` idiom.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-compile-and (pats target bound success fail)
    (if (empty? pats)
      success
      (%match-compile (first pats)
        target
        bound
        (%match-compile-and (rest pats)
          target
          (append bound (%pattern-vars (first pats)))
          success
          fail)
        fail))))

;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-compile-seq (pats rest-pat has-rest target bound success fail)
    (if (empty? pats)
      (if has-rest
        (%match-compile rest-pat target bound success fail)
        ; bind the rest to what remains
        `(if (nil? ~target) ~success ~fail))
      ; require the list exhausted
      (let (p (first pats)
            hd (gensym "hd")
            tl (gensym "tl")
            inner (%match-compile-seq (rest pats)
                    rest-pat
                    has-rest
                    tl
                    (append bound (%pattern-vars p))
                    success
                    fail)
            head (%match-compile p hd bound inner fail))
        `(if (pair? ~target) (let (~hd (first ~target) ~tl (rest ~target)) ~head) ~fail)))))

;; vector pattern: a fixed-length tuple, matched element-wise by index.
(defn- %match-compile-vector (pat target bound success fail)
  (let (elems (%match-vec->list pat) n (count elems))
    (when (%match-member? '& elems)
      (error "match: '&' (rest) is not allowed in a vector pattern — vectors are fixed-length"))
    `(if (and (vector? ~target) (%eq (%vector-length ~target) ~n))
       ~(%match-compile-velems elems target 0 bound success fail)
       ~fail)))

;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-compile-velems (pats target i bound success fail)
    (if (empty? pats)
      success
      (let (p (first pats)
            el (gensym "el")
            inner (%match-compile-velems (rest pats)
                    target
                    (inc i)
                    (append bound (%pattern-vars p))
                    success
                    fail)
            this (%match-compile p el bound inner fail))
        `(let (~el (%vector-ref ~target ~i)) ~this)))))

;; associative (map) pattern: {:keys [a b] :or {a default}} — a map literal in
;; pattern position destructures a map. Each symbol in :keys binds to the value at
;; the same-named keyword (nil if absent, or the :or default). The target must be a
;; map, else the clause fails. Mirrors Clojure's associative destructuring, minus
;; the power forms — general `{:key subpattern}` nesting and `:as` are deferred
;; (ADR-011: ship the simple shape, add the rest on a concrete need).
(defn- %match-map-pattern? (p) (map? p))

;; A map pattern understands exactly two keys: `:keys` and `:or`. Any other key
;; is REJECTED rather than ignored (ADR-152). Ignoring it was the worst kind of
;; wrong: `{:a v}` degenerated to "is the target a map?", so the clause matched
;; anything, bound nothing, and the body then died on an unbound `v` — a
;; diagnostic pointing at the body, nowhere near the cause. (`{}` stays legal: no
;; keys to misread, so it is the honest "any map" pattern.)
;; `:as` stays rejected. With general `{key subpattern}` support (ADR-160) a stray
;; `:as` would otherwise read as "this map must have an `:as` key", silently matching
;; something else entirely — and the `and`-pattern spells the intent exactly.
(defn- %match-map-check (pat)
  (when (contains? pat :as)
    (error (str "match: a map pattern has no `:as` — capture the whole value with an"
             " `and` pattern instead: (and "
             (pr-str (get pat :as))
             " {…}). (As a plain key, `:as` would test for an `:as` KEY in the"
             " map.)"))))

;; :keys value is a vector [a b] (or a list); return it as a list of symbols.
(defn- %match-map-keys (pat)
  (let (kv (get pat :keys))
    (cond (nil? kv) nil (vector? kv) (%match-vec->list kv) else kv)))

;; The explicit `{key subpattern}` entries — every key except the two markers — as
;; a list of `[key subpattern]` pairs.
(defn- %match-map-entries (pat)
  (filter (fn (kv) (not (or (= (first kv) :keys) (= (first kv) :or))))
    (%map-pairs pat)))

(defn- %match-map-vars (pat)
  (do
    (%match-map-check pat)
    (append (%match-map-keys pat)
      (fold (fn (acc kv) (append acc (%pattern-vars (second kv))))
        nil
        (%match-map-entries pat)))))

(defn- %match-compile-map (pat target bound success fail)
  (do
    (%match-map-check pat)
    ;; Explicit `{key subpattern}` entries are tested FIRST (they can fail), then the
    ;; lenient `:keys` binds wrap the success branch. The two halves differ on
    ;; purpose, and the difference is the ecosystem each comes from:
    ;;   {:keys [a b]}  — Clojure DESTRUCTURING: an absent key binds nil (or its
    ;;                    `:or` default). Never fails.
    ;;   {:k pat}       — Erlang/Elixir MAP PATTERN: the key must be PRESENT and its
    ;;                    value must match `pat`, else the clause fails.
    `(if (map? ~target)
       ~(%match-compile-map-entries (%match-map-entries pat)
          target
          bound
          (%match-map-binds (%match-map-keys pat) (get pat :or) target success)
          fail)
       ~fail)))

;; Each explicit entry: require the key, bind its value to a temp, match the
;; sub-pattern against it. The key is emitted QUOTED — in pattern position a key is a
;; literal (`{[1 2] p}` looks up the vector `[1 2]`), never an expression to evaluate.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-compile-map-entries (entries target bound success fail)
    (if (empty? entries)
      success
      (let (kv (first entries)
            k (first kv)
            sub (second kv)
            v (gensym "mval"))
        `(if (contains? ~target (quote ~k))
           (let (~v (get ~target (quote ~k)))
             ~(%match-compile sub
                v
                bound
                (%match-compile-map-entries (rest entries)
                  target
                  (append bound (%pattern-vars sub))
                  success
                  fail)
                fail))
           ~fail)))))

;; Bind each key symbol to (get target :key); when the key is absent, fall back to
;; its :or default (evaluated only then) if one is given, else nil.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-map-binds (keys ors target success)
    (if (empty? keys)
      success
      (let (k (first keys)
            kw (keyword (->string k))
            getter (if (and ors (contains? ors k))
                     `(if (contains? ~target ~kw) (get ~target ~kw) ~(get ors k))
                     `(get ~target ~kw)))
        `(let (~k ~getter) ~(%match-map-binds (rest keys) ors target success))))))

;; `(record name {map-pattern}?)` — assert the target is a `defrecord` value of nominal id
;; `name`, then match the optional map pattern against its fields. `record-id` returns the
;; value's `:__id__` (or nil for a non-record), so the whole test is a single `%eq` against
;; the id derived from `name` at expansion; a non-record simply fails. The inner map pattern
;; is compiled by the ordinary map path, so `{:k p}` / `:keys` / `:or` all work unchanged.
(defn- %match-compile-record (pat target bound success fail)
  (let (name (second pat)
        mappat (first (rest (rest pat))))
    (when (not (symbol? name))
      (error (str "match: (record name …) needs a record NAME symbol, got "
               (pr-str name)
               " — e.g. (record circle {:r r}) or (record geometry/circle {:r r}).")))
    (when (and mappat (not (map? mappat)))
      (error (str "match: (record "
               (pr-str name)
               " …) — the field pattern must be a map"
               " pattern like {:field p} or {:keys [f]}, got "
               (pr-str mappat))))
    (let (id (%ability-id-kw name))
      `(if (%eq (record-id ~target) ~id)
         ~(if mappat (%match-compile mappat target bound success fail) success)
         ~fail))))

;; -- clauses: (pattern [:when guard] body...) — one shape for match / fn / receive --
(defn- %match-parse-clause (clause)
  (if (not (pair? clause))
    (error (str "match: each clause must be a (pattern body...) list, got " (pr-str clause)))
    (let (pat (first clause) more (rest clause))
      (if (= (first more) :when)
        (if (empty? (rest more))
          (error "match: :when must be followed by a guard expression")
          [pat (second more) (rest (rest more))])
        [pat nil more]))))

;; A clause is irrefutable (always matches) iff its pattern is _ or a bare bind
;; and it has no guard. Such a clause must be last; anything after it is dead.
(defn- %match-irrefutable? (pat guard)
  (and (nil? guard) (or (%match-wildcard? pat) (%match-bind-sym? pat))))

(defn- %match-compile-clause (clause target fail)
  (let (parsed (%match-parse-clause clause)
        pat (nth parsed 0)
        guard (nth parsed 1)
        body (nth parsed 2)
        success (if (nil? guard) `(do ~@body) `(if ~guard (do ~@body) ~fail)))
    (%match-compile pat target nil success fail)))

;; The no-match failure: a structured, catchable, self-describing value carrying
;; the context (:match / :let / a fn name), the value, and the patterns tried.
(defn- %match-no-match (context target patterns)
  `(throw [:match-error (quote ~context) ~target (quote ~patterns)]))

(defn- %match-clause-patterns (clauses) (map (fn (c) (if (pair? c) (first c) c)) clauses))

(defn- %match-check-reachable (clause following)
  (let (parsed (%match-parse-clause clause))
    (when (and (%match-irrefutable? (nth parsed 0) (nth parsed 1)) (not (empty? following)))
      (error "match: unreachable clause after a catch-all (an irrefutable pattern must come last)"))))

;; Occurrences of symbol `s` in code tree `form` (pairs only — `s` is a gensym,
;; so quoted user data can never contain it and vectors need no descent).
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-count-sym (form s)
    (cond
      (= form s) 1
      (pair? form) (+ (%match-count-sym (first form) s) (%match-count-sym (rest form) s))
      else 0)))

;; Replace each `(k)` call in code tree `form` with `code` (used only when the
;; duplication is bounded — one use, or a small `code`). Rebuilds ONLY the spine
;; above a splice point: a subtree with no `(k)` in it — every clause body the
;; reader positioned — is returned as the very pair it came in as, so its source
;; positions survive into the expansion and a checker warning inside a clause
;; points at the clause, not at the `match` (ADR-297). The worker returns
;; `[spliced? form]`; `[]` patterns are avoided since `let` destructuring is
;; itself built on this file.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-splice-fail-in (form k code)
    (cond
      (and (pair? form) (= (first form) k) (nil? (rest form))) [true code]
      (pair? form)
        (let (head (%match-splice-fail-in (first form) k code)
              tail (%match-splice-fail-in (rest form) k code))
          (if (or (first head) (first tail))
            [true (cons (second head) (second tail))]
            [false form]))
      else [false form])))
(defn- %match-splice-fail (form k code)
  (second (%match-splice-fail-in form k code)))

;; Remaining budget after counting `form`'s pair nodes, or -1 once exhausted —
;; an early-exit size probe (big trees aren't walked past the budget).
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-size-budget (form budget)
    (cond
      (< budget 0) -1
      (pair? form) (%match-size-budget (rest form) (%match-size-budget (first form) (- budget 1)))
      else budget)))

(defn- %match-small? (form) (>= (%match-size-budget form 64) 0))

;; Compile one clause with `rest-code` (the code for every following clause) as
;; its fail-continuation — WITHOUT exponential growth. The pattern compilers
;; splice `fail` at every failure point, so handing them `rest-code` verbatim
;; duplicates it once per test and the whole match doubles per clause (a 16-arm
;; receive took seconds to load). Instead compile against a thunk call `(k)`,
;; then: 0 uses → drop rest-code (irrefutable pattern, later clauses dead);
;; 1 use → splice rest-code in place (zero runtime cost, growth stays linear);
;; 2+ uses of a SMALL rest-code → still splice (bounded duplication — the hot
;; 2–4-arm receive/fn dispatch stays thunk-free, zero runtime cost); 2+ uses of
;; a big one → bind it once as `(let (k (fn () rest-code)) …)`. The `(k)` call
;; is in tail position wherever fail was, so match stays TCO-safe.
(defn- %match-build-clause (clause target rest-code)
  (let (k (gensym "mfail")
        compiled (%match-compile-clause clause target (list k))
        uses (%match-count-sym compiled k))
    (cond
      (= uses 0) compiled
      (or (= uses 1) (%match-small? rest-code)) (%match-splice-fail compiled k rest-code)
      else `(let (~k (fn () ~rest-code)) ~compiled))))

;; Chain the clauses: each clause's fail-continuation is the code for the rest;
;; the innermost fail is the structured no-match throw. Each chosen body lands in
;; tail position of the generated if/let, so a `match` in tail position is TCO-safe.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn- %match-build-from (clauses target fail)
    (if (empty? clauses)
      fail
      (let (clause (first clauses)
            following (rest clauses)
            rest-code (%match-build-from following target fail))
        (%match-check-reachable clause following)
        (%match-build-clause clause target rest-code)))))

(defn- %match-build (clauses target context)
  (%match-build-from clauses
    target
    (%match-no-match context target (%match-clause-patterns clauses))))

;; match* — the shared engine. `context` (a keyword like :match/:let, or a fn
;; name) is embedded in the failure. `match` is the value-dispatch surface; the
;; `let` and `fn` special forms target match* directly with their own context.
(defmacro match* (context expr & clauses)
  "The shared pattern-matching ENGINE behind `match`, `case`, and the destructuring `let`
and `fn` forms. `context` (a keyword like `:match`/`:let`, or a function name) is embedded
in the no-match failure so the error names the form that failed. Prefer `match` — this is
the surface the special forms target directly when they need their own context."
  (let (v (gensym "m")) `(let (~v ~expr) ~(%match-build clauses v context))))

;; (match expr (pattern [:when guard] body...) ...) — match `expr` against each
;; clause in order; the first whose pattern (and guard) matches runs its body.
;; No clause matching crashes with a structured value; add a `_` clause to total it.
(defmacro match (expr & clauses)
  "Match `expr` against each `(pattern [:when guard] body...)` clause, running the first that fits (binding the pattern's variables). Errors if none match."
  `(match* :match ~expr ~@clauses))

;; ---- case: literal dispatch, flat pairs -------------------------------------
;; Sugar over `match*`, but NOT a synonym for it (which is why it earns a name
;; under "one spelling each"): `case` accepts only *literal* tests, so it cannot
;; silently bind where you meant to compare — the one trap `match` has. A bare
;; symbol test is therefore rejected rather than read as a binder.
(defn- %case-check-test (t)
  (cond
    (or (keyword? t) (int? t) (float? t) (decimal? t) (ratio? t) (string? t) (bool? t) (nil? t)) t
    (and (pair? t) (= (first t) 'quote)) t
    (symbol? t)
      (throw (str "case: the bare symbol test `"
               t "` would BIND, not compare" " — write `'" t
               "` for the literal symbol, or use `match`" " if you meant to bind it"))
    else
      (throw (str "case: each test must be a literal (keyword/int/float/decimal/"
               "string/bool/nil, or 'symbol), got "
               (pr-str t)
               " — use `match` for destructuring, guards, or alternatives"))))

;; Flat `test result …` pairs → wrapped match clauses; a lone trailing form is the
;; default (an `_` clause). Flat pairs match `cond`'s shape, which is where a
;; reader's eye already is for value dispatch.
(defn- %case-clauses (forms acc)
  (cond
    (empty? forms) (reverse acc)
    (empty? (rest forms)) (reverse (cons (list '_ (first forms)) acc))
    else
      (%case-clauses (rest (rest forms))
        (cons (list (%case-check-test (first forms)) (second forms)) acc))))

(defmacro case (expr & clauses)
  "Dispatch on the VALUE of `expr` against literal tests, as flat `test result`
pairs; a lone trailing form is the default. `(case k :a 1 :b 2 :other)`. Tests
are literals only — a bare symbol is an error (it would bind, not compare), and
destructuring, guards, or alternatives mean you want `match`. With no default, no
match raises `[:match-error :case value patterns]`, exactly as `match` does."
  `(match* :case ~expr ~@(%case-clauses clauses nil)))
