;; std/io.blsp — output ports: the redirectable sink behind `io/write` / `io/puts`.
;;
;; A *port* is any value with a **`io/port` impl** — the ability whose one op, `emit`,
;; is the single seam every output path goes through. Two shapes matter:
;;
;;   - a bare **1-arg fn** `(fn (s) …)` that consumes a ready string. This was the whole
;;     definition of a port originally, and it still is one: `(impl io/port :fn …)` below is
;;     what keeps `%write-out`, `fn-port`, and every hand-written sink working.
;;   - a **port record** — `standard-port` / `process-port` / `file-port` — which carries
;;     its target (a label, a pid, a path), prints as itself (`#<port stdout>`), and can
;;     own its write policy. This is the "richer port value (named, introspectable)"
;;     `emit` is the seam for; the ability is what made it expressible
;;     without touching a single caller.
;;
;; A third-party port needs nothing from this module: `defrecord` your own, `impl io/port`
;; for it, and every `io/write` / `with-out` / logger backend accepts it.
;;
;; `*out*`/`*err*` (declared in the prelude) still hold a plain **1-arg fn** — the
;; prelude's `io/write`/`io/puts` call it directly, so printing pays no dispatch cost.
;; `port-fn` is the adapter at that boundary, and `with-out`/`with-err` apply it for
;; you, so a record port installs just as a fn port does.
;;
;; The buffer case — an editor showing output in its `*Messages*` buffer — is a
;; `process-port` to the process that owns the buffer: the string crosses as an
;; `[:write s]` message (async, share-nothing), never a mutated value. That is
;; the same safe mechanism the logger's `process-backend` uses (std/log.blsp).

(defmodule io
  "Output ports — the redirectable sink the prelude's `io/write`/`io/puts` write to.
A port is any value implementing the **`io/port`** ability: a 1-arg fn
`(fn (s) …)` that consumes a ready string, or a port record. `*out*`/`*err*` (declared
in the prelude) hold the current stdout/stderr ports.

Build one with `stdout-port`/`stderr-port`/`process-port`/`file-port`/`fn-port`, then
redirect output for a dynamic extent with `with-out`/`with-err`:

    (with-out (process-port editor) (io/puts \"into the editor's buffer\"))
    (with-out (fn-port (fn (s) (collect s))) (io/puts \"into a callback\"))

A `process-port` sends `[:write s]` to its target — async and share-nothing, so
output crosses process boundaries with no shared mutable state. (Dynamic bindings
do not reach a `spawn`ed child — a child starts from the default `*out*`; pass it
a port explicitly if it should redirect too.)

Your own port type is a `defrecord` plus an `impl io/port` for it — `io/write`,
`with-out`, and every logger backend then accept it with no change here.")

;; ---- the io/port ability -------------------------------------------------------

(defability io/port
  "Where written output goes. `emit` is the one seam every output path passes through,
so a port may be any value with an impl.

It is `emit` rather than `write` because `io/write` is what a CALLER reaches for — the
variadic, rendering, `:to`-taking function below. The seam is the implementor's side of
the contract, invoked once per ready string, and it is the one that should yield the
plainer name."
  (emit [self s] :-> nil))

;; A bare 1-arg sink fn is a port — the original representation, still first-class.
;; This impl is what keeps `%write-out`, `fn-port`, and every hand-written `(fn (s) …)`
;; working unchanged.
(impl io/port :fn (emit [f s] (f s)))
;; A NATIVE 1-arg sink is a port too. The prelude's default `*out*`/`*err*` are the
;; primitives `%write-out`/`%write-err`, whose `type-of` is `:native`, not `:fn` — so
;; without this `(io/port? *err*)` was false for the very ports the language ships with.
;; That made `(io/puts "…" :to *err*)` decline the target and print `:to #<native
;; %write-err>` as two more values. Every test passed anyway, because `with-err-str`
;; rebinds `*err*` to a Brood closure, which is `:fn` — the default was the broken case
;; and the tests never exercised it. What it cost in practice: every `:to *err*` in the
;; stdlib — `log`, the test runner, `supervisor`, `repl`, `telemetry`, `format` — wrote to
;; stdout with that suffix, which is how it surfaced (a checker test asserting on warnings
;; read from stderr saw none).
(impl io/port :native (emit [f s] (f s)))

(defn port? (x)
  "True if `x` can be written to — it has a `io/port` impl (a 1-arg sink fn, a port record,
or your own type). The check a function taking a port can branch on instead of letting
`emit` raise.

    (io/port? (io/stdout-port))   → true"
  (satisfies? 'io/port x))

;; ---- port values ------------------------------------------------------------

(defrecord standard-port (label write))

(impl io/port io/standard-port (emit [p s] ((get p :write) s)))
(impl display io/standard-port (->string [p] (str "#<port " (get p :label) ">")))

(defn stdout-port ()
  "The default stdout port: writes to real stdout, honouring `with-out-str`
capture. (The prelude's default `*out*` is the bare `%write-out` fn this wraps.)"
  (standard-port "stdout" %write-out))

(defn stderr-port ()
  "The default stderr port: writes to real stderr (never captured)."
  (standard-port "stderr" %write-err))

(defn fn-port (f)
  "A port that hands each written string to the 1-arg callback `f` — which is to say,
`f` itself: a bare fn is already a port (the `:fn` impl of `io/port`). The general adapter,
kept as a name because it *documents* the intent at a call site; `f` may buffer, filter,
count, or forward however it likes."
  f)

(defrecord process-port (pid))

(impl io/port io/process-port (emit [p s] (send (get p :pid) [:write s]) nil))
(impl display io/process-port (->string [p] (str "#<port process " (get p :pid) ">")))

(defrecord file-port (path))

(impl io/port io/file-port (emit [p s] (file/spit-append (get p :path) s) nil))
(impl display io/file-port (->string [p] (str "#<port file " (get p :path) ">")))

;; ---- writing values ---------------------------------------------------------
;; `emit` above is the one-string seam every port implements. These three are the
;; convenience layer over it: variadic, they render their arguments the way the
;; prelude's printer does, and they choose a destination.
;;
;; The destination is a trailing `:to <port>` rather than a leading argument, because
;; the values are variadic and a leading port would make `(io/puts p)` ambiguous —
;; write the port, or target it? A trailing keyword pair has no such reading: `:to`
;; must be BOTH the keyword and followed by something `port?` accepts, so
;; `(io/puts :to 3)` prints `:to 3` like any other pair of values.

(defn- shown
  (xs)
  ;; Each argument through the installed `*show*` transform, or untouched when none is
  ;; installed (the default fast path). Mirrors the prelude's own printer.
  (if *show* (map *show* xs) xs))

(defn- split-target
  (xs)
  "`[values port]` for an argument list that may end in `:to <port>`; `port` is nil when
it does not."
  (let (n (count xs))
    (if (and (>= n 2) (= (nth xs (- n 2)) :to) (port? (nth xs (- n 1))))
      [(take (- n 2) xs) (nth xs (- n 1))]
      [xs nil])))

(defn- inspect-render
  (& xs)
  ;; `%render`'s re-readable twin: the same space-joined shape, but each value through the
  ;; `inspectable` ability (which defaults to `pr-str`) rather than its display form. Written
  ;; here rather than as a primitive because it is a fold over an ability call — the
  ;; language can already say it.
  ;; `/inspect` — the ROOT ability op — not bare `inspect`, which inside this module
  ;; resolves to `io/inspect` below and recurses until the stack guard fires.
  (fold (fn (acc v) (let (s (/inspect v)) (if (= acc "") s (str acc " " s)))) "" xs))

(defn- render-display
  (& xs)
  ;; The DISPLAY renderer: each value through the installed `*show*` transform (which is
  ;; what honors `display` for a record), then the kernel's space-joined `%render`.
  ;; `*show*` lives HERE rather than in `send-text` because it is a display transform: on
  ;; the inspect path it would flatten a record to its `display` string BEFORE
  ;; `inspect-render` could ask the `inspectable` ability, so a custom `inspect` impl could
  ;; never be seen (`#money<$5>` printed as `"$5"`).
  (apply %render (shown xs)))

(defn- send-text
  (xs suffix render)
  ;; The shared body of the three writers: split off a trailing `:to <port>`, render the
  ;; remaining values with `render`, append `suffix`, and `emit` it — to the named port, or
  ;; to `*out*` when none was named. Each `render` applies its own value transform.
  (let ([vals port] (split-target xs)
        text (str (apply render vals) suffix))
    (if port (emit port text) (*out* text))
    nil))

(defn write (& xs)
  "Write the display forms of `xs` with NO trailing newline, to `*out*` — or to the port
named by a trailing `:to <port>`. Returns nil.

    (io/write \"working\")
    (io/write \"progress: \" n :to *err*)"
  (send-text xs "" render-display))

(defn puts (& xs)
  "Write the display forms of `xs` followed by a newline, to `*out*` — or to the port named
by a trailing `:to <port>`. Returns nil. The everyday output function.

    (io/puts \"hello\")
    (io/puts \"count = \" n)
    (io/puts \"boom\" :to *err*)
    (io/puts \"entry\" :to (io/file-port \"log.txt\"))"
  (send-text xs "\n" render-display))

(defn inspect (& xs)
  "Write the RE-READABLE forms of `xs` — strings quoted, escapes shown — followed by a
newline, to `*out*` or to a trailing `:to <port>`. Returns nil.

The debugging counterpart of [[puts]]: `(io/puts \"a\\nb\")` prints two lines, while
`(io/inspect \"a\\nb\")` prints `\"a\\nb\"`, so you can see what the value actually is.

Distinct from the bare `inspect`, which is the `inspectable` ability op and returns the string
rather than writing it — that one belongs with `pr-str`, this one with the writers."
  (send-text xs "\n" inspect-render))

;; ---- installing a port for a dynamic extent ---------------------------------

(defn port-fn (port)
  "`port` as a bare 1-arg sink fn: itself when it already is one, else a closure that
`write`s to it. The adapter at the `*out*`/`*err*` boundary — those dynamic vars hold
a plain fn so the prelude can call it directly with no dispatch, while a record
port still reaches them through this. `with-out`/`with-err` apply it for you."
  (if (fn? port) port (fn (s) (emit port s))))

(defmacro with-out (port & body)
  "Evaluate `body` with `*out*` bound to `port` (a fn port or a port record — adapted
with `port-fn`), restoring the previous port on exit (even on error). `io/write`/`io/puts`
inside `body` write to `port`."
  `(binding (*out* (port-fn ~port)) ~@body))

(defmacro with-err (port & body)
  "Evaluate `body` with `*err*` bound to `port` (a fn port or a port record — adapted
with `port-fn`), restoring the previous port on exit (even on error). `io/write`/`io/puts` with `:to *err*`
inside `body` write to `port`."
  `(binding (*err* (port-fn ~port)) ~@body))
