(defmodule format
  "The in-Brood code formatter behind `nest format` (ADR-020/028 extension).
Walks the lossless CST exposed by the `parse-source` builtin (see
`crates/lisp/src/syntax/cst.rs`) and re-emits each file with normalised
indentation and whitespace, preserving comments and the blank lines the author
left between top-level forms. Rust supplies one primitive (`parse-source`);
everything else — the layout policy, file discovery, in-place vs check — lives
here.

Layout in one paragraph: every form is rendered single-line if it fits within
the width budget; otherwise it breaks across lines with each body argument on
its own line at +2 indent. A handful of special forms (`defn`, `let`, `if`,
`cond`, `defmodule`, …) keep a fixed prefix of *header* arguments on the first
line — e.g. `defn` keeps the name + params there so the body indents under
them. Comments inside a list force the multi-line shape; they're re-emitted on
their own lines at the surrounding indent.

Idempotency is a contract: `(= (source (source s)) (source s))`
for every well-formed input. Hand-checked across the brood repo's std/ and tests/."
  (:use project))

;; ---- knobs ------------------------------------------------------------------
(def *width* 100)
; column budget for the single-line attempt (the built-in default)

;; The effective column budget: a project's manifest `:width` (ambient
;; `*project-width*`, set by `setup`) when present, else the built-in
;; default. So `nest format` / the LSP / `nest mcp` all honour a project that pins,
;; say, `:width 80`, and a bare `brood`-run format uses the default.
(defn width ()
  "The effective column budget: the project's `:width` when set, else the built-in default.

    (format/width)   → 100   ; the column the formatter wraps at"
  (or *project-width* *width*))

;; ---- CST node accessors -----------------------------------------------------
;; Every node is a vector [kind payload]. For leaves payload is the raw source
;; text (so we can re-emit it byte-for-byte). For reader-macro wrappers payload
;; is the single wrapped child. For containers (:root :list :vector :map)
;; payload is a vector of children (including trivia, so blank-line + comment
;; intent is recoverable). See the `parse-source` doc in builtins.rs.

(defn node-kind (n)
  "The kind keyword of CST node `n` (`:list`, `:symbol`, `:whitespace`, …)."
  (seq/vector-ref n 0))
(defn node-text (n)
  "The raw source text of leaf node `n` (so it re-emits byte-for-byte)."
  (seq/vector-ref n 1))
; leaf
(defn- node-form (n) (seq/vector-ref n 1))
; wrapper (quote/quasi/unquote/splice)
(defn node-children (n)
  "The child-node vector of container node `n` (includes trivia)."
  (seq/vector-ref n 1))
; container (a vector)

(defn- whitespace? (n) (= (node-kind n) :whitespace))
(defn- comment? (n) (= (node-kind n) :comment))
(defn trivia? (n)
  "True if node `n` is trivia — whitespace or a comment."
  (or (whitespace? n) (comment? n)))

(defn- container?
  (n)
  (let (k (node-kind n)) (or (= k :list) (= k :vector) (= k :map) (= k :set) (= k :root))))

(defn- wrapper?
  (n)
  (let (k (node-kind n))
    (or (= k :quote) (= k :quasi) (= k :unquote) (= k :splice) (= k :pin))))

;; ---- small utilities --------------------------------------------------------
(defn vec->list (v)
  "The vector `v` as a list, preserving order."
  (vec->list-acc v (dec (seq/vector-length v)) nil))
(defn- vec->list-acc
  (v i acc)
  (if (< i 0) acc (vec->list-acc v (dec i) (cons (seq/vector-ref v i) acc))))

(defn count-newlines (s)
  "How many `\\n` characters appear in string `s`.

    (format/count-newlines \"a\nb\")   → 1"
  ;; Native O(n) split. A per-char `(string/substring s i (inc i))` loop is O(n^2) —
  ;; `substring` walks to char boundary `i` each call.
  (dec (count (string/split s "\n"))))

;; (`string-repeat` is the prelude's — it used to be redefined here with an
;; accumulator that did `(str acc s)` each step (O(total length²)); the prelude's
;; `(apply str (repeat n s))` is a single O(total length) pass. The runtime shares
;; one global table, so this local copy clobbered the prelude's for the whole image
;; once `format` was required. Use the prelude's.)
(defn- indent-of (n) (string/repeat " " n))

;; The whitespace inside a comment node is `";; foo\n"` — the trailing newline
;; is part of the node. We strip it before emitting so glue logic owns the
;; spacing between blocks.
(defn- comment-strip-trailing-nl
  (text)
  (if (string/ends-with? text "\n") (string/substring text 0 (dec (string/length text))) text))

;; ---- header table -----------------------------------------------------------
;; The number of args that ride on the same line as the head when a list breaks.
;; Forms not listed get 0 → in multi-line mode every arg goes on its own line.
;; The values are conservative: anything past the header is a *body* and indents
;; uniformly at +2, which is the only style that's both simple and obviously
;; idempotent. (We're not in the business of aligning args under the head; that
;; reflows on every rename.)
(def *format-headers*
  {'defn 2
   ; name params
   'defmacro 2
   ; name params
   'def 1
   ; name (value goes on the next line if it breaks)
   'defdyn 1
   ; name (value goes on the next line if it breaks)
   'defmodule 1
   ; name (docstring goes on the next line if it breaks)
   'fn 1
   ; params
   'let 1
   ; bindings list
   'letrec 1
   ; bindings list
   'binding 1
   ; bindings list
   ;; predicate-and-body
   'if 1
   ; predicate (then/else each go on their own lines)
   'when 1
   'unless 1
   ;; scrutinee-and-arms
   'case 1
   ; expr
   'match 1
   ; expr
   ;; bare body
   'cond 0
   'do 0
   'try 0
   ;; actor receive: every clause on its own line, like cond (no scrutinee rides up)
   'receive 0
   ;; assoc / assoc!: the collection rides the head line, then key/value PAIRS
   ;; (see *format-pair-body*) — `(assoc m :k1 v1 :k2 v2)` not one element per line
   'assoc 1
   'assoc! 1
   ;; loop forms
   'dotimes 1
   ; binding
   'dolist 1
   ; binding
   'loop 1
   ; bindings
   ;; tests
   'describe 1
   ; name
   'test 1
   ;; the project manifest: head alone, then :key value pairs (see *format-pair-body*)
   'project 0})
; name

;; Project/plugin-contributed header rules, layered over the built-ins above.
;; `setup` (re)sets this from the manifest's `:format-headers` plus any
;; `:format-plugins` deps, so `nest format`, the LSP, and `nest mcp` all honour a
;; framework's macro shapes (e.g. Hatch's `deflive`/`on`/`tick`). Empty when not in a
;; project or when no rules are declared. Entries here win over the built-ins.
(defdyn *format-headers-extra* {})

(defn head-header-count (head-node)
  "How many args after this head stay on the first line of a broken list. -1 means
not a known body form (defaults to call-style — every arg breaks). Consults the
project/plugin table (`*format-headers-extra*`) first, then the built-ins."
  (if (= (node-kind head-node) :symbol)
    (let (sym (symbol (node-text head-node)))
      (get *format-headers-extra* sym (get *format-headers* sym -1)))
    -1))

;; Forms whose FIRST header arg is a pair-list (alternating name/value). When
;; that list breaks across lines, we group each name+value on one line and
;; align them under the opening element — the canonical let/binding shape.
(def *format-pair-bindings*
  {'let true 'letrec true 'binding true 'dotimes true 'dolist true 'loop true})

;; Forms whose body args (after the header) are emitted as test+body pairs,
;; one pair per line. Comments between clauses are kept on their own lines.
;; `assoc`/`assoc!` ride one header arg (the collection) and then pair their
;; trailing key/value arguments, the same shape as `cond`'s test+result.
(defdyn *format-pair-body* {'cond true 'case true 'assoc true 'assoc! true 'project true})

(defn pair-bindings? (head-node)
  "True if `head-node` names a form whose first header arg is a pair-list."
  (and (= (node-kind head-node) :symbol)
    (get *format-pair-bindings* (symbol (node-text head-node)) false)))

(defn pair-body? (head-node)
  "True if `head-node` names a form whose body emits in pairs."
  (and (= (node-kind head-node) :symbol)
    (get *format-pair-body* (symbol (node-text head-node)) false)))

;; ---- the inlineability check ------------------------------------------------
;; Every LEAF node kind that re-emits as exactly its own source text. ONE
;; definition, because `single-line` and `render` both need this set and the two
;; hand-maintained copies drifted: ADR-196 added `:ratio` and `:decimal` to the CST
;; and only `render` learned them. `render`'s fallback is `(node-text n)`, so its
;; output stayed correct — but `single-line`'s fallback is **nil**, meaning "cannot
;; go on one line", so every form containing a `1/2` or `1.5M` was forced to break:
;; `(assert= (sqrt 9/4) 1.5)` came out as four lines. A kind missing here is silent
;; and disfiguring, so the set lives in one place — adding a literal kind to the
;; reader now only needs this list touched.
(def *verbatim-kinds*
  #{:symbol :keyword :int :float :ratio :decimal :bool :nil :error})
(defn verbatim-kind? (k)
  "True if node kind `k` re-emits as exactly its own source text (a leaf literal)."
  (contains? *verbatim-kinds* k))

;; Single-line emit: returns the string, or nil if the node cannot legally
;; appear on one line (it contains a comment, or a string with a literal
;; newline). Recursive — a list inlines only if every child does.
(defn single-line (n)
  "Render node `n` on one line, or nil if it can't legally be single-line (it contains a comment, or a string with a literal newline). Recursive — a list inlines only if every child does."
  (let (k (node-kind n))
    (cond
      (= k :whitespace) " "
      ; collapses to one space inside a form
      (= k :comment) nil
      ; comments always break
      (= k :str) (single-line-str (node-text n))
      (verbatim-kind? k) (node-text n)
      (= k :quote) (single-line-wrap "'" (node-form n))
      (= k :quasi) (single-line-wrap "`" (node-form n))
      (= k :unquote) (single-line-wrap "~" (node-form n))
      (= k :splice) (single-line-wrap "~@" (node-form n))
      (= k :pin) (single-line-wrap "^" (node-form n))
      (= k :list) (single-line-seq (node-children n) "(" ")")
      (= k :vector) (single-line-seq (node-children n) "[" "]")
      (= k :map) (single-line-seq (node-children n) "{" "}")
      ; a set literal `#{ … }` — a flat sequence, like a vector, with the `#{` glued
      (= k :set) (single-line-seq (node-children n) "#{" "}")
      else nil)))

(defn- single-line-str
  (text)
  ;; A literal multi-line string can't be re-emitted on one line.
  (if (includes? text "\n") nil text))

(defn- single-line-wrap
  (prefix child)
  (let (s (single-line child)) (if (nil? s) nil (str prefix s))))

(defn- single-line-seq
  (kids open close)
  ;; Render the structural children space-separated. Any comment, or any
  ;; un-inlineable child, sinks the attempt.
  (let (forms (filter (fn (c) (not (trivia? c))) (vec->list kids)))
    (cond
      (any-comment? kids) nil
      (nil? forms) (str open close)
      else (single-line-seq-build forms open close))))

(defn- any-comment?
  (kids)
  ;; Direct-child comment? (Sub-list comments are caught recursively when their
  ;; parent calls single-line on them.)
  (any-comment-at kids 0 (seq/vector-length kids)))
(defn- any-comment-at
  (kids i n)
  (cond (= i n) false (comment? (seq/vector-ref kids i)) true else (any-comment-at kids (inc i) n)))

(defn- single-line-seq-build
  (forms open close)
  (let (parts (map single-line forms))
    (if (any-nil? parts) nil (str open (string/join " " parts) close))))

(defn- any-nil? (xs) (cond (nil? xs) false (nil? (first xs)) true else (any-nil? (rest xs))))

;; ---- multi-line emit --------------------------------------------------------
;; `render n indent` produces the canonical text for node n, possibly multi-line.
;; The result never ends with a newline (callers own the gluing).
(defn render (n indent)
  "Render node `n` at column `indent` as canonical text, breaking across lines when it exceeds the width budget. The result never ends with a newline (callers own the gluing)."
  (let (k (node-kind n))
    (cond
      (or (verbatim-kind? k) (= k :str)) (node-text n)
      (= k :quote) (render-wrap "'" (node-form n) indent)
      (= k :quasi) (render-wrap "`" (node-form n) indent)
      (= k :unquote) (render-wrap "~" (node-form n) indent)
      (= k :splice) (render-wrap "~@" (node-form n) indent)
      (= k :pin) (render-wrap "^" (node-form n) indent)
      (= k :list) (render-seq n indent "(" ")")
      (= k :vector) (render-seq n indent "[" "]")
      (= k :map) (render-seq n indent "{" "}")
      ; a set literal `#{ … }` — flat like a vector (not pair-broken like a map)
      (= k :set) (render-seq n indent "#{" "}")
      else (node-text n))))

(defn- render-wrap
  (prefix child indent)
  ;; Reader-macro wrappers don't introduce their own break: render the child at
  ;; the current column. (A long `'(foo bar)` will break inside the list, which
  ;; is what we want.)
  (str prefix (render child (+ indent (string/length prefix)))))

(defn- render-seq
  (n indent open close)
  ;; Try single-line; if it fits the remaining budget at this indent, take it.
  ;; Else break across lines.
  ;;
  ;; Maps are inherently pair-shaped (alternating key/value), so a broken map
  ;; pairs up like a `let` bindings list — `{:a 1\n :b 2}` instead of every
  ;; element on its own line. The pair walker is comment-aware, so a map with
  ;; comments still pairs up (with the comments preserved in place).
  ;; Respect the author's line structure: if the source had newlines *inside this
  ;; form's own children*, keep it broken even if the collapsed form would fit.
  ;; Standard Lisp formatter behaviour (matches Clojure/Racket/Emacs-lisp), and
  ;; idempotent — a form already on one line stays on one line, a form already
  ;; broken stays broken. Maps follow the same rule but get the pair-break layout.
  ;;
  ;; Perf: compute `keep-broken` FIRST and build the flat `single-line` only when
  ;; the form is NOT already broken. An already-formatted file is mostly broken
  ;; forms, and their flat string would just be discarded — building it was the
  ;; formatter's dominant cost (each nested breaking form rebuilt the full flat of
  ;; its whole subtree). Skipping it is the same output, far less work.
  (let (keep-broken (had-author-newlines? n)
        one (if keep-broken nil (single-line n)))
    (cond
      (and one (<= (+ indent (string/length one)) (width))) one
      (= (node-kind n) :map) (render-pair-break (node-children n) indent "{" "}")
      else (render-break (node-children n) indent open close))))

;; True if `n` was broken across lines in the source — so collapsing it to one
;; line would erase that intent. A form is broken if any of its direct-child
;; whitespace contains a newline, OR if any structural child is itself broken.
;;
;; The recursion is load-bearing for idempotence. A multi-line form physically
;; spans several lines, so it always contains a nested newline somewhere — but
;; on a re-format that newline can sink one level deeper than the form whose
;; break we're deciding. E.g. `(let (caught (try …multi-line…)))`: the author's
;; newline sat between `caught` and the `(try …)`, so pass 1 kept the bindings
;; list broken; but pass 1 re-emits `caught` and `(try …)` on the *same* line,
;; pushing every newline down inside the `(try …)`. A shallow direct-child scan
;; then sees no newline in the bindings list and collapses it — losing the
;; break. Propagating broken-ness up from any nested form makes "broken" a true
;; fixed point: a form that renders multi-line is recognised as broken on every
;; subsequent pass. Idempotent: a fully single-line form has no inner newline at
;; any depth and answers false.
(defn- had-author-newlines?
  (n)
  (let (k (node-kind n))
    (cond
      (or (= k :list) (= k :vector) (= k :map) (= k :set))
        (had-author-newlines-scan (node-children n)
          0
          (seq/vector-length (node-children n)))
      (wrapper? n) (had-author-newlines? (node-form n))
      else false)))

(defn- had-author-newlines-scan
  (kids i n)
  (cond
    (= i n) false
    (let (c (seq/vector-ref kids i))
      (or (and (whitespace? c) (includes? (node-text c) "\n"))
        (and (not (trivia? c)) (had-author-newlines? c))))
      true
    else (had-author-newlines-scan kids (inc i) n)))

(defn- render-break
  (kids indent open close)
  ;; Multi-line list emit. The output is:
  ;;   open + head-line + body-lines + close
  ;; where head-line is "head [header-args]" on the first line, and body-lines
  ;; are each remaining structural arg on its own line, indented +2 from the
  ;; opening bracket. Comments between args are emitted on their own lines at
  ;; the same body indent. Whitespace nodes only contribute "blank line wanted"
  ;; intent (capped at 1) between body items.
  ;;
  ;; Two layout shapes ride on top of the default:
  ;;   - `let`-family forms (`*format-pair-bindings*`): the first header arg
  ;;     is rendered as a pair-list (name+value per line, aligned under the
  ;;     bindings list's opening element).
  ;;   - `cond`/`case` (`*format-pair-body*`): body args are emitted two per
  ;;     line (test+result, pattern+body) at the body indent.
  ;; Generic calls (head not in the headers table) also keep their *first*
  ;; arg on the head line — provided it is single-line — so the visual unit
  ;; `(head arg1)` survives the break.
  (let (forms (filter (fn (c) (not (trivia? c))) (vec->list kids)))
    (cond
      (nil? forms) (str open close)
      else
        (let (head (first forms)
              args (rest forms)
              hdr-count (head-header-count head)
              pair-bind (pair-bindings? head)
              pair-bd (pair-body? head)
              body-ind (+ indent 2)
              ;; eff-hdr: how many args ride on the head line. Body-form
              ;; counts (>= 0) override the default; for generic calls
              ;; (-1) we ride exactly one arg when it's single-line.
              eff-hdr (cond
                        ;; A DATA collection (`[…]`/`#{…}`) has no "head": its first
                        ;; element mustn't ride a sibling up onto its line. Break one
                        ;; element per line (the first sits after the open bracket).
                        ;; Riding is a *call* affordance — `(head arg)` — only. (Maps
                        ;; are pair-broken elsewhere and never reach here.)
                        (not (= open "(")) 0
                        (>= hdr-count 0) (min hdr-count (count args))
                        (nil? args) 0
                        (nil? (single-line (first args))) 0
                        ;; A comment sitting between the head and its first
                        ;; arg must stay visible: riding the arg up would skip
                        ;; over the comment's `kids` slot (it precedes the
                        ;; first body index) and silently drop it. Break
                        ;; instead so the body walker emits the comment.
                        (comment-before-first-arg? kids) 0
                        else 1))
          (let (header-args (take eff-hdr args)
                first-body-idx (kids-index-after-form kids eff-hdr)
                header-line (render-head-line head header-args pair-bind (inc indent))
                ;; Fill (pack args per line) only for a *generic call* — a head
                ;; with no header entry (`hdr-count` -1). A known body/special
                ;; form (`defn`/`do`/`let`/`when`…) keeps its statements one per
                ;; line, so it must NOT fill. Nor a body whose args are themselves
                ;; collections (a vector/list of `[…]`/`(…)`): those read best one
                ;; per line (CL `:linear`), so filling `[[a][b][c]]` onto packed
                ;; lines is wrong — break linearly. Fill stays for atom sequences
                ;; (`(error "a: " x " b: " y …)`), the case it exists for.
                body-text (if pair-bd
                            (render-body-pairs kids first-body-idx body-ind)
                            (render-body kids
                              first-body-idx
                              body-ind
                              (and (< hdr-count 0)
                                (not (body-has-container? kids first-body-idx))))))
            ;; If the body ends in a comment, the close delimiter must drop to
            ;; its own line at the opening indent — appended directly it would
            ;; land *inside* the comment (`;; note)`), commenting out the `)`
            ;; and leaving the list unclosed (an unparseable file).
            (str open
              header-line
              body-text
              (if (last-nonws-comment? kids) (str "\n" (indent-of indent)) "")
              close))))))

(defn last-nonws-comment? (kids)
  "True if the body's LAST emitted block is a comment — the case where a closing
delimiter has to break to its own line so it isn't swallowed (`;; note)` would comment
out the `)` and leave the file unparseable).

The last non-ws child being a comment is now both necessary AND sufficient: since a
same-line trailing comment is left in place rather than hoisted above its form, a
comment that is last in the source is last in the output either way. That is what
retired the `comment-on-own-line?` distinction this used to need."
  (last-nonws-comment?-at kids (dec (seq/vector-length kids))))
(defn- last-nonws-comment?-at
  (kids i)
  (cond
    (< i 0) false
    (whitespace? (seq/vector-ref kids i)) (last-nonws-comment?-at kids (dec i))
    (comment? (seq/vector-ref kids i)) true
    else false))
;; Scanning backward from `i`, was the comment that follows on its own line —
;; i.e. NOT a same-line trailing comment that the body walker hoists above its
;; form? A comment is hoisted (and so is *not* emitted last) only when it sits on
;; the same line right after a FORM: the gap before it is whitespace without a
;; newline, and the node before that gap is a structural form. Every other case
;; is own-line and stays last: a newline in the preceding whitespace, a comment
;; right after `(`, or a comment following another comment (each comment node
;; carries its own trailing newline, so the separating whitespace is just
;; indentation with no newline of its own).
(defn- comment-on-own-line?
  (kids i)
  (cond
    (< i 0) true
    (and (whitespace? (seq/vector-ref kids i)) (includes? (node-text (seq/vector-ref kids i)) "\n"))
      true
    ;; skip one newline-free whitespace gap, then look at what precedes it
    (whitespace? (seq/vector-ref kids i)) (comment-on-own-line?-prev kids (dec i))
    else (comment-on-own-line?-prev kids i)))
(defn- comment-on-own-line?-prev
  (kids i)
  (cond
    (< i 0) true
    (comment? (seq/vector-ref kids i)) true
    else false))

;; True if a comment appears in `kids` between the head (first structural form)
;; and the first argument (second structural form). Such a comment would be
;; dropped by the generic-call head-ride (which jumps from the head straight to
;; the first body form), so the caller breaks instead of riding when it's true.
(defn- comment-before-first-arg?
  (kids)
  (let (head-i (kids-index-of-form kids 0) n (seq/vector-length kids))
    (and (< head-i n) (comment-before-next-form? kids (inc head-i) n))))
;; Scanning forward from `i`, is the next non-whitespace node a comment (rather
;; than a structural form)? Stops at the first form (false) or first comment (true).
(defn- comment-before-next-form?
  (kids i n)
  (cond
    (= i n) false
    (whitespace? (seq/vector-ref kids i)) (comment-before-next-form? kids (inc i) n)
    (comment? (seq/vector-ref kids i)) true
    else false))

;; Index in `kids` of the (1-based) Nth structural form (0 = head).
(defn- kids-index-of-form
  (kids form-i)
  (kids-index-of-form-at kids form-i 0 0 (seq/vector-length kids)))
(defn- kids-index-of-form-at
  (kids target seen i n)
  (cond
    (= i n) n
    (= seen target) i
    (trivia? (seq/vector-ref kids i)) (kids-index-of-form-at kids target seen (inc i) n)
    else (kids-index-of-form-at kids target (inc seen) (inc i) n)))

;; The `kids` index immediately PAST the slot of the (0-based) `form-i`th
;; structural form — i.e. where the body walk should begin so that any trivia
;; (notably comments) sitting between the last head-line form and the first body
;; form is still visited rather than skipped. Counts `form-i + 1` structural
;; forms and returns the index one past the last of them; if there are fewer,
;; returns the end. (`kids-index-of-form kids (inc form-i)` jumps to the *next*
;; structural form, stepping over — and dropping — an intervening comment.)
(defn- kids-index-after-form
  (kids form-i)
  (kids-index-after-form-at kids (inc form-i) 0 (seq/vector-length kids)))
(defn- kids-index-after-form-at
  (kids remaining i n)
  (cond
    (= i n) n
    (trivia? (seq/vector-ref kids i)) (kids-index-after-form-at kids remaining (inc i) n)
    (= remaining 1) (inc i)
    else (kids-index-after-form-at kids (dec remaining) (inc i) n)))

(defn- render-head-line
  (head header-args pair-bind? indent-after-open)
  ;; "head a b c" — the head and any header args, space-separated. Uses
  ;; single-line for the args. For very long header args (e.g. an oversize
  ;; param list), each falls back to its own multi-line render — keeping it on
  ;; the same line might exceed width, but the alternative is fiddly and the
  ;; defn signatures we see in practice fit.
  ;;
  ;; When `pair-bind?` is true, the FIRST header arg (the bindings list of
  ;; let/letrec/binding/...) goes through `render-pair-list`, which pairs up
  ;; alternating name/value when the list breaks.
  (render-head-line-build (cons head header-args) pair-bind? indent-after-open ""))
(defn- render-head-line-build
  (items pair-bind-first? indent acc)
  (cond
    (nil? items) acc
    (= acc "")
      (render-head-line-build (rest items)
        pair-bind-first?
        indent
        (render (first items) indent))
    pair-bind-first?
      (let (item (first items)
            col (+ indent (string/length acc) 1)
            part (if (= (node-kind item) :list)
                   (render-pair-list item col)
                   (render item col)))
        (render-head-line-build (rest items) false indent (str acc " " part)))
    else
      (let (part (render (first items) (+ indent (string/length acc) 1)))
        (render-head-line-build (rest items) false indent (str acc " " part)))))

;; ---- pair-list emit (let / letrec / binding / ... bindings) -----------------
;; Renders a list node `n` whose children are alternating name/value, breaking
;; to one pair per line when it doesn't fit. Continuation lines align under
;; the bindings list's first element (column = `indent + 1`, i.e. one past
;; the opening `(`). Comments are preserved — a same-line trailing comment is
;; hoisted onto its own line *above* its pair, an own-line comment sits on its own
;; line at the pair indent (the walker pairs name+value but never *across* a comment).
(defn- render-pair-list
  (n indent)
  ;; Skip the flat `single-line` when already broken — same perf fix as `render-seq`.
  (let (keep-broken (had-author-newlines? n)
        one (if keep-broken nil (single-line n)))
    (cond
      (and one (<= (+ indent (string/length one)) (width))) one
      else (render-pair-break (node-children n) indent "(" ")"))))

(defn- render-pair-break
  (kids indent open close)
  ;; The close delimiter drops to its own line when the last emitted item is a comment —
  ;; appended directly it would land INSIDE it (`b 2 ; the b)`), commenting out the
  ;; bindings list's `)` and leaving the file unparseable. This check was unnecessary
  ;; while same-line trailing comments were hoisted above their pair (a comment could
  ;; never be last); leaving them in place is what makes it load-bearing. Same rule
  ;; `render-break` already applies to a body.
  (let (pair-ind (inc indent))
    (str open
      (render-pair-walk kids 0 (seq/vector-length kids) pair-ind 0 "")
      (if (last-nonws-comment? kids) (str "\n" (indent-of pair-ind)) "")
      close)))

;; The separator before the next emitted item: nothing for the very first pair
;; (it sits right after the `(`), else a newline (blank line preserved when the
;; source had one) + the pair indent. Comments always take a leading newline so
;; one can never land right after `(` and comment out the bindings.
(defn- render-pair-sep
  (acc nl pair-ind comment?)
  (cond
    (and (= acc "") (not comment?)) ""
    (>= nl 2) (str "\n\n" (indent-of pair-ind))
    else (str "\n" (indent-of pair-ind))))

(defn- render-pair-walk
  (kids i n pair-ind nl acc)
  ;; Walk kids, emitting one name+value pair per line and each comment in place.
  ;; `nl` tracks newlines since the last emitted item (so a blank line between
  ;; bindings survives). Mirrors render-body-pairs, but with no head, the pair
  ;; indent for continuation lines, and same-line trailing comments hoisted above.
  (if (= i n)
    acc
    (let (c (seq/vector-ref kids i))
      (cond
        (whitespace? c)
          (render-pair-walk kids
            (inc i)
            n
            pair-ind
            (+ nl (count-newlines (node-text c)))
            acc)
        (comment? c)
          (render-pair-walk kids
            (inc i)
            n
            pair-ind
            1
            (str acc
              (render-pair-sep acc nl pair-ind true)
              (comment-strip-trailing-nl (node-text c))))
        ;; a name; pair it with the next form unless a comment (or the end)
        ;; intervenes first — pairing across a comment would step over and drop it.
        else
          (let (j (kids-next-nonws kids (inc i) n)
                arendr (render c pair-ind))
            (if (or (= j n) (comment? (seq/vector-ref kids j)))
              (render-pair-walk kids
                (inc i)
                n
                pair-ind
                0
                (str acc (render-pair-sep acc nl pair-ind false) arendr))
              (let (brendr (render (seq/vector-ref kids j) (+ pair-ind (string/length arendr) 1))
                    pair-body (str arendr " " brendr)
                    tc (trailing-comment-at kids (inc j) n))
                (if (nil? tc)
                  (render-pair-walk kids
                    (inc j)
                    n
                    pair-ind
                    0
                    (str acc (render-pair-sep acc nl pair-ind false) pair-body))
                  ;; Keep a same-line trailing comment after its pair, where the author
                  ;; wrote it (see render-body-at).
                  (render-pair-walk kids
                    (inc tc)
                    n
                    pair-ind
                    0
                    (str acc
                      (render-pair-sep acc nl pair-ind false)
                      pair-body
                      " "
                      (comment-strip-trailing-nl (node-text (seq/vector-ref kids tc)))))))))))))

;; ---- pair body emit (cond / case clauses) -----------------------------------
;; Like render-body but consumes two structural forms per emission, joined by
;; one space, one pair per line. Comments preserved on their own lines (a
;; comment between the two members of a pair is rare and won't render ideally;
;; the common case — a comment above a clause — works correctly).
(defn- render-body-pairs
  (kids start-idx body-ind)
  (render-body-pairs-at kids start-idx (seq/vector-length kids) body-ind 0 ""))

(defn- render-body-pairs-at
  (kids i n body-ind nl acc)
  (if (= i n)
    acc
    (let (c (seq/vector-ref kids i))
      (cond
        (whitespace? c)
          (render-body-pairs-at kids
            (inc i)
            n
            body-ind
            (+ nl (count-newlines (node-text c)))
            acc)
        (comment? c)
          (render-body-pairs-at kids
            (inc i)
            n
            body-ind
            1
            (str acc
              (if (>= nl 2) "\n\n" "\n")
              (indent-of body-ind)
              (comment-strip-trailing-nl (node-text c))))
        ;; A structural clause. Pair it with the *next* form — but only if a form
        ;; is what comes next. If a comment intervenes first (or we're at the end),
        ;; emit this clause alone and let the loop handle the comment on its own
        ;; line; pairing across a comment would step over and DROP it.
        else
          (let (j (kids-next-nonws kids (inc i) n))
            (if (or (= j n) (comment? (seq/vector-ref kids j)))
              ;; No form to pair with. If what intervenes is this clause's own
              ;; SAME-LINE trailing comment, keep it on the clause's line rather than
              ;; letting the loop drop it onto its own.
              (let (tc (trailing-comment-at kids (inc i) n))
                (if (nil? tc)
                  (render-body-pairs-at kids
                    (inc i)
                    n
                    body-ind
                    0
                    (str acc (if (>= nl 2) "\n\n" "\n") (indent-of body-ind) (render c body-ind)))
                  (render-body-pairs-at kids
                    (inc tc)
                    n
                    body-ind
                    0
                    (str acc
                      (if (>= nl 2) "\n\n" "\n")
                      (indent-of body-ind)
                      (render c body-ind)
                      " "
                      (comment-strip-trailing-nl (node-text (seq/vector-ref kids tc)))))))
              (let (arendr (render c body-ind)
                    vnode (seq/vector-ref kids j)
                    ;; Miser drop (CL miser mode): if `key value` won't fit on one
                    ;; line at the width, put the value on the NEXT line at a block
                    ;; indent rather than starting it deep after the key — this
                    ;; avoids far-right drift AND gives the value's own contents the
                    ;; full width (so e.g. each `:dependencies` entry gets room).
                    ;; The trigger is content-based (does the flat pair fit?), so it
                    ;; is idempotent. `value-ind` is +2 from the key's indent.
                    vflat (single-line vnode)
                    pair-fits (and vflat
                                (<= (+ body-ind (string/length arendr) 1 (string/length vflat))
                                  (width)))
                    value-ind (+ body-ind 2)
                    pair-str (if pair-fits
                               (str arendr
                                 " "
                                 (render vnode (+ body-ind (string/length arendr) 1)))
                               (str arendr "\n" (indent-of value-ind) (render vnode value-ind)))
                    tc (trailing-comment-at kids (inc j) n))
                (if (nil? tc)
                  (render-body-pairs-at kids
                    (inc j)
                    n
                    body-ind
                    0
                    (str acc (if (>= nl 2) "\n\n" "\n") (indent-of body-ind) pair-str))
                  ;; Keep the pair's same-line trailing comment on the pair's line.
                  (render-body-pairs-at kids
                    (inc tc)
                    n
                    body-ind
                    0
                    (str acc
                      (if (>= nl 2) "\n\n" "\n")
                      (indent-of body-ind)
                      pair-str
                      " "
                      (comment-strip-trailing-nl (node-text (seq/vector-ref kids tc)))))))))))))

;; Next non-WHITESPACE child at or after `i` (comments are NOT skipped — a
;; comment is a meaningful boundary the pair emitter must not pair across).
(defn- kids-next-nonws
  (kids i n)
  (cond (= i n) n (whitespace? (seq/vector-ref kids i)) (kids-next-nonws kids (inc i) n) else i))

;; "Trailing same-line comment" detection. After emitting a structural form,
;; peek through any following whitespace. If that whitespace contains no newline
;; AND the next non-whitespace node is a comment, the comment was on the same line
;; as the form in the source. Each render site **hoists** such a comment onto its
;; own line *above* the form (a trailing comment never stays after the code on the
;; same line). Returns the index of that comment, or nil if there is none.
(defn- trailing-comment-at (kids start n) (trailing-comment-at-scan kids start n))
(defn- trailing-comment-at-scan
  (kids i n)
  (cond
    (= i n) nil
    (whitespace? (seq/vector-ref kids i))
      (if (> (count-newlines (node-text (seq/vector-ref kids i))) 0)
        nil
        (trailing-comment-at-scan kids (inc i) n))
    (comment? (seq/vector-ref kids i)) i
    else nil))

;; True if any structural body arg (from start-idx) is itself a container — then
;; fill is the wrong layout (containers read best one per line, CL `:linear`).
(defn- body-has-container?
  (kids start-idx)
  (body-has-container?-at kids start-idx (seq/vector-length kids)))
(defn- body-has-container?-at
  (kids i n)
  (cond
    (= i n) false
    (and (not (trivia? (seq/vector-ref kids i))) (container? (seq/vector-ref kids i))) true
    else (body-has-container?-at kids (inc i) n)))

;; The index of the value that belongs to the keyword argument at `i`, or nil when
;; `kids[i]` is not a keyword or no FORM follows it (end of body, or a comment next —
;; pairing across a comment would step over and drop it).
(defn- keyword-value-at
  (kids i n)
  (when (= (node-kind (seq/vector-ref kids i)) :keyword)
    (let (j (kids-next-nonws kids (inc i) n))
      (when (and (< j n) (not (comment? (seq/vector-ref kids j)))) j))))

(defn- render-body
  (kids start-idx body-ind fill?)
  ;; Walk kids from start-idx, emitting each structural form (and each comment) at
  ;; body-ind. `nl` mirrors the root walker: it tracks the newline count between
  ;; the last emitted block and the cursor, so a blank line in the source survives
  ;; between two body items. Init 0: we want a single `\n` between the head-line
  ;; and the first body item (a blank there would be ugly and isn't user intent).
  ;;
  ;; `fill?` (true only for a **generic call** — never a body/special form) packs
  ;; consecutive single-line args onto one line up to `*width*`, so an
  ;; overflowing `(error "a: " x " b: " y …)` wraps as a few filled lines rather
  ;; than one tall stack. The +2 indent is kept (no align-to-head, which would
  ;; reflow on every rename). `col` = the column the next arg would fill to, or nil
  ;; to force a fresh line (start of body, after a comment, after a multi-line arg).
  (render-body-at kids start-idx (seq/vector-length kids) body-ind 0 "" fill? nil))

(defn- render-body-at
  (kids i n body-ind nl acc fill? col)
  (if (= i n)
    acc
    (let (c (seq/vector-ref kids i))
      (cond
        (whitespace? c)
          (render-body-at kids
            (inc i)
            n
            body-ind
            (+ nl (count-newlines (node-text c)))
            acc
            fill?
            col)
        (comment? c)
          (render-body-at kids
            (inc i)
            n
            body-ind
            1
            (str acc
              (if (>= nl 2) "\n\n" "\n")
              (indent-of body-ind)
              (comment-strip-trailing-nl (node-text c)))
            fill?
            nil)
        else
          (let (ind (indent-of body-ind)
                ;; A KEYWORD ARGUMENT and the value after it are one unit, so they are
                ;; rendered together and never split across lines. Without this,
                ;; `(io/puts "…" :to (io/stderr-port))` broke as
                ;;
                ;;     (io/puts "…"
                ;;       :to
                ;;       (io/stderr-port))
                ;;
                ;; which reads as two unrelated arguments rather than one named one. It
                ;; only showed when filling was off — a body containing a container breaks
                ;; linearly — so the short-value form `:to *err*` looked fine and hid it.
                ;;
                ;; Only when a FORM is what follows: pairing across a comment would step
                ;; over and drop it (the trap `render-body-pairs-at` documents), and a
                ;; trailing keyword with nothing after it is an ordinary argument.
                kw-val-idx (keyword-value-at kids i n)
                form-rendr (if kw-val-idx
                             (str (node-text c)
                               " "
                               (render (seq/vector-ref kids kw-val-idx) body-ind))
                             (render c body-ind))
                ;; Skip past the value too when the pair was emitted as one.
                i (if kw-val-idx kw-val-idx i)
                c (if kw-val-idx (seq/vector-ref kids kw-val-idx) c)
                tc-idx (trailing-comment-at kids (inc i) n)
                single (not (includes? form-rendr "\n"))
                w (string/length form-rendr)
                ;; Ride onto the current line when: filling is allowed, the
                ;; previous item left a fillable column, this arg is single-line,
                ;; no blank line or trailing comment forces a break, and it fits.
                can-fill (and fill?
                           col
                           single
                           (nil? tc-idx)
                           (< nl 2)
                           (<= (+ col 1 w) (width)))
                ;; The column a following arg would fill to: end of this arg on
                ;; its line, or nil when it is multi-line (can't fill after it).
                next-col (if single (+ body-ind w) nil))
            (cond
              can-fill
                (render-body-at kids
                  (inc i)
                  n
                  body-ind
                  0
                  (str acc " " form-rendr)
                  fill?
                  (+ col 1 w))
              (nil? tc-idx)
                (render-body-at kids
                  (inc i)
                  n
                  body-ind
                  0
                  (str acc (if (>= nl 2) "\n\n" "\n") ind form-rendr)
                  fill?
                  next-col)
              ;; Keep a same-line trailing comment WHERE THE AUTHOR PUT IT — after the
              ;; form, on the same line. It used to be hoisted onto its own line above
              ;; the form, which is what made `nest format` disagree with the whole tree
              ;; (98 lines of the red) and destroyed the alignment that makes a column of
              ;; trailing comments readable. `col` is nil after one: nothing may ride a
              ;; line that now ends in a comment, or it would be commented out.
              else
                (render-body-at kids
                  (inc tc-idx)
                  n
                  body-ind
                  0
                  (str acc
                    (if (>= nl 2) "\n\n" "\n")
                    ind
                    form-rendr
                    " "
                    (comment-strip-trailing-nl (node-text (seq/vector-ref kids tc-idx))))
                  fill?
                  nil)))))))

;; ---- top-level walk ---------------------------------------------------------
;; `source src` parses src, renders the root, and ensures exactly one
;; trailing newline. Top-level forms are joined by a single `\n`, with a blank
;; line preserved between any pair the author separated with one.
(defn source (src)
  "Format `src` as a Brood source string. Idempotent.

    (string/trim (format/source \"(a  b)\"))   → \"(a b)\""
  (let (root (reflect/parse-source src)) (cst-root (node-children root))))

(defn cst-root (kids)
  "Render the root's child nodes `kids` — the top-level forms — into the formatted source string, with exactly one trailing newline."
  ;; The walk accumulates the top-level blocks as a REVERSED chunk list, joined once here.
  ;; It used to accumulate the output string itself — `(str acc "\n" block)` per top-level
  ;; form — which recopies everything emitted so far, i.e. O(forms × file). That reads as
  ;; linear at small sizes (the per-form render dominates) and only shows up as the file
  ;; grows: ratios 3.80 / 4.12 / 4.64 / 4.46 / 6.40 across bases, and 3.6 s for 12 800
  ;; forms. A shape that creeps *up* across bases is the opposite of the warm-up signature
  ;; that clears a row, and it was mistakenly cleared once on the small-N numbers alone.
  (let (out (apply str (reverse (format-cst-root-walk kids 0 (seq/vector-length kids) 0 ()))))
    (cond (= out "") "" (string/ends-with? out "\n") out else (str out "\n"))))

;; The walker threads `nl-since-last`: the newline count between the last
;; emitted block and the cursor. Whitespace adds its newline count; a comment
;; resets to 1 (its own trailing `\n` is the start of the gap to the next
;; block); a form resets to 0. Two-or-more newlines between blocks → blank line.
(defn- format-cst-root-walk
  (kids i n nl acc)
  (if (= i n)
    acc
    (let (c (seq/vector-ref kids i))
      (cond
        (whitespace? c)
          (format-cst-root-walk kids
            (inc i)
            n
            (+ nl (count-newlines (node-text c)))
            acc)
        (comment? c)
          (format-cst-root-walk kids
            (inc i)
            n
            1
            (format-source-glue acc nl (comment-strip-trailing-nl (node-text c))))
        else
          (let (form-block (render c 0) tc-idx (trailing-comment-at kids (inc i) n))
            (if (nil? tc-idx)
              (format-cst-root-walk kids
                (inc i)
                n
                0
                (format-source-glue acc nl form-block))
              ;; Keep a top-level form's same-line trailing comment after it, where the
              ;; author wrote it (see render-body-at).
              (format-cst-root-walk kids
                (inc tc-idx)
                n
                0
                (format-source-glue acc
                  nl
                  (str form-block
                    " "
                    (comment-strip-trailing-nl (node-text (seq/vector-ref kids tc-idx))))))))))))

;; `acc` is the reversed chunk list, so gluing is two `cons`es instead of a full recopy.
;; The empty case is deliberately `(if (= block "") acc …)` rather than a plain `(list
;; block)`: the old string version tested `(= acc "")`, which stays true while every block
;; so far has been empty, and only then omits the separator. Consing an empty first block
;; would make the list non-empty and emit a leading separator the old code never produced.
(defn- format-source-glue
  (acc nl block)
  (cond
    (empty? acc) (if (= block "") acc (list block))
    (>= nl 2) (cons block (cons "\n\n" acc))
    else (cons block (cons "\n" acc))))

;; ---- driving the project ----------------------------------------------------
;; `nest format` formats the trees the project OWNS, named as a whitelist:
;; `:source-paths` + `:test-paths` + any extra `:format-paths`, plus the root's
;; own top-level .blsp (the manifest). `nest format --check` runs the same walk
;; but emits a diff summary and raises if anything was off.
;;
;; A whitelist, not "everything under the root minus an ignore list". The root
;; also holds Brood source the project does NOT own — `_deps/<pkg>/**.blsp` is a
;; fetched dependency, which `nest fetch` regenerates and the author cannot edit,
;; so reformatting it is churn the next fetch discards, and counting it makes
;; "N files considered" a number about somebody else's code. An ignore list has
;; to grow an entry for each such directory as it is invented (`target`,
;; `node_modules`, `_deps`, the next one); naming what we own is closed by
;; construction. The cost is that a tree of authored-but-not-built .blsp — this
;; repo's own `std/`, an `examples/` — must be listed in `:format-paths` to be
;; formatted.

;; Directory names skipped WITHIN a whitelisted tree. `target/` is Cargo's build
;; output and `node_modules/` npm's, neither authored; dot-dirs (`.git`,
;; `.claude`, …) are external state. `_deps/` is here as depth (the whitelist
;; already excludes it) for a nested-project layout that vendors one inside a
;; source path.
(defn- format-ignored-dir?
  (name)
  (or (= name "target")
    (= name "_deps")
    (= name "node_modules")
    (and (> (string/length name) 0) (= (string/substring name 0 1) "."))))

(defn- format-collect-blsp
  (dir)
  ;; Every .blsp file beneath `dir` (recursive), sorted by `file/ls`'s order.
  ;; Returns a flat list of absolute paths. Symlinks aren't followed — we read
  ;; whatever `file/dir?` + `file/ls` see, which is sufficient for the typical
  ;; project layout.
  (if (file/dir? dir)
    (fold
      (fn (acc entry)
        (let (p (path/join dir entry))
          (cond
            ;; `cons`/`%append-two` (share the accumulator tail) not `(append acc …)`
            ;; (recopies the growing accumulator per entry → O(files²) on a large tree).
            (file/dir? p)
              (if (format-ignored-dir? entry) acc (%append-two (format-collect-blsp p) acc))
            ;; Skip generated lock files (`project.lock.blsp`): they're machine-
            ;; written ("do not edit by hand") and re-serialized by `nest fetch` on
            ;; every setup, so formatting them just fights the resolver.
            (string/ends-with? entry ".lock.blsp") acc
            (string/ends-with? entry ".blsp") (cons p acc)
            else acc)))
      nil
      (file/ls dir))
    nil))

;; The root's OWN .blsp files, non-recursively — `project.blsp` and any top-level
;; script. Non-recursive on purpose: descending is exactly what the whitelist is
;; there to prevent, and this keeps the manifest formatted without naming it.
;; `project.lock.blsp` is skipped by the `.lock.blsp` rule below, as before.
(defn- format-root-files
  (root)
  (if (file/dir? root)
    (fold (fn (acc entry)
            (let (p (path/join root entry))
              (cond
                (file/dir? p) acc
                (string/ends-with? entry ".lock.blsp") acc
                (string/ends-with? entry ".blsp") (cons p acc)
                else acc)))
      nil
      (file/ls root))
    nil))

;; The directories this project owns: its source and test paths, plus whatever
;; `:format-paths` adds. A path that does not exist contributes nothing.
;; The path vars are `defdyn`, so they are ROOT names (ADR-151) — read bare, not
;; as `project/…`, even though `project` is where they are declared.
(defn- format-roots
  (root)
  (append (project/abs-paths root *project-source-paths*)
    (project/abs-paths root *project-test-paths*)
    (project/abs-paths root (or *project-format-paths* (list)))))

(defn- format-every-blsp
  (root)
  ;; Every .blsp the project owns, in deterministic order: the root's own files
  ;; plus each whitelisted tree. `distinct` because the whitelists can overlap
  ;; (`:format-paths ["."]`, or a test path nested inside a source path).
  (seq/distinct (append (format-root-files root)
                  (fold (fn (acc dir) (%append-two (format-collect-blsp dir) acc))
                    nil
                    (format-roots root)))))

(defn- format-require-root
  ()
  (let (root (project/find-root (file/cwd)))
    (when (nil? root)
      (error "format: not in a Brood project (no project.blsp found from " (file/cwd) ")"))
    (project/setup root)
    root))

;; Does `src` parse as a complete program? The CST the formatter walks is
;; deliberately LOSSLESS and error-TOLERANT — it happily represents an unclosed
;; list — so it cannot answer this. The strict reader can.
;;
;; This gate is load-bearing, not belt-and-braces. A formatter's contract is "same
;; program, different layout", and on a file with a missing `)` the CST's recovery
;; silently RESTRUCTURED the source: given a `(defn f …` whose paren was never
;; closed followed by a top-level `(defn g …)`, formatting moved `g` *inside* `f`
;; and appended the missing paren at the end. Being mid-edit with an unclosed paren
;; is completely routine (and format-on-save makes it automatic), so that turned a
;; half-typed file into silently different code.
(defn- format-parses? (src) (try (do (read-all src) true) (catch _ false)))

(defn file (path)
  "Format the file at `path` in place. Returns `:unchanged`, `:rewrote`, or `:unparseable` — a file that does not parse is left untouched, since there is no program to re-lay-out and the tolerant CST would restructure it."
  (let (src (file/slurp path))
    (if (not (format-parses? src))
      :unparseable (let (out (source src))
        (if (= src out) :unchanged (do (file/spit path out) :rewrote))))))

(defn project ()
  "Format every .blsp under the current project (sources + tests). Prints one line
per rewritten file and a summary; returns the number of files rewritten. A file
that does not parse is reported and skipped, never rewritten."
  (let (root (format-require-root) files (format-every-blsp root))
    (let (counts (format-apply files 0 0)
          rewrote (first counts)
          skipped (second counts))
      (io/puts (str "format: "
                 (count files)
                 " file"
                 (if (= (count files) 1) "" "s")
                 " considered, "
                 rewrote
                 " rewritten"
                 (if (> skipped 0) (str ", " skipped " skipped (does not parse)") "")
                 "."))
      rewrote)))

;; Returns `(rewrote skipped)`. An unparseable file prints a `does not parse`
;; line so it is never silently passed over — the whole point is that the user
;; finds out their file was left alone, and why.
(defn- format-apply
  (files rewrote skipped)
  (if (nil? files)
    (list rewrote skipped)
    (let (path (first files)
          r (file path))
      (when (= r :rewrote) (io/puts (str "  rewrote " path)))
      (when (= r :unparseable) (io/puts (str "  skipped (does not parse): " path)))
      (format-apply (rest files)
        (if (= r :rewrote) (inc rewrote) rewrote)
        (if (= r :unparseable) (inc skipped) skipped)))))

;; A tiny local set (a map to true) — avoids requiring `set` just for membership.
(defn- format-set-of
  (coll)
  (fold (fn (m x) (assoc m x true)) {} coll))

;; The .blsp files under the project that git reports as not-committed-clean
;; (modified/staged/untracked), intersected with the project's own file set so
;; a stray .blsp elsewhere in the repo is ignored. Returns `:not-a-repo` (from
;; the primitive) when there is no git work tree; otherwise a list (possibly
;; empty — a clean tree) of the changed .blsp paths.
(defn- format-changed-blsp
  (root)
  (let (changed (%git-changed-files root))
    (if (= changed :not-a-repo)
      :not-a-repo (let (project (format-set-of (format-every-blsp root)))
        (filter (fn (p) (contains? project p))
          (filter (fn (p) (string/ends-with? p ".blsp")) changed))))))

(defn project-changed ()
  "Format only the .blsp files git reports as changed (modified/staged/untracked)
under the current project — the git-aware narrower scope of `nest format`
(`--changed`). Falls back to the whole project if not in a git repo. Returns the
number of files rewritten."
  (let (root (format-require-root) changed (format-changed-blsp root))
    (if (= changed :not-a-repo)
      (do
        (io/puts "format: not a git repository — formatting the whole project.")
        (project))
      (let (counts (format-apply changed 0 0)
            rewrote (first counts)
            skipped (second counts))
        (io/puts (str "format: "
                   (count changed)
                   " changed file"
                   (if (= (count changed) 1) "" "s")
                   " considered, "
                   rewrote
                   " rewritten"
                   (if (> skipped 0) (str ", " skipped " skipped (does not parse)") "")
                   "."))
        rewrote))))

(defn project-check ()
  "Check (don't write): print each file whose contents differ from
`(source …)` and raise if any do. Used by `nest format --check`."
  (let (root (format-require-root) files (format-every-blsp root))
    (let (changed (format-check files nil))
      (cond
        (nil? changed)
          (do
            (io/puts (str "format: "
                       (count files)
                       " file"
                       (if (= (count files) 1) "" "s")
                       " checked, all clean."))
            0)
        else
          (do
            (fold (fn (_ entry)
                    (io/puts (if (= (seq/vector-ref entry 1) :unparseable)
                               (str "  does not parse: " (seq/vector-ref entry 0))
                               (str "  needs formatting: " (seq/vector-ref entry 0)))))
              nil changed)
            (let (unparseable (count (filter (fn (e) (= (seq/vector-ref e 1) :unparseable))
                                       changed))
                  dirty (- (count changed) unparseable))
              (error "format: "
                dirty
                (if (= dirty 1) " file needs" " files need")
                " formatting"
                (if (> unparseable 0) (str ", " unparseable " do(es) not parse") "")
                ".")))))))

;; An unparseable file is reported as `[path :unparseable]` rather than as "needs
;; formatting": `nest format` will NOT rewrite it (see `file`), so calling
;; it unformatted would promise a fix that never comes. It still fails the check —
;; a file that doesn't parse is not a clean tree.
(defn- format-check
  (files acc)
  (if (nil? files)
    (reverse acc)
    (let (path (first files)
          src (file/slurp path))
      (format-check (rest files)
        (cond
          (not (format-parses? src)) (cons [path :unparseable] acc)
          (= src (source src)) acc
          else (cons [path :needs-formatting] acc))))))
