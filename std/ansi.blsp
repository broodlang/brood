;; std/ansi.blsp — ANSI / VT100 escape-sequence stripping.
;; Callers use `ansi/strip` — a qualified name loads the module. Pure Brood over string
;; primitives, no IO or editor dependency — reusable in any process that reads
;; pipe output from a subprocess that emits colour escapes (a shell, a build
;; tool, a test runner).
(defmodule ansi
  "ANSI / VT100 escape-sequence stripping for pipe output.
Strips CSI colour/cursor sequences (`ESC [ … letter`, the SGR `m` and cursor
`A`–`D`/`H`/`J`/`K` family) and bare carriage returns (`\\r`) — the characters a
subprocess emits when it detects a TTY but gets a pipe instead. `strip` is
the public entry point; the helpers are private (`--`).")

(defn- ansi-csi-final?
  (c)
  "Whether `c` is the final byte of a CSI sequence — a letter (SGR `m`, cursor ops)."
  (includes? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" c))

;; `v` below is a CODE-POINT VECTOR (built once in `strip`), and `n` its length,
;; threaded rather than recomputed. Both matter: `char-at` on a raw UTF-8 string is O(i)
;; and `string-length` is `chars().count()`, i.e. O(n) — so the previous scan, which did
;; one of each per character, was O(n²) twice over. Measured 7.6× then 14.0× per 4× of
;; input (linear is 4×), and 1.58 s to strip ~90 KB of colourised output. Same fix as
;; `url.blsp` / `csv.blsp`, which hit this before.

(defn- ansi-csi-end
  (v i n)
  "Index just past the CSI final byte, scanning `v` from `i` (clamped to `n`)."
  (cond
    (>= i n) i
    (ansi-csi-final? (nth v i)) (+ i 1)
    else (ansi-csi-end v (+ i 1) n)))

(defn- ansi-strip
  (v i n out)
  "Tail-recursive scan: copy `v[i..n]` to the reversed char list `out`, dropping ANSI
escape sequences and carriage returns."
  (if (>= i n)
    (apply str (reverse out))
    (let (c (nth v i))
      (cond
        (= c "\e")
          (if (and (< (+ i 1) n) (= (nth v (+ i 1)) "["))
            ; CSI: skip to final byte
            (ansi-strip v (ansi-csi-end v (+ i 2) n) n out)
            (ansi-strip v (+ i 2) n out))
        ; other ESC X: drop both
        (= c "\r") (ansi-strip v (+ i 1) n out)
        ; bare CR: drop
        else (ansi-strip v (+ i 1) n (cons c out))))))

(defn strip (s)
  "`s` with all ANSI escape sequences and bare carriage returns removed.
Fast path: a chunk with no ESC byte only needs its CRs dropped (a single
`replace` pass, no char-by-char scan).

    (ansi/strip (str (string/int->char 27) \"[1mx\" (string/int->char 27) \"[0m\"))   → \"x\""
  (if (includes? s "\e")
    (let (v (into [] (string/->list s)))
      (ansi-strip v 0 (count v) ()))
    (string/replace s "\r" "")))
