;; std/stream.blsp — process-based pull streams.
;;
;; A stream is a PID implementing this two-message protocol:
;;
;;   (send s [:next (self)])   request the next element
;;   → [:stream-val v]         value arrived
;;   → :stream-done            stream exhausted
;;   → [:stream-err msg]       unrecoverable error
;;
;;   (send s :stream-close)    cancel (graceful shutdown)
;;
;; Streams are lazy (nothing is computed until requested) and work across
;; process boundaries. Transformers like `map` each spawn one light
;; process; the process overhead is noise when I/O dominates, and that is the
;; primary use case (HTTP bodies, TCP pipes). For pure data, plain map/fold
;; over lists is faster and simpler.

(defmodule stream
  "Process-based pull streams.

A stream is a PID: send `[:next (self)]`, receive `[:stream-val v]`,
`:stream-done`, or `[:stream-err msg]`. Build pipelines from sources,
transformers, and terminals — each transformer adds one green process.

  ;; HTTP body line-by-line (with http):
  (let (body-stream (socket-> sock))
    (each (lines body-stream) io/puts))

  ;; Lazy integer processing:
  (->list
    (take (map (range 1 100) (fn (n) (* n n))) 5))
  ;; => [1 4 9 16 25]")

;; ---- protocol helpers -------------------------------------------------------

;; A producer that is GONE can never answer, so a bare `receive` for its reply parks
;; the consumer forever — uncatchably, with no timeout and nothing left to wake it.
;; That is not a hypothetical: since KI-33 an exhausted source answers `:stream-done`
;; **once and then exits**, so a second `next` on a fully-consumed stream (or on one
;; whose producer crashed mid-pipeline) had no reply coming at all. `next` therefore
;; monitors the producer for the duration of the request: its death is an answer.
(defn- stream-down-result (reason)
  ;; An exhausted source exits `:normal` after its last `:stream-done`, and a monitor
  ;; placed on an ALREADY-exited process reports `:noproc` without retaining the
  ;; original reason — so both read as a clean end of stream. Anything else is a crash,
  ;; and the consumer gets it as a failure rather than as silent exhaustion.
  (if (or (= reason :normal) (= reason :noproc))
    :done (failure "stream/next: producer died: " (pr-str reason))))

(defn next (s &optional timeout-ms)
  "Request the next element from stream `s`.
Returns `[:ok v]` for a value, `:done` when exhausted, or a `failure` on error (ADR-310).
A value stays wrapped because it may itself be `nil` or `:done`.

Monitors `s` for the duration, so a producer that has **exited** — an exhausted
source (which exits after its last `:stream-done`, KI-33) or one that crashed —
answers `:done` / a failure instead of parking the caller forever. `timeout-ms`
additionally bounds the wait on a producer that is alive but never replies; omit
it (the default) for an I/O stream that may legitimately be slow, where the
monitor is the whole guard.

    (stream/next (stream/singleton 7))   ;=> [:ok 7]
    (stream/next (stream/empty))         ;=> :done"
  (let (m (monitor s))
    (send s [:next (self)])
    (let (res (if (nil? timeout-ms)
                (receive
                  ([:stream-val v] [:ok v])
                  (:stream-done :done)
                  ([:stream-err msg] (failure msg))
                  ([:down ^m _ reason] (stream-down-result reason)))
                (receive
                  ([:stream-val v] [:ok v])
                  (:stream-done :done)
                  ([:stream-err msg] (failure msg))
                  ([:down ^m _ reason] (stream-down-result reason))
                  (after timeout-ms (failure "stream/next: timed out after " timeout-ms " ms")))))
      (demonitor m)
      ; don't leak a late [:down] into the caller's mailbox
      (receive ([:down ^m _ _] :ok) (after 0 :ok))
      res)))

(defn close (s: (or map pid) -> nil)
  "Signal stream `s` to clean up and exit. Returns nil immediately.

    (stream/close (stream/range 0 10))   ;=> nil"
  (send s :stream-close))

;; ---- sources ----------------------------------------------------------------

(defn empty ()
  "A stream that is immediately done.

    (stream/->list (stream/empty))   ;=> nil"
  (spawn (done-loop)))

(defn singleton (x)
  "A stream that yields exactly one value `x`, then ends.

    (stream/->list (stream/singleton :x))   ;=> (:x)"
  (spawn (singleton-loop x)))

(defn- singleton-loop (x)
  (receive
    ([:next r] (send r [:stream-val x])
      (done-loop))
    (:stream-close nil)))

(defn- done-loop ()
  ;; An exhausted stream answers :stream-done ONCE, then exits — like every other source
  ;; loop (list-loop, fn-loop) and every transformer, all of which return on
  ;; exhaustion. Recursing here (answering :done idempotently) would park the process
  ;; forever — a per-stream leak. Exiting is safe: a consumer stops at the first :done, and
  ;; a transformer forwards :done then exits, never re-polling its upstream (KI-33).
  (receive
    ([:next r] (send r :stream-done))
    (:stream-close nil)))

(defn list-> (xs)
  "A stream over the items of list or vector `xs`. Evaluated eagerly once.

    (stream/->list (stream/list-> [1 2 3]))   ;=> (1 2 3)"
  (spawn (list-loop (seq xs))))

(defn- list-loop (xs)
  (receive
    ([:next r] (if (empty? xs)
                 (do (send r :stream-done))
                 (do
                   (send r [:stream-val (first xs)])
                   (list-loop (rest xs)))))
    (:stream-close nil)))

(defn fn-> (init f:fn)
  "A stream driven by generator `f` from the state `init`. Each call `(f state)` returns
`[:yield v new-state]` to emit `v` and continue, or `:done` to end the stream. The seed comes
first and the generator last, as `seq/iterate` takes `(x f)` (ADR-507).

    (stream/->list (stream/fn-> 1 (fn (n) (if (> n 3) :done [:yield n (inc n)]))))   ;=> (1 2 3)"
  (spawn (fn-loop f init)))

(defn- fn-loop (f state)
  (receive
    ([:next r] (let (result (f state))
                 (if (= result :done)
                   (send r :stream-done)
                   (do
                     (send r [:stream-val (second result)])
                     (fn-loop f (third result))))))
    (:stream-close nil)))

(defn range (start stop)
  "A stream of integers from `start` (inclusive) to `stop` (exclusive).

    (stream/->list (stream/range 0 5))   ;=> (0 1 2 3 4)"
  (fn-> start
    (fn (i) (if (< i stop) [:yield i (+ i 1)] :done))))

;; ---- TCP socket source ------------------------------------------------------
;; socket-> creates a stream that owns a TCP socket and delivers
;; its inbound chunks on demand. The calling process must be the socket owner
;; at call time; ownership transfers to the stream process immediately.
;;
;; Socket messages pile up in the stream process's mailbox and are served
;; to requesters on demand. Data that arrives before a request is buffered
;; in the process loop parameter (immutable accumulation).

(defn socket-> (sock)
  "A stream of string chunks from TCP socket `sock`. Transfers socket ownership
to the stream process — the caller must not `receive` from `sock` afterwards.
Call immediately after accept or connect, before any data has been read.

    (stream/socket-> (tcp/connect \"localhost\" 8080))   ;~> a stream of the string chunks the socket receives"
  (let (me (self)
        s (spawn (sock-init sock me)))
    (receive
      ([:stream-socket-ready ^s] (do (sock-forward-queued sock s) s))
      ([:stream-err msg] (error "socket->: " msg)))))

;; A connected or accepted socket is already reading, so data can reach the caller before
;; the stream process owns the socket. `tcp/controlling-process` moves only what arrives
;; after it returns, and it has returned by the time the producer says it is ready, so
;; everything still in the caller's mailbox for this socket is exactly what came before.
;; Hand it over in order, then mark the end. Left where it was, it never reached the
;; stream, and a writer that sent and closed straight after the accept hung the reader.
(defn- sock-forward-queued (sock s)
  (receive
    ([:tcp ^sock data] (do (send s [:stream-fwd [:tcp data]]) (sock-forward-queued sock s)))
    ([:tcp-closed ^sock] (do (send s [:stream-fwd [:tcp-closed]]) (sock-forward-queued sock s)))
    ([:tcp-error ^sock msg] (do
                              (send s [:stream-fwd [:tcp-error msg]])
                              (sock-forward-queued sock s)))
    (after 0 (send s :stream-flushed))))

(defn- sock-init (sock parent)
  (tcp/controlling-process sock (self))
  (send parent [:stream-socket-ready (self)])
  (sock-take-forwarded sock ""))

;; What the caller forwards comes before anything the socket sends this process directly,
;; so it is consumed first; a selective receive leaves the direct messages queued behind it.
(defn- sock-take-forwarded (sock buf)
  (receive
    ([:stream-fwd [:tcp data]] (sock-take-forwarded sock (str buf data)))
    ([:stream-fwd [:tcp-closed]] (do (receive (:stream-flushed nil)) (sock-eof-loop buf)))
    ([:stream-fwd [:tcp-error msg]] (do (receive (:stream-flushed nil)) (sock-error-loop msg)))
    (:stream-flushed (sock-loop sock nil buf))))

(defn- sock-loop (sock pending buf)
  ;; pending: a requester PID waiting for data, or nil.
  ;; buf: data that arrived before a requester; "" when empty.
  (receive
    ;; TCP data arrived
    ([:tcp ^sock data] (if pending
                         (do
                           (send pending [:stream-val data])
                           (sock-loop sock nil ""))
                         (sock-loop sock nil (str buf data))))
    ;; Socket closed / EOF
    ([:tcp-closed ^sock]
      (cond
        pending (send pending (if (= buf "") :stream-done [:stream-val buf]))
        ;; No requester yet (buffered data or not): stay alive in the EOF loop so the
        ;; consumer's next `[:next]` is answered (remaining data, then `:stream-done`).
        ;; Returning `nil` here when `buf` is "" was a race: if EOF was processed while
        ;; the consumer was between requests, the process died and the consumer's final
        ;; `[:next]` blocked forever (the stream hung).
        else (sock-eof-loop buf)))
    ;; Socket error. With no requester waiting, stay to answer the next one: returning
    ;; left the consumer's next `[:next]` unanswered, and the stream hung.
    ([:tcp-error ^sock msg] (if pending (send pending [:stream-err msg]) (sock-error-loop msg)))
    ;; Consumer requests next chunk
    ([:next r] (cond
                 (not (= buf ""))
                   (do
                     (send r [:stream-val buf])
                     (sock-loop sock nil ""))
                 else (sock-loop sock r "")))
    ;; Graceful cancel
    (:stream-close (tcp/close sock))))

(defn- sock-error-loop (msg)
  ;; The socket failed before anyone asked for data: the next request gets the error.
  (receive
    ([:next r] (send r [:stream-err msg]))
    (:stream-close nil)))

(defn- sock-eof-loop (remaining)
  ;; Closed but still have buffered bytes to deliver.
  (receive
    ([:next r] (if (= remaining "")
                 (send r :stream-done)
                 (do
                   (send r [:stream-val remaining])
                   (sock-eof-loop ""))))
    (:stream-close nil)))

;; ---- transformers -----------------------------------------------------------
;; Each transformer spawns a process that sits between upstream and downstream.
;; The nested receive in each is safe: the inner receive fires before the next
;; outer [:next] can arrive (the consumer is blocked waiting for our reply).

(defn map (s f)
  "A stream applying `f` to each element of `s`.

    (stream/->list (stream/map (stream/range 1 4) (fn (n) (* n n))))   ;=> (1 4 9)"
  (spawn (map-loop f s)))

(defn- map-loop (f up)
  (receive
    ([:next r] (send up [:next (self)])
      (receive
        ([:stream-val v] (send r [:stream-val (f v)]) (map-loop f up))
        (:stream-done (send r :stream-done))
        ([:stream-err m] (send r [:stream-err m]))))
    (:stream-close (close up))))

(defn filter (s pred)
  "A stream yielding only elements of `s` for which `(pred element)` is true.

    (stream/->list (stream/filter (stream/range 0 10) math/even?))   ;=> (0 2 4 6 8)"
  (spawn (filter-outer pred s)))

(defn- filter-outer (pred up)
  (receive
    ([:next r] (filter-fetch pred up r))
    (:stream-close (close up))))

(defn- filter-fetch (pred up r)
  ;; Keep asking upstream until a matching element is found.
  (send up [:next (self)])
  (receive
    ([:stream-val v] (if (pred v)
                       (do (send r [:stream-val v]) (filter-outer pred up))
                       (filter-fetch pred up r)))
    (:stream-done (send r :stream-done))
    ([:stream-err m] (send r [:stream-err m]))))

(defn take (s n)
  "A stream yielding at most the first `n` elements of `s`.

    (stream/->list (stream/take (stream/range 0 100) 3))   ;=> (0 1 2)"
  (spawn (take-loop n s)))

(defn- take-loop (n up)
  (receive
    ([:next r] (if (= n 0)
                 (do (send r :stream-done) (close up))
                 (do
                   (send up [:next (self)])
                   (receive
                     ([:stream-val v] (send r [:stream-val v])
                       (take-loop (- n 1) up))
                     (:stream-done (send r :stream-done))
                     ([:stream-err m] (send r [:stream-err m]))))))
    (:stream-close (close up))))

(defn- take-while-loop (pred up)
  (receive
    ([:next r] (send up [:next (self)])
      (receive
        ([:stream-val v] (if (pred v)
                           (do (send r [:stream-val v]) (take-while-loop pred up))
                           (do (send r :stream-done) (close up))))
        (:stream-done (send r :stream-done))
        ([:stream-err m] (send r [:stream-err m]))))
    (:stream-close (close up))))

(defn drop (s n)
  "A stream skipping the first `n` elements of `s`.

    (stream/->list (stream/drop (stream/range 0 6) 4))   ;=> (4 5)"
  (spawn (drop-init n s)))

(defn- drop-init (n up)
  ;; Eagerly skip n items before the first request arrives.
  (if (= n 0)
    (passthrough-loop up)
    (do
      (send up [:next (self)])
      (receive
        ([:stream-val _] (drop-init (- n 1) up))
        (:stream-done (done-loop))
        ([:stream-err m] (err-loop m))))))

(defn- passthrough-loop (up)
  (receive
    ([:next r] (send up [:next (self)])
      (receive
        ([:stream-val v] (send r [:stream-val v]) (passthrough-loop up))
        (:stream-done (send r :stream-done))
        ([:stream-err m] (send r [:stream-err m]))))
    (:stream-close (close up))))

(defn- err-loop (m)
  ;; Like done-loop: report the error once, then exit rather than parking forever.
  ;; A consumer that sees [:stream-err …] stops (fold/-->list raise), and a
  ;; transformer forwards the error and exits — nothing re-polls, so exiting is safe.
  (receive
    ([:next r] (send r [:stream-err m]))
    (:stream-close nil)))

(defn chunk (s:any n:int -> pid)
  "A stream of vectors, each holding `n` consecutive elements of `s`.
The last vector may be shorter if the source isn't a multiple of `n`.

    (stream/->list (stream/chunk (stream/range 0 5) 2))   ;=> ([0 1] [2 3] [4])"
  (when (<= n 0) (error "chunk: n must be > 0"))
  (spawn (chunk-outer n s)))

(defn- chunk-outer (n up)
  (receive
    ([:next r] (chunk-fetch n up r nil 0))
    (:stream-close (close up))))

(defn- chunk-fetch (n up r acc k)
  ;; Collect k items (in reverse in acc), emit when k=n or upstream done.
  (if (= k n)
    (do
      (send r [:stream-val (into [] (reverse acc))])
      (chunk-outer n up))
    (do
      (send up [:next (self)])
      (receive
        ([:stream-val v] (chunk-fetch n up r (cons v acc) (+ k 1)))
        (:stream-done (if (nil? acc)
                        (send r :stream-done)
                        (do
                          (send r [:stream-val (into [] (reverse acc))])
                          (done-loop))))
        ([:stream-err m] (send r [:stream-err m]))))))

(defn append (s1 s2)
  "A stream yielding all elements of `s1` then all elements of `s2`. Shadows the bare `append`, which returns a list, as `stream/map` shadows `map` (ADR-253).

    (stream/->list (stream/append (stream/list-> [1 2]) (stream/list-> [3])))   ;=> (1 2 3)"
  (spawn (append-loop s1 s2)))

(defn- append-loop (s1 s2)
  (receive
    ([:next r] (send s1 [:next (self)])
      (receive
        ([:stream-val v] (send r [:stream-val v])
          (append-loop s1 s2))
        (:stream-done
          ;; s1 exhausted — serve pending r from s2, then passthrough s2
          (send s2 [:next (self)])
          (receive
            ([:stream-val v] (send r [:stream-val v])
              (passthrough-loop s2))
            (:stream-done (send r :stream-done))
            ([:stream-err m] (send r [:stream-err m]))))
        ([:stream-err m] (send r [:stream-err m]))))
    (:stream-close (close s1)
      (close s2))))

(defn lines (s)
  "A stream that takes string chunks from `s` and emits complete lines
(trailing `\\r\\n` or `\\n` stripped). The final non-empty buffer fragment
after EOF is emitted as a last line (for streams without a trailing newline).

    (stream/->list (stream/lines (stream/list-> [\"a\\nb\" \"c\\r\\nd\"])))   ;=> (\"a\" \"bc\" \"d\")"
  (spawn (lines-outer s "" ())))

;; `buf` is the incomplete trailing fragment; `pending` the complete lines already split
;; out of the last chunk, waiting to be pulled one per `:next`.
;;
;; Splitting each chunk once keeps this linear. Cutting lines one at a time with `index-of`
;; + `substring` copies the rest of the buffer per line — O(lines × buffer) within a chunk,
;; which is the normal shape for a 64 KB socket read or a file slurped and streamed.
(defn- lines-outer (up buf pending)
  (receive
    ([:next r] (lines-fetch up buf pending r))
    (:stream-close (close up))))

(defn- lines-fetch (up buf pending r)
  (if (empty? pending)
    ;; Nothing split out yet — pull upstream. `(str buf chunk)` still recopies, but `buf`
    ;; is only the fragment after the last newline, not the whole unconsumed buffer.
    (do
      (send up [:next (self)])
      (receive
        ([:stream-val chunk] (lines-split up (str buf chunk) r))
        (:stream-done
          ;; Flush remaining buffer as the last line if non-empty.
          (if (= buf "")
            (send r :stream-done)
            (do
              (send r [:stream-val buf])
              (done-loop))))
        ([:stream-err m] (send r [:stream-err m]))))
    (do
      (send r [:stream-val (first pending)])
      (lines-outer up buf (rest pending)))))

;; One `string-split` per chunk. `string-split` always returns at least one element and its
;; LAST element is the fragment after the final separator ("" when the chunk ended on one),
;; so that element is the new `buf` and everything before it is a complete line.
(defn- lines-split (up all r)
  (let (parts (string/split all "\n")
        n (/count parts)
        tail (nth parts (dec n))
        lines (/map (/take parts (dec n)) strip-cr))
    (if (empty? lines)
      ;; No newline in the chunk — keep buffering and ask again.
      (lines-fetch up tail () r)
      (do
        (send r [:stream-val (first lines)])
        (lines-outer up tail (rest lines))))))

(defn- strip-cr (line)
  "Drop one trailing `\\r`, so `\\r\\n` and `\\n` line endings both yield the bare line."
  (string/drop-suffix line "\r"))

;; ---- terminals --------------------------------------------------------------
;; These consume the stream in the calling process (no extra spawn).

(defn fold (s init f)
  "Reduce stream `s` with `f` (a `(fn (acc v) → new-acc)`) starting from `init`.
Raises on a stream error.

    (stream/fold (stream/range 1 5) 0 +)   ;=> 10"
  (%fold-loop f init s))

(defn- %fold-loop (f acc s)
  (match (next s)
    (:done acc)
    ([:ok v] (%fold-loop f (f acc v) s))
    (failed (error "fold: " (error-message failed)))))

(defn ->list (s)
  "Collect all elements of `s` into a list.

    (stream/->list (stream/range 0 3))   ;=> (0 1 2)"
  (reverse (collect-loop s nil)))

(defn- collect-loop (s acc)
  (match (next s)
    (:done acc)
    ([:ok v] (collect-loop s (cons v acc)))
    (failed (error "->list: " (error-message failed)))))

(defn ->vector (s)
  "Collect all elements of `s` into a vector.

    (stream/->vector (stream/range 0 3))   ;=> [0 1 2]"
  (into [] (->list s)))

(defn each (s f)
  "Apply `f` to each element of `s` for side effects. Returns nil.

    (stream/each (stream/range 0 3) (fn (_) nil))   ;=> nil"
  (match (next s)
    (:done nil)
    ([:ok v] (do (f v) (each s f)))
    (failed (error "each: " (error-message failed)))))

(defn count (s)
  "Count the elements in `s`, consuming it.

    (stream/count (stream/range 0 42))   ;=> 42"
  (fold s 0 (fn (n _) (+ n 1))))

(defn pipe (src sink)
  "Drain stream `src`, sending each value as `[:stream-data v]` to process `sink`,
then `:stream-eof` when done (or `[:stream-err msg]` + `:stream-eof` on error).

    (stream/pipe (stream/range 0 3) consumer-pid)   ;~> consumer-pid gets [:stream-data 0] … [:stream-data 2], then :stream-eof"
  (pipe-loop src sink))

(defn- pipe-loop (src sink)
  (match (next src)
    (:done (send sink :stream-eof))
    ([:ok v] (do (send sink [:stream-data v]) (pipe-loop src sink)))
    (failed (do (send sink [:stream-err (error-message failed)]) (send sink :stream-eof)))))

(defn ->socket (s sock)
  "Drain stream `s`, writing each chunk to `sock` with `tcp/send`. Returns nil.

    (stream/->socket (stream/socket-> upstream) sock)   ;~> nil, once every chunk is written to sock"
  (each s (fn (chunk) (tcp/send sock chunk))))

;; (restored: this is stream's take-while, not the sequence one)
(defn take-while (s pred)
  "A stream yielding elements from `s` while `(pred element)` is true.

    (stream/->list (stream/take-while (stream/range 0 100) (fn (n) (< n 3))))   ;=> (0 1 2)"
  (spawn (take-while-loop pred s)))
