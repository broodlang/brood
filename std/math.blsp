;; std/math.blsp — the math library (ADR-227).
;; A namespace (ADR-065): its functions are `math/sqrt`, `math/pow`, `math/round`, … —
;; consumers `(:use math)` to refer them bare, or call them qualified.
;;
;; The *core* arithmetic stays bare in the prelude — the operators (`+ - * /`),
;; `inc`/`dec`, `quot`, `mod`, `rem`, and the always-there predicates `zero?`,
;; `nan?`, `infinite?`. This module is the derived math *library* layered on top:
;; roots, powers, rounding, aggregation, sign/parity predicates, and the constants.
(defmodule math
  "The math library — roots, powers, rounding, aggregation, and constants.

Core arithmetic (`+` `-` `*` `/` `inc` `dec` `quot` `mod` `rem` `zero?` `nan?`
`infinite?`) stays bare in the prelude and needs no import. This module adds the
derived math functions: `sqrt`, `pow`, `ceil`, `round`, `round-to`, `clamp`, `abs`,
`sum`, `product`, the sign/parity predicates (`positive?` `negative?` `even?` `odd?`),
and the constants `pi`/`e`. `(:use math)` for bare access, or call qualified.")

;; ---- math constants ---------------------------------------------------------
(def pi 3.141592653589793)
(def e 2.718281828459045)

;; ---- sign & parity ----------------------------------------------------------
(defn positive? (n) "True if `n` is greater than zero." (> n 0))
(defn negative? (n) "True if `n` is less than zero." (< n 0))
(defn abs (n) "The absolute value of `n`." (if (< n 0) (- n) n))
(defn even? (n) "True if integer `n` is even." (= (rem n 2) 0))
(defn odd? (n) "True if integer `n` is odd." (not (even? n)))

;; ---- aggregation ------------------------------------------------------------
(defn sum (xs) "The sum of the numbers in `xs`." (fold %add 0 xs))
(defn product (xs) "The product of the numbers in `xs`." (fold %mul 1 xs))

;; Rounding & roots, all Brood over the one Float->Int primitive `floor` (toward
;; -inf) plus `rem`/`/`/`*`. `floor` of an int is itself, so these pass ints
;; through unchanged.
(defn ceil (x) "Round `x` toward positive infinity to an integer." (- (floor (- x))))
;; round half away from zero: floor(x+0.5) for x>=0, mirrored for x<0.
(defn round (x)
  "Round `x` to the nearest integer (halves away from zero)."
  (if (< x 0) (- (floor (+ (- x) 0.5))) (floor (+ x 0.5))))

;; (pow base exp) — `exp` must be an integer (use `sqrt` for roots). Int base +
;; non-negative exp stays an int (overflow raises, like `*`); a negative exp gives
;; the reciprocal. Tail-recursive, so a large exponent is O(1) stack.
;;
;; Since ADR-196 an EXACT base's reciprocal is a ratio, which is both better and
;; immune to the underflow the machinery below exists for: `(pow 2 -2000)` is exactly
;; 1/2^2000, where a float reciprocal would be 0.0. A float base still goes through
;; that machinery — an f64 has nowhere exact to put the answer.
;; True for an infinite float: doubling leaves it unchanged and it isn't zero. Used to
;; detect that the positive power overflowed, without naming a magic constant.
(defn- pow-inf? (x) (and (float? x) (not (= x 0.0)) (= x (* x 2.0))))

(defn pow (base exp)
  "`base` raised to integer `exp`. A negative exponent gives the reciprocal — **exact**
(a ratio) for an exact `base`, a float for a float `base`."
  (cond
    (not (int? exp)) (error "pow: exponent must be an integer (use sqrt for roots), got " exp)
    (< exp 0) (pow-reciprocal base exp)
    else (pow-acc base exp 1)))

;; A negative exponent used to be `(/ 1 (pow base (- exp)))`, which loses the whole
;; subnormal range: when the *positive* power overflows, `1/inf` is 0.0, so
;; `(pow 2.0 -1074)` gave 0.0 where 2^-1074 is perfectly representable (5e-324), and
;; every exponent past -1023 was wrong the same way. An int base fails for the sibling
;; reason — `base^|exp|` becomes a bignum rather than inf, and *its* reciprocal
;; underflows. So the test is on the reciprocal, not on the power: a 0.0 result may have
;; lost a representable answer either way. Recompute by splitting the exponent in half,
;; which keeps every intermediate in range and is exact for a radix-2 base. Terminates
;; because `(quot exp 2)` is strictly closer to zero than `exp` once `exp <= -2`, and the
;; halves only recurse while they too come back 0.0. A genuinely-zero answer (10.0^-400,
;; below the subnormal floor) costs one extra recompute and still yields 0.0.
;; (Found by the Paranoia port, 2026-07-26.)
(defn- pow-reciprocal
  (base exp)
  (let (p (pow-acc base (- exp) 1)
        r (if (pow-inf? p) 0.0 (/ 1 p)))
    (if (and (= r 0.0) (<= exp -2))
      (let (h (quot exp 2))
        (* (pow base h) (pow base (- exp h))))
      r)))

(defn- pow-acc (base exp acc) (if (= exp 0) acc (pow-acc base (- exp 1) (* acc base))))

;; (round-to x places) — round to a fixed number of decimal places, staying a
;; number (for a fixed-width *string*, e.g. "3.10", use the `->fixed` primitive).
;; Subject to the usual binary-float caveat: a "halfway" decimal like 1.255 isn't
;; exactly representable, so it may round the way its nearest f64 actually lies.
(defn round-to (x places)
  "Round `x` to `places` decimal places (halves away from zero); returns a number —
a float for a float `x` unless the rounded value is an integer, exact for an exact `x`."
  ;; The final `/` is `round`'s int result over the int scale, so since ADR-196 made
  ;; integer `/` exact it yields a RATIO whenever it doesn't divide evenly, and
  ;; `(round-to 3.14159 2)` came back `157/50` instead of `3.14`. Rounding recovers no
  ;; exactness a float never had, so a float `x` converts back — which restores the
  ;; pre-ADR-196 contract exactly: that `/` was float division, giving a float in the
  ;; non-integral case and an int in the integral one (`(round-to 2.5 0)` → 3, because
  ;; a denominator of 1 demotes). An exact `x` keeps the exact answer.
  (let (scale (pow 10 places)
        r (/ (round (* x scale)) scale))
    (if (and (float? x) (ratio? r)) (->float r) r)))

;; (sqrt n) — delegates to `%f64-sqrt` (f64::sqrt) for IEEE 754 correctness on all
;; inputs including subnormals. Always returns a Float; a negative argument raises.
(defn sqrt (n)
  "The square root of `n` (IEEE 754; always a float). Negative `n` raises."
  (cond (< n 0) (error "sqrt: negative argument " n) (<= n 0) 0.0 else (%f64-sqrt n)))

(defn clamp (x lo hi)
  "Constrain `x` to the closed range [`lo`, `hi`]: `lo` if `x` is below it, `hi` if above, else `x`."
  (max lo (min hi x)))

;; ---- transcendental functions -----------------------------------------------
;; Thin policy over the `%`-prefixed f64 primitives (mechanism), so they live in the
;; `math` namespace (`math/sin`) rather than cluttering the bare language core.
(defn sin (x) "The sine of `x` (radians). Returns a float." (%sin x))
(defn cos (x) "The cosine of `x` (radians). Returns a float." (%cos x))
(defn tan (x) "The tangent of `x` (radians). Returns a float." (%tan x))
(defn asin (x) "The arcsine of `x` in radians. `x` must be in [-1, 1]; raises otherwise." (%asin x))
(defn acos (x)
  "The arccosine of `x` in radians. `x` must be in [-1, 1]; raises otherwise."
  (%acos x))
(defn atan (x) "The arctangent of `x` in radians (result in [-π/2, π/2])." (%atan x))
(defn atan2 (y x)
  "The angle in radians of the vector (`x`, `y`) from the positive x-axis, in (-π, π]. Handles x=0."
  (%atan2 y x))
(defn exp (x) "e raised to the power `x`. Returns a float." (%exp x))
(defn ln (x) "The natural logarithm of `x`. `x` must be positive; raises otherwise." (%ln x))
(defn log2 (x) "The base-2 logarithm of `x`. `x` must be positive; raises otherwise." (%log2 x))
(defn log10 (x) "The base-10 logarithm of `x`. `x` must be positive; raises otherwise." (%log10 x))
