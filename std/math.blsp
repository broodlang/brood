;; std/math.blsp — the math library (ADR-227).
;; A namespace (ADR-065): its functions are `math/sqrt`, `math/pow`, `math/round`, … —
;; consumers `(:use math)` to refer them bare, or call them qualified.
;;
;; The *core* arithmetic stays bare in the prelude — the operators (`+ - * /`),
;; `inc`/`dec`, `quot`, `mod`, `rem`, and the always-there predicates `zero?`,
;; `nan?`, `infinite?`. This module is the derived math *library* layered on top:
;; roots, powers, rounding, aggregation, sign/parity predicates, and the constants.
(defmodule math
  "The math library — roots, powers, rounding, aggregation, and constants.

Core arithmetic (`+` `-` `*` `/` `inc` `dec` `quot` `mod` `rem` `zero?` `nan?`
`infinite?`) stays bare in the prelude and needs no import. This module adds the
derived math functions: `sqrt`, `pow`, `ceil`, `round`, `round-to`, `clamp`, `abs`,
`sum`, `product`, the sign/parity predicates (`positive?` `negative?` `even?` `odd?`),
and the constants `pi`/`e`. `(:use math)` for bare access, or call qualified.")

;; ---- math constants ---------------------------------------------------------
(def pi 3.141592653589793)
(def e 2.718281828459045)

;; ---- sign & parity ----------------------------------------------------------
;; `Zero` — is this value the additive identity of ITS OWN type?
;;
;; It lives HERE, as `math/zero?`, because its whole family does: `math/positive?`,
;; `math/negative?`, `math/even?`, `math/odd?`. It was bare, which made it the odd one out
;; and spent a bare name on a question only numbers can answer. An ability op declared
;; inside a module is namespaced to it (`%ability-qualify-op`), the way `Port`'s op is
;; `io/emit` and not bare `emit`.
;;
;; `zero?` was `(= n 0)`, bare, in prelude/map.blsp. `=` is type-strict, so it answered
;; **false for `0.0` and for `0M`** — a zero-predicate that says a zero is not zero — while
;; `(< 0.0 1)` and `math/positive?` beside it handled the whole numeric tower. It also
;; answered `false` for `"a"` and for `nil`: a WRONG VALUE for a question that has no
;; meaning, rather than a refusal.
;;
;; There is deliberately **NO `:default`**. A type with no impl gets the loud `%no-method`
;; error naming the ability, exactly as `Num` and `Ord` do — a question about a type nobody
;; has answered must SAY nobody has answered it, not pick a value. That is the whole
;; distinction between "false" and "not applicable", and defaulting erases it.
;;
;; A zero ratio normalises to the int `0` (`(/ 0 5)` is `0`, `:int`), so the `:ratio` impl is
;; constant-false rather than a comparison.
;; `Numeric` — the two float-domain questions, asked of any numeric type.
;;
;; `nan?`/`infinite?` were bare and written `(and (float? x) …)`, so a non-float answered
;; `false` — including `"a"`, `nil` and `[1]`, for which the question is a category error,
;; not a fact. An INT answering false is right (an int is a number and is not NaN); a string
;; answering false is the `zero?` bug again. One impl per numeric type, no `:default`
;; (ADR-254), so an unanswered type raises instead of being told it is not NaN.
;; ---- the arithmetic that is not an operator ------------------------------------
;; `min`/`max`/`rem`/`quot`/`mod`/`->fixed` were BARE. They are derived arithmetic, which is
;; what this module is, and bare is the scarce namespace — `(:use math)` brings them back
;; bare inside one module. The kernel halves keep the `%` prefix every other primitive has
;; (`%add`, `%quot`), so the PRELUDE can use `%max`/`%rem`/`%quot` directly and never has to
;; load a module to do arithmetic. `eval/compile/ir.rs` keys `PrimOp::Max`/`Min`/`Rem` on the
;; call-site NAME, so these wrappers are still inlined — `table/get` is the same shape.

;; Two-argument arms so the common call is a DIRECT primitive call, which is what the
;; ADR-069 thin-wrapper elision needs to reach it — the same reason `<=` in the prelude
;; spells its 2-arg body `(%le a b)` rather than `(not (%lt b a))`. As a single-clause
;; `(& xs)` over `(apply %max xs)` this allocated a rest-list per call and could not be
;; inlined: measured at **36% of the `collatz` benchmark row** (223 ms -> 142 ms), where
;; one `math/max` runs per loop iteration. `math/rem`/`math/quot` beside it cost nothing
;; precisely because they are fixed-arity one-primitive bodies. See
;; docs/compute-frontier.md §2b.
(defn max "The largest of the arguments.

    (math/max 1 2)   → 2"
  ((a b) (%max a b))
  ((& xs) (apply %max xs)))
(defn min "The smallest of the arguments.

    (math/min 1 2)   → 1"
  ((a b) (%min a b))
  ((& xs) (apply %min xs)))
(defn rem (a b)
  "The remainder of `a / b`, taking the sign of the DIVIDEND (truncated division), the
partner of `quot`. `mod` is the one whose sign follows the divisor.

    (math/rem 7 2)    → 1
    (math/rem -7 2)   → -1"
  (%rem a b))
(sig rem (int int -> int))
(defn ->fixed (x n)
  "Render number `x` as a string with exactly `n` digits after the decimal point (rounded).

    (math/->fixed 1.5 2)   → \"1.50\""
  (%->fixed x n))
(sig ->fixed (number int -> string))

(defn rational (n d)
  "The exact rational `n`/`d` — reduced, with a positive denominator (a denominator
of 1 gives an integer). Same as `(/ n d)` for integers; errors when `d` is 0.

    (math/rational 1 2)   → 1/2"
  (/ n d))
(defn quot (a b)
  "Truncated integer division of `a` by `b` (toward zero); the quotient partner to `rem`.

    (math/quot 7 2)    → 3"
  (%quot a b))
(sig quot (int int -> int))
(defn mod (a b)
  "Euclidean modulo: the result is always non-negative and lies in [0, |b|).

    (math/mod 7 2)     → 1
    (math/mod -1 3)    → 2   ; sign follows the DIVISOR"
  ;; `(abs b)` inlined so bare `mod` stays self-sufficient — `abs` now lives in the
  ;; `math` module (ADR-227) and the boot-time prelude cannot require a module.
  (let (r (math/rem a b)) (if (< r 0) (+ r (if (< b 0) (- b) b)) r)))

(defability Numeric
  "Float-domain questions every numeric type can answer.

    (math/nan? nan)        → true
    (math/nan? 1)          → false   ; an int is a number, and is not NaN
    (math/infinite? inf)   → true
    (math/infinite? 1.0)   → false"
  (nan? [self] :-> bool)
  (infinite? [self] :-> bool))
(impl Numeric
  :float (nan? [x] (not (= x x)))
  (infinite? [x] (or (= x inf) (= x -inf))))
(impl Numeric :int (nan? [x] false) (infinite? [x] false))
(impl Numeric :decimal (nan? [x] false) (infinite? [x] false))
(impl Numeric :ratio (nan? [x] false) (infinite? [x] false))

(defability Zero
  "True when `self` is the additive identity of its own type — across the whole numeric
tower, not just the int `0`. A type with no impl RAISES rather than answering.

    (zero? 0)      → true
    (zero? 0.0)    → true
    (zero? 0M)     → true
    (zero? 1/2)    → false"
  (zero? [self] :-> bool))
(impl Zero :int (zero? [n] (%eq n 0)))
(impl Zero :float (zero? [n] (%eq n 0.0)))
(impl Zero :decimal (zero? [n] (%eq n 0M)))
(impl Zero :ratio (zero? [n] false))

(defn positive? (n)
  "True if `n` is greater than zero.

    (math/positive? 1)    → true"
  (> n 0))
(sig positive? (number -> bool))

(defn negative? (n)
  "True if `n` is less than zero.

    (math/negative? -1)   → true"
  (< n 0))
(sig negative? (number -> bool))

(defn abs (n)
  "The absolute value of `n`.

    (math/abs -3)    → 3
    (math/abs 3)     → 3
    (math/abs -2.5)  → 2.5

    (math/abs -3)          → 3"
  (if (< n 0) (- n) n))
(sig abs (number -> number))

(defn even? (n)
  "True if integer `n` is even.

    (math/even? 4)   → true
    (math/even? 3)   → false
    (math/even? 0)   → true

    (math/even? 4)         → true"
  (= (math/rem n 2) 0))
(sig even? (int -> bool))
(defn odd? (n)
  "True if integer `n` is odd.

    (math/odd? 3)         → true"
  (not (even? n)))
(sig odd? (int -> bool))

;; ---- aggregation ------------------------------------------------------------
(defn sum (xs)
  "The sum of the numbers in `xs`.

    (math/sum [1 2 3])  → 6
    (math/sum [])       → 0

    (math/sum [1 2 3])     → 6"
  (fold xs 0 %add))
(sig sum (seqable -> number))
(defn product (xs)
  "The product of the numbers in `xs`.

    (math/product [2 3 4])   → 24"
  (fold xs 1 %mul))
(sig product (seqable -> number))

;; Rounding & roots, all Brood over the one Float->Int primitive `floor` (toward
;; -inf) plus `rem`/`/`/`*`. `floor` of an int is itself, so these pass ints
;; through unchanged.
(defn ceil (x)
  "Round `x` toward positive infinity to an integer.

    (math/ceil 1.2)       → 2"
  (- (math/floor (- x))))
(sig ceil (number -> int))

;; round half away from zero: floor(x+0.5) for x>=0, mirrored for x<0.
(defn round (x)
  "Round `x` to the nearest integer (halves away from zero).

    (math/round 2.5)       → 3"
  (if (< x 0) (- (math/floor (+ (- x) 0.5))) (math/floor (+ x 0.5))))
(sig round (number -> int))

;; (pow base exp) — `exp` must be an integer (use `sqrt` for roots). Int base +
;; non-negative exp stays an int (overflow raises, like `*`); a negative exp gives
;; the reciprocal. Tail-recursive, so a large exponent is O(1) stack.
;;
;; Since ADR-196 an EXACT base's reciprocal is a ratio, which is both better and
;; immune to the underflow the machinery below exists for: `(pow 2 -2000)` is exactly
;; 1/2^2000, where a float reciprocal would be 0.0. A float base still goes through
;; that machinery — an f64 has nowhere exact to put the answer.
;; True for an infinite float: doubling leaves it unchanged and it isn't zero. Used to
;; detect that the positive power overflowed, without naming a magic constant.
(defn- pow-inf? (x) (and (float? x) (not (= x 0.0)) (= x (* x 2.0))))

(defn pow (base exp)
  "`base` raised to integer `exp`. A negative exponent gives the reciprocal — **exact**
(sig pow (number int -> number))

(a ratio) for an exact `base`, a float for a float `base`.

    (math/pow 2 10)        → 1024"
  (cond
    (not (int? exp)) (error "pow: exponent must be an integer (use sqrt for roots), got " exp)
    (< exp 0) (pow-reciprocal base exp)
    else (pow-acc base exp 1)))

;; A negative exponent used to be `(/ 1 (pow base (- exp)))`, which loses the whole
;; subnormal range: when the *positive* power overflows, `1/inf` is 0.0, so
;; `(pow 2.0 -1074)` gave 0.0 where 2^-1074 is perfectly representable (5e-324), and
;; every exponent past -1023 was wrong the same way. An int base fails for the sibling
;; reason — `base^|exp|` becomes a bignum rather than inf, and *its* reciprocal
;; underflows. So the test is on the reciprocal, not on the power: a 0.0 result may have
;; lost a representable answer either way. Recompute by splitting the exponent in half,
;; which keeps every intermediate in range and is exact for a radix-2 base. Terminates
;; because `(math/quot exp 2)` is strictly closer to zero than `exp` once `exp <= -2`, and the
;; halves only recurse while they too come back 0.0. A genuinely-zero answer (10.0^-400,
;; below the subnormal floor) costs one extra recompute and still yields 0.0.
;; (Found by the Paranoia port, 2026-07-26.)
(defn- pow-reciprocal (base exp)
  (let (p (pow-acc base (- exp) 1)
        r (if (pow-inf? p) 0.0 (/ 1 p)))
    (if (and (= r 0.0) (<= exp -2))
      (let (h (math/quot exp 2))
        (* (pow base h) (pow base (- exp h))))
      r)))

(defn- pow-acc (base exp acc) (if (= exp 0) acc (pow-acc base (- exp 1) (* acc base))))

;; (round-to x places) — round to a fixed number of decimal places, staying a
;; number (for a fixed-width *string*, e.g. "3.10", use the `->fixed` primitive).
;; Subject to the usual binary-float caveat: a "halfway" decimal like 1.255 isn't
;; exactly representable, so it may round the way its nearest f64 actually lies.
(defn round-to (x places)
  "Round `x` to `places` decimal places (halves away from zero); returns a number —
a float for a float `x` unless the rounded value is an integer, exact for an exact `x`.

    (math/round-to 3.14159 2)   → 3.14"
  ;; The final `/` is `round`'s int result over the int scale, so since ADR-196 made
  ;; integer `/` exact it yields a RATIO whenever it doesn't divide evenly, and
  ;; `(round-to 3.14159 2)` came back `157/50` instead of `3.14`. Rounding recovers no
  ;; exactness a float never had, so a float `x` converts back — which restores the
  ;; pre-ADR-196 contract exactly: that `/` was float division, giving a float in the
  ;; non-integral case and an int in the integral one (`(round-to 2.5 0)` → 3, because
  ;; a denominator of 1 demotes). An exact `x` keeps the exact answer.
  (let (scale (pow 10 places)
        r (/ (round (* x scale)) scale))
    (if (and (float? x) (ratio? r)) (->float r) r)))
(sig round-to (number int -> number))

;; (sqrt n) — delegates to `%f64-sqrt` (f64::sqrt) for IEEE 754 correctness on all
;; inputs including subnormals. Always returns a Float; a negative argument raises.
(defn sqrt (n)
  "The square root of `n` (IEEE 754; always a float). Negative `n` raises.

    (math/sqrt 9)          → 3.0"
  (cond (< n 0) (error "sqrt: negative argument " n) (<= n 0) 0.0 else (%f64-sqrt n)))
(sig sqrt (number -> float))

(defn clamp (x lo hi)
  "Constrain `x` to the closed range [`lo`, `hi`]: `lo` if `x` is below it, `hi` if above, else `x`.

    (math/clamp 5 0 10)   → 5
    (math/clamp -1 0 10)  → 0
    (math/clamp 99 0 10)  → 10

    (math/clamp 12 0 10)   → 10
    (math/clamp -1 0 10)   → 0"
  (math/max lo (math/min hi x)))
(sig clamp (number number number -> number))

;; ---- transcendental functions -----------------------------------------------
;; Thin policy over the `%`-prefixed f64 primitives (mechanism), so they live in the
;; `math` namespace (`math/sin`) rather than cluttering the bare language core.
(defn sin (x)
  "The sine of `x` (radians). Returns a float.

    (math/sin 0)          → 0.0"
  (%sin x))
(sig sin (number -> float))
(defn cos (x)
  "The cosine of `x` (radians). Returns a float.

    (math/cos 0)          → 1.0"
  (%cos x))
(sig cos (number -> float))
(defn tan (x) "The tangent of `x` (radians). Returns a float." (%tan x))
(sig tan (number -> float))
(defn asin (x) "The arcsine of `x` in radians. `x` must be in [-1, 1]; raises otherwise." (%asin x))
(sig asin (number -> float))
(defn acos (x)
  "The arccosine of `x` in radians. `x` must be in [-1, 1]; raises otherwise."
  (%acos x))
(sig acos (number -> float))
(defn atan (x) "The arctangent of `x` in radians (result in [-π/2, π/2])." (%atan x))
(sig atan (number -> float))
(defn atan2 (y x)
  "The angle in radians of the vector (`x`, `y`) from the positive x-axis, in (-π, π]. Handles x=0.

    (math/atan2 0 1)      → 0.0"
  (%atan2 y x))
(sig atan2 (number number -> float))
(defn exp (x)
  "e raised to the power `x`. Returns a float.

    (math/exp 0)          → 1.0"
  (%exp x))
(sig exp (number -> float))
(defn ln (x)
  "The natural logarithm of `x`. `x` must be positive; raises otherwise.

    (math/ln 1)           → 0.0"
  (%ln x))
(sig ln (number -> float))
(defn log2 (x) "The base-2 logarithm of `x`. `x` must be positive; raises otherwise." (%log2 x))
(sig log2 (number -> float))
(defn log10 (x) "The base-10 logarithm of `x`. `x` must be positive; raises otherwise." (%log10 x))
(sig log10 (number -> float))
