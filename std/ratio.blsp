(defmodule ratio
  "Exact rational numbers — a Brood-first prototype (ADR-070 / the freeze-list
`ratios` row).

Construct with `(rational num den)`; the value is kept **reduced** (gcd 1) with a
**positive denominator**. Ratios do arithmetic through `+`/`-`/`*`/`/` (the `Num`
ability), order through `<`/`<=`/`sort` (`Ord`/`compare-to`), and print as
`num/den` (`Display`). Mixed ratio+int arithmetic and comparison work.

**Prototype limits** — the properties that need a kernel `Value::Ratio`, which this
exists to justify (ADR-169 reserved the `1/2` token for exactly that): there is no
`1/2` reader literal (call `rational`), a ratio and an *equal* integer are **not**
`=` (a ratio is a distinct record, compared structurally), and `pr-str` shows the
underlying map rather than round-tripping. Use `to-str`/`println` for the `num/den`
form and `ratio->float` for an inexact value.")

;; A ratio is a record {:num :den}; ALWAYS built through `ratio--norm`, never the raw
;; positional `ratio` constructor, so the reduced / positive-denominator invariant
;; holds (and two equal ratios are structurally `=`, hash equal, sort together).
(defrecord ratio (num den))

(defn ratio--gcd (a b)
  "Greatest common divisor of non-negative ints `a` and `b` (Euclid, tail-recursive)."
  (if (= b 0) a (ratio--gcd b (mod a b))))

(defn ratio--norm (n d)
  "Build the reduced ratio `n`/`d`: sign carried on the numerator, positive
denominator, divided out by the gcd. Errors when `d` is 0."
  (if (= d 0)
    (error "rational: denominator is zero: " n "/" d)
    (let (s (if (< d 0) -1 1)
          n (* s n)
          d (* s d)
          g (ratio--gcd (abs n) d))
      (ratio (quot n g) (quot d g)))))

(defn ratio--sign (x) "-1, 0, or 1 by the sign of int `x`." (cond (< x 0) -1 (> x 0) 1 else 0))

(defn rational (n d)
  "An exact rational `n`/`d`, kept reduced with a positive denominator.
`(rational 4 2)` is `2/1`; `(rational 1 -2)` is `-1/2`. Errors when `d` is 0."
  (ratio--norm n d))

(defn ratio? (x)
  "True when `x` is a ratio value (built by `rational`)."
  (and (record? x) (= (record-id x) :ratio/ratio)))

(defn ratio->float (r)
  "The ratio `r` as an (inexact) float — `(rational 1 2)` → `0.5`."
  (/ (ratio-num r) (ratio-den r)))

;; ── Num: +/-/*// on ratios (and ratio↔int), via multimethods (ADR-179). `+`/`*`
;; are `:commutative`, so the `[:int ratio]` mirror is derived; `-`/`/` are not, so
;; both directions are written. All results go through `ratio--norm` to stay reduced.
(defmethod num-add [ratio ratio] (a b)
  (ratio--norm (+ (* (ratio-num a) (ratio-den b)) (* (ratio-num b) (ratio-den a)))
    (* (ratio-den a) (ratio-den b))))
(defmethod num-add [ratio :int] (r n)
  (ratio--norm (+ (ratio-num r) (* n (ratio-den r))) (ratio-den r)))

(defmethod num-sub [ratio ratio] (a b)
  (ratio--norm (- (* (ratio-num a) (ratio-den b)) (* (ratio-num b) (ratio-den a)))
    (* (ratio-den a) (ratio-den b))))
(defmethod num-sub [ratio :int] (r n)
  (ratio--norm (- (ratio-num r) (* n (ratio-den r))) (ratio-den r)))
(defmethod num-sub [:int ratio] (n r)
  (ratio--norm (- (* n (ratio-den r)) (ratio-num r)) (ratio-den r)))

(defmethod num-mul [ratio ratio] (a b)
  (ratio--norm (* (ratio-num a) (ratio-num b)) (* (ratio-den a) (ratio-den b))))
(defmethod num-mul [ratio :int] (r n)
  (ratio--norm (* (ratio-num r) n) (ratio-den r)))

(defmethod num-div [ratio ratio] (a b)
  (ratio--norm (* (ratio-num a) (ratio-den b)) (* (ratio-den a) (ratio-num b))))
(defmethod num-div [ratio :int] (r n)
  (ratio--norm (ratio-num r) (* (ratio-den r) n)))
(defmethod num-div [:int ratio] (n r)
  (ratio--norm (* n (ratio-den r)) (ratio-num r)))

;; ── Ord: </<=/>/>= and sort via compare-to (ADR-179, `:antisymmetric` — the
;; `[:int ratio]` mirror is derived). Both denominators are positive, so cross-
;; multiplying preserves the ordering.
(defmethod compare-to [ratio ratio] (a b)
  (ratio--sign (- (* (ratio-num a) (ratio-den b)) (* (ratio-num b) (ratio-den a)))))
(defmethod compare-to [ratio :int] (r n)
  (ratio--sign (- (ratio-num r) (* n (ratio-den r)))))

;; ── Display: print as `num/den`.
(impl Display ratio (to-str [r] (str (ratio-num r) "/" (ratio-den r))))
