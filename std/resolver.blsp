;; std/resolver.blsp — the dependency version resolver (ADR-209). Given the direct
;; dependencies a project declares and a way to ask "what versions of X exist?" and
;; "what does X@v depend on?", pick ONE concrete version for every package in the
;; transitive graph so that every version constraint holds — or explain why none can.
;;
;; The whole module is a PURE function of its inputs. It never touches the network,
;; the filesystem, or a registry: those live behind a `provider` (two closures —
;; `versions` and `deps`), so the search is driven entirely by data the caller
;; supplies. That is what makes it exhaustively testable offline
;; (tests/resolver_test.blsp), and it is why the version *predicates* live in
;; std/version.blsp while version *selection* lives here.
;;
;; Strategy: PubGrub (the Dart-pub algorithm, ADR-209) over a FINITE version domain.
;; Rather than blind backtracking, it reasons with INCOMPATIBILITIES — sets of package
;; terms that cannot all hold at once. Unit propagation drives forced choices (so a
;; package a later requirer pins is decided before a free guess commits it wrongly), and
;; on a conflict it derives the ROOT CAUSE by resolution and BACKJUMPS straight to the
;; decision that caused it, learning that cause so the dead end is never re-explored. The
;; effect: tangled-but-solvable graphs resolve without exponential search, and an
;; unsolvable one yields a derivation — "because A needs X and B needs Y, no version fits".
;;
;; Finite domain: each package's universe is its available versions, so a "version set"
;; is a subset of that list and the set algebra is plain list operations — no interval or
;; successor math. Newest-compatible selection: a free decision takes the newest version
;; still allowed (or a `preferred`/locked one first).

(defmodule resolver
  "The dependency version resolver (ADR-209), a PubGrub solver. `(resolve roots provider)`
picks one version per package across the transitive graph, or reports a derivation of why
none fits. `roots` is a list of `[name constraint]` (constraint a `std/version` string, or
nil/\"\" = any); `provider` (see `make-provider`) answers what versions exist and what each
release requires. Pure — no I/O; the registry provider that fetches for real lives in
`std/tool/package`. `(require 'resolver)`.")

(require 'version)

;; --- the provider: the resolver's only window onto the package universe ----------
;; Two closures. `versions-fn`: name → the list of version strings that exist for it.
;; `deps-fn`: name, version → the `[dep-name constraint]` requirements of that release.
;; Both are pure from the resolver's view; a real one hits a registry (and caches),
;; a test one is a literal table.

(defn make-provider (versions-fn deps-fn)
  "A provider the resolver queries: `versions-fn` maps a package name to the list of
version strings that exist for it; `deps-fn` maps a name + a version to that release's
`[dep-name constraint]` requirements."
  {:versions versions-fn :deps deps-fn})

(defn provider-versions (provider name)
  "The version strings `provider` knows for `name` (possibly empty/nil)."
  ((get provider :versions) name))

(defn provider-deps (provider name version)
  "The `[dep-name constraint]` requirements of `name` at `version`, per `provider`."
  ((get provider :deps) name version))

;; --- budget: a safety net, not the search's crutch -------------------------------
;; PubGrub does not backtrack exponentially, so on a well-formed graph the budget is never
;; approached. It remains as a guard against a pathological input (or a bug) hanging the
;; process. Both are dynvars so a genuinely huge workspace can raise them.
(defdyn *resolver-time-budget-ms* 10000)
(defdyn *resolver-max-steps* 2000000)

(defn resolver--tick (ctx)
  (let (steps (get ctx :steps)
        n (+ 1 (table-get steps :n 0)))
    (table-put steps :n n)
    (when (and (= 0 (rem n 256))
            (> (- (now) (table-get steps :start 0)) *resolver-time-budget-ms*))
      (resolver--budget-exceeded (str "did not finish within " *resolver-time-budget-ms* " ms")))
    (when (> n *resolver-max-steps*)
      (resolver--budget-exceeded (str "exceeded " *resolver-max-steps* " search steps")))))

(defn resolver--budget-exceeded (why)
  (throw {:resolver-budget-exceeded true
          :message (str "dependency resolution "
                     why " — the version constraints are too tangled to resolve within the budget."
                     " Pin the conflicting dependencies explicitly, or relax a range.")}))

;; --- finite version sets (subsets of a package's universe) -----------------------
;; A "version set" for a package is a list of version strings drawn from its universe (its
;; available versions), kept in the universe's newest-first order. Every set is a sublist of
;; the universe, so the algebra is membership + filtering.

;; A virtual ROOT package, always decided at a single virtual version, so the project's own
;; requirements become ordinary dependency incompatibilities `{root: {v0}, P: not-R}`. Without
;; it a permissive root requirement (`P` at any version) would encode to a vacuous
;; incompatibility and never force `P` to be selected. A keyword, so it can never collide with
;; a real (symbol) package name; excluded from the returned solution.
(def pg-root-pkg :%pubgrub-root)
(def pg-root-version "0")

;; NONE — the "not selected" member every real package's universe carries. It is what lets a
;; dependency FORCE selection: "P requires Q in R" forbids Q from `complement(R)`, and NONE is
;; in that complement, so choosing P narrows Q to real versions in R (never NONE). A package
;; nothing requires keeps NONE and is simply left out of the solution. Without it, a
;; permissive requirement ("Q at any version") would complement to the empty set and select
;; nothing. Kept LAST in the universe so `pg-pick-version` never prefers "not selected".
(def pg-none :%none)

(defn pg-universe (ctx pkg)
  "The package's available versions newest-first, plus the NONE sentinel; memoized."
  (if (= pkg pg-root-pkg)
    (list pg-root-version)
    (pg-universe--fetch ctx pkg)))

(defn pg-universe--fetch (ctx pkg)
  (let (cache (get ctx :universes)
        hit (table-get cache pkg :miss))
    (if (= hit :miss)
      (let (versions (append (sort (fn (a b) (> (version/version-compare a b) 0))
                               (or (provider-versions (get ctx :provider) pkg) nil))
                       (list pg-none)))
        (table-put cache pkg versions)
        versions)
      hit)))

(defn pg-set-matching (ctx pkg constraint)
  "The subset of `pkg`'s REAL versions matching `constraint` (a version string; nil/\"\" =
all). NONE never matches — a version constraint is about a selected version."
  (let (compiled (version/version-compile constraint))
    (filter (fn (v) (and (not (= v pg-none)) (version/version-match? compiled v)))
      (pg-universe ctx pkg))))

(defn pg-intersect (a b) (filter (fn (v) (includes? b v)) a))
(defn pg-subset? (a b) (every? (fn (v) (includes? b v)) a))
(defn pg-disjoint? (a b) (not (any? (fn (v) (includes? b v)) a)))
(defn pg-complement (ctx pkg s) (filter (fn (v) (not (includes? s v))) (pg-universe ctx pkg)))
(defn pg-empty? (s) (empty? s))

;; --- incompatibilities -----------------------------------------------------------
;; An INCOMPATIBILITY is a set of terms (at most one per package) that cannot all hold at
;; once: `{:terms {pkg -> set} :cause cause}`. A term `[pkg set]` asserts "pkg's version is
;; in set". `cause` is `[:root name constraint]`, `[:dep pkg ver depname depconstraint]`, or
;; `[:derived a b]` (the resolvent of two incompatibilities during conflict resolution) —
;; kept so a failure can render the derivation that proves no solution exists.

(defn pg-ic (terms cause) {:terms terms :cause cause})

;; The incompatibilities a package's release contributes: for each dep `[Q R]`, "P=V and Q
;; outside R is forbidden" — i.e. choosing P=V forces Q into R.
(defn pg-dep-ics (ctx pkg version)
  (map
    (fn (dep)
      (let (dep-name (nth dep 0)
            dep-constraint (nth dep 1)
            forbidden (pg-complement ctx dep-name (pg-set-matching ctx dep-name dep-constraint))
            ;; a self-dependency puts two terms on the SAME package — intersect them into
            ;; one (`P=v` and `P∉R` both hold only where `{v} ∩ complement(R)`), so a map
            ;; key doesn't silently drop one. If `v` satisfies its own constraint the term
            ;; is empty and the incompatibility is vacuous, which is exactly "self-dep is fine".
            terms (if (= dep-name pkg)
                    {pkg (pg-intersect (list version) forbidden)}
                    {pkg (list version) dep-name forbidden}))
        (pg-ic terms [:dep pkg version dep-name dep-constraint])))
    (or (provider-deps (get ctx :provider) pkg version) nil)))

;; The root requirements as incompatibilities: "root is chosen AND P is outside R" is
;; forbidden — so once the (always-decided) root is in, P must land in R. Binary, exactly a
;; dependency of the virtual root, which is what makes even a permissive requirement select P.
(defn pg-root-ics (ctx roots)
  (map (fn (r)
         (let (pkg (nth r 0) constraint (nth r 1))
           (pg-ic {pg-root-pkg (list pg-root-version)
                   pkg (pg-complement ctx pkg (pg-set-matching ctx pkg constraint))}
             [:root pkg constraint])))
    roots))

;; --- the partial solution --------------------------------------------------------
;; An ordered list of ASSIGNMENTS (newest first) plus the derived state. A DECISION fixes a
;; package to a version at a new decision level; a DERIVATION narrows a package to a term,
;; caused by an incompatibility, at the current level. `pos` is each package's accumulated
;; set (intersection of its assignments); `decs` the decided versions; `level` the current
;; decision level (0 before any decision).

;; `:pending` is the work-list of required-but-undecided packages, maintained incrementally
;; (enqueued the first time a package is constrained, popped when decided) so choosing the next
;; package is not an O(n) scan of every constrained package each step.
(defn pg-state () {:assigns nil :pos {} :decs {} :level 0 :pending nil})

(defn pg-pos (state ctx pkg)
  ;; the package's currently-allowed set — its accumulated term, or its whole universe if
  ;; nothing has constrained it yet.
  (let (p (get (get state :pos) pkg :none))
    (if (= p :none) (pg-universe ctx pkg) p)))

(defn pg-derive (state ctx pkg s cause)
  (let (narrowed (pg-intersect (pg-pos state ctx pkg) s)
        newly-required (not (contains? (get state :pos) pkg)))
    (assoc state
      :assigns
        (cons {:dec false :pkg pkg :set s :level (get state :level) :cause cause}
          (get state :assigns))
      :pos (assoc (get state :pos) pkg narrowed)
      :pending (if newly-required (cons pkg (get state :pending)) (get state :pending)))))

(defn pg-decide (state ctx pkg version)
  (let (level (+ 1 (get state :level)))
    (assoc state
      :level level
      :assigns
        (cons {:dec true :pkg pkg :set (list version) :level level :ver version}
          (get state :assigns))
      :pos (assoc (get state :pos) pkg (list version))
      :decs (assoc (get state :decs) pkg version))))

;; Drop every assignment above `level`, then rebuild `pos`/`decs` from what remains — the
;; backjump. `assigns` is newest-first, so kept assignments keep their order.
(defn pg-backtrack (state level)
  (let (kept (filter (fn (a) (<= (get a :level) level)) (get state :assigns))
        pos (fold (fn (m a)
                    (assoc m
                      (get a :pkg) (pg-intersect (get m (get a :pkg) (get a :set)) (get a :set))))
              {}
              (reverse kept))
        decs (fold (fn (m a) (if (get a :dec) (assoc m (get a :pkg) (get a :ver)) m))
               {}
               (reverse kept)))
    {:assigns kept
     :level level
     :pos pos
     :decs decs
     ;; every constrained-but-undecided package is required again after the backjump.
     :pending (keep (fn (pkg) (when (not (contains? decs pkg)) pkg)) (keys pos))}))

;; --- term / incompatibility relations --------------------------------------------

(defn pg-term-rel (state ctx pkg s)
  ;; how the partial solution's set for `pkg` relates to term set `s`.
  (let (p (pg-pos state ctx pkg))
    (cond
      (pg-subset? p s) :satisfied
      (pg-disjoint? p s) :contradicted
      else :inconclusive)))

(defn pg-ic-rel (state ctx ic)
  ;; :satisfied (all terms hold → conflict), :contradicted (some term can't hold → moot),
  ;; [:almost pkg] (all but one hold; that one is the unit), or :inconclusive.
  (pg-ic-rel--go state ctx (map-pairs (get ic :terms)) :none))

(defn pg-ic-rel--go (state ctx terms unresolved)
  (cond
    (empty? terms) (if (= unresolved :none) :satisfied [:almost unresolved])
    else
      (let (kv (first terms)
            rel (pg-term-rel state ctx (nth kv 0) (nth kv 1)))
        (cond
          (= rel :contradicted) :contradicted
          (= rel :satisfied) (pg-ic-rel--go state ctx (rest terms) unresolved)
          ;; inconclusive: the first is the unit candidate; a second makes it inconclusive
          (= unresolved :none) (pg-ic-rel--go state ctx (rest terms) (nth kv 0))
          else :inconclusive))))

;; The incompatibilities are held INDEXED by package (name → list of ics mentioning it), so
;; propagating a just-changed package scans only the incompatibilities that can involve it —
;; not the whole growing set. Without this, a 300-package solve is quadratic in the number of
;; dependencies; with it, propagation is proportional to what actually touches each package.
(defn pg-index-add (index ics)
  (fold (fn (idx ic)
          (fold (fn (i pkg) (assoc i pkg (cons ic (get i pkg nil))))
            idx
            (keys (get ic :terms))))
    index ics))

;; --- unit propagation ------------------------------------------------------------
;; Given the incompatibilities that mention a just-changed package, derive every forced
;; consequence. `:satisfied` is a conflict (returned for resolution); an `:almost` gives a
;; unit — the loose term's package must AVOID that term, so we derive its complement.

(defn pg-propagate (state ctx index changed)
  (pg-propagate--changed state ctx index (list changed)))

(defn pg-propagate--changed (state ctx index changed)
  (if (empty? changed)
    [:ok state]
    (let (pkg (first changed))
      (match (pg-propagate--pkg state ctx index pkg (rest changed))
        ;; carry the state AT the conflict — it holds the derivations that made the
        ;; incompatibility satisfied, which conflict resolution must replay.
        ([:conflict ic conflict-state] [:conflict ic conflict-state])
        ([:ok state2 changed2] (pg-propagate--changed state2 ctx index changed2))))))

(defn pg-propagate--pkg (state ctx index pkg changed)
  ;; scan only the incompatibilities that mention `pkg`; derive units, surface a conflict.
  (fold-until (fn (acc ic)
                (let (state2 (nth acc 0) changed2 (nth acc 1))
                  (match (pg-ic-rel state2 ctx ic)
                    (:satisfied [:done [:conflict ic state2]])
                    ([:almost unit-pkg] (let (term (get (get ic :terms) unit-pkg)
                                              state3 (pg-derive state2
                                                       ctx
                                                       unit-pkg
                                                       (pg-complement ctx unit-pkg term)
                                                       ic))
                                          [:cont [state3 (cons unit-pkg changed2)]]))
                    (_ [:cont [state2 changed2]]))))
    [state changed]
    (get index pkg nil)))

;; fold-until: fold `f` over `items`, threading `acc`; `f` returns [:cont acc'] to continue
;; or [:done result] to stop early. Ends `[:ok acc changed]`-shaped for propagate's caller.
(defn fold-until (f acc items)
  (cond
    (empty? items) [:ok (nth acc 0) (nth acc 1)]
    else
      (match (f acc (first items))
        ([:done result] result)
        ([:cont acc2] (fold-until f acc2 (rest items))))))

;; --- conflict resolution (CDCL): derive the root cause and backjump --------------
;; Given a satisfied incompatibility, walk the partial solution back: find the assignment
;; that completed the conflict (the "satisfier"); if it is a decision, or an earlier level
;; already sufficed, BACKJUMP there and learn this incompatibility (so the dead end never
;; recurs). Otherwise the satisfier is itself a derivation — RESOLVE this incompatibility
;; with the one that caused it (union the other terms, drop the shared package) and repeat.
;; Terminates in a solvable-from-here backjump, or in a proof of no-solution.

(defn pg-conflict-resolution (state ctx ics ic)
  (resolver--tick ctx)
  (let (chrono (reverse (get state :assigns)) ; oldest-first
        satisfier-idx (pg-satisfier-index state ctx ic chrono)
        satisfier (nth chrono satisfier-idx)
        previous-level (pg-previous-satisfier-level state ctx ic chrono satisfier-idx satisfier))
    (cond
      ;; The conflict traces all the way back to the always-decided root: no solution. We keep
      ;; resolving until the incompatibility reduces to just the root term, so the FAILING one
      ;; carries the full derivation (every requirer that contributed), not a single leaf.
      (= (get satisfier :pkg) pg-root-pkg) [:fail ic]
      (or (get satisfier :dec) (< previous-level (get satisfier :level)))
        [:backjump (pg-backtrack state previous-level) ic]
      else
        (pg-conflict-resolution state
          ctx
          ics
          (pg-resolvent ctx ic (get satisfier :cause) (get satisfier :pkg) (get satisfier :set))))))

;; The earliest assignment (index into oldest-first `chrono`) after which `ic` is satisfied.
;; The full partial solution satisfies `ic` (it was a conflict), so a satisfier always
;; exists; running off the end signals a resolvent bug rather than looping forever.
(defn pg-satisfier-index (state ctx ic chrono)
  (pg-first-index-satisfying ctx ic chrono 0 (pg-state) (count chrono)))

(defn pg-first-index-satisfying (ctx ic chrono i acc limit)
  (when (>= i limit)
    (throw {:resolver-budget-exceeded true
            :message "dependency resolution hit an internal inconsistency (no satisfier)"}))
  (let (acc2 (pg-apply ctx acc (nth chrono i)))
    (if (= :satisfied (pg-ic-rel acc2 ctx ic))
      i
      (pg-first-index-satisfying ctx ic chrono (+ i 1) acc2 limit))))

;; The decision level to backjump to: the earliest assignment before the satisfier such that
;; that prefix PLUS the satisfier already satisfies `ic` (1 — the root floor — if the
;; satisfier alone does it). This is the level where the conflict became inevitable.
(defn pg-previous-satisfier-level (state ctx ic chrono satisfier-idx satisfier)
  (pg-prev-level--go ctx ic chrono satisfier-idx satisfier 0 (pg-state)))

(defn pg-prev-level--go (ctx ic chrono satisfier-idx satisfier j acc)
  (if (>= j satisfier-idx)
    0 ; only the satisfier matters → root floor (level 0)
    (let (acc2 (pg-apply ctx acc (nth chrono j))
          with-satisfier (pg-apply ctx acc2 satisfier))
      (if (= :satisfied (pg-ic-rel with-satisfier ctx ic))
        (max 0 (get (nth chrono j) :level))
        (pg-prev-level--go ctx ic chrono satisfier-idx satisfier (+ j 1) acc2)))))

;; Replay one assignment onto a scratch state (for the satisfier search) — like pg-derive/
;; pg-decide but without recording history, just updating `pos`.
(defn pg-apply (ctx state a)
  (assoc state
    :pos
      (assoc (get state :pos)
        (get a :pkg) (pg-intersect (pg-pos state ctx (get a :pkg)) (get a :set)))))

;; The resolvent of two incompatibilities over their shared package `pkg`: union every OTHER
;; package's terms (intersection within a universe — both must hold), and drop `pkg` (the two
;; sides constrain it oppositely, so it cancels).
(defn pg-resolvent (ctx ic cause pkg satisfier-set)
  (let (ic-pkg-set (or (get (get ic :terms) pkg) nil)
        ;; the part of the satisfier's own term that reaches OUTSIDE the conflict's term for
        ;; this package: if empty, the satisfier fully explains it and the package cancels;
        ;; otherwise the complement of that difference stays in the resolvent (pub's
        ;; `difference.inverse`), so the learned incompatibility is not weakened.
        difference (filter (fn (v) (not (includes? ic-pkg-set v))) satisfier-set)
        others (fold (fn (terms kv)
                       (let (p (nth kv 0) s (nth kv 1))
                         (if (= p pkg)
                           terms
                           (assoc terms
                             p (if (contains? terms p)
                                 (pg-intersect (get terms p) s)
                                 s)))))
                 (dissoc (get ic :terms) pkg)
                 (map-pairs (get cause :terms)))
        merged (if (empty? difference)
                 others
                 (assoc others pkg (pg-complement ctx pkg difference))))
    (pg-ic merged [:derived ic cause])))

;; --- decision making + the main loop ---------------------------------------------

(defn resolve (roots provider &optional preferred)
  "Resolve `roots` (a list of `[name constraint]`) against `provider` into a concrete
version per package. Returns `[:ok solution]` — `solution` a map of name → version string
covering every package in the transitive graph — or `[:error message]`, a derivation of why
no version set fits. Pure: all fetching is the provider's. `preferred` (optional, a name →
version map, e.g. the prior lock) is chosen first for each package when it still fits, so a
re-solve keeps existing pins instead of upgrading the whole graph to newest."
  (let (ctx {:provider provider
             :preferred (or preferred {})
             :universes (table)
             :steps (table)})
    (table-put (get ctx :steps) :start (now))
    (try
      (let (root-ics (pg-root-ics ctx roots)
            ;; Seed the virtual root as a level-0 decision, then propagate from it: every
            ;; root incompatibility mentions it, so this derives each required package.
            seeded {:assigns (list {:dec true
                                    :pkg pg-root-pkg
                                    :set (list pg-root-version)
                                    :level 0
                                    :ver pg-root-version})
                    :pos {pg-root-pkg (list pg-root-version)}
                    :decs {pg-root-pkg pg-root-version}
                    :level 0
                    :pending nil}
            result (pg-solve ctx (pg-index-add {} root-ics) seeded (list pg-root-pkg)))
        (pg-cleanup ctx)
        (match result
          ([:ok decs] [:ok (dissoc decs pg-root-pkg)])
          (other other)))
      (catch e
        (pg-cleanup ctx)
        (if (and (map? e) (get e :resolver-budget-exceeded))
          [:error (get e :message)]
          (throw e))))))

(defn pg-cleanup (ctx) (table-drop (get ctx :universes)) (table-drop (get ctx :steps)))

;; The PubGrub main loop. `ics` is the growing incompatibility set; `state` the partial
;; solution; `known` the packages discovered so far (to decide over). Propagate from the
;; last-changed package; on a conflict, resolve+backjump and learn the cause; when quiet,
;; make the next decision (whose deps add incompatibilities and reveal new packages).
(defn pg-solve (ctx index state changed-list)
  (resolver--tick ctx)
  (match (pg-propagate-list state ctx index changed-list)
    ([:conflict ic conflict-state]
      ;; resolve against the state AT the conflict (with the derivations that caused it),
      ;; not the pre-propagation state — otherwise the satisfier search cannot find them.
      (match (pg-conflict-resolution conflict-state ctx index ic)
        ([:fail cause] [:error (pg-error ctx cause)])
        ([:backjump state2 learned]
          ;; the learned incompatibility is now a unit at the backjump level; index + propagate
          ;; it and continue from the package it constrains.
          (pg-solve ctx (pg-index-add index (list learned)) state2 (keys (get learned :terms))))))
    ([:ok state2] (match (pg-next-decision state2 ctx index)
                    (:done [:ok (get state2 :decs)])
                    ([:decide pkg version dep-ics discovered popped] (pg-solve ctx
                                                                       (pg-index-add index dep-ics)
                                                                       (pg-decide popped
                                                                         ctx pkg version)
                                                                       discovered))
                    ([:no-versions pkg] [:error (pg-no-versions-msg state2 ctx index pkg)])))))

(defn pg-propagate-list (state ctx index changed-list)
  (if (empty? changed-list)
    [:ok state]
    (match (pg-propagate state ctx index (first changed-list))
      ([:conflict ic conflict-state] [:conflict ic conflict-state])
      ([:ok state2] (pg-propagate-list state2 ctx index (rest changed-list))))))

;; Choose the next package to decide: one that is required (has a narrowed positive set) but
;; not yet decided. Fewest allowed versions first (fail-fast). Return the decision + the
;; incompatibilities its chosen version introduces + the packages it reveals; or :done when
;; everything required is decided; or [:no-versions pkg] when a required package's set is empty.
(defn pg-next-decision (state ctx index)
  ;; pop the next undecided package off the work-list (skipping any that a decision has since
  ;; covered). Returns the popped state so the decision is threaded on top of it.
  (cond
    (empty? (get state :pending)) :done
    (contains? (get state :decs) (first (get state :pending)))
      (pg-next-decision (assoc state :pending (rest (get state :pending))) ctx index)
    else
      (let (pkg (first (get state :pending))
            popped (assoc state :pending (rest (get state :pending)))
            allowed (pg-pos state ctx pkg))
        (if (pg-empty? allowed)
          [:no-versions pkg]
          (let (version (pg-pick-version ctx pkg allowed)
                dep-ics (pg-dep-ics ctx pkg version)
                discovered (keys (fold (fn (m ic)
                                         (fold (fn (mm k) (assoc mm k true))
                                           m
                                           (keys (get ic :terms))))
                                   {}
                                   dep-ics)))
            [:decide pkg version dep-ics discovered popped])))))

;; Newest allowed version, unless a `preferred` (locked) version is still allowed — then that,
;; keeping a re-solve stable. `allowed` is already newest-first.
(defn pg-pick-version (ctx pkg allowed)
  (let (pin (get (get ctx :preferred) pkg))
    (if (and pin (includes? allowed pin)) pin (first allowed))))

(defn pg-min-by (f items)
  (fold (fn (best x) (if (< (f x) (f best)) x best)) (first items) (rest items)))

;; --- error rendering: the derivation (pub-style structured proof) ----------------
;; The failing incompatibility's CAUSE is a left-leaning tree of resolution steps —
;; `[:derived accumulated satisfier-cause]`, deepest-left being the original conflict — whose
;; LEAVES are the original facts (`[:root …]`, `[:dep …]`). Rather than dump every leaf flat,
;; we render the tree as pub's derivation report: a chain of "Because <premise> and <premise>,
;; <consequence>." lines that expands a derived premise on its own line(s) first and states
;; each step's consequence, so the reader follows the reasoning down to "version solving
;; failed". The packages named are then listed with what they actually offer.
(defn pg-error (ctx ic)
  (let (lines (pg-report ctx ic)
        leaves (pg-cause-leaves (get ic :cause) nil))
    (str "dependency resolution failed:\n"
      (join "\n" (map (fn (l) (str "  " l)) lines))
      (pg-availability-lines ctx leaves))))

;; Whether a cause / incompatibility is an original fact (a leaf) rather than a [:derived …]
;; resolution step.
(defn pg-cause-external? (cause) (match cause ([:derived _ _] false) (_ true)))
(defn pg-ic-external? (ic) (pg-cause-external? (get ic :cause)))

;; A package's REAL versions (never NONE) an incompatibility term ALLOWS — the complement of
;; its forbidden set — for phrasing a step's consequence.
(defn pg-term-allows (ctx pkg forbidden)
  (filter (fn (v) (not (= v pg-none))) (pg-complement ctx pkg forbidden)))

;; The fact a derived incompatibility establishes going forward, phrased for prose. An
;; incompatibility forbids all its terms holding at once; dropping the (always-true) root term,
;; if what remains pins a single package we say what it must — or cannot — be, and an empty
;; remainder is the final contradiction ("version solving failed").
(defn pg-consequence-str (ctx ic)
  (let (reals (filter (fn (kv) (not (= (nth kv 0) pg-root-pkg))) (map-pairs (get ic :terms))))
    (cond
      (empty? reals) "version solving failed"
      (= 1 (count reals))
        (let (kv (first reals)
              pkg (nth kv 0)
              allowed (pg-term-allows ctx pkg (nth kv 1)))
          (if (empty? allowed)
            (str "no version of " (name pkg) " satisfies every requirement on it")
            (str (name pkg) " must be " (join " or " allowed))))
      else
        (str "the requirements on "
          (join " and " (map (fn (kv) (name (nth kv 0))) reals))
          " cannot all hold"))))

;; One premise's rendering: an external cause is its plain fact; a derived cause is stated by
;; its consequence (its own supporting lines are emitted before it is referenced).
(defn pg-premise-str (ctx ic)
  (if (pg-ic-external? ic) (pg-explain-leaf (get ic :cause)) (pg-consequence-str ctx ic)))

;; Walk the derivation into ordered lines: a post-order over the `[:derived]` nodes so a step's
;; supporting lines precede the line that uses them. An external premise is inlined into its
;; parent's line and never gets a line of its own, so only derived nodes emit. An explicit
;; worklist keeps the walk tail-recursive — the spine can be as deep as the resolution-step
;; count, so plain recursion could overflow on a large tangled graph. The deepest
;; (both-premises-external) step opens with "Because"; steps layered on it continue "And
;; because", and a step over two derived premises reads "Thus".
(defn pg-report (ctx ic) (pg-report--drive ctx (list [:visit ic]) nil))

(defn pg-report--drive (ctx work acc)
  (if (empty? work)
    (reverse acc)
    (let (item (first work)
          more (rest work))
      (match item
        ([:emit ic] (pg-report--drive ctx more (cons (pg-report--line ctx ic) acc)))
        ([:visit ic]
          (match (get ic :cause)
            ;; push the emit last so it pops after both premises' lines; visit the
            ;; left (deep) spine before the right, and only descend derived premises.
            ([:derived a b] (pg-report--drive ctx
                              (append (if (pg-ic-external? a) nil (list [:visit a]))
                                (append (if (pg-ic-external? b) nil (list [:visit b]))
                                  (cons [:emit ic] more)))
                              acc))
            ;; a bare leaf as the whole "derivation" (degenerate): emit its fact.
            (leaf (pg-report--drive ctx more (cons (pg-explain-leaf leaf) acc)))))))))

;; The one line a derived step contributes, inlining any external premise as its plain fact.
(defn pg-report--line (ctx ic)
  (match (get ic :cause)
    ([:derived a b] (let (a-ext (pg-ic-external? a)
                          b-ext (pg-ic-external? b)
                          conseq (pg-consequence-str ctx ic))
                      (cond
                        (and a-ext b-ext)
                          (str "Because "
                            (pg-premise-str ctx a)
                            " and "
                            (pg-premise-str ctx b)
                            ", "
                            conseq
                            ".")
                        a-ext (str "And because " (pg-premise-str ctx a) ", " conseq ".")
                        b-ext (str "And because " (pg-premise-str ctx b) ", " conseq ".")
                        else (str "Thus, " conseq "."))))
    (_ "")))

(defn pg-cause-leaves (cause acc)
  ;; distinct leaves of the derivation tree, in first-seen (left-to-right) order.
  ;; An explicit worklist keeps this tail-recursive, so a deep derivation (up to
  ;; one level per resolution step on a large tangled graph) can't overflow.
  (pg-cause-leaves--loop (list cause) acc))

(defn pg-cause-leaves--loop (stack acc)
  (if (empty? stack)
    acc
    (let (cause (first stack)
          more (rest stack))
      (match cause
        ;; push the left cause on top so its leaves are visited before the right's.
        ([:derived a b] (pg-cause-leaves--loop (cons (get a :cause) (cons (get b :cause) more))
                          acc))
        (leaf (pg-cause-leaves--loop more
                (if (includes? acc leaf) acc (append acc (list leaf)))))))))

(defn pg-explain-leaf (leaf)
  (match leaf
    ([:root pkg constraint] (str "your project requires "
                              (name pkg)
                              " "
                              (resolver--constraint-str constraint)))
    ([:dep pkg version dep-name dep-constraint] (str (name pkg)
                                                  " "
                                                  version
                                                  " requires "
                                                  (name dep-name)
                                                  " "
                                                  (resolver--constraint-str dep-constraint)))))

(defn pg-leaf-packages (leaf)
  (match leaf
    ([:root pkg _] (list pkg))
    ([:dep pkg _ dep-name _] (list pkg dep-name))))

(defn pg-availability-lines (ctx leaves)
  (let (pkgs (distinct (apply append (map pg-leaf-packages leaves))))
    (apply str
      (map (fn (pkg)
             (let (real (filter (fn (v) (not (= v pg-none))) (pg-universe ctx pkg)))
               (str "\n  "
                 (name pkg)
                 (if (empty? real)
                   " has no versions available"
                   (str " available: " (join ", " real))))))
        pkgs))))

(defn pg-no-versions-msg (state ctx ics pkg)
  (let (universe (pg-universe ctx pkg))
    (if (empty? universe)
      (str "dependency resolution failed:\n  no versions of " (name pkg) " are available")
      (str "dependency resolution failed:\n  no version of "
        (name pkg)
        " satisfies every requirement (available: "
        (join ", " universe)
        ")"))))

(defn resolver--constraint-str (c)
  (if (or (nil? c) (= c "")) "(any version)" c))
