;; std/proc/gen.blsp — the server process framework.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - Messages ride internal envelopes — [:$cast …] / [:$call from ref …] — so the
;;    receive loop can tell a cast from a call, and match a call to its reply by a
;;    fresh (ref) (the request/reply idiom in docs/language.md). A message that is
;;    *not* one of those envelopes (a monitor `[:down …]`, a link `[:EXIT …]`, a
;;    timer tick, a plain send) is an `info` message.
;;  - An ORDINARY module, not prelude: a framework does not get to reserve generic
;;    globals like `call`/`cast`/`stop` (ADR-243).
;;
;; A server process framework on the kernel's spawn / send / receive / ref /
;; monitor (ADR-006). A server carries one immutable state value through its receive loop
;; and handles four message kinds: CAST (fire-and-forget; body is the next state), CALL
;; (synchronous; body is [reply next-state], caller blocks), QUERY (synchronous read-only;
;; body is the reply, state unchanged), and INFO (a non-cast/call message — a monitor
;; [:down …], a link [:EXIT …], a timer tick, a raw send; body is the next state). State is
;; immutable, so a clause returns the state to carry forward; to leave it unchanged in a
;; `call`, return the state parameter. Two optional lifecycle clauses run outside the loop:
;; INIT (once at startup — the place to `(proc/trap-exit true)`/`(monitor …)`/arm a timer) and
;; TERMINATE (on a clean `(stop pid)`). An implicit `(stop pid)` ends the loop; a message
;; matched by no clause is dropped (it does not pile up in the mailbox).
;;
;;   (defserver counter (n)
;;     (init  (do (io/puts "up") n))                 ; setup; returns initial state
;;     (cast  :inc   (+ n 1))                        ; new state
;;     (call  :value [n n])                          ; reply n, state unchanged
;;     (query :double (* n 2))                       ; reply n*2; state untouched
;;     (info  [:down _ pid r] (do (log-death pid r) n))
;;     (terminate reason (io/puts "down: " reason)))
;;   (def c (gen/start counter 0))
;;   (gen/cast c :inc) (gen/call c :value) (gen/stop c)

(defmodule gen
  "The server framework: a server carries one immutable state value
through a tail-recursive `receive` loop, and `defserver` declares how it handles each
kind of message — CAST (async), CALL (sync), QUERY (sync, read-only), INFO (anything
else), plus the `init` / `terminate` / `code-change` lifecycle clauses.

    (defserver counter (n)
      (cast  :inc   (+ n 1))       ; body => next state
      (call  :value [n n])         ; body => [reply next-state]
      (query :double (* n 2)))     ; body => reply; state untouched

    (def c (gen/start counter 0))
    (gen/cast c :inc)
    (gen/call c :value)   ;; => 1
    (gen/stop c)

Names are qualified (`gen/call`, `gen/cast`, `gen/stop`, …) or bare after
`(:use gen)`. `call`/`cast`/`stop` are far too generic to own as globals, so this is
a module like any other — `(def call …)` in your own code is yours.")

;; ---- client side ------------------------------------------------------------

;; Every client function takes a pid, a kernel name, a `{:name …}` address — all of which
;; `send` routes — or a `{:via registry :key key}` address: a key in a `names` registry,
;; resolved to its live holder at each call. A key nobody holds resolves to nil: a cast,
;; stop or code-change to it is dropped, as a send to a dead pid is, and a call raises.
;;
;; The registries' directory lives HERE, not in `names`: `names` is built on `gen`, so `gen`
;; naming `names` would make each load the other first. Each registry's name maps to [its
;; pid, its table]; a module-level `def` pins this table, not the tables it points to, which
;; stay owned by their registries (ADR-418), so a dead registry's handle reads as dropped.
(def- via-directory (table/new))

(defn %via-publish (registry pid entries)
  "Point `registry`'s name at its pid and its entries table. Internal: `names`'s registry
calls it once, at its start.

    (gen/%via-publish :sessions (self) (table/new))   ;~> the directory"
  (table/put via-directory registry [pid entries]))

(defn %via-table (registry)
  "The entries table of the running registry named `registry`, or nil. Internal: what
`names`'s reads and `gen`'s `{:via …}` addresses read.

    (gen/%via-table :no-such-registry)   ;=> nil"
  (let (published (table/get via-directory registry))
    (when (and published (proc/alive? (first published))) (second published))))

;; The raw entry under `key`, or nil. The catch covers a registry that dies between
;; `%via-table`'s liveness check and the read, whose table is then dropped.
(defn %via-entry (registry key)
  "The raw entry under `key` in the running registry named `registry` — `[pid value]` for a
unique key, a map pid → value for a duplicate one — or nil. Internal, for `names`.

    (gen/%via-entry :no-such-registry :k)   ;=> nil"
  (let (entries (%via-table registry))
    (when entries
      (check-allow :discarded-catch
        (try (table/get entries key) (catch _ nil))))))

;; A kernel name resolves to its pid here too: `monitor`, which `call` needs, takes a pid or
;; a `{:name :node}` address but not a bare keyword, so `(call :logger …)` raised there.
(defn- gen-target (pid)
  (cond
    (keyword? pid) (proc/whereis pid)
    (and (map? pid) (contains? pid :via))
      (let (entry (%via-entry (get pid :via) (get pid :key)))
        (cond
          (nil? entry) nil
          (vector? entry) (when (proc/alive? (first entry)) (first entry))
          else (seq/find (keys entry) proc/alive?)))
    else pid))

(defn- gen-send (pid message)
  (let (target (gen-target pid))
    (when target (send target message))
    nil))

(defn cast (pid: (or map pid) payload:any -> nil)
  "Send `payload` to a server process as a cast — fire-and-forget, the asynchronous
counterpart to `call` (no reply, the caller never blocks).

    (gen/cast server [:put :k 1])   ;~> nil — the server handles it asynchronously"
  (gen-send pid [:$cast payload]))

(defn call (pid payload)
  "Send `payload` as a synchronous call and block up to 5 s for the reply. Monitors the
server, so a *dead* server raises at once rather than hanging; a timeout raises too. Use
`call-timeout` for a custom deadline. Other messages stay queued — the reply is matched by
a fresh (ref).

    (gen/call server :ping)   ;~> the server's reply, e.g. :pong"
  (call-timeout pid payload 5000))

(defn call-timeout (pid payload ms)
  "Like `call`, but wait at most `ms` milliseconds. Monitors the server for
the duration: a reply returns its value, the server dying raises
`call: server … died: …`, and crossing the deadline raises
`call: timed out …`, and a `{:via …}` address nobody holds raises `call: no process
holds …`. All are catchable with `try`. **Every** exit path drops the monitor,
deactivates this call's reply `ref` as a one-shot alias, and flushes anything already
queued for it — so a call that gives up leaves nothing addressed to its `ref` behind, and
nothing can arrive for it afterwards either.

The reply `ref` is a **one-shot alias**. Flushing alone only clears what is *already*
queued; a reply the server posts
strictly after the deadline would still land, unmatchable, and sit in the mailbox
forever — unbounded growth over a retry loop, plus a re-scan by every later
selective receive. `(%ref-deactivate r)` closes that: the kernel drops a message
addressed to a deactivated ref **at delivery**, so it never enters the queue at
all (ADR-244).

    (gen/call-timeout server [:get :k] 500)   ;~> the reply, or raises `call: timed out …` after 500 ms"
  (let (target (gen-target pid))
    (when (nil? target)
      (error "call: no process holds " (pr-str pid)))
    (gen-call target payload ms)))

(defn- gen-call (pid payload ms)
  (let (r (ref) m (monitor pid))
    (send pid [:$call (self) r payload])
    (receive
      ([:reply ^r v] (demonitor m)
        ;; a second reply to this ref (a `defer` answered twice) is dropped at delivery,
        ;; or flushed if it was already queued behind this one
        (%ref-deactivate r)
        (receive ([:reply ^r _] :ok) (after 0 :ok))
        ; flush a late down, don't leak it
        (receive ([:down ^m _ _] :ok) (after 0 :ok))
        v)
      ([:down ^m _ reason] (demonitor m)
        ;; The server is gone, so nothing will ever match this ref again — but a reply
        ;; it posted just before dying may still be in flight. Deactivate first (drops
        ;; the in-flight one at delivery), then flush one already queued.
        (%ref-deactivate r)
        (receive ([:reply ^r _] :ok) (after 0 :ok))
        (error "call: server " (pr-str pid) " died: " (pr-str reason)))
      (after ms
        (demonitor m)
        ;; Deactivate BEFORE flushing: from here on a late `[:reply r …]` is dropped by
        ;; the kernel at delivery, so the flush below only has to clear what was queued
        ;; before this instant, and nothing can slip in behind it.
        (%ref-deactivate r)
        ;; Both envelopes carry an unforgeable `ref`/monitor that NO other receive in
        ;; this process can match, so anything left queued for them is unreachable
        ;; garbage: it never gets consumed, grows the mailbox without bound over a
        ;; retry loop, and is re-scanned by every later selective receive. The reply
        ;; first — a server that answered just as the deadline passed is the common
        ;; case — then the monitor's down.
        (receive ([:reply ^r _] :ok) (after 0 :ok))
        (receive ([:down ^m _ _] :ok) (after 0 :ok))
        (error "call: timed out after " ms " ms")))))

(defn reply (token value)
  "Answer a `defer`red call: send `value` to the caller still blocked in `gen/call`.
`token` is the opaque `reply` the `defer` clause bound — pass it wherever the answer
will be produced (a worker, a later message, a timer) and call this when it exists.

    (defserver fetcher (state)
      (defer :get (do (spawn-link (fn () (gen/reply reply (slow-fetch)))) state)))

Safe to call after the caller gave up: its reply `ref` is a one-shot alias, so a late
answer is dropped at delivery rather than left unmatchable in the mailbox. Replying
twice to one token is likewise harmless — the second is dropped.

    (gen/reply reply result)   ;~> the caller blocked in `gen/call` returns `result`"
  (send (nth token 0) [:reply (nth token 1) value]))

(defn stop (pid: (or map pid) -> nil)
  "Tell a server process to exit its receive loop cleanly (running its
`terminate` clause first, if it has one). Returns nil immediately — there is no
acknowledgement (the process is gone by the time the caller could check). Safe to
send to a pid that has already exited.

    (gen/stop server)   ;~> nil — the server runs its `terminate` clause and exits"
  (gen-send pid [:$stop]))

(defn code-change (pid: (or map pid) -> nil)
  "Ask a running server to migrate its state to the current code shape — its
`defserver` `code-change` clause runs, transforming the old-shaped state into the
new one. This is the hand-off a long-lived server needs after a hot reload: the
shared code region swaps behaviour live (ADR-013 late binding), but the loop keeps
threading its old-shaped state until told to migrate. A no-op (the message is
dropped) if the server declares no `code-change` clause. Returns nil immediately —
like `stop`, there is no acknowledgement; follow with a `call`/`query` if you
need to observe the migrated state. A supervisor (or an `on-reload` hook) is the
usual caller, once per affected child after a reload.

    (gen/code-change server)   ;~> nil — the server migrates its state on its next message"
  (gen-send pid [:$code-change]))

;; One entry with options rather than a verb per combination (ADR-433): `start-link` and
;; `start-named` were one-line wrappers that did not compose, so a linked AND named server
;; had no spelling at all.
(def- *start-options* #{:link :name})

(defn start (f state & opts)
  "Spawn a `defserver` server `f` with its initial `state`; return its pid. `opts` is an
optional map:
  - `:link` — `spawn-link` the server to the caller, so a crash propagates either way
  - `:name` — `register` it under this keyword, so it is reachable as
    `(proc/whereis name)` or by sending to `{:name name}`; or a `{:via registry :key key}`
    address, which registers it in that `names` registry. A key another live process
    holds there is not taken: the new server is stopped and the answer is the failure.

    (gen/start counter 0)                                 ;~> the pid of a `counter` server with state 0
    (gen/start counter 0 {:link true :name :counter})     ;~> the pid, linked to the caller and registered as :counter"
  (let (options (or (first opts) {})
        unknown (seq/reject (keys options) (fn (k) (contains? *start-options* k))))
    (when (not (empty? unknown))
      (error "gen/start: unknown option " (pr-str (first unknown)) " (expected :link or :name)"))
    (let (pid (if (get options :link) (spawn-link (f state)) (spawn (f state)))
          name (get options :name))
      (cond
        (nil? name) pid
        (map? name)
        ;; the registry's own register call (`names/register`), sent directly: `names` is
        ;; built on `gen`, so `gen` does not name it
          (let (held (call (get name :via) [:register (get name :key) pid nil]))
            (when (failure? held) (stop pid))
            held)
        else (do (proc/register name pid) pid)))))

;; ---- defserver -------------------------------------------------------------

(defn- gen-clause (c loop from rf res state-sym)
  "Compile one defserver message clause `c` into a receive clause. `loop` is the
loop fn (so a clause tail-recurses with the next state); `from`/`rf`/`res` are the
gensyms a `call`/`query` clause uses for the sender pid, reply ref, and the
[reply state] tuple; `state-sym` is the closed-over state parameter (so `query`
and `info` can tail-recurse with it unchanged)."
  ;; the receive clause stands for the user's clause `c`, and is located there: an error the
  ;; inner `receive`/`match` reports about it names the clause's line
  (let (kind (first c) pat (second c) body (rest (rest c)))
    (%copy-form-pos
      (cond
        (= kind 'cast) `([:$cast ~pat] (~loop (do ~@body)))
        ; body => next state
        (= kind 'call)
          `([:$call ~from ~rf ~pat] (let (~res (do ~@body))
                                      (/send ~from [:reply ~rf (/nth ~res 0)])
                                      (~loop (/nth ~res 1))))
        ; query — like call but the body is just the reply; state is untouched.
        ; Removes the [x s] boilerplate from the common "read a field" case.
        (= kind 'query)
          `([:$call ~from ~rf ~pat] (/send ~from [:reply ~rf (do ~@body)])
             (~loop ~state-sym))
        ; defer — a CALL the server will answer later. The body returns the next state
        ; (like a cast) and binds `reply`, an opaque token, so the answer can be sent from
        ; anywhere once it exists: a worker process, a later message, a timer. Without this
        ; a `call` clause had to produce its reply synchronously, so a server could not hand
        ; work off without blocking its own loop — the one gap that limited what could be
        ; built rather than merely what was convenient. `~'reply` injects the literal symbol
        ; (the `%defseq` escape hatch) so the body can name it.
        (= kind 'defer) `([:$call ~from ~rf ~pat] (let (~'reply [~from ~rf]) (~loop (do ~@body))))
        ; info — a raw message (no envelope): a monitor [:down …], a link [:EXIT …],
        ; a timer tick, a plain send. Body => next state, like a cast.
        (= kind 'info) `(~pat (~loop (do ~@body)))
        else
          (error "defserver: a message clause must start with `cast`, `call`, `query`, `defer`, or `info`, got "
            (pr-str kind)))
      c)))

;; `defserver`, not `defprocess`: it defines a **gen server** — clauses `cast`/`call`/
;; `query`/`info`, code speaking the gen envelope (`[:$call from ref …]`) — not a process.
(defmacro defserver (name params & clauses)
  "Define a gen server `name` over a single `params` state, as a tail-recursive
receive loop. Message clauses are `(cast PATTERN body…)` — body is the next
state — `(call PATTERN body…)` — body is `[reply next-state]` — `(query PATTERN
body…)` — body is just the reply, state unchanged — or `(info PATTERN body…)` —
matches a message that is no cast/call (a `[:down …]`, `[:EXIT …]`, timer tick,
or plain send), body is the next state. Three optional lifecycle clauses may appear
in any position: `(init body…)` runs once at startup (sees the state param,
returns the initial state), `(terminate reason body…)` runs on `(stop)`, and
`(code-change old-state body…)` runs on `(code-change pid)` — it binds the current
state and returns the migrated state, the hand-off a long-lived server needs to
reshape its state after a hot reload (ADR-013). An optional leading string is the
server's docstring. `(stop pid)` always ends the loop, and a message matched by no
clause is dropped (so the mailbox can't leak)."
  ;; Peel an optional leading docstring so it stays the generated defn's docstring
  ;; rather than being parsed as a clause.
  (let (doc (if (string? (first clauses)) (first clauses) nil)
        clauses (if doc (rest clauses) clauses)
        state-sym (first params)
        ;; Lifecycle clauses are pulled out; the rest are message clauses.
        init-clause (seq/find clauses (fn (c) (= (first c) 'init)))
        term-clause (seq/find clauses (fn (c) (= (first c) 'terminate)))
        cc-clause (seq/find clauses (fn (c) (= (first c) 'code-change)))
        msg-clauses (seq/filter clauses
                      (fn (c)
                        (not (includes? (list 'init 'terminate 'code-change) (first c)))))
        ;; Envelope clauses (cast/call/query) are matched BEFORE info clauses,
        ;; regardless of declaration order, so a broad `info` pattern can never
        ;; swallow a `[:$call …]` / `[:$cast …]` envelope (receive is first-match).
        env-clauses (seq/filter msg-clauses
                      (fn (c) (includes? (list 'cast 'call 'query 'defer) (first c))))
        info-clauses (seq/filter msg-clauses (fn (c) (= (first c) 'info)))
        from (reflect/gensym "from")
        rf (reflect/gensym "ref")
        res (reflect/gensym "res")
        loop (reflect/gensym "loop")
        junk (reflect/gensym "msg")
        compile (fn (c) (gen-clause c loop from rf res state-sym))
        env-receive (map env-clauses compile)
        info-receive (map info-clauses compile)
        ;; `[:$stop]` ends the loop; run `terminate` (reason :normal) first if present.
        stop-clause (if term-clause
                      `([:$stop] (let (~(second term-clause) :normal) ~@(rest (rest term-clause)))
                         nil)
                      `([:$stop] nil))
        ;; `[:$code-change]` (from `(code-change pid)`): the loop migrates its own
        ;; state before continuing, so a long-lived server picks up a state-shape
        ;; change after a hot reload (ADR-013 late binding swaps the *code*; this is
        ;; the hand-off that reshapes the *state*). The clause binds the OLD state and
        ;; returns the NEW. Without a `code-change` clause the message falls through to
        ;; the catch-all and is dropped — a safe no-op.
        cc-receive (if cc-clause
                     (list `([:$code-change] (~loop (let (~(second cc-clause) ~state-sym)
                                                      ~@(rest (rest cc-clause))))))
                     nil)
        ;; Default catch-all (last): drop an unrecognised message and keep state,
        ;; so it cannot pile up unmatched in the mailbox.
        catch-all `(~junk (~loop ~state-sym))
        loop-body `(receive ~@env-receive ~stop-clause ~@cc-receive ~@info-receive ~catch-all)
        ;; `init` runs once: its body sees the state param and returns the initial
        ;; state. Without it the loop just starts from the passed-in state.
        init-expr (if init-clause `(do ~@(rest init-clause)) state-sym)
        ;; A local `loop` keeps init outside the per-message recursion; the clause
        ;; bodies tail-recurse via `loop`, so the receive loop stays O(1) stack.
        entry `(letrec (~loop (fn (~state-sym) ~loop-body)) (~loop ~init-expr)))
    ;; Guard typos: every message clause must be cast/call/query/info.
    (if (not (= (+ (count env-clauses) (count info-clauses)) (count msg-clauses)))
      (error "defserver: every clause must be cast/call/query/defer/info/init/terminate/code-change"))
    (if doc `(defn ~name ~params ~doc ~entry) `(defn ~name ~params ~entry))))

;; ---- defstatem ---------------------------------------------------------------
;; A state machine (ADR-437): the server's state is a NAME plus data, and what a message
;; does depends on the name. The macro writes only the dispatch — one `match` over
;; `[state event]` — and `run-statem` below is the loop: plain Brood, so postponing and
;; state timeouts are code you can read rather than macro output. The envelopes are
;; `defserver`'s, so `gen/start`, `gen/cast`, `gen/call` and `gen/stop` drive one unchanged.
;;
;; The loop's own state: `{:state :data :postponed :generation :timer :stopped}`.
;; `:generation` counts transitions, and a state timeout carries the generation that armed
;; it, so one that fires after its state was left is recognised and dropped.

(defn- statem-arm (st opts)
  ;; Every transition cancels the pending state timeout; `opts` may arm a new one.
  (when (get st :timer) (timer/cancel (get st :timer)))
  (let (generation (inc (get st :generation))
        ms (get opts :timeout))
    (assoc st
      :generation generation
      :timer (when ms (timer/send-after ms (self) [:$state-timeout generation])))))

(defn- statem-handle (handler st event)
  (let (action (handler (get st :state) event (get st :data)))
    (match action
      (:unhandled st)
      ([:postpone] (assoc st :postponed (conj (get st :postponed) event)))
      ([:keep data] (assoc st :data data))
      ([:next state data] (statem-enter handler st state data {}))
      ([:next state data opts] (statem-enter handler st state data opts))
      ([:stop data] (assoc st :data data :stopped true))
      (_ (error "defstatem: a clause returned "
           (pr-str action)
           " (expected [:next state data], [:next state data opts], [:keep data], [:postpone] or [:stop data])")))))

;; Postponed events run again, oldest first, once the state changes.
(defn- statem-replay (handler st events)
  (if (or (empty? events) (get st :stopped))
    st
    (statem-replay handler (statem-handle handler st (first events)) (rest events))))

(defn- statem-enter (handler st state data opts)
  (let (moved (statem-arm (assoc st :state state :data data) opts))
    (if (= state (get st :state))
      moved
      (statem-replay handler (assoc moved :postponed []) (get st :postponed)))))

(defn- statem-loop (handler terminate st)
  (if (get st :stopped)
    (do
      (when (get st :timer) (timer/cancel (get st :timer)))
      (when terminate (terminate :normal (get st :data)))
      nil)
    (let (generation (get st :generation))
      (statem-loop handler
        terminate
        (receive
          ([:$cast payload] (statem-handle handler st [:cast payload]))
          ([:$call from r payload] (statem-handle handler st [:call payload [from r]]))
          ([:$stop] (assoc st :stopped true))
          ([:$state-timeout ^generation] (statem-handle handler st [:timeout]))
          ;; A timeout armed in a state since left.
          ([:$state-timeout _] st)
          (message (statem-handle handler st [:info message])))))))

(defn run-statem (handler terminate initial)
  "The loop a `defstatem` expands to; call `gen/start` on the machine, not this.
`handler` maps `[state event data]` to an action, `terminate` is nil or a function of
`reason` and `data`, and `initial` is `[state data]` or `[state data opts]`.

    (gen/run-statem handler nil [:idle {}])   ;~> nil, once the machine stops"
  (let (opts (if (> (count initial) 2) (nth initial 2) {}))
    (statem-loop handler
      terminate
      (statem-arm {:state (nth initial 0)
                   :data (nth initial 1)
                   :postponed []
                   :generation 0
                   :timer nil}
        opts))))

;; One state clause as a `match` clause over `[state event]`. `state-pattern` is the
;; state's keyword, or `_` for an `any` clause. A `call` clause binds `reply`, the token
;; `gen/reply` answers, so a call may be answered now, later, or postponed with it.
(defn- statem-clause (state-pattern c)
  (let (kind (first c)
        pattern (second c)
        body (drop c 2))
    (cond
      (= kind 'cast) `([~state-pattern [:cast ~pattern]] ~@body)
      (= kind 'call) `([~state-pattern [:call ~pattern ~'reply]] ~@body)
      (= kind 'info) `([~state-pattern [:info ~pattern]] ~@body)
      (= kind 'timeout) `([~state-pattern [:timeout]] ~@(rest c))
      else
        (error "defstatem: a state's clause must start with cast, call, info or timeout, got "
          (pr-str kind)))))

(defmacro defstatem (name params & clauses)
  "Define a state machine `name` over one data parameter: a gen server whose behaviour
depends on a named state. Each `(:state clause…)` block lists what that state accepts:
`(cast PATTERN body…)`, `(call PATTERN body…)` (binds `reply`; answer with
`(gen/reply reply value)`), `(info PATTERN body…)` (any other message) and
`(timeout body…)` (the state timeout fired). A pattern may take a `:when` guard. Every
body returns an action:
  - `[:next state data]`, or `[:next state data {:timeout ms}]` — move to `state`; with
    `:timeout`, its `timeout` clause runs if the machine is still there after `ms`.
    Every `:next` cancels the pending timeout.
  - `[:keep data]` — stay, with new data (a pending timeout stays armed)
  - `[:postpone]` — keep this event until the state changes, then handle it again
  - `[:stop data]` — end the machine
An `(any clause…)` block applies in every state, after the state's own clauses; an event
nothing matches is dropped. The machine starts in the first state, or in what an
`(init body…)` clause returns (`[state data]` or `[state data opts]`; it sees the data
parameter). `(terminate reason body…)` runs on `gen/stop` or `[:stop data]`. Start it
with `gen/start`; drive it with `gen/cast`, `gen/call` and `gen/stop`.

    (defstatem door (code)
      (:locked
        (cast [:digit d] :when (= d code) [:next :open code {:timeout 5000}])
        (call :state (gen/reply reply :locked) [:keep code]))
      (:open
        (timeout [:next :locked code])
        (call :state (gen/reply reply :open) [:keep code])))"
  (let (doc (if (string? (first clauses)) (first clauses) nil)
        clauses (if doc (rest clauses) clauses)
        data-sym (first params)
        init-clause (seq/find clauses (fn (c) (= (first c) 'init)))
        term-clause (seq/find clauses (fn (c) (= (first c) 'terminate)))
        any-block (seq/find clauses (fn (c) (= (first c) 'any)))
        state-blocks (seq/filter clauses (fn (c) (keyword? (first c))))
        known (+ (count state-blocks)
                (if init-clause 1 0)
                (if term-clause 1 0)
                (if any-block 1 0))
        state-sym (reflect/gensym "state")
        event-sym (reflect/gensym "event")
        match-clauses (append (mapcat state-blocks
                                (fn (block)
                                  (map (rest block) (fn (c) (statem-clause (first block) c)))))
                        (if any-block (map (rest any-block) (fn (c) (statem-clause '_ c))) ())
                        (list `(~'_ :unhandled)))
        handler `(fn (~state-sym ~event-sym ~data-sym)
                   (match [~state-sym ~event-sym] ~@match-clauses))
        terminate (if term-clause
                    `(fn (~(second term-clause) ~data-sym) ~@(rest (rest term-clause)))
                    nil)
        initial (if init-clause
                  `(do ~@(rest init-clause))
                  `[~(first (first state-blocks)) ~data-sym])
        entry `(gen/run-statem ~handler ~terminate ~initial))
    (when (not (symbol? data-sym))
      (error "defstatem " name ": the parameter list must start with the data parameter"))
    (when (empty? state-blocks) (error "defstatem " name ": no states"))
    (when (not (= known (count clauses)))
      (error "defstatem "
        name ": every clause must be a state block (:name …), init, terminate or any"))
    (if doc `(defn ~name ~params ~doc ~entry) `(defn ~name ~params ~entry))))
