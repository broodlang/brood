;; std/proc/crash-report.blsp — crash reports for processes nobody is watching.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - An unsupervised process that raises just dies. The supervisor sees its
;;    children, the CLI sees the top-level process, and every other process —
;;    a `spawn` from a handler, a one-off worker, a `task` whose owner moved on —
;;    exits with a structured reason that nothing reads. That is the gap
;;    ADR-039's reversal left open (kernel supervision was the scheduler-race
;;    surface; userland supervision does not cover what nobody supervises), and
;;    it is closed here with a reporting process, not with the kernel:
;;    every crash is *reported* whether or not it is *handled*.
;;  - Mechanism is the kernel system monitor (`proc/system-monitor`), which
;;    already pushes `[:system :exit pid reason]` for every exit; this module is
;;    one subscriber selecting `:exit-abnormal`, which the kernel filters before
;;    it builds a message, so a clean exit costs one atomic load. One
;;    subscription per pid (ADR-305) is what lets this sit armed underneath
;;    `telemetry/watch-runtime` and the MCP snapshot instead of being displaced.
;;  - Default-ON in `brood file`, `nest run`, a released bundle and the REPL, for
;;    ADR-232's reason: a flag you must arm before the bug is a flag that is
;;    absent when it matters (KI-36). `nest test` does not arm it — the test
;;    runner reports its own failures, and a suite deliberately crashing
;;    processes would flood. `BROOD_NO_CRASH_REPORT=1` opts a run out.
;;  - Deduplicated per SITE, like ADR-232's once-per-name drop warning: the
;;    first crash at a `(kind file line)` prints in full, later ones at the same
;;    site print nothing. A supervised worker in a restart loop therefore costs
;;    one report, and the supervisor's own give-up (a different site) another.
;;  - The reporter does not report the process that started it: in `nest run`
;;    that is the entry process, whose crash the CLI already prints with the
;;    same trace. Reporting it here would print every top-level error twice.

(defmodule crash-report
  "Crash reports for green processes nobody is watching (ADR-305). A listener
process subscribes to the kernel's abnormal-exit events and prints one report per
crash site to stderr — pid, reason, error kind/code, source position, hint and the
innermost trace frames — so a `spawn`ed process that raises is never silent.

    (crash-report/start)          ; arm; idempotent, returns the listener pid
    (crash-report/stop)           ; disarm
    (crash-report/start {:sink f}) ; f receives each report string instead of stderr

`brood file.blsp`, `nest run`, a released bundle and the REPL arm it by default — through
the prelude's `%crash-report-arm-default`, which subscribes without loading this module and
calls `take-over` on the first crash (ADR-313). `BROOD_NO_CRASH_REPORT=1` opts out;
`nest test` never arms it.

A report looks like:

    [crash] #<pid a/9> exited: division by zero
            kind :arith-error  code E0031  at src/worker.blsp:14:9
            at worker/step (src/worker.blsp:14:9)
            at worker/loop (src/worker.blsp:9:5)
            (further crashes at this site are not reported)

Reasons that are not crashes — `:normal`, `:killed`, `:shutdown`, `[:shutdown x]` —
are never reported: a supervisor tearing a subtree down is not a fault.")

(def- crash-report-name :crash-reporter)

(def- crash-report-max-frames 8)

;; ---- classifying a reason ----------------------------------------------------

(defn- crash-report-crash? (reason)
  "True when `reason` is a fault worth reporting — anything but a clean or
deliberate exit."
  (match reason
    (:normal false)
    (:killed false)
    (:kill false)
    (:shutdown false)
    ([:shutdown _] false)
    (_ true)))

(defn- crash-report-site (reason)
  "The deduplication key for `reason`: the raise site `[kind file line]` when the
error map or its trace carries a position, `[kind message]` when neither does, else
the reason itself. A crash loop whose message varies per iteration (`\"boom: 3\"`,
`\"boom: 4\"`) is still one site."
  (match reason
    ;; Without a position on the map, the first trace frame carrying a `:file` (the raise
    ;; site as the program sees it): a user `error` records its position on the frame that
    ;; entered it, not on the error map, and a frame reached by a tail call carries none.
    ([:error (and m {:keys [kind message]})] (let (at (if (get m :file)
                                                        m
                                                        (seq/find (get m :trace)
                                                          (fn (frame) (get frame :file)))))
                                               (if at
                                                 [kind (get at :file) (get at :line)]
                                                 [kind message])))
    (_ reason)))

;; ---- rendering ---------------------------------------------------------------

(defn- crash-report-position (m)
  "`file:line:col` for an error map that carries a position, else nil."
  (let (file (get m :file) line (get m :line) col (get m :col))
    (cond
      (and file line col) (str file ":" line ":" col)
      (and file line) (str file ":" line)
      file file
      else nil)))

(defn- crash-report-frame-line (frame)
  "One `at fn (file:line:col)` line for a trace frame."
  (let (name (or (get frame :fn) "<anonymous>")
        pos (crash-report-position frame))
    (if pos
      (str "        at " name " (" pos ")")
      (str "        at " name))))

(defn- crash-report-detail-lines (m)
  "The lines under the headline for an error map: kind/code/position, hint, frames."
  (let (pos (crash-report-position m)
        meta (str "        kind "
               (pr-str (get m :kind))
               (if (get m :code) (str "  code " (get m :code)) "")
               (if pos (str "  at " pos) ""))
        hint (when (get m :hint) (str "        hint: " (get m :hint)))
        frames (map (take (or (get m :trace) ()) crash-report-max-frames)
                 crash-report-frame-line))
    (append (list meta) (if hint (list hint) ()) frames)))

(defn render (pid:pid reason:any -> string)
  "Render one crash report for `pid` exiting with `reason` as a multi-line string
(no trailing newline). Pure — the piece a host that captures reports formats with.

    (crash-report/render pid reason)   ;~> a multi-line report string naming `pid` and where it crashed"
  (let (headline (match reason
                   ([:error (and m {:keys [message]})] (str "[crash] "
                                                         (pr-str pid)
                                                         " exited: "
                                                         (or message (pr-str m))))
                   ([:error other] (str "[crash] " (pr-str pid) " exited: " (pr-str other)))
                   (_ (str "[crash] " (pr-str pid) " exited: " (pr-str reason))))
        details (match reason
                  ([:error (and m {:keys [kind]})] (if kind (crash-report-detail-lines m) ()))
                  (_ ()))
        lines (append (list headline)
                details
                (list "        (further crashes at this site are not reported)")))
    (string/join lines "\n")))

;; ---- the listener ------------------------------------------------------------

(defn- crash-report-emit (sink text)
  "Hand `text` to the configured sink, or print it to stderr."
  (if sink
    (sink text)
    (io/puts text :to *err*)))

(defn- crash-report-step (starter sink seen pid reason)
  "Report `pid`'s exit if it is a crash at a site not already in `seen`; return the
`seen` to carry forward. The single place the report/skip decision is made — the loop
and `take-over` both go through it, so the lazy-arm handoff cannot drift from the
eager one."
  (if (or (= pid starter) (not (crash-report-crash? reason)))
    seen
    (let (site (crash-report-site reason))
      (if (contains? seen site)
        seen
        (do
          (crash-report-emit sink (render pid reason))
          (conj seen site))))))

(defn- crash-report-loop (starter sink seen)
  "The listener: report each abnormal exit once per site; `:stop` disarms."
  (receive
    ([:system :exit pid reason] (crash-report-loop starter
                                  sink
                                  (crash-report-step starter sink seen pid reason)))
    ([:system _ _ _] (crash-report-loop starter sink seen))
    (:stop (do (proc/system-monitor nil) nil))))

(defn take-over (starter:pid msg:any -> nil)
  "Become the real reporter, handling `msg` — the first event the prelude's lazy shim
(`%crash-reporter-shim`) received — then looping as usual. `starter` is the process that
armed, whose own exit is never reported.

Called only from that shim, and the qualified call to it is what loads this module: until
a process actually crashes, none of this file exists in the image (ADR-313). Reporting to
stderr, never a sink — a caller wanting a sink calls `start` explicitly, which loads the
module eagerly because it is already talking to it.

No `:stop` arm: the shim matches `:stop` itself and disarms without ever loading this
file, so a `:stop` cannot reach here — the checker says so too, and said so out loud when
this had one.

    (crash-report/take-over starter msg)   ;~> never returns — loops as the reporter"
  (match msg
    ([:system :exit pid reason] (crash-report-loop starter
                                  nil
                                  (crash-report-step starter nil #{} pid reason)))
    (_ (crash-report-loop starter nil #{}))))

(defn start (&optional opts: (or map nil) -> pid)
  "Arm the crash reporter: spawn the listener, subscribe it to the kernel's abnormal
exits and register it as `:crash-reporter`. Idempotent — a second call returns the
running listener's pid. `opts` may carry `:sink`, a one-argument function that
receives each rendered report instead of it going to stderr (a host capturing
reports, or a test). The calling process is never reported — its crash is the
CLI's to print.

    (crash-report/start {:sink (fn (text) (log/error text))})   ;~> the listener's pid"
  (let (running (proc/whereis crash-report-name))
    (if running
      running
      (let (starter (self)
            sink (get (or opts {}) :sink)
            listener (spawn (crash-report-loop starter sink #{})))
        (proc/register crash-report-name listener)
        (proc/system-monitor listener {:exit-abnormal true})
        listener))))

(defn stop ()
  "Disarm the crash reporter, if one is running, and return once it has: the
listener's subscription is gone and a crash after `stop` returns is not reported.
Returns nil.

    (crash-report/stop)   ;~> nil — later crashes are not reported"
  (let (running (proc/whereis crash-report-name))
    (when running
      (let (m (monitor running))
        (send running :stop)
        (receive ([:down ^m _ _] nil) (after 1000 nil))))
    nil))

(defn running? ()
  "Is a crash reporter armed?

    (crash-report/running?)   ;~> true while the reporter is armed"
  (not (nil? (proc/whereis crash-report-name))))

;; ---- a report as data: what a program sends somewhere --------------------------------
;; `render` is text for stderr, for a process that died. A program that CATCHES its errors —
;; an editor's command, a server's handler — has nothing to print to and wants to send the
;; error to whoever fixes it: as data, its private details gone, under a signature that is
;; the same for the same bug on every machine, so a collector can count it once.

(def- crash-report-max-message 500)

(defn- crash-report-error-map (error)
  "The error map inside `error`: a caught error map, a process exit reason `[:error m]`, or
anything else as a message."
  (match error
    ([:error (and m {:keys [kind]})] m)
    ([:error other] {:kind :error :message (pr-str other)})
    ({:keys [kind]} error)
    (_ {:kind :error :message (if (string? error) error (pr-str error))})))

(defn- crash-report-relative-file (file)
  "`file` as the same on every machine: from the LAST `src/`, `std/` or `tests/` in it on, as
the directories above that are the checkout's, else its name alone."
  (if (not (string? file))
    nil
    (let (found (regex/find "^(?:.*/)?((?:src|std|tests|tools)/.*)$" file))
      (if found (:text (first (:groups found))) (path/basename file)))))

(defn- crash-report-frame (frame)
  {:fn (when (get frame :fn) (->string (get frame :fn)))
   :file (crash-report-relative-file (get frame :file))
   :line (get frame :line)})

;; A value after a secret's name: a quoted string, escapes and all, or a bare word.
(def- crash-report-secret-value "(\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'|[^\\s,;&\"'})\\]]+)")

;; A name that holds a secret, as it is spelled in an env var, a flag, JSON or a keyword:
;; `AWS_SECRET_ACCESS_KEY`, `--db-password`, `"apiKey"`, `:password`.
(def- crash-report-secret-name
  "[A-Za-z0-9_-]*(?:password|passwd|pwd|passphrase|token|secret|credential|api[_-]?key|access[_-]?key|private[_-]?key)[A-Za-z0-9_-]*")

(def- crash-report-redactions
  [["/(?:home|Users)/[^/\\s\"':,]+" "~"]
    ["[A-Za-z]:\\\\Users\\\\[^\\\\\\s\"':,]+" "~"]
    ["(?i)([a-z][a-z0-9+.-]*://)[^/\\s@]+@" "$1[redacted]@"]
    ["(?i)(authorization[\"']?\\s*[=:]\\s*[\"']?(?:[a-z]+\\s+)?)[^\r\n\"']+" "$1[redacted]"]
    ["(?i)(bearer\\s+)[A-Za-z0-9._~+/=-]+" "$1[redacted]"]
    ["(?i)((?:set-)?cookie[\"']?\\s*[=:]\\s*[\"']?)[^\r\n\"']+" "$1[redacted]"]
    [(str "(?i)(" crash-report-secret-name "[\"']?\\s*(?:=>|=|:)\\s*)" crash-report-secret-value)
      "$1[redacted]"]
    [(str "(?i)(:" crash-report-secret-name "\\s+)" crash-report-secret-value) "$1[redacted]"]
    ["-----BEGIN [A-Z ]+-----[\\s\\S]*?(?:-----END [A-Z ]+-----|$)" "[redacted key]"]])

(defn redact (text:any -> string)
  "`text` with what must not leave the machine taken out: home directories as `~`, URL
credentials, `Authorization` and `Cookie` values, a bearer token, the value of anything named
like a password, token, secret or key, however it is spelled, and a PEM block, whole or cut
short. A message can quote anything the program held, so a report's text goes through here
before it is shown or sent. It recognises names and shapes, so a secret with neither gets
through: a caller holding one should not put it in an error.

    (crash-report/redact \"open /home/ann/x: no such file\")   ;=> \"open ~/x: no such file\"
    (crash-report/redact \"{\\\"password\\\":\\\"hunter2\\\"}\")   ;=> \"{\\\"password\\\":[redacted]}\""
  (let (text (if (string? text) text (pr-str text))
        home (path/home)
        homed (if (and (string? home) (> (string/length home) 1))
                (string/replace text (str home "/") "~/")
                text))
    (fold crash-report-redactions
      homed
      (fn (redacted rule) (regex/replace (first rule) redacted (second rule))))))

(defn- crash-report-redact-value (value)
  "`value` with every string in it, however deep, through [[redact]]."
  (cond
    (string? value) (redact value)
    (map? value)
      (fold (%map-pairs value)
        {}
        (fn (acc pair)
          (assoc acc
            (first pair) (crash-report-redact-value (second pair)))))
    (vector? value) (into [] (map value crash-report-redact-value))
    (list? value) (map value crash-report-redact-value)
    else value))

(defn signature (report:map -> string)
  "The report's identity across machines and runs: its error kind, where it was raised and
the functions above that — no message, no value, no path outside the project. The same bug
hit twice, or by two people, has one signature; a collector groups by it.

    (crash-report/signature (crash-report/describe-error {:kind :type-error :file \"src/a.blsp\" :line 3}))   ;~> \"9f2c…\" (16 hex digits)"
  (let (site (:site report)
        frames (map (take (or (:frames report) []) 4) (fn (frame) [(:fn frame) (:file frame)])))
    (string/substring (hash/sha256 (pr-str [(:kind report) (:file site) (:line site) frames])) 0 16)))

(defn describe-error (error:any &optional context: (or map nil) -> map)
  "`error` — a caught error map, a process's exit reason, or any value — as a report: its
`:kind`, `:code`, `:message` (redacted, capped), `:hint`, `:site` `{:file :line}` and the
innermost `:frames` with project-relative paths, the `:brood` version, the `:os`, its
`:signature` ([[signature]]), and the caller's `context` map under `:context`, redacted
(the program's name and version, what it was doing). Pure but for reading the version.

    (crash-report/describe-error (try (/ 1 0) (catch e e)) {:program \"bedit\"})   ;~> {:kind :arith-error :site {…} :signature \"…\" …}"
  (let (m (crash-report-error-map error)
        trace (or (get m :trace) [])
        at (if (get m :file) m (or (seq/find trace (fn (frame) (get frame :file))) {}))
        message (redact (or (get m :message) ""))
        report {:kind (get m :kind)
                :code (get m :code)
                :message (if (> (string/length message) crash-report-max-message)
                           (str (string/substring message 0 crash-report-max-message) "…")
                           message)
                :hint (when (get m :hint) (redact (get m :hint)))
                :site {:file (crash-report-relative-file (get at :file)) :line (get at :line)}
                :frames (into [] (map (take trace crash-report-max-frames) crash-report-frame))
                :brood (system/brood-version)
                :os (os/type)
                :context (crash-report-redact-value (or context {}))})
    (assoc report :signature (signature report))))

;; ---- a runtime's own death: the fatal-signal record ----
;; A runtime that dies on SIGSEGV, SIGBUS, SIGILL, SIGFPE or SIGABRT runs no Brood code and no
;; panic hook, so the kernel writes a record from its signal handler instead
;; (`cli_support/fatal_signal.rs`): one map literal per crashed process, under
;; `(%crash-record-dir)`. The next start reads them here.

(defn- crash-report-record-message (record)
  (str "fatal "
    (:signal record)
    (if (:thread record) (str " on thread " (:thread record)) "")
    (if (:panic record) (str " after a panic: " (:panic record)) "")))

(defn- crash-report-read-record (dir name)
  "The record in `dir`/`name` with its `:file` and a `:message`, or nil when it is not one."
  ;; check-allow :discarded-catch — a record that cannot be read or parsed is not one, and
  ;; nil is that answer
  (check-allow :discarded-catch
    (let (file (path/join dir name)
          text (try (file/slurp file) (catch _ nil))
          record (when (string? text) (try (reflect/read-string text) (catch _ nil))))
      (when (and (map? record) (= (get record :kind) :fatal-signal))
        (assoc record :file file :message (crash-report-record-message record))))))

(defn previous-crashes (-> vector)
  "The fatal-signal records earlier runs left on this machine, oldest first: a runtime that died
on SIGSEGV, SIGBUS, SIGILL, SIGFPE or SIGABRT (a Rust panic that aborted, a stack overflow)
writes one from its signal handler, where no Brood code runs. Each is a map — `:kind
:fatal-signal`, `:signal` (\"SIGSEGV\"), `:signo`, `:time` (epoch ms), `:pid`, `:version` and
`:sha` of the runtime, its `:argv`, the `:thread` it died on, the fault `:address`, the signal's
`:code`, the `:panic` message when a panic led to it — plus `:file` (where it is) and a
`:message`. [[describe-error]] makes a report of one; [[forget-crash]] removes it once offered.
A record can be any brood program's: `:argv` says which.

    (crash-report/previous-crashes)   ;~> [{:kind :fatal-signal :signal \"SIGSEGV\" :time 1762560000000 …}]"
  (let (dir (%crash-record-dir))
    (if (or (nil? dir) (not (file/dir? dir)))
      []
      (let (names (seq/filter (file/ls dir)
                    (fn (name)
                      (and (string/starts-with? name "crash-") (string/ends-with? name ".blsp"))))
            records (seq/keep names (fn (name) (crash-report-read-record dir name))))
        (into [] (seq/sort-by records (fn (record) (or (get record :time) 0))))))))

(defn forget-crash (record:map -> any)
  "Remove `record` (one of [[previous-crashes]]) from disk, so the next start does not offer it
again. True when it was removed.

    (crash-report/forget-crash (first (crash-report/previous-crashes)))   ;~> true"
  (let (file (get record :file))
    (and (string? file)
      (= (path/dirname file) (%crash-record-dir))
      ;; check-allow :discarded-catch — whether the file is gone afterwards is the answer
      (check-allow :discarded-catch
        (do (try (file/rm file) (catch _ nil)) (not (file/exists? file)))))))

(defn post (url:string report:map -> any)
  "Send `report` ([[describe-error]]'s, perhaps with a note the user added) to the collector at
`url` as JSON: the response map, or a failure saying why. Blocking, under `http`'s own
timeouts — call it off a loop that must stay responsive (a task).

    (crash-report/post \"https://brood.fly.dev/api/v1/reports\" report)   ;~> {:status 201 …}"
  (http/post url
    (json/encode report)
    {:headers {"Content-Type" "application/json"}}))
