;; std/proc/agent.blsp — process-backed state cell.
;;
;; An agent is a single green process that holds one immutable value as state.
;; Callers send it messages to read or transform that value; the agent serialises
;; all updates. Modelled after Elixir's Agent, built on Brood's spawn/send/receive.

(defmodule agent
  "A process-backed state cell: read or transform a value via message-passing.

    (def a (agent/start (fn () 0)))
    (agent/update a inc)          ;; state becomes 1
    (agent/get    a identity)     ;; => 1
    (agent/cast   a (fn (n) (* n 10))) ;; fire-and-forget update
    (agent/stop   a)

State is always passed through a function so callers never access the raw value
directly, keeping access patterns explicit. `get-and-update` is the atomic
read+write primitive for compare-and-swap-style patterns.")

;; ---- receive loop -----------------------------------------------------------
;;
;; The wire format is `gen`'s: `[:$call from ref payload]` in, `[:reply ref v]` out,
;; `[:$cast payload]` for the async update, `[:$stop]` to end the loop. That is what
;; lets the public API below simply BE `gen`'s `call` — with its monitor + deadline —
;; instead of a second hand-rolled request/reply that blocked forever against a dead
;; agent.

(defn- agent-loop
  (state)
  (receive
    ([:$call from r [:get f]] (send from [:reply r (f state)]) (agent-loop state))
    ([:$call from r [:update f]] (send from [:reply r :ok]) (agent-loop (f state)))
    ([:$call from r [:get-and-update f]] (let (res (f state))
                                           (send from [:reply r (first res)])
                                           (agent-loop (second res))))
    ([:$call from r :stop] (send from [:reply r :ok]))
    ([:$cast f] (agent-loop (f state)))
    ([:$stop] nil)
    ;; Catch-all, last (OTP's default handle_info, and what `gen` already does):
    ;; drop an unrecognised message and keep the state. Without it a stray send —
    ;; a `[:down …]`, a misrouted reply, a timer tick — was matched by no clause and
    ;; sat in the mailbox forever, growing it and being re-scanned by every later
    ;; selective receive.
    (_ (agent-loop state))))

;; ---- public API -------------------------------------------------------------

(defn start (init-fn)
  "Spawn an agent whose initial state is `(init-fn)`. Returns the agent's pid."
  (spawn (agent-loop (init-fn))))

(defn start-link (init-fn)
  "Like `start` but links the agent to the calling process — the agent crashes
if its owner crashes and vice versa."
  (spawn-link (agent-loop (init-fn))))

;; Every synchronous op below is `gen`'s `call` (core, bare): it monitors the agent
;; for the duration, so a **dead** agent raises `call: server … died: …` at once and a
;; wedged one raises `call: timed out …` after 5 s (Elixir's Agent default). The
;; hand-rolled `(receive ([:reply ^r v] v))` these replaced had neither, so any of
;; them parked the caller FOREVER — no error, no timeout, nothing to wake it.

(defn get (pid f)
  "Call `(f state)` inside the agent and return the result. Blocks until the
agent replies (up to 5 s; a dead agent raises rather than hanging). Use
`identity` to return the state as-is."
  (call pid [:get f]))

(defn update (pid f)
  "Replace the agent's state with `(f state)`. Blocks until acknowledged (up to
5 s; a dead agent raises rather than hanging)."
  (call pid [:update f]))

(defn get-and-update (pid f)
  "Atomically read and update: `f` must return a 2-vector `[result new-state]`.
Returns `result` and leaves the agent with `new-state`. Blocks until the agent
replies (up to 5 s; a dead agent raises rather than hanging)."
  (call pid [:get-and-update f]))

(defn cast (pid f)
  "Fire-and-forget update: apply `(f state)` asynchronously, no reply waited."
  (send pid [:$cast f]))

(defn stop (pid)
  "Ask the agent to exit its loop cleanly. Blocks until it acknowledges (up to
5 s; a dead agent raises rather than hanging)."
  (call pid :stop))
