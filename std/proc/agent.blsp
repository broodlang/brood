;; std/proc/agent.blsp — process-backed state cell.
;;
;; An agent is a single green process that holds one immutable value as state.
;; Callers send it messages to read or transform that value; the agent serialises
;; all updates. Modelled after Elixir's Agent, built on Brood's spawn/send/receive.

(defmodule agent
  "A process-backed state cell: read or transform a value via message-passing.

    (def a (agent/start (fn () 0)))
    (agent/update a inc)          ;; state becomes 1
    (agent/get    a identity)     ;; => 1
    (agent/cast   a (fn (n) (* n 10))) ;; fire-and-forget update
    (agent/stop   a)

State is always passed through a function so callers never access the raw value
directly, keeping access patterns explicit. `get-and-update` is the atomic
read+write primitive for compare-and-swap-style patterns.")

;; ---- receive loop -----------------------------------------------------------
;;
;; The wire format is `gen`'s: `[:$call from ref payload]` in, `[:reply ref v]` out,
;; `[:$cast payload]` for the async update, `[:$stop]` to end the loop. That is what
;; lets the public API below simply BE `gen/call` — with its monitor + deadline —
;; instead of a second hand-rolled request/reply that blocked forever against a dead
;; agent.

;; A synchronous op runs the caller's `f` INSIDE the agent, so a throwing `f` is the
;; caller's error, not the agent's: `agent-apply` catches it, the reply carries it back
;; (`[:raised problem]`, beside `[:ok value]`), `agent-result` re-raises it in the caller,
;; and the agent carries on with its OLD state. `update` used to reply `:ok` BEFORE
;; applying `f`, so a throwing `f` reported success and then killed the agent — every
;; later call raised "server died" for an update the caller had been told succeeded.
;; A `cast` has no caller to tell, so a throwing cast `f` still crashes the agent loudly.
(defn- agent-apply (f state)
  (try [:ok (f state)] (catch problem [:raised problem])))

(defn- agent-loop (state)
  (receive
    ([:$call from r [:get f]] (send from [:reply r (agent-apply f state)]) (agent-loop state))
    ([:$call from r [:update f]] (match (agent-apply f state)
                                   ([:ok next] (send from [:reply r [:ok :ok]])
                                     (agent-loop next))
                                   (raised (send from [:reply r raised]) (agent-loop state))))
    ([:$call from r [:get-and-update f]] (match (agent-apply (fn (current)
                                                               (let (pair (f current))
                                                                 (if (and (vector? pair)
                                                                       (= (count pair) 2))
                                                                   pair
                                                                   (error "agent/get-and-update: f must return [result new-state], got "
                                                                     (pr-str pair)))))
                                                  state)
                                           ([:ok [result next]] (send from [:reply r [:ok result]])
                                             (agent-loop next))
                                           (raised (send from [:reply r raised]) (agent-loop state))))
    ([:$call from r :stop] (send from [:reply r :ok]))
    ([:$cast f] (agent-loop (f state)))
    ([:$stop] nil)
    ;; Catch-all, last (OTP's default handle_info, and what `gen` already does):
    ;; drop an unrecognised message and keep the state. Without it a stray send —
    ;; a `[:down …]`, a misrouted reply, a timer tick — was matched by no clause and
    ;; sat in the mailbox forever, growing it and being re-scanned by every later
    ;; selective receive.
    (_ (agent-loop state))))

;; ---- public API -------------------------------------------------------------

(defn start (init-fn)
  "Spawn an agent whose initial state is `(init-fn)`. Returns the agent's pid."
  (spawn (agent-loop (init-fn))))

(defn start-link (init-fn)
  "Like `start` but links the agent to the calling process — the agent crashes
if its owner crashes and vice versa."
  (spawn-link (agent-loop (init-fn))))

;; Every synchronous op below is `gen/call`: it monitors the agent
;; for the duration, so a **dead** agent raises `call: server … died: …` at once and a
;; wedged one raises `call: timed out …` after 5 s (Elixir's Agent default). The
;; hand-rolled `(receive ([:reply ^r v] v))` these replaced had neither, so any of
;; them parked the caller FOREVER — no error, no timeout, nothing to wake it.

(defn- agent-result (reply)
  ;; Unwrap a synchronous op's reply: the value, or the caller's own `f` error re-raised.
  (match reply
    ([:ok value] value)
    ([:raised problem] (throw problem))))

(defn get (pid f)
  "Call `(f state)` inside the agent and return the result. Blocks until the
agent replies (up to 5 s; a dead agent raises rather than hanging). Use
`identity` to return the state as-is. If `f` raises, the error is re-raised here and
the agent keeps running."
  (agent-result (gen/call pid [:get f])))

(defn update (pid f)
  "Replace the agent's state with `(f state)` and return `:ok`. Blocks until applied (up
to 5 s; a dead agent raises rather than hanging). If `f` raises, the error is re-raised
here and the agent keeps its previous state."
  (agent-result (gen/call pid [:update f])))

(defn get-and-update (pid f)
  "Atomically read and update: `f` must return a 2-vector `[result new-state]`.
Returns `result` and leaves the agent with `new-state`. Blocks until the agent
replies (up to 5 s; a dead agent raises rather than hanging). If `f` raises (or returns
anything but a 2-vector), the error is re-raised here and the agent keeps its previous
state."
  (agent-result (gen/call pid [:get-and-update f])))

(defn cast (pid f)
  "Fire-and-forget update: apply `(f state)` asynchronously, no reply waited. There is no
caller to report to, so an `f` that raises crashes the agent (let it crash) — use
`update` when the error should come back to you."
  (send pid [:$cast f]))
(sig cast ((or map pid) any -> nil))

(defn stop (pid)
  "Ask the agent to exit its loop cleanly. Blocks until it acknowledges (up to
5 s; a dead agent raises rather than hanging)."
  (gen/call pid :stop))
