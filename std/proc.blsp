;; std/proc.blsp — the non-mainstream process surface: green-process introspection/control
;; plus OS subprocesses. Policy over the %-prefixed primitives, so it lives under proc/*
;; rather than the bare core. (The mainstream actor model — spawn/send/receive/self/link/
;; monitor/register — stays bare in the prelude.)
(defmodule proc)

(defn info (pid)
  "A snapshot map of a live local process:
{:id :pid :node :name :status :mailbox :monitored-by :parent :memory :collections
:reductions} (:pid the process's pid value, for acting on it with exit/send/monitor;
:status is :running or :waiting; :name nil if unregistered; :parent the spawner's id,
nil for the root; :memory the LOCAL heap bytes and :collections the cumulative GC count,
both as of the process's last receive; :reductions the cumulative reduction count — the
scheduling unit, updated every quantum; exact for spawned processes, coarse for the
root). nil for a remote/dead pid. The process-introspection snapshot the observer reads;
see std/tool/observer.blsp."
  (%process-info pid))
(sig info (pid -> (or map nil)))

;; `& more`, not `&optional value`: for this primitive an ABSENT value reads the flag
;; while an explicit `nil` CLEARS it, and `&optional` collapses the two (both arrive as
;; nil), which silently turned every read into a clear.
(defn flag (flag & more)
  "Read or set a per-process runtime flag on the current process; returns the previous
(or, with no value, current) setting. Flags: :max-heap — this process's heap limit in
bytes (positive int sets, nil clears, absent reads). Checked after each GC against the
live footprint; exceeding it raises a catchable E0045 error in this process only —
uncaught, it kills just the offender (the global BROOD_MEM_LIMIT hard cap aborts the
whole runtime). Set it first thing in a spawned fn to cap that process:
(spawn (fn () (proc/flag :max-heap 8000000) (work))). :send-errors — when truthy, a
(send …) whose target NODE is unknown/disconnected raises a catchable E0060 noconnection
error instead of silently dropping the message (process liveness stays silent either
way) — so a sender can queue-and-retry across a net-split; pairs with the reconnect
reconnector."
  (if (empty? more) (%process-flag flag) (%process-flag flag (first more))))

(defn list ()
  "Every currently-live pid on this runtime (one per registered mailbox). Order is
unspecified — sort if you need stability. For agents/tools enumerating spawned
processes."
  (%list-processes))

(defn mailbox-size (pid)
  "How many messages are queued in pid's mailbox (its receive backlog), or nil if pid is
not a live local process. See std/tool/observer.blsp."
  (%mailbox-size pid))
(sig mailbox-size (pid -> (or int nil)))

(defn hibernate ()
  "Tell the runtime this process is about to idle for a long time: collect, shrink its
heap slabs and root vectors, and drop its inline caches and compiled-body cache. Returns
the bytes of slab capacity released. There is no continuation argument — a Brood process
resumes from its receive. Use it in a process that will wait a long while (a pooled
connection, an idle session actor) — it trades a one-off cache rebuild on the next call
for a substantially smaller idle footprint. Do NOT use it in a request loop: dropping the
caches per park costs message-heavy code 12-26%, which is exactly why this is an explicit
call and not automatic."
  (%hibernate))

;; `offload` stays a BARE prelude wrapper (core dirty-native concurrency, used
;; during `nest fetch` before any module loads) — see std/prelude/process.blsp.

;; ---- timers ----------------------------------------------------------------
;; Cancellation moved to `timer/cancel`, beside the two functions that create a timer.

;; ---- naming ------------------------------------------------------------------
;; `proc/register` / `proc/whereis` / `proc/unregister` / `proc/alive?` are kernel
;; primitives registered under this module (the `bit/*` pattern). They were bare
;; (`register`, `whereis`) until 2026-08-26 — process naming is process business, and
;; it reads better beside `proc/info` and `proc/list` than loose in the global namespace.
;; `unregister` and `alive?` are new: `register` had no inverse, so a name could only be
;; released by its process dying, and liveness had to be asked for by allocating a whole
;; `proc/info` snapshot and testing it for nil.
