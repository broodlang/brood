;; std/term.blsp — the terminal seam (ADR-046 display protocol).
;;
;; Thin policy over the `%term-*` primitives (mechanism): raw-mode + alternate-screen
;; control, input polling, and the two paint frontends (full-screen `draw`, inline
;; `emit`). Kept in the `term` namespace rather than the bare language core — an editor
;; or REPL reaches these as `term/enter`, `term/poll`, `term/draw`, …
(defmodule term
  "The terminal seam: raw mode, the alternate screen, cursor control and key decoding, over the `%term-*` primitives.")

(defn enter ()
  "Enter raw mode + the alternate screen, hide the cursor, and enable mouse capture,
taking over the terminal for a full-screen UI (so click/scroll reach `term/poll`). A
terminal that speaks the kitty keyboard protocol is asked to report repeats and releases
(popped again by `term/leave` and every exit path); in any other a held key is inferred
from its repeats. Either way `term/poll` delivers `[:key-up …]` and `term/held-key` knows
the key held. A terminal without the kitty protocol is asked for xterm's `modifyOtherKeys`
instead, so a chord with no legacy bytes (`C-;`, `C-.`, `C-S-a`) still arrives — xterm sends
it; under tmux add `set -g extended-keys on` to `~/.tmux.conf` (KI-360). Bracketed paste is turned on, so a paste arrives whole (`[:paste text]`), and
the next `term/draw` paints the screen whole (ADR-586). Pair with `term/leave`.

    (term/enter)   ;~> the terminal taken over: raw mode, alternate screen, mouse capture"
  (%term-enter))

(defn leave ()
  "Restore the terminal: show the cursor, disable mouse capture, leave the alternate
screen, disable raw mode. The normal-path teardown for `term/enter`.

    (term/leave)   ;~> the terminal restored to its normal state"
  (%term-leave))

(defn size ()
  "The terminal size as [cols rows] in character cells.

    (term/size)   ;~> [120 40]"
  (%term-size))

(defn poll (ms)
  "Wait up to `ms` milliseconds for an input event; return a key (a 1-char string for
printables, or a keyword for specials: :up :down :left :right :enter :escape :backspace
:tab :back-tab :delete :home :end :page-up :page-down, ctrl combos like :ctrl-c, alt
combos like :alt-f, and :ctrl-tab / :ctrl-shift-tab from a terminal that reports them —
the kitty keyboard protocol or xterm modifyOtherKeys; elsewhere Ctrl+Tab arrives as :tab), a mouse event as a vector [:mouse action button row col mods]
(action: :press :release :drag :scroll-up :scroll-down — :drag is motion with a button
held, reported once per cell crossed; button: :left :right :middle or nil for scroll;
row/col 0-based cells; mods a vector of held modifier keywords in :ctrl :alt :shift order,
[] when none), or nil on timeout. After `term/enter` a key coming up is delivered too, as
`[:key-up press]`, `press` the value that key's press delivered though Ctrl or Shift came
up first: reported by a terminal that speaks the kitty keyboard protocol, and inferred in
any other (tmux, a legacy terminal) when a held key's repeats stop — a held key there is
the same press arriving faster than a hand can press one key, and a tapped key has no
key-up. A held key's repeat already superseded in the buffered input is dropped, so a
backlog never plays on after the key is up; a press is never dropped, nor typed text. After
`term/enter` a paste arrives whole, as `[:paste text]` (bracketed paste), and a resize of the
terminal as `[:resize cols rows]` — a window's spelling, so a `ui-run` app re-renders at the
new size at once (ADR-586). `term/held-key` names the key held. Always pass a finite `ms`.

    (term/poll 50)   ;~> \"a\", :ctrl-c, [:mouse :press :left 3 10 []], [:key-up :ctrl-n], or nil on timeout"
  (%term-poll ms))

(defn held-key ()
  "The key held down in the terminal now — the value its press delivered (a 1-char string,
or a keyword like :ctrl-n / :up) — or nil when none is. A terminal that speaks the kitty
keyboard protocol (kitty, foot, WezTerm, Ghostty, Alacritty 0.13+) reports it; in any other,
and for the keys the protocol still sends as text, a key is held once its repeats arrive
faster than a hand presses one key, until they stop. Always nil outside `term/enter`.

    (term/held-key)   ;~> :down while the down arrow is held, nil when no key is"
  (%term-held-key))

(defn forward-input (pid)
  "Deliver every terminal input event to `pid`'s PRIORITY lane (`proc/send-priority`) from
now on — keys, mouse, `[:key-up …]`, exactly what `term/poll` would answer — from a reader
thread, as a window delivers its input (ADR-491); nil stops it. While it runs the keyboard
is read for you: a process that is busy still has its keys queued where the kernel's quit
key (`proc/set-quit-key`) sees them, so a terminal C-g interrupts a stuck `update` as a
window's does. Take them with `proc/take-priority` / `proc/receive-lane`; `term/poll` sees
nothing meanwhile. `editor/frontend/*term-display*` turns it on for its loop.

    (term/forward-input nil)   ;=> nil"
  (%term-forward-input pid))

(defn draw (frame)
  "Paint a `frame` — a vector of render ops: [:clear], [:text row col str], [:text row col
str face], [:rect row col w h face], [:cursor row col] / [:cursor row col style]. A face is
a map like {:fg :red :bold true}; a colour is a palette keyword (:red … :dark-grey) or an
explicit [r g b] vector / \"#rrggbb\" hex string. [:rect …] fills a w×h cell block with the
face's background. [:image row col w h source opts] (editor/display/image, ADR-686) draws a picture in the cell block as half blocks — `▀`, two pixels a cell — where a window paints it at pixel resolution. The optional cursor `style` is :block (default), :bar, or :underline. The
in-process frontend for the display protocol; returns nil.

The frame is painted over what the terminal already shows, cell by cell, and only the cells
that CHANGED are written (ADR-586) — so a frame that redraws the whole screen from `[:clear]`
costs the bytes of what moved, not of the screen, and a terminal over ssh does not flicker. A
wide character takes two cells; a true colour is written as the nearest colour the terminal
has (`term/colors`). The terminal's cursor shows at the frame's last `[:cursor]` (a `:hollow`
one only when there is no other), and is hidden in a frame with none.

    (term/draw [[:clear] [:text 0 0 \"hello\" {:fg :red}] [:cursor 0 5]])   ;~> nil"
  (%term-draw frame))

(defn invalidate ()
  "Forget what the terminal shows, so the next `term/draw` clears it and writes every cell —
for after something other than `term/draw` wrote to the screen (a program run in the
foreground, a stray write to stdout). A resize does it by itself (ADR-586).

    (term/invalidate)   ;=> nil"
  (%term-invalidate))

(defn suspend ()
  "Give the terminal back and stop this process, as a shell's C-z stops a job — Emacs's
`suspend-frame` in a terminal. The screen is left (`term/leave`), SIGTSTP raised with its
default action, and when the shell continues the job (`fg`) the terminal is taken again
(`term/enter`) and the next frame painted whole: `:suspended`. When nothing could continue a
stopped process — its process group is orphaned, as under `gnome-terminal -- prog`, `ssh host
prog` or `exec prog` — it does not stop, keeps the terminal, and answers `:no-job-control`
(stopped, it would stay frozen with whatever it had not saved). A full-screen app reads C-z
as a key (the terminal is raw), so this is what its C-z binding calls; a SIGTSTP sent from
outside reaches `ui-run`'s terminal display as the same (ADR-586). Unix only.

    (term/suspend)   ;~> :suspended once the shell has continued the job, or :no-job-control"
  (%term-suspend))

(defn refresh ()
  "After this process was stopped and continued by someone else (SIGSTOP, then SIGCONT): raw
mode back on — a shell resets the terminal when a job stops — and the next frame painted
whole. The terminal display does it on SIGCONT (ADR-586).

    (term/refresh)   ;~> nil"
  (%term-refresh))

(defn repaint-due? ()
  "Whether the next `term/draw` paints the screen whole — what the terminal shows was
forgotten (a resize, a continue, `term/invalidate`) — so a loop that skips drawing a model
that did not change must draw this time (ADR-586).

    (bool? (term/repaint-due?))   ;=> true"
  (%term-repaint-due))

(defn bg (background &optional (foreground nil))
  "Set the terminal's DEFAULT FACE — what `gui/bg` is to a window: `[:clear]` fills with
`background`, and a cell whose face names no `:bg` (no `:fg`) is drawn in `background`
(`foreground`). A theme made for a dark window is then drawn on its own background, not on
a light terminal's. A colour is a palette keyword, `[r g b]` or `\"#rrggbb\"` (degraded to
the terminal's depth, `term/colors`); nil is the terminal's own. The next frame repaints
whole (ADR-586). Returns nil.

    (term/bg \"#1e1e2e\" \"#cdd6f4\")   ;~> nil — the next frame drawn on the theme's base
    (term/bg nil)   ;=> nil"
  (%term-bg background foreground))

(defn colors (&optional (depth :environment))
  "The colour depth `term/draw` writes at: `:truecolor`, `:256` or `:16`. Read from
`$COLORTERM` (`truecolor` / `24bit`) and `$TERM` (`…-256color`, `…-direct`), as Emacs reads
them; over ssh `COLORTERM` is rarely passed on, so a remote session is usually `:256`. Given
a `depth`, set it — nil goes back to the environment's — and repaint the next frame whole. A
true colour (`\"#1e1e2e\"`) is drawn as the nearest colour the depth has; a named one (`:red`)
is always the terminal's own (ADR-586).

    (contains? #{:truecolor :256 :16} (term/colors))   ;=> true"
  (if (= depth :environment) (%term-colors) (%term-colors depth)))

(defn raw-enter ()
  "Enter raw mode only — NO alternate screen, cursor stays visible, scrollback preserved.
The seam for an inline line editor (the REPL); use `term/enter` instead for a full-screen
TUI. Pair with `term/raw-leave`.

    (term/raw-enter)   ;~> raw mode on; the screen and scrollback stay in place"
  (%term-raw-enter))

(defn raw-leave ()
  "Leave raw mode (the teardown for `term/raw-enter`). Idempotent with the panic-path restore.

    (term/raw-leave)   ;~> raw mode off"
  (%term-raw-leave))

(defn emit (ops)
  "Paint inline, relative-motion render `ops` (for an in-place editor that must not take
over the screen): [:print str], [:print str face], [:cr], [:nl], [:up n], [:down n],
[:col n], [:clear-eol], [:clear-below], [:clear-screen]. A face is a map like
{:fg :cyan :bold true}. Queues all ops then flushes once; unknown ops are skipped; returns nil.

    (term/emit [[:cr] [:print \"> \" {:fg :cyan}] [:clear-eol]])   ;~> nil"
  (%term-emit ops))
