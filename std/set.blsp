;; std/set.blsp — the set algebra over the kernel `#{…}` set type.
;; A namespace (ADR-065): its functions are `set/set`, `set/union`, … — consumers
;; `(:use set)` to refer them bare, or call them qualified.
(defmodule set
  "Sets — unordered collections of **unique** values with fast membership.

A set is a **first-class kernel value** (`#{…}`, ADR-060): `set?` is true, it
prints `#{…}`, and it never compares equal to a map. It is backed by the same
CHAMP trie as a map (`element → true`), so it shares the map's structural
equality (vector/structural keys work — `#{[0 0] [1 2]}` Just Works) and O(log n)
membership, and it is *seqable* (`map`/`fold`/`count`/`vec`/`into` treat it as its
elements).

The kernel supplies the literal, `set?`, and the O(log n) element ops
(`%set`/`%set-add`/`%set-remove`/`%set-has?`/`%set-count`); the prelude's
`conj`/`disj`/`get`/`into`/`contains?`/`count`/`empty?`/`first`/`rest` already
dispatch to a set, so plain collection code needs no import. This module adds the
constructor from a collection (`set`) and the set algebra (`union` /
`intersection` / `difference` / `subset?`).")

(defn set (coll)
  "The set of the distinct elements of `coll` (any seqable — list, vector, another
set). Duplicates collapse: `(set [1 1 2]) ⇒ #{1 2}`."
  (fold (fn (s x) (%set-add s x)) #{} coll))
(sig set (any -> set))

;; `conj`/`disj` deliberately do NOT live here: they are prelude functions that
;; dispatch on the collection kind (a set is one), so they need no import — and a
;; module-local copy would SHADOW the polymorphic prelude ones under `(:use set)`,
;; breaking `(conj [1 2] 3)` for the rest of that file. (They were defined here
;; until 2026-07-26, on the mistaken premise that `clojure.set` does the same;
;; Clojure's `conj`/`disj` are both `clojure.core`, and polymorphic.)

(defn union (a b)
  "Every element in either `a` or `b`."
  (fold (fn (s x) (%set-add s x)) a b))
(sig union (set set -> set))

(defn intersection (a b)
  "Every element in both `a` and `b`."
  (fold (fn (s x) (if (contains? b x) (%set-add s x) s)) #{} a))
(sig intersection (set set -> set))

(defn difference (a b)
  "Every element of `a` that is not in `b`."
  (fold (fn (s x) (%set-remove s x)) a b))
(sig difference (set set -> set))

(defn subset? (a b)
  "True when every element of `a` is also in `b`."
  (fold (fn (ok x) (if ok (contains? b x) false)) true a))
(sig subset? (set set -> bool))

