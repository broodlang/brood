(defmodule ability
  "Open generic functions with nominal dispatch — Brood's unified polymorphism seam.

  ONE concept, value dispatch on the FIRST argument's *identity*:
    - a built-in value dispatches on its `type-of` kind (`:int`, `:string`, `:map`, …);
    - an identity-carrying record (`defrecord*`) dispatches on its NOMINAL id — a
      `module/name` keyword baked in at definition — so two record shapes in one module
      dispatch apart, and a plain map (even one carrying a `:type` field) never does.

  This subsumes both jobs the old `protocol`/`behaviour` split handled separately:
    - value polymorphism (the `protocol` job): `(size x)` picks the impl by x's kind/id;
    - drivers (part of the `behaviour` job): a driver is a VALUE, so `(fetch db k)` picks
      by `db`'s id — no config magic, no module-atom dispatch. Ambient selection is a
      one-line wrapper over this, not a second mechanism. (Module-as-implementor
      contracts — `(:implements …)`, where the unit is a namespace with no dispatch
      value — remain `defbehaviour`'s job; see `std/protocol.blsp`.)

  Registration is OPEN and LATE: `impl` for any id, from any module, at any time. Each
  impl is tagged with its registering namespace (`current-ns`), and resolution is by
  **precedence tier**, not load order (ADR-172): **app** (a module in the current project's
  own package, or a root/REPL impl) > **type-owner** (owns the record) > **ability-owner**
  (owns the ability, e.g. its `:default`/built-in impls) > **other**. So the app can
  override anything, and the winner is deterministic regardless of registration order. A
  *same-tier* cross-module claim on the same `[ability op id]` is a loud conflict (last
  wins); a *same-module* re-register is hot-reload (silent); a strictly lower tier is ignored
  (a stronger owner holds the slot). The app tier reads package identity — `*ns-package*`
  (namespace → package, set at project setup) vs `*project-name*`. The advisory checker
  (`types/check/protocol.rs`) verifies each `impl` provides the ability's declared ops at the
  right arity, at `nest check` time.

  Two registries, mirroring `protocol`:
    *abilities* — name → declared op specs, as DATA (introspection / checker hook).
    *impls*     — [ability op] → {id → fn}. Nested so the constant
      `[ability op]` key is built once (the macro emits it as a quoted literal) and
      each call only indexes by the argument's runtime id.

  Identity representation: a record's id is a reserved `:__id__` map field holding a
  `module/name` KEYWORD — a keyword literal is what the type-checker tracks via
  `Ty::keyword_lit`, so a record's identity flows through inference; the seam that makes
  the checker nominal-aware. `json-encode` omits `:__id__` (it must never reach
  the wire); a record printing with its id, and being `≠` a bare map, are *correct*
  (Elixir-struct semantics), not leaks. The only residual is cosmetic — `keys`/`count`
  include the id; use `record?`/`record-id`/`fields` for the clean, id-free view, which
  is also the stable seam a future hidden slot swaps behind (nothing else reads `:__id__`).")

; ---- registries -------------------------------------------------------------

; ability-name → op specs (introspection / checker / LSP)
(def *abilities* {})
; ability-name → the namespace that `defability`'d it (its OWNER, ADR-172): one input to
; an impl's precedence tier — an impl from this ns is the ability-owner tier, and only this
; ns may impl the ability for a built-in id (`:int`, `:default`).
(def *ability-owner* {})
; [ability op] → {id → fn} (runtime dispatch — the fn stored directly, no wrapper)
(def *impls* {})
; [ability op id] → registering ns (provenance for conflict detection; read only at
; registration, never on dispatch — keeps the dispatch value a bare fn)
(def *impl-from* {})

(defn register-ability (aname specs &optional owner)
  "Record ability `aname`'s declared op specs (raw forms) for the checker / LSP, and its
  OWNER namespace (`defability`'s defining ns, ADR-172) for impl precedence."
  (def *abilities* (assoc *abilities* aname specs))
  (when owner (def *ability-owner* (assoc *ability-owner* aname owner)))
  nil)

(defn ability-owner-ns (aname)
  "The namespace that `defability`'d `aname` (its owner), or nil."
  (get *ability-owner* aname))

(defn ability-ops (aname)
  "The op specs declared for ability `aname` (or nil) — which ops an `impl` must
  provide, with what arities."
  (get *abilities* aname))

; ability-name → its SEALED member ids (a closed set), or absent if open
(def *sealed* {})

(defn register-sealed (aname members)
  "Record ability `aname`'s SEALED member ids — the closed set of identities it is meant
  to be implemented for. The checker uses this for exhaustiveness: every member must have
  an impl of every declared op. Runtime dispatch is unaffected (sealing is a contract)."
  (def *sealed* (assoc *sealed* aname members))
  nil)

(defn sealed-members (aname)
  "The sealed member ids of ability `aname` (a list of keyword ids), or nil if open."
  (get *sealed* aname))

; ---- dispatch identity ------------------------------------------------------

(defn identity-of (x)
  "The dispatch identity of `x`: its nominal record id (a `module/name` keyword) if it
  is an identity-carrying record, else its `type-of` kind. This — with `record?` /
  `record-id` / `fields` — is the one seam a later kernel slot swaps behind; nothing
  outside this module reads `:__id__` directly."
  ; one hash on the hot path: `get` (not `contains?` + `get`). `:__id__` is a reserved
  ; keyword a record always carries and is never nil, so a present id is truthy.
  (if (map? x)
    (let (id (get x :__id__))
      (if id id (type-of x)))
    (type-of x)))

(defn record? (x)
  "True if `x` is an identity-carrying record (a `defrecord*` value)."
  (and (map? x) (contains? x :__id__)))

(defn record-id (x)
  "The nominal id (`module/name` keyword) of record `x`, or nil if `x` is not a record.
  Unlike `identity-of`, never falls back to `type-of`."
  (if (record? x) (get x :__id__) nil))

(defn fields (x)
  "The FIELDS of record `x` as a plain map — its identity omitted. The clean view for
  code that wants a record's data without the internal id (`keys`/`count`/serialization
  over this see only fields). A plain map is returned unchanged."
  (if (record? x) (dissoc x :__id__) x))

; ---- registration -----------------------------------------------------------

; The owning module of a record id keyword `:mod/name` (as a string), or nil for a
; built-in id (`:int`, `:default` — no `/`). The record NAME is the final `/`-segment, so
; the module is everything BEFORE the last `/` — a nested module keeps all its segments
; (`:editor/display/frame` → `editor/display`, not `editor`). Used to place an impl in the
; tier ladder: an impl whose registering ns equals this owns the type.
(defn impl--id-owner (key)
  (if (keyword? key)
    (let (parts (string-split (name key) "/"))
      (if (> (count parts) 1)
        (join "/" (take (- (count parts) 1) parts))
        nil))
    nil))

; True if module `from` belongs to the current project's OWN package (ADR-172): its
; `*ns-package*` entry (set at project setup) equals `*project-name*`. Guarded with `bound?`
; so abilities still work when no project is loaded (a bare `brood script.blsp` — those
; ambients are undeclared then). Root/REPL (`from` = nil) is handled by the caller as the app.
(defn impl--app? (from)
  (and from
    (bound? '*project-name*) *project-name* (bound? '*ns-package*)
    (= (get *ns-package* from) *project-name*)))

(defn impl-rank (aname key from)
  ;; Precedence tier (ADR-172 §3), higher wins: **app (4) > type-owner (3) > ability-owner
  ;; (2) > other (1)**. `from` = nil is the root/REPL — the user IS the app, so app tier; a
  ;; module whose package is the project's own is likewise the app. Otherwise `from` owns the
  ;; record's type (id-owner) or the ability (its `:default`/built-in impls), else it's other.
  ;; Guard the nil/app cases before `(name from)`.
  (if (or (nil? from) (impl--app? from))
    4
    (let (from-name (name from)
          id-owner (impl--id-owner key)
          abl-owner (let (o (ability-owner-ns aname)) (if o (name o) nil)))
      (cond
        (= from-name id-owner) 3
        (= from-name abl-owner) 2
        else 1))))

(defn register-impl (aname op key f from)
  "Register impl `f` of `aname`'s `op` for dispatch id `key`, tagged with the registering
  namespace `from`. Resolution is by PRECEDENCE, not load order (ADR-172 §3): the impl with
  the highest tier for a `(aname, op, key)` slot wins, computed by `impl-rank`, so the result
  is deterministic regardless of registration order. A same-tier re-register from a DIFFERENT
  `from` is a genuine cross-module conflict (warned; last wins); from the SAME `from` it is
  hot-reload (silent); a strictly lower-tier registration is ignored (a higher tier holds the
  slot). Read-modify-write of `*impls*` — register at load time, as top-level `impl` does."
  (let (op-key [aname op]
        methods (or (get *impls* op-key) {})
        prov-key [aname op key]
        ; presence, not truthiness: a root/REPL/app incumbent records `from` = nil, so a
        ; nil `prev-from` is ambiguous between "no incumbent" and "incumbent was the app".
        ; Keying off `contains?` keeps a later lower tier from displacing an app impl.
        has-prev (contains? *impl-from* prov-key)
        prev-from (get *impl-from* prov-key)
        new-rank (impl-rank aname key from)
        ; recompute the incumbent's tier from its recorded `from` — no extra registry.
        old-rank (if has-prev (impl-rank aname key prev-from) 0))
    (when (and has-prev (= new-rank old-rank) (not (= prev-from from)))
      (println "warning: ability "
        aname "/" op " for " key " — same-tier impl from " prev-from " overridden by " from
        " (last wins)"))
    ; Store the winner only when the new impl's tier is >= the incumbent's — so a higher tier
    ; always holds the slot and order can't decide it. A strictly lower tier is dropped (its
    ; owner already has a stronger claim). The fn is stored DIRECTLY so dispatch (`impl-for`)
    ; stays a plain map-get; provenance in *impl-from* is read only here, never on dispatch.
    (when (>= new-rank old-rank)
      (def *impls* (assoc *impls* op-key (assoc methods key f)))
      (def *impl-from* (assoc *impl-from* prov-key from)))
    nil))

(defn impl-for (op-key key)
  "The impl fn of op `op-key` (a `[ability op]` pair) for id `key`, falling back to a
  `:default` impl, or nil. One map fetch for the op's method set, then one by id."
  (let (methods (get *impls* op-key))
    (or (get methods key) (get methods :default))))

(defn no-impl (op-key key)
  "The loud, located error an op raises when no impl (and no `:default`) covers id
  `key`. Names the ability, the op, the id, and lists the ids that ARE implemented."
  (let (aname (first op-key)
        op (second op-key)
        known (keys (or (get *impls* op-key) {})))
    (if (empty? known)
      (error "ability " aname "/" op ": no impl for " key)
      (error "ability " aname "/" op ": no impl for " key " — have " known))))

(defn satisfies? (aname x)
  "True if ability `aname` is implemented for `x`'s identity — every declared op
  resolves (directly or via `:default`). Lets a caller branch instead of letting the op
  raise the missing-impl error. False for an unknown ability."
  (let (key (identity-of x)
        ops (ability-ops aname))
    (if ops
      (every? (fn (spec) (impl-for [aname (first spec)] key)) ops)
      false)))

; ---- macros -----------------------------------------------------------------

(defn defability--sealed-vec (specs)
  "The vector following `:sealed` in a `defability`'s specs (its closed member set), or nil."
  (cond
    (empty? specs) nil
    (= (first specs) :sealed) (second specs)
    else (defability--sealed-vec (rest specs))))

(defn ability--id-kw (m)
  "The dispatch-id keyword for an impl / sealed-member id `m`. A keyword is kept as-is
  (`:int`, `:default`); a bare record symbol is qualified against the current ns
  (`circle` → `:<ns>/circle`, matching what `defrecord*` bakes into a value); an already-
  qualified symbol is keyworded as-is (`geo/circle` → `:geo/circle`). Shared by `impl`
  and `:sealed` so they agree on a bare id — otherwise `(impl S circle …)` would register
  under `:circle` while a value presents `:<ns>/circle` and never match (KI-15)."
  (if (symbol? m)
    (if (includes? (name m) "/")
      (keyword (name m))
      (keyword (str (name (current-ns)) "/" (name m))))
    m))

(defmacro defability (aname & specs)
  "Declare ability `aname`. Each op spec `(op [args…] :-> ret?)` becomes a generic
  function dispatching on its first argument's identity. An optional leading docstring
  is allowed. Records the specs in *abilities* for the checker / LSP.

  An optional `:sealed [id …]` clause names the CLOSED set of member ids the ability is
  meant to cover; the checker then flags any member missing an impl of any op
  (exhaustiveness). A bare record symbol is qualified with the current ns.

    (defability Size  (size [self] :-> int))
    (defability Store (fetch [self k]) (put [self k v]))
    (defability Shape :sealed [circle rect] (area [self] :-> float))"
  (let (ops (filter (fn (s) (pair? s)) specs)
        sealed-vec (defability--sealed-vec specs)
        sealed-ids (if sealed-vec (map ability--id-kw sealed-vec) nil)
        ; pass `(current-ns)` as the owner — evaluated at load in the DEFINING module, so
        ; `*ability-owner*` records where the ability was declared (ADR-172 precedence).
        reg (cons (list 'ability/register-ability
                    (list 'quote aname) (list 'quote ops) (list 'current-ns))
              (if sealed-ids
                (list (list 'ability/register-sealed
                        (list 'quote aname) (cons 'list sealed-ids)))
                nil))
        op-defs (map
                  (fn (op)
                    (let (op-name (first op)
                          ; arg vector → list; dispatch reads the FIRST arg's identity
                          arg-syms (map (fn (s) s) (second op))
                          first-arg (first arg-syms)
                          ; a *constant* [ability op] key — a quoted literal, built once
                          op-key (list 'quote [aname op-name])
                          ; gensym'd temporaries so an op arg named `k`/`f` can't be captured
                          id-sym (gensym)
                          impl-sym (gensym))
                      (list 'defn
                        op-name arg-syms
                        (list 'let
                          (list id-sym
                            (list 'ability/identity-of first-arg) impl-sym
                            (list 'ability/impl-for op-key id-sym))
                          (list 'if
                            impl-sym
                            ; direct, arity-correct call — no arg-list alloc, no `apply`
                            (cons impl-sym arg-syms) (list 'ability/no-impl op-key id-sym))))))
                  ops))
    (cons 'do (append reg op-defs))))

(defmacro impl (aname key & methods)
  "Register implementations of ability `aname` for dispatch id `key` — a `type-of`
  keyword (`:int`, `:map`, …), a record's nominal id (`geometry/circle`), or `:default`.
  Open and late: from any module, any time. Each method is `(op [args…] body…)`; the
  registration is tagged with the current namespace for conflict detection.

    (impl Size :int             (size [n] n))
    (impl Size geometry/circle  (size [c] (get c :r)))"
  ; the dispatch id is a KEYWORD: a record id written as a symbol (`geometry/circle`) is
  ; keyworded to match what `identity-of` produces; a built-in id (`:int`) is already one.
  (let (id-kw (ability--id-kw key))
    (cons 'do
      (map
        (fn (m)
          (let (op-name (first m)
                ; arg vector → list
                arg-syms (map (fn (s) s) (second m))
                body (rest (rest m)))
            (list 'ability/register-impl
              (list 'quote aname) (list 'quote op-name) id-kw (cons 'fn (cons arg-syms body))
              (list 'quote (current-ns)))))
        methods))))

(defmacro defrecord* (rec fields)
  "Like `defrecord`, but constructed values carry a NOMINAL identity — a `module/name`
  symbol captured at definition — so `ability` dispatch tells them apart from other maps
  and other records. Otherwise a plain structural map: `get`/`assoc`/`=` treat it as its
  fields (plus the reserved `:__id__`; a future hidden kernel slot could remove that leak).

    (defmodule geometry)
    (defrecord* circle (r))          ; (circle 2) → {:__id__ geometry/circle :r 2}"
  ;; The id is a KEYWORD (`:module/name`), not a symbol: a keyword literal is what the
  ;; type-checker tracks (`Ty::keyword_lit`), so a record's identity flows through
  ;; inference as a literal — the seam that makes the checker nominal-aware.
  (let (id (keyword (str (name (current-ns)) "/" (name rec)))
        ;; Build a MAP LITERAL body (a real map value whose field values are the field
        ;; symbols), NOT a `(hash-map …)` call — so the checker infers the constructor's
        ;; result as a record SHAPE carrying the `:__id__` keyword literal. That is what
        ;; makes a record's identity flow through inference to call sites (the checker's
        ;; inference hook). At runtime it evaluates identically to `(hash-map …)`.
        body (apply hash-map
               (cons :__id__
                 (cons id
                   (mapcat (fn (f) (list (keyword (name f)) f)) fields))))
        ;; Emit a `sig` for the constructor so its record-shaped return type — carrying
        ;; the `:__id__` keyword literal — flows through inference to call sites: this is
        ;; what lets `(let (c (circle 2)) (size c))` be checked. Fields are `any` (records
        ;; are structural — the identity is the point).
        arg-tys (map (fn (_) 'any) fields)
        rec-ty (cons 'record
                 (cons :__id__
                   (cons id
                     (mapcat (fn (f) (list (keyword (name f)) 'any)) fields))))
        the-sig (list 'sig rec (append arg-tys (list '-> rec-ty))))
    (list 'do
      the-sig (list 'defn rec fields body))))
