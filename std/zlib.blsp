;; std/zlib.blsp — gzip / zlib / raw-deflate / brotli compression.
;;
;; Four container formats, each an
;; encode/decode pair over a byte sequence.
;;
;;   | format      | encode              | decode                | notes                       |
;;   |-------------|---------------------|-----------------------|-----------------------------|
;;   | gzip        | `zlib/gzip`         | `zlib/gunzip`         | RFC 1952, `Content-Encoding`|
;;   | zlib        | `zlib/compress`     | `zlib/uncompress`     | RFC 1950, header + Adler-32 |
;;   | raw deflate | `zlib/zip`          | `zlib/unzip`          | RFC 1951, no header         |
;;   | brotli      | `zlib/brotli`       | `zlib/unbrotli`       | RFC 7932, `Content-Encoding: br`|
;;
;; The gzip/zlib/deflate encoders are Brood over the `flate2` prims; brotli is Brood over the
;; `%brotli`/`%unbrotli` prims (the `brotli` crate). Input is *iodata* — a string (UTF-8 encoded
;; first) or any byte sequence; output is always a `bytes` value.
;;
;; The three encoders take an optional compression `level`, 0-9 (0 = store, 9 = best;
;; default 6). Reach for 9 when the compressed form is written once and served many
;; times (a precompressed static asset); the default trades a little ratio for speed,
;; which is what per-request compression wants.

(defmodule zlib
  "gzip / zlib / raw-deflate compression.

    (zlib/gunzip (zlib/gzip \"hello\"))   ;; => the bytes of \"hello\"
    (utf8-bytes->string (zlib/gunzip (zlib/gzip \"hello\")))  ;; => \"hello\"

  `gzip`/`compress`/`zip` accept a string or a byte sequence; the `gunzip`/
  `uncompress`/`unzip` inverses take compressed `bytes` and raise on invalid input.")

(defn- as-bytes
  (data)
  "Coerce iodata to a byte sequence: a string is UTF-8-encoded, bytes pass through."
  (if (string? data) (string->utf8-bytes data) data))

;; ---- gzip (RFC 1952) — the HTTP `Content-Encoding: gzip` format ----

(defn gzip (data &optional level)
  "gzip-compress `data` (a string or byte sequence), returned as `bytes`. This is the
  `Content-Encoding: gzip` wire format. Optional `level` is 0-9 (0 = store, 9 = best; default
  6). Inverse: `gunzip`."
  (if (nil? level) (%gzip (as-bytes data)) (%gzip (as-bytes data) level)))

(defn gunzip (data)
  "Decompress gzip `bytes` back to a `bytes` value. Raises on data that isn't valid gzip."
  (%gunzip data))

;; ---- zlib (RFC 1950) — 2-byte header + Adler-32 checksum ----

(defn compress (data &optional level)
  "zlib-compress `data` (a string or byte sequence), returned as `bytes`. Optional `level` is
  0-9 (default 6). Inverse: `uncompress`."
  (if (nil? level) (%zlib-compress (as-bytes data)) (%zlib-compress (as-bytes data) level)))

(defn uncompress (data)
  "Decompress zlib `bytes` to a `bytes` value. Raises on invalid data."
  (%zlib-uncompress data))

;; ---- raw deflate (RFC 1951) — no header or checksum ----

(defn unzip (data)
  "Decompress raw-DEFLATE `bytes` to a `bytes` value. Raises on invalid data."
  (%inflate data))

;; ---- brotli (RFC 7932) — the HTTP `Content-Encoding: br` format ----

(defn brotli (data &optional quality)
  "Brotli-compress `data` (a string or byte sequence), returned as `bytes`. This is the
  `Content-Encoding: br` wire format, which beats gzip on text. Optional `quality` is 0-11
  (0 = fastest, 11 = best; default 5). Inverse: `unbrotli`."
  (if (nil? quality) (%brotli (as-bytes data)) (%brotli (as-bytes data) quality)))

(defn unbrotli (data)
  "Decompress brotli `bytes` back to a `bytes` value. Raises on data that isn't valid brotli."
  (%unbrotli data))

;; (restored: this is zlib's zip — compression, not the sequence pairing)
(defn zip (data &optional level)
  "Raw-DEFLATE-compress `data` (a string or byte sequence), returned as `bytes` — no
  gzip/zlib header or checksum. Optional `level` is 0-9 (default 6). Inverse: `unzip`."
  (if (nil? level) (%deflate (as-bytes data)) (%deflate (as-bytes data) level)))
