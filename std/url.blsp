;; std/url.blsp — URL encoding/decoding and parsing, written entirely in Brood.
;;
;; Provides percent-encoding (RFC 3986 unreserved characters are left as-is),
;; query-string encoding/decoding (with + for space), URL parsing/building.

(defmodule url
  "URL encoding/decoding and parsing, written entirely in Brood (pure; opt-in).

    (url/percent-encode \"hello world\")   ;; => \"hello%20world\"
    (url/percent-decode \"hello%20world\") ;; => \"hello world\"
    (url/query-encode {:q \"hello world\" :n \"42\"}) ;; => \"n=42&q=hello+world\"
    (url/query-decode \"q=hello+world&n=42\") ;; => {\"q\" \"hello world\" \"n\" \"42\"}
    (url/parse \"https://example.com:8080/path?q=1#frag\")
    ;; => {:scheme \"https\" :host \"example.com\" :port 8080 :path \"/path\"
    ;;     :query \"q=1\" :fragment \"frag\"}
    (url/build {:scheme \"https\" :host \"example.com\" :path \"/search\"
                    :query-params {:q \"hello world\"}})
    ;; => \"https://example.com/search?q=hello+world\"")

;; ---- percent-encoding -------------------------------------------------------

(defn- unreserved? (cp)
  "True if byte `cp` is an RFC 3986 unreserved character (§2.3): A-Z a-z 0-9 - _ . ~"
  (or (and (>= cp 65) (<= cp 90))
    (and (>= cp 97) (<= cp 122))
    (and (>= cp 48) (<= cp 57))
    (includes? [45 95 46 126] cp)))

(defn- encode-bytes (s space)
  "`s`'s UTF-8 bytes with unreserved ASCII as-is, a space as `space`, and every other
byte as %XX (uppercase hex)."
  (string/join (map (seq (string/->bytes s))
                 (fn (b)
                   (cond
                     (unreserved? b) (string/int->char b)
                     (= b 32) space
                     else (str "%" (encoding/hex-encode-bytes-upper [b])))))
    ""))

(defn percent-encode (s)
  "Percent-encode string `s` for use in a URL path or query component. Every byte
that is not an RFC 3986 unreserved character (A-Z a-z 0-9 - _ . ~) is encoded as
%XX (uppercase hex). Multi-byte UTF-8 sequences are encoded byte-by-byte.

    (url/percent-encode \"a b\")   ;=> \"a%20b\""
  (encode-bytes s "%20"))

;; ---- percent-decoding -------------------------------------------------------

;; `s` is a CODE-POINT VECTOR (built once in `percent-decode`), so char access is
;; O(1) `nth` — `char-at` on the raw UTF-8 string is O(i), making the scan O(n^2).
(defn- decode-loop (s i n acc)
  "Decode percent-encoded code-point vector `s` (count `n`), accumulating decoded bytes
into `acc`; the decoded byte list, or `:invalid` for an incomplete or non-hex %XX (decoding
it literally would hand back text that looks decoded and isn't)."
  (cond
    (>= i n) (reverse acc)
    (not (= (nth s i) "%")) (decode-loop s (+ i 1) n (%reverse-onto (string/->bytes (nth s i)) acc))
    (>= (+ i 2) n) :invalid
    else
      (let (byte (encoding/hex-decode-bytes (str (nth s (+ i 1)) (nth s (+ i 2)))))
        (if (failure? byte) :invalid (decode-loop s (+ i 3) n (cons (bytes/at byte 0) acc))))))

(defn percent-decode (s)
  "Decode percent-encoded sequences in `s` → the original string, or a `failure` when
`s` contains an invalid or incomplete %XX sequence, or decodes to bytes that are not
UTF-8.

    (url/percent-decode \"a%20b\")          ;=> \"a b\"
    (failure? (url/percent-decode \"a%ZZ\"))   ;=> true
    (failure? (url/percent-decode \"%FF\"))    ;=> true"
  (let (v (into [] (string/->list s))
        r (decode-loop v 0 (count v) nil)
        ;; `%FF` is well-formed percent-encoding of a byte that is not UTF-8, and the
        ;; decoder RAISES on it. The byte list is ints 0–255, so not-UTF-8 is the only way
        ;; the decode can raise.
        ;; check-allow :discarded-catch — the raise IS the answer: nil means "not UTF-8"
        text (if (= r :invalid)
               nil
               (check-allow :discarded-catch (try (string/bytes-> r) (catch _ nil)))))
    (cond
      (= r :invalid) (failure "url/percent-decode: invalid percent-encoding: " (pr-str s))
      (nil? text) (failure "url/percent-decode: not UTF-8 once decoded: " (pr-str s))
      else text)))

;; ---- query string encoding --------------------------------------------------
;;
;; application/x-www-form-urlencoded: space → +, rest percent-encoded (same
;; unreserved set). Keys and values are percent-encoded individually.

(defn query-encode (params)
  "Encode a map of string→string (or keyword→string) params as a
`key=value&key=value` query string, percent-encoding keys and values and using
`+` for spaces. Keys are sorted for deterministic output. A non-string value is rendered
with `->string` (the `Display` protocol), so a record encodes as the string its type
defines rather than as its field map.

    (url/query-encode {:a 1})    ;=> \"a=1\""
  (let (pairs (sort (map (%map-pairs params)
                      (fn ([k v]) [(if (keyword? k) (->string k) (str k)) (->string v)]))))
    (string/join (map pairs (fn ([k v]) (str (encode-bytes k "+") "=" (encode-bytes v "+"))))
      "&")))

;; ---- query string decoding --------------------------------------------------

(defn- url-qdecode-str (s)
  "Decode a query-string value: replace + with space, then percent-decode."
  (percent-decode (string/replace s "+" " ")))

(defn- url-parse-query-pairs (parts acc)
  "Parse a list of `key=value` strings into a string→string map, or the first
component's `failure` if one will not percent-decode.

A failure must NOT be stored: `(assoc acc <failure> \"\")` would put it in the map as a
key and hand the caller a structure that looks decoded, which is the corrupt-data
outcome this whole channel exists to prevent. It propagates out instead — the boundary
where a decoded query stops being decodable is the query, not one field."
  (if (empty? parts)
    acc
    (let (part (first parts)
          eq (index-of part "="))
      ;; `with`, not a `cond` of two `failure?` arms (ADR-315): "the first component that
      ;; cannot be decoded is the answer" is what this says, and the guards were four lines
      ;; spelling it out. Either key or value may fail; whichever does falls out.
      (with (k (url-qdecode-str (if (< eq 0) part (string/substring part 0 eq)))
              v
              (if (< eq 0)
                ""
                (url-qdecode-str (string/substring part (+ eq 1) (string/length part)))))
        (url-parse-query-pairs (rest parts) (assoc acc k v))))))

(defn query-decode (s:string -> (or map failure))
  "Parse a query string `key=value&key=value` into a string→string map,
decoding + as space and %XX sequences — or a `failure` if any component carries an
invalid %XX sequence (the failure propagates rather than landing in the map).

    (url/query-decode \"a=1\")     ;=> {\"a\" \"1\"}"
  (if (= s "")
    {}
    (url-parse-query-pairs (string/split s "&") {})))

;; ---- URL parsing ------------------------------------------------------------
;;
;; parse returns {:scheme :host :port :path :query :fragment}
;; port is an integer when present in the URL, nil otherwise.

(defn- url-split-first (s sep)
  "Split `s` on the first occurrence of `sep`; return `[before after]` or nil if
`sep` is absent."
  (let (i (index-of s sep))
    (if (< i 0)
      nil
      [(string/substring s 0 i) (string/substring s (+ i (string/length sep)) (string/length s))])))

;; An RFC-3986 authority is `[userinfo@]host[:port]`, and `host` may be a **bracketed
;; IPv6 literal** (`[::1]`) — which itself contains colons, so neither split is on the
;; first colon. Reading userinfo as the host is a security bug, not a parse nit:
;; `https://evil.com@good.com/` must report host `good.com`, or an allow-list or SSRF
;; guard built on `:host` checks a different host than the one a client connects to.
(defn- url-authority-split (hostport)
  "Split a `host[:port]` (userinfo already removed) into `[host port-str]`, honouring
a bracketed IPv6 literal. `port-str` is nil when no `:port` is present."
  (if (string/starts-with? hostport "[")
    (let (close (index-of hostport "]"))
      (if (< close 0)
        (error "url: unterminated IPv6 literal in authority: " (pr-str hostport))
        (let (host (string/substring hostport 0 (+ close 1))
              tail (string/substring hostport (+ close 1) (string/length hostport)))
          (cond
            (= tail "") [host nil]
            (string/starts-with? tail ":") [host (string/substring tail 1 (string/length tail))]
            else (error "url: junk after the IPv6 literal in authority: " (pr-str hostport))))))
    (let (colon (index-of hostport ":"))
      (if (< colon 0)
        [hostport nil]
        [(string/substring hostport 0 colon)
          (string/substring hostport (+ colon 1) (string/length hostport))]))))

(defn- url-parse-port (port-str)
  ;; An unparseable port raises: nil would read as "no port given" and fall back to the
  ;; scheme's default, somewhere the URL never named. An EMPTY port (`host:`) is nil:
  ;; RFC 3986 §3.2.3 defines that as "use the scheme's default".
  ;; A port is DIGITs only (RFC 3986 §3.2.3): `string/->number` also reads `+80`, which
  ;; a client may resolve differently, so the digits are checked before the number.
  (cond
    (nil? port-str) nil
    (= port-str "") nil
    else
      (let (n (if (every? (string/->codepoints port-str) (fn (cp) (and (>= cp 48) (<= cp 57))))
                (string/->number port-str)
                nil))
        (if (and (int? n) (>= n 0) (<= n 65535))
          n
          (error "url: invalid port " (pr-str port-str) " — expected an integer 0..65535")))))

;; RFC 3986 §3.1: `scheme = ALPHA *( ALPHA / DIGIT / "+" / "-" / "." )`. Splitting on the
;; first `://` alone read `/r/https://evil.com/` as scheme `/r/https` — a relative path
;; reported as an absolute URL, which an open-redirect guard asking "is there a scheme?"
;; gets backwards.
(defn- url-scheme? (s)
  (let (cps (string/->codepoints s))
    (and (not (empty? cps))
      (url-alpha? (first cps))
      (every? cps
        (fn (cp) (or (url-alpha? cp) (and (>= cp 48) (<= cp 57)) (= cp 43) (= cp 45) (= cp 46)))))))

(defn- url-alpha? (cp)
  (or (and (>= cp 65) (<= cp 90)) (and (>= cp 97) (<= cp 122))))

(defn- url-parse-authority (auth)
  "Parse an RFC-3986 authority `[userinfo@]host[:port]` into `{:userinfo :host :port}`.
`:host` keeps the brackets of an IPv6 literal (`\"[::1]\"`, which is what a Host
header and a `build` round-trip both need); `:userinfo` is nil when absent and
`:port` is an int or nil. An unparseable port raises."
  (let (at (string/last-index-of auth "@")
        ;; the LAST `@` — userinfo may itself contain an encoded one
        userinfo (if (< at 0) nil (string/substring auth 0 at))
        hostport (if (< at 0) auth (string/substring auth (+ at 1) (string/length auth)))
        [host port-str] (url-authority-split hostport))
    {:userinfo userinfo :host host :port (url-parse-port port-str)}))

(defn parse (s)
  "Parse URL string `s` into a map
`{:scheme :userinfo :host :port :path :query :fragment}`.
`:port` is an integer when present, nil otherwise (an unparseable one **raises**,
so it is never confused with `absent`). `:userinfo` is the raw `user[:pass]` before
the `@`, or nil — it is **not** part of `:host`, so an allow-list or SSRF check on
`:host` sees the host a client would actually connect to (`https://evil.com@good.com/`
→ host `good.com`). An IPv6 literal keeps its brackets (`\"[::1]\"`). `:query` and
`:fragment` are the raw (still-encoded) strings, or nil when absent. Relative URLs
(no scheme) have nil `:scheme`, `:host`, and `:port` — except a network-path reference
`//host/path`, which has a host and no scheme. A scheme is recognised only when it is
well-formed (a letter, then letters, digits, `+`, `-`, `.`), so `/r/https://x/` is a path.

    (:host (url/parse \"//evil.com/x\"))           ;=> \"evil.com\"
    (:scheme (url/parse \"/r/https://evil.com/\"))  ;=> nil"
  ;; 1. strip fragment
  (let (frag-split (url-split-first s "#")
        before-frag (if frag-split (first frag-split) s)
        fragment (if frag-split (second frag-split) nil))
    ;; 2. strip query
    (let (q-split (url-split-first before-frag "?")
          before-q (if q-split (first q-split) before-frag)
          query (if q-split (second q-split) nil))
      ;; 3. strip scheme — only a well-formed one (see `url-scheme?`)
      (let (scheme-split (url-split-first before-q "://")
            scheme (if (and scheme-split (url-scheme? (first scheme-split)))
                     (first scheme-split)
                     nil)
            ;; a network-path reference (`//host/path`, §4.2) has an authority but no
            ;; scheme; reading it as a path hid `evil.com` from every check on `:host`
            network-path? (and (nil? scheme) (string/starts-with? before-q "//"))
            rest-url (cond
                       scheme (second scheme-split)
                       network-path? (string/substring before-q 2 (string/length before-q))
                       else before-q)
            has-authority? (or scheme network-path?))
        ;; 4. split authority from path
        (let (slash (index-of rest-url "/")
              authority (cond
                          (not has-authority?) ""
                          (< slash 0) rest-url
                          else (string/substring rest-url 0 slash))
              path (cond
                     (not has-authority?) rest-url
                     (< slash 0) "/"
                     else (string/substring rest-url slash (string/length rest-url)))
              auth-map (if (= authority "")
                         {:host nil :port nil}
                         (url-parse-authority authority)))
          (merge auth-map {:scheme scheme :path path :query query :fragment fragment}))))))

;; ---- URL building -----------------------------------------------------------

(defn build (parts)
  "Build a URL string from a map
`{:scheme :userinfo :host :port :path :query-params :query :fragment}`.
`:query-params` is a map encoded via `query-encode`; `:query` is a raw query string
(used only when `:query-params` is absent). `:userinfo`, `:port` and `:fragment` are
optional — `:userinfo` is emitted as `userinfo@` before the host, so a `parse`
round-trip is lossless.

    (url/build {:scheme \"https\" :host \"example.com\" :path \"/a\" :query-params {:q \"x y\"}})   ;=> \"https://example.com/a?q=x+y\"
    (url/build {:scheme \"http\" :host \"h\" :port 8080 :path \"/p\" :fragment \"top\"})   ;=> \"http://h:8080/p#top\""
  (let (scheme (get parts :scheme)
        host (get parts :host)
        userinfo (get parts :userinfo)
        port (get parts :port)
        path (or (get parts :path) "/")
        query-params (get parts :query-params)
        query (if (nil? query-params)
                (get parts :query)
                (query-encode query-params))
        fragment (get parts :fragment)
        authority (if (nil? host)
                    ""
                    (str (if (nil? userinfo) "" (str userinfo "@"))
                      host
                      (if (nil? port) "" (str ":" port)))))
    (str (if (nil? scheme) "" (str scheme "://"))
      authority
      path
      (if (nil? query) "" (str "?" query))
      (if (nil? fragment) "" (str "#" fragment)))))
