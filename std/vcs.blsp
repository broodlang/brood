;; std/vcs.blsp — the version control a directory lives in, whichever one it is.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - Every tool that asks "which files are the project's", "what did this work change" or
;;    "what did this file say before I touched it" asked git by name: `nest format`'s file
;;    list, a package's files, the build stamp, an editor's find-file, change gutter and mode
;;    line. In a checkout of any other VCS each of those answered nothing. This module is the
;;    one place that question is put, so another VCS is a row, not an edit to every caller.
;;  - A backend is a ROW in `std/registry` (`:vcs/backends`), so a package adds a VCS by
;;    `registry/put!`. Its hooks are symbols called late (`reflect/call-if-bound`) or
;;    functions — a package's own module names are rooted under it, so a function that calls
;;    its globals is how it says "late" — and either way a redefined hook takes effect on its
;;    next call. git is the one row std puts; any other comes from that VCS's own package or
;;    the application that knows it (bedit puts mur's).
;;  - Self-contained on purpose: nothing else in std's kernel depends on it, so it can leave
;;    std for a package if it ever should (ROADMAP § Packaging & ecosystem). Its callers are
;;    `nest format --changed` and applications; each treats nil as "no checkout".
;;  - Only the MECHANISM is here: where the checkout is and the four questions every caller
;;    shares. What a VCS can DO (git's staging, a branch, a rebase) is an editor's or a tool's
;;    porcelain over its own command line, and stays there.
;;  - Every answer is opportunistic: nil when the directory is in no checkout, the program is
;;    not installed, or it fails. A caller falls back (a plain directory walk) rather than
;;    handling an error for "this is not a repository".

(defmodule vcs
  "The version control a directory lives in — git, or another a package registers —
and the questions every tool asks of it: where the checkout's top is ([[locate]]), which
files are the project's ([[files]]), which this work changed ([[changed]]), what a file said
before it was edited ([[base-text]]), and what the tree is at ([[id]])."
  (:use registry)) ; the backend table: a row per VCS, keyed by its kind

;; --- running a VCS's command line ----------------------------------------------------------

(defn- run (program:string args: (or list vector) root:string -> (or string nil))
  "`program`'s stdout for `args`, run in `root` — or nil when there is no such program, it
fails, or it exits non-zero. Every question this module asks is a READ, asked by a tool
the user did not point at git (an editor's gutter, a project's file list), so git is told
to take no optional lock: a `git status` or `git diff` would otherwise refresh the index
and write it under `index.lock`, and the user's own `git commit` at that moment fails
with \"Unable to create '.git/index.lock': File exists\"."
  (let (r (check-allow :discarded-catch
            (try
              (os/cmd program
                args
                {:cwd root :env {"GIT_TERMINAL_PROMPT" "0" "GIT_OPTIONAL_LOCKS" "0"}})
              (catch _ nil))))
    (if (and r (= (get r :exit) 0)) (get r :stdout) nil)))

(defn- fields (out:string -> (list string))
  "The NUL-separated fields of a `-z` git listing — without `-z` git writes a non-ASCII name
quoted, which no file is called."
  (seq/reject (string/split out (string/int->char 0)) empty?))

;; --- git -------------------------------------------------------------------------------------

(defn git-files (root:string -> (or (list string) nil))
  "The files of the git checkout at `root`, root-relative and sorted: tracked, and untracked
but not ignored (`.gitignore`, the global excludes), less the tracked ones deleted from the
work tree. `-z` because without it git writes a non-ASCII name quoted, which no file is
called. nil when git cannot answer.

    (vcs/git-files \"/\")   ;=> nil"
  (let (listed (run "git" ["ls-files" "-z" "--cached" "--others" "--exclude-standard"] root)
        gone (run "git" ["ls-files" "-z" "--deleted"] root))
    (if (nil? listed)
      nil
      (let (deleted (set/set (if gone (fields gone) [])))
        (sort (seq/distinct (seq/reject (fields listed) (fn (f) (contains? deleted f)))))))))

(defn- status-paths (out)
  "The paths `git status --porcelain -z` printed (`out`, or nil), in order. Each entry is
`XY path`; a rename or copy (`R` / `C`) is followed by its old path as an entry of its own,
which is not the file this work touches now, so it is skipped."
  (if (nil? out)
    []
    (:paths (fold (fields out)
              {:paths [] :skip? false}
              (fn (state entry)
                (cond
                  (:skip? state) (assoc state :skip? false)
                  (< (string/length entry) 4) state
                  else
                    {:paths (conj (:paths state) (string/substring entry 3 (string/length entry)))
                     :skip? (contains? #{"R" "C"} (string/substring entry 0 1))}))))))

(defn git-changed (root:string -> (or (list string) nil))
  "The files this work touches in the git checkout at `root`: the commits not yet upstream
(since the branch left it — `upstream...HEAD`, so commits that landed upstream meanwhile are
not this work; against `origin/main` with no upstream), the index, the work tree and the untracked files —
root-relative, sorted. nil when git cannot answer.

    (vcs/git-changed \"/\")   ;=> nil"
  (let (upstream (or (run "git"
                       ["rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{upstream}"]
                       root)
                   "origin/main")
        committed (run "git"
                    ["diff" "--name-only" "-z" (str (string/trim upstream) "...HEAD")]
                    root)
        ;; the index, the work tree and the untracked files in ONE `status`, not `git diff
        ;; HEAD` + `--cached` + `ls-files --others`: the porcelain `git diff` writes the
        ;; index it refreshes even under GIT_OPTIONAL_LOCKS=0, and `status` does not
        working (run "git" ["status" "--porcelain" "-z" "--untracked-files=all"] root))
    (if (and (nil? committed) (nil? working))
      nil
      (sort (seq/distinct (into (if committed (vec (fields committed)) []) (status-paths working)))))))

(defn git-base-text (root:string path:string -> (or string nil))
  "The text of `path` (absolute) at HEAD — what `git diff` compares the working file against.
nil for a file HEAD does not have (a new one) or outside a checkout.

    (vcs/git-base-text \"/\" \"/no-such-file\")   ;=> nil"
  ;; `HEAD:./name` from the file's own directory: git reads `./` against the cwd, so a file in
  ;; a subdirectory needs no root-relative spelling worked out here
  (run "git" ["show" (str "HEAD:./" (path/basename path))] (path/dirname path)))

(defn git-id (root:string -> (or map nil))
  "What the git checkout at `root` is at: `{:id <short sha> :dirty? <work tree differs>}`, or
nil before the first commit or outside a checkout.

    (vcs/git-id \"/\")   ;=> nil"
  (let (sha (run "git" ["rev-parse" "--short=12" "HEAD"] root))
    (if (nil? sha)
      nil
      {:id (string/trim sha)
       :dirty? (not (empty? (string/trim (or (run "git" ["status" "--porcelain"] root) ""))))})))

;; --- the backends ----------------------------------------------------------------------------
;; git ranks 20, leaving room before it: a VCS that can take over a git clone in place
;; registers a lower rank, so a directory holding both markers is the newer one's.

(registry/put! :vcs/backends
  :git {:rank 20
   :marker ".git" ; a directory in a clone, a file in a worktree or submodule
   :files 'vcs/git-files
   :changed 'vcs/git-changed
   :base-text 'vcs/git-base-text
   :id 'vcs/git-id})

(defn backends (-> list)
  "The registered backends as `[kind row]`, in rank order — the order [[locate]] tries them in
one directory. A row is `{:rank :marker :files :changed :base-text :id}`: the marker its
checkout's top holds, and each question as a symbol (called late) or a function, called with
the checkout's root first (`:base-text` then the file's absolute path). A row may leave a
question out: it is nil.

    (includes? (map (vcs/backends) first) :git)   ;=> true"
  (map (registry/ranked :vcs/backends) (fn (row) [(first row) (second row)])))

(defn- marked-here (dir:string rows:seqable -> any)
  (seq/find rows (fn (row) (file/exists? (path/join dir (:marker (second row)))))))

(defn- locate-from
  (dir:string rows:seqable limit:int -> (or (record :kind keyword :root string) nil))
  (let (found (marked-here dir rows))
    (cond
      found {:kind (first found) :root dir}
      (or (<= limit 0) (= dir (path/dirname dir))) nil
      else (locate-from (path/dirname dir) rows (dec limit)))))

(defn locate (dir:string -> (or (record :kind keyword :root string) nil))
  "The checkout `dir` is in: `{:kind :git :root \"/src/app\"}` — the nearest directory, walking
up from `dir` itself, that holds a backend's marker, so a checkout nested inside another's
tree is its own. In one directory with two markers the backend ranked first wins.
nil when `dir` is in none.

    (vcs/locate \"/\")   ;=> nil"
  (locate-from (path/absolute dir) (backends) 64))

(defn kind (dir:string -> (or keyword nil))
  "The kind of checkout `dir` is in (`:git`, or a registered backend's kind), or nil.

    (vcs/kind \"/\")   ;=> nil"
  (:kind (locate dir)))

(defn root (dir:string -> (or string nil))
  "The top of the checkout `dir` is in, or nil.

    (vcs/root \"/\")   ;=> nil"
  (:root (locate dir)))

(defn- ask (dir:string hook:keyword & args)
  "Put `hook`'s question to the backend of the checkout `dir` is in, its root first and then
`args` — nil outside a checkout, or for a question that backend's row does not answer."
  (let (where (locate dir)
        row (and where (registry/lookup :vcs/backends (:kind where)))
        answers (and row (get row hook)))
    (cond
      (symbol? answers) (apply reflect/call-if-bound answers nil (cons (:root where) args))
      (fn? answers) (apply answers (cons (:root where) args))
      else nil)))

;; Trusted, not verified: each question is answered by a backend's hook, called late, so the
;; checker cannot see its result. The row's hooks are held to these types by the contract
;; `backends` documents: git's here declares them.
(check-allow :trusted
  (defn files (dir:string -> (or (list string) nil))
    "The files of the checkout `dir` is in, relative to its root and sorted: what the VCS counts
as the project's (tracked, and new files it does not ignore). nil outside a checkout, or when
the VCS cannot answer — walk the directory instead.

    (vcs/files \"/\")   ;=> nil"
    (ask dir :files)))

(check-allow :trusted
  (defn changed (dir:string -> (or (list string) nil))
    "The files the work in progress touches in the checkout `dir` is in, relative to its root:
git's commits not yet upstream and its uncommitted edits, or what another backend counts as
the work. nil outside a checkout.

    (vcs/changed \"/\")   ;=> nil"
    (ask dir :changed)))

(check-allow :trusted
  (defn base-text (path:string -> (or string nil))
    "What the file at `path` said before the work in progress — the text the VCS compares it
against (git's HEAD) — so an editor can mark the lines changed while the file is still
being typed. nil for a new file, or one in no checkout.

    (vcs/base-text \"/no-such-file\")   ;=> nil"
    (let (absolute (path/absolute path)) (ask (path/dirname absolute) :base-text absolute))))

(check-allow :trusted
  (defn id (dir:string -> (or map nil))
    "What the checkout `dir` is in is at: `{:id <the VCS's short name for it> :dirty? <changed
since>}`, as a build stamp wants it. nil outside a checkout, or before anything is committed.

    (vcs/id \"/\")   ;=> nil"
    (ask dir :id)))
