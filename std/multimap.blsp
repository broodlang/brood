;; std/multimap.blsp — multi-valued maps.
;;
;; A multimap is a map from keys to lists of values, wrapped in a `multimap` RECORD.
;; Values are prepended on insert, so `get` returns them in reverse insertion
;; order; use `get-all` to get insertion order (at the cost of a reverse). Across KEYS the
;; order is UNSPECIFIED — the CHAMP trie's, which follows keyword interning and so is not
;; even stable across processes. `keys`/`values`/`->seq` all inherit it; sort if it matters.
;;
;; The record wraps the inner map rather than *being* it: a record carries its identity
;; in a reserved `:__id__` field, which `keys`/`count` would see — so a bare-map
;; representation would have leaked `:__id__` out of `keys` and counted it in
;; `empty?`. Wrapping keeps the inner map pristine and buys the identity:
;; `multimap?` is a real predicate, a multimap is never `=` to a plain key→list map, and
;; it prints as itself.

(defmodule multimap
  "Multi-valued map: one key may have multiple associated values.

    (let (mm (-> (multimap/empty)
                 (multimap/assoc :color \"red\")
                 (multimap/assoc :color \"blue\")
                 (multimap/assoc :size  \"large\")))
      (multimap/get-all mm :color))   ;; => (\"red\" \"blue\")
      (count mm)               ;; => 3

A multimap is a **record** wrapping a key→list map, so it is its own type rather than a
map that happens to hold lists: `multimap?` is a real predicate, it is never `=` to a
look-alike map, and it prints as `#<multimap …>` (`->map` is the plain-map view,
`inspect` the full contents).")

(defrecord multimap (entries))

;; The bare `multimap?` type predicate lives in the prelude alongside `set?`/`map?` (ADR-236).

(defn empty ()
  "An empty multimap."
  (multimap {}))

(defn empty? (mm)
  "True if the multimap has no entries.

    (multimap/empty? (multimap/empty))   → true"
  (= (count (/get mm :entries)) 0))

(defn assoc (mm k v)
  "Return a multimap with value `v` added under key `k`."
  (let (entries (/get mm :entries))
    (multimap (/assoc entries k (cons v (/get entries k nil))))))

(defn assoc-all (mm k vs)
  "Return a multimap with all values in list `vs` added under key `k`."
  (fold (fn (m v) (assoc m k v)) mm vs))

(defn get (mm k)
  "All values for key `k` in reverse insertion order, or nil if absent.

Always reach for this rather than the bare `get`: a multimap is a record, so `(get mm k)`
takes the record-FIELD path and silently answers nil for a key that holds values.

    (multimap/get (multimap/assoc (multimap/assoc (multimap/empty) :k 1) :k 2) :k)   → (2 1)"
  (/get (/get mm :entries) k nil))

(defn get-all (mm k)
  "All values for key `k` in insertion order (oldest first), or nil if absent.

    (multimap/get-all (multimap/assoc (multimap/assoc (multimap/empty) :k 1) :k 2) :k)   → (1 2)"
  (reverse (get mm k)))

(defn contains? (mm k)
  "True if `k` has at least one value in the multimap.

    (multimap/contains? (multimap/assoc (multimap/empty) :k 1) :k)   → true"
  (not (nil? (get mm k))))

(defn dissoc (mm k)
  "Return a multimap with all values for key `k` removed."
  (multimap (/dissoc (/get mm :entries) k)))

(defn remove-value (mm k v)
  "Return a multimap with the first occurrence of `v` removed from key `k`.
If no values remain under `k`, the key is dropped."
  (let (entries (/get mm :entries)
        vs (/get entries k nil))
    (if (nil? vs)
      mm
      (let (new-vs (remove-first vs v))
        (if (nil? new-vs)
          (multimap (/dissoc entries k))
          (multimap (/assoc entries k new-vs)))))))

(defn- remove-first
  (lst v)
  ;; Tail-recursive: accumulate the (reversed) skipped prefix and splice once at
  ;; the match, so removing from a long value list can't overflow the stack.
  (letrec (go (fn (acc xs)
                (cond
                  (nil? xs) (reverse acc)
                  (= (first xs) v) (%reverse-onto acc (rest xs))
                  else (go (cons (first xs) acc) (rest xs)))))
    (go nil lst)))

;; A multimap joins the collection protocol (ADR-172 §7): its `Seqable` view is its
;; flattened `[k v]` associations (insertion order), so `count`/`map`/`filter`/`fold`/
;; `for`/`into`-from work over the associations directly. `Conjable` takes a `[k v]` PAIR
;; (or a map), exactly as `conj` on a plain map does — the pair convention is how one
;; element carries two things, so the earlier "an association needs a key, which conj's
;; single element can't carry" reasoning does not actually rule it out.
;;
;; Joining `Seqable` makes every bare collection op resolve on a multimap. One of them used
;; to answer WRONGLY and is now fixed; the other differs legitimately.
;;
;; `get` is FIXED (2026-08-27). It answered `nil` for a key holding values, because a
;; multimap is a record and bare `get` took the record-FIELD path — reporting "no such
;; field" as "no such key", a wrong value rather than an error (ADR-254). Bare `get` now
;; consults the `Lookup` ability when a map lookup comes back empty, and this type
;; implements it, so `(get mm k)` and `(multimap/get-all mm k)` agree.
;;
;; `keys` is fixed the same way, through `Lookup`'s `-keys`: it read the `Seqable` view and
;; answered one key per VALUE. `keys` and `vals` are GONE with it — bare
;; `keys` and `vals` now give the same answers they did, so keeping them would be two names
;; for one function.
(impl Lookup
  multimap/multimap
  (-get [mm k] (get-all mm k))
  ;; `/get`, not bare `get`: inside this module bare `get` is `multimap/get`, so it would
  ;; look up a KEY named `:entries` in the contents and find nothing.
  (-keys [mm] (/keys (/get mm :entries))))
(impl Conjable
  multimap/multimap
  (-conj [mm x]
    (cond
      (and (vector? x) (= (count x) 2)) (assoc mm (nth x 0) (nth x 1))
      (map? x) (fold (fn (m kv) (assoc m (nth kv 0) (nth kv 1))) mm (seq x))
      else (error "conj: adding to a multimap takes a [key value] pair or a map, got "
             (pr-str x)))))
(impl Seqable
  multimap/multimap
  (->seq [mm]
    (mapcat (fn (pair) (map (fn (v) [(first pair) v]) (reverse (second pair))))
      (%map-pairs (/get mm :entries)))))

(defn map-vals (mm f)
  "Return a multimap where each value list has been transformed by `(f key values-list)`."
  (multimap (fold (fn (m pair)
                    (let (k (first pair)
                          vs (second pair))
                      (/assoc m k (f k vs))))
              {}
              (%map-pairs (/get mm :entries)))))

(defn ->map (mm)
  "Flatten the multimap to a plain map from key → list-of-values (insertion order)."
  (fold (fn (m pair)
          (/assoc m (first pair) (reverse (second pair))))
    {}
    (%map-pairs (/get mm :entries))))

;; `Display` is the O(1) summary (how many keys, how many pairs); `Inspect` shows the
;; whole thing — the plain-map view, so a log line reads as data rather than a wrapper.
(impl Display
  multimap/multimap
  (->string [mm]
    (str "#<multimap "
      (count (keys mm))
      " keys, "
      (count mm)
      " pairs>")))

(impl Inspect
  multimap/multimap
  (inspect [mm] (str "#<multimap " (pr-str (->map mm)) ">")))
