;; Brood prelude / core library
;; ------------------------------
;; Most of the language lives here, in Brood itself. Rust provides only a small
;; primitive kernel (see crates/lisp/src/builtins.rs — the `%`-prefixed ops and
;; a few constructors/predicates); everything below is ordinary Brood.
;;
;; Style note: code is made of lists, so parameter lists are written as lists —
;; (defn f (x y) ...). Vectors [ ] are a *data* type (O(1) indexing); they are
;; still accepted in parameter/binding positions, but lists are idiomatic.
;;
;; The very first definition is `defn`, a macro. Everything after it is written
;; with `defn`, so the library is defined exactly the way you would define your
;; own functions — including `+`, which is "just a function".

;; ---- bootstrap: the list builders the quasiquote expander emits ----
;; `quasiquote` is a compile/eval-time transform: `` `(a ~b ~@c) `` becomes builder
;; code `(append (list 'a) (list b) c)`. The very first macro below (`defn`) already
;; uses a backtick template, so the symbols that builder code names must be bound
;; before any prelude form runs. `cons`/`vector`/`hash-map`/`apply` are kernel
;; builtins; `list` and `append` are not — so seed minimal versions here (raw
;; `def`/`fn`, no backtick, no quasiquote dependency). The full seq-generic,
;; tail-recursive `list`/`append` further down simply `def`-rebind these.
(def list (fn (& xs) "A list of the given arguments." xs))
(def append--empty?
  (fn (x)
    (if (%eq (type-of x) :nil)
      true
      (if (%eq (type-of x) :vector) (%eq (vector-length x) 0) false))))
(def append--rev
  (fn (src acc)
    ;; Reverse seq `src` (a list or vector) onto list `acc`. Tail-recursive.
    (if (append--empty? src) acc (append--rev (rest src) (cons (first src) acc)))))
(def append--2
  (fn (a b)
    ;; Cons every element of seq `a` (a list or vector) onto list `b` — via a
    ;; double reverse, so even the bootstrap builder is O(1) stack like the full
    ;; `append` below that rebinds it (`check-allow` doesn't exist yet up here).
    (append--rev (append--rev a nil) b)))
(def append
  (fn (& lists)
    ;; Concatenate any number of sequences into one list, left to right.
    (if (append--empty? lists)
      nil
      (append--2 (first lists) (apply append (rest lists))))))

;; `defmacro` itself — a macro, not a core special form. A macro is just a `fn`
;; the expander calls on the *unexpanded* argument forms; `%make-macro` (the one
;; Rust primitive this needs) tags a closure as one. Bootstrapped with raw
;; `def`/`fn` because `defmacro` can't define itself; every later `(defmacro …)`
;; expands through this into `(def name (%make-macro (fn …)))`.
(def defmacro
  (%make-macro (fn (name & body)
                 "Define `name` as a macro: a `fn` run at expansion time on the unevaluated argument forms, whose returned form replaces the call."
                 `(def ~name (%make-macro (fn ~@body))))))

;; `defn` itself: forwards everything after the name to `fn`, so it inherits
;; both single-clause — (defn f (x) ...) => (def f (fn (x) ...)) — and the
;; multi-clause pattern form — (defn f ((0) 1) ((n) ...)) => (def f (fn ((0) 1) ((n) ...))).
(defmacro defn (name & clauses)
  "Define a global function `name`, forwarding the clauses to `fn` — so it supports both the single-clause form `(defn f (x) body...)` and multi-clause pattern dispatch."
  `(def ~name (fn ~@clauses)))

;; ---- logic ----
(defn not (x)
  "Logical negation: `nil`/`false` become `true`, everything else `false`."
  (if x false true))

;; `empty?` — true for the empty value of any collection. Defined here, before
;; `fold`/`reduce` use it, so it's written with the raw kernel ops (`%eq`,
;; `type-of`, `string-length`, `vector-length`, `map-count`) rather than the type
;; predicates / `cond`, which are defined further down. (Not a Rust primitive: the
;; empty list is `nil`, and every other collection's emptiness is a length the
;; kernel already exposes.)
;; `empty?` is a native builtin (builtins.rs) for Prim1-level dispatch speed.

;; ---- universal list view ----
;; `seq` is what lets every list-shaped op (map/filter/fold/reduce/…) walk a
;; *map* without callers reaching for `(zip (keys m) (vals m))`: a map becomes
;; its `[k v]` pairs in one O(n) `map-pairs` pass; lists, vectors, strings, and
;; `nil` pass through unchanged. Defined here with raw kernel ops (`%eq`,
;; `type-of`, `map-pairs`) because `fold` calls it before the `map?` predicate /
;; `cond` macro are available.
(defn seq (coll)
  "A list view of `coll`. A map becomes its `[k v]` pairs; a lazy range or seq-view is realised to a list; a bytes value becomes its list of ints; lists, vectors, strings, and `nil` pass through. Used by `map`/`filter`/`fold` so they accept any collection."
  (if (range? coll)
    (%range->list coll)
    (if (seqview? coll)
      (%seqview-realize coll)
      (let (t (type-of coll))
        ;; A `bytes` value is realised to a list ONCE here: without this, fold/map/
        ;; filter/reduce would walk it with `first`/`rest`, and `(rest bytes)` copies
        ;; all-but-the-first byte — O(n) per step, O(n^2) total (a 50k-byte reduce
        ;; spiked ~1.3 GB RSS). `bytes->list` is a single O(n) native pass.
        (if (%eq t :map)
          ;; A record (a map carrying `:__id__`) takes its `Seqable` view — the fields,
          ;; id-free, by default — so it never leaks `:__id__` into map/fold/keys and a
          ;; custom collection can define its own iteration. `to-seq` is only reached for
          ;; records (never at boot, which has none), so its late definition is fine.
          (if (map-get coll :__id__ nil)
            (to-seq coll)
            (map-pairs coll))
          (if (%eq t :bytes) (bytes->list coll) coll))))))

;; ---- folding (the workhorse; tail-recursive, so it is stack-safe) ----
;; The public entry coerces once via `seq`; the inner `fold--loop` then stays in
;; list form for the recursion, so a map costs one extra `map-pairs` pass total
;; rather than O(n) per step.
(defn fold (f acc coll)
  "Left-fold: combine the items of `coll` left-to-right with `(f acc item)`, starting from `acc`. Tail-recursive, so it is stack-safe. Maps fold as their `[k v]` pairs. A lazy range folds in a counted loop with no list materialised; a lazy seq-view fuses — its transducer wraps `f` and folds straight over the source, so `(reduce + 0 (map sq (filter p (range n))))` walks the range once with no intermediate lists."
  (if (range? coll)
    (%range-reduce f acc coll)
    (if (seqview? coll)
      ;; Fuse: `(xform f)` is the wrapped reducer; fold it over the source (a
      ;; range → counted loop, a list → fold--loop, a nested view → fuses again).
      ;; Raw kernel ops (`if`/`let`/`vector-ref`) only — `fold` is defined before
      ;; `cond`/`second`.
      (let (parts (%seqview-parts coll))
        (fold ((vector-ref parts 1) f) acc (vector-ref parts 0)))
      (fold--loop f acc (seq coll)))))
(defn fold--loop (f acc coll)
  (if (empty? coll) acc (fold--loop f (f acc (first coll)) (rest coll))))

;; `cons` with its arguments flipped — the workhorse passed to `fold` to build a
;; list in reverse (then reversed once at the end). Hoisted to the top level so
;; the list builders that reverse-accumulate don't each allocate a fresh closure
;; on every call.
(defn flip-cons (acc x) (cons x acc))

;; A dedicated loop, not `(fold flip-cons …)`: `reverse` is the final pass of
;; nearly every sequence builder (`map`/`filter`/`take`/`zip`/`range`/…), so
;; dropping the per-element `flip-cons` `apply` frame here pays off across the
;; whole library. Coerce a map to its pairs once via `seq`, as `fold` did.
(defn reverse--acc (coll acc)
  (if (empty? coll) acc (reverse--acc (rest coll) (cons (first coll) acc))))
(defn reverse (coll)
  "The items of `coll` in reverse order, as a list."
  (reverse--acc (seq coll) nil))

(defn reverse-onto (coll tail)
  "The items of `coll` reversed, prepended onto `tail`. `(reverse-onto xs ys)` is
`(append (reverse xs) ys)` — but it walks `xs` **once**, so it is the spelling to
reach for when a tail-recursive loop has accumulated a reversed prefix and wants to
splice it back in front of the remainder."
  ;; This is THE shape every tail-recursive rewrite lands in: walk a list building a
  ;; reversed accumulator, then splice at the stopping point. Written as
  ;; `(append (reverse acc) tail)` it costs four passes — `reverse` walks `acc`, then
  ;; `append` folds both lists onto nil and reverses the result — and the checker's
  ;; non-tail-recursion advice produces more of these every time it is followed. So
  ;; the idiom gets a name and one pass. Measured, 20k splices of a 500-element
  ;; prefix: `(append (reverse acc) tail)` 2739 ms, `(fold flip-cons tail acc)`
  ;; 1674 ms, this 601 ms (4.6x). The `fold` form loses because of the per-element
  ;; `flip-cons` apply frame, which is exactly why `reverse--acc` is a dedicated loop.
  (reverse--acc (seq coll) tail))

;; Realise a lazy seq-view to a concrete list by running its transducer. Folding
;; `flip-cons` over the view hits `fold`'s seq-view branch, which wraps the
;; transducer around `flip-cons` and folds over the source — producing the
;; transduced items in reverse, so one `reverse` puts them in order. The kernel
;; `first`/`rest`/`apply` builtins call this (by name) for a view that escapes the
;; fusing path; `seq` calls it to coerce. No intermediate list beyond the result.
(defn %seqview-realize (sv) (reverse (fold flip-cons nil sv)))

;; reduce supports both (reduce f init coll) and (reduce f coll). The 2-arg
;; form must seq-coerce `x` itself before splitting head/tail, because the bare
;; `(first x)`/`(rest x)` calls bypass fold's coercion and a map would error.
(defn reduce (f x & more)
  "Reduce a collection with `f`. Either `(reduce f init coll)` or `(reduce f coll)` (using the first item as the initial value). Maps reduce as their `[k v]` pairs."
  (if (empty? more)
    (let (s (seq x)) (fold f (first s) (rest s)))
    (fold f x (first more))))

;; ---- arithmetic (variadic, built on the 2-arg primitives) ----
;; Multi-arity (ADR-047): the 0/1/2-argument clauses bind their parameters
;; *directly* and call the primitive — no `& xs` rest-list, no `fold`, just one
;; env frame — so the overwhelmingly common 2-argument call (`(+ a b)`) is ~40×
;; cheaper than folding over a variadic rest-list. Only the 3+-argument fallback
;; folds, starting from the first two combined so it never re-walks them. (This
;; is the dogfooding payoff: writing `+` in Brood surfaced the missing
;; multi-arity dispatch; we built that capability rather than moving `+` to Rust
;; — CLAUDE.md "dogfood first; optimize by building the language up".)
(defn + "Sum of all arguments (0 with none)."
  (() 0)
  ((a) a)
  ((a b) (%add a b))
  ((a b & more) (fold %add (%add a b) more)))
(defn * "Product of all arguments (1 with none)."
  (() 1)
  ((a) a)
  ((a b) (%mul a b))
  ((a b & more) (fold %mul (%mul a b) more)))
(defn - "Subtract the rest from `x`; negate `x` if it's the only argument."
  ((x) (%sub 0 x))
  ((a b) (%sub a b))
  ((x & xs) (fold %sub x xs)))
(defn / "Divide `x` by the rest; reciprocal of `x` if it's the only argument. Errors on division by zero."
  ((x) (%div 1 x))
  ((a b) (%div a b))
  ((x & xs) (fold %div x xs)))

(defn inc (n) "Return `n` + 1." (%add n 1))
(defn dec (n) "Return `n` - 1." (%sub n 1))

;; ---- comparison & equality (variadic chains over %lt / %eq) ----
;; chain? checks a predicate holds for every adjacent pair: (chain? < (1 2 3)).
(defn chain? (pred xs)
  (if (empty? xs)
    true
    (if (empty? (rest xs))
      true
      (if (pred (first xs) (first (rest xs))) (chain? pred (rest xs)) false))))

;; Binary comparison kernels, hoisted to the top level so the variadic chains
;; below pass an *existing* function to `chain?` rather than allocating a fresh
;; closure on every call. `<` and `=` reuse the `%lt`/`%eq` primitives directly;
;; the swapped/negated ones get a named Brood helper (still policy in Brood).
(defn cmp--gt (a b) (%lt b a))
(defn cmp--le (a b) (not (%lt b a)))
(defn cmp--ge (a b) (not (%lt a b)))

;; Multi-arity like arithmetic above: a direct 2-argument clause (the common
;; case — `(< a b)`, `(= a b)`) calls the primitive with one env frame; the
;; variadic clause chains over adjacent pairs for 3+ (or 0/1, trivially true).
(defn < "True if the arguments are in strictly increasing order."
  ((a b) (%lt a b))
  ((& xs) (chain? %lt xs)))
(defn > "True if the arguments are in strictly decreasing order."
  ((a b) (%lt b a))
  ((& xs) (chain? cmp--gt xs)))
(defn <= "True if the arguments are in non-decreasing order."
  ;; 2-arg body is a direct primitive call (a <= b) so the ADR-069 thin-wrapper
  ;; elision reaches it — the old `(not (%lt b a))` was a nested call it couldn't.
  ((a b) (%le a b))
  ((& xs) (chain? cmp--le xs)))
(defn >= "True if the arguments are in non-increasing order."
  ;; a >= b  ==  b <= a — still a single passthrough (%le with args swapped).
  ((a b) (%le b a))
  ((& xs) (chain? cmp--ge xs)))
(defn = "True if all arguments are structurally equal."
  ((a b) (%eq a b))
  ((& xs) (chain? %eq xs)))
(defn not= "True if the arguments are not all equal."
  ((a b) (not (%eq a b)))
  ((& xs) (not (apply = xs))))

;; ---- control-flow macros ----
;; These read like special forms but are ordinary macros over `if`/`do`/`let`.
;; The compile pass (macroexpand-all) expands them once, so they cost nothing at
;; runtime while the evaluator's core stays just `if`/`do`/`let`/`fn`/… — policy
;; in Brood, mechanism in Rust (ADR-006/008). There is no `while`: data is
;; immutable and there's no local mutation (ADR-026), so loops are recursion (TCO
;; keeps the stack O(1)) or processes.

(defmacro when (test & body)
  "Evaluate `body` (returning the last) when `test` is truthy, else `nil`."
  `(if ~test (do ~@body) nil))

(defmacro unless (test & body)
  "Evaluate `body` (returning the last) when `test` is falsy, else `nil`."
  `(if ~test nil (do ~@body)))

;; `defonce` — define only if the name is not already bound. The point is
;; hot-reload: re-evaluating a file (via `reload-defs` or `load`) re-runs every
;; `def…` form, which would reset top-level state and re-create singletons (a
;; fresh `(spawn …)`, a reopened connection) on every save. `defonce` makes the
;; init run *once* — the value survives reload, exactly like Emacs `defvar`.
;; Idiomatic for global state and resources: (defonce *server* (spawn (serve))),
;; (defonce *registry* {}). Plain behaviour stays `defn`/`def`. To force re-init,
;; restart or re-`def` explicitly. (`bound?` returns false on an unbound symbol,
;; so this is safe on first definition — docs/live-editing.md Stage 1.)
(defmacro defonce (name val)
  "Bind `name` to `val` only if it isn't already bound, so the value survives
hot-reload (cf. Emacs `defvar`). Once bound, re-evaluating is a no-op; restart
or re-`def` to force re-init."
  `(unless (bound? '~name) (def ~name ~val)))

;; `(comment …)` — the dev-scratch block every Lisp has. Its body is read (so it
;; must still be balanced sexps) but never evaluated, which is the point: a
;; worked example, a REPL snippet, or a disabled call can sit next to the code it
;; documents without being commented out line by line. Brood has no `#_`
;; form-discard reader macro, so this is the only form-level "don't run this".
(defmacro comment (& _body)
  "Ignore the body entirely and return nil — a scratch block for examples and
disabled snippets. The body is still *read*, so it must be balanced sexps; use
`;` for prose or anything that wouldn't parse."
  nil)

;; `(sig name (params… -> ret))` — a type-signature declaration the advisory
;; checker reads (it parses the type-expression and treats it as `name`'s
;; authoritative signature, ahead of inferred/curated ones). Normally a runtime
;; no-op (expands to `nil`); set BROOD_CONTRACTS=1 to enforce every `(sig …)`
;; as a runtime contract (same as `(sig! …)`) for a dev/test run. See
;; `docs/type-annotations.md`. NOTE: the checker reads the *un-expanded* form, so
;; this macro intentionally discards its arguments.
(defmacro sig (name type)
  "Declare a type signature for `name`, e.g. `(sig area (number -> number))`.
Read by the advisory type checker; a runtime no-op unless `BROOD_CONTRACTS=1`
is set, in which case it installs a runtime contract like `(sig! …)`. Type
grammar: base names (`int` `string` `number` `list` `vector` `map` `fn` `any` …),
arrows `(p… -> r)`, `(list E)`/`(vector E)`, `(or A B)`, and `(& rest-type)`
for variadic tails."
  ;; Always register the declaration on the heap (keyed by the module-qualified
  ;; global name, resolved as `def` would) so the checker treats it as `name`'s
  ;; authoritative signature everywhere — intra-module and cross-module — not just
  ;; in a bare file's per-file ctx. Then keep the existing semantics: a runtime
  ;; no-op, or a `sig!` runtime contract under BROOD_CONTRACTS=1.
  `(do
     ~(if (= (getenv "BROOD_CONTRACTS") "1") nil `(%register-sig '~name '~type))
     ~(if (= (getenv "BROOD_CONTRACTS") "1")
        ;; Contracts mode turns this *declaration* into an *action*: `sig!` rebinds
        ;; `name` to a checking wrapper, so the definition must already exist. A
        ;; `sig` written above its `defn` — the natural place, since a signature is
        ;; documentation — then failed with a bare `unbound symbol: mod/name` and
        ;; took the whole module load down with it (found by annotating `std/` for
        ;; real, 2026-07-26). Name the fix instead of dying sideways.
        ;; `bound?` on a QUOTED symbol is not namespace-resolved — inside
        ;; `(defmodule path)` it would ask about bare `basename` while the
        ;; definition is `path/basename`, and report "not defined yet" for a
        ;; perfectly-placed sig. `%register-sig` already returns the qualified
        ;; symbol it keyed the declaration under, so ask about *that*.
        `(if (bound? (%register-sig '~name '~type))
           (sig! ~name ~type)
           (error "sig: "
             '~name " is not defined yet, and BROOD_CONTRACTS=1 makes "
             "`sig` install a runtime contract (which rebinds the name). Move this " "`(sig " '~name
             " …)` BELOW the definition, or unset BROOD_CONTRACTS "
             "to use it as a pure declaration."))
        nil)))

;; ---- checker suppression: `(check-allow :category form…)` -------------------
;; A form-level opt-out for an advisory lint the author deliberately trips — a
;; non-tail-recursive function written to exercise the deep-recursion path, a
;; redundant `match` clause under test. The reader strips comments before the
;; checker runs, so a `;;`-directive can't reach it; this macro expands to a
;; marker (`%lint-allow`) that survives macroexpansion and that `nest check`
;; reads. A pure runtime no-op — it just yields the wrapped body's value.
;; Recognised categories: `:non-tail-recursion`, `:unreachable-clause`,
;; `:type-mismatch` (a `sig`-declared return/argument the body deliberately
;; violates — e.g. a negative test proving a `sig!` runtime contract throws).
;; Wraps one or many forms (top-level defns or an inner expression).
;; See docs/type-annotations.md.
(defn %lint-allow (category value)
  "Identity on `value` — the runtime side of `check-allow` (a checker marker)."
  value)
(defmacro check-allow (category & body)
  "Suppress an advisory checker lint over the wrapped forms. `category` is a
keyword: `:non-tail-recursion`, `:unreachable-clause`, `:type-mismatch`, or
`:unbound` (globals defined at runtime — an `eval`-driven `def`, the wasm
`use-native` binding — that the checker cannot see in source). A runtime
no-op; the marker is read only by the type checker (`nest check`)."
  `(%lint-allow ~category (do ~@body)))

;; ---- runtime contracts: `(sig! …)` enforces a signature at call time --------
;; The opt-in *sound* half of the type system (the paper's "strong arrow", done
;; Brood-side). `(sig …)` informs only the checker; `(sig! …)` *also* wraps the
;; function so each argument and the result are checked at run time and a
;; mismatch throws — so a value the static checker trusted can never silently
;; slip through. All policy, no new primitive. See `docs/type-annotations.md`.

; unknown base name → accept
(defn type-matches? (t v)
  "True if value `v` inhabits the (sig …) type-expression `t`. Unknown type
names accept anything, so a contract never throws on a type it can't interpret."
  (cond
    (nil? t) (nil? v)
    ; the `nil` type reads as the nil literal
    (pair? t) (let (h (first t))
                (cond
                  (%eq h 'or) (any? (fn (s) (type-matches? s v)) (rest t))
                  (%eq h 'and) (every? (fn (s) (type-matches? s v)) (rest t))
                  (%eq h 'list) (and (list? v)
                                  (let (elem (first (rest t)))
                                    (or (nil? elem)
                                      (every? (fn (x) (type-matches? elem x)) v))))
                  (%eq h 'vector) (and (vector? v)
                                    (let (elem (first (rest t)))
                                      (or (nil? elem)
                                        (every? (fn (x) (type-matches? elem x)) v))))
                  (%eq h 'map) (and (map? v)
                                 (let (ktype (first (rest t))
                                       vtype (first (rest (rest t))))
                                   (or (and (nil? ktype) (nil? vtype))
                                     (every? (fn (kv)
                                               (and (type-matches? ktype (first kv))
                                                 (type-matches? vtype (second kv))))
                                       (map-pairs v)))))
                  (%eq h 'record)
                  ;; A field's type may be wrapped `(optional T)` — allowed to
                  ;; be absent/nil. Every other field is required: `(get v k)`
                  ;; on a missing key is nil, so `type-matches?` on the bare
                  ;; field type naturally fails unless that type accepts nil —
                  ;; no separate presence check needed. Extra keys are ignored
                  ;; (open records).
                  (and (map? v)
                    (every? (fn (field)
                              (let (k (first field)
                                    ftype (second field))
                                (if (and (pair? ftype) (%eq (first ftype) 'optional))
                                  (or (nil? (get v k))
                                    (type-matches? (second ftype) (get v k)))
                                  (type-matches? ftype (get v k)))))
                      (partition 2 (rest t)))) (%eq h
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       'tuple)
                  ;; A fixed-arity positional vector shape (ADR-128): exact
                  ;; arity, then each position checked against its own
                  ;; declared type.
                  (and (vector? v)
                    (= (count v) (count (rest t)))
                    (every? (fn (i) (type-matches? (nth (rest t) i) (nth v i)))
                      (range (count v)))) else
                  true))
    ; arrow param / unknown compound → accept
    (keyword? t) (= t v)
    ; a keyword type-expr is a literal: match it exactly
    (int? t) (= t v)
    ; an int type-expr is a literal too (ADR-117)
    (bool? t) (= t v)
    ; likewise for bool and string (ADR-120)
    (string? t) (= t v)
    (%eq t 'any) true
    (%eq t 'number) (number? v)
    (%eq t 'int) (int? v)
    (%eq t 'float) (float? v)
    (%eq t 'decimal) (decimal? v)
    (%eq t 'ratio) (ratio? v)
    (%eq t 'string) (string? v)
    (%eq t 'bool) (bool? v)
    (%eq t 'keyword) (keyword? v)
    (%eq t 'symbol) (symbol? v)
    (%eq t 'pair) (pair? v)
    (%eq t 'map) (map? v)
    (%eq t 'fn) (fn? v)
    (%eq t 'list) (list? v)
    (%eq t 'vector) (vector? v)
    else true))
(defn contract--check-args (name ptypes args i)
  "Throw if any argument fails its declared type. Pairwise over the overlap —
arity itself is the static checker's job."
  (when (and (pair? ptypes) (pair? args))
    (unless (type-matches? (first ptypes) (first args))
      (throw (str name
               ": argument " i " expected " (first ptypes) ", got " (type-of (first args)) " ("
               (pr-str (first args)) ")")))
    (contract--check-args name (rest ptypes) (rest args) (inc i))))

(defn contract--check-rest (name rtype args)
  "Throw if any rest argument fails its declared rest type."
  (when (pair? args)
    (unless (type-matches? rtype (first args))
      (throw (str name
               ": rest argument expected " rtype ", got " (type-of (first args)) " ("
               (pr-str (first args)) ")")))
    (contract--check-rest name rtype (rest args))))

(defn sig--pos (xs x n)
  "Position of `x` in the list `xs` (from index `n`), or -1. Expansion-time helper
for `sig!` that predates `index-of` in the prelude's own load order."
  (cond
    (nil? xs) -1
    (%eq (first xs) x) n
    else (sig--pos (rest xs) x (%add n 1))))

(defmacro sig! (name type)
  "Like `(sig …)` but also installs a *runtime* contract: each argument and the
result are checked at every call and a mismatch throws (an opt-in 'strong
arrow'). Place it AFTER the function's definition — it rebinds `name`, preserving
arity (so introspection and the reload-arity check are undisturbed). The checker
reads it exactly like `(sig …)`. Supports a `&` rest marker:
`(sig! f (int & number -> string))` checks fixed args then every rest arg."
  ;; Register the declaration on the heap for the checker (keyed by the
  ;; module-qualified global name) — same as `(sig …)` — then install the runtime
  ;; contract. The `(do …)` keeps both effects at top level.
  `(do
     (%register-sig '~name '~type)
     ~(let (i (sig--pos type '-> 0))
        (if (< i 0)
          ; not a (… -> …) type — nothing to enforce
          nil
          (let (ptypes (take i type)
                rtype (nth type (inc i))
                amp-pos (sig--pos ptypes '& 0))
            (if (< amp-pos 0)
              ;; fixed arity
              (let (params (map (fn (_) (gensym "arg")) (range (count ptypes)))
                    orig (gensym "orig")
                    r (gensym "ret"))
                `(def ~name
                   (let (~orig ~name)
                     (fn (~@params)
                       (contract--check-args '~name '~ptypes (list ~@params) 1)
                       (let (~r (~orig ~@params))
                         (unless (type-matches? '~rtype ~r)
                           (throw (str '~name
                                    ": result expected " '~rtype ", got " (type-of ~r) " ("
                                    (pr-str ~r) ")")))
                         ~r)))))
              ;; variadic: (fixed… & rest-type -> ret)
              (let (fixed-ptypes (take amp-pos ptypes)
                    rest-ptype (nth ptypes (inc amp-pos))
                    fixed-params (map (fn (_) (gensym "arg")) (range amp-pos))
                    rest-param (gensym "rest")
                    orig (gensym "orig")
                    r (gensym "ret"))
                `(def ~name
                   (let (~orig ~name)
                     (fn (~@fixed-params & ~rest-param)
                       (contract--check-args '~name '~fixed-ptypes (list ~@fixed-params) 1)
                       (contract--check-rest '~name '~rest-ptype ~rest-param)
                       (let (~r (apply ~orig (append (list ~@fixed-params) ~rest-param)))
                         (unless (type-matches? '~rtype ~r)
                           (throw (str '~name
                                    ": result expected " '~rtype ", got " (type-of ~r) " ("
                                    (pr-str ~r) ")")))
                         ~r)))))))))))

;; `and`/`or` short-circuit left-to-right and return the deciding value, with
;; each subexpression evaluated at most once (a gensym holds it across the test).
(defmacro and (& xs)
  "Logical AND: evaluate left-to-right, short-circuiting on the first falsy value (which it returns); `true` if none. Each argument is evaluated at most once."
  (if (empty? xs)
    true
    (if (empty? (rest xs))
      (first xs)
      (let (g (gensym "and")) `(let (~g ~(first xs)) (if ~g (and ~@(rest xs)) ~g))))))

(defmacro or (& xs)
  "Logical OR: evaluate left-to-right, short-circuiting on the first truthy value (which it returns); `nil` if none. Each argument is evaluated at most once."
  (if (empty? xs)
    nil
    (if (empty? (rest xs))
      (first xs)
      (let (g (gensym "or")) `(let (~g ~(first xs)) (if ~g ~g (or ~@(rest xs))))))))

;; cond: flat test/expr pairs (ADR-004); a final `else` is the catch-all.
;;
;; `else` needs the special case below: a bare symbol would otherwise be an unbound
;; reference. `:else` never did — a keyword is self-evaluating and truthy, so it
;; already worked the way `true` or any other truthy test does. Special-casing it
;; too made the language carry a second blessed spelling for no gain, so that case
;; is gone (2026-07-26). `(cond … :else x)` still returns `x` — as an ordinary
;; truthy test, via `if` — but `else` is the spelling the language knows.
;; Bootstrap helper for cond's guard: walks clauses two at a time, returning
;; the orphan last element when count is odd, nil when even. Uses only
;; `if`/`empty?`/`first`/`rest` — all kernel primitives — so it's safe to call
;; during prelude loading before `odd?`/`count`/`last` are defined.
(defn cond--orphan (clauses)
  (if (empty? clauses)
    nil
    (if (empty? (rest clauses))
      (first clauses)
      (cond--orphan (rest (rest clauses))))))

(defmacro cond (& clauses)
  "Multi-way branch over `test expr` pairs: return the `expr` of the first truthy `test`. A final `else` test always matches; `nil` if none do."
  (let (orphan (cond--orphan clauses))
    (if (and (not (nil? orphan)) (not (%eq orphan 'else)))
      (error "cond: odd number of clauses — expected test/expression pairs. "
        "Did you forget an expression for '" (pr-str orphan) "'?")
      (if (empty? clauses)
        nil
        (let (test (first clauses) expr (first (rest clauses)) more (rest (rest clauses)))
          ;; compare with the `%eq` primitive, not the variadic `=` — `=` builds a
          ;; lambda, and doing that *at expansion time* during the prelude's own
          ;; compile pass would strand a local-env closure (breaks the freeze).
          (if (%eq test 'else) expr `(if ~test ~expr (cond ~@more))))))))

;; ---- macro expansion --------------------------------------------------------
;; Fully expand `form`'s head macro by iterating the single-step `macroexpand-1`
;; primitive to a fixpoint. Written in Brood, not Rust (ADR-064): the loop's state
;; is an env-bound local the evaluator already roots, so it can't strand a handle
;; across a GC safepoint the way a hand-rooted Rust loop could. `macroexpand-1` is
;; the irreducible single-shot primitive (one expansion, holding nothing across
;; its `apply`); this just drives it. Tail-recursive, so it is O(1) stack.
;; Bounded (kernel audit): a macro that forever expands to another macro call
;; would otherwise spin here. Mirrors the kernel expander's own cap
;; (`MAX_EXPAND_ROUNDS` in eval/macros.rs) — keep the two in step.
(def macroexpand--max-rounds 256)

(defn macroexpand--loop (form n)
  (if (= n 0)
    (error "macroexpand: no fixpoint after "
      macroexpand--max-rounds " rounds (a macro that expands to itself?)")
    (let (stepped (macroexpand-1 form))
      (if (= stepped form) form (macroexpand--loop stepped (- n 1))))))

(defn macroexpand (form)
  "Repeatedly expand `form`'s head macro until the head is no longer a macro call."
  (macroexpand--loop form macroexpand--max-rounds))

;; ---- type predicates --------------------------------------------------------
;; Each is a thin wrapper over `type-of`, the one reflective primitive (it
;; returns the runtime tag as a keyword). (`%eq` not `=`: no dependency on the
;; variadic comparison, and it can't be shadowed by a local `=`.)
;; `nil?` and `pair?` are native builtins (builtins.rs) — they compile to
;; PrimOp1::IsNil / IsPair inline instructions, eliminating call overhead.
(defn int? (x) "True if `x` is an integer." (%eq (type-of x) :int))
(defn float? (x) "True if `x` is a float." (%eq (type-of x) :float))
(defn bool? (x) "True if `x` is a boolean." (%eq (type-of x) :bool))
(defn string? (x) "True if `x` is a string." (%eq (type-of x) :string))
(defn bytes? (x) "True if `x` is a bytes value." (%eq (type-of x) :bytes))
(defn decimal? (x)
  "True if `x` is an exact base-10 decimal (e.g. `1.50M`)."
  (%eq (type-of x) :decimal))
(defn ratio? (x)
  "True if `x` is an exact rational (e.g. `1/2`)."
  (%eq (type-of x) :ratio))
(defn symbol? (x) "True if `x` is a symbol." (%eq (type-of x) :symbol))
(defn keyword? (x) "True if `x` is a keyword." (%eq (type-of x) :keyword))
(defn vector? (x) "True if `x` is a vector." (%eq (type-of x) :vector))
(defn map? (x) "True if `x` is a map." (%eq (type-of x) :map))
(defn set? (x) "True if `x` is a set (a `#{…}` value)." (%eq (type-of x) :set))
(defn ref? (x) "True if `x` is a `(ref)` token (a unique reference)." (%eq (type-of x) :ref))
(defn pid? (x) "True if `x` is a process id (from `self`/`spawn`)." (%eq (type-of x) :pid))
(defn rope? (x)
  "True if `x` is a rope (editor buffer text from `string->rope`)."
  (%eq (type-of x) :rope))
(defn table? (x)
  "True if `x` is an in-memory table (from `(table)`) — Brood's shared mutable ETS store."
  (%eq (type-of x) :table))
;; Copy an immutable map into a fresh mutable table. Used only by the compiler's
;; linear-map-accumulator rewrite (docs/linear-map-accumulator.md) to seed the
;; private table from the accumulator's input map; never surfaced to user code.
(defn %table-from-map (m)
  (reduce (fn (t kv) (table-put t (first kv) (second kv))) (table) (map-pairs m)))
;; `fn?` holds for both Brood closures (:fn) and Rust builtins (:native).
(defn fn? (x)
  "True if `x` is callable (a closure or a primitive)."
  (or (%eq (type-of x) :fn) (%eq (type-of x) :native)))

;; ---- derived predicates ----
(defn number? (x)
  "True if `x` is an int, a float, a decimal, or a ratio."
  (or (int? x) (float? x) (decimal? x) (ratio? x)))
(defn ->float (x)
  "The number `x` as an (inexact) float — the escape hatch from an exact ratio or
decimal to fast float math (`(->float 1/2)` → `0.5`)."
  (* 1.0 x))
(defn rational (n d)
  "The exact rational `n`/`d` — reduced, with a positive denominator (a denominator
of 1 gives an integer). Same as `(/ n d)` for integers; errors when `d` is 0."
  (/ n d))
(defn list? (x) "True if `x` is a proper list (`nil` or a pair)." (or (nil? x) (pair? x)))

;; ---- list accessors ----
(defn list (& xs) "A list of the given arguments." xs)
(defn second (coll) "The second item of `coll`." (first (rest coll)))
(defn third (coll) "The third item of `coll`." (first (rest (rest coll))))

;; ---- sequence operations ----
;; Many eager seq ops share one structure: reverse-accumulate over `(seq coll)`,
;; then reverse once. `defseq` encodes the pattern as a single `defn` whose body
;; holds a tail-recursive `letrec` loop. This keeps the source location visible to
;; `note_definition` (which only recognises `def`/`defn` as outer heads) and
;; removes the need for separate `name--acc` globals. Each loop calls the user fn
;; directly — no extra `apply` frame per element. Inside `step`: `item` is bound to
;; the current element and `acc` is the current accumulator.
;; `item` and `acc` are *intentional* anaphora: a `defseq` step-expr is documented
;; to reference them (`(cons (f item) acc)`), so they opt out of automatic binding
;; hygiene with `~'item`/`~'acc` — an unquoted quoted symbol stays the literal name
;; (the `aif` `it` case). Every other binder here — `coll`, `--loop` — is auto-renamed
;; by the hygiene pass (ADR-066 amendment) so it can't capture the caller's `step`
;; code; no `#`/`(gensym)` needed.
(defmacro defseq (sym params docstring step)
  "Define an eager sequence op that reverse-accumulates over `coll`.
`params` are the extra arguments before `coll`; inside `step`, `item` is the
current element and `acc` is the current accumulator."
  (if (not (string? docstring))
    (error "defseq: third argument must be a docstring string, got "
      (pr-str docstring) ". Syntax: (defseq name (params...) \"docstring\" step-expr)")
    `(defn ~sym (~@params coll)
       ~docstring
       (letrec (--loop (fn (coll ~'acc)
                         (if (empty? coll)
                           acc
                           (let (~'item (first coll))
                             (--loop (rest coll) ~step)))))
         (reverse (--loop (seq coll) nil))))))

(defseq map
  (f) "A list of `(f x)` for each `x` in `coll`." (cons (f item) acc))

(defseq filter
  (pred) "A list of the items of `coll` for which `(pred x)` is truthy."
  (if (pred item) (cons item acc) acc))

(defn mapv (f coll)
  "A VECTOR of `(f x)` for each `x` in `coll` — `map` when the caller needs
indexed access or a vector literal shape (`(into [] (map f coll))`, named)."
  (into [] (map f coll)))

(defn filterv (pred coll)
  "A VECTOR of the items of `coll` for which `(pred x)` is truthy — `filter`
when the caller needs indexed access (`(into [] (filter pred coll))`, named)."
  (into [] (filter pred coll)))

(defn vec (coll)
  "`coll` as a VECTOR (`(into [] coll)`, named). A map becomes its `[k v]` pairs
and a set its elements, as everywhere else `seq` applies."
  (into [] coll))

(defn append-two (a b) "Concatenate two lists (`a` before `b`)." (fold flip-cons b (reverse a)))

;; Prepend every element of `lst` onto `acc` (so `acc` collects all elements in
;; reverse); `append` folds this over the lists, then reverses once. Argument order
;; is fold's (`acc` first), which is why this exists at all rather than callers
;; using `reverse-onto` directly — it is that function with the arguments flipped.
(defn append--onto (acc lst) (reverse-onto lst acc))
(defn append (& lists)
  "Concatenate any number of lists into one, left to right."
  ;; O(total length) and fully tail-recursive — so `mapcat` (via `apply append`)
  ;; stays stack-safe on many/long lists. The previous left fold of `append-two`
  ;; re-reversed the growing accumulator each step, making it O(lists²).
  (reverse (fold append--onto nil lists)))

(defn count--acc (coll n) (if (empty? coll) n (count--acc (rest coll) (%add n 1))))
(defn count (coll)
  "The number of items in `coll` (a list, vector, string, or map)."
  ;; `vector?`/`map?` short-circuit to the O(1) `vector-length`/`map-count`
  ;; kernels (both were O(n) — a fold walk / a `map-pairs` allocation); lists
  ;; and nil go through a dedicated tail loop, not a per-element counting closure.
  (cond
    (range? coll) (%range-count coll)
    ;; A lazy seq-view counts by fusing a counting reducer through `fold` — walks
    ;; the source once, no list materialised.
    (seqview? coll) (fold (fn (n _) (%add n 1)) 0 coll)
    (string? coll) (string-length coll)
    (vector? coll) (vector-length coll)
    (bytes? coll) (byte-length coll)
    ;; a record counts as its `Seqable` view (its fields, id-free, by default) — not the
    ;; raw map, which would include the internal `:__id__`. `map-get` distinguishes it.
    (map? coll) (if (map-get coll :__id__ nil) (count (to-seq coll)) (map-count coll))
    (set? coll) (%set-count coll)
    else (count--acc coll 0)))

(defn nth-list (coll i d)
  (cond (empty? coll) d (= i 0) (first coll) else (nth-list (rest coll) (- i 1) d)))

;; A non-integer index is a type error that must name `nth`. Before this it fell
;; through to the guards and the list walk, where `(>= i 0)` / `(- i 1)` raised
;; `>=: expected number, got keyword` and `-: expected number, got keyword` — errors
;; naming an arithmetic helper the caller never wrote, in violation of the
;; self-identifying-type-error promise in docs/language.md. `(nth v :k)` is a real
;; mistake (usually a map/sequence mix-up), so it must say so.
(defn nth--bad-index (coll i)
  (error (str "nth: expected an integer index, got "
           (name (type-of i)) " (" (pr-str i) ")"
           " — a vector, list, string or bytes is indexed by position, not by key")))
;; The list arm is also where a NON-collection lands (`(nth 5 0)`), which used to
;; surface as `empty?: expected collection, got int (5)` — an internal `nth-list`
;; walks through, not the op the caller wrote. Checked once per `nth`, not per step:
;; the vector/bytes arms never reach it, and a list walk is already O(n).
(defn nth--seq-or-fail (coll i d)
  (cond
    (or (pair? coll) (nil? coll)) (nth-list coll i d)
    ;; a record indexes through its `Seqable` view (a custom collection or its fields)
    (record? coll) (nth-list (seq coll) i d)
    else (error (str "nth: expected a collection to index, got "
                  (name (type-of coll)) " (" (pr-str coll) ")"))))

(defn nth "The item at index `i` of `coll` (0-based), or `default` (else `nil`) if out of range."
  ;; The fixed 2-arity arm is the hot path (`(nth v i)`): it is VM-eligible
  ;; (exact arity), so its body compiles to bytecode and the inner `vector-ref`
  ;; inlines to a slab read — whereas the variadic-only definition deferred the
  ;; whole thing to the tree-walker. The `& default` arm keeps the explicit-default
  ;; behaviour for the rarer 3-arg call.
  ((coll i) (cond
              (not (int? i)) (nth--bad-index coll i)
              (vector? coll) (if (and (>= i 0) (< i (vector-length coll))) (vector-ref coll i) nil)
              (bytes? coll) (if (and (>= i 0) (< i (byte-length coll))) (byte-at coll i) nil)
              else (nth--seq-or-fail coll i nil)))
  ((coll i & default) (cond
                        (not (int? i)) (nth--bad-index coll i)
                        (vector? coll) (if (and (>= i 0) (< i (vector-length coll)))
                                         (vector-ref coll i)
                                         (first default))
                        (bytes? coll) (if (and (>= i 0) (< i (byte-length coll)))
                                        (byte-at coll i)
                                        (first default))
                        else (nth--seq-or-fail coll i (first default)))))

;; ---- numeric helpers ----
;; ---- map operations ----
;; Maps are immutable: `assoc`/`dissoc` return a fresh map, never mutate.
;; `{ }` literals and `hash-map` construct them; these wrap the `map-*` kernel
;; primitives with the variadic / default-bearing surface.

;; (get coll k) -> value or nil if absent; (get coll k default) -> value or default.
;; The fixed-arity 2- and 3-arg arms are the hot paths: exact arity → VM-eligible,
;; so the body compiles to bytecode and the common `(get m k d)` map case goes
;; straight to the `map-get` kernel op — no variadic-rest dispatch, no `(first
;; default)`, and no extra call hop. The cond is repeated per arm (rather than
;; factored into a helper) precisely to avoid that extra call on the hot path.
;; A `get` that cannot be answered — the cold path, factored out so the hot arms
;; below stay one `cond` deep. Two distinct mistakes, so two distinct messages:
;;   - an integer-indexed collection asked for by a non-integer key (`(get v :name)`,
;;     almost always a map/sequence mix-up: `deps` where `dep` was meant);
;;   - something that isn't a collection at all (`(get 5 :k)`).
;; Both used to leak an error from an internal the caller never wrote — `-`, `>=`, or
;; `empty?` — and `(get "s" :k)` was worse than either: it silently returned nil, so a
;; typo'd accessor produced a plausible-looking absent value. The `default` argument
;; deliberately does NOT suppress these: a default means "the key is absent", not
;; "the key is the wrong type".
(defn get--unanswerable (coll k)
  (if (or (pair? coll) (vector? coll) (bytes? coll) (string? coll))
    (error (str "get: expected an integer index, got "
             (name (type-of k)) " (" (pr-str k) ")"
             " — a vector, list, string or bytes is indexed by position, not by key."
             " Did you mean one element of it, or `get-in` for a nested key?"))
    (error (str "get: expected a collection (map, set, vector, list, string or bytes), got "
             (name (type-of coll)) " (" (pr-str coll) ")"))))

(defn get "The value at key/index `k` in `coll`, or `default` (else `nil`) if absent.
Maps look up by key; **a set looks up by membership** — it yields the element
itself when present (so `(get s x)` agrees with `(contains? s x)`), never a
positional index; vectors, lists, strings and bytes index by integer position, where
an out-of-range index yields the default. `nil` is an empty collection (`(get nil k)`
is the default). A **non-integer key on an integer-indexed collection**, or any
non-collection, is a type error naming `get` — the default covers an absent key, not
a wrong-typed one."
  ;; Branch order is load-bearing, not stylistic: map (much the most common), then
  ;; set, then the two cheap `nil?`/`string?` prim checks, then ONE fallthrough to
  ;; `nth` for every integer-indexed kind — the shape the pre-2026-07-26 version had.
  ;; Factoring the kind test into a `get--indexed?` helper (four type checks behind a
  ;; call) measured a ~1.8x slowdown on `(get v i)`: 1130ms → 2050ms per 2M.
  ;;
  ;; MEASURED COST of the diagnostics (2M calls, release+JIT): `(get m :k)` 735 → 739ms
  ;; (noise), `(get v i)` 1130 → 1432ms (~27%). Accepted deliberately: the keyword-key
  ;; form is 4796 call sites in the workspace and is unaffected, while the integer-key
  ;; form is 124 — and positional access in hot code goes through `nth`/`vector-ref`
  ;; (720 sites), whose wall time is unchanged. ~115ms of the delta is `nth`'s own
  ;; entry check showing up through this call (an inlining-boundary effect, not
  ;; instruction cost — `nth` measured standalone is identical either way).
  ((coll k) (cond
              (map? coll) (map-get coll k nil)
              (set? coll) (if (%set-has? coll k) k nil)
              (nil? coll) nil
              (string? coll) (if (int? k)
                               (if (and (>= k 0) (< k (string-length coll))) (char-at coll k) nil)
                               (get--unanswerable coll k))
              (int? k) (nth coll k nil)
              else (get--unanswerable coll k)))
  ((coll k default) (cond
                      (map? coll) (map-get coll k default)
                      (set? coll) (if (%set-has? coll k) k default)
                      (nil? coll) default
                      (string? coll) (if (int? k)
                                       (if (and (>= k 0) (< k (string-length coll)))
                                         (char-at coll k)
                                         default)
                                       (get--unanswerable coll k))
                      (int? k) (nth coll k default)
                      else (get--unanswerable coll k)))
  ((coll k & default) (cond
                        (map? coll) (map-get coll k (first default))
                        (set? coll) (if (%set-has? coll k) k (first default))
                        (nil? coll) (first default)
                        (string? coll) (if (int? k)
                                         (if (and (>= k 0) (< k (string-length coll)))
                                           (char-at coll k)
                                           (first default))
                                         (get--unanswerable coll k))
                        (int? k) (nth coll k (first default))
                        else (get--unanswerable coll k))))

;; (assoc m k1 v1 k2 v2 …) -> a fresh map with each pair added/updated.
;; Multi-pair builders, split by collection kind so the kernel op (`map-assoc` /
;; `vector-assoc`) is a **direct free-global call**, not a computed-head call through a
;; passed-in `set` function value. The computed-head form `(set m k v)` mis-compiles under
;; the JIT — a map accumulator held across the loop's safepoints goes stale (use-after-GC);
;; the direct call avoids that path (and is faster: no per-step function-value dispatch).
(defn assoc--map-pairs (m kvs)
  (if (empty? kvs) m (assoc--map-pairs (map-assoc m (first kvs) (second kvs)) (rest (rest kvs)))))
(defn assoc--vec-pairs (v kvs)
  (if (empty? kvs) v (assoc--vec-pairs (vector-assoc v (first kvs) (second kvs)) (rest (rest kvs)))))
(defn assoc "A fresh collection like `coll` with each `key value` pair added or updated.
For a map, keys are added or replaced; for a vector, integer indices in
`[0, count)` are replaced (an out-of-range index is an error — appending is via
`conj`, not `assoc`)."
  ;; The single-pair `(assoc coll k v)` arm is the hot case (it's what `update`,
  ;; tallies, and most call sites use): exact arity → VM-eligible, and it skips the
  ;; `& kvs` rest-list + the multi-pair loop, going straight to the kernel op.
  ((coll k v) (if (vector? coll) (vector-assoc coll k v) (map-assoc coll k v)))
  ((coll & kvs) (if (vector? coll) (assoc--vec-pairs coll kvs) (assoc--map-pairs coll kvs))))

;; (dissoc m k1 k2 …) -> a fresh map with each key removed.
(defn dissoc (m & ks)
  "A fresh map like `m` with each of the given keys removed."
  (fold map-dissoc m ks))

;; `map-pairs` (kernel) is the single map enumerator: the entries as a list of
;; [k v] vectors, in one O(n) pass. `keys`/`vals`/`contains?`/`reduce-kv` are all
;; Brood over it — no per-key `get`, so no O(n²) (this replaced the old `map-keys`
;; primitive + get-per-key `vals`).
;; `seq` (not `map-pairs`) so a record's keys/vals are its fields — no internal `:__id__`.
(defn keys (m) "The keys of map `m` (a record's are its fields, id-free)." (map first (seq m)))
(defn vals (m) "The values of map `m` (a record's are its fields, id-free)." (map second (seq m)))
(defn contains? (m k)
  "True if map `m` has key `k` (distinguishes a stored `nil`/`false` from
absence). O(1) via the CHAMP hash path (`map-get`), not an O(n) key scan: probe
with two distinct sentinels — a present key returns its stored value both times;
an absent key returns each sentinel, and those differ. (One sentinel can't tell
absence from a key whose *stored value* happens to equal it; two distinct ones
can.)"
  (if (set? m)
    (%set-has? m k)
    (let (a (map-get m k :%contains-miss-a))
      (if (= a :%contains-miss-a)
        (not (= (map-get m k :%contains-miss-b) :%contains-miss-b))
        true))))
(defn reduce-kv (f init m)
  "Fold over the entries of map `m`, calling `(f acc k v)`, starting from `init`."
  (fold (fn (acc p) (f acc (first p) (second p))) init (map-pairs m)))

;; ---- map: merge / update / nested access -----------------------------------
;; All Brood over the kernel ops (`map-assoc`/`map-pairs`) and the surface above
;; (`reduce-kv`/`contains?`/`get`). Every one returns a fresh map — maps are
;; immutable (ADR-026). The builders fold with the 3-arg kernel `map-assoc` (no
;; per-step rest-list, unlike variadic `assoc`).

;; `into` bulk-builds through the kernel's GC-quiet CHAMP builder (`%map-into`):
;; an implementation detail of *constructing* a fresh immutable map (no `Value` is
;; ever mutable, no path-copy per entry), so the merge family rides it for speed
;; while staying fully immutable.
(defn merge (& maps)
  "A single map combining the given maps left to right; on a duplicate key the rightmost map wins. `nil` maps are skipped, so `(merge)` is `{}`."
  (reduce (fn (acc m) (if (nil? m) acc (into acc m))) {} maps))

;; merge-with: on a shared key, combine with `(f existing new)` instead of replacing.
;; Read-modify-write per key, so it folds immutable `assoc` (each returns a fresh map).
(defn merge-with (f & maps)
  "Like `merge`, but when two maps share a key the combined value is `(f value-so-far next-value)` rather than just the latter. `nil` maps are skipped."
  (fold (fn (acc m)
          (if (nil? m)
            acc
            (reduce-kv (fn (a k v) (assoc a k (if (contains? a k) (f (get a k) v) v))) acc m)))
    {} maps))

(defn update (coll k f & args)
  "A collection like `coll` with the value at key/index `k` replaced by
`(apply f current args)`, where `current` is the existing value (`nil` if absent).
Works on maps (by key) and vectors (by integer index, which must be in range)."
  (assoc coll k (apply f (get coll k) args)))

(defn update-vals (m f)
  "A map like `m` with `f` applied to every value."
  (into {} (map (fn (p) [(first p) (f (second p))]) (map-pairs m))))
(defn update-keys (m f)
  "A map like `m` with `f` applied to every key (later keys win on a collision)."
  (into {} (map (fn (p) [(f (first p)) (second p)]) (map-pairs m))))

(defn select-keys (m ks)
  "A map of just the entries of `m` whose key is in `ks` (keys absent from `m` are skipped)."
  ;; One `map-get` per key — which also yields the value — rather than
  ;; `contains?` (its own probe) plus a separate `get`. A present key returns its
  ;; stored value (used directly); only when that value happens to equal the
  ;; first sentinel do we disambiguate present-vs-absent with a second sentinel,
  ;; so a key stored with `nil`/`false` is still kept (contains?'s guarantee).
  (into {}
    (keep (fn (k)
            (let (v (map-get m k :%select-miss-a))
              (if (= v :%select-miss-a)
                (let (v2 (map-get m k :%select-miss-b))
                  (if (= v2 :%select-miss-b) nil [k v2]))
                [k v])))
      ks)))

(defn zipmap (ks vs)
  "A map pairing each key in `ks` with the value at the same position in `vs`, stopping at the shorter."
  (into {} (zip ks vs)))

;; Nested-map access along a `path` (a sequence of keys). `get-in` walks; missing
;; key → default. `assoc-in` rebuilds, coercing a non-map node to `{}` so it can
;; create intermediate maps; `update-in` is `get-in` then `assoc-in`.
(defn get-in--walk (m path default)
  (cond
    (empty? path) m
    (and (map? m) (contains? m (first path))) (get-in--walk (get m (first path))
                                                (rest path) default)
    else default))
(defn get-in (m path & default)
  "The value in nested maps `m` at the key sequence `path`, or `default` (else `nil`) if any key along the way is absent. `(get-in m ())` is `m`."
  (get-in--walk m path (first default)))

;; check-allow: deliberately non-tail — depth = (count path) — a few keys, never data scale.
(check-allow :non-tail-recursion
  (defn assoc-in (m path v)
    "A nested copy of `m` with `v` stored at the key sequence `path`, creating intermediate maps as needed (a non-map node along the path becomes a fresh map)."
    (let (m (if (map? m) m {}) k (first path) ks (rest path))
      (if (empty? ks)
        (assoc m k v)
        (assoc m k (assoc-in (get m k) ks v))))))

(defn update-in (m path f & args)
  "A nested copy of `m` with the value at the key sequence `path` replaced by `(apply f current args)` (creating intermediate maps as needed)."
  (assoc-in m path (apply f (get-in m path) args)))

;; The nested-access family was `get-in`/`assoc-in`/`update-in` with no removal —
;; so deleting a nested key meant a hand-written `(update-in m parent dissoc k)`,
;; which every caller re-derived. Completes the set.
;; check-allow: deliberately non-tail — depth = (count path) — a few keys, never data scale.
(check-allow :non-tail-recursion
  (defn dissoc-in (m path)
    "A nested copy of `m` with the key sequence `path` REMOVED (the sibling of
  `assoc-in`). A path that doesn't exist is a no-op, and intermediate maps are left in
  place even when they end up empty — removing a leaf never prunes its branch."
    (let (k (first path) ks (rest path))
      (cond
        (not (map? m)) m
        (empty? ks) (dissoc m k)
        (contains? m k) (assoc m k (dissoc-in (get m k) ks))
        else m))))

(defn identity (x) "Return `x` unchanged." x)
(defn zero? (n) "True if `n` is zero." (= n 0))
(defn positive? (n) "True if `n` is greater than zero." (> n 0))
(defn negative? (n) "True if `n` is less than zero." (< n 0))
(defn abs (n) "The absolute value of `n`." (if (< n 0) (- n) n))
(defn sum (xs) "The sum of the numbers in `xs`." (fold %add 0 xs))
(defn product (xs) "The product of the numbers in `xs`." (fold %mul 1 xs))
(defn even? (n) "True if integer `n` is even." (= (rem n 2) 0))
(defn odd? (n) "True if integer `n` is odd." (not (even? n)))
;; `nan` is a reader-level float literal, so the language could *produce* a NaN
;; long before it could TEST for one: `=` reports NaN as equal to nothing (the
;; IEEE rule), which is simultaneously the only way to detect it. Naming that
;; removes the puzzle.
(defn nan? (x)
  "True if `x` is the float NaN — the value that is not equal to itself."
  (and (float? x) (not (= x x))))
(defn infinite? (x)
  "True if `x` is float `inf` or `-inf` (a finite float, and any int, is false)."
  (and (float? x) (or (= x inf) (= x -inf))))

;; Rounding & roots, all Brood over the one Float->Int primitive `floor` (toward
;; -inf) plus `rem`/`/`/`*`. `floor` of an int is itself, so these pass ints
;; through unchanged.
(defn ceil (x) "Round `x` toward positive infinity to an integer." (- (floor (- x))))
;; round half away from zero: floor(x+0.5) for x>=0, mirrored for x<0.
(defn round (x)
  "Round `x` to the nearest integer (halves away from zero)."
  (if (< x 0) (- (floor (+ (- x) 0.5))) (floor (+ x 0.5))))

;; (round-to x places) — round to a fixed number of decimal places, staying a
;; number (for a fixed-width *string*, e.g. "3.10", use the `to-fixed` primitive).
;; Subject to the usual binary-float caveat: a "halfway" decimal like 1.255 isn't
;; exactly representable, so it may round the way its nearest f64 actually lies.
(defn round-to (x places)
  "Round `x` to `places` decimal places (halves away from zero); returns a number —
a float for a float `x` unless the rounded value is an integer, exact for an exact `x`."
  ;; The final `/` is `round`'s int result over the int scale, so since ADR-196 made
  ;; integer `/` exact it yields a RATIO whenever it doesn't divide evenly, and
  ;; `(round-to 3.14159 2)` came back `157/50` instead of `3.14`. Rounding recovers no
  ;; exactness a float never had, so a float `x` converts back — which restores the
  ;; pre-ADR-196 contract exactly: that `/` was float division, giving a float in the
  ;; non-integral case and an int in the integral one (`(round-to 2.5 0)` → 3, because
  ;; a denominator of 1 demotes). An exact `x` keeps the exact answer.
  (let (scale (pow 10 places)
        r (/ (round (* x scale)) scale))
    (if (and (float? x) (ratio? r)) (->float r) r)))

;; (quot a b) — truncated integer division (toward zero), the quotient partner to
;; `rem`. (a - (rem a b)) is exactly divisible by b, so `/` returns an exact int
;; (no float round-trip — correct even for large i64, unlike (floor (/ a b))).
(defn quot (a b)
  "Truncated integer division of `a` by `b` (toward zero); the quotient partner to `rem`."
  (%quot a b))

;; (pow base exp) — `exp` must be an integer (use `sqrt` for roots). Int base +
;; non-negative exp stays an int (overflow raises, like `*`); a negative exp gives
;; the reciprocal. Tail-recursive, so a large exponent is O(1) stack.
;;
;; Since ADR-196 an EXACT base's reciprocal is a ratio, which is both better and
;; immune to the underflow the machinery below exists for: `(pow 2 -2000)` is exactly
;; 1/2^2000, where a float reciprocal would be 0.0. A float base still goes through
;; that machinery — an f64 has nowhere exact to put the answer.
;; True for an infinite float: doubling leaves it unchanged and it isn't zero. Used to
;; detect that the positive power overflowed, without naming a magic constant.
(defn pow--inf? (x) (and (float? x) (not (= x 0.0)) (= x (* x 2.0))))

(defn pow (base exp)
  "`base` raised to integer `exp`. A negative exponent gives the reciprocal — **exact**
(a ratio) for an exact `base`, a float for a float `base`."
  (cond
    (not (int? exp)) (error "pow: exponent must be an integer (use sqrt for roots), got " exp)
    (< exp 0) (pow--reciprocal base exp)
    else (pow--acc base exp 1)))

;; A negative exponent used to be `(/ 1 (pow base (- exp)))`, which loses the whole
;; subnormal range: when the *positive* power overflows, `1/inf` is 0.0, so
;; `(pow 2.0 -1074)` gave 0.0 where 2^-1074 is perfectly representable (5e-324), and
;; every exponent past -1023 was wrong the same way. An int base fails for the sibling
;; reason — `base^|exp|` becomes a bignum rather than inf, and *its* reciprocal
;; underflows. So the test is on the reciprocal, not on the power: a 0.0 result may have
;; lost a representable answer either way. Recompute by splitting the exponent in half,
;; which keeps every intermediate in range and is exact for a radix-2 base. Terminates
;; because `(quot exp 2)` is strictly closer to zero than `exp` once `exp <= -2`, and the
;; halves only recurse while they too come back 0.0. A genuinely-zero answer (10.0^-400,
;; below the subnormal floor) costs one extra recompute and still yields 0.0.
;; (Found by the Paranoia port, 2026-07-26.)
(defn pow--reciprocal (base exp)
  (let (p (pow--acc base (- exp) 1)
        r (if (pow--inf? p) 0.0 (/ 1 p)))
    (if (and (= r 0.0) (<= exp -2))
      (let (h (quot exp 2))
        (* (pow base h) (pow base (- exp h))))
      r)))

(defn pow--acc (base exp acc) (if (= exp 0) acc (pow--acc base (- exp 1) (* acc base))))

;; (sqrt n) — Newton's method (Babylonian): guess' = (guess + n/guess)/2, iterated
;; Delegates to `%f64-sqrt` (f64::sqrt) for IEEE 754 correctness on all inputs
;; including subnormals (the old Newton's-method initial guess `(/ n 2.0)` would
;; underflow to 0.0 for subnormal n, triggering a false division-by-zero).
;; Always returns a Float; a negative argument raises.
(defn sqrt (n)
  "The square root of `n` (IEEE 754; always a float). Negative `n` raises."
  (cond (< n 0) (error "sqrt: negative argument " n) (<= n 0) 0.0 else (%f64-sqrt n)))

;; Euclidean modulo: the result is always non-negative and lies in
;; [0, (abs b)). Brood over the `rem` primitive (truncated remainder), nudged
;; back into range when `rem` comes out negative. (÷0 raises via `rem`.)
;; Note this is *not* floored modulo: `(mod 7 -3)` is 1, not -2.
(defn mod (a b)
  "Euclidean modulo: the result is always non-negative and lies in [0, |b|)."
  (let (r (rem a b)) (if (< r 0) (+ r (abs b)) r)))

;; ---- math constants ---------------------------------------------------------
(def pi 3.141592653589793)
(def e 2.718281828459045)

;; ---- I/O --------------------------------------------------------------------
;; Output is redirectable. A *port* is just a 1-arg fn that consumes a ready
;; string (`(fn (s) …)`); `*out*`/`*err*` are dynamic vars holding the current
;; stdout/stderr ports, and `print`/`println`/`eprint`/`eprintln` render their
;; args (Rust `%render` — the exact text stdout would show) and hand the string to
;; the port. The defaults are the kernel writers `%write-out`/`%write-err`; rebind
;; with `binding` (or `std/io`'s `with-out`/`with-err`) to send output to a
;; process, a buffer, or any callback — see std/io.blsp. The default `*out*` stays
;; `%write-out`, which honours the capture stack, so `with-out-str` is unaffected.
;;
;; Declared with the `%declare-dynamic` primitive directly because the `defdyn`
;; macro isn't defined until further down the prelude (and `print` lives here).
(%declare-dynamic '*out*)
(def *out* %write-out)
(%declare-dynamic '*err*)
(def *err* %write-err)
;; `*show*` — a late-bound per-argument display transform for the SCREEN printers
;; (`print`/`println`/`eprint`/`eprintln`). Declared here; the Display protocol (core,
;; defined at the end of this prelude) sets it to `show--print-hook`, which routes a
;; *record* through the `Display` ability's `to-str` op so a record can define how it
;; prints (Elixir's `String.Chars` model) while built-ins keep the fast native render.
;; An ordinary dynamic var, so `(binding (*show* nil) …)` disables the transform for a
;; scope. Only the screen printers consult it; `str`/`pr-str`/`fmt` stay native.
(%declare-dynamic '*show*)
(def *show* nil)
(defn show--args (xs)
  ;; Each print argument, run through the installed `*show*` transform — or the
  ;; arguments untouched when none is installed (the default fast path).
  (if *show* (map *show* xs) xs))
(defn print (& xs)
  "Write the display forms of the arguments to the current `*out*` port (stdout by default); returns nil."
  (*out* (apply %render (show--args xs)))
  nil)
(defn println (& xs)
  "Write the display forms of the arguments to the current `*out*` port, followed by a newline."
  (*out* (str (apply %render (show--args xs)) "\n"))
  nil)
(defn eprint (& xs)
  "Write the display forms of the arguments to the current `*err*` port (stderr by default); returns nil."
  (*err* (apply %render (show--args xs)))
  nil)
(defn eprintln (& xs)
  "Write the display forms of the arguments to the current `*err*` port, followed by a newline."
  (*err* (str (apply %render (show--args xs)) "\n"))
  nil)

;; `with-out-str` runs `body` for effect with stdout diverted into a capture
;; buffer, and returns the captured text (a string) instead of `body`'s value —
;; the standard "what did this print?" sink. Capture is process-scoped *and*
;; inherited by anything `body` spawns, so a printer running in a child process is
;; captured too. Captures nest (the buffer is a stack), so a `with-out-str` inside
;; an outer capture — e.g. a `nest mcp` tool handler — drains only its own output.
;; The buffer is popped even if `body` throws (the `catch` re-raises), so a thrown
;; error never leaves a dangling capture diverting all later output.
(defmacro with-out-str (& body)
  "Evaluate `body` with stdout captured, and return everything it printed as a
string (`\"\"` if it printed nothing), discarding `body`'s own value. Output from
processes `body` spawns is captured too; nested `with-out-str`s compose."
  `(do
     (%capture-begin)
     (try
       (do ~@body (%capture-take))
       (catch e (do (%capture-take) (throw e))))))

;; The stderr counterpart of `with-out-str`. It works differently, and has to:
;; stdout capture is a kernel buffer (`%capture-begin`), while `eprint`/`eprintln`
;; write through the `*err*` PORT — so this rebinds that port to a collecting sink
;; instead. Consequences worth knowing: it captures only what goes through `*err*`
;; (a Rust-side `eprintln!`, e.g. a kernel reload diagnostic, is NOT interceptable
;; this way), and it does not follow into spawned processes the way `with-out-str`
;; does. Accumulation uses a `Table` because data is immutable — the one sanctioned
;; mutable structure, and a local one that never escapes.
(defmacro with-err-str (& body)
  "Evaluate `body` with the `*err*` port captured, returning everything written to it as a string (`\"\"` if nothing was), discarding `body`'s own value. For asserting on a warning — and for keeping an expected warning out of a test run's output. Only intercepts writes through `*err*` (`eprint`/`eprintln`), not stderr written by the kernel itself."
  (let (sink (gensym "err-sink"))
    `(let (~sink (table))
       (try
         (do
           (binding (*err* (fn (s)
                             (table-put ~sink :text (str (table-get ~sink :text "") s))
                             nil))
             ~@body)
           (table-get ~sink :text ""))
         (catch e (do (table-drop ~sink) (throw e)))))))

;; ---- threading macros (demonstrate that macros compute at expansion time) ----
;; (-> x (f a) (g b))  =>  (g (f x a) b)   ; thread as FIRST argument
;; (->> x (f a) (g b)) =>  (g b (f a x))   ; thread as LAST argument
(defn thread-first-step (acc form)
  (if (pair? form) (cons (first form) (cons acc (rest form))) (list form acc)))
(defmacro -> (x & forms)
  "Thread `x` through the forms as each one's *first* argument: `(-> x (f a) (g b))` is `(g (f x a) b)`."
  (reduce thread-first-step x forms))

(defn thread-last-step (acc form) (if (pair? form) (append form (list acc)) (list form acc)))
(defmacro ->> (x & forms)
  "Thread `x` through the forms as each one's *last* argument: `(->> x (f a) (g b))` is `(g b (f a x))`."
  (reduce thread-last-step x forms))

;; (as-> x name (f a name) (g name b)) — thread `x` as `name`, in ANY position.
;; Brood's `let` is sequential and re-binds a repeated name, so this is one `let`:
;;   (as-> 5 $ (+ $ 1) (* $ 2))  =>  (let ($ 5  $ (+ $ 1)  $ (* $ 2)) $)  =>  12
(defmacro as-> (expr name & forms)
  "Thread `expr` through `forms`, re-binding it to `name` at each step so it can sit in *any* argument position: `(as-> 5 $ (+ $ 1) (* $ 2))` is `12`."
  (let (steps (reduce (fn (acc form) (append acc (list name form))) (list name expr) forms))
    `(let ~steps ~name)))

;; ---- conditional threading & short-circuit threading ------------------------
;; `some->`/`some->>` thread like `->`/`->>` but stop and yield `nil` the moment a
;; step produces `nil`; `cond->`/`cond->>` thread `x` only through the forms whose
;; guard is truthy. Both build on the `thread-first-step`/`thread-last-step`
;; placement helpers above, so "where does the value go" is defined once.
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn some-thread--build (place forms step)
    (if (empty? forms)
      place
      `(if (nil? ~place)
         nil
         (let (~place ~(step place (first forms)))
           ~(some-thread--build place (rest forms) step))))))
(defmacro some-> (x & forms)
  "Thread `x` through `forms` as each one's *first* argument (like `->`), but short-circuit to `nil` as soon as any step yields `nil`."
  (let (v (gensym "v")) `(let (~v ~x) ~(some-thread--build v forms thread-first-step))))
(defmacro some->> (x & forms)
  "Thread `x` through `forms` as each one's *last* argument (like `->>`), but short-circuit to `nil` as soon as any step yields `nil`."
  (let (v (gensym "v")) `(let (~v ~x) ~(some-thread--build v forms thread-last-step))))

;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn cond-thread--build (place clauses step)
    (if (empty? clauses)
      place
      `(let (~place (if ~(first clauses) ~(step place (second clauses)) ~place))
         ~(cond-thread--build place (rest (rest clauses)) step)))))
(defmacro cond-> (x & clauses)
  "Thread `x` through the `test form` clause pairs, applying each `form` (as its *first* argument, like `->`) only when its `test` is truthy: `(cond-> {} add-a? (assoc :a 1))`."
  (let (v (gensym "v")) `(let (~v ~x) ~(cond-thread--build v clauses thread-first-step))))
(defmacro cond->> (x & clauses)
  "Thread `x` through the `test form` clause pairs, applying each `form` (as its *last* argument, like `->>`) only when its `test` is truthy."
  (let (v (gensym "v")) `(let (~v ~x) ~(cond-thread--build v clauses thread-last-step))))

(defmacro doto (x & forms)
  "Evaluate `x` once, run each `form` with it spliced in as the *first* argument (for side effects), then return `x`: `(doto (table) (table-put :a 1) (table-put :b 2))`."
  (let (v (gensym "v"))
    `(let (~v ~x)
       ~@(map (fn (form) (thread-first-step v form)) forms)
       ~v)))

;; ---- binding-conditionals: bind, test the *source* value, branch -------------
;; `if-let`/`when-let` evaluate the binding expression once, branch on its
;; truthiness, and bind the target (a symbol or destructuring pattern) to it in
;; the truthy branch. Testing a fresh temp (not the pattern) is what makes
;; destructuring targets — `(when-let ([k v] (first-entry m)) …)` — behave.
(defmacro if-let (binding then & else)
  "Bind `(name expr)`; if `expr` is truthy, evaluate `then` with `name` bound to it, else evaluate `else` (or `nil`). `name` may be a destructuring pattern."
  (let (name (first binding) expr (second binding) v (gensym "v"))
    `(let (~v ~expr) (if ~v (let (~name ~v) ~then) ~@else))))
(defmacro when-let (binding & body)
  "Bind `(name expr)`; when `expr` is truthy, evaluate `body` (returning the last) with `name` bound to it, else `nil`. `name` may be a destructuring pattern."
  (let (name (first binding) expr (second binding) v (gensym "v"))
    `(let (~v ~expr) (when ~v (let (~name ~v) ~@body)))))

;; ---- with: sequential match-binding with fall-through -----------------------
;; Elixir's `with`, spelled as flat `pattern expr` pairs (the `let` shape). Each
;; `expr` is matched against its `pattern` in order; the first value that does
;; NOT match short-circuits, and the body runs only when every step matched, with
;; all bindings in scope. Pure sugar over nested `match`. A trailing `:else`
;; section (its own `match` clauses) runs the short-circuited value through them;
;; with no `:else`, the value that failed to match falls straight through as the
;; result — so an `[:error …]` becomes the answer untouched.
(defn with--split-else (forms before)
  ;; [happy-forms else-clauses] — split `forms` at the first bare `:else` keyword.
  (cond
    (empty? forms) [(reverse before) nil]
    (= (first forms) :else) [(reverse before) (rest forms)]
    else (with--split-else (rest forms) (cons (first forms) before))))
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn with--build (bindings body else-clauses)
    (if (empty? bindings)
      `(do ~@body)
      (let (pattern (first bindings)
            expr (second bindings)
            more (rest (rest bindings))
            miss (gensym "miss"))
        `(match ~expr
           (~pattern ~(with--build more body else-clauses))
           (~miss ~(if (empty? else-clauses) miss `(match ~miss ~@else-clauses))))))))
(defmacro with (bindings & body)
  "Sequentially match each `pattern expr` pair in `bindings`; the first value that fails its pattern short-circuits, else `body` runs (returning its last form) with every binding in scope. A trailing `:else` section of `match` clauses handles the short-circuited value; without one it is returned as-is. Brood's flat `with`, like Elixir's."
  (let ([happy else-clauses] (with--split-else body []))
    (with--build bindings happy else-clauses)))

;; ---- local loops: just use `letrec` -----------------------------------------
;; Brood has no `loop`/`recur` macro. A self-contained *local* loop is a `letrec`-
;; bound closure you call by name:
;;   (letrec (go (fn (i acc) (if (= i n) acc (go (inc i) (+ acc i))))) (go 0 0))
;; It closes over the enclosing scope (thread only the *changing* state; the loop's
;; params are exactly what evolves), and a tail call to `go` is a proper tail call —
;; O(1) stack. A top-level `defn` works too when the loop needs no enclosing locals.
;; (`loop`/`recur` were prototyped then dropped: `recur` is a workaround for runtimes
;; without tail calls — which Brood has — and `loop` was just `letrec` sugar not worth
;; a reserved word. See ADR-154 / deferred.md.)

;; ---- side-effecting iteration (function form of `doseq`) --------------------
(defn run! (f coll)
  "Apply `f` to each item of `coll` for its side effects, returning `nil`. The function-valued counterpart of `doseq`: `(run! println xs)`."
  (fold (fn (acc x) (f x) acc) nil coll)
  nil)

;; ---- error handling ----
;; The kernel gives us `throw` (raise) and `%try` (low-level catch). Everything
;; user-facing — `error`, `try`/`catch` — is written here in Brood.
(defn last (xs) "The last item of `xs`." (first (reverse xs)))
(defn but-last (xs) "All but the last item of `xs`, as a list." (reverse (rest (reverse xs))))

(defn error (& parts)
  "Raise an error whose message is the concatenated display forms of `parts`."
  (throw (apply str parts)))

;; `(catch Type e body…)` — Clojure/Java's *typed* catch. Brood's `catch` binds
;; ONE bare symbol and has no exception class, so this shape is not an error the
;; reader can see: the class name silently becomes the binding and the intended
;; binder is evaluated as a statement. It produces a WRONG PROGRAM, not a
;; diagnostic — `(catch Exception e (println "caught" e))` binds the value to
;; `Exception` and prints the prelude's `e` (2.718…). Detected by shape: a symbol
;; binder whose handler *starts* with a bare symbol and has more forms after it.
;; There is no legitimate reading to protect — a leading bare symbol followed by
;; more body is dead code in every case — so this is a zero-false-positive guard.
(defn try--class-catch? (clause)
  (let (handler (rest (rest clause)))
    (and (symbol? (second clause))
      (> (count handler) 1) (symbol? (first handler)))))

;; (try body... (catch e handler...)) => (%try (fn () body...) (fn (e) handler...))
;; With no catch clause, it's just (do body...).
(defmacro try (& body)
  "Evaluate `body`; if a final `(catch e handler...)` clause is present, run it with the raised value bound to `e` when `body` throws."
  (let (clause (last body))
    (if (and (pair? clause) (= (first clause) 'catch))
      (let (init (but-last body) evar (second clause) handler (rest (rest clause)))
        (if (try--class-catch? clause)
          (error "try: `(catch "
            (str evar) " " (str (first handler))
            " …)` looks like Clojure's typed catch, which Brood does not have. "
            "`catch` takes ONE bare binding and no exception class: write `(catch "
            (str (first handler)) " …)` and branch on the caught value's shape in the body "
            "(`(get e :kind)`, `match`, `error-message`). As written, `" (str evar)
            "` would be bound to the raised value and `" (str (first handler))
            "` evaluated as a statement.")
          `(%try (fn () ~@init) (fn (~evar) ~@handler))))
      (if (and (pair? clause) (= (first clause) 'fn))
        ;; Common mistake: (try body (fn (e) handler)) instead of (try body (catch e handler)).
        ;; Fail loud at macro-expansion time so the bug is caught before it silently becomes
        ;; (do body (fn (e) ...)) — a handler that is never installed.
        (error "try: last form is `"
          (pr-str clause) "` — did you mean `(catch "
          (let (params (second clause))
            (if (and (pair? params) (not (nil? params)))
              (str (first params))
              "e"))
          " ...)`? Syntax: (try body... (catch e handler...))")
        `(do ~@body)))))

;; A thrown value has no single shape: `(throw x)` hands `catch` the value `x`
;; verbatim (a bare string from `error`, a keyword, a `[:tag …]` vector, …),
;; while every *kernel* error is the canonical `{:kind :message [:code :file
;; :line :col :hint]}` map. `error-message` is the one accessor that turns any of
;; them into a human string, so a `(catch e …)` handler never has to branch on
;; the shape itself.
(defn error-message (e)
  "A human-readable message string for a caught value `e`: a raised string
as-is, the `:message` of a structured error map (what the kernel throws), else
its printed form."
  (cond
    (string? e) e
    (and (map? e) (get e :message)) (get e :message)
    else (pr-str e)))

;; ---- dynamic variables ------------------------------------------------------
;; Process-scoped, dynamically-bound variables (Lisp "special" vars), for
;; config-style knobs like *print-depth*. `defdyn` declares one with a default;
;; `binding` rebinds it for the dynamic extent of a body, restoring on exit (even
;; on error). A reference to the var resolves to the innermost active `binding`,
;; else the default. Bindings are per-process — they do NOT reach a `spawn`ed
;; child (it starts from the defaults). The kernel supplies only `%declare-dynamic`,
;; `%binding`, and `dynamic?`; the surface is these two macros (the `try` precedent).

;; (defdyn *x* 10) => declare *x* dynamic, then def its default.
(defmacro defdyn (name default)
  "Declare `name` a dynamic (process-scoped special) variable with the given default, rebindable via `binding`. Also marks the name **ambient** — never namespaced, so a `def` of it from any module rebinds this one root binding."
  (do
    ;; Declare at EXPANSION time as well as at run time. `defdyn` is the *only* door
    ;; to an ambient (never-namespaced) name, and the compile pass resolves
    ;; namespaces AFTER macroexpansion — so the mark has to exist before the `def`
    ;; head below is qualified, or `(defdyn *x* 0)` inside a module would define
    ;; `mod/*x*` while `binding` and every reader looked for bare `*x*`. The runtime
    ;; `%declare-dynamic` stays for a `defdyn` form built and `eval`'d dynamically.
    (%declare-dynamic name)
    `(do (%declare-dynamic '~name) (def ~name ~default))))

;; Split a flat binding list (*a* va *b* vb) into its names and value forms, at
;; expansion time (like the threading-macro helpers above).
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn binding--names (b) (if (nil? b) nil (cons (first b) (binding--names (rest (rest b)))))))
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn binding--vals (b) (if (nil? b) nil (cons (second b) (binding--vals (rest (rest b)))))))

;; (binding (*a* 1 *b* 2) body...) => (%binding '(*a* *b*) [1 2] (fn () body...))
;; The names go out as a quoted list and the values as a vector literal — both
;; reader/evaluator syntax, never function calls — so a locally-shadowed `list`
;; or `map` can't break the expansion (`fn`/`quote` are special forms).
(defmacro binding (bindings & body)
  "Rebind the dynamic variables in `bindings` (a flat `name value ...` list) for the dynamic extent of `body`, restoring them on exit (even on error)."
  (if (vector? bindings)
    (error "binding: bindings must be a list, not a vector: write (binding (*a* 1 *b* 2) …)."
      " Brood is lists-for-code, vectors-for-data (unlike Clojure).")
    (if (odd? (count bindings))
      (error "binding: bindings must be name/value pairs, got " bindings)
      `(%binding (quote ~(binding--names bindings)) [~@(binding--vals bindings)] (fn () ~@body)))))

;; ---- pattern matching -------------------------------------------------------
;; The matcher is written in Brood, not Rust: a pattern->code compiler (a macro
;; plus expand-time helper `defn`s, exactly like the threading macros compute at
;; expansion time) that emits nested `if`/`let` over existing primitives —
;; `pair?`, `first`, `rest`, `nil?`, `vector?`, `vector-ref`, `vector-length`,
;; and `%eq` (the kernel equality op, used by convention over `=` so a local
;; binding named `=` can't hijack a generated match). No new special form (the
;; `try`/`catch` precedent: a macro over primitives). One compiler serves `match`
;; here, and the `let` / `fn` special forms delegate to it for destructuring.
;; See docs/pattern-matching.md.
;; (Note: the other emitted primitives — `first`/`rest`/`pair?`/… — are still
;; ordinary names a local binding could shadow; full macro hygiene is deferred.)
;;
;; THE ONE TRAP: a bare symbol in a pattern *binds* (and shadows); it does not
;; test against a same-named value. Match a known value with a keyword (:ok), a
;; quoted symbol ('none), or a pin (~x). The grammar:
;;   _              wildcard (matches anything, binds nothing)
;;   x              binds x  (a repeated x is an equality constraint — non-linear)
;;   42 "s" :k nil  a literal, matched by =
;;   'sym           the literal symbol sym
;;   ~expr          the current value of expr (a pin)
;;   (p1 p2 ...)    a list of that exact length, element-wise
;;   (p1 & rest)    head(s) + tail bound (the & rest marker)
;;   [p1 p2 ...]    a vector of that exact length (the tagged-data / tuple idiom)

;; -- pattern shape predicates --
(defn match-wildcard? (p) (= p '_))
(defn match-bind-sym? (p) (and (symbol? p) (not (= p '_)) (not (= p '&))))
(defn match-quoted? (p) (and (pair? p) (= (first p) 'quote)))
;; A **pin** — `^expr`, read as `(%pin expr)`: match the current *value* of `expr`
;; rather than binding a name.
(defn match-pin? (p) (and (pair? p) (= (first p) '%pin)))
;; `~expr` in pattern position — the pre-`^` pin spelling. `~` now belongs to
;; quasiquote alone (a pin written `~expr` IS `(unquote expr)`, so a macro template
;; consumed it before the pattern compiler ever saw it, making pinned patterns
;; unemittable from a macro). Left as a list pattern it would silently try to match
;; a 2-element list headed by the symbol `unquote`, so name it instead.
(defn match-stale-pin? (p) (and (pair? p) (= (first p) 'unquote)))
;; `(or p q …)` — an ALTERNATIVE pattern: try each in order, first match wins
;; (ADR-160). `(and p q …)` — a CONJUNCTION: every pattern must match the same
;; value, which is also how you capture the whole while destructuring it (Clojure's
;; `:as`, Rust's `x @ pat`): `(and whole {:keys [a]})`.
(defn match-or-pattern? (p) (and (pair? p) (= (first p) 'or)))
(defn match-and-pattern? (p) (and (pair? p) (= (first p) 'and)))
;; `(not …)` stays rejected: it binds nothing and reads as a *guard*, which is what
;; `:when` is for. Read as a plain list pattern it would silently bind a variable
;; named `not`, so name it (ADR-152).
(defn match-not-pattern? (p) (and (pair? p) (= (first p) 'not)))
(defn match-not-pattern-error (p)
  (error (str "match: `(not …)` is not a pattern — a negative match binds nothing,"
           " so put the test in a `:when` guard instead:" " (x :when (not " (pr-str (second p))
           ") body…)." " (Read as a list pattern it would BIND a variable named `not`.)")))

;; `(record name {map-pattern}?)` — a RECORD pattern (ADR-186): matches a `defrecord` value
;; whose nominal id is `name` (a bare symbol qualified to the current ns, or a `mod/name`),
;; then matches the optional map pattern against its fields. A record is a map, so this is an
;; id assertion plus an ordinary map pattern — `:keys`/`:or`/nested `{:k p}` all compose. The
;; id is derived SYNTACTICALLY from `name` (via `ability--id-kw`), so no registry lookup is
;; needed at expansion (unlike a positional pattern, which would need the definition's field
;; order — deferred). Named, like `and`/`or`/`bytes`, so a plain list pattern isn't stolen.
(defn match-record-pattern? (p) (and (pair? p) (= (first p) 'record)))

;; Every alternative of an `or` must bind the SAME names — otherwise the body could
;; reference a name only some alternatives bind, and which one it is depends on the
;; input. Rust enforces the same rule for the same reason.
(defn match-or-check (alts)
  (let (name-sets (map (fn (a) (sort (map name (pattern-vars a)))) alts))
    (when (not (every? (fn (ns) (= ns (first name-sets))) name-sets))
      (error (str "match: every alternative of an `(or …)` pattern must bind the same"
               " names, got " (pr-str (map (fn (ns) ns) name-sets))
               " — a body can't reference a name only some alternatives bind."
               " Use separate clauses when the bindings differ.")))))

;; -- expand-time helpers --
(defn match-member? (x xs)
  (cond (empty? xs) false (= x (first xs)) true else (match-member? x (rest xs))))

(defn match-vec->list (v) (match-vec-collect v (dec (vector-length v)) nil))
(defn match-vec-collect (v i acc)
  (if (< i 0) acc (match-vec-collect v (dec i) (cons (vector-ref v i) acc))))

;; The variables a pattern binds. Threaded as `bound` through the compiler so a
;; variable that recurs becomes an equality check (non-linear patterns).
(defn pattern-vars (pat)
  (cond
    (match-wildcard? pat) nil
    (match-bind-sym? pat) (list pat)
    (match-quoted? pat) nil
    (match-pin? pat) nil
    (match-stale-pin? pat) nil
    (match-bytes-pattern? pat) (match-bytes-vars (rest pat))
    ;; `or` binds the same names in every alternative (checked at compile), so the
    ;; first alternative's set is the whole set; `and` binds the union.
    (match-or-pattern? pat) (pattern-vars (second pat))
    (match-and-pattern? pat) (match-seq-vars (rest pat))
    ;; a record pattern binds whatever its (optional) inner map pattern binds
    (match-record-pattern? pat) (let (mp (first (rest (rest pat)))) (if mp (pattern-vars mp) nil))
    (pair? pat) (match-seq-vars pat)
    (vector? pat) (match-seq-vars (match-vec->list pat))
    (match-map-pattern? pat) (match-map-vars pat)
    else nil))
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-seq-vars (pats)
    (cond
      (empty? pats) nil
      (= (first pats) '&) (match-seq-vars (rest pats))
      else (append (pattern-vars (first pats)) (match-seq-vars (rest pats))))))

;; The core: compile `pat` against the value of the symbol `target`, given the
;; already-`bound` names; on a match run `success`, else `fail`. Returns code.
(defn match-compile (pat target bound success fail)
  (cond
    (match-wildcard? pat) success
    (match-bind-sym? pat) (if (match-member? pat bound)
                            `(if (%eq ~target ~pat) ~success ~fail)
                            ; non-linear: equal to earlier binding
                            `(let (~pat ~target) ~success))
    ; fresh bind
    (match-quoted? pat) `(if (%eq ~target ~pat) ~success ~fail)
    ; 'sym self-evaluates to the symbol
    (match-pin? pat) `(if (%eq ~target ~(second pat)) ~success ~fail)
    ; ^expr: match the value of expr
    (match-stale-pin? pat) (error "match: `~"
                             (pr-str (second pat)) "` is not a pattern — a pin is written `^"
                             (pr-str (second pat))
                             "` (`~` belongs to quasiquote alone). To match the literal"
                             " 2-element list (unquote x), quote the head: ('unquote x).")
    (match-bytes-pattern? pat) (match-compile-bytes (rest pat) target bound success fail)
    ; (bytes seg…): destructure a bytes value, Elixir-style binary matching
    (match-not-pattern? pat) (match-not-pattern-error pat)
    ; (not …): rejected — a negative match binds nothing; use a :when guard
    (match-or-pattern? pat) (match-compile-or (rest pat) target bound success fail)
    ; (or p q …): first alternative that matches wins
    (match-and-pattern? pat) (match-compile-and (rest pat) target bound success fail)
    ; (and p q …): every pattern must match the same value (capture-and-destructure)
    (match-record-pattern? pat) (match-compile-record pat target bound success fail)
    ; (record name {…}): a defrecord value of nominal id `name`, then a map pattern
    (pair? pat) (match-compile-list pat target bound success fail)
    (vector? pat) (match-compile-vector pat target bound success fail)
    (match-map-pattern? pat) (match-compile-map pat target bound success fail)
    else `(if (%eq ~target ~pat) ~success ~fail)))
; literal (number/string/keyword/bool/nil)

;; ---- bytes integer decode/encode: byte-aligned, big-endian by default ----
;; The workhorses behind the typed (bytes …) pattern segments (:u16, :i32-le, …)
;; below, and useful directly when parsing at explicit offsets. Widths are in
;; bytes (1–8); reads are bounds-checked by byte-at. An unsigned 8-byte read
;; whose top bit is set exceeds the i64 range and widens to a big integer
;; (arithmetic auto-promotes) — read :i64 to get the raw two's complement.

(defn bytes--acc-be (bs i end acc)
  (if (>= i end) acc (bytes--acc-be bs (+ i 1) end (+ (* acc 256) (byte-at bs i)))))

(defn bytes--acc-le (bs low i acc)
  (if (< i low) acc (bytes--acc-le bs low (- i 1) (+ (* acc 256) (byte-at bs i)))))

(defn bytes--width-check (who n)
  (if (and (int? n) (>= n 1) (<= n 8))
    n
    (error (str who ": width must be an int in 1–8, got " (pr-str n)))))

(defn bytes-uint (bs off n)
  "Read `n` bytes (1–8) of `bs` at `off` as a big-endian unsigned integer."
  (bytes--acc-be bs off (+ off (bytes--width-check "bytes-uint" n)) 0))

(defn bytes-uint-le (bs off n)
  "Read `n` bytes (1–8) of `bs` at `off` as a little-endian unsigned integer."
  (bytes--acc-le bs off (+ off (- (bytes--width-check "bytes-uint-le" n) 1)) 0))

(defn bytes-int (bs off n)
  "Read `n` bytes (1–8) of `bs` at `off` as a big-endian signed (two's-complement) integer."
  (do
    (bytes--width-check "bytes-int" n)
    (let (b0 (byte-at bs off))
      (bytes--acc-be bs (+ off 1) (+ off n) (if (>= b0 128) (- b0 256) b0)))))

(defn bytes-int-le (bs off n)
  "Read `n` bytes (1–8) of `bs` at `off` as a little-endian signed (two's-complement) integer."
  (do
    (bytes--width-check "bytes-int-le" n)
    (let (bt (byte-at bs (+ off (- n 1))))
      (bytes--acc-le bs off (+ off (- n 2)) (if (>= bt 128) (- bt 256) bt)))))

(defn int->bytes--be (v w acc)
  (if (<= w 0)
    acc
    (int->bytes--be (bit-shift-right v 8) (- w 1) (cons (bit-and v 255) acc))))

(defn int->bytes (v n)
  "Encode integer `v` as `n` bytes (1–8), big-endian two's complement. Bits
above `n` bytes are truncated (the bit-syntax convention), so negatives encode
to their low `n` bytes: (int->bytes -1 2) => #b\"\\xff\\xff\"."
  (bytes (int->bytes--be v (bytes--width-check "int->bytes" n) nil)))

(defn int->bytes-le (v n)
  "Encode integer `v` as `n` bytes (1–8), little-endian two's complement
(truncating, like int->bytes)."
  (bytes (reverse (int->bytes--be v (bytes--width-check "int->bytes-le" n) nil))))

;; ---- bytes patterns: (bytes seg…) — Elixir-style binary destructuring ----
;; Each `seg` consumes bytes left-to-right from the target:
;;   int / #b"…" literal   match those exact byte(s)
;;   symbol                bind exactly one byte (as an int 0–255); `_` skips one
;;   (sym n)               bind `n` bytes (as a bytes value); n may be an int OR a
;;                         symbol bound by an earlier segment (dynamic size); `(_ n)` skips n
;;   (sym :u16)            bind a typed integer segment: :u8/:u16/:u32/:u64 unsigned,
;;                         :i8/:i16/:i32/:i64 signed two's complement; big-endian by
;;                         default, with explicit :uN-be/:uN-le (:iN-…) variants;
;;                         `(_ :u32)` skips the segment's width
;;   & rest                bind the remaining bytes (must be the last segment)
;; Without a trailing `& rest`, the bytes must be consumed exactly (count match).

(defn match-bytes-pattern? (pat)
  (and (pair? pat) (= (first pat) (quote bytes))))

; literal → binds nothing
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-bytes-vars (segs)
    (cond
      (empty? segs) nil
      (= (first segs) '&) (match-bytes-vars (rest segs))
      (pair? (first segs)) (let (s (first (first segs)))
                             ; (sym n) sized
                             (if (match-wildcard? s)
                               (match-bytes-vars (rest segs))
                               (cons s (match-bytes-vars (rest segs)))))
      (match-bind-sym? (first segs)) (cons (first segs) (match-bytes-vars (rest segs)))
      else (match-bytes-vars (rest segs)))))
;; typed integer segment spec: :u8/:i8/:u16[-be/-le]/…/:i64[-be/-le] → [width signed? little?]
(defn match-bytes-int-spec (kw)
  (cond
    (= kw :u8) [1 false false]
    (= kw :i8) [1 true false]
    (= kw :u16) [2 false false]
    (= kw :u16-be) [2 false false]
    (= kw :u16-le) [2 false true]
    (= kw :i16) [2 true false]
    (= kw :i16-be) [2 true false]
    (= kw :i16-le) [2 true true]
    (= kw :u32) [4 false false]
    (= kw :u32-be) [4 false false]
    (= kw :u32-le) [4 false true]
    (= kw :i32) [4 true false]
    (= kw :i32-be) [4 true false]
    (= kw :i32-le) [4 true true]
    (= kw :u64) [8 false false]
    (= kw :u64-be) [8 false false]
    (= kw :u64-le) [8 false true]
    (= kw :i64) [8 true false]
    (= kw :i64-be) [8 true false]
    (= kw :i64-le) [8 true true]
    else nil))

;; (sym :u16) — a typed integer segment: fixed width, endianness + signedness
;; from the spec keyword, value read via the bytes-uint/bytes-int family.
(defn match-bytes-typed-seg (seg more target off bound success fail)
  (let (s (first seg)
        spec (match-bytes-int-spec (second seg)))
    (if (nil? spec)
      (error (str "match: unknown bytes segment spec "
               (pr-str (second seg)) " (expected :u8/:i8/:u16[-be/-le]/…/:i64[-be/-le])"))
      (let (w (vector-ref spec 0)
            reader (cond
                     (and (vector-ref spec 1) (vector-ref spec 2)) 'bytes-int-le
                     (vector-ref spec 1) 'bytes-int
                     (vector-ref spec 2) 'bytes-uint-le
                     else 'bytes-uint)
            noff (gensym "off"))
        (cond
          ;; (_ :u32) — skip the segment's width
          (match-wildcard? s) `(if (<= (+ ~off ~w) (byte-length ~target))
                                 (let (~noff (+ ~off ~w))
                                   ~(match-bytes-segs more target noff bound success fail))
                                 ~fail)
          ;; non-linear: an already-bound binder requires an equal value
          (match-member? s bound) `(if (and (<= (+ ~off ~w) (byte-length ~target))
                                         (%eq (~reader ~target ~off ~w) ~s))
                                     (let (~noff (+ ~off ~w))
                                       ~(match-bytes-segs more target noff bound success fail))
                                     ~fail)
          else `(if (<= (+ ~off ~w) (byte-length ~target))
                  (let (~s (~reader ~target ~off ~w) ~noff (+ ~off ~w))
                    ~(match-bytes-segs more target noff (append bound (list s)) success fail))
                  ~fail))))))

(defn match-compile-bytes (segs target bound success fail)
  `(if (bytes? ~target)
     ~(match-bytes-segs segs target 0 bound success fail)
     ~fail))

(defn match-bytes-segs (segs target off bound success fail)
  (cond
    ;; exhausted: require the bytes were consumed exactly
    (empty? segs) `(if (%eq ~off (byte-length ~target)) ~success ~fail)
    ;; & rest — bind everything left (the tail must be exactly `& sym`)
    (= (first segs) '&) (if (= (count segs) 2)
                          `(let (~(second segs) (subbytes ~target ~off)) ~success)
                          (error "match: bytes pattern '&' must be followed by exactly one rest binding"))
    else (match-bytes-seg (first segs) (rest segs) target off bound success fail)))

(defn match-bytes-seg (seg more target off bound success fail)
  (let (noff (gensym "off"))
    (cond
      ;; (sym :u16) — a typed integer segment (spec keyword in size position)
      (and (pair? seg) (keyword? (second seg))) (match-bytes-typed-seg seg
                                                  more target off bound success fail)
      ;; (sym n) — bind n bytes as a sub-bytes value; n is an int or an earlier binding
      (pair? seg) (let (s (first seg) szv (gensym "sz"))
                    `(let (~szv ~(second seg))
                       (if (and (>= ~szv 0) (<= (+ ~off ~szv) (byte-length ~target)))
                         (let (~@(if (match-wildcard? s)
                                   []
                                   (list s `(subbytes ~target ~off (+ ~off ~szv)))) ~noff
                               (+ ~off ~szv))
                           ~(match-bytes-segs more
                              target noff (if (match-wildcard? s) bound (append bound (list s)))
                              success fail))
                         ~fail)))
      ;; _ — skip one byte
      (match-wildcard? seg) `(if (< ~off (byte-length ~target))
                               (let (~noff (+ ~off 1))
                                 ~(match-bytes-segs more target noff bound success fail))
                               ~fail)
      ;; symbol — bind one byte as an int (or, if already bound, require equality —
      ;; non-linear patterns, consistent with the vector/list matchers)
      (match-bind-sym? seg) (if (match-member? seg bound)
                              `(if (and (< ~off (byte-length ~target))
                                     (%eq (byte-at ~target ~off) ~seg))
                                 (let (~noff (+ ~off 1))
                                   ~(match-bytes-segs more target noff bound success fail))
                                 ~fail)
                              `(if (< ~off (byte-length ~target))
                                 (let (~seg (byte-at ~target ~off) ~noff (+ ~off 1))
                                   ~(match-bytes-segs more
                                      target noff (append bound (list seg)) success fail))
                                 ~fail))
      ;; #b"…" literal — match those exact bytes (count known at expand time)
      (bytes? seg) (let (n (byte-length seg))
                     `(if (and (<= (+ ~off ~n) (byte-length ~target))
                            (%eq (subbytes ~target ~off (+ ~off ~n)) ~seg))
                        (let (~noff (+ ~off ~n))
                          ~(match-bytes-segs more target noff bound success fail))
                        ~fail))
      ;; int literal — match one exact byte
      (int? seg) `(if (and (< ~off (byte-length ~target)) (%eq (byte-at ~target ~off) ~seg))
                    (let (~noff (+ ~off 1)) ~(match-bytes-segs more target noff bound success fail))
                    ~fail)
      else (error (str "match: invalid bytes-pattern segment " (pr-str seg))))))

;; list pattern: split off an optional `& rest` tail, then bind element-wise.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-split (pats)
    (cond
      (empty? pats) [nil nil false]
      (= (first pats) '&) (if (= (count (rest pats)) 1)
                            [nil (second pats) true]
                            (error "match: '&' must be followed by exactly one tail pattern"))
      else (let (sub (match-split (rest pats)))
             [(cons (first pats) (nth sub 0)) (nth sub 1) (nth sub 2)]))))

(defn match-compile-list (pat target bound success fail)
  (let (parts (match-split pat))
    (match-compile-seq (nth parts 0) (nth parts 1) (nth parts 2) target bound success fail)))

;; `(or p q …)`: chain the alternatives, each falling through to the next. `success`
;; is duplicated per alternative rather than hoisted into a thunk — that keeps every
;; alternative's body in TAIL position (a `match` in tail position must stay O(1)
;; stack), and alternatives are nearly always literals, so the duplication is small.
(defn match-compile-or (alts target bound success fail)
  (do
    (match-or-check alts)
    (match-compile-or--chain alts target bound success fail)))
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-compile-or--chain (alts target bound success fail)
    (if (empty? alts)
      fail
      (match-compile (first alts)
        target bound success (match-compile-or--chain (rest alts) target bound success fail)))))

;; `(and p q …)`: match every pattern against the SAME value, left to right, so
;; later patterns see the names earlier ones bound (a repeated name is an equality
;; constraint, as everywhere else). `(and whole {:keys [a]})` is the `:as` idiom.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-compile-and (pats target bound success fail)
    (if (empty? pats)
      success
      (match-compile (first pats)
        target bound
        (match-compile-and (rest pats)
          target (append bound (pattern-vars (first pats))) success fail)
        fail))))

;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-compile-seq (pats rest-pat has-rest target bound success fail)
    (if (empty? pats)
      (if has-rest
        (match-compile rest-pat target bound success fail)
        ; bind the rest to what remains
        `(if (nil? ~target) ~success ~fail))
      ; require the list exhausted
      (let (p (first pats)
            hd (gensym "hd")
            tl (gensym "tl")
            inner (match-compile-seq (rest pats)
                    rest-pat has-rest tl (append bound (pattern-vars p)) success fail)
            head (match-compile p hd bound inner fail))
        `(if (pair? ~target) (let (~hd (first ~target) ~tl (rest ~target)) ~head) ~fail)))))

;; vector pattern: a fixed-length tuple, matched element-wise by index.
(defn match-compile-vector (pat target bound success fail)
  (let (elems (match-vec->list pat) n (count elems))
    (when (match-member? '& elems)
      (error "match: '&' (rest) is not allowed in a vector pattern — vectors are fixed-length"))
    `(if (and (vector? ~target) (%eq (vector-length ~target) ~n))
       ~(match-compile-velems elems target 0 bound success fail)
       ~fail)))

;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-compile-velems (pats target i bound success fail)
    (if (empty? pats)
      success
      (let (p (first pats)
            el (gensym "el")
            inner (match-compile-velems (rest pats)
                    target (inc i) (append bound (pattern-vars p)) success fail)
            this (match-compile p el bound inner fail))
        `(let (~el (vector-ref ~target ~i)) ~this)))))

;; associative (map) pattern: {:keys [a b] :or {a default}} — a map literal in
;; pattern position destructures a map. Each symbol in :keys binds to the value at
;; the same-named keyword (nil if absent, or the :or default). The target must be a
;; map, else the clause fails. Mirrors Clojure's associative destructuring, minus
;; the power forms — general `{:key subpattern}` nesting and `:as` are deferred
;; (ADR-011: ship the simple shape, add the rest on a concrete need).
(defn match-map-pattern? (p) (map? p))

;; A map pattern understands exactly two keys: `:keys` and `:or`. Any other key
;; is REJECTED rather than ignored (ADR-152). Ignoring it was the worst kind of
;; wrong: `{:a v}` degenerated to "is the target a map?", so the clause matched
;; anything, bound nothing, and the body then died on an unbound `v` — a
;; diagnostic pointing at the body, nowhere near the cause. (`{}` stays legal: no
;; keys to misread, so it is the honest "any map" pattern.)
;; `:as` stays rejected. With general `{key subpattern}` support (ADR-160) a stray
;; `:as` would otherwise read as "this map must have an `:as` key", silently matching
;; something else entirely — and the `and`-pattern spells the intent exactly.
(defn match-map-check (pat)
  (when (contains? pat :as)
    (error (str "match: a map pattern has no `:as` — capture the whole value with an"
             " `and` pattern instead: (and " (pr-str (get pat :as))
             " {…}). (As a plain key, `:as` would test for an `:as` KEY in the" " map.)"))))

;; :keys value is a vector [a b] (or a list); return it as a list of symbols.
(defn match-map-keys (pat)
  (let (kv (get pat :keys))
    (cond (nil? kv) nil (vector? kv) (match-vec->list kv) else kv)))

;; The explicit `{key subpattern}` entries — every key except the two markers — as
;; a list of `[key subpattern]` pairs.
(defn match-map-entries (pat)
  (filter (fn (kv) (not (or (= (first kv) :keys) (= (first kv) :or))))
    (map-pairs pat)))

(defn match-map-vars (pat)
  (do
    (match-map-check pat)
    (append (match-map-keys pat)
      (fold (fn (acc kv) (append acc (pattern-vars (second kv))))
        nil (match-map-entries pat)))))

(defn match-compile-map (pat target bound success fail)
  (do
    (match-map-check pat)
    ;; Explicit `{key subpattern}` entries are tested FIRST (they can fail), then the
    ;; lenient `:keys` binds wrap the success branch. The two halves differ on
    ;; purpose, and the difference is the ecosystem each comes from:
    ;;   {:keys [a b]}  — Clojure DESTRUCTURING: an absent key binds nil (or its
    ;;                    `:or` default). Never fails.
    ;;   {:k pat}       — Erlang/Elixir MAP PATTERN: the key must be PRESENT and its
    ;;                    value must match `pat`, else the clause fails.
    `(if (map? ~target)
       ~(match-compile-map-entries (match-map-entries pat)
          target bound (match-map-binds (match-map-keys pat) (get pat :or) target success) fail)
       ~fail)))

;; Each explicit entry: require the key, bind its value to a temp, match the
;; sub-pattern against it. The key is emitted QUOTED — in pattern position a key is a
;; literal (`{[1 2] p}` looks up the vector `[1 2]`), never an expression to evaluate.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-compile-map-entries (entries target bound success fail)
    (if (empty? entries)
      success
      (let (kv (first entries)
            k (first kv)
            sub (second kv)
            v (gensym "mval"))
        `(if (contains? ~target (quote ~k))
           (let (~v (get ~target (quote ~k)))
             ~(match-compile sub
                v bound
                (match-compile-map-entries (rest entries)
                  target (append bound (pattern-vars sub)) success fail)
                fail))
           ~fail)))))

;; Bind each key symbol to (get target :key); when the key is absent, fall back to
;; its :or default (evaluated only then) if one is given, else nil.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-map-binds (keys ors target success)
    (if (empty? keys)
      success
      (let (k (first keys)
            kw (keyword (name k))
            getter (if (and ors (contains? ors k))
                     `(if (contains? ~target ~kw) (get ~target ~kw) ~(get ors k))
                     `(get ~target ~kw)))
        `(let (~k ~getter) ~(match-map-binds (rest keys) ors target success))))))

;; `(record name {map-pattern}?)` — assert the target is a `defrecord` value of nominal id
;; `name`, then match the optional map pattern against its fields. `record-id` returns the
;; value's `:__id__` (or nil for a non-record), so the whole test is a single `%eq` against
;; the id derived from `name` at expansion; a non-record simply fails. The inner map pattern
;; is compiled by the ordinary map path, so `{:k p}` / `:keys` / `:or` all work unchanged.
(defn match-compile-record (pat target bound success fail)
  (let (name (second pat)
        mappat (first (rest (rest pat))))
    (when (not (symbol? name))
      (error (str "match: (record name …) needs a record NAME symbol, got " (pr-str name)
               " — e.g. (record circle {:r r}) or (record geometry/circle {:r r}).")))
    (when (and mappat (not (map? mappat)))
      (error (str "match: (record " (pr-str name) " …) — the field pattern must be a map"
               " pattern like {:field p} or {:keys [f]}, got " (pr-str mappat))))
    (let (id (ability--id-kw name))
      `(if (%eq (record-id ~target) ~id)
         ~(if mappat (match-compile mappat target bound success fail) success)
         ~fail))))

;; -- clauses: (pattern [:when guard] body...) — one shape for match / fn / receive --
(defn match-parse-clause (clause)
  (if (not (pair? clause))
    (error (str "match: each clause must be a (pattern body...) list, got " (pr-str clause)))
    (let (pat (first clause) more (rest clause))
      (if (= (first more) :when)
        (if (empty? (rest more))
          (error "match: :when must be followed by a guard expression")
          [pat (second more) (rest (rest more))])
        [pat nil more]))))

;; A clause is irrefutable (always matches) iff its pattern is _ or a bare bind
;; and it has no guard. Such a clause must be last; anything after it is dead.
(defn match-irrefutable? (pat guard)
  (and (nil? guard) (or (match-wildcard? pat) (match-bind-sym? pat))))

(defn match-compile-clause (clause target fail)
  (let (parsed (match-parse-clause clause)
        pat (nth parsed 0)
        guard (nth parsed 1)
        body (nth parsed 2)
        success (if (nil? guard) `(do ~@body) `(if ~guard (do ~@body) ~fail)))
    (match-compile pat target nil success fail)))

;; The no-match failure: a structured, catchable, self-describing value carrying
;; the context (:match / :let / a fn name), the value, and the patterns tried.
(defn match-no-match (context target patterns)
  `(throw [:match-error (quote ~context) ~target (quote ~patterns)]))

(defn match-clause-patterns (clauses) (map (fn (c) (if (pair? c) (first c) c)) clauses))

(defn match-check-reachable (clause following)
  (let (parsed (match-parse-clause clause))
    (when (and (match-irrefutable? (nth parsed 0) (nth parsed 1)) (not (empty? following)))
      (error "match: unreachable clause after a catch-all (an irrefutable pattern must come last)"))))

;; Occurrences of symbol `s` in code tree `form` (pairs only — `s` is a gensym,
;; so quoted user data can never contain it and vectors need no descent).
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-count-sym (form s)
    (cond
      (= form s) 1
      (pair? form) (+ (match-count-sym (first form) s) (match-count-sym (rest form) s))
      else 0)))

;; Replace each `(k)` call in code tree `form` with `code` (used only when the
;; duplication is bounded — one use, or a small `code`).
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-splice-fail (form k code)
    (cond
      (and (pair? form) (= (first form) k) (nil? (rest form))) code
      (pair? form) (cons (match-splice-fail (first form) k code)
                     (match-splice-fail (rest form) k code))
      else form)))

;; Remaining budget after counting `form`'s pair nodes, or -1 once exhausted —
;; an early-exit size probe (big trees aren't walked past the budget).
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-size-budget (form budget)
    (cond
      (< budget 0) -1
      (pair? form) (match-size-budget (rest form) (match-size-budget (first form) (- budget 1)))
      else budget)))

(defn match-small? (form) (>= (match-size-budget form 64) 0))

;; Compile one clause with `rest-code` (the code for every following clause) as
;; its fail-continuation — WITHOUT exponential growth. The pattern compilers
;; splice `fail` at every failure point, so handing them `rest-code` verbatim
;; duplicates it once per test and the whole match doubles per clause (a 16-arm
;; receive took seconds to load). Instead compile against a thunk call `(k)`,
;; then: 0 uses → drop rest-code (irrefutable pattern, later clauses dead);
;; 1 use → splice rest-code in place (zero runtime cost, growth stays linear);
;; 2+ uses of a SMALL rest-code → still splice (bounded duplication — the hot
;; 2–4-arm receive/fn dispatch stays thunk-free, zero runtime cost); 2+ uses of
;; a big one → bind it once as `(let (k (fn () rest-code)) …)`. The `(k)` call
;; is in tail position wherever fail was, so match stays TCO-safe.
(defn match-build-clause (clause target rest-code)
  (let (k (gensym "mfail")
        compiled (match-compile-clause clause target (list k))
        uses (match-count-sym compiled k))
    (cond
      (= uses 0) compiled
      (or (= uses 1) (match-small? rest-code)) (match-splice-fail compiled k rest-code)
      else `(let (~k (fn () ~rest-code)) ~compiled))))

;; Chain the clauses: each clause's fail-continuation is the code for the rest;
;; the innermost fail is the structured no-match throw. Each chosen body lands in
;; tail position of the generated if/let, so a `match` in tail position is TCO-safe.
;; check-allow: deliberately non-tail — expansion-time recursion over pattern syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn match-build-from (clauses target fail)
    (if (empty? clauses)
      fail
      (let (clause (first clauses)
            following (rest clauses)
            rest-code (match-build-from following target fail))
        (match-check-reachable clause following)
        (match-build-clause clause target rest-code)))))

(defn match-build (clauses target context)
  (match-build-from clauses target (match-no-match context target (match-clause-patterns clauses))))

;; match* — the shared engine. `context` (a keyword like :match/:let, or a fn
;; name) is embedded in the failure. `match` is the value-dispatch surface; the
;; `let` and `fn` special forms target match* directly with their own context.
(defmacro match* (context expr & clauses)
  (let (v (gensym "m")) `(let (~v ~expr) ~(match-build clauses v context))))

;; (match expr (pattern [:when guard] body...) ...) — match `expr` against each
;; clause in order; the first whose pattern (and guard) matches runs its body.
;; No clause matching crashes with a structured value; add a `_` clause to total it.
(defmacro match (expr & clauses)
  "Match `expr` against each `(pattern [:when guard] body...)` clause, running the first that fits (binding the pattern's variables). Errors if none match."
  `(match* :match ~expr ~@clauses))

;; ---- case: literal dispatch, flat pairs -------------------------------------
;; Sugar over `match*`, but NOT a synonym for it (which is why it earns a name
;; under "one spelling each"): `case` accepts only *literal* tests, so it cannot
;; silently bind where you meant to compare — the one trap `match` has. A bare
;; symbol test is therefore rejected rather than read as a binder.
(defn case--check-test (t)
  (cond
    (or (keyword? t) (int? t) (float? t) (decimal? t) (ratio? t) (string? t) (bool? t) (nil? t)) t
    (and (pair? t) (= (first t) 'quote)) t
    (symbol? t) (throw (str "case: the bare symbol test `"
                         t "` would BIND, not compare" " — write `'" t
                         "` for the literal symbol, or use `match`" " if you meant to bind it"))
    else (throw (str "case: each test must be a literal (keyword/int/float/decimal/"
                  "string/bool/nil, or 'symbol), got " (pr-str t)
                  " — use `match` for destructuring, guards, or alternatives"))))

;; Flat `test result …` pairs → wrapped match clauses; a lone trailing form is the
;; default (an `_` clause). Flat pairs match `cond`'s shape, which is where a
;; reader's eye already is for value dispatch.
(defn case--clauses (forms acc)
  (cond
    (empty? forms) (reverse acc)
    (empty? (rest forms)) (reverse (cons (list '_ (first forms)) acc))
    else (case--clauses (rest (rest forms))
           (cons (list (case--check-test (first forms)) (second forms)) acc))))

(defmacro case (expr & clauses)
  "Dispatch on the VALUE of `expr` against literal tests, as flat `test result`
pairs; a lone trailing form is the default. `(case k :a 1 :b 2 :other)`. Tests
are literals only — a bare symbol is an error (it would bind, not compare), and
destructuring, guards, or alternatives mean you want `match`. With no default, no
match raises `[:match-error :case value patterns]`, exactly as `match` does."
  `(match* :case ~expr ~@(case--clauses clauses nil)))

;; ---- spawn: run an expression as a new green process ------------------------
;; (spawn expr) runs `expr` in a fresh process and returns its pid. The expression
;; is wrapped in a 0-arg thunk, so its free *locals* are captured lexically (the
;; closure carries them) and its free *globals* resolve in the child — which is why
;; the thunk is shippable to another node (a closure serialises as data; see
;; docs/decisions.md). Note `(self)` inside `expr` is the *child's* pid: to hand the
;; parent's pid in, capture it first — `(let (me (self)) (spawn (work me)))`.
;; `spawn` has two shapes:
;;   (spawn expr)          → anonymous; always creates a fresh process.
;;   (spawn name expr)     → **named & idempotent**. If a process is already
;;                            registered under `name` (a keyword/symbol) and
;;                            is still alive, the call is a no-op and returns
;;                            the existing pid; `expr` is never evaluated.
;;                            Otherwise spawns fresh and registers the new
;;                            pid under `name`.
;;
;; The named form is the replacement for the old `(defonce *worker* (spawn
;; (worker)))` hot-reload pattern (ADR-039). A file containing
;; `(spawn :worker (worker))` reloaded by a hot-reload supervisor sees the
;; name is alive and does nothing — the running worker keeps going with its
;; current state, picking up the new code via the next global lookup of
;; `worker`. When the process dies, its registered name is reaped automatically
;; (`process::deregister` calls `dist::unregister_dead_pid`), so a fresh
;; reload spawns again — no stale entries.
;; spawn — two shapes via arity dispatch:
;;   (spawn expr)         → (%spawn (fn () expr))             — anonymous
;;   (spawn name expr)    → (%spawn-named name (fn () expr))  — idempotent on name
;; The named form replaces the `defonce *worker* (spawn …)` hot-reload
;; pattern (ADR-039). The reloaded file sees the name is alive and the
;; second `(spawn :worker …)` is a no-op — the running worker keeps going,
;; picking up the new code via the next global lookup. When the process
;; dies, its registered name is reaped (`process::deregister` →
;; `dist::unregister_dead_pid`), so a later reload re-spawns cleanly.
;; A literal zero-arg lambda `(fn () …)` is *already* a process thunk. Re-wrapping
;; it (`(fn () (fn () …))`) would make the process merely build a closure and
;; discard it — a silent no-op. So pass such a form through unwrapped:
;; `(spawn (fn () body))` and `(spawn body)` then mean the same. (The dual footgun —
;; a bare function *name* like `(spawn worker)`, which used to yield the closure and
;; exit — is handled by `spawn--body-thunk` below, which wraps a symbol as a *call*.)
(defn spawn--thunk-form? (form)
  (and (list? form)
    (not (empty? form)) (= (first form) 'fn)
    (let (params (second form)) (and (list? params) (empty? params)))))

;; The process-body thunk a `spawn`-family macro wraps its body form in. Three cases,
;; each closing off a footgun so no `spawn` shape can silently do nothing:
;;   - a literal `(fn () …)` is already the thunk → pass it through (re-wrapping it
;;     would build-and-discard a closure);
;;   - a **bare symbol** is a function *name* → wrap it as a CALL `(fn () (name))`,
;;     so `(spawn worker)` runs `worker` (Erlang's `spawn(fun name/0)`) instead of
;;     yielding the closure and exiting. A process body that merely *evaluates* a
;;     symbol has no effect, so this is never a legitimate use — the call either
;;     works or raises a loud "not callable", never a silent no-op;
;;   - anything else is the body expression → `(fn () expr)`.
(defn spawn--body-thunk (form)
  (cond
    (spawn--thunk-form? form) form
    (symbol? form) `(fn () (~form))
    else `(fn () ~form)))

(defmacro spawn (head & more)
  "Run an expression in a new green process; returns its pid. Shapes:
  - `(spawn expr)` — anonymous; `expr` is the process body.
  - `(spawn (fn () expr))` — same as above (a zero-arg lambda is the body too, so
    the Erlang `spawn(fun() -> … end)` habit just works, no silent no-op).
  - `(spawn fn-name)` — a bare function name is **called**: `(spawn worker)` runs
    `(worker)` (Erlang's `spawn(fun name/0)`), not `worker`-then-exit.
  - `(spawn name expr)` — named & idempotent: returns the existing pid if
    a live process is already registered under `name`. The hot-reload-friendly
    form (reloading the file doesn't fire a second worker).

  Erlang **let-it-crash** (`spawn/1`): an uncaught throw kills the process and
  any monitors see `[:down pid [:error {:kind :message … :trace}]]` immediately
  (the reason carries the structured error map, call trace included)."
  ;; Param name is `more` (not `rest`) so the body can still call the
  ;; prelude's `rest` function without param-shadowing itself.
  (if (empty? more)
    `(%spawn ~(spawn--body-thunk head))
    (if (empty? (rest more))
      `(%spawn-named ~head ~(spawn--body-thunk (first more)))
      (throw "spawn: expected (spawn expr) or (spawn name expr)"))))

(defmacro spawn-link (expr)
  "Spawn a new green process running `expr` and `link` it to the caller **atomically**
(Erlang `spawn_link`, ADR-067) — returns its pid. The link is symmetric: if either
process dies abnormally the other is taken down too (or receives a trappable `[:EXIT …]`
if it `(trap-exit true)`'d). The link is established *before* the child runs, so even an
instant exit reaches the caller with its **true** reason — unlike a separate
`(let (p (spawn expr)) (link p) p)`, where a child that exits in the gap is linked dead
and reports `:noproc` (losing `:normal`). Supervised children should use this so a fast
`:normal` exit isn't misread as a crash. A zero-arg lambda `(fn () …)` body is
passed through (not re-wrapped), like `spawn`."
  `(%spawn-link ~(spawn--body-thunk expr)))

;; A long-lived `:remote-spawn` server: the receiver-side machinery behind the
;; `remote-spawn` macro. Receives `[:run thunk]` messages and applies the thunk
;; in a fresh local process — that's "the receiver runs my code". A permanent
;; loop so it stays a stable address; the closure crosses the wire as data
;; (ADR-033), so any peer node running the same prelude can run it.
(defn remote--spawn-server ()
  (receive
    ([:run thunk] (do (spawn (thunk)) (remote--spawn-server)))
    ;; Synchronous variant: spawn the thunk and reply with the child's pid (a
    ;; remote pid, carrying this node's `name@host`) to the requester, keyed by
    ;; the ref it supplied so its `receive` can pin the reply.
    ([:run-sync thunk from r] (do (send from [:spawned r (spawn (thunk))]) (remote--spawn-server)))
    (_ (remote--spawn-server))))

(defn start-remote-spawn ()
  "Idempotently start + register the local `:remote-spawn` server so peers can `(remote-spawn this-node …)` against this node. Safe to call multiple times — only the first call spawns a server. Typically called once at startup, after `(node-start …)`."
  (when (nil? (whereis :remote-spawn))
    (register :remote-spawn (spawn (remote--spawn-server))))
  nil)

(defmacro remote-spawn (node expr)
  "Run `expr` in a fresh process on `node` (a node-name keyword/symbol — `(node-name)` for the local node, or a connected peer's). Returns `nil`; the spawned process lives on the remote and runs detached (capture the parent's pid in a `let` and `(send parent (self))` from inside `expr` if you need its pid). `expr` ships as a closure (ADR-033) — free locals ride along, free globals re-resolve on the receiver. A zero-arg lambda `(fn () …)` body is passed through (not re-wrapped), like `spawn`. The **receiver** must have called `(start-remote-spawn)` (typically right after `node-start`); the macro itself does no setup on either side."
  `(do
     (send {:name :remote-spawn :node ~node}
       [:run ~(spawn--body-thunk expr)])
     nil))

(defmacro remote-spawn-sync (node expr)
  "Like `remote-spawn`, but **synchronous**: run `expr` in a fresh process on
`node` and return the child's pid (a remote pid carrying `node`'s `name@host`).
Blocks until the receiver replies (5s timeout → throws). The receiver must have
called `(start-remote-spawn)`. A zero-arg lambda `(fn () …)` body is passed
through (not re-wrapped), like `spawn`. Use this when you need the child's pid —
e.g. to `monitor`/`link` a remote child — rather than fire-and-forget."
  `(let (r# (ref))
     (send {:name :remote-spawn :node ~node}
       [:run-sync ~(spawn--body-thunk expr) (self) r#])
     (receive
       ([:spawned got# child#] :when (= got# r#) child#)
       (after 5000
         (throw "remote-spawn-sync: no reply (is start-remote-spawn running on the peer?)")))))

;; ---- node identity: name-addressing + the shared cookie (ADR-068) ----------
;; A node is addressed by NAME on the local machine (a Unix-domain socket — no
;; port to pick) and by "name@host:port" across machines (TCP). The shared secret
;; lives in ~/.config/brood/cookie, auto-generated on first use. All of this is
;; policy in Brood over the %node-listen / %node-connect / random-token /
;; spit-private primitives — the kernel only carries bytes.

(defn node--config-dir ()
  (str (or (getenv "XDG_CONFIG_HOME") (str (getenv "HOME") "/.config")) "/brood"))

(defn node--cookie-path () (str (node--config-dir) "/cookie"))

;; Strip trailing newlines so a hand-edited cookie file (or one written by a
;; tool that appends "\n") still matches the bytes we minted.
(defn node--chomp (s)
  (let (n (string-length s))
    (if (and (> n 0) (= (substring s (dec n) n) "\n"))
      (node--chomp (substring s 0 (dec n)))
      s)))

(defn node-cookie ()
  "The shared secret authenticating node links, resolved as: `$BROOD_COOKIE` →
`~/.config/brood/cookie` → freshly generated and persisted (0600). All your nodes
on this machine share one cookie, Erlang-style; set `$BROOD_COOKIE` to override."
  (or (getenv "BROOD_COOKIE")
    (let (path (node--cookie-path))
      (if (file-exists? path)
        (node--chomp (slurp path))
        (let (secret (random-token 32))
          (spit-private path secret)
          secret)))))

;; The per-user dir holding local node sockets. $XDG_RUNTIME_DIR is the right
;; home (tmpfs, cleared on logout); fall back to /tmp/brood-<user> when a bare /
;; cron / ssh session leaves it unset.
(defn node--runtime-dir ()
  (str (or (getenv "XDG_RUNTIME_DIR")
         (str "/tmp/brood-" (or (getenv "USER") (getenv "LOGNAME") "shared")))
    "/brood"))

(defn node--socket-path (s) (str (node--runtime-dir) "/" s ".sock"))

;; Index of the first "@" in s, or -1. No string-split primitive — and a node
;; spec only ever has the one separator — so a small char scan is plenty.
(defn node--at (s i n)
  (cond
    (>= i n) -1
    (= (substring s i (inc i)) "@") i
    else (node--at s (inc i) n)))

;; Last index of `:` in s (or -1) — needed to split "name@host:port" into the
;; node name "name@host" and the port, IPv6-host-safe (the port colon is last).
(defn node--last-colon (s i n last)
  (cond
    (>= i n) last
    (= (substring s i (inc i)) ":") (node--last-colon s (inc i) n i)
    else (node--last-colon s (inc i) n last)))

;; The bare name-part of a node name (before any `@`). Used for the local Unix
;; socket filename — the socket is same-machine, so the host qualifier is
;; identity only, not part of the path.
(defn node--name-part (s)
  (let (at (node--at s 0 (string-length s)))
    (if (>= at 0) (substring s 0 at) s)))

;; The host part of a "host:port" address (everything before the last colon),
;; IPv6-safe. So a TCP node's name host == the host peers dial, keeping
;; `connect`/`net/reconnect` name-derivation consistent with the node's identity.
(defn node--addr-host (addr)
  (let (lc (node--last-colon addr 0 (string-length addr) -1))
    (if (>= lc 0) (substring addr 0 lc) addr)))

;; Qualify a node name to `name@host` (ADR-073), Erlang-style:
;;   - already `name@host` → verbatim (an explicit long/FQDN name);
;;   - TCP node (addr given) → `name@<addr-host>`, so it matches how peers reach it;
;;   - local Unix node → `name@<short hostname>`.
;; The result is the node's global identity, carried in every pid.
(defn node--qualify (nm addr)
  (let (s (name nm))
    (cond
      (>= (node--at s 0 (string-length s)) 0) (keyword s)
      (nil? addr) (keyword (str s "@" (hostname)))
      else (keyword (str s "@" (node--addr-host addr))))))

(defn node-start (nm &optional addr cookie)
  "Start this runtime as a node so peers can reach it. The node's identity is
`name@host` (ADR-073): a bare `name` becomes `name@host` where `host` is the
listen address's host for a TCP node, or this machine's short `(hostname)` for a
local node; pass an already-qualified `:name@host` to override (a long/FQDN name).
`(node-start name)` listens on a local Unix-domain socket (no port) — the common
same-machine case; `(node-start name \"host:port\")` listens over TCP for remote
peers. The cookie defaults to `(node-cookie)`. Returns the qualified node name.
Errors if this runtime is already a node."
  (%node-listen (node--qualify nm addr)
    (if (nil? addr)
      (str "unix:" (node--socket-path (node--name-part (name nm))))
      (str "tcp:" addr))
    (or cookie (node-cookie))))

(defn connect (spec)
  "Link to a peer node. `(connect \"name\")` dials a local node by name over its
Unix socket; `(connect \"name@host:port\")` dials a remote node over TCP. Cookie-
authenticated with this runtime's `(node-cookie)`. Returns the peer's authoritative
`name@host` node name (from the handshake) — address the peer with that value
(`{:name … :node <that>}`), not a bare literal. This runtime must already be a
node — call `(node-start …)` first."
  (when (= (node-name) :nonode)
    (error "connect: this runtime is not a node yet — call (node-start name) first"))
  (let (n (string-length spec)
        at (node--at spec 0 n))
    (if (< at 0)
      ;; Bare name → local Unix node. The peer's real name is `name@thishost`;
      ;; pass that as the claimed name (the handshake confirms it).
      (%node-connect (keyword (str spec "@" (hostname)))
        (str "unix:" (node--socket-path spec)))
      ;; Qualified → remote TCP: "name@host:port". The node name is everything
      ;; before the (last) port colon; the dial address is everything after `@`.
      (let (lc (node--last-colon spec 0 n -1))
        (when (<= lc at)
          (error "connect: a remote node needs \"name@host:port\" (a bare name is local), got "
            spec))
        (%node-connect (keyword (substring spec 0 lc))
          (str "tcp:" (substring spec (inc at) n)))))))

(defn node-also-listen (&optional addr)
  "Add another listener to this (already-started) node so it serves several
transports at once — **dual-listen** (ADR-074). `(node-also-listen)` opens the
local Unix socket (reachable by name); `(node-also-listen \"host:port\")` opens a
TCP endpoint (reachable remotely). Both share the node's identity + cookie. The
shape behind a local+remote editor daemon — e.g. `(node-start :ed@host
\"0.0.0.0:9001\")` then `(node-also-listen)` is reachable as `(connect \"ed\")`
locally and `(connect \"ed@host:9001\")` from another machine. Errors if this
runtime isn't a node yet."
  (when (= (node-name) :nonode)
    (error "node-also-listen: this runtime is not a node yet — call (node-start name) first"))
  (%node-also-listen (if (nil? addr)
                       (str "unix:" (node--socket-path (node--name-part (name (node-name)))))
                       (str "tcp:" addr))))

;; ---- sleep: park on the scheduler timer (policy in Brood) ---------------
;; Sleep `ms` milliseconds in the current process. A bare `(receive (after ms …))`
;; would *consume* the next queued message — an empty clause list matches anything,
;; so `%receive` grabs whatever is in the mailbox and returns immediately instead of
;; waiting. We pin a fresh, unforgeable `(ref)` as the only real clause (`~never`):
;; no message can ever match it, so selective receive leaves every real message
;; queued and the timeout always fires. Parks the green process on the scheduler's
;; timer (it does NOT block a worker thread) — which is why sleep is pure Brood
;; rather than a Rust primitive.
(defn sleep (ms)
  "Park the current process for `ms` milliseconds without touching its mailbox — every queued message stays queued. Parks on the scheduler timer; it does not block a worker thread."
  (let (never (ref)) (receive (^never nil) (after ms nil))))

;; ---- timers: send-after / send-interval / cancel-timer (Erlang parity) -----
;; Pure Brood policy: a timer is a tiny green process parked on the scheduler's
;; timer wheel (the same mechanism `sleep` rides), so a pending timer costs no
;; worker thread. The handle is the timer's pid — inspectable with
;; `process-info`, cancellable with `cancel-timer` (a hard exit, so it stops
;; even mid-fire).

(defn send-after (ms pid msg)
  "Send `msg` to `pid` after `ms` milliseconds (Erlang `send_after/3` — same
argument order). Returns a timer handle; `(cancel-timer h)` stops it if it
hasn't fired. One-shot; fires even if `pid` is already dead (the send is then
a silent no-op, like any send to a dead process)."
  (spawn (do (sleep ms) (send pid msg))))

(defn send-interval (ms pid msg)
  "Send `msg` to `pid` every `ms` milliseconds (Erlang `timer:send_interval/3`)
until cancelled. Returns a timer handle for `(cancel-timer h)`. Self-cleaning:
the timer monitors `pid` and exits when it dies, so a forgotten interval can't
tick against a dead process forever."
  (spawn
    (let (target pid interval ms payload msg)
      (monitor target)
      (letrec (tick (fn ()
                      (receive
                        ; target died — stop ticking
                        ([:down _ ^target _] nil)
                        (after interval (do (send target payload) (tick))))))
        (tick)))))

(defn cancel-timer (timer)
  "Cancel a `send-after`/`send-interval` timer by its handle. Idempotent (a
fired or already-cancelled timer is a dead process; the exit is a no-op).
Returns nil. Note: like Erlang, cancellation races an in-flight fire — a
message already sent stays sent."
  (exit timer :kill)
  nil)

;; Node-link auto-reconnect moved to `std/net/reconnect` (2026-07-18):
;; `(require 'net/reconnect)` then `(net/reconnect/watch "name@host:port")` —
;; exponential backoff, [:nodeup]/[:nodedown] subscriber events, idempotent
;; named watchers. It supersedes the old prelude `ensure-link`.

;; ---- receive: selective, pattern-matched message receipt --------------------
;; (receive clause...) where each clause is (pattern [:when guard] body...), with an
;; optional trailing (after ms body...) timeout clause. Reuses the match compiler
;; (match-build-from) to build a *matcher* fn: given a message it returns the clause
;; body as a thunk on a match, or nil on no match. The %receive primitive runs that
;; over the mailbox — scanning in order, removing+running the first match, leaving
;; non-matching messages queued (true Erlang selective receive).
;;
;;   (receive
;;     ([:say text]      (println text))
;;     (n :when (int? n) (handle n))
;;     (after 5000       (throw [:timeout])))   ; catchable via try/catch
;;
;; (receive) with no clauses blocks for the next message and returns it.
;; (after 0 ...) is a non-blocking poll; (after ms>0 ...) waits up to ms.

;; The bodies do NOT live in the matcher. The matcher's job is only to pick a clause
;; and hand back what that clause's pattern bound; the body itself is emitted at the
;; *call site* (see `receive` below). Two reasons, both measured:
;;
;;   * A `(fn () body…)` thunk cost a closure + captured-env allocation and a second
;;     closure activation on every received message (~235 ns/message against ~50 ns
;;     for the small-vector protocol used instead).
;;   * `Inst::MakeClosure` is not in the JIT subset, so building that thunk made the
;;     WHOLE matcher arm ineligible for the JIT — the hot message path ran with no
;;     native code at all. A vector literal (`Inst::MakeVector`) is in the subset.
;;
;; Emitting the body at the call site also puts it in the owning arm's bytecode, so a
;; receive loop's `(recur …)`/self-call is an ordinary tail call in that arm rather
;; than a call through a thunk — Erlang's "receive clauses compile into the enclosing
;; function", reached from the Brood side.

;; The variables a clause's pattern binds, de-duplicated: a non-linear pattern (`[a a]`)
;; lists `a` twice, but binds it once (the repeat compiles to an equality check).
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn receive--dedupe (vars seen)
    (cond
      (empty? vars) nil
      (match-member? (first vars) seen) (receive--dedupe (rest vars) seen)
      else (cons (first vars) (receive--dedupe (rest vars) (cons (first vars) seen))))))
(defn receive--clause-vars (pat) (receive--dedupe (pattern-vars pat) nil))

;; Pair each clause with the variables its pattern binds and its index, ONCE. Both
;; halves below (the matcher's result vector and the call site's rebinding) need that
;; same list in that same order, and `pattern-vars` walks the whole pattern — so
;; deriving them from a shared prep keeps expansion to one walk per clause instead of
;; two. Shape: `[clause vars idx]`.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn receive--prep (clauses idx)
    (if (empty? clauses)
      nil
      (cons [(first clauses) (receive--clause-vars (first (first clauses))) idx]
        (receive--prep (rest clauses) (+ idx 1))))))

;; Replace a clause's body with `[idx var…]` — the clause's index plus the values its
;; pattern bound. Keeps the :when guard in place, so the match compiler still gates on
;; it and the guard still runs exactly once, during the scan.
(defn receive--result-clause (prep)
  (let (clause (nth prep 0)
        vars (nth prep 1)
        idx (nth prep 2)
        pat (first clause)
        more (rest clause))
    (if (= (first more) :when)
      `(~pat :when ~(second more) [~idx ~@vars])
      `(~pat [~idx ~@vars]))))

;; `(v0 (nth r 1) v1 (nth r 2) …)` — the flat `let` binding list that unpacks the
;; matcher's result vector back into the clause's pattern variables.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn receive--binds (vars r i)
    (if (empty? vars)
      nil
      (cons (first vars)
        (cons `(nth ~r ~i) (receive--binds (rest vars) r (+ i 1)))))))

;; One clause's call-site code: rebind its pattern variables from the result vector,
;; then run its body.
(defn receive--body-code (prep r)
  (let (clause (nth prep 0)
        more (rest clause)
        body (if (= (first more) :when) (rest (rest more)) more)
        binds (receive--binds (nth prep 1) r 1))
    (if (empty? binds) `(do ~@body) `(let ~binds ~@body))))

;; The call-site dispatch: `(if (= (nth r 0) 0) body0 (if (= (nth r 0) 1) body1 …))`.
;; The last clause is reached by elimination (%receive only ever returns a result a
;; clause matched), so it needs no test — and a single-clause receive, the common
;; shape, collapses to its body with no dispatch at all. Every body sits in tail
;; position, so a receive loop stays O(1) stack.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn receive--dispatch (preps r)
    (if (empty? (rest preps))
      (receive--body-code (first preps) r)
      `(if (= (nth ~r 0) ~(nth (first preps) 2))
         ~(receive--body-code (first preps) r)
         ~(receive--dispatch (rest preps) r)))))

;; Walk the clause list and error if an `(after ...)` clause appears before the last
;; position — a non-last `after` would silently become a pattern clause matching the
;; symbol `after`, which is almost certainly a mistake.
(defn receive--check-after (clauses)
  (if (or (empty? clauses) (empty? (rest clauses)))
    nil
    (if (and (pair? (first clauses)) (%eq (first (first clauses)) 'after))
      (error "receive: (after ...) must be the last clause, but it appears before "
        (count (rest clauses)) " more clause(s)")
      (receive--check-after (rest clauses)))))

;; Split clauses into [real-clauses ms-or-nil timeout-body-or-nil], peeling an
;; optional trailing (after ms body...). `after` as a final clause head is reserved.
(defn receive--split (clauses)
  (let (lst (last clauses))
    (if (and (pair? lst) (= (first lst) 'after))
      [(but-last clauses) (second lst) `(do ~@(rest (rest lst)))]
      ;; no `after`: ms nil (wait forever), so `%receive` can never return its
      ;; timeout answer and the timeout branch is provably dead — the macro omits it.
      [clauses nil nil])))

;; The set of leading keyword tags a `receive`'s clauses can match, or nil when the
;; filter cannot be used. Passed to `%receive` as a THIRD argument so the mailbox scan
;; can reject a non-matching message by peeking its tag, without first rebuilding it
;; into the heap (`from_message`) and running the matcher — the cost that makes a
;; selective receive against a backlog O(rounds x backlog). Measured 2026-07-29 at
;; ~0.4us per rescanned message.
;;
;; Conservative by construction: it answers nil (no filtering, scan everything) unless
;; EVERY clause is a vector pattern whose head is a literal keyword. A catch-all
;; pattern, a bare symbol, a map/list pattern or a non-keyword head all disable it, so
;; the filter can never skip a message some clause would have matched. Guards are
;; irrelevant to it — a `:when` can only reject a message the tag already admitted.
;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn receive--tags (clauses)
    (if (empty? clauses)
      nil
      (let (pat (first (first clauses))
            tag (if (and (vector? pat) (> (count pat) 0) (keyword? (first pat)))
                  (first pat)
                  nil))
        (if (nil? tag)
          nil                              ; one un-taggable clause disables the filter
          (let (rest-tags (receive--tags (rest clauses)))
            (if (and (nil? rest-tags) (not (empty? (rest clauses))))
              nil                          ; a later clause disabled it
              (cons tag rest-tags))))))))

;; The receive-mark hint (ADR-195): the expression EVERY clause pins, when they all pin the
;; same one — `([:reply ^r v] …)` yields `r`. Any clause that pins nothing, or pins something
;; different, disables it (nil), exactly like `receive--tags`. The kernel only acts on it when
;; the value turns out to be a `ref` this process minted, so a false positive here costs
;; nothing but a wasted comparison.
(defn receive--pinned-in (pat)
  "The single pinned expression inside `pat`, or nil if it pins none or several."
  (cond
    (match-pin? pat) (second pat)
    (vector? pat) (fold (fn (acc p)
                          (let (inner (receive--pinned-in p))
                            (cond
                              (nil? inner) acc
                              (nil? acc) inner
                              (= acc inner) acc
                              else :none)))
                    nil (seq pat))
    else nil))

;; check-allow: deliberately non-tail — expansion-time recursion over receive-clause syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn receive--pin (clauses)
    "The **symbol** pinned by every clause, or nil when they do not agree.

  Restricted to a symbol deliberately. The hint is emitted as a form that the call site
  evaluates *in addition to* the matcher's own evaluation of the same pin, so anything with a
  side effect (or a value that could differ between the two evaluations) would be run twice.
  A pinned symbol — `^r`, which is the whole idiom this exists for — reads a binding and cannot
  differ. Any other pinned expression declines the hint and scans from the front."
    (if (empty? clauses)
      nil
      (let (first-pin (receive--pinned-in (first (first clauses))))
        (if (or (nil? first-pin) (= first-pin :none) (not (symbol? first-pin)))
          nil
          (if (empty? (rest clauses))
            first-pin
            (let (rest-pin (receive--pin (rest clauses)))
              (if (= rest-pin first-pin) first-pin nil))))))))

(defmacro receive (& clauses)
  "Selectively receive a message from the mailbox: run the first `(pattern [:when guard] body...)` clause that matches, leaving others queued. An optional final `(after ms body...)` clause fires on timeout; `(receive)` blocks for the next message."
  (do
    (receive--check-after clauses)
    (let (parts (receive--split clauses)
          real (nth parts 0)
          ms (nth parts 1)
          on-time (nth parts 2)
          msg (gensym "msg")
          r (gensym "rcv")
          ;; Walk each pattern once; both halves below read the same prep.
          preps (receive--prep real 0)
          ;; The matcher answers "which clause, and what did it bind?" as `[idx var…]`,
          ;; or nil for no match. No clauses: take the next message as-is.
          matcher (if (empty? real)
                    `(fn (~msg) [0 ~msg])
                    `(fn (~msg)
                       ~(match-build-from (map receive--result-clause preps) msg nil)))
          dispatch (if (empty? real) `(nth ~r 1) (receive--dispatch preps r))
          ;; nil when the filter can't apply (see `receive--tags`). Built as a vector
          ;; FORM (`[~@tags]`), not by calling a function: a plain list would expand to
          ;; `(:tag …)`, which evaluates as a keyword accessor call (ADR-165) rather
          ;; than data — and calling `vec` here would run at macro-expansion time
          ;; *during the prelude build*, where its own dependency (`into`, defined
          ;; ~2000 lines later) does not exist yet.
          tag-list (if (empty? real) nil (receive--tags real))
          tags (if (nil? tag-list) nil `[~@tag-list])
          ;; The receive-mark hint — see `receive--pin`. Emitted as the pinned FORM, so it
          ;; evaluates at the call site to the same value the pattern compares against.
          pin (if (empty? real) nil (receive--pin real)))
      ;; `%receive` returns the matcher's result vector, or nil on timeout (only
      ;; reachable with an `after` clause — nil is unambiguous because a match always
      ;; answers with a vector). The bodies run HERE, in the caller's tail position.
      (if (nil? ms)
        `(let (~r (%receive ~matcher nil ~tags ~pin)) ~dispatch)
        `(let (~r (%receive ~matcher ~ms ~tags ~pin))
           (if (nil? ~r) ~on-time ~dispatch))))))

;; ---- dirty-native offload (ADR-144) -----------------------------------------
;; The BEAM dirty-scheduler shape: a long/blocking native runs on a small OS
;; pool and only THIS process waits — its scheduler worker keeps running other
;; processes. Mechanism is `%offload` (kernel: copy args out, run on the pool,
;; deliver the result as a message); this wrapper is the policy — park in a
;; selective receive on the job's token, rethrow errors as ordinary throws.
;; Sits AFTER the `receive` macro because it uses it. It USED to double as a
;; boot-time exerciser of the freeze's reachability-aware dangling-env check:
;; the old expansion nested a body-thunk `(fn () …)` inside the matcher, so
;; expanding it left a dead captured-frame closure in the builder heap for the
;; freeze to scrub. ADR-155 removed that thunk, so no prelude form produces one
;; any more (`BROOD_BOOT_TRACE=1` now reports 0 scrubbed, was 1) and that
;; incidental coverage is GONE — the scrub branch in `Heap::to_prelude` is no
;; longer reached at boot. The hard assert for *reachable* env-capturing
;; closures still runs on every closure, so the invariant itself is unchanged.
;; (The original observation is devlog 2026-07-22.)
(defn offload (f & args)
  "Run the blocking native `f` (e.g. `slurp-bytes`, `%git-clone`,
`%pbkdf2-sha256-bytes`) with `args` on the dirty-offload OS pool and wait for
the result — parking only this process, never a scheduler worker. An error in
the native rethrows here, catchable as usual. Only long/blocking
data-in/data-out natives are allowed (`%offload` refuses the rest); other
mailbox messages stay queued while waiting (selective receive)."
  (let (tok (%offload f (into [] args)))
    (receive
      ([:offload ^tok result] result)
      ([:offload-error ^tok e] (throw e)))))

;; ---- a general membership test ----------------------------------------------
(defn member? (x xs)
  "True if `x` is equal to some item of list `xs`."
  (cond (empty? xs) false (= x (first xs)) true else (member? x (rest xs))))

;; ---- sequence library -------------------------------------------------------
;; All in Brood over the list primitives (`first`/`rest`/`cons`/`empty?`) and
;; `take`/`drop`. Every builder is tail-recursive (it accumulates a reversed list
;; and reverses once at the end), so these stay stack-safe on long inputs — which
;; matters because a `test` body runs in a green process with a small coroutine
;; stack. Sequences are cons-lists; `zip` pairs are 2-vectors (the tuple idiom).

;; (range hi) -> 0..hi-1 ; (range lo hi) -> lo..hi-1 ; (range lo hi step).
(defn range (a & more)
  "A range of integers: `(range hi)` is 0..hi-1, `(range lo hi)` is lo..hi-1, `(range lo hi step)` strides by `step`. The result is a *lazy* range — `fold`/`reduce`/`sum`/`count` walk it without building a list (O(1) memory); every other op treats it as the list of those integers. Empty ranges are `nil`."
  (cond
    (empty? more) (%range 0 a 1)
    (empty? (rest more)) (%range a (first more) 1)
    else (%range a (first more) (second more))))

;; (take n coll) -> the first n elements (fewer if coll is shorter).
(defn take (n coll)
  "The first `n` items of `coll` (fewer if it is shorter), as a list."
  (take--acc n coll nil))
(defn take--acc (n coll acc)
  (if (or (<= n 0) (empty? coll))
    (reverse acc)
    (take--acc (- n 1) (rest coll) (cons (first coll) acc))))

;; (drop n coll) -> coll without its first n elements.
(defn drop (n coll)
  "`coll` without its first `n` items."
  (if (or (<= n 0) (empty? coll)) coll (drop (- n 1) (rest coll))))

;; (take-while pred coll) / (drop-while pred coll) split on the first failure.
(defn take-while (pred coll)
  "The leading items of `coll` for which `(pred x)` holds."
  (take-while--acc pred coll nil))
(defn take-while--acc (pred coll acc)
  (if (and (pair? coll) (pred (first coll)))
    (take-while--acc pred (rest coll) (cons (first coll) acc))
    (reverse acc)))
(defn drop-while (pred coll)
  "`coll` with its leading items for which `(pred x)` holds removed."
  (if (and (pair? coll) (pred (first coll))) (drop-while pred (rest coll)) coll))

;; (any? pred coll) -> true if pred holds for any element; (every? pred coll) ->
;; true if it holds for all (vacuously true on the empty list). Booleans, by the
;; `?` convention — use `find` to recover the matching element itself.
(defn any? (pred coll)
  "True if `(pred x)` holds for at least one item of `coll`."
  (cond (empty? coll) false (pred (first coll)) true else (any? pred (rest coll))))
(defn every? (pred coll)
  "True if `(pred x)` holds for every item of `coll` (vacuously true if empty)."
  (cond (empty? coll) true (pred (first coll)) (every? pred (rest coll)) else false))

;; (find pred coll) -> the first element satisfying pred, or nil.
(defn find (pred coll)
  "The first item of `coll` for which `(pred x)` holds, or `nil`."
  (cond (empty? coll) nil (pred (first coll)) (first coll) else (find pred (rest coll))))

;; (zip a b) -> a list of [x y] vectors, stopping at the shorter input.
(defn zip (a b)
  "A list of `[x y]` pairs from `a` and `b`, stopping at the shorter input."
  (zip--acc a b nil))
(defn zip--acc (a b acc)
  (if (or (empty? a) (empty? b))
    (reverse acc)
    (zip--acc (rest a) (rest b) (cons [(first a) (first b)] acc))))

;; (partition n coll) -> consecutive n-sized chunks; a trailing partial chunk is
;; dropped (Clojure `partition` semantics). `has-at-least?` avoids re-counting.
(defn has-at-least? (n coll)
  (cond (<= n 0) true (empty? coll) false else (has-at-least? (- n 1) (rest coll))))
(defn partition (n coll)
  "Split `coll` into consecutive `n`-sized chunks; a trailing partial chunk is dropped."
  (partition--acc n coll nil))
(defn partition--acc (n coll acc)
  (if (has-at-least? n coll)
    (partition--acc n (drop n coll) (cons (take n coll) acc))
    (reverse acc)))

;; (sort coll) ascending via `<` (numbers) or structural order (anything else);
;; (sort less? coll) with a strict less-than predicate. (sort-by key-fn coll)
;; sorts by `(< (key-fn x) (key-fn y))`. A stable, O(n log n) merge sort: the
;; merge prefers the left run on ties (stable) and is tail-recursive; recursion
;; depth is O(log n), so it's stack-safe.
;;
;; The single-arg `(sort coll)` case has two Rust fast paths: `%sort-asc` for
;; the all-numeric case (~50× faster than the in-Brood mergesort because every
;; comparison is a Rust `match` instead of an `eval::apply` round-trip), and
;; `%sort-cmp` for the heterogeneous / structural case (vectors, strings,
;; keywords, …). Dispatch checks the first item — non-empty fast since
;; `(number? (first a))` is one tag-of compare. Empty coll → empty list.
;; Custom-comparator `(sort less? coll)` stays on the Brood-side `merge-sort`.
(defn sort (a & more)
  "Sort a collection (stable). `(sort coll)` is ascending by `<` for numbers, or by structural order (lexicographic on vectors/lists, text order on strings/symbols/keywords) for anything else. `(sort less? coll)` uses a strict less-than predicate."
  (cond
    (not (empty? more)) (merge-sort a (first more))
    (empty? a) nil
    (number? (first a)) (%sort-asc a)
    ;; a record element sorts by its `Ord` (`compare-to`, STRICT — no structural default,
    ;; ADR-179: sorting records without a method is a no-method error), so a type can
    ;; define its own order; every built-in keeps the native `%sort-cmp` path.
    (record? (first a)) (merge-sort (fn (x y) (< (ord-compare x y) 0)) a)
    else (%sort-cmp a)))
(defn sort-by (key-fn coll)
  "Sort `coll` (stable, ascending) by comparing `(key-fn x)` of each item with the
structural order (`compare`) — or a key's own `Ord` if the key is a record. Numeric,
string, keyword, vector, and record keys all work."
  (merge-sort (fn (x y) (< (ord-compare (key-fn x) (key-fn y)) 0)) coll))
;; Split `coll` into its first `n` items and the rest in ONE pass — what
;; merge-sort needs instead of a separate `take` + `drop` (two walks). Generally
;; useful, so it's public.
(defn split-at--acc (n coll acc)
  (if (or (<= n 0) (empty? coll))
    [(reverse acc) coll]
    (split-at--acc (dec n) (rest coll) (cons (first coll) acc))))
(defn split-at (n coll)
  "The vector `[front back]` splitting `coll` at index `n`: `front` is its first `n` items (a list), `back` the remainder. One pass, unlike a separate `take`/`drop`."
  (split-at--acc n coll nil))

;; Length-carrying merge sort: count once up front and halve `n` down the
;; recursion, and split each run in a single `split-at` pass. The previous form
;; re-`count`ed and ran a separate `take`+`drop` at every level — three O(n)
;; walks per level, O(n log n) wasted overall — purely to find the midpoint.
(defn merge-sort (less? coll) (merge-sort--n less? coll (count coll)))
;; check-allow: deliberately non-tail — depth = log2 of the length — ~60 frames for any feasible list.
(check-allow :non-tail-recursion
  (defn merge-sort--n (less? coll n)
    (if (<= n 1)
      coll
      (let (h (quot n 2)
            parts (split-at h coll))
        (merge--runs less?
          (merge-sort--n less? (nth parts 0) h) (merge-sort--n less? (nth parts 1) (- n h)))))))
(defn merge--runs (less? a b) (merge--acc less? a b nil))
(defn merge--acc (less? a b acc)
  (cond
    ;; `acc` holds the merged prefix reversed; `reverse-onto` splices it in front of
    ;; the remaining run in ONE pass — the old `(append (reverse acc) …)` reversed
    ;; `acc` and then re-walked it. (This was `(fold flip-cons tail acc)`, already
    ;; one pass, but paying a `flip-cons` apply frame per element: 1674 ms vs 601 ms
    ;; over 20k splices of a 500-element prefix.)
    (empty? a) (reverse-onto acc b)
    (empty? b) (reverse-onto acc a)
    ;; strict `<` on b-vs-a: equal elements take from `a` first, so it's stable.
    (less? (first b) (first a)) (merge--acc less? a (rest b) (cons (first b) acc))
    else (merge--acc less? (rest a) b (cons (first a) acc))))

;; `mapcat` uses `append--onto` instead of `cons` to splice each sublist straight
;; onto the reversed accumulator, then reverse once — so we never materialise the
;; intermediate list-of-sublists nor spread it through `apply append`.
(defseq mapcat
  (f) "Map `f` over `coll` and concatenate the resulting lists into one."
  (append--onto acc (f item)))

(defn frequencies (coll)
  "A map from each distinct element of `coll` to how many times it occurs."
  ;; The map accumulator is always a map, so hit the 3-arg kernel ops
  ;; (`map-assoc`/`map-get`) directly — variadic `assoc` would build a rest-list
  ;; and `get` a `cond` dispatch on every one of the n elements.
  (fold (fn (m x) (map-assoc m x (%add (map-get m x 0) 1))) {} coll))

(defn into (to from)
  "Pour each item of `from` into `to`. For a map, items are `[k v]` pairs (assoc'd, map result); for a **set**, items are added and duplicates collapse (set result); for a vector, items are appended (vector result); otherwise items are appended (list result). Maps in `from` are read as their entries, so `(into [] some-map)` and `(into {} other-map)` both work."
  (cond
    ;; Map target: build via the kernel's GC-quiet CHAMP builder (`%map-into`) —
    ;; an implementation detail of *constructing* a fresh immutable map (it writes
    ;; only build-local trie nodes inside one GC-quiet builtin; no `Value` is ever
    ;; mutable), so O(result-nodes) allocation, not O(n) fresh path-copies. A map
    ;; `from` is read as its entries first (`%map-into` takes a list/vector of `[k v]`).
    ;; a record target conj's each item via `Conjable` (a custom collection defines how);
    ;; a plain map uses the GC-quiet CHAMP builder. `map-get` tells them apart.
    (map? to) (if (map-get to :__id__ nil)
                (fold conj--one to (seq from))
                (%map-into to (if (map? from) (map-pairs from) from)))
    ;; Set target: add each item (duplicates collapse). Without this branch the
    ;; `else` poured a set into a LIST — `(into #{} [1 1 2])` was `(1 1 2)`.
    (set? to) (fold %set-add to from)
    ;; `append to from` is always a list (fold-of-flip-cons), so we re-vectorise.
    ;; That's an extra O(n) pass — acceptable; the previous code silently
    ;; returned a list even when `to` was a vector.
    (vector? to) (apply vector (append to from))
    else (append to from)))

;; conj's per-element step: each collection kind has a natural insertion point.
(defn conj--one (coll x)
  (cond
    (nil? coll) (list x)
    (vector? coll) (into coll [x])
    (set? coll) (%set-add coll x)
    ;; a record dispatches to its `Conjable` impl (default: the map behaviour below); a
    ;; custom-collection record defines its own insertion. `map-get` distinguishes it from
    ;; a plain map, and `-conj` is only reached for records, so its late definition is fine.
    (map? coll) (if (map-get coll :__id__ nil)
                  (-conj coll x)
                  (cond
                    (map? x) (merge coll x)
                    (and (vector? x) (= (count x) 2)) (assoc coll (nth x 0) (nth x 1))
                    else (error "conj: adding to a map takes a [k v] pair or a map, got " (pr-str x))))
    (pair? coll) (cons x coll)
    else (error "conj: not a collection: " (pr-str coll))))

(defn conj (coll & xs)
  "Add element(s) to `coll` at its natural insertion point (Clojure-style):
APPEND to a vector, PREPEND to a list (`nil` counts as an empty list), ADD to a
set (a duplicate is a no-op), and `assoc` a `[k v]` pair — or merge a map — into
a map. Returns a fresh collection; `coll` is untouched. e.g. (conj [1 2] 3) →
[1 2 3]; (conj '(2 3) 1) → (1 2 3); (conj #{1} 2) → #{1 2};
(conj {:a 1} [:b 2]) → {:a 1 :b 2}."
  (fold conj--one coll xs))

(defn disj (s & xs)
  "A fresh set like `s` with each of `xs` removed (removing an absent element is a
no-op). The set counterpart of `dissoc`, and `conj`'s inverse — both live here
rather than in `std/set` so a set works with the collection protocol without an
import (and so `(:use set)` can't shadow them)."
  (fold %set-remove s xs))

(defn remove-nth (coll i)
  "A fresh collection like `coll` with the element at index `i` removed. Returns
a vector for a vector and a list for a list. `i` must be in `[0, count)`."
  (if (vector? coll)
    (into (subvec coll 0 i) (subvec coll (inc i) (count coll)))
    (append (take i coll) (drop (inc i) coll))))

;; ---- more sequence operations -----------------------------------------------
;; The eager counterparts of the `x*` transducers, plus the common Clojure-ish
;; builders. All tail-recursive (reverse-accumulate, reverse once) so they stay
;; stack-safe on long inputs — see the sequence-library note above.

(defseq remove
  (pred)
  "A list of the items of `coll` for which `(pred x)` is *falsy* — the complement of `filter`."
  (if (pred item) acc (cons item acc)))

(defseq keep
  (f)
  "A list of the non-nil results of `(f x)` over `coll` — map and filter fused (the eager counterpart of `xkeep`)."
  (let (y (f item)) (if (nil? y) acc (cons y acc))))

;; distinct: keep the first occurrence of each item. A map carried alongside the
;; result acts as the "seen" set, so membership is O(1)-ish, not the O(n²) a
;; `member?`-per-item scan would cost. State is the 2-vector [seen result-rev].
(defn distinct--step (state x)
  ;; the "seen" map only ever stores `true`, so a single `map-get` (default
  ;; `false`) distinguishes present from absent — no need for `contains?`'s
  ;; two-sentinel probe (which exists to tell a stored `nil`/`false` from absence).
  (if (map-get (nth state 0) x false)
    state
    [(map-assoc (nth state 0) x true) (cons x (nth state 1))]))
(defn distinct (coll)
  "The items of `coll` with duplicates removed, keeping the first occurrence of each (order-preserving)."
  (reverse (nth (fold distinct--step [{} nil] coll) 1)))

;; dedupe: collapse only *consecutive* runs of equal items (no "seen" set needed).
(defn dedupe--acc (coll prev acc)
  (cond
    (empty? coll) acc
    (= (first coll) prev) (dedupe--acc (rest coll) prev acc)
    else (dedupe--acc (rest coll) (first coll) (cons (first coll) acc))))
(defn dedupe (coll)
  "The items of `coll` with *consecutive* runs of equal items collapsed to a single item."
  (if (empty? coll)
    nil
    (reverse (dedupe--acc (rest coll) (first coll) (list (first coll))))))

(defn group-by (f coll)
  "A map from each `(f x)` to the list of items of `coll` that produced it, each list in original order."
  ;; Prepend per group (O(1)) then reverse every group's list once at the end.
  ;; Direct kernel `map-assoc`/`map-get` — the accumulator is always a map.
  (update-vals (fold (fn (m x) (let (k (f x)) (map-assoc m k (cons x (map-get m k nil))))) {} coll)
    reverse))

;; flatten: splice nested lists into one flat list. Descends through `pair?`/`nil`
;; (so empty sub-lists and nils vanish); vectors and maps are leaf items. The
;; outer walk is tail-recursive; the nested call recurses only as deep as the
;; nesting (bounded), not the length.
;; check-allow: deliberately non-tail — depth = the structure's nesting, not its element count.
(check-allow :non-tail-recursion
  (defn flatten--acc (coll acc)
    (cond
      (empty? coll) acc
      (list? (first coll)) (flatten--acc (rest coll) (flatten--acc (first coll) acc))
      else (flatten--acc (rest coll) (cons (first coll) acc)))))
(defn flatten (coll)
  "A single flat list of the leaf items of `coll`, descending into nested lists. Vectors and maps are treated as leaves."
  (reverse (flatten--acc coll nil)))

(defn interpose--acc (sep coll acc)
  (if (empty? coll) acc (interpose--acc sep (rest coll) (cons (first coll) (cons sep acc)))))
(defn interpose (sep coll)
  "A list with `sep` inserted between adjacent items of `coll`."
  (if (empty? coll) nil (reverse (interpose--acc sep (rest coll) (list (first coll))))))

(defn interleave--acc (a b acc)
  (if (or (empty? a) (empty? b))
    (reverse acc)
    (interleave--acc (rest a) (rest b) (cons (first b) (cons (first a) acc)))))
(defn interleave (a b)
  "A list alternating items from `a` and `b` — `(a0 b0 a1 b1 …)` — stopping at the shorter input."
  (interleave--acc a b nil))

(defn take-last (n coll)
  "The last `n` items of `coll`, as a list (the whole of `coll` if it is shorter, `()` if `n` <= 0)."
  (drop (- (count coll) n) coll))
(defn drop-last (n coll)
  "`coll` without its last `n` items (`()` if `n` >= its length)."
  (take (- (count coll) n) coll))

;; ---- enum extras ------------------------------------------------------------
;; (chunk-every n coll) — like partition but keeps the trailing partial chunk.
(defn chunk-every--acc (n coll acc)
  (if (empty? coll)
    (reverse acc)
    (chunk-every--acc n (drop n coll) (cons (into [] (take n coll)) acc))))
(defn chunk-every (n coll)
  "Split `coll` into consecutive `n`-item vectors; unlike `partition`, a
trailing partial chunk is kept. `n` must be positive."
  (chunk-every--acc n (seq coll) nil))

;; (chunk-by f coll) — consecutive runs where (f x) returns the same value.
(defn chunk-by--acc (f coll key curr acc)
  (if (empty? coll)
    (reverse (cons (into [] (reverse curr)) acc))
    (let (x (first coll) k (f x))
      (if (= k key)
        (chunk-by--acc f (rest coll) key (cons x curr) acc)
        (chunk-by--acc f (rest coll) k (list x) (cons (into [] (reverse curr)) acc))))))
(defn chunk-by (f coll)
  "Split `coll` into consecutive vectors where `(f x)` returns the same value.
A new chunk starts each time the return value of `f` changes."
  (let (s (seq coll))
    (if (empty? s)
      nil
      (chunk-by--acc f (rest s) (f (first s)) (list (first s)) nil))))

;; (scan f init coll) — running fold: returns a list of all intermediate values
;; including the seed.
(defn scan--acc (f acc coll result)
  (if (empty? coll)
    (reverse result)
    (let (next (f acc (first coll)))
      (scan--acc f next (rest coll) (cons next result)))))
(defn scan (f init coll)
  "Return a list of successively accumulated values of `(fold f init coll)`,
starting with `init`. `(scan + 0 '(1 2 3))` → `(0 1 3 6)`."
  (scan--acc f init (seq coll) (list init)))

;; (zip-with f a b) — map `f` over pairs, stopping at the shorter sequence.
(defn zip-with--acc (f a b acc)
  (if (or (empty? a) (empty? b))
    (reverse acc)
    (zip-with--acc f (rest a) (rest b) (cons (f (first a) (first b)) acc))))
(defn zip-with (f a b)
  "Map `f` over corresponding pairs from `a` and `b`, stopping at the shorter
input. `(zip-with + '(1 2) '(3 4))` → `(4 6)`."
  (zip-with--acc f (seq a) (seq b) nil))

;; ---- records: named, optionally-typed maps (defrecord — ADR-130) ------------
;; A record is a plain immutable map with a positional constructor and one
;; accessor per field. `(defrecord point (x y))` defines:
;;   (defn point   (x y) {:x x :y y})   ; constructor, named after the record
;;   (defn point-x (p)   (get p :x))    ; accessor per field
;;   (defn point-y (p)   (get p :y))
;; The accessors are the point: `(point-x p)` names the field, and a typo
;; `(point-witdh p)` is an undefined-function error the checker catches — where
;; `(get p :witdh)` silently returns nil. Records ARE maps (no new Value or tag),
;; so update with `assoc`/`merge` — but they are NOMINAL since ADR-177: the baked
;; `:__id__` makes `(= (point 1 2) {:x 1 :y 2})` false and carries dispatch
;; identity. No generated `point?` predicate; write one over `record-id` if needed.
;;
;; A field may carry a type: `(defrecord point ((x int) (y int)))`. When *every*
;; field is typed, `sig`s are emitted too — the constructor's `(record …)` return
;; type and each accessor's field type — so the advisory checker gets field-type
;; and field-presence checking from the existing record-type machinery (ADR-115).

;; A field spec is a bare `name` (untyped) or `(name type)` (typed).
(defn defrecord--fname (f) (if (pair? f) (first f) f))
(defn defrecord--ftype (f) (if (pair? f) (second f) nil))
(defn defrecord--acc-sym (rec fld) (symbol (str (name rec) "-" (name fld))))
(defn defrecord--derives (opts)
  "The vector following `:derives` in a `defrecord`'s trailing opts (the abilities to
  derive), or nil. Each named ability must declare a `:derive-record` recipe (ADR-185)."
  (cond
    (empty? opts) nil
    (= (first opts) :derives) (second opts)
    else (defrecord--derives (rest opts))))
(defn defrecord--qualify (nm)
  "Qualify bare name `nm` (a string) against the current ns → a `:<ns>/nm` keyword; at
root/REPL (no ns) there is no prefix, so it is a bare `:nm`. Shared by `defrecord` (which
bakes a record's `:__id__`) and `ability--id-kw` (an impl's bare id) so the two AGREE — a
record built at root and an impl for it at root must land on the same dispatch id."
  (let (ns (current-ns))
    (if ns (keyword (str (name ns) "/" nm)) (keyword nm))))

;; The `(sig …)` forms for an all-typed record: the constructor arrow, then one
;; accessor arrow per field. Built as plain data — `sig` reads the un-expanded type.
;; id-keyword → record name: the set of nominal ids that are GENUINE `defrecord`
;; identities. Ground truth for BROOD_MONO's direct-constructor devirtualization
;; (ADR-182) — a constructor call `(circle 2)` may be devirtualized only when its baked
;; id (`:module/circle`) is registered here, so a same-named non-record fn is never
;; mistaken for a record constructor. Always populated (cheap load-time metadata, like
;; `*impls*`); read only under the flag.
(def *record-ids* {})
(defn record-register (id nm)
  "Record that `id` (a `:module/name` keyword) is a `defrecord`'s nominal identity."
  (def *record-ids* (assoc *record-ids* id nm))
  nil)

(defmacro defrecord (rec fields & opts)
  "Define record `rec` with `fields` — a positional constructor `(rec …)` plus a
`rec-field` accessor per field. A record is an immutable map that also carries a
**nominal identity**: a reserved `:__id__` field holding a `:module/name` keyword baked
in at definition, so `ability` dispatch tells it apart from a bare map and from other
records (Elixir-struct semantics — a record is NOT `=` to a bare map with the same
fields). `record?`/`record-id`/`fields` are the clean, id-free view.

A field is a bare symbol or `(field type)`; the constructor result is inferred as a
record SHAPE carrying the `:__id__` keyword literal, so a value's identity flows through
the checker to dispatch sites (`(let (c (circle 2)) (area c))` is checkable). When every
field is typed, per-accessor signatures are emitted too.

A trailing `:derives [Ability …]` clause auto-generates an impl of each named ability
(Elixir `@derive` / Rust `#[derive]`, ADR-185): each ability's `:derive-record` recipe is
called with the field names at expansion, and the methods it returns are spliced into an
`(impl Ability rec …)`. The ability must declare a recipe (else a clean expansion error),
and it must be loaded before this `defrecord`.

    (defmodule geometry)
    (defrecord circle (r))          ; (circle 2) → {:__id__ :geometry/circle, :r 2}
    (impl Shape circle (area [c] (* 3.14 (get c :r) (get c :r))))
    (defrecord point (x y) :derives [Ord])   ; compare-to synthesized field-wise"
  (let (fnames (map defrecord--fname fields)
        fkws (map (fn (n) (keyword (name n))) fnames)
        ;; the nominal id — a `:module/name` KEYWORD (a keyword literal is what the
        ;; checker tracks via `Ty::keyword_lit`), captured at definition.
        id (defrecord--qualify (name rec))
        ;; ctor body: a MAP LITERAL (built here, at macro time) whose values are the field
        ;; symbols, with the reserved `:__id__` carrying the id keyword. Emitting a real
        ;; map value (not a `(hash-map …)` call) is what makes the checker infer the result
        ;; as a record shape carrying the `:__id__` keyword literal.
        body (zipmap (cons :__id__ fkws) (cons id fnames))
        ctor `(defn ~rec (~@fnames) ~body)
        accs (map (fn (f)
                    (let (fnm (defrecord--fname f))
                      `(defn ~(defrecord--acc-sym rec fnm) (r) (get r ~(keyword (name fnm))))))
               fields)
        ;; the record-shaped constructor sig (always — this is the dispatch-inference
        ;; seam): each field keeps its declared type, else `any`.
        arg-tys (map (fn (f) (or (defrecord--ftype f) 'any)) fields)
        rec-ty (cons 'record
                 (cons :__id__
                   (cons id
                     (mapcat (fn (f)
                               (list (keyword (name (defrecord--fname f)))
                                 (or (defrecord--ftype f) 'any)))
                       fields))))
        ctor-sig (list 'sig rec (append arg-tys (list '-> rec-ty)))
        ;; per-accessor sigs only when every field is typed (else an accessor call on a
        ;; bare map would false-warn), mirroring the pre-unification behaviour.
        acc-sigs (if (every? pair? fields)
                   (map (fn (f)
                          (let (fnm (defrecord--fname f))
                            (list 'sig
                              (defrecord--acc-sym rec fnm)
                              (list (list 'record (keyword (name fnm)) (defrecord--ftype f))
                                '-> (defrecord--ftype f)))))
                     fields)
                   nil)
        ;; `:derives [A …]` → one `(derive-into 'A id 'fields (current-ns))` per ability. The
        ;; recipe is run at LOAD (not expansion), because the checker expands this `defrecord`
        ;; WITHOUT first evaluating the ability's `defability`, so the recipe isn't registered
        ;; at expand time. `derive-into` registers the impls at load; the checker reads these
        ;; forms statically (they mark the ability's ops as implemented for `id`).
        derives (defrecord--derives opts)
        derive-calls (if derives
                       (map (fn (a)
                              (list 'derive-into (list 'quote a) id
                                (list 'quote fnames) (list 'current-ns)))
                         derives)
                       nil))
    `(do ~ctor-sig ~ctor ~@accs ~@acc-sigs ~@derive-calls (record-register ~id '~rec) nil)))

;; (min-by f coll) / (max-by f coll) — find the element whose key is smallest/largest.
(defn min-by (f coll)
  "The item in `coll` for which `(f item)` is smallest. Errors on empty input."
  (fold (fn (best x) (if (< (f x) (f best)) x best)) (first coll) (rest coll)))
(defn max-by (f coll)
  "The item in `coll` for which `(f item)` is largest. Errors on empty input."
  (fold (fn (best x) (if (> (f x) (f best)) x best)) (first coll) (rest coll)))

(defn clamp (x lo hi)
  "Constrain `x` to the closed range [`lo`, `hi`]: `lo` if `x` is below it, `hi` if above, else `x`."
  (max lo (min hi x)))

(defn repeat--acc (n x acc) (if (<= n 0) acc (repeat--acc (dec n) x (cons x acc))))
(defn repeat (n x)
  "A list of `x` repeated `n` times (empty if `n` <= 0)."
  (repeat--acc n x nil))

(defn repeatedly--acc (n f acc)
  (if (<= n 0) (reverse acc) (repeatedly--acc (dec n) f (cons (f) acc))))
(defn repeatedly (n f)
  "A list of `n` successive calls to the zero-argument function `f` (in call order)."
  (repeatedly--acc n f nil))

;; ---- lazy / fusing seq-views (compute-frontier lever 3) ---------------------
;; `map`/`filter`/`keep`/`remove` are EAGER — they return a concrete list, and
;; running them for side effects (`(map require-one mods)`, `(map run-test ts)`)
;; works as it always has. Fusion is **opt-in**, via `lmap`/`lfilter`/`lkeep`/
;; `lremove` composed with `->>`. Each returns a lazy seq-view (`%seqview`): a
;; non-materialising value carrying a transducer over a source. Chaining
;; composes the transducers onto one view, so a `->>` pipeline folds/reduces in
;; a **single pass with no intermediate lists**:
;;
;;   (->> xs (lmap sq) (lfilter even?) (reduce + 0))   ; one pass, no temp lists
;;
;; Consume a view with `fold`/`reduce`/`sum`/`count`/`into`/`join`/`seq`/`nth`/
;; `first`/`rest`; `seq`/`into`/`str`/`=` materialise it to a concrete value. A
;; view is heap-local: **`send` refuses to ship one** (a view references its
;; source process's heap), so realise it first (`(seq v)`/`(into [] v)`) before
;; crossing a process or the network. Footgun: like any lazy value, a view
;; defers the work in its fns (and a `throw` therein) until realised — so don't
;; build a view for side effects; use eager `map`/`doseq` for that.

;; Composition — general right-to-left function composition; also the glue that
;; fuses a view's stages.
(defn comp--compose (f g) (fn (x) (f (g x))))
(defn comp (& fns)
  "Right-to-left function composition. `((comp f g) x)` is `(f (g x))`; with no
arguments, `identity`."
  (cond
    (empty? fns) identity
    (empty? (rest fns)) (first fns)
    else (fold comp--compose (first fns) (rest fns))))

;; The rest of the combinator family. `comp` shipped alone for a long time, which
;; left `(map (fn (x) (f a x)) xs)` as the only spelling of a partially-applied
;; call — the gap a review found on 2026-07-26.
(defn partial (f & bound)
  "`f` with its leading arguments fixed: `((partial f a b) c)` is `(f a b c)`.
The workhorse for handing a configured function to a higher-order op."
  (fn (& later) (apply f (append bound later))))

(defn complement (pred)
  "A predicate that returns the logical negation of `pred`: `((complement odd?) 2)`
is `true`. The named form of `(fn (& args) (not (apply pred args)))`."
  (fn (& args) (not (apply pred args))))

(defn constantly (x)
  "A function of any arguments that always returns `x` — the placeholder callback
for a higher-order op that wants a fixed answer."
  (fn (& _ignored) x))

;; Internal stateless transducer constructors — the fused stages behind the
;; `l*` combinators. A transducer is `(xf rf) -> rf'`; composing them (`comp`)
;; fuses a pipeline into one per-step reducing function. Named `%x*` because they
;; are plumbing: the public surface is `lmap`/`lfilter`/`lkeep`/`lremove`, not
;; raw transducers. Fixed-arity (no rest-list) so they keep the fast call path.
(defn %xmap (f)
  (fn (rf) (fn (acc x) (rf acc (f x)))))
(defn %xfilter (pred)
  (fn (rf) (fn (acc x) (if (pred x) (rf acc x) acc))))
(defn %xremove (pred)
  (fn (rf) (fn (acc x) (if (pred x) acc (rf acc x)))))
(defn %xkeep (f)
  (fn (rf) (fn (acc x) (let (y (f x)) (if (nil? y) acc (rf acc y))))))

;; ---- transducers, as public surface (ADR-161) -------------------------------
;; The stage constructors above stayed private for a reason that expired: the `l*`
;; combinators cover the built-in stages, but a user who wants a stage of their OWN
;; (`take-while`-as-a-stage, a stateful de-duplicator, a windower) had no way to
;; write one and no way to run it. The contract is small enough to publish:
;;
;;   A TRANSDUCER is a function `(rf) -> rf'` where a REDUCING FUNCTION `rf` is
;;   `(acc x) -> acc`. It wraps `rf` and may call it zero, one, or many times per
;;   input. Compose stages with `comp` — LEFT to RIGHT in data-flow order, the
;;   reverse of ordinary function composition, because each stage wraps the *next*
;;   one's reducer.
;;
;; `xmap`/`xfilter`/`xremove`/`xkeep` are the built-in stages (the same functions
;; the `l*` combinators use), and `transduce` runs a stack over any collection.
(defn xmap (f)
  "The `map` stage as a transducer: `(f x)` for each input. Compose with `comp`, run
with `transduce`, or reach for `lmap` when you just want a fusing pipeline."
  (%xmap f))
(defn xfilter (pred)
  "The `filter` stage as a transducer: keep inputs where `(pred x)` is truthy."
  (%xfilter pred))
(defn xremove (pred)
  "The `remove` stage as a transducer: drop inputs where `(pred x)` is truthy."
  (%xremove pred))
(defn xkeep (f)
  "The `keep` stage as a transducer: `(f x)` for each input, dropping `nil` results."
  (%xkeep f))

(defn transduce (xform rf init coll)
  "Reduce `coll` with `rf`/`init` through the transducer `xform` — one pass, no
intermediate collections. `(transduce (comp (xfilter odd?) (xmap sq)) + 0 (range 10))`
sums the squares of the odd numbers, allocating nothing in between.

`xform` is any `(rf) -> rf'` function, so a stage of your own is a plain `fn`:

  (defn xtake-while (pred)          ; stop-at-first-failure, as a stage
    (fn (rf) (fn (acc x) (if (pred x) (rf acc x) acc))))

Stages compose LEFT to RIGHT in data-flow order under `comp` — `(comp (xfilter p)
(xmap f))` filters before mapping — because each stage wraps the next one's reducer.
`lmap`/`lfilter`/… are the ergonomic front end over the same machinery; use
`transduce` when the stage stack is computed, reused, or your own."
  (fold (xform rf) init coll))

(defn %seqview-wrap (coll xf)
  "Wrap `coll` in a lazy seq-view applying transducer `xf`. If `coll` is already a
view, compose `xf` onto its transducer (same source) so the stages fuse."
  (if (seqview? coll)
    (let (parts (%seqview-parts coll))
      (%seqview (vector-ref parts 0) (comp (vector-ref parts 1) xf)))
    (%seqview coll xf)))

(defn lmap (f coll)
  "Lazy, fusing `map`: a seq-view of `(f x)` for each `x` in `coll`. Composes with
adjacent `l*` stages (thread them with `->>`) and folds/reduces in one pass with
no intermediate lists. Realise with `seq`/`into`, or just consume it
(`fold`/`reduce`/`count`/…). Use eager `map` when you want a concrete list or are
iterating for side effects."
  (%seqview-wrap coll (%xmap f)))

(defn lfilter (pred coll)
  "Lazy, fusing `filter` — see `lmap`."
  (%seqview-wrap coll (%xfilter pred)))

(defn lkeep (f coll)
  "Lazy, fusing `keep` (map + filter of non-nil `(f x)`) — see `lmap`."
  (%seqview-wrap coll (%xkeep f)))

(defn lremove (pred coll)
  "Lazy, fusing `remove` — see `lmap`."
  (%seqview-wrap coll (%xremove pred)))

;; ---- iteration combinators --------------------------------------------------
;; Hide the hand-rolled counter/accumulator recursion behind names that read as
;; intent (the way `defprocess` hides a receive loop). All ordinary Brood.

(defn times (n f x)
  "Apply `f` to `x` `n` times — fⁿ(x). `(times 0 f x)` is `x`."
  (if (<= n 0) x (times (dec n) f (f x))))

(defn iterate-times--acc (f x n acc)
  (if (< n 0) acc (iterate-times--acc f (f x) (dec n) (cons x acc))))
(defn iterate-times (f x n)
  "The list (x f(x) f²(x) … fⁿ(x)) — `n`+1 successive states of applying `f`."
  (reverse (iterate-times--acc f x n nil)))

;; One tail pass pairing each item with a running index — the old
;; `(zip (range (count coll)) coll)` made three passes (count, build the range
;; list, then zip). `seq` coerces a map to its `[k v]` pairs, as `zip` did.
(defn enumerate--acc (i coll acc)
  (if (empty? coll)
    (reverse acc)
    (enumerate--acc (inc i) (rest coll) (cons [i (first coll)] acc))))
(defn enumerate (coll)
  "Pair each item with its 0-based index: ([0 x₀] [1 x₁] …)."
  (enumerate--acc 0 (seq coll) nil))

;; ---- comprehensions ---------------------------------------------------------
;; `for` builds a list by walking one or more bindings, with `:when` guards —
;; a macro over `mapcat`, so the map/filter/fold plumbing disappears from view.
;;   (for (x xs) expr)               -> a list of expr for each x
;;   (for (x xs :when p) expr)       -> … only where p holds
;;   (for (x xs y ys) [x y])         -> nested (y varies fastest)
;; Bindings may destructure: (for ([k v] (map-pairs m)) …). Build a map from the
;; result with `(into {} (for …))`. Bindings are a list — code is lists, vectors
;; are data (ADR-010); a vector is still accepted in binding position.

;; Compile the binding forms (a list: alternating pattern/coll, plus :when pred)
;; from the inside out, threading a single accumulator `acc` through. Each
;; binding becomes a `fold` over its collection that conses the body onto `acc`;
;; each :when an `if` that passes `acc` through unchanged when the guard fails;
;; the body a single `(cons body acc)`. The whole thing builds the result in
;; reverse with no intermediate per-element lists (the old `mapcat` lowering
;; allocated a one-element `(list body)` per item and concatenated them) — so a
;; final `reverse` restores order in one extra O(n) pass. `fold` is tail-
;; recursive, so deep comprehensions don't grow the stack.
;; check-allow: deliberately non-tail — expansion-time recursion over macro-body syntax — depth is source nesting, not runtime data.
(check-allow :non-tail-recursion
  (defn for--fold (acc binds body)
    (cond
      (empty? binds) `(cons ~body ~acc)
      (= (first binds) :when) `(if ~(second binds) ~(for--fold acc (rest (rest binds)) body) ~acc)
      else `(fold (fn (~acc ~(first binds)) ~(for--fold acc (rest (rest binds)) body))
              ~acc ~(second binds)))))

;; Validate that binding pairs are complete — each variable has a collection, and each
;; :when has a guard expression. An odd-count suffix silently produces an empty result
;; (the missing coll becomes nil), which is almost always a mistake.
(defn for--check-binds (binds)
  (cond
    (empty? binds) nil
    (%eq (first binds) :when) (if (empty? (rest binds))
                                (error "for: :when at end of bindings has no guard expression")
                                (for--check-binds (rest (rest binds))))
    (empty? (rest binds)) (error "for: binding '"
                            (pr-str (first binds))
                            "' has no collection — bindings must be paired as (var coll ...)")
    else (for--check-binds (rest (rest binds)))))

(defmacro for (binds & body)
  "List comprehension: `(for (x xs) expr)` yields `expr` for each `x`; supports `:when guard` filters and multiple bindings (last varies fastest). Bindings may destructure. Multiple body forms are evaluated in order and the LAST one is collected (like `let`/`when`/`doseq`) — `for` took exactly one body form until 2026-07-26, the only iteration form that did."
  (do
    (when (vector? binds)
      (error "for: bindings must be a list, not a vector: write (for (x xs) expr)."
        " Brood is lists-for-code, vectors-for-data (unlike Clojure) — a vector"
        " *inside* a binding position is still destructuring: (for ([k v] pairs) k)."))
    (for--check-binds binds)
    (let (acc (gensym "acc"))
      `(reverse (let (~acc nil)
                  ~(for--fold acc
                     (map identity binds) (if (empty? (rest body)) (first body) (cons 'do body))))))))

;; (doseq (pat coll) body...) — run `body` for its side effects over each item,
;; returning nil. Just `for` run for effect (the result list is discarded). The
;; param is `bind`, not `binding` — the latter is the dynamic-variable form.
(defmacro doseq (bind & body)
  "Run `body` for its side effects over each item of the binding (like `for`, but discards the result and returns `nil`)."
  `(do (for ~bind (do ~@body)) nil))

;; (dotimes (i n) body...) — run `body` for `i` = 0, 1, …, n-1; returns nil. The
;; lean iteration primitive: a plain tail-recursive walker, no result list built
;; (unlike `doseq`, which routes through `for`/`mapcat`). For effects only.
(defn dotimes--loop (n f i) (when (< i n) (f i) (dotimes--loop n f (+ i 1))))
(defmacro dotimes (bind & body)
  "Run `body` with the bound name set to 0, 1, …, n-1 for side effect; returns `nil`. `bind` is `(var n)`."
  (if (not (and (pair? bind) (pair? (rest bind))))
    (error "dotimes: bind must be (var n), got "
      (pr-str bind) ". Syntax: (dotimes (i n) body...)")
    `(do (dotimes--loop ~(second bind) (fn (~(first bind)) ~@body) 0) nil)))

;; (dolist (x xs) body...) — run `body` for each element of `xs`; returns nil.
;; The list-only counterpart to `dotimes`: lean and tail-recursive, no discard
;; list built. Use `doseq` when you need destructuring or `:when` filters; reach
;; for `dolist` for the common "do this for each item" loop.
(defn dolist--loop (xs f) (when (not (nil? xs)) (f (first xs)) (dolist--loop (rest xs) f)))
(defmacro dolist (bind & body)
  "Run `body` with the bound name set to each element of the collection for side effect; returns `nil`. `bind` is `(var coll)`."
  (if (not (and (pair? bind) (pair? (rest bind))))
    (error "dolist: bind must be (var coll), got "
      (pr-str bind) ". Syntax: (dolist (x xs) body...)")
    `(do (dolist--loop ~(second bind) (fn (~(first bind)) ~@body)) nil)))

;; (bench label expr) — wall-clock timing, in milliseconds (the resolution of
;; `now`). The gensyms keep `label`/`expr` from capturing `t0`/`r` if the caller
;; happens to use those names.
(defmacro bench (label expr)
  "Evaluate `expr`, print `label: N ms`, and return `expr`'s value."
  (let (t0 (gensym "t0") r (gensym "r"))
    `(let (~t0 (now) ~r ~expr)
       (println (str ~label ": " (- (now) ~t0) " ms"))
       ~r)))

;; ---- symbol / keyword conversions -------------------------------------------
;; `symbol` and `keyword` (Rust) are lenient — they take string/symbol/keyword.
;; These are the strict named conversions: each errors on the wrong input shape,
;; matching the Scheme/Clojure tradition. Thin Brood wrappers, no new kernel.

(defn symbol->string (s)
  "The spelling of symbol `s` as a string. Errors if `s` isn't a symbol."
  (if (symbol? s) (name s) (error "symbol->string: expected a symbol, got " (type-of s))))

(defn string->symbol (s)
  "The symbol whose spelling is the string `s`. Errors if `s` isn't a string."
  (if (string? s) (symbol s) (error "string->symbol: expected a string, got " (type-of s))))

;; ---- strings ----------------------------------------------------------------
;; The string library, written over the kernel primitives `substring` /
;; `string-length` / `str` and `upper` / `lower` / `string->number`. Brood has no
;; distinct char type, so a "character" is a 1-char string; all indices are
;; char-based, matching `string-length`. The helpers below are tail-recursive
;; (stack-safe over long strings); `substring` is O(index), so a full scan is
;; O(n²) — fine for the short strings this targets (the rope/buffer engine in M2
;; is the home for large-text performance).

(defn feature? (name)
  "True if this runtime was built with the optional feature `name` (a keyword —
`:gui`, `:jit`, `:audio`, `:treesit`, …). See `(features)` for the whole list.

Reach for this instead of `bound?` when a capability is optional: a builtin from
an absent feature is still **bound** and still raises when called, so `(bound?
'gui-open)` answers yes on a runtime that cannot open a window. An app that wants
to degrade rather than fail asks the build."
  (includes? (features) name))

(defn capitalize (s)
  "Return `s` with the first character upper-cased and the rest lower-cased."
  (if (= (string-length s) 0)
    s
    (str (upper (substring s 0 1)) (lower (substring s 1)))))

(defn codepoints->string (cs)
  "Build a string from a list (or vector) of Unicode codepoint integers — the
inverse of the `string->codepoints` primitive."
  (apply str (map int->char cs)))

(defn char-at (s i)
  "The character (a 1-char string) at char index `i` of `s`."
  (substring s i (inc i)))

(defn number->string (n)
  "The textual form of number `n` — the inverse of `string->number`."
  (str n))

(defn string->list (s)
  "The characters of `s` as a list of 1-char strings."
  ;; One native O(n) `chars()` pass. A pure-Brood `(substring s i (inc i))` loop
  ;; is O(n^2) — `substring` walks to char boundary `i` each call — which silently
  ;; makes every `(into [] (string->list s))` code-point vector O(n^2) to build
  ;; (it defeated the json/base64 char-indexing rewrites; see docs/devlog.md).
  (string-split s ""))

(defn list->string (cs)
  "Concatenate a list of strings (e.g. from `string->list`) into one string."
  (apply str cs))

(defn index-of--seq-from (coll x i from)
  ;; scan from the head; only start matching once the running index reaches `from`
  (cond
    (empty? coll) -1
    (and (>= i from) (= (first coll) x)) i
    else (index-of--seq-from (rest coll) x (inc i) from)))
(defn index-of (coll x &optional from)
  "The 0-based index of `x` in `coll` at or after `from` (default 0), or -1 if absent.
For a string, `x` is a substring (multi-char ok; the empty string matches at `from`);
for a list or vector, `x` is an element compared structurally. The `from` offset is
what incremental search rides on (formerly the separate `index-of`)."
  (let (start (or from 0))
    (cond
      ;; Strings ride on the `%str-index-of` kernel primitive — linear; a pure-Brood
      ;; scan would be O(n²) (char indexing is O(index)), which is too slow for
      ;; whole-namespace `doc-search`/`apropos` use. With a `from`, search the suffix
      ;; and re-offset, clamping `from` to `[0, length]`; the empty needle matches at `from`.
      (string? coll) (if (= start 0)
                       (%str-index-of coll x)
                       (let (n (string-length coll)
                             s0 (max 0 (min n start))
                             rel (%str-index-of (substring coll s0 n) x))
                         (if (< rel 0) -1 (+ s0 rel))))
      else (index-of--seq-from coll x 0 start))))

(defn index-where--from (pred coll i)
  (cond
    (empty? coll) -1
    (pred (first coll)) i
    else (index-where--from pred (rest coll) (inc i))))
(defn index-where (pred coll)
  "The 0-based index of the first item of `coll` for which `(pred x)` holds, or
-1 if none does. The predicate counterpart of `index-of` (which matches by
equality); recover the item itself with `find`."
  (index-where--from pred coll 0))

(defn last-index-of--scan (s needle before i best)
  ;; walk forward collecting match starts < `before`, keeping the greatest seen
  (let (j (index-of s needle i))
    (cond
      (< j 0) best
      (>= j before) best
      else (last-index-of--scan s needle before (inc j) j))))
(defn last-index-of (s needle &optional before)
  "The 0-based char index of the **last** occurrence of `needle` in string `s` whose
start is strictly **before** `before` (default `(string-length s)`), or -1 if there is
none. The backward counterpart of `(index-of s needle from)` — what reverse
incremental search rides on."
  (let (b (or before (string-length s)))
    (cond
      ;; the empty needle matches at every position 0..length; the last one strictly
      ;; before `b` is `b-1` (clamped). Handled directly — the scan would loop forever
      ;; when `b` exceeds the length (every probe returns the same index).
      (= needle "") (cond (<= b 0) -1 (> b (string-length s)) (string-length s) else (dec b))
      else (last-index-of--scan s needle b 0 -1))))

(defn includes? (coll x)
  "True if `coll` contains `x`. Works on lists, vectors, strings (substring), and maps (membership among values — use `contains?` for keys)."
  (cond
    (map? coll) (member? x (vals coll))
    else (>= (index-of coll x) 0)))

;; Collect `coll`'s elements interleaved with `sep` into a parts list (tail-
;; recursively, reversed), then build the string in one `apply str` pass.
(defn join--parts (sep coll acc)
  (if (empty? coll) acc (join--parts sep (rest coll) (cons (first coll) (cons sep acc)))))
(defn join (sep coll)
  "Concatenate the strings in `coll` with `sep` between adjacent elements."
  ;; For the common case — a string separator over a list/vector/range — the
  ;; native `%string-join` walks `coll` once into one buffer (no intermediate
  ;; parts list, no reverse). The all-Brood path stays as a fallback for an
  ;; exotic (non-string) separator: it builds the interleaved parts list
  ;; (reversed) then concatenates in one `apply str` pass.
  ;; A lazy seq-view is realised first (the native walks it via `seq_items`,
  ;; which can't run a transducer). NOTE: this materialises the mapped strings —
  ;; the `strings` benchmark's full fusion would need a string-builder reducer
  ;; (a follow-up); today join over a view matches the old eager-`map` behaviour.
  (let (coll (if (seqview? coll) (seq coll) coll))
    (if (string? sep)
      (%string-join sep coll)
      (if (empty? coll)
        ""
        (apply str (cons (first coll) (reverse (join--parts sep (rest coll) nil))))))))

;; `string-split` is now a native builtin (crates/lisp/src/builtins.rs) — one O(n)
;; pass via Rust's `str::split`. The former pure-Brood version re-`substring`ed the
;; tail each step, which is O(n²) (char-indexed substring is O(index)); a 174 KB
;; `git ls-files` output took ~840 ms in the editor's project scan, now ~10 ms.

(defn replace (s old new)
  "Return `s` with every occurrence of `old` replaced by `new`. An empty `old`
leaves `s` unchanged."
  (if (= old "") s (join new (string-split s old))))

(defn string--whitespace? (c) (or (= c " ") (= c "\t") (= c "\n") (= c "\r")))

(defn blank? (s)
  "Is `s` empty or made up only of whitespace?"
  (let (n (string-length s))
    (cond (= n 0) true (string--whitespace? (char-at s 0)) (blank? (substring s 1 n)) else false)))

(defn triml--from (s i n)
  (if (and (< i n) (string--whitespace? (char-at s i))) (triml--from s (inc i) n) (substring s i n)))
(defn triml (s) "Remove leading whitespace from `s`." (triml--from s 0 (string-length s)))

(defn trimr--to (s n)
  (if (and (> n 0) (string--whitespace? (char-at s (dec n))))
    (trimr--to s (dec n))
    (substring s 0 n)))
(defn trimr (s) "Remove trailing whitespace from `s`." (trimr--to s (string-length s)))

(defn trim (s) "Remove leading and trailing whitespace from `s`." (triml (trimr s)))

;; ---- string padding & repetition --------------------------------------------
;; Column formatting for tabular/console output. `pad-*` left unchanged when the
;; string already meets the width (they never truncate).
(defn string-repeat (s n)
  "The string `s` concatenated `n` times (the empty string if `n` <= 0)."
  (apply str (repeat n s)))

(defn pad-left (s w &optional (pad " "))
  "Right-justify `s` in a field of width `w`, padding with `pad` (a single-character string, a space by default) on the left; `s` is returned unchanged if it is already at least `w` wide."
  (let (n (string-length s)) (if (>= n w) s (str (string-repeat pad (- w n)) s))))

(defn pad-right (s w &optional (pad " "))
  "Left-justify `s` in a field of width `w`, padding with `pad` (a single-character string, a space by default) on the right; `s` is returned unchanged if it is already at least `w` wide."
  (let (n (string-length s)) (if (>= n w) s (str s (string-repeat pad (- w n))))))

;; ---- string interpolation ---------------------------------------------------
;; `(fmt "…{expr}…")` builds a string from a template, splicing the value of each
;; `{expr}` hole — any Brood expression, read at macro-expansion time — between the
;; literal chunks. `{{` / `}}` are literal braces; braces *inside* a hole nest, so
;; `{ {:a 1} }` reads a map. It expands to a plain `(str chunk expr …)`, so there is
;; zero runtime machinery — it is exactly the hand-written `str` call, minus the
;; quote-chopping. Reach for it wherever a message interleaves text and values:
;; `(error (fmt "json: bad number '{tok}' at index {i}"))`.
(defn fmt--flush (buf parts)
  ;; push the accumulated literal chunk (reversed chars) onto `parts`, if non-empty
  (if (empty? buf) parts (cons (apply str (reverse buf)) parts)))
(defn fmt--hole (chars expr depth parts)
  ;; inside a {…} hole: accumulate the expression text until the matching `}`, then
  ;; `read-string` it into a form. Braces nest by `depth` (a map/set literal inside).
  (cond
    (empty? chars) (error "fmt: unterminated '{' in template")
    (and (= (first chars) "}") (= depth 0)) (fmt--lit (rest chars)
                                              nil (cons (read-string expr) parts))
    (= (first chars) "{") (fmt--hole (rest chars) (str expr "{") (inc depth) parts)
    (= (first chars) "}") (fmt--hole (rest chars) (str expr "}") (dec depth) parts)
    else (fmt--hole (rest chars) (str expr (first chars)) depth parts)))
(defn fmt--lit (chars buf parts)
  ;; scanning literal text: `buf` = reversed literal chars, `parts` = reversed forms
  (cond
    (empty? chars) (reverse (fmt--flush buf parts))
    (and (= (first chars) "{") (= (second chars) "{")) (fmt--lit (rest (rest chars))
                                                         (cons "{" buf) parts)
    (and (= (first chars) "}") (= (second chars) "}")) (fmt--lit (rest (rest chars))
                                                         (cons "}" buf) parts)
    (= (first chars) "{") (fmt--hole (rest chars) "" 0 (fmt--flush buf parts))
    else (fmt--lit (rest chars) (cons (first chars) buf) parts)))
(defmacro fmt (template)
  "Build a string from a template, splicing each `{expr}` hole's value between the literal text: `(fmt \"x={x} sum={(+ a b)}\")`. `{{`/`}}` are literal braces; braces nest inside a hole. Expands to a plain `(str …)`."
  (if (string? template)
    (cons 'str (fmt--lit (string->list template) nil nil))
    (error "fmt: template must be a string literal, got " (pr-str template))))

;; ---- string formatting ------------------------------------------------------
;; A small `printf`-style helper for inline rendering. The supported specifiers
;; are a deliberate subset — the common cases for demos and tooling output:
;;   %s    any value, rendered via `str`
;;   %d    integer (any number; the type tag is a hint for the reader, not a
;;         converter — float in / float out, same as %s)
;;   %f    float with 6 fractional digits (matches the C/Java default)
;;   %.Nf  float with N fractional digits, rounded — uses `to-fixed`
;;   %%    a literal `%`
;; Width / justification aren't built in — `pad-left` / `pad-right` cover those
;; explicitly. Hex/octal/etc. aren't here; add them on demand. Errors on an
;; unknown spec or a format string that ends inside one; a missing arg renders
;; as `nil` (debuggable), extra args are ignored.
(defn format (fmt & args)
  "Render `fmt`, replacing each %-specifier with the next of `args`. Supports `%s` `%d` `%f` `%.Nf` `%%`; use `pad-left`/`pad-right` for width."
  (format--loop fmt 0 (string-length fmt) args ""))

(defn format--loop (fmt i n args acc)
  (cond
    (>= i n) acc
    (= (char-at fmt i) "%") (format--spec fmt (inc i) n args acc)
    else (format--loop fmt (inc i) n args (str acc (char-at fmt i)))))

(defn format--spec (fmt i n args acc)
  ;; called with `i` pointing one past the `%`
  (cond
    (>= i n) (error "format: unterminated specifier (lone '%' at end of format string)")
    (= (char-at fmt i) "%") (format--loop fmt (inc i) n args (str acc "%"))
    (= (char-at fmt i) "s") (format--loop fmt (inc i) n (rest args) (str acc (str (first args))))
    (= (char-at fmt i) "d") (format--loop fmt (inc i) n (rest args) (str acc (str (first args))))
    (= (char-at fmt i) "f") (format--loop fmt
                              (inc i) n (rest args) (str acc (to-fixed (first args) 6)))
    (= (char-at fmt i) ".") (format--prec fmt (inc i) n args acc 0)
    else (error (str "format: unrecognized specifier '%" (char-at fmt i) "' at column " i))))

(defn format--prec (fmt i n args acc p)
  ;; called with `i` pointing one past the `.`, accumulating precision in `p`
  (cond
    (>= i n) (error "format: unterminated %.Nf specifier")
    (= (char-at fmt i) "f") (format--loop fmt
                              (inc i) n (rest args) (str acc (to-fixed (first args) p)))
    else (let (d (string->number (char-at fmt i)))
           (if (and (int? d) (>= d 0) (<= d 9))
             (format--prec fmt (inc i) n args acc (+ (* p 10) d))
             (error (str "format: expected digit or 'f' after '.' in specifier, got '"
                      (char-at fmt i) "' at column " i))))))

;; ---- strings & paths --------------------------------------------------------
;; Helpers over `substring` (char-indexed, like `string-length`). Generic enough
;; to live in core; the module system and the project tooling build on them.
(defn starts-with? (s prefix)
  "Does string `s` begin with `prefix`?"
  (let (n (string-length prefix)) (and (>= (string-length s) n) (= (substring s 0 n) prefix))))

(defn ends-with? (s suffix)
  "Does string `s` end with `suffix`?"
  (let (sl (string-length s) ql (string-length suffix))
    (and (>= sl ql) (= (substring s (- sl ql) sl) suffix))))

;; The bootstrap `path-*` subset (path-join/path-basename/path-absolute/parent-dir):
;; the minimal path ops tooling needs *before* any module can be required. The full
;; path library is `std/path.blsp` (`path/dirname`/`normalize`/`relative-to`/…) — a
;; deliberate layer on top, with its own (slightly different) contracts. Not a dup.
;;
;; Index of the last `/` in `s`, scanning down from `i`, or -1 if none. (Brood has
;; no char accessor yet; paths are short, so a substring scan is fine.)
(defn path--last-slash (s i)
  (cond (< i 0) -1 (= (substring s i (inc i)) "/") i else (path--last-slash s (dec i))))

;; The directory containing `path`: "/a/b/c" -> "/a/b", "/foo" -> "/", "rel" -> ".".
;; A path that is its own parent ("/" or ".") is the fixed point a walk-up stops at.
(defn parent-dir (path)
  "The directory containing `path` (\"/a/b/c\" -> \"/a/b\", \"/foo\" -> \"/\", \"rel\" -> \".\")."
  (let (i (path--last-slash path (dec (string-length path))))
    (cond (< i 0) "." (= i 0) "/" else (substring path 0 i))))

(defn path-join (a b)
  "Join path segments `a` and `b` with a single `/` separator."
  (if (ends-with? a "/") (str a b) (str a "/" b)))

(defn path-basename (path)
  "The final component of `path` (\"/a/b/c\" -> \"c\", \"/foo\" -> \"foo\",
\"foo\" -> \"foo\"). The empty string returns itself; a trailing slash isn't
stripped (`(cwd)` doesn't produce one, which is the primary caller)."
  (let (n (string-length path))
    (if (= n 0)
      ""
      (let (i (path--last-slash path (dec n)))
        (if (< i 0) path (substring path (inc i) n))))))

(defn path-absolute (path &optional base)
  "Resolve `path` to an absolute path: a `/`-rooted path is returned unchanged, a
`~`/`~/…` path is expanded against `$HOME`, and any other (relative) path is joined
onto `base` (default the current directory, `(cwd)`). The empty string is returned as
is. Makes a path absolute, not canonical — it does not collapse `.`/`..` segments."
  (cond
    (or (= path "") (starts-with? path "/")) path
    (= path "~") (or (getenv "HOME") path)
    (starts-with? path "~/") (str (or (getenv "HOME") "~") (substring path 1 (string-length path)))
    else (path-join (or base (cwd)) path)))

;; ---- pseudo-random numbers (xorshift32, pure & seedable) --------------------
;; Brood has no global mutable state, so randomness is *threaded*: every step
;; takes a seed and returns `[value next-seed]`. Pass `next-seed` to the next
;; call; thread the seed through your loop state exactly like any other value.
;; Seed a fresh stream from any integer (e.g. `(now)`) via `rand-seed`.
;;
;; The generator is Marsaglia's xorshift32 — fast and good enough for
;; simulations, sampling, shuffling, jitter, and ids; NOT for cryptography. Each
;; left shift can exceed 32 bits, so we mask back to 32 bits with `*rand-mask*`,
;; which also keeps every intermediate well within i64 (no overflow).

; 2^32 - 1
(def *rand-mask* 4294967295)
(defn rand-seed (n)
  "Normalize integer `n` into a valid nonzero 32-bit PRNG seed (xorshift32 cannot start from 0)."
  (let (m (bit-and n *rand-mask*))
    (if (= m 0) 2463534242 m)))

(defn rand--step (state)
  ;; One xorshift32 transition over a nonzero 32-bit `state`.
  (let (x (bit-and (bit-xor state (bit-shift-left state 13)) *rand-mask*)
        x (bit-xor x (bit-shift-right x 17))
        x (bit-and (bit-xor x (bit-shift-left x 5)) *rand-mask*))
    x))

(defn rng (seed)
  "Step the PRNG: returns `[value next-seed]`, where `value` is a pseudo-random non-negative 32-bit integer and `next-seed` feeds the next call. `seed` is any integer (normalized via `rand-seed`)."
  (let (s (rand--step (rand-seed seed)))
    [s s]))

(defn rand-int (seed n)
  "Returns `[i next-seed]` with `i` a pseudo-random integer in `[0, n)`. `n` must be positive."
  (if (<= n 0)
    (error "rand-int: bound must be positive: " n)
    (let (s (rand--step (rand-seed seed)))
      [(rem s n) s])))

(defn rand-float (seed)
  "Returns `[f next-seed]` with `f` a pseudo-random float in `[0.0, 1.0)`."
  (let (s (rand--step (rand-seed seed)))
    [(/ s 4294967296.0) s]))

(defn sample (seed coll)
  "Returns `[item next-seed]`: one uniformly random element of non-empty `coll` (list, vector, or a map read as its `[k v]` entries)."
  (let (items (into [] coll)
        n (count items))
    (if (= n 0)
      (error "sample: cannot sample from an empty collection")
      (let (s (rand--step (rand-seed seed)))
        [(nth items (rem s n)) s]))))

(defn shuffle--acc (state remaining acc)
  (if (= (count remaining) 0)
    [acc state]
    (let (s (rand--step state)
          i (rem s (count remaining)))
      (shuffle--acc s
        (append (take i remaining) (drop (inc i) remaining)) (cons (nth remaining i) acc)))))

(defn shuffle (seed coll)
  "Returns `[shuffled next-seed]`: the items of `coll` as a list in uniformly random order (Fisher–Yates)."
  (shuffle--acc (rand-seed seed) (into [] coll) nil))

;; ---- bounded printing -------------------------------------------------------
;; `pr-str` is *faithful*: whatever it returns reads back as the same value, so it
;; can never elide anything. That's the right contract for serialization and the
;; wrong one for a screen — one 100k-element list at a REPL prompt scrolls your
;; session away, and there is no way to ask for less.
;;
;; So bounding is a SEPARATE function rather than a flag on `pr-str`: nothing that
;; round-trips data can accidentally acquire an eliding printer, and `pr-str`
;; remains the escape hatch for seeing everything (`(pr-str *1)` after a truncated
;; result). The two knobs are `defdyn`s, so they are ambient (usable bare from any
;; namespace) and scopable with `binding`.
;;
;; Both markers are `…`, meaning "elided here" — for length as a trailing item, for
;; depth in place of the subform. Deliberately ONE marker rather than Clojure's
;; `…`/`#` pair: two symbols for one concept is a thing to learn for no gain, and a
;; bare `#` would read as the start of a `#{…}` set to anything re-lexing the output
;; (the REPL's result highlighter does exactly that).
;;
;; Only *containers* are traversed; every leaf and every value this doesn't know
;; about (records with an `impl Display`, ropes, tables, functions) is handed to
;; `pr-str` unchanged, so custom printing keeps working and this stays small.

(defdyn *print-length* 100)
(defdyn *print-level* 8)

(defn pr--elide (parts over)
  "`parts` joined for display, with the `…` length marker appended when `over`."
  (join " " (if over (append parts (list "…")) parts)))

(defn pr--limit (items)
  "`[shown over?]` for `items` under `*print-length*` — at most that many items,
plus whether any were dropped. Takes one extra item to detect the overflow, so a
long collection is never walked past the limit."
  (let (lim *print-length*)
    (if (nil? lim)
      [items false]
      (let (taken (take (inc lim) items)
            over (> (count taken) lim))
        [(if over (take lim taken) taken) over]))))

(defn pr--safely (thunk x)
  "Run `thunk`, falling back to `(pr-str x)` if it raises. The guard for a value
that looks like a container but doesn't walk like one — an improper/dotted pair
such as `(cons 1 2)` is the real case. Per-node, so one odd subtree degrades to
faithful printing instead of losing the bound on the whole value."
  (try (thunk) (catch _ (pr-str x))))

(defn pr--bounded-seq (x level open close)
  (let ([shown over] (pr--limit x))
    (str open (pr--elide (map (fn (i) (pr--bounded i (inc level))) shown) over) close)))

(defn pr--bounded-map (x level)
  (let ([shown over] (pr--limit (map-pairs x)))
    (str "{"
      (pr--elide (map (fn ([k v])
                        (str (pr--bounded k (inc level)) " " (pr--bounded v (inc level))))
                   shown)
        over)
      "}")))

(defn pr--bounded (x level)
  "`x` printed at nesting `level`, honouring both bounds. Containers recurse;
anything else goes to `pr-str`.

The depth bound is tested on *entering a container*, never on a leaf — so
`*print-level*` 2 on `{:a {:b {:c 1}}}` elides the whole third map (`{:a {:b …}}`)
rather than each of its keys and values separately (`{:a {:b {… …}}}`). A leaf always
prints: eliding an atom would cost a character and save nothing."
  (let (t (type-of x)
        container (or (= t :pair) (= t :vector) (= t :set) (= t :map)))
    (cond
      (and container *print-level* (>= level *print-level*)) "…"
      (= t :pair) (pr--safely (fn () (pr--bounded-seq x level "(" ")")) x)
      (= t :vector) (pr--safely (fn () (pr--bounded-seq x level "[" "]")) x)
      (= t :set) (pr--safely (fn () (pr--bounded-seq x level "#{" "}")) x)
      (= t :map) (pr--safely (fn () (pr--bounded-map x level)) x)
      else (pr-str x))))

(defn pr-str-bounded (x)
  "Like `pr-str`, but eliding with `…` past `*print-length*` items per collection
and `*print-level*` levels of nesting (`nil` for either means no limit). For
*display* — the result does not read back, so use `pr-str` when you need the whole
value. This is what the REPL prints results with."
  (pr--bounded x 0))

;; ---- discovery / introspection ----------------------------------------------
;; "What's in this image, and where?" — name- and doc-based search over the flat
;; global table, on top of the `global-names`/`doc` primitives. The first thing
;; to reach for when exploring rather than guessing names one at a time.

(defn apropos (pattern)
  "Every global whose name contains `pattern` (a string, symbol, or keyword), as a sorted list of symbols — e.g. `(apropos \"rand\")`."
  ;; `name` (not `str`) so a keyword pattern drops its leading colon, matching
  ;; the bare global names; a string passes through unchanged.
  (let (needle (if (string? pattern) pattern (name pattern)))
    (filter (fn (s) (includes? (name s) needle)) (global-names))))

;; Whitespace-split a query into lowercased terms (blanks dropped) — the unit
;; doc-search ranks by. A single-word query yields one term, so it degrades to
;; the old "docstring contains this word" search.
(defn doc-search--terms (query)
  "Lowercased, whitespace-separated terms of `query`, with blanks removed."
  (filter (fn (t) (not (blank? t))) (string-split (lower query) " ")))

(defn doc-search (query)
  "Globals whose name or docstring matches `query`, ranked by how many of its
whitespace-separated terms they contain (case-insensitive substring) — most
matches first, ties broken by name. A list of `[name doc]` pairs. Searches
behaviour, not just names: `(doc-search \"node up down\")` finds `monitor-node`
even when no single docstring holds that exact phrase. A single-word query
degrades to a plain case-insensitive name/docstring search, e.g.
`(doc-search \"random\")`."
  (let (terms (doc-search--terms query))
    (when (not (empty? terms))
      (map (fn (e) [(second e) (nth e 2)])
        (sort-by (fn (e) [(- (first e)) (str (second e))])
          (keep (fn (s)
                  (let (d (try (doc (eval s)) (catch _ nil)))
                    (when (string? d)
                      (let (hay (lower (str s " " d))
                            hits (count (filter (fn (t) (includes? hay t)) terms)))
                        (when (> hits 0) [hits s d])))))
            (global-names)))))))

;; ---- spy: homoiconic tree-tracing debug (ADR-173) ---------------------------
;; `(spy expr)` evaluates `expr`, traces every evaluated subexpression's value in
;; evaluation order, and returns the value UNCHANGED — so it is referentially
;; transparent: wrap or unwrap `spy` around any form with zero behavioural change
;; (the Elixir `dbg` property). Unlike `dbg`, which special-cases a fixed handful
;; of constructs, `spy` leans on homoiconicity: it fully macroexpands the form
;; (re-expanding at every node, since `macroexpand` only resolves the outer head)
;; and instruments each evaluated position IN PLACE, so laziness is preserved —
;; an untaken `if` branch or a short-circuited `and` tail never traces. A pipeline
;; needs no special case: `(-> x f g)` expands to `(g (f x))`, and the ordinary
;; call rule traces each stage for free. Trace entries flow through the swappable
;; `*spy-sink*`, so a host (the editor, the observer) can capture the trace as
;; DATA rather than text; the default sink pretty-prints an indented tree to
;; stderr. `fn` bodies, `quote`, and `quasiquote` are left opaque (a closure body
;; runs later/elsewhere, quoted data never evaluates).

;; The sink `spy` routes trace entries to (a 1-arg fn), or nil for the default
;; stderr tree. Entries are maps: `{:spy :enter :form f}`,
;; `{:spy :node :form f :value v :depth d}`, `{:spy :exit :value v}`. Rebind it
;; (via `binding`) to capture a trace as data.
(defdyn *spy-sink* nil)

(defn spy--indent (depth) (apply str (map (constantly "  ") (range depth))))
(defn spy--default-sink (entry)
  "Default `*spy-sink*`: pretty-print one trace entry as an indented stderr line.
`:call`/`:return` are the function-boundary entries `debug/trace-fn` emits."
  (case (:spy entry)
    :enter (eprintln (str "spy: " (pr-str (:form entry))))
    :node (eprintln (str "  "
                      (spy--indent (:depth entry)) (pr-str (:form entry)) " => "
                      (pr-str (:value entry))))
    :exit (eprintln (str "=> " (pr-str (:value entry))))
    :call (eprintln (str "trace: " (pr-str (cons (:fn entry) (:args entry)))))
    :return (eprintln (str "trace: " (pr-str (:fn entry)) " => " (pr-str (:value entry))))
    nil))
(defn spy--emit (entry) ((or *spy-sink* spy--default-sink) entry))
(defn spy--node (form value depth)
  ;; Runtime: emit a traced node's value, then return it untouched.
  (spy--emit {:spy :node :form form :value value :depth depth})
  value)
(defn spy--run (form thunk)
  (spy--emit {:spy :enter :form form})
  (let (value (thunk)) (spy--emit {:spy :exit :value value}) value))

;; Core forms whose heads must NOT be treated as function calls (their arguments
;; are not plain eager operands). After a full macroexpand only these survive; the
;; macro entries are belt-and-suspenders in case one reaches a node unexpanded.
(def spy--special-forms
  #{'if 'do
    'def 'fn 'let 'letrec 'quote 'quasiquote 'defmacro 'defn 'defdyn 'defrecord 'defmodule 'when
    'unless 'cond 'and 'or 'match 'match* 'case 'comment 'try 'catch 'throw 'receive 'binding
    'dolist 'doseq 'dotimes 'for '-> '->> 'spawn 'spawn-link 'remote-spawn 'remote-spawn-sync 'error
    'with-out-str 'with-err-str 'bench})

(defn spy--walk-seq (forms depth) (map (fn (form) (spy--walk form depth)) forms))
(defn spy--walk-binds (binds depth)
  ;; A flat `(name expr …)` binding list — instrument the RHS positions only.
  (letrec (go (fn (bs acc)
                (cond
                  (empty? bs) (reverse acc)
                  (empty? (rest bs)) (reverse (cons (first bs) acc))
                  else (go (rest (rest bs))
                         (cons (spy--walk (second bs) depth) (cons (first bs) acc))))))
    (go binds ())))
(defn spy--walk-if (form depth)
  ;; Instrument test + both branches in place; the branches stay lazy, so only the
  ;; taken one ever traces.
  (let (parts (rest form) test (first parts) then (second parts) d (inc depth))
    (if (> (count parts) 2)
      `(if ~(spy--walk test d) ~(spy--walk then d) ~(spy--walk (nth parts 2) d))
      `(if ~(spy--walk test d) ~(spy--walk then d)))))
(defn spy--walk-let (form depth)
  (let (head (first form) binds (second form) body (rest (rest form)) d (inc depth))
    `(~head ~(spy--walk-binds binds d) ~@(spy--walk-seq body d))))
(defn spy--walk-call (form depth)
  ;; (f a…) — every operand is eager, unconditional, once; instrument them all and
  ;; trace this call node's value.
  `(spy--node '~form (~@(spy--walk-seq form (inc depth))) ~depth))
(defn spy--walk (form depth)
  (if (not (pair? form))
    form
    (let (form (macroexpand form))
      ; resolve the (outer) macro head
      (if (not (pair? form))
        ; a macro expanded to an atom
        (spy--walk form depth)
        (let (head (first form))
          (cond
            (or (= head 'fn) (= head 'quote) (= head 'quasiquote)) form
            (= head 'if) (spy--walk-if form depth)
            (= head 'do) `(do ~@(spy--walk-seq (rest form) (inc depth)))
            (or (= head 'let) (= head 'letrec)) (spy--walk-let form depth)
            (contains? spy--special-forms head) `(spy--node '~form ~form ~depth)
            else (spy--walk-call form depth)))))))

(defmacro spy (expr)
  "Evaluate `expr`, trace every evaluated subexpression's value (in evaluation order) to `*spy-sink*` — default: an indented tree on stderr — and return the value unchanged. Referentially transparent: wrap or drop `spy` around any form with no behavioural change. Homoiconic: fully macroexpands and instruments in place, so laziness (an untaken branch, a short-circuited `and`) is preserved and pipelines trace stage-by-stage for free. `fn` bodies and quoted data are left opaque."
  `(spy--run '~expr (fn () ~(spy--walk expr 0))))

;; ---- modules: Emacs-flat provide / require (ADR-019) ------------------------
;; A flat module system over the one shared global table: `provide` records a
;; loaded feature, `require` loads one once. Embedded std modules (test, project)
;; are baked into the binary and found via `%builtin-module`; everything else is
;; searched for on `*load-path*` as `<name>.blsp`. This is policy — Rust supplies
;; only the filesystem + embedded-source mechanism (ADR-006/008).
(def *features* nil)
; names (strings) of features already loaded
(def *load-path* (list "."))
; directories searched for <name>.blsp

;; `*load-path*` lives in the ROOT namespace, so only root code can rebind it: a
;; `(def *load-path* …)` written inside a module defines `mod/*load-path*` (ambient
;; is a declaration now, not an earmuff spelling — see `defdyn`). These two setters
;; are that root code, so project tooling and tests can extend the path from any
;; namespace without the loader losing track of it.
(defn set-load-path! (dirs)
  "Replace the module search path with `dirs` (a list of directory strings); returns it."
  (def *load-path* dirs)
  *load-path*)
(defn add-load-path! (& dirs)
  "Prepend `dirs` to the module search path (skipping any already present); returns the new path."
  (set-load-path! (append (remove (fn (d) (member? d *load-path*)) dirs) *load-path*)))
(def *features-loading* {})
; feature key → loader pid for loads IN FLIGHT. Set before a load begins so (a) a
; CIRCULAR require inside that same load returns immediately (the contract
; `defmodule`'s top-of-file provide used to supply), and (b) a CONCURRENT require
; from another process WAITS for the load to finish instead of returning while the
; module is half-evaluated — the partial-load race: `require` returned, the caller
; called `mod/fn`, unbound. (Surfaced as a once-in-several-runs editor test flake
; the moment two test processes raced an inline `(require 'proctree)`.)

;; (provide 'foo) — mark a feature loaded (idempotent). Returns its name.
(defn provide (mod)
  "Mark feature `mod` (a symbol or string) as loaded (idempotent); returns its name."
  (let (key (name mod))
    (unless (member? key *features*) (def *features* (cons key *features*)))
    key))

;; A module declares itself at the top with `defmodule`: its name, an optional
;; docstring, and (implicitly) `provide`. The canonical module header — it replaces
;; the old bare-leading-string docstring *and* a trailing `(provide 'name)`.
(def *module-docs* {})
; module name (string) -> its docstring (or nil)

;; Called from `defmodule`'s expansion, which runs inside the *consumer's* module —
;; where a bare `(def *module-docs* …)` would define `mod/*module-docs*`. Defined
;; here at root, so the `def` below targets the one real registry.
(defn record-module-doc! (key doc)
  "Record `doc` as module `key`'s docstring (the registry `module-doc` reads); returns doc."
  (def *module-docs* (assoc *module-docs* key doc))
  doc)

;; The hot-reload `def` diagnostics switch. The kernel reads it by BARE name from
;; root (`eval::reload_diagnostics_on`), so it has to be ambient by declaration —
;; a plain `(def *reload-diagnostics* false)` inside a module would define
;; `mod/*reload-diagnostics*` and silence nothing. Declared here (default `true`,
;; matching the kernel's unbound-means-on) so any module or test can turn it off
;; for its own scope with an ordinary `def`.
(defdyn *reload-diagnostics* true)

;; ---- deprecation ------------------------------------------------------------
;; A deprecated construct keeps working but says so. `deprecation-warning` is the
;; primitive: print a message to stderr ONCE per key (so a re-required module or a
;; hot loop doesn't spam), then stay silent. A macro calls it from its expansion
;; when it lowers a deprecated form.
(def *deprecation-seen* nil)
(defn deprecation-warning (key message)
  "Print `message` to stderr once per `key` (deduplicated); returns nil. The
deprecation primitive — emit it from a macro's expansion to flag a deprecated use."
  (unless (member? key *deprecation-seen*)
    (def *deprecation-seen* (cons key *deprecation-seen*))
    (eprintln "deprecation: " message))
  nil)

;; The `(require …)`+`(%refer …)` forms for one `(:use mod [:only [a b]])` clause:
;; load the module, then import its names. `:only [a b]` imports just those; with no
;; marker, all of `mod`'s public (non-`--`) names. `:only` is the *sole* import
;; filter — any other marker is a clean error (ADR-152: name the fix, don't
;; silently import everything). Used at `defmodule` expand time.
(defn defmodule--use-clause (clause)
  (let (mod (second clause)
        opts (rest (rest clause))
        marker (first opts))
    (when (and marker (not (= marker :only)))
      (error "defmodule: unknown (:use "
        mod " " marker " …) marker — the only import " "filter is :only, as `(:use " mod
        " :only [a b])`"))
    (let (subset (if (= marker :only) (second opts) nil))
      (list (list 'require (list 'quote mod))
        (list '%refer (list 'quote mod) (list 'quote subset))))))

;; All require/refer forms for the `(:use …)` clauses in a `defmodule` header
;; (skipping the optional docstring / any non-`:use` form), flattened for splicing.
(defn defmodule--use-forms (clauses)
  (apply append
    (map defmodule--use-clause
      (filter (fn (c) (and (pair? c) (= (first c) :use))) clauses))))

;; The forms for one `(:use-internals mod)` clause — module privacy's @testable
;; seam (ADR-146): like `(:use mod)` (load + refer publics), PLUS a grant that
;; lets this file reference `mod`'s module-private `--` names by qualified
;; name, which is otherwise a compile error. For tests and tightly-coupled
;; tooling; loud and greppable by design.
(defn defmodule--internals-clause (clause)
  (let (mod (second clause))
    (list (list 'require (list 'quote mod))
      (list '%refer (list 'quote mod) nil) (list '%grant-internals (list 'quote mod)))))

(defn defmodule--internals-forms (clauses)
  (apply append
    (map defmodule--internals-clause
      (filter (fn (c) (and (pair? c) (= (first c) :use-internals))) clauses))))

;; web/views/counter → counter  (a module name's last `/`-segment, as a symbol).
(defn defmodule--last-segment (mod)
  (symbol (last (string-split (name mod) "/"))))

;; The `(require …)`+`(%alias …)` forms for one `(:alias mod [:as short])` clause:
;; load the module, then register a prefix alias so a later `short/name` resolves to
;; `mod/name` (Elixir-style `alias`). `short` defaults to `mod`'s last path segment;
;; `:as` overrides it (needed when two modules share a last segment).
(defn defmodule--alias-clause (clause)
  (let (mod (second clause)
        opts (rest (rest clause))
        short (if (= (first opts) :as) (second opts) (defmodule--last-segment mod)))
    (list (list 'require (list 'quote mod))
      (list '%alias (list 'quote mod) (list 'quote short)))))

(defn defmodule--alias-forms (clauses)
  (apply append
    (map defmodule--alias-clause
      (filter (fn (c) (and (pair? c) (= (first c) :alias))) clauses))))

;; A file declares itself a **module = namespace** at the top with `defmodule`
;; (ADR-065): each `def`/`defn`/`defmacro` defines `mod/name`, and a bare reference
;; resolves to `mod/name` if this namespace defines it, then through a `(:use …)`
;; import, then falls back to root (the prelude). It also records an optional
;; docstring and `provide`s the feature (the load-once key). A `(:use bar)` clause
;; refers `bar`'s public names bare; `(:use baz :only [a b])` refers just `a`/`b`.
;; Put it first; one per file. e.g. (defmodule observer "process viewer" (:use display)).
;; defmodule's top-of-file provide — but ONLY when no `require` is driving the load.
;; Under require, the feature is provided when the WHOLE file has evaluated
;; (require--force); providing here, before the module's defs exist, is exactly the
;; window a concurrent requirer used to slip through. A direct `(load "x.blsp")`
;; (no require in flight) keeps the immediate provide it always had.
(defn defmodule--provide (key)
  (if (contains? *features-loading* key) key (provide key)))

;; The only clauses the header understands. Anything else in a `defmodule` header
;; used to be silently IGNORED — so a misspelled `(:use-internal m)` or a
;; Clojure-style `(:require m)` looked like it imported names / granted access and
;; did nothing at all. That is the worst failure mode for a header that governs
;; imports *and* privacy, so an unrecognised form is now a hard error.
;; `:implements` is a CHECKER annotation, not a loader one: a module claiming a protocol
;; is verified by `crates/lisp/src/types/check/protocol.rs`, which reads the clause
;; straight out of the header source. The loader's job is only to tolerate it. It was
;; missing from this list, so tightening the header (above) turned every
;; protocol-implementing module into a load error — found by a downstream app whose
;; whole test suite stopped loading.
(def defmodule--clause-heads [:use :use-internals :alias :implements])

(defn defmodule--check-clause (clause)
  (if (and (pair? clause)
        (keyword? (first clause)) (includes? defmodule--clause-heads (first clause)))
    clause
    (error "defmodule: unrecognised header form "
      (pr-str clause) " — a `defmodule` header takes only (:use mod [:only [names]]),"
      " (:use-internals mod), (:alias mod [:as short]), and (:implements Protocol)."
      " Check the spelling;"
      " Clojure's `(:require …)` is not a Brood clause (`:use` both loads and refers).")))

(defmacro defmodule (mod & more)
  "Declare module/namespace `mod` and compile the rest of the file into it —
definitions become `mod/name`; bare references resolve there, then through
`(:use …)` imports, then root. Records an optional docstring and `provide`s the
feature. Put it first. e.g. (defmodule proc/gen \"A gen_server …\")."
  (let (key (name mod)
        doc (if (string? (first more)) (first more) nil)
        clauses (if (string? (first more)) (rest more) more)
        _checked (map defmodule--check-clause clauses))
    `(do
       (record-module-doc! ~key ~doc)
       (defmodule--provide ~key)
       (%in-ns '~mod)
       ~@(defmodule--use-forms clauses)
       ~@(defmodule--internals-forms clauses)
       ~@(defmodule--alias-forms clauses))))

(defn module-doc (mod)
  "The docstring declared by `(defmodule mod …)` (a symbol or string), or nil."
  (get *module-docs* (name mod)))

;; First existing <filename> across the load-path dirs, or nil.
(defn require--find (filename dirs)
  (cond
    (empty? dirs) nil
    (file-exists? (path-join (first dirs) filename)) (path-join (first dirs) filename)
    else (require--find filename (rest dirs))))

;; The raw load of feature `key`: evaluate its embedded source (a baked-in std
;; module) or the first <key>.blsp found on *load-path*, then record it. No
;; loading-bookkeeping — callers manage *features-loading*. Errors if not found.
(defn require--force (key)
  (let (src (%builtin-module key))
    (if src
      ;; Attribute the baked-in source to the file it was WRITTEN in, not to whichever
      ;; file happened to be mid-load when the `require` ran. The path comes from the
      ;; same literal the source was baked in from, so it can't drift.
      ;; `%load-module-source`, not `%load-string`: a baked-in std module's own defs
      ;; are allowed to bind reserved names and BECOME reserved (ADR-166). A project
      ;; file (the branch below) goes through the ordinary `load`, so a package's
      ;; names are never reserved.
      (do (%load-module-source src (%builtin-module-file key)) (provide key))
      (let (path (require--find (str key ".blsp") *load-path*))
        (if path
          (do (load path) (provide key))
          (error "require: cannot find module '" key "'"))))
    key))

;; Wait (5ms ticks, ~`n` of them) for another process's in-flight load of `key`;
;; if it never completes — the loader died or its load threw, leaving a stale
;; marker — take the load over ourselves (re-evaluating a module is idempotent:
;; same source, same defs). `sleep`, not a bare receive: waiting must not eat a
;; queued mailbox message.
(defn require--await (key n)
  (cond
    (member? key *features*) key
    (> n 0) (do (sleep 5) (require--await key (dec n)))
    else (require--force key)))

;; Load one feature once. CONCURRENT-SAFE: `require` returning means the module's
;; defs exist — a require that races another process's load of the same feature
;; waits for that load to complete rather than trusting a top-of-file provide
;; (the old partial-load race). A circular require inside one file's own load
;; still returns immediately (the loader pid matches).
(defn require-one (mod)
  "Load a single feature `mod` once (a no-op if already loaded); returns its name.
Safe under concurrency: never returns while another process is mid-load of `mod` —
it waits for that load to finish (a half-evaluated module is never observable)."
  (let (key (name mod))
    (cond
      (member? key *features*) key
      ;; OUR OWN in-flight load of `key` requiring it back (a :use cycle): proceed —
      ;; the classic load-once contract for circular requires
      (= (get *features-loading* key) (self)) key
      ;; someone else is mid-load: wait for their provide (never see a partial module)
      (contains? *features-loading* key) (require--await key 1000)
      else
      ;; Clear the in-flight marker on BOTH exits: a load that throws (module not
      ;; found, or an error inside its source) must not leave `key` marked, or
      ;; every later require of it stalls the full `require--await` window
      ;; (~5s of 5ms ticks) before taking the load over.
      (do
        (def *features-loading* (assoc *features-loading* key (self)))
        (try
          (require--force key)
          (catch e
            (do
              (def *features-loading* (dissoc *features-loading* key))
              (throw e))))
        (def *features-loading* (dissoc *features-loading* key))
        key))))

;; (require 'a 'b …) — load each feature once, left to right. Returns the names.
(defn require (& mods)
  "Load each feature once (a no-op for any already loaded); errors on one not
found. Returns the list of feature names. e.g. (require 'proc/gen 'test)."
  (map require-one mods))

;; ═══ Abilities + the Display protocol (core) ════════════════════════════════
;; Open generic functions with nominal dispatch — Brood's unified polymorphism seam
;; (ADR-168/172). Folded into the prelude (was std/ability.blsp + std/show.blsp) so
;; `defability`/`impl`/`defrecord` and the always-on `Display`/`Inspect` protocol are
;; core — no `(:use ability)`, no `(require 'show)`, no activation step. Dispatch is on
;; the FIRST arg's identity (a built-in's `type-of` kind, or a `defrecord` value's
;; nominal `module/name` id); resolution is by PRECEDENCE tier, not load order:
;; app > type-owner > ability-owner > other.

; ---- registries -------------------------------------------------------------

; ability-name → op specs (introspection / checker / LSP)
(def *abilities* {})
; ability-name → the namespace that `defability`'d it (its OWNER, ADR-172): one input to
; an impl's precedence tier — an impl from this ns is the ability-owner tier, and only this
; ns may impl the ability for a built-in id (`:int`, `:default`).
(def *ability-owner* {})
; [ability op] → {id → fn} (runtime dispatch — the fn stored directly, no wrapper)
(def *impls* {})
; [ability op id] → registering ns (provenance for conflict detection; read only at
; registration, never on dispatch — keeps the dispatch value a bare fn)
(def *impl-from* {})
; qualified-op-fn-symbol → the ability that declared it. An ability op becomes a global
; `defn` named after the op (qualified to the declaring ns), so two abilities in the SAME
; ns declaring the same op name would have the second silently clobber the first's op
; function. This registry lets `register-ability` warn on that collision instead of losing
; an op silently (ADR-172; the checker can't see a same-ns clobber either). Keyed by the
; QUALIFIED symbol (`<ns>/op` or bare `op` at root) so cross-module same-name ops — which
; get distinct globals and never clash — do not false-warn.
(def *op-ability* {})

(defn ability--qualify-op (owner op-name)
  "The global symbol an ability op's `defn` binds: `op-name` qualified to the declaring ns
  `owner` (`<owner>/op`), or bare `op-name` when `owner` is nil (root/REPL). Mirrors how the
  `defn` `defability` emits is namespaced at load, so `*op-ability*` keys on the real global."
  (if owner (symbol (str (name owner) "/" (name op-name))) op-name))

(defn register-ability (aname specs &optional owner)
  "Record ability `aname`'s declared op specs (raw forms) for the checker / LSP, and its
  OWNER namespace (`defability`'s defining ns, ADR-172) for impl precedence. Warns if an op
  name is already owned by a DIFFERENT ability in the same ns — that op's generic function
  would otherwise be silently clobbered (only the last-defined ability's op survives)."
  (def *abilities* (assoc *abilities* aname specs))
  (when owner (def *ability-owner* (assoc *ability-owner* aname owner)))
  ;; Record op-name ownership and warn on a same-ns cross-ability collision. A re-declaration
  ;; of the SAME ability (hot reload) re-registers its own ops — same owner → no warning.
  (for (spec specs)
    (when (pair? spec)
      (let (qsym (ability--qualify-op owner (first spec))
            prev (get *op-ability* qsym))
        ; Warn only when a real generic function is at stake: a DIFFERENT ability already
        ; owns this op name AND that name is bound (its `defability` emitted the `defn`, so a
        ; second `defability` of the same op name genuinely shadows it). A direct
        ; `register-ability` that never defines a generic fn (crafted precedence fixtures) is
        ; harmless and stays quiet.
        (when (and prev (not (= prev aname)) (bound? qsym))
          (println "warning: ability " aname " declares op `" (first spec)
            "` already owned by ability " prev
            " — its generic function will be shadowed (rename one op)"))
        (def *op-ability* (assoc *op-ability* qsym aname)))))
  nil)

(defn ability-owner-ns (aname)
  "The namespace that `defability`'d `aname` (its owner), or nil."
  (get *ability-owner* aname))

(defn ability-ops (aname)
  "The op specs declared for ability `aname` (or nil) — which ops an `impl` must
  provide, with what arities."
  (get *abilities* aname))

; ability-name → its `:derive-record` recipe (ADR-185): a fn `(fn (fields) …)` that, given
; a record's field-name symbols, returns a list of `impl` METHOD forms `((op (args…) body…)
; …)` for the ability's REQUIRED ops (provided ops come free). `defrecord`'s `:derives`
; clause calls it at EXPANSION and splices the result into an `(impl <ability> <record> …)`,
; so the derived methods are ordinary, statically-checkable impls. The per-ability recipe is
; the Elixir `@derive` / Rust `#[derive]` model: each ability decides how it derives itself.
(def *ability-derives* {})

(defn register-ability-derive (aname recipe)
  "Record ability `aname`'s `:derive-record` recipe (the fn `defrecord`'s `:derives` runs to
  synthesise a structural impl). Rebindable like any registry — a later `defability` wins."
  (def *ability-derives* (assoc *ability-derives* aname recipe))
  nil)

(defn ability-derive-recipe (aname)
  "Ability `aname`'s `:derive-record` recipe fn (fields → `impl` method forms), or nil when
  the ability declared none — i.e. it is not derivable, and `:derives [aname]` is an error."
  (get *ability-derives* aname))

; ability-name → its SEALED member ids (a closed set), or absent if open
(def *sealed* {})

(defn register-sealed (aname members)
  "Record ability `aname`'s SEALED member ids — the closed set of identities it is meant
  to be implemented for. The checker uses this for exhaustiveness: every member must have
  an impl of every declared op. Runtime dispatch is unaffected (sealing is a contract)."
  (def *sealed* (assoc *sealed* aname members))
  nil)

(defn sealed-members (aname)
  "The sealed member ids of ability `aname` (a list of keyword ids), or nil if open."
  (get *sealed* aname))

; ability-name → its REQUIRED (super-)abilities (ADR-193): a list of ability names that any id
; implementing this ability must ALSO implement. A declared conformance contract like `:sealed`
; — checker-only, advisory (late binding means it can't gate); runtime dispatch is unaffected.
(def *ability-requires* {})

(defn register-ability-requires (aname reqs)
  "Record that ability `aname` REQUIRES abilities `reqs` (a list of names) — an implementor of
  `aname` must also implement each of them (ADR-193). The checker enforces it."
  (def *ability-requires* (assoc *ability-requires* aname reqs))
  nil)

(defn ability-requires (aname)
  "The abilities `aname` requires (a list of names), or nil."
  (get *ability-requires* aname))

; ---- dispatch identity ------------------------------------------------------

(defn identity-of (x)
  "The dispatch identity of `x`: its nominal record id (a `module/name` keyword) if it
  is an identity-carrying record, else its `type-of` kind. This — with `record?` /
  `record-id` / `fields` — is the one seam a later kernel slot swaps behind; nothing
  outside this module reads `:__id__` directly."
  ; one hash on the hot path: `get` (not `contains?` + `get`). `:__id__` is a reserved
  ; keyword a record always carries and is never nil, so a present id is truthy.
  (if (map? x)
    (let (id (get x :__id__))
      (if id id (type-of x)))
    (type-of x)))

(defn record? (x)
  "True if `x` is an identity-carrying record (a `defrecord` value). Requires a
  *truthy* `:__id__` — matching `identity-of`, which treats a nil/false id as a plain
  map and dispatches on `type-of`. (A `defrecord` value always carries a truthy keyword
  id; the guard only matters for a hand-written `{:__id__ nil …}` literal, which must not
  be seen as a record by `record?`/`record-id`/`fields` while dispatching as `:map`.)"
  (if (and (map? x) (get x :__id__)) true false))

(defn record-id (x)
  "The nominal id (`module/name` keyword) of record `x`, or nil if `x` is not a record.
  Unlike `identity-of`, never falls back to `type-of`."
  (if (record? x) (get x :__id__) nil))

(defn fields (x)
  "The FIELDS of record `x` as a plain map — its identity omitted. The explicit id-free
  view; the default `Seqable` view a record's `seq`/`count`/`keys`/`map`/`fold` already
  give (so those don't leak `:__id__`). A plain map is returned unchanged."
  (if (record? x) (dissoc x :__id__) x))

; ---- registration -----------------------------------------------------------

; The owning module of a record id keyword `:mod/name` (as a string), or nil for a
; built-in id (`:int`, `:default` — no `/`). The record NAME is the final `/`-segment, so
; the module is everything BEFORE the last `/` — a nested module keeps all its segments
; (`:editor/display/frame` → `editor/display`, not `editor`). Used to place an impl in the
; tier ladder: an impl whose registering ns equals this owns the type.
(defn impl--id-owner (key)
  (if (keyword? key)
    (let (parts (string-split (name key) "/"))
      (if (> (count parts) 1)
        (join "/" (take (- (count parts) 1) parts))
        nil))
    nil))

; True if module `from` belongs to the current project's OWN package (ADR-172): its
; `*ns-package*` entry (set at project setup) equals `*project-name*`. Guarded with `bound?`
; so abilities still work when no project is loaded (a bare `brood script.blsp` — those
; ambients are undeclared then). Root/REPL (`from` = nil) is handled by the caller as the app.
(defn impl--app? (from)
  (and from
    (bound? '*project-name*) *project-name* (bound? '*ns-package*)
    (= (get *ns-package* from) *project-name*)))

(defn impl-rank (aname key from)
  ;; Precedence tier (ADR-172 §3), higher wins: **app (4) > type-owner (3) > ability-owner
  ;; (2) > other (1)**. `from` = nil is the root/REPL — the user IS the app, so app tier; a
  ;; module whose package is the project's own is likewise the app. Otherwise `from` owns the
  ;; record's type (id-owner) or the ability (its `:default`/built-in impls), else it's other.
  ;; Guard the nil/app cases before `(name from)`.
  (if (or (nil? from) (impl--app? from))
    4
    (let (from-name (name from)
          id-owner (impl--id-owner key)
          abl-owner (let (o (ability-owner-ns aname)) (if o (name o) nil)))
      (cond
        (= from-name id-owner) 3
        (= from-name abl-owner) 2
        else 1))))

(defn impl--fn-arity (f)
  "The impl fn `f`'s shape as `[fixed-count variadic?]` — the number of fixed params (before
  any `&`) and whether it takes a `&`-rest — read from `(arglist f)`."
  (let (params (arglist f)
        fixed (count (take-while (fn (s) (not (= s '&))) params)))
    [fixed (member? '& params)]))

(defn register-impl--check-arity (aname op f)
  "Warn if impl `f`'s arity is incompatible with `aname`'s declared `op` arity. Only runs
  when the ability is KNOWN (in `*abilities*`) — an impl registered before its `defability`
  (legal, ADR-172 late binding) simply isn't arity-checked here; the checker covers the rest.
  A fixed-arity impl must match exactly; a variadic impl must accept the declared arity."
  (let (specs (get *abilities* aname)
        op-spec (if specs (first (filter (fn (s) (= (first s) op)) specs)) nil)
        op-args (if op-spec (second op-spec) nil))
    ; Skip a variadic OP spec — it declares no single arity to pin against (matches the
    ; checker). Only a fixed op spec is arity-checked.
    (when (and op-spec (not (member? '& op-args)))
      (let (op-arity (count op-args)
            shape (impl--fn-arity f)
            fixed (nth shape 0)
            variadic (nth shape 1))
        (when (if variadic (> fixed op-arity) (not (= fixed op-arity)))
          (println "warning: ability " aname "/" op " expects " op-arity
            " arg(s), but this impl takes " (if variadic (str fixed "+") fixed)))))))

(defn register-impl (aname op key f from)
  "Register impl `f` of `aname`'s `op` for dispatch id `key`, tagged with the registering
  namespace `from`. Resolution is by PRECEDENCE, not load order (ADR-172 §3): the impl with
  the highest tier for a `(aname, op, key)` slot wins, computed by `impl-rank`, so the result
  is deterministic regardless of registration order. A same-tier re-register from a DIFFERENT
  `from` is a genuine cross-module conflict (warned; last wins); from the SAME `from` it is
  hot-reload (silent); a strictly lower-tier registration is ignored (a higher tier holds the
  slot). Read-modify-write of `*impls*` — register at load time, as top-level `impl` does."
  (register-impl--check-arity aname op f)
  (let (op-key [aname op]
        methods (or (get *impls* op-key) {})
        prov-key [aname op key]
        ; presence, not truthiness: a root/REPL/app incumbent records `from` = nil, so a
        ; nil `prev-from` is ambiguous between "no incumbent" and "incumbent was the app".
        ; Keying off `contains?` keeps a later lower tier from displacing an app impl.
        has-prev (contains? *impl-from* prov-key)
        prev-from (get *impl-from* prov-key)
        new-rank (impl-rank aname key from)
        ; recompute the incumbent's tier from its recorded `from` — no extra registry.
        old-rank (if has-prev (impl-rank aname key prev-from) 0))
    (when (and has-prev (= new-rank old-rank) (not (= prev-from from)))
      (println "warning: ability "
        aname "/" op " for " key " — same-tier impl from " prev-from " overridden by " from
        " (last wins)"))
    ; Store the winner only when the new impl's tier is >= the incumbent's — so a higher tier
    ; always holds the slot and order can't decide it. A strictly lower tier is dropped (its
    ; owner already has a stronger claim). The fn is stored DIRECTLY so dispatch (`impl-for`)
    ; stays a plain map-get; provenance in *impl-from* is read only here, never on dispatch.
    (when (>= new-rank old-rank)
      (register-impl--commit op-key key f prov-key from))
    nil))

;; Commit one registration under a lock (KI-22).
;;
;; `(def *impls* (assoc *impls* …))` is a read-modify-write of ONE shared global holding the
;; whole registry, so two processes registering at the same time each read the old map and
;; each write their own successor — the later write silently drops the earlier one's impl.
;; Measured before this: **218 of 500** concurrent registrations lost outright, after which
;; the op dispatches to `:default`. A wrong answer, not a crash — and `impl` is hot-reloadable
;; by design, so it bites a live reload, not just the parallel test suite.
;;
;; The registry has to STAY an immutable global map: `%dispatch`/`vm_dispatch` reads it on
;; every call, and a `Table` deep-clones values in and out, which would put a closure copy on
;; the dispatch hot path. So the write is serialised instead of the structure being changed.
;;
;; `table-incr` is the one atomic read-modify-write the language has ("concurrent increments
;; never lose an update"), which is enough for a ticket lock: take a ticket, wait until it is
;; being served, write, then serve the next. Registration is rare (load time and hot reload),
;; so the cost is irrelevant; dispatch is untouched.
;;
;; The wait is BOUNDED and falls back to writing unsynchronised. A registry deadlock would be
;; unrecoverable and this runs during prelude load, so the failure mode is capped at exactly
;; today's behaviour (a possible lost update) rather than a hang — e.g. if a lock holder dies
;; mid-section and never serves the next ticket.
(def *impl-lock* (table))

(defn register-impl--commit (op-key key f prov-key from)
  (let (ticket (table-incr *impl-lock* :ticket 1)
        got (register-impl--await ticket 20000))
    (do
      (def *impls* (assoc *impls* op-key (assoc (or (get *impls* op-key) {}) key f)))
      (def *impl-from* (assoc *impl-from* prov-key from))
      ;; Serve the next ticket only if we actually held the lock; bumping it after a
      ;; timed-out wait would let two writers through at once, for good.
      (when got (table-incr *impl-lock* :served 1))
      nil)))

;; Spin until our ticket is the one being served. Tickets start at 1 (`table-incr` returns the
;; POST-increment value) and `:served` starts absent = 0, so ticket N runs when served = N-1.
(defn register-impl--await (ticket spins)
  (cond
    (= (- ticket 1) (table-get *impl-lock* :served 0)) true
    (<= spins 0) false
    else (register-impl--await ticket (- spins 1))))

(defn impl-for (op-key key)
  "The impl fn of op `op-key` (a `[ability op]` pair) for id `key`, falling back to a
  `:default` impl, or nil. One map fetch for the op's method set, then one by id."
  (let (methods (get *impls* op-key))
    (or (get methods key) (get methods :default))))

(defn derive-into (aname id fields from)
  "Load-time worker for `defrecord`'s `:derives` (ADR-185): register ability `aname`'s derived
  impl for record id `id` (field-name symbols `fields`), tagged with ns `from`. Calls the
  ability's `:derive-record` recipe to get a list of `impl` method forms `((op [args] body…)
  …)`, evals each into a fn, and registers it for `id`. Loud error if `aname` is not derivable
  (declares no recipe). Runs at load, so the ability's `defability` need only precede the
  record's construction — not its macro-expansion."
  (let (recipe (ability-derive-recipe aname))
    (when (not recipe)
      (error "defrecord :derives — ability " aname " is not derivable "
        "(its defability declares no :derive-record recipe)"))
    (doseq (m (recipe fields))
      ;; a method form is `(op [args] body…)` (impl syntax — a `[args]` VECTOR); `fn` wants a
      ;; LIST param, so convert the vector to a list, exactly as the `impl` macro does.
      (register-impl aname (first m) id
        (eval (cons 'fn (cons (map (fn (s) s) (second m)) (rest (rest m))))) from))))

(defn no-impl (op-key key)
  "The loud, located error an op raises when no impl (and no `:default`) covers id
  `key`. Throws a STRUCTURED error map — `{:kind :no-impl :message … :ability :op :id
  :have}` — so a handler can branch on the parts (`(get e :id)`) without string-parsing;
  `error-message` still returns the `:message`, so a `(catch e (error-message e))` reads
  the same human text as before. Names the ability, the op, the id, and the ids that ARE
  implemented."
  (let (aname (first op-key)
        op (second op-key)
        known (keys (or (get *impls* op-key) {}))
        message (if (empty? known)
                  (str "ability " aname "/" op ": no impl for " key)
                  (str "ability " aname "/" op ": no impl for " key " — have " known)))
    (throw {:kind :no-impl :message message :ability aname :op op :id key :have known})))

(defn satisfies? (aname x)
  "True if ability `aname` is implemented for `x`'s identity — every declared op
  resolves (directly or via `:default`). Lets a caller branch instead of letting the op
  raise the missing-impl error. False for an unknown ability."
  (let (key (identity-of x)
        ops (ability-ops aname))
    (if ops
      (every? (fn (spec) (impl-for [aname (first spec)] key)) ops)
      false)))

; ---- macros -----------------------------------------------------------------

(defn defability--sealed-vec (specs)
  "The vector following `:sealed` in a `defability`'s specs (its closed member set), or nil."
  (cond
    (empty? specs) nil
    (= (first specs) :sealed) (second specs)
    else (defability--sealed-vec (rest specs))))

(defn defability--requires-vec (specs)
  "The vector following `:requires` in a `defability`'s specs (its prerequisite abilities), or nil."
  (cond
    (empty? specs) nil
    (= (first specs) :requires) (second specs)
    else (defability--requires-vec (rest specs))))

(defn defability--derive-fn (specs)
  "The form following `:derive-record` in a `defability`'s specs — the derive recipe (an
  inline `(fn (fields) …)` or a fn-symbol), or nil. Distinct from an op spec (whose second
  element is a `[args]` *vector*), so it is filtered out of the op list."
  (cond
    (empty? specs) nil
    (= (first specs) :derive-record) (second specs)
    else (defability--derive-fn (rest specs))))

(defn ability--id-kw (m)
  "The dispatch-id keyword for an impl / sealed-member id `m`. A keyword is kept as-is
  (`:int`, `:default`); a bare record symbol is qualified against the current ns
  (`circle` → `:<ns>/circle`, matching what `defrecord` bakes into a value); an already-
  qualified symbol is keyworded as-is (`geo/circle` → `:geo/circle`). Shared by `impl`
  and `:sealed` so they agree on a bare id — otherwise `(impl S circle …)` would register
  under `:circle` while a value presents `:<ns>/circle` and never match (KI-15)."
  (if (symbol? m)
    (if (includes? (name m) "/")
      (keyword (name m))
      (defrecord--qualify (name m)))
    m))

(defn defability--op-call (impl-sym arg-syms)
  "The dispatch call an op emits once its impl `impl-sym` is resolved. A fixed-arity op
  emits a direct `(impl self a b …)` — no arg-list allocation. A VARIADIC op (a `&` in the
  arg vector) emits `(apply impl self a … rest)`, because `&` is a binding marker, not a
  call-position argument — a direct `(impl self & rest)` would pass the symbol `&` as an
  argument (an unbound-symbol error at every call)."
  (if (member? '& arg-syms)
    (let (fixed (take-while (fn (s) (not (= s '&))) arg-syms)
          rest-sym (second (drop-while (fn (s) (not (= s '&))) arg-syms)))
      (append (list 'apply impl-sym) (append fixed (list rest-sym))))
    (cons impl-sym arg-syms)))

(defn defability--op-body (op)
  "The default-implementation body of op spec `op` — everything after the arg vector and
  any `:-> RET` — or nil when the op declares none. A spec `(op [args] :-> ret? body…)`
  with a body is a PROVIDED op (ADR-185): `defability` emits its body as an auto-registered
  `:default` impl, so an `impl` that omits the op still gets it (Rust/Haskell provided
  methods, Elixir `Protocol`'s derived defaults). The body typically calls the ability's
  *required* ops on `self`, so it works for any id that supplies those."
  (let (tail (rest (rest op)))          ; forms after `(op-name [args])`
    (if (= (first tail) :->)
      (rest (rest tail))                 ; skip the `:-> ret` pair
      tail)))

(defmacro defability (aname & specs)
  "Declare ability `aname`. Each op spec `(op [args…] :-> ret?)` becomes a generic
  function dispatching on its first argument's identity. An optional leading docstring
  is allowed. Records the specs in *abilities* for the checker / LSP.

  A **provided** op carries a default body after its spec — `(op [args] :-> ret? body…)`
  — which `defability` registers as the op's `:default` impl (ADR-185). An `impl` that
  omits a provided op inherits the default; one that supplies it overrides it (an id-keyed
  impl always beats `:default`). Write the required ops as bodyless specs and derive the
  rest — implement `compare-to`, get `lt`/`gt`/`min`/`max` free:

    (defability Ord
      (compare-to [self other] :-> int)                          ; required
      (lt  [self other] :-> bool (< (compare-to self other) 0))   ; provided
      (gt  [self other] :-> bool (> (compare-to self other) 0)))  ; provided

  An optional `:sealed [id …]` clause names the CLOSED set of member ids the ability is
  meant to cover; the checker then flags any member missing an impl of any *required* op
  (a provided op is satisfied by its default). An optional `:requires [A B …]` clause names
  prerequisite (super-)abilities: any id implementing this ability must also implement each of
  them, which the checker enforces (`(defability Ord :requires [Eq] (compare-to …))`). A bare
  record symbol is qualified with the current ns. An optional `:derive-record <fn>` clause makes the ability derivable: `<fn>`
  maps a record's field names to a list of `impl` method forms, which `defrecord`'s
  `:derives` splices in (see `defrecord`).

    (defability Size  (size [self] :-> int))
    (defability Store (fetch [self k]) (put [self k v]))
    (defability Shape :sealed [circle rect] (area [self] :-> float))"
  ; An op spec is a pair whose second element is the `[args]` VECTOR; that excludes a
  ; `:derive-record` recipe `(fn (fields) …)` (its second is a `(fields)` *list*) and any
  ; keyword-clause value, so only real ops are collected.
  (let (ops (filter (fn (s) (and (pair? s) (vector? (second s)))) specs)
        sealed-vec (defability--sealed-vec specs)
        sealed-ids (if sealed-vec (map ability--id-kw sealed-vec) nil)
        derive-fn (defability--derive-fn specs)
        requires-vec (defability--requires-vec specs)
        ; pass `(current-ns)` as the owner — evaluated at load in the DEFINING module, so
        ; `*ability-owner*` records where the ability was declared (ADR-172 precedence).
        ; The specs are stored WITH their bodies so the checker can tell a provided op from
        ; a required one (a body ⇒ provided ⇒ not demanded of a sealed member).
        reg (append
              (append
                (cons (list 'register-ability
                        (list 'quote aname) (list 'quote ops) (list 'current-ns))
                  (if sealed-ids
                    (list (list 'register-sealed
                            (list 'quote aname) (cons 'list sealed-ids)))
                    nil))
                ; the `:derive-record` recipe is emitted UNQUOTED — evaluated to a closure at
                ; load, so `defrecord`'s `:derives` can call it at expansion (ADR-185).
                (if derive-fn
                  (list (list 'register-ability-derive (list 'quote aname) derive-fn))
                  nil))
              ; `:requires [A B]` — an implementor of this ability must also implement A and B
              ; (super-abilities, ADR-193). The names are emitted quoted so the list is the
              ; ability-name symbols, not their (unbound) values.
              (if requires-vec
                (list (list 'register-ability-requires (list 'quote aname)
                        (cons 'list (map (fn (r) (list 'quote r)) requires-vec))))
                nil))
        ; A provided op (one with a default body) becomes a `:default` impl, registered from
        ; the declaring ns (ability-owner tier) so an app/type impl can still override it. Its
        ; body runs through ordinary dispatch, calling sibling ops on `self` by late binding.
        provided-defs (fold
                        (fn (acc op)
                          (let (body (defability--op-body op))
                            (if (empty? body)
                              acc
                              (let (arg-syms (map (fn (s) (if (pair? s) (first s) s))
                                               (second op)))
                                (append acc
                                  (list (list 'register-impl
                                          (list 'quote aname) (list 'quote (first op))
                                          :default (cons 'fn (cons arg-syms body))
                                          (list 'current-ns))))))))
                        nil ops)
        op-defs (map
                  (fn (op)
                    (let (op-name (first op)
                          ; arg vector → list of bare param symbols; dispatch reads the FIRST
                          ; arg's identity. A param may be typed `(name T)` (the `:-> RET`
                          ; sibling — a checker-only annotation, ADR-180); strip the type here
                          ; so the generated `defn` gets a plain symbol, `factor` not `(factor float)`.
                          arg-syms (map (fn (s) (if (pair? s) (first s) s)) (second op))
                          first-arg (first arg-syms)
                          ; a *constant* [ability op] key — a quoted literal, built once
                          op-key (list 'quote [aname op-name])
                          ; gensym'd temporaries so an op arg named `k`/`f` can't be captured
                          id-sym (gensym)
                          impl-sym (gensym))
                      ; A generic op dispatches on its FIRST argument, so a zero-arg op has
                      ; nothing to dispatch on — every value would route to the `:nil` impl.
                      ; Reject it at expansion rather than silently degrade.
                      (when (empty? arg-syms)
                        (error "defability " aname ": op `" op-name
                          "` takes no arguments — a generic op must have at least one "
                          "argument (it dispatches on the first)"))
                      (list 'defn
                        op-name arg-syms
                        (list 'let
                          ; `%dispatch` is `impl-for` through the per-op inline cache (ADR-172
                          ; §7): the op passes `*impls*` so the kernel stays decoupled from the
                          ; global's name; a hit skips the two CHAMP lookups. Cache-transparent.
                          (list id-sym
                            (list 'identity-of first-arg) impl-sym
                            (list '%dispatch '*impls* op-key id-sym))
                          (list 'if
                            impl-sym
                            ; the resolved call — direct for a fixed arity, `apply` for a
                            ; variadic op (`defability--op-call`)
                            (defability--op-call impl-sym arg-syms)
                            (list 'no-impl op-key id-sym))))))
                  ops))
    (cons 'do (append reg (append op-defs provided-defs)))))

(defmacro impl (aname key & methods)
  "Register implementations of ability `aname` for dispatch id `key` — a `type-of`
  keyword (`:int`, `:map`, …), a record's nominal id (`geometry/circle`), or `:default`.
  Open and late: from any module, any time. Each method is `(op [args…] body…)`; the
  registration is tagged with the current namespace for conflict detection.

    (impl Size :int             (size [n] n))
    (impl Size geometry/circle  (size [c] (get c :r)))"
  ; the dispatch id is a KEYWORD: a record id written as a symbol (`geometry/circle`) is
  ; keyworded to match what `identity-of` produces; a built-in id (`:int`) is already one.
  (let (id-kw (ability--id-kw key))
    (cons 'do
      (map
        (fn (m)
          (let (op-name (first m)
                ; arg vector → list
                arg-syms (map (fn (s) s) (second m))
                body (rest (rest m)))
            (list 'register-impl
              (list 'quote aname) (list 'quote op-name) id-kw (cons 'fn (cons arg-syms body))
              (list 'quote (current-ns)))))
        methods))))

;; ── Multiple dispatch: `defmulti` / `defmethod` (ADR-179) ──────────────────────
;; Dispatch on the IDENTITY-TUPLE of the arguments, resolved by EXACT match, then a declared
;; `:default`, else a loud `no-method` error — never a nearest-neighbour guess. Ambiguity is
;; impossible by construction (no partial wildcards). A `defmulti` may declare a closure
;; algebra — `:commutative` or `:antisymmetric` — that derives each off-diagonal binary
;; method's mirror, so a binary operator is authored as the upper triangle of its type matrix.
;; The single-dispatch seam is still `defability`/`impl`; this is its multi-arg sibling.

(def *methods* {})        ; multimethod name → { [id …] → fn, :default → fn }
(def *multi-algebra* {})  ; multimethod name → :commutative | :antisymmetric | nil (declared)
(def *method-from* {})    ; [mname key] → registering ns, for cross-module conflict detection

(defn register-multi (mname algebra)
  "Declare multimethod `mname` with optional closure `algebra` (nil, :commutative, or
  :antisymmetric). Records the algebra so `register-method` can derive each mirror."
  (def *multi-algebra* (assoc *multi-algebra* mname algebra))
  nil)

(defn multi-resolve (mname key)
  "The method fn of multimethod `mname` for identity-tuple `key` (a vector), else the declared
  `:default` method, else nil. Exact match or declared fallback — never a nearest guess."
  (let (methods (get *methods* mname))
    (or (get methods key) (get methods :default))))

(defn no-method (mname key)
  "The loud, structured error a multimethod raises when neither an exact method nor a
  `:default` covers identity-tuple `key`: `{:kind :no-method :message … :multi :key :have}`
  (the multiple-dispatch sibling of `no-impl`). `error-message` returns the human text."
  (let (known (keys (or (get *methods* mname) {}))
        message (if (empty? known)
                  (str "multimethod " mname ": no method for " key)
                  (str "multimethod " mname ": no method for " key " — have " known)))
    (throw {:kind :no-method :message message :multi mname :key key :have known})))

(defn register-method--store (mname key f)
  "Store method `f` at EXACT `key` for `mname` (overwrites — an authored method always wins)."
  (def *methods* (assoc *methods* mname (assoc (get *methods* mname {}) key f)))
  nil)

(defn register-method--derive (mname key f)
  "Fill the CLOSURE-derived mirror at `key` only if ABSENT — an explicitly authored method of
  the same key must never be clobbered by a derived one, whatever the load order."
  (let (methods (get *methods* mname {}))
    (when (not (contains? methods key))
      (def *methods* (assoc *methods* mname (assoc methods key f)))))
  nil)

(defn register-method (mname key f from)
  "Register method `f` of multimethod `mname` for identity-tuple `key` (a vector), tagged with
  ns `from`. Derives the mirror per the declared algebra for a BINARY off-diagonal key
  (:commutative → `(f y x)`; :antisymmetric → `(- 0 (f y x))`). STRICT: the multimethod must
  be declared first, a closure needs a binary key, and a same-key re-register from a DIFFERENT
  module is a loud conflict (last wins) — nothing is left unclear."
  ; The multimethod must be declared (so its algebra/shape is known). Unclear otherwise —
  ; fail at load, not silently at a later dispatch.
  (when (not (contains? *multi-algebra* mname))
    (error "defmethod " mname " " key ": no `(defmulti " mname " …)` is in scope — "
      "declare the multimethod before adding methods"))
  (let (prov [mname key]
        has-prev (contains? *method-from* prov)
        prev-from (get *method-from* prov))
    (when (and has-prev (not (= prev-from from)))
      (println "warning: multimethod " mname " method for " key
        " — redefined from " prev-from " by " from " (last wins)"))
    (register-method--store mname key f)
    (def *method-from* (assoc *method-from* prov from)))
  (let (algebra (get *multi-algebra* mname))
    ; the `:default` catch-all is a keyword sentinel, not a tuple — never a closure target.
    (when (and algebra (vector? key))
      ; a closure encodes a BINARY-operator law; refuse to derive on a non-binary key.
      (when (not (= (count key) 2))
        (error "defmethod " mname " " key ": a " algebra " closure needs a binary (2-arg) "
          "method, but this key has " (count key) " position(s)"))
      (let (left (nth key 0) right (nth key 1))
        ; skip the diagonal (key = its own mirror — it would wrap itself)
        (when (not (= left right))
          (let (mirror [right left])
            (cond
              (= algebra :commutative)
                (register-method--derive mname mirror (fn (x y) (f y x)))
              (= algebra :antisymmetric)
                (register-method--derive mname mirror (fn (x y) (- 0 (f y x))))
              else
                (error "defmulti " mname ": unknown algebra " algebra
                  " (expected :commutative, :antisymmetric, or none)")))))))
  nil)

(defmacro defmulti (mname & opts)
  "Declare multimethod `mname`, dispatching on the IDENTITY-TUPLE of its arguments: an EXACT
  method, then a `:default` method, else a loud `no-method` error — never a nearest guess.
  An optional algebra keyword derives each off-diagonal binary method's mirror — `:commutative`
  (`+`/`*`/`min`/`max`) or `:antisymmetric` (`compare-to`) — so a binary op is authored as the
  UPPER TRIANGLE of its type-pair matrix. See [[decisions]] ADR-179.

    (defmulti num-add :commutative)
    (defmulti compare-to :antisymmetric)
    (defmulti render)"
  (let (algebra (if (empty? opts) nil (first opts)))
    ; STRICT: an unknown algebra keyword is a clear declaration error — fail at expansion.
    (when (and algebra (not (member? algebra (list :commutative :antisymmetric))))
      (error "defmulti " mname ": unknown algebra " algebra
        " (expected :commutative, :antisymmetric, or none)"))
    (list 'do
      (list 'register-multi (list 'quote mname) algebra)
      (list 'defn mname '(& args)
        (list 'let (list 'key (list 'mapv 'identity-of 'args)
                    'f (list 'multi-resolve (list 'quote mname) 'key))
          (list 'if 'f
            (list 'apply 'f 'args)
            (list 'no-method (list 'quote mname) 'key)))))))

(defmacro defmethod (mname pattern arglist & body)
  "Register a method of multimethod `mname` for identity `pattern` — a vector whose positions
  are a built-in id keyword (`:int`) or a record name (`money`, `geo/circle`), the same
  spelling `impl` uses. STRICT (no guessing): the pattern must be a vector of ids and the
  method's arg count must match the pattern length — a mismatch fails at load.

    (defmethod num-add [money money] (a b) (money (+ (cents a) (cents b))))
    (defmethod num-add [money :int]  (m n) (money (+ (cents m) n)))    ; + is commutative
    (defmethod render   :default     (x) (str x))                      ; the catch-all"
  (cond
    ; the catch-all: consulted only when no exact identity-tuple matches. A keyword sentinel,
    ; not a tuple — so it is arity-agnostic and never a closure target.
    (= pattern :default)
      (list 'register-method (list 'quote mname) :default
        (cons 'fn (cons arglist body)) (list 'current-ns))
    (vector? pattern)
      (do
        (when (not (every? (fn (p) (or (symbol? p) (keyword? p))) pattern))
          (error "defmethod " mname " " pattern ": each position must be a record name or a "
            "built-in id keyword"))
        ; `:default` is the whole-pattern catch-all, never a single position — reject the mix.
        (when (any? (fn (p) (= p :default)) pattern)
          (error "defmethod " mname " " pattern ": `:default` is the catch-all, not a dispatch "
            "position — write `(defmethod " mname " :default …)`"))
        (when (not (= (count pattern) (count arglist)))
          (error "defmethod " mname " " pattern ": the method takes " (count arglist)
            " arg(s) but the pattern has " (count pattern) " position(s)"))
        ; resolve each position to the id keyword a value presents (records qualified, `impl`).
        (let (key (mapv ability--id-kw pattern))
          (list 'register-method
            (list 'quote mname)
            (list 'quote key)
            (cons 'fn (cons arglist body))
            (list 'current-ns))))
    else
      (error "defmethod " mname ": the dispatch pattern must be a vector of ids or "
        "`:default`, got " pattern)))

;; ── Display / Inspect: the print protocol (always on) ──────────────────────────
(defability Display
  "A value's human display string — what `print`/`println` show for it." (to-str [self] :-> string))

;; Every built-in kind, and every record without a custom impl, lands here: the
;; native `str` — i.e. exactly what printing produced before this module loaded.
(impl Display :default (to-str [x] (str x)))

;; `Inspect` — the DEBUG form (Elixir's `Inspect`, Haskell's `Show`), the companion
;; to `Display`. `(inspect x)` is what you want in a log line or a REPL: unambiguous,
;; type-revealing, and free to include a wrapper a human reads (`#money<$10.50>`).
;; It is DISTINCT from `pr-str` on purpose — `pr-str` must *round-trip* (its output
;; re-reads to the same value), so it is a kernel guarantee this protocol must not
;; override. `inspect` carries no round-trip contract, so a record may shape it
;; freely. `:default` is `pr-str` (the readable form) for everything uncustomised.
(defability Inspect
  "A value's debug string — for logs / the REPL. Unlike `pr-str`, need not re-read."
  (inspect [self] :-> string))

(impl Inspect :default (inspect [x] (pr-str x)))

(defn inspectln (x)
  "Print `x`'s debug form (`inspect`) followed by a newline — the `IO.inspect` move,
  for tracing. Returns `x`, so it drops into a pipeline: `(-> v f inspectln g)`."
  (println (inspect x))
  x)

;; Seqable — a value's list/seq view: the seam `seq` (and thus `map`/`filter`/`fold`/
;; `for`/`into`, plus `count`/`keys`/`vals`) consults for a RECORD. The default is the
;; record's fields (id-free) as `[k v]` pairs, so a record iterates, counts, and keys as
;; its fields and never leaks the internal `:__id__`; a custom-collection record overrides
;; `to-seq` to define its own iteration. Built-ins never reach here — `seq` takes their
;; native path — so this is purely the record extension point (à la `Display`), at zero
;; cost to built-ins.
(defability Seqable
  "A value's sequence view — the list that `seq`/`map`/`fold`/`for`/`into` iterate."
  (to-seq [self] :-> any))
(impl Seqable :default (to-seq [x] (map-pairs (fields x))))

;; Conjable — adding an element: the seam `conj`/`into` consult for a RECORD. The default
;; is the map behaviour (a record is a map: assoc a `[k v]` pair, or merge a map), so a
;; plain record conj's like a map; a custom-collection record overrides `-conj` to define
;; its own insertion (a queue pushes, a stack prepends, …). Built-ins keep their native
;; `conj--one` path — this fires only for a record.
(defability Conjable
  "Add element `x` to collection `self`, returning a fresh collection."
  (-conj [self x] :-> any))
(impl Conjable :default
  (-conj [coll x]
    (cond
      (map? x) (merge coll x)
      (and (vector? x) (%eq (count x) 2)) (assoc coll (nth x 0) (nth x 1))
      else (error "conj: adding to a record takes a [k v] pair or a map, got " (pr-str x)))))

;; Ord — total ordering: the seam `sort`/`sort-by` (and any `ord-compare` caller) consult
;; for a RECORD. `compare-to` returns -1 / 0 / 1. The default is the kernel's structural
;; `compare` (a record orders as its underlying map — deterministic and total, but NOT by
;; field value); a type that wants a meaningful order (a version, a money value, a hand of
;; cards) overrides `compare-to`.
;; `compare-to` is a multimethod (ADR-179): `:antisymmetric`, so a `[ver :int]` method
;; derives `[:int ver]` as its negation. STRICT like `Num` — there is NO `:default`: a record
;; type must define `compare-to` to be ordered (`<`/`<=`/`>`/`>=`/`sort`), else the pair is a
;; loud `no-method` (a record is not silently ordered by its map layout). `(compare-to a b)`
;; → -1 / 0 / 1.
(defmulti compare-to :antisymmetric)

;; Record-aware compare: a record uses its `compare-to` (a type with no `Ord` method is a loud
;; no-method — strict), everything else the kernel `compare`. This is the comparator
;; `sort`/`sort-by` use, so an `Ord` record type orders itself while built-ins keep the native
;; path.
(defn ord-compare (a b)
  (if (record? a) (compare-to a b) (compare a b)))

;; Num — arithmetic for a RECORD (a money value, complex number, 2-D vector, bignum), as
;; multimethods (ADR-179) dispatching on BOTH operands. A record operand to `+`/`-`/`*`/`/`
;; dispatches here — but NOT from the operators themselves (a Brood branch in `+` defeats the
;; JIT's arithmetic specialization, a ~195× regression); the kernel `%add`/`%sub`/`%mul`/`%div`
;; builtins call the matching `num-*` multimethod only on their COLD fallback, when EITHER
;; operand is a record, so int/float arithmetic is byte-for-byte untouched. `+`/`*` are
;; `:commutative` (author `[usd :int]` and `[:int usd]` is derived); `-`/`/` are not. There is
;; NO `:default` — a pair with no method gets the loud `no-method` error.
(defmulti num-add :commutative)
(defmulti num-sub)
(defmulti num-mul :commutative)
(defmulti num-div)

;; The per-print-argument hook the prelude installs into `*show*` at the end of boot
;; (Display is core, ADR-172 §8 — no activation step). Only a RECORD is routed through
;; `to-str` (a `defrecord` value is the sole thing that can carry a custom impl); every
;; other value passes through untouched so the built-in renderer stays on the fast path
;; — no `identity-of`/`impl-for` lookup per printed int or string. Disable for a scope
;; with `(binding (*show* nil) …)`.
(defn show--print-hook (x)
  (if (record? x) (to-str x) x))

;; Wire the screen printers to honor `Display` for records, by default (ADR-172 §8).
;; `(binding (*show* nil) …)` disables it for a scope.
(def *show* show--print-hook)
