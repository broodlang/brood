;; std/net/dns.blsp — a DNS client, in Brood, over TCP.
;;
;; Why TCP: the kernel has no UDP, and DNS over TCP is not a fallback but a required transport
;; (RFC 7766 — "DNS over TCP MUST be supported"). Same wire format, with a two-byte length
;; prefix in front of each message. So a resolver is reachable with the primitives that already
;; exist, and no new Rust.
;;
;; Why it exists: enumerating the addresses behind a name is how a cluster finds its own
;; members. On Fly, `<app>.internal` has one AAAA per machine; on Kubernetes a headless service
;; has one A per pod. A DNS-polling cluster strategy is built on exactly this — without it, a
;; Brood node can dial a peer it was told about but cannot discover one.
(defmodule dns
  "Resolve a hostname to its A/AAAA records, over TCP.

  `(dns/lookup \"example.com\")` → a list of IPv4 address strings;
  `(dns/lookup \"example.com\" dns/*aaaa*)` → IPv6.

  Enough DNS to enumerate a name, deliberately: one question per query, answers only, A and
  AAAA only. Not a resolver — no recursion of its own, no cache, no DNSSEC. It asks the
  resolver the system already uses and reads back what it says."
  (:alias tcp))

(def *a* 1)
(def *aaaa* 28)

;; ---- the resolver to ask -----------------------------------------------------

(defn nameserver ()
  "The first `nameserver` in /etc/resolv.conf, or `127.0.0.1` when there is no readable one.

  A container without resolv.conf is not an error worth raising here — the connect that
  follows will fail with something a caller can act on.

    (dns/nameserver)   ;~> \"127.0.0.53\" — whatever /etc/resolv.conf names first"
  (let (text (check-allow :discarded-catch
               (try (file/slurp "/etc/resolv.conf") (catch _e ""))))
    (or (first (seq/filter (map (string/split (or text "") "\n")
                             (fn (line)
                               (let (t (string/trim line))
                                 (if (string/starts-with? t "nameserver")
                                   (string/trim (string/substring t 10 (count t)))
                                   nil))))
                 (fn (v) (and v (not (= v ""))))))
      "127.0.0.1")))

;; ---- building a query --------------------------------------------------------

(defn- label-bytes (label)
  "One DNS label: a length byte, then the label's bytes."
  (bytes/append (bytes (count label)) (string/->bytes label)))

(defn- encode-name (host)
  "A hostname as length-prefixed labels terminated by a zero byte — `QNAME`."
  (bytes/append (apply bytes/append (map (string/split host ".") label-bytes))
    (bytes 0)))

(defn- u16 (n)
  "A 16-bit big-endian field."
  (bytes (bit/and (bit/shift-right n 8) 0xFF) (bit/and n 0xFF)))

(defn- query-message (host qtype)
  "A complete DNS query: header, one question, nothing else.

  Flags `0x0100` is RD (recursion desired) — we are asking a resolver to do the walking, which
  is the whole point of asking it rather than the root."
  (bytes/append (u16 22136)
    (u16 256)
    (u16 1)
    (u16 0)
    (u16 0)
    (u16 0)
    (encode-name host)
    (u16 qtype)
    (u16 1)))

;; ---- reading the answer ------------------------------------------------------

;; Every read below is bounds-checked against the reply, so a truncated or lying reply
;; decodes to nothing rather than raising: malformed input is an ordinary answer here.

(defn- skip-name (msg:bytes off:int -> (or int nil))
  "The offset just past the name at `off`, or nil when the name runs off the end of `msg`.

  A name ends at a zero length byte, or at a two-byte COMPRESSION POINTER (top bits set) that
  points back into the message — the pointer is the end of the name here, since we only need to
  step over it. Without handling pointers this walks off into the middle of a record: every
  answer after the first uses one."
  (when (< off (count msg))
    (let (b (bytes/at msg off))
      (cond
        (= b 0) (+ off 1)
        (>= b 192) (+ off 2)
        else (skip-name msg (+ off 1 b))))))

(defn- ipv4 (msg:bytes off:int -> string)
  (string/join (map (range 0 4) (fn (i) (->string (bytes/at msg (+ off i))))) "."))

(defn- ipv6 (msg:bytes off:int -> string)
  "The full eight-group form, each group lowercase hex without leading zeros. Not the
  `::`-compressed one: this is fed to a connect string, where being unambiguous matters more
  than being short."
  (string/join (map (range 0 8) (fn (i) (string/number-> (bytes/uint msg (+ off (* i 2)) 2) 16)))
    ":"))

(defn- read-answers (msg off n qtype acc)
  "Walk `n` answer records from `off`, collecting the ones matching `qtype` — nil if a record
  runs past the end of `msg`.

  Every record is stepped over by its own RDLENGTH whether or not we want it — a response
  carries CNAMEs and other types alongside the answer, and skipping only the ones we recognise
  would desynchronise the walk."
  (let (after-name (when (> n 0) (skip-name msg off)))
    (cond
      (<= n 0) (reverse acc)
      (or (nil? after-name) (> (+ after-name 10) (count msg))) nil
      else
        (let (rtype (bytes/uint msg after-name 2)
              rdlen (bytes/uint msg (+ after-name 8) 2)
              rdata (+ after-name 10)
              value (cond
                      (> (+ rdata rdlen) (count msg)) :truncated
                      (not (= rtype qtype)) nil
                      (and (= rtype *a*) (= rdlen 4)) (ipv4 msg rdata)
                      (and (= rtype *aaaa*) (= rdlen 16)) (ipv6 msg rdata)
                      else nil))
          (cond
            (= value :truncated) nil
            value (read-answers msg (+ rdata rdlen) (- n 1) qtype (cons value acc))
            else (read-answers msg (+ rdata rdlen) (- n 1) qtype acc))))))

(defn- decode-reply (body qtype)
  "The addresses in reply `body`, or the empty list for one too short to hold them."
  ;; the question is echoed back before the answers; step over it
  (let (after-question (when (>= (count body) 12) (skip-name body 12)))
    (if after-question
      (read-answers body (+ after-question 4) (bytes/uint body 6 2) qtype (list))
      (list))))

;; ---- the query ---------------------------------------------------------------

(defn- read-body (sock len surplus timeout-ms)
  "`len` bytes of body, using whatever `read-n` already handed back before asking for more —
  or `:closed`/`:timeout` when the rest never arrives."
  (let (have (count surplus))
    (if (>= have len)
      (bytes/slice surplus 0 len)
      (let ([more _] (tcp/read-n sock (- len have) {:timeout-ms timeout-ms}))
        (if (bytes? more) (bytes/append surplus more) more)))))

(defn- exchange (sock host qtype timeout-ms)
  "Send one query on `sock` and decode the reply; the empty list when no whole reply arrives."
  ;; Binary BEFORE the send: text mode would UTF-8-decode the reply, turning every byte over
  ;; 0x7F into U+FFFD, and the record offsets would stop meaning anything (KI-102).
  (tcp/set-binary sock true)
  (let (msg (query-message host qtype)
        sent (check-allow :discarded-catch
               (try
                 (tcp/send sock (bytes/append (u16 (count msg)) msg))
                 true
                 (catch _e false)))
        ;; TCP framing: two bytes of length, then the message. `read-n`'s surplus is
        ;; already-arrived body; dropping it would wait forever for bytes we have.
        [len-bytes surplus] (if sent (tcp/read-n sock 2 {:timeout-ms timeout-ms}) [:closed nil])
        body (if (bytes? len-bytes)
               (read-body sock (bytes/uint len-bytes 0 2) surplus timeout-ms)
               len-bytes))
    (if (bytes? body) (decode-reply body qtype) (list))))

(defn- ask (server port host qtype timeout-ms)
  ;; Only the connect and the send are caught — a refused or broken connection is an
  ;; answer. Anything else raising is a bug, and propagates.
  (let (sock (check-allow :discarded-catch (try (tcp/connect server port) (catch _e nil))))
    (if sock
      (try (exchange sock host qtype timeout-ms) (finally (tcp/close sock)))
      (list))))

(defn lookup (host &optional (qtype *a*) (server nil) (timeout-ms 5000))
  "The addresses `host` resolves to, as strings — the empty list when the name does not
  resolve, the resolver is unreachable or silent, or the response is malformed.

  Those are ordinary answers, not raises: a caller enumerating cluster peers polls, and wants
  an empty list rather than an exception on every tick while a peer is down.

  (dns/lookup \"localhost\") ;=> (\"127.0.0.1\")"
  (ask (or server (nameserver)) 53 host qtype timeout-ms))

(defn lookup-all (host &optional (server nil))
  "Every address for `host`, IPv6 first — the order a dual-stack caller should try them in, and
  on a v6-only network (Fly's private network, for one) the only ones that exist.

    (dns/lookup-all \"localhost\")   ;~> (\"::1\" \"127.0.0.1\"), IPv6 addresses first"
  (append (lookup host *aaaa* server) (lookup host *a* server)))
