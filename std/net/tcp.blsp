;; std/net/tcp.blsp — TCP sockets, the Brood layer.
;;
;; Sockets follow the blocking-IO → mailbox model (ADR-059/060): the kernel reads
;; each socket on a non-worker thread and delivers events to the **owning process's
;; mailbox** (the process that called `tcp-connect` / `tcp-listen`). You consume
;; them with plain `receive` — no polling, and a socket waiting for data costs no
;; worker. The message shapes:
;;
;;   [:tcp sock data]            inbound data on a connected socket — a `bytes`
;;                               value in binary mode (`tcp-set-binary`), a UTF-8
;;                               string in text mode (the default)
;;   [:tcp-closed sock]          that socket reached EOF / errored. NOTE the peer
;;                               closing its SEND side is a half-close — the write
;;                               side stays usable (a server can still reply). So
;;                               `[:tcp-closed]` does not free the socket; call
;;                               `(tcp-close sock)` when you're done with it. A
;;                               per-connection handler process that exits frees
;;                               its sockets automatically (owner-death reclaim),
;;                               so the serve-loop pattern needs no explicit close;
;;                               a long-lived process handling sockets directly
;;                               should close them to avoid holding fds.
;;   [:tcp-accept lsock client]  a new connection on a listener (client is wired
;;                               to the same owner, so its [:tcp …] arrive here too)
;;
;; Outbound is `(tcp-send sock iolist)` (writes it all; string leaves are always
;; UTF-8, raw bytes ride as `bytes` values — ADR-141); `(tcp-close sock)` shuts a
;; stream or stops a listener. A socket handle is valid across this runtime's
;; processes but is never sent across nodes.

(defmodule net/tcp
  "TCP sockets over the kernel's non-blocking primitives (ADR-059/060). Inbound
data arrives as `[:tcp sock data]` / `[:tcp-closed sock]` / `[:tcp-accept lsock
client]` messages in the owning process's mailbox — consume them with `receive`.
This module adds the `socket?` predicate, `tcp-drain` (read to EOF), and the
framed-read combinators `tcp-read-until` (read to a delimiter — an HTTP head, a
line) and `tcp-read-n` (read a length-prefixed body/frame), which return the frame
plus any surplus already read past it. Both take an options map bounding an
untrusted peer — `:timeout-ms` (idle), `:max-bytes`, and `:deadline-ms` (total) —
so a server can answer 408 / 413 instead of holding a process open, accumulating
without limit, or being drip-fed indefinitely. Policy is Brood; only the syscalls
are Rust.")

(defn socket? (x) "True if `x` is a TCP socket." (%eq (type-of x) :socket))

(defn tcp-drain (sock)
  "Receive `[:tcp sock data]` messages for `sock`, concatenating the chunks, until `[:tcp-closed sock]`; return everything as one `bytes` value (byte-faithful in either socket mode — text-mode string chunks contribute their UTF-8 bytes; decode with `utf8-bytes->string` for text). For request/response protocols where the peer closes when its reply is complete (e.g. HTTP/1.0). Must be called by the socket's owning process."
  (tcp-drain-acc sock nil))

;; `acc` is the chunks in reverse; ONE `bytes-concat` at close (the reversed chunk
;; list is itself an iolist). Per-chunk concatenation rebuilt the whole accumulator
;; each message — O(total²) over a large response.
(defn- tcp-drain-acc
  (sock acc)
  (receive
    ([:tcp ^sock d] (tcp-drain-acc sock (cons d acc)))
    ([:tcp-closed ^sock] (bytes-concat (reverse acc)))))

(defn tcp-drain-timeout (sock ms)
  "Like `tcp-drain`, but give up after `ms` milliseconds of silence and return whatever was collected (tagged `[:timeout acc]` vs `[:closed acc]` so the caller can tell; `acc` is a `bytes` value)."
  (tcp-drain-to sock nil ms))

(defn- tcp-drain-to
  (sock acc ms)
  (receive
    ([:tcp ^sock d] (tcp-drain-to sock (cons d acc) ms))
    ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))])
    (after ms [:timeout (bytes-concat (reverse acc))])))

;; ---- framed reads: the input-side twin of iolists (ADR-139) ----------------
;; The recurring stream-parsing shapes — read a delimited frame (an HTTP request
;; head, a line), read a length-prefixed body (Content-Length, a chunk, a WS
;; payload) — as reusable combinators, so a protocol needn't re-implement the
;; receive+accumulate+split loop each time (the manual `cons`/`reverse`/`join`
;; idiom, written five ways across an HTTP/WS stack). Both accumulate chunks in a
;; reversed list and `bytes-concat` **once**, never per-chunk (no O(total²) rebuild),
;; and return the frame plus any surplus already read past it, so the caller keeps
;; the leftover for the next frame. Pure Brood over `receive` — no mutable buffer
;; (ADR-026); the accumulator is an ordinary immutable list. Binary mode
;; (`tcp-set-binary`) is recommended so byte lengths and delimiters are exact.
;; Must be called by the socket's owning process (they `receive` its messages).

;; ---- limits: three bounds, none of which substitutes for another ---------
;; A server reading an attacker-controlled stream needs more than one bound:
;;
;;   :timeout-ms  how long to wait for the NEXT chunk (idle, reset per chunk).
;;                Bounds a peer that connects and then says nothing — the classic
;;                slow-loris hold, which costs the server a process and an fd for
;;                as long as it lasts. Idle, because a large legitimate body is
;;                slow for honest reasons; what marks that attack is silence.
;;   :max-bytes   how many bytes the frame may reach. Bounds a peer that DOES keep
;;                talking — drip-feeding a byte just inside the idle timeout, or
;;                streaming an unbounded head that never contains the delimiter.
;;                Without it `tcp-read-until` accumulates until the process OOMs.
;;   :deadline-ms a TOTAL wall-clock budget for the whole frame, measured once at
;;                the call and never reset. Bounds the gap the other two leave
;;                open: a drip-feeder re-arms the idle timeout on every chunk, so
;;                `:timeout-ms` alone never fires, and `:max-bytes` bounds only the
;;                SIZE it reaches, not the TIME it takes to get there. A peer
;;                sending one byte per (idle - 1)ms therefore holds a worker for
;;                `:max-bytes` × idle — hours, legitimately, under both other
;;                bounds. Use it where a frame is small and bounded by protocol and
;;                a slow one is therefore already suspect (an HTTP request head);
;;                leave it off where slowness is honest (a large body upload),
;;                which is why it is separate from `:timeout-ms` rather than
;;                replacing it.
;;
;; Added 2026-08-13 after hatch — the consumer these combinators were built for —
;; found it could not adopt them without it: all four of its read loops enforce an
;; idle timeout AND a total deadline (its own hand-rolled `(min idle (- deadline
;; (now)))` per receive), so switching to `tcp-read-until` would have dropped the
;; drip defense. A single call cannot express it from the outside: the idle timer
;; resets per chunk INSIDE the call, so no `:timeout-ms` value survives a dripper,
;; and splitting the read across several calls would miss a delimiter straddling
;; the boundary between them (each call scans only its own accumulator).
;;
;; All three are opt-in and default off: a client reading a reply it asked for
;; wants none of them, and adding any silently would change existing callers.
;; Limits produce their own tagged returns (`[:timeout acc]` / `[:too-large acc]`),
;; alongside `[:closed acc]`, so a caller can answer 408 vs 413 vs "peer hung up"
;; — the distinction an HTTP server has to make. The idle timeout and the deadline
;; share `[:timeout acc]`: both mean "this frame did not arrive in time", which is
;; one 408, and keeping them distinct would buy a caller nothing it can act on.

;; `{:timeout-ms n :max-bytes n :deadline-ms n}` → `[ms maxb end]`, each nil when
;; unset. `end` is resolved HERE to an absolute epoch-ms — the budget is measured
;; from the call, so a loop that re-reads it per chunk cannot accidentally restart
;; it. One place that reads the map, so both combinators accept the same options.
(defn- tcp-read-limits
  (opts)
  (let (d (get opts :deadline-ms))
    [(get opts :timeout-ms) (get opts :max-bytes) (if d (+ (now) d) nil)]))

;; ---- :seed — bytes the caller already holds -------------------------------
;; A protocol that reads frame after frame off one stream ends each read holding the surplus
;; that arrived past the frame it wanted. The NEXT frame therefore starts with bytes in hand,
;; and those bytes may already contain the delimiter — or, worse, its first half. Without a
;; way to hand them in, a caller must either scan them itself (re-implementing the loop these
;; combinators exist to replace) or lose a delimiter straddling the boundary between what it
;; holds and what arrives next.
;;
;; `:seed` is those bytes: the read behaves exactly as if they had just arrived as the first
;; chunk. It is checked for the delimiter before any socket read, so a seed that already
;; contains a whole frame returns without blocking at all.
;;
;; Added 2026-08-13, from hatch again: its HTTP worker re-enters the head read with the
;; leftover of a pipelined request, which can be a partial head, so this was the last thing
;; keeping it on a hand-rolled loop.

;; The `after` value for one receive: the idle timeout, the time left on the total
;; deadline, or the sooner of the two — nil when neither is set, which selects the
;; unbounded `receive` (there is no way to write "no timeout" as an `after` clause).
;; Floors at 1ms so an expired deadline fires immediately rather than passing `after`
;; a zero or negative wait.
(defn- tcp-read-wait
  (ms end)
  (cond
    (and ms end) (min ms (max 1 (- end (now))))
    ms ms
    end (max 1 (- end (now)))
    else nil))

(defn tcp-read-until (sock sep &optional (opts {}))
  "Receive `[:tcp sock data]` chunks until the byte sequence `sep` (a string or `bytes`) first appears in the stream. Return `[head rest]`: `head` is the bytes up to AND INCLUDING `sep`, `rest` is any bytes already received past it (both `bytes`). Return `[:closed acc]` if the socket closes before `sep` appears (`acc` = all bytes received). For a delimited frame — an HTTP request head (`sep` = \"\\r\\n\\r\\n\"), a line (\"\\n\"), a protocol record — which is bounded; a length-prefixed *body* uses `tcp-read-n` (which never scans).

  `opts` bounds an untrusted peer, all off by default: `:timeout-ms` is the IDLE wait for the next chunk (reset per chunk), returning `[:timeout acc]` — a peer that connects and goes silent; `:max-bytes` caps the frame INCLUDING `sep`, returning `[:too-large acc]` — a peer that drip-feeds or never sends the delimiter; `:deadline-ms` is a TOTAL budget for the whole frame, measured from the call and never reset, also returning `[:timeout acc]` — a peer that drips just fast enough to keep re-arming the idle timeout. An HTTP head reader wants all three (408, 413, 408).

  `:seed` is a `bytes` value the caller already holds — the surplus a previous framed read returned — treated as if it had just arrived as the first chunk. A protocol reading frame after frame off one stream needs it: without it, a delimiter sitting in (or straddling) those bytes is missed. A seed containing a whole frame returns without reading the socket at all. Must be called by the socket's owning process."
  (let ([ms maxb end] (tcp-read-limits opts)
        sepb (bytes-concat sep)
        seed (get opts :seed))
    (if (or (nil? seed) (= (byte-length seed) 0))
      (tcp-read-until-loop sock sepb nil 0 #b"" ms maxb end)
      ;; Feed the seed through the same step the loop runs on an arriving chunk, so a
      ;; delimiter inside it — or straddling it and the next chunk — is found by exactly the
      ;; arithmetic that handles every other boundary. One code path, no special case.
      (tcp-read-until-step sock sepb nil 0 #b"" ms maxb end seed))))

;; `acc` is the chunks in reverse, `have` their running byte total, and `tail` the
;; last (|sep|-1) bytes accumulated — the only earlier bytes a delimiter straddling
;; the chunk boundary can still need. So each inbound chunk is scanned exactly once,
;; against `[tail | chunk]` (O(chunk + |sep|)), and the accumulator is concatenated
;; ONCE — only on the delimiter, when the caller actually needs the bytes.
;;
;; This used to `bytes-concat` the whole accumulator and rescan it from 0 on EVERY
;; chunk, which is O(total²) in both copying and scanning: 250 KB arriving as 4000
;; chunks took 1.57 s, and 16× the chunk count cost 169× the time. There is no size
;; cap here (the caller frames what it reads), so that was also remotely triggerable
;; by a peer that drip-feeds and never sends the delimiter.
;;
;; `byte-length`, not `count`, throughout: these are byte counts, and `count` reaches
;; bytes only at the bottom of a five-deep type-predicate `cond` (514ns vs 36ns) — a
;; per-chunk cost in a loop this shape.
;; Only the `receive` SHAPE differs between the bounded and unbounded cases — `after`
;; needs a real millisecond count, so there is no way to write "no timeout" as an
;; `after` clause. The two receives therefore differ in that one clause and hand every
;; chunk to the same `tcp-read-until-step`, so the delimiter arithmetic (the subtle
;; part) exists once. The unbounded path pays one `tcp-read-wait` (a cond that answers
;; nil on its first two tests) per chunk and is otherwise the loop it always was.
;;
;; The wait is recomputed per chunk rather than once, because that is exactly what
;; makes `:deadline-ms` a TOTAL budget: each receive waits only for what is left of it.
(defn- tcp-read-until-loop
  (sock sep acc have tail ms maxb end)
  (let (w (tcp-read-wait ms end))
    (if w
      (receive
        ([:tcp ^sock d] (tcp-read-until-step sock sep acc have tail ms maxb end d))
        ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))])
        (after w [:timeout (bytes-concat (reverse acc))]))
      (receive
        ([:tcp ^sock d] (tcp-read-until-step sock sep acc have tail ms maxb end d))
        ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))])))))

(defn- tcp-read-until-step
  (sock sep acc have tail ms maxb end d)
  (let (probe (bytes-concat tail d)
        i (bytes-index-of probe sep))
    (if (>= i 0)
      ;; probe byte 0 sits at absolute (have - |tail|); a match must
      ;; include a byte of `d` (|tail| < |sep|), so it is never one
      ;; we already reported past.
      (let (cut (+ (- have (byte-length tail)) i (byte-length sep)))
        ;; The cap is checked against the COMPLETED frame, so a head that lands
        ;; exactly on `:max-bytes` is delivered rather than rejected off-by-one.
        (if (and maxb (> cut maxb))
          [:too-large (bytes-concat (reverse (cons d acc)))]
          (let (buf (bytes-concat (reverse (cons d acc))))
            [(subbytes buf 0 cut) (subbytes buf cut (byte-length buf))])))
      (let (have (+ have (byte-length d)))
        ;; No delimiter yet: stop as soon as what we hold already exceeds the cap,
        ;; rather than waiting for a delimiter that may never come.
        (if (and maxb (> have maxb))
          [:too-large (bytes-concat (reverse (cons d acc)))]
          (tcp-read-until-loop sock
            sep
            (cons d acc)
            have
            (tcp-straddle probe (byte-length sep))
            ms
            maxb
            end))))))

;; The last (|sep|-1) bytes of `probe` — everything a delimiter spanning the next
;; chunk boundary could need, and nothing more.
(defn- tcp-straddle
  (probe sep-len)
  (let (n (byte-length probe)
        k (max 0 (- sep-len 1)))
    (if (<= n k) probe (subbytes probe (- n k) n))))

(defn tcp-read-n (sock n &optional (opts {}))
  "Receive `[:tcp sock data]` chunks until at least `n` bytes have arrived; return `[data rest]` where `data` is exactly the first `n` bytes and `rest` any surplus already received (both `bytes`). Return `[:closed acc]` if the socket closes with fewer than `n` bytes (`acc` = what arrived). For a length-prefixed body — a Content-Length payload, one chunk of a chunked transfer, a WebSocket frame payload. O(total): the running byte count means no rescanning and a single `bytes-concat` at the end. Assumes binary mode (chunk byte lengths).

  `opts` takes the same limits as `tcp-read-until`, all off by default: `:timeout-ms`, the IDLE wait for the next chunk, returning `[:timeout acc]`; `:max-bytes`, returning `[:too-large #b\"\"]` **before reading anything** when the declared `n` exceeds it — a `Content-Length: 4000000000` is refused rather than read; and `:deadline-ms`, a TOTAL budget for the whole body measured from the call, also returning `[:timeout acc]`. Prefer `:timeout-ms` alone for a large body — slowness there is usually honest — and reach for `:deadline-ms` when the protocol bounds the body small. Must be called by the socket's owning process."
  (let ([ms maxb end] (tcp-read-limits opts))
    (if (and maxb (> n maxb))
      ;; The length is DECLARED, so the cap is a pre-read decision: there is no
      ;; reason to buffer a body we have already resolved to reject (that is the
      ;; whole amplification the cap exists to stop). Nothing has been consumed.
      [:too-large #b""]
      (tcp-read-n-loop sock n 0 nil ms end))))

(defn- tcp-read-n-loop
  (sock n have acc ms end)
  (if (>= have n)
    (let (buf (bytes-concat (reverse acc)))
      [(subbytes buf 0 n) (subbytes buf n (count buf))])
    ;; As in `tcp-read-until-loop`: `after` needs a concrete ms, so the bounded and
    ;; unbounded cases are two receives over the same body, and the wait is recomputed
    ;; per chunk so `:deadline-ms` stays a total budget rather than restarting.
    (let (w (tcp-read-wait ms end))
      (if w
        (receive
          ([:tcp ^sock d] (tcp-read-n-loop sock n (+ have (count d)) (cons d acc) ms end))
          ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))])
          (after w [:timeout (bytes-concat (reverse acc))]))
        (receive
          ([:tcp ^sock d] (tcp-read-n-loop sock n (+ have (count d)) (cons d acc) ms end))
          ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))]))))))
