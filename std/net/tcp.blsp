;; std/tcp.blsp — TCP sockets, the Brood layer. (require 'tcp).
;;
;; Sockets follow the blocking-IO → mailbox model (ADR-059/060): the kernel reads
;; each socket on a non-worker thread and delivers events to the **owning process's
;; mailbox** (the process that called `tcp-connect` / `tcp-listen`). You consume
;; them with plain `receive` — no polling, and a socket waiting for data costs no
;; worker. The message shapes:
;;
;;   [:tcp sock data]            inbound data on a connected socket — a `bytes`
;;                               value in binary mode (`tcp-set-binary`), a UTF-8
;;                               string in text mode (the default)
;;   [:tcp-closed sock]          that socket reached EOF / errored. NOTE the peer
;;                               closing its SEND side is a half-close — the write
;;                               side stays usable (a server can still reply). So
;;                               `[:tcp-closed]` does not free the socket; call
;;                               `(tcp-close sock)` when you're done with it. A
;;                               per-connection handler process that exits frees
;;                               its sockets automatically (owner-death reclaim),
;;                               so the serve-loop pattern needs no explicit close;
;;                               a long-lived process handling sockets directly
;;                               should close them to avoid holding fds.
;;   [:tcp-accept lsock client]  a new connection on a listener (client is wired
;;                               to the same owner, so its [:tcp …] arrive here too)
;;
;; Outbound is `(tcp-send sock iolist)` (writes it all; string leaves are always
;; UTF-8, raw bytes ride as `bytes` values — ADR-141); `(tcp-close sock)` shuts a
;; stream or stops a listener. A socket handle is valid across this runtime's
;; processes but is never sent across nodes.

(defmodule net/tcp
  "TCP sockets over the kernel's non-blocking primitives (ADR-059/060). Inbound
data arrives as `[:tcp sock data]` / `[:tcp-closed sock]` / `[:tcp-accept lsock
client]` messages in the owning process's mailbox — consume them with `receive`.
This module adds the `socket?` predicate, `tcp-drain` (read to EOF), and the
framed-read combinators `tcp-read-until` (read to a delimiter — an HTTP head, a
line) and `tcp-read-n` (read a length-prefixed body/frame), which return the frame
plus any surplus already read past it. Policy is Brood; only the syscalls are Rust.")

(defn socket? (x) "True if `x` is a TCP socket." (%eq (type-of x) :socket))

(defn tcp-drain (sock)
  "Receive `[:tcp sock data]` messages for `sock`, concatenating the chunks, until `[:tcp-closed sock]`; return everything as one `bytes` value (byte-faithful in either socket mode — text-mode string chunks contribute their UTF-8 bytes; decode with `utf8-bytes->string` for text). For request/response protocols where the peer closes when its reply is complete (e.g. HTTP/1.0). Must be called by the socket's owning process."
  (tcp--drain-acc sock nil))

;; `acc` is the chunks in reverse; ONE `bytes-concat` at close (the reversed chunk
;; list is itself an iolist). Per-chunk concatenation rebuilt the whole accumulator
;; each message — O(total²) over a large response.
(defn tcp--drain-acc (sock acc)
  (receive
    ([:tcp ^sock d] (tcp--drain-acc sock (cons d acc)))
    ([:tcp-closed ^sock] (bytes-concat (reverse acc)))))

(defn tcp-drain-timeout (sock ms)
  "Like `tcp-drain`, but give up after `ms` milliseconds of silence and return whatever was collected (tagged `[:timeout acc]` vs `[:closed acc]` so the caller can tell; `acc` is a `bytes` value)."
  (tcp--drain-to sock nil ms))

(defn tcp--drain-to (sock acc ms)
  (receive
    ([:tcp ^sock d] (tcp--drain-to sock (cons d acc) ms))
    ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))])
    (after ms [:timeout (bytes-concat (reverse acc))])))

;; ---- framed reads: the input-side twin of iolists (ADR-139) ----------------
;; The recurring stream-parsing shapes — read a delimited frame (an HTTP request
;; head, a line), read a length-prefixed body (Content-Length, a chunk, a WS
;; payload) — as reusable combinators, so a protocol needn't re-implement the
;; receive+accumulate+split loop each time (the manual `cons`/`reverse`/`join`
;; idiom, written five ways across an HTTP/WS stack). Both accumulate chunks in a
;; reversed list and `bytes-concat` **once**, never per-chunk (no O(total²) rebuild),
;; and return the frame plus any surplus already read past it, so the caller keeps
;; the leftover for the next frame. Pure Brood over `receive` — no mutable buffer
;; (ADR-026); the accumulator is an ordinary immutable list. Binary mode
;; (`tcp-set-binary`) is recommended so byte lengths and delimiters are exact.
;; Must be called by the socket's owning process (they `receive` its messages).

(defn tcp-read-until (sock sep)
  "Receive `[:tcp sock data]` chunks until the byte sequence `sep` (a string or `bytes`) first appears in the stream. Return `[head rest]`: `head` is the bytes up to AND INCLUDING `sep`, `rest` is any bytes already received past it (both `bytes`). Return `[:closed acc]` if the socket closes before `sep` appears (`acc` = all bytes received). For a delimited frame — an HTTP request head (`sep` = \"\\r\\n\\r\\n\"), a line (\"\\n\"), a protocol record — which is bounded; a length-prefixed *body* uses `tcp-read-n` (which never scans). Must be called by the socket's owning process."
  (tcp--read-until sock (bytes-concat sep) nil))

(defn tcp--read-until (sock sep acc)
  (receive
    ([:tcp ^sock d]
      (let (buf (bytes-concat (reverse (cons d acc)))
            i (bytes-index-of buf sep))
        (if (>= i 0)
          (let (cut (+ i (count sep)))
            [(subbytes buf 0 cut) (subbytes buf cut (count buf))])
          (tcp--read-until sock sep (cons d acc)))))
    ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))])))

(defn tcp-read-n (sock n)
  "Receive `[:tcp sock data]` chunks until at least `n` bytes have arrived; return `[data rest]` where `data` is exactly the first `n` bytes and `rest` any surplus already received (both `bytes`). Return `[:closed acc]` if the socket closes with fewer than `n` bytes (`acc` = what arrived). For a length-prefixed body — a Content-Length payload, one chunk of a chunked transfer, a WebSocket frame payload. O(total): the running byte count means no rescanning and a single `bytes-concat` at the end. Assumes binary mode (chunk byte lengths). Must be called by the socket's owning process."
  (tcp--read-n sock n 0 nil))

(defn tcp--read-n (sock n have acc)
  (if (>= have n)
    (let (buf (bytes-concat (reverse acc)))
      [(subbytes buf 0 n) (subbytes buf n (count buf))])
    (receive
      ([:tcp ^sock d] (tcp--read-n sock n (+ have (count d)) (cons d acc)))
      ([:tcp-closed ^sock] [:closed (bytes-concat (reverse acc))]))))
