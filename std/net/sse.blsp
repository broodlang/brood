;; std/sse.blsp — Server-Sent Events (text/event-stream): a client + server framing.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - SSE is **not** request→response like `request`: it's a long-lived `GET`
;;    that the server holds open and *pushes* frames down forever. So it gets its
;;    own module (reusing `http`'s URL + header helpers for the handshake) and its
;;    own **process**: `connect` spawns a reader that streams `[:tcp …]` chunks
;;    and `send`s each parsed event to a subscriber's mailbox — the same
;;    deliver-to-a-mailbox shape as `gui/open` input (ADR-058) and the observer's
;;    remote agent.
;;  - **Pure frame parsing** (the `observe-frame` discipline): the wire grammar
;;    (`event:`/`data:`/`id:` field lines, blank-line frame boundaries, comment
;;    lines, `\n`/`\r\n`/`\r` terminators) is parsed by pure functions
;;    (`parse-event`, `frames`) that are unit-testable without a socket;
;;    only `connect`/`stream` touch IO.
;;  - **Integrates with `ui-run` via `with-events`** (in `std/editor/ui.blsp`): wrap a
;;    display so its `:poll` surfaces queued `[:sse …]` messages as loop input — so
;;    pushed events drive the UI on the terminal *and* the GUI.
;;  - **Text-mode reads are deliberate** (ADR-141): SSE is a UTF-8 *text*
;;    protocol (`text/event-stream`), and the kernel's text decode — longest
;;    valid prefix per chunk, split multibyte characters carried to the next
;;    read — is exactly the right framing for it, so events surface as strings
;;    with no decode step here. Binary-mode `bytes` reads are for *binary*
;;    protocols (see http's request path).
;;  - Opt-in (`require`), never in the prelude. http (not https) for now — the
;;    target is a localhost daemon.

(defmodule sse
  "Server-Sent Events (`text/event-stream`) in Brood: a client, and server-side
framing for pushing events over `http`'s streaming seam.

    (def conn (connect \"http://127.0.0.1:7777/events\" (self)))
    (receive ([:sse ev] ev))     ; => {:event \"run_started\" :data \"{…}\" :id \"7\"}
    (exit conn :kill)            ; disconnect

`connect` spawns a reader **process** that opens the stream and delivers each
event to `subscriber`'s mailbox as `[:sse {:event :data :id}]` (`[:sse-open status]`
once connected, `[:sse-closed reason]` when the link ends); it returns that process's
pid (kill it to disconnect). The `:data` is the raw payload — `parse` it
yourself. Pair with `with-events` (std/editor/ui.blsp) to feed events into a `ui-run` loop.

On the server side, `headers` / `frame` / `emit` turn payloads into wire
frames: return `(http/stream-response 200 (headers) (fn (sock) … (emit sock
data) …))` from an `http` handler to push events to a browser `EventSource`."
  (:use http))

; reuse http/parse-url + http/request-headers for the handshake
;; The reader consumes UNTRUSTED server output. A malicious endpoint that never
;; sends the head's blank line, or an event with no `\n\n` frame boundary, would
;; grow the reader's buffer without bound → OOM. Cap the buffered head/leftover at
;; 16 MiB (SSE frames are tiny; this is purely a runaway guard); past it the
;; reader closes the socket and reports `[:sse-closed :buffer-overflow]`.
(def *max-buffer-bytes* (* 16 1024 1024))

;; ---- pure frame parsing -----------------------------------------------------

(defn- normalize (s)
  "Normalise line terminators to `\\n` (SSE allows `\\r\\n`, `\\r`, or `\\n`)."
  (string/replace (string/replace s "\r\n" "\n") "\r" "\n"))

(defn- frames (buf)
  "`[complete-event-blocks remainder]` extracted from accumulated stream text `buf`."
  ;; ONE native split, not a `substring` of the rest per block. The drain this replaced
  ;; re-copied the remainder of the buffer for every event, so a single socket read holding
  ;; k events cost O(k * chunk) — the `stream-lines` quadratic (2026-08-02) in another
  ;; module, and one 64 KB read is the normal case, not the pathological one.
  ;; `string-split` keeps a trailing empty piece, so the LAST piece is exactly the
  ;; remainder (`""` when the buffer ended on a blank line); an empty buffer splits to no
  ;; pieces at all, hence the guard. Covered by the `sse frames-1c` sweep row.
  (let (parts (string/split buf "\n\n"))
    (if (empty? parts) [nil ""] [(seq/drop-last parts 1) (last parts)])))

(defn- field (ev line)
  "Fold one SSE field `line` into event map `ev`. `data` lines accumulate (joined by
`\\n`); `event`/`id`/`retry` set their field; comment lines (`:`-prefixed) and blanks
are ignored. One optional space after the colon is stripped."
  (cond
    (= line "") ev
    (string/starts-with? line ":") ev
    else
      (let (i (index-of line ":")
            field (if (< i 0) line (string/substring line 0 i))
            raw (if (< i 0) "" (string/substring line (+ i 1) (string/length line)))
            val (if (string/starts-with? raw " ") (string/substring raw 1 (string/length raw)) raw))
        (cond
          (= field "data")
            (assoc ev
              :data (if (nil? (get ev :data)) val (str (get ev :data) "\n" val)))
          (= field "event") (assoc ev :event val)
          (= field "id") (assoc ev :id val)
          (= field "retry") (assoc ev :retry val)
          else ev))))

(defn- parse-event (block)
  "Parse one event `block` (its field lines) into `{:event :data :id …}`, defaulting
the type to `\"message\"` and the data to `\"\"` (the SSE spec's defaults). Pure."
  (let (ev (fold (string/split block "\n") {} field))
    (assoc ev :event (or (get ev :event) "message") :data (or (get ev :data) ""))))

(defn- status (head)
  "The numeric status from an HTTP response `head` (its first line), or 0."
  (let (line (first (string/split head "\n"))
        parts (string/split line " ")
        n (string/->number (nth parts 1 "0")))
    (if (nil? n) 0 n)))

;; ---- server-side framing (the inverse of the parser above) ------------------
;; Pair with `http`'s streaming seam: a handler returns `(stream-response 200
;; (headers) (fn (sock) … (emit sock data) …))`, and these turn payloads
;; into wire frames. Pure string building over `tcp/send` — the kernel adds nothing.

(defn headers ()
  "Headers for an event stream: `text/event-stream`, no caching, keep-alive. Pass as
the `headers` of a `stream-response` so a browser `EventSource` reads the open stream."
  {"Content-Type" "text/event-stream" "Cache-Control" "no-cache" "Connection" "keep-alive"})

(defn frame (data &optional (event nil))
  "One SSE frame for `data`: every line prefixed `data: ` (so multi-line payloads
round-trip), an optional `event:` type line first, terminated by the blank line.
The exact inverse of `parse-event`."
  (str (if (nil? event) "" (str "event: " event "\n"))
    (string/join (map (string/split data "\n") (fn (l) (str "data: " l))) "\n")
    "\n\n"))

(defn emit (sock data &optional (event nil))
  "Push one SSE event (`data`, with an optional `event` type) down `sock` — the live
socket a `stream-response` handler was handed. Just `(tcp/send sock (frame …))`."
  (tcp/send sock (frame data event)))

;; ---- the reader process (IO) ------------------------------------------------

(defn- stream (sock subscriber buf)
  "Process the buffered stream text `buf` — deliver every complete event to
`subscriber` — then wait for the next chunk and recurse. Notifies the subscriber
with `[:sse-closed reason]` when the socket closes or errors. Tail-recursive."
  (if (> (string/length buf) *max-buffer-bytes*)
    (do (tcp/close sock) (send subscriber [:sse-closed :buffer-overflow]))
    (let ([blocks rest] (frames buf))
      (doseq (b blocks)
        (when (not (= b ""))
          (send subscriber [:sse (parse-event b)])))
      (receive
        ([:tcp ^sock d] (stream sock subscriber (str rest (normalize d))))
        ([:tcp-closed ^sock] (send subscriber [:sse-closed :closed]))
        ([:tcp-error ^sock msg] (send subscriber [:sse-closed msg]))))))

(defn- read-head (sock subscriber buf)
  "Read until the HTTP response head's blank line, check the status, then hand the
leftover bytes to `stream`. A non-200 status closes the connection."
  (receive
    ([:tcp ^sock d] (let (buf2 (str buf (normalize d))
                          i (index-of buf2 "\n\n"))
                      (cond
                        (> (string/length buf2) *max-buffer-bytes*)
                          (do
                            (tcp/close sock)
                            (send subscriber
                              [:sse-closed :buffer-overflow]))
                        (< i 0) (read-head sock subscriber buf2)
                        else
                          (let (status (status (string/substring buf2 0 i))
                                body (string/substring buf2 (+ i 2) (string/length buf2)))
                            (if (= status 200)
                              (do
                                (send subscriber [:sse-open status])
                                (stream sock subscriber body))
                              (do
                                (tcp/close sock)
                                (send subscriber [:sse-closed (str "http " status)])))))))
    ([:tcp-closed ^sock] (send subscriber [:sse-closed :closed]))
    ([:tcp-error ^sock msg] (send subscriber [:sse-closed msg]))))

(defn connect (url subscriber)
  "Open an SSE stream to `url` (http) and deliver its events to `subscriber`'s mailbox
as `[:sse {:event :data :id}]` messages — `[:sse-open status]` once connected,
`[:sse-closed reason]` when it ends. Runs in a **new process** (so it parks on
`receive`, holding no worker) and returns that process's pid; `(exit pid :kill)` to
disconnect. The socket is owned by the reader process, so call this for the process
that should receive the events (typically the UI process — see `with-events`)."
  (let (u (http/parse-url url)
        req (str "GET "
              (get u :path)
              " HTTP/1.1\r\n"
              (http/render-headers (http/request-headers u
                                     ""
                                     {"Accept" "text/event-stream" "Connection" "keep-alive"}))
              "\r\n"))
    (spawn (let (sock (tcp/connect (get u :host) (get u :port)))
             (tcp/send sock req)
             (read-head sock subscriber "")))))
