;; std/registry.blsp — named registries a program fills as its modules load.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - A plugin-shaped program — an editor whose features each add a timer, an event
;;    handler, a status-bar chip — keeps tables that LOADING fills: each module adds its
;;    rows when it loads, and the core reads the table without naming any of them. bedit
;;    hand-wrote seventeen of these, each a `defonce` global re-bound with `def`, and every
;;    one carried the same three latent bugs the kernel's own registries were fixed for:
;;    two processes registering at once each read the old table and the later write drops
;;    the earlier row (KI-22/KI-23); a registration made inside an `%isolate` window is
;;    lost at the restore (KI-134/KI-141); and a global that loading MUTATES is invisible to
;;    the startup image, which carries only what loading creates (ADR-218, KI-106).
;;  - `%registry-update!` fixes all three — one locked read-modify-write, journalled for
;;    the isolate replay, recorded for the image with the module that made the write
;;    (KI-136) — but it names a registry by its fully qualified global, which a project
;;    module cannot spell (`model/*jobs*` in source is `bedit/model/*jobs*` at runtime; a
;;    bare name writes a root global of that name instead, silently).
;;  - So the registries live HERE, in one global, keyed by an id the caller chooses (a
;;    keyword — namespace it, `:model/idle-jobs`), then by entry key. `%registry-update!`'s
;;    two-level path is exactly that shape, so every registry gets the atomic write, the
;;    isolate replay and the image for free, and nobody spells a qualified global.
;;  - Entries are whatever the caller stores. Hooks in them are best stored as SYMBOLS and
;;    called late (`reflect/call-if-bound`): a redefinition then takes effect on the next
;;    call, and a hook whose module has not loaded yet is simply not there.

(defmodule registry
  "Named registries a program fills as its modules load — `put!` a row under a registry id
and a key, read them back with `entries` / `lookup` / `ranked`. Each write is atomic across
processes, survives an `%isolate` restore and is carried by the startup image."
  (:use memo)) ; defmemo — a table's rank order, computed once per change

;; id -> key -> entry. `defonce`: this file re-runs from its embedded source when a project
;; module `:use`s it on an imaged start, and a plain `def` would wipe what the image restored.
(defonce *registries* {})

(defn put! (id:any key:any entry:any -> any)
  "Register `entry` under `key` in the registry `id`, replacing any entry already there —
so a module that registers at load is safe to reload. Returns `entry`.

    (registry/put! :doc/greetings :en \"hello\")   ;=> \"hello\""
  (do (%registry-update! 'registry/*registries* :assoc [id key] entry) entry))

(defn put-new! (id:any key:any entry:any -> bool)
  "Register `entry` under `key` in the registry `id` only when nothing is there, in one locked
step, and answer whether it did — first one wins, so a key held this way is a runtime-wide
slot: two windows, two processes, cannot both take it.

    (registry/put-new! :doc/slots :only 1)   ;~> true the first time, false while it is held"
  (= true (%registry-update! 'registry/*registries* :assoc-new [id key] entry)))

(defn entries (id:any -> map)
  "The registry `id` as a map of key → entry — `{}` for a registry nothing has written.

    (do (registry/put! :doc/colours :red 1) (registry/entries :doc/colours))   ;=> {:red 1}"
  (let (table (get *registries* id))
    (if (map? table) table {})))

(defn remove! (id:any key:any -> bool)
  "Remove `key` from the registry `id`. True when there was an entry to remove.

    (do (registry/put! :doc/scratch :k 1) (registry/remove! :doc/scratch :k))   ;=> true"
  (and (contains? (entries id) key)
    (= true (%registry-update! 'registry/*registries* :dissoc [id key] nil))))

(defn lookup (id key &optional default)
  "The entry under `key` in the registry `id`, else `default` (nil).

    (do (registry/put! :doc/sizes :s 1) (registry/lookup :doc/sizes :s))   ;=> 1
    (registry/lookup :doc/sizes :xl 0)   ;=> 0"
  (get (entries id) key default))

(defn- rank-of (entry)
  (let (rank (and (map? entry) (get entry :rank)))
    (if (number? rank) rank 0)))

(defn- rank-order (table)
  ;; Sort keys computed ONCE per row, then compared — `sort-by` asks its key function on
  ;; every comparison, and a printed key per comparison made reading a fourteen-row
  ;; registry a visible slice of an editor's cursor blink.
  (map (seq/sort-by (map (%map-pairs table)
                      (fn ([key entry]) [(rank-of entry) (pr-str key) key entry]))
         (fn (row) [(nth row 0) (nth row 1)]))
    (fn (row) [(nth row 2) (nth row 3)])))

;; The order of a table is a pure function of the table, and a table only changes when
;; something registers — rare — while the order is read on hot paths (an idle beat, every
;; blink). `defmemo` compares by `=`, which is immediate for the very map it saw last.
(defmemo ranked-table 16 (table)
  "`table`'s `[key entry]` rows in rank order — the memoised half of [[ranked]], public only
because `defmemo` defines a public function.

    (registry/ranked-table {:b {:rank 2} :a {:rank 1}})   ;=> ([:a {:rank 1}] [:b {:rank 2}])"
  (rank-order table))

(defn ranked (id:any -> list)
  "The registry `id`'s rows as `[key entry]` pairs, in order of each entry's `:rank` (a
number; 0 for an entry with none, or that is not a map), ties broken by the printed key —
so the order never depends on which module happened to load first.

    (do (registry/put! :doc/steps :b {:rank 2}) (registry/put! :doc/steps :a {:rank 1}) (map (registry/ranked :doc/steps) first))   ;=> (:a :b)"
  (let (order (ranked-table (entries id))) (if (list? order) order (list))))

;; ---- who wrote an entry, and taking it back (ADR-582) --------------------------------
;; The kernel journals who made each registry write that APPLIED (KI-136, ADR-582): the
;; module whose load made it (a symbol), or — for a load with no namespace, a file without a
;; `defmodule` — that file, by its absolute path (a string). A map entry is journalled by its
;; key path, a list registry's member by its position, matched with the same `=` `:remove`
;; uses. That is enough for a program that loads plugins to take back everything one
;; registered — here, in a std table (`editor/layers`, `editor/face`) or anywhere else —
;; without each registry keeping its own ownership.
;;
;; A write made at run time, outside any load, credits the process's ACTING WRITER (ADR-596):
;; the load that spawned the process, or the spawner's own acting writer, or what
;; [[with-acting-writer]] set — so a timer, a task or a worker a plugin started registers as
;; the plugin, and taking the plugin back takes those writes too. A process with none (the
;; program, anything spawned outside a load) credits nobody.

(defn acting-writer (-> any)
  "Who a registry write this process makes outside any load credits: the module (a symbol)
or namespace-less file (its absolute path, a string) whose load spawned it or one of its
ancestors, or what [[with-acting-writer]] set — nil when nobody.

    (registry/acting-writer)   ;~> nil — in a process nothing spawned under a load"
  (%acting-writer))

(defn with-acting-writer (writer:any thunk:any -> any)
  "Call `thunk` with the registry writes it makes outside a load — and those of every
process it spawns, a timer's included — credited to `writer` (a module symbol, a file's
absolute path, or nil for nobody), and answer what it answers. A program that runs a
plugin's code at run time (a command, a hook) says whose code it is with this, so what the
plugin registers there is [[written-by]] the plugin.

    (registry/with-acting-writer 'my-plugin (fn () (registry/acting-writer)))   ;=> my-plugin"
  (let (previous (%set-acting-writer! writer))
    (try (thunk) (finally (%set-acting-writer! previous)))))

(defn writer (id:any key:any -> any)
  "Who wrote the entry under `key` in the registry `id`: the module whose load wrote it (a
symbol), the namespace-less file whose load did (its absolute path, a string), or nil (a
root or run-time write, or no entry).

    (registry/writer :doc/nobody :k)   ;=> nil"
  (%registry-writer 'registry/*registries* [id key]))

(def- module-state-registries
  #{'*features*
    '*features-loading* '*require-edges* '*module-files* '*impls* '*impl-from* '*impl-tiers*
    '*impl-shadowed*})
;; The module system's own bookkeeping, which a write-back would corrupt: what is loaded,
;; the require edges, where a package's modules are, and the ability impls (retired with
;; the definitions they name, by `reflect/undef`).

(defn written-by (writers:set -> vector)
  "Every registry entry a load by one of `writers` wrote and that is still there — each
writer a module symbol, or a namespace-less file's absolute path (a string): `{:global sym
:path [k …] :value v :writer w}` for a map entry (one or two keys deep), `{:global sym :member
v :writer w}` for a member of a LIST registry (`editor/layers`' `*system-layers*`). What
[[retract]] takes back and [[restore]] puts back over. The module system's own bookkeeping is
not listed, and neither are a vector-valued global's elements: no registry op adds one.

    (registry/written-by #{'nobody/at-all})   ;=> []"
  ;; only the registries the journal says these writers wrote into (ADR-604), not every one
  (fold (%registries-written-by (vec writers))
    []
    (fn (found global)
      (let (value (if (bound? global) (reflect/eval global) nil)
            writer-at (fn (path)
                        (let (who (%registry-writer global path))
                          (when (contains? writers who) who))))
        (cond
          (contains? module-state-registries global) found
          (map? value)
            (fold value
              found
              (fn (acc entry)
                (let ([outer inner] entry
                      who (writer-at [outer]))
                  (cond
                    who (conj acc {:global global :path [outer] :value inner :writer who})
                    (map? inner)
                      (fold inner
                        acc
                        (fn (deeper pair)
                          (let ([key nested] pair
                                nested-who (writer-at [outer key]))
                            (if nested-who
                              (conj deeper
                                {:global global :path [outer key] :value nested :writer nested-who})
                              deeper))))
                    else acc))))
          (list? value)
            (fold value
              found
              (fn (acc member)
                (let (who (writer-at [member]))
                  (if who (conj acc {:global global :member member :writer who}) acc))))
          else found)))))

(defn retract (write:map -> bool)
  "Take back one registry write [[written-by]] listed: dissoc its `:path`, or remove its
`:member` from the list — only while the entry is still credited to the write's `:writer`,
checked in the same locked step as the removal, so an entry another load has written since
is left alone. An operation like the write was, so a load journal replays it and an isolate
restore keeps it. True when there was something to take back.

    (registry/retract {:global 'registry/*registries* :path [:doc/none :k]})   ;=> false"
  (if (contains? write :member)
    (= true (%registry-update! (:global write) :remove [] (:member write) nil (:writer write)))
    (let (path (:path write)
          table (if (bound? (:global write)) (reflect/eval (:global write)) nil)
          present? (if (= (count path) 1)
                     (and (map? table) (contains? table (first path)))
                     (let (inner (and (map? table) (get table (first path))))
                       (and (map? inner) (contains? inner (second path))))))
      (and present?
        (= true (%registry-update! (:global write) :dissoc path nil nil (:writer write)))))))

(defn restore (write:map value:any &optional credit:any -> bool)
  "Put `value` back at the map entry [[written-by]] listed as `write` (its `:global` and
`:path`) — what the write REPLACED, so taking a plugin back leaves the entry as it was before
rather than gone. When `write` has a `:writer`, only while the entry is still credited to it
(checked in the same locked step), so an entry another load has written since is left alone.
The entry is then credited to `credit` — a module symbol or a file path, the writer of the
value being put back — or to nobody at all when `credit` is nil (never to whoever is loading).
An operation like the write was (journalled with a load, kept by an isolate restore). True
when it was written.

    (do (registry/put! :doc/restored :k 1) (registry/restore {:global 'registry/*registries* :path [:doc/restored :k]} 2) (registry/lookup :doc/restored :k))   ;=> 2"
  (= true
    (%registry-update! (:global write)
      :assoc (:path write)
      value
      (if (nil? credit) false credit)
      (:writer write))))

;; ---- ability impls a module registered (ADR-603, ADR-604) ------------------------------
;; `written-by` leaves the impl tables out: an impl is retired with the type it is for
;; (`reflect/undef`), and a write-back would corrupt them. But a plugin's `impl` of an ability
;; for a type it does not own — a core ability, a core type — outlives the plugin that way,
;; calling a helper that is gone. Every registration is kept by precedence tier with the
;; namespace that made it (`*impl-tiers*`, ADR-432), and one a same-tier registration from
;; another namespace replaced is kept under it (`*impl-shadowed*`), so one module's can be
;; found and taken back exactly: the tier below winning again, or the impl it replaced.

(defn impls-by (writers:set)
  "Every ability impl a namespace in `writers` (module symbols) registered and that is still
registered — the one dispatch finds in its tier, or one a later registration of the same tier
replaced (`:shadowed? true`): `{:ability :op :key :rank :from :shadowed?}`, what
[[retract-impl]] takes back. An impl from code of no module (a file without a `defmodule`,
the REPL) is credited to nobody.

    (registry/impls-by #{'nobody/at-all})   ;=> []"
  (let (listed (fn (found slot rank registered shadowed?)
                 (let ([ability op key] slot)
                   (if (contains? writers (second registered))
                     (conj found
                       {:ability ability
                        :op op
                        :key key
                        :rank rank
                        :from (second registered)
                        :shadowed? shadowed?})
                     found))))
    (fold (%map-pairs (or *impl-shadowed* {}))
      (fold (%map-pairs (or *impl-tiers* {}))
        []
        (fn (found entry)
          (let ([slot tiers] entry)
            (fold (%map-pairs tiers)
              found
              (fn (acc tier) (listed acc slot (first tier) (second tier) false))))))
      (fn (found entry)
        (let ([slot tiers] entry)
          (fold (%map-pairs tiers)
            found
            (fn (acc tier)
              (fold (second tier)
                acc
                (fn (deeper registered) (listed deeper slot (first tier) registered true))))))))))

(defn- reinstate-winner (slot)
  ;; dispatch for `slot` set to its highest tier left, or unclaimed with none
  (let (op-key [(first slot) (second slot)]
        key (nth slot 2)
        best (fold (%map-pairs (or (get (or *impl-tiers* {}) slot) {}))
               nil
               (fn (winner tier)
                 (if (or (nil? winner) (> (first tier) (first winner))) tier winner))))
    (if (nil? best)
      (do
        (%registry-update! '*impls* :dissoc [op-key key] nil)
        (%registry-update! '*impl-from* :dissoc [slot] nil)
        (%registry-update! '*impl-tiers* :dissoc [slot] nil)
        (%registry-update! '*impl-shadowed* :dissoc [slot] nil))
      (do
        (%registry-update! '*impls* :assoc [op-key key] (first (second best)))
        (%registry-update! '*impl-from* :assoc [slot] (second (second best)))))))

(defn retract-impl (impl:map -> bool)
  "Take back one impl [[impls-by]] listed — only while it is still that namespace's
registration — and answer whether it did. Where it had replaced another namespace's impl in
its tier, that one is put back; dispatch then finds the highest tier left for the slot (a core
impl the plugin's outranked, or the one it replaced); with none left the slot is unclaimed,
as before anything implemented it. A replaced impl taken back just leaves the stack.

    (registry/retract-impl {:ability 'Nobody :op 'op :key :none :rank 1 :from 'nobody})   ;=> false"
  (let (slot [(:ability impl) (:op impl) (:key impl)]
        rank (:rank impl)
        from (:from impl)
        registered (get (or (get (or *impl-tiers* {}) slot) {}) rank)
        replaced (or (get (or (get (or *impl-shadowed* {}) slot) {}) rank) '())
        others (reverse (fold replaced
                          '()
                          (fn (kept entry) (if (= (second entry) from) kept (cons entry kept))))))
    (cond
      (and (not (:shadowed? impl)) registered (= (second registered) from))
        (do
          (if (empty? others)
            (%registry-update! '*impl-tiers* :dissoc [slot rank] nil)
            (do
              (%registry-update! '*impl-tiers* :assoc [slot rank] (first others))
              (%registry-update! '*impl-shadowed* :assoc [slot rank] (rest others))))
          (reinstate-winner slot)
          true)
      (and (:shadowed? impl) (< (count others) (count replaced)))
        (do (%registry-update! '*impl-shadowed* :assoc [slot rank] others) true)
      else false)))
