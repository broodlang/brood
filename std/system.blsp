;; std/system.blsp — the Brood runtime's own surface (argv, exit, build identity).

(defmodule system
  "The Brood RUNTIME itself: this process's arguments, how it exits, and which build it is.
Distinct from `os`, which is the OPERATING SYSTEM around it (`os/env`, `os/cmd`, `os/spawn`).

    (system/argv)            ;; => [\"brood\" \"script.blsp\"]
    (system/script-args)     ;; => [\"--verbose\"]   — everything after `--`
    (system/brood-version)   ;; => \"0.25.0\"
    (system/halt 0)          ;; exit with code 0

The environment/subprocess half moved to `os` on 2026-08-27: `system/env` was literally
`(os/getenv name)`, so one function had two names in two modules.")

;; ---- environment ------------------------------------------------------------

;; ---- process identity -------------------------------------------------------

(defn argv ()
  "Command-line arguments as a vector of strings, including `argv[0]` (the binary).

  This is the RAW invocation, host CLI and all — for `brood run.blsp -- --verbose` it is
  `[\"brood\" \"run.blsp\" \"--\" \"--verbose\"]`. A script wanting its own options wants
  [[script-args]] instead; finding them here means knowing where brood's arguments stop,
  which is knowing brood's parser."
  (%argv))

(defn script-args ()
  "The arguments meant for this program, without the host CLI's own — everything after
  `--`, so `brood run.blsp -- --verbose x` gives `[\"--verbose\" \"x\"]`.

  A script could not take options at all before this: every trailing argument parsed as
  another FILE to run, so `-- --verbose` made brood try to open a file by that name and
  die. The workaround was to configure scripts through the environment.

  For a bundled app (`nest release`), which boots before any CLI parsing and owns its whole
  argv, this is everything after `argv[0]` — so a bundled program and a script see the same
  shape."
  (%script-args))

;; ---- subprocess -------------------------------------------------------------

;; ---- process control --------------------------------------------------------

(defn halt (& args)
  "Exit the process. `(halt)` exits with code 0; `(halt n)` exits with code `n`."
  (%halt (if (nil? args) 0 (first args))))

;; ---- build identity ----------------------------------------------------------
;; `feature?` lived in `std/prelude/string.blsp` — a module-system predicate in the string
;; file, which is simply where it landed rather than where it belongs. It asks what THIS
;; RUNTIME was built with, so it belongs beside `system/brood-version` and `system/build-id`.

(defn feature? (name)
  "True if this runtime was built with the optional feature `name` (a keyword —
`:gui`, `:jit`, `:audio`, `:treesit`, …). See `(system/features)` for the whole list.

Reach for this instead of `bound?` when a capability is optional: a builtin from
an absent feature is still **bound** and still raises when called, so `(bound?
'gui/open)` answers yes on a runtime that cannot open a window. An app that wants
to degrade rather than fail asks the build."
  (includes? (system/features) name))

;; ---- module system -----------------------------------------------------------
;; Where modules load from, and what the image knows about them. Runtime configuration,
;; so it belongs here rather than bare.
;;
;; `reflect/builtin-modules` and `reserved-package-name?` deliberately did NOT come along: they are
;; called from `%merge-require-edges!` and `%require-force-package` — the module-LOADING
;; path itself — so moving them here would mean loading `system` requires `system`.

(defn module-doc (mod)
  "The docstring declared by `(defmodule mod …)` (a symbol or string), or nil."
  (get *module-docs* (->string mod)))
