;; std/system.blsp — OS/process interface.

(defmodule system
  "OS and process utilities: environment, argv, subprocess execution, OS type.

    (system/env \"HOME\")               ;; => \"/home/alice\"
    (system/env-all)                    ;; => {:HOME \"/home/alice\" ...}
    (system/argv)                       ;; => [\"brood\" \"script.blsp\"]
    (system/os-type)                    ;; => :linux
    (system/cwd)                        ;; => \"/home/alice/project\"
    (system/os/hostname)                   ;; => \"mymachine\"

    (def r (system/cmd \"git\" [\"log\" \"--oneline\" \"-3\"]))
    (get r :stdout)                     ;; => \"abc1234 ...\n...\"
    (get r :exit)                       ;; => 0

    (system/halt 0)                     ;; exit with code 0")

;; ---- environment ------------------------------------------------------------

(defn env (name)
  "The value of environment variable `name` as a string, or nil if unset."
  (os/getenv name))

(defn env-all ()
  "All environment variables as a `{string → string}` map."
  (%env-all))

;; ---- process identity -------------------------------------------------------

(defn argv ()
  "Command-line arguments as a vector of strings, including `argv[0]` (the binary).

  This is the RAW invocation, host CLI and all — for `brood run.blsp -- --verbose` it is
  `[\"brood\" \"run.blsp\" \"--\" \"--verbose\"]`. A script wanting its own options wants
  [[script-args]] instead; finding them here means knowing where brood's arguments stop,
  which is knowing brood's parser."
  (%argv))

(defn script-args ()
  "The arguments meant for this program, without the host CLI's own — everything after
  `--`, so `brood run.blsp -- --verbose x` gives `[\"--verbose\" \"x\"]`.

  A script could not take options at all before this: every trailing argument parsed as
  another FILE to run, so `-- --verbose` made brood try to open a file by that name and
  die. The workaround was to configure scripts through the environment.

  For a bundled app (`nest release`), which boots before any CLI parsing and owns its whole
  argv, this is everything after `argv[0]` — so a bundled program and a script see the same
  shape."
  (%script-args))

(defn os-type ()
  "The current OS as a keyword: `:linux`, `:macos`, or `:windows`."
  (%os-type))

;; ---- subprocess -------------------------------------------------------------

(defn cmd (prog & rest)
  "Run `prog` (a string) and return `{:stdout s :stderr s :exit n}`.
An optional second argument is a list or vector of string arguments.

    (system/cmd \"ls\" [\"-la\" \"/tmp\"])
    (system/cmd \"date\")"
  (let (args (if (nil? rest) nil (first rest)))
    (if (nil? args)
      (%os-cmd prog)
      (%os-cmd prog args))))

(defn cmd-ok? (result)
  "True if the command result has exit code 0."
  (= (get result :exit) 0))

(defn cmd-out (result)
  "The stdout string from a `cmd` result, trimmed."
  (string/trim (get result :stdout "")))

;; ---- process control --------------------------------------------------------

(defn halt (& args)
  "Exit the process. `(halt)` exits with code 0; `(halt n)` exits with code `n`."
  (%halt (if (nil? args) 0 (first args))))
