;; std/sudo.blsp — reading and writing a file as another user, through `sudo` (ADR-588).
(defmodule sudo
  "Reading and writing a file as another user — root by default — through `sudo`: what an
editor needs to edit `/etc/hosts` (Emacs's TRAMP `/sudo::` method), and what an installer or
a script fixing a system file needs too.

A password is the CALLER's to ask for and is never kept here: it is handed to `sudo` on its
standard input for one validation (`sudo -S -v`), so sudo's own credential cache — its
timestamp, as for a `sudo` typed in a shell — is what lets the next call go without one. The
file's text never shares a stream with the password: every command runs as `sudo -n`, which
never reads a password, after the validation (or after `password-required?` said none is
needed). A sudo configured to cache nothing (`timestamp_timeout=0`) gets the password and
the command in one call, with `-k`, so the password is the line sudo reads first.

Whether a failed `sudo -n` was SUDO wanting a password, or the command failing, is told by
asking sudo again — `sudo -n true` — not by its message: classic sudo says \"a password is
required\", sudo-rs \"interactive authentication is required\", and either may be translated.

A file is READ as its bytes (`read-bytes`, through `base64`, so nothing is lost to a text
decode); `read` is its text, refused when the bytes are not UTF-8. A WRITE goes to a temporary
file beside the file — given its owner, mode, ACLs, extended attributes and SELinux context —
which is renamed over it, so a full disk or a killed pipe leaves the old file whole. Where a
rename cannot be had it writes in place instead: a file with other hard links (a rename would
part it from them), a directory the user may not write, a file bind-mounted into a container
(the rename refused, EBUSY). A symbolic link is written through (its target replaced, the
link kept). The temporary file is removed on every exit the shell sees, and one a SIGKILL
left is cleared by the next write.

`sudo/*program*` names the sudo to run — a test binds a stand-in script, so no test runs the real
one; `opts`' `:program` does the same for one call.

    (sudo/password-required? {:program \"false\"})   ;=> true")

(defdyn sudo/*program* "sudo")
;; The sudo program run — a path or a name on `PATH`. A test binds a stand-in.

(def- sudo-env
  ;; sudo's messages in English where it can be asked — read only to say why a call failed
  {"LC_ALL" "C" "LANG" "C"})

(defn- program-of (opts)
  (or (:program opts) sudo/*program*))

(defn- user-args (opts)
  (if (:user opts) ["-u" (:user opts)] []))

(defn password-required? (&optional (opts {}))
  "Whether running a command through sudo needs a password typed NOW — false when sudo's
policy needs none (`NOPASSWD`) or its credential cache still holds one from an earlier
call. Asks `sudo -n -v`, which never prompts. `opts` `:program` overrides `sudo/*program*`.

    (sudo/password-required? {:program \"true\"})   ;=> false"
  (not (= 0 (:exit (os/cmd (program-of opts) ["-n" "-v"] {:env sudo-env})))))

(defn- sudo-refused? (opts result)
  "Whether `result`, a `sudo -n` run that failed, failed because sudo would not run the
command without a password — told by asking sudo whether it would run `true` as the same
user, never by its message (classic sudo and sudo-rs word it differently)."
  (and (not (= 0 (:exit result)))
    (not (= 0
           (:exit (os/cmd (program-of opts)
                    (append ["-n"] (user-args opts) ["--" "true"])
                    {:env sudo-env}))))))

(defn- failure-of (who result)
  (failure (str "sudo/"
             who
             ": "
             (let (said (string/trim (or (:stderr result) "")))
               (if (= said "") (str "exit " (:exit result)) said)))))

(defn- run-as (opts who command input own-exits)
  "Run `command` (a vector) through sudo as `opts`' user with `input` on its stdin: the
command's result map — whatever its exit — or a failure when sudo itself refused (a wrong
password, none given when one is required). See the module doc for how a password goes."
  (let (program (program-of opts)
        password (:password opts)
        validated (when password
                    (os/cmd program ["-S" "-p" "" "-v"] {:stdin (str password "\n") :env sudo-env})))
    (if (and validated (not (= 0 (:exit validated))))
      (failure-of who validated)
      (let (result (os/cmd program
                     (append ["-n"] (user-args opts) ["--"] command)
                     {:stdin input :env sudo-env}))
        (cond
          ;; an exit the command itself chose (the read's 3: no file) is its answer — never
          ;; sudo's, which a probe would wrongly say it is when sudo caches nothing
          (or (contains? own-exits (:exit result)) (not (sudo-refused? opts result))) result
          ;; validated, yet sudo keeps no cache: the password and the input in one call,
          ;; `-k` so the password is the line sudo reads before the command sees any
          password
            (let (once (os/cmd program
                         (append ["-S" "-k" "-p" ""] (user-args opts) ["--"] command)
                         {:stdin (str password "\n" input) :env sudo-env}))
              (if (and (not (contains? own-exits (:exit once))) (sudo-refused? opts once))
                (failure-of who once)
                once))
          else (failure (str "sudo/" who ": a password is required")))))))

;; the file's bytes as Base64 (no text decode can lose one), a missing file told by exit 3
(def- read-script "if [ -e \"$1\" ]; then exec base64 < \"$1\"; else exit 3; fi")

(defn read-bytes (path &optional (opts {}))
  "The bytes of the file at `path`, read as `opts`' `:user` (root by default) through sudo;
nil when no file is there; a failure when sudo refuses or the read fails — `sudo/read: a
password is required` when one is and `opts` has no `:password`. Byte-faithful: the file
comes through `base64`, so a binary or a file in another encoding arrives exactly.

    (sudo/read-bytes \"/etc/shadow\" {:password typed})   ;~> the file's bytes, or a failure"
  (let (result (run-as opts "read" ["sh" "-c" read-script "sh" path] "" #{0 3}))
    (cond
      (failure? result) result
      (= 0 (:exit result))
        (encoding/base64-decode-bytes (string/replace (string/replace (:stdout result) "\n" "")
                                        "\r" ""))
      (= 3 (:exit result)) nil
      else (failure-of "read" result))))

(defn read (path &optional (opts {}))
  "The text of the file at `path`, read as `opts`' `:user` through sudo (`read-bytes`): nil
when no file is there; a failure when sudo refuses, the read fails, or the file is not UTF-8
text — never a text with its undecodable bytes replaced, which a save would write back over
the file. `:password` is handed to sudo once and kept nowhere; `:program` overrides
`sudo/*program*`.

    (sudo/read \"/etc/hosts\" {:password typed})   ;~> the file's text, or a failure"
  (let (bytes (read-bytes path opts))
    (cond
      (or (nil? bytes) (failure? bytes)) bytes
      else
        (check-allow :discarded-catch
          (try
            (string/bytes-> bytes)
            (catch _
              (failure (str "sudo/read: " path " is not UTF-8 text (sudo/read-bytes reads it)"))))))))

;; The write, as the target user. Its own failures exit 4 (so they are never taken for sudo's
;; refusal). Through a symbolic link to its target. In place — `cat > FILE` — when a rename
;; cannot be had: the file has other hard links, no temporary file can be made beside it (a
;; user who may write the file but not its directory), or the rename itself is refused (a file
;; bind-mounted into a container, /etc/hosts under Docker: EBUSY). Otherwise a temporary file
;; beside it, given the file's owner, mode, ACLs, extended attributes and SELinux context
;; (`cp --preserve=all --attributes-only`, else `cp -p`; `chcon --reference`; the ACL copied
;; with getfacl/setfacl), or the umask's mode for a new file, filled, and renamed over it. The
;; temporary file is removed on every way out the shell sees (EXIT, HUP, INT, TERM), and one a
;; SIGKILL left behind is cleared by the next write.
(def- write-script
  (str "target=$1\n"
    "if [ -L \"$target\" ]; then resolved=$(readlink -f \"$target\") && target=$resolved; fi\n"
    "in_place() { cat > \"$target\" || exit 4; exit 0; }\n" "if [ -e \"$target\" ]; then\n"
    "  links=$(ls -ld -- \"$target\" | awk '{print $2}')\n"
    "  if [ \"$links\" -gt 1 ]; then in_place; fi\n" "fi\n" "dir=$(dirname \"$target\")\n"
    "find \"$dir\" -maxdepth 1 -name '.sudo-write.*' -type f -mmin +1 -exec rm -f {} + 2>/dev/null\n"
    "tmp=$(mktemp \"$dir/.sudo-write.XXXXXX\" 2>/dev/null) || in_place\n"
    "trap 'rm -f -- \"$tmp\"' EXIT\n" "trap 'exit 4' HUP INT TERM\n" "if [ -e \"$target\" ]; then\n"
    "  cp --preserve=all --attributes-only -- \"$target\" \"$tmp\" 2>/dev/null"
    " || cp -p -- \"$target\" \"$tmp\" 2>/dev/null || { rm -f -- \"$tmp\"; in_place; }\n"
    "  if command -v chcon >/dev/null 2>&1; then chcon --reference=\"$target\" -- \"$tmp\" 2>/dev/null; fi\n"
    "  if command -v getfacl >/dev/null 2>&1 && command -v setfacl >/dev/null 2>&1; then\n"
    "    getfacl -p -- \"$target\" 2>/dev/null | setfacl --set-file=- -- \"$tmp\" 2>/dev/null\n"
    "  fi\n" "else\n" "  chmod \"$(printf '%o' $((0666 & ~$(umask))))\" \"$tmp\"\n" "fi\n"
    "cat > \"$tmp\" || exit 4\n" "if mv -f -- \"$tmp\" \"$target\" 2>/dev/null; then exit 0; fi\n"
    "cat -- \"$tmp\" > \"$target\" || exit 4\n" "exit 0\n"))

(defn write (path text &optional (opts {}))
  "Write `text` to the file at `path` as `opts`' `:user` (root by default) through sudo,
replacing what it held — atomically: a temporary file beside it, the file's owner and mode
copied, renamed over it, so a failure halfway leaves the old file whole (see the module doc
for links) — and creating it when it does not exist. True, or a failure as `sudo/read`
gives one.

    (sudo/write \"/etc/hosts\" text {:password typed})   ;~> true, or a failure"
  (let (result (run-as opts "write" ["sh" "-c" write-script "sh" path] text #{0 4}))
    (cond
      (failure? result) result
      (= 0 (:exit result)) true
      else (failure-of "write" result))))
