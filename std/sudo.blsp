;; std/sudo.blsp — reading and writing a file as another user, through `sudo` (ADR-588).
(defmodule sudo
  "Reading and writing a file as another user — root by default — through `sudo`: what an
editor needs to edit `/etc/hosts` (Emacs's TRAMP `/sudo::` method), and what an installer or
a script fixing a system file needs too.

A password is the CALLER's to ask for and is never kept here: it is handed to `sudo` on its
standard input for one validation (`sudo -S -v`), so sudo's own credential cache — its
timestamp, as for a `sudo` typed in a shell — is what lets the next call go without one. The
file's text never shares a stream with the password: every command runs as `sudo -n`, which
never reads a password, after the validation (or after `password-required?` said none is
needed). A sudo configured to cache nothing (`timestamp_timeout=0`) gets the password and
the command in one call, with `-k`, so the password is the line sudo reads first.

Whether a failed `sudo -n` was SUDO wanting a password, or the command failing, is told by
asking sudo again — `sudo -n true` — not by its message: classic sudo says \"a password is
required\", sudo-rs \"interactive authentication is required\", and either may be translated.

A file is READ as its bytes (`read-bytes`, through `base64`, so nothing is lost to a text
decode); `read` is its text, refused when the bytes are not UTF-8. A WRITE never puts text
over the file until all of it has arrived: it is staged in a temporary file and checked
against the byte count and SHA-256 the caller sent, so a caller killed halfway — its pipe
closed early — leaves the file as it was. The stage, beside the file and given its owner,
mode, ACLs, extended attributes and SELinux context, is then renamed over it. Where a rename
cannot be had — a file with other hard links (a rename would part it from them), a directory
the user may not write (the stage is then in $TMPDIR), a file bind-mounted into a container
(the rename refused, EBUSY) — the checked text is copied into the file, its old text kept
aside and put back if the copy does not land whole — or if a signal (C-g, a hang-up) cuts the
copy off: the old text is removed only once the file is known whole. A symbolic link is written
through (its target replaced, the link kept). The temporary files are removed on every exit the
shell sees. An old text a SIGKILL left mid-copy is never aged out: the next write to that file
refuses, naming where the old text is, unless the file holds it again. Other leftovers are
removed by a later write once a day old, never while another writer may be filling them.

`sudo/*program*` names the sudo to run — a test binds a stand-in script, so no test runs the real
one; `opts`' `:program` does the same for one call.

    (sudo/password-required? {:program \"false\"})   ;=> true")

(defdyn sudo/*program* "sudo")
;; The sudo program run — a path or a name on `PATH`. A test binds a stand-in.

(def- sudo-env
  ;; sudo's messages in English where it can be asked — read only to say why a call failed
  {"LC_ALL" "C" "LANG" "C"})

(def- prompting-env
  ;; a call that hands sudo the password on its stdin (`-S`): no prompt, asked for through
  ;; `SUDO_PROMPT` rather than `-p ""` — sudo-rs before 0.2.5 (Ubuntu 24.04's) refuses `-p`
  ;; outright, and classic sudo and later sudo-rs read the variable as they read the flag
  (assoc sudo-env "SUDO_PROMPT" ""))

(def- old-sudo-rs-prompt
  ;; what a sudo-rs that ignores SUDO_PROMPT writes on stderr before reading the password:
  ;; `[sudo: authenticate] Password: `, or `[sudo: authenticate as alice] …`
  "\\[sudo: [^\\]\\n]*\\] [Pp]assword: ?")

(defn- without-prompt (said)
  "`said`, a sudo call's stderr, without the password prompt an old sudo-rs writes there
whatever `SUDO_PROMPT` says — so a failure reads as sudo's message, and a command's own
stderr as the command's."
  (regex/replace (or said "") old-sudo-rs-prompt ""))

(defn- program-of (opts)
  (or (:program opts) sudo/*program*))

(defn- user-args (opts)
  (if (:user opts) ["-u" (:user opts)] []))

(defn password-required? (&optional (opts {}))
  "Whether running a command through sudo needs a password typed NOW — false when sudo's
policy needs none (`NOPASSWD`) or its credential cache still holds one from an earlier
call. Asks `sudo -n -v`, which never prompts. `opts` `:program` overrides `sudo/*program*`.

    (sudo/password-required? {:program \"true\"})   ;=> false"
  (not (= 0 (:exit (os/cmd (program-of opts) ["-n" "-v"] {:env sudo-env})))))

(defn- sudo-refused? (opts result)
  "Whether `result`, a `sudo -n` run that failed, failed because sudo would not run the
command without a password — told by asking sudo whether it would run `true` as the same
user, never by its message (classic sudo and sudo-rs word it differently)."
  (and (not (= 0 (:exit result)))
    (not (= 0
           (:exit (os/cmd (program-of opts)
                    (append ["-n"] (user-args opts) ["--" "true"])
                    {:env sudo-env}))))))

(defn- failure-of (who result)
  (failure (str "sudo/"
             who
             ": "
             (let (said (string/trim (without-prompt (:stderr result))))
               (if (= said "") (str "exit " (:exit result)) said)))))

(defn- run-as (opts who command input own-exits)
  "Run `command` (a vector) through sudo as `opts`' user with `input` on its stdin: the
command's result map — whatever its exit — or a failure when sudo itself refused (a wrong
password, none given when one is required). See the module doc for how a password goes."
  (let (program (program-of opts)
        password (:password opts)
        validated (when password
                    (os/cmd program ["-S" "-v"] {:stdin (str password "\n") :env prompting-env})))
    (if (and validated (not (= 0 (:exit validated))))
      (failure-of who validated)
      (let (result (os/cmd program
                     (append ["-n"] (user-args opts) ["--"] command)
                     {:stdin input :env sudo-env}))
        (cond
          ;; an exit the command itself chose (the read's 3: no file) is its answer — never
          ;; sudo's, which a probe would wrongly say it is when sudo caches nothing
          (or (contains? own-exits (:exit result)) (not (sudo-refused? opts result))) result
          ;; validated, yet sudo keeps no cache: the password and the input in one call,
          ;; `-k` so the password is the line sudo reads before the command sees any
          password
            (let (once (os/cmd program
                         (append ["-S" "-k"] (user-args opts) ["--"] command)
                         {:stdin [(str password "\n") (or input "")] :env prompting-env}))
              (if (and (not (contains? own-exits (:exit once))) (sudo-refused? opts once))
                (failure-of who once)
                (assoc once :stderr (without-prompt (:stderr once)))))
          else (failure (str "sudo/" who ": a password is required")))))))

;; the file's bytes as Base64 (no text decode can lose one), a missing file told by exit 3
(def- read-script "if [ -e \"$1\" ]; then exec base64 < \"$1\"; else exit 3; fi")

(defn read-bytes (path &optional (opts {}))
  "The bytes of the file at `path`, read as `opts`' `:user` (root by default) through sudo;
nil when no file is there; a failure when sudo refuses or the read fails — `sudo/read: a
password is required` when one is and `opts` has no `:password`. Byte-faithful: the file
comes through `base64`, so a binary or a file in another encoding arrives exactly.

    (sudo/read-bytes \"/etc/shadow\" {:password typed})   ;~> the file's bytes, or a failure"
  (let (result (run-as opts "read" ["sh" "-c" read-script "sh" path] "" #{0 3}))
    (cond
      (failure? result) result
      (= 0 (:exit result))
        (encoding/base64-decode-bytes (string/replace (string/replace (:stdout result) "\n" "")
                                        "\r" ""))
      (= 3 (:exit result)) nil
      else (failure-of "read" result))))

(defn read (path &optional (opts {}))
  "The text of the file at `path`, read as `opts`' `:user` through sudo (`read-bytes`): nil
when no file is there; a failure when sudo refuses, the read fails, or the file is not UTF-8
text — never a text with its undecodable bytes replaced, which a save would write back over
the file. `:password` is handed to sudo once and kept nowhere; `:program` overrides
`sudo/*program*`.

    (sudo/read \"/etc/hosts\" {:password typed})   ;~> the file's text, or a failure"
  (let (bytes (read-bytes path opts))
    (cond
      (or (nil? bytes) (failure? bytes)) bytes
      else
        (check-allow :discarded-catch
          (try
            (string/bytes-> bytes)
            (catch _
              (failure (str "sudo/read: " path " is not UTF-8 text (sudo/read-bytes reads it)"))))))))

;; The write, as the target user: `sh -c write-script sh PATH BYTES SHA256`. Its own failures
;; exit 4 (so they are never taken for sudo's refusal).
;;
;; The text is STAGED first, never written straight over anything: into a temporary file beside
;; the file (or, where the user may not write the directory, one in $TMPDIR), and checked —
;; exactly BYTES bytes, and the SHA256 when `sha256sum` is there — before anything is replaced.
;; A caller killed halfway (C-g, a timeout, a hang-up) closes the pipe early: `cat` sees EOF
;; and stops short, and the check refuses the partial text, so the file is left as it was.
;;
;; Then the staged text replaces the file: renamed over it when it is beside it — the stage
;; given the file's owner, mode, ACLs, extended attributes and SELinux context before it was
;; filled (`cp --preserve=all --attributes-only`, else `cp -p`; `chcon --reference`;
;; getfacl/setfacl), or the umask's mode for a new file. Where no rename can be had — the file
;; has other hard links, the stage is not beside it, or the rename is refused (a file
;; bind-mounted into a container, /etc/hosts under Docker: EBUSY) — it is copied INTO the file,
;; after the file's old text was kept aside, and compared after; a copy that did not land whole
;; puts the old text back. Through a symbolic link to its target.
;;
;; Its temporary files are `.sudo-write.PID.*` (the stage) and `.sudo-keep.SUM.PID.*` (the old
;; text, SUM the target path's `cksum`), removed on every way out the shell sees (EXIT, HUP, INT,
;; TERM) — the keep only once the file is known whole: the copy compared equal, or the old text
;; put back and compared equal. A signal that lands DURING the copy puts the old text back
;; before the shell exits (a new file is removed again), so an interrupted copy leaves the file
;; as it was too; one that cannot be put back keeps the keep and says where it is. A
;; `.sudo-keep.….copying` marker beside the keep is up for exactly the copy. One a SIGKILL left
;; is never aged out: the next write to that file, finding a keep with its marker whose writer
;; is gone, removes it only when the file holds that text again, and otherwise refuses, naming
;; the keep, so the user puts the old text back or removes it. A stage, or a keep with no marker
;; (the file was never touched), a SIGKILL left is removed by a later write once it is a day old:
;; never another writer's, still being written.
(def- write-script
  (str "target=$1; expected=$2; digest=$3\n"
    "if [ -L \"$target\" ]; then resolved=$(readlink -f \"$target\") && target=$resolved; fi\n"
    "dir=$(dirname \"$target\"); tmp=${TMPDIR:-/tmp}\n"
    "stage=''; keep=''; existed=0; copying=0; intact=1\n" "restore() {\n"
    "  if [ -n \"$keep\" ]; then cat -- \"$keep\" > \"$target\" && cmp -s -- \"$keep\" \"$target\"\n"
    "  elif [ $existed = 0 ]; then rm -f -- \"$target\"\n" "  else false; fi\n" "}\n"
    "put_back() {\n" "  if restore; then intact=1; echo \"$1; its old text is back\" >&2\n"
    "  else echo \"$1, and its old text could not be put back: it is kept in $keep\" >&2; fi\n"
    "}\n" "cleanup() {\n" "  if [ -n \"$stage\" ]; then rm -f -- \"$stage\"; fi\n"
    "  if [ -n \"$keep\" ] && [ $intact = 1 ]; then rm -f -- \"$keep\" \"$keep.copying\"; fi\n"
    "}\n" "interrupted() {\n"
    "  if [ $copying = 1 ]; then copying=0; put_back 'the write was interrupted while copying'; fi\n"
    "  exit 4\n" "}\n" "trap cleanup EXIT\n" "trap interrupted HUP INT TERM\n"
    "sum=$(printf '%s' \"$target\" | cksum | cut -d' ' -f1)\n"
    "for old in \"$dir\"/.sudo-keep.\"$sum\".* \"$tmp\"/.sudo-keep.\"$sum\".*; do\n"
    "  case \"$old\" in *.copying) continue ;; esac\n" "  [ -f \"$old\" ] || continue\n"
    "  pid=${old##*/.sudo-keep.$sum.}; pid=${pid%%.*}\n"
    "  if ps -p \"$pid\" >/dev/null 2>&1; then continue; fi\n"
    "  if [ ! -e \"$old.copying\" ] || { [ -e \"$target\" ] && cmp -s -- \"$old\" \"$target\"; }; then\n"
    "    rm -f -- \"$old\" \"$old.copying\"; continue\n" "  fi\n"
    "  echo \"an earlier write to $target was cut off while copying; the text it had before is kept in $old: put it back or remove it (and $old.copying), then write again\" >&2\n"
    "  exit 4\n" "done\n"
    "find \"$dir\" -maxdepth 1 -type f \\( -name '.sudo-write.*' -o -name '.sudo-keep.*' \\) ! -name '*.copying' -mmin +1440 -exec sh -c 'for kept; do [ -e \"$kept.copying\" ] || rm -f -- \"$kept\"; done' sh {} + 2>/dev/null\n"
    "links=1\n"
    "if [ -e \"$target\" ]; then existed=1; links=$(ls -ld -- \"$target\" | awk '{print $2}'); fi\n"
    "rename=1\n"
    "stage=$(mktemp \"$dir/.sudo-write.$$.XXXXXX\" 2>/dev/null) || { rename=0; stage=$(mktemp \"$tmp/.sudo-write.$$.XXXXXX\") || exit 4; }\n"
    "if [ \"$links\" -gt 1 ]; then rename=0; fi\n" "if [ $rename = 1 ]; then\n"
    "  if [ $existed = 1 ]; then\n"
    "    cp --preserve=all --attributes-only -- \"$target\" \"$stage\" 2>/dev/null || cp -p -- \"$target\" \"$stage\" 2>/dev/null || rename=0\n"
    "    if command -v chcon >/dev/null 2>&1; then chcon --reference=\"$target\" -- \"$stage\" 2>/dev/null; fi\n"
    "    if command -v getfacl >/dev/null 2>&1 && command -v setfacl >/dev/null 2>&1; then\n"
    "      getfacl -p -- \"$target\" 2>/dev/null | setfacl --set-file=- -- \"$stage\" 2>/dev/null\n"
    "    fi\n" "  else\n" "    chmod \"$(printf '%o' $((0666 & ~$(umask))))\" \"$stage\"\n" "  fi\n"
    "fi\n" "cat > \"$stage\" || exit 4\n" "size=$(wc -c < \"$stage\" | tr -d ' ')\n"
    "if [ \"$size\" != \"$expected\" ]; then\n"
    "  echo \"$size of $expected bytes arrived; the file is unchanged\" >&2; exit 4\n" "fi\n"
    "if command -v sha256sum >/dev/null 2>&1; then\n"
    "  got=$(sha256sum < \"$stage\" | cut -d' ' -f1)\n" "  if [ \"$got\" != \"$digest\" ]; then\n"
    "    echo 'the text arrived changed; the file is unchanged' >&2; exit 4\n" "  fi\n" "fi\n"
    "if [ $rename = 1 ] && mv -f -- \"$stage\" \"$target\" 2>/dev/null; then stage=''; exit 0; fi\n"
    "if [ $existed = 1 ]; then\n"
    "  keep=$(mktemp \"$dir/.sudo-keep.$sum.$$.XXXXXX\" 2>/dev/null) || keep=$(mktemp \"$tmp/.sudo-keep.$sum.$$.XXXXXX\") || exit 4\n"
    "  if ! { cat -- \"$target\" > \"$keep\" && cmp -s -- \"$target\" \"$keep\"; }; then\n"
    "    echo 'its old text could not be kept aside; the file is unchanged' >&2; exit 4\n" "  fi\n"
    "  : > \"$keep.copying\" || exit 4\n" "fi\n" "intact=0; copying=1\n"
    "if cat -- \"$stage\" > \"$target\" && cmp -s -- \"$stage\" \"$target\"; then\n"
    "  copying=0; intact=1; if [ -n \"$keep\" ]; then rm -f -- \"$keep.copying\"; fi; exit 0\n"
    "fi\n" "copying=0\n" "put_back 'the file could not be written'\n" "exit 4\n"))

(defn write (path content &optional (opts {}))
  "Write `content`, text or bytes (any iolist), to the file at `path` as `opts`' `:user` (root by default) through sudo,
replacing what it held, and creating it when it does not exist. The text is staged and
checked — its byte count and SHA-256 — before anything is replaced, so a write cut short (the
caller killed, the pipe closed) leaves the file as it was; it then replaces the file by a
rename where it can, else by a copy into it that puts the old text back if it does not land
whole (see the module doc). True, or a failure as `sudo/read` gives one.

    (sudo/write \"/etc/hosts\" text {:password typed})   ;~> true, or a failure"
  (let (written (if (string? content) (string/->bytes content) (bytes/append content))
        result (run-as opts
                 "write"
                 ["sh"
                   "-c"
                   write-script
                   "sh"
                   path
                   (str (count written))
                   (hash/sha256-bytes written)]
                 written
                 #{0 4}))
    (cond
      (failure? result) result
      (= 0 (:exit result)) true
      else (failure-of "write" result))))
