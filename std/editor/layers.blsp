;; std/layers.blsp — composable, runtime-reconfigurable behaviour layers.
;;
;; The generic mechanism the editor's "modes" are built from — but NOT
;; editor-specific: any interactive Brood UI uses it, with or without buffers. A
;; *context* (an app model, or a buffer) carries an ordered list of named behaviour
;; *layers*; input and events resolve through them by precedence. "Major"/"minor"
;; are positions in that list (base vs. stacked), not types — see docs/layers.md.
;;
;; A LAYER is a `def`'d, late-bound value, resolved by symbol at use (so redefining
;; it hot-swaps everywhere — like a keymap command):
;;
;;   (def magit/layer
;;     {:name 'magit
;;      :keymap (-> {} (keymap-bind ["s"] 'magit/stage))
;;      :hooks  {:activate '(magit/setup) :on-close '(magit/kill-worker)}})
;;
;; A CONTEXT is any state map carrying `:layers` — a list of layer references
;; (symbols, or inline maps), **head = highest precedence**.
;;
;; This is framework tier (opt-in, never the prelude), pure Brood over `keymap`,
;; zero kernel surface (ADR-045). Phase 1: the buffer-free core (keys + hooks).

(defmodule editor/layers
  "Composable, runtime-reconfigurable behaviour layers for interactive UIs.
A *context* (any state map — an app model or a buffer) holds
`:layers`, an ordered list of layer references (head = highest precedence). A
*layer* is a `def`'d map `{:name … :keymap … :hooks {event → (fn-syms)}}`, resolved
by symbol at use (late-bound, so redefining it hot-swaps it everywhere).

    (def app/quit (fn () :quit))
    (def app/base {:name 'base :keymap (keymap-bind {} [\"q\"] 'app/quit)})
    (def st (activate-layer {} 'app/base))
    (layer-dispatch st nil \"q\" (fn (s _) s))   ; => [st' pending']

Keymaps and hooks are resolved by one generic collector (`layer-collect`) — facets.
`:activate`/`:deactivate` fire for the one layer toggled; `:on-focus`/`:on-blur`/
`:on-close` (and app-defined events) fan across all active layers via `run-event`.
Buffer-type binding and focus/scope wiring are layered on in later phases — this
core knows nothing about buffers."
  (:use editor/keymap))

;; ============================================================================
;; HOW TO USE
;; ============================================================================
;;
;; The whole idea: a CONTEXT (any state map) carries `:layers`, an ordered list of
;; LAYERS (head = highest precedence). A layer bundles a keymap and lifecycle hooks
;; under a name. Input and events resolve through the active layers. "Modes" (major,
;; minor) are just positions in the list — there is no mode type.
;;
;; ---- 1. Define a layer -----------------------------------------------------
;; A layer is a `def`'d map, referenced by symbol so redefining it hot-swaps it
;; everywhere. Commands and hooks are *also* symbols (resolved late). Build the
;; keymap with `keymap-bind` (chords are vectors of >1 key):
;;
;;   (defmodule magit (:use layers) (:use keymap) (:use buffer))
;;   ;; no load step: `layers/…` / `keymap/…` load on reference
;;
;;   (defn stage  (st key) …)            ; a command: (state key) -> state
;;   (defn commit (st key) …)
;;   (defn refresh (st) …)               ; a hook: (state) -> state
;;   (defn kill-worker (st) …)
;;
;;   (def layer
;;     {:name 'magit
;;      :keymap (-> {} (keymap-bind ["s"]     'magit/stage)
;;                     (keymap-bind ["c" "c"] 'magit/commit))   ; a chord
;;      :hooks  {:activate '(magit/refresh)        ; turned on  (once)
;;               :on-focus '(magit/refresh)        ; re-entered (every time)
;;               :on-close '(magit/kill-worker)}}) ; going away (cleanup)
;;
;; ---- 2. Turn layers on/off on a context ------------------------------------
;; `activate-layer` pushes a layer (highest precedence) and fires its `:activate`;
;; `deactivate-layer` (by :name) fires `:deactivate` and removes it. `push-layer`
;; / `remove-layer` are the no-hook primitives. `replace-base-layer` swaps the base
;; (the "major") while layers above it stay — deactivating the old, activating new.
;;
;;   (def st (activate-layer {} 'magit/layer))   ; st now has :layers '(magit/layer)
;;   (layer-active? st 'magit)                    ; => true
;;
;; ---- 3. Dispatch a key -----------------------------------------------------
;; `layer-dispatch` composes the context's active keymaps and steps one keystroke,
;; returning [state' pending']. Thread `pending` back on the next key (chords span
;; keystrokes); a fallback handles unbound keys (e.g. self-insert).
;;
;;   (let (r (layer-dispatch st nil "s" (fn (s _) s)))   ; runs magit/stage
;;     (first r))   ; => new state          (second r) => nil, or a pending sub-keymap
;;
;; ---- 4. Buffer types: which layers a new buffer starts with ----------------
;; Bind layers to a TYPE, and a type to filenames (data registries, hot-reloadable):
;;
;;   (register-type-layers :magit-status '(magit/layer))     ; type → layers
;;   (register-file-type ".el" :elisp)                       ; filename → type (suffix)
;;   (register-file-type (fn (f) (= f "Makefile")) :make)    ; …or a predicate
;;   (register-interpreter-type "bash" :shell)              ; `#!` line → type (no extension)
;;
;;   (init-buffer-layers buf)                ; file → type → seed :layers, fire :activate
;;   (init-buffer-layers (set-buffer-type buf :magit-status))  ; fileless/special buffer
;;
;; `std/buffer` need not be loaded — this only reads/writes :file/:type/:layers on a
;; plain map. A buffer-less GUI just keeps `:layers` on its own model.
;;
;; ---- 5. Scopes & focus (apps with several contexts) ------------------------
;; The active set is the FOCUSED context's layers. Several scopes compose — a
;; focused buffer shadowing the window/app. Layers stays focus-agnostic: YOU pass
;; the scope contexts, highest precedence first.
;;
;;   (scope-dispatch (list focused-buffer model) model pending key fallback)
;;       ; keymap merged from buffer + model layers; command runs on `model`
;;
;; Switching focus is *dormancy*, not teardown (no activate/deactivate). Fire the
;; fanned events yourself at the right moments:
;;
;;   (switch-focus old-buf new-buf)   ; => [old' new'] : :on-blur then :on-focus
;;   (close-context buf)              ; :on-close (kill async workers) then deactivate all
;;
;; `:on-close` is the async-cleanup seam: a layer whose `:on-focus` `spawn`ed a
;; worker kills it in `:on-close`; results from the worker arrive as mailbox
;; messages the app's loop handles.
;;
;; ---- 6. Putting it in a ui-run loop ----------------------------------------
;; `std/ui`'s loop is (model, view, update). Keep layers in the model (and on each
;; buffer); dispatch in `update`; thread `pending` in the model:
;;
;;   (defn update (model input cols rows)
;;     (let (buf (current-buffer model)                       ; app's own accessor
;;           r   (scope-dispatch (list buf model) model (get model :pending) input
;;                               (fn (m _) m)))               ; fallback: ignore
;;       (assoc (first r) :pending (second r))))
;;
;; Create a buffer → `init-buffer-layers`; switch buffers → `switch-focus` +
;; stash both; close one → `close-context`. The view reads whatever facets it wants
;; off the active layers via `(layer-collect ctx :some-facet)`.
;;
;; ---- 7. Facets beyond :keymap/:hooks ----------------------------------------
;; Any key on a layer is a facet an app can collect; two vocabulary entries are
;; worth standardising because more than one app wants the same seam:
;;
;;   * services — a facet holding a fn SYMBOL the app `reflect/eval`s at use (late-bound,
;;     hot-swappable), e.g. an editor's `:fontify`/`:indent`/`:complete-at`. The
;;     app defines the signature; layers supply implementations.
;;   * `:post-key` — a GUARD run after key dispatch: `(fn (ctx-before ctx-after
;;     key) -> ctx)`, applied by the app's loop for each active layer defining it
;;     (highest precedence first, each seeing the previous one's result). Because
;;     contexts are immutable, "this edit isn't allowed here" is simply returning
;;     `ctx-before` — the canonical way a layer protects read-only regions (a
;;     shell prompt, generated prose around an editable playground) without the
;;     app hardcoding per-layer checks in its dispatch path.
;;   * `:on-move` — a FOLLOWER run after dispatch ONLY when the context's point or text
;;     changed (`buffer-moved?` in editor/buffer is the test): `(fn (ctx) -> ctx)`, the
;;     same order as `:post-key`. Keeps a companion pane (a preview, a trace pane) on
;;     the cursor. It is a separate facet because a guard must see EVERY event —
;;     a mouse gesture can edit — while a follower on that facet re-asserts its
;;     position on events that moved nothing, such as the wheel scrolling the very
;;     pane it follows with, and fights the user for it. The app's loop decides
;;     "moved" once and runs the facet only then; a follower never has to remember.
;;
;; ---- semantics to remember -------------------------------------------------
;;   * head of :layers = highest precedence (keymap merge + hook order).
;;   * dormant != deactivated: leaving a context never fires :deactivate.
;;   * :activate/:deactivate fire for the ONE layer toggled; :on-focus/:on-blur/
;;     :on-close (and your own events, via `run-event`) fan across ALL active layers.
;;   * a throwing hook is isolated (state unchanged) — a bad layer can't crash the loop.
;;   * prefixes compose across layers (`keymap-overlay`): a mode binding `C-x C-x` keeps
;;     the global `C-x b`; a command or `nil` above hides what is below.
;; ============================================================================

;; ---- resolution -------------------------------------------------------------

(defn- layers-list (ctx)
  "The context's layer list (highest precedence first), or () when it has none."
  (or (get ctx :layers) (list)))

(defn- layers-resolve (layer)
  "A layer reference → its map. A map is itself; a symbol is resolved (late-bound,
so redefining the layer hot-swaps it), like a keymap command."
  (if (map? layer) layer (reflect/eval layer)))

(defn- layers-name-of (layer)
  "The `:name` of a layer reference (resolving it first)."
  (get (layers-resolve layer) :name))

(defn- layers-find (ctx name)
  "The first active layer reference named `name`, or nil."
  (seq/find (layers-list ctx) (fn (l) (= name (layers-name-of l)))))

(defn layer-collect (ctx facet)
  "The `facet` value of every active layer that defines it, highest-precedence
first (head of `:layers`); layers lacking the facet are dropped. The one generic
resolver — keymaps and hooks are just facets over it.

    (editor/layers/layer-collect {:layers (list {:name :a :keymap {:x 'one}} {:name :b} {:name :c :keymap {:x 'two}})} :keymap)   ;=> ({:x one} {:x two})"
  (seq/reject (map (layers-list ctx) (fn (l) (get (layers-resolve l) facet))) nil?))

(defn- layer-facet-in (layers facet)
  (if (empty? layers)
    nil
    (let (v (get (layers-resolve (first layers)) facet))
      (if (nil? v) (layer-facet-in (rest layers) facet) v))))

(defn layer-facet (ctx facet)
  "The `facet` value of the highest-precedence active layer that defines it, or nil — what
`(first (layer-collect ctx facet))` answers, but it stops at the first layer that has one
instead of resolving every layer and collecting every value. An editor asks this for a
mode's services several times per pane per frame, where the difference is the frame.

    (editor/layers/layer-facet {:layers [{:name 'a} {:name 'b :x 1} {:name 'c :x 2}]} :x)   ;=> 1"
  (layer-facet-in (layers-list ctx) facet))

(defn active-layers (ctx)
  "The active layers of `ctx` as **resolved maps**, highest-precedence first — for
inspecting whole layers (e.g. to skip `:system` ones when naming the mode), where
`layer-collect` (which projects a single facet) isn't enough.

    (map (editor/layers/active-layers {:layers (list {:name :a} {:name :b})}) :name)   ;=> (:a :b)"
  (map (layers-list ctx) layers-resolve))

;; ---- stack ops (pure; fire no hooks) ----------------------------------------

(defn push-layer (ctx layer)
  "Add `layer` (a reference) at highest precedence (the head). The low-level
primitive — `activate-layer` is the hook-firing version.

    (map (get (editor/layers/push-layer {:layers (list {:name :base})} {:name :vi}) :layers) :name)   ;=> (:vi :base)"
  (assoc ctx :layers (cons layer (layers-list ctx))))

(defn remove-layer (ctx name)
  "Remove every active layer whose `:name` is `name`.

    (editor/layers/layer-active? (editor/layers/remove-layer (editor/layers/push-layer {} {:name :vi}) :vi) :vi)   ;=> false"
  (assoc ctx :layers (seq/reject (layers-list ctx) (fn (l) (= name (layers-name-of l))))))

(defn layer-active? (ctx name)
  "True if an active layer is named `name`.

    (editor/layers/layer-active? (editor/layers/push-layer {} {:name :vi}) :vi)   ;=> true
    (editor/layers/layer-active? {} :vi)   ;=> false"
  (any? (layers-list ctx) (fn (l) (= name (layers-name-of l)))))

(defn- layers-replace-base-list (lst layer)
  "Replace the base (last) element of `lst` with `layer`, or add it if `lst` empty."
  (if (empty? lst) (list layer) (append (seq/but-last lst) (list layer))))

;; ---- hooks ------------------------------------------------------------------

(defn- layers-run-hook (hook ctx)
  "Run one hook — a fn symbol resolved late and applied as `(ctx) -> ctx`. A throw
leaves `ctx` unchanged, so a bad hook can't crash the loop."
  (try ((reflect/eval hook) ctx) (catch e ctx)))

(defn- layers-run-hooks (ctx hooks)
  "Thread `ctx` through a list of hooks (each `(ctx) -> ctx`)."
  (fold hooks ctx (fn (acc h) (layers-run-hook h acc))))

(defn- layers-layer-event-hooks (layer event)
  "The `event` hook list of a single layer reference, or ()."
  (or (map/get-in (layers-resolve layer) [:hooks event]) (list)))

(defn- layers-run-one (ctx layer event)
  "Run just `layer`'s `event` hooks (the lifecycle path: `:activate`/`:deactivate`)."
  (layers-run-hooks ctx (layers-layer-event-hooks layer event)))

(defn run-event (ctx event)
  "Fan `event` across ALL active layers, highest precedence first, threading `ctx`
through every hook. For broadcast events — `:on-focus`/`:on-blur`/`:on-close` and
app-defined ones — *not* the lifecycle `:activate`/`:deactivate`.

    (editor/layers/run-event {:layers (list {:name :a})} :on-focus)   ;=> {:layers ({:name :a})}"
  (layers-run-hooks ctx
    (mapcat (layer-collect ctx :hooks) (fn (hk) (or (get hk event) (list))))))

;; ---- lifecycle toggles ------------------------------------------------------

(defn activate-layer (ctx layer)
  "Turn a layer on: push `layer` at highest precedence, then run *its* `:activate`
hooks. (Raw `push-layer` fires no hooks.)

    (editor/layers/layer-active? (editor/layers/activate-layer {} {:name :vi}) :vi)   ;=> true"
  (layers-run-one (push-layer ctx layer) layer :activate))

(defn deactivate-layer (ctx name)
  "Turn off the layer named `name`: run its `:deactivate` hooks, then remove it. A
no-op if no such layer is active.

    (editor/layers/layer-active? (editor/layers/deactivate-layer (editor/layers/activate-layer {} {:name :vi}) :vi) :vi)   ;=> false"
  (let (layer (layers-find ctx name))
    (if (nil? layer)
      ctx
      (remove-layer (layers-run-one ctx layer :deactivate) name))))

(defn replace-base-layer (ctx layer)
  "Swap the base (lowest-precedence, the 'major') layer for `layer`: deactivate the
old base, set the new base, activate it. Layers stacked above are untouched — like
changing major mode while minor modes stay on.

    (map (get (editor/layers/replace-base-layer {:layers (list {:name :minor} {:name :old})} {:name :new}) :layers) :name)   ;=> (:minor :new)"
  (let (old (last (layers-list ctx))
        ctx1 (if (nil? old) ctx (layers-run-one ctx old :deactivate))
        ctx2 (assoc ctx1 :layers (layers-replace-base-list (layers-list ctx1) layer)))
    (layers-run-one ctx2 layer :activate)))

;; ---- keymap consumer (bridge to keymap) -------------------------------------

(defn active-keymap (ctx)
  "Merge the keymaps of all active layers into one, each laid over the layers below it
([[keymap-overlay]]), head (highest precedence) winning.

    (get (editor/layers/active-keymap {:layers (list {:keymap {:x 'one}} {:keymap {:x 'two :y 'three}})}) :x)   ;=> one
    (get (editor/layers/active-keymap {:layers (list {:keymap {:x 'one}} {:keymap {:x 'two :y 'three}})}) :y)   ;=> three"
  (fold (reverse (layer-collect ctx :keymap)) {} keymap-overlay))

(defn layer-binding (ctx key)
  "What `key` is bound to in the context's active keymap — the same answer as
`(get (active-keymap ctx) key)`, without building the merged map. What dispatch asks on
every keystroke; the merge is for help text that wants the whole map. A command (or an
explicit `nil`) comes from the first layer binding `key`; a prefix comes back merged with
the same key's maps below it, down to the first layer binding the key to anything else.

    (editor/layers/layer-binding {:layers (list {:keymap {:x 'one}} {:keymap {:x 'two :y 'three}})} :y)   ;=> three
    (editor/layers/layer-binding {:layers (list {:keymap {:x {:c 'hi}}} {:keymap {:x {:b 'lo}}})} :x)   ;=> {:c hi, :b lo}"
  (layer-binding-in (layers-list ctx) key ()))

(defn- layer-binding-in (layers key maps)
  "Walk `layers` for `key`, collecting the prefix maps it is bound to (`maps`, lowest
precedence first) until a layer binds it to anything else, which wins outright if no map
came before it."
  (if (empty? layers)
    (layers-overlay maps)
    (let (keymap (get (layers-resolve (first layers)) :keymap))
      (if (and (map? keymap) (contains? keymap key))
        (let (v (get keymap key))
          (cond
            (map? v) (layer-binding-in (rest layers) key (cons v maps))
            (empty? maps) v
            else (layers-overlay maps)))
        (layer-binding-in (rest layers) key maps)))))

(defn- layers-overlay (maps)
  "Overlay `maps`, lowest precedence first: nil for none, the map itself for one."
  (fold (rest maps) (first maps) keymap-overlay))

(defn layer-resolve (ctx pending key)
  "`keymap-resolve` over the context's layers: `[binding pending']` for `key`, looked up
in `pending` mid-chord, else through [[layer-binding]].

    (editor/layers/layer-resolve {:layers (list {:keymap {:x 'one}})} nil :x)   ;=> [one nil]"
  (if (nil? pending) (keymap-classify (layer-binding ctx key)) (keymap-resolve pending nil key)))

(defn layer-dispatch (ctx pending key fallback)
  "One keystroke through the context's composed active keymap, via `keymap-step`:
returns `[ctx' pending']`. The bridge from layers to keymap — compose, then step.

    (get (first (editor/layers/layer-dispatch {} nil :z (fn (s k) (assoc s :key k)))) :key)   ;=> :z"
  (keymap-run (layer-resolve ctx pending key) pending ctx key fallback))

;; ============================================================================
;; Phase 2 — buffer-type binding
;; ============================================================================
;; A new buffer's starting layer set is determined by its TYPE. Two registries
;; (plain data, rebindable via the helpers → hot-reload) bind layers to types and
;; types to filenames. This stays buffer-*agnostic* code: it only reads/writes the
;; `:file` / `:type` / `:layers` keys on a plain map — `std/buffer` need not be
;; loaded, and a buffer-less context can carry a `:type` too.

;; These three are REGISTRIES: a module `register-`s into them at load and they must
;; accumulate across the module's life, so each is `defonce`, not `def` — re-loading THIS
;; module must not wipe registrations already made. Two ways this file re-runs after
;; registrations exist, both of which a plain `def` silently reset: a hot reload, and — the
;; one that bit a real app — an IMAGED start (ADR-218). The image restores these registries'
;; VALUES in the always-materialised root section, but editor/layers is a STD module served
;; from its own EMBEDDED source, so a project module's `(:use editor/layers)` re-runs this
;; file; a `(def *type-layers* {})` here would clobber the restored value — dropping the
;; layer types of every DEFERRED module (loaded on demand, so absent from the image's eager
;; set: a tutorial, a test runner). `defonce` leaves the restored/accumulated registry intact.

;; type → its layer refs, in precedence order (head = highest; activated base-first).
(defonce *type-layers* {})
;; ordered filename→type rules, newest-first (first match wins). Each is
;; `{:match <suffix-string | (fn (filename) -> bool)> :type <type>}`.
(defonce *auto-type-by-file* ())
;; interpreter → type, for a file whose FIRST LINE is a `#!` (Emacs `interpreter-mode-alist`):
;; `{"bash" :shell "python3" :python}`. Consulted after the filename rules, so an
;; extensionless script (`run`, `deploy`) still finds its mode.
(defonce *auto-type-by-interpreter* {})

;; Always-on **system layers** — included (at lowest precedence) on every buffer by
;; `init-buffer-layers`, regardless of type. The home for global behaviour (a
;; baseline keymap, etc.) that isn't a "mode". Mark such a layer `:system true` so a
;; UI can keep it out of the mode display (e.g. show the major mode, not "global").
(defonce *system-layers* ())

(defn register-system-layer (ref)
  "Register `ref` as an always-on system layer (appended at lowest precedence to
every buffer). **Idempotent** — registering the same ref again is a no-op, so a
module that registers at load is safe to (re)load.

    (editor/layers/register-system-layer 'myapp/layer)   ;~> …the registry updated: every buffer now carries myapp/layer…"
  ;; The membership test is INSIDE the transform, so two processes registering the same
  ;; ref cannot both see it absent and both append (the KI-23 shape).
  ;; `:append-new` — an op, not a whole-map swap, so a module registering at load inside
  ;; an `%isolate` window keeps its layer past the restore (KI-141; see `editor/face`).
  (%registry-update! 'editor/layers/*system-layers* :append-new [] ref))

(defn register-type-layers (type refs)
  "Bind buffer `type` to `refs` (a list of layer references, head = highest
precedence). Rebinds the registry, so it hot-swaps on the next buffer of that type.
To add a single layer to a type, `assoc` onto its existing `(layers-for-type type)`.

    (editor/layers/register-type-layers :elixir ['myapp/elixir-layer])   ;~> …the registry updated: new :elixir buffers get that layer…"
  (%registry-update! 'editor/layers/*type-layers* :assoc [type] refs))

(defn register-file-type (spec type)
  "Map filenames to `type`: `spec` is a suffix string (matched with `ends-with?`)
or a predicate `(fn (filename) -> bool)`. Prepended, so the most-recently-registered
rule wins — a project can override a default.

    (editor/layers/register-file-type \".ex\" :elixir)   ;~> …the registry updated: a file ending .ex is now :elixir…"
  (%registry-update! 'editor/layers/*auto-type-by-file* :cons-new [] {:match spec :type type}))

(defn register-interpreter-type (name type)
  "Map the interpreter `name` a `#!` line names — the program's basename, or the word
after `env` (`#!/usr/bin/env bash` and `#!/bin/bash` are both `\"bash\"`) — to `type`.
The Emacs `interpreter-mode-alist`: a script with no extension is typed by its shebang.

    (editor/layers/register-interpreter-type \"bash\" :shell)   ;~> …the registry updated: a #!/bin/bash script is now :shell…"
  (%registry-update! 'editor/layers/*auto-type-by-interpreter* :assoc [name] type))

(defn shebang-interpreter (line:string -> (or nil string))
  "The interpreter a `#!` `line` names — `\"bash\"` for `#!/usr/bin/env bash` and for
`#!/bin/bash -e`, `\"python3\"` for `#!/usr/bin/python3` — or nil for a line that is not a
shebang. The version suffix is kept (`python3`), a trailing newline and arguments are not.

    (editor/layers/shebang-interpreter \"#!/usr/bin/env bash\")      ;=> \"bash\"
    (editor/layers/shebang-interpreter \"#!/usr/bin/python3 -u\\n\")   ;=> \"python3\"
    (editor/layers/shebang-interpreter \"echo hi\")                  ;=> nil"
  (if (not (string/starts-with? line "#!"))
    nil
    (let (words (seq/reject (string/split (string/trim (string/substring line
                                                         2
                                                         (string/length line)))
                              " ")
                  (fn (w) (= w "")))
          ;; `string?` on the word itself, not `empty?` on the list: both reject the same
          ;; input, but only this one narrows `(first words)` from `nil | string` for the
          ;; checker — `path/basename` takes a string.
          prog (let (first-word (first words))
                 (if (string? first-word) (path/basename first-word) nil))
          name (if (and (= prog "env") (> (count words) 1))
                 ;; `env -S bash`: skip env's own flags
                 (seq/find (rest words) (fn (w) (not (string/starts-with? w "-"))))
                 prog))
      (if (or (nil? name) (= name "")) nil name))))

(defn- layers-match-interpreter (buf)
  "The type `*auto-type-by-interpreter*` gives `buf`'s shebang line, or nil."
  (let (rope (get buf :rope))
    (if (nil? rope)
      nil
      (let (name (shebang-interpreter (text/line rope 0)))
        (if (nil? name) nil (get *auto-type-by-interpreter* name))))))

(defn layers-for-type (type)
  "The layer refs bound to `type`, or () if none.

    (editor/layers/layers-for-type :no-such-type)   ;=> ()"
  (or (get *type-layers* type) ()))

(defn- layers-file-matches? (file spec)
  "Does `file` satisfy a `:match` spec — a suffix string, or a predicate fn?"
  (if (string? spec) (string/ends-with? file spec) (spec file)))

(defn- layers-match-file (file rules)
  "Walk `rules` (newest-first); return the `:type` of the first whose `:match` fits
`file`, else nil."
  (get (seq/find rules (fn (rule) (layers-file-matches? file (get rule :match)))) :type))

(defn buffer-type-for (buf)
  "The type of `buf`. An explicitly-set `:type` wins — it was either stamped by a
prior `init-buffer-layers` (the open-time auto-detection) or set by an explicit mode
switch, and both should stick. When `:type` is nil (a freshly-created buffer), matches
`:file` against `*auto-type-by-file*` (first match wins), then the first line's `#!`
against `*auto-type-by-interpreter*`, then falls back to `:fundamental`.

    (editor/layers/buffer-type-for {:type :lisp})   ;=> :lisp"
  (let (explicit (get buf :type)
        file (get buf :file)
        matched (if (nil? file) nil (layers-match-file file *auto-type-by-file*)))
    (or explicit matched (layers-match-interpreter buf) :fundamental)))

(defn set-buffer-type (buf type)
  "Set `buf`'s `:type` explicitly — the Brood-side override for fileless or special
buffers (a `*magit-status*`, a scratch buffer). Does not (re)seed layers; pair with
`init-buffer-layers`.

    (editor/layers/buffer-type-for (editor/layers/set-buffer-type {} :magit))   ;=> :magit"
  (assoc buf :type type))

(defn init-buffer-layers (buf)
  "Resolve `buf`'s type, set `:type` to it, and seed `:layers` from `*type-layers*`
**plus the always-on `*system-layers*`** (at lowest precedence), firing each
layer's `:activate` (base-first). Replaces any existing `:layers` — call on buffer
creation, or after `set-buffer-type`. The type list's order is preserved (head =
highest precedence); system layers come last.

    (editor/layers/init-buffer-layers buf)   ;~> buf with :type and :layers set from the registered types and layers"
  (let (type (buffer-type-for buf)
        refs (append (layers-for-type type) *system-layers*)
        seeded (assoc buf :type type :layers ()))
    ;; activate base-first (reverse: each push goes to the head), so the resulting
    ;; :layers order equals `refs` order and a minor's :activate sees the base.
    (fold (reverse refs) seeded (fn (b ref) (activate-layer b ref)))))

;; ============================================================================
;; Phase 3 — scopes, focus/close lifecycle, teardown
;; ============================================================================
;; The active layer set is whichever context has focus. Several scopes compose —
;; a focused buffer shadowing the window/app — but layers stays focus-agnostic: the
;; APP owns "what's focused" and passes the scope contexts here, in precedence order
;; (first = highest). A keystroke composes their keymaps; commands run on the app
;; model. Switching focus is dormancy, not lifecycle (no activate/deactivate);
;; focus/blur/close are *fanned events* — and `:on-close` is where a layer cleans up
;; async work it started (kill a spawned worker), which `close-context` drives.

(defn compose-layers (ctxs)
  "Concatenate the `:layers` of `ctxs` in precedence order (first scope = highest) —
the composite layer list for multi-scope dispatch, e.g. (focused-buffer app-model).

    (map (editor/layers/compose-layers [{:layers (list {:name :buf})} {:layers (list {:name :app})}]) :name)   ;=> (:buf :app)"
  (mapcat ctxs layers-list))

(defn scope-keymap (ctxs)
  "The merged active keymap across several scopes `ctxs` (first = highest
precedence; prefixes merged across layers, as [[active-keymap]] merges them).

    (get (editor/layers/scope-keymap [{:layers (list {:keymap {:x 'buf}})} {:layers (list {:keymap {:x 'app :y 'quit}})}]) :x)   ;=> buf
    (get (editor/layers/scope-keymap [{:layers (list {:keymap {:x 'buf}})} {:layers (list {:keymap {:x 'app :y 'quit}})}]) :y)   ;=> quit"
  (active-keymap {:layers (compose-layers ctxs)}))

(defn scope-binding (ctxs key)
  "[[layer-binding]] across several scopes `ctxs` (first = highest precedence): what
`(get (scope-keymap ctxs) key)` answers, without merging every layer's keymap per key.

    (editor/layers/scope-binding [{:layers (list {:keymap {:x 'buf}})} {:layers (list {:keymap {:x 'app}})}] :x)   ;=> buf"
  (layer-binding-in (compose-layers ctxs) key ()))

(defn scope-resolve (ctxs pending key)
  "[[layer-resolve]] across several scopes `ctxs`: `[binding pending']` for `key`.

    (editor/layers/scope-resolve [{:layers (list {:keymap {:x 'buf}})}] nil :x)   ;=> [buf nil]"
  (if (nil? pending) (keymap-classify (scope-binding ctxs key)) (keymap-resolve pending nil key)))

(defn- layers-hides? (keymap sequence)
  "Does `keymap`, laid over a lower one ([[keymap-overlay]]), hide the lower one's binding
of key `sequence`? Yes when it binds the whole sequence, or a proper prefix of it to
anything but a map; a prefix map merges, so the walk goes on inside it."
  (let (k (first sequence)
        more (rest sequence))
    (cond
      (not (and (map? keymap) (contains? keymap k))) false
      (empty? more) true
      (map? (get keymap k)) (layers-hides? (get keymap k) more)
      else true)))

(defn- scope-shadow-of (layers i sequence)
  "The `:name` of the highest-precedence layer BEFORE index `i` that hides key `sequence`
([[layers-hides?]]), or nil when it is in force. The WHOLE sequence, not its first key: a
layer binding `C-x s` leaves a lower `C-x k` in force; one binding `C-x` to a command
shadows every lower `C-x` chord."
  (let (above (seq/find (take layers i) (fn (l) (layers-hides? (:keymap l) sequence))))
    (if (nil? above) nil (:name above))))

(defn scope-bindings (ctxs:seqable -> vector)
  "Every binding the scopes `ctxs` make (first scope = highest precedence), each WITH the
layer it came from and what shadows it: a vector of
`{:sequence :command :layer :shadowed-by}` in precedence order, `:shadowed-by` nil for the
bindings actually in force.

`scope-keymap` answers the same question with the answer thrown away — it merges the stack
into one keymap, after which no caller can say which layer won a key, or what that win cost.
That is what help needs and cannot reconstruct: `describe-bindings` groups by layer,
`describe-key` names the layer a key came from, and a which-key popup dims what is shadowed.

Its shadow rule (`scope-shadow-of`) is the overlay rule `active-keymap` dispatches
through, stated per sequence; `layers_test` pins the two together. Help that computes its
own answer drifts from the dispatcher and then lies — and a lying keymap help is worse than
none, because it is believed.

    (editor/layers/scope-bindings (list {:layers (list {:name :mode :keymap {:a 'go}})}))   ;=> [{:sequence [:a] :command go :layer :mode :shadowed-by nil}]"
  (let (layers (map (compose-layers ctxs) layers-resolve))
    (into []
      (mapcat (range (count layers))
        (fn (i)
          (let (layer (nth layers i))
            (map (keymap-bindings (or (:keymap layer) {}))
              (fn (pair)
                (let ([command sequence] pair)
                  {:sequence sequence
                   :command command
                   :layer (:name layer)
                   :shadowed-by (scope-shadow-of layers i sequence)})))))))))

(defn scope-dispatch (ctxs state pending key fallback)
  "Dispatch `key` through the merged keymap of `ctxs` (precedence by order), running
the resolved command on `state` — typically the app model, which may itself be one
of `ctxs` so its window-level layers compose with the focused buffer's. Returns
`[state' pending']`. The multi-scope counterpart to `layer-dispatch`.

    (first (editor/layers/scope-dispatch [{} {}] 0 nil :z (fn (s k) (inc s))))   ;=> 1"
  (keymap-run (scope-resolve ctxs pending key) pending state key fallback))

(defn switch-focus (from to)
  "Move focus from context `from` to `to`: fan `:on-blur` across `from`'s layers and
`:on-focus` across `to`'s, returning `[from' to']`. Either side may be nil (a
no-op). Neither context is activated/deactivated — leaving a context is *dormancy*,
not teardown; its layers simply stop being consulted.

    (editor/layers/switch-focus nil nil)   ;=> [nil nil]"
  [(if (nil? from) from (run-event from :on-blur)) (if (nil? to) to (run-event to :on-focus))])

(defn deactivate-all (ctx)
  "Deactivate every active layer (head-first), firing each `:deactivate`.

    (editor/layers/layer-active? (editor/layers/deactivate-all {:layers (list {:name :a} {:name :b})}) :a)   ;=> false"
  (fold (map (layers-list ctx) layers-name-of) ctx (fn (c nm) (deactivate-layer c nm))))

(defn close-context (ctx)
  "Tear a context down: fan `:on-close` across its active layers — the async-cleanup
hook, where a layer kills a worker it `spawn`ed — then `deactivate-all` (firing each
`:deactivate`). The full close path for a buffer or window going away.

Read `close-requests` off the RESULT: a closing context may name companions that should
go with it (see `request-close`).

    (editor/layers/layer-active? (editor/layers/close-context {:layers (list {:name :a})}) :a)   ;=> false"
  (deactivate-all (run-event ctx :on-close)))

;; ---- taking companions with you ---------------------------------------------
;; A mode often owns more than its own context: the tutorial's *Workings* pane, a REPL's
;; transcript, a debugger's queue — buffers it created and that mean nothing once it is
;; gone. An `:on-close` hook cannot close them itself, and deliberately so: a hook is
;; `(ctx) -> ctx`, and a "context" here is whatever the app threads through (a buffer, a
;; window) — layers has no idea what container those live in, which is exactly why it
;; composes with any app.
;;
;; So a hook doesn't reach; it NAMES. `request-close` records a companion on the closing
;; context, `close-requests` reads the list back, and the app — which does know its own
;; pool — decides what to do with it. The same shape as a render op: the layer says what
;; it wants, the frontend performs it.

(defn request-close (ctx name)
  "From an `:on-close` hook: ask the app to close companion `name` as well. Names
accumulate and de-duplicate, so two layers asking for the same companion is one request.
Returns `ctx`, so a hook can thread it: `(fn (buf) (request-close buf \"*Workings*\"))`.

    (editor/layers/close-requests (editor/layers/request-close (editor/layers/request-close {} \"*a*\") \"*a*\"))   ;=> (\"*a*\")"
  (let (seen (close-requests ctx))
    (if (includes? seen name)
      ctx
      (assoc ctx :close-requests (append seen (list name))))))

(defn close-requests (ctx)
  "The companions a closing context asked to take with it, in the order requested — `()`
when none. The app reads this off `close-context`'s result; a name it does not recognise
is simply ignored (a mode may have been unloaded, or its companion already closed).

    (editor/layers/close-requests (editor/layers/request-close (editor/layers/request-close {} \"*a*\") \"*b*\"))   ;=> (\"*a*\" \"*b*\")"
  (or (get ctx :close-requests) (list)))
