;; std/editor/markdown.blsp — lexical Markdown highlighting.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - The Markdown analogue of `editor/highlight.blsp`: pure data → data, no IO and
;;    no kernel surface. `(markdown-spans src)` takes a source string and returns
;;    `[start end face]` colour spans (character offsets, end-exclusive) in exactly
;;    the `highlight-spans` shape, so it drops straight into the editor's `:fontify`
;;    mode service and the shared `fontify-runs` tiler — the view, the web mirror,
;;    and any REPL use it the same way (ADR-052, ADR-092).
;;  - Lexical, not a CommonMark parser: it classifies tokens by *line shape* (ATX
;;    headings, fenced code, list bullets, blockquotes) and a left-to-right inline
;;    scan (code spans, bold, italic, links). Cheap, robust on incomplete input, and
;;    written in Brood (ADR-006). Spans are emitted ascending and non-overlapping —
;;    the `fontify-runs` contract — by consuming each matched region whole.
;;  - The faces are `display.blsp`-style maps (`{:fg :green}` …) so they feed straight
;;    into a `[:print str face]` op, like `highlight.blsp`'s `hl-face-*`.

(defmodule editor/markdown
  "Lexical Markdown syntax highlighting, as a pure function over a source string —
the Markdown analogue of `editor/highlight` (ADR-052) — and the document RENDERED:

  - `(markdown-spans src)` — `[start end face]` colour spans for `src`'s tokens,
    in the `highlight-spans` shape (ascending, non-overlapping, end-exclusive).
  - `(markdown-render src width)` — `{:text :spans :lines}`: the text the markup
    describes (markers gone, paragraphs re-flowed to `width`), the same span shape
    over it as DATA, and a rendered-line → source-line map for a preview that
    follows the cursor; `(markdown-rendered-line rendered src-line)` reads it.

Classifies *line shapes* (ATX `#` headings, ``` fenced code blocks, `-`/`*`/`+` and
ordered list bullets, `>` blockquotes) plus an inline scan (`` `code` ``, `**bold**`,
`*italic*`, `[text](url)`). Lexical, not a CommonMark parser — cheap and robust on
incomplete input; feeds the editor's `:fontify` mode service and the shared
`fontify-runs` tiler unchanged. Pure, so independently testable.")

;; ---- faces (display.blsp-style maps) ----------------------------------------

(def md-face-heading {:fg :magenta :bold true})
(def md-face-bold {:bold true})
(def md-face-italic {:italic true})
(def md-face-code {:fg :green})
(def md-face-link {:fg :cyan :underline true})
(def md-face-list {:fg :yellow})
(def md-face-quote {:fg :dark-grey :italic true})

;; ---- character / scanning helpers -------------------------------------------

(defn- md-digit? (c)
  "True if single-char string `c` is an ASCII digit."
  (includes? "0123456789" c))

(defn- md-bullet? (c)
  "True if `c` is an unordered-list bullet marker (`-`, `*`, or `+`)."
  (or (= c "-") (= c "*") (= c "+")))

(defn- md-lead-ws (line)
  "The column where `line`'s leading whitespace (spaces / tabs) ends."
  (md-lead-ws-at line 0 (string/length line)))
(sig md-lead-ws (string -> int))
(defn- md-lead-ws-at (line i n)
  ;; `string/span` is the native run scan — one call, not one `char-at` per column
  (math/min n (string/span line i " \t")))
(sig md-lead-ws-at (string int int -> int))

(defn- md-count-char (line i n ch)
  "How many copies of single-char `ch` run consecutively starting at offset `i`."
  (md-count-char-at line i n ch 0))
(sig md-count-char (string int int string -> int))
(defn- md-count-char-at (line i n ch k)
  (+ k (- (math/min n (string/span line i ch)) i)))
(sig md-count-char-at (string int int string int -> int))

(defn- md-find-char (line i n ch)
  "The offset of the next single-char `ch` at or after `i` in `line`, or -1."
  ;; `index-of` with a `from` rides the native `%str-index-of`; `n` is the line's length,
  ;; so a hit is always inside it.
  (if (>= i n) -1 (index-of line ch i)))
(sig md-find-char (string int int string -> int))

(defn- md-find-2 (line i n a b)
  "The offset of the next two-char run `a b` at or after `i` in `line`, or -1."
  (if (>= i n) -1 (index-of line (str a b) i)))
(sig md-find-2 (string int int string string -> int))

(defn- md-space-after? (line i n)
  "True if offset `i` is end-of-line or a space — the separator a list marker needs."
  (or (>= i n) (= (string/char-at line i) " ")))
(sig md-space-after? (string int int -> bool))

;; ---- line-shape classifiers -------------------------------------------------

(defn- md-fence? (line)
  "True if `line` is a fenced-code delimiter — three or more `` ` `` or `~`, after up
to its leading whitespace."
  (let (lead (md-lead-ws line)
        n (string/length line)
        c (if (< lead n) (string/char-at line lead) ""))
    (and (or (= c "`") (= c "~"))
      (>= (md-count-char line lead n c) 3))))
(sig md-fence? (string -> bool))

(defn- md-heading-level (line)
  "The ATX heading level (1–6) of `line` — its run of leading `#`s, which must be
followed by a space or end-of-line — or nil if it isn't a heading."
  (let (n (string/length line)
        lead (md-lead-ws line)
        h (md-count-char line lead n "#"))
    (if (and (>= h 1) (<= h 6) (or (= (+ lead h) n) (= (string/char-at line (+ lead h)) " ")))
      h
      nil)))
(sig md-heading-level (string -> (or int nil)))

(defn- md-ordered-end (line i n)
  "Given digits start at `i`, the offset just past an ordered-list marker
(`1.`/`1)` followed by a space or EOL), or -1 if `line` has no such marker there."
  (let (d (md-digits-end line i n))
    (if (= d i)
      -1
      (if (and (< d n)
            (or (= (string/char-at line d) ".") (= (string/char-at line d) ")"))
            (md-space-after? line (inc d) n))
        (inc d)
        -1))))
(sig md-ordered-end (string int int -> int))
(defn- md-digits-end (line i n)
  (if (and (< i n) (md-digit? (string/char-at line i))) (md-digits-end line (inc i) n) i))
(sig md-digits-end (string int int -> int))

;; ---- block markers (the leading `>` / bullet a line may carry) --------------

(defn- md-block (line base lead n)
  "The leading block marker of `line` (offsets shifted by `base`): a `[spans col]`
pair — `spans` a one-element list for a `>` blockquote or a list bullet (else `()`),
and `col` the column where inline content begins (past the marker, or `lead`)."
  (if (>= lead n)
    [() lead]
    (let (c (string/char-at line lead))
      (cond
        (= c ">") [(list [(+ base lead) (+ base (inc lead)) md-face-quote]) (inc lead)]
        (and (md-bullet? c) (md-space-after? line (inc lead) n))
          [(list [(+ base lead) (+ base (inc lead)) md-face-list])
            (inc lead)]
        (md-digit? c)
          (let (oe (md-ordered-end line lead n))
            (if (< oe 0)
              [() lead]
              [(list [(+ base lead) (+ base oe) md-face-list]) oe]))
        else [() lead]))))
(sig md-block (string int int int -> vector))

;; ---- the inline scanner: code / bold / italic / links -----------------------

(defn- md-delim2? (line i n)
  "True if offsets `i` and `i+1` are a matching pair of `*` or `_` — a bold delimiter."
  (and (< (inc i) n)
    (let (c (string/char-at line i))
      (and (or (= c "*") (= c "_")) (= (string/char-at line (inc i)) c)))))
(sig md-delim2? (string int int -> bool))

(defn- md-link-span (line base i n)
  "A `[start end face]` link span for `[text](url)` starting at `i` (offsets shifted
by `base`), or nil when the text isn't immediately followed by a closed `(url)`."
  (let (close (md-find-char line (inc i) n "]"))
    (if (or (< close 0) (>= (inc close) n) (not (= (string/char-at line (inc close)) "(")))
      nil
      (let (pclose (md-find-char line (+ close 2) n ")"))
        (if (< pclose 0)
          nil
          [(+ base i) (+ base (inc pclose)) md-face-link])))))
(sig md-link-span (string int int int -> (or (tuple int int map) nil)))

(defn- md-inline-emph (line base i n acc)
  "Scan a single-char emphasis (`*`/`_`) at `i`: emit an italic span to its closing
delimiter (or skip the char if unclosed), then continue the inline scan."
  (let (a (string/char-at line i)
        j (md-find-char line (inc i) n a))
    (if (< j 0)
      (md-inline line base (inc i) n acc)
      (md-inline line
        base
        (inc j)
        n
        (cons [(+ base i) (+ base (inc j)) md-face-italic] acc)))))
(sig md-inline-emph (string int int int list -> list))

(defn- md-inline (line base i n acc)
  "Tail-recursive inline scanner over `[i, n)` of `line` (offsets shifted by `base`),
accumulating spans for `` `code` ``, `**bold**`, `*italic*`, and `[text](url)` in
reverse. Each matched region is consumed whole, so spans stay non-overlapping."
  ;; Plain text is the common case, so the scan JUMPS to the next delimiter with one
  ;; native `string/span-until` instead of visiting each character through `char-at`:
  ;; a per-char step in interpreted Brood cost ~2 ms/KB, eight times brood-mode's lexer,
  ;; and the editor re-lexes a ~300-line band on every keystroke in a `.md` buffer —
  ;; the per-edit hitch the fontify window could not amortise away.
  (let (i (if (>= i n) n (string/span-until line i "`*_[")))
    (if (>= i n)
      (reverse acc)
      (let (c (string/char-at line i))
        (cond
          ;; inline code: `…`
          (= c "`")
            (let (j (md-find-char line (inc i) n "`"))
              (if (< j 0)
                (md-inline line base (inc i) n acc)
                (md-inline line
                  base
                  (inc j)
                  n
                  (cons [(+ base i) (+ base (inc j)) md-face-code] acc))))
          ;; bold: **…** or __…__ (fall back to italic when unclosed)
          (md-delim2? line i n)
            (let (a (string/char-at line i)
                  j (md-find-2 line (+ i 2) n a a))
              (if (< j 0)
                (md-inline-emph line base i n acc)
                (md-inline line
                  base
                  (+ j 2)
                  n
                  (cons [(+ base i) (+ base (+ j 2)) md-face-bold] acc))))
          ;; italic: *…* or _…_
          (or (= c "*") (= c "_")) (md-inline-emph line base i n acc)
          ;; link: [text](url)
          (= c "[")
            (let (span (md-link-span line base i n))
              (if (nil? span)
                (md-inline line base (inc i) n acc)
                (md-inline line base (- (second span) base) n (cons span acc))))
          else (md-inline line base (inc i) n acc))))))
(sig md-inline (string int int int list -> list))

;; ---- a line's spans + the document walker -----------------------------------

(defn- md-line-spans (line base fence)
  "The `[new-fence spans]` for one `line` starting at offset `base`, given whether we
are currently inside a fenced code block (`fence`). A fence delimiter or any line
inside a block colours whole as code (and toggles `fence`); a heading colours whole;
otherwise a leading block marker plus an inline scan of the rest."
  (let (n (string/length line))
    (cond
      fence [(not (md-fence? line)) (list [base (+ base n) md-face-code])]
      (md-fence? line) [true (list [base (+ base n) md-face-code])]
      (md-heading-level line) [false (list [base (+ base n) md-face-heading])]
      else
        (let (lead (md-lead-ws line)
              [marker mstart] (md-block line base lead n))
          [false (append marker (md-inline line base mstart n '()))]))))
(sig md-line-spans (string int bool -> vector))

;; One `string-split` for the whole source, then walk the lines with a running offset —
;; instead of `(string/substring src i e)` per line with a rising `i`. Both of the old per-line
;; calls (`string-span-until` to find the newline, `substring` to cut the line) convert a
;; CHAR index to a byte offset, which is O(1) only on pure-ASCII text; off that fast path it
;; is O(i), so the document scan was O(n²) as soon as one non-ASCII character appeared —
;; measured 5.03x then 6.92x across three rising points, against 3.81x/3.88x for the same
;; text in ASCII. Splitting once is the same fix `stream-lines` needed (2026-08-02) and for
;; the same reason. The offset arithmetic replaces the newline scan exactly: the next line
;; starts one past this line's end.
;;
;; `string-split` yields a trailing "" when the source ends in a newline (and `("")` for the
;; empty string), where the old `(>= i n)` loop stopped instead. Dropping a final empty
;; element reproduces the old line set exactly for every case — "", "a", "a\n", "a\nb",
;; "a\nb\n", "\n", "a\n\nb" — which the equivalence test in `tests/markdown_test.blsp`
;; pins rather than leaving to this comment.
(defn- md-drop-trailing-empty (lines)
  (let (r (reverse lines))
    (if (and (not (empty? r)) (= (first r) "")) (reverse (rest r)) lines)))

(defn- md-lex-lines (lines i fence acc)
  "Tail-recursive walker over pre-split lines, threading the fenced-code `fence` state and
accumulating spans in reverse. `i` is the char offset of `line` in the original source."
  (if (empty? lines)
    (reverse acc)
    (let (line (first lines)
          [fence2 spans] (md-line-spans line i fence))
      (md-lex-lines (rest lines)
        (+ i (string/length line) 1)
        fence2
        (fold spans acc (fn (a s) (cons s a)))))))
(sig md-lex-lines (list int bool list -> list))

(defn markdown-spans (src)
  "Lexically tokenize Markdown `src` into a list of `[start end face]` colour spans
(character offsets, end-exclusive) — in the `highlight-spans` shape, so it feeds the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Covers ATX
headings, fenced code blocks, list bullets and blockquotes (line shapes), and inline
code / bold / italic / links. Spans are ascending and non-overlapping; text carrying
no markup carries no span (the default face)."
  (md-lex-lines (md-drop-trailing-empty (string/split src "\n")) 0 false '()))
(sig markdown-spans (string -> any))

;; ---- rendering: the document as READABLE text, faces carried as data ---------
;;
;; `markdown-spans` colours the SOURCE — the markers stay, the reader sees `**bold**`. A
;; preview wants the other thing: the text the markup DESCRIBES, with the markers gone,
;; paragraphs re-flowed to a width, and the faces that survived attached to the rendered
;; characters. That is a rich-text value, `{:text :spans :lines}`: the same
;; `[start end face]` spans over `:text` that the `fontify-runs` tiler already takes, so a
;; buffer holding the rendered text paints from the spans as DATA rather than from a lexer
;; (no lexer can recover faces from text whose markers are gone). `:lines` maps each
;; rendered line back to the source line it came from, which is what lets a preview pane
;; follow the cursor in the source.
;;
;; The same lexical stance as the highlighter: line shapes and a left-to-right inline scan,
;; not a CommonMark parser. The inline scan is the highlighter's, re-expressed to yield the
;; text BETWEEN the markers with the marker's face — the two must agree on what a marker
;; is, and they do by construction.

(defn- md-plain-runs (s face)
  ;; A run of plain text, dropped when empty so no zero-width run reaches the wrapper.
  (if (= s "") '() (list [s face])))
(sig md-plain-runs (string any -> list))

(defn- md-inline-runs (line i n base-face acc)
  "The inline scan as RUNS: `[text face]` pairs (reverse order in `acc`) covering `[i, n)`
of `line`, plain text under `base-face`, each marked region reduced to its content under
its face. Unclosed markers are literal characters, as in the highlighter."
  (let (j (if (>= i n) n (string/span-until line i "`*_["))
        acc (if (> j i) (append (md-plain-runs (string/substring line i j) base-face) acc) acc)
        i j)
    (if (>= i n)
      (reverse acc)
      (let (c (string/char-at line i))
        (cond
          (= c "`")
            (let (k (md-find-char line (inc i) n "`"))
              (if (< k 0)
                (md-inline-runs line (inc i) n base-face (cons ["`" base-face] acc))
                (md-inline-runs line
                  (inc k)
                  n
                  base-face
                  (append (md-plain-runs (string/substring line (inc i) k) md-face-code) acc))))
          (md-delim2? line i n)
            (let (a (string/char-at line i)
                  k (md-find-2 line (+ i 2) n a a))
              (if (< k 0)
                (md-inline-emph-runs line i n base-face acc)
                (md-inline-runs line
                  (+ k 2)
                  n
                  base-face
                  (append (md-plain-runs (string/substring line (+ i 2) k) md-face-bold) acc))))
          (or (= c "*") (= c "_")) (md-inline-emph-runs line i n base-face acc)
          (= c "[")
            (let (span (md-link-span line 0 i n))
              (if (nil? span)
                (md-inline-runs line (inc i) n base-face (cons ["[" base-face] acc))
                (let (close (md-find-char line (inc i) n "]"))
                  (md-inline-runs line
                    (second span)
                    n
                    base-face
                    (append (md-plain-runs (string/substring line (inc i) close) md-face-link)
                      acc)))))
          else (md-inline-runs line (inc i) n base-face (cons [c base-face] acc)))))))
(sig md-inline-runs (string int int any list -> list))

(defn- md-inline-emph-runs (line i n base-face acc)
  ;; `*x*` / `_x_` → x in italics; an unclosed marker is the literal character
  (let (a (string/char-at line i)
        k (md-find-char line (inc i) n a))
    (if (< k 0)
      (md-inline-runs line (inc i) n base-face (cons [a base-face] acc))
      (md-inline-runs line
        (inc k)
        n
        base-face
        (append (md-plain-runs (string/substring line (inc i) k) md-face-italic) acc)))))
(sig md-inline-emph-runs (string int int any list -> list))

(defn- md-runs-of (text base-face)
  "The `[text face]` runs of one line of inline markup, plain text under `base-face`."
  (md-inline-runs text 0 (string/length text) base-face '()))
(sig md-runs-of (string any -> list))

;; ---- words: runs cut at whitespace, so a paragraph can be re-flowed ----------
;; A WORD is a list of `[text face]` fragments with no whitespace in it — more than one
;; fragment when markup starts mid-word (`foo**bar**`). Filling then places words, and a
;; word's fragments become spans at wherever it landed.

(defn- md-word-len (word)
  (fold word 0 (fn (n frag) (+ n (string/length (first frag))))))
(sig md-word-len (list -> int))

(defn- md-words (runs)
  "Cut `runs` into words at spaces: a list of words, each a list of `[text face]`
fragments, in order, with empty words (runs of spaces) dropped."
  (let ([cur done] (fold runs
                     ['() '()]
                     (fn (acc run)
                       (let ([cur done] acc
                             [text face] run
                             pieces (string/split text " ")
                             ;; the first piece continues the current word; each later piece starts one
                             cur1 (if (= (first pieces) "") cur (cons [(first pieces) face] cur))
                             [cur2 done2] (fold (rest pieces)
                                            [cur1 done]
                                            (fn (a p)
                                              (let ([c d] a
                                                    d1 (if (empty? c) d (cons (reverse c) d)))
                                                [(if (= p "") '() (list [p face])) d1]))))
                         [cur2 done2]))))
    (reverse (if (empty? cur) done (cons (reverse cur) done)))))
(sig md-words (list -> list))

(defn- md-word-spans (word at acc)
  ;; The spans of `word`'s faced fragments placed at column `at`, consed (reversed) onto `acc`;
  ;; a fragment continuing the previous span's face extends it instead of starting another
  ;; (so `**a b**` is ONE bold span across its space, the way the source marked it).
  (fold word
    [at acc]
    (fn (st frag)
      (let ([pos acc] st
            [text face] frag
            end (+ pos (string/length text))
            prev (first acc))
        [end
          (cond
            (nil? face) acc
            (and prev (= (nth prev 2) face) (>= (inc (nth prev 1)) pos))
              (cons [(nth prev 0) end face] (rest acc))
            else (cons [pos end face] acc))]))))
(sig md-word-spans (list int list -> vector))

(defn- md-fill-words (words width first-prefix rest-prefix)
  "Greedily fill `words` into lines of at most `width` columns (a word longer than that
keeps its own line). The first line opens with `first-prefix`, every later one with
`rest-prefix` (a hanging indent); each prefix is a `[text face]` run. Returns a list of
`[text spans]` lines, spans relative to the line."
  (let (pre-len (fn (p) (string/length (first p)))
        ;; one line: its prefix, then its words separated by single spaces
        finish (fn (prefix line-words)
                 (let (ws (reverse line-words)
                       [end spans] (fold ws
                                     ;; the prefix's face covers its marker, not the space after it
                                     [(pre-len prefix)
                                       (if (nil? (second prefix))
                                         '()
                                         (list [0
                                                 (string/length (string/trimr (first prefix)))
                                                 (second prefix)]))]
                                     (fn (st w)
                                       (let ([pos acc] st
                                             [pos1 acc1] (if (= pos (pre-len prefix))
                                                           [pos acc]
                                                           [(inc pos) acc])
                                             [end acc2] (md-word-spans w pos1 acc1))
                                         [end acc2])))
                       text (str (first prefix)
                              (string/join (map ws (fn (w) (string/join (map w first) ""))) " ")))
                   [text (reverse spans)]))
        [cur cur-len done] (fold words
                             ['() (pre-len first-prefix) '()]
                             (fn (st w)
                               (let ([cur cur-len done] st
                                     wl (md-word-len w)
                                     sep (if (empty? cur) 0 1))
                                 (if (or (empty? cur) (<= (+ cur-len sep wl) width))
                                   [(cons w cur) (+ cur-len sep wl) done]
                                   [(list w)
                                     (+ (pre-len rest-prefix) wl)
                                     (cons (finish (if (empty? done) first-prefix rest-prefix) cur)
                                       done)])))))
    (reverse (if (empty? cur)
               (if (empty? done) (list (finish first-prefix '())) done)
               (cons (finish (if (empty? done) first-prefix rest-prefix) cur) done)))))
(sig md-fill-words (list int vector vector -> list))

;; ---- block shapes -------------------------------------------------------------

(defn- md-rule? (line)
  ;; `---` / `***` / `___` (three or more, spaces allowed) — a thematic break
  (let (t (string/replace (string/trim line) " " "")
        n (string/length t))
    (and (>= n 3)
      (let (c (string/char-at t 0))
        (and (or (= c "-") (= c "*") (= c "_")) (= (string/span t 0 c) n))))))
(sig md-rule? (string -> bool))

(defn- md-quote? (line)
  (let (lead (md-lead-ws line))
    (and (< lead (string/length line)) (= (string/char-at line lead) ">"))))
(sig md-quote? (string -> bool))

(defn- md-quote-body (line)
  ;; the text after the `>` and one optional space
  (let (lead (md-lead-ws line)
        n (string/length line)
        i (inc lead))
    (string/substring line (if (and (< i n) (= (string/char-at line i) " ")) (inc i) i) n)))
(sig md-quote-body (string -> string))

(defn- md-item-marker (line)
  "`[marker body-col]` when `line` opens a list item — the marker text (`-`, `*`, `+` or
`12.`) and the column its content starts at — else nil."
  (let (lead (md-lead-ws line)
        n (string/length line)
        [spans col] (md-block line 0 lead n))
    (if (empty? spans)
      nil
      (let ([s e f] (first spans))
        (if (= f md-face-list) [(string/substring line s e) (md-lead-ws-at line col n)] nil)))))
(sig md-item-marker (string -> (or nil (tuple string int))))

(defn- md-blank? (line)
  (string/blank? line))
(sig md-blank? (string -> bool))

(defn- md-paragraph-line? (line)
  ;; a line that continues a paragraph: not blank and not opening any other block
  (not (or (md-blank? line)
         (md-fence? line)
         (md-heading-level line)
         (md-rule? line)
         (md-quote? line)
         (md-item-marker line))))
(sig md-paragraph-line? (string -> bool))

;; ---- the walker: source lines → rendered lines --------------------------------
;; A rendered line is `[text spans src]` — its text, its spans relative to itself, and the
;; source line it stands for. Blocks are cut here, filled by `md-fill-words`, and the
;; document is assembled at the end (`md-assemble`), where the relative spans become
;; absolute.

(defn- md-take-while (lines i pred)
  ;; the index of the first line at/after `i` failing `pred` (or the end)
  (if (and (< i (count lines)) (pred (nth lines i))) (md-take-while lines (inc i) pred) i))
(sig md-take-while (vector int any -> int))

(defn- md-spread (rendered from to)
  "Stamp the `[text spans]` lines of one block with source lines: a block from source lines
`from`..`to` (inclusive) that filled to k lines maps them across that range evenly, so a
preview following the cursor lands in the right part of a long paragraph."
  (let (k (count rendered)
        span (inc (- to from))
        [_ out] (fold rendered
                  [0 '()]
                  (fn (st line)
                    (let ([j acc] st
                          [text spans] line)
                      [(inc j) (cons [text spans (+ from (math/quot (* j span) k))] acc)]))))
    (reverse out)))
(sig md-spread (list int int -> list))

(defn- md-heading (line src width)
  ;; the heading text under its face, underlined for the top two levels
  (let (level (md-heading-level line)
        text (string/trim (string/substring line level (string/length line)))
        n (string/length text)
        head [text (if (= n 0) '() (list [0 n md-face-heading])) src])
    (cond
      (= level 1) (list head [(string/repeat "━" (math/max 1 (math/min width n))) '() src])
      (= level 2) (list head [(string/repeat "─" (math/max 1 (math/min width n))) '() src])
      else (list head))))
(sig md-heading (string int int -> list))

(defn- md-block-at (lines i width)
  "Cut the block opening at source line `i`: `[rendered next]` — its rendered
`[text spans src]` lines and the index of the first line after it."
  (let (line (nth lines i))
    (cond
      ;; blank: one blank rendered line for a run of them
      (md-blank? line) [(list ["" '() i]) (md-take-while lines i md-blank?)]
      ;; fenced code: the lines between the fences, verbatim, indented, all code
      (md-fence? line)
        (let (j (md-take-while lines (inc i) (fn (l) (not (md-fence? l))))
              body (map (range (inc i) j)
                     (fn (k)
                       (let (t (str "    " (nth lines k)))
                         [t (list [0 (string/length t) md-face-code]) k]))))
          ;; the closing fence, when there is one, is consumed too
          [(if (empty? body) (list ["" '() i]) body) (if (< j (count lines)) (inc j) j)])
      (md-heading-level line) [(md-heading line i width) (inc i)]
      (md-rule? line) [(list [(string/repeat "─" width) (list [0 width md-face-quote]) i]) (inc i)]
      ;; blockquote: a run of `>` lines, re-flowed, under a bar
      (md-quote? line)
        (let (j (md-take-while lines i md-quote?)
              text (string/join (map (range i j) (fn (k) (md-quote-body (nth lines k)))) " ")
              filled (md-fill-words (md-words (md-runs-of text md-face-quote))
                       width
                       ["│ " md-face-quote]
                       ["│ " md-face-quote]))
          [(md-spread filled i (dec j)) j])
      ;; list item: the marker, then the item text with a hanging indent; the lines that
      ;; follow it indented (and open nothing else) belong to the item
      (md-item-marker line)
        (let ([marker col] (md-item-marker line)
              lead (md-lead-ws line)
              j (md-take-while lines
                  (inc i)
                  (fn (l) (and (md-paragraph-line? l) (> (md-lead-ws l) 0))))
              text (string/join (cons (string/substring line col (string/length line))
                                  (map (range (inc i) j) (fn (k) (string/trim (nth lines k)))))
                     " ")
              bullet (if (md-digit? (string/char-at marker 0)) marker "•")
              indent (string/repeat " " lead)
              hang (string/repeat " " (+ lead (string/length bullet) 1))
              filled (md-fill-words (md-words (md-runs-of text nil))
                       width
                       [(str indent bullet " ") md-face-list]
                       [hang nil]))
          [(md-spread filled i (dec j)) j])
      ;; paragraph: a run of plain lines, re-flowed
      else
        (let (j (md-take-while lines i md-paragraph-line?)
              text (string/join (map (range i j) (fn (k) (string/trim (nth lines k)))) " ")
              filled (md-fill-words (md-words (md-runs-of text nil)) width ["" nil] ["" nil]))
          [(md-spread filled i (dec j)) j]))))
(sig md-block-at (vector int int -> vector))

(defn- md-render-lines (lines i width acc)
  "Tail-recursive walker over the pre-split source `lines` (a vector) from index `i`,
accumulating rendered `[text spans src]` lines in reverse, one block at a time."
  (if (>= i (count lines))
    (reverse acc)
    (let ([rendered next] (md-block-at lines i width))
      (md-render-lines lines next width (fold rendered acc (fn (a l) (cons l a)))))))
(sig md-render-lines (vector int int list -> list))

(defn- md-assemble (rendered)
  ;; `[text spans src]` lines → `{:text :spans :lines}`, the spans shifted to absolute offsets
  (let ([off spans] (fold rendered
                      [0 '()]
                      (fn (st line)
                        (let ([off acc] st
                              [text sp src] line)
                          [(+ off (string/length text) 1)
                            (fold sp
                              acc
                              (fn (a s) (let ([a1 b1 f] s) (cons [(+ off a1) (+ off b1) f] a))))]))))
    {:text (string/join (map rendered (fn (l) (nth l 0))) "\n")
     :spans (reverse spans)
     :lines (into [] (map rendered (fn (l) (nth l 2))))}))
(sig md-assemble (list -> map))

(defn markdown-render (src width)
  "Render Markdown `src` as readable text `width` columns wide — the markers gone, the
faces kept as data. Returns `{:text :spans :lines}`:

  - `:text`  — headings on their own lines (the top two underlined), paragraphs and
    blockquotes (`│ `) re-flowed to `width`, list items as `•`/`1.` with a hanging
    indent, fenced code indented and verbatim, a rule as a line of `─`;
  - `:spans` — `[start end face]` over `:text`, ascending and non-overlapping (the
    `fontify-runs` shape), with the highlighter's faces: what was `**bold**` is bold,
    a link is its text underlined, code is green;
  - `:lines` — a vector, one entry per rendered line: the SOURCE line it came from,
    non-decreasing. See [[markdown-rendered-line]].

Lexical, like `markdown-spans`, and pure: the editor shows the result in a preview pane
and follows the cursor with `:lines`."
  (let (width (math/max 10 width))
    (md-assemble (md-render-lines (into [] (md-drop-trailing-empty (string/split src "\n")))
                   0 width '()))))
(sig markdown-render (string int -> map))

(defn- md-line-at (lines i n src-line)
  (cond
    (>= i n) (math/max 0 (dec n))
    (>= (nth lines i) src-line) i
    else (md-line-at lines (inc i) n src-line)))
(sig md-line-at (vector int int int -> int))

(defn markdown-rendered-line (rendered src-line)
  "The first rendered line of `rendered` (a [[markdown-render]] result) standing for
source line `src-line` or a later one — where a preview should scroll to when the
cursor is on that line; the last rendered line when the source line is past them all.
0 for an empty render."
  (let (lines (:lines rendered))
    (md-line-at lines 0 (count lines) src-line)))
(sig markdown-rendered-line (map int -> int))
