;; std/editor/pane.blsp — Emacs-style tiled pane splits over the display seam.
;; Pure and content-agnostic.
;;
;; A *pane layout* is an immutable **binary tree**: a leaf is one pane showing
;; an opaque PAYLOAD (the toolkit never inspects it — an editor stores e.g.
;; `{:buffer <i> :top <n>}` there); a split divides its rect between two children
;; either `:row` (stacked, a above b) or `:col` (side by side, a left of b), with a
;; `:ratio` (the fraction given to child `a`). Exactly one leaf is *selected* (the
;; `:selected` marker travels with the tree, so there is no separate selected-path
;; to keep in sync — `C-x o` just moves the marker).
;;
;; The split point reserves **one cell** for a divider (a column for `:col`, a row
;; for `:row`), and `pane-layout` reports those divider rects so a frontend can
;; paint them and hit-test a drag. Resizing is then pure: `divider-at` finds the
;; divider under a `[:mouse … row col]` point, `pane-ratio-for` turns a drag point
;; into the split's new ratio, and `pane-set-ratio` returns the re-proportioned
;; tree. The kernel `:drag`/`:release` mouse events (ADR-077) are what let a frontend
;; drive that loop; the geometry here is all Brood, so it stays live-editable.
;;
;; This is reusable editor *mechanism* (the editor toolkit), not policy: which keys
;; split/cycle/resize, and what a payload is, live in the editor (see myedit).

(defmodule editor/pane
  "An immutable binary-tree pane layout (Emacs-style tiled splits) over the M3
display seam. A leaf shows an opaque payload; a `:row`/`:col` split divides its rect
by a `:ratio`, reserving one cell for a divider. `pane-layout` turns a tree + a
rect into pane rects + divider rects; `pane-split`/`pane-delete`/`pane-other`
restructure it; `pane-swap`/`pane-rotate`/`pane-transpose`/`pane-flip` move panes
around and `pane-neighbor` finds the pane in a direction (windmove); `divider-at` +
`pane-ratio-for` + `pane-set-ratio` implement drag-to-resize over the kernel's `:drag`
mouse events (ADR-077). Pure and content-agnostic — the editor supplies the payload and
the keybindings."
  (:use math))

;; Note on recursion: the helpers below walk the layout *tree*, so they recurse on
;; its DEPTH — the number of nested splits — not on any list length or leaf count.
;; That depth is bounded by how many times a user has split the frame (a handful;
;; each split halves a pane, so a screen tops out well before deep nesting). The
;; non-tail-recursion checker can't see that bound and flags these; they're safe as
;; plain tree recursion (cf. std/sexp.blsp's CST walk). Don't contort them into an
;; explicit-stack tail loop — there's no overflow to prevent here.

;; ---- the shapes, named once (ADR-326) ---------------------------------------
;; What `pane-layout` hands out. A frontend keeps these as plain maps (no `defrecord`
;; identity — a literal `{:rect …}` in a test IS a pane), and every consumer's `sig`
;; names the shape here instead of spelling it: `(sig pane-rows (pane -> int))`. Open,
;; because a value may carry more than the layout put there.
(deftype rect (tuple int int int int))
(deftype pane (record &open :path list :payload any :selected bool :rect rect))
(deftype divider (record &open :path list :dir (or :row :col) :rect rect :split-rect rect))
(deftype layout (record &open :panes (list pane) :dividers (or nil (list divider))))

;; ---- nodes ------------------------------------------------------------------

(defn pane-single (payload)
  "A lone pane layout: one selected leaf showing `payload`. The starting tree
(and what `pane-delete-others` collapses back to)."
  {:pane true :payload payload :selected true})

(defn pane-leaf? (node)
  "True if `node` is a pane (a leaf), false if it's a split."
  (= true (get node :pane)))

;; ---- paths (a list of :a/:b from the root to a node) ------------------------
;; Paths are transient addresses derived from the tree (e.g. by `pane-layout`
;; for a divider, or to find the selected leaf); they're never stored long-term, so
;; restructuring can't leave a stale one behind. Selection itself is a `:selected`
;; marker on the leaf, not a path.

(defn- pane-get (node path)
  "The node at `path` (a list of `:a`/`:b`) under `node`."
  (if (empty? path) node (pane-get (get node (first path)) (rest path))))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn- pane-update (node path f)
    "The tree like `node` with the node at `path` replaced by `(f node-at-path)`."
    (if (empty? path)
      (f node)
      (let (k (first path))
        (assoc node k (pane-update (get node k) (rest path) f))))))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn- pane-paths (node prefix)
    "All leaf paths under `node` in traversal order (a before b), each prefixed by
  the forward-order `prefix`."
    (if (pane-leaf? node)
      (list prefix)
      (append (pane-paths (get node :a) (append prefix (list :a)))
        (pane-paths (get node :b) (append prefix (list :b)))))))

(defn pane-leaf-paths (tree)
  "Every leaf's path, in left-to-right / top-to-bottom traversal order."
  (pane-paths tree ()))

(defn pane-count (tree)
  "How many panes (leaves) the layout holds."
  (count (pane-leaf-paths tree)))

;; ---- selection --------------------------------------------------------------

(defn pane-selected-path (tree)
  "The path of the selected leaf (`()` for a lone pane)."
  (seq/find (pane-leaf-paths tree) (fn (p) (get (pane-get tree p) :selected))))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn- pane-clear (node)
    "The tree with the `:selected` marker cleared from every leaf."
    (if (pane-leaf? node)
      (assoc node :selected false)
      (assoc node :a (pane-clear (get node :a)) :b (pane-clear (get node :b))))))

(defn pane-select-path (tree path)
  "The tree with the leaf at `path` made the sole selected pane."
  (pane-update (pane-clear tree) path (fn (leaf) (assoc leaf :selected true))))

(defn pane-selected-payload (tree)
  "The payload of the selected pane."
  (get (pane-get tree (pane-selected-path tree)) :payload))

(defn pane-update-selected (tree f)
  "The tree with the selected pane's payload replaced by `(f payload)` — how an
editor applies an edit to whatever the active pane shows."
  (pane-update tree
    (pane-selected-path tree)
    (fn (leaf) (assoc leaf :payload (f (get leaf :payload))))))

(defn pane-update-path (tree path f)
  "The tree with the payload of the pane at `path` replaced by `(f payload)` — the
position-targeted sibling of `pane-update-selected`. Lets an editor act on the pane
*under the pointer* (via `pane-at`'s `:path`) — e.g. wheel zoom / scroll — without
disturbing which pane is selected."
  (pane-update tree path (fn (leaf) (assoc leaf :payload (f (get leaf :payload))))))

(defn pane-payload-at (tree path)
  "The payload of the pane at `path` — the read half of `pane-update-path`, and the
position-targeted sibling of `pane-selected-payload`. Combined with `pane-leaf-paths`
it lets an editor answer 'which pane, if any, already shows buffer N?' (the reuse rule
behind an Emacs-style `display-buffer`)."
  (get (pane-get tree path) :payload))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn pane-map (tree f)
    "The tree with `f` applied to *every* pane's payload (leaves only; splits and
  selection unchanged). For an editor re-pointing pane→buffer references after the
  buffer pool changes — e.g. decrementing indices above a killed buffer."
    (if (pane-leaf? tree)
      (assoc tree :payload (f (get tree :payload)))
      (assoc tree :a (pane-map (get tree :a) f) :b (pane-map (get tree :b) f)))))

(defn pane-other (tree)
  "Move selection to the next pane in traversal order, wrapping (Emacs `C-x o`)."
  (let (paths (pane-leaf-paths tree)
        i (index-of paths (pane-selected-path tree)))
    (pane-select-path tree (nth paths (math/mod (inc i) (count paths))))))

;; ---- structure (split / delete) ---------------------------------------------

(defn pane-split (tree dir new-payload)
  "Split the selected pane in `dir` (`:row` stacked, `:col` side by side) into two
even panes: the original (still selected) becomes child `a`, a new pane showing
`new-payload` becomes child `b` (Emacs `C-x 2` / `C-x 3` — point stays put)."
  (pane-update tree
    (pane-selected-path tree)
    (fn (leaf)
      {:split true
       :dir dir
       :ratio 0.5
       :a leaf
       :b {:pane true :payload new-payload :selected false}})))

(defn pane-delete (tree)
  "Delete the selected pane: its sibling subtree takes the split's place, and
selection moves to that subtree's first pane (Emacs `C-x 0`). A lone pane is
returned unchanged — you can't delete the only one."
  (let (p (pane-selected-path tree))
    (if (empty? p)
      tree
      (let (parent (seq/drop-last p 1)
            sib (if (= (last p) :a) :b :a)
            pruned (pane-update tree parent (fn (split) (get split sib))))
        (pane-select-path pruned (first (pane-leaf-paths pruned)))))))

(defn pane-delete-others (tree)
  "Collapse the layout to just the selected pane, filling the whole frame (Emacs
`C-x 1`)."
  (pane-single (pane-selected-payload tree)))

;; ---- moving panes around (swap / rotate / transpose) ------------------------
;; The window-management verbs of Emacs' `windmove-swap-states-*`, `buffer-move` and
;; `transpose-frame`. All of them move PAYLOADS between leaves or re-shape splits; none
;; creates or removes a pane, so every path stays valid across the call. Selection is a
;; leaf marker, so it stays with the POSITION — the editor decides whether to follow the
;; payload it just moved (a swap that keeps the reader on their buffer selects the other
;; leaf afterwards).

(defn pane-swap (tree path-a path-b)
  "The tree with the payloads of the panes at `path-a` and `path-b` exchanged; the same
tree when the two paths are equal. Selection stays where it was."
  (if (= path-a path-b)
    tree
    (let (pa (pane-payload-at tree path-a)
          pb (pane-payload-at tree path-b))
      (pane-update-path (pane-update-path tree path-a (fn (_) pb)) path-b (fn (_) pa)))))

(defn pane-rotate (tree &optional (n 1))
  "Rotate every pane's payload `n` steps forward through traversal order (each pane takes
the payload of the pane `n` before it; the first takes the last's) — a negative `n` turns
the other way. Selection stays put, so the reader ends up looking at a different buffer
in the same place (Emacs `rotate-frame`'s buffer half)."
  (let (paths (pane-leaf-paths tree)
        k (count paths)
        payloads (map paths (fn (p) (pane-payload-at tree p))))
    (fold (seq/enumerate paths)
      tree
      (fn (t pair)
        (let ([i path] pair
              from (nth payloads (math/mod (- i n) k)))
          (pane-update-path t path (fn (_) from)))))))
(sig pane-rotate (map &optional int -> map))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn pane-transpose (tree)
    "Every split turned the other way — `:row` becomes `:col` and back — so a layout of
  stacked panes becomes side-by-side ones and vice versa, ratios and order kept
  (`transpose-frame`)."
    (if (pane-leaf? tree)
      tree
      (assoc tree
        :dir (if (= (get tree :dir) :row) :col :row)
        :a (pane-transpose (get tree :a))
        :b (pane-transpose (get tree :b))))))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn pane-flip (tree &optional (dir nil))
    "Every split's children exchanged — the layout mirrored — with `:ratio` inverted so
  each pane keeps its size. `dir` restricts it to splits of that direction: `:col` mirrors
  left-right (`flop-frame`), `:row` top-bottom (`flip-frame`), nil both."
    (if (pane-leaf? tree)
      tree
      (let (a (pane-flip (get tree :a) dir)
            b (pane-flip (get tree :b) dir))
        (if (or (nil? dir) (= dir (get tree :dir)))
          (assoc tree :a b :b a :ratio (- 1 (get tree :ratio)))
          (assoc tree :a a :b b))))))

;; ---- neighbours: which pane lies in a direction (windmove) -------------------

(defn- pane-rect-centre (rect)
  (let ([x y w h] rect) [(+ y (math/quot h 2)) (+ x (math/quot w 2))]))
(sig pane-rect-centre (rect -> (tuple int int)))

(defn- pane-beside? (rect from dir)
  "Whether `rect` lies wholly in direction `dir` of `from` and shares rows (for
`:left`/`:right`) or columns (for `:up`/`:down`) with it."
  (let ([x y w h] rect [fx fy fw fh] from)
    (cond
      (= dir :left) (and (<= (+ x w) fx) (< y (+ fy fh)) (< fy (+ y h)))
      (= dir :right) (and (>= x (+ fx fw)) (< y (+ fy fh)) (< fy (+ y h)))
      (= dir :up) (and (<= (+ y h) fy) (< x (+ fx fw)) (< fx (+ x w)))
      else (and (>= y (+ fy fh)) (< x (+ fx fw)) (< fx (+ x w))))))
(sig pane-beside? (rect rect keyword -> bool))

(defn- pane-gap (rect from dir)
  "How far `rect` is from `from` in direction `dir` — the nearest candidate wins."
  (let ([x y w h] rect [fx fy fw fh] from)
    (cond
      (= dir :left) (- fx (+ x w))
      (= dir :right) (- x (+ fx fw))
      (= dir :up) (- fy (+ y h))
      else (- y (+ fy fh)))))
(sig pane-gap (rect rect keyword -> int))

(defn- pane-nearest (cands from dir best)
  (if (empty? cands)
    best
    (let (c (first cands)
          better? (or (nil? best)
                    (< (pane-gap (get c :rect) from dir) (pane-gap (get best :rect) from dir))))
      (pane-nearest (rest cands) from dir (if better? c best)))))
(sig pane-nearest (list rect keyword (or nil pane) -> (or nil pane)))

(defn- pane-across (rect dir)
  ;; a rect's centre coordinate ACROSS the direction of travel: its row for a sideways
  ;; move, its column for a vertical one — what breaks a tie between panes along an edge
  (let ([crow ccol] (pane-rect-centre rect))
    (if (or (= dir :left) (= dir :right)) crow ccol)))
(sig pane-across (rect keyword -> int))

(defn- pane-most-aligned (cands dir across best)
  (if (empty? cands)
    best
    (let (c (first cands)
          d (fn (p) (math/abs (- (pane-across (get p :rect) dir) across)))
          better? (or (nil? best) (< (d c) (d best))))
      (pane-most-aligned (rest cands) dir across (if better? c best)))))
(sig pane-most-aligned (list keyword int (or nil pane) -> (or nil pane)))

(defn pane-neighbor (layout path dir)
  "The pane (`{:path :payload :selected :rect}`) beside the pane at `path` in direction
`dir` (`:left` `:right` `:up` `:down`) in the laid-out `layout`, or nil at the edge.
Among the panes on that side that share rows/columns with it, the nearest; ties —
several panes stacked along the edge — go to the one whose centre is most in line with
the source's, first in traversal order on an exact tie. `windmove`'s question, answered
from the geometry `pane-layout` already computed."
  (let (me (seq/find (get layout :panes) (fn (p) (= (get p :path) path))))
    (if (nil? me)
      nil
      (let (from (get me :rect)
            beside (seq/filter (get layout :panes) (fn (p) (pane-beside? (get p :rect) from dir)))
            nearest (pane-nearest beside from dir nil))
        (if (nil? nearest)
          nil
          (let (gap (pane-gap (get nearest :rect) from dir)
                tied (seq/filter beside (fn (p) (= (pane-gap (get p :rect) from dir) gap))))
            (pane-most-aligned tied dir (pane-across from dir) nil)))))))
(sig pane-neighbor (layout list keyword -> (or nil pane)))

;; ---- layout (tree + rect -> pane rects + divider rects) ---------------------
;; A rect is `[x y w h]` in cells (x = column origin, y = row origin). A point (from
;; a `[:mouse … row col]` event) is `[row col]`.

(defn- pane-clampi (v lo hi)
  "Clamp integer `v` into `[lo hi]`."
  (math/max lo (math/min hi v)))
(sig pane-clampi (int int int -> int))

;; check-allow: deliberately non-tail — depth = the pane tree's split nesting — single digits on any screen.
(check-allow :non-tail-recursion
  (defn- pane-layout-go (node path rect)
    "Lay `node` (at `path`) into `rect`, returning `{:panes (…) :dividers (…)}`."
    (if (pane-leaf? node)
      {:panes (list {:path path
                     :payload (get node :payload)
                     :selected (= true (get node :selected))
                     :rect rect})
       :dividers ()}
      (let ([x y w h] rect
            col? (= (get node :dir) :col)
            ;; the extent split between the two children (less the 1-cell divider),
            ;; and child a's share of it, clamped so neither pane vanishes
            ext (- (if col? w h) 1)
            a-ext (pane-clampi (round (* ext (get node :ratio))) 1 (math/max 1 (- ext 1)))
            arect (if col? [x y a-ext h] [x y w a-ext])
            drect (if col? [(+ x a-ext) y 1 h] [x (+ y a-ext) w 1])
            brect (if col?
                    [(+ x a-ext 1) y (- w a-ext 1) h]
                    [x (+ y a-ext 1) w (- h a-ext 1)])
            la (pane-layout-go (get node :a) (append path (list :a)) arect)
            lb (pane-layout-go (get node :b) (append path (list :b)) brect))
        {:panes (append (get la :panes) (get lb :panes))
         :dividers (cons {:path path :dir (get node :dir) :rect drect :split-rect rect}
                     (append (get la :dividers) (get lb :dividers)))}))))

;; BELOW its definition, outside the wrapper. Indented above it, this sig was invisible to
;; `sig_placement.rs` and, under BROOD_CONTRACTS=1 from source, its deferred contract landed
;; at `provide` — after the loader's reserved-name exemption — and was refused, failing the
;; module (2026-09-06). The gate now reads indented sigs too.
(sig pane-layout-go (any list rect -> layout))

(defn pane-layout (tree rect)
  "Lay `tree` out in `rect` (`[x y w h]` cells): a map `{:panes :dividers}` where
each pane is `{:path :payload :selected :rect}` and each divider is `{:path :dir
:rect :split-rect}` (`:rect` the 1-cell divider line, `:split-rect` the whole rect
that split feeds `pane-ratio-for`). Pure — the frontend paints each pane's payload
into its rect and the dividers between them."
  (pane-layout-go tree () rect))
(sig pane-layout (any rect -> layout))

;; ---- hit-testing + resize (drag-to-resize over :drag mouse events) ----------

(defn- pane-in-rect? (rect point)
  "Whether `point` (`[row col]`) falls inside `rect` (`[x y w h]`)."
  (let ([x y w h] rect [row col] point)
    (and (>= col x) (< col (+ x w)) (>= row y) (< row (+ y h)))))
(sig pane-in-rect? (rect (tuple int int) -> bool))

(defn- pane-find (items point)
  "The first `{:rect …}` in `items` whose rect contains `point`, or nil."
  (cond
    (empty? items) nil
    (pane-in-rect? (get (first items) :rect) point) (first items)
    else (pane-find (rest items) point)))

(defn pane-at (layout point)
  "The pane (`{:path :payload :selected :rect}`) under `point`, or nil."
  (pane-find (get layout :panes) point))
(sig pane-at (layout (tuple int int) -> (or nil pane)))

(defn divider-at (layout point)
  "The divider (`{:path :dir :rect :split-rect}`) under `point`, or nil — what a
frontend stashes on a left-press to begin a drag-resize."
  (pane-find (get layout :dividers) point))
(sig divider-at (layout (tuple int int) -> (or nil divider)))

(defn pane-select-at (tree layout point)
  "Move selection to the pane under `point` (a click selects it); unchanged if the
point is off every pane."
  (let (pane (pane-at layout point))
    (if (nil? pane) tree (pane-select-path tree (get pane :path)))))

(defn pane-ratio-for (divider point)
  "The ratio that places `divider` at `point`, within the divider's `:split-rect` —
i.e. dragging the divider to the pointer. Feed the result to `pane-set-ratio`."
  (let ([x y w h] (get divider :split-rect) [row col] point)
    (if (= (get divider :dir) :col)
      (/ (- col x) (math/max 1 (- w 1)))
      (/ (- row y) (math/max 1 (- h 1))))))
(sig pane-ratio-for (divider (tuple int int) -> number))

(defn pane-set-ratio (tree path ratio)
  "Set the `:ratio` of the split at `path` (clamped to `[0.1 0.9]` so neither pane
vanishes), returning the re-proportioned tree — one step of a divider drag."
  (pane-update tree
    path
    (fn (split) (assoc split :ratio (math/max 0.1 (math/min 0.9 ratio))))))
