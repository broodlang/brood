;; std/editor/buffer-client.blsp — the CLIENT half of the buffer-process protocol.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - `editor/buffer`'s actor shell (`spawn-buffer` / `buffer-serve`) is the SERVER
;;    half of a two-party protocol: it owns the authoritative text, serializes edits,
;;    and pushes `[:buffer-updated pid version view origin]` to subscribers. This
;;    module is the OTHER half — the state a subscriber keeps about one hosted
;;    document (a *link*) and the pure fold that turns each push into an action on
;;    the subscriber's own local copy. Together they make "a document lives in a
;;    process; any number of holders track it by deltas" a std capability (ADR-134).
;;  - The fold is the subtle, load-bearing piece: echo suppression (your own edit
;;    coming back must NOT rebuild content — the local copy may already be ahead of
;;    it), transform of a foreign splice over your in-flight ones (two parties typing
;;    in different places inside one round-trip merge exactly — the client-side
;;    mirror of the server's `recent`-ring transform), pending remap, and the
;;    ambiguous-collision fallback (resync from the process, the always-correct
;;    authority). It was proven in myedit's collab layer and extracted here.
;;  - `link-fold` is PURE — it never touches a process. It returns the new link and
;;    an ACTION for the caller to apply to whatever holds its local copy (an editor's
;;    buffer pool, a registry's text mirror, a test's string). Sending (`link-
;;    propagate`) is the one side-effecting entry point.
;;  - Content crosses as positional SPLICES, never ropes and never closures — closure
;;    edits are invisible to the server's transform ring (see `buffer-serve`), so a
;;    transform-collaborated document must keep content changes structured.

; buffer-splice, splice-disjoint?, splice-transform(-all)
(defmodule editor/buffer-client
  "Track a buffer PROCESS (`editor/buffer` `spawn-buffer`) from the subscribing side:
a *link* — `{:proc <pid> :me <own-id> :version <int> :pending (<[lo hi replen]>…)}`
— plus the two operations the protocol needs.

Outbound, `link-propagate` turns a local text change into a based positional splice
(`buffer-splice` + the link's version) and counts it in `:pending` (in flight until
its echo returns). Inbound, `link-fold` folds one `[:buffer-updated proc version view
origin]` push into the link and tells the caller what to do with its LOCAL copy:

    [link' action], action ∈
      :stale          — old/duplicate version: ignore the push entirely
      :noop           — nothing to apply (your own echo; a cursor-only delta)
      [:splice [lo hi repl] properties] — apply this splice (already transformed over
                        your in-flight edits) to your local copy, laying the text
                        `properties` it came with (`{key spans}` relative to `repl`,
                        or nil — ADR-579) on its new text (`buffer-apply-action`);
                        `:redact` for its properties is a REDACTION (ADR-581), and
                        `[:put-properties width changes]` a PROPERTY CHANGE over
                        `[lo, lo + width)` whose splice is empty (the text untouched)
      :resync         — ambiguous concurrent collision: refetch the authoritative
                        text (e.g. `(buffer-query (get link :proc) buffer-text)`)
      [:text s properties] — a full-text view (a closure edit / the seed): rebuild
                        your copy from `s` and its `properties` if they differ

The fold is pure (no sends, no receives) — the merge matrix is testable with
hand-fed pushes. Start a link with `link-init` (version -1, so the subscription
seed always applies); compute minimal splices with `text-splice`."
  (:use editor/buffer)
  (:use editor/buffer-server)
  (:use editor/span-properties))
;; ---- the single positional splice diff ---------------------------------------

(defn text-splice (old new)
  "The single positional splice `[lo hi repl]` that turns string `old` into `new`:
replace `old[lo, hi)` with `repl`. `lo`/`hi` bound the minimal changed span (shared
prefix + suffix trimmed off), so `(replace-region buf lo hi repl)` reproduces `new`.
Equal strings give a no-op `[n n \"\"]`. The whole edit expressed positionally, so it
lands correctly at the process no matter where other participants' points are.
Native (`%str-splice-diff`, one O(n) pass) — this runs per keystroke on every
hosted buffer, where a per-char Brood scan cost ~40 ms on a 300-line file.

    (editor/buffer-client/text-splice \"hello\" \"help\")   ;=> [3 5 \"p\"]
    (editor/buffer-client/text-splice \"abc\" \"abc\")     ;=> [3 3 \"\"]"
  (%str-splice-diff old new))

(defn splice-noop? (splice)
  "True when `splice` (`[lo hi repl]`) changes nothing — an empty range and empty
replacement. A pure-movement command (point moved, text unchanged) yields this, so
no edit is sent.

    (editor/buffer-client/splice-noop? [3 3 \"\"])    ;=> true
    (editor/buffer-client/splice-noop? [0 1 \"J\"])   ;=> false"
  (let ([lo hi repl] splice)
    (and (= lo hi) (= repl ""))))

(defn text-apply-splice (text splice)
  "`text` with `splice` (`[lo hi repl]`) applied — the plain-STRING counterpart of
`replace-region`, for a holder whose local copy is a string rather than a buffer
(a registry's crash-recovery mirror, a log tailer, a test): apply `link-fold`'s
`[:splice …]` action with this and its `[:text s]` action by replacement.

    (editor/buffer-client/text-apply-splice \"hello\" [3 5 \"p\"])   ;=> \"help\""
  (let ([lo hi repl] splice)
    (str (string/substring text 0 lo) repl (string/substring text hi (string/length text)))))

(defn text-apply-action (text:string action:any -> string)
  "`text` with the CONTENT half of a `link-fold` action applied — `[:splice s _]` by
`text-apply-splice`, `[:text t _]` by replacement, anything else (`:noop`, `:stale`,
`:resync`) leaving it as it is. The whole of what a plain-string holder does with a push
(it keeps no text properties); a `:resync` is the caller's to act on (it needs the process).

    (editor/buffer-client/text-apply-action \"hello\" [:splice [0 1 \"J\"] nil])   ;=> \"Jello\"
    (editor/buffer-client/text-apply-action \"hello\" :noop)   ;=> \"hello\""
  (match action
    ([:splice splice _] (text-apply-splice text splice))
    ([:text replacement _] (if (string? replacement) replacement text))
    (_ text)))

(defn buffer-apply-action (buf action)
  "`buf` with the content half of a `link-fold` action applied, TEXT PROPERTIES included —
the buffer-holder twin of `text-apply-action`: `[:splice [lo hi repl] properties]` by
`apply-splice` (whatever the copy's read-only state: the text already changed where it is
authoritative), which also takes the two edits that are not plain splices — `:redact`, a
redaction that leaves no trace in this copy either (no history, no log), and a property
change (`[:put-properties width changes]`), which touches no text — `[:text t properties]`
by replacing the whole text when it differs, and when only its PROPERTIES differ by a property
change over the whole text (point, markers, the modified flag and the text itself left as
they are; undo takes the properties back), anything else leaving `buf` as it is.

    (editor/buffer/buffer-text (editor/buffer-client/buffer-apply-action (editor/buffer/make-buffer \"hello\") [:splice [0 1 \"J\"] nil]))   ;=> \"Jello\"
    (editor/buffer/buffer-point (editor/buffer-client/buffer-apply-action (editor/buffer/goto-char (editor/buffer/make-buffer \"hello\") 2) [:text \"hello\" {:face [[0 1 :red]]}]))   ;=> 2"
  (match action
    ([:splice [lo hi repl] properties] (apply-splice buf lo hi repl properties))
    ([:text replacement properties]
      (let (wanted (or properties {})
            current (buffer-property-map buf))
        (cond
          (not (string? replacement)) buf
          (not (= replacement (buffer-text buf)))
            (apply-splice buf 0 (buffer-length buf) replacement properties)
          (= wanted current) buf
          else
          ;; the same text: set every key either side has, over all of it — a key only
          ;; this copy has is cleared (`[]`); the text is what the file has no less than
          ;; before, so the modified flag stays
            (assoc (apply-splice buf
                     0
                     0
                     ""
                     [:put-properties
                       (buffer-length buf)
                       (fold (keys current)
                         wanted
                         (fn (acc key) (if (contains? acc key) acc (assoc acc key []))))])
              :modified (buffer-modified? buf)))))
    (_ buf)))

;; ---- the wire-view normalizer -------------------------------------------------

(defn content-view (buf)
  "The projection a holder that keeps a whole COPY subscribes with: `[text markers
participants properties]` — the document, every marker, the pid → name registry and the
text properties (`buffer-property-map`). Sent on the seed and on closure edits; structured
ops push O(change) deltas instead. Runs in the buffer process.

    (editor/buffer-client/content-view (editor/buffer/make-buffer \"hi\"))   ;=> [\"hi\" {} {} {}]"
  [(buffer-text buf) (buffer-markers buf) (get buf :participants {}) (buffer-property-map buf)])

(defn view-parts (view)
  "Normalize a push `view` to `{:text :splice :properties :cursors :names}`. Three wire
shapes: the presence vector `[text markers names]` — or `[text markers names properties]`,
[[content-view]]'s — (closure edits and the seed), a DELTA map `{:splice [lo hi repl]?
:properties … :markers … :participants …}` (structured `buffer-splice` /
`buffer-marker-move` / `[:write]` ops — O(change), the document never ships), or a bare
text string (plain projections, tests). `:properties` is the splice's (relative to its
replacement) in a delta and the whole document's in a vector; nil when the view has none.

    (get (editor/buffer-client/view-parts [\"abc\" {} {}]) :text)           ;=> \"abc\"
    (get (editor/buffer-client/view-parts {:splice [0 1 \"x\"]}) :splice)   ;=> [0 1 \"x\"]"
  (cond
    (map? view)
      {:text nil
       :splice (get view :splice)
       :properties (get view :properties)
       :cursors (or (get view :markers) {})
       :names (or (get view :participants) {})}
    (vector? view)
      {:text (nth view 0)
       :splice nil
       :properties (nth view 3 nil)
       :cursors (nth view 1)
       :names (nth view 2)}
    else {:text view :splice nil :properties nil :cursors {} :names {}}))

;; ---- the link -----------------------------------------------------------------

(defn link-init (proc me)
  "A fresh link to buffer process `proc`, identifying our own edits by `me` (any
value — conventionally the subscribing process's pid, matching the `origin` we tag
outbound edits with). Version -1, so the subscription's seed push always applies.

    (get (editor/buffer-client/link-init :proc :me) :version)   ;=> -1"
  {:proc proc :me me :version -1 :pending ()})

(defn- link-send-splice (link splice &optional properties)
  "Send one `[lo hi repl]` to the link's process, based and tagged, with the text
`properties` its replacement comes with, and count it in `:pending`. The link unchanged for
a splice that changes nothing — but a property change (`[:put-properties …]`, the text
untouched, so its splice is empty) is sent, and counted over the RANGE it changes
(`[lo lo+width width]`, no length change), so a foreign edit inside it is seen to collide."
  (if (and (splice-noop? splice) (nil? properties))
    link
    (let ([lo hi repl] splice
          in-flight (if (property-change? properties)
                      (let (width (math/max 0 (nth properties 1))) [lo (+ lo width) width])
                      [lo hi (string/length repl)]))
      (buffer-splice (get link :proc) lo hi repl (get link :me) (get link :version) properties)
      (assoc link :pending (append (or (get link :pending) ()) (list in-flight))))))

(defn- link-splice-range (splice properties)
  "The range a pushed `splice` touches, as `[lo hi repl]`: a property change's is the range
it changes (its splice is empty), anything else its own."
  (if (property-change? properties)
    (let ([lo _ _] splice) [lo (+ lo (math/max 0 (nth properties 1))) ""])
    splice))

(defn link-propagate (link old-text new-text)
  "Send the local text change `old-text` → `new-text` to the link's process as a
based positional splice — tagged with `:me` (our echo comes back recognizable) and
based on `:version` (the process transforms it over anything applied since) — and
count it in `:pending` (in flight until `link-fold` pops it on the echo). Returns
the link (unchanged when the texts are equal — pure movement sends nothing)."
  (link-send-splice link (text-splice old-text new-text)))

(defn link-propagate-buffers (link before after)
  "`link-propagate` for a holder whose local copy is a BUFFER: send the change `before` →
`after` as the edits actually made (`buffer-edits-between`: the buffer's own log), each one
sent and counted as `link-propagate` sends its one, with the text properties its inserted
text came with (ADR-579) — a redaction as a redaction (ADR-581), a property change as one.
Exact where a diff guesses — a diff of `aaa` → `aaaa` cannot say WHICH `a` was typed, so a
collaborator's caret beside it landed on the wrong side — and it reads no text. When the log
cannot account for the change (the text was replaced wholesale, more history than it keeps)
it sends what a comparison finds: the minimal changed range, widened to cover any changed
property, with its properties — correct in content and properties, nothing outside it
moved, and a redaction since `before` still redacts."
  (fold (buffer-edits-between before after)
    link
    (fn (acc edit)
      (let ([lo hi repl properties] edit) (link-send-splice acc [lo hi repl] properties)))))

(defn link-fold (link:map version:int view:any origin:any -> (tuple map any))
  "Fold one `[:buffer-updated proc version view origin]` push into `link`: returns
`[link' action]` — the advanced link and what the caller should do with its LOCAL
copy of the document (see the module doc for the action vocabulary).

The merge matrix, in order: a stale/duplicate `version` is ignored outright. A push
whose `origin` is our own `:me` is OUR edit coming back — the local copy already
applied it (and may be ahead of it, mid-fast-typing), so content is never rebuilt
from it: the matching `:pending` splice is popped and the version bumps (`:noop`).
A foreign SPLICE that is strictly apart from every in-flight splice of ours merges
exactly: it is transformed over them (`splice-transform-all` — the same function the
process uses on ours) into the `[:splice … properties]` to apply, and the pendings are remapped
over it, as the process will when they arrive after it. A foreign splice that
touches a span one of ours also touched is genuinely ambiguous → `:pending` resets
and the caller must `:resync` from the process. A full-text view (closure edits, the
seed) is handed back as `[:text s properties]` — unless we hold IN-FLIGHT edits, where rebuilding
from it would clobber them (the attach seed racing a first keystroke: the stale
snapshot rewound the local copy to empty, the own-echo after it was rightly a `:noop`,
and the next keystroke spliced at 0 — `qZ` for `Zq`); that case is `:resync` too,
which is EXACT here, not merely safe: our sends and the sync query share one FIFO to
the process, so the snapshot always contains every in-flight edit of ours. A
cursor-only delta is `:noop`."
  (if (<= version (or (get link :version) -1))
    [link :stale]
    (let (vp (view-parts view)
          text (get vp :text)
          splice (get vp :splice)
          me (get link :me)
          own? (and (not (nil? origin)) (= origin me))
          pending (or (get link :pending) ())
          ;; a foreign splice can merge exactly iff it's strictly apart from every
          ;; in-flight splice of ours; touching/overlapping is ambiguous → resync
          properties (get vp :properties)
          ;; what the foreign splice touches: a property change's whole range
          touched (when splice (link-splice-range splice properties))
          mergeable? (and splice
                       (or (empty? pending)
                         (every? pending (fn (p) (splice-disjoint? touched p)))))
          npending (cond
                     (and own? splice) (rest pending)
                     ; our echo — first in, first home
                     (and splice mergeable? (not own?))
                     ;; remap our in-flight splices over the foreign one, as the
                     ;; process will when they arrive after it
                       (map pending
                         (fn (p)
                           (let ([plo phi plen] p
                                 [flo fhi frepl] splice
                                 [nlo nhi _] (splice-transform [plo phi ""]
                                               [flo fhi (string/length frepl)]))
                             [nlo nhi plen])))
                     (and splice
                       (not own?)) ()
                     ; ambiguous → resync resets
                     else pending)
          nlink (assoc link :version version :pending npending))
      (cond
        own? [nlink :noop]
        (and splice mergeable?)
          (let ([lo hi repl] (splice-transform-all touched pending))
            (if (property-change? properties)
              ;; the range moved with our in-flight edits; the text is still untouched
              [nlink
                [:splice
                  [lo lo ""]
                  [:put-properties (- hi lo) (nth properties 2)]]]
              [nlink [:splice [lo hi repl] properties]]))
        splice [nlink :resync]
        (nil? text) [nlink :noop]
        ;; a full-text rebuild over in-flight edits would clobber them — resync
        ;; (atomic snapshot; includes our sends by FIFO order), pendings reset
        (not (empty? pending)) [(assoc nlink :pending ()) :resync]
        else [nlink [:text text (get vp :properties)]]))))
