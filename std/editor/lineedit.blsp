;; std/editor/lineedit.blsp — a raw-mode, emacs-style line editor in Brood.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - Policy, not mechanism (ADR-006/048): the editor is a Brood loop over the
;;    thin inline `term-*` seam (`term/raw-enter`/`term/raw-leave`/`term/emit`/
;;    `term/poll`/`term/size`) plus the pure `std/editor/highlight.blsp`. The Rust side
;;    only toggles raw mode and paints relative ops; everything an editor *does*
;;    — keymap, kill-ring, history, completion, layout — lives here, redefinable.
;;  - Pure core + thin IO (the `observe-frame` discipline): `lineedit-handle`
;;    maps `(state, key) -> state` with no IO, so the whole keymap is unit-tested
;;    without a terminal (tests/lineedit_test.blsp). `lineedit-loop` is the only
;;    part that polls keys and paints — exercised manually, like `repl`/`observe`.
;;  - Immutable state, no loops: the editor state is a map threaded through a
;;    tail-recursive loop; every keystroke returns a fresh state.
;;  - Single- or multi-line: with a `:complete?` predicate (the REPL passes one),
;;    Enter inserts a newline while the form is incomplete and the whole multi-line
;;    form is edited and repainted *in place* — so a bracket's match lights up across
;;    lines, C-a/C-e are line-aware, and ↑/↓ move between the form's lines (falling
;;    through to history at the top/bottom). Without it, Enter always submits (the
;;    single-line `read-line` drop-in, e.g. the observer minibuffer).
;;  - Inline, not full-screen: raw mode only (no alternate screen), so the prompt
;;    and submitted lines stay in the terminal's scrollback. Rendering is relative:
;;    each repaint moves up over the previous block (`:last-row`), clears, reprints
;;    every line, and reparks. A single line horizontally scrolls; multi-line forms
;;    print each line in full (a line wider than the terminal wraps — cursor math
;;    assumes it doesn't, a known edge with real wcwidth as a follow-up).

(defmodule editor/lineedit
  "A raw-mode, emacs/readline-style line editor for the REPL, written in Brood
(ADR-052). `(lineedit-read prompt history)` reads one line with live
syntax highlighting, bracket matching, signature hints, Tab completion (which
lists the matching candidates in columns below the input once it has no more
characters to insert), structural auto-indent on a continuation line, `M-q` to
reformat the form in place, and the
emacs/readline keys — C-a/C-e, C-f/C-b, M-f/M-b, C-k/C-u/C-w, M-d, C-y, C-t, C-h,
C-d, C-l, arrows, Home/End, and ↑/↓ (or C-p/C-n) history; it returns
`{:line <str|nil> :eof <bool> :cancel <bool>}`.

Built on `std/editor/highlight.blsp` (pure analysis) and the inline `term-*` seam.
`std/tool/repl.blsp` calls it on a TTY in place of `read-line`."
  (:use editor/highlight)
  (:use editor/keymap))

(def lineedit-face-hint {:fg :dark-grey})

;; ---- editor state -----------------------------------------------------------

;; The editor's state, named once (ADR-326): `:text` and `:point` are what every step
;; reads; the rest (`:hscroll`, `:width`, `:done`, `:last-row`, …) rides on the open shape.
(deftype state (record &open :text string :point int))

(defn lineedit-init (prompt history &optional opts)
  "The fresh editor state for one read: empty line, point at 0, and `history`
(newest-first submitted lines). `opts` (a map)
enables multi-line editing:
`:cont-prompt` (the prompt for lines after the first) and `:complete?` (a `text -> bool`
predicate — when set, Enter inserts a newline while the form is incomplete instead of
submitting).

    (get (editor/lineedit/lineedit-init \"> \" [\"(+ 1 2)\"]) :point)   ;=> 0"
  (let (options (or opts {}))
    {:text ""
     :point 0
     :kill ""
     :hist history
     :hist-idx -1
     :saved ""
     :hscroll 0
     :prompt prompt
     :cont-prompt (or (get options :cont-prompt) prompt)
     :complete? (get options :complete?)
     :completions nil
     :last-row 0
     :done nil}))

;; ---- character helpers ------------------------------------------------------

(defn- lineedit-word-char? (c)
  "True if `c` is part of a word for M-f/M-b/C-w (i.e. not whitespace or a delimiter)."
  (not (or (= c " ")
         (= c "\t")
         (= c "(")
         (= c ")")
         (= c "[")
         (= c "]")
         (= c "{")
         (= c "}")
         (= c "\"")
         (= c ";")
         (= c ","))))

(defn- lineedit-path-word-char? (c)
  "Word constituent for **path mode** — like `lineedit-word-char?` but `/` is also a
boundary, so M-f/M-b/C-w move and kill one path component (folder) at a time."
  (and (lineedit-word-char? c) (not (= c "/"))))

(defn- lineedit-word-pred (state)
  "The word-constituent predicate for `state`: path-aware (breaks on `/`, for find-file /
project prompts) when `:word-mode` is `:path`, else the default. Set `:word-mode` on the
lineedit state to pick — a tiny per-prompt 'mode' for path navigation."
  (if (= (get state :word-mode) :path) lineedit-path-word-char? lineedit-word-char?))

(defn- lineedit-fwd (text:string i:int n:int pred:fn -> int)
  "Smallest index ≥ `i` (up to `n`) whose char fails `pred` — advance while `pred`."
  (if (or (>= i n) (not (pred (string/char-at text i)))) i (lineedit-fwd text (inc i) n pred)))

(defn- lineedit-bwd (text:string i:int pred:fn -> int)
  "Largest index ≤ `i` (down to 0) whose preceding char fails `pred`."
  (if (or (<= i 0) (not (pred (string/char-at text (dec i))))) i (lineedit-bwd text (dec i) pred)))

(defn- lineedit-fwd-word (text p word?)
  "Point after the next word forward from `p` (skip non-word, then word), where `word?`
is the word-constituent predicate (`lineedit-word-pred` picks it per mode)."
  (let (n (count text)
        i (lineedit-fwd text p n (fn (c) (not (word? c)))))
    (lineedit-fwd text i n word?)))

(defn- lineedit-bwd-word (text p word?)
  "Point at the start of the word backward from `p` (skip non-word, then word), with
`word?` the word-constituent predicate."
  (let (i (lineedit-bwd text p (fn (c) (not (word? c)))))
    (lineedit-bwd text i word?)))

;; ---- multi-line geometry (pure) ---------------------------------------------
;; `:text` may hold newlines (a multi-line form). Point is a flat offset; these map
;; between that offset and (row, col) so motion, Enter, and rendering are line-aware.

(defn- lineedit-line-start (text:string p:int -> int)
  "Offset of the first char of the line containing point `p` (just after the previous
newline, or 0)."
  (inc (string/last-index-of text "\n" p)))

(defn- lineedit-line-end (text:string p:int -> int)
  "Offset of the end of the line containing point `p` (the next newline, or the end)."
  (let (j (index-of text "\n" p))
    (if (< j 0) (count text) j)))

(defn- lineedit-count-nl (s)
  "How many newlines are in `s` (deleting them and measuring the length drop)."
  (- (count s) (count (string/replace s "\n" ""))))

(defn- lineedit-cursor-rc (text p)
  "Point `p` as `[row col]` — `row` the count of newlines before `p`, `col` the offset
within that line."
  [(lineedit-count-nl (string/substring text 0 p)) (- p (lineedit-line-start text p))])

(defn- lineedit-up-point (text p)
  "Point one line up from `p`, keeping the column (clamped to the shorter line), or nil
when `p` is already on the first line."
  (let (ls (lineedit-line-start text p))
    (if (= ls 0)
      nil
      (let (col (- p ls)
            prev-start (lineedit-line-start text (dec ls)))
        ; (dec ls) is the prior "\n"
        (math/min (+ prev-start col) (dec ls))))))

(defn- lineedit-down-point (text p)
  "Point one line down from `p`, keeping the column (clamped), or nil when `p` is on
the last line."
  (let (le (lineedit-line-end text p))
    (if (>= le (count text))
      nil
      (let (col (- p (lineedit-line-start text p))
            next-start (inc le))
        (math/min (+ next-start col) (lineedit-line-end text next-start))))))

;; ---- pure edit operations ---------------------------------------------------

(defn- lineedit-clamp (text p) (math/max 0 (math/min (count text) p)))

(defn- lineedit-move (state p)
  "State with point moved to `p` (clamped)."
  (assoc state :point (lineedit-clamp (get state :text) p)))

(defn lineedit-insert (state s)
  "State with string `s` inserted at point; point advances past it. Public because it
is how a HOST pastes into the line: an editor's `C-y` in its minibuffer yanks the
editor's kill ring (and the OS clipboard), which the line editor cannot know — the
line's own `C-y` (`lineedit-yank`) inserts only what `C-k`/`C-w` cut from the line.

    (get (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") :text)   ;=> \"foo bar\""
  (let (text (get state :text) p (get state :point))
    (assoc state
      :text (str (string/substring text 0 p) s (string/substring text p (count text)))
      :point (+ p (count s))
      :hist-idx -1)))

(defn- lineedit-del-back (state: (record &open :text string :point int) -> map)
  "State with the char before point deleted (backspace)."
  ;; a whole grapheme cluster, never one code point of it (ADR-422)
  (let (text (get state :text) p (get state :point) start (string/prev-grapheme text p))
    (if (= p 0)
      state
      (assoc state
        :text (str (string/substring text 0 start) (string/substring text p (count text)))
        :point start
        :hist-idx -1))))

(defn- lineedit-del-fwd (state: (record &open :text string :point int) -> map)
  "State with the char at point deleted (delete / C-d mid-line)."
  (let (text (get state :text) p (get state :point) n (count text))
    (if (>= p n)
      state
      (assoc state
        :text
          (str (string/substring text 0 p) (string/substring text (string/next-grapheme text p) n))
        :hist-idx -1))))

(defn- lineedit-kill-end (state: (record &open :text string :point int) -> map)
  "State with the text from point to end killed into `:kill` (C-k)."
  (let (text (get state :text) p (get state :point) n (count text))
    (assoc state :text (string/substring text 0 p) :kill (string/substring text p n) :hist-idx -1)))

(defn- lineedit-kill-begin (state: (record &open :text string :point int) -> map)
  "State with the text from start to point killed into `:kill`, point to 0 (C-u)."
  (let (text (get state :text) p (get state :point) n (count text))
    (assoc state
      :text (string/substring text p n)
      :kill (string/substring text 0 p)
      :point 0
      :hist-idx -1)))

(defn- lineedit-kill-word (state: (record &open :text string :point int) -> map)
  "State with the word before point killed into `:kill` (C-w)."
  (let (text (get state :text)
        p (get state :point)
        n (count text)
        s (lineedit-bwd-word text p (lineedit-word-pred state)))
    (assoc state
      :text (str (string/substring text 0 s) (string/substring text p n))
      :kill (string/substring text s p)
      :point s
      :hist-idx -1)))

(defn- lineedit-kill-word-fwd (state: (record &open :text string :point int) -> map)
  "State with the word *after* point killed into `:kill` (M-d), point unchanged."
  (let (text (get state :text)
        p (get state :point)
        n (count text)
        e (lineedit-fwd-word text p (lineedit-word-pred state)))
    (assoc state
      :text (str (string/substring text 0 p) (string/substring text e n))
      :kill (string/substring text p e)
      :hist-idx -1)))

(defn- lineedit-transpose (state: (record &open :text string :point int) -> map)
  "State with the two characters around point swapped, point advanced (C-t) — at
end of line, swaps the last two. No-op on a line shorter than 2 or at column 0."
  (let (text (get state :text) p (get state :point) n (count text))
    (if (or (< n 2) (= p 0))
      state
      (let (q (if (>= p n) (dec n) p)
            a (string/char-at text (dec q))
            b (string/char-at text q))
        (assoc state
          :text (str (string/substring text 0 (dec q)) b a (string/substring text (inc q) n))
          :point (math/min n (inc q))
          :hist-idx -1)))))

(defn- lineedit-yank-impl (state)
  "State with the last-killed text inserted at point (C-y)."
  (lineedit-insert state (get state :kill)))

;; ---- history ----------------------------------------------------------------

(defn- lineedit-hist-prev (state)
  "Recall the previous (older) history entry (↑). Saves the in-progress line the
first time, so ↓ can restore it."
  (let (hist (get state :hist) idx (get state :hist-idx) n (count hist))
    (if (= n 0)
      state
      (let (ni (math/min (dec n) (inc idx))
            saved (if (= idx -1) (get state :text) (get state :saved))
            entry (nth hist ni))
        (assoc state :hist-idx ni :saved saved :text entry :point (count entry))))))

(defn lineedit-remember (history src)
  "Push submitted source `src` onto `history` (newest first) for ↑/↓ recall —
internal newlines collapsed to spaces (so a multi-line form recalls as one line),
trimmed, dropping blanks and consecutive duplicates. Shared by the REPL and the
observer's eval minibuffer (the `:hist` list `lineedit-init` is seeded with).

    (editor/lineedit/lineedit-remember (list \"(a)\") \"(b)\")   ;=> (\"(b)\" \"(a)\")
    (editor/lineedit/lineedit-remember (list \"(a)\") \"(a)\")   ;=> (\"(a)\")"
  (let (entry (string/trim (string/replace src "\n" " ")))
    (if (or (= entry "") (and (not (empty? history)) (= (first history) entry)))
      history
      (cons entry history))))

(defn- lineedit-hist-next (state)
  "Recall the next (newer) history entry, or the saved in-progress line at the end (↓)."
  (let (idx (get state :hist-idx))
    (cond
      (< idx 0) state
      (= idx 0)
        (let (s (get state :saved))
          (assoc state :hist-idx -1 :text s :point (count s)))
      else
        (let (ni (dec idx) entry (nth (get state :hist) ni))
          (assoc state :hist-idx ni :text entry :point (count entry))))))

;; ---- reverse incremental history search (C-r) -------------------------------
;; A modal sub-state on `:search` = `{:query :idx :orig-text :orig-point}`. While
;; set, `lineedit-handle` routes keys here instead of the keymap: printable chars
;; extend the query, C-r steps to the next older match, Enter accepts (keeps the
;; matched line for editing), C-g/Esc cancels (restoring the pre-search line), and
;; any other key accepts then replays through the normal keymap.

(defn- lineedit-search-find (history:seqable query:string i:number -> number)
  "Index of the first history entry at or after `i` (older) that contains `query`
as a substring, or -1. An empty query matches the newest entry."
  (cond
    (>= i (count history)) -1
    (includes? (nth history i) query) i
    else (lineedit-search-find history query (inc i))))
;; `number`, not `int`, on the index: `from` in `lineedit-search-step` reaches this
;; through `(math/max 0 from)`, and `from` originates in `(get s :idx)` — an untyped map
;; read. Declaring `int` anywhere in that chain only moves the strict warning one call up
;; until it lands on the `get`, which has nothing to narrow it with. `number` is what the
;; chain actually supports, and it still rules out the index typos `nth` now rejects.

(defn- lineedit-search-step (state:any query:string from:number -> any)
  "Set the search query to `query` and select the nearest match at or after index
`from`; on no match, keep the current line but record the (failing) query."
  (let (s (get state :search)
        found (lineedit-search-find (get state :hist) query (math/max 0 from)))
    (if (< found 0)
      (assoc state :search (assoc s :query query))
      (let (entry (nth (get state :hist) found))
        (assoc state
          :text entry
          :point (count entry)
          :search (assoc s :query query :idx found))))))
;; `any` for the state, deliberately: it IS a map, but every caller builds it with
;; `assoc` over an untyped value, which types as `vector | map` — so annotating `map`
;; rejects correct callers. This signature exists to give `from` a type, nothing more.

(defn- lineedit-search-cancel (state)
  "Leave search, restoring the line as it was before C-r."
  (let (s (get state :search))
    (assoc state :text (get s :orig-text) :point (get s :orig-point) :search nil)))

(defn- lineedit-search-accept (state)
  "Leave search, keeping the currently matched line for editing."
  (assoc state :search nil))

(defn- lineedit-search-key (state key)
  "Handle one key while in reverse-search mode (see `:search`)."
  (let (s (get state :search) q (get s :query) idx (get s :idx))
    (cond
      (= key :ctrl-r) (lineedit-search-step state q (inc idx))
      ; next older match
      (or (= key :ctrl-g) (= key :escape)) (lineedit-search-cancel state)
      (= key :enter) (lineedit-search-accept state)
      (or (= key :backspace) (= key :ctrl-h))
        (lineedit-search-step state
          (if (= q "")
            ""
            (string/substring q 0 (dec (count q))))
          0)
      (and (string? key) (= (count key) 1)) (lineedit-search-step state (str q key) idx)
      ; extend; keep current match if it still matches
      else (lineedit-handle (lineedit-search-accept state) key))))

(defn lineedit-reverse-search (state _)
  "Enter reverse incremental history search (C-r), saving the current line so C-g
can restore it, and selecting the newest match (empty query → newest entry)."
  (lineedit-search-step (assoc state
                          :search
                            {:query ""
                             :idx 0
                             :orig-text (get state :text)
                             :orig-point (get state :point)})
    "" 0))

;; ---- completion -------------------------------------------------------------

(defn- lineedit-candidates (pfx)
  "Sorted global names beginning with `pfx` — the default Tab-completion source.
Reads the live image (`reflect/global-names`), so globals + macros (defn/when/cond/…) are
all in (and a new project's own globals, since it's the live runtime).

    (editor/lineedit/*candidates* \"string/jo\")   ;~> (\"string/join\" …every live global with that prefix…)"
  (sort (seq/filter (map (reflect/global-names) str) (fn (s) (string/starts-with? s pfx)))))

;; The completion source: a `(fn pfx -> sorted-candidate-strings)`. Defaults to the
;; live globals; a project that wants to complete its *own* vocabulary (buffer
;; words, file paths, a DSL's keywords) just rebinds this — `(def editor/lineedit/*candidates*
;; my-completer)` — and Tab in `lineedit-read` (or the observer minibuffer) uses it.
;; A plain redefinable global (hot-swappable), not baked into the completer.
(def *candidates* lineedit-candidates)

;; How many rows of candidates a listing may occupy. Kept small on purpose: the
;; renderer's geometry is *relative* (move up over the previous block, clear, reprint),
;; so a listing tall enough to scroll the terminal would desync the cursor restore —
;; the same limit the one-line signature hint lives under, just with more rows. A
;; redefinable global, so a session on a tall terminal can raise it.
(def *completion-max-rows* 6)

(defn- lineedit-completion-rows (cands: (list string) width:int -> list)
  "Pure: the display rows listing `cands` in a `width`-column terminal — laid out
across in equal columns (row-major, as bash lists), capped at
`*completion-max-rows*` rows with a trailing `… +N more` when they don't all
fit. Each row is truncated to `width - 1` columns so it can never wrap (a wrapped row
would desync the `[:up n]` cursor restore)."
  (let (room (math/max 1 (- width 1))
        colw (+ 2 (fold cands 0 (fn (widest c) (math/max widest (count c)))))
        ncols (math/max 1 (math/quot room colw))
        total (count cands)
        shown (math/min total (* ncols *completion-max-rows*))
        more (- total shown)
        ;; `chunk-every`, not `partition`: a listing must not silently lose its last row
        rows (map (seq/chunk-every (take cands shown) ncols)
               (fn (row)
                 (let (line (string/trim-right (apply str
                                                 (map row (fn (c) (string/pad-right c colw))))))
                   (if (> (count line) room) (string/substring line 0 room) line)))))
    (if (> more 0) (append rows (list (str "… +" more " more"))) rows)))

(defn- lineedit-completion-lines (line-state)
  "The listing rows to paint below the input for `st` — empty unless the last key was a
Tab that couldn't make progress (see `lineedit-apply-completion`). `st` must be
reflowed (`:width` set)."
  (let (cands (get line-state :completions))
    (if (or (nil? cands) (empty? cands))
      '()
      (lineedit-completion-rows cands (or (get line-state :width) 80)))))

(defn- lineedit-completion-ops (rows)
  "Render ops for listing `rows`: each row on its own new line, in the dim hint face."
  (fold rows '() (fn (acc row) (append acc (list [:nl] [:print row lineedit-face-hint])))))

(defn- lineedit-apply-completion (state sstart pfx cands)
  "Pure: replace the symbol prefix `[sstart, point)` with the completion of `pfx`
against `cands` — the candidate itself when unique, else the longest common prefix.

When the common prefix adds *nothing* (several candidates whose shared prefix is
already typed), attach `cands` as `:completions` so the renderer lists them below the
input. That's the readline convention: Tab makes progress if it can, and shows you the
alternatives when it can't — so a second Tab on `str` lists rather than sitting mute.
Any other key clears the listing (`lineedit-handle`)."
  (let (text (get state :text)
        p (get state :point)
        n (count text)
        ins (cond
              (empty? cands) pfx
              (empty? (rest cands)) (first cands)
              else (common-prefix cands)))
    (assoc state
      :text (str (string/substring text 0 sstart) ins (string/substring text p n))
      :point (+ sstart (count ins))
      :hist-idx -1
      :completions
        (if (and (= ins pfx) (not (empty? cands)) (not (empty? (rest cands))))
          cands
          nil))))

(defn- lineedit-complete-impl (state)
  "Tab: complete the symbol under point against `*candidates*` (the live
globals by default; a project can rebind it to complete its own vocabulary)."
  (let (text (get state :text)
        p (get state :point)
        [sstart pfx] (symbol-prefix-at text p))
    (if (= pfx "")
      state
      (lineedit-apply-completion state sstart pfx (*candidates* pfx)))))

;; ---- commands ---------------------------------------------------------------
;; Each command is a public `(fn (state key) -> state)` — the bindable unit the
;; keymap names. Redefining one (`def`) hot-swaps that key's behaviour on the next
;; keystroke (late binding); they all ignore `key` except self-insert. Keep these
;; thin over the edit ops above so a REPL/editor can compose or replace them.

(defn lineedit-self-insert (state key)
  "Insert the typed character `key`.

    (get (editor/lineedit/lineedit-self-insert (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") \"!\") :text)   ;=> \"foo bar!\""
  (lineedit-insert state key))
(defn lineedit-beginning-of-line (state _)
  "Move point to the start of the current line (C-a) — line-aware for multi-line forms.

    (get (editor/lineedit/lineedit-beginning-of-line (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :point)   ;=> 0"
  (lineedit-move state (lineedit-line-start (get state :text) (get state :point))))
(defn lineedit-end-of-line (state _)
  "Move point to the end of the current line (C-e) — line-aware for multi-line forms.

    (get (editor/lineedit/lineedit-end-of-line (editor/lineedit/lineedit-beginning-of-line (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil) :point)   ;=> 7"
  (lineedit-move state (lineedit-line-end (get state :text) (get state :point))))
(defn lineedit-forward-char (state _)
  "Move point one user-perceived character right (C-f) — a whole grapheme cluster.

    (get (editor/lineedit/lineedit-forward-char (editor/lineedit/lineedit-beginning-of-line (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil) :point)   ;=> 1"
  (lineedit-move state (string/next-grapheme (get state :text) (get state :point))))
(defn lineedit-backward-char (state _)
  "Move point one user-perceived character left (C-b) — a whole grapheme cluster.

    (get (editor/lineedit/lineedit-backward-char (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :point)   ;=> 6"
  (lineedit-move state (string/prev-grapheme (get state :text) (get state :point))))
(defn lineedit-forward-word (state _)
  "Move point to the end of the next word (M-f) — by path component in `:path` mode.

    (get (editor/lineedit/lineedit-forward-word (editor/lineedit/lineedit-beginning-of-line (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil) :point)   ;=> 3"
  (lineedit-move state
    (lineedit-fwd-word (get state :text) (get state :point) (lineedit-word-pred state))))
(defn lineedit-backward-word (state _)
  "Move point to the start of the previous word (M-b) — by path component in `:path` mode.

    (get (editor/lineedit/lineedit-backward-word (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :point)   ;=> 4"
  (lineedit-move state
    (lineedit-bwd-word (get state :text) (get state :point) (lineedit-word-pred state))))
(defn- lineedit-component-start (text:string p:int -> int)
  "Where the path component ending at `p` (just after its `/`) starts: just after the `/`
before it, or 0."
  (let (before (string/last-index-of (string/substring text 0 (dec p)) "/"))
    (if (< before 0) 0 (inc before))))

(defn lineedit-delete-backward (state _)
  "Delete the character before point (Backspace / C-h). In `:path` mode, at the end of the
line right after a `/`, the whole last component goes instead — `foo/`, `~/` — as Emacs's
vertico-directory has it: a directory is one step back, and `~` alone names nothing.

    (get (editor/lineedit/lineedit-delete-backward (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :text)   ;=> \"foo ba\"
    (get (editor/lineedit/lineedit-delete-backward (assoc (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"~/src/foo/\") :word-mode :path) nil) :text)   ;=> \"~/src/\"
    (get (editor/lineedit/lineedit-delete-backward (assoc (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"~/\") :word-mode :path) nil) :text)   ;=> \"\""
  (let (text (get state :text)
        p (get state :point))
    (if (and (= (get state :word-mode) :path)
          (> p 0)
          (= p (count text))
          (string/ends-with? text "/"))
      (let (start (lineedit-component-start text p))
        (assoc state :text (string/substring text 0 start) :point start :hist-idx -1))
      (lineedit-del-back state))))
(defn lineedit-delete-forward (state _)
  "Delete the character at point (Delete).

    (get (editor/lineedit/lineedit-delete-forward (editor/lineedit/lineedit-beginning-of-line (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil) :text)   ;=> \"oo bar\""
  (lineedit-del-fwd state))
(defn lineedit-kill-line (state _)
  "Kill from point to end of line (C-k).

    (let (s (editor/lineedit/lineedit-kill-line (editor/lineedit/lineedit-backward-word (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil)) [(get s :text) (get s :kill)])   ;=> [\"foo \" \"bar\"]"
  (lineedit-kill-end state))
(defn lineedit-kill-to-start (state _)
  "Kill from start of line to point (C-u).

    (let (s (editor/lineedit/lineedit-kill-to-start (editor/lineedit/lineedit-backward-word (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil)) [(get s :text) (get s :kill)])   ;=> [\"bar\" \"foo \"]"
  (lineedit-kill-begin state))
(defn lineedit-kill-word-backward (state _)
  "Kill the word before point (C-w).

    (get (editor/lineedit/lineedit-kill-word-backward (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :text)   ;=> \"foo \""
  (lineedit-kill-word state))
(defn lineedit-kill-word-forward (state _)
  "Kill the word after point (M-d).

    (get (editor/lineedit/lineedit-kill-word-forward (editor/lineedit/lineedit-beginning-of-line (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil) :text)   ;=> \" bar\""
  (lineedit-kill-word-fwd state))
(defn lineedit-yank (state _)
  "Insert the last-killed text at point (C-y).

    (get (editor/lineedit/lineedit-yank (editor/lineedit/lineedit-kill-word-backward (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) nil) :text)   ;=> \"foo bar\""
  (lineedit-yank-impl state))
(defn lineedit-transpose-chars (state _)
  "Swap the two characters around point (C-t).

    (get (editor/lineedit/lineedit-transpose-chars (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :text)   ;=> \"foo bra\""
  (lineedit-transpose state))
(defn lineedit-history-prev (state _)
  "Move to the previous line of a multi-line form if there is one above, else recall
the previous (older) history entry (↑ / C-p).

    (get (editor/lineedit/lineedit-history-prev (editor/lineedit/lineedit-init \"\" [\"(b)\" \"(a)\"]) nil) :text)   ;=> \"(b)\""
  (let (up (lineedit-up-point (get state :text) (get state :point)))
    (if (nil? up) (lineedit-hist-prev state) (lineedit-move state up))))
(defn lineedit-history-next (state _)
  "Move to the next line of a multi-line form if there is one below, else recall the
next (newer) history entry (↓ / C-n).

    (get (editor/lineedit/lineedit-history-next (editor/lineedit/lineedit-history-prev (editor/lineedit/lineedit-history-prev (editor/lineedit/lineedit-init \"\" [\"(b)\" \"(a)\"]) nil) nil) nil) :text)   ;=> \"(b)\""
  (let (down (lineedit-down-point (get state :text) (get state :point)))
    (if (nil? down) (lineedit-hist-next state) (lineedit-move state down))))
(defn lineedit-complete (state _)
  "Complete the symbol under point (Tab).

    (editor/lineedit/lineedit-complete state nil)   ;~> state, its symbol completed from the live globals"
  (lineedit-complete-impl state))
(defn lineedit-clear-screen (state _)
  "Request a screen clear + redraw (C-l).

    (get (editor/lineedit/lineedit-clear-screen (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :clear)   ;=> true"
  (assoc state :clear true))
;; ---- auto-indent (pure) -----------------------------------------------------
;; A continuation line starts at the column `nest format` would give it, so typing never
;; leaves a line that M-q or the formatter then moves.
;;
;; The indent rule is not invented here: it is *read off* `std/format.blsp`'s output, so
;; typing and reformatting cannot disagree. The formatter breaks a `(…)` call or a
;; `[…]` vector with continuation lines at the opener's column + 2 (bodies of `defn` /
;; `let` land there too — the header table changes what stays on line 1, never the body
;; indent), and a `{…}` map at + 1 so its keys align under the first key. That is the
;; whole rule; no per-form table is needed for it.

;; A constant, not a knob, so no earmuffs. (It was `*indent-width*` until a downstream
;; `(defdyn *indent-width* …)`, then a root name, took it over whenever std loaded from
;; source — KI-383, fixed for good by ADR-722.)
(def- body-indent 2)

(defn- lineedit-indent-for (text pos)
  "The column a fresh line beginning at offset `pos` should be indented to: two past
the column of the innermost unclosed `(`/`[`, one past a `{`, and 0 at top level."
  (let (open (enclosing-open text pos))
    (if (< open 0)
      0
      (let (col (- open (lineedit-line-start text open)))
        (if (= (string/char-at text open) "{")
          (inc col)
          (+ col body-indent))))))

(defn lineedit-newline-and-indent (state)
  "Insert a newline and indent the new line to its structural column.

    (get (editor/lineedit/lineedit-newline-and-indent (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"(let (x 1)\")) :text)   ;=> \"(let (x 1)\\n  \""
  (lineedit-insert state
    (str "\n" (string/repeat " " (lineedit-indent-for (get state :text) (get state :point))))))

(defn- lineedit-same-forms? (a b)
  "True when texts `a` and `b` read as the *same* forms — the guard that a reformat
preserved meaning. False if either fails to read.

This is not belt-and-braces. `source` does not raise on incomplete input, it
completes it: mid-typing, `(defn f (x` came back as `(defn f (x ) )`, silently closing
brackets the user had not closed yet. Comparing the parsed forms rejects that (and any
future rewrite that changes structure) while correctly ignoring comment and whitespace
changes, which is exactly the difference a formatter is allowed to make."
  ;; check-allow :discarded-catch — a parse failure on half-typed input is the expected answer (not equivalent / nothing to format / no hint)
  (check-allow :discarded-catch (try (= (reflect/read-all a) (reflect/read-all b)) (catch _ false))))

(defn lineedit-reformat (state _)
  "M-q: reformat the whole form in place with `std/format.blsp`, leaving point at the
end. A no-op unless the result reads back as the same forms — so mid-form text (the
common case while typing) and anything the formatter would restructure are left
exactly as typed. Reformatting must never eat what you typed.

`format` is required lazily: the editor shouldn't drag the formatter into every REPL
boot (or into a lean bundle) for a key most sessions never press.

    (get (editor/lineedit/lineedit-reformat (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"(+   1    2)\") nil) :text)   ;=> \"(+ 1 2)\""
  (let (text (get state :text)
        ;; check-allow :discarded-catch — a parse failure on half-typed input is the expected answer (not equivalent / nothing to format / no hint)
        formatted (check-allow :discarded-catch
                    (try
                      (do
                        (let (out (string/trim (format/source text)))
                          (if (= out "") nil out)))
                      (catch _ nil))))
    (cond
      (nil? formatted) state
      (= formatted text) state
      (not (lineedit-same-forms? text formatted)) state
      else (assoc state :text formatted :point (count formatted) :hist-idx -1))))

(defn lineedit-submit (state _)
  "Enter: submit the form. In multi-line mode (a `:complete?` predicate is on the
state) when the text isn't yet a complete form, insert an *indented* newline instead so
the form keeps growing — so a `(defn …` opens a fresh continuation line, already at the
column the formatter would put it, rather than submitting.

    (get (editor/lineedit/lineedit-submit (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :done)   ;=> :submit"
  (let (complete? (get state :complete?))
    (if (and complete? (not (complete? (get state :text))))
      (lineedit-newline-and-indent state)
      (assoc state :done :submit))))
(defn lineedit-cancel (state _)
  "Abandon the line, re-prompt (C-c).

    (get (editor/lineedit/lineedit-cancel (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") nil) :done)   ;=> :cancel"
  (assoc state :done :cancel))
(defn lineedit-eof-or-delete (state _)
  "Signal EOF on an empty line, else delete forward (C-d) — readline semantics.

    (get (editor/lineedit/lineedit-eof-or-delete (editor/lineedit/lineedit-init \"\" []) nil) :done)   ;=> :eof"
  (if (= (get state :text) "") (assoc state :done :eof) (lineedit-del-fwd state)))

;; ---- the keymap -------------------------------------------------------------

;; The editor's `key → command-symbol` bindings — the bindable keymap (ADR-052).
;; Override a key by re-`def`ing this map
;;   (def editor/lineedit/*keymap* (assoc editor/lineedit/*keymap* :ctrl-x 'my-command))
;; or change what a key does by redefining its command function; both take effect on
;; the next keystroke (late binding). A command is a global `(fn (state key) -> state)`.
;; A key not bound here self-inserts (a 1-char string) or is ignored. (Plain `def`
;; takes no docstring — keep this as a comment, not a string before the map.)
(defdyn editor/lineedit/*keymap*
  {:enter 'editor/lineedit/lineedit-submit
   ;; C-j (line feed, 0x0A) also accepts the line — readline's accept-line. In raw
   ;; mode crossterm reports a bare \n as Ctrl-J, not Enter (its issue #371): when a
   ;; line is *typed ahead* before the REPL enters raw mode, the tty has already
   ;; mapped Enter (\r) to \n, so that submit arrives here as :ctrl-j. Without this
   ;; the pre-typed form just sits unsubmitted until you press Enter again.
   :ctrl-j 'editor/lineedit/lineedit-submit
   :ctrl-c 'editor/lineedit/lineedit-cancel
   :ctrl-d 'editor/lineedit/lineedit-eof-or-delete
   :backspace 'editor/lineedit/lineedit-delete-backward
   :ctrl-h 'editor/lineedit/lineedit-delete-backward
   :delete 'editor/lineedit/lineedit-delete-forward
   :left 'editor/lineedit/lineedit-backward-char
   :ctrl-b 'editor/lineedit/lineedit-backward-char
   :right 'editor/lineedit/lineedit-forward-char
   :ctrl-f 'editor/lineedit/lineedit-forward-char
   :home 'editor/lineedit/lineedit-beginning-of-line
   :ctrl-a 'editor/lineedit/lineedit-beginning-of-line
   :end 'editor/lineedit/lineedit-end-of-line
   :ctrl-e 'editor/lineedit/lineedit-end-of-line
   :alt-f 'editor/lineedit/lineedit-forward-word
   :alt-b 'editor/lineedit/lineedit-backward-word
   :ctrl-k 'editor/lineedit/lineedit-kill-line
   :ctrl-u 'editor/lineedit/lineedit-kill-to-start
   :ctrl-w 'editor/lineedit/lineedit-kill-word-backward
   :alt-q 'editor/lineedit/lineedit-reformat
   :alt-d 'editor/lineedit/lineedit-kill-word-forward
   :ctrl-y 'editor/lineedit/lineedit-yank
   :ctrl-t 'editor/lineedit/lineedit-transpose-chars
   :up 'editor/lineedit/lineedit-history-prev
   :ctrl-p 'editor/lineedit/lineedit-history-prev
   :down 'editor/lineedit/lineedit-history-next
   :ctrl-n 'editor/lineedit/lineedit-history-next
   ;; M-p / M-n — the Emacs minibuffer's history keys, so a completion UI that takes
   ;; C-p / C-n and the arrows for its candidates still has the history reachable
   :alt-p 'editor/lineedit/lineedit-history-prev
   :alt-n 'editor/lineedit/lineedit-history-next
   :ctrl-l 'editor/lineedit/lineedit-clear-screen
   :ctrl-r 'editor/lineedit/lineedit-reverse-search
   :tab 'editor/lineedit/lineedit-complete
   :back-tab 'editor/lineedit/lineedit-complete})

(defn lineedit-bind (key cmd)
  "Bind `key` (a keyword like `:ctrl-x`, or a 1-char string) to command symbol `cmd`
in the editor keymap, taking effect on the next keystroke. The ergonomic way to
customise the REPL from the REPL: `(lineedit-bind :ctrl-x 'lineedit-clear-screen)`.

    (editor/lineedit/lineedit-bind :ctrl-x 'editor/lineedit/lineedit-clear-screen)   ;~> …the keymap rebound: Ctrl-X now clears the screen…"
  (def editor/lineedit/*keymap* (assoc editor/lineedit/*keymap* key cmd)))

(defn- lineedit-fallback (state key)
  "The unbound-key fallback: a printable 1-char key self-inserts, anything else is
a no-op. Passed to `keymap-dispatch` as the keymap's default."
  (if (and (string? key) (= (count key) 1))
    (lineedit-self-insert state key)
    state))

(defn lineedit-handle (state key)
  "Dispatch key event `key` through `editor/lineedit/*keymap*` to its command (via the
shared `keymap-dispatch`): a global `(fn (state key) -> state)` resolved by symbol,
so redefining the command or rebinding the key hot-swaps behaviour. An unbound key
self-inserts (a 1-char string) or is a no-op; a command that throws is caught so a
bad binding can't crash the read. In reverse-search mode (`:search` set) keys route
to `lineedit-search-key` instead. Pure apart from symbol resolution; testable.

Any pending completion listing is dropped *before* dispatch, so it survives exactly one
keystroke: a Tab that can't make progress re-attaches it (`lineedit-apply-completion`),
and typing the next character clears it. Clearing up front rather than per-command means
a rebound key or a user's own command can't leave a stale listing on screen.

    (get (editor/lineedit/lineedit-handle (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init \"\" []) \"foo bar\") :ctrl-a) :point)   ;=> 0"
  (let (line-state (if (nil? (get state :completions)) state (assoc state :completions nil)))
    (if (not (nil? (get line-state :search)))
      (lineedit-search-key line-state key)
      (keymap-dispatch editor/lineedit/*keymap* line-state key lineedit-fallback))))

;; ---- signature hint + bracket overrides (pure analysis -> render data) -------

(defn- lineedit-arglist-of (callee)
  "The arglist of the function/macro named by string `callee` (resolved in the live
image), or nil if it isn't a bound symbol. A bare-symbol `reflect/eval` is just a lookup."
  ;; check-allow :discarded-catch — a parse failure on half-typed input is the expected answer (not equivalent / nothing to format / no hint)
  (check-allow :discarded-catch
    (try
      (when (string? callee)
        (let (sym (reflect/read-string callee))
          (if (and (symbol? sym) (bound? sym)) (reflect/arglist (reflect/eval sym)) nil)))
      (catch _e nil))))

;; check-allow: deliberately non-tail — depth = the signature hint's argument count.
(check-allow :non-tail-recursion
  (defn- lineedit-arg-pieces (args idx argi)
    "`[str face]` pieces for the arglist `args`, bolding the parameter at slot `argi`.
  Marker symbols (`&optional`, `&`) render dim and don't consume a slot."
    (if (empty? args)
      '()
      (let (s (str (first args))
            marker (or (= s "&optional") (= s "&"))
            face (if (and (not marker) (= idx argi)) {:bold true} lineedit-face-hint)
            nidx (if marker idx (inc idx)))
        (cons [" " lineedit-face-hint]
          (cons [s face] (lineedit-arg-pieces (rest args) nidx argi)))))))

(defn- lineedit-hint-pieces (full pos)
  "`[str face]` pieces for the signature hint of the call enclosing cursor `pos`
in `full`, or nil when there's no call (or its head isn't a known function)."
  (let (call (enclosing-call full pos))
    (if (nil? call)
      nil
      (let ([callee argi] call
            args (lineedit-arglist-of callee))
        (if (nil? args)
          nil
          (append (list ["(" lineedit-face-hint] [callee lineedit-face-hint])
            (append (lineedit-arg-pieces args 0 argi)
              (list [")" lineedit-face-hint]))))))))

(defn- lineedit-fit (pieces:list room:int acc:list -> list)
  "Truncate `[str face]` `pieces` to at most `room` columns so the one-line hint
never wraps (which would desync the `[:up 1]` cursor restore)."
  (if (or (empty? pieces) (<= room 0))
    (reverse acc)
    (let ([s f] (first pieces) w (count s))
      (if (<= w room)
        (lineedit-fit (rest pieces) (- room w) (cons [s f] acc))
        (reverse (cons [(string/substring s 0 room) f] acc))))))

(defn lineedit-overrides (full:string pos:int -> list)
  "Bracket-match colour overrides (`[pos face]` list) for the cursor at `pos`: the
matched pair reversed, or a lone unmatched bracket in the error face.

    (editor/lineedit/lineedit-overrides \"(a)\" 3)   ;=> ([0 {:reverse true}] [2 {:reverse true}])"
  (let (m (bracket-match full pos))
    (if (nil? m)
      '()
      (let ([a b] m)
        (if (= b :unmatched)
          (list [a hl-face-error])
          (list [a hl-face-match] [b hl-face-match]))))))

;; ---- layout + rendering (IO) ------------------------------------------------

(defn- lineedit-cols (-> int)
  "The terminal width in columns, with a sane fallback when the terminal reports no
size (e.g. a pty with no winsize), so layout never collapses to a 1-column window."
  (let ([c _r] (term/size)) (if (< c 1) 80 c)))

(defn lineedit-display-prompt (state)
  "The prompt to show for `state`: the `(reverse-i-search)\`query':` prompt while
searching, else the configured prompt.

Public because a consumer that renders the editor itself — a custom TUI drawing its own
input line rather than calling `lineedit-render` — has no other way to know which prompt
the current state calls for. Two independent consumers needed it (a chat client and a
terminal multiplexer), which is the same reason `lineedit-init` is public.

    (editor/lineedit/lineedit-display-prompt (editor/lineedit/lineedit-init \"> \" []))   ;=> \"> \""
  (let (s (get state :search))
    (if (nil? s)
      (get state :prompt)
      (str "(reverse-i-search)`" (get s :query) "': "))))

(defn- lineedit-reflow (state:state -> state)
  "Recompute the horizontal-scroll window so point is visible, and cache the width,
available text columns, and prompt width for rendering."
  (let (width (lineedit-cols)
        promptw (count (lineedit-display-prompt state))
        avail (math/max 1 (- width promptw))
        point (get state :point)
        hs (get state :hscroll)
        hs2 (cond
              (< point hs) point
              (>= point (+ hs avail)) (inc (- point avail))
              else hs))
    (assoc state :hscroll hs2 :width width :avail avail :promptw promptw)))

(defn- lineedit-chunk-ops (chunks)
  "Turn `[substring face]` highlight chunks into `[:print str face]` ops."
  (map chunks (fn ([s f]) [:print s f])))

(defn- lineedit-render-single
  (line-state: (record &open
                 :text string :point int :hscroll int :avail int :promptw int :width int
                 :last-row int)
    -> map)
  "Repaint a SINGLE-line input in place (the common case): move up over any block left
by a previous multi-line render, carriage-return, clear below, reprint prompt + the
highlighted (horizontally-scrolled) window, draw the signature hint and then any
completion listing on the lines below (if any), then park the cursor back on the input.
Returns `st` with `:last-row` 0 (cursor ends on row 0)."
  (let (text (get line-state :text)
        point (get line-state :point)
        hs (get line-state :hscroll)
        avail (get line-state :avail)
        promptw (get line-state :promptw)
        prev-row (or (get line-state :last-row) 0)
        len (count text)
        vis (string/substring text hs (math/min len (+ hs avail)))
        overrides (lineedit-overrides text point)
        chunks (highlight-chunks text hs vis overrides)
        raw-hint (if (get line-state :search) nil (lineedit-hint-pieces text point))
        hint (if (nil? raw-hint) nil (lineedit-fit raw-hint (dec (get line-state :width)) '()))
        cand-rows (lineedit-completion-lines line-state)
        cursor-col (+ promptw (- point hs))
        head (append (if (> prev-row 0) (list [:up prev-row]) '())
               [[:cr] [:clear-below] [:print (lineedit-display-prompt line-state)]]
               (lineedit-chunk-ops chunks))
        ;; Everything painted *below* the input line — the hint row, then the listing.
        ;; We must climb back over exactly as many rows as we printed to repark.
        below (append (if (nil? hint) '() (cons [:nl] (lineedit-chunk-ops hint)))
                (lineedit-completion-ops cand-rows))
        nbelow (+ (if (nil? hint) 0 1) (count cand-rows))
        tail (if (= nbelow 0)
               (list [:col cursor-col])
               (append below (list [:up nbelow] [:col cursor-col]))))
    (term/emit (into [] (append head tail)))
    (assoc line-state :last-row 0)))

;; check-allow: deliberately non-tail — depth = lines of the input being edited.
(check-allow :non-tail-recursion
  (defn- lineedit-multi-line-ops (lines i offset full overrides prompt cont)
    "Render ops for the logical `lines` of a multi-line form: each line gets its prompt
  (`prompt` for the first, `cont` after) + its highlight chunks (lexed from `full`, so
  bracket-match overrides spanning lines apply), `[:nl]`-separated. `offset` tracks each
  line's start within the text so the lexer spans land on the right chars."
    (if (empty? lines)
      '()
      (let (line (first lines)
            pstr (if (= i 0) prompt cont)
            chunks (highlight-chunks full offset line overrides)
            line-ops (cons [:print pstr] (lineedit-chunk-ops chunks))
            here (if (= i 0) line-ops (cons [:nl] line-ops)))
        (append here
          (lineedit-multi-line-ops (rest lines)
            (inc i)
            (+ offset (count line) 1)
            full
            overrides
            prompt
            cont))))))

(defn- lineedit-multi-ops (line-state: (record &open :text string :point int) -> list)
  "The full op vector to repaint a MULTI-line form in place: up over the previous
block, clear, all lines (prompt + highlight, partner brackets reverse-videoed *in
place* since every line is repainted), then reposition to the cursor's row/col. Pure —
tested in isolation."
  (let (text (get line-state :text)
        point (get line-state :point)
        prompt (lineedit-display-prompt line-state)
        cont (or (get line-state :cont-prompt) prompt)
        prev-row (or (get line-state :last-row) 0)
        overrides (lineedit-overrides text point)
        lines (string/split text "\n")
        nlines (count lines)
        cand-rows (lineedit-completion-lines line-state)
        [cur-row cur-col] (lineedit-cursor-rc text point)
        promptw (count (if (= cur-row 0) prompt cont))
        col (+ promptw cur-col)
        ;; The listing rows sit below the last form line, so the climb back to the
        ;; cursor's row spans the remaining form lines *plus* the listing.
        up-to-cursor (- (+ (dec nlines) (count cand-rows)) cur-row))
    (append (if (> prev-row 0) (list [:up prev-row]) '())
      (list [:cr] [:clear-below])
      (lineedit-multi-line-ops lines 0 0 text overrides prompt cont)
      (lineedit-completion-ops cand-rows)
      (if (> up-to-cursor 0) (list [:up up-to-cursor]) '())
      (list [:cr] [:col col]))))

(defn- lineedit-render-multi (line-state)
  "Repaint a multi-line form (emit `lineedit-multi-ops`), and record the cursor row in
`:last-row` so the next render moves back up to the block top before clearing."
  (do
    (term/emit (into [] (lineedit-multi-ops line-state)))
    (let ([cur-row _] (lineedit-cursor-rc (get line-state :text) (get line-state :point)))
      (assoc line-state :last-row cur-row))))

(defn- lineedit-render (line-state)
  "Repaint the input in place, returning `st` with an updated `:last-row`. Dispatches to
the single-line path (with horizontal scroll + signature hint, the common case) unless
the text spans multiple lines, in which case every line is repainted so a bracket's
partner highlights in place. `st` must already be reflowed by `lineedit-loop`."
  (if (includes? (get line-state :text) "\n")
    (lineedit-render-multi line-state)
    (lineedit-render-single line-state)))

(defn- lineedit-render-final (state)
  "Repaint the finished form once more (all lines, no scroll/cursor games) and drop to a
fresh line, so the submitted form stays in scrollback as typed. Works for one or many
lines; moves up over any leftover render block first."
  (let (prompt (lineedit-display-prompt state)
        cont (or (get state :cont-prompt) prompt)
        text (get state :text)
        prev-row (or (get state :last-row) 0)
        lines (string/split text "\n"))
    (term/emit (into []
                 (append (if (> prev-row 0) (list [:up prev-row]) '())
                   (list [:cr] [:clear-below])
                   (lineedit-multi-line-ops lines 0 0 text '() prompt cont)
                   (list [:nl]))))))

;; ---- the event loop (IO) ----------------------------------------------------

(defn- lineedit-drain (state:state -> state)
  "Apply every key already available (without blocking) so a paste burst repaints
once. Stops as soon as the read is `:done`."
  (if (get state :done)
    state
    (let (k (term/poll 0))
      (if (nil? k) state (lineedit-drain (lineedit-handle state k))))))

(defn- lineedit-finish (state)
  "End the read: repaint the final line, drop to a new line, and return the result
map for `repl-read-eval` — `{:line <str|nil> :eof :cancel}`."
  (do
    (lineedit-render-final state)
    (let (done (get state :done))
      (cond
        (= done :submit) {:line (get state :text) :eof false :cancel false}
        (= done :cancel) {:line nil :eof false :cancel true}
        else {:line nil :eof true :cancel false}))))

(defn- lineedit-await (state)
  "Block for the next key (re-polling on idle without redrawing), then handle +
drain it and either finish or loop with the new state."
  (let (k (term/poll 250))
    (if (nil? k)
      (lineedit-await state)
      (let (next (lineedit-drain (lineedit-handle state k)))
        (if (get next :done)
          (lineedit-finish next)
          (lineedit-loop next))))))

(defn- lineedit-loop (state)
  "Reflow (so the horizontal-scroll window sticks), honour a pending C-l screen
clear (which resets `:last-row` — the cursor is back at the top), render (threading the
updated `:last-row` so the next repaint finds the block top), then wait for input.
Tail-recursive via `--await`."
  (let (s1 (lineedit-reflow state)
        line-state (if (get s1 :clear)
                     (do (term/emit [[:clear-screen]]) (assoc s1 :clear nil :last-row 0))
                     s1)
        st2 (lineedit-render line-state))
    (lineedit-await st2)))

(defn lineedit-read (prompt history &optional opts)
  "Read interactively (raw mode) and return `{:line <str|nil> :eof :cancel}`: `:line`
the typed text on Enter (possibly multi-line — `:eof` true on Ctrl-D at an empty line,
`:cancel` true on Ctrl-C). `prompt` is the prompt, `history` a newest-first list for
↑/↓. `opts` (a map) turns on
multi-line editing: `:cont-prompt` for continuation lines and `:complete?` (a
`text -> bool`) so Enter inserts a newline while the form is incomplete and the whole
multi-line form is edited + repainted in place (bracket matches light up across lines).
The terminal is restored even if rendering raises (the caller must be on a TTY).

    (editor/lineedit/lineedit-read \"> \" [])   ;~> {:line \"…what the user typed…\"}"
  (do
    (term/raw-enter)
    (let (result (try
                   (lineedit-loop (lineedit-init prompt history opts))
                   (catch e (do (term/raw-leave) (throw e)))))
      (term/raw-leave)
      result)))
