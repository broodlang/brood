;; std/editor/treesit.blsp — generic services for tree-sitter language modes.
;;
;; `tree-sitter-parse` (the Rust builtin, feature "treesit") yields a positioned
;; CST in the SAME node shape Brood's own reader gives — `{:kind :start :end
;; :named}` per node, `:text` on leaves, `:kids` on nodes with children, half-open
;; CHARACTER offsets. This module is the language-agnostic policy over that shape:
;;
;;  - `fontify` — a `:fontify` service: walk the tree and emit `[start end face]`
;;    colour spans, colouring a whole node (and not descending) when a per-language
;;    kind→face table assigns it one — tree-sitter highlight semantics, so a
;;    `(string)`/`(comment)` span covers its delimiters and content as one.
;;  - `point-forward` / `-backward` / `-list-forward` / `-list-backward` / `-up` /
;;    `-up-forward` / `-down` / `-defun-start` / `-defun-end` — pure
;;    `(text lang point) -> point` structural motions, the foreign-language
;;    analogue of `std/tool/sexp`'s, navigating named nodes of the tree. The
;;    `-list-*` pair stops only at containers, so it steps over leaf siblings.
;;
;; Mechanism is the builtin; the per-language kind→face tables and keymaps are
;; policy in the editor's modes (`src/modes.blsp`). A new tree-sitter language is a
;; grammar crate (Brood `Cargo.toml`) + a face table + a layer — no code here.
;; Framework tier, pure, zero kernel surface beyond the parse builtin (§C).

(defmodule editor/treesit
  "Generic tree-sitter language services over `tree-sitter-parse`'s positioned
CST (`{:kind :start :end :named :kids/:text}`): `(fontify text lang face-of)` →
`[start end face]` spans, and pure structural motions `(text lang point) ->
point` — `point-forward` / `point-backward` (every named node),
`point-list-forward` / `point-list-backward` (containers only),
`point-up` / `point-up-forward` / `point-down`, and `point-defun-start` /
`point-defun-end` — which find what each language declared a definition to be with
`register-definitions`. `face-of` is built with `(face-of-kinds {kind face-name})`.
A view keeps a TREE per document instead: `open-tree` parses it once, `update-tree`
reparses it incrementally after an edit, `fontify-tree` colours a char range of it without
parsing, and `tree-changes` says which ranges an edit recoloured (ADR-443).
Per-language face tables + keymaps are policy in the editor. `(require
'editor/treesit)`."
  (:use editor/face)
  (:load registry)) ; each language's definitions (`register-definitions`)

;; ---- what a language mode must answer ---------------------------------------
;; The CONTRACT, named once. Every service below is generic — the editor's view asks a
;; buffer for `:fontify` and its RET asks for `:indent` without naming a language — so
;; "which services exist" is a fact about the seam, not about any one language, and
;; belongs where the seam does.
;;
;; It is data so that both sides can read it instead of remembering it: a registration
;; can refuse a language that does not answer the required set, and a test can enumerate
;; the set × the languages rather than listing the pairs by hand — otherwise a command
;; written to be language-agnostic can silently be reachable in only one language.

(def language-contract
  {
   ;; Without these a mode is not usable as a code mode at all.
   ;;   :ts-lang   the grammar keyword — also what marks the mode as tree-sitter-backed,
   ;;              which is how the polymorphic motions choose their backend
   ;;   :fontify   text -> ([start end face] …)
   ;;   :indent    text, line-start -> column
   :required [:ts-lang :fontify :indent]
   ;; Provide when the language has the thing; absence is a fact, not a gap.
   ;;   :fontify-restart  where a windowed fontify may safely begin (heredocs)
   ;;   :comment-syntax   the line-comment prefix, for comment/uncomment
   :optional [:fontify-restart :comment-syntax]})

(defn missing-services (layer:any -> list)
  "The `language-contract` services `layer` fails to provide — `()` when it is complete.
What a registration checks before accepting a language, so an incomplete mode fails at
load with the list rather than at the keypress that needed it.

    (editor/treesit/missing-services {:ts-lang :elixir})   ;=> (:fontify :indent)"
  (seq/filter (get language-contract :required) (fn (k) (nil? (get layer k)))))

;; A face table is the other half of what a language hands the seam, and it has a SHAPE
;; the kernel walk relies on: a key is a node kind or a context selector (ADR-486, see
;; `fontify`). The kernel refuses a malformed one too — but at the first fontify, which
;; is a frame, not a load. Checking it here lets a registration refuse it where
;; `missing-services` refuses a missing service.

(def- selector-constraints #{:kind :parent :field :nth :text :after})

;; how many selector MAPS one key may nest through `:parent` — the kernel's bound (ADR-487,
;; ADR-614: four reaches the name an Elixir `def` with a guard defines)
(def- selector-depth-max 4)

(defn- text-constraint-ok? (text)
  ;; a string, or a non-empty set of strings
  (or (string? text) (and (set? text) (not (empty? text)) (every? text string?))))

(defn- after-problem (selector after)
  ;; what is wrong with `selector`'s `:after` — the named sibling before the node, a map of
  ;; `:kind` and `:text` alone (ADR-614) — or nil
  (cond
    (nil? after) nil
    (not (map? after)) (str (pr-str selector) ": :after is a {:kind :text} selector map")
    (or (empty? after) (not (every? (keys after) (fn (k) (contains? #{:kind :text} k)))))
      (str (pr-str selector) ": :after names the sibling's :kind and :text only")
    (not (or (nil? (get after :kind)) (keyword? (get after :kind))))
      (str (pr-str selector) ": :after's :kind is a keyword")
    (not (or (nil? (get after :text)) (text-constraint-ok? (get after :text))))
      (str (pr-str selector) ": :after's :text is a string or a non-empty set of strings")
    else nil))

(defn- selector-shape-problem (selector depth)
  ;; what is wrong with the selector map `selector`, `depth` maps deep, or nil
  (let (parent (get selector :parent)
        after-issue (after-problem selector (get selector :after)))
    (cond
      (empty? selector) "an empty selector {} would colour every node"
      (not (every? (keys selector) (fn (k) (contains? selector-constraints k))))
        (str (pr-str selector)
          " names a constraint other than :kind :parent :field :nth :text :after")
      ;; the kernel reads every constraint the map has, so one present with no value is refused
      (any? (keys selector) (fn (k) (nil? (get selector k))))
        (str (pr-str selector) ": a constraint with no value — leave the key out instead")
      (not (every? [:kind :field] (fn (k) (or (nil? (get selector k)) (keyword? (get selector k))))))
        (str (pr-str selector) ": :kind and :field are keywords")
      (let (n (get selector :nth)) (not (or (nil? n) (and (int? n) (>= n 0)))))
        (str (pr-str selector) ": :nth is a non-negative int")
      (not (or (nil? (get selector :text)) (text-constraint-ok? (get selector :text))))
        (str (pr-str selector) ": :text is a string or a non-empty set of strings")
      (not (nil? after-issue)) after-issue
      (or (nil? parent) (keyword? parent)) nil
      (not (map? parent)) (str (pr-str selector) ": :parent is a kind keyword or a selector map")
      (>= depth selector-depth-max)
        (str (pr-str selector) ": :parent maps nest at most " selector-depth-max " deep")
      else (selector-shape-problem parent (inc depth)))))

(defn- selector-problem (selector face-name)
  ;; what is wrong with one face-table entry, or nil
  (cond
    (not (keyword? face-name)) (str "face name for " (pr-str selector) " is not a keyword")
    (keyword? selector) nil
    (not (map? selector)) (str (pr-str selector) " is neither a node kind nor a selector map")
    else (selector-shape-problem selector 1)))

(defn face-table-problems (table:any -> list)
  "What is malformed in the face table `table` — one message per bad entry, `()` when every
key is a node kind or a context selector (`{:kind :parent :field :nth :text :after}`, ADR-486,
ADR-487, ADR-614 — a `:parent` itself a kind or a selector map, at most four maps deep, an
`:after` the `:kind` and `:text` of the named sibling before the node) and every
value a face-name keyword. What a registration checks beside `missing-services`, so a
misspelt selector fails at load rather than at the first frame drawn.

    (editor/treesit/face-table-problems {:string :syntax/string {:field :function} :syntax/function})   ;=> ()
    (count (editor/treesit/face-table-problems {{:feild :name} :syntax/function}))   ;=> 1
    (editor/treesit/face-table-problems {{:kind :identifier :text #{\"def\" \"if\"} :parent {:kind :call}} :syntax/keyword})   ;=> ()"
  (seq/keep (%map-pairs table) (fn ([selector face-name]) (selector-problem selector face-name))))

;; An INJECTION spec (ADR-489) is the third thing a language hands the seam: which of its
;; nodes hold another language's text. Checked here for the same reason as a face table —
;; the kernel refuses a malformed one, but at the first frame.

(def- injection-rule-keys #{:content :exclude :lang :lang-from :aliases})

(defn- injection-rule-problems (rule faces)
  ;; what is wrong with one injection rule, as a list of messages — the last, a language the
  ;; rule can only ever name that has no table, being a rule that colours nothing
  (let (shown (pr-str rule)
        content (get rule :content)
        exclude (get rule :exclude)
        fixed (get rule :lang)
        from (get rule :lang-from)
        aliases (get rule :aliases))
    (cond
      (not (map? rule)) (list (str shown " is not an injection rule map"))
      (not (every? (keys rule) (fn (k) (contains? injection-rule-keys k))))
        (list (str shown " names a key other than :content :exclude :lang :lang-from :aliases"))
      (any? (keys rule) (fn (k) (nil? (get rule k))))
        (list (str shown ": a key with no value — leave the key out instead"))
      (nil? content) (list (str shown " names no :content selector"))
      (not (or (keyword? content) (map? content)))
        (list (str shown ": :content is a node kind or a selector map"))
      (and (map? content) (selector-shape-problem content 1))
        (list (selector-shape-problem content 1))
      (not (or (nil? exclude) (keyword? exclude) (map? exclude)))
        (list (str shown ": :exclude is a node kind or a selector map"))
      (and (map? exclude) (selector-shape-problem exclude 1))
        (list (selector-shape-problem exclude 1))
      (= (nil? fixed) (nil? from))
        (list (str shown " names its language with :lang or with :lang-from — exactly one"))
      (not (keyword? (or fixed from))) (list (str shown ": :lang and :lang-from are keywords"))
      ;; an empty :aliases names no language, so beside a fixed one it says nothing
      (and fixed aliases (not (and (map? aliases) (empty? aliases))))
        (list (str shown ": :aliases goes with :lang-from, not :lang"))
      (not (or (nil? aliases)
             (and (map? aliases)
               (every? (%map-pairs aliases) (fn ([word lang]) (and (string? word) (keyword? lang)))))))
        (list (str shown ": :aliases maps a string word to a language keyword"))
      else
        (seq/keep (if fixed [fixed] (vals (or aliases {})))
          (fn (lang)
            (when (not (contains? faces lang))
              (str shown " injects " lang ", which has no face table in :faces")))))))

(defn injection-problems (injections:any -> list)
  "What is malformed in the injection spec `injections` — one message per problem, `()` when
it is sound. The spec says which nodes of a tree-sitter language hold ANOTHER language's
text, and how to colour it (ADR-489):

    {:rules [{:content {:kind :quoted_content :parent :sigil}   ; the nodes whose text it is
              :lang-from :sigil_name                            ; …named by a node beside them
              :aliases {\"H\" :heex}}                           ; …whose first word maps so
             {:content {:kind :template_literal :parent :heredoc_template}
              :lang :bash}]                                     ; or a fixed language
     :faces {:heex heex-table :bash bash-table}}                ; each language's face table

`:content` is a face-table selector. A parent's matching children are ONE document (a
heredoc's pieces between `${…}` interpolations parse together, a line break between two
pieces kept). `:exclude`, also a selector, cuts the content's descendants it selects out of
the document, and they keep the host's colours — a Dockerfile `RUN <<EOT` line is shell
except its `<<EOT` marker (ADR-496). `:lang-from` names a node
kind among the content's siblings, else its children — a fence's info string, a sigil's
name — whose first word, through `:aliases` or lowercased as it is, is the language. A
document whose language has no table in `:faces`, or no grammar, keeps the host's colours.
What a registration checks beside `face-table-problems`.

    (editor/treesit/injection-problems {:rules [{:content :heredoc :lang :bash}] :faces {:bash {:string :syntax/string}}})   ;=> ()
    (count (editor/treesit/injection-problems {:rules [{:content :heredoc :lang :bash :lang-from :x}] :faces {}}))   ;=> 1
    (count (editor/treesit/injection-problems {:rules [{:content :x :lang :sql}] :faces {}}))   ;=> 1
    (editor/treesit/injection-problems {:rules [{:content :shell_fragment :exclude :heredoc_marker :lang :bash}] :faces {:bash {}}})   ;=> ()"
  (cond
    (not (map? injections)) (list (str (pr-str injections) " is not an injection spec map"))
    (not (every? (keys injections) (fn (k) (contains? #{:rules :faces} k))))
      (list "an injection spec takes :rules and :faces only")
    else
      (let (rules (get injections :rules [])
            faces (get injections :faces {}))
        (cond
          (not (or (vector? rules) (list? rules))) (list ":rules is a vector of injection rules")
          (not (map? faces)) (list ":faces maps a language keyword to its face table")
          else
            (append (mapcat rules (fn (rule) (injection-rule-problems rule faces)))
              (mapcat (%map-pairs faces)
                (fn ([lang table])
                  (if (not (keyword? lang))
                    (list (str ":faces key " (pr-str lang) " is not a language keyword"))
                    (map (face-table-problems table) (fn (problem) (str lang ": " problem)))))))))))

;; ---- does the grammar still have the names a language wrote? (ADR-583) ------------------
;; Everything above checks a language's tables for SHAPE. None of it can say whether the
;; names in them exist: a face table keyed `:heredoc_body` is well formed whether or not the
;; grammar has such a node, and a grammar update that renamed it leaves a language that loads,
;; parses and silently stops colouring heredocs. The names a language wrote are data — its
;; face table, its injection rules, its indent spec, its definitions — and the names a grammar
;; has are a kernel answer (`grammar-info`), so the comparison is a function, and drift is a
;; list of the names that went missing rather than a bug report months later.

(defn- names-of-selector (selector acc)
  ;; `acc` ({:kinds :fields}) with the kinds and fields the face-table selector names
  (cond
    (keyword? selector) (update acc :kinds (fn (kinds) (conj kinds selector)))
    (not (map? selector)) acc
    else
      (let (kind (get selector :kind)
            field (get selector :field)
            parent (get selector :parent)
            with-kind (if (keyword? kind) (update acc :kinds (fn (kinds) (conj kinds kind))) acc)
            with-field (if (keyword? field)
                         (update with-kind :fields (fn (fields) (conj fields field)))
                         with-kind)
            ;; the sibling an `:after` names (ADR-614) is a kind of the grammar too
            after-kind (get (get selector :after) :kind)
            with-after (if (keyword? after-kind)
                         (update with-field :kinds (fn (kinds) (conj kinds after-kind)))
                         with-field))
        (names-of-selector parent with-after))))

(defn- names-of-kinds (kinds acc)
  ;; `acc` with every keyword of `kinds` (a set or sequence, or nil) as a node kind
  (fold (or kinds [])
    acc
    (fn (names kind) (if (keyword? kind) (update names :kinds (fn (all) (conj all kind))) names))))

(defn language-names (language:map -> map)
  "The node kinds and field names a tree-sitter language's tables refer to, as `{:kinds
#{…} :fields #{…}}`. `language` holds any of `:faces` (a face table: its kind keys and every
selector's `:kind`, `:parent`, `:field` and `:after`), `:injections` (the RULES of an injection spec:
each `:content` and `:exclude` selector, each `:lang-from` kind — the embedded languages'
faces are their own grammars' business), `:indent` (an `indent-column` spec: its `:blocks`,
`:brackets` and `:verbatim` kinds; `:dedent` and `:opens` are source text, not kinds) and
`:definitions` (its `:kinds`). What `grammar-problems` checks against the loaded grammar.

    (editor/treesit/language-names {:faces {{:parent :call :field :function} :syntax/function} :indent {:blocks #{:do_block}}})   ;=> {:kinds #{:call :do_block} :fields #{:function}}"
  (let (faces (or (get language :faces) {})
        rules (or (get language :injections) [])
        indent (get language :indent)
        definitions (get language :definitions)
        from-faces (fold (keys faces)
                     {:kinds #{} :fields #{}}
                     (fn (acc selector) (names-of-selector selector acc)))
        from-rules (fold rules
                     from-faces
                     (fn (acc rule)
                       (if (not (map? rule))
                         acc
                         (names-of-kinds [(get rule :lang-from)]
                           (names-of-selector (get rule :exclude)
                             (names-of-selector (get rule :content) acc))))))
        from-indent (if (map? indent)
                      (names-of-kinds (get indent :verbatim)
                        (names-of-kinds (get indent :brackets)
                          (names-of-kinds (get indent :blocks) from-rules)))
                      from-rules))
    (if (map? definitions) (names-of-kinds (get definitions :kinds) from-indent) from-indent)))

;; The kinds every tree has whatever its grammar: the parser's own error and missing nodes.
(def- universal-kinds #{:ERROR :MISSING})

(defn grammar-problems (info:map names:map -> list)
  "What `names` (`language-names`' `{:kinds :fields}`) refers to that the grammar `info`
(`grammar-info`) lacks — one message per missing name, sorted, `()` when the grammar has
them all. A kind may be named or anonymous (`:def`, `:=>`). The message says which name and
which grammar, because the usual cause is a grammar NEWER (or older) than the tables were
written against, and the fix is the revision they were.

    (editor/treesit/grammar-problems {:lang :x :named #{:call} :anonymous #{} :fields #{:name}} {:kinds #{:call :heredoc_body} :fields #{:name}})   ;=> (\"node kind `heredoc_body` is not in the :x grammar\")"
  (let (lang (->string (get info :lang))
        known-kinds (set/union (or (get info :named) #{}) (or (get info :anonymous) #{}))
        known-fields (or (get info :fields) #{})
        missing-kinds (seq/filter (seq/sort-by (or (get names :kinds) #{}) ->string)
                        (fn (kind)
                          (not (or (contains? known-kinds kind) (contains? universal-kinds kind)))))
        missing-fields (seq/filter (seq/sort-by (or (get names :fields) #{}) ->string)
                         (fn (field) (not (contains? known-fields field)))))
    (append (map missing-kinds
              (fn (kind) (str "node kind `" (->string kind) "` is not in the :" lang " grammar")))
      (map missing-fields
        (fn (field) (str "field `" (->string field) "` is not in the :" lang " grammar"))))))

(defn language-grammar-problems (lang:keyword language:map -> list)
  "`grammar-problems` of the grammar the runtime parses `lang` with now, against the names
`language` (`language-names`' argument) refers to — loading a declared grammar, as its first
parse would. A one-item list naming the failure when there is no usable grammar, so a caller
reports one thing either way. What a language registry runs once per grammar it loads: a
grammar that fails it would mis-colour, and is better reported (and stood in for) than used.

    (editor/treesit/language-grammar-problems :no-grammar-has-this-name {})   ;=> (\"no :no-grammar-has-this-name grammar to check\")"
  (if (nil? (grammar-status lang))
    (list (str "no :" (->string lang) " grammar to check"))
    (let (info (try (grammar-info lang) (catch e (failure (error-message e)))))
      (if (failure? info)
        (list (error-message info))
        (grammar-problems info (language-names language))))))

;; ---- is this text finished? -------------------------------------------------
;; The question a LIVE evaluator asks before it sends anything, and the one thing a
;; parser must answer carefully: text that is merely *unfinished* is not text that is
;; *wrong*. Every form passes through unfinished on its way to being typed, so a tool
;; that reports the two the same way spends most of its time calling you mistaken.
;;
;; Brood's own reader makes the distinction with two error codes (E0002 "this could
;; still become valid" vs E0001 "it could not"). A tree-sitter grammar makes it with
;; the shape of its repair, and until `%tree-sitter-errors` there was no way to read
;; that from Brood: `%tree-sitter-chain` reports `:broken` on the root, which says only
;; that something, somewhere, is wrong.

(deftype parse-state (or :blank :ok (tuple :incomplete string) (tuple :err string)))

(defn- error-token (text)
  "The one token an error node is worth naming: its leading word (`do`, `fn`, `end`) when
it begins with one, else its first character (`(`, `*`, `\"`).

An ERROR node's text runs from where the parser lost its footing to wherever it
regained it, which for an unclosed construct is the rest of the buffer — the node for a
half-written `Enum.map([1,2], fn x ->` is all fifteen characters of it. What the reader
needs from that is the one token that opened, and that token is at the front."
  (let (t (string/trim-left text))
    (if (= t "")
      ""
      (let (word (regex/find "^[A-Za-z_][A-Za-z_0-9]*" t))
        (if word (get word :text) (string/substring t 0 1))))))

(defn parse-state (text:string lang:keyword -> parse-state)
  "Is `text` blank, mid-form, broken, or ready to evaluate? — `:blank`, `[:incomplete
reason]`, `[:err msg]` or `:ok`, for any language with a tree-sitter grammar.

The classification that matters is the middle one, and it is read from WHERE the parse
came apart rather than from the kind of repair alone:

  - a **MISSING** node is a token the grammar expected and inserted for you (an
    unterminated string's closing quote) — unfinished, by construction;
  - an **ERROR** node that runs to the end of the text is an unclosed construct: there
    is nothing after it because you have not typed it yet — unfinished;
  - an **ERROR** with good code after it is a real mistake, because no amount of further
    typing at the cursor will explain the text that already follows it.

The tail test is what makes this work for a grammar that repairs an unclosed `do` with
an ERROR rather than a MISSING `end` — which tree-sitter-elixir does, so the kind alone
would call every half-written `defmodule` a syntax error. Trailing whitespace is not
text: an error is at the tail if nothing but blanks follows it.

Where it is wrong it is wrong in the safe direction. A stray closing delimiter typed at
the end of a buffer reads as `[:incomplete \"unclosed `)`\"]` rather than as an error,
which shows a reader a dim, pending note instead of a confident red verdict about
something they are in the middle of fixing. The reverse mistake — a verdict on text
someone is still writing — is the one worth engineering against.

Blank text is answered without parsing at all, which is why the example below needs no
grammar; `\"1 +* 2\"` in Elixir is `[:err \"unexpected `*`\"]`, and the suite's cases are in
`tests/treesit_module_test.blsp`.

    (editor/treesit/parse-state \"   \\n \" :elixir)   ;=> :blank"
  (cond
    (= (string/trim text) "") :blank
    else
      (let (errs (%tree-sitter-errors text lang))
        (if (empty? errs)
          :ok
          ;; A MISSING node is never the broken case, whatever its position: it IS the
          ;; grammar saying "you have not typed this yet".
          (let (tail (string/length (string/trim-right text))
                broken (seq/find errs
                         (fn (e) (and (not (get e :missing?)) (< (get e :end) tail)))))
            (cond
              broken [:err (str "unexpected `" (error-token (get broken :text)) "`")]
              (get (first errs) :missing?)
                [:incomplete (str "missing `" (->string (get (first errs) :kind)) "`")]
              else [:incomplete (str "unclosed `" (error-token (get (first errs) :text)) "`")]))))))

(defn parse-tag (state:parse-state -> keyword)
  "The classification alone — `:blank`, `:ok`, `:incomplete` or `:err` — for a caller that
does not need the reason. The full state is a `match` subject; this is the `first` of it
that a keyword state has no `first` of.

    (editor/treesit/parse-tag [:incomplete \"missing `end`\"])   ;=> :incomplete"
  (if (vector? state) (first state) state))

;; ---- fontify ----------------------------------------------------------------

(defn face-of-kinds (kind->face-name)
  "A node→face function for `fontify` from a map of `{:node-kind :syntax/face-name}`:
the node's `:kind` looked up in the map and resolved live with `(face …)`, or nil
when the kind isn't coloured (so `fontify` descends into its children)."
  (fn (node)
    (let (name (get kind->face-name (get node :kind)))
      (if (nil? name) nil (face name)))))

(defn- ts-alpha? (c)
  "True if the 1-char string `c` is a letter. Brood's `<`/`<=` are numeric-only, so
test by case-folding: a letter changes between upper- and lower-case, punctuation
and digits don't."
  (not (= (string/upper c) (string/lower c))))

(defn anonymous-keyword? (node)
  "True for an anonymous token whose text is alphabetic — a language keyword
(`def`/`end`/`do`/`if`/`fn`/`class`…). The cheap, cross-language way to colour
keywords without enumerating every grammar's keyword set: keywords surface as
anonymous tokens, operators/punctuation as anonymous non-alphabetic ones.

    (editor/treesit/anonymous-keyword? {:named false :text \"def\"})   ;=> true
    (editor/treesit/anonymous-keyword? {:named false :text \"+\"})     ;=> false"
  (and (not (get node :named))
    (let (t (get node :text))
      (and (not (nil? t)) (> (string/length t) 0) (ts-alpha? (string/char-at t 0))))))

(defn face-of-syntax (kind->face-name)
  "Like `face-of-kinds`, plus the cross-language rule that an anonymous alphabetic
token (`anonymous-keyword?`) is a `:syntax/keyword`. Most language tables need
only name the handful of *named* nodes they colour (string/comment/number/…) and
get keywords for free. The face is resolved live, so a `(face-set :syntax/…)`
restyles the next frame drawn (under `ui-run`, the next turn that changes the model).


    (fn? (editor/treesit/face-of-syntax {:string :syntax/string}))   ;=> true"
  (fn (node)
    (let (name (or (get kind->face-name (get node :kind))
                 (if (anonymous-keyword? node) :syntax/keyword nil)))
      (if (nil? name) nil (face name)))))

;; ---- face tables: a kind, or a kind in its CONTEXT (ADR-486) ---------------------------
;; A face table maps a SELECTOR to a face name. The plain selector is a node kind,
;; `:comment`. A kind alone cannot tell apart what a grammar names alike — in HCL a block's
;; type (`resource`), an attribute's name (`ami =`) and a called function (`lookup(`) are
;; all `identifier`, and so is the function in a Rust, Go or Python call — so a selector may
;; also be a MAP naming where the node sits:
;;
;;   {:parent :block :kind :identifier :nth 0}   the identifier first among a block's named children
;;   {:parent :attribute :kind :identifier}      an identifier directly under an attribute
;;   {:field :function :kind :identifier}        an identifier filling its parent's `function` field
;;   {:field :name}                              whatever fills a `name` field, of any kind
;;
;; Two more reach what position alone cannot (ADR-487):
;;
;;   {:kind :identifier :parent :call :field :target :text #{"def" "if" "case"}}
;;                                               Elixir's `def`/`if`/`case`, which its grammar
;;                                               parses as calls — told from `foo(x)` by TEXT
;;   {:kind :field_identifier :parent {:kind :field_expression :field :function}}
;;                                               Rust's `s.bar()`, not the read `p.x`: the
;;                                               PARENT must satisfy a selector of its own
;;
;; And one reaches a SIBLING (ADR-614):
;;
;;   {:kind :identifier :field :target :parent {:kind :call :nth 0 :parent {:kind :arguments
;;     :after {:text #{"def" "defp"}}}}}        the name an Elixir `def` defines — its
;;                                               `arguments` come right after an identifier
;;                                               reading `def`, where a call's follow a name
;;
;; `:kind` and `:field` are keywords (tree-sitter's node and field names), `:nth` an index
;; among the parent's NAMED children, `:text` the node's exact source text (a string or a
;; set of strings), `:after` the `:kind` and `:text` of the named sibling right before the
;; node, `:parent` a kind or a selector map the parent satisfies in turn — its own `:field`,
;; `:nth` and `:after` placing it in the grandparent — at most four maps deep. Every one
;; given must hold. When several entries match a node the most specific wins: the node's
;; own constraints decide first — after over text over field over parent over position
;; over kind — then the parent selector's by the same rule, then the grandparent's, then the
;; narrower `:text` set. So any context entry beats the plain kind, and the answer never
;; depends on the map's order. A coloured node is coloured whole, context or not, so an
;; entry can only reach a node whose ancestors the table leaves uncoloured.
;;
;; The kernel walk matches the selectors itself (it is standing on the parent when it
;; reaches the child), so a context costs the walk nothing and no Brood runs per node.

(defn- token-rules (keywords?)
  "What a span query is asked to report of the anonymous tokens its table names none of
(ADR-614): keywords when `keywords?`, and brackets, commas and semicolons when
`:syntax/punctuation` paints anything — by default it does not, and then a bracket costs no
span. Read per call, so a theme that dims punctuation takes effect on the next frame."
  (let (punctuation (face :syntax/punctuation))
    (cond
      (or (nil? punctuation) (empty? punctuation)) keywords?
      keywords? #{:keywords :punctuation}
      else #{:punctuation})))

(defn- table-spans->faces (raw kind->face-name injections)
  "The `[start end face-name]` spans a span query answers, as `[start end face]` — each
face name resolved, `:__keyword__` as `:syntax/keyword` and `:__punctuation__` as
`:syntax/punctuation`. The names come from the host's
table and from every injected language's table in `injections` (ADR-489), since an
injected span reports its own table's face name."
  ;; Each face resolved ONCE per call — per face name, not per span. A window has a few
  ;; hundred spans and a table a dozen entries, and looking the face up for every span was
  ;; two thirds of the whole fontify (1.28 ms against 0.41 ms on a 250-line Elixir window,
  ;; measured in bedit) — paid on every keystroke in every tree-sitter language.
  (let (tables (cons kind->face-name (vals (get injections :faces {})))
        resolved (fold tables
                   {:__keyword__ (face :syntax/keyword)
                    :__punctuation__ (face :syntax/punctuation)}
                   (fn (acc table)
                     (fold (%map-pairs table)
                       acc
                       (fn (inner [_ name]) (assoc inner name (face name)))))))
    ;; a LIST, as before — the `:fontify` contract, and what `shift-spans` and the view
    ;; consume; returning a vector here compared unequal to every list in sight
    (seq/keep raw
      (fn (sp)
        (let (resolved-face (get resolved (nth sp 2)))
          (when resolved-face [(nth sp 0) (nth sp 1) resolved-face]))))))

(defn fontify (text lang kind->face-name &optional (keywords? true) (injections nil))
  "A `:fontify` service: `[start end face]` colour spans for `text` parsed as the
tree-sitter language keyword `lang` (`:ruby`/`:elixir`), from a face table — `{selector
:syntax/face-name}`, a selector being a node kind or a context map (see above: `{:parent
:call :kind :identifier}`, `{:field :function}`). Faces are resolved live, so a
`(face-set :syntax/…)` restyles the next frame drawn (under `ui-run`, the next turn that
changes the model). With `keywords?` (the default), an anonymous alphabetic token is a
`:syntax/keyword` — the cross-language rule that lets a table name only the handful of
*named* nodes it colours. And when the `:syntax/punctuation` face paints anything (a theme that
dims punctuation; by default it does not), an anonymous bracket, comma or semicolon is
`:syntax/punctuation` (ADR-614).

Takes the TABLE, not a node→face closure. The selection happens inside
`%tree-sitter-spans`, which walks the tree in Rust and returns spans only for what the
table colours — and a closure cannot say what that is. Fontify is the one consumer that
genuinely visits every node, so it was the one paying for the whole-tree projection:
thousands of Brood maps per keystroke, built to read `:kind` off each and discard the
rest. `face-of-kinds` / `face-of-syntax` remain for anything that wants the node→face
function itself (plain kinds only).

`injections` (ADR-489) declares the code EMBEDDED in this language — a fence's body, a
sigil's, a heredoc's — as `{:rules [rule …] :faces {lang table}}`; see `injection-problems`
for the shape. Over each embedded document the host's spans give way to its own language's."
  (table-spans->faces (%tree-sitter-spans text
                        lang
                        kind->face-name
                        (token-rules keywords?)
                        injections)
    kind->face-name injections))
(sig fontify (string keyword any -> any))

(defn fontify-ranges (text lang ranges kind->face-name &optional (keywords? true))
  "`fontify` over PART of `text`: the char `ranges` (`[start end]` each) parsed as ONE
document in the tree-sitter language `lang`, its spans `[start end face]` in `text`'s own
char offsets, clipped to the ranges. `text` is a string or a rope (read in place).

What a host WITHOUT a tree calls to colour code embedded in it (ADR-489): a line-lexed
Markdown buffer colours a fence's body as the language its info string names, a Dockerfile
colours a `RUN` line as shell. The ranges are one document, so code split across them — a
fence whose lines the host hands over one by one, a heredoc broken by interpolations —
parses as it reads. `()` when `lang` has no grammar: an embedded language's grammar is
optional, and a caller keeps its own colours there. Bounded: past 256 ranges or 128 KB the
rest is left uncoloured.

    (editor/treesit/fontify-ranges \"# x\\n\" :no-such-grammar [[0 3]] {:string :syntax/string})   ;=> ()"
  (let (raw (%tree-sitter-range-spans text lang ranges kind->face-name (token-rules keywords?)))
    (if (nil? raw) '() (table-spans->faces raw kind->face-name nil))))

;; ---- a tree per document: incremental parsing (ADR-443) ----------------------------
;; `fontify` takes TEXT, which makes it a pure service and a poor fit for a view: the
;; caller slices a window out of the buffer, the kernel re-derives what changed by
;; diffing it against whatever it parsed last, and the window has no context above it —
;; a string opened off screen colours as code. A TREE HANDLE is the whole document's
;; parse, held beside the buffer's rope: an edit reparses it incrementally (tree-sitter
;; reuses every subtree the edit did not touch), and a frame asks it for the spans of the
;; lines on screen without parsing anything.
;;
;; A handle is an opaque ref, immutable like every value: `update-tree` returns a NEW one
;; and leaves the old one answering as before. A handle is OWNED (ADR-495) by the process
;; that opened or updated it, like a socket: it goes away when that process frees it
;; (`free-tree` — free the handle you replace) or exits, and nothing another process does
;; can take it. A task that parses off the loop hands its tree on (`give-tree`) before it
;; replies, or the tree dies with the task. Every query on a gone handle answers nil, and
;; updating from one is a full parse — never an error, never a wrong tree.

(defn open-tree (text lang)
  "A tree handle for the whole document `text` — a rope (read in place, never copied) or a
string — parsed as the tree-sitter language `lang`. Keep it beside the text it was parsed
from; hand it to `update-tree` after an edit and to `fontify-tree` to colour a range.

    (editor/treesit/open-tree text :elixir)   ;~> a tree handle (a ref) for the document
    (fn? editor/treesit/open-tree)   ;=> true"
  (%tree-sitter-tree text lang))

(defn update-tree (tree text lang &optional (edits nil))
  "A NEW tree handle for `text`, reparsed incrementally from `tree` (which stays valid —
free it with `free-tree` once nothing reads it). `edits` says what changed since `tree`'s
text, in char offsets: one `[start old-end new-end]`, a sequence of them in the order they
were made, or nil to have the kernel find the change by comparing the two texts — cheap
(prefix and suffix, chunk by chunk) and exact for any single contiguous edit, so nil is
the right default for a caller that does not already know. A splice `[lo hi repl]` is the
edit `[lo hi (+ lo (string/length repl))]`.

That comparison reads both texts up to the change from each end — linear in the document
per call. A caller holding the splices it made (`editor/buffer/buffer-splices-since`, nil
when the log cannot say) passes them instead and the reparse costs the edit alone: the
kernel composes a sequence into the one range it covers, and refuses an edit whose lengths
do not fit the two texts rather than build a wrong tree.

    (editor/treesit/update-tree tree rope :elixir (map splices (fn ([lo hi repl]) [lo hi (+ lo (string/length repl))])))   ;~> a new handle, reparsed without comparing the texts

    (editor/treesit/update-tree tree new-text :elixir)   ;~> a new handle; tree still answers for the old text
    (fn? editor/treesit/update-tree)   ;=> true"
  (%tree-sitter-tree-reparse tree text lang edits))

(defn free-tree (tree)
  "Drop `tree`'s handle now. True when it was still held.

    (editor/treesit/free-tree tree)   ;~> true, then false for the same handle again
    (fn? editor/treesit/free-tree)   ;=> true"
  (%tree-sitter-tree-free tree))

(defn give-tree (tree pid)
  "Hand `tree` to the local process `pid`: it becomes `pid`'s to free, and dies when `pid`
exits instead of when the caller does. A tree belongs to the process that opened (or
updated) it, so a task parsing off the loop gives the tree to the process it reports to
BEFORE replying — the task exits right after, and a tree it still owned would go with it.
True when `pid` holds it now; false when the handle was already gone or `pid` has died. Only
the owner can give a tree away: anyone else's call is an error.

    (editor/treesit/give-tree tree editor-pid)   ;~> true — then reply with the handle
    (editor/treesit/give-tree (ref) (self))   ;=> false"
  (%tree-sitter-tree-give tree pid))

(defn owned-trees ()
  "Every tree handle the calling process owns, as a vector by ascending id: the ones it opened
or updated and has not freed or given away, and the ones given to it. A handle is freed only
by its holder or its owner's exit, so one a holder lost track of — opened by a turn an editor
then rolled back — stays until that exit. Free every owned handle you no longer reference, at
some quiet moment, and that is the whole sweep.

    (editor/treesit/owned-trees)   ;~> [] — or the handles this process holds
    (vector? (editor/treesit/owned-trees))   ;=> true"
  (%tree-sitter-owned-trees))

(defn tree-changes (tree &optional (injections nil))
  "Where `tree`'s colouring may differ from the tree it was updated from: a sorted vector of
disjoint char ranges `[start end]` — the edited text, plus every range whose syntax the edit
changed (a quote typed above the screen recolours everything after it, and this says so).
`[]` when the text did not change, `true` for a tree from a fresh parse (anything may
differ), nil when the handle is gone. What a span cache invalidates by, instead of dropping
every cached band on any edit. With `injections` (as `fontify`'s) a range reaching an
embedded document is widened over all of it: an edit inside a fence can recolour the fence
below the edit, which the host's tree cannot know, its own syntax being unchanged.

    (editor/treesit/tree-changes (editor/treesit/open-tree text :elixir))   ;~> true — a fresh parse
    (editor/treesit/tree-changes (editor/treesit/update-tree tree text :elixir))   ;~> [] — nothing changed
    (fn? editor/treesit/tree-changes)   ;=> true"
  (%tree-sitter-tree-changes tree injections))

(defn fontify-tree (tree kind->face-name from to &optional (keywords? true) (injections nil))
  "`fontify` over a held tree, for chars `[from, to)` of its text: `[start end face]` spans in
ABSOLUTE char offsets, each clipped to the range, for the outermost nodes `kind->face-name`
colours that reach into it. Parses nothing, and walks only the nodes that reach the range —
and because the tree is the whole document's, a construct opened above `from` colours as what
it is. A vector — `[]` for a range nothing colours — and nil only when the handle is gone,
so a caller can tell the two apart: open a fresh tree on nil. `injections` as `fontify`'s: the
embedded documents reaching the range are parsed for this call — none is held beside the
tree — each whole up to 32 KB and cut to the range past that (ADR-489).

    (editor/treesit/fontify-tree tree {:string :syntax/string} 0 40)   ;~> [[8 13 :syntax/string] …], nil once tree is freed
    (fn? editor/treesit/fontify-tree)   ;=> true"
  (let (raw (%tree-sitter-tree-spans tree
              kind->face-name
              (token-rules keywords?)
              from
              to
              injections))
    (when raw (into [] (table-spans->faces raw kind->face-name injections)))))

(defn tree-alive? (tree)
  "Whether `tree` is still held — not freed, and its owner (`give-tree`) not exited. Builds
nothing: the check to make per event, where asking `tree-changes` would build a vector only
to test it for nil.

    (editor/treesit/tree-alive? (ref))   ;=> false"
  (%tree-sitter-tree-alive? tree))

;; ---- the structural queries over a held tree (ADR-467) --------------------------
;; Every query below — `indent-column`, the `point-*` motions — takes the document's TEXT
;; and asks the kernel about it, which parses it (cached by text, so the first query after
;; an edit pays a whole parse: ~650 ms on a 250 KB file). A caller that keeps the
;; document's tree incrementally (`update-tree` per edit) passes it as the optional last
;; argument, and the query reads that tree instead: no parse, O(depth). The tree must be
;; the one for exactly `text` — the query still reads `text` for what a node does not carry
;; (a line's indentation, an Elixir call's head word). A gone handle falls back to the
;; text, so passing one is never worse than not.
;;
;; The text may be a string or a ROPE (ADR-483). An editor holds its document as a rope,
;; and building the whole-buffer string to indent one line was the cost of RET on a large
;; file. With a held tree a rope query reads only the lines it inspects; without one, the
;; parse needs the string anyway and the rope is converted for it.

(defn- ts-source-length (src)
  (if (rope? src) (text/length src) (string/length src)))

(defn- ts-slice (src from:int to:int -> string)
  "Characters `[from, to)` of `src`, a string or a rope, as a string."
  (if (rope? src) (text/slice src from to) (string/substring src from to)))

(defn- ts-line-start (src at)
  "The offset of the start of the line containing `at` (a newline belongs to the line it
ends)."
  (if (rope? src)
    (text/line->char src (text/char->line src at))
    (inc (string/last-index-of src "\n" at))))

(defn- ts-line-end (src at)
  "The offset of the newline ending the line containing `at`, or the end of `src`."
  (if (rope? src)
    (let (line (text/char->line src at))
      (if (< (inc line) (text/line-count src))
        (dec (text/line->char src (inc line)))
        (text/length src)))
    (let (i (index-of src "\n" at)) (if (< i 0) (string/length src) i))))

(defn- ts-string (src)
  ;; the text-keyed kernel queries parse a string
  (if (rope? src) (text/->string src) src))

(defn- ts-chain-at (text lang at tree)
  ;; the held tree's chain when there is one alive, else the text's
  (or (when tree (%tree-sitter-tree-chain tree at)) (%tree-sitter-chain (ts-string text) lang at)))

(defn node-chain (text lang offset &optional (tree nil))
  "The nodes of `text`'s `lang` parse that contain char `offset`, OUTERMOST first (the root, then
each node inside it down to the deepest), each `{:kind :start :end :named :container}` in char
offsets. Read from `tree`, a held parse of exactly `text`, when one is given and alive, else from
`text` parsed (cached by text). What a structural question about a place walks: the string or
comment it is in, the block a fold there would cover.

    (map (editor/treesit/node-chain \"x = [1,\\n 2]\" :ruby 5) :kind)   ;~> (:program :assignment :array …)"
  (ts-chain-at text lang offset tree))

(defn node-children (text lang offset &optional (all? false) (tree nil))
  "The children of the deepest node STRICTLY containing char `offset` of `text` (a string or a
rope) parsed as `lang`, each `{:kind :start :end :named :container}` without its own
children, in source order — the named ones, or with `all?` the parent's ANONYMOUS tokens
too, each `:named false` with the token's text as its `:kind` (`:{`, `:do`). `tree`, the
held tree of exactly `text`, is read instead of parsing it; a gone handle falls back to the
text. Strict containment makes a point at a node's start belong to its parent.

`all?` is what a bracket matcher wants: a delimiter pair in the middle of its parent — an
HCL block's braces after its labels, bash's `name()` — sits in this list beside the named
children, so the pair is read from it rather than found by scanning the text between them.

    (editor/treesit/node-children \"f(a, b)\\n\" :elixir 2 true)   ;~> [{:kind :( …} {:kind :identifier …} {:kind :, …} {:kind :identifier …} {:kind :) …}] — with the :elixir grammar
    (fn? editor/treesit/node-children)   ;=> true"
  (or (when tree (%tree-sitter-tree-kids tree offset all?))
    (%tree-sitter-kids (ts-string text) lang offset all?)))

(defn- ts-kids-at (text lang at tree)
  ;; the held tree's sibling list when there is one alive, else the text's
  (node-children text lang at false tree))

;; ---- where a windowed fontify may restart -------------------------------------

(defn- ts-col0? (src i)
  ;; A line beginning with something other than whitespace. `i` may sit one past the end —
  ;; a window whose last line has no newline, or an empty buffer — and `string/char-at`
  ;; raises there rather than answering nil, so the bound is checked here.
  (and (< i (string/length src))
    (let (c (string/char-at src i))
      (and (not (= c " ")) (not (= c "\t")) (not (= c "\n")) (not (= c "\r"))))))

(defn- ts-back-to-col0 (src at)
  (let (nl (string/last-index-of src "\n" at))
    (if (< nl 0) 0 (if (ts-col0? src (inc nl)) (inc nl) (ts-back-to-col0 src nl)))))

(defn- ts-count-upto (src:string needle:string upto:int acc:int from:int -> int)
  (let (i (index-of src needle from))
    (if (or (< i 0) (>= i upto))
      acc
      (ts-count-upto src needle upto (inc acc) (+ i (string/length needle))))))
;; Declared because the body is SELF-RECURSIVE, and the checker deliberately does not
;; specialize those (it would type an accumulator loop from its first base case). Undeclared,
;; the count read `number`, and `column0-restart`'s `(math/rem opened 2)` — which wants an
;; int — was a strict-gate warning. A counter is an int; saying so is one line.

(defn column0-before (src pos)
  "The offset of the nearest line at or before `pos` that begins in column 0 with something
other than whitespace, or 0 when there is none — the CANDIDATE restart point, ungurded.

Separate from [[column0-restart]] because the guard is the language-specific half. Elixir can
decide safety by counting paired heredoc markers, which is what `column0-restart` does; Ruby
cannot (its `<<~EOS` terminator is arbitrary text) and needs to scan for its own openers. Both
want the same candidate, and neither should re-derive it.

    (editor/treesit/column0-before \"a\\nb\\n  c\" 6)   ;=> 2"
  ;; `pos` is a line start when `ed-window-src` calls this, but normalising to one anyway
  ;; makes the answer total: an offset in the middle of a line asks about that line, and the
  ;; result is always a line start, never an offset into one.
  (let (line-start (ts-line-start src pos))
    (if (ts-col0? src line-start) line-start (ts-back-to-col0 src line-start))))

(defn column0-restart (src pos delimiters)
  "A `:fontify-restart` answer for a tree-sitter mode: the offset of the nearest line at or
before `pos` beginning in column 0, or 0 when that line cannot be shown to lie outside a
multi-line string.

**Why a mode wants one.** An editor fontifies a WINDOW — the viewport plus a lead-in, so a
construct opening above the screen is still in scope. A mode with no restart parses that
lead-in in full on every keystroke: 245 lines for a 44-row viewport, five times more text
than is on screen (18 ms of a 25 ms keystroke, measured in bedit on a 10k-line Elixir file).
A restart says where the lead-in may be cut, and for a language whose top-level constructs
begin in column 0 — Elixir, Ruby, Python, Go, Rust — the previous such line is that place.

**Why the guard.** A column-0 line INSIDE a heredoc is not a restart point: parse from there
and the prose of an `@moduledoc` colours as code. So a candidate is accepted only when the
number of `delimiters` occurrences before it is EVEN — every multi-line string opened in this
window is also closed above the candidate. `delimiters` is a vector of the language's PAIRED
multi-line string markers (Elixir's triple-quote and triple-apostrophe). A language whose
heredocs have no paired marker — Ruby's `<<~EOS`, whose terminator is arbitrary text — has
nothing to count, and should keep the lead-in rather than pass a list that cannot decide.

**What it does not fix.** A construct opening ABOVE the window is invisible to this guard —
and to the lead-in it replaces. Both mis-colour there, identically. That is the ceiling of
any windowed fontify rather than of this rule: measured against a whole-file parse, the
restart is never wrong where the lead-in is right, and is right everywhere the lead-in is.

    (editor/treesit/column0-restart \"x\\n'''\\ny\" 6 [\"'''\"])   ;=> 0"
  (let (candidate (column0-before src pos)
        opened (fold delimiters 0 (fn (n d) (+ n (ts-count-upto src d candidate 0 0)))))
    (if (= 0 (math/rem opened 2)) candidate 0)))

;; ---- indentation -------------------------------------------------------------
;; The `:indent` service's other half. Brood indents by parsing `[defun-start, bol)` and
;; asking what is still OPEN — the reader leaves an unclosed form as an unclosed node. That
;; trick does not transfer: tree-sitter's error recovery collapses an unterminated `do` into
;; an ERROR node rather than an open block, so a truncated slice knows nothing about the
;; nesting.
;;
;; The level is how many block nodes enclose the line, and [[chain]] answers that from the
;; real root in O(depth) — no slice that could begin inside a form and lose enclosing
;; blocks, and no projection of every node. What remains
;; is the one case no tree can answer — text that does not parse yet, which is the ordinary
;; state of a line being typed — and there the lexical fallback carries the previous line.

(defn- ts-leading-columns (line:string -> int)
  ;; the COLUMN `line`'s text starts at: its leading whitespace's display width, a tab
  ;; reaching the next stop of the ambient `*tab-width*` (ADR-537). A character count was
  ;; read as a column, so a line indented with two tabs came back as column 2
  (string/display-width (string/substring line
                          0
                          (- (string/length line) (string/length (string/trim-left line))))))

(defn- ts-prev-nonblank (text: (or string rope) bol:int -> (or nil (tuple int string)))
  ;; `[indent last-token]` of the nearest non-blank line before `bol`, or nil when there is
  ;; none — what the indenter carries when no tree can answer.
  (if (<= bol 0)
    nil
    (let (nl (dec (ts-line-start text bol))
          ls (if (< nl 0) 0 (ts-line-start text nl))
          le (if (< nl 0) (math/max 0 (dec bol)) nl)
          l (ts-slice text ls le))
      (cond
        (and (< nl 0) (= (string/trim l) "")) nil
        (= (string/trim l) "") (ts-prev-nonblank text ls)
        else [(ts-leading-columns l) (or (last (string/split (string/trim l) " ")) "")]))))

(defn- ts-chain (node p acc)
  ;; the kinds of every node containing offset `p`, outermost first
  (let (hit (seq/find (or (get node :kids) [])
              (fn (k) (and (<= (get k :start) p) (< p (get k :end))))))
    (if (nil? hit)
      (reverse (cons (get node :kind) acc))
      (ts-chain hit p (cons (get node :kind) acc)))))

(defn- ts-opens-with? (line token)
  "Does `line` begin with `token` at a WORD BOUNDARY? `end)` closes a block and `endless`
does not, and splitting on whitespace cannot tell them apart — which is how the closing
line of `Enum.reduce(xs, %{}, fn … end)`, a shape Elixir is full of, kept a level it had
already left.

The boundary is asked of a token that ENDS in a word character only. A punctuation token
has no word to run on into — JSX's `</` closes an element whatever tag name follows it."
  (let (t (string/trim-left line)
        n (string/length token)
        word-char? (fn (c) (regex/matches? "[A-Za-z0-9_]" c)))
    (and (string/starts-with? t token)
      (or (= (string/length t) n)
        (not (word-char? (string/substring token (dec n) n)))
        (not (word-char? (string/substring t n (inc n))))))))

(defn- ts-dedent-tokens (dedent)
  "The tokens of a `:dedent`, which may be a SET (all backing out `:dedent-levels`) or a
MAP of token → levels. A map because grammars disagree per token, not per language: in
Ruby a `body_statement` stops before its `end`, so `end` is already outside and backs out
nothing — but it SPANS its own `ensure`, so `ensure` must back out one. One number for
the language cannot say both, and with only a set Ruby's `ensure` sat a level too deep in
every method that had one."
  (if (map? dedent) (into [] (map dedent first)) (into [] dedent)))

(defn- ts-closing-token (line dedent)
  "The closing token `line` begins with, or nil.

A closing DELIMITER counts whether or not the language listed it, because it needs no
listing: `ts-dedent-levels` works out what it closes from the chain. Requiring it in the
table was the bug that came with making delimiters self-deciding — the entries were
removed from the tables as redundant, and with them went the only thing that recognised
those lines as closing at all, so every `}` on its own line stopped dedenting."
  (let (t (string/trim-left line)
        first-char (when (> (string/length t) 0) (string/substring t 0 1)))
    (if (and first-char (includes? ")]}" first-char))
      first-char
      (seq/find (ts-dedent-tokens dedent) (fn (d) (ts-opens-with? line d))))))

(defn- ts-delimiter? (token)
  (and token (= 1 (string/length token)) (includes? ")]}" token)))

(defn- ts-dedent-levels (spec token brackets-counted)
  "How many levels `token` backs out of.

A closing DELIMITER decides for itself: it leaves the bracket it closes, so it backs out
one iff a bracket was counted for this line and none otherwise. That cannot be a table
entry, because the same `}` plays two grammatical roles — closing a Ruby hash, whose node
still encloses the closing line, and closing a `{ |x| … }` block, whose `block_body` ended
before it. One number for `}` is wrong in whichever case it was not written for, and both
appear in the same file.

Everything else is a keyword, and a keyword's answer IS per language — `end` is outside
its `body_statement` while `ensure` is inside one — so it comes from the table."
  (if (ts-delimiter? token)
    (math/min 1 brackets-counted)
    (let (dedent (get spec :dedent #{}))
      (if (and (map? dedent) (not (nil? (get dedent token))))
        (get dedent token)
        (get spec :dedent-levels 1)))))

(defn- ts-aligns? (text: (or string rope) open:int -> bool)
  "Does the bracket at offset `open` have CONTENT after it on its own line?

That is the whole distinction every formatter draws. A bracket that ends its line opens a
HANGING indent — its contents go one level in:

    __all__ = [
        'field',

A bracket with something after it on the line opens an ALIGNED one — its contents line up
under that first item, wherever it happens to sit:

    __all__ = ['dataclass',
               'field',

The second is not a level at all; it is a column, and it is why counting blocks alone
could never produce it. Roughly a quarter of the Python stdlib's lines and a tenth of
Ruby's are aligned this way."
  (let (after (inc open)
        eol (ts-line-end text after))
    (and (< after eol) (not (= (string/trim (ts-slice text after eol)) "")))))

(defn- ts-align-column (text bol chain brackets)
  "The column a continuation line aligns to, or nil when it is not one.

The innermost bracket enclosing the line, when that bracket opened with content after it.
Only a real delimiter counts — `(`, `[`, `{` — because a `:brackets` entry may be a
CONSTRUCT rather than a delimiter (Elixir's `fn … end`), and a construct has no column to
align under."
  (let (inner (last (seq/filter chain
                      (fn (node)
                        (and (contains? brackets (get node :kind))
                          (< (ts-start node) bol)
                          (includes? "([{"
                            (ts-slice text
                              (ts-start node)
                              (inc (ts-start node)))))))))
    (when (and inner (ts-aligns? text (get inner :start)))
      (inc (- (get inner :start) (ts-line-start text (get inner :start)))))))

(defn- ts-next-nonblank-bol (text bol)
  "The start of the next NON-BLANK line after the one at `bol`, or nil at the end.

Blank lines are skipped rather than consulted, because a blank line's own answer is the
block level — the very thing a comment above the first statement is trying not to use.
A comment, a blank, then the code it describes is the ordinary shape of a docstring-style
comment in Python, and stopping at the blank put the comment in column 0."
  (letrec (scan (fn (from)
                  (let (next-bol (inc (ts-line-end text from)))
                    (cond
                      (>= next-bol (ts-source-length text)) nil
                      (= "" (string/trim (ts-slice text next-bol (ts-line-end text next-bol))))
                        (scan next-bol)
                      else next-bol))))
    (scan bol)))

;; check-allow: deliberately non-tail — the depth is a run of consecutive comment
;; lines, and it stops at the first line that is code.
(check-allow :non-tail-recursion
  (defn- ts-comment-column (text lang bol chain spec tree)
    "The column for a COMMENT line — the column of the next line that is code — or nil
when this line is not a comment.

A comment belongs to what follows it, which is how every editor treats it and the only
answer that survives the grammars. Ruby's `body_statement` begins at its first
STATEMENT, and a comment is not one, so the doc comment above a method sits outside the
method's body and counting blocks puts it a level short — every documented method in the
Ruby stdlib. Asking what the next code line does is right there and right everywhere."
    (when (and (not (empty? chain))
            (contains? editor/treesit/*comment-kinds* (get (last chain) :kind)))
      (let (next-bol (ts-next-nonblank-bol text bol))
        (when next-bol (indent-column text lang next-bol spec tree))))))

(defn indent-column (text lang bol spec &optional (tree nil))
  "The column the line beginning at offset `bol` should be indented to — a `:indent` service
for a tree-sitter mode, given a per-language `spec`. `text` is a string or a rope (ADR-483): an
editor passes its buffer's rope and held `tree`, and only the lines the indenter inspects are
read — RET in a large file builds no whole-buffer string.

    {:width 2                        ; columns per level
     :blocks #{:do_block :body}      ; node kinds that open one
     :dedent #{\"end\" \"else\"}         ; line-leading tokens that close one
     :dedent-levels 1                ; how many the closing token backs out of
     :verbatim #{:heredoc_template}} ; node kinds whose inside is content, not code

**Mechanism here, kinds there.** Which node opens a level is the one thing only the language
knows, and it is a set of names — so a language's whole indent policy is four entries, and
this walks the tree. The nesting level is the number of enclosing `:blocks` nodes.

**Where a line is measured from is the subtle part.** An ordinary line is measured at its
first non-blank character, because a block node may not begin until its first statement —
Ruby's `body_statement` starts at the `def` it contains, so measuring at the line START puts
you outside the very block you are in. A CLOSING line is measured at the line start instead,
because a closer sits outside what it closes; measuring `end` at the `end` would put it
inside the block again in some grammars and not others.

`:dedent-levels` is what remains of that difference, and it is per-language because the
grammars genuinely differ: Elixir's `do_block` spans its own `end`, so a closer measured at
the line start is still inside it and must back out one; Ruby's `body_statement` stops before
`end`, so the closer is already out and backs out none. Both are checked line-for-line
against real source.

**A line inside a `:verbatim` node is left where it is.** A heredoc's body, a raw string, a
triple-quoted docstring: their lines are CONTENT, and their indentation is part of the value
— re-indenting a heredoc line to its block level rewrote the shell script inside it. A line
is verbatim when a `:verbatim` node that began on an EARLIER line encloses it (the line that
opens the heredoc is code, and is indented as code), and its answer is the indentation it
already has, so a caller that indents to the answer changes nothing. A BLANK verbatim line
answers the previous non-blank line's indentation instead — the RET case, where the new line
has no indentation of its own yet and the content's is the one to continue. Indentation is
counted in characters, as everywhere here.

Deliberately not a full indent engine: no alignment to an open bracket's column, no operator
continuation rules. It answers the shape that block-structured languages share, which is the
shape `nest format` answers for Brood, and it is checked line-for-line against real source in
`tests/treesit_module_test.blsp`.

    (editor/treesit/indent-column \"def f do\\nx\\nend\" :elixir 9 spec)   ;~> 2 — with the :elixir grammar installed and the spec above"
  (let (width (get spec :width 2)
        eol (ts-line-end text bol)
        line (ts-slice text bol eol)
        closing-token (ts-closing-token line (get spec :dedent #{}))
        closing (not (nil? closing-token))
        ;; an ordinary line measures at its first non-blank, a closing line at the line start
        at (if closing bol (+ bol (- (string/length line) (string/length (string/trim-left line)))))
        blocks (get spec :blocks #{})
        chain (ts-chain-at text lang at tree)
        broken (get (first chain) :broken)
        verbatim (get spec :verbatim #{})
        ;; inside content (a heredoc's body) that opened on an earlier line
        inside-verbatim (and (not (empty? verbatim))
                          (any? chain
                            (fn (node)
                              (and (contains? verbatim (get node :kind)) (< (get node :start) bol)))))
        ;; Two kinds of opener, and they differ in ONE way: whether a node that begins on
        ;; the line being indented counts for that line.
        ;;
        ;; `:blocks` always counts. A `do`-shaped block opens at a keyword on an earlier
        ;; line, so the question never arises — and Ruby's `body_statement` deliberately
        ;; begins AT its first statement, so it must count for that statement's own line
        ;; or every method body loses a level.
        ;;
        ;; `:brackets` counts only when it opened on an earlier line, because a bracket
        ;; can open on the very line being indented, and then it is not enclosing that
        ;; line — it is starting on it:
        ;;
        ;;     [                 <- the list starts here; this line is at the OUTER level
        ;;       {:a, 1},        <- inside it, one deeper
        ;;     ]
        ;;
        ;; Counting a list for its own opening line pushes `[` in by a level, and the same
        ;; mistake appears on every `%{`, `{` and `fn` that begins a line.
        brackets (get spec :brackets #{})
        openers (seq/filter chain
                  (fn (node)
                    (let (k (get node :kind))
                      (or (contains? blocks k)
                        (and (contains? brackets k) (< (get node :start) bol))))))
        ;; Brackets that open on the SAME LINE count once between them. `frozenset({`
        ;; opens two, and charging a level for each put the contents at 8 where Python
        ;; puts them at 4 — the rule everywhere is that a line introduces at most one
        ;; level however many delimiters it opens. Blocks are exempt: a `do` block and
        ;; the `def` around it legitimately share a line and legitimately nest.
        keys (seq/distinct
               (map openers
                 (fn (node)
                   (if (contains? blocks (get node :kind))
                     ;; keyed by identity, so every block still counts
                     [(get node :kind) (get node :start)]
                     ;; keyed by LINE, so co-opening brackets collapse
                     [:bracket (ts-line-start text (get node :start))]))))
        n (count keys)
        ;; how many of those levels a closing delimiter could be leaving
        brackets-counted (count (seq/filter keys (fn (k) (= (first k) :bracket)))))
    (cond
      ;; content, not code: the line keeps its own indentation (a blank one continues the
      ;; content's) — checked before `broken`, since a heredoc stays one while code above
      ;; it is half-typed
      inside-verbatim
        (if (= (string/trim line) "")
          (let (previous (ts-prev-nonblank text bol))
            (if (nil? previous) 0 (first previous)))
          (ts-leading-columns line))
      ;; No tree can say what is open while the text does not parse — an unterminated
      ;; `do` collapses into an error node rather than staying open — which is the
      ;; ordinary state of a line someone is still typing. Carry the previous non-blank
      ;; line's own indentation, one level deeper when that line OPENS something, which
      ;; is what every editor does and the only thing available here.
      broken
        (let (previous (ts-prev-nonblank text bol))
          (if (nil? previous)
            0
            (let ([indent last-token] previous
                  opened (contains? (get spec :opens #{}) last-token))
              (math/max 0
                (+ indent
                  (if opened width 0)
                  (if closing
                    (- (* width (ts-dedent-levels spec closing-token brackets-counted)))
                    0))))))
      else
        (or (ts-comment-column text lang bol chain spec tree)
          (ts-align-column text bol chain (get spec :brackets #{}))
          (* width
            (math/max 0 (if closing (- n (ts-dedent-levels spec closing-token brackets-counted)) n)))))))

;; ---- structural navigation --------------------------------------------------
;; The sexp module's `narrow` optimisation keys off column-0 brackets (a Lisp
;; convention), so these motions read the whole-buffer tree directly instead — a
;; motion fires once per chord, and tree-sitter parsing is C-fast. A container is
;; any node with `:kids`; a "form" is a NAMED node (anonymous tokens — keywords,
;; punctuation — are skipped, like sexp skips whitespace/comments).
(defn- ts-container? (node) (get node :kids))

(defn- ts-enclosing (node point)
  "The deepest container node strictly containing `point`; `node` if none."
  (let (hit (seq/find (or (get node :kids) [])
              (fn (k)
                (and (ts-container? k)
                  (< (get k :start) point)
                  (< point (get k :end))))))
    (if (nil? hit) node (ts-enclosing hit point))))

;; Each motion is one positional query: `%tree-sitter-kids` hands over exactly the list of
;; siblings, so motion cost does not grow with the file as projecting the whole tree would.

(defdyn editor/treesit/*comment-kinds*
  ;; Node kinds that a structural motion steps OVER rather than stopping at. A comment is
  ;; not a form: Emacs gives comments whitespace syntax, so `forward-sexp` skips them,
  ;; and a tree-sitter tree makes them ordinary named nodes — so `C-M-f` from a comment
  ;; landed at the comment's end and `C-M-b` from a definition landed on the comment
  ;; above it, neither of which is a structural move.
  ;;
  ;; The names are a convention across grammars rather than a rule, so this is a dynvar:
  ;; a grammar spelling comments otherwise is one `defdyn` away, not a patch.
  #{:comment :line_comment :block_comment :comment_block})

(defn- ts-siblings (text lang point tree)
  "The named children of the node strictly containing `point` — the siblings a motion
steps through, comments excluded (see [[editor/treesit/*comment-kinds*]])."
  (seq/filter (ts-kids-at text lang point tree)
    (fn (n) (not (contains? editor/treesit/*comment-kinds* (get n :kind))))))

;; A node's offsets are ints by construction (the kernel writes them), but a `get` on a map
;; says `any`, and `(inc any)` is `number` — which the int-taking motions then refuse under
;; the strict gate. The node's shape states the invariant once, and the two accessors are
;; verified against it rather than trusted.
(deftype ts-node (record &open :kind keyword :start int :end int))
(defn- ts-start (node:ts-node -> int) (get node :start))
(defn- ts-end (node:ts-node -> int) (get node :end))

(defn point-forward (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "End of the next named node at or after `point` within the enclosing node;
unchanged if none (the Emacs `forward-sexp`, over a tree-sitter tree).

Every `point-*` motion and `indent-column` take an optional last `tree`: the held tree of
exactly `text` (`open-tree` / `update-tree`), read instead of parsing `text`; a gone handle
falls back to the text. `text` may be a string or the rope an editor holds (ADR-483): with a
held tree a rope is read only where the query needs a character, never copied whole.

    (editor/treesit/point-forward \"foo(1, 2)\" :elixir 0)   ;~> 9 — with the :elixir grammar installed"
  (let (nxt (seq/find (ts-siblings text lang point tree) (fn (f) (>= (get f :start) point))))
    (if (nil? nxt) point (get nxt :end))))

(defn point-backward (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "Start of the previous named node ending at or before `point` (`backward-sexp`).

    (editor/treesit/point-backward \"foo(1, 2)\" :elixir 9)   ;~> 0 — with the :elixir grammar installed"
  (let (prev (last (seq/filter (ts-siblings text lang point tree) (fn (f) (<= (get f :end) point)))))
    (if (nil? prev) point (get prev :start))))

(defn point-list-forward (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "End of the next child CONTAINER at or after `point` — leaf nodes are stepped over, not
stopped at (Emacs `forward-list`); unchanged if none.

    (editor/treesit/point-list-forward src :elixir 0)   ;~> …the end of the next container…"
  (let (nxt (seq/find (ts-siblings text lang point tree)
              (fn (f) (and (get f :container) (>= (get f :start) point)))))
    (if (nil? nxt) point (get nxt :end))))

(defn point-list-backward
  (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "Start of the previous child CONTAINER ending at or before `point` — leaves stepped over
(Emacs `backward-list`); unchanged if none.

    (editor/treesit/point-list-backward src :elixir 40)   ;~> …the start of the previous container…"
  (let (prev (last (seq/filter (ts-siblings text lang point tree)
                     (fn (f) (and (get f :container) (<= (get f :end) point))))))
    (if (nil? prev) point (get prev :start))))

(defn- ts-enclosing-node (text lang point tree)
  "The deepest node STRICTLY containing `point`, or nil at the top level — the last
container on the chain that neither begins nor ends at `point` itself."
  (last (seq/filter (ts-chain-at text lang point tree)
          (fn (n) (and (get n :container) (< (get n :start) point) (< point (get n :end)))))))

(defn point-up (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "Start of the enclosing node (`backward-up-list`); unchanged at top level.

    (editor/treesit/point-up src :elixir 30)   ;~> …the start of the node enclosing offset 30…"
  (let (enc (ts-enclosing-node text lang point tree))
    (if (nil? enc) point (get enc :start))))

(defn point-up-forward (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "End of the enclosing node — the forward counterpart of `point-up` (Emacs `up-list`);
unchanged at top level.

    (editor/treesit/point-up-forward src :elixir 30)   ;~> …the end of the node enclosing offset 30…"
  (let (enc (ts-enclosing-node text lang point tree))
    (if (nil? enc) point (get enc :end))))

(defn point-down (text: (or string rope) lang:keyword point:any &optional (tree nil) -> any)
  "INSIDE the next child container at or after `point` (`down-list`); unchanged if none.

Emacs' `down-list` moves *into* one level (`|(a b)` → `(|a b)`). A tree has no delimiter
to step over, so \"inside\" is that container's first child lying ahead of point — not its
own start, which is usually where point already is (a container and its opening token
begin together: `defmodule` is its own call's first named child, both at the same
offset), and a motion that cannot move is worse than one that overshoots."
  (let (lst (seq/find (ts-siblings text lang point tree)
              (fn (f) (and (get f :container) (>= (get f :start) point)))))
    (if (nil? lst)
      point
      (let (inner (seq/find (ts-siblings text lang (inc (ts-start lst)) tree)
                    (fn (k) (> (get k :start) point))))
        (cond
          inner (get inner :start)
          (> (get lst :start) point) (get lst :start)
          else point)))))

;; ---- what a definition is, per language ----------------------------------------
;; Which nodes are DEFINITIONS is the one thing `beginning-of-defun` cannot read off a tree,
;; and it is a fact about one grammar: Ruby says `method`, Python `function_definition`,
;; Rust `function_item`, and Elixir says nothing at all — its `def` is a `call`. It used to
;; be one private list holding every grammar's names at once, so a language the list had
;; not heard of (Rust, at the time) got no definitions: C-M-a inside an `impl` jumped to the
;; edge of the whole `impl`, and the only fix was an edit to std. Now a language declares
;; its own, beside the rest of its mode, and an undeclared one falls back to the top-level
;; form — the honest answer when nothing says what a definition is.

(defn register-definitions (lang:keyword definitions:map -> map)
  "Declare what a definition is in tree-sitter language `lang`, for `point-defun-start` /
`point-defun-end`: `{:kinds #{node-kind …} :calls #{callee …}}`. `:kinds` names the node
kinds that are themselves definitions; `:calls` the callees whose `call` node defines
(Elixir's `def`, `defmodule`, … are calls, not node kinds). Replaces any earlier
declaration for `lang`; returns `definitions`.

    (editor/treesit/register-definitions :doc-lang {:kinds #{:fn_item}})   ;=> {:kinds #{:fn_item}}"
  (registry/put :treesit/definitions lang definitions))

(defn definitions (lang:keyword -> map)
  "What `lang` declared a definition to be (`register-definitions`), or `{}`.

    (contains? (get (editor/treesit/definitions :ruby) :kinds) :method)   ;=> true"
  (let (declared (registry/lookup :treesit/definitions lang))
    (if (map? declared) declared {})))

;; The two grammars this runtime can be built with. A grammar loaded at runtime declares
;; its own, from the editor's language definition.
(register-definitions :ruby {:kinds #{:method :singleton_method :class :module}})
(register-definitions :elixir
  {:calls #{"def" "defp" "defmacro" "defmacrop" "defmodule" "defprotocol" "defimpl"}})

(defn- ts-head-word (text node)
  "The identifier a node BEGINS with, read from the source. A chain node carries no
children, so an Elixir `call`'s callee is taken lexically from its start rather than from
a first child — which is the same token either way, and does not require the tree."
  (let (from (ts-start node)
        head (ts-slice text from (math/min (ts-end node) (+ from 32)))
        limit (string/length head))
    (letrec (scan (fn (i)
                    (if (or (>= i limit)
                          (not (regex/matches? "[A-Za-z0-9_?!]" (string/char-at head i))))
                      (string/substring head 0 i)
                      (scan (inc i)))))
      (scan 0))))

(defn- ts-defun? (text definitions node)
  "Whether `node` is a definition for `beginning-of-defun`, as the language's `definitions`
say: a node of a definition KIND (Ruby `method`, Rust `function_item`, …) or a `call`
whose callee is a defining one (Elixir, where `def`/`defmodule`/… are calls)."
  (let (k (get node :kind))
    (or (contains? (get definitions :kinds #{}) k)
      (and (= k :call) (contains? (get definitions :calls #{}) (ts-head-word text node))))))

(defn- ts-defun-edge (text: (or string rope) lang:keyword point:any edge:any tree:any -> any)
  "The `edge` (`:start` / `:end`) of the enclosing **definition**: the deepest `def` /
`class` / `module` / … containing `point`, falling back to the top-level form, then `point`.
The shared body of `point-defun-start` / `point-defun-end`."
  (let (chain (seq/filter (ts-chain-at text lang point tree)
                (fn (n) (and (get n :container) (< (get n :start) point) (< point (get n :end)))))
        definitions (definitions lang)
        defuns (seq/filter chain (fn (n) (ts-defun? text definitions n))))
    (cond
      (not (empty? defuns)) (get (last defuns) edge)
      (not (empty? chain)) (get (first chain) edge)
      else point)))

(defn point-defun-start (text lang point &optional (tree nil))
  "Start of the enclosing **definition** (`beginning-of-defun`): the deepest `def` / `class`
/ `module` / … containing `point` — so a `def` inside an Elixir `defmodule` or a Ruby `class`,
not the whole enclosing module. Falls back to the top-level form, then `point`.

    (editor/treesit/point-defun-start src :elixir 30)   ;~> …the offset of the enclosing `def`…"
  (ts-defun-edge text lang point :start tree))

(defn point-defun-end (text lang point &optional (tree nil))
  "End of the enclosing **definition** (`end-of-defun`, C-M-e) — the close of the same node
`point-defun-start` finds, so the pair brackets one `def` / `class` / `module`.

    (editor/treesit/point-defun-end src :elixir 30)   ;~> …the offset just past the enclosing def's `end`…"
  (ts-defun-edge text lang point :end tree))

;; ---- the grammars this runtime has -------------------------------------------------
;; Asked of the runtime. Fetching and building one is `editor/grammar-install`.

(defn languages (-> vector)
  "The languages this runtime can parse right now — grammars loaded at runtime and built
in — as a sorted vector of keywords. What to ask before offering to fetch a grammar, or
telling someone a file's mode has none.

    (vector? (editor/treesit/languages))   ;=> true"
  (%tree-sitter-languages))

(defn declare-grammar (path:string lang:keyword -> bool)
  "Say that `lang`'s grammar is the library at `path` without loading it (ADR-481): the
first parse, query or tree that names `lang` loads it, once. Declaring costs a table entry,
so an application declares every grammar it has at startup and pays a dlopen only for the
languages its files use — rather than loading them all before its first frame, or loading
them later and leaving a file opened in between uncoloured. Declaring a language that is
already loaded reloads it from `path` at its next use: replace the library, declare it
again. A load that fails is reported by `grammar-status` and not retried until the next
declaration.

    (editor/treesit/declare-grammar \"/nonexistent/libtree-sitter-docexample.so\" :docexample)   ;=> true"
  (%tree-sitter-declare-grammar path lang))

(defn grammar-status (lang:keyword)
  "Where `lang`'s grammar stands, loading nothing: `:declared` (declared, not used yet),
`:loaded`, `:built-in`, a failure carrying the load's message when the last declaration
did not load, `{:quarantined reason :library :sha256 :by}` when the declared library is
quarantined (it crashed or hung a vetting child, or crashed a runtime — ADR-660, see
`vet-grammar`), or nil when the runtime has no grammar for it. What a grammar list shows
without opening every library to ask.

    (editor/treesit/grammar-status :no-grammar-has-this-name)   ;=> nil"
  (%tree-sitter-grammar-status lang))

;; ---- a grammar library vetted before this process loads it (ADR-660) -----------------
;; A grammar is native code: one that crashes takes the process with it. The runtime vets a
;; library in a CHILD before its first load (a crash there is a verdict, not a lost editor),
;; keeps the verdict by the library's hash, refuses a quarantined one, and names the grammar
;; in the crash record should one crash a runtime anyway — which quarantines it too.

(defn vet-grammar (path:string lang:keyword &optional (options nil) -> map)
  "Vet the grammar library at `path` as `lang`'s in a child runtime, loading nothing here:
the child parses `options`' `:corpus` (strings — `editor/grammar-install/grammar-corpus` reads
a grammar's own test corpus) and inputs made to reach a scanner's corners. The verdict:
`{:verdict :passed|:quarantined|:refused|:unvetted :reason :lang :library :sha256 :time
:inputs :cached}` — `:quarantined` when the child crashed, failed or went quiet for
`:timeout-ms` (10000), and every later load of these bytes is refused; `:passed` likewise
kept, so it is vetted once; `:refused` when it does not load at all (no entry point, an ABI
out of range); `:unvetted` when no child could run. A kept verdict comes back `:cached
true` unless `:force`. A load vets on its own (without a corpus) when there is no verdict;
call this after an install to vet with one, off any loop that must stay responsive.

    (try (editor/treesit/vet-grammar \"/nonexistent/libtree-sitter-x.so\" :x) (catch _ :none))   ;=> :none"
  (%tree-sitter-vet-grammar path lang options))

(defn declared-grammars (-> map)
  "Every grammar declared (`declare-grammar`) and not loaded yet, as `{lang path}`; a
declaration whose load failed is left out. Loads nothing.

    (map? (editor/treesit/declared-grammars))   ;=> true"
  (%tree-sitter-declared-grammars))

(defn vet-declared-grammars (&optional (options nil) -> map)
  "Vet every grammar declared and not loaded yet (`declared-grammars`) that has no verdict,
one after another, and answer `{lang verdict}` (`vet-grammar`'s verdict, `:cached true` for
one kept already). Blocks while each child runs, so call it OFF any loop that must stay
responsive — in a spawned process at startup — and the first parse of each language finds its
verdict waiting instead of starting a child (ADR-672). A parse that needs a language while it
is being vetted here waits for this vetting rather than starting a second. `options` go to
`vet-grammar` (`:timeout-ms`). A library that cannot be read answers its error as a failure.

    (map? (editor/treesit/vet-declared-grammars))   ;=> true"
  (into {}
    (map (declared-grammars)
      (fn ([lang path])
        [lang
          (check-allow :discarded-catch
            (try
              (vet-grammar path lang options)
              (catch e (failure (error-message e)))))]))))

(defn grammar-verdict (path:string)
  "The verdict kept on the grammar library at `path` as its bytes are now (see
`vet-grammar`; a quarantine a crashed runtime wrote has `:by :crash`, its `:signal` and
`:pid`), or nil when it was never vetted. Loads nothing.

    (editor/treesit/grammar-verdict \"/nonexistent/libtree-sitter-x.so\")   ;=> nil"
  (%tree-sitter-grammar-verdict path))

(defn forget-grammar-verdict (path:string -> bool)
  "Drop the verdict kept on the grammar library at `path`, so its next load vets it again
— the way to give a quarantined library another chance. A reinstalled library has new bytes
and no verdict, and needs none of this. True when there was one.

    (editor/treesit/forget-grammar-verdict \"/nonexistent/libtree-sitter-x.so\")   ;=> false"
  (%tree-sitter-forget-grammar-verdict path))

(defn grammar-info (lang:keyword -> map)
  "What the grammar `lang` parses with contains (ADR-583): `{:lang :abi :version :name
:source :loaded-via :named :anonymous :fields}` — its visible node kinds (`:named`,
`:anonymous`) and field names (`:fields`) as keyword sets, its tree-sitter ABI, its own version
and name (nil before ABI 15, which did not record them), the library it came from (`:source`,
or `:built-in`) and how that was opened (`:loaded-via`: `:beside` or `:cache`, a copy named for
its content, so a library rebuilt in place loads as the new build; `:in-place` when no copy
could be made, and a rebuilt library may then stay the old one until a restart). Loads a declared grammar, as its first parse would; raises when the runtime
has none for `lang`. What `grammar-problems` checks a language's tables against.

    (try (editor/treesit/grammar-info :no-grammar-has-this-name) (catch _ :none))   ;=> :none"
  (%tree-sitter-grammar-info lang))

(defn grammar-fingerprint (info:map -> string)
  "A hash of the grammar `info` (`grammar-info`) by its SHAPE: its ABI, node kinds and field
names, sorted. Two builds of one revision agree; a revision that renamed, added or removed a
node does not — while a rebuild by another compiler, which changes the library's bytes and
nothing a language can see, keeps it. The identity worth comparing when the question is
\"will my tables still fit\".

    (string/length (editor/treesit/grammar-fingerprint {:abi 14 :named #{:a} :anonymous #{} :fields #{}}))   ;=> 64"
  (let (names (fn (key prefix)
                (map (seq/sort-by (or (get info key) #{}) ->string)
                  (fn (name) (str prefix (->string name))))))
    (hash/sha256 (string/join (append [(str "abi " (get info :abi))]
                                (names :named "named ")
                                (names :anonymous "anonymous ")
                                (names :fields "field "))
                   "\n"))))
