;; std/editor/treesit.blsp — generic services for tree-sitter language modes.
;;
;; `tree-sitter-parse` (the Rust builtin, feature "treesit") yields a positioned
;; CST in the SAME node shape Brood's own reader gives — `{:kind :start :end
;; :named}` per node, `:text` on leaves, `:kids` on nodes with children, half-open
;; CHARACTER offsets. This module is the language-agnostic policy over that shape:
;;
;;  - `fontify` — a `:fontify` service: walk the tree and emit `[start end face]`
;;    colour spans, colouring a whole node (and not descending) when a per-language
;;    kind→face table assigns it one — tree-sitter highlight semantics, so a
;;    `(string)`/`(comment)` span covers its delimiters and content as one.
;;  - `point-forward` / `-backward` / `-list-forward` / `-list-backward` / `-up` /
;;    `-up-forward` / `-down` / `-defun-start` / `-defun-end` — pure
;;    `(text lang point) -> point` structural motions, the foreign-language
;;    analogue of `std/tool/sexp`'s, navigating named nodes of the tree. The
;;    `-list-*` pair stops only at containers, so it steps over leaf siblings.
;;
;; Mechanism is the builtin; the per-language kind→face tables and keymaps are
;; policy in the editor's modes (`src/modes.blsp`). A new tree-sitter language is a
;; grammar crate (Brood `Cargo.toml`) + a face table + a layer — no code here.
;; Framework tier, pure, zero kernel surface beyond the parse builtin (§C).

(defmodule editor/treesit
  "Generic tree-sitter language services over `tree-sitter-parse`'s positioned
CST (`{:kind :start :end :named :kids/:text}`): `(fontify text lang face-of)` →
`[start end face]` spans, and pure structural motions `(text lang point) ->
point` — `point-forward` / `point-backward` (every named node),
`point-list-forward` / `point-list-backward` (containers only),
`point-up` / `point-up-forward` / `point-down`, and `point-defun-start` /
`point-defun-end`. `face-of` is built with `(face-of-kinds {kind face-name})`.
Per-language face tables + keymaps are policy in the editor. `(require
'editor/treesit)`."
  (:use editor/face))

;; ---- fontify ----------------------------------------------------------------

(defn face-of-kinds (kind->face-name)
  "A node→face function for `fontify` from a map of `{:node-kind :syntax/face-name}`:
the node's `:kind` looked up in the map and resolved live with `(face …)`, or nil
when the kind isn't coloured (so `fontify` descends into its children)."
  (fn (node)
    (let (name (get kind->face-name (get node :kind)))
      (if (nil? name) nil (face name)))))

(defn- ts-alpha? (c)
  "True if the 1-char string `c` is a letter. Brood's `<`/`<=` are numeric-only, so
test by case-folding: a letter changes between upper- and lower-case, punctuation
and digits don't."
  (not (= (string/upper c) (string/lower c))))

(defn anonymous-keyword? (node)
  "True for an anonymous token whose text is alphabetic — a language keyword
(`def`/`end`/`do`/`if`/`fn`/`class`…). The cheap, cross-language way to colour
keywords without enumerating every grammar's keyword set: keywords surface as
anonymous tokens, operators/punctuation as anonymous non-alphabetic ones."
  (and (not (get node :named))
    (let (t (get node :text))
      (and (not (nil? t)) (> (string/length t) 0) (ts-alpha? (string/char-at t 0))))))

(defn face-of-syntax (kind->face-name)
  "Like `face-of-kinds`, plus the cross-language rule that an anonymous alphabetic
token (`anonymous-keyword?`) is a `:syntax/keyword`. Most language tables need
only name the handful of *named* nodes they colour (string/comment/number/…) and
get keywords for free. The face is resolved live, so a `(face-set :syntax/…)`
restyles the editor on its next frame."
  (fn (node)
    (let (name (or (get kind->face-name (get node :kind))
                 (if (anonymous-keyword? node) :syntax/keyword nil)))
      (if (nil? name) nil (face name)))))

(defn- ts-spans-into (node face-of acc)
  ;; Depth-first, newest-first onto `acc` — see [[ts-spans]] for why it is not `mapcat`.
  (let (fc (face-of node))
    (if fc
      (cons [(get node :start) (get node :end) fc] acc)
      (fold (or (get node :kids) []) acc (fn (a c) (ts-spans-into c face-of a))))))

(defn- ts-spans (node face-of)
  "Depth-first `[start end face]` spans (ascending — children are in source order).
When `face-of` gives a node a face, colour the WHOLE node and stop; else descend.

ONE accumulator, reversed once at the end. Written as a `mapcat` per level — which reads
better — every node's spans are rebuilt into a fresh list once for each ancestor it has, so
the cost is O(nodes × depth) allocation for a walk that is O(nodes) of actual work. On a
241-line Elixir window (1866 CST nodes, the size an editor fontifies per keystroke) that was
10.5 ms against 6.8 ms here, and it is the dominant half of the whole fontify — four times
the tree-sitter parse it walks."
  (reverse (ts-spans-into node face-of '())))

(defn fontify (text lang face-of)
  "A `:fontify` service: `[start end face]` colour spans for `text` parsed as the
tree-sitter language keyword `lang` (`:ruby`/`:elixir`), with `face-of` a node→face
function (build one with `face-of-kinds`). A mode wraps this in its own 1-arg
`(text)` service closing over its `lang` and table."
  (ts-spans (%tree-sitter-parse text lang) face-of))
(sig fontify (string keyword any -> any))

;; ---- where a windowed fontify may restart -------------------------------------

(defn- ts-col0? (src i)
  ;; A line beginning with something other than whitespace. `i` may sit one past the end —
  ;; a window whose last line has no newline, or an empty buffer — and `string/char-at`
  ;; raises there rather than answering nil, so the bound is checked here.
  (and (< i (string/length src))
    (let (c (string/char-at src i))
      (and (not (= c " ")) (not (= c "\t")) (not (= c "\n")) (not (= c "\r"))))))

(defn- ts-back-to-col0 (src at)
  (let (nl (string/last-index-of src "\n" at))
    (if (< nl 0) 0 (if (ts-col0? src (inc nl)) (inc nl) (ts-back-to-col0 src nl)))))

(defn- ts-count-upto (src needle upto acc from)
  (let (i (index-of src needle from))
    (if (or (< i 0) (>= i upto))
      acc
      (ts-count-upto src needle upto (inc acc) (+ i (string/length needle))))))
;; Declared because the body is SELF-RECURSIVE, and the checker deliberately does not
;; specialize those (it would type an accumulator loop from its first base case). Undeclared,
;; the count read `number`, and `column0-restart`'s `(math/rem opened 2)` — which wants an
;; int — was a strict-gate warning. A counter is an int; saying so is one line.
(sig ts-count-upto (string string int int int -> int))

(defn column0-before (src pos)
  "The offset of the nearest line at or before `pos` that begins in column 0 with something
other than whitespace, or 0 when there is none — the CANDIDATE restart point, ungurded.

Separate from [[column0-restart]] because the guard is the language-specific half. Elixir can
decide safety by counting paired heredoc markers, which is what `column0-restart` does; Ruby
cannot (its `<<~EOS` terminator is arbitrary text) and needs to scan for its own openers. Both
want the same candidate, and neither should re-derive it."
  ;; `pos` is a line start when `ed-window-src` calls this, but normalising to one anyway
  ;; makes the answer total: an offset in the middle of a line asks about that line, and the
  ;; result is always a line start, never an offset into one.
  (let (line-start (let (nl (string/last-index-of src "\n" pos)) (if (< nl 0) 0 (inc nl))))
    (if (ts-col0? src line-start) line-start (ts-back-to-col0 src line-start))))

(defn column0-restart (src pos delimiters)
  "A `:fontify-restart` answer for a tree-sitter mode: the offset of the nearest line at or
before `pos` beginning in column 0, or 0 when that line cannot be shown to lie outside a
multi-line string.

**Why a mode wants one.** An editor fontifies a WINDOW — the viewport plus a lead-in, so a
construct opening above the screen is still in scope. A mode with no restart parses that
lead-in in full on every keystroke: 245 lines for a 44-row viewport, five times more text
than is on screen (18 ms of a 25 ms keystroke, measured in bedit on a 10k-line Elixir file).
A restart says where the lead-in may be cut, and for a language whose top-level constructs
begin in column 0 — Elixir, Ruby, Python, Go, Rust — the previous such line is that place.

**Why the guard.** A column-0 line INSIDE a heredoc is not a restart point: parse from there
and the prose of an `@moduledoc` colours as code. So a candidate is accepted only when the
number of `delimiters` occurrences before it is EVEN — every multi-line string opened in this
window is also closed above the candidate. `delimiters` is a vector of the language's PAIRED
multi-line string markers (Elixir's triple-quote and triple-apostrophe). A language whose
heredocs have no paired marker — Ruby's `<<~EOS`, whose terminator is arbitrary text — has
nothing to count, and should keep the lead-in rather than pass a list that cannot decide.

**What it does not fix.** A construct opening ABOVE the window is invisible to this guard —
and to the lead-in it replaces. Both mis-colour there, identically. That is the ceiling of
any windowed fontify rather than of this rule: measured against a whole-file parse, the
restart is never wrong where the lead-in is right, and is right everywhere the lead-in is."
  (let (candidate (column0-before src pos)
        opened (fold delimiters 0 (fn (n d) (+ n (ts-count-upto src d candidate 0 0)))))
    (if (= 0 (math/rem opened 2)) candidate 0)))

;; ---- indentation -------------------------------------------------------------
;; ---- indentation -------------------------------------------------------------
;; The `:indent` service's other half. Brood indents by parsing `[defun-start, bol)` and
;; asking what is still OPEN — the reader leaves an unclosed form as an unclosed node. That
;; trick does not transfer: tree-sitter's error recovery collapses an unterminated `do` into
;; an ERROR node rather than an open block, so a truncated slice reports `:ERROR` for nearly
;; every line and knows nothing about the nesting (measured on Elixir: 7 of 9 lines).
;;
;; So the slice has to be text that PARSES, and the level is how many block nodes enclose the
;; line inside it. Which slice, though, has no single answer, so [[indent-column]] takes two
;; and keeps the deeper: the enclosing top-level form by the column-0 convention (cheap, and
;; right for a file that is already indented), and a fixed window either side (right for a
;; flush-left file, where the column-0 convention degenerates to "the previous line"). A
;; slice that begins inside a form can only ever lose enclosing blocks, never invent them, so
;; between two clean readings the deeper one is the better-informed one — and a slice that
;; did not parse is not a reading at all. When neither parses, which is the ordinary state of
;; a line someone is still typing, [[indent-column]] falls back to the previous non-blank
;; line's own indentation plus a level when that line ends in an opening token.

(def *indent-window* 40000)
;; How far the indenter reads around the line when the column-0 convention fails it (~800
;; lines). Bounded so one keypress cannot become a whole-buffer parse on a large file; a
;; top-level form longer than this is past the point where its indentation is the reader's
;; problem.

(defn- ts-broken? (node)
  ;; Does this tree contain a parse error anywhere? tree-sitter marks its recovery with
  ;; `:error` and `:missing`, and either means the text does not stand on its own — the
  ;; ordinary state of a buffer someone is typing into, and the state in which no tree can
  ;; say what is open, because an unterminated `do` collapses rather than staying open. That
  ;; is why `indent-column` has a second answer at all.
  (or (get node :error)
    (get node :missing)
    (any? (or (get node :kids) []) ts-broken?)))

(defn- ts-prev-nonblank (text bol)
  ;; `[indent last-token]` of the nearest non-blank line before `bol`, or nil when there is
  ;; none — what the indenter carries when no tree can answer.
  (if (<= bol 0)
    nil
    (let (nl (string/last-index-of text "\n" bol)
          ls (if (< nl 0) 0 (let (p (string/last-index-of text "\n" nl)) (if (< p 0) 0 (inc p))))
          le (if (< nl 0) (math/max 0 (dec bol)) nl)
          l (string/substring text ls le))
      (cond
        (and (< nl 0) (= (string/trim l) "")) nil
        (= (string/trim l) "") (ts-prev-nonblank text ls)
        else
          [(- (string/length l) (string/length (string/triml l)))
            (or (last (string/split (string/trim l) " ")) "")]))))
(sig ts-prev-nonblank (string int -> (or nil (tuple int string))))

(defn- ts-chain (node p acc)
  ;; the kinds of every node containing offset `p`, outermost first
  (let (hit (seq/find (or (get node :kids) [])
              (fn (k) (and (<= (get k :start) p) (< p (get k :end))))))
    (if (nil? hit)
      (reverse (cons (get node :kind) acc))
      (ts-chain hit p (cons (get node :kind) acc)))))

(defn- ts-first-token (line)
  ;; the first whitespace-delimited word of `line`, or ""
  (let (t (string/triml line)) (or (first (string/split t " ")) "")))

(defn indent-column (text lang bol spec)
  "The column the line beginning at offset `bol` should be indented to — a `:indent` service
for a tree-sitter mode, given a per-language `spec`.

    {:width 2                        ; columns per level
     :blocks #{:do_block :body}      ; node kinds that open one
     :dedent #{\"end\" \"else\"}         ; line-leading tokens that close one
     :dedent-levels 1}               ; how many the closing token backs out of

**Mechanism here, kinds there.** Which node opens a level is the one thing only the language
knows, and it is a set of names — so a language's whole indent policy is four entries, and
this walks the tree. The nesting level is the number of enclosing `:blocks` nodes.

**Where a line is measured from is the subtle part.** An ordinary line is measured at its
first non-blank character, because a block node may not begin until its first statement —
Ruby's `body_statement` starts at the `def` it contains, so measuring at the line START puts
you outside the very block you are in. A CLOSING line is measured at the line start instead,
because a closer sits outside what it closes; measuring `end` at the `end` would put it
inside the block again in some grammars and not others.

`:dedent-levels` is what remains of that difference, and it is per-language because the
grammars genuinely differ: Elixir's `do_block` spans its own `end`, so a closer measured at
the line start is still inside it and must back out one; Ruby's `body_statement` stops before
`end`, so the closer is already out and backs out none. Both are checked line-for-line
against real source.

Deliberately not a full indent engine: no alignment to an open bracket's column, no operator
continuation rules. It answers the shape that block-structured languages share, which is the
shape `nest format` answers for Brood, and it is checked line-for-line against real source in
`tests/treesit_module_test.blsp`."
  (let (width (get spec :width 2)
        eol (let (i (index-of text "\n" bol)) (if (< i 0) (string/length text) i))
        line (string/substring text bol eol)
        closing (contains? (get spec :dedent #{}) (ts-first-token line))
        ;; an ordinary line measures at its first non-blank, a closing line at the line start
        at (if closing bol (+ bol (- (string/length line) (string/length (string/triml line)))))
        blocks (get spec :blocks #{})
        ;; The level from ONE slice, or nil when that slice cannot answer — it did not parse,
        ;; so anything it says about nesting is a reading of recovered wreckage.
        level-in (fn (lo hi)
                   (let (slice (string/substring text lo hi)
                         tree (if (= (string/trim slice) "")
                                nil
                                (check-allow :discarded-catch
                                  (try (%tree-sitter-parse slice lang) (catch _ nil)))))
                     (when (and tree (not (ts-broken? tree)))
                       (let (n (count (filter (ts-chain tree (- at lo) '())
                                        (fn (k) (contains? blocks k)))))
                         (math/max 0 (if closing (- n (get spec :dedent-levels 1)) n))))))
        ;; Two readings, and the DEEPER one wins. The cheap slice is the enclosing top-level
        ;; form by the column-0 convention — right, and enough, for a file that is already
        ;; indented. In a FLUSH-LEFT file that convention says nothing: every line begins at
        ;; column 0, so the slice starts one line up, and the danger is not that it fails but
        ;; that it SUCCEEDS — `def run do / :ok / end` parses perfectly on its own and reports
        ;; one level where there are two. A slice beginning inside a form can only ever lose
        ;; enclosing blocks, never invent them, so between two clean readings the deeper one
        ;; is the better-informed one, and a reading that did not parse is no reading at all.
        narrow-lo (column0-before text (math/max 0 (dec bol)))
        readings (seq/keep [(level-in narrow-lo
                              (math/min (string/length text) (+ narrow-lo *indent-window*)))
                             (level-in (math/max 0 (- bol *indent-window*))
                               (math/min (string/length text) (+ bol *indent-window*)))]
                   (fn (x) x))
        structural (when (not (empty? readings)) (fold readings 0 math/max)))
    (if structural
      (* width structural)
      ;; The tree could not say. Carry the previous non-blank line's own indentation, one
      ;; level deeper when that line OPENS something — which is what every editor does while
      ;; you type, and the only thing available here: a half-written `do` is not an open block
      ;; in the tree, it is an error node, so there is no structure left to ask.
      (let (previous (ts-prev-nonblank text bol))
        (if (nil? previous)
          0
          (let ([indent last-token] previous
                opened (contains? (get spec :opens #{}) last-token))
            (math/max 0 (+ indent (if opened width 0) (if closing (- width) 0)))))))))
(sig indent-column (string any int countable -> number))

;; ---- structural navigation --------------------------------------------------
;; The sexp module's `narrow` optimisation keys off column-0 brackets (a Lisp
;; convention), so these motions read the whole-buffer tree directly instead — a
;; motion fires once per chord, and tree-sitter parsing is C-fast. A container is
;; any node with `:kids`; a "form" is a NAMED node (anonymous tokens — keywords,
;; punctuation — are skipped, like sexp skips whitespace/comments).
(defn- ts-container? (node) (get node :kids))

(defn- ts-named-kids (node)
  "The named children of `node` (grammar nodes, not anonymous tokens)."
  (filter (or (get node :kids) []) :named))

(defn- ts-enclosing (node point)
  "The deepest container node strictly containing `point`; `node` if none."
  (let (hit (seq/find (or (get node :kids) [])
              (fn (k)
                (and (ts-container? k)
                  (< (get k :start) point)
                  (< point (get k :end))))))
    (if (nil? hit) node (ts-enclosing hit point))))

(defn- ts-root? (node root)
  (and (= (get node :start) (get root :start)) (= (get node :end) (get root :end))))

(defn point-forward (text lang point)
  "End of the next named node at or after `point` within the enclosing node;
unchanged if none (the Emacs `forward-sexp`, over a tree-sitter tree)."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point)
        nxt (seq/find (ts-named-kids enc) (fn (f) (>= (get f :start) point))))
    (if (nil? nxt) point (get nxt :end))))
(sig point-forward (string keyword any -> any))

(defn point-backward (text lang point)
  "Start of the previous named node ending at or before `point` (`backward-sexp`)."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point)
        prev (last (filter (ts-named-kids enc) (fn (f) (<= (get f :end) point)))))
    (if (nil? prev) point (get prev :start))))
(sig point-backward (string keyword any -> any))

(defn point-list-forward (text lang point)
  "End of the next child CONTAINER at or after `point` — leaf nodes are stepped over, not
stopped at (Emacs `forward-list`); unchanged if none."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point)
        nxt (seq/find (ts-named-kids enc)
              (fn (f) (and (ts-container? f) (>= (get f :start) point)))))
    (if (nil? nxt) point (get nxt :end))))
(sig point-list-forward (string keyword any -> any))

(defn point-list-backward (text lang point)
  "Start of the previous child CONTAINER ending at or before `point` — leaves stepped over
(Emacs `backward-list`); unchanged if none."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point)
        prev (last (filter (ts-named-kids enc)
                     (fn (f) (and (ts-container? f) (<= (get f :end) point))))))
    (if (nil? prev) point (get prev :start))))
(sig point-list-backward (string keyword any -> any))

(defn point-up (text lang point)
  "Start of the enclosing node (`backward-up-list`); unchanged at top level."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point))
    (if (ts-root? enc root) point (get enc :start))))
(sig point-up (string keyword any -> any))

(defn point-up-forward (text lang point)
  "End of the enclosing node — the forward counterpart of `point-up` (Emacs `up-list`);
unchanged at top level."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point))
    (if (ts-root? enc root) point (get enc :end))))
(sig point-up-forward (string keyword any -> any))

(defn point-down (text lang point)
  "Start of the next child container at or after `point` (`down-list`); unchanged
if none."
  (let (root (%tree-sitter-parse text lang)
        enc (ts-enclosing root point)
        lst (seq/find (ts-named-kids enc)
              (fn (f) (and (ts-container? f) (>= (get f :start) point)))))
    (if (nil? lst) point (get lst :start))))
(sig point-down (string keyword any -> any))

;; check-allow: deliberately non-tail — depth = syntax-tree nesting at point.
(check-allow :non-tail-recursion
  (defn- ts-chain-rest (node point)
    "The containers strictly enclosing `point` below `node`, outermost first — each a
  container that contains the next. `()` at the leaf."
    (let (hit (seq/find (or (get node :kids) [])
                (fn (k)
                  (and (ts-container? k)
                    (< (get k :start) point)
                    (< point (get k :end))))))
      (if (nil? hit) () (cons hit (ts-chain-rest hit point))))))

(def- ts-def-kinds
  ;; node KINDS that are themselves definitions — most grammars (Ruby, …) name them
  ;; distinctly. Extend for a new language whose defs have their own node kind.
  (list "method" "singleton_method" "class" "module" "function_definition" "method_declaration"))

(def- ts-def-macros
  ;; Elixir defines via a `call` to one of these macros (the node kind is just `call`, so we
  ;; key off the callee text). Extend for a macro-defined construct in another grammar.
  (list "def" "defp" "defmacro" "defmacrop" "defmodule" "defprotocol" "defimpl"))

(defn- ts-defun? (text node)
  "Whether `node` is a definition for `beginning-of-defun`: a definition-*kind* node (Ruby
`method`/`class`/`module`, …) or a `call` whose callee text is a `def`-family macro (Elixir,
where `def`/`defmodule`/… are calls, not distinct node kinds)."
  (let (k (->string (get node :kind)))
    (or (includes? ts-def-kinds k)
      (and (= k "call")
        (let (head (first (ts-named-kids node)))
          (and (not (nil? head))
            (includes? ts-def-macros (string/substring text (get head :start) (get head :end)))))))))

(defn- ts-defun-edge (text lang point edge)
  "The `edge` (`:start` / `:end`) of the enclosing **definition**: the deepest `def` /
`class` / `module` / … containing `point`, falling back to the top-level form, then `point`.
The shared body of `point-defun-start` / `point-defun-end`."
  (let (root (%tree-sitter-parse text lang)
        chain (ts-chain-rest root point)
        defuns (filter chain (fn (n) (ts-defun? text n))))
    (cond
      (not (empty? defuns)) (get (last defuns) edge)
      (not (empty? chain)) (get (first chain) edge)
      else point)))
(sig ts-defun-edge (string keyword any any -> any))

(defn point-defun-start (text lang point)
  "Start of the enclosing **definition** (`beginning-of-defun`): the deepest `def` / `class`
/ `module` / … containing `point` — so a `def` inside an Elixir `defmodule` or a Ruby `class`,
not the whole enclosing module. Falls back to the top-level form, then `point`."
  (ts-defun-edge text lang point :start))
(sig point-defun-start (string keyword any -> any))

(defn point-defun-end (text lang point)
  "End of the enclosing **definition** (`end-of-defun`, C-M-e) — the close of the same node
`point-defun-start` finds, so the pair brackets one `def` / `class` / `module`."
  (ts-defun-edge text lang point :end))
(sig point-defun-end (string keyword any -> any))
