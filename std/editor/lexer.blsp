;; std/editor/lexer.blsp — a line-oriented lexer from a table of rules.
;;
;; A shell highlighter (bedit's `lex-shell` now) set the shape every lexical
;; (non-tree-sitter) language mode wants: per line, ONE `regex/tokens` scan over a table of rules — the structured tokens (comments,
;; strings, …) first and the word pattern as the last row, so a word inside a string is
;; never produced and a lookup classifies each one that is; on the bitset DFA, so the
;; per-character work is a memo lookup and never a capture thread (ADR-352). The next six formats an
;; editor needs (JSON, YAML, TOML, a Makefile, an INI / git config, a commit message)
;; are that shape with different tables, so the walker lives here once and a format is
;; DATA: a `lexer-grammar` map. Line-oriented: a token never crosses a line (a
;; multi-line string colours on its first line only — the trade dotenv, shell and
;; markdown all make), so a band re-lexes on every keystroke and `editor/highlight/line-restart`
;; is its restart rule: any line start is a safe one.
;;
;;     (def json-grammar
;;       (lexer-grammar
;;         {:structured [["\"(?:[^\"\\\\]|\\\\.)*\"" :string] ["-?\\d+(?:\\.\\d+)?" :number]]
;;          :words "[A-Za-z_]+"
;;          :classes {"true" :constant "false" :constant "null" :constant}}))
;;     (lexer-spans json-grammar src)      ; → ([start end face] …), the highlight-spans shape
;;
;; Faces are named by `:syntax/*` role (`:comment` `:string` `:doc` `:number` `:keyword`
;; `:symbol` `:constant` `:special` `:function` `:definition` `:punctuation`), resolved through `editor/face` once
;; per pass, so a theme restyles every table-driven mode with the rest.

(defmodule editor/lexer
  "A line-oriented lexer from a table of rules: `lexer-grammar` compiles a map of
`:structured` `[pattern role]` rules and an optional `:words` pattern with `:classes`
(word → role) into one `regex/tokens` scan (earliest position, first rule, the word rule
last), plus optional `:line` rules anchored at the line's start (`[prefix paint suffix
role]` on `regex/paint`, or `[pattern role]` painting a capture group); `(lexer-spans grammar src)` returns `[start end face]`
spans in the `highlight-spans` shape — what an editor's `:fontify` service is. Roles are
`:syntax/*` faces (`:comment` `:string` `:doc` `:number` `:keyword` `:symbol` `:constant`
`:special` `:function` `:definition` `:punctuation`), resolved per pass."
  (:use editor/face)
  ;; `editor/highlight` is where the `:syntax/*` faces are DECLARED (`def-face`), and
  ;; nothing on this module's own path loads it: from source every role resolved to nil
  ;; and every span came back unstyled (`configs_test` 2/10). The stdlib image hid it —
  ;; `editor/face`'s replayed registrations carry every face recorded at build time,
  ;; highlight's included — which is why a load-only clause, not a `:use`: the faces are
  ;; a dependency of the pass, and none of highlight's names are wanted here.
  (:load editor/highlight))

;; ---- the grammar ----------------------------------------------------------------

(def lexer-roles
  ;; role keyword → the `:syntax/*` face it resolves to
  {:comment :syntax/comment
   :string :syntax/string
   :doc :syntax/doc
   :number :syntax/number
   :keyword :syntax/keyword
   :symbol :syntax/symbol
   :constant :syntax/constant
   :special :syntax/special
   :function :syntax/function
   :definition :syntax/definition
   :punctuation :syntax/punctuation})

(defn lexer-grammar (spec:map -> map)
  "Compile `spec` into a grammar: `:structured` — a vector of `[pattern role]` rules,
scanned as one table by `regex/tokens` (at the earliest position any rule matches, the
first rule in table order wins with its longest match; a `\\b` may sit only at a rule's
edges); `:words` — a pattern for identifiers (default none) with `:classes`, a map
word → role; `:line` — rules tried at each line's START, each `[prefix paint suffix
role]` (three patterns: the paint's text between a prefix at the line's start and a
suffix after it is painted — `regex/paint`, on the DFA — so `[\"^\" \"\\\\w+\" \"=\" :keyword]`
paints a Makefile variable) or `[pattern role]` (the pattern's FIRST group, on the
capture engine). The result is what `lexer-spans` takes; the scanners are compiled once
here, not once per line."
  ;; one table: the structured rules, then the word rule as the LAST row — so a word
  ;; inside a string or a comment is never produced (the earlier rule took it), and a
  ;; line pays a single scan
  (let (structured (into [] (or (:structured spec) []))
        rules (if (nil? (:words spec)) structured (into structured [[(:words spec) :word]])))
    {:scanner (if (empty? rules) nil (regex/tokenizer rules))
     :classes (or (:classes spec) {})
     :line (or (:line spec) [])}))

(defn- lexer-faces ()
  "Every role's face, resolved once per pass."
  (fold (%map-pairs lexer-roles) {} (fn (acc [role name]) (assoc acc role (face name)))))

;; ---- one line ---------------------------------------------------------------------

(defn- lexer-tokens (grammar line faces)
  "The token spans of `line`, line-relative, ascending and non-overlapping: one
`regex/tokens` scan over the table. A structured token paints its rule's role; a word
paints the role `:classes` gives its text, or nothing."
  (if (nil? (:scanner grammar))
    '()
    (seq/keep (regex/tokens (:scanner grammar) line)
      (fn (t)
        (let (s (get t :start)
              e (get t :end)
              tag (get t :tag))
          (if (= tag :word)
            (let (role (get (:classes grammar) (get t :text)))
              (when role [s e (get faces role)]))
            ;; a rule may consume the separator that lets it match (`(?:^|\\s)#.*` — a
            ;; `#` that starts a word); the token itself never starts with whitespace
            [(lexer-skip-ws line s e) e (get faces tag)]))))))

(defn- lexer-skip-ws (line s e)
  "`s` advanced past the spaces and tabs before `e`."
  (math/min e (string/span line s " \t")))

(defn- lexer-line-rules (grammar line faces)
  "The spans of the `:line` rules that match at `line`'s start: a `[prefix paint suffix
role]` rule paints what `regex/paint` finds; a `[pattern role]` rule its pattern's first
group (the whole match when it has none)."
  (seq/keep (:line grammar)
    (fn (rule)
      (if (= (count rule) 4)
        (let ([prefix pattern suffix role] rule
              hit (regex/paint prefix pattern suffix line))
          (when hit (let ([s e] hit) [s e (get faces role)])))
        (let ([pattern role] rule
              m (regex/find pattern line))
          (if (or (nil? m) (not (= (get m :start) 0)))
            nil
            (let (g (first (or (get m :groups) [])))
              (if (nil? g)
                [(get m :start) (get m :end) (get faces role)]
                [(get g :start) (get g :end) (get faces role)]))))))))

(defn- lexer-merge (a b acc)
  "Merge two ascending span lists in reverse onto `acc`; a span inside an earlier one is
dropped, so the result stays non-overlapping."
  (cond
    (and (empty? a) (empty? b)) acc
    (or (empty? b) (and (not (empty? a)) (<= (first (first a)) (first (first b)))))
      (lexer-merge (rest a) b (lexer-push acc (first a)))
    else (lexer-merge a (rest b) (lexer-push acc (first b)))))

(defn- lexer-push (acc span)
  "`span` consed onto the reversed `acc` unless it starts inside the span before it."
  (if (and (not (empty? acc)) (< (first span) (second (first acc))))
    acc
    (cons span acc)))

(defn lexer-line-spans (grammar:map line:string base:int faces:map -> any)
  "The spans for one `line` at offset `base`, ascending and non-overlapping: the
tokens (structured and classified words, one scan) and the line rules, merged.

    (editor/lexer/lexer-line-spans (editor/lexer/lexer-grammar {:structured [[\"#.*\" :comment]]}) \"x # y\" 10 {:comment {:fg :grey}})   ;=> ([12 15 {:fg :grey}])"
  (let (tokens (lexer-tokens grammar line faces)
        rules (lexer-line-rules grammar line faces)
        merged (reverse (lexer-merge tokens rules '())))
    (map merged (fn ([s e f]) [(+ base s) (+ base e) f]))))

;; ---- the walk ---------------------------------------------------------------------

(defn- lexer-walk (src i n line-spans acc)
  "Tail-recursive line walker, accumulating each line's spans in reverse."
  (if (>= i n)
    (reverse acc)
    (let (e (math/min n (string/span-until src i "\n"))
          spans (line-spans (string/substring src i e) i))
      (lexer-walk src (inc e) n line-spans (fold spans acc (fn (a s) (cons s a)))))))

(defn lexer-walk-lines (src:string line-spans: (string int -> any) -> list)
  "Concatenate `(line-spans line base)` over each line of `src` — `line` without its
newline, `base` its character offset in `src`. The walk every line-oriented mode shares:
`line-spans` returns that line's `[start end face]` spans already offset by `base`, and
the result is the whole source's spans in order.

    (editor/lexer/lexer-walk-lines \"ab\\ncd\" (fn (line base) (list [base (+ base 1) :x])))   ;=> ([0 1 :x] [3 4 :x])"
  (lexer-walk src 0 (string/length src) line-spans '()))

(defn lexer-spans (grammar:map src:string -> any)
  "Lexically tokenize `src` with `grammar` (from `lexer-grammar`) into `[start end face]`
colour spans — character offsets, end-exclusive, ascending, non-overlapping — the
`highlight-spans` shape an editor's `:fontify` service returns.

    (map (editor/lexer/lexer-spans (editor/lexer/lexer-grammar {:structured [[\"#.*\" :comment]]}) \"x # y\") (fn ([s e _]) [s e]))   ;=> ([2 5])"
  (let (faces (lexer-faces))
    (lexer-walk-lines src (fn (line base) (lexer-line-spans grammar line base faces)))))

(defn lexer-line-lexer (grammar:map -> map)
  "`grammar` (from `lexer-grammar`) as a `stateless-lexer` for `editor/highlight`'s line
cache (ADR-471): a line's spans are its own — no token crosses a line — so the cache keeps
them as a memo on the line's text, and a pane lexes only the lines that changed. The faces
are resolved when this is built, so build it again (and start a fresh `line-cache`) when
the theme changes.

    (:stateless? (editor/lexer/lexer-line-lexer (editor/lexer/lexer-grammar {:structured [[\"#.*\" :comment]]})))   ;=> true"
  (let (faces (lexer-faces))
    (editor/highlight/stateless-lexer (fn (line) (lexer-line-spans grammar line 0 faces)))))
