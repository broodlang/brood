;; std/editor/buffer.blsp — the editor framework's buffer model.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - A BUFFER is an immutable value (a map) holding a rope plus cursor state.
;;    Every operation returns a *fresh* buffer (ADR-026) — nothing mutates. This
;;    is the pure, trivially-testable core of the editor toolkit (M2, ADR-045).
;;  - Text lives in a `rope` (the kernel's one editor primitive); all of the
;;    point / mark / region / movement *policy* here is pure Brood over it.
;;  - A buffer is process-local because its rope is: you never `send` a buffer
;;    (or its rope) across processes. `editor/buffer-server` makes a thin actor that
;;    OWNS one and replies only with *derived views* (text, lines, positions).
;;  - This module is NOT part of the language: it is opt-in (`require`), never in
;;    the prelude, and adds zero kernel surface — pure Brood over rope primitives.
;;
;; Char indices are 0-based, like the rope primitives. `point` is a char index in
;; [0, length]; `mark` is a char index or nil. Lines are 0-based; a line's text
;; (`buffer-line-at`) includes its trailing newline, matching `text/line`.

(defmodule editor/buffer
  "An immutable text buffer for building editors, written in Brood over the rope
primitives (ADR-045). A *buffer* is a **record** (so `buffer?` is an identity check, and
a buffer is never `=` to a look-alike map) whose fields are:

    {:rope <rope> :point <int> :mark <int|nil> :name <string> :file <string|nil>
     :undo (<snapshot>…) :pending-undo (<snapshot>…)}

Every operation is pure — movement and editing return a **fresh** buffer; nothing
mutates (ADR-026). `point` is the cursor (a char index); `mark`, with point,
delimits the region. Each editing op records the pre-edit state on `:undo` (a stack
of `{:rope :point :mark}` snapshots); undo is an Emacs-style *tree* (undoing is itself
recorded, so no state is ever lost) — see the undo section below.

    (def b (-> (make-buffer \"hello world\")
               (goto-char 5) (insert \",\") end-of-line))
    (buffer-text b)            ; => \"hello, world\"

Because a buffer holds a rope, and ropes are **process-local**, a buffer cannot
cross a process boundary: `editor/buffer-server` is the process that owns one."
  (:use map)
  (:use editor/span-properties))

;; ---- helpers ----------------------------------------------------------------

(defn- buffer-clamp (lo:int hi:int x:int -> int)
  "Clamp `x` into the inclusive range [lo, hi]."
  (math/max lo (math/min hi x)))

(defn- buffer-line-end-col (buf:any line:int -> int)
  "The column at the end of `line` — its length excluding any trailing newline.
Where `end-of-line` lands and the rightmost column point can hold on that line."
  (let (lt (text/line (get buf :rope) line))
    (if (string/ends-with? lt "\n") (dec (string/length lt)) (string/length lt))))

;; ---- construction -----------------------------------------------------------
;;
;; A buffer is a RECORD, so its type is its identity rather than "a map that happens to
;; hold a rope under `:rope`" — `buffer?` can't be fooled by a look-alike, a buffer never
;; compares `=` to a bare map, and it prints as `#<buffer …>` instead of dumping the whole
;; rope and undo history. Every op still `assoc`es (a record IS a map), and `assoc`
;; preserves the identity, so a buffer stays a buffer through the whole pipeline —
;; including the extra keys other layers stamp on (`:markers`, `:type`, `:layers`).
;;
;; The generated field accessors are re-defined below with docstrings.

(defrecord buffer
  ((rope rope) (point int)
    (mark (or int nil))
    (name string)
    (file (or string nil))
    (undo list)
    (pending-undo list)))

(defn make-buffer (text &optional (name "*scratch*") (file nil))
  "A fresh buffer holding `text`, with point at 0, no mark, and an empty undo history.
`name` is a label (default `\"*scratch*\"`); `file` is the backing path or nil. It starts
unmodified: `text` is its baseline (`buffer-modified?`).

    (editor/buffer/buffer-point (editor/buffer/make-buffer \"hi\"))   ;=> 0"
  (mark-buffer-saved (buffer (text/from-string text) 0 nil name file () ())))

(defn buffer? (x)
  "True if `x` is a buffer value — by record identity, not by shape.

    (editor/buffer/buffer? (editor/buffer/make-buffer \"x\"))   ;=> true
    (editor/buffer/buffer? {:rope nil :point 0})              ;=> false"
  (and (record? x) (= (record-id x) :editor/buffer/buffer)))

;; A buffer's display form is a short identification — never its text: a buffer can hold
;; a megabyte of rope plus an undo history, and `io/puts`ing that (or seeing it in an
;; error message) is never what was wanted. `inspect` adds point/mark for debugging.
(impl Display
  editor/buffer/buffer
  (->string (b) (str "#<buffer " (get b :name) " " (text/length (get b :rope)) " chars>")))

(impl Inspect
  editor/buffer/buffer
  (inspect (b)
    (str "#<buffer "
      (get b :name)
      " "
      (text/length (get b :rope))
      " chars"
      " point="
      (get b :point)
      (if (get b :mark) (str " mark=" (get b :mark)) "")
      (if (get b :file) (str " file=" (get b :file)) "")
      ">")))

;; ---- reads ------------------------------------------------------------------

(defn buffer-rope (buf)
  "The buffer's underlying rope (process-local).

    (text/length (editor/buffer/buffer-rope (editor/buffer/make-buffer \"hi\")))   ;=> 2"
  (get buf :rope))
(defn buffer-text (buf)
  "The buffer's full text as a string.

    (editor/buffer/buffer-text (editor/buffer/insert (editor/buffer/make-buffer \"bc\") \"a\"))   ;=> \"abc\""
  (text/->string (get buf :rope)))
(defn buffer-point (buf)
  "The cursor position (a char index).

    (editor/buffer/buffer-point (editor/buffer/insert (editor/buffer/make-buffer \"bc\") \"a\"))   ;=> 1"
  (get buf :point))
(defn buffer-mark (buf)
  "The mark (a char index), or nil if unset.

    (editor/buffer/buffer-mark (editor/buffer/set-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abc\") 2)))   ;=> 2"
  (get buf :mark))
(defn buffer-moved? (before after)
  "Did the cursor or the text move between two states of a buffer — `before` and `after`
its point or rope differ? The test an app's loop runs a layer's `:on-move` followers on
(layers §7): the rope is a handle, so an unchanged text is an O(1) `=`. Compares STATES,
not identities — an app that can switch buffers between the two states checks that itself.

    (let (b (editor/buffer/make-buffer \"abc\")) (editor/buffer/buffer-moved? b (editor/buffer/forward-char b)))   ;=> true
    (let (b (editor/buffer/make-buffer \"abc\")) (editor/buffer/buffer-moved? b (editor/buffer/set-mark b)))       ;=> false"
  (or (not (= (get before :point) (get after :point)))
    (not (= (get before :rope) (get after :rope)))))

(defn buffer-content-changed? (before:buffer after:buffer -> bool)
  "Did the CONTENT change between two states of a buffer — its text or its text properties?
What a holder of a copy asks before sending anything to another (a frame, a buffer process):
a property change (`put-properties`) leaves the text as it was, so the text alone would miss
it. O(1) when nothing changed: an unchanged rope and property map are the same values.

    (let (b (editor/buffer/make-buffer \"abc\")) (editor/buffer/buffer-content-changed? b (editor/buffer/put-properties b :face 0 1 [[0 1 :red]])))   ;=> true
    (let (b (editor/buffer/make-buffer \"abc\")) (editor/buffer/buffer-content-changed? b (editor/buffer/forward-char b)))   ;=> false"
  (not (and (= (get before :rope) (get after :rope))
         (= (get before :properties) (get after :properties)))))

(defn buffer-name (buf)
  "The buffer's name.

    (editor/buffer/buffer-name (editor/buffer/make-buffer \"x\"))           ;=> \"*scratch*\"
    (editor/buffer/buffer-name (editor/buffer/make-buffer \"x\" \"notes\"))   ;=> \"notes\""
  (get buf :name))
(defn buffer-file (buf)
  "The buffer's backing file path, or nil.

    (editor/buffer/buffer-file (editor/buffer/make-buffer \"x\" \"a.txt\" \"/tmp/a.txt\"))   ;=> \"/tmp/a.txt\""
  (get buf :file))
(defn buffer-length (buf)
  "The number of characters in the buffer.

    (editor/buffer/buffer-length (editor/buffer/make-buffer \"héllo\"))   ;=> 5"
  (text/length (get buf :rope)))
(defn buffer-line-count (buf)
  "The number of lines in the buffer.

    (editor/buffer/buffer-line-count (editor/buffer/make-buffer \"a\\nb\\nc\"))   ;=> 3"
  (text/line-count (get buf :rope)))

(defn buffer-line-at (buf line)
  "The text of `line` (0-based), including its trailing newline (like `text/line`).

    (editor/buffer/buffer-line-at (editor/buffer/make-buffer \"a\\nb\\nc\") 1)   ;=> \"b\\n\""
  (text/line (get buf :rope) line))

(defn buffer-current-line (buf)
  "The 0-based line index that point is on.

    (editor/buffer/buffer-current-line (editor/buffer/goto-char (editor/buffer/make-buffer \"ab\\ncd\") 4))   ;=> 1"
  (text/char->line (get buf :rope) (get buf :point)))

(defn buffer-column (buf:buffer -> int)
  "The 0-based column of point — characters from the start of its line.

    (editor/buffer/buffer-column (editor/buffer/goto-char (editor/buffer/make-buffer \"ab\\ncd\") 4))   ;=> 1"
  (let (rope (get buf :rope))
    (- (get buf :point) (text/line->char rope (text/char->line rope (get buf :point))))))

(defn buffer-char-after (buf:buffer -> (or string nil))
  "The single-character string just after point, or nil at end of buffer.

    (editor/buffer/buffer-char-after (editor/buffer/goto-char (editor/buffer/make-buffer \"abc\") 1))     ;=> \"b\"
    (editor/buffer/buffer-char-after (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"abc\")))   ;=> nil"
  (let (p (get buf :point))
    (if (< p (buffer-length buf)) (text/slice (get buf :rope) p (inc p)) nil)))

(defn buffer-char-before (buf:buffer -> (or string nil))
  "The single-character string just before point, or nil at start of buffer.

    (editor/buffer/buffer-char-before (editor/buffer/goto-char (editor/buffer/make-buffer \"abc\") 1))   ;=> \"a\""
  (let (p (get buf :point))
    (if (> p 0) (text/slice (get buf :rope) (dec p) p) nil)))

(defn buffer-region-bounds (buf:buffer -> (or nil (tuple int int)))
  "The region's char bounds as `[lo hi]` (lo ≤ hi, point and mark in either order),
or nil if no mark is set. The half-open span `[lo, hi)` the view highlights and
`delete-region`/`buffer-region` act on.

    (editor/buffer/buffer-region-bounds (editor/buffer/goto-char (editor/buffer/set-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abcdef\") 4)) 1))   ;=> [1 4]"
  (let (m (get buf :mark))
    (if (nil? m) nil (let (p (get buf :point)) [(math/min p m) (math/max p m)]))))

(defn buffer-region (buf)
  "The text between point and mark (in either order), or nil if no mark is set.

    (editor/buffer/buffer-region (editor/buffer/goto-char (editor/buffer/set-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abcdef\") 4)) 1))   ;=> \"bcd\"
    (editor/buffer/buffer-region (editor/buffer/make-buffer \"abc\"))   ;=> nil"
  (let (b (buffer-region-bounds buf))
    (if (nil? b)
      nil
      (let ([lo hi] b) (text/slice (get buf :rope) lo hi)))))

;; ---- movement (returns a fresh buffer with point moved) ---------------------

(defn goto-char (buf:buffer n:int -> buffer)
  "Point moved to char index `n`, clamped to [0, length].

    (editor/buffer/buffer-point (editor/buffer/goto-char (editor/buffer/make-buffer \"abc\") 99))   ;=> 3"
  (assoc buf :point (buffer-clamp 0 (buffer-length buf) n)))

(defn forward-char (buf:buffer &optional (n:int 1) -> buffer)
  "Point moved `n` user-perceived characters forward (clamped) — whole grapheme clusters, so
point never lands inside `e` + a combining accent or an emoji sequence (ADR-422). A negative
`n` moves backward.

    (editor/buffer/buffer-point (editor/buffer/forward-char (editor/buffer/make-buffer \"e\u{301}x\")))   ;=> 2"
  (if (< n 0)
    (backward-char buf (- 0 n))
    (assoc buf :point (text/forward-graphemes (get buf :rope) (get buf :point) n))))

(defn backward-char (buf:buffer &optional (n:int 1) -> buffer)
  "Point moved `n` user-perceived characters backward (clamped) — whole grapheme clusters
(ADR-422). A negative `n` moves forward.

    (editor/buffer/buffer-point (editor/buffer/backward-char (editor/buffer/goto-char (editor/buffer/make-buffer \"xe\u{301}\") 3)))   ;=> 1"
  (if (< n 0)
    (forward-char buf (- 0 n))
    (assoc buf :point (text/backward-graphemes (get buf :rope) (get buf :point) n))))

(defn beginning-of-line (buf)
  "Point moved to the first character of its current line.

    (editor/buffer/buffer-point (editor/buffer/beginning-of-line (editor/buffer/goto-char (editor/buffer/make-buffer \"ab\\ncd\") 4)))   ;=> 3"
  (let (rope (get buf :rope))
    (goto-char buf (text/line->char rope (text/char->line rope (get buf :point))))))

(defn end-of-line (buf)
  "Point moved to the end of its current line (before the trailing newline).

    (editor/buffer/buffer-point (editor/buffer/end-of-line (editor/buffer/make-buffer \"ab\\ncd\")))   ;=> 2"
  (let (rope (get buf :rope)
        line (text/char->line rope (get buf :point)))
    (goto-char buf (+ (text/line->char rope line) (buffer-line-end-col buf line)))))

(defn forward-line (buf:buffer &optional (n:int 1) -> buffer)
  "Point moved `n` lines forward (negative = backward), keeping the column where
the target line is long enough. Clamps to the buffer's line range.

    (editor/buffer/buffer-point (editor/buffer/forward-line (editor/buffer/goto-char (editor/buffer/make-buffer \"ab\\ncd\") 1)))   ;=> 4
    (editor/buffer/buffer-point (editor/buffer/forward-line (editor/buffer/make-buffer \"ab\\ncd\") 5))   ;=> 3"
  (let (rope (get buf :rope)
        col (buffer-column buf)
        target (buffer-clamp 0
                 (dec (text/line-count rope))
                 (+ (text/char->line rope (get buf :point)) n))
        line-start (text/line->char rope target))
    (goto-char buf (+ line-start (math/min col (buffer-line-end-col buf target))))))

(defn backward-line (buf:buffer &optional (n:int 1) -> buffer)
  "Point moved `n` lines backward (see `forward-line`).

    (editor/buffer/buffer-point (editor/buffer/backward-line (editor/buffer/goto-char (editor/buffer/make-buffer \"ab\\ncd\") 4)))   ;=> 1"
  (forward-line buf (- n)))

(defn beginning-of-buffer (buf)
  "Point moved to the start of the buffer.

    (editor/buffer/buffer-point (editor/buffer/beginning-of-buffer (editor/buffer/goto-char (editor/buffer/make-buffer \"abc\") 2)))   ;=> 0"
  (goto-char buf 0))
(defn end-of-buffer (buf)
  "Point moved to the end of the buffer.

    (editor/buffer/buffer-point (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"abc\")))   ;=> 3"
  (goto-char buf (buffer-length buf)))

;; ---- word motion (M-f / M-b) ------------------------------------------------
;; A word is a run of non-delimiter, non-whitespace chars (same notion as the
;; line editor's M-f/M-b). Forward skips any non-word chars then the word;
;; backward is the mirror. Both scan the ROPE from point (`text/skip-forward`), reading
;; only the characters they cross.

(def- *word-delimiters*
  ;; what is NOT part of a word: whitespace and the delimiters. `/` is one — a qualified
  ;; name `math/floor` is two words, so M-d / M-DEL and M-f / M-b take the namespace and
  ;; the name separately.
  " /\t\n()[]{}\";,")

(def- *horizontal-space*
  ;; horizontal only: a newline is a line boundary, never whitespace to squeeze
  " \t")

(defn forward-word (buf)
  "Point moved to the end of the next word forward (skip non-word chars, then the word).
Scans the rope from point and reads only what it crosses: it used to flatten the whole
buffer to a string on every M-f, which on a large file was the cost of the keystroke.

    (editor/buffer/buffer-point (editor/buffer/forward-word (editor/buffer/make-buffer \"  hello world\")))   ;=> 7"
  (let (rope (get buf :rope)
        i (text/skip-forward rope (get buf :point) *word-delimiters* true))
    (goto-char buf (text/skip-forward rope i *word-delimiters* false))))

(defn backward-word (buf)
  "Point moved to the start of the previous word backward (skip non-word chars, then the
word). Like `forward-word`, reads only the characters it crosses.

    (editor/buffer/buffer-point (editor/buffer/backward-word (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"hello world\"))))   ;=> 6"
  (let (rope (get buf :rope)
        i (text/skip-backward rope (get buf :point) *word-delimiters* true))
    (goto-char buf (text/skip-backward rope i *word-delimiters* false))))

;; ---- indentation motion (M-m) -----------------------------------------------
;; `beginning-of-line` with the indent skipped — the same rope scan the word motions use.

(defn back-to-indentation (buf)
  "Point moved to the first non-whitespace character of its current line — the
indentation skipped (Emacs `back-to-indentation`, M-m). Lands at the line's end when
the line is blank or all whitespace.

    (editor/buffer/buffer-point (editor/buffer/back-to-indentation (editor/buffer/end-of-line (editor/buffer/make-buffer \"   x = 1\"))))   ;=> 3"
  (let (bol (beginning-of-line buf)
        eol (get (end-of-line bol) :point))
    (goto-char bol
      (math/min eol (text/skip-forward (get bol :rope) (get bol :point) *horizontal-space* true)))))

;; ---- mark -------------------------------------------------------------------

(defn set-mark (buf:buffer -> buffer)
  "Set the mark at point (with point, this delimits the region).

    (editor/buffer/buffer-mark (editor/buffer/set-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abc\") 2)))   ;=> 2"
  (assoc buf :mark (get buf :point)))
;; `assoc` on a record answers `vector | map` — a record's type does not survive an
;; update — so every buffer transformer has to re-declare what it hands back, or its
;; callers report the width instead.
(defn clear-mark (buf:buffer -> buffer)
  "Clear the mark.

    (editor/buffer/buffer-mark (editor/buffer/clear-mark (editor/buffer/set-mark (editor/buffer/make-buffer \"abc\"))))   ;=> nil"
  (assoc buf :mark nil))

;; ---- mark ring (a history of marks; the substrate for C-u C-SPC) ------------

; like Emacs `mark-ring-max`
(def *mark-ring-max* 16)
(defn push-mark (buf)
  "Set the mark at point **and** push point onto the buffer's `:mark-ring` (bounded
by `*mark-ring-max*`, newest first). The ring records where the mark has been so
`pop-mark` can revisit prior locations.

    (editor/buffer/buffer-mark (editor/buffer/push-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abcdef\") 2)))   ;=> 2"
  (let (p (get buf :point))
    (assoc buf
      :mark p
      :mark-ring (take (cons p (or (get buf :mark-ring) ())) *mark-ring-max*))))

(defn pop-mark (buf)
  "Move point to the newest entry on the buffer's `:mark-ring`, rotating that entry
to the back so repeated calls cycle through the ring (Emacs `pop-to-mark-command`).
A no-op when the ring is empty.

    (editor/buffer/buffer-point (editor/buffer/pop-mark (editor/buffer/goto-char (editor/buffer/push-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abcdef\") 2)) 5)))   ;=> 2"
  (let (ring (or (get buf :mark-ring) ()))
    (if (empty? ring)
      buf
      (assoc buf
        :point (buffer-clamp 0 (buffer-length buf) (first ring))
        :mark-ring (append (rest ring) (list (first ring)))))))

;; ---- search (pure position queries; the caller moves point) -----------------

;; `fold?` is the case-insensitive switch, and it is a parameter rather than a mode
;; because WHEN to fold is the editor's policy, not the buffer's: Emacs folds by default
;; and stops the moment the pattern contains an upper-case letter. What belongs here is
;; only that folding can be done at all, and done without moving the answer — both the
;; haystack and the needle go through `string/fold-case`, which is one character per
;; character, so an index into the folded text is an index into the real text. Folding
;; with `string/lower` instead would shift every offset after the first `İ`.

;; Both searches stream the ROPE (`%rope-find` / `%rope-rfind`) rather than asking the buffer
;; for its text: `(index-of (string/fold-case (buffer-text buf)) needle from)` is three
;; whole-buffer passes per call, and incremental search calls this on every keystroke, so
;; its cost would grow with exactly the buffers where search matters most. Nothing
;; whole-buffer is allocated; the fold happens per character as the scan passes it.

(defn buffer-search-forward (buf needle from &optional (fold? false))
  "The char index of the first occurrence of `needle` in `buf`'s text at or after
`from`, or nil if there is none. With `fold?`, the comparison ignores case (simple case
folding — `string/fold-case`). Pure — it does not move point; the caller composes
`goto-char`/`set-mark`. The forward primitive incremental search rides on.

    (editor/buffer/buffer-search-forward (editor/buffer/make-buffer \"abcabc\") \"bc\" 2)       ;=> 4
    (editor/buffer/buffer-search-forward (editor/buffer/make-buffer \"abc\") \"BC\" 0 true)   ;=> 1"
  (let (i (%rope-find (buffer-rope buf) needle from fold?))
    (if (< i 0) nil i)))
(sig buffer-search-forward (any string any -> (or int nil)))

(defn buffer-search-backward (buf needle before &optional (fold? false))
  "The char index of the last occurrence of `needle` in `buf`'s text whose start is
strictly before `before`, or nil if there is none. With `fold?`, the comparison ignores
case. The backward counterpart of `buffer-search-forward`.

    (editor/buffer/buffer-search-backward (editor/buffer/make-buffer \"abcabc\") \"bc\" 4)   ;=> 1
    (editor/buffer/buffer-search-backward (editor/buffer/make-buffer \"abc\") \"bc\" 1)      ;=> nil"
  (let (i (%rope-rfind (buffer-rope buf) needle before fold?))
    (if (< i 0) nil i)))
(sig buffer-search-backward (any string any -> (or int nil)))

;; ---- undo (an undo *tree*, Emacs-style) -------------------------------------
;;
;; Undo rides the immutable buffer for free: a snapshot is the edit-mutable triple
;; `{:rope :point :mark}` (ropey shares structure, so a snapshot is O(1)). `:undo` is
;; the history — a stack of snapshots, newest first — and each editing op pushes its
;; PRE-edit snapshot (only when the text really changes, so undo has no dead steps).
;;
;; The twist that makes it a *tree*, not a one-way stack (Emacs `undo`): **undoing is
;; itself recorded as a change.** `undo-next` restores the next state AND pushes the
;; current one onto `:undo`, so an undo can itself be undone (= redo), and editing
;; after some undos leaves the undone states on `:undo` as a branch you can still
;; reach. No state is ever lost.
;;
;; `:pending-undo` is the tail of `:undo` the current undo run walks down. The caller
;; (the editor's cmd-undo / cmd-redo) calls `undo-start` to begin a fresh run — pointed
;; at the front of `:undo`, which after a run holds the just-undone states, so a fresh
;; run *reverses direction* (redo). Continuing the run (not restarting) keeps direction.
;; A snapshot excludes the history fields so snapshots don't nest and grow geometrically.

(defn- buffer-snapshot (buf)
  "The restorable edit state of `buf` — `{:rope :point :mark}` (no history), plus `:markers`,
`:editable` (the narrowing) and `:properties` (the text properties) when the buffer has any.
Each is snapshot-restored like `point`/`mark` (not re-derived), so undo/redo return them to
their recorded positions instead of stranding them at the post-edit spot — the editable
regions revert in lockstep with the text they bound, and deleted text comes back with its
properties. A buffer with none of them omits the keys, staying identical to before those
facilities."
  (let (base {:rope (get buf :rope) :point (get buf :point) :mark (get buf :mark)}
        markers (get buf :markers)
        regions (get buf :editable)
        properties (get buf :properties)
        base (if markers (assoc base :markers markers) base)
        base (if properties (assoc base :properties properties) base))
    (if regions (assoc base :editable regions) base)))

(defn amalgamate-undo (buf:buffer -> buffer)
  "Make the **next** editing op amalgamate into the current undo group rather than start
a new one: its pre-edit snapshot is dropped, so undo treats the run as a single step.
A one-shot flag (cleared by the next edit). By default every op is its own undo step; the
editor's command loop calls this to coalesce a typing / deletion run (or a multi-edit
command) into one undo, the Emacs way — keeping this primitive's default simple.

    (count (get (editor/buffer/insert (editor/buffer/amalgamate-undo (editor/buffer/insert (editor/buffer/make-buffer \"\") \"a\")) \"b\") :undo))   ;=> 1"
  (assoc buf :undo-amalgamate true))

;; ---- the undo limit (Emacs's undo-limit / undo-strong-limit) ------------------
;; A history nobody trims is a memory leak over a long session, so `:undo` is capped by
;; SIZE. A snapshot shares every rope leaf its edit did not touch, so what it alone keeps
;; alive is the text its step changed plus the leaf and path that edit copied: its COST is
;; the changed chars (the old side and the new, `text/changed-range` against the state
;; that came after it) plus `*undo-step-cost*`. The cost is known once the NEXT snapshot is
;; pushed, so it is stamped on the old head then (`:cost`), and the buffer keeps the
;; running sum as `:undo-size`.
;;
;; Trimming is Emacs's two limits: nothing happens until the history passes
;; `*undo-strong-limit*`, then the oldest snapshots go until what is left fits
;; `*undo-limit*` — one O(history) pass per (strong - limit) worth of edits, never per
;; keystroke. A snapshot IS one undo group (amalgamation and `undo-group` fold a run into
;; one), so dropping whole snapshots never cuts a group in half; the newest group is kept
;; whatever its size. Only an EDIT trims: an undo run walks the oldest entries, which are
;; what a trim drops, so its own steps never trim and a run reaches the end of a history at
;; the limit. Both limits are `defdyn`s: an editor binds them, or re-`def`s them from its
;; settings (every process of the image then sees them); nil turns the cap off.

(defdyn editor/buffer/*undo-limit* 2000000)
;; What a trimmed history is cut back to, in cost units (≈ chars). See the section note.

(defdyn editor/buffer/*undo-strong-limit* 3000000)
;; The size a history may reach before it is trimmed back to `*undo-limit*`.

(def *undo-step-cost* 1024)
;; What one snapshot costs beyond the text its step changed: the rope leaf (ropey's are up
;; to ~1 KB) and the internal nodes its edit copied, which the snapshot alone keeps alive.

(defn undo-cost (older newer)
  "What snapshot (or buffer) `older` costs to keep on the undo history when `newer` is the
state after it: the chars its step changed, old side and new, plus `*undo-step-cost*`.

    (editor/buffer/undo-cost (editor/buffer/make-buffer \"abcd\") (editor/buffer/make-buffer \"abXcd\"))   ;=> 1025"
  (let (range (text/changed-range (get older :rope) (get newer :rope)))
    (if (nil? range)
      *undo-step-cost*
      (let ([start old-end new-end] range)
        (+ *undo-step-cost* (- old-end start) (- new-end start))))))

(defn- buffer-undo-keep (history limit)
  "How many snapshots of `history` (newest first) fit in `limit`: their summed `:cost` stays
within it, and the newest is kept whatever it costs. Answers `[kept size]`."
  (letrec (walk (fn (entries kept size)
                  (if (empty? entries)
                    [kept size]
                    (let (next (+ size (or (get (first entries) :cost) 0)))
                      (if (and (> kept 0) (> next limit))
                        [kept size]
                        (walk (rest entries) (inc kept) next))))))
    (walk history 0 0)))

(defn trim-undo (buf:buffer -> buffer)
  "`buf` with its undo history cut back to `*undo-limit*` when it has grown past
`*undo-strong-limit*` — the oldest snapshots dropped, whole (each is one undo group), the
newest always kept. A current undo run (`:pending-undo`, a tail of the history) loses the
same oldest entries, so it never walks into a dropped one. Every edit calls this (an undo
step does not, so a run can walk back through all of a history at the limit);
call it after lowering the limits to apply them at once.

    (count (get (binding (editor/buffer/*undo-limit* 0 editor/buffer/*undo-strong-limit* 0) (editor/buffer/trim-undo (editor/buffer/insert (editor/buffer/insert (editor/buffer/make-buffer \"\") \"a\") \"b\"))) :undo))   ;=> 1"
  (let (limit *undo-limit*
        ;; never below the limit: a strong limit under it would trim on every edit and drop
        ;; nothing, an O(history) pass a keystroke
        strong (when limit (math/max limit (or *undo-strong-limit* limit)))
        history (or (get buf :undo) ()))
    (if (or (nil? limit) (<= (or (get buf :undo-size) 0) strong))
      buf
      (let ([kept size] (buffer-undo-keep history limit)
            dropped (- (count history) kept)
            pending (or (get buf :pending-undo) ()))
        (if (= dropped 0)
          (assoc buf :undo-size size)
          (assoc buf
            :undo (apply list (take history kept))
            :undo-size size
            :pending-undo (apply list (take pending (math/max 0 (- (count pending) dropped))))))))))

(defn- buffer-undo-cons (buf history snapshot)
  "`buf` with `snapshot` pushed onto `history` as its new head: the old head's `:cost` is
stamped now that the state after it is known (`snapshot`), and `:undo-size` grows by it."
  (let (head (first history)
        priced? (or (nil? head) (get head :cost))
        cost (if priced? 0 (undo-cost head snapshot))
        history (if priced? history (cons (assoc head :cost cost) (rest history))))
    (assoc buf :undo (cons snapshot history) :undo-size (+ (or (get buf :undo-size) 0) cost))))

(defn- buffer-undo-push (buf history snapshot)
  "[[buffer-undo-cons]], then the history trimmed when it passed the strong limit
(`trim-undo`) — what every EDIT records through. An undo step does not trim: the run it is
part of walks the oldest entries, which are the ones a trim drops, so a run at the limit
would eat the history it is undoing. A run at most doubles the history; the next edit trims."
  (trim-undo (buffer-undo-cons buf history snapshot)))

(defn- buffer-record-change (buf:buffer -> buffer)
  "Record that `buf`'s text is about to change — called by EVERY editing op, and only by
one that really changes the text. Two facts follow from a change, and this is the one place
both are kept, so no op can record one and forget the other:

  - the buffer is now modified (`buffer-modified?`);
  - its pre-edit state goes on `:undo`. Normally a fresh snapshot (each op its own undo
    step); when `amalgamate-undo` armed the one-shot `:undo-amalgamate` (and there's a group
    to merge into) this op's snapshot is dropped so the run undoes as one. Nothing is
    recorded when undo is disabled (`disable-undo`).

(Does not touch `:pending-undo`: the next undo run starts fresh anyway — the editor
restarts it whenever the previous command wasn't an undo.)"
  (let (buf (assoc buf :modified true))
    (cond
      (get buf :undo-disabled) buf
      (and (get buf :undo-amalgamate) (not (empty? (get buf :undo))))
        (assoc buf
          :undo-amalgamate false)
      else
        (buffer-undo-push (assoc buf :undo-amalgamate false)
          (or (get buf :undo) ())
          (buffer-snapshot buf)))))

(defn undo-group (buf:buffer f: (buffer -> buffer) -> buffer)
  "Apply `f` (`buffer -> buffer`) to `buf` as ONE undo step, however many edits it makes:
a single `undo` restores `buf` exactly as it was, point included. The way to write a
command that is several edits — a replace that is a delete then an insert, a
query-replace-all, a transpose — so undo never stops in the half-done state between them.

It works by running `f` against an empty history and looking at what `f` left there: if
`f` recorded nothing, `f` changed nothing and `buf`'s history comes back untouched; if it
recorded anything, all of it is replaced by one snapshot of `buf`. O(1) either way — the
history is never walked. An armed `amalgamate-undo` still applies to the group as a whole.
A `redact-region` inside `f` wins: the step back to `buf` would hold what it took, so the
group leaves no history at all, `buf`'s included (ADR-581).

    (count (get (editor/buffer/undo-group (editor/buffer/make-buffer \"ab\") (fn (b) (editor/buffer/insert (editor/buffer/insert b \"x\") \"y\"))) :undo))   ;=> 1"
  (let (
        ;; `f` runs with no undo run either: a trim of its own history (its edits passing
        ;; the strong limit) cuts the pending run by what IT dropped, and the outer run is
        ;; a tail of a history it never saw
        after (f (assoc buf :undo () :undo-size 0 :undo-amalgamate false :pending-undo ()))
        history (or (get buf :undo) ())
        ;; what `f` recorded is thrown away below, so its size goes with it, and the outer
        ;; run comes back as it was
        after (assoc after
                :undo-size (or (get buf :undo-size) 0)
                :pending-undo (get buf :pending-undo)))
    (cond
      ;; `f` redacted: neither its steps nor `buf`'s history may come back
      (> (or (get after :redactions) 0) (or (get buf :redactions) 0))
        (assoc after :undo () :undo-size 0 :pending-undo () :undo-amalgamate false)
      (empty? (get after :undo))
        (assoc after :undo history :undo-amalgamate (get buf :undo-amalgamate))
      (get buf :undo-disabled) (assoc after :undo history)
      (and (get buf :undo-amalgamate) (not (empty? history)))
        (assoc after :undo history :undo-amalgamate false)
      else (buffer-undo-push (assoc after :undo-amalgamate false) history (buffer-snapshot buf)))))

;; ---- modified: does the text differ from the file? ---------------------------
;; The buffer owns this, because only the buffer sees every change: an editor that kept the
;; flag itself had to set it in each command, and the commands that forgot (kill, yank,
;; query-replace — a dozen of them) lost unsaved work silently on close.
;;
;; Every editing op passes through `buffer-record-change`, which sets `:modified`. The
;; baseline is `:saved-rope` — the text as it was read or last written — and an undo step
;; compares against it, so undoing back to the saved text makes the buffer unmodified again
;; (Emacs does the same). That comparison is by content (O(n) worst case), which is why it
;; runs per undo step and never per keystroke or per frame.

(defn buffer-modified? (buf:buffer -> bool)
  "True when `buf`'s text has changed since it was read, created or last saved.

    (editor/buffer/buffer-modified? (editor/buffer/make-buffer \"a\"))   ;=> false
    (editor/buffer/buffer-modified? (editor/buffer/insert (editor/buffer/make-buffer \"a\") \"b\"))   ;=> true"
  (= true (get buf :modified)))

(defn mark-buffer-saved (buf:buffer -> buffer)
  "`buf` with its current text as the saved baseline — unmodified. `save-buffer` and
`buffer-from-file` do this; call it after writing the text out some other way.

    (editor/buffer/buffer-modified? (editor/buffer/mark-buffer-saved (editor/buffer/insert (editor/buffer/make-buffer \"a\") \"b\")))   ;=> false"
  (assoc buf :modified false :saved-rope (get buf :rope)))

(defn mark-buffer-modified (buf:buffer -> buffer)
  "`buf` flagged as differing from its file even though no edit made it so — a buffer
whose file vanished, or whose text came from somewhere other than its file.

    (editor/buffer/buffer-modified? (editor/buffer/mark-buffer-modified (editor/buffer/make-buffer \"a\")))   ;=> true"
  (assoc buf :modified true))

(defn disable-undo (buf)
  "Turn off undo recording for `buf` and drop any existing history. For a log / output
buffer (e.g. `*Messages*`) where undo is meaningless and would otherwise grow without
bound — editing ops on the result record nothing, so undo stays a no-op. Like Emacs
`buffer-disable-undo`.

    (get (editor/buffer/insert (editor/buffer/disable-undo (editor/buffer/make-buffer \"\")) \"a\") :undo)   ;=> nil"
  (assoc buf :undo-disabled true :undo () :undo-size 0 :pending-undo ()))

(defn- buffer-restore (buf snap)
  "Restore the `{:rope :point :mark}` (and `:markers`, `:editable`, `:properties`) of `snap`
into `buf`, keeping `buf`'s history. Markers, the narrowing and the text properties are
restored to the snapshot's recorded positions; a snapshot without one drops the key so that
state stays as it was."
  (let (restored (assoc buf :rope (get snap :rope) :point (get snap :point) :mark (get snap :mark)))
    (fold [:markers :editable :properties]
      restored
      (fn (acc key)
        (let (value (get snap key))
          (cond
            value (assoc acc key value)
            (get acc key) (dissoc acc key)
            else acc))))))

(defn undo-start (buf:buffer -> buffer)
  "Begin a fresh undo run: point `:pending-undo` at the whole `:undo` history. Because
each `undo-next` records the state it leaves onto `:undo`, a run started after some undos
walks the *reverse* direction — i.e. it redoes.

    (count (get (editor/buffer/undo-start (editor/buffer/insert (editor/buffer/make-buffer \"a\") \"b\")) :pending-undo))   ;=> 1"
  (assoc buf :pending-undo (get buf :undo)))

(defn undo-next (buf:buffer -> buffer)
  "One step of the current undo run: restore the next snapshot in `:pending-undo`,
recording the current state onto `:undo` (so this very step is itself reversible) and
advancing `:pending-undo`. A no-op (returns `buf`) when the run is exhausted. The
restored text is compared with the saved baseline, so undoing back to what is on disk
leaves the buffer unmodified.

    (editor/buffer/buffer-text (editor/buffer/undo-next (editor/buffer/undo-start (editor/buffer/insert (editor/buffer/make-buffer \"a\") \"b\"))))   ;=> \"a\""
  (let (p (get buf :pending-undo))
    (if (empty? p)
      buf
      (let (restored (buffer-log-restore buf (buffer-restore buf (first p))))
        (buffer-undo-cons (assoc restored
                            :pending-undo (rest p)
                            :modified (not (= (get restored :rope) (get buf :saved-rope))))
          (or (get buf :undo) ())
          (buffer-snapshot buf))))))

;; ---- undo in a region: undo only the lines you selected ----------------------
;; Emacs's `undo-in-region`, and it costs almost nothing here — because of what
;; snapshot undo already is. Emacs must maintain a change LOG to know which edits
;; touched your selection; we keep whole previous texts instead, and the change set
;; between two texts is exactly what a line diff computes. So selective undo needs no
;; new undo representation at all: derive the changes on demand (`diff/lines`),
;; keep the ones that fall inside the region, and drop the rest.
;;
;; Reading a diff of OLD -> NEW as "what the user did":
;;   [:keep l]    unchanged      -> keep it, whatever the region says
;;   [:insert l]  they added l   -> inside the region, undo means DROP it
;;   [:delete l]  they removed l -> inside the region, undo means PUT IT BACK
;; One fold with a current-line counter, and the region test is on the CURRENT side,
;; because that is the text the user selected in.
;;
;; Granularity is the LINE (that is the unit a line diff — and the user's "these
;; lines" — speaks in); a whole-buffer region reproduces a plain undo exactly.

(def *undo-region-char-budget* 4000)
;; The largest changed SPAN (in chars) a region undo will diff character-by-character.
;; The LCS diff is O(n²) in time and space, so an unbounded char diff on a huge rewrite
;; would hang the editor; past this the span is treated as one change (undone whole if it
;; overlaps the region). Typical edits trim to a handful of chars, so this is never hit
;; in practice — it exists so the pathological case degrades instead of freezing.

(defn- undo-hunk-chars (hunk tag)
  ;; `hunk` is gathered newest-first (a `cons` per op), so it is read back reversed
  (apply str (seq/keep (reverse hunk) (fn (op) (let ([t c] op) (when (= t tag) c))))))

(defn- region-piece-push (pieces source from length)
  ;; `pieces` (newest first, `[source from length]`, `source` :old or :new) with `length`
  ;; chars of `source` from `from` — joined to the newest piece when it continues it
  (if (<= length 0)
    pieces
    (let (head (when (not (empty? pieces)) (first pieces)))
      (if (and head (= (first head) source) (= (+ (nth head 1) (nth head 2)) from))
        (cons [source (nth head 1) (+ (nth head 2) length)] (rest pieces))
        (cons [source from length] pieces)))))

(defn- undo-flush-chunk (hunk n old-n lo hi out pieces)
  ;; One CHUNK — a run of consecutive changed characters — is one change, and Emacs's
  ;; rule is that a change is undone when it OVERLAPS the region. An insertion occupies
  ;; `[n, n+len)` in the current text, so it overlaps when it starts before `hi` and ends
  ;; after `lo`; a deletion occupies no current characters, so it counts when its
  ;; position sits inside the region. Overlapping -> emit the OLD characters (undone);
  ;; otherwise the NEW ones (the change stands). `n` always advances by the characters
  ;; the current text really has there, `old-n` by those the old text has, and the piece
  ;; emitted says which text it came from, so its properties can come from there too.
  (let (adds (undo-hunk-chars hunk :insert)
        dels (undo-hunk-chars hunk :delete)
        na (string/length adds)
        nd (string/length dels)
        overlap (if (> na 0)
                  (and (< n hi) (> (+ n na) lo))
                  (and (>= n lo) (<= n hi)))
        emit (if overlap dels adds))
    [(+ n na)
      (+ old-n nd)
      (cons emit out)
      (if overlap (region-piece-push pieces :old old-n nd) (region-piece-push pieces :new n na))]))

(defn- undo-region-restore (old:string new:string lo:int hi:int -> (tuple string list))
  "The text you get by undoing, in `new`, only the changes (vs `old`) that OVERLAP the
character range `[lo, hi]` — everything else keeps `new`'s version — and where each part of
it came from: `[text pieces]`, `pieces` the `[source from length]` it is made of in order,
`source` `:old` or `:new`. Character-precise, like Emacs's `undo-in-region`: half of a line,
or one of two edits on the same line, is exactly what you get.

Cheap despite being character-level: the shared prefix and suffix are trimmed first, so
the diff only ever runs over the span that actually changed."
  ;; The trim is `%str-splice-diff`'s one native pass: `old[pre, old-end)` became `n-mid`,
  ;; and the shared prefix and suffix around them are the same chars a char-by-char walk
  ;; would find — without a `char-at` per step on both sides.
  (let ([pre old-end n-mid] (%str-splice-diff old new)
        o-mid (string/substring old pre old-end)
        head (string/substring new 0 pre)
        new-length (string/length new)
        tail-from (+ (string/length head) (string/length n-mid))
        tail (string/substring new tail-from new-length)
        whole (list [:new 0 new-length]))
    (cond
      ;; nothing changed
      (and (= o-mid "") (= n-mid "")) [new whole]
      ;; too large to diff character-wise: treat the whole span as one change
      (> (math/max (string/length o-mid) (string/length n-mid)) *undo-region-char-budget*)
        (if (and (< pre hi) (> (+ pre (string/length n-mid)) lo))
          [(str head o-mid tail)
            (reverse (region-piece-push (region-piece-push (region-piece-push () :new 0 pre)
                                          :old pre
                                          (string/length o-mid))
                       :new tail-from
                       (- new-length tail-from)))]
          [new whole])
      else
        (let (ops (diff/seq (string/->list o-mid) (string/->list n-mid))
              r (fold ops
                  [pre pre '() '() (region-piece-push () :new 0 pre)]
                  (fn (acc op)
                    (let ([n old-n out hunk pieces] acc
                          [tag c] op)
                      (if (= tag :keep)
                        (let ([n2 old-n2 out2 pieces2] (undo-flush-chunk hunk
                                                         n old-n lo hi out pieces))
                          [(inc n2)
                            (inc old-n2)
                            (cons c out2)
                            '()
                            (region-piece-push pieces2 :new n2 1)])
                        [n old-n out (cons op hunk) pieces]))))
              [n old-n out hunk pieces] r
              [_ _ out2 pieces2] (undo-flush-chunk hunk n old-n lo hi out pieces))
          [(str head (apply str (reverse out2)) tail)
            (reverse (region-piece-push pieces2 :new tail-from (- new-length tail-from)))]))))

(defn- region-pieces-properties (pieces new-map old-map)
  "The text properties of a region undo's text, made of `pieces` (`[source from length]`):
each piece's from the text it came from — `old-map` for the undone snapshot's, `new-map`
for the current text's — laid end to end. Nil when there are none."
  (second (fold pieces
            [0 nil]
            (fn (acc piece)
              (let ([at property-map] acc
                    [source from length] piece
                    relative (properties-relative (if (= source :old) old-map new-map)
                               from
                               (+ from length)))
                [(+ at length) (properties-append property-map relative at)])))))

(defn- undo-region-candidate (text lo hi snaps depth)
  ;; The nearest snapshot whose changes actually touch the region: `[undone-text tail
  ;; snapshot pieces]`, where `tail` is the history BELOW the snapshot we used and `pieces`
  ;; where the undone text came from (`undo-region-restore`). Walking back matters because
  ;; the most recent edit may have been somewhere else entirely and "undo my selection"
  ;; should still find the last thing that happened *there* (Emacs skips the same way);
  ;; returning the tail is what lets a repeat peel the NEXT change off the same lines
  ;; instead of bouncing against the entry this undo just pushed. nil when nothing in
  ;; reach touched the region.
  (cond
    (or (empty? snaps) (<= depth 0)) nil
    ;; A snapshot a region undo itself pushed is not a candidate: it holds the text we
    ;; just came from, so taking it would REDO the change instead of peeling the next
    ;; one off. Skipping it is what makes repeated calls walk backwards.
    (get (first snaps) :region-undo) (undo-region-candidate text lo hi (rest snaps) (dec depth))
    else
      (let (snapshot (first snaps)
            [undone pieces] (undo-region-restore (text/->string (get snapshot :rope)) text lo hi))
        (if (= undone text)
          (undo-region-candidate text lo hi (rest snaps) (dec depth))
          [undone (rest snaps) snapshot pieces]))))

(def *undo-region-search-depth* 200)
;; How far back a region undo will look for a change that touched the region. Bounded
;; so a long history can't turn one keystroke into an unbounded scan.

(defn undo-in-region (buf)
  "Undo, restricted to the buffer's REGION (point↔mark): the most recent change that
touched those lines is reverted and everything outside them is left exactly as it is.
Returns `buf` unchanged when there is no region, no history, or nothing in reach
touched the region. The text it restores comes back with the text properties it had in
the undone state, as a plain undo's does; the text it keeps keeps its own.

The region survives, so repeated calls keep peeling changes off the same lines — and
the step itself is an ordinary undo entry, so a plain `undo` afterwards takes the
whole thing back.

    (editor/buffer/buffer-text (editor/buffer/undo-in-region (editor/buffer/make-buffer \"abc\")))   ;=> \"abc\""
  (let (bounds (buffer-region-bounds buf))
    (if (or (nil? bounds) (empty? (or (get buf :undo) ())))
      buf
      (let ([lo hi] bounds
            text (buffer-text buf)
            found (undo-region-candidate text
                    lo
                    hi
                    (get buf :undo)
                    *undo-region-search-depth*))
        (if (nil? found)
          buf
          ;; record the pre-state (so this is itself undoable), then swap the text.
          ;; Point is clamped; the MARK is kept so the region stays live for a repeat.
          (let ([undone tail snapshot pieces] found
                ;; a step of its own, never amalgamated into a typing run before it: our
                ;; pre-state is then always the new head of the history
                pushed (buffer-record-change (assoc buf :undo-amalgamate false))
                ;; recording may have TRIMMED the history (`trim-undo`), dropping its oldest
                ;; entries — which `tail`, cut from the history before, still holds. Only
                ;; what survived the trim may stay: the history after our pre-state is the
                ;; old history's first `survivors` entries, and `tail` starts at the
                ;; consumed entry's successor
                survivors (dec (count (get pushed :undo)))
                consumed-at (- (count (or (get buf :undo) ())) (count tail) 1)
                tail (apply list (take tail (math/max 0 (- survivors consumed-at 1))))
                rope (text/from-string undone)
                [same-lo same-hi changed] (%str-splice-diff text undone)
                properties (region-pieces-properties pieces
                             (get buf :properties)
                             (get snapshot :properties))
                carried (buffer-carry-markers pushed same-lo same-hi (string/length changed))
                swapped (assoc (if (nil? properties)
                                 (dissoc carried :properties)
                                 (assoc carried :properties properties))
                          :rope rope)
                ;; the region undo knows both texts, so the splice it made is one native trim,
                ;; widened to whatever properties it gave back
                [edit-lo edit-hi edit-repl edit-properties] (buffer-edit-between buf
                                                              swapped
                                                              [same-lo same-hi changed]))
            (assoc (buffer-log-edit swapped buf edit-lo edit-hi edit-repl edit-properties)
              ;; the consumed change is dropped from history and OUR pre-state sits on
              ;; top, so a plain `undo` still takes this step back while another region
              ;; undo continues backwards through the same lines. The size is recounted from
              ;; what is left (our pre-state is priced by the next push), so `:undo` and
              ;; `:undo-size` agree — a region undo is a command, not a keystroke, and the
              ;; walk is the history's length at most.
              :undo
                (if (get buf :undo-disabled)
                  (get pushed :undo)
                  (cons (assoc (first (get pushed :undo)) :region-undo true) tail))
              :undo-size
                (if (get buf :undo-disabled)
                  (get pushed :undo-size)
                  (fold tail 0 (fn (acc kept) (+ acc (or (get kept :cost) 0)))))
              :point (math/min (get buf :point) (text/length rope))
              ;; `bounds` being non-nil says the mark is set; the `or` says so to the
              ;; checker (`:mark` reads `nil | int` on its own), with point as the
              ;; never-taken fallback.
              :mark (math/min (or (get buf :mark) (get buf :point)) (text/length rope)))))))))

(defn undo (buf)
  "A standalone single undo: begin a fresh run and take one step. The editor's repeat
behaviour — continue a run vs. restart after a non-undo command (which is what turns a
fresh run into a redo) — lives in cmd-undo / cmd-redo, which call `undo-start` /
`undo-next` directly.

    (editor/buffer/buffer-text (editor/buffer/undo (editor/buffer/insert (editor/buffer/make-buffer \"a\") \"b\")))   ;=> \"a\"
    (editor/buffer/buffer-text (editor/buffer/undo (editor/buffer/undo (editor/buffer/insert (editor/buffer/make-buffer \"a\") \"b\"))))   ;=> \"ba\""
  (undo-next (undo-start buf)))

;; ---- editing (returns a fresh buffer; records undo; clears the mark) ---------
;;
;; Edits clear the mark rather than try to track it across the change — the
;; simple, safe choice for v1 (a smarter mark-adjustment can come later if the
;; editor app needs it). `delete-region` clears it by definition. Each op records
;; an undo snapshot (see above) only when it actually changes the text.

;; ---- narrowing: what is editable -------------------------------------------
;; ONE mechanism for read-only, at two grains. A buffer is either WIDE (everything editable)
;; or NARROWED to a set of editable regions; "the whole buffer is read-only" is simply
;; narrowed to *no* regions, and `read-only?` / `set-read-only` are the names for that case.
;; A form buffer — a shell prompt whose input line is yours, a commit message whose `#` block
;; must survive, a tutorial whose prose explains and whose boxes you may break — narrows to
;; the regions the user owns, and everything outside them is read-only by construction.
;;
;; **Editable regions, not protected spans.** Storing the COMPLEMENT (the frozen ranges)
;; cannot answer the boundary question: an insert happens BETWEEN two characters, so "is
;; this position protected?" needs special cases to guess, and the answer then depends on
;; how the producer happened to split its span list.
;;
;; Editable regions have no such ambiguity, and need no special cases:
;;
;;   insert at `p`      allowed when some region has `lo <= p <= hi`  (both ends included:
;;                      typing at either edge of a region grows it, which is also what makes
;;                      an EMPTY region `[k k]` mean "you may type at k" — the emptied-box
;;                      case, said directly instead of encoded as a junction)
;;   delete `[lo hi)`   allowed when some region CONTAINS it
;;
;; That is the whole rule. Both are enforced at one choke point — every
;; mutator asks before it touches the rope — so protection holds on every edit path by
;; construction (key, mouse, held-key repeat, keyboard macro, a programmatic edit), never a
;; reactive after-the-fact comparison a caller can forget to run.
;;
;; Regions travel with edits (OUTWARD gravity, `buffer-adjust-editable`): text inserted at or
;; inside a region lands INSIDE it, and a delete confined to one shrinks it. So once set they
;; stay correct across edits with no recomputation, and a form re-narrows only when it
;; regenerates its text.

(defn- region-normalize (regions len)
  ;; Clamp to the buffer, order, and merge anything overlapping or touching. Merging matters:
  ;; two abutting editable regions ARE one editable run, and leaving them apart would let the
  ;; region list's shape leak into behaviour again — the exact failure the complement had.
  ;; An isolated empty region survives (it is a real permission), one absorbed by a
  ;; neighbour does not (it grants nothing the neighbour does not already grant).
  (let (clamped (sort (map regions
                        (fn (r)
                          (let ([lo hi] r
                                l (buffer-clamp 0 len lo)
                                h (buffer-clamp 0 len hi))
                            [(math/min l h) (math/max l h)])))))
    (into []
      (reverse (fold clamped
                 '()
                 (fn (acc r)
                   (let ([lo hi] r)
                     (if (empty? acc)
                       (list r)
                       (let ([plo phi] (first acc))
                         (if (<= lo phi)
                           (cons [plo (math/max phi hi)] (rest acc))
                           (cons r acc)))))))))))

(defn narrowed? (buf)
  "True when `buf` has been narrowed — only some of it (possibly none of it) is editable.
False for an ordinary buffer, where everything is.

    (editor/buffer/narrowed? (editor/buffer/narrow-to (editor/buffer/make-buffer \"abcdef\") [[0 3]]))   ;=> true
    (editor/buffer/narrowed? (editor/buffer/make-buffer \"abc\"))   ;=> false"
  (not (nil? (get buf :editable))))

(defn editable-regions (buf)
  "The `[lo hi]` regions of `buf` that may be edited — clamped, ordered and merged — or nil
when the buffer is not narrowed (everything is editable). `[]` means nothing is: that is the
whole-buffer read-only case, which [[read-only?]] names.

Always a VECTOR when narrowed, never a list. `'()` IS nil in Brood, so a list would make
\"narrowed to nothing\" and \"not narrowed at all\" the same value at every reader — the two
opposite answers to may-I-edit-this. [[narrow-to]] normalises its argument for the same
reason: a caller that computed its regions with `map` over an empty sequence hands in `'()`
and must not silently get a fully editable buffer.

    (editor/buffer/editable-regions (editor/buffer/narrow-to (editor/buffer/make-buffer \"abcdef\") [[4 9] [0 2]]))   ;=> [[0 2] [4 6]]"
  (let (r (get buf :editable))
    (when r (region-normalize r (buffer-length buf)))))

(defn narrow-to (buf:buffer regions:any -> buffer)
  "Narrow `buf` so that only `regions` (a list of `[lo hi]` pairs) may be edited; everything
outside them is read-only. Replaces any previous narrowing. `()` narrows to nothing, which
is the whole-buffer read-only case.

Build the text first, then narrow — like [[set-read-only]], construction never checks.
Pass the regions the user OWNS, not their complement: an empty region `[k k]` means `you may
type at k`, which has no complement spelling — that is why this takes the editable side.

    (editor/buffer/buffer-text (editor/buffer/insert (editor/buffer/goto-char (editor/buffer/narrow-to (editor/buffer/make-buffer \"abcdef\") [[0 3]]) 1) \"!\"))   ;=> \"a!bcdef\""
  (assoc buf :editable (into [] regions)))

(defn widen (buf:buffer -> buffer)
  "Undo any narrowing: the whole of `buf` is editable again.

    (editor/buffer/narrowed? (editor/buffer/widen (editor/buffer/narrow-to (editor/buffer/make-buffer \"abcdef\") [[0 3]])))   ;=> false"
  (dissoc buf :editable))

(defn read-only? (buf)
  "True if `buf` refuses every change — its mutators (`insert`, `delete-char`,
`delete-backward-char`, `delete-region`, `replace-region`) all throw.

The whole-buffer end of [[narrow-to]]: read-only IS narrowed to no editable region. A buffer
narrowed to some regions is not read-only — parts of it are writable — and a fresh buffer is
not narrowed at all.

    (editor/buffer/read-only? (editor/buffer/set-read-only (editor/buffer/make-buffer \"abc\") true))   ;=> true"
  (let (r (get buf :editable)) (and (not (nil? r)) (empty? r))))

(defn set-read-only (buf flag)
  "Mark `buf` read-only (`flag` truthy) or writable. Sugar over [[narrow-to]]: read-only narrows
to nothing, writable widens. While read-only the text mutators throw `\"buffer is read-only\"`
(Emacs's `buffer-read-only` signal) — point motion, rendering and buffer-local state are
unaffected.

Note it WIDENS on false, so it clears a narrowing rather than sitting orthogonally beside
one. That is the point of their being one feature: two independent notions of \"can I edit
here\" is how a buffer ends up read-only by one rule and writable by the other.

    (try (editor/buffer/insert (editor/buffer/set-read-only (editor/buffer/make-buffer \"abc\") true) \"x\") (catch e :refused))   ;=> :refused"
  (if flag (narrow-to buf '()) (widen buf)))

;; The signal every read-only refusal raises: a structured error tagged `:kind :read-only`
;; so a caller can tell "you may not edit that" from a genuine fault. The editor's turn of
;; the refusal into a graceful no-op matches `(= (:kind e) :read-only)` rather than the
;; message text, so the wording stays free to change.
(defn- buffer-read-only-error (message)
  (throw {:kind :read-only :message message}))

(defn- region-allows-insert? (regions p)
  ;; Both ends inclusive — see the section note. nil regions = not narrowed = anywhere.
  (or (nil? regions)
    (any? regions (fn (r) (let ([lo hi] r) (and (>= p lo) (<= p hi)))))))

(defn- region-allows-delete? (regions lo hi)
  ;; A delete must fall inside ONE region: spanning two would take the read-only text between.
  (or (nil? regions)
    (any? regions (fn (r) (let ([rlo rhi] r) (and (>= lo rlo) (<= hi rhi)))))))

(defn position-read-only? (buf pos)
  "True when the character at `pos` may not be edited — outside every editable region, or the
buffer is read-only. What the editor asks to explain a refused edit, or to keep a caret out
of generated text.

    (editor/buffer/position-read-only? (editor/buffer/narrow-to (editor/buffer/make-buffer \"abcdef\") [[0 3]]) 4)   ;=> true"
  (let (regions (editable-regions buf))
    (and (not (nil? regions))
      (not (any? regions (fn (r) (let ([lo hi] r) (and (>= pos lo) (< pos hi)))))))))

(defn- buffer-barf-if-read-only (buf)
  "Throw if `buf` is read-only outright — the cheap whole-buffer check every mutator runs
first, so the contract lives in the model and no consumer has to remember it. Returns `buf`."
  (if (read-only? buf) (buffer-read-only-error "buffer is read-only") buf))

(defn- buffer-barf-if-protected-insert (buf p)
  (if (region-allows-insert? (editable-regions buf) p)
    buf
    (buffer-read-only-error "text is read-only")))

(defn- buffer-barf-if-protected-delete (buf lo hi)
  (if (region-allows-delete? (editable-regions buf) lo hi)
    buf
    (buffer-read-only-error "text is read-only")))

(defn- buffer-adjust-editable (buf:buffer kind:keyword a:int b:int -> buffer)
  "Return `buf` with its editable regions shifted for an edit — `:insert` (a=pos, b=len) or
`:delete` (a=lo, b=hi) — or `buf` unchanged when it is not narrowed.

OUTWARD gravity on insert: a region ending at or after the insert grows to contain the new
text, and one starting strictly after it shifts. So typing at either edge of a region — the
empty-region case included — puts the text inside, which is what makes a region you may type
at a region that keeps what you typed. A delete never spans a region boundary (the mutators
refuse that first), so every endpoint is either at/before the cut or slides left by its
width."
  (let (regions (get buf :editable))
    (if (nil? regions)
      buf
      (assoc buf
        :editable
          (if (= kind :insert)
            (map regions
              (fn (r) (let ([lo hi] r) [(if (< a lo) (+ lo b) lo) (if (<= a hi) (+ hi b) hi)])))
            (let (d (- b a))
              (map regions
                (fn (r)
                  (let ([lo hi] r)
                    [(if (>= lo b) (- lo d) lo) (if (>= hi b) (- hi d) hi)])))))))))

;; ---- the complement view (compatibility) ------------------------------------
;; `read-only-spans` reads fine as a QUERY — "which ranges
;; are frozen?" — so it stays, derived. `set-read-only-spans` stays too, but it is lossy by
;; nature and says so: the complement cannot express an empty editable region, so a producer
;; that has regions should call `narrow-to` with them instead of computing a complement for this
;; to invert.

(defn read-only-spans (buf)
  "The frozen `[lo hi)` ranges of `buf` — the complement of [[editable-regions]] — or `()`
when the buffer is not narrowed. A query view; [[narrow-to]] is how you set it.

    (editor/buffer/read-only-spans (editor/buffer/narrow-to (editor/buffer/make-buffer \"abcdef\") [[0 3]]))   ;=> ([3 6])"
  (let (regions (editable-regions buf))
    (if (nil? regions)
      '()
      (let (len (buffer-length buf)
            r (fold regions
                [0 '()]
                (fn (acc region)
                  (let ([pos spans] acc
                        [lo hi] region)
                    [hi (if (< pos lo) (cons [pos lo] spans) spans)])))
            [pos spans] r)
        (reverse (if (< pos len) (cons [pos len] spans) spans))))))

(defn set-read-only-spans (buf spans)
  "Narrow `buf` to everything OUTSIDE `spans` — the complement-shaped way to say what
[[narrow-to]] says directly. `()` widens.

**Lossy, and preferably not used.** A complement cannot express an empty editable region
(\"you may type at k\"), so a form buffer that empties a region and expects typing to refill
it must call `narrow-to` with its own regions. Kept for callers that genuinely think in frozen
ranges.

    (editor/buffer/editable-regions (editor/buffer/set-read-only-spans (editor/buffer/make-buffer \"abcdef\") [[2 4]]))   ;=> [[0 2] [4 6]]"
  (if (empty? spans)
    (widen buf)
    (let (len (buffer-length buf)
          frozen (region-normalize spans len)
          r (fold frozen
              [0 '()]
              (fn (acc span)
                (let ([pos regions] acc
                      [lo hi] span)
                  [hi (if (< pos lo) (cons [pos lo] regions) regions)])))
          [pos regions] r)
      (narrow-to buf (reverse (if (< pos len) (cons [pos len] regions) regions))))))

;; ---- markers: edit-surviving positions --------------------------------------
;; A marker is a named char position the editing ops keep in sync as text is inserted or
;; deleted before it — so an overlay, a diagnostic, or a *remote participant's cursor*
;; tracks the same logical spot across edits (the buffers-as-processes / collaboration
;; foundation). Markers live under `:markers` ({id -> pos}); a buffer with none carries no
;; `:markers` key and is byte-identical to before this facility (the adjust step is a no-op
;; then). Gravity is left: an insert exactly AT a marker leaves it put, so text typed at one
;; cursor lands after another user's cursor sitting at the same spot.

;; Both shifts assoc only the markers that MOVE, starting from `markers` itself: an edit
;; after every marker — most keystrokes — returns the same map, where rebuilding every
;; entry through `update-vals` cost a fresh map per keystroke in any buffer with markers.
(defn- buffer-markers-shift (markers moved-to)
  (fold markers
    markers
    (fn (acc entry)
      (let ([id pos] entry
            moved (moved-to pos))
        (if (= moved pos) acc (assoc acc id moved))))))

(defn- buffer-markers-insert (markers p n)
  "Shift `markers` for an insert of `n` chars at `p`: a marker strictly after `p` moves
right by `n` (left-gravity — a marker exactly at `p` stays put)."
  (buffer-markers-shift markers (fn (pos) (if (> pos p) (+ pos n) pos))))

(defn- buffer-markers-delete (markers lo hi)
  "Shift `markers` for a delete of `[lo, hi)`: a marker at/before `lo` is unchanged, one
inside the range collapses to `lo`, one at/after `hi` moves left by the deleted width."
  (let (d (- hi lo))
    (buffer-markers-shift markers (fn (pos) (cond (<= pos lo) pos (< pos hi) lo else (- pos d))))))

(defn- buffer-adjust-markers (buf:buffer kind:keyword a:int b:int -> buffer)
  "Return `buf` with its markers shifted for an edit — `:insert` (a=pos, b=len) or `:delete`
(a=lo, b=hi) — or `buf` unchanged when it has no markers, so marker-less buffers are untouched."
  (let (m (get buf :markers))
    (if (nil? m)
      buf
      (assoc buf
        :markers
          (if (= kind :insert)
            (buffer-markers-insert m a b)
            (buffer-markers-delete m a b))))))
(defn- buffer-carry-markers (buf:buffer lo:int hi:int length:int -> buffer)
  "`buf`'s markers carried through `[lo, hi)` replaced by `length` chars — for an op that
swaps the rope itself rather than going through the editing primitives (a region undo), so
what points into the text still moves with it. The op sets the text properties itself."
  (let (cut (if (< lo hi) (buffer-adjust-markers buf :delete lo hi) buf))
    (if (> length 0) (buffer-adjust-markers cut :insert lo length) cut)))

;; ---- text properties: data that belongs to the characters (ADR-579) ---------------
;; A program's colours on its output, a link on a word, a face stamped by whoever produced
;; the text rather than derived by a mode: Emacs keeps these as TEXT PROPERTIES, and they
;; move with the characters because they belong to them. Here they live under `:properties`
;; as `{key [[start end value] …]}` — per key a vector of ascending, non-overlapping
;; half-open spans — and every editing primitive carries them in the same tail that carries
;; the markers (`buffer-apply-edit`), so no holder shifts them by hand. A buffer with none
;; carries no `:properties` key. How spans move is `editor/span-properties`; this section is
;; what a buffer does with them. Inserted text gets properties only when it comes with them (`insert` / `replace-region`'s `properties`),
;; which is how a stream's coloured chunk is appended in one edit. Undo and redo restore
;; them with the text (the snapshot holds them); the splice log records what each inserted
;; text came with, so a holder replaying it — a buffer process, another frame — ends with
;; the same properties (`buffer-edits-since`).

(defn- buffer-adjust-properties (buf:buffer kind:keyword a:int b:int -> buffer)
  "Return `buf` with its text properties carried through an edit — `:insert` (a=pos, b=len)
or `:delete` (a=lo, b=hi) — a key whose spans all went dropped, and `buf` itself when it has
none or the edit is after all of them."
  (let (property-map (get buf :properties))
    (if (nil? property-map)
      buf
      (let (carried (properties-map-carry property-map kind a b))
        (if (empty? carried) (dissoc buf :properties) (assoc buf :properties carried))))))

(defn- buffer-add-properties (buf:buffer lo:int added:map -> buffer)
  "`buf` with the normalized `added` (`{key spans}` relative to text just inserted at `lo`,
where no span of the buffer's is — an insert leaves a gap) laid in, joined to a neighbour
that continues one in the same value."
  (assoc buf :properties (properties-map-add (or (get buf :properties) {}) lo added)))

(defn buffer-property-map (buf:buffer -> map)
  "Every text property of `buf` as `{key [[start end value] …]}` — per key its ascending,
non-overlapping spans — or `{}` when it has none. What a holder ships with the text (a buffer
process's seed, another frame's copy) so the copy has them too.

    (editor/buffer/buffer-property-map (editor/buffer/make-buffer \"abc\"))   ;=> {}"
  (let (properties (get buf :properties)) (if (map? properties) properties {})))

(defn buffer-properties (buf:buffer key:any -> vector)
  "The spans `[[start end value] …]` of text property `key` in `buf`, ascending and
non-overlapping — `[]` when it has none. They are where the characters they were put on
are now: every edit carries them (ADR-579).

    (editor/buffer/buffer-properties (editor/buffer/insert (editor/buffer/insert (editor/buffer/make-buffer \"\") \"ab\" {:face [[0 2 :red]]}) \"!\") :face)   ;=> [[0 2 :red]]
    (editor/buffer/buffer-properties (editor/buffer/insert (editor/buffer/goto-char (editor/buffer/insert (editor/buffer/make-buffer \"\") \"ab\" {:face [[0 2 :red]]}) 0) \"!\") :face)   ;=> [[1 3 :red]]"
  (let (spans (get (buffer-property-map buf) key)) (if (vector? spans) spans [])))

(defn buffer-properties-in (buf:buffer key:any lo:int hi:int -> vector)
  "The spans of text property `key` that overlap `[lo, hi)`, clipped to it — what a view
painting those characters needs, found by a binary search rather than a walk of them all.

    (editor/buffer/buffer-properties-in (editor/buffer/insert (editor/buffer/make-buffer \"\") \"abcdef\" {:face [[0 2 :a] [3 6 :b]]}) :face 1 4)   ;=> [[1 2 :a] [3 4 :b]]"
  (spans-clip (buffer-properties buf key) lo hi))

;; ---- the splice log: what an edit DID, not a guess from the text -------------------
;; A holder that mirrors this buffer somewhere else — a buffer process, a collaborator, a
;; language server — has to say what changed as a positional splice. Diffing the old text
;; against the new one gets the SIZE right and the PLACE wrong in a run of equal
;; characters: typing `a` at the front of `aaa` diffs as an insert at the END, which lands a
;; collaborator's caret and every marker on the wrong side of it. It also materialises both
;; texts per keystroke. The edit primitives know exactly what they did, so they say so:
;; each logs `[rope-before rope-after lo hi repl mids properties]`, and `buffer-splices-since` replays
;; the chain.
;;
;; A RUN is one entry (ADR-466). Typing on at the end of the last splice, deleting back into
;; what it typed, or extending a run of deletions merges into the newest entry instead of
;; pushing one, so a burst of typing between two syncs is one splice rather than a log
;; overflow (a language server synced on the idle beat used to get the whole document
;; after 32 keys). `mids` keeps what a holder that synced MID-run needs: each text the run
;; passed through, as `[rope delta]` — that text is the entry's own `rope-before` with the
;; run so far applied, `delta` the length change so far — from which the rest of the run is
;; one splice (`buffer-splice-from-mid`).
;;
;; An undo or redo restores a snapshot, so no primitive edit says what changed; it logs the
;; splice the log can prove instead (`buffer-undo-splice`), and a holder keeps its exact
;; path across C-/.
;;
;; An entry also says what TEXT PROPERTIES its inserted text came with (ADR-579): a 7th
;; element, `{key [[start end value] …]}` relative to `repl`, or nil — so a holder that
;; replays the log ends with the same properties as the buffer that made it. A run of
;; appends merges whatever its chunks carry (a program's coloured output, chunk after chunk,
;; is one entry: their properties laid end to end), and a delete back into it clips them;
;; a mid-run holder's rest of the run comes with the properties of its text.
;;
;; Two entries are not text changes at all, and never merge: a REDACTION (7th element
;; `:redact`, `redact-region` — ADR-581) and a PROPERTY CHANGE (`[:put-properties width
;; changes]`, `put-properties`: `changes` sets each of its keys over `[lo, lo + width)`,
;; relative to `lo`, with `hi` = `lo` and `repl` empty, so a reader that took it for a splice
;; would change nothing). A property change keeps the text, and ropes compare by text, so the
;; log cannot order it by its rope: its entry carries a 4th element, the buffer's
;; `:property-stamp` after it, and the walk takes a property entry stamped after the copy it
;; walks back to even once it has reached that copy's text (`buffer-splice-path`).

(def *splice-log-max* 32)
;; Entries a buffer keeps — runs, not keystrokes. A holder asks once per event or per idle
;; beat; a longer history (a macro, a rectangle over many lines) falls back to a comparison
;; (`buffer-edits-between`), which is correct, merely approximate in placement.

(def *splice-run-max* 256)
;; Edits one entry merges. Bounds the texts a run keeps alive for a mid-run holder, and the
;; replacement string a run rebuilds per keystroke.

(def *splice-run-chars-max* 16384)
;; The replacement length past which a run takes no more appends: a program's output arrives
;; in chunks of kilobytes, and each merge rebuilds the run's replacement, so a run of them is
;; capped by size as well as by count.

;; The shapes the log is made of, for the checker: an entry, a mid-run text, one splice
;; (`[lo hi repl]`), and a cover (`[lo old-hi new-hi]`).
(deftype splice-entry (tuple any any int int string any any))
(deftype splice-mid (tuple any int))
(deftype splice-step (tuple int int string))
(deftype splice-cover (tuple int int int))

(defn- buffer-splice-coalesce
  (entry:splice-entry before-rope after-rope a:int b:int r:string added -> any)
  "`entry` with the edit `[a b r]` (`before-rope` → `after-rope`, its inserted text carrying
`added` — `{key spans}` relative to `r`, or nil) merged into it when the edit continues the
entry's run, else nil. The merged splice still starts from the entry's `rope-before`, and
only ever WIDENS — which is what lets `buffer-splice-from-mid` answer for every text the run
passed through. Propertied text joins a run only by appending (its properties laid behind
the run's); a delete back into the run clips the run's. A redaction or a property change
is never merged, into or onto."
  (let ([r0 r1 lo hi repl mids properties] entry
        length (string/length repl)
        end (+ lo length)
        merged (cond
                 (not (= r1 before-rope)) nil
                 (or (= properties :redact) (property-change? properties)) nil
                 (not (or (nil? added) (map? added))) nil
                 (>= (count mids) *splice-run-max*) nil
                 ;; typing on at the run's end (a replacement: typing after a deletion), or the
                 ;; next chunk of a program's output
                 (and (= a end) (= b end) (not (= r "")))
                   (when (< length *splice-run-chars-max*)
                     [lo hi (str repl r) (properties-append properties added length)])
                 (not (nil? added)) nil
                 (not (= r "")) nil
                 ;; deleting back into what the run typed
                 (and (= b end) (>= a lo) (< a b))
                   [lo
                     hi
                     (string/substring repl 0 (- a lo))
                     (properties-normalize properties (- a lo))]
                 (not (= repl "")) nil
                 ;; a run of deletions: backward, then forward
                 (and (= b lo) (< a b)) [a hi "" nil]
                 (and (= a lo) (< a b)) [lo (+ hi (- b a)) "" nil]
                 else nil))
    (when merged
      (let ([merged-lo merged-hi merged-repl merged-properties] merged)
        [r0
          after-rope
          merged-lo
          merged-hi
          merged-repl
          (cons [r1 (- length (- hi lo))] mids)
          merged-properties]))))

(defn- buffer-splice-log-push (log before-rope after-rope lo hi repl &optional properties)
  "`log` with the splice `[lo hi repl]` (`before-rope` → `after-rope`) recorded: merged into
the newest entry when it continues that entry's run, else a new entry, the oldest dropped
past `*splice-log-max*`. `properties` is what the inserted text came with, relative to
`repl` — or a property change (`[:put-properties width changes]`), an entry of its own."
  (let (log (or log ())
        merged (when (not (empty? log))
                 (buffer-splice-coalesce (first log) before-rope after-rope lo hi repl properties)))
    (if merged
      (cons merged (rest log))
      (take (cons [before-rope after-rope lo hi repl () properties] log) *splice-log-max*))))

(defn- buffer-log-edit (after:buffer before:buffer lo:int hi:int repl:string properties -> buffer)
  "`after` — `before` changed by the edit `[lo hi repl properties]` — with that edit logged.
A property change (`[:put-properties width changes]`) is stamped: the rope it leaves is the
rope it found, and ropes compare by text, so the log cannot order it by its rope as it
orders a text change; its entry carries the buffer's next `:property-stamp`, which a holder's
walk compares with the stamp its copy was taken at (`buffer-splice-path`)."
  (let (stamp (when (property-change? properties) (inc (or (get before :property-stamp) 0))))
    (assoc (if stamp (assoc after :property-stamp stamp) after)
      :splices
        (buffer-splice-log-push (or (get before :splices) ())
          (get before :rope)
          (get after :rope)
          lo
          hi
          repl
          (if stamp (conj properties stamp) properties)))))

(defn- buffer-apply-edit
  (before:buffer after:buffer kind:keyword a:int b:int repl:string &optional properties -> buffer)
  "`after` — `before` with `[lo, hi)` replaced by `repl` in its rope, where `kind`/`a`/`b`
describe the edit as `buffer-adjust-markers` reads it — with its markers, editable regions and
text properties carried, the inserted text given `properties` (`{key spans}` relative to it,
ADR-579), and the splice logged with them. The one tail every editing primitive shares."
  (let (lo a
        hi (if (= kind :insert) a b)
        added (when (= kind :insert) (properties-normalize properties (string/length repl)))
        logged (assoc after
                 :splices
                   (buffer-splice-log-push (or (get before :splices) ())
                     (get before :rope)
                     (get after :rope)
                     lo
                     hi
                     repl
                     added))
        carried (buffer-adjust-properties (buffer-adjust-editable (buffer-adjust-markers logged
                                                                    kind a b)
                                            kind a b)
                  kind a b))
    (if (nil? added) carried (buffer-add-properties carried lo added))))

(defn- buffer-splice-from-mid (lo:int hi:int repl:string properties mid:splice-mid)
  "The step `[rope lo hi repl properties]` from a text a run passed through (`mid`, `[rope
delta]`) to the run's end, the run being the splice `[lo hi repl]` of its entry, its text
carrying `properties` (relative to `repl`). That splice replaced `[lo, hi)` of the entry's
`rope-before`; in the mid text that range is `[lo, hi + delta)`, and trimming what the two
already share leaves the exact rest of the run — small, because a run is — whose text is
`repl`'s from where the shared start ends, so its properties are `repl`'s from there."
  (let ([rope delta] mid
        [same-lo same-hi changed] (%str-splice-diff (text/slice rope lo (+ hi delta))
                                    repl))
    [rope
      (+ lo same-lo)
      (+ lo same-hi)
      changed
      (properties-relative properties same-lo (+ same-lo (string/length changed)))]))

(defn- buffer-log-newer-property? (log stamp:int -> bool)
  "Whether `log` still holds a property entry stamped after `stamp`."
  (any? log
    (fn (entry)
      (let (properties (nth entry 6))
        (and (property-change? properties) (> (nth properties 3 0) stamp))))))

(defn- buffer-splice-path (from from-stamp:int to-stamp:int log target)
  "The steps `[rope-before lo hi repl properties]`, oldest first, that `log` records from the text
`from` to the text `target` (ropes), or nil when it cannot account for them. A property
change leaves the text as it was, so reaching `from` is not yet the end: every property entry
stamped after `from-stamp` (the `:property-stamp` the text `from` was taken at) is newer than
it and joins the path, however deep in the log — behind an insert and its delete, which
brought the text back to `from`'s, the walk goes on to it. `to-stamp` is `target`'s stamp:
when it is no newer than `from-stamp` no property changed since, and the first entry back at
`from`'s text ends the walk. A `from-stamp` of -1 (a snapshot, which keeps no stamp) ends
it there too, unless the entry at hand is itself a property change."
  (let (settled? (fn (log)
                   ;; nothing newer than `from` left in `log` to walk back to
                   (or (< from-stamp 0)
                     (<= to-stamp from-stamp)
                     (not (buffer-log-newer-property? log from-stamp)))))
    (letrec (walk (fn (target log acc)
                    (let (entry (when (not (empty? log)) (first log))
                          properties (when entry (nth entry 6)))
                      (cond
                        (and (= target from)
                          (if (< from-stamp 0)
                            (not (and (property-change? properties) (= (nth entry 1) target)))
                            (settled? log)))
                          acc
                        (nil? entry) nil
                        else
                          (let ([rope-before rope-after lo hi repl mids _] entry
                                ;; a property change's stamp is the log's, not the edit's
                                properties (if (property-change? properties)
                                             [(nth properties 0)
                                               (nth properties 1)
                                               (nth properties 2)]
                                             properties))
                            (if (= rope-after target)
                              (let (mid (seq/find mids (fn (m) (= (first m) from))))
                                (if (and mid (settled? (rest log)))
                                  (cons (buffer-splice-from-mid lo hi repl properties mid) acc)
                                  (walk rope-before
                                    (rest log)
                                    ;; a run that took back all it did (typed, then deleted)
                                    ;; is no step — passed only for what lies behind it
                                    (if (and (= lo hi) (= repl "") (nil? properties))
                                      acc
                                      (cons [rope-before lo hi repl properties] acc)))))
                              nil))))))
      (walk target log ()))))

(defn- buffer-path-between (before:buffer after:buffer -> (or nil list))
  "[[buffer-splice-path]] from `before`'s text and property stamp to `after`'s, through
`after`'s log."
  (buffer-splice-path (get before :rope)
    (or (get before :property-stamp) 0)
    (or (get after :property-stamp) 0)
    (or (get after :splices) ())
    (get after :rope)))

(defn buffer-splices-since (before:buffer after:buffer -> (or nil list))
  "The splices `[lo hi repl]`, oldest first, that the editing primitives made to turn
`before`'s text into `after`'s — each positioned against the text the one before it left.
A run of typing is one splice, and an undo or redo is the splice it restored. `()` when the
two hold the same text; nil when the log cannot account for the change (the text was
replaced wholesale, more history than the log keeps), for the caller to diff the texts
instead (`editor/buffer-client/text-splice`).

Exact where a diff guesses: a diff of `aaa` → `aaaa` cannot tell WHICH `a` was typed, and
this can. Costs no text but a run's own: the walk compares rope handles. A property change
(`put-properties`) is no text change and is not among them.

    (let (b (editor/buffer/make-buffer \"ab\")) (editor/buffer/buffer-splices-since b (editor/buffer/insert (editor/buffer/insert b \"x\") \"y\")))   ;=> ([0 0 \"xy\"])"
  (let (path (buffer-path-between before after))
    (when (not (nil? path))
      (reverse (fold path
                 ()
                 (fn (acc step)
                   (let ([_ lo hi repl properties] step)
                     (if (property-change? properties) acc (cons [lo hi repl] acc)))))))))

(defn buffer-edits-since (before:buffer after:buffer -> (or nil list))
  "[[buffer-splices-since]] with each splice's TEXT PROPERTIES: `[lo hi repl properties]`,
`properties` the `{key spans}` the inserted text came with, relative to `repl` (nil when
none). Two edits are not plain splices: a `redact-region` is `[lo hi \"\" :redact]`, and a
`put-properties` is `[lo lo \"\" [:put-properties width changes]]` — the text untouched,
`changes` (`{key spans}` relative to `lo`, `[]` clearing a key) set over `[lo, lo + width)`.
What a holder replaying the edits on its own copy sends (`apply-splice` takes all three), so
the copy ends with the same properties as well as the same text (ADR-579). Nil when the log
cannot account for the change; [[buffer-edits-between]] then compares instead.

    (let (b (editor/buffer/make-buffer \"ab\")) (editor/buffer/buffer-edits-since b (editor/buffer/insert b \"x\" {:face [[0 1 :red]]})))   ;=> ([0 0 \"x\" {:face [[0 1 :red]]}])
    (let (b (editor/buffer/make-buffer \"abc\")) (editor/buffer/buffer-edits-since b (editor/buffer/put-properties b :face 1 3 [[1 2 :red]])))   ;=> ([1 1 \"\" [:put-properties 2 {:face [[0 1 :red]]}]])"
  (let (path (buffer-path-between before after))
    (when (not (nil? path))
      (reverse (fold path
                 ()
                 (fn (acc step)
                   (let ([_ lo hi repl properties] step) (cons [lo hi repl properties] acc))))))))

(defn- buffer-edit-between (before:buffer after:buffer splice -> any)
  "The ONE edit `[lo hi repl properties]` that turns `before` into `after`, text and text
properties both, given `splice` — the `[lo hi repl]` that turns `before`'s text into
`after`'s, or nil when the texts are the same. The splice is widened to cover any property
it would not leave right by itself (`before`'s properties carried through it, compared with
`after`'s), and carries `after`'s properties over its new text — so a holder applying it
(`apply-splice`) ends with exactly `after`'s properties, wherever the splice cut a span.
Only properties changed: a property change (`[:put-properties width changes]`). Nothing
changed: nil. O(spans) when either has properties."
  (let (before-map (get before :properties)
        after-map (get after :properties)
        text? (and (not (nil? splice))
                (not (and (= (nth splice 0) (nth splice 1)) (= (nth splice 2) "")))))
    (if (and (nil? before-map) (nil? after-map))
      (when text? [(nth splice 0) (nth splice 1) (nth splice 2) nil])
      (let ([lo hi repl] (if text? splice [0 0 ""])
            inserted-end (+ lo (string/length repl))
            carried (if text?
                      (properties-map-replace (or before-map {}) lo hi (string/length repl))
                      (or before-map {}))
            difference (properties-difference carried (or after-map {})))
        (cond
          (not text?)
            (when difference
              (let ([from to changed] difference)
                [from
                  from
                  ""
                  [:put-properties (- to from) (properties-changes after-map from to changed)]]))
          (nil? difference) [lo hi repl (properties-relative after-map lo inserted-end)]
          else
            (let (from (math/min lo (first difference))
                  to (math/max inserted-end (second difference)))
              [from
                (+ hi (- to inserted-end))
                (check-allow :type-mismatch (text/slice (get after :rope) from to))
                (properties-relative after-map from to)]))))))

(defn- buffer-diff-edits (before:buffer after:buffer -> list)
  "The edits a comparison of `before` and `after` finds, for when the log cannot account for
the change: the minimal changed range of the text (`text/changed-range`, natively, no
string built) widened to cover any changed property ([[buffer-edit-between]]) — `()` when
nothing changed.

When `after` was REDACTED since `before` (its `:redactions` count grew) the answer is ALWAYS a
redaction, whatever the comparison found — even nothing, when the event put the very
characters back where they were: every holder must drop its history, which holds the secret.
What is redacted is the changed range joined with everything the redaction touched since
([[buffer-redaction-cover]]: where it cut, carried and widened through the edits logged after
it), and the text `after` has there is inserted after it. When the log cannot place the
redaction (more than one since `before`, or its entry fell off the log) the whole text is
redacted and inserted again (ADR-581)."
  (let (range (text/changed-range (get before :rope) (get after :rope))
        splice (when range
                 (let ([start old-end new-end] range)
                   [start old-end (text/slice (get after :rope) start new-end)]))
        edit (buffer-edit-between before after splice)
        redactions (- (or (get after :redactions) 0) (or (get before :redactions) 0)))
    (cond
      (<= redactions 0) (if (nil? edit) () (list edit))
      else
        (let (
              ;; `[lo old-hi new-hi]`: before's `[lo, old-hi)` became after's `[lo, new-hi)`
              changed (cond
                        (nil? edit) nil
                        (property-change? (nth edit 3))
                          (let (to (+ (nth edit 0) (nth (nth edit 3) 1))) [(nth edit 0) to to])
                        else (let ([lo hi repl _] edit) [lo hi (+ lo (string/length repl))]))
              cover (when (= redactions 1) (buffer-redaction-cover after))
              [lo old-hi new-hi] (buffer-redaction-range before after changed cover)
              redaction [lo old-hi "" :redact])
          (if (< lo new-hi)
            (list redaction
              [lo
                lo
                (text/slice (get after :rope) lo new-hi)
                (properties-relative (get after :properties) lo new-hi)])
            (list redaction))))))

(defn- buffer-redaction-range (before:buffer after:buffer changed:any cover:any -> splice-cover)
  "`[lo old-hi new-hi]`: the stretch `[lo, old-hi)` of `before` that became `[lo, new-hi)` of
`after` and holds both the `changed` range (`[lo old-hi new-hi]`, nil when the texts are the
same) and the redaction's `cover` (`[lo hi]` of `after`, nil when the log cannot place it:
then the whole text)."
  (cond
    (nil? cover) [0 (buffer-length before) (buffer-length after)]
    ;; the same text: before's positions are after's
    (nil? changed) [(first cover) (second cover) (second cover)]
    else
      (let ([changed-lo changed-old-hi changed-new-hi] changed
            new-hi (math/max changed-new-hi (second cover)))
        ;; past the changed range, after is before shifted
        [(math/min changed-lo (first cover)) (- new-hi (- changed-new-hi changed-old-hi)) new-hi])))

(defn- buffer-redaction-cover (after:buffer -> (or nil (tuple int int)))
  "`[lo hi]`: the stretch of `after`'s text holding everything its last redaction touched —
where it cut, carried and widened through every text edit logged after it (a property change
moves nothing) — or nil when its log does not start with a redaction (none, or it fell off).
A redaction leaves itself alone in the log ([[buffer-redact]]), so it is the oldest entry."
  (let (oldest-first (reverse (or (get after :splices) ()))
        oldest (when (not (empty? oldest-first)) (first oldest-first)))
    (when (and oldest (= (nth oldest 6) :redact))
      (let (cut (nth oldest 2)
            steps (fold (rest oldest-first)
                    [[cut cut ""]]
                    (fn (acc entry)
                      (let ([_ _ lo hi repl _ properties] entry)
                        (if (property-change? properties) acc (conj acc [lo hi repl])))))
            [cover-lo _ cover-hi] (buffer-splices-cover steps))
        [cover-lo cover-hi]))))

(defn buffer-edits-between (before:buffer after:buffer -> list)
  "The edits `[lo hi repl properties]` that turn `before` into `after`, always: the log's
own ([[buffer-edits-since]]) when it accounts for the change, else what a comparison finds —
the minimal changed range of the text, widened to cover any changed property and carrying
`after`'s properties over its new text, so a holder's copy ends with the same text AND
properties and nothing outside the range moves. A redaction between the two always arrives
as one (`:redact`), the log's or the comparison's (ADR-581). What a holder of a copy sends
another (`editor/buffer-client/link-propagate-buffers`).

    (editor/buffer/buffer-edits-between (editor/buffer/make-buffer \"abc\") (editor/buffer/make-buffer \"abXc\"))   ;=> ([2 2 \"X\" nil])"
  (let (edits (buffer-edits-since before after))
    (if (nil? edits) (buffer-diff-edits before after) edits)))

(defn- buffer-cover-of (step:splice-step -> splice-cover)
  "The cover of one splice: `[lo, hi)` of the text before it became `[lo, lo + |repl|)`."
  (let ([lo hi repl] step) [lo hi (+ lo (string/length repl))]))

(defn- buffer-cover-step (cover:splice-cover step:splice-step -> splice-cover)
  "`cover` widened by the next splice `step`: still one range of the first splice's text that
became one range of the text after `step`. A position outside the cover maps across
by the cover's length change; one inside it widens to the cover's edge."
  (let ([cover-lo restored-hi current-hi] cover
        [lo hi repl] step
        added (string/length repl)
        shift (- current-hi restored-hi)
        restored-hi-of (cond
                         (<= hi cover-lo) hi
                         (>= hi current-hi) (- hi shift)
                         else restored-hi)
        through (cond
                  (<= current-hi lo) current-hi
                  (>= current-hi hi) (+ current-hi (- added (- hi lo)))
                  else (+ lo added)))
    [(math/min cover-lo lo) (math/max restored-hi restored-hi-of) (math/max through (+ lo added))]))

(defn buffer-splices-cover (splices -> (or nil splice-cover))
  "`[lo old-hi new-hi]`: the one stretch `[lo, old-hi)` of the text before `splices` that
became `[lo, new-hi)` of the text after them — everything before it unchanged, everything
after it shifted. `splices` are `[lo hi repl]`, oldest first, each positioned against the text
the one before it left (what [[buffer-splices-since]] answers). Nil for none.

The shape `text/changed-range` answers, at the cost of the edits rather than a compare of
two texts: a cache keyed on a rope (`editor/highlight`'s line cache) can be told what changed
by the buffer that made the change.

    (editor/buffer/buffer-splices-cover [[2 4 \"xyz\"] [0 0 \"a\"]])   ;=> [0 4 6]
    (editor/buffer/buffer-splices-cover [])   ;=> nil"
  (when (not (empty? splices))
    (fold (rest splices) (buffer-cover-of (first splices)) buffer-cover-step)))

(defn- buffer-undo-splice (buf restored-rope)
  "Whether `buf`'s log reaches `restored-rope` — an undo or redo target — and the splice it
proves: `[splice]` when it does, `splice` the single `[lo hi repl]` that turns `buf`'s text
into the restored one (nil when the two texts are the same: the path held only property
changes), nil when it does not reach. The log's path runs FROM the restored text TO the
current one; the covering range of its text splices, re-read from the restored text and
trimmed to what actually differs, reverses all of it at once."
  ;; a snapshot keeps no stamp: every property change in reach counts as newer than it,
  ;; which only lengthens the path by changes the cover leaves out anyway
  (let (path (buffer-splice-path restored-rope
               -1
               (or (get buf :property-stamp) 0)
               (or (get buf :splices) ())
               (get buf :rope)))
    (when (not (empty? path))
      (let (text-steps (seq/reject path (fn (step) (property-change? (nth step 4)))))
        (if (empty? text-steps)
          [nil]
          ;; The cover: `[cover-lo, restored-hi)` of the restored text became
          ;; `[cover-lo, current-hi)` of the current one.
          (let ([cover-lo restored-hi current-hi] (buffer-splices-cover (map text-steps
                                                                          (fn (step)
                                                                            (let ([_ lo hi repl _] step)
                                                                              [lo hi repl]))))
                [same-lo same-hi changed] (%str-splice-diff (text/slice (get buf :rope)
                                                              cover-lo current-hi)
                                            (text/slice restored-rope cover-lo restored-hi)))
            [[(+ cover-lo same-lo) (+ cover-lo same-hi) changed]]))))))

(defn- buffer-log-restore (before after)
  "`after` — `before` with a snapshot restored — with the edit that restore made logged, when
the log can say what it was: the text splice widened to whatever text properties it gives
back ([[buffer-edit-between]]), or a property change when the restore gave back only
properties — so a holder replaying an undo of `put-properties` changes no text either.

When the log cannot say, a restore that changed the text leaves a holder's walk nowhere to go
(its text is in no entry) and it compares; one that gave back only PROPERTIES would leave the
same text, which the walk would take for no change, so it logs a barrier — a property entry
with no text before it, which no walk passes."
  (let (reached (buffer-undo-splice before (get after :rope)))
    (cond
      (not (nil? reached))
        (let ([lo hi repl properties] (or (buffer-edit-between before after (first reached))
                                        [0 0 "" nil]))
          (buffer-log-edit after before lo hi repl properties))
      (= (get before :properties) (get after :properties)) after
      else
        (let (stamp (inc (or (get before :property-stamp) 0)))
          (assoc after
            :property-stamp stamp
            :splices
              (buffer-splice-log-push (or (get before :splices) ())
                nil
                (get after :rope)
                0
                0
                ""
                [:put-properties 0 {} stamp]))))))

(defn insert (buf:buffer s:string &optional (properties nil) -> buffer)
  "Insert string `s` at point; point advances past it. Recorded for undo. Markers after the
insertion point shift with the text. Throws if `buf` is read-only.

`properties` — `{key [[start end value] …]}`, spans relative to `s` — are the TEXT
PROPERTIES the inserted text comes with (ADR-579): Emacs's `insert` of a propertized string.
Without them the new text has none, even inserted inside a span (the span splits around it).

    (editor/buffer/buffer-text (editor/buffer/insert (editor/buffer/goto-char (editor/buffer/make-buffer \"hello world\") 5) \",\"))   ;=> \"hello, world\"
    (editor/buffer/buffer-properties (editor/buffer/insert (editor/buffer/make-buffer \"ab\") \"xy\" {:face [[0 1 :red]]}) :face)   ;=> [[0 1 :red]]"
  (buffer-barf-if-read-only buf)
  (if (= (string/length s) 0)
    buf
    (let (p (get buf :point)
          _ (buffer-barf-if-protected-insert buf p)
          buf (buffer-record-change buf))
      (buffer-apply-edit buf
        (assoc buf :rope (text/insert (get buf :rope) p s) :point (+ p (string/length s)) :mark nil)
        :insert p
        (string/length s)
        s
        properties))))

(defn delete-char (buf:buffer &optional (n:int 1) -> buffer)
  "Delete `n` user-perceived characters *after* point — whole grapheme clusters (ADR-422);
point stays put. Recorded for undo (a no-op at end-of-buffer is not recorded). Throws if
`buf` is read-only.

    (editor/buffer/buffer-text (editor/buffer/delete-char (editor/buffer/make-buffer \"abc\")))   ;=> \"bc\""
  (buffer-barf-if-read-only buf)
  (let (p (get buf :point)
        end (text/forward-graphemes (get buf :rope) p (math/max n 0)))
    (if (= p end)
      buf
      (let (_ (buffer-barf-if-protected-delete buf p end)
            buf (buffer-record-change buf))
        (buffer-apply-edit buf
          (assoc buf :rope (text/delete (get buf :rope) p end) :mark nil)
          :delete p
          end
          "")))))

(defn delete-backward-char (buf:buffer &optional (n:int 1) -> buffer)
  "Delete `n` user-perceived characters *before* point (backspace) — whole grapheme clusters
(ADR-422); point moves back with it. Recorded for undo (a no-op at point 0 is not recorded).
Throws if `buf` is read-only.

    (editor/buffer/buffer-text (editor/buffer/delete-backward-char (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"abc\"))))     ;=> \"ab\"
    (editor/buffer/buffer-text (editor/buffer/delete-backward-char (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"abc\")) 2))   ;=> \"a\""
  (buffer-barf-if-read-only buf)
  (let (p (get buf :point)
        start (text/backward-graphemes (get buf :rope) p (math/max n 0)))
    (if (= p start)
      buf
      (let (_ (buffer-barf-if-protected-delete buf start p)
            buf (buffer-record-change buf))
        (buffer-apply-edit buf
          (assoc buf :rope (text/delete (get buf :rope) start p) :point start :mark nil)
          :delete start
          p
          "")))))

(defn insert-pair (buf:buffer open:string close:string -> buffer)
  "Insert `open` and `close` at point with point between them — the electric half of a
bracket key: `(` types `()` and leaves you inside. One undo unit.

    (let (b (editor/buffer/insert-pair (editor/buffer/make-buffer \"\") \"(\" \")\")) [(editor/buffer/buffer-text b) (editor/buffer/buffer-point b)])   ;=> [\"()\" 1]"
  (backward-char (insert buf (str open close)) (string/length close)))

(defn delete-empty-pair (buf:buffer open:string close:string -> buffer)
  "When point sits between `open` and `close` with nothing in between — `(|)` — delete
both, else `buf` unchanged. The backspace half of an electric bracket key: what typing
`(` put there, one backspace takes away, so a pair is never left half-deleted. Callers
fall through to `delete-backward-char` on the unchanged buffer.

    (editor/buffer/buffer-text (editor/buffer/delete-empty-pair (editor/buffer/insert-pair (editor/buffer/make-buffer \"\") \"(\" \")\") \"(\" \")\"))   ;=> \"\""
  (if (and (= (buffer-char-before buf) open) (= (buffer-char-after buf) close))
    (undo-group buf
      (fn (b) (delete-char (delete-backward-char b (string/length open)) (string/length close))))
    buf))

(defn delete-region (buf)
  "Delete the text between point and mark; point moves to the region start and
the mark is cleared. A no-op (returns `buf`, unrecorded) if no mark is set or the
region is empty. Recorded for undo (restoring it brings back the mark too). Throws if
`buf` is read-only.

    (editor/buffer/buffer-text (editor/buffer/delete-region (editor/buffer/goto-char (editor/buffer/set-mark (editor/buffer/goto-char (editor/buffer/make-buffer \"abcdef\") 1)) 4)))   ;=> \"aef\""
  (buffer-barf-if-read-only buf)
  (let (b (buffer-region-bounds buf))
    (if (nil? b)
      buf
      (let ([lo hi] b)
        (if (= lo hi)
          (assoc buf :mark nil)
          (let (_ (buffer-barf-if-protected-delete buf lo hi)
                buf (buffer-record-change buf))
            (buffer-apply-edit buf
              (assoc buf :rope (text/delete (get buf :rope) lo hi) :point lo :mark nil)
              :delete lo
              hi
              "")))))))

(defn- buffer-delete-range (buf:buffer lo:int hi:int -> buffer)
  "`buf` with the characters `[lo, hi)` deleted and point at `lo` — CHARACTERS, not grapheme
clusters: a splice names char offsets, and counting clusters from `lo` took a combining
mark's base and the character after it. `lo`/`hi` are already clamped, `lo <= hi`."
  (if (= lo hi)
    (goto-char buf lo)
    (let (_ (buffer-barf-if-protected-delete buf lo hi)
          recorded (buffer-record-change buf))
      (buffer-apply-edit recorded
        (assoc recorded :rope (text/delete (get recorded :rope) lo hi) :point lo :mark nil)
        :delete lo
        hi
        ""))))

(defn replace-region (buf:buffer start:int end:int s:string &optional (properties nil) -> buffer)
  "Replace the characters in `[start, end)` with string `s`, leaving point just after
the inserted text. The splice primitive: completion-at-point, comment toggling,
query-replace, re-indentation, and transpose are all this. A delete of exactly those
characters (clamped into the buffer; an `end` before `start` deletes nothing) and an
`insert` inside one `undo-group`: a single undo puts the old text back, never the half-way
state with the range deleted and nothing inserted. Read-only and narrowing refuse it as
they refuse those.

`properties` (`{key spans}` relative to `s`) are the text properties the new text comes
with, as for [[insert]].

    (editor/buffer/buffer-text (editor/buffer/replace-region (editor/buffer/make-buffer \"hello world\") 0 5 \"goodbye\"))   ;=> \"goodbye world\"
    (editor/buffer/buffer-text (editor/buffer/replace-region (editor/buffer/make-buffer (str \"e\" (string/int->char 769) \"x\")) 0 2 \"Q\"))   ;=> \"Qx\""
  (buffer-barf-if-read-only buf)
  (let (length (buffer-length buf)
        lo (buffer-clamp 0 length start)
        hi (math/max lo (buffer-clamp 0 length end)))
    (undo-group buf (fn (b) (insert (buffer-delete-range b lo hi) s properties)))))

(defn buffer-replace-text (buf:buffer text:string -> buffer)
  "`buf` holding `text`, as ONE undoable edit of its own, point where it was (clamped) and
any narrowing kept: `buf` itself when the text is already `text`. A read-only buffer takes
it too. What a revert needs, so a file read back costs none of the history before it.

    (editor/buffer/buffer-text (editor/buffer/undo (editor/buffer/buffer-replace-text (editor/buffer/make-buffer \"old\") \"new\")))   ;=> \"old\""
  (if (= text (buffer-text buf))
    buf
    ;; through the mutators, so markers, the edit log a held parse is updated from and the
    ;; history all see one edit; widened for it, and its own step, never merged into typing
    (let (open (dissoc (assoc buf :undo-amalgamate false) :editable)
          ;; point stays where it was, clamped: not after the new text
          replaced (goto-char (replace-region open 0 (buffer-length open) text)
                     (math/min (buffer-point buf) (string/length text)))
          restored (if (contains? buf :editable)
                     (assoc replaced :editable (get buf :editable))
                     replaced))
      ;; the step's snapshot is of the WIDENED buffer: undo would leave it writable, so it
      ;; is the buffer as it was, narrowing and all
      (if (get buf :undo-disabled)
        restored
        (assoc restored :undo (cons (buffer-snapshot buf) (rest (get restored :undo))))))))

(defn- property-change-range (buf:buffer lo:int width:int -> (tuple int int))
  "`[from to]`: the range `[lo, lo + width)` a property change names, clamped into `buf`."
  (let (length (buffer-length buf)
        from (buffer-clamp 0 length lo))
    [from (math/max from (buffer-clamp 0 length (+ lo width)))]))

(defn apply-splice (buf:buffer lo:int hi:int repl:string &optional (properties nil) -> buffer)
  "`buf` with a splice ANOTHER holder made — `[lo, hi)` replaced by `repl`, with the text
`properties` it came with — applied whatever this copy's narrowing or read-only state:
the text is already changed where it is authoritative (a buffer process, a collaborator),
and a copy that refused it would diverge. Emacs's `inhibit-read-only` for process output.
The narrowing is kept, carried through the splice as an edit carries it; recorded for undo
like any edit.

The two edits that are not plain splices ([[buffer-edits-since]]) apply as what they are:
`:redact` for `properties` redacts `[lo, hi)` — this copy's history and splice log go with
it, nothing of the text kept even for an edit, and an EMPTY range still drops them (the
history may hold the secret wherever the owner's cut fell, ADR-581) — and a property change
(`[:put-properties width changes]`) sets `changes` over `[lo, lo + width)` without touching
the text, recorded for undo.

    (editor/buffer/buffer-text (editor/buffer/apply-splice (editor/buffer/set-read-only (editor/buffer/make-buffer \"abc\") true) 3 3 \"d\"))   ;=> \"abcd\""
  (cond
    (= properties :redact) (buffer-redact buf lo hi true)
    (property-change? properties)
      (let ([_ width changes] properties
            [from to] (property-change-range buf lo width)
            normalized (properties-changes-normalize changes (- to from))
            current (buffer-property-map buf)
            updated (properties-with-changes current from to normalized))
        (if (or (= from to) (= updated current))
          buf
          (buffer-commit-properties buf from to normalized updated)))
    else
      (let (regions (get buf :editable)
            replaced (replace-region (dissoc buf :editable) lo hi repl properties))
        (if (or (nil? regions) (empty? regions))
          (if (nil? regions) replaced (assoc replaced :editable regions))
          (let (length (buffer-length buf)
                from (buffer-clamp 0 length lo)
                to (math/max from (buffer-clamp 0 length hi))
                narrowed (assoc replaced :editable regions)
                cut (if (< from to) (buffer-adjust-editable narrowed :delete from to) narrowed))
            (if (= repl "") cut (buffer-adjust-editable cut :insert from (string/length repl))))))))

(defn put-properties (buf:buffer key:any lo:int hi:int spans:seqable -> buffer)
  "`buf` with text property `key` over `[lo, hi)` set to `spans` (`[[start end value] …]` in
buffer offsets, clipped to the range; `[]` removes `key` there) — Emacs's
`set-text-properties` for one property. The other keys over the range are kept.

A PROPERTY change, not a text change: the text, point, mark, markers and narrowing stay
exactly where they were. Still an edit in every other sense — undo takes it back, a read-only
buffer refuses it (as Emacs's refuses a property change), and the splice log records it as a
property entry (`[:put-properties width changes]`, ADR-579) that a holder replaying the log
applies to its own copy without touching its text (`buffer-edits-since`); a text consumer
never sees it (`buffer-splices-since`). Unchanged properties change nothing.

    (editor/buffer/buffer-properties (editor/buffer/put-properties (editor/buffer/make-buffer \"abcdef\") :face 1 5 [[2 4 :red]]) :face)   ;=> [[2 4 :red]]"
  (let (length (buffer-length buf)
        from (buffer-clamp 0 length lo)
        to (math/max from (buffer-clamp 0 length hi)))
    (if (= from to)
      buf
      (let (relative (map spans
                       (fn (span)
                         (let ([start end value] span) [(- start from) (- end from) value])))
            changes (properties-changes-normalize {key relative} (- to from))
            current (buffer-property-map buf)
            updated (properties-with-changes current from to changes))
        (if (= updated current)
          buf
          (do
            (buffer-barf-if-read-only buf)
            (buffer-barf-if-protected-delete buf from to)
            (buffer-commit-properties buf from to changes updated)))))))

(defn- buffer-commit-properties (buf:buffer from:int to:int changes:map updated:map -> buffer)
  "`buf` with its text properties now `updated` — `changes` (`{key spans}` relative to `from`)
set over `[from, to)` — as an EDIT that leaves the text alone: recorded for undo, logged as a
property entry ([[buffer-log-edit]]), nothing moved."
  (let (recorded (buffer-record-change buf))
    (buffer-log-edit (if (empty? updated)
                       (dissoc recorded :properties)
                       (assoc recorded :properties updated))
      buf
      from
      from
      ""
      [:put-properties (- to from) changes])))

;; ---- redaction: text removed with every trace of it (ADR-581) -------------------------
;; A password typed ahead into a shell's input before its prompt was recognised went into the
;; buffer as ordinary typing: every keystroke a snapshot on `:undo`, a splice in the log, a
;; copy in every frame's buffer. Moving it out with `replace-region` recorded one more, so one
;; undo brought `Password: hun` back. What the owner needs is the delete that leaves NO trace:
;; the history before it may hold any prefix of the text, so it goes with it.
;;
;; The splice log keeps nothing from before it either: a redaction leaves its own entry alone
;; in the log, naming no rope from before the cut, so no holder can walk back past it. A
;; holder that synced before the redaction finds the change by comparison instead
;; (`buffer-edits-between`), and `:redactions` — the count of redactions a buffer has had —
;; tells that comparison a redaction happened, so it ALWAYS sends one: the changed range
;; joined with what the redaction touched (its entry, at the bottom of the log, carried
;; through the edits after it), even when the event put the same characters back. An
;; `undo-group` around one does not bring the history back, and the ropes a buffer keeps
;; beside its text (the saved baseline, annotations) go too (`buffer-forget-ropes`).

(defn- buffer-forget-ropes (buf:buffer -> buffer)
  "`buf` without the ropes it keeps BESIDE its text that a redaction may have taken text out
of: the saved baseline (`:saved-rope` — the buffer counts as modified from here on, which it
is) and every annotation's (`annotate` — the annotation goes stale, as it would after any
edit). Its history and log are the redaction's own to drop."
  (let (unsaved (if (nil? (get buf :saved-rope)) buf (assoc buf :saved-rope nil)))
    (fold (keys unsaved)
      unsaved
      (fn (acc key)
        (let (value (get acc key))
          (if (and (map? value) (rope? (get value :rope)) (contains? value :lines))
            (assoc acc key (assoc value :rope nil))
            acc))))))

(defn- buffer-redact (buf:buffer lo:int hi:int &optional (even-empty:bool false) -> buffer)
  "[[redact-region]]'s work, the owner's and a copy applying another holder's redaction
(`apply-splice`) alike: the log is left with the redaction alone, naming no text from before
it, and no rope the buffer keeps holds the redacted characters — not its history, not its
saved baseline, not an annotation ([[buffer-forget-ropes]]). An empty range is no edit,
unless `even-empty` — a copy told of a redaction drops its history whatever range reached it
(its history may hold the secret, wherever the owner's cut fell)."
  (let (length (buffer-length buf)
        from (buffer-clamp 0 length lo)
        to (math/max from (buffer-clamp 0 length hi)))
    (if (and (= from to) (not even-empty))
      buf
      (let (cut (if (= from to) buf (assoc (buffer-delete-traced buf from to) :modified true)))
        (assoc (buffer-forget-ropes cut)
          :undo ()
          :pending-undo ()
          :undo-size 0
          :undo-amalgamate false
          :redactions (inc (or (get buf :redactions) 0))
          ;; the entry names no text to walk back to: a holder comparing from before the
          ;; redaction finds the change by `buffer-edits-between`, which redacts too
          :splices (list [nil (get cut :rope) from to "" () :redact]))))))

(defn- buffer-delete-traced (buf:buffer from:int to:int -> buffer)
  "`buf` with `[from, to)` (already clamped) deleted whatever its narrowing or read-only
state, point, mark, markers, text properties and the narrowing carried as for any edit —
[[buffer-redact]]'s delete, before it drops every trace of it."
  (let (regions (get buf :editable)
        open (dissoc buf :editable)
        carry (fn (position:int)
                (cond
                  (<= position from) position
                  (< position to) from
                  else (- position (- to from))))
        deleted (buffer-apply-edit open
                  (assoc open
                    :rope (text/delete (get open :rope) from to)
                    :point (carry (buffer-point open))
                    :mark (let (mark (buffer-mark open)) (when (int? mark) (carry mark))))
                  :delete from
                  to
                  "")
        narrowed (cond
                   (nil? regions) deleted
                   (empty? regions) (assoc deleted :editable regions)
                   else (buffer-adjust-editable (assoc deleted :editable regions) :delete from to)))
    narrowed))

(defn redact-region (buf:buffer lo:int hi:int -> buffer)
  "`buf` with the characters `[lo, hi)` deleted and every trace of them gone: the undo
history is dropped (any snapshot before the delete may hold part of the text — a password
typed one key at a time leaves a snapshot per key), none is recorded for the delete, and the
splice log records the delete as a redaction (`[lo hi \"\" :redact]` from
`buffer-edits-between`), so a holder replaying it (a buffer process, another frame) redacts
its copy too instead of recording the delete in its own history. The log keeps nothing from
before it — no rope holding the redacted text stays in memory — so a holder comparing from
before the redaction finds the change by `buffer-edits-between`, which redacts too. An
`undo-group` around it drops the history too. Point, mark, markers, text properties and the
narrowing are carried as for any edit; a read-only or narrowed buffer is redacted all the
same (the owner removes its own text). Emacs has no single call for it: `read-passwd` keeps
the text out of the buffer in the first place.

    (editor/buffer/buffer-text (editor/buffer/undo (editor/buffer/redact-region (editor/buffer/insert (editor/buffer/end-of-buffer (editor/buffer/make-buffer \"pw: \")) \"hun\") 4 7)))   ;=> \"pw: \""
  (buffer-redact buf lo hi))

;; ---- public marker API ------------------------------------------------------

(defn buffer-marker-set (buf:buffer id:any pos:int -> buffer)
  "Set marker `id` (any value — a keyword, a participant pid) to char position `pos`
(clamped into the buffer). The marker then survives edits: text inserted or deleted before
it shifts it, so it tracks the same logical spot. The basis for overlays, diagnostics, and
remote participants' cursors on a shared buffer.

    (editor/buffer/buffer-marker (editor/buffer/insert (editor/buffer/buffer-marker-set (editor/buffer/make-buffer \"abc\") :m 2) \"zz\") :m)   ;=> 4"
  (assoc buf
    :markers (assoc (or (get buf :markers) {}) id (buffer-clamp 0 (buffer-length buf) pos))))

(defn buffer-marker (buf:buffer id:any -> (or nil int))
  "The char position of marker `id` (clamped to the current length), or nil if unset.

    (editor/buffer/buffer-marker (editor/buffer/make-buffer \"abc\") :m)   ;=> nil"
  (let (p (get (or (get buf :markers) {}) id))
    (if (nil? p) nil (buffer-clamp 0 (buffer-length buf) p))))

(defn buffer-marker-delete (buf:buffer id:any -> buffer)
  "Remove marker `id`. A no-op if it (or any marker) isn't set.

    (editor/buffer/buffer-markers (editor/buffer/buffer-marker-delete (editor/buffer/buffer-marker-set (editor/buffer/make-buffer \"abc\") :m 2) :m))   ;=> {}"
  (let (m (get buf :markers))
    (if (nil? m) buf (assoc buf :markers (dissoc m id)))))

(defn buffer-markers (buf)
  "The marker map `{id -> pos}` (positions clamped to the current length), or `{}` if none.

    (editor/buffer/buffer-markers (editor/buffer/buffer-marker-set (editor/buffer/make-buffer \"abc\") :m 2))   ;=> {:m 2}"
  (update-vals (or (get buf :markers) {}) (fn (pos) (buffer-clamp 0 (buffer-length buf) pos))))

;; ---- annotations: derived data stamped with the text it describes -------------
;; A tool that computes something ABOUT a buffer — per-line test verdicts, a diff
;; gutter, breakpoints, inline eval results — has to answer two questions before it
;; renders: is this still about the text on screen, and are the LINES still where
;; they were? Every consumer was hand-rolling the same triple of fields (the value,
;; the rope it was computed from, the line count at the time) and re-deriving the
;; same two comparisons, which is how one of them silently drifted. So the pairing
;; lives here, next to the rope and the line count it is made of.
;;
;; `:current?` is the positional question (the line count is unchanged, so a
;; line-keyed annotation still points at the right lines — blank it when false);
;; `:stale?` is the content question (the text moved at all, so the value predates
;; your edit — dim it, don't hide it, and undoing back un-dims it).

;; check-allow: the checker is RIGHT and the suppression is the contract, not a shrug.
;; `key` is `any`, so `(assoc buf key …)` could in principle name one of the buffer's own
;; fields (`:point`, `:rope`, …) and store a `{:value :rope :lines}` map there — which would
;; genuinely stop being a `buffer`. That is what "yields map" is reporting. Callers pass an
;; ANNOTATION name, never a field name, and the return really is a buffer for every such
;; call; the type system has no way to say "a keyword that is not one of these", so the
;; alternative would be weakening the declared return to `map` and losing it for the
;; callers that chain buffer operations onto the result.
;;
;; The hazard it names is real but latent. Removing it rather than declaring it would mean
;; nesting annotations under one reserved key, so a collision becomes impossible — a change
;; to the stored shape and to `annotation`, deliberately not made here.
(check-allow :type-mismatch
  (defn annotate (buf key value)
    "Stamp derived `value` onto `buf` under `key`, together with the rope and line
count it describes. Read it back with `annotation`.

`key` must not be one of the buffer's own fields — it names an annotation, and a field
name would overwrite the buffer's own state.

    (editor/buffer/annotation-value (editor/buffer/annotate (editor/buffer/make-buffer \"a\\nb\") :lint [1 2]) :lint)   ;=> [1 2]"
    (assoc buf
      key
        {:value value
         :rope (buffer-rope buf)
         :lines (buffer-line-count buf)}))
  (sig annotate (buffer any any -> buffer)))
(defn annotation (buf key)
  "The annotation stored under `key` as `{:value :current? :stale?}`, or nil when
there is none. `:current?` — the line count still matches, so line-keyed data is
positionally valid. `:stale?` — the text has changed since, so the value is older
than what you see.

    (editor/buffer/annotation (editor/buffer/make-buffer \"a\") :lint)   ;=> nil
    (get (editor/buffer/annotation (editor/buffer/insert (editor/buffer/annotate (editor/buffer/make-buffer \"a\") :lint 7) \"z\") :lint) :stale?)   ;=> true"
  (let (a (get buf key))
    (when (map? a)
      {:value (get a :value)
       :current? (= (buffer-line-count buf) (get a :lines))
       :stale? (not (= (buffer-rope buf) (get a :rope)))})))

(defn annotation-value (buf key)
  "The annotated value under `key` **only while it is positionally current**, else
nil — the common case for line-keyed data a renderer would otherwise misplace.

    (editor/buffer/annotation-value (editor/buffer/annotate (editor/buffer/make-buffer \"a\") :lint 7) :lint)   ;=> 7
    (editor/buffer/annotation-value (editor/buffer/insert (editor/buffer/annotate (editor/buffer/make-buffer \"a\") :lint 7) \"\\n\") :lint)   ;=> nil"
  (let (a (annotation buf key))
    (when (and a (:current? a)) (:value a))))

;; ---- line-wise region ops (the scaffold for comment / indent-region / …) -----

(defn region-line-range (buf)
  "The inclusive `[startline endline]` line span to act on: the lines the region
covers when a mark is set, else the current line twice. A region ending exactly at a
line's start does **not** pull that trailing line in (Emacs's line-wise convention).

    (editor/buffer/region-line-range (editor/buffer/goto-char (editor/buffer/set-mark (editor/buffer/make-buffer \"a\\nb\\nc\")) 4))   ;=> [0 1]"
  (let (rb (buffer-region-bounds buf))
    (if (nil? rb)
      (let (l (buffer-current-line buf)) [l l])
      (let ([lo hi] rb
            sl (buffer-current-line (goto-char buf lo))
            elraw (buffer-current-line (goto-char buf hi))
            hicol (- hi (text/line->char (buffer-rope buf) elraw)))
        [sl (if (and (> elraw sl) (= hicol 0)) (dec elraw) elraw)]))))

(defn map-region-lines (buf:any f: (any any -> any) -> any)
  "Fold `(f buf line)` over each line in `buf`'s `region-line-range`, threading the
buffer through — the scaffold for line-wise commands (comment, indent-region, …).
`f` must not add or remove lines (line numbers stay valid across the fold). Returns
the resulting buffer.

    (editor/buffer/buffer-text (editor/buffer/map-region-lines (editor/buffer/goto-char (editor/buffer/set-mark (editor/buffer/make-buffer \"a\\nb\\nc\")) 4) (fn (b line) (editor/buffer/insert (editor/buffer/goto-char b (text/line->char (editor/buffer/buffer-rope b) line)) \"#\"))))   ;=> \"#a\\n#b\\nc\""
  (let ([sl el] (region-line-range buf))
    (fold (range sl (inc el)) buf f)))

;; ---- splice transforms: concurrent edits without a CRDT ----------------------
;; Two participants typing inside one round-trip window each compute a splice against
;; text the other's edit hasn't reached yet. For DISJOINT spans the fix is exact and
;; tiny: shift the later splice by the earlier one's length delta (operational
;; transformation's easy half). Ambiguous cases — spans that touch or overlap — are
;; left to the caller's policy (the buffer process falls back to an authoritative
;; placement; a client falls back to resyncing from the process).

(defn splice-disjoint? (a b)
  "Whether splices `a`/`b` (`[lo hi …]`) touch nothing in common — STRICTLY apart, so
even boundary-touching (an insert exactly at the other's edge) counts as ambiguous.

    (editor/buffer/splice-disjoint? [0 2 \"x\"] [5 6 \"\"])   ;=> true
    (editor/buffer/splice-disjoint? [0 2 \"x\"] [2 3 \"\"])   ;=> false"
  (or (< (nth a 1) (nth b 0)) (> (nth a 0) (nth b 1))))

(defn splice-transform (splice applied)
  "Transform `splice` `[lo hi repl]` — computed against text that did NOT yet contain
`applied` `[alo ahi alen]` (a replace of `[alo, ahi)` by `alen` chars) — so it lands
correctly on the text that DOES. Disjoint-before shifts by `applied`'s length delta;
disjoint-after is untouched; an overlap degrades to inserting `repl` just after
`applied`'s replacement (the deterministic authoritative choice — the span it meant
to delete no longer exists as written).

    (editor/buffer/splice-transform [5 6 \"x\"] [0 2 4])   ;=> [7 8 \"x\"]
    (editor/buffer/splice-transform [0 1 \"x\"] [3 4 0])   ;=> [0 1 \"x\"]"
  (let ([lo hi repl] splice
        [alo ahi alen] applied
        delta (- alen (- ahi alo)))
    (cond
      (<= ahi lo) [(+ lo delta) (+ hi delta) repl]
      (>= alo hi) splice
      else (let (p (+ alo alen)) [p p repl]))))

(defn splice-transform-all (splice:any applieds:seqable -> any)
  "`splice` transformed over each of `applieds` in order (oldest first).

    (editor/buffer/splice-transform-all [5 6 \"x\"] [[0 2 4] [0 0 1]])   ;=> [8 9 \"x\"]"
  (fold applieds splice (fn (sp a) (splice-transform sp a))))
