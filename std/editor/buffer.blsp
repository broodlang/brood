;; std/editor/buffer.blsp — the editor framework's buffer model.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - A BUFFER is an immutable value (a map) holding a rope plus cursor state.
;;    Every operation returns a *fresh* buffer (ADR-026) — nothing mutates. This
;;    is the pure, trivially-testable core of the editor toolkit (M2, ADR-045).
;;  - Text lives in a `rope` (the kernel's one editor primitive); all of the
;;    point / mark / region / movement *policy* here is pure Brood over it.
;;  - A buffer is process-local because its rope is: you never `send` a buffer
;;    (or its rope) across processes. `spawn-buffer` makes a thin actor that OWNS
;;    one and replies only with *derived views* (text, lines, positions) — never
;;    the buffer or rope themselves. That reply-with-views boundary is the seed
;;    of the display protocol (M3).
;;  - This module is NOT part of the language: it is opt-in (`require`), never in
;;    the prelude, and adds zero kernel surface — pure Brood over rope primitives.
;;
;; Char indices are 0-based, like the rope primitives. `point` is a char index in
;; [0, length]; `mark` is a char index or nil. Lines are 0-based; a line's text
;; (`buffer-line-at`) includes its trailing newline, matching `text/line`.

(defmodule editor/buffer
  "An immutable text buffer for building editors, written in Brood over the rope
primitives (ADR-045). A *buffer* is a **record** (so `buffer?` is an identity check, and
a buffer is never `=` to a look-alike map) whose fields are:

    {:rope <rope> :point <int> :mark <int|nil> :name <string> :file <string|nil>
     :undo (<snapshot>…) :pending-undo (<snapshot>…)}

Every operation is pure — movement and editing return a **fresh** buffer; nothing
mutates (ADR-026). `point` is the cursor (a char index); `mark`, with point,
delimits the region. Each editing op records the pre-edit state on `:undo` (a stack
of `{:rope :point :mark}` snapshots); undo is an Emacs-style *tree* (undoing is itself
recorded, so no state is ever lost) — see the undo section below.

    (def b (-> (make-buffer \"hello world\")
               (goto-char 5) (insert \",\") end-of-line))
    (buffer-text b)            ; => \"hello, world\"

Because a buffer holds a rope, and ropes are **process-local**, a buffer cannot
cross a process boundary. `spawn-buffer` makes a process that *owns* a buffer and
serves edits/queries, replying only with derived views (strings, positions) —
never the buffer itself. Drive it with `buffer-edit` / `buffer-query`."
  (:use map))

;; ---- helpers ----------------------------------------------------------------

(defn- buffer-clamp
  (lo hi x)
  "Clamp `x` into the inclusive range [lo, hi]."
  (math/max lo (math/min hi x)))

(defn- buffer-line-end-col
  (buf line)
  "The column at the end of `line` — its length excluding any trailing newline.
Where `end-of-line` lands and the rightmost column point can hold on that line."
  (let (lt (text/line (get buf :rope) line))
    (if (string/ends-with? lt "\n") (dec (string/length lt)) (string/length lt))))

;; ---- construction -----------------------------------------------------------
;;
;; A buffer is a RECORD, so its type is its identity rather than "a map that happens to
;; hold a rope under `:rope`" — `buffer?` can't be fooled by a look-alike, a buffer never
;; compares `=` to a bare map, and it prints as `#<buffer …>` instead of dumping the whole
;; rope and undo history. Every op still `assoc`es (a record IS a map), and `assoc`
;; preserves the identity, so a buffer stays a buffer through the whole pipeline —
;; including the extra keys other layers stamp on (`:markers`, `:type`, `:layers`).
;;
;; The generated field accessors are re-defined below with docstrings.

(defrecord buffer (rope point mark name file undo pending-undo))

(defn make-buffer (text &optional (name "*scratch*") (file nil))
  "A fresh buffer holding `text`, with point at 0, no mark, and an empty undo history.
`name` is a label (default `\"*scratch*\"`); `file` is the backing path or nil."
  (buffer (text/from-string text) 0 nil name file () ()))

(defn buffer? (x)
  "True if `x` is a buffer value — by record identity, not by shape."
  (and (record? x) (= (record-id x) :editor/buffer/buffer)))

;; A buffer's display form is a short identification — never its text: a buffer can hold
;; a megabyte of rope plus an undo history, and `io/puts`ing that (or seeing it in an
;; error message) is never what was wanted. `inspect` adds point/mark for debugging.
(impl display
  editor/buffer/buffer
  (->string [b] (str "#<buffer " (get b :name) " " (text/length (get b :rope)) " chars>")))

(impl inspectable
  editor/buffer/buffer
  (inspect [b]
    (str "#<buffer "
      (get b :name)
      " "
      (text/length (get b :rope))
      " chars"
      " point="
      (get b :point)
      (if (get b :mark) (str " mark=" (get b :mark)) "")
      (if (get b :file) (str " file=" (get b :file)) "")
      ">")))

(defn buffer-from-file (path)
  "Read the file at `path` into a fresh buffer, with `:file` set to `path` so
`save-buffer` can write it back."
  (make-buffer (file/slurp path) path path))

(defn find-file-buffer (path)
  "Open `path` for editing, vim/emacs `find-file` style: its contents if the file
exists, else a fresh *empty* buffer — either way backed by `path`, so `save-buffer`
writes it (creating the file for a new path). Visiting a missing path starts an
unsaved buffer rather than erroring."
  (if (file/exists? path) (buffer-from-file path) (make-buffer "" path path)))

(defn save-buffer (buf)
  "Write `buf`'s text to its `:file`; raise if it has none. Returns `buf`."
  (let (f (get buf :file))
    (if (nil? f)
      (error "save-buffer: buffer has no file: " (get buf :name))
      (do (file/spit f (buffer-text buf)) buf))))

;; ---- reads ------------------------------------------------------------------

(defn buffer-rope (buf) "The buffer's underlying rope (process-local)." (get buf :rope))
(defn buffer-text (buf) "The buffer's full text as a string." (text/->string (get buf :rope)))
(defn buffer-point (buf) "The cursor position (a char index)." (get buf :point))
(defn buffer-mark (buf) "The mark (a char index), or nil if unset." (get buf :mark))
(defn buffer-name (buf) "The buffer's name." (get buf :name))
(defn buffer-file (buf) "The buffer's backing file path, or nil." (get buf :file))
(defn read-only? (buf)
  "True if `buf` is marked read-only — its mutators (`insert`, `delete-char`,
`delete-backward-char`, `delete-region`, `replace-region`) refuse to change it.
Unset/false on a fresh buffer (`make-buffer` builds freely)."
  (= (get buf :read-only) true))
(defn buffer-length (buf) "The number of characters in the buffer." (text/length (get buf :rope)))
(defn buffer-line-count (buf)
  "The number of lines in the buffer."
  (text/line-count (get buf :rope)))

(defn buffer-line-at (buf line)
  "The text of `line` (0-based), including its trailing newline (like `text/line`)."
  (text/line (get buf :rope) line))

(defn buffer-current-line (buf)
  "The 0-based line index that point is on."
  (text/char->line (get buf :rope) (get buf :point)))

(defn buffer-column (buf)
  "The 0-based column of point — characters from the start of its line."
  (let (rope (get buf :rope))
    (- (get buf :point) (text/line->char rope (text/char->line rope (get buf :point))))))

(defn buffer-char-after (buf)
  "The single-character string just after point, or nil at end of buffer."
  (let (p (get buf :point))
    (if (< p (buffer-length buf)) (text/slice (get buf :rope) p (inc p)) nil)))

(defn buffer-char-before (buf)
  "The single-character string just before point, or nil at start of buffer."
  (let (p (get buf :point))
    (if (> p 0) (text/slice (get buf :rope) (dec p) p) nil)))

(defn buffer-region-bounds (buf)
  "The region's char bounds as `[lo hi]` (lo ≤ hi, point and mark in either order),
or nil if no mark is set. The half-open span `[lo, hi)` the view highlights and
`delete-region`/`buffer-region` act on."
  (let (m (get buf :mark))
    (if (nil? m) nil (let (p (get buf :point)) [(math/min p m) (math/max p m)]))))

(defn buffer-region (buf)
  "The text between point and mark (in either order), or nil if no mark is set."
  (let (b (buffer-region-bounds buf))
    (if (nil? b)
      nil
      (let ([lo hi] b) (text/slice (get buf :rope) lo hi)))))

;; ---- movement (returns a fresh buffer with point moved) ---------------------

(defn goto-char (buf n)
  "Point moved to char index `n`, clamped to [0, length]."
  (assoc buf :point (buffer-clamp 0 (buffer-length buf) n)))

(defn forward-char (buf &optional (n 1))
  "Point moved `n` characters forward (clamped)."
  (goto-char buf (+ (get buf :point) n)))

(defn backward-char (buf &optional (n 1))
  "Point moved `n` characters backward (clamped)."
  (goto-char buf (- (get buf :point) n)))

(defn beginning-of-line (buf)
  "Point moved to the first character of its current line."
  (let (rope (get buf :rope))
    (goto-char buf (text/line->char rope (text/char->line rope (get buf :point))))))

(defn end-of-line (buf)
  "Point moved to the end of its current line (before the trailing newline)."
  (let (rope (get buf :rope)
        line (text/char->line rope (get buf :point)))
    (goto-char buf (+ (text/line->char rope line) (buffer-line-end-col buf line)))))

(defn forward-line (buf &optional (n 1))
  "Point moved `n` lines forward (negative = backward), keeping the column where
the target line is long enough. Clamps to the buffer's line range."
  (let (rope (get buf :rope)
        col (buffer-column buf)
        target (buffer-clamp 0
                 (dec (text/line-count rope))
                 (+ (text/char->line rope (get buf :point)) n))
        line-start (text/line->char rope target))
    (goto-char buf (+ line-start (math/min col (buffer-line-end-col buf target))))))

(defn backward-line (buf &optional (n 1))
  "Point moved `n` lines backward (see `forward-line`)."
  (forward-line buf (- n)))

(defn beginning-of-buffer (buf) "Point moved to the start of the buffer." (goto-char buf 0))
(defn end-of-buffer (buf)
  "Point moved to the end of the buffer."
  (goto-char buf (buffer-length buf)))

;; ---- word motion (M-f / M-b) ------------------------------------------------
;; A word is a run of non-delimiter, non-whitespace chars (same notion as the
;; line editor's M-f/M-b). Forward skips any non-word chars then the word;
;; backward is the mirror. Pure scans over the buffer text.

(defn- buffer-word-char?
  (c)
  "True if `c` is part of a word (not whitespace or a delimiter) — matches the
line editor's M-f/M-b notion of a word."
  (not (or (= c " ")
         (= c "\t")
         (= c "\n")
         (= c "(")
         (= c ")")
         (= c "[")
         (= c "]")
         (= c "{")
         (= c "}")
         (= c "\"")
         (= c ";")
         (= c ","))))

(defn- buffer-scan-fwd
  (text i n pred)
  "Smallest index ≥ `i` (up to `n`) whose char fails `pred` — advance while `pred`."
  (if (or (>= i n) (not (pred (string/char-at text i)))) i (buffer-scan-fwd text (inc i) n pred)))

(defn- buffer-scan-bwd
  (text i pred)
  "Largest index ≤ `i` (down to 0) whose preceding char fails `pred` — retreat while `pred`."
  (if (or (<= i 0) (not (pred (string/char-at text (dec i)))))
    i
    (buffer-scan-bwd text (dec i) pred)))

(defn forward-word (buf)
  "Point moved to the end of the next word forward (skip non-word chars, then the word)."
  (let (text (buffer-text buf)
        n (string/length text)
        i (buffer-scan-fwd text (get buf :point) n (fn (c) (not (buffer-word-char? c)))))
    (goto-char buf (buffer-scan-fwd text i n buffer-word-char?))))

(defn backward-word (buf)
  "Point moved to the start of the previous word backward (skip non-word chars, then the word)."
  (let (text (buffer-text buf)
        i (buffer-scan-bwd text (get buf :point) (fn (c) (not (buffer-word-char? c)))))
    (goto-char buf (buffer-scan-bwd text i buffer-word-char?))))

;; ---- indentation motion (M-m) -----------------------------------------------
;; Lives here rather than with the line motions above because it shares the word
;; section's `buffer-scan-fwd` walk — it's `beginning-of-line` with the indent skipped.

(defn back-to-indentation (buf)
  "Point moved to the first non-whitespace character of its current line — the
indentation skipped (Emacs `back-to-indentation`, M-m). Lands at the line's end when
the line is blank or all whitespace."
  (let (bol (beginning-of-line buf)
        eol (get (end-of-line bol) :point))
    (goto-char bol
      (buffer-scan-fwd (buffer-text bol) (get bol :point) eol buffer-horizontal-space?))))

;; ---- paragraph motion (M-{ / M-}) -------------------------------------------
;; A paragraph is a run of non-blank lines bounded by blank (empty / whitespace-only)
;; lines. Forward motion skips any blank lines then the paragraph, landing at the next
;; blank separator (or end of buffer); backward is the mirror, landing at the
;; paragraph's first line. Pure line scans over the rope.

(defn- buffer-line-blank?
  (buf line)
  "True if buffer `line` is empty or whitespace-only (a paragraph separator)."
  (string/blank? (buffer-line-at buf line)))

(defn- buffer-scan-lines
  (buf line n step want-blank?)
  "First line index walking from `line` by `step` (±1, within `[0, n)`) whose
blankness differs from `want-blank?`; stops at the buffer edge."
  (if (or (< line 0) (>= line n) (not (= (buffer-line-blank? buf line) want-blank?)))
    line
    (buffer-scan-lines buf (+ line step) n step want-blank?)))

(defn forward-paragraph (buf)
  "Point moved to the start of the next blank line after the current paragraph (end of
buffer if none) — Emacs `forward-paragraph` (M-})."
  (let (rope (get buf :rope)
        n (text/line-count rope)
        line (text/char->line rope (get buf :point))
        ; skip leading blank lines
        afterblank (buffer-scan-lines buf line n 1 true)
        boundary (buffer-scan-lines buf afterblank n 1 false))
    ; skip the paragraph
    (goto-char buf (if (>= boundary n) (buffer-length buf) (text/line->char rope boundary)))))

(defn backward-paragraph (buf)
  "Point moved to the start of the current/previous paragraph (start of buffer if none)
— Emacs `backward-paragraph` (M-{)."
  (let (rope (get buf :rope)
        n (text/line-count rope)
        line (text/char->line rope (get buf :point))
        ;; step back over blank lines directly above, then over the paragraph's lines.
        afterblank (buffer-scan-lines buf (dec line) n -1 true)
        start (buffer-scan-lines buf afterblank n -1 false))
    (goto-char buf (text/line->char rope (math/max 0 (if (< start 0) 0 (inc start)))))))

;; ---- sentence motion (M-a / M-e) --------------------------------------------
;; A sentence ends at `.`/`?`/`!`, any closing quotes/brackets, then whitespace or the
;; end of the text — ONE space is enough (Emacs' `sentence-end-double-space` off, which
;; is what people set it to). Both motions are bounded by the enclosing paragraph, so
;; they never run past a blank line — the same containment Emacs gives them.

(def- buffer-sentence-enders (list "." "?" "!"))
(def- buffer-sentence-closers (list "\"" "'" ")" "]" "}"))

(defn- buffer-sentence-space? (c) (or (= c " ") (= c "\t") (= c "\n")))

(defn- buffer-sentence-closers-end
  (text i n)
  "Index past the run of closing quotes/brackets at `i` — what may sit between a
sentence's terminator and the whitespace after it (`he said \"stop.\"`)."
  (if (or (>= i n) (not (includes? buffer-sentence-closers (string/char-at text i))))
    i
    (buffer-sentence-closers-end text (inc i) n)))

(defn- buffer-sentence-end-at
  (text i n)
  "Index just past a sentence ending AT `i` — a terminator, its closing quotes/brackets,
then whitespace or `n` — or nil when `i` doesn't end a sentence."
  (if (not (includes? buffer-sentence-enders (string/char-at text i)))
    nil
    (let (j (buffer-sentence-closers-end text (inc i) n))
      (if (or (>= j n) (buffer-sentence-space? (string/char-at text j))) j nil))))

(defn- buffer-scan-sentence-fwd
  (text i limit)
  "Index just past the first sentence end at or after `i`, capped at `limit` (the
paragraph's end); `limit` when the paragraph holds no further sentence end."
  (if (>= i limit)
    limit
    (let (e (buffer-sentence-end-at text i limit))
      (if (nil? e) (buffer-scan-sentence-fwd text (inc i) limit) (math/min e limit)))))

(defn- buffer-sentence-start-before
  (text i limit best)
  "The greatest sentence start `< limit`, scanning forward from `i` and carrying `best`
(seeded with the paragraph start). A sentence start is the paragraph start, or the index
just past a sentence end with the whitespace after it skipped."
  (let (e (if (>= i limit) nil (buffer-sentence-end-at text i limit)))
    (cond
      (>= i limit) best
      (nil? e) (buffer-sentence-start-before text (inc i) limit best)
      else
        (let (s (buffer-scan-fwd text e limit buffer-sentence-space?))
          (if (>= s limit) best (buffer-sentence-start-before text s limit s))))))

(defn forward-sentence (buf)
  "Point moved just past the end of the current sentence — the paragraph's end when it
holds no further sentence terminator (Emacs `forward-sentence`, M-e)."
  (let (point (get buf :point)
        limit (math/max point (get (forward-paragraph buf) :point)))
    (goto-char buf (buffer-scan-sentence-fwd (buffer-text buf) point limit))))

(defn backward-sentence (buf)
  "Point moved to the start of the current sentence — the previous sentence's start when
point already sits at one, the paragraph's start when there is no earlier sentence
(Emacs `backward-sentence`, M-a)."
  (let (point (get buf :point)
        floor (math/min point (get (backward-paragraph buf) :point)))
    (goto-char buf (buffer-sentence-start-before (buffer-text buf) floor point floor))))

;; ---- mark -------------------------------------------------------------------

(defn set-mark (buf)
  "Set the mark at point (with point, this delimits the region)."
  (assoc buf :mark (get buf :point)))
(defn clear-mark (buf) "Clear the mark." (assoc buf :mark nil))

;; ---- mark ring (a history of marks; the substrate for C-u C-SPC) ------------

; like Emacs `mark-ring-max`
(def *mark-ring-max* 16)
(defn push-mark (buf)
  "Set the mark at point **and** push point onto the buffer's `:mark-ring` (bounded
by `*mark-ring-max*`, newest first). The ring records where the mark has been so
`pop-mark` can revisit prior locations."
  (let (p (get buf :point))
    (assoc buf
      :mark p
      :mark-ring (take *mark-ring-max* (cons p (or (get buf :mark-ring) ()))))))

(defn pop-mark (buf)
  "Move point to the newest entry on the buffer's `:mark-ring`, rotating that entry
to the back so repeated calls cycle through the ring (Emacs `pop-to-mark-command`).
A no-op when the ring is empty."
  (let (ring (or (get buf :mark-ring) ()))
    (if (empty? ring)
      buf
      (assoc buf
        :point (buffer-clamp 0 (buffer-length buf) (first ring))
        :mark-ring (append (rest ring) (list (first ring)))))))

;; ---- search (pure position queries; the caller moves point) -----------------

(defn buffer-search-forward (buf needle from)
  "The char index of the first occurrence of `needle` in `buf`'s text at or after
`from`, or nil if there is none. Pure — it does not move point; the caller composes
`goto-char`/`set-mark`. The forward primitive incremental search rides on."
  (let (i (index-of (buffer-text buf) needle from))
    (if (< i 0) nil i)))

(defn buffer-search-backward (buf needle before)
  "The char index of the last occurrence of `needle` in `buf`'s text whose start is
strictly before `before`, or nil if there is none. The backward counterpart of
`buffer-search-forward`."
  (let (i (last-index-of (buffer-text buf) needle before))
    (if (< i 0) nil i)))

;; ---- undo (an undo *tree*, Emacs-style) -------------------------------------
;;
;; Undo rides the immutable buffer for free: a snapshot is the edit-mutable triple
;; `{:rope :point :mark}` (ropey shares structure, so a snapshot is O(1)). `:undo` is
;; the history — a stack of snapshots, newest first — and each editing op pushes its
;; PRE-edit snapshot (only when the text really changes, so undo has no dead steps).
;;
;; The twist that makes it a *tree*, not a one-way stack (Emacs `undo`): **undoing is
;; itself recorded as a change.** `undo-next` restores the next state AND pushes the
;; current one onto `:undo`, so an undo can itself be undone (= redo), and editing
;; after some undos leaves the undone states on `:undo` as a branch you can still
;; reach. No state is ever lost.
;;
;; `:pending-undo` is the tail of `:undo` the current undo run walks down. The caller
;; (the editor's cmd-undo / cmd-redo) calls `undo-start` to begin a fresh run — pointed
;; at the front of `:undo`, which after a run holds the just-undone states, so a fresh
;; run *reverses direction* (redo). Continuing the run (not restarting) keeps direction.
;; A snapshot excludes the history fields so snapshots don't nest and grow geometrically.

(defn- buffer-snapshot
  (buf)
  "The restorable edit state of `buf` — `{:rope :point :mark}` (no history), plus `:markers`
and `:read-only-spans` when the buffer has any. Both are snapshot-restored like `point`/`mark`
(not re-derived), so undo/redo return them to their recorded positions instead of stranding
them at the post-edit spot — protected spans revert in lockstep with the text they guard. A
buffer with neither omits the key, staying identical to before those facilities."
  (let (base {:rope (get buf :rope) :point (get buf :point) :mark (get buf :mark)}
        m (get buf :markers)
        s (get buf :read-only-spans)
        base (if m (assoc base :markers m) base))
    (if s (assoc base :read-only-spans s) base)))

(defn amalgamate-undo (buf)
  "Make the **next** editing op amalgamate into the current undo group rather than start
a new one: its pre-edit snapshot is dropped, so undo treats the run as a single step.
A one-shot flag (cleared by the next edit). By default every op is its own undo step; the
editor's command loop calls this to coalesce a typing / deletion run (or a multi-edit
command) into one undo, the Emacs way — keeping this primitive's default simple."
  (assoc buf :undo-amalgamate true))

(defn- buffer-push-undo
  (buf)
  "Record `buf`'s pre-edit state for undo — called by an editing op before it changes the
text. Normally conses a fresh snapshot onto `:undo` (each op its own undo step); when
`amalgamate-undo` armed the one-shot `:undo-amalgamate` (and there's a group to merge
into) it drops this op's snapshot so the run undoes as one. A no-op when undo is disabled
(`disable-undo`). (Does not touch `:pending-undo`: the next undo run starts fresh anyway —
the editor restarts it whenever the previous command wasn't an undo.)"
  (cond
    (get buf :undo-disabled) buf
    (and (get buf :undo-amalgamate) (not (empty? (get buf :undo))))
      (assoc buf
        :undo-amalgamate false)
    else
      (assoc buf
        :undo (cons (buffer-snapshot buf) (or (get buf :undo) ()))
        :undo-amalgamate false)))

(defn disable-undo (buf)
  "Turn off undo recording for `buf` and drop any existing history. For a log / output
buffer (e.g. `*Messages*`) where undo is meaningless and would otherwise grow without
bound — editing ops on the result record nothing, so undo stays a no-op. Like Emacs
`buffer-disable-undo`."
  (assoc buf :undo-disabled true :undo () :pending-undo ()))

(defn- buffer-restore
  (buf snap)
  "Restore the `{:rope :point :mark}` (and `:markers`, `:read-only-spans`) of `snap` into
`buf`, keeping `buf`'s history. Markers and protected spans are restored to the snapshot's
recorded positions; a snapshot without them drops the key so that state stays as it was."
  (let (b (assoc buf :rope (get snap :rope) :point (get snap :point) :mark (get snap :mark))
        m (get snap :markers)
        b (cond
            m (assoc b :markers m)
            (get b :markers) (dissoc b :markers)
            else b)
        s (get snap :read-only-spans))
    (cond
      s (assoc b :read-only-spans s)
      (get b :read-only-spans) (dissoc b :read-only-spans)
      else b)))

(defn undo-start (buf)
  "Begin a fresh undo run: point `:pending-undo` at the whole `:undo` history. Because
each `undo-next` records the state it leaves onto `:undo`, a run started after some undos
walks the *reverse* direction — i.e. it redoes."
  (assoc buf :pending-undo (get buf :undo)))

(defn undo-next (buf)
  "One step of the current undo run: restore the next snapshot in `:pending-undo`,
recording the current state onto `:undo` (so this very step is itself reversible) and
advancing `:pending-undo`. A no-op (returns `buf`) when the run is exhausted."
  (let (p (get buf :pending-undo))
    (if (empty? p)
      buf
      (assoc (buffer-restore buf (first p))
        :undo (cons (buffer-snapshot buf) (or (get buf :undo) ()))
        :pending-undo (rest p)))))

;; ---- undo in a region: undo only the lines you selected ----------------------
;; Emacs's `undo-in-region`, and it costs almost nothing here — because of what
;; snapshot undo already is. Emacs must maintain a change LOG to know which edits
;; touched your selection; we keep whole previous texts instead, and the change set
;; between two texts is exactly what a line diff computes. So selective undo needs no
;; new undo representation at all: derive the changes on demand (`diff/lines`),
;; keep the ones that fall inside the region, and drop the rest.
;;
;; Reading a diff of OLD -> NEW as "what the user did":
;;   [:keep l]    unchanged      -> keep it, whatever the region says
;;   [:insert l]  they added l   -> inside the region, undo means DROP it
;;   [:delete l]  they removed l -> inside the region, undo means PUT IT BACK
;; One fold with a current-line counter, and the region test is on the CURRENT side,
;; because that is the text the user selected in.
;;
;; Granularity is the LINE (that is the unit a line diff — and the user's "these
;; lines" — speaks in); a whole-buffer region reproduces a plain undo exactly.

(defn- undo-common-prefix
  (a b i)
  ;; how many leading chars `a` and `b` share — bounds the char diff to what changed
  (if (or (>= i (string/length a))
        (>= i (string/length b))
        (not= (string/char-at a i) (string/char-at b i)))
    i
    (undo-common-prefix a b (inc i))))

(defn- undo-common-suffix
  (a b lo k)
  ;; how many trailing chars they share, never eating into the shared prefix `lo`
  (let (la (string/length a) lb (string/length b))
    (if (or (>= k (- la lo))
          (>= k (- lb lo))
          (not= (string/char-at a (- la k 1)) (string/char-at b (- lb k 1))))
      k
      (undo-common-suffix a b lo (inc k)))))

(def *undo-region-char-budget* 4000)
;; The largest changed SPAN (in chars) a region undo will diff character-by-character.
;; The LCS diff is O(n²) in time and space, so an unbounded char diff on a huge rewrite
;; would hang the editor; past this the span is treated as one change (undone whole if it
;; overlaps the region). Typical edits trim to a handful of chars, so this is never hit
;; in practice — it exists so the pathological case degrades instead of freezing.

(defn- undo-hunk-chars
  (hunk tag)
  (apply str (seq/keep (fn (op) (let ([t c] op) (when (= t tag) c))) hunk)))

(defn- undo-flush-chunk
  (hunk n lo hi out)
  ;; One CHUNK — a run of consecutive changed characters — is one change, and Emacs's
  ;; rule is that a change is undone when it OVERLAPS the region. An insertion occupies
  ;; `[n, n+len)` in the current text, so it overlaps when it starts before `hi` and ends
  ;; after `lo`; a deletion occupies no current characters, so it counts when its
  ;; position sits inside the region. Overlapping -> emit the OLD characters (undone);
  ;; otherwise the NEW ones (the change stands). `n` always advances by the characters
  ;; the current text really has there.
  (let (adds (undo-hunk-chars hunk :insert)
        dels (undo-hunk-chars hunk :delete)
        na (string/length adds)
        overlap (if (> na 0)
                  (and (< n hi) (> (+ n na) lo))
                  (and (>= n lo) (<= n hi)))
        emit (if overlap dels adds))
    [(+ n na) (cons emit out)]))

(defn- undo-region-restore
  (old new lo hi)
  "The text you get by undoing, in `new`, only the changes (vs `old`) that OVERLAP the
character range `[lo, hi]` — everything else keeps `new`'s version. Character-precise,
like Emacs's `undo-in-region`: half of a line, or one of two edits on the same line, is
exactly what you get.

Cheap despite being character-level: the shared prefix and suffix are trimmed first, so
the diff only ever runs over the span that actually changed."
  (let (pre (undo-common-prefix old new 0)
        suf (undo-common-suffix old new pre 0)
        o-mid (string/substring old pre (- (string/length old) suf))
        n-mid (string/substring new pre (- (string/length new) suf))
        head (string/substring new 0 pre)
        tail (string/substring new (- (string/length new) suf) (string/length new)))
    (cond
      ;; nothing changed
      (and (= o-mid "") (= n-mid "")) new
      ;; too large to diff character-wise: treat the whole span as one change
      (> (math/max (string/length o-mid) (string/length n-mid)) *undo-region-char-budget*)
        (if (and (< pre
                   hi)
              (> (+ pre
                   (string/length n-mid))
                lo))
          (str head
            o-mid tail)
          new)
      else
        (let (ops (diff/seq (string/->list o-mid) (string/->list n-mid))
              r (fold (fn (acc op)
                        (let ([n out hunk] acc
                              [tag c] op)
                          (if (= tag :keep)
                            (let ([n2 out2] (undo-flush-chunk hunk n lo hi out))
                              [(inc n2) (cons c out2) '()])
                            [n out (append hunk (list op))])))
                  [pre '() '()]
                  ops)
              [n out hunk] r
              [_ out2] (undo-flush-chunk hunk n lo hi out))
          (str head (apply str (reverse out2)) tail)))))

(defn- undo-region-candidate
  (buf lo hi snaps depth)
  ;; The nearest snapshot whose changes actually touch the region: `[undone-text tail]`,
  ;; where `tail` is the history BELOW the snapshot we used. Walking back matters because
  ;; the most recent edit may have been somewhere else entirely and "undo my selection"
  ;; should still find the last thing that happened *there* (Emacs skips the same way);
  ;; returning the tail is what lets a repeat peel the NEXT change off the same lines
  ;; instead of bouncing against the entry this undo just pushed. nil when nothing in
  ;; reach touched the region.
  (let (text (buffer-text buf))
    (cond
      (or (empty? snaps) (<= depth 0)) nil
      ;; A snapshot a region undo itself pushed is not a candidate: it holds the text we
      ;; just came from, so taking it would REDO the change instead of peeling the next
      ;; one off. Skipping it is what makes repeated calls walk backwards.
      (get (first snaps) :region-undo) (undo-region-candidate buf lo hi (rest snaps) (dec depth))
      else
        (let (old (text/->string (get (first snaps) :rope))
              undone (undo-region-restore old text lo hi))
          (if (= undone text)
            (undo-region-candidate buf lo hi (rest snaps) (dec depth))
            [undone (rest snaps)])))))

(def *undo-region-search-depth* 200)
;; How far back a region undo will look for a change that touched the region. Bounded
;; so a long history can't turn one keystroke into an unbounded scan.

(defn undo-in-region (buf)
  "Undo, restricted to the buffer's REGION (point↔mark): the most recent change that
touched those lines is reverted and everything outside them is left exactly as it is.
Returns `buf` unchanged when there is no region, no history, or nothing in reach
touched the region.

The region survives, so repeated calls keep peeling changes off the same lines — and
the step itself is an ordinary undo entry, so a plain `undo` afterwards takes the
whole thing back."
  (let (bounds (buffer-region-bounds buf))
    (if (or (nil? bounds) (empty? (or (get buf :undo) ())))
      buf
      (let ([lo hi] bounds
            found (undo-region-candidate buf
                    lo
                    hi
                    (get buf :undo)
                    *undo-region-search-depth*))
        (if (nil? found)
          buf
          ;; record the pre-state (so this is itself undoable), then swap the text.
          ;; Point is clamped; the MARK is kept so the region stays live for a repeat.
          (let ([undone tail] found
                pushed (buffer-push-undo buf)
                rope (text/from-string undone))
            (assoc pushed
              :rope rope
              ;; the consumed change is dropped from history and OUR pre-state sits on
              ;; top, so a plain `undo` still takes this step back while another region
              ;; undo continues backwards through the same lines.
              :undo (cons (assoc (first (get pushed :undo)) :region-undo true) tail)
              :point (math/min (get buf :point) (text/length rope))
              :mark (math/min (get buf :mark) (text/length rope)))))))))

(defn undo (buf)
  "A standalone single undo: begin a fresh run and take one step. The editor's repeat
behaviour — continue a run vs. restart after a non-undo command (which is what turns a
fresh run into a redo) — lives in cmd-undo / cmd-redo, which call `undo-start` /
`undo-next` directly."
  (undo-next (undo-start buf)))

;; ---- editing (returns a fresh buffer; records undo; clears the mark) ---------
;;
;; Edits clear the mark rather than try to track it across the change — the
;; simple, safe choice for v1 (a smarter mark-adjustment can come later if the
;; editor app needs it). `delete-region` clears it by definition. Each op records
;; an undo snapshot (see above) only when it actually changes the text.

(defn set-read-only (buf flag)
  "Mark `buf` read-only (`flag` truthy) or writable. While read-only, the text
mutators throw `\"buffer is read-only\"` (Emacs's `buffer-read-only` signal) — point
and mark still move, so the buffer stays navigable. Build the contents *before*
flipping this on (construction never checks the flag), the way a generated report
or `special-mode` buffer does."
  (assoc buf :read-only (if flag true false)))

;; The signal every read-only refusal raises: a structured error tagged `:kind :read-only`
;; (the canonical error-map shape — `error-message` still returns the `:message`, so a plain
;; `(catch e (error-message e))` reads unchanged). A consumer that wants to turn a refusal
;; into a graceful no-op matches `(= (:kind e) :read-only)` rather than the message text, so
;; the wording can change without breaking the handler.
(defn- buffer-read-only-error
  (message)
  (throw {:kind :read-only :message message}))

(defn- buffer-barf-if-read-only
  (buf)
  "Throw if `buf` is read-only — the guard every text mutator runs first, so the
read-only contract lives in the model (no consumer has to remember to check). Returns
`buf` unchanged when writable, for use as a guard expression."
  (if (read-only? buf) (buffer-read-only-error "buffer is read-only") buf))

;; ---- partial read-only: protected spans -------------------------------------
;; Whole-buffer `read-only?` is all-or-nothing. A FORM buffer wants the opposite grain:
;; most of the text is generated and untouchable, a few spans are the user's to edit — a
;; shell prompt whose input line is yours; a commit-message buffer whose `#` help block
;; must survive; a tutorial whose prose explains and whose code boxes you may break.
;; `:read-only-spans` holds the protected ranges as `[lo hi)` half-open pairs (plain data,
;; so a form buffer rides collab/hosting like any other buffer value).
;;
;; Enforced at the SAME choke point as the whole-buffer flag — every mutator asks before it
;; touches the rope — so protection holds on every edit path by CONSTRUCTION (key, mouse,
;; held-key repeat, keyboard macro, a programmatic edit), never a reactive after-the-fact
;; comparison a caller can forget to run.
;;
;; The spans travel with edits (INWARD gravity, `buffer-adjust-spans`): text inserted at a
;; span's edge lands OUTSIDE it, in the neighbouring editable text (a span's left edge shifts
;; when `lo >= p`, its right edge only when `hi > p`), and a delete confined to editable text
;; slides the spans past it. So once set the spans stay correct across edits with no
;; recomputation, and a form re-stamps them only when it regenerates its text.

(defn read-only-spans (buf)
  "The protected `[lo hi)` spans of `buf`, clamped to its length and with empties dropped
(`()` if none). Chars inside a span can be neither inserted-into nor deleted; everything
else edits normally even while these are set. Orthogonal to the whole-buffer `read-only?`
flag, which still refuses the buffer entire."
  (let (len (buffer-length buf))
    (seq/keep (fn (s)
                (let ([lo hi] s
                      l (buffer-clamp 0 len lo)
                      h (buffer-clamp 0 len hi))
                  (when (< l h) [l h])))
      (or (get buf :read-only-spans) '()))))

(defn set-read-only-spans (buf spans)
  "Mark `spans` (a list of `[lo hi)` pairs) read-only in `buf`, replacing any prior set;
`()` clears them. Stored as given and normalised on read (`read-only-spans`). Build the text
first, then stamp — like `set-read-only`, construction never checks the spans."
  (assoc buf :read-only-spans (into [] spans)))

(defn- span-covers?
  (spans pos)
  ;; is the CHAR at `pos` inside a protected span
  (seq/find (fn (s) (let ([lo hi] s) (and (>= pos lo) (< pos hi)))) spans))

(defn position-read-only? (buf pos)
  "True when the char at `pos` falls inside a protected span (or the whole buffer is
read-only) — what the editor asks to explain a refused edit, or to keep a caret out of
generated text."
  (or (read-only? buf) (not (nil? (span-covers? (read-only-spans buf) pos)))))

(defn- span-blocks-insert?
  (spans len p)
  ;; Inserting at `p` drops new (unprotected) text between the chars at `p-1` and `p`. Refuse
  ;; it only when `p` is STRICTLY interior to a single span (both neighbours are the same
  ;; protected run), or against a BUFFER END whose adjacent char is protected (nothing editable
  ;; to grow into there). NOT refused at the junction of two *different* spans — that is a
  ;; zero-width editable region (an emptied box), and typing must be able to refill it — nor at
  ;; an ordinary protected/editable boundary, where the insert joins the editable side.
  (or (seq/find (fn (s) (let ([lo hi] s) (and (< lo p) (< p hi)))) spans)
    (and (= p 0) (span-covers? spans 0))
    (and (= p len) (span-covers? spans (dec len)))))

(defn- span-blocks-delete?
  (spans lo hi)
  ;; a delete of `[lo hi)` is refused when it overlaps any protected span at all
  (seq/find (fn (s) (let ([slo shi] s) (and (< slo hi) (> shi lo)))) spans))

(defn- buffer-barf-if-protected-insert
  (buf p)
  (if (span-blocks-insert? (read-only-spans buf) (buffer-length buf) p)
    (buffer-read-only-error "text is read-only")
    buf))

(defn- buffer-barf-if-protected-delete
  (buf lo hi)
  (if (span-blocks-delete? (read-only-spans buf) lo hi)
    (buffer-read-only-error "text is read-only")
    buf))

(defn- buffer-adjust-spans
  (buf kind a b)
  "Return `buf` with its protected spans shifted for an edit — `:insert` (a=pos, b=len) or
`:delete` (a=lo, b=hi) — or `buf` unchanged when it has no spans. Inward gravity on insert;
a delete never overlaps a span (the mutators refuse that first), so every endpoint is either
at/before the cut or slides left by its width."
  (let (spans (get buf :read-only-spans))
    (if (nil? spans)
      buf
      (assoc buf
        :read-only-spans
          (if (= kind :insert)
            (map (fn (s)
                   (let ([lo hi] s)
                     [(if (>= lo a) (+ lo b) lo) (if (> hi a) (+ hi b) hi)]))
              spans)
            (let (d (- b a))
              (map (fn (s)
                     (let ([lo hi] s)
                       [(if (>= lo b) (- lo d) lo) (if (>= hi b) (- hi d) hi)]))
                spans)))))))

;; ---- markers: edit-surviving positions --------------------------------------
;; A marker is a named char position the editing ops keep in sync as text is inserted or
;; deleted before it — so an overlay, a diagnostic, or a *remote participant's cursor*
;; tracks the same logical spot across edits (the buffers-as-processes / collaboration
;; foundation). Markers live under `:markers` ({id -> pos}); a buffer with none carries no
;; `:markers` key and is byte-identical to before this facility (the adjust step is a no-op
;; then). Gravity is left: an insert exactly AT a marker leaves it put, so text typed at one
;; cursor lands after another user's cursor sitting at the same spot.

(defn- buffer-markers-insert
  (markers p n)
  "Shift `markers` for an insert of `n` chars at `p`: a marker strictly after `p` moves
right by `n` (left-gravity — a marker exactly at `p` stays put)."
  (update-vals markers (fn (pos) (if (> pos p) (+ pos n) pos))))

(defn- buffer-markers-delete
  (markers lo hi)
  "Shift `markers` for a delete of `[lo, hi)`: a marker at/before `lo` is unchanged, one
inside the range collapses to `lo`, one at/after `hi` moves left by the deleted width."
  (let (d (- hi lo))
    (update-vals markers (fn (pos) (cond (<= pos lo) pos (< pos hi) lo else (- pos d))))))

(defn- buffer-adjust-markers
  (buf kind a b)
  "Return `buf` with its markers shifted for an edit — `:insert` (a=pos, b=len) or `:delete`
(a=lo, b=hi) — or `buf` unchanged when it has no markers, so marker-less buffers are untouched."
  (let (m (get buf :markers))
    (if (nil? m)
      buf
      (assoc buf
        :markers (if (= kind :insert)
                   (buffer-markers-insert m a b)
                   (buffer-markers-delete m a b))))))

(defn insert (buf s)
  "Insert string `s` at point; point advances past it. Recorded for undo. Markers after the
insertion point shift with the text. Throws if `buf` is read-only."
  (buffer-barf-if-read-only buf)
  (if (= (string/length s) 0)
    buf
    (let (p (get buf :point)
          _ (buffer-barf-if-protected-insert buf p)
          buf (buffer-push-undo buf))
      (buffer-adjust-spans (buffer-adjust-markers (assoc buf
                                                    :rope (text/insert (get buf :rope) p s)
                                                    :point (+ p (string/length s))
                                                    :mark nil)
                             :insert p
                             (string/length s))
        :insert p
        (string/length s)))))

(defn delete-char (buf &optional (n 1))
  "Delete `n` characters *after* point; point stays put. Recorded for undo (a
no-op at end-of-buffer is not recorded). Throws if `buf` is read-only."
  (buffer-barf-if-read-only buf)
  (let (p (get buf :point)
        end (buffer-clamp p (buffer-length buf) (+ p n)))
    (if (= p end)
      buf
      (let (_ (buffer-barf-if-protected-delete buf p end)
            buf (buffer-push-undo buf))
        (buffer-adjust-spans (buffer-adjust-markers (assoc buf
                                                      :rope (text/delete (get buf :rope) p end)
                                                      :mark nil)
                               :delete p end)
          :delete p end)))))

(defn delete-backward-char (buf &optional (n 1))
  "Delete `n` characters *before* point (backspace); point moves back with it.
Recorded for undo (a no-op at point 0 is not recorded). Throws if `buf` is read-only."
  (buffer-barf-if-read-only buf)
  (let (p (get buf :point)
        start (buffer-clamp 0 p (- p n)))
    (if (= p start)
      buf
      (let (_ (buffer-barf-if-protected-delete buf start p)
            buf (buffer-push-undo buf))
        (buffer-adjust-spans (buffer-adjust-markers (assoc buf
                                                      :rope (text/delete (get buf :rope) start p)
                                                      :point start
                                                      :mark nil)
                               :delete start p)
          :delete start p)))))

(defn delete-region (buf)
  "Delete the text between point and mark; point moves to the region start and
the mark is cleared. A no-op (returns `buf`, unrecorded) if no mark is set or the
region is empty. Recorded for undo (restoring it brings back the mark too). Throws if
`buf` is read-only."
  (buffer-barf-if-read-only buf)
  (let (b (buffer-region-bounds buf))
    (if (nil? b)
      buf
      (let ([lo hi] b)
        (if (= lo hi)
          (assoc buf :mark nil)
          (let (_ (buffer-barf-if-protected-delete buf lo hi)
                buf (buffer-push-undo buf))
            (buffer-adjust-spans (buffer-adjust-markers (assoc buf
                                                          :rope (text/delete (get buf :rope) lo hi)
                                                          :point lo
                                                          :mark nil)
                                   :delete lo hi)
              :delete lo hi)))))))

(defn replace-region (buf start end s)
  "Replace the characters in `[start, end)` with string `s`, leaving point just after
the inserted text. The splice primitive: completion-at-point, comment toggling,
query-replace, re-indentation, and transpose are all this. Composes `delete-char` +
`insert`, so range clamping and undo behave exactly as those do."
  (insert (delete-char (goto-char buf start) (- end start)) s))

;; ---- public marker API ------------------------------------------------------

(defn buffer-marker-set (buf id pos)
  "Set marker `id` (any value — a keyword, a participant pid) to char position `pos`
(clamped into the buffer). The marker then survives edits: text inserted or deleted before
it shifts it, so it tracks the same logical spot. The basis for overlays, diagnostics, and
remote participants' cursors on a shared buffer."
  (assoc buf
    :markers (assoc (or (get buf :markers) {}) id (buffer-clamp 0 (buffer-length buf) pos))))

(defn buffer-marker (buf id)
  "The char position of marker `id` (clamped to the current length), or nil if unset."
  (let (p (get (or (get buf :markers) {}) id))
    (if (nil? p) nil (buffer-clamp 0 (buffer-length buf) p))))

(defn buffer-marker-delete (buf id)
  "Remove marker `id`. A no-op if it (or any marker) isn't set."
  (let (m (get buf :markers))
    (if (nil? m) buf (assoc buf :markers (dissoc m id)))))

(defn buffer-markers (buf)
  "The marker map `{id -> pos}` (positions clamped to the current length), or `{}` if none."
  (update-vals (or (get buf :markers) {}) (fn (pos) (buffer-clamp 0 (buffer-length buf) pos))))

;; ---- annotations: derived data stamped with the text it describes -------------
;; A tool that computes something ABOUT a buffer — per-line test verdicts, a diff
;; gutter, breakpoints, inline eval results — has to answer two questions before it
;; renders: is this still about the text on screen, and are the LINES still where
;; they were? Every consumer was hand-rolling the same triple of fields (the value,
;; the rope it was computed from, the line count at the time) and re-deriving the
;; same two comparisons, which is how one of them silently drifted. So the pairing
;; lives here, next to the rope and the line count it is made of.
;;
;; `:current?` is the positional question (the line count is unchanged, so a
;; line-keyed annotation still points at the right lines — blank it when false);
;; `:stale?` is the content question (the text moved at all, so the value predates
;; your edit — dim it, don't hide it, and undoing back un-dims it).

(defn annotate (buf key value)
  "Stamp derived `value` onto `buf` under `key`, together with the rope and line
count it describes. Read it back with `annotation`."
  (assoc buf
    key {:value value
         :rope (buffer-rope buf)
         :lines (buffer-line-count buf)}))

(defn annotation (buf key)
  "The annotation stored under `key` as `{:value :current? :stale?}`, or nil when
there is none. `:current?` — the line count still matches, so line-keyed data is
positionally valid. `:stale?` — the text has changed since, so the value is older
than what you see."
  (let (a (get buf key))
    (when (map? a)
      {:value (get a :value)
       :current? (= (buffer-line-count buf) (get a :lines))
       :stale? (not= (buffer-rope buf) (get a :rope))})))

(defn annotation-value (buf key)
  "The annotated value under `key` **only while it is positionally current**, else
nil — the common case for line-keyed data a renderer would otherwise misplace."
  (let (a (annotation buf key))
    (when (and a (:current? a)) (:value a))))

;; ---- line-wise region ops (the scaffold for comment / indent-region / …) -----

(defn region-line-range (buf)
  "The inclusive `[startline endline]` line span to act on: the lines the region
covers when a mark is set, else the current line twice. A region ending exactly at a
line's start does **not** pull that trailing line in (Emacs's line-wise convention)."
  (let (rb (buffer-region-bounds buf))
    (if (nil? rb)
      (let (l (buffer-current-line buf)) [l l])
      (let ([lo hi] rb
            sl (buffer-current-line (goto-char buf lo))
            elraw (buffer-current-line (goto-char buf hi))
            hicol (- hi (text/line->char (buffer-rope buf) elraw)))
        [sl (if (and (> elraw sl) (= hicol 0)) (dec elraw) elraw)]))))

(defn- buffer-horizontal-space?
  (c)
  ;; horizontal only: a newline is a line boundary, never whitespace to squeeze
  (or (= c " ") (= c "\t")))

(defn- buffer-ws-run-start
  (txt i)
  (if (and (> i 0) (buffer-horizontal-space? (string/char-at txt (dec i))))
    (buffer-ws-run-start txt (dec i))
    i))

(defn- buffer-ws-run-end
  (txt i n)
  (if (and (< i n) (buffer-horizontal-space? (string/char-at txt i)))
    (buffer-ws-run-end txt (inc i) n)
    i))

(defn whitespace-run-at (buf)
  "The span of spaces/tabs SURROUNDING point, as `[lo hi]` (`hi` exclusive; `[p p]` when
point is not in or beside one). Scans both directions but never across a newline, so it
is the gap you are standing in — line structure is somebody else's business.

Public because the span, not just its collapse, is what callers need: `collapse-whitespace`
replaces it, `fixup-whitespace` decides what to leave in it, and a cycling command
(Emacs 29's `cycle-spacing`, which walks one-space → none → *what was there*) has to read
the original text out of it before touching anything."
  (let (txt (buffer-text buf)
        p (buffer-point buf))
    [(buffer-ws-run-start txt p) (buffer-ws-run-end txt p (string/length txt))]))

(defn collapse-whitespace (buf seq/keep)
  "The run of spaces/tabs SURROUNDING point replaced by `keep` — `\" \"` for Emacs's
`just-one-space` (M-SPC), `\"\"` for `delete-horizontal-space` (M-\\), and the squeeze
step of `fixup-whitespace`. Scans both directions from point but never across a
newline, so it collapses the gap you are standing in and leaves the line structure
alone. Point lands just after `keep`."
  (let ([lo hi] (whitespace-run-at buf))
    (replace-region buf lo hi seq/keep)))

(def- buffer-close-delimiters [")" "]" "}"])
(def- buffer-open-delimiters ["(" "[" "{"])

(defn fixup-whitespace (buf)
  "Emacs `fixup-whitespace`: squeeze the horizontal whitespace around point to exactly
ONE space — or to none in the places a space would be wrong. Point does not move (it
stays at the join, ahead of any space inserted), so this composes under `join-line`.

No space is left when point is at the start or end of a line, before a closing
delimiter, or after an opening one: joining `(foo` to `bar)` gives `(foo bar)`, but
joining `(foo bar` to `)` gives `(foo bar)` rather than `(foo bar )`. That rule is what
makes the operation usable on Lisp — which is to say, on Brood source."
  (let (squeezed (collapse-whitespace buf "")
        at (buffer-point squeezed)
        before (buffer-char-before squeezed)
        after (buffer-char-after squeezed))
    (if (or (nil? before)
          (= before "\n") ; start of line
          (nil? after)
          (= after "\n") ; end of line
          (includes? buffer-close-delimiters after)
          (includes? buffer-open-delimiters before))
      squeezed
      (goto-char (insert squeezed " ") at))))

(defn join-line (buf)
  "Emacs `delete-indentation` / `join-line` (M-^): pull THIS line up onto the previous
one — delete the newline before it and `fixup-whitespace` at the seam, so the joined
line's indentation collapses to a single space (or none, next to a delimiter). Point
ends at the join. On the first line there is nothing above to join to, so the buffer
comes back untouched.

Note the direction: it joins the current line to the one ABOVE (Emacs), not the next
line onto this one (Vim's `J`). Joining upward is what makes repeated presses walk a
wrapped paragraph together from the bottom."
  (let (at-bol (beginning-of-line buf)
        bol (buffer-point at-bol))
    (if (= bol 0)
      buf
      (fixup-whitespace (delete-char (goto-char at-bol (dec bol)) 1)))))

(defn map-region-lines (buf f)
  "Fold `(f buf line)` over each line in `buf`'s `region-line-range`, threading the
buffer through — the scaffold for line-wise commands (comment, indent-region, …).
`f` must not add or remove lines (line numbers stay valid across the fold). Returns
the resulting buffer."
  (let ([sl el] (region-line-range buf))
    (fold f buf (range sl (inc el)))))

;; ---- the actor shell (buffer-as-process) ------------------------------------
;;
;; A buffer process OWNS its buffer (and thus its process-local rope). Clients
;; never receive the buffer — only derived views. Edits and reads cross as
;; *closures* (`buffer -> buffer` and `buffer -> view`), shipped by closure-as-
;; data (ADR-033); the read closure must return a non-rope value.
;;
;; A buffer process is also a first-class **`io` sink**: it answers `[:write s]`
;; by appending `s` (the same message `std/io`'s `process-port` and thus `std/log`'s
;; `process-backend` send), so `(add-backend (process-backend a-buffer-pid))` streams
;; log output straight into a buffer — async, share-nothing, no glue. The append is
;; applied as a structured SPLICE (delta push, transform-ring recorded), so a streamed
;; log line costs its subscribers O(line) and never invalidates concurrent based splices.

(defn- buffer-push
  (subs version buf &optional origin)
  "Notify every subscriber of an edit: send each its `[:buffer-updated <bufpid> version
view origin]`, where `view` is `(proj buf)` for its registered projection `proj` (a nil
projection pushes a nil view — a bare change notification) and `origin` is whatever the
edit carried (nil when untagged). An origin lets a subscriber recognise its OWN edit
coming back — the echo-suppression seam: a collaborative client that already applied its
edit locally can fold its own push as a version bump instead of a content rebuild, so
fast typing never flickers under its round-trip. Runs in the buffer process, so `(self)`
is the buffer pid the subscriber keys on."
  (doseq (s subs)
    (send (get s :pid)
      [:buffer-updated
        (self)
        version
        (let (proj (get s :proj)) (if (nil? proj) nil (proj buf)))
        origin])))

(defn- buffer-push-view
  (subs version view origin)
  "Push a ready-made `view` (a delta — see the `:splice` / `:marker-set` arms) to every
subscriber verbatim, bypassing projections: one small value, fanned as-is."
  (doseq (s subs)
    (send (get s :pid) [:buffer-updated (self) version view origin])))

(defn- buffer-serve
  (buf subs version &optional recent)
  "The receive loop of a buffer process over its immutable `buf`, tracking `subs` (subscriber
`{:pid :proj}` records) and a monotonic `version`. `:edit` applies a change, bumps the
version, and **pushes** the new projection to every subscriber — the collaboration seam:
two panes or sessions subscribed to one buffer both see every edit. `:write` is an
end-append expressed as a structured splice (delta push, ring-recorded). `:get` replies a
derived view synchronously; `:subscribe`/`:unsubscribe` manage the push set (a new
subscriber is seeded with the current state at once, and monitored); `:stop` ends. The
rope never leaves this process — pushes and replies carry only derived, non-rope values
(`proj`/`f` must return such).

`recent` is the ring of the last 64 APPLIED splices (`[version lo hi replen origin]`,
newest first) — what a based `[:splice … base]` transforms over. A based splice is
transformed only over entries from OTHER origins: the sender's own earlier splices
are already part of the basis its positions were computed against (its local copy
applied them first — local-apply-first), so transforming over them would double-shift
a second keystroke sent before the first's echo folded. Every content path records
in the ring except CLOSURE edits, which are invisible to it — so on a
transform-collaborated buffer, content changes should arrive as splices or `:write`
(closure edits are for markers/metadata).

**Subscriber lifecycle:** every subscriber is monitored, so a dead one (crash, detach, link
drop) is removed rather than lingering. A marker keyed by the dead subscriber's *pid* is
deleted too — the convention for transient per-subscriber state (a participant's cursor on a
shared buffer: key your marker by your pid and it is cleaned up with you) — and when that
changed the buffer, survivors get a push (they see the cursor vanish)."
  (let (rec (or recent ()))
    (receive
      ;; one arm for both tagged and untagged closure edits (origin nil when untagged).
      ;; This merge used to be forced by a 12-arm budget — a 13th receive arm fell off a
      ;; compile cliff (KI-10). That cliff no longer reproduces (re-measured 2026-07-25:
      ;; +1 arm and +8 arms are both flat, buffer suite and full suite), so the budget is
      ;; gone; the single arm stays because one arm for both shapes is simply simpler.
      ([:edit f origin] (let (nb (f buf) v (inc version))
                          (do (buffer-push subs v nb origin) (buffer-serve nb subs v rec))))
      ;; A read-then-decide edit in ONE round-trip: `f` returns `[new-buf value]` — the
      ;; buffer is replaced AND the extracted value (killed text, a popped mark, …) goes
      ;; back to the caller, totally ordered with every other edit (no read-modify-write
      ;; race against a concurrent splice). The kill-region shape: delete the region and
      ;; get the deleted text back, atomically. Same closure-edit caveats as `:edit`
      ;; (invisible to the transform ring; `value` must be non-rope).
      ([:edit-reply f origin from r] (let ([nb value] (f buf) v (inc version))
                                       (do
                                         (send from [:reply r value])
                                         (buffer-push subs v nb origin)
                                         (buffer-serve nb subs v rec))))
      ;; A structured edit: the change arrives as DATA (a positional splice), so the push
      ;; can carry the DELTA — {:splice [lo hi repl] :markers … :participants …} — instead
      ;; of each subscriber's full projection. O(change), not O(document): the seam that
      ;; makes collaborative typing on a large buffer cheap. Structured ops push this light
      ;; view to EVERY subscriber regardless of its projection (document accordingly);
      ;; closure edits (:edit) and the seed keep the full projection contract.
      ([:splice lo hi repl origin] (let (nb (replace-region buf lo hi repl) v (inc version))
                                     (do
                                       (buffer-push-view subs
                                         v
                                         {:splice [lo hi repl]
                                          :markers (buffer-markers nb)
                                          :participants (get nb :participants {})}
                                         origin)
                                       (buffer-serve nb
                                         subs
                                         v
                                         (take 64 (cons [v lo hi (string/length repl) origin] rec))))))
      ;; A BASED splice: computed against `base`, so first TRANSFORM it over every
      ;; splice applied since (the `rec` ring, oldest-first over the window) — two
      ;; people typing in different places inside one round-trip window both land
      ;; where they meant to. Entries from the SAME origin are skipped: the sender's
      ;; local copy already contained them when it computed these positions
      ;; (local-apply-first), so shifting over them again would land a pipelined
      ;; second keystroke one column too far. The push carries the splice AS APPLIED.
      ([:splice lo hi repl origin base] (let (since (reverse (take-while (fn (e) (> (first e) base))
                                                               rec))
                                              foreign (filter (fn (e)
                                                                (or (nil? origin)
                                                                  (not (= (nth e 4 nil) origin))))
                                                        since)
                                              [tlo thi trepl] (splice-transform-all [lo hi repl]
                                                                (map (fn (e)
                                                                       [(nth e 1)
                                                                         (nth e 2)
                                                                         (nth e 3)])
                                                                  foreign))
                                              nb (replace-region buf tlo thi trepl)
                                              v (inc version))
                                          (do
                                            (buffer-push-view subs
                                              v
                                              {:splice [tlo thi trepl]
                                               :markers (buffer-markers nb)
                                               :participants (get nb :participants {})}
                                              origin)
                                            (buffer-serve nb
                                              subs
                                              v
                                              (take 64
                                                (cons [v tlo thi (string/length trepl) origin] rec))))))
      ;; A cursor move as data: no text change at all — the push carries markers + names
      ;; only, so presence traffic on a large document never ships its text.
      ([:marker-set id pos origin] (let (nb (buffer-marker-set buf id pos) v (inc version))
                                     (do
                                       (buffer-push-view subs
                                         v
                                         {:markers (buffer-markers nb)
                                          :participants (get nb :participants {})}
                                         origin)
                                       (buffer-serve nb subs v rec))))
      ;; An appended line is a positional splice like any other: apply it at end-of-buffer,
      ;; RECORD it in the ring (a based splice computed before the append still transforms
      ;; correctly over it), and push the DELTA — so a log-backed buffer is as cheap to
      ;; subscribe to as a collaborative one (O(line), not O(document), per line).
      ([:write s] (let (n (buffer-length buf)
                        nb (replace-region buf n n s)
                        v (inc version))
                    (do
                      (buffer-push-view subs
                        v
                        {:splice [n n s]
                         :markers (buffer-markers nb)
                         :participants (get nb :participants {})}
                        nil)
                      (buffer-serve nb
                        subs
                        v
                        (take 64 (cons [v n n (string/length s) nil] rec))))))
      ([:get f from r] (do (send from [:reply r (f buf)]) (buffer-serve buf subs version rec)))
      ;; An atomic [version view] snapshot — the RESYNC primitive: a client rebuilding
      ;; its copy after an ambiguous collision needs the text AND the version it
      ;; corresponds to in ONE reply, or edits applied between its query and the
      ;; answer replay onto the rebuilt copy (their queued pushes pass the version
      ;; check) and double themselves.
      ([:sync proj from r] (do
                             (send from [:reply r [version (proj buf)]])
                             (buffer-serve buf subs version rec)))
      ([:subscribe pid proj] (do
                               (monitor pid)
                               (send pid
                                 [:buffer-updated
                                   (self)
                                   version
                                   (if (nil? proj) nil (proj buf))
                                   nil])
                               (buffer-serve buf (cons {:pid pid :proj proj} subs) version rec)))
      ([:unsubscribe pid] (buffer-serve buf
                            (seq/remove (fn (s) (= (get s :pid) pid)) subs)
                            version
                            rec))
      ([:down _ pid _]
        (let (ns (seq/remove (fn (s) (= (get s :pid) pid)) subs)
              ;; the dead subscriber's transient markers: keyed BY its pid (its cursor)
              ;; or by a vector containing it (e.g. [pid :mark] — its selection anchor)
              nb (fold (fn (b k) (buffer-marker-delete b k))
                   buf
                   (filter (fn (k) (or (= k pid) (and (vector? k) (includes? k pid))))
                     (keys (buffer-markers buf)))))
          (if (= nb buf)
            ; no marker for it — just drop the subscriber
            (buffer-serve buf ns version rec)
            (let (v (inc version)) (do (buffer-push ns v nb) (buffer-serve nb ns v rec))))))
      ([:stop from r] (send from [:reply r :stopped])))))

(defn spawn-buffer (buf)
  "Spawn a process that owns a copy of `buf` and serves edits/queries; return its
pid. The rope can't cross a process boundary, so this ships `buf`'s *text* (plus
name/file/point/mark) and rebuilds the rope inside the new process. Drive it with
`buffer-edit` and `buffer-query`."
  (let (text (buffer-text buf)
        name (buffer-name buf)
        file (buffer-file buf)
        pt (buffer-point buf)
        mk (buffer-mark buf))
    (spawn (buffer-serve (assoc (make-buffer text name file) :point pt :mark mk) () 0))))

(defn buffer-edit (bp f &optional origin)
  "Apply pure transform `f` (a `buffer -> buffer` fn) inside buffer process `bp`.
With `origin` (any value — conventionally the sender's pid), the resulting push is
tagged with it, so subscribers can recognise their own edit coming back (see
`buffer-push` — the echo-suppression seam). Asynchronous — returns nil."
  (send bp [:edit f origin]))

(defn buffer-edit-reply (bp f &optional origin)
  "Apply `f` — a `buffer -> [new-buf value]` fn — inside buffer process `bp` and have
the extracted `value` sent back: the READ-THEN-DECIDE edit (kill-region's shape —
delete the region *and* learn what was deleted) as one atomic, totally-ordered
round-trip; no concurrent splice can land between the read and the write. `value`
must be non-rope (the rope never leaves the process); `origin` tags the push as for
`buffer-edit`. Asynchronous — returns a ref `r`; the caller receives `[:reply r
value]` (or use `buffer-edit-value` to block for it)."
  (let (r (ref))
    (send bp [:edit-reply f origin (self) r])
    r))

(defn buffer-edit-value (bp f &optional origin (timeout 5000))
  "`buffer-edit-reply`, blocking for the extracted value: apply `f` (`buffer ->
[new-buf value]`) in buffer process `bp` and return `value`. Throws after `timeout`
ms (default 5000) — the bounded-sync form for callers that need the answer to
proceed (an interactive command deciding on what it read)."
  (let (r (buffer-edit-reply bp f origin))
    (receive
      ([:reply ^r v] v)
      (after timeout (error "buffer-edit-value: no reply after " timeout "ms")))))

;; ---- splice transforms: concurrent edits without a CRDT ----------------------
;; Two participants typing inside one round-trip window each compute a splice against
;; text the other's edit hasn't reached yet. For DISJOINT spans the fix is exact and
;; tiny: shift the later splice by the earlier one's length delta (operational
;; transformation's easy half). Ambiguous cases — spans that touch or overlap — are
;; left to the caller's policy (the buffer process falls back to an authoritative
;; placement; a client falls back to resyncing from the process).

(defn splice-disjoint? (a b)
  "Whether splices `a`/`b` (`[lo hi …]`) touch nothing in common — STRICTLY apart, so
even boundary-touching (an insert exactly at the other's edge) counts as ambiguous."
  (or (< (nth a 1) (nth b 0)) (> (nth a 0) (nth b 1))))

(defn splice-transform (splice applied)
  "Transform `splice` `[lo hi repl]` — computed against text that did NOT yet contain
`applied` `[alo ahi alen]` (a replace of `[alo, ahi)` by `alen` chars) — so it lands
correctly on the text that DOES. Disjoint-before shifts by `applied`'s length delta;
disjoint-after is untouched; an overlap degrades to inserting `repl` just after
`applied`'s replacement (the deterministic authoritative choice — the span it meant
to delete no longer exists as written)."
  (let ([lo hi repl] splice
        [alo ahi alen] applied
        delta (- alen (- ahi alo)))
    (cond
      (<= ahi lo) [(+ lo delta) (+ hi delta) repl]
      (>= alo hi) splice
      else (let (p (+ alo alen)) [p p repl]))))

(defn splice-transform-all (splice applieds)
  "`splice` transformed over each of `applieds` in order (oldest first)."
  (fold (fn (sp a) (splice-transform sp a)) splice applieds))

(defn buffer-splice (bp lo hi repl &optional origin base)
  "Replace `[lo, hi)` with `repl` inside buffer process `bp` — the structured-edit
counterpart of `buffer-edit` for a change already expressed positionally. Because the
change is data, the resulting push carries only the DELTA (`{:splice … :markers …
:participants …}`) instead of each subscriber's full projection — O(change) per
keystroke on a shared buffer, whatever the document's size. `origin` tags the push as
for `buffer-edit`. With `base` (the version this splice was computed against), the
process TRANSFORMS it over every splice applied since (`splice-transform`) before
applying — so two people typing in different places inside one round-trip window both
land exactly where they meant to, no CRDT. Asynchronous — returns nil."
  (if (nil? base)
    (send bp [:splice lo hi repl origin])
    (send bp [:splice lo hi repl origin base])))

(defn buffer-marker-move (bp id pos &optional origin)
  "Set marker `id` to `pos` inside buffer process `bp`, pushing only `{:markers …
:participants …}` — a cursor move never ships the document. `origin` tags the push.
Asynchronous — returns nil."
  (send bp [:marker-set id pos origin]))

(defn buffer-query (bp f)
  "Synchronously read a derived view from buffer process `bp` via pure fn `f` (a
`buffer -> view`). `f` must return a non-rope value — e.g. `buffer-text`,
`buffer-point`, `(fn (b) (buffer-line-at b 0))`. Blocks for the reply."
  (let (r (ref))
    (send bp [:get f (self) r])
    (receive ([:reply ^r v] v))))

(defn subscribe-buffer (bp proj)
  "Subscribe the calling process to buffer process `bp`. It immediately receives — and then
gets on every edit — `[:buffer-updated bp version view]`, where `view` is `(proj buffer)`, a
derived non-rope value (a viewport projection, the text, a marker set), or nil when `proj` is
nil (a bare change notification). The push side of buffers-as-processes: a pane subscribes
with its viewport projection and re-renders from each pushed frame instead of polling. Many
processes may subscribe to one buffer — that is what lets several sessions see each edit."
  (send bp [:subscribe (self) proj]))

(defn unsubscribe-buffer (bp)
  "Stop the calling process receiving `[:buffer-updated …]` pushes from buffer process `bp`."
  (send bp [:unsubscribe (self)]))

(defn buffer-sync (bp proj &optional (timeout 2000))
  "An ATOMIC `[version view]` snapshot of buffer process `bp` through projection
`proj` — the resync primitive: unlike `buffer-query`, the reply pairs the view with
the version it corresponds to, so a client rebuilding its copy can set its link
version to exactly the snapshot and let queued pushes sort themselves (≤ snapshot →
stale-dropped, > → applied once). `:no-reply` after `timeout` ms (a dead process —
the caller's monitor will deal with it)."
  (let (r (ref))
    (send bp [:sync proj (self) r])
    (receive ([:reply ^r v] v) (after timeout :no-reply))))

(defn stop-buffer (bp)
  "Stop buffer process `bp` (it leaves its loop). Synchronous; returns :stopped —
or :no-reply after 2s (an already-dead process: sending [:stop] to a corpse would
otherwise park the caller forever, e.g. killing a buffer whose process just
crashed, before the [:down] has been folded)."
  (let (r (ref))
    (send bp [:stop (self) r])
    (receive ([:reply ^r v] v) (after 2000 :no-reply))))

;; ---- create / delete (the buffer-process lifecycle) -------------------------

(defn create-buffer (&optional (name "*scratch*"))
  "Spawn a fresh, empty buffer process named `name` and return its **pid**. The
process serves `buffer-edit` / `buffer-query` and accepts `[:write s]`, so it is a
valid `io`/logger sink — `(add-backend (process-backend (create-buffer \"*log*\")))`
streams log output straight into it. Tear it down with `delete-buffer`. (High-volume
sinks may want `(buffer-edit pid disable-undo)` so appends don't grow undo history.)"
  (spawn-buffer (make-buffer "" name)))

(defn delete-buffer (bp)
  "Stop buffer process `bp` and free it — the symmetric name for `stop-buffer`.
Synchronous; returns :stopped."
  (stop-buffer bp))
