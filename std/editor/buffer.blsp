;; std/buffer.blsp — the editor framework's buffer model. (require 'buffer).
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - A BUFFER is an immutable value (a map) holding a rope plus cursor state.
;;    Every operation returns a *fresh* buffer (ADR-026) — nothing mutates. This
;;    is the pure, trivially-testable core of the editor toolkit (M2, ADR-045).
;;  - Text lives in a `rope` (the kernel's one editor primitive); all of the
;;    point / mark / region / movement *policy* here is pure Brood over it.
;;  - A buffer is process-local because its rope is: you never `send` a buffer
;;    (or its rope) across processes. `spawn-buffer` makes a thin actor that OWNS
;;    one and replies only with *derived views* (text, lines, positions) — never
;;    the buffer or rope themselves. That reply-with-views boundary is the seed
;;    of the display protocol (M3).
;;  - This module is NOT part of the language: it is opt-in (`require`), never in
;;    the prelude, and adds zero kernel surface — pure Brood over rope primitives.
;;
;; Char indices are 0-based, like the rope primitives. `point` is a char index in
;; [0, length]; `mark` is a char index or nil. Lines are 0-based; a line's text
;; (`buffer-line-at`) includes its trailing newline, matching `rope-line`.

(defmodule editor/buffer
  "An immutable text buffer for building editors, written in Brood over the rope
primitives (ADR-045). A *buffer* is a map:

    {:rope <rope> :point <int> :mark <int|nil> :name <string> :file <string|nil>
     :undo (<snapshot>…) :pending-undo (<snapshot>…)}

Every operation is pure — movement and editing return a **fresh** buffer; nothing
mutates (ADR-026). `point` is the cursor (a char index); `mark`, with point,
delimits the region. Each editing op records the pre-edit state on `:undo` (a stack
of `{:rope :point :mark}` snapshots); undo is an Emacs-style *tree* (undoing is itself
recorded, so no state is ever lost) — see the undo section below.

    (require 'buffer)
    (def b (-> (make-buffer \"hello world\")
               (goto-char 5) (insert \",\") end-of-line))
    (buffer-text b)            ; => \"hello, world\"

Because a buffer holds a rope, and ropes are **process-local**, a buffer cannot
cross a process boundary. `spawn-buffer` makes a process that *owns* a buffer and
serves edits/queries, replying only with derived views (strings, positions) —
never the buffer itself. Drive it with `buffer-edit` / `buffer-query`.")

;; ---- helpers ----------------------------------------------------------------

(defn buffer--clamp (lo hi x)
  "Clamp `x` into the inclusive range [lo, hi]."
  (max lo (min hi x)))

(defn buffer--line-end-col (buf line)
  "The column at the end of `line` — its length excluding any trailing newline.
Where `end-of-line` lands and the rightmost column point can hold on that line."
  (let (lt (rope-line (get buf :rope) line))
    (if (ends-with? lt "\n") (dec (string-length lt)) (string-length lt))))

;; ---- construction -----------------------------------------------------------

(defn make-buffer (text &optional (name "*scratch*") (file nil))
  "A fresh buffer holding `text`, with point at 0, no mark, and an empty undo history.
`name` is a label (default `\"*scratch*\"`); `file` is the backing path or nil."
  {:rope (string->rope text) :point 0 :mark nil :name name :file file :undo () :pending-undo ()})

(defn buffer? (x)
  "True if `x` is a buffer value (a map with a rope under `:rope`)."
  (and (map? x) (rope? (get x :rope))))

(defn buffer-from-file (path)
  "Read the file at `path` into a fresh buffer, with `:file` set to `path` so
`save-buffer` can write it back."
  (make-buffer (slurp path) path path))

(defn find-file-buffer (path)
  "Open `path` for editing, vim/emacs `find-file` style: its contents if the file
exists, else a fresh *empty* buffer — either way backed by `path`, so `save-buffer`
writes it (creating the file for a new path). Visiting a missing path starts an
unsaved buffer rather than erroring."
  (if (file-exists? path) (buffer-from-file path) (make-buffer "" path path)))

(defn save-buffer (buf)
  "Write `buf`'s text to its `:file`; raise if it has none. Returns `buf`."
  (let (f (get buf :file))
    (if (nil? f)
      (error "save-buffer: buffer has no file: " (get buf :name))
      (do (spit f (buffer-text buf)) buf))))

;; ---- reads ------------------------------------------------------------------

(defn buffer-rope (buf) "The buffer's underlying rope (process-local)." (get buf :rope))
(defn buffer-text (buf) "The buffer's full text as a string." (rope->string (get buf :rope)))
(defn buffer-point (buf) "The cursor position (a char index)." (get buf :point))
(defn buffer-mark (buf) "The mark (a char index), or nil if unset." (get buf :mark))
(defn buffer-name (buf) "The buffer's name." (get buf :name))
(defn buffer-file (buf) "The buffer's backing file path, or nil." (get buf :file))
(defn read-only? (buf)
  "True if `buf` is marked read-only — its mutators (`insert`, `delete-char`,
`delete-backward-char`, `delete-region`, `replace-region`) refuse to change it.
Unset/false on a fresh buffer (`make-buffer` builds freely)."
  (= (get buf :read-only) true))
(defn buffer-length (buf) "The number of characters in the buffer." (rope-length (get buf :rope)))
(defn buffer-line-count (buf)
  "The number of lines in the buffer."
  (rope-line-count (get buf :rope)))

(defn buffer-line-at (buf line)
  "The text of `line` (0-based), including its trailing newline (like `rope-line`)."
  (rope-line (get buf :rope) line))

(defn buffer-current-line (buf)
  "The 0-based line index that point is on."
  (rope-char->line (get buf :rope) (get buf :point)))

(defn buffer-column (buf)
  "The 0-based column of point — characters from the start of its line."
  (let (rope (get buf :rope))
    (- (get buf :point) (rope-line->char rope (rope-char->line rope (get buf :point))))))

(defn buffer-char-after (buf)
  "The single-character string just after point, or nil at end of buffer."
  (let (p (get buf :point))
    (if (< p (buffer-length buf)) (rope-slice (get buf :rope) p (inc p)) nil)))

(defn buffer-char-before (buf)
  "The single-character string just before point, or nil at start of buffer."
  (let (p (get buf :point))
    (if (> p 0) (rope-slice (get buf :rope) (dec p) p) nil)))

(defn buffer-region-bounds (buf)
  "The region's char bounds as `[lo hi]` (lo ≤ hi, point and mark in either order),
or nil if no mark is set. The half-open span `[lo, hi)` the view highlights and
`delete-region`/`buffer-region` act on."
  (let (m (get buf :mark))
    (if (nil? m) nil (let (p (get buf :point)) [(min p m) (max p m)]))))

(defn buffer-region (buf)
  "The text between point and mark (in either order), or nil if no mark is set."
  (let (b (buffer-region-bounds buf))
    (if (nil? b)
      nil
      (let ([lo hi] b) (rope-slice (get buf :rope) lo hi)))))

;; ---- movement (returns a fresh buffer with point moved) ---------------------

(defn goto-char (buf n)
  "Point moved to char index `n`, clamped to [0, length]."
  (assoc buf :point (buffer--clamp 0 (buffer-length buf) n)))

(defn forward-char (buf &optional (n 1))
  "Point moved `n` characters forward (clamped)."
  (goto-char buf (+ (get buf :point) n)))

(defn backward-char (buf &optional (n 1))
  "Point moved `n` characters backward (clamped)."
  (goto-char buf (- (get buf :point) n)))

(defn beginning-of-line (buf)
  "Point moved to the first character of its current line."
  (let (rope (get buf :rope))
    (goto-char buf (rope-line->char rope (rope-char->line rope (get buf :point))))))

(defn end-of-line (buf)
  "Point moved to the end of its current line (before the trailing newline)."
  (let (rope (get buf :rope)
        line (rope-char->line rope (get buf :point)))
    (goto-char buf (+ (rope-line->char rope line) (buffer--line-end-col buf line)))))

(defn forward-line (buf &optional (n 1))
  "Point moved `n` lines forward (negative = backward), keeping the column where
the target line is long enough. Clamps to the buffer's line range."
  (let (rope (get buf :rope)
        col (buffer-column buf)
        target (buffer--clamp 0
                 (dec (rope-line-count rope))
                 (+ (rope-char->line rope (get buf :point)) n))
        line-start (rope-line->char rope target))
    (goto-char buf (+ line-start (min col (buffer--line-end-col buf target))))))

(defn backward-line (buf &optional (n 1))
  "Point moved `n` lines backward (see `forward-line`)."
  (forward-line buf (- n)))

(defn beginning-of-buffer (buf) "Point moved to the start of the buffer." (goto-char buf 0))
(defn end-of-buffer (buf)
  "Point moved to the end of the buffer."
  (goto-char buf (buffer-length buf)))

;; ---- word motion (M-f / M-b) ------------------------------------------------
;; A word is a run of non-delimiter, non-whitespace chars (same notion as the
;; line editor's M-f/M-b). Forward skips any non-word chars then the word;
;; backward is the mirror. Pure scans over the buffer text.

(defn buffer--word-char? (c)
  "True if `c` is part of a word (not whitespace or a delimiter) — matches the
line editor's M-f/M-b notion of a word."
  (not (or (= c " ")
         (= c "\t")
         (= c "\n")
         (= c "(")
         (= c ")")
         (= c "[")
         (= c "]")
         (= c "{")
         (= c "}")
         (= c "\"")
         (= c ";")
         (= c ","))))

(defn buffer--scan-fwd (text i n pred)
  "Smallest index ≥ `i` (up to `n`) whose char fails `pred` — advance while `pred`."
  (if (or (>= i n) (not (pred (char-at text i)))) i (buffer--scan-fwd text (inc i) n pred)))

(defn buffer--scan-bwd (text i pred)
  "Largest index ≤ `i` (down to 0) whose preceding char fails `pred` — retreat while `pred`."
  (if (or (<= i 0) (not (pred (char-at text (dec i))))) i (buffer--scan-bwd text (dec i) pred)))

(defn forward-word (buf)
  "Point moved to the end of the next word forward (skip non-word chars, then the word)."
  (let (text (buffer-text buf)
        n (string-length text)
        i (buffer--scan-fwd text (get buf :point) n (fn (c) (not (buffer--word-char? c)))))
    (goto-char buf (buffer--scan-fwd text i n buffer--word-char?))))

(defn backward-word (buf)
  "Point moved to the start of the previous word backward (skip non-word chars, then the word)."
  (let (text (buffer-text buf)
        i (buffer--scan-bwd text (get buf :point) (fn (c) (not (buffer--word-char? c)))))
    (goto-char buf (buffer--scan-bwd text i buffer--word-char?))))

;; ---- paragraph motion (M-{ / M-}) -------------------------------------------
;; A paragraph is a run of non-blank lines bounded by blank (empty / whitespace-only)
;; lines. Forward motion skips any blank lines then the paragraph, landing at the next
;; blank separator (or end of buffer); backward is the mirror, landing at the
;; paragraph's first line. Pure line scans over the rope.

(defn buffer--line-blank? (buf line)
  "True if buffer `line` is empty or whitespace-only (a paragraph separator)."
  (blank? (buffer-line-at buf line)))

(defn buffer--scan-lines (buf line n step want-blank?)
  "First line index walking from `line` by `step` (±1, within `[0, n)`) whose
blankness differs from `want-blank?`; stops at the buffer edge."
  (if (or (< line 0) (>= line n) (not (= (buffer--line-blank? buf line) want-blank?)))
    line
    (buffer--scan-lines buf (+ line step) n step want-blank?)))

(defn forward-paragraph (buf)
  "Point moved to the start of the next blank line after the current paragraph (end of
buffer if none) — Emacs `forward-paragraph` (M-})."
  (let (rope (get buf :rope)
         n
         (rope-line-count rope)
         line
         (rope-char->line rope (get buf :point))
         afterblank
         (buffer--scan-lines buf line n 1 true)  ; skip leading blank lines
         boundary
         (buffer--scan-lines buf afterblank n 1 false))
    ; skip the paragraph
    (goto-char buf (if (>= boundary n) (buffer-length buf) (rope-line->char rope boundary)))))

(defn backward-paragraph (buf)
  "Point moved to the start of the current/previous paragraph (start of buffer if none)
— Emacs `backward-paragraph` (M-{)."
  (let (rope (get buf :rope)
         n
         (rope-line-count rope)
         line
         (rope-char->line rope (get buf :point))
         ;; step back over blank lines directly above, then over the paragraph's lines.
         afterblank
         (buffer--scan-lines buf (dec line) n -1 true)
         start
         (buffer--scan-lines buf afterblank n -1 false))
    (goto-char buf (rope-line->char rope (max 0 (if (< start 0) 0 (inc start)))))))

;; ---- mark -------------------------------------------------------------------

(defn set-mark (buf)
  "Set the mark at point (with point, this delimits the region)."
  (assoc buf :mark (get buf :point)))
(defn clear-mark (buf) "Clear the mark." (assoc buf :mark nil))

;; ---- mark ring (a history of marks; the substrate for C-u C-SPC) ------------

(def *mark-ring-max* 16)  ; like Emacs `mark-ring-max`

(defn push-mark (buf)
  "Set the mark at point **and** push point onto the buffer's `:mark-ring` (bounded
by `*mark-ring-max*`, newest first). The ring records where the mark has been so
`pop-mark` can revisit prior locations."
  (let (p (get buf :point))
    (assoc buf
      :mark
      p
      :mark-ring
      (take *mark-ring-max* (cons p (or (get buf :mark-ring) ()))))))

(defn pop-mark (buf)
  "Move point to the newest entry on the buffer's `:mark-ring`, rotating that entry
to the back so repeated calls cycle through the ring (Emacs `pop-to-mark-command`).
A no-op when the ring is empty."
  (let (ring (or (get buf :mark-ring) ()))
    (if (empty? ring)
      buf
      (assoc buf
        :point
        (buffer--clamp 0 (buffer-length buf) (first ring))
        :mark-ring
        (append (rest ring) (list (first ring)))))))

;; ---- search (pure position queries; the caller moves point) -----------------

(defn buffer-search-forward (buf needle from)
  "The char index of the first occurrence of `needle` in `buf`'s text at or after
`from`, or nil if there is none. Pure — it does not move point; the caller composes
`goto-char`/`set-mark`. The forward primitive incremental search rides on."
  (let (i (string-index-of (buffer-text buf) needle from))
    (if (< i 0) nil i)))

(defn buffer-search-backward (buf needle before)
  "The char index of the last occurrence of `needle` in `buf`'s text whose start is
strictly before `before`, or nil if there is none. The backward counterpart of
`buffer-search-forward`."
  (let (i (string-last-index-of (buffer-text buf) needle before))
    (if (< i 0) nil i)))

;; ---- undo (an undo *tree*, Emacs-style) -------------------------------------
;;
;; Undo rides the immutable buffer for free: a snapshot is the edit-mutable triple
;; `{:rope :point :mark}` (ropey shares structure, so a snapshot is O(1)). `:undo` is
;; the history — a stack of snapshots, newest first — and each editing op pushes its
;; PRE-edit snapshot (only when the text really changes, so undo has no dead steps).
;;
;; The twist that makes it a *tree*, not a one-way stack (Emacs `undo`): **undoing is
;; itself recorded as a change.** `undo-next` restores the next state AND pushes the
;; current one onto `:undo`, so an undo can itself be undone (= redo), and editing
;; after some undos leaves the undone states on `:undo` as a branch you can still
;; reach. No state is ever lost.
;;
;; `:pending-undo` is the tail of `:undo` the current undo run walks down. The caller
;; (the editor's cmd-undo / cmd-redo) calls `undo-start` to begin a fresh run — pointed
;; at the front of `:undo`, which after a run holds the just-undone states, so a fresh
;; run *reverses direction* (redo). Continuing the run (not restarting) keeps direction.
;; A snapshot excludes the history fields so snapshots don't nest and grow geometrically.

(defn buffer--snapshot (buf)
  "The restorable edit state of `buf` — just `{:rope :point :mark}` (no history)."
  {:rope (get buf :rope) :point (get buf :point) :mark (get buf :mark)})

(defn amalgamate-undo (buf)
  "Make the **next** editing op amalgamate into the current undo group rather than start
a new one: its pre-edit snapshot is dropped, so undo treats the run as a single step.
A one-shot flag (cleared by the next edit). By default every op is its own undo step; the
editor's command loop calls this to coalesce a typing / deletion run (or a multi-edit
command) into one undo, the Emacs way — keeping this primitive's default simple."
  (assoc buf :undo-amalgamate true))

(defn buffer--push-undo (buf)
  "Record `buf`'s pre-edit state for undo — called by an editing op before it changes the
text. Normally conses a fresh snapshot onto `:undo` (each op its own undo step); when
`amalgamate-undo` armed the one-shot `:undo-amalgamate` (and there's a group to merge
into) it drops this op's snapshot so the run undoes as one. A no-op when undo is disabled
(`disable-undo`). (Does not touch `:pending-undo`: the next undo run starts fresh anyway —
the editor restarts it whenever the previous command wasn't an undo.)"
  (cond
    (get buf :undo-disabled) buf
    (and (get buf :undo-amalgamate) (not (empty? (get buf :undo))))
      (assoc buf :undo-amalgamate false)
    :else (assoc buf
            :undo (cons (buffer--snapshot buf) (or (get buf :undo) ()))
            :undo-amalgamate false)))

(defn disable-undo (buf)
  "Turn off undo recording for `buf` and drop any existing history. For a log / output
buffer (e.g. `*Messages*`) where undo is meaningless and would otherwise grow without
bound — editing ops on the result record nothing, so undo stays a no-op. Like Emacs
`buffer-disable-undo`."
  (assoc buf :undo-disabled true :undo () :pending-undo ()))

(defn buffer--restore (buf snap)
  "Restore the `{:rope :point :mark}` of `snap` into `buf`, keeping `buf`'s history."
  (assoc buf :rope (get snap :rope) :point (get snap :point) :mark (get snap :mark)))

(defn undo-start (buf)
  "Begin a fresh undo run: point `:pending-undo` at the whole `:undo` history. Because
each `undo-next` records the state it leaves onto `:undo`, a run started after some undos
walks the *reverse* direction — i.e. it redoes."
  (assoc buf :pending-undo (get buf :undo)))

(defn undo-next (buf)
  "One step of the current undo run: restore the next snapshot in `:pending-undo`,
recording the current state onto `:undo` (so this very step is itself reversible) and
advancing `:pending-undo`. A no-op (returns `buf`) when the run is exhausted."
  (let (p (get buf :pending-undo))
    (if (empty? p)
      buf
      (assoc (buffer--restore buf (first p))
        :undo (cons (buffer--snapshot buf) (or (get buf :undo) ()))
        :pending-undo (rest p)))))

(defn undo (buf)
  "A standalone single undo: begin a fresh run and take one step. The editor's repeat
behaviour — continue a run vs. restart after a non-undo command (which is what turns a
fresh run into a redo) — lives in cmd-undo / cmd-redo, which call `undo-start` /
`undo-next` directly."
  (undo-next (undo-start buf)))

;; ---- editing (returns a fresh buffer; records undo; clears the mark) ---------
;;
;; Edits clear the mark rather than try to track it across the change — the
;; simple, safe choice for v1 (a smarter mark-adjustment can come later if the
;; editor app needs it). `delete-region` clears it by definition. Each op records
;; an undo snapshot (see above) only when it actually changes the text.

(defn set-read-only (buf flag)
  "Mark `buf` read-only (`flag` truthy) or writable. While read-only, the text
mutators throw `\"buffer is read-only\"` (Emacs's `buffer-read-only` signal) — point
and mark still move, so the buffer stays navigable. Build the contents *before*
flipping this on (construction never checks the flag), the way a generated report
or `special-mode` buffer does."
  (assoc buf :read-only (if flag true false)))

(defn buffer--barf-if-read-only (buf)
  "Throw if `buf` is read-only — the guard every text mutator runs first, so the
read-only contract lives in the model (no consumer has to remember to check). Returns
`buf` unchanged when writable, for use as a guard expression."
  (if (read-only? buf) (error "buffer is read-only") buf))

;; ---- markers: edit-surviving positions --------------------------------------
;; A marker is a named char position the editing ops keep in sync as text is inserted or
;; deleted before it — so an overlay, a diagnostic, or a *remote participant's cursor*
;; tracks the same logical spot across edits (the buffers-as-processes / collaboration
;; foundation). Markers live under `:markers` ({id -> pos}); a buffer with none carries no
;; `:markers` key and is byte-identical to before this facility (the adjust step is a no-op
;; then). Gravity is left: an insert exactly AT a marker leaves it put, so text typed at one
;; cursor lands after another user's cursor sitting at the same spot.

(defn buffer--markers-insert (markers p n)
  "Shift `markers` for an insert of `n` chars at `p`: a marker strictly after `p` moves
right by `n` (left-gravity — a marker exactly at `p` stays put)."
  (update-vals markers (fn (pos) (if (> pos p) (+ pos n) pos))))

(defn buffer--markers-delete (markers lo hi)
  "Shift `markers` for a delete of `[lo, hi)`: a marker at/before `lo` is unchanged, one
inside the range collapses to `lo`, one at/after `hi` moves left by the deleted width."
  (let (d (- hi lo))
    (update-vals markers (fn (pos) (cond (<= pos lo) pos (< pos hi) lo :else (- pos d))))))

(defn buffer--adjust-markers (buf kind a b)
  "Return `buf` with its markers shifted for an edit — `:insert` (a=pos, b=len) or `:delete`
(a=lo, b=hi) — or `buf` unchanged when it has no markers, so marker-less buffers are untouched."
  (let (m (get buf :markers))
    (if (nil? m)
      buf
      (assoc buf :markers (if (= kind :insert)
                            (buffer--markers-insert m a b)
                            (buffer--markers-delete m a b))))))

(defn insert (buf s)
  "Insert string `s` at point; point advances past it. Recorded for undo. Markers after the
insertion point shift with the text. Throws if `buf` is read-only."
  (buffer--barf-if-read-only buf)
  (if (= (string-length s) 0)
    buf
    (let (p (get buf :point)
          buf (buffer--push-undo buf))
      (buffer--adjust-markers
        (assoc buf
          :rope
          (rope-insert (get buf :rope) p s)
          :point
          (+ p (string-length s))
          :mark
          nil)
        :insert p (string-length s)))))

(defn delete-char (buf &optional (n 1))
  "Delete `n` characters *after* point; point stays put. Recorded for undo (a
no-op at end-of-buffer is not recorded). Throws if `buf` is read-only."
  (buffer--barf-if-read-only buf)
  (let (p (get buf :point)
        end (buffer--clamp p (buffer-length buf) (+ p n)))
    (if (= p end)
      buf
      (let (buf (buffer--push-undo buf))
        (buffer--adjust-markers
          (assoc buf :rope (rope-delete (get buf :rope) p end) :mark nil)
          :delete p end)))))

(defn delete-backward-char (buf &optional (n 1))
  "Delete `n` characters *before* point (backspace); point moves back with it.
Recorded for undo (a no-op at point 0 is not recorded). Throws if `buf` is read-only."
  (buffer--barf-if-read-only buf)
  (let (p (get buf :point)
        start (buffer--clamp 0 p (- p n)))
    (if (= p start)
      buf
      (let (buf (buffer--push-undo buf))
        (buffer--adjust-markers
          (assoc buf :rope (rope-delete (get buf :rope) start p) :point start :mark nil)
          :delete start p)))))

(defn delete-region (buf)
  "Delete the text between point and mark; point moves to the region start and
the mark is cleared. A no-op (returns `buf`, unrecorded) if no mark is set or the
region is empty. Recorded for undo (restoring it brings back the mark too). Throws if
`buf` is read-only."
  (buffer--barf-if-read-only buf)
  (let (b (buffer-region-bounds buf))
    (if (nil? b)
      buf
      (let ([lo hi] b)
        (if (= lo hi)
          (assoc buf :mark nil)
          (let (buf (buffer--push-undo buf))
            (buffer--adjust-markers
              (assoc buf :rope (rope-delete (get buf :rope) lo hi) :point lo :mark nil)
              :delete lo hi)))))))

(defn replace-region (buf start end s)
  "Replace the characters in `[start, end)` with string `s`, leaving point just after
the inserted text. The splice primitive: completion-at-point, comment toggling,
query-replace, re-indentation, and transpose are all this. Composes `delete-char` +
`insert`, so range clamping and undo behave exactly as those do."
  (insert (delete-char (goto-char buf start) (- end start)) s))

;; ---- public marker API ------------------------------------------------------

(defn buffer-marker-set (buf id pos)
  "Set marker `id` (any value — a keyword, a participant pid) to char position `pos`
(clamped into the buffer). The marker then survives edits: text inserted or deleted before
it shifts it, so it tracks the same logical spot. The basis for overlays, diagnostics, and
remote participants' cursors on a shared buffer."
  (assoc buf :markers (assoc (or (get buf :markers) {}) id (buffer--clamp 0 (buffer-length buf) pos))))

(defn buffer-marker (buf id)
  "The char position of marker `id` (clamped to the current length), or nil if unset."
  (let (p (get (or (get buf :markers) {}) id))
    (if (nil? p) nil (buffer--clamp 0 (buffer-length buf) p))))

(defn buffer-marker-delete (buf id)
  "Remove marker `id`. A no-op if it (or any marker) isn't set."
  (let (m (get buf :markers))
    (if (nil? m) buf (assoc buf :markers (dissoc m id)))))

(defn buffer-markers (buf)
  "The marker map `{id -> pos}` (positions clamped to the current length), or `{}` if none."
  (update-vals (or (get buf :markers) {}) (fn (pos) (buffer--clamp 0 (buffer-length buf) pos))))

;; ---- line-wise region ops (the scaffold for comment / indent-region / …) -----

(defn region-line-range (buf)
  "The inclusive `[startline endline]` line span to act on: the lines the region
covers when a mark is set, else the current line twice. A region ending exactly at a
line's start does **not** pull that trailing line in (Emacs's line-wise convention)."
  (let (rb (buffer-region-bounds buf))
    (if (nil? rb)
      (let (l (buffer-current-line buf)) [l l])
      (let ([lo hi] rb
            sl (buffer-current-line (goto-char buf lo))
            elraw (buffer-current-line (goto-char buf hi))
            hicol (- hi (rope-line->char (buffer-rope buf) elraw)))
        [sl (if (and (> elraw sl) (= hicol 0)) (dec elraw) elraw)]))))

(defn map-region-lines (buf f)
  "Fold `(f buf line)` over each line in `buf`'s `region-line-range`, threading the
buffer through — the scaffold for line-wise commands (comment, indent-region, …).
`f` must not add or remove lines (line numbers stay valid across the fold). Returns
the resulting buffer."
  (let ([sl el] (region-line-range buf))
    (fold f buf (range sl (inc el)))))

;; ---- the actor shell (buffer-as-process) ------------------------------------
;;
;; A buffer process OWNS its buffer (and thus its process-local rope). Clients
;; never receive the buffer — only derived views. Edits and reads cross as
;; *closures* (`buffer -> buffer` and `buffer -> view`), shipped by closure-as-
;; data (ADR-033); the read closure must return a non-rope value.
;;
;; A buffer process is also a first-class **`io` sink**: it answers `[:io-write s]`
;; by appending `s` (the same message `std/io`'s `process-port` and thus `std/log`'s
;; `process-backend` send), so `(add-backend (process-backend a-buffer-pid))` streams
;; log output straight into a buffer — async, share-nothing, no glue.

(defn buffer--push (subs version buf)
  "Notify every subscriber of an edit: send each its `[:buffer-updated <bufpid> version
view]`, where `view` is `(proj buf)` for its registered projection `proj` (a nil projection
pushes a nil view — a bare change notification). Runs in the buffer process, so `(self)` is
the buffer pid the subscriber keys on."
  (doseq (s subs)
    (send (get s :pid)
      [:buffer-updated (self) version (let (proj (get s :proj)) (if (nil? proj) nil (proj buf)))])))

(defn buffer--serve (buf subs version)
  "The receive loop of a buffer process over its immutable `buf`, tracking `subs` (subscriber
`{:pid :proj}` records) and a monotonic `version`. `:edit`/`:io-write` apply a change, bump
the version, and **push** the new projection to every subscriber — the collaboration seam:
two panes or sessions subscribed to one buffer both see every edit. `:get` replies a derived
view synchronously; `:subscribe`/`:unsubscribe` manage the push set (a new subscriber is
seeded with the current state at once, and monitored); `:stop` ends. The rope never leaves
this process — pushes and replies carry only derived, non-rope values (`proj`/`f` must
return such).

**Subscriber lifecycle:** every subscriber is monitored, so a dead one (crash, detach, link
drop) is removed rather than lingering. A marker keyed by the dead subscriber's *pid* is
deleted too — the convention for transient per-subscriber state (a participant's cursor on a
shared buffer: key your marker by your pid and it is cleaned up with you) — and when that
changed the buffer, survivors get a push (they see the cursor vanish)."
  (receive
    ([:edit f] (let (nb (f buf) v (inc version))
                 (do (buffer--push subs v nb) (buffer--serve nb subs v))))
    ([:io-write s] (let (nb (insert (end-of-buffer buf) s) v (inc version))
                     (do (buffer--push subs v nb) (buffer--serve nb subs v))))
    ([:get f from r] (do (send from [:reply r (f buf)]) (buffer--serve buf subs version)))
    ([:subscribe pid proj]
      (do (monitor pid)
        (send pid [:buffer-updated (self) version (if (nil? proj) nil (proj buf))])
        (buffer--serve buf (cons {:pid pid :proj proj} subs) version)))
    ([:unsubscribe pid] (buffer--serve buf (remove (fn (s) (= (get s :pid) pid)) subs) version))
    ([:down _ pid _]
      (let (ns (remove (fn (s) (= (get s :pid) pid)) subs)
            nb (buffer-marker-delete buf pid))
        (if (= nb buf)
          (buffer--serve buf ns version)  ; no marker for it — just drop the subscriber
          (let (v (inc version)) (do (buffer--push ns v nb) (buffer--serve nb ns v))))))
    ([:stop from r] (send from [:reply r :stopped]))))

(defn spawn-buffer (buf)
  "Spawn a process that owns a copy of `buf` and serves edits/queries; return its
pid. The rope can't cross a process boundary, so this ships `buf`'s *text* (plus
name/file/point/mark) and rebuilds the rope inside the new process. Drive it with
`buffer-edit` and `buffer-query`."
  (let (text (buffer-text buf)
        name (buffer-name buf)
        file (buffer-file buf)
        pt (buffer-point buf)
        mk (buffer-mark buf))
    (spawn (buffer--serve (assoc (make-buffer text name file) :point pt :mark mk) () 0))))

(defn buffer-edit (bp f)
  "Apply pure transform `f` (a `buffer -> buffer` fn) inside buffer process `bp`.
Asynchronous — returns nil."
  (send bp [:edit f]))

(defn buffer-query (bp f)
  "Synchronously read a derived view from buffer process `bp` via pure fn `f` (a
`buffer -> view`). `f` must return a non-rope value — e.g. `buffer-text`,
`buffer-point`, `(fn (b) (buffer-line-at b 0))`. Blocks for the reply."
  (let (r (ref))
    (send bp [:get f (self) r])
    (receive ([:reply ~r v] v))))

(defn subscribe-buffer (bp proj)
  "Subscribe the calling process to buffer process `bp`. It immediately receives — and then
gets on every edit — `[:buffer-updated bp version view]`, where `view` is `(proj buffer)`, a
derived non-rope value (a viewport projection, the text, a marker set), or nil when `proj` is
nil (a bare change notification). The push side of buffers-as-processes: a pane subscribes
with its viewport projection and re-renders from each pushed frame instead of polling. Many
processes may subscribe to one buffer — that is what lets several sessions see each edit."
  (send bp [:subscribe (self) proj]))

(defn unsubscribe-buffer (bp)
  "Stop the calling process receiving `[:buffer-updated …]` pushes from buffer process `bp`."
  (send bp [:unsubscribe (self)]))

(defn stop-buffer (bp)
  "Stop buffer process `bp` (it leaves its loop). Synchronous; returns :stopped."
  (let (r (ref))
    (send bp [:stop (self) r])
    (receive ([:reply ~r v] v))))

;; ---- create / delete (the buffer-process lifecycle) -------------------------

(defn create-buffer (&optional (name "*scratch*"))
  "Spawn a fresh, empty buffer process named `name` and return its **pid**. The
process serves `buffer-edit` / `buffer-query` and accepts `[:io-write s]`, so it is a
valid `io`/logger sink — `(add-backend (process-backend (create-buffer \"*log*\")))`
streams log output straight into it. Tear it down with `delete-buffer`. (High-volume
sinks may want `(buffer-edit pid disable-undo)` so appends don't grow undo history.)"
  (spawn-buffer (make-buffer "" name)))

(defn delete-buffer (bp)
  "Stop buffer process `bp` and free it — the symmetric name for `stop-buffer`.
Synchronous; returns :stopped."
  (stop-buffer bp))
