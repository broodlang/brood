;; std/editor/ui.blsp — the reusable terminal/GUI app framework.
;;
;; Extracted from the observer so a *new* project (the coming editor) builds on the
;; same seam instead of re-inventing it. Two pieces:
;;
;;  - **Frontends** (ADR-046: one render-op protocol, many frontends). A *display*
;;    is a map of five fns `{:enter :leave :size :draw :poll}`. `editor/ui/*term-display*` is
;;    the crossterm terminal; `(gui-display)` opens a native window (needs
;;    `--features gui`); `display-broadcast` fans one frame out to several at once.
;;    All over the `term-*` / `gui-*` primitives — the same pure `view` frame paints
;;    to any of them unchanged. A display that sets `:fragments? true` (the GUI window)
;;    is handed the frame with its `ui-memo` markers in, and reuses what it parsed a
;;    reused fragment to last frame (ADR-470); every other display gets them spliced.
;;  - **The app loop** `(ui-run model view update display)` — a tiny TEA-style loop:
;;    enter the frontend, then render `(view model cols rows)`, poll input, fold it
;;    with `(update model input cols rows)`, recurse until the model is `:done`, then
;;    leave. `input` is the frontend's key/mouse value, or `:tick` on the poll
;;    timeout (the refresh beat).
;;
;; Both the observer (`std/tool/observer.blsp`) and the editor are just `ui-run` clients:
;; they supply a `view` (model+size → frame, built with `display.blsp` ops) and an
;; `update` (model+input+size → model, dispatching via `keymap.blsp`, prompting via
;; `lineedit.blsp`, colouring via `highlight.blsp`). That is the dogfooding proof —
;; the framework is whatever the observer needs, nothing observer-specific.

(defmodule editor/ui
  "A small terminal/GUI app framework over the M3 display/input seam (ADR-046): a
`display` frontend (`editor/ui/*term-display*` / `(gui-display)` / `display-broadcast`) plus a
TEA-style `(ui-run model view update display)` loop. Build an app by supplying a
pure `view` (model + cols/rows → a render frame) and an `update` (model + input +
cols/rows → model); set `:done` in the model to quit, and declare time-driven work
as `:timers` (named timers, ADR-102) — or, legacy, `:tick-ms` for a single refresh
beat. The observer and the editor are both `ui-run` clients — see
`std/tool/observer.blsp`."
  (:use map))

;; ---- frontends (ADR-046: one render-op protocol, many frontends) ------------
;;
;; The same pure `view` frame therefore paints to the terminal, a GUI window, or
;; several at once. `term-*` / `gui-*` are the two Rust-backed frontends (mechanism
;; only); the composition below — fan a frame out to every frontend, merge their
;; keys, render at the smallest common grid — is all Brood, so it stays live-
;; editable and grows to remote frontends.

(defn display-polls (poll-tagged)
  "A display's poll entries from its `poll-tagged` (ADR-490): `:poll-tagged`, the `:poll`
derived from it (the message without its tag), and `:poll-tagged-of`, that same `:poll` —
the mark that the two agree. A wrapper that replaces `:poll` (`(assoc display :poll …)`, as
apps did before `:poll-tagged` existed) leaves the mark pointing at the old one, so
`display-poll-tagged` asks the new `:poll` rather than a `:poll-tagged` that bypasses it.
Merge the result into the display map.

    (let (d (editor/ui/display-polls (fn (ms) [\"x\" true]))) [((get d :poll) 0) ((get d :poll-tagged) 0)])   ;=> [\"x\" [\"x\" true]]"
  (let (poll (fn (ms) (display-untag (poll-tagged ms))))
    {:poll poll :poll-tagged poll-tagged :poll-tagged-of poll}))

(defdyn editor/ui/*term-display*
  ;; the terminal (crossterm) frontend — always available, and single (one
  ;; terminal), so it's a fixed display map of the 0-arg `term-*` primitives.
  ;; `:key-held?` is reported by a terminal speaking the kitty keyboard protocol and
  ;; inferred from the repeats in any other (`term/held-key`).
  ;; While it is entered, a reader thread delivers the terminal's keys and mouse to the
  ;; loop's PRIORITY lane (`term/forward-input`, ADR-491), as a window delivers its input:
  ;; a key typed while the loop is busy is queued where the kernel's quit key sees it, so a
  ;; terminal C-g stops a stuck turn. So the terminal polls the mailbox as the window does —
  ;; input first, and the loop's background messages arrive tagged as such (ADR-490).
  (merge
    {:enter (fn ()
              (do
                (term/enter)
                (term/forward-input (self))))
     :leave (fn ()
              (do
                (term/forward-input nil)
                (term/leave)))
     :size term/size
     :draw term/draw
     :poll-input (fn () (ui-take-input))
     :key-held? (fn () (not (nil? (term/held-key))))
     ;; a kill reaches the clipboard of the machine the user sits at: the desktop's
     ;; when there is one, the TERMINAL's (OSC 52) over ssh or on a console (ADR-587)
     :clipboard-set (fn (text) (term-clipboard-set text))
     :primary-set (fn (text) (term-clipboard-set text :primary))}
    (display-polls (fn (ms) (ui-receive-tagged ms)))))

(defn display-available? ()
  "Whether a native window can be opened here: the runtime has the GUI backend
(`gui/available?`) and the session has a display to put it on — `$WAYLAND_DISPLAY` or
`$DISPLAY` on Linux and the BSDs, a desktop login (not an ssh session) on macOS, always on
Windows. A headless GUI runtime (`BROOD_GUI_HEADLESS`) counts as one: its windows open,
drawing nothing. The question a program that can run in a window OR the terminal asks
before choosing — Emacs's `-nw` when there is no display (ADR-587).

    (bool? (editor/ui/display-available?))   ;=> true"
  (let (set? (fn (name) (let (value (os/env name)) (and (string? value) (not (= value ""))))))
    (and (gui/available?)
      (or (gui/headless?)
        (case (os/type)
          :windows true
          :macos (not (or (set? "SSH_CONNECTION") (set? "SSH_TTY")))
          (or (set? "WAYLAND_DISPLAY") (set? "DISPLAY")))))))

(defn term-clipboard-set (text &optional (selection :clipboard))
  "Put `text` on the clipboard (or, `selection` `:primary`, the PRIMARY selection) of the
machine the user sits at, from a program in a TERMINAL: the desktop's own when a display is
reachable (`display-available?`, `os/clipboard-set`), else the terminal's, through the OSC
52 escape (`editor/ansi/ansi-clipboard`) — what reaches the user's machine from the far end
of ssh, from tmux, from a console. A terminal without OSC 52 ignores it. Returns nil (ADR-587).

    (editor/ui/term-clipboard-set \"copied\")   ;~> nil, \"copied\" on the user's clipboard"
  (if (display-available?)
    (if (= selection :primary) (os/primary-set text) (os/clipboard-set text))
    (io/write (editor/ansi/ansi-clipboard text selection)))
  nil)

(defn- ui-coalesce-motion (msg)
  "Collapse a flood of pointer-motion events — a `:drag` or a `:move` — down to the
latest of its kind. A fast pointer emits one event per cell it crosses (ADR-080), so the
mailbox backs up and the loop folds and renders every intermediate position: a drag
visibly lags, filling in cell by cell, and a plain move costs a full turn (fold + view)
per cell even when nothing on screen depends on it. Only the *final* position matters
for either gesture (a drag-select region is just `[mark, point]`, a hover just where the
pointer is now), so when `msg` is one, we pull every further event of the SAME kind
already queued — a non-blocking selective `receive` that leaves keys / ticks / async
replies / the other kind untouched — and return the last. A `:move` never swallows a
`:drag` (nor the reverse): a press between two moves changes what the later one means.
`msg` unchanged when it isn't motion (incl. nil on timeout)."
  (if (and (vector? msg)
        (>= (count msg) 2)
        (= (nth msg 0) :mouse)
        (or (= (nth msg 1) :drag) (= (nth msg 1) :move)))
    (let (kind (nth msg 1))
      ;; every shape motion comes in: a window adds the pointer's fractional position
      ;; as `{:at …}` after a nil 7th slot, and a 6-element-only pattern never matched
      ;; one, so a window's drag was folded and rendered cell by cell (ADR-490)
      (receive
        ([:mouse ^kind button row col mods] (ui-coalesce-motion [:mouse kind button row col mods]))
        ([:mouse ^kind button row col mods extra] (ui-coalesce-motion [:mouse
                                                                        kind button row col mods
                                                                        extra]))
        ([:mouse ^kind button row col mods extra at] (ui-coalesce-motion [:mouse
                                                                           kind button row col mods
                                                                           extra at]))
        (after 0 msg)))
    msg))

;; ---- what counts as input (ADR-490) -----------------------------------------
;; A loop's mailbox carries two kinds of message: the USER's input — a key, a mouse
;; event, typed or composed text, a resize, the close button, focus in or out — and
;; everything else, the background: task replies, a language server's diagnostics, a
;; test stream, collab deltas. Folded in arrival order, a flood of background puts the
;; user's next key behind all of it, and the editor stops answering for as long as the
;; flood lasts. So input is told apart where it is MADE, not by its shape: a window and a
;; browser tab deliver everything they send on the mailbox's priority lane
;; (`proc/send-priority`), the terminal's keys come from the terminal itself, and a
;; served session's from its thin client's `[:key …]` messages. Each display says which
;; through two entries:
;;   :poll-input   a 0-arg fn: the next queued INPUT or nil, at once, touching nothing else
;;   :poll-tagged  `(fn (ms) …)`: the OLDEST message of any kind, waiting up to `ms`, as
;;                 `[message input?]` — nil on timeout
;; `:poll` stays what it always was (`:poll-tagged` without the tag), for callers outside
;; the loop. The loop asks `display-poll-input` first and parks on `display-poll-tagged`
;; after, so it serves input before background whatever the display, knows which a
;; message that woke it was (only input holds idle timers back), and still has an
;; arrival-order slot that keeps background moving while input never stops
;; (`ui-drain-input`).

(defn- ui-take-input ()
  "The oldest input a window delivered to this process's mailbox — its priority lane
(`proc/take-priority`) — with pointer motion coalesced to its latest (`ui-coalesce-motion`);
nil when no input is queued, however much else is."
  (let (taken (proc/take-priority))
    (if (nil? taken) nil (ui-coalesce-motion (first taken)))))

(defn- ui-receive-tagged (ms)
  "A window's `:poll-tagged`: the oldest message in this process's mailbox, waiting up to
`ms`, as `[message input?]` — input when it came on the priority lane, where the window
delivers (`proc/receive-lane`) — with pointer motion coalesced; nil on timeout."
  (let (received (proc/receive-lane ms))
    (if (nil? received)
      nil
      [(ui-coalesce-motion (first received)) (= (second received) :priority)])))

(defn- display-untag (tagged)
  "The message of a `[message input?]` poll result, nil for nil — `:poll` from `:poll-tagged`."
  (if (nil? tagged) nil (first tagged)))

(defn display-poll-input (display)
  "The next user input queued for `display`, or nil — at once, and ahead of any
background message queued before it (ADR-490): its `:poll-input`. A display without one
answers nil, so the loop folds what its `:poll` returns in arrival order, as before.

    (editor/ui/display-poll-input {:poll-input (fn () \"x\")})   ;=> \"x\"
    (editor/ui/display-poll-input {})   ;=> nil"
  (let (poll-input (get display :poll-input))
    (if poll-input (poll-input) nil)))

(defn display-poll-tagged (display ms)
  "The oldest message for `display`, waiting up to `ms`, as `[message input?]`, or nil on
timeout (ADR-490): its `:poll-tagged`. A display without one has its `:poll` asked, and
what that returns counts as input unless the display has a `:poll-input` — a display that
cannot tell input apart keeps every message holding idle timers back, as before. So does a
display whose `:poll` was replaced after `display-polls` made its `:poll-tagged` (its
`:poll-tagged-of` is no longer its `:poll`): the replacement is what the app meant.

    (editor/ui/display-poll-tagged {:poll (fn (ms) \"x\")} 0)   ;=> [\"x\" true]
    (editor/ui/display-poll-tagged {:poll (fn (ms) nil)} 0)   ;=> nil"
  (let (tagged (get display :poll-tagged)
        of (get display :poll-tagged-of))
    (if (and tagged (or (nil? of) (= of (get display :poll))))
      (tagged ms)
      (let (message ((get display :poll) ms))
        (if (nil? message) nil [message (nil? (get display :poll-input))])))))

(defn- display-configure-window (id o)
  "Apply the runtime-switchable window options in `o` to window `id`: `:input`
(`:pixels` / `:cells`) and `:title`. The subset of `gui/open`'s options an app can still
ask for after the window exists — which is what an app that attached to a window it did
not open needs."
  (when (get o :input) (gui/input id (get o :input)))
  (when (get o :title) (gui/title id (get o :title)))
  nil)

(defn display-texture "Upload an image as a texture through `display` — a `gui-display` (the window it owns) or the `remote-display` a served app draws to (the thin client's window, over the wire) — and return its handle, for `gui/sprite`. Either `(display-texture d image)` with the {:width :height :rgba} map `gui/image-thumb` decodes, or `(display-texture d rgba w h)` with raw bytes. The handle comes from `gui/alloc-texture`, so `gui/texture-size` knows it; a display without a `:texture` entry (the terminal) accepts and ignores the upload.

    (gui/texture-size (editor/ui/display-texture {} {:width 2 :height 1 :rgba [0 0 0 0 0 0 0 0]}))   ;=> [2 1]"
  ((display image) (display-texture display
                     (get image :rgba)
                     (get image :width)
                     (get image :height)))
  ((display rgba w h) (let (tex (gui/alloc-texture w h))
                        (when (get display :texture) ((get display :texture) tex rgba w h))
                        tex)))

(defn display-sound (display pcm rate &optional channels)
  "Keep a sound through `display` — a `gui-display` or a served app's `remote-display`
(the thin client's window, over the wire) — and return its handle, for a `[:sound snd vol]`
or `[:music snd vol]` frame op. `pcm` is interleaved PCM16 little-endian samples at `rate` Hz, `channels` 1
(default) or 2. The handle comes from `gui/alloc-sound`; a display without a `:sound`
entry (the terminal) accepts and ignores the upload.

    (gui/sound-seconds (editor/ui/display-sound {} [0 0 0 0] 2))   ;=> 1.0"
  (let (ch (or channels 1)
        n (if (bytes? pcm) (bytes/length pcm) (count pcm))
        snd (gui/alloc-sound (->float (/ (math/quot n 2) (* rate ch)))))
    (when (get display :sound) ((get display :sound) snd pcm rate ch))
    snd))

(defn gui-display (&optional (opts nil))
  "Open a **new** native window and return a display (the `{:enter :leave :size
:draw :poll}` map) bound to it — each call is a separate window, so several
observers (or editor windows) can run at once. Unlike `editor/ui/*term-display*` (one
terminal, a constant), the windowed frontend is a *constructor*: it calls `gui/open`
for a fresh window id and closes the `gui-*` primitives over it. The window is
opened eagerly here, so `:enter` is a no-op and `:leave` closes it. Needs the
runtime built with `--features gui` (`./configure --with-gui && make install`), else
`gui/open` errors. The map also carries the raw `:window` id.

`opts` is passed through to `gui/open`, so a frontend can ask for a window that
suits it: `:title` names it, `:width`/`:height` size it (logical pixels), `:input :pixels`
and `:vsync true` are the game options (ADR-374), `:key-repeat :os` hands a held key's repeat
to the OS (the user's delay and rate; at most one undelivered, taken back at the
release), `:ime false` turns the input method off and `:wheel :glide` makes a wheel notch
glide instead of scrolling its three lines at once (ADR-441), `:option-meta` picks which macOS
Option key is Meta, the other composing (`:left`, the default, `:right`, `:both`, `:none`;
ADR-541), and `{:decorations false}`
drops the OS title bar and frame for an app that draws its own chrome (a browser's tab
strip and toolbar) and would otherwise sit under a redundant second title. A shipped app
should also pass `:app-id` — the desktop application id the installed
`<app-id>.desktop` entry is named after, which is what earns the window its own icon and
name in a GNOME dash or alt-tab instead of the desktop's generic fallback.

**Create and poll it in the same process.** `:draw`/`:size`/`:leave` act on the
captured window id, but `:poll` is a `receive` on the *calling* process's mailbox
(that's where `gui/open` delivers this window's input, ADR-059) — it ignores the
window id. So a display made here must be polled by the process that made it; don't
hand it to another process to run. And because the delivered key/mouse messages
carry no window id, one process should drive **one** window (which is why
`(observe)` spawns a process per window) — two windows in one process would mix
their input. Both are deferred trade-offs (ADR-059), fine for the observer.

    (editor/ui/gui-display {:title \"demo\" :width 800 :height 600})   ;~> {:enter … :draw … :poll … :window id}, or an error without the gui feature"
  (let (id (gui/open (get opts :title) (get opts :width) (get opts :height) opts))
    (merge
      {:enter (fn () nil)
       :leave (fn () (gui/close id))
       :size (fn () (gui/size id))
       :draw (fn (f) (gui/draw id f))
       ;; the window takes `ui-memo` markers: a fragment the loop reused is not parsed
       ;; again, and is the same allocation as last frame's to its diff (ADR-470)
       :fragments? true
       ;; a turn the loop skipped (ADR-444): the window still learns the app is done with
       ;; it — its wheel glide paces on that, and the latency trace drops the input
       :settle (fn () (gui/settle id))
       ;; a thin client's daemon says its loop is busy (ADR-491): the wait cursor, as for
       ;; this window's own loop
       :busy (fn (on) (%gui-busy id on))
       ;; a key is down: the loop holds its idle timers until it comes up
       :key-held? (fn () (not (nil? (gui/held-key id))))
       ;; The pixel-space seam (ADR-374), for a game: a texture under a handle the app
       ;; allocated (`gui/alloc-texture`), released again, and the window told which
       ;; input unit / title the app wants — the three things that also cross the wire
       ;; in `editor/serve/remote-display`, so an app written against a display runs
       ;; unchanged in its own window or in a thin client's.
       :texture (fn (tex rgba w h) (%gui-texture id tex rgba w h))
       :texture-free (fn (tex) (%gui-texture-free id tex))
       :sound (fn (snd pcm rate channels) (%gui-sound id snd rate channels pcm))
       :sound-free (fn (snd) (%gui-sound-free id snd))
       :configure (fn (o) (display-configure-window id o))
       ;; Input arrives as mailbox messages (gui/open delivers to this process), so
       ;; `:poll` is a `receive` that parks the process — it holds no scheduler worker
       ;; while waiting (ADR-059), unlike a blocking poll. Returns the next key/mouse
       ;; message, or nil after `ms` (the live-refresh tick) — the OLDEST message, of any
       ;; kind. The window delivers on the priority lane, so `:poll-input` takes its input
       ;; ahead of a background backlog (ADR-490).
       :poll-input ui-take-input
       ;; Raise this window to the front + focus it (un-minimising) — `ui-run` calls
       ;; this when a `:focus` control message lands in the mailbox, so another process
       ;; can surface an already-open singleton window (e.g. a second `(observe)`).
       :focus (fn () (gui/focus id))
       :window id}
      (display-polls ui-receive-tagged))))

(defn display-key-held? (display)
  "Whether a key is down in `display` — its `:key-held?`, which a GUI window answers from
the press and release it saw (the terminal too, when it speaks the kitty keyboard protocol);
false for a display that cannot tell. `ui-run` holds its idle timers while it is true, and a
thin client (`editor/serve`) ships it with each key so a served app's loop does the same.

    (editor/ui/display-key-held? {:key-held? (fn () true)})   ;=> true
    (editor/ui/display-key-held? {})   ;=> false"
  (let (held? (get display :key-held?))
    (if held? (held?) false)))

(defn- display-min-size (displays)
  "The smallest cols×rows across all frontends, so one broadcast frame fits every
screen (a larger frontend just shows it in its top-left)."
  (fold displays
    nil
    (fn (acc d)
      (let ([c r] ((get d :size)))
        (if (nil? acc)
          [c r]
          (let ([ac ar] acc) [(math/min ac c) (math/min ar r)]))))))

(defn- display-poll-loop (displays slice)
  (if (empty? displays)
    nil
    (let (tagged (display-poll-tagged (first displays) slice))
      (if (nil? tagged) (display-poll-loop (rest displays) slice) tagged))))

(defn- display-poll-input-any (displays)
  "The first input any frontend has queued (`display-poll-input`), or nil."
  (if (empty? displays)
    nil
    (let (input (display-poll-input (first displays)))
      (if (nil? input) (display-poll-input-any (rest displays)) input))))

(defn- display-poll-any (displays ms)
  "Poll each frontend for a slice of `ms` in turn, returning the first message seen as
`[message input?]` (or nil) — so a keystroke from *any* attached frontend reaches the
loop. A frontend's QUEUED input is taken first, from whichever has it, so one member's
slice is never waited out while another already holds a key."
  (let (input (display-poll-input-any displays))
    (if (nil? input)
      (display-poll-loop displays (math/max 1 (math/quot ms (math/max 1 (count displays)))))
      [input true])))

(defn display-broadcast (displays)
  "Compose several displays into one that fans a single frame out to all of them
and merges their input: update the view and *every* attached frontend updates
together (a GUI window and the terminal today; remote frontends later — they slot
in as just another member). The frame renders at the smallest common grid so it
fits everywhere. Pure Brood over the `term-*`/`gui-*` mechanism.

    (editor/ui/display-broadcast [editor/ui/*term-display* (editor/ui/gui-display)])   ;~> one display map driving both frontends"
  (merge {:enter (fn () (doseq (d displays) ((get d :enter))))
          :leave (fn () (doseq (d displays) ((get d :leave))))
          :size (fn () (display-min-size displays))
          :draw (fn (f) (doseq (d displays) ((get d :draw) f)))
          :settle (fn () (doseq (d displays) (when (get d :settle) ((get d :settle)))))
          :key-held? (fn () (any? displays display-key-held?))
          :poll-input (fn () (display-poll-input-any displays))}
    (display-polls (fn (ms) (display-poll-any displays ms)))))

(defn with-events (display)
  "Wrap `display` so its polls first return any queued `[:sse-open …]` / `[:sse …]` /
`[:sse-closed …]` mailbox message (from an `sse/connect` whose subscriber is this
process), tagged as background, else poll `display` as usual. Every std display already
polls the whole mailbox (the terminal too, since its keys come through it — ADR-491), so
what this adds is ORDER: the pushed events are taken before whatever else is queued.
`update` folds an `[:sse ev]` like any other message. The other display ops pass through unchanged.
The display's `:poll-input` passes through too, so `ui-run` still takes a queued key
ahead of a flood of pushes (ADR-490). Needs the `sse` module on the producing side
(loaded by referencing `sse/…`).

    (editor/ui/with-events editor/ui/*term-display*)   ;~> the display, its :poll also yielding [:sse ev] messages"
  (let (poll-tagged (fn (ms)
                      (let (event (receive
                                    ([:sse-open s] [:sse-open s])
                                    ([:sse e] [:sse e])
                                    ([:sse-closed r] [:sse-closed r])
                                    (after 0 nil)))
                        ;; a pushed event is background, never the user's input
                        (if (nil? event) (display-poll-tagged display ms) [event false]))))
    (merge display (display-polls poll-tagged))))

;; ---- the app loop (TEA: model + view + update) ------------------------------

(defn- ui-tick-ms (model)
  "The poll timeout (refresh beat) in ms: `(get model :tick-ms)` or 1000 by default.
The legacy single-beat knob; superseded by `:timers` (ADR-102) — kept for the
synthesized back-compat timer below and any app that hasn't moved to named timers."
  (or (get model :tick-ms) 1000))

;; ---- named timers (ADR-102) -------------------------------------------------
;; A model may carry `:timers` — a map `name -> spec`, where a spec is `{:every ms}`
;; (repeating) or `{:after ms}` (one-shot), optionally with `:command? true` (the timer
;; continues the user's own command, so its fold is served as input's: no background ceiling,
;; ADR-564) and `:idle? true` (count from
;; the last *real* input, not from arm/last-fire). Each firing delivers `[:timer name]`
;; as loop input; an idle timer pauses while input flows and resumes once it settles.
;; A key held down counts as input flowing, before its first repeat as after it.
;; This replaces juggling a single `:tick-ms` beat: a steady animation timer (cursor
;; blink) and several idle one-shots (debounce, which-key) now coexist, each with its
;; own clock and its own fired-event identity. Named timers are **opt-in by the
;; `:timers` key**: with no such key the loop takes the legacy path unchanged (a `nil`
;; poll → the bare keyword `:tick`, the `:tick-ms` beat) — so the observer and any
;; pre-timers app are untouched; with the key, the clock-driven path below. The
;; per-timer bookkeeping — when each timer appeared, when it last fired, and the
;; last-input time — lives in a `clock` map threaded through `ui-loop`, NOT in the
;; model: it's wall-clock reality, so it never rolls back when a view/update crash
;; rolls the model back.

(def *ui-idle-cap* 60000)
;; The longest the loop will park when no live timer needs servicing sooner — a
;; ceiling on the poll timeout so a far-future (or fired-and-done) timer can't make
;; the loop oversleep. Input still wakes it immediately; this only bounds the idle wait.

(def *ui-input-batch* 1024)
;; The most inputs `ui-drain-input` folds into ONE render when a `:coalesce-input?`
;; app has a backlog (see below) — a ceiling so a self-feeding source (an `update`
;; that re-enqueues to itself) can't starve the render forever; hitting it just renders
;; and the next iteration drains the rest.

(def *ui-fold-budget-ms* 8)
;; How long one turn of a `:coalesce-input?` app may spend folding BACKGROUND messages
;; before it renders and looks for input again (ADR-490); a model's `:fold-budget-ms`
;; overrides it. Half a 60 Hz frame: a flood of any size then shows its progress at
;; least every frame or two, and a key typed into it waits about this long plus one
;; fold, where it used to wait for the whole backlog. Much smaller and a turn renders
;; after only a few folds, so a burst costs many frames — the cost coalescing exists to
;; avoid; much larger and typing during a flood is visibly late.

(def *ui-slow-ms* 50)
;; The watchdog's line (ADR-490): an `update` fold or a `view` slower than this is
;; reported, naming what it was folding (`ui-input-tag`). Three frames — past it a
;; stall is something a user sees, and below it the report would be noise from GC
;; pauses and a busy machine. A model's `:slow-ms` overrides it.

(def *ui-quit-key* :ctrl-g)
;; The input that QUITS a turn stuck in `update` or `view` (ADR-491) — Emacs's
;; `quit-char`. A window delivers C-g as `:ctrl-g` on the priority lane; `ui-run` hands it
;; to the kernel (`proc/set-quit-key`), which interrupts the running fold or view when it
;; arrives while the turn is past `*ui-quit-busy-ms*`. A model's `:quit-key` overrides it,
;; nil turning it off.

(def *ui-quit-busy-ms* 300)
;; How long a turn must have been running before its quit key interrupts it rather than
;; just queueing (ADR-491): a C-g typed during a normal fast turn is an ordinary key for
;; the app. A model's `:quit-busy-ms` overrides it.

(def *ui-event-ceiling-ms* 2000)
;; The longest the loop lets the fold of a BACKGROUND message (a reply, a stream line, a
;; timer) run before it interrupts it itself (ADR-491): no user asked for that work, so
;; nobody is there to press C-g for it. A user's own command is never stopped this way —
;; only C-g stops it, as in Emacs. A model's `:event-ceiling-ms` overrides it, nil
;; turning it off.

(def *ui-slow-update-quiet-ms* 1000)
;; At most one slow-UPDATE report per this many ms (an interrupted one is always reported:
;; it is what an editor says "Quit" for). A run of slow folds — a reply stream each of
;; whose folds is just over the line — would otherwise report once per fold, and an app
;; that logs the report into its model makes the next fold slower still.

(defdyn editor/ui/*slow-reports* nil)
;; The loop's watchdog bookkeeping, a table bound for the loop's life: when it last reported
;; a slow update (`:update-at`). nil outside a loop, where nothing is rate-limited.

(def *ui-slow-view-quiet-ms* 5000)
;; At most one slow-VIEW report per this many ms. A view has no input to name and is
;; slow for as long as what it draws is big, so a report per frame would be a flood of
;; its own — and an app that logs the report into its model makes the next frame, which
;; is slow again: rate-limiting is what keeps that from feeding itself.

(defn- ui-now (model)
  "The current wall-clock in ms — `(os/now)`, unless the model carries a `:now-fn` (a
0-arg fn), which the loop calls instead. The injection seam tests use to drive timers
off a scripted clock deterministically, with no real sleeping."
  ((or (get model :now-fn) os/now)))

(defn- ui-timer-ms (spec)
  "A timer spec's interval in ms — its `:every` (repeating) or `:after` (one-shot)."
  (or (get spec :every) (get spec :after)))

(def *ui-held-quiet-ms* 2000)
;; While a key is held, an `:idle?` timer waits at least this long after the last input.
;; Held is not idle: under the OS repeat each repeat is an input and pushes the timer out
;; anyway, but the desktop's delay before the FIRST repeat (250 ms to over a second) is a
;; gap no input fills, and an idle beat, a debounce or a caret blink would run in it. The
;; bound is for a hold that never repeats (repeat switched off) and a release the window
;; never saw: idle work is held back, never lost.

(defn- ui-deadline (spec armed fired last-input &optional (held? false))
  "When timer `spec` next wants to fire, as an absolute ms time. `armed` is when it
first appeared; `fired` is when it last fired (nil if never). A repeating timer counts
from its last fire (or, before the first fire, from `armed`); a one-shot always counts
from `armed`, so its deadline is fixed and it fires exactly once per arming. An
`:idle?` timer counts from the later of that base and `last-input`, so a real key
pushes it out — it fires only after input settles — and, while `held?` (a key is down),
no sooner than `*ui-held-quiet-ms*` after that input."
  (let (ms (ui-timer-ms spec)
        idle? (get spec :idle?)
        base0 (if (contains? spec :every) (or fired armed) armed)
        deadline (+ (if idle? (math/max base0 last-input) base0) ms))
    (if (and idle? held?)
      (math/max deadline (+ last-input *ui-held-quiet-ms*))
      deadline)))

(defn- ui-timer-live? (fired deadline)
  "Whether a timer with last-fire `fired` and next-fire `deadline` can still fire — its
deadline is strictly past its last firing. False for a one-shot that already fired (its
deadline is fixed at-or-before `fired`); true for a repeating timer (each fire advances
the base, so the next deadline moves ahead) and for an idle one-shot once new input has
pushed the deadline past the last fire."
  (> deadline (or fired -1)))

(defn- ui-clock-init (clock timers now)
  "Refresh the loop clock for this iteration: default `:last-input` to `now` on the
first pass, GC the per-timer `:armed`/`:fired` maps down to the live timer set (so a
removed-then-re-added timer re-arms clean and stale entries can't leak), and stamp
`:armed` = `now` for any timer seen for the first time (its base)."
  (let (ks (keys timers)
        last-input (or (get clock :last-input) now)
        armed0 (select-keys (or (get clock :armed) {}) ks)
        fired (select-keys (or (get clock :fired) {}) ks)
        armed (fold ks armed0 (fn (a k) (if (contains? a k) a (assoc a k now)))))
    ;; `:memo` (the view's memoised fragments, ADR-336) rides along untouched
    (assoc clock :last-input last-input :armed armed :fired fired)))

(defn- ui-poll-ms (timers clock now)
  "How long to park the poll: the soonest *live* timer deadline minus `now` (at least
1ms), or `*ui-idle-cap*` when no live timer is pending — capped at the idle ceiling so
a far-future timer can't oversleep a responsive app."
  (let (last-input (get clock :last-input)
        held? (get clock :key-held?)
        armed (get clock :armed)
        fired (get clock :fired)
        best (map/reduce-kv timers
               nil
               (fn (acc name spec)
                 (let (d (ui-deadline spec
                           (get armed name)
                           (get fired name)
                           last-input
                           held?))
                   (if (and (ui-timer-live? (get fired name) d) (or (nil? acc) (< d acc)))
                     d
                     acc)))))
    (if (nil? best)
      *ui-idle-cap*
      (math/max 1 (math/min *ui-idle-cap* (- best now))))))

(defn- ui-command-timer? (timers event)
  "Whether the `[:timer name]` firing `event` continues the user's own command — its spec says
`:command? true` (a keyboard macro's next slice) — so its fold is served as input's is: no
background ceiling stops it (`ui-event-ceiling-ms`), only the quit key, as a command run in
one turn would be. A step that ran past the ceiling and was stopped would leave the model it
started from, and the timer would run the same step again."
  (= true (get (get timers (second event)) :command?)))

(defn- ui-fire (timers clock now)
  "Service the timers at time `now`: find the earliest *live* timer whose deadline has
arrived and return `[event clock']`, where `event` is `[:timer name]` and `clock'`
records the firing. When none is due, `[nil clock]` — the loop re-parks without folding.
Only one timer fires per call; simultaneous timers serialize over successive iterations
(each next poll clamps to 1ms while another is overdue)."
  (let (last-input (get clock :last-input)
        held? (get clock :key-held?)
        armed (get clock :armed)
        fired (get clock :fired)
        due (map/reduce-kv timers
              nil
              (fn (acc name spec)
                (let (d (ui-deadline spec (get armed name) (get fired name) last-input held?))
                  (if (and (>= now d)
                        (ui-timer-live? (get fired name) d)
                        (or (nil? acc) (< d (second acc))))
                    [name d]
                    acc)))))
    (if (nil? due)
      [nil clock]
      (let (name (first due))
        [[:timer name] (map/assoc-in clock [:fired name] now)]))))

(defn quit-request? (input)
  "True if `input` is a window-close request (`:close`) — the frontend (the GUI's X
button) asking the app to quit, as distinct from the Escape *key* (`:escape`).
`ui-run` already quits on `:close` for you; reach for this only in a hand-rolled
`receive` loop (one not built on `ui-run`) so the X button closes the window
alongside whatever quit keys you bind — e.g. `(:close :quit)` next to your own.

    (editor/ui/quit-request? :close)    ;=> true
    (editor/ui/quit-request? :escape)   ;=> false"
  (= input :close))

(defn- ui-close-quits? (model input)
  "Whether `input` is a `:close` the LOOP must act on: the window's X button, for an app
that has not claimed it. An app sets `:close-is-input? true` on its model to fold `:close`
through `update` like any key instead — so it can ask about unsaved work before quitting
(Emacs's `save-buffers-kill-terminal` on the window manager's close) and quit by setting
`:done` itself. Without the flag every `ui-run` app stays closeable by its X button with
no wiring, as before."
  (and (quit-request? input) (not (get model :close-is-input?))))

(defn focus-request? (input)
  "True if `input` is a `:focus` control message — a request (delivered to this
process's mailbox by another process) to raise this app's window to the front.
`ui-run` handles it by calling the display's `:focus`; a frontend without one (the
terminal) just ignores it. The seam a singleton launcher uses to surface an
already-open window instead of opening a duplicate (e.g. a repeated `(observe)`).

    (editor/ui/focus-request? :focus)   ;=> true"
  (= input :focus))

(defn- ui-log-error (where e)
  "Log a caught `view`/`update` error to stderr (via `*err*`, so it's redirectable)
— it would otherwise vanish with the echo-area message on quit, leaving no trace.
`where` names the phase it came from (`\"view\"` / `\"update\"`). Returns nil."
  (io/puts (str "ui-run: " where " error (recovering to last good frame): " (error-message e))
    :to *err*))

;; ---- memoised view fragments (ADR-336) --------------------------------------
;; A `view` is pure, so a fragment of the frame is a function of a few values — a
;; buffer line's ops of its text, its syntax spans and its highlights; a pane's mode
;; line of the fields it shows. Yet the view can't remember last turn's result: it
;; has no state, and the loop hands it only the model. `ui-memo` is the missing
;; primitive, Elm's `Html.Lazy` in TEA-honest form: the loop keeps the previous
;; turn's fragments as a table bound to `editor/ui/*memo*` while `view` runs, a fragment
;; reads its own entry there and reuses the ops when its `deps` are unchanged, and
;; the fragments of THIS turn travel back to the loop inside the frame itself — as
;; `[:ui/memo key deps ops]` markers `ui-harvest` collects into the next table and
;; splices away before the frontend sees the frame. No cell is written anywhere.
;;
;; The `deps` comparison is `=`, which is O(1) on a value that is the same heap cell
;; (a cached band, a rope) and a real walk otherwise — so name as deps the values a
;; fragment actually reads, prefer ones the model keeps between turns, and keep them
;; small. A fragment that is not emitted this turn is simply not in the next table:
;; the memo is bounded by the frame, and nothing needs evicting.

(defdyn editor/ui/*loop* nil)
;; The pid of the `ui-run` loop this code is running inside — bound for the loop's whole
;; life, `update` and `view` alike — or nil outside one: a test calling `update` directly, a
;; batch run. The one question an app has to ask before it fires work at another process and
;; waits for the answer to come back as an input: is there a loop here to receive it? Ask
;; this, not a registered name like `:editor`, which is true of exactly one loop — a second
;; window or a daemon's per-client loop would read as "no loop" and do the work inline.

(defdyn editor/ui/*memo* nil)
;; The previous turn's memo table — `{key -> [deps ops]}` — while `view` runs inside
;; `ui-loop`; nil outside a loop (a test calling a view directly, a headless render),
;; where `ui-memo` computes every fragment and emits no marker, so a frame is the
;; same plain data it always was.

(defn ui-memo (key:any deps:any thunk:fn -> any)
  "The ops of a view fragment, remembered across turns. `key` names the fragment
(anything `=`-comparable: `[:line 12]`, `[:modeline pane-path]`); `deps` are the values
its ops depend on; `(thunk)` computes the ops — a list or vector of render ops. Inside a
running `ui-run` the previous turn's ops are reused when the key's `deps` are `=`, and the
result is a one-element list holding a `[:ui/memo key deps ops reused?]` marker the loop harvests
(`ui-harvest`); splice it where the ops would go (`mapcat`/`append`). Outside a loop it is
just `(thunk)` — as is a nil `key`, the way a caller opts a fragment out (a pane whose
ops are transformed after this). Omit from `deps` nothing the thunk reads, or a stale
fragment is painted.

`reused?` is true when the ops are last turn's value itself (the deps matched): a display
that takes the markers (`:fragments?`, the GUI window) then reuses what it parsed them to
last frame instead of parsing them again (ADR-470).

    (editor/ui/ui-memo [:line 12] [\"text\"] (fn () [[:text \"text\"]]))   ;~> ([:ui/memo [:line 12] [\"text\"] ops reused?]) in a loop; the thunk's ops outside one"
  (if (or (nil? editor/ui/*memo*) (nil? key))
    (thunk)
    (let (prev (get editor/ui/*memo* key))
      (if (and prev (= (first prev) deps))
        (list [:ui/memo key deps (second prev) true])
        (list [:ui/memo key deps (thunk) false])))))

(defn ui-memo-marker? (op)
  "True for a `[:ui/memo key deps ops reused?]` marker.

    (editor/ui/ui-memo-marker? [:ui/memo :k [] [] false])   ;=> true
    (editor/ui/ui-memo-marker? [:text \"x\"])          ;=> false"
  (and (vector? op) (= (first op) :ui/memo)))

(defn ui-harvest (frame &optional (keep-markers? false))
  "`[frame' table]`: `frame` with every `ui-memo` marker spliced away (a plain frame the
frontend paints), and the table of this turn's fragments — what `editor/ui/*memo*` is bound to
for the next turn. With `keep-markers?` the frame comes back as it is, markers and all,
for a display whose `:fragments?` says it takes them: the GUI window parses a fragment the
loop reused once, and shares it with the frame before (ADR-470). The loop calls it on every rendered frame; a frame without markers
comes back as it went in, with an empty table. Recurses into a marker's ops and a
`:scroll-region`'s. Native (`%ui-harvest`): it walks every op of every frame, where a
Brood-level walk cost about a millisecond — more than the paint the memo saves.

    (first (editor/ui/ui-harvest [[:ui/memo :k [] [[:clear]] false]]))   ;=> [[:clear]]
    (first (editor/ui/ui-harvest [[:ui/memo :k [] [] false]] true))   ;=> [[:ui/memo :k [] [] false]]"
  (%ui-harvest frame keep-markers?))

;; ---- per-turn tracing (BROOD_UI_TRACE=1) ------------------------------------
;; Where a turn's time goes on the BROOD side of the loop: `view` (model → frame),
;; `:draw` (the frame handed to the frontend — for the GUI, marshalling the ops to the
;; window thread) and `update` (folding one input). The GUI's own paint is traced by
;; `BROOD_GUI_TRACE=1` on the Rust side; the two together account for a keystroke end
;; to end. One stderr line per phase, prefixed `ui-run:`, so a filter reads either.

(defn- ui-trace? ()
  "Whether per-turn tracing is on — read per call, not at load: a `def-` here would be
snapshotted into the startup image (ADR-218) and the env var never consulted again."
  (= (os/env "BROOD_UI_TRACE") "1"))

(defn- ui-cost-snapshot ()
  ;; `[cpu-us gc-pause-us gc-collections]` for this process — read only when tracing.
  ;; `%gc-stats` is a dev-tools builtin a lean release runtime does not register (ADR-038),
  ;; and calling it bare made `BROOD_UI_TRACE=1` kill a released app at its first frame;
  ;; there the GC figures read as zero and the CPU time is still reported.
  (let (gc (reflect/call-if-bound '%gc-stats {}))
    [(:cpu-us (%process-info (self)) 0) (:pause-total-us gc 0) (:collections gc 0)]))

(defn- ui-timed (thunk)
  "`[result elapsed-ms cost]` for `(thunk)` — the wall time a float in ms, off `os/now-ns`,
and, when tracing, what it cost this process as trace text (nil otherwise): the CPU time
it actually used, and how much of that was garbage collection (pause ms / collections)."
  (let (tracing (ui-trace?)
        before (when tracing (ui-cost-snapshot))
        started (os/now-ns)
        r (thunk)
        ms (/ (- (os/now-ns) started) 1000000.0))
    [r
      ms
      (when tracing
        (let ([cpu0 pause0 runs0] before
              [cpu1 pause1 runs1] (ui-cost-snapshot))
          (string/format "cpu=%.2fms gc=%.2fms/%d"
            (/ (- cpu1 cpu0) 1000.0)
            (/ (- pause1 pause0) 1000.0)
            (- runs1 runs0))))]))

(defn- ui-trace (phase ms detail &optional (cost nil))
  "One `ui-run: <phase>=<ms> cpu=<ms> gc=<ms>/<n> <detail>` line to stderr when
`BROOD_UI_TRACE=1`; nil otherwise. Its arguments are evaluated either way, so a caller
whose `detail` costs anything to build gates the call on `ui-timed`'s `cost` (non-nil only
when tracing), as `ui-fold` does.

The cost figures are what tell a slow turn's causes apart. `update=25ms cpu=24ms` did that
much work; `update=25ms cpu=2ms` spent 23 ms WAITING for a CPU — behind other processes or
other programs — and no change to the code it timed will help; `cpu=24ms gc=18ms/1` was a
collection, and the lever is what the process keeps alive, not the code that ran."
  (when (ui-trace?)
    (io/puts (if (nil? cost)
               (string/format "ui-run: %s=%.2fms %s" phase ms detail)
               (string/format "ui-run: %s=%.2fms %s %s" phase ms cost detail))
      :to *err*)))

(defn- ui-abbrev (s)
  "`s` cut to 72 characters for a trace line (an input can carry a paste or a task reply)."
  (if (> (string/length s) 72) (str (string/substring s 0 72) "…") s))

(defn- ui-interruptible (ceiling thunk)
  "`(thunk)` inside an interrupt window (ADR-491, `proc/interruptible`), with `ceiling` ms
(nil: none) after which it interrupts itself, as `[:ok value]`, `[:interrupted e]` or `[:threw
e]`. The kernel opens, closes and catches the window around the thunk, so an interrupt can
land only inside it — never in the loop's own glue — and a catch-all inside the thunk cannot
swallow it (it is sticky)."
  (try (proc/interruptible ceiling thunk) (catch e [:threw e])))

(defn- ui-event-ceiling-ms (model)
  "How long the fold of a background message may run before the loop interrupts it: the
model's `:event-ceiling-ms` when it has the key (nil: never), else `*ui-event-ceiling-ms*`."
  (if (contains? model :event-ceiling-ms) (get model :event-ceiling-ms) *ui-event-ceiling-ms*))

(defn- ui-quit-key (model)
  "The quit key `ui-run` arms for `model`: its `:quit-key` when it has the key (nil: none),
else `*ui-quit-key*`."
  (if (contains? model :quit-key) (get model :quit-key) *ui-quit-key*))

(defn- ui-quit-message (display key)
  "The message the kernel watches for as `display`'s quit `key`: the key itself — what a
window or the terminal delivers on the priority lane — unless the display ships keys in
another shape, which its `:quit-message` `(fn (key) …)` gives (a served session's
`[:key key]`, which arrives from a thin client on the ordinary lane). nil for no key."
  (let (shape (get display :quit-message))
    (if (or (nil? key) (nil? shape)) key (shape key))))

(defn- ui-fold (update model input cols rows input?)
  "`(update model input cols rows)`, timed and traced as `update` — and survived: a
throwing `update` is logged (`ui-log-error`) and drops that one input, returning
`model` unchanged. Every fold in the loop and the drain goes through here.

**Interruptible (ADR-491).** The fold runs in an interrupt window: the quit key (a
window's C-g) stops it once the turn is past `*ui-quit-busy-ms*`, and the fold of a
BACKGROUND message (`input?` false) is stopped by the loop itself past
`ui-event-ceiling-ms`. An interrupted fold drops its input like a throwing one, keeps the
previous model, and is reported through the watchdog with `:interrupted true`."
  (let ([outcome ms cost] (ui-timed (fn ()
                                      (ui-interruptible (if input? nil (ui-event-ceiling-ms model))
                                        (fn () (update model input cols rows)))))
        [how value] outcome)
    (do
      (when (= how :threw) (ui-log-error "update" value))
      ;; `cost` is non-nil exactly when tracing is on, and it gates the `pr-str`: printing
      ;; every input to throw it away cost O(its size) per event — a paste, a git status
      ;; reply, a diagnostics batch — with tracing off.
      (when (not (nil? cost)) (ui-trace "update" ms (ui-abbrev (pr-str input)) cost))
      (cond
        (= how :interrupted) (ui-report-slow model "update" (ui-input-tag input) ms true input?)
        (and (> ms (ui-slow-ms model)) (ui-slow-update-due?))
          (ui-report-slow model "update" (ui-input-tag input) ms false input?))
      (if (= how :ok) value model))))

;; ---- the watchdog (ADR-490) ---------------------------------------------------
;; A stall is reported as it happens, naming its cause, so the next one does not have to
;; be reproduced under a profiler to be found: which input's fold, or the view, took how
;; long. Always on, and cheap — the fold is timed anyway, and the report names the input by
;; its TAG, never by printing it (a diagnostics batch or a paste would cost what it reports).

(defn- ui-slow-ms (model)
  "The watchdog's line for `model`: its `:slow-ms`, else `*ui-slow-ms*`."
  (or (get model :slow-ms) *ui-slow-ms*))

(defn ui-input-tag (input)
  "What a slow-fold report calls `input`, small whatever `input` is: a key or keyword as
itself, a vector by its leading keyword — and its second, when that is one too (`[:timer
:idle]`, `[:mouse :press]`) — a record by its id, anything else by its type. A long string
(a paste) is `:string`.

    (editor/ui/ui-input-tag [:timer :idle])   ;=> [:timer :idle]
    (editor/ui/ui-input-tag [:lsp-diagnostics \"a.rs\" [1 2 3]])   ;=> :lsp-diagnostics
    (editor/ui/ui-input-tag \"x\")   ;=> \"x\""
  (cond
    (keyword? input) input
    (string? input) (if (> (string/length input) 16) :string input)
    (record? input) (record-id input)
    (and (vector? input) (not (empty? input)) (keyword? (first input)))
      (if (and (> (count input) 1) (keyword? (second input)))
        [(first input) (second input)]
        (first input))
    else (type-of input)))

(defn- ui-report-slow (model phase tag ms interrupted? input?)
  "Report one slow `phase` (\"update\" / \"view\") of `ms` on `tag` — or one the loop
INTERRUPTED (ADR-491, `interrupted?`): to the model's `:on-slow` hook — `(fn (report) …)`,
`report` a `{:phase :tag :ms :input}` map, with `:interrupted true` for an interrupted one,
its result ignored — or, without one, a line on stderr. `:input` (`input?`) is true when
the fold was the USER's input (a key, a click: what came on the priority lane, or what
`:poll-tagged` called input) and false for a background message or a timer — an editor
says \"Quit\" for an interrupted INPUT turn only, and a tag alone cannot tell `:up` from
`:lsp-diagnostics`. A view's report is `:input true`: only the quit key, the user, stops a
view. A hook is how an app puts the report where its user looks (an editor's *Messages*,
its echo area); one that throws is logged and dropped, since the watchdog must not become a
crash of its own. nil."
  (let (hook (get model :on-slow)
        report (if interrupted?
                 {:phase phase :tag tag :ms ms :input (if input? true false) :interrupted true}
                 {:phase phase :tag tag :ms ms :input (if input? true false)}))
    (do
      (if (nil? hook)
        (io/puts (string/format "ui-run: %s %s %.1fms on %s"
                   (if interrupted? "interrupted" "slow")
                   phase
                   ms
                   (pr-str tag))
          :to *err*)
        (try (hook report) (catch e (ui-log-error "on-slow" e))))
      nil)))

(defn- ui-slow-update-due? ()
  "Whether a slow update may be reported now: none was in the last
`*ui-slow-update-quiet-ms*` (wall clock) — stamping now as the last when so. Always true
outside a loop (`editor/ui/*slow-reports*` nil)."
  (let (reports editor/ui/*slow-reports*
        now (os/now)
        last (if (nil? reports) nil (table/get reports :update-at nil)))
    (if (or (nil? last) (>= (- now last) *ui-slow-update-quiet-ms*))
      (do (when reports (table/put reports :update-at now)) true)
      false)))

(defn- ui-watch-view (model clock ms)
  "The watchdog on a `view` of `ms`: report it when it is slow and no view report was
made in the last `*ui-slow-view-quiet-ms*` (wall clock, `os/now`), stamping the report
time on `clock` (`:slow-view-at`). The clock, unchanged when nothing was reported."
  (let (now (os/now)
        last (get clock :slow-view-at))
    (if (and (> ms (ui-slow-ms model)) (or (nil? last) (>= (- now last) *ui-slow-view-quiet-ms*)))
      (do (ui-report-slow model "view" :view ms false true) (assoc clock :slow-view-at now))
      clock)))

(defn- ui-fold-budget-ns (model)
  "The background fold budget of one turn (`*ui-fold-budget-ms*`, or the model's
`:fold-budget-ms`), in ns — the unit `os/now-ns` deadlines are in."
  (* 1000000 (or (get model :fold-budget-ms) *ui-fold-budget-ms*)))

(defn- ui-pending? (model raw)
  "Whether `raw` is a control message the LOOP acts on (`:close` it owns, `:focus`), which
a drain hands back instead of folding."
  (or (ui-close-quits? model raw) (focus-request? raw)))

;; A turn's drain moves through three states (ADR-490), a keyword threaded by
;; `ui-drain-input` and handed back with its result:
;;   :owed    an input jumped the queue, and the turn still owes its ONE arrival-order fold
;;   :budget  the arrival-order fold is made and no input taken: background folds on
;;            until the deadline
;;   :closed  an input was taken AND the arrival-order fold is made: inputs only now
;; The arrival-order fold is `display-poll-tagged` at 0 ms — the oldest message of any
;; kind — and every turn makes one when anything is queued. That is the fairness: input
;; is always served first, but a background message cannot wait more than a turn per
;; queued message ahead of it, however fast input arrives. A turn that ends `:owed` or
;; `:closed` folded user input — what holds idle timers back.

(defn- ui-tagged-input? (display tagged)
  "Whether a `[message input?]` poll result is user input the drain must serve first. Only
when the display can tell (it has `:poll-input`): one that cannot calls everything input,
which holds idle timers back as before but must not close a turn's background."
  (and (not (nil? tagged)) (second tagged) (not (nil? (get display :poll-input)))))

(defn- ui-drain-saw-input? (state)
  "Whether a drain that ended in `state` folded user input (`:owed` / `:closed`)."
  (or (= state :owed) (= state :closed)))

(defn- ui-drain-step (model update display cols rows fuel deadline state raw input?)
  "Fold `raw`, which the drain pulled and which leaves it in `state`, and drain on — or
hand back a control message `raw` is (`ui-pending?`) as `pending`. `input?`: `raw` is the
user's input, which no ceiling interrupts (`ui-fold`)."
  (if (ui-pending? model raw)
    [model raw state]
    (ui-drain-input (ui-fold update model raw cols rows input?)
      update
      display
      cols
      rows
      (dec fuel)
      deadline
      state)))

(defn- ui-drain-input (model update display cols rows fuel deadline state)
  "Fold what is ALREADY queued into `model` WITHOUT rendering between them, returning
`[model' pending state']`. The render, not the fold, is the per-input cost, so a burst of
async events (a streaming test / run / collab feed, a paste) that would otherwise force
one full frame *each* collapses to a single render. Non-blocking — a 0 ms poll that
returns nil means the queue is empty, so we stop and let the caller render. `pending` is a
control message (`:close` / `:focus`) pulled mid-drain that the caller must act on
structurally rather than fold; nil otherwise. `state'` is where the turn ended (see
above; `ui-drain-saw-input?`). Opt-in per app via the model's `:coalesce-input?` flag —
off by default, so a non-coalescing app renders once per input exactly as before.

**Input first, background on a budget (ADR-490).** Queued USER input
(`display-poll-input`) is taken before anything else, and background only until the
turn's `deadline` — an `os/now-ns` time, the fold budget — so a flood of any size renders
every budget and looks for input between every fold. Once an input is folded the turn
folds no more background, so its frame is drawn behind no more than the fold already
running — except the ONE arrival-order fold every turn makes (`state`, see above), which
keeps background moving while input never stops. Past the deadline even input waits for
the render, and is the first thing the next turn takes. `fuel` (`*ui-input-batch*`) is
the ceiling on any one turn, and `:done` stops it early."
  (if (or (<= fuel 0) (get model :done))
    [model nil state]
    (let (in-time (< (os/now-ns) deadline))
      (if (= state :owed)
        ;; the turn's arrival-order fold, owed since an input jumped the queue
        (let (tagged (display-poll-tagged display 0))
          (if (nil? tagged)
            [model nil state]
            (ui-drain-step model
              update
              display
              cols
              rows
              fuel
              deadline
              :closed (first tagged)
              (second tagged))))
        (let (input (if in-time (display-poll-input display) nil))
          (cond
            (not (nil? input))
              (ui-drain-step model update display cols rows fuel deadline :closed input true)
            ;; background, on the budget
            (and (= state :budget) in-time)
              (let (tagged (display-poll-tagged display 0))
                (cond
                  ; queue empty — render the settled model
                  (nil? tagged) [model nil state]
                  ;; arrived since the input poll above: input after all
                  (ui-tagged-input? display tagged)
                    (ui-drain-step model
                      update
                      display
                      cols
                      rows
                      fuel
                      deadline
                      :closed (first tagged)
                      true)
                  else
                    (ui-drain-step model
                      update
                      display
                      cols
                      rows
                      fuel
                      deadline
                      :budget (first tagged)
                      ;; not input to serve first, but still the user's when the display
                      ;; cannot tell (no `:poll-input`): no background ceiling for it
                      (second tagged))))
            else [model nil state]))))))

(defn- ui-render (model last-good clock view display cols rows)
  "`(view model cols rows)` for one turn, as `[:frame ops memo-table ms]`; `:failed` when
`view` threw (logged), unless there is no `last-good` frame to fall back to (the first
render), when the error re-raises; `[:interrupted nil nil ms]` when the quit key stopped it
(ADR-491) — reported through the watchdog, and the screen keeps its last frame. The
previous turn's memoised fragments are in scope for `ui-memo` (ADR-336) — nil outside a
loop, `{}` on the first turn."
  (let ([outcome ms cost] (ui-timed
                            (fn ()
                              (ui-interruptible nil
                                (fn ()
                                  ;; the harvest walks every op too: inside the window
                                  (ui-harvest (binding (editor/ui/*memo* (or (get clock :memo) {}))
                                                (view model cols rows))
                                    (get display :fragments?))))))
        [how value] outcome)
    (if (= how :interrupted)
      (do (ui-report-slow model "view" :view ms true true) [:interrupted nil nil ms])
      (try
        (if (= how :threw)
          (throw value)
          (let ([flat table] value)
            (do
              (ui-trace "view" ms (str (count flat) " ops, " (count table) " memo") cost)
              [:frame flat table ms])))
        (catch e
          (if (nil? last-good)
            ; first render failed — a real startup bug, not a wedge
            (throw e)
            (do (ui-log-error "view" e) :failed)))))))

(defn- ui-loop (model last-good clock view update display)
  "The inner recursion of `ui-run` (own function so each turn is a proper tail call —
O(1) stack). Renders, parks the poll until the soonest timer is due, folds the input
(a key/mouse/system event, or a timer firing), recurses; stops when `:done` (the
caller, `ui-run`, runs `:leave` in all cases). A `:close` input (the window's X
button) quits unless the app claims it (`:close-is-input?`, `ui-close-quits?`), so every
`ui-run` app is closeable by its close button without wiring it into `update` —
independent of how the app binds the Escape key. A `:focus`
control message (from another process) raises the window via the display's `:focus`
and is NOT folded into `update`.

**Named timers (ADR-102).** The poll timeout is `ui-poll-ms` — the soonest live
timer in `(ui-timers model)`. A timed-out poll (nil) fires the earliest due timer via
`ui-fire`, folding `[:timer name]` (or the bare `:tick` legacy beat). A turn that folded
USER input stamps `:last-input` on the `clock` (so idle timers reset; ADR-490). The `clock` is threaded
alongside `model`/`last-good` and is wall-clock bookkeeping, NOT model state: it does
**not** roll back on a crash (a key the user pressed stays pressed), and the `:focus`
branch passes it through without advancing `:last-input` (a focus message isn't input).

**Let-it-crash at the render loop** (the editor's application of userland
supervision, M4 — see `docs/supervision.md`). A throw from `view` or `update` is
caught, logged to stderr (`ui-log-error`), and the loop keeps going rather than
dying: a throwing `view` rolls the model back to `last-good` (the last model that
rendered cleanly) and re-renders it; a throwing `update` drops that one bad input
and keeps the current model. `last-good` is threaded alongside `model` and starts
nil — so if the *first* render throws (no good frame to fall back to yet) the error
re-raises, surfacing a genuine startup bug instead of spinning."
  (if (get model :done)
    nil
    (let ([cols rows] ((get display :size))
          ;; the screen already shows this model at this grid: a turn that changed
          ;; nothing (a key-up, an echo, a timer that found nothing to do, a poll that
          ;; timed out) renders nothing. `=` is a pointer test when `update` handed the
          ;; model back untouched, and stops at the first differing subtree otherwise.
          unchanged (= (get clock :shown) [model cols rows])
          ;; render this model; a `[:frame …]` result is the frame to draw, `:failed`
          ;; means `view` threw (already logged) and we must fall back to `last-good`,
          ;; `[:unchanged …]` means there is nothing new to draw, and `[:interrupted …]`
          ;; that the quit key stopped a slow view (ADR-491): the screen keeps the last
          ;; frame and the loop goes on to read the input that is waiting.
          rendered (if unchanged
                     [:unchanged nil nil 0.0]
                     (ui-render model last-good clock view display cols rows))
          drawn (and (vector? rendered) (= (first rendered) :frame))
          ;; the fallback for the turns after this one: `model` when it is on screen (drawn
          ;; now, or unchanged since it was), the previous fallback when its view was
          ;; interrupted — a model that never rendered is no point to roll back to
          good (if (and (vector? rendered) (= (first rendered) :interrupted)) last-good model))
      (if (= rendered :failed)
        ;; couldn't render `model` — roll back to the last model that did, and re-render it
        ;; (the clock keeps advancing — it's wall-clock reality, not model state).
        (ui-loop last-good last-good clock view update display)
        (let (
              ;; this turn's fragments become next turn's memo table — loop bookkeeping
              ;; on `clock`, like the timers: never rolled back with the model
              clock0 (if (not drawn)
                       clock
                       (assoc clock :memo (nth rendered 2) :shown [model cols rows]))
              ;; the watchdog on the view: rate-limited, its last report on the clock
              clock (if (not drawn) clock0 (ui-watch-view model clock0 (nth rendered 3))))
          (do
            (if (not drawn)
              ;; nothing to draw, but a display that paces on its frames (the GUI's
              ;; wheel glide) is still told the turn is over
              (when (get display :settle) ((get display :settle)))
              (ui-trace "draw"
                (second (ui-timed (fn () ((get display :draw) (second rendered)))))
                ""))
            ;; `model` rendered cleanly: it's now the fallback point for the next turns.
            ;; Named timers are opt-in via the `:timers` key — `timers` is nil for a
            ;; pre-timers app (the legacy `:tick-ms`/`:tick` path) and the clock is just
            ;; passed through untouched; with timers, the poll parks until the soonest is
            ;; due and `ui-fire` decides what (if anything) fired.
            (let (timers (get model :timers)
                  now1 (ui-now model)
                  ;; whether a key is down is read before the park: every change to it
                  ;; (a press, its key-up, a blur) arrives as input and wakes the poll
                  clock1 (if (nil? timers)
                           clock
                           (assoc (ui-clock-init clock timers now1)
                             :key-held? (display-key-held? display)))
                  poll-ms (if (nil? timers) (ui-tick-ms model) (ui-poll-ms timers clock1 now1))
                  ;; queued user input first, ahead of any background backlog (ADR-490);
                  ;; then park for whatever comes, told whether it is input. A
                  ;; non-coalescing app has no drain to make a turn's arrival-order fold,
                  ;; so after a turn whose input jumped the queue, it makes one here:
                  ;; background keeps moving however fast keys come
                  input (if (get clock1 :jumped) nil (display-poll-input display))
                  tagged (if (nil? input) (display-poll-tagged display poll-ms) [input true])
                  raw (display-untag tagged)
                  clock1 (assoc clock1
                           :jumped (and (not (nil? input)) (not (get model :coalesce-input?)))))
              (cond
                ;; the window's close button always quits; `ui-run` then runs `:leave`
                (ui-close-quits? model raw) nil
                ;; raise-to-front request: act on the display, keep the model untouched and
                ;; do NOT advance `:last-input` (a focus message from another process is
                ;; not user input — it must not reset idle timers).
                (focus-request? raw)
                  (let (f (get display :focus))
                    (do
                      (when f (f))
                      (ui-loop model good clock1 view update display)))
                ;; poll timed out (nil). Legacy: deliver the bare `:tick`. Timers: fire the
                ;; earliest due timer (if any), else re-park without folding.
                (nil? raw)
                  (if (nil? timers)
                    (let (next (ui-fold update model :tick cols rows false))
                      (ui-loop next good clock1 view update display))
                    (let (fr (ui-fire timers clock1 (ui-now model))
                          event (first fr)
                          clock2 (second fr))
                      (if (nil? event)
                        (ui-loop model good clock2 view update display)
                        (let (next (ui-fold update
                                     model
                                     event
                                     cols
                                     rows
                                     (ui-command-timer? timers event)))
                          (ui-loop next good clock2 view update display)))))
                ;; a message: fold it, drain, then — with timers — stamp `:last-input` if
                ;; the turn folded USER input (ADR-490): only input resets idle timers, so
                ;; an idle beat still comes during a flood of background replies. A
                ;; throwing `update` drops this input.
                else
                  (let (
                        ;; the turn's background budget runs from its first fold
                        deadline (+ (os/now-ns) (ui-fold-budget-ns model))
                        next0 (ui-fold update model raw cols rows (second tagged))
                        ;; a `:coalesce-input?` app also drains what is ALREADY queued into
                        ;; this same turn, so a burst renders once instead of once per event
                        ;; (`ui-drain-input`): input first, background on the budget. A
                        ;; control message pulled mid-drain comes back as `pending` for the
                        ;; loop to act on. Default apps skip the drain and render per input
                        ;; exactly as before.
                        drained (if (get model :coalesce-input?)
                                  (ui-drain-input next0
                                    update
                                    display
                                    cols
                                    rows
                                    *ui-input-batch*
                                    deadline
                                    (if (ui-tagged-input? display tagged) :owed :budget))
                                  [next0 nil nil])
                        next1 (first drained)
                        pending (second drained)
                        clock2 (if (and (not (nil? timers))
                                     (or (second tagged) (ui-drain-saw-input? (nth drained 2))))
                                 (assoc clock1 :last-input (ui-now model))
                                 clock1)
                        ;; A due timer fires on THIS turn too, not only when the poll times
                        ;; out. Without this a timer is an idle callback rather than a
                        ;; timer: while input keeps arriving the poll never returns nil, so
                        ;; a non-idle timer starves for as long as the stream lasts. That is
                        ;; exactly when an app needs it — a wheel's kinetic glide, a drag, a
                        ;; key held down are all continuous input, and anything paced during
                        ;; one (an animation, a zoom, a throttled repaint) simply stopped.
                        ;;
                        ;; `:idle?` timers are unaffected by construction: their deadline
                        ;; counts from `:last-input`, which this branch stamped if the turn took
                        ;; input, so they still wait for the input to settle. Only a timer that asked
                        ;; to fire every N ms regardless now actually does.
                        serviced (if (nil? timers)
                                   [nil clock2]
                                   (ui-fire timers clock2 (ui-now next1)))
                        tevent (first serviced)
                        clock3 (second serviced)
                        next (if (nil? tevent)
                               next1
                               (ui-fold update
                                 next1
                                 tevent
                                 cols
                                 rows
                                 (ui-command-timer? timers tevent))))
                    (cond
                      (ui-close-quits? next pending) nil
                      (focus-request? pending)
                        (let (f (get display :focus))
                          (do
                            (when f (f))
                            (ui-loop next good clock3 view update display)))
                      else (ui-loop next good clock3 view update display)))))))))))

(defn ui-run (model view update display)
  "Run a UI app over `display` (a frontend map): enter it, then loop —
`(view model cols rows)` → `:draw` → `(:poll ms)` → `(update model input cols rows)`
→ recurse — until the model is `:done`, then `:leave`. `input` is the frontend's
key/mouse value (`\"a\"`, `:up`, `[:mouse …]`), or a timer firing. `view` is pure
(model + size → a `display.blsp` render frame); `update` folds an input into the next
model and sets `:done` to quit.

**Timers (ADR-102).** Declare time-driven work as data on the model: `:timers`, a map
`name -> {:every ms}` / `{:after ms}` (optionally `:idle? true`, and `:command? true` for a timer
that carries on the user's own command — a fold no background ceiling stops). The loop parks the
poll until the soonest is due and folds `[:timer name]` when it fires — so a steady
animation timer and several idle one-shots coexist, each on its own clock. An idle timer
waits for input to settle, and a key held down is not settled: while the display's
`:key-held?` says one is down (a GUI window does), idle timers wait for it to come up, at
most `*ui-held-quiet-ms*` past the last input. A model
with no `:timers` key keeps the legacy single beat (`:tick-ms`, default 1000 ms),
delivered as the bare keyword `:tick`. See `ui-loop` and the named-timers section.

**Input coalescing (`:coalesce-input? true`).** By default the loop renders once per
input. An app that streams async events into its own mailbox — a test/run feed, collab
deltas, an SSE push — can flip this flag so the loop, after folding one input, folds any
inputs ALREADY queued into the same turn and renders once at the settled model
(`ui-drain-input`). Since rendering, not folding, is the per-event cost, this turns a
burst of N events from N full frames into one — a 900-test run streams in as it finishes
instead of over seconds of frames. Intermediate frames within a burst are never seen
anyway; a throwing `update` still drops just its one input, and a `:close`/`:focus` pulled
mid-burst is still honoured. Off leaves the per-input behaviour (and every existing app)
exactly as before.

**Input before background (ADR-490).** Every turn takes the user's queued input first —
the display's `:poll-input` (`display-poll-input`): what a window delivers on the
mailbox's priority lane, the terminal's keyboard, a thin client's keys — so a key is never
queued behind a language server's diagnostics or a test stream. A coalescing app folds
background only for `*ui-fold-budget-ms*` per turn (the model's `:fold-budget-ms`), then
renders and looks again: a flood of any size delays a keystroke by about one budget plus
one fold. Every turn still makes one arrival-order fold (a non-coalescing app: the turn
after one whose input jumped the queue), so background keeps moving while input never
stops, and a due timer fires on every turn. Only input holds an `:idle?` timer back: the
display says whether what it parked for was input (`:poll-tagged`, `display-poll-tagged`),
so an idle beat still comes during a flood. A producer whose message only matters at its
newest value sends it with `proc/send-latest`, so a newer one replaces it while it waits.

**The watchdog (ADR-490).** An `update` fold or a `view` slower than `*ui-slow-ms*` (the
model's `:slow-ms`) is reported, naming the input it folded by its tag (`ui-input-tag`) —
to the model's `:on-slow` hook, `(fn (report) …)` with `report` a `{:phase :tag :ms :input}` map (`:input` true for the user's own input),
or as a line on stderr. A slow view is reported at most every `*ui-slow-view-quiet-ms*`, a
slow update every `*ui-slow-update-quiet-ms*`; an interrupted one always.

**Quit (ADR-491).** Each `update` and `view` runs in an interrupt window
(`proc/interruptible`), and the loop arms the kernel's quit key: the frontend's C-g
(`*ui-quit-key*`, `:ctrl-g`; the model's `:quit-key`, nil for none) arriving while a turn
has run past `*ui-quit-busy-ms*` (the model's `:quit-busy-ms`) STOPS it, wherever it is —
deep in a loop, inside a tree-sitter parse. An interrupted `update` drops its input and
keeps the previous model; an interrupted `view` keeps the last frame on screen. The fold of
a BACKGROUND message is also stopped by the loop itself past `*ui-event-ceiling-ms*` (the
model's `:event-ceiling-ms`, nil for none); a user's own command never is — only C-g stops
that, as in Emacs. Either is reported like a slow turn, with `:interrupted true` in the
report, whose `:input` says whether the turn was the user's. A catch-all inside `update`
cannot swallow the interrupt: it is sticky until the turn ends. The C-g is queued as well,
so the app still folds it next (its keyboard-quit). A window and the terminal (a reader
thread, `term/forward-input`) deliver C-g on the priority lane, where the kernel sees it
while the loop is busy; a display that ships keys in another shape says so with
`:quit-message` (a served session's `[:key k]`). A window shows the wait cursor while a
turn is past the busy-ms.

**A turn that changes nothing renders nothing (ADR-444).** When the model after a turn
is `=` to the one last drawn, at the same grid, the loop skips `view` and `:draw` and goes
straight back to the poll. A key release or a timer that found no work costs no frame.
This is why `view` has to be a function of the model and the grid alone. A view that
reads the clock or another process will not be called again until the model changes —
nor will one that reads a global such as the face registry, so whatever changes one
changes the model too, as a theme switch does.

**The window's close button (the X) always quits.** A GUI frontend delivers it as
a `:close` input (distinct from the Escape *key*, `:escape`), and `ui-run` treats
`:close` as an immediate quit — before `update` even sees it — then runs `:leave`.
So every app is closeable by its X button for free, no matter how it binds Escape
(an editor binds Escape to cancel/normal-mode, not quit). An app that must ask first
(\"unsaved changes\") sets `:close-is-input? true` on its model: `:close` is then folded
through `update` like a key, and the app quits by setting `:done` itself — the deferred
power feature of ADR-011, opt-in so the default stays free.

**A `view`/`update` crash is survived, not fatal** (let-it-crash at the render
loop). A throw from `view` or `update` is caught and logged to stderr, and the loop
recovers: a bad `view` rolls the model back to the last frame that rendered cleanly;
a bad `update` drops that one input. So a single buggy command can't kill the app or
wedge it on a frame it can't redraw — only the *first* render throwing (no good frame
yet) is fatal, surfacing a genuine startup bug. See `ui-loop`.

**Teardown is guaranteed.** `:leave` runs on a normal quit *and* if the frontend
mechanism itself (`:size`/`:draw`/`:poll`) throws, or the first render fails (the
error is re-raised after) — so a crash never strands the terminal in the alternate
screen / raw mode; the screen is restored. With `editor/ui/*term-display*` the frontend is raw
mode + the alternate screen, so `Ctrl-C` arrives as a `:ctrl-c` **key** (have
`update` quit on it — see the observer's keymap) rather than a SIGINT that kills the
process mid-draw and leaves stale cells on screen.

Modal: control returns to the caller on quit — run it in a spawned process for a
non-blocking window. The shared loop behind the observer (and the editor)."
  (do
    ((get display :enter))
    ;; the quit key (ADR-491): a C-g that arrives while a turn is busy interrupts it
    ;; a key from another node counts only from the client the display serves (`:quit-from`,
    ;; a served session's), or a full peer — never a guest link that reaches this pid
    (proc/set-quit-key (ui-quit-message display (ui-quit-key model))
      (or (get model :quit-busy-ms) *ui-quit-busy-ms*)
      (get display :quit-from))
    (try
      (do
        ;; nil last-good: first render must succeed. {} clock: a fresh timer bookkeeping
        ;; map (last-input/armed/fired filled lazily on the first iteration).
        (binding (editor/ui/*loop* (self) editor/ui/*slow-reports* (table/new))
          (ui-loop model nil {} view update display))
        (proc/set-quit-key nil 0)
        ((get display :leave)))
      (catch e
        ; restore the terminal even on a frontend/startup error
        (proc/set-quit-key nil 0)
        ((get display :leave))
        (throw e)))))

;; ---- modal input overlays (the dispatch-fallthrough policy) -----------------
;; A `ui-run` app's `update` usually has a few *transient* modes that sit beside its
;; keymap and, while open, capture input: a minibuffer prompt, a completion popup, an
;; incremental search, a y/n confirmation. `overlay-route` is the one fallthrough rule
;; they share — route a key to whichever overlay is open, else dispatch normally — so an
;; app lists its overlays as data instead of growing a bespoke `cond`. The editor and the
;; observer both build on it (ADR-094). An overlay is a record implementing the
;; `Overlay` ability (ADR-183).

(defability Overlay
  "A transient input overlay: a modal feature that sits beside an app's keymap and,
while open, captures input. Implement it for a record per overlay — only the ops the
overlay needs: a record that skips `overlay-owns?` captures every key, and one that
skips `overlay-exit` needs no dismiss step (the `:default` impl supplies both).

    (editor/ui/overlay-active? overlay model)   ;~> truthy while the overlay is open
    (editor/ui/overlay-owns? overlay model input)   ;~> truthy when input is the overlay's
    (editor/ui/overlay-handle overlay model input)   ;~> the model with input folded in
    (editor/ui/overlay-exit overlay model)   ;~> the model with the overlay dismissed"
  (overlay-active? (self model) :-> any) ; truthy while the overlay is open
  (overlay-owns? (self model input) :-> any) ; truthy when `input` is the overlay's to handle
  (overlay-handle (self model input) :-> any) ; fold an owned key into the model
  (overlay-exit (self model) :-> any)) ; dismiss before a non-owned key falls through
(impl Overlay
  :default
  ;; The fallback for a record implementing a subset of the ops: never open, capture every
  ;; key, leave the model as-is.
  (overlay-active? (_overlay _model) false)
  (overlay-owns? (_overlay _model _input) true)
  (overlay-handle (_overlay model _input) model)
  (overlay-exit (_overlay model) model))

(defn overlay-active (overlays model)
  "The first overlay in `overlays` open for `model` (`overlay-active?`; list order =
precedence), or nil.

    (editor/ui/overlay-active [] {})   ;=> nil"
  (seq/find overlays (fn (overlay) (overlay-active? overlay model))))

(defn overlay-route (overlays model input fallback)
  "Fold `input` into the first active overlay in `overlays`, or `(fallback model input)`
when none is open. The owning overlay (`overlay-owns?`) handles the key; a key it does
**not** own dismisses the overlay (`overlay-exit`) and is re-dispatched through
`fallback` — Emacs' dismiss-and-process. Overlays are records implementing `Overlay`.
The shared seam behind the editor's transient overlays and the observer's minibuffer.

    (editor/ui/overlay-route overlays model input fallback)   ;~> the model after the overlay or the fallback handled `input`"
  (let (overlay (overlay-active overlays model))
    (cond
      (nil? overlay) (fallback model input)
      (overlay-owns? overlay model input) (overlay-handle overlay model input)
      else (fallback (overlay-exit overlay model) input))))
