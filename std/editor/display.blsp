;; std/editor/display.blsp — the render-op protocol for the display seam.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - The display layer is a *protocol, not a library* (docs/architecture.md): a
;;    frontend consumes a serialisable stream of "render this" ops and emits input
;;    events. This module defines that op vocabulary as plain Brood **data** —
;;    each constructor just builds a tagged vector. The `term-*` primitives are
;;    the in-process (crossterm) frontend that paints it; a remote frontend
;;    would interpret the identical ops over a socket. That sameness is what makes
;;    "fast native locally" and "server for other instances" one code path (M3/M4).
;;  - Pure: every constructor returns a fresh value, no IO, no kernel surface.
;;    Opt-in (`require`), never in the prelude.
;;
;; A FRAME is a vector of OPS. An OP is a tagged vector:
;;   [:clear]                       clear the whole screen
;;   [:text row col s]              draw string `s` at (row, col), 0-based cells
;;   [:text row col s face]         …styled by `face`, a map (see below)
;;   [:cursor row col]              place the text cursor (a block caret)
;;   [:cursor row col style]        …shaped :block / :bar / :underline / :hollow
;;   [:cursor row col style colour] …in `colour` (a face colour; `style` may be nil)
;;   [:cursor row col style colour blink] …blinked by the GUI window itself (`cursor-blink`)
;;   [:cursor row col style colour blink under face] …a block drawn solid, `under` (the
;;                                  text in its cell) over it in `face`, coloured the
;;                                  background (ADR-515)
;;   [:rect row col w h face]       fill a w×h cell block with `face`'s :bg colour
;;   [:rect row col w h face r]     …with corners rounded by `r` cells (GUI only)
;;   [:frect x y w h face op r]     sub-cell rounded rect (cell-unit floats); GUI-only
;;   [:seam row]                    rows from `row` down anchored to the window's bottom, the
;;                                  leftover pixels at the seam (ADR-610); GUI-only
;;   [:seam row {:top-band false}]  …and row 0 not a band: the top gets the inset too
;;   [:above-seam ops]              ops on the rows above the seam carried on past it, cut off
;;                                  at it: their seam row shows in the leftover (ADR-615)
;; A FACE is a map of style attributes, any subset of:
;;   {:fg <colour> :bg <colour> :bold <truthy> :reverse <truthy>}
;; where a colour is either a palette keyword — :black :red :green :yellow :blue
;;   :magenta :cyan :white :grey :dark-grey (the terminal renders these as its
;;   *named* colours, honouring the user's theme) — or an explicit colour: an
;;   `[r g b]` vector (each channel 0..255) or a `"#rgb"` / `"#rrggbb"` hex string,
;;   both rendering as the same true colour in either frontend (so a curated
;;   palette looks identical in the terminal and the GUI window). Unknown
;;   keys/colours are ignored by the frontend.

(defmodule editor/display
  "The render-op protocol for the display seam (M3, ADR-046): pure constructors
that build a **frame** — a vector of render ops — as plain data.

    (frame (clear)
           (text 0 0 \"hello\" {:bold true})
           (cursor 0 5))

A frontend (the `term-*` primitives locally, a socket peer remotely) interprets
that frame. Ops: `(clear)`, `(text row col s)` / `(text row col s face)`,
`(cursor row col)`. A *face* is a map like `{:fg :red :bold true}`. Rows and
columns are 0-based character cells.")

(defn clear ()
  "A render op that clears the whole screen.

    (editor/display/clear)   ;=> [:clear]"
  [:clear])

(defn text (row col s &optional (face nil))
  "A render op drawing string `s` at (`row`, `col`) (0-based cells), optionally
styled by `face` (a map like `{:fg :red :bold true}`).

    (editor/display/text 0 0 \"hi\")   ;=> [:text 0 0 \"hi\"]"
  (if (nil? face)
    [:text row col s]
    [:text row col s face]))

(defn cursor (row col &optional (style nil) (color nil) (blink nil) (under nil) (face nil))
  "A render op placing the text cursor at (`row`, `col`). With `style` — `:bar`
(a thin insertion caret on the cell's left edge), `:underline` (a rule along the
cell bottom), `:hollow` (an outline box around the cell, the cursor of a window
without focus), or `:block` (the default full-cell caret) — the GUI frontend shapes
the caret accordingly and the terminal maps it to its matching steady cursor
(`:hollow` to a block). With `color` (a face colour: a palette keyword, `[r g b]` or
`\"#rrggbb\"`) the GUI draws the caret in it — a block washes its cell in the colour
at half strength and rims it solid, every other shape is solid; the terminal ignores
it. With `blink` (a `cursor-blink` map) the GUI window blinks the caret ITSELF, between
frames: the app draws it once and no turn of its loop runs per toggle (ADR-469). With
`under` (the text in the caret's cell — one character, or a cluster) a BLOCK caret is
drawn as Emacs draws its box: the cell filled solid in the caret's colour and `under`
painted over it in the window background, so the character stays readable through
the caret (ADR-515); a wide character's block covers both its cells. With `face` (the
cell's own face map) `under` keeps its weight, slant, family and underline — a bold
keyword stays bold under the caret; its colours and size are the caret's. Other shapes and
the terminal ignore it; without it a block is the half-strength wash. With none of
these it's `[:cursor row col]`, unchanged (a block caret).

    (editor/display/cursor 1 2)   ;=> [:cursor 1 2]
    (editor/display/cursor 1 2 :hollow)   ;=> [:cursor 1 2 :hollow]
    (editor/display/cursor 1 2 nil :red)   ;=> [:cursor 1 2 nil :red]
    (editor/display/cursor 1 2 :bar nil {:interval 530 :blinks 10})   ;=> [:cursor 1 2 :bar nil {:interval 530 :blinks 10}]
    (editor/display/cursor 1 2 :block nil nil \"x\")   ;=> [:cursor 1 2 :block nil nil \"x\"]"
  (cond
    (not (nil? face)) [:cursor row col style color blink under face]
    (not (nil? under)) [:cursor row col style color blink under]
    (not (nil? blink)) [:cursor row col style color blink]
    (not (nil? color)) [:cursor row col style color]
    (not (nil? style)) [:cursor row col style]
    else [:cursor row col]))

(defn cursor-blink (interval &optional (blinks 0))
  "How a `cursor` blinks in a GUI window (ADR-469): shown for `interval` ms, hidden for
`interval` ms, `blinks` times over and then steady — Emacs's `blink-cursor-interval` and
`blink-cursor-blinks`; 0 blinks for as long as no input comes. The window restarts the
blink, shown, on every key, click and wheel step it sees and on every frame that moves the
caret, and holds it shown while it lacks focus; a toggle repaints the caret's row, not the
window. The terminal ignores it.

    (editor/display/cursor-blink 530 10)   ;=> {:interval 530 :blinks 10}"
  {:interval interval :blinks blinks})

(defn cursor-zone (x y w h shape)
  "A render op marking a rectangular hot-zone (cells: `[x y]` origin, `w`×`h`) that
asks the frontend to show pointer `shape` while the cursor is over it — `:col-resize`
(↔) on a side-by-side split's divider, `:row-resize` (↕) on a stacked one, or
`:pointer` (👆) over a clickable region so it reads as a link. The GUI frontend
hit-tests it on pointer-move; the terminal ignores it (ADR-080).

The cells are the ones the op is painted in: inside a `cell-region` they are that
region's cells (a zone in a zoomed pane is sized and placed at the pane's px), and
inside a `scroll-region` the zone slides with the ops around it. The frontend resolves
each zone to pixels once per frame, so a zone means the same thing wherever it sits.

    (editor/display/cursor-zone 0 0 1 10 :col-resize)   ;=> [:cursor-zone 0 0 1 10 :col-resize]"
  [:cursor-zone x y w h shape])

(defn rect (row col w h face &optional (radius 0.0))
  "A render op filling the `w`×`h` block of cells whose top-left is (`row`, `col`)
with `face`'s `:bg` colour — a solid panel. The general fill primitive `bar`
(one row) is a special case of: a card behind a popup, a filled selection band, a
gutter background. The GUI paints the rectangle directly (no glyphs); the terminal
space-fills each row in the face so the `:bg` shows. Other face attributes (`:fg`,
`:bold`) are irrelevant — there are no glyphs — but a `:bg` (or `:reverse`) is what
makes it visible; a face with no background paints nothing.

`radius` (cell units, default 0.0) rounds the corners **in the GUI**; the terminal
ignores it and space-fills as always, which is the same frontend asymmetry
`cursor-zone` and `frect` already rely on. That is the point: rounded chrome — a
pill address field, a button highlight — is one op that degrades on its own,
rather than an `frect` for the window plus a `rect` inside it for the terminal.
Use `(/ h 2)`-ish for a pill. A zero radius emits the 5-element op unchanged, so
existing frames are byte-identical.

    (editor/display/rect 1 2 3 4 {:bg :blue})   ;=> [:rect 1 2 3 4 {:bg :blue}]
    (editor/display/rect 1 2 3 4 nil 0.5)       ;=> [:rect 1 2 3 4 nil 0.5]"
  (if (= radius 0.0)
    [:rect row col w h face]
    [:rect row col w h face radius]))

(defn scroll-region (dy-frac ops)
  "A self-contained render block that draws `ops` with all `text`, `rect`, and `cursor`
ops shifted upward by `dy-frac × cell-height` pixels. The offset is scoped: ops outside
this region are not affected and no reset sentinel is needed. `ops` is a flat vector of
render ops (built with `into []`). Regions may be nested (inner overrides outer). GUI-only —
the terminal frontend flattens the inner ops and ignores the offset. ADR-114.

    (editor/display/scroll-region 0.5 [])   ;=> [:scroll-region 0.5 []]"
  [:scroll-region dy-frac ops])

(defn cell-region (x y w h px ops)
  "A self-contained render block that draws `ops` with the cell metrics of font size `px`
(logical pixels), inside the rect `[x y w h]` given in the PARENT's cells. Inside, ops are
positioned in the REGION's own cell space — its top-left is row 0, column 0 — so a caller
lays the region out in its own units without knowing the outer size, and the region is
clipped to its rect vertically. `ops` is a flat vector of render ops (built with `into []`).

This is what lets ONE FRAME carry two text sizes: an editor zooming a single buffer while
the rest of the window stays put. The face attribute `:scale` also draws bigger text, but
only in whole multiples of the cell (2×, 3×); a region carries a px, so a step is a pixel.

How many region cells fit the rect is a question only the renderer can answer — ask
`gui/cell-size` for the cell size at `px` and at the window's own size, and divide. Scoped
and self-restoring like `scroll-region`, and regions nest (an inner one wins). GUI-only — the
terminal frontend SKIPS it (like `frect` and `vspans`): a terminal cell is whatever the
terminal says it is, and flattening the ops would paint them in the wrong place.

    (editor/display/cell-region 0 4 40 6 21 [[:text 0 0 \"big\"]])   ;=> [:cell-region 0 4 40 6 21 [[:text 0 0 \"big\"]]]"
  [:cell-region x y w h px ops])

(defn seam (row &optional (opts {}))
  "A render op saying how the frame's rows sit in a GUI window (ADR-610): rows above
`row` are anchored to the window's top, rows from `row` down to its bottom, so the last
row ends exactly at the bottom inset at every window height, and the leftover pixels (the
window less its margins, mod one row) sit between row `row - 1` and row `row`, painted by
the backgrounds of the row above. An editor names its bottom mode line: the echo area
stays on the window's edge and the leftover becomes the text body's partial line, as in
Emacs. `row` nil (or past the grid) keeps the leftover under the last row.

`opts` `{:top-band false}` says row 0 is not a full-width band (a header line or tab bar
is one): the top then gets the inset the sides have, and the grid loses those rows — the
window sends a resize when this changes. Left out, row 0 is a band and starts at the
window's top edge, the layout of a frame without the op.

Rows stay whole cells: only the renderer's row-to-pixel map and the mouse hit-test change,
so the app never sees a pixel. Frame state, read at the top level (the first one wins);
the terminal frontend skips it.

    (editor/display/seam 38)                     ;=> [:seam 38]
    (editor/display/seam 38 {:top-band false})   ;=> [:seam 38 {:top-band false}]"
  (if (empty? opts) [:seam row] [:seam row opts]))

(defn above-seam (ops)
  "A render block for the text ABOVE the seam (ADR-615): `ops` are laid out on the rows above
the frame's `seam` carried on past it, as if the grid had no seam, and cut off where the
seam's row begins. So the row they put at the seam's own row number shows its top in the
leftover strip — the next line of the text, partly visible, as Emacs shows a window's last
line — rather than the stretched background of the row above it, once the strip is at least
half a row tall (under that, a few pixels of a line being specks, the strip stays the row
above's, exactly as without the block: the renderer decides, knowing the pixels). Rows above
the seam paint where they always do. Paint the next row's background too: the strip holds
what the frame painted there before the block. `ops` is a flat vector of render ops (built with `into []`).

A frame with one makes a strip showing the line content to the mouse as well: a pointer in it
is reported on the seam's row, as the block laid it out, with `:partial true` in the event's
trailing map — not the bottom-anchored row of the same number. GUI-only: without a seam the ops paint
as they are, and the terminal frontend draws them in place.

    (editor/display/above-seam [[:text 30 0 \"next line\"]])   ;=> [:above-seam [[:text 30 0 \"next line\"]]]"
  [:above-seam ops])

(defn frect (x y w h face &optional (opacity 1.0) (radius 0.0))
  "A **sub-cell** rounded-rectangle render op: like `rect`, but `x`/`y` (top-left) and
`w`/`h` (size) are in **cell units as floats**, so the shape isn't snapped to the
character grid — `0.4` cells wide, `12.7` tall at `y 3.25` are all fine. The GUI
fills an anti-aliased, alpha-blended quad: `opacity` (0..1, default 1.0) fades it over
whatever's behind, and `radius` (cell units, default 0.0 — use `(/ w 2)` for a pill)
rounds the corners. `face`'s `:bg` (or `:fg` under `:reverse`) is the fill colour.
The primitive a smooth scrollbar thumb / slider / progress bar wants. GUI-only — the
terminal frontend skips it (like `vspans`).

    (editor/display/frect 0.5 1.0 2.0 1.0 nil)   ;=> [:frect 0.5 1.0 2.0 1.0 nil 1.0 0.0]"
  [:frect x y w h face opacity radius])

(defn bar (row width s &optional (opts {}))
  "A full-width status / mode / **buffer bar**: string `s` drawn on `row` from column
0 and padded with spaces to `width` cells (truncated if it overflows), so a
`:reverse` or `:bg` face fills the whole line — the header / footer / buffer-bar
shape `std/observer` draws by hand. Returns one `text` op.

`opts` (all optional):
  `:face`  — the style map: `{:reverse true}`, a named `(face :ui/header)`, or
             `{:bg :blue :fg :white :bold true}`.
  `:align` — `:left` (default), `:center`, or `:right`: where `s` sits on the bar.
  `:scale` — GUI per-op font scale (ADR-079, an integer >= 1, default 1): the bar is
             drawn that many times larger — `scale` rows tall, holding `width/scale`
             characters — with the terminal frontend rendering it 1x.

    (bar 0 cols \" file.blsp        UTF-8  L1\" {:face (face :ui/header)})
    (bar (dec rows) cols msg {:face {:bg :blue :fg :white} :align :center})

    (editor/display/bar 0 6 \"ab\")                   ;=> [:text 0 0 \"ab    \"]
    (editor/display/bar 0 6 \"ab\" {:align :right})   ;=> [:text 0 0 \"    ab\"]"
  (let (scale (math/max 1 (get opts :scale 1))
        cells (math/max 1 (math/quot width scale)))
    (text row
      0
      (bar-fit s cells (get opts :align :left))
      (bar-face (get opts :face) scale))))

(defn- bar-face (face scale)
  "`face` with `:scale` added when `scale` > 1 (a magnified bar); the face unchanged
(possibly `nil`) at scale 1."
  (if (> scale 1) (assoc (or face {}) :scale scale) face))

(defn- bar-fit (s cells align)
  "`s` fitted to exactly `cells` characters — padded with spaces (positioned per
`align`: `:left` / `:center` / `:right`) or truncated when longer."
  (let (n (string/length s))
    (cond
      (>= n cells) (string/substring s 0 cells)
      (= align :right) (string/pad-left s cells)
      (= align :center)
        (string/pad-right (str (string/repeat " " (math/quot (- cells n) 2)) s) cells)
      else (string/pad-right s cells))))

(defn frame (& ops)
  "Collect render ops into a frame (a vector), dropping any `nil` ops so callers
can splice in conditional ops inline. Pass the result to a frontend (`term/draw`).

    (count (editor/display/frame (editor/display/clear)))   ;=> 1"
  (into [] (seq/filter ops (fn (o) (not (nil? o))))))

;; The ops a window acts on ONCE, when the frame carrying them arrives, rather than
;; painting what they describe: a sound plays, a burst emits. Every other op is state the
;; next frame repeats or drops (music and emitters included), so it is lost with nothing
;; when a frame is skipped.
(def- one-shot-tags #{:sound :burst})

(defn frame-one-shots (frame)
  "The ops in `frame` a window acts on once, when the frame arrives — every `[:sound …]`
and `[:burst …]`, at any depth, in order — and nothing else. A frontend that skips a
frame to paint a newer one (a thin client behind its daemon, ADR-492) carries these into
the frame it paints, so skipping it costs a paint and never a sound; `[:music …]` and
`[:emitter …]` are state the newer frame restates, and are not here.

    (editor/display/frame-one-shots [[:clear] [:sound 3 0.5] [:text 0 0 \"x\"]])   ;=> [[:sound 3 0.5]]
    (editor/display/frame-one-shots [[:scroll-region 0 0 [[:burst 1 10]]] [:music 2]])   ;=> [[:burst 1 10]]"
  (fold frame [] frame-one-shots-into))

(defn- frame-one-shots-into (found op)
  "`found` with the one-shot ops in `op` appended: `op` itself when it is one, those
nested in it when it holds ops (a region), nothing for anything else."
  (cond
    (not (vector? op)) found
    (contains? one-shot-tags (first op)) (conj found op)
    else (fold op found frame-one-shots-into)))

;; ---- interaction zones (hover / click hit-testing) --------------------------
;; `cursor-zone` (above) is a *render op* the frontend hit-tests to choose a pointer
;; shape. A `zone` is its model-side dual: a plain value the *editor* hit-tests
;; (`zone-at`) on pointer-move / click, so chrome can react — highlight on hover, pop a
;; tooltip, run a command. Clickable/hoverable furniture (a mode-line segment, a gutter
;; marker) is a list of zones laid alongside the render ops that draw it.

(defn zone (rect id &optional (cursor nil))
  "An interaction zone: the screen-cell rectangle `rect` (`[x y w h]`, 0-based cells)
tagged with `id` — any value the caller keys off when the pointer hits it (a segment id, a
command symbol, a payload map). `cursor`, when given, is the pointer shape to request while
hovered (rendered via `zone-cursor-ops`, as a `cursor-zone`). Pure data.

    (:rect (editor/display/zone [0 0 4 1] :save))              ;=> [0 0 4 1]
    (:cursor (editor/display/zone [0 0 4 1] :save :pointer))   ;=> :pointer"
  {:rect rect :id id :cursor cursor})

(defn zone-at (zones col row)
  "The hit `zone` in `zones` containing cell `(col, row)`, or nil. Scans in order and keeps
the **last** match, so a zone painted later (visually on top) shadows an earlier one it
overlaps — matching paint order. The model calls this on pointer-move (to find the hovered
zone) and on click (to find the target).

    (get (editor/display/zone-at [(editor/display/zone [0 0 10 1] :bar) (editor/display/zone [2 0 3 1] :btn)] 3 0) :id)   ;=> :btn
    (editor/display/zone-at [(editor/display/zone [0 0 10 1] :bar)] 3 5)   ;=> nil"
  (fold zones
    nil
    (fn (hit z)
      (let ([x y w h] (get z :rect))
        (if (and (>= col x) (< col (+ x w)) (>= row y) (< row (+ y h)))
          z
          hit)))))

(defn zone-cursor-ops (zones)
  "`cursor-zone` render ops for every zone in `zones` that requests a `:cursor` shape — so
the one zone list the model hit-tests also drives the frontend's pointer shape. Zones with
no `:cursor` contribute nothing.

    (editor/display/zone-cursor-ops [(editor/display/zone [0 0 4 1] :link :pointer) (editor/display/zone [5 0 2 1] :plain)])   ;=> ([:cursor-zone 0 0 4 1 :pointer])"
  (map (seq/filter zones :cursor)
    (fn (z) (let ([x y w h] (get z :rect)) (cursor-zone x y w h (get z :cursor))))))

;; ---- floating cards (popups, menus, tooltips) -------------------------------
;; The shared shape behind every floating overlay — completion popup, context menu,
;; marginalia list, tooltip: a rounded raised *surface* (GUI) or a flat filled panel
;; (terminal), positioned near an anchor and clamped on-screen. Callers draw their own
;; content (rows, marginalia, tooltip text) on top; only the surface + geometry + the
;; selection pill live here, so every overlay elevates identically — surfaces + hairlines,
;; no shadow (dark-UI chrome; see the editor's docs/ui-chrome.md).

(defn- clamp-cell (v:number hi:number -> number)
  "`v` clamped to `0..hi` — a screen cell coordinate, so an integer in and an integer out.

`math/max`/`math/min` would say this more briefly, and did. They are polymorphic over
`ordered` (they compare strings just as happily), so their result types as `ordered` and the
integer-ness is lost the moment it leaves here — `(+ mr i)` in the caller below then had a
non-number where a number belongs. Written as comparisons the type follows the values."
  (cond
    (< v 0) 0
    (> v hi) hi
    else v))

(defn card-rect (row col w h cols rows)
  "The clamped top-left `[mr mc]` of a `w`×`h`-cell card anchored at `(row, col)`: shifted
so the whole card stays on the `cols`×`rows` screen. Shared by a card's renderer and any
click/hover hit-test, so a card near a screen edge stays interactive exactly where drawn.

    (editor/display/card-rect 20 75 10 4 80 24)   ;=> [20 70]"
  [(clamp-cell row (- rows h)) (clamp-cell col (- cols w))])

(defn card-surface (row col w h face &optional (gui? false) (opts {}))
  "Render ops for a floating card's **surface** — the raised panel other overlays sit on:
`w`×`h` cells at top-left `(row, col)`, filled in `face`. In the GUI (`gui?`) it's a rounded
`frect` (radius `opts :radius`, default 0.5 cell); a `opts :border` face adds a crisp rounded
hairline as a slightly larger border-coloured `frect` drawn behind the surface (a rounded
edge, not a shadow). The terminal falls back to a flat `rect` (no radius, no border). Content
is drawn by the caller on top.

    (editor/display/card-surface 1 2 10 3 nil)   ;=> ([:rect 1 2 10 3 nil])"
  (let (radius (get opts :radius 0.5)
        border (get opts :border))
    (if gui?
      (append (if border
                [(frect (- col 0.07) (- row 0.07) (+ w 0.14) (+ h 0.14) border 1.0 (+ radius 0.07))]
                [])
        [(frect (* 1.0 col) (* 1.0 row) (* 1.0 w) (* 1.0 h) face 1.0 radius)])
      (list (rect row col w h face)))))

(defn card-pill (row col w face &optional (opts {}))
  "A rounded selection **pill** inside a card: a one-row-tall `frect` highlight at
`(row, col)` spanning `w` cells, inset slightly so it floats within the card's padding.
GUI-only (the flat/terminal card highlights the selected row with a solid face instead).

    (editor/display/card-pill 2 3 10 nil)   ;=> [:frect 3.2 2.08 9.6 0.84 nil 1.0 0.35]"
  (frect (+ 0.2 col) (+ 0.08 row) (- w 0.4) 0.84 face 1.0 (get opts :radius 0.35)))

(defn tooltip (anchor-row anchor-col lines face fg cols rows &optional (gui? false) (opts {}))
  "Render ops for a tooltip — a small floating card showing `lines` (a vector of strings),
its **bottom** anchored just above cell `(anchor-row, anchor-col)`: the mature-GUI placement,
a hint hovering over the thing it describes, clamped on-screen via `card-rect`. Sized to the
widest line plus one cell of padding each side; `face` fills the surface, `fg` styles the
text, and `opts` forwards `:border`/`:radius` to `card-surface`. GUI rounds the card; the
terminal draws a flat panel.

    (editor/display/tooltip 5 10 [\"hi\"] :popup :fg 80 24)   ;=> ([:rect 4 10 4 1 :popup] [:text 4 10 \" hi \" :fg])"
  (let (n (count lines)
        w (+ 2 (fold lines 0 (fn (m s) (math/max m (string/length s)))))
        [mr mc] (card-rect (- anchor-row n) anchor-col w n cols rows))
    (append (card-surface mr mc w n face gui? opts)
      (map (range n)
        (fn (i)
          (let (s (nth lines i))
            (text (+ mr i)
              mc
              (str " " s (string/repeat " " (math/max 0 (- w 1 (string/length s)))))
              fg)))))))
