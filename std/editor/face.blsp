;; std/editor/face.blsp — named text faces + a theme registry for UI apps.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - An emacs-style **face system** shared by every UI on the display seam (the
;;    process observer today, the REPL line editor and the coming editor next), so
;;    styling is policy in Brood, named once and referenced everywhere — restyle a
;;    "section" by redefining ONE face, not by hunting inline `{:fg …}` literals
;;    through a renderer. The counterpart to `keymap` (key→command) and `display`
;;    (render-ops): this is "name → style".
;;  - A FACE is the same attribute map `display.blsp`/`term/draw`/`gui/draw` already
;;    consume (`{:fg :red :bold true …}`), so `(face :ui/header)` drops straight into
;;    a `[:text row col s <face>]` op with no frontend change. `face` is the only
;;    resolution step — call sites never touch `editor/face/*faces*` directly.
;;  - The registry is a single global map, mutated only by `def` rebinding it (the
;;    language's one mutation, as `provide` does for `*features*`). That rebind is
;;    visible across processes (shared code region, ADR), so a theme set in the REPL
;;    restyles a running observer on its next frame — late binding, like a redefined
;;    command through `keymap`. (A `def` rebind isn't an atomic read-modify-write,
;;    so *concurrent* `def-face`s from many processes can lose updates — like
;;    concurrent `(def *features* …)`. Define a theme from one place — startup or
;;    the REPL — not from a fan-out; reads are always safe.)
;;  - Pure resolution (`face` is data→data, no IO), opt-in (`require`), never in the
;;    prelude.
;;
;; ATTRIBUTES a face map may carry (all optional; unknown keys are ignored by every
;; frontend, so the vocabulary grows without breaking older ones):
;;   :fg :bg        — a colour, both frontends: a palette keyword (:red :green …
;;                    :dark-grey, rendered as the terminal's named colour), or an
;;                    explicit `[r g b]` vector (0..255) / `"#rgb"`|`"#rrggbb"` hex
;;                    string (a true colour, identical in both frontends — for a
;;                    curated palette beyond the 16 named slots)
;;   :bold :reverse — flags, both frontends
;;   :italic        — a flag (terminal + GUI)
;;   :underline     — a flag; a colour (`"#ff5f59"`, `:red`) for an underline of its own
;;                    colour; or `{:color c :style :wave}` for a wavy one (a spell
;;                    checker's, a diagnostic's), the text keeping its own colour.
;;                    The terminal draws the coloured / curly form where it supports
;;                    the extended underline (ADR-513), else a plain underline
;;   :family        — GUI only: a font-family keyword (`:mono` is the bundled
;;                    default; others registered via `gui/font-register`)
;;   :height        — GUI only: a hint, honored by the whole-window `gui/font` knob
;;   :scale         — GUI only: a positive integer (default 1, capped at 16). The
;;                    op's text is drawn `:scale`× larger, occupying a scale×scale
;;                    block of cells anchored at its (row, col) — the per-section /
;;                    per-pane / per-buffer font knob (ADR-079). Distinct from
;;                    `:height` (which only re-sizes the whole window via
;;                    `gui/font`); the terminal frontend ignores it (renders 1×).
;;   :inherit       — a face NAME this face is layered over (local keys win)

(defmodule editor/face
  "Named text faces + a theme registry for UI apps on the display seam (the
counterpart to `keymap`/`display`): style is named once and referenced everywhere,
so restyling a section is a one-line redefinition rather than an edit at every call
site.

    (def-face :ui/header {:fg :white :bold true :reverse true})
    (def-face :note      {:inherit :ui/dim :italic true})
    (text 0 0 \"hi\" (face :ui/header))   ; resolve a face into a render op
    (face-set :ui/header {:fg :cyan})    ; restyle everywhere, live

A *face* is the same attribute map `term/draw`/`gui/draw` consume (`{:fg :red :bold
true …}`); `face` resolves a name (following an `:inherit` chain) to that map, or
nil (the default face) for an unknown name. The registry is a shared global, so a
theme change is visible to a running UI on its next frame (late binding).")

;; ---- the registry -----------------------------------------------------------

(defdyn editor/face/*faces* {})
; the theme: face-name (keyword) -> attribute map

;; Both writers are ONE map operation through `%registry-update!`, never a whole-map
;; `%swap-registry!`. The difference is not style: a swap writes the whole map LIVE, and
;; the kernel documents that as the write an `%isolate` restore discards — whereas an op is
;; staged with the module load that makes it, published whole, and replayed by every restore
;; that would otherwise roll the module back (ADR-339/344). `editor/highlight` used to declare
;; its `:syntax/*` faces at its own load; under lazy loading that load landed inside whichever
;; test file first coloured a token, and with the swap every later file found the module provided
;; and its faces gone — `highlight-spans` answered nil for a week of tree-walker CI (KI-141).
(defn def-face (name attrs)
  "Register (or replace) face `name` with the attribute map `attrs`; returns `name`.
`attrs` may carry an `:inherit` face name layered under it at resolution time.

    (editor/face/def-face :myapp/warning {:fg :yellow :bold true})   ;~> :myapp/warning — the face registry now holds it"
  (%registry-update! 'editor/face/*faces* :assoc [name] attrs)
  name)

(defn face-set (name attrs)
  "Merge `attrs` into face `name` (creating it if absent) — restyle a face in one
place, keeping its other attributes. Returns `name`.

    (editor/face/face-set :syntax/keyword {:bold true})   ;~> :syntax/keyword — the registry's keyword face is now bold"
  (%registry-update! 'editor/face/*faces* :merge [name] attrs)
  name)

(defn faces ()
  "The whole face registry (a map of name → attribute map). For introspection — a
theme editor or the docs; resolve a single face with `face`."
  editor/face/*faces*)

;; ---- resolution -------------------------------------------------------------

;; check-allow: deliberately non-tail — depth = the face inheritance chain — a few links.
(check-allow :non-tail-recursion
  (defn- face-resolve (name depth)
    "Resolve face `name` to a flat attribute map, layering an `:inherit` parent
  underneath (local keys win). `depth` bounds the `:inherit` chain so an accidental
  cycle terminates instead of overflowing the stack (cf. `observe-tree-walk`)."
    (let (attrs (get editor/face/*faces* name))
      (cond
        (nil? attrs) nil
        (>= depth 16) (dissoc attrs :inherit)
        else
          (let (parent (get attrs :inherit)
                self (dissoc attrs :inherit))
            (if (nil? parent)
              self
              (merge (or (face-resolve parent (inc depth)) {}) self)))))))

(defn face (name)
  "Resolve face `name` to the attribute map a render op wants (`{:fg :red …}`),
following its `:inherit` chain. An unknown name resolves to `nil` — the default
face — so `(text r c s (face :missing))` is just unstyled text. Pure.

    (get (editor/face/face :ui/error) :fg)   ;=> :red
    (editor/face/face :no-such-face)         ;=> nil"
  (face-resolve name 0))

;; ---- the core `:ui/*` faces -------------------------------------------------
;;
;; A small base palette every UI app can build on (and an app overrides or inherits
;; from): the neutral default, an emphatic header, dimmed/secondary text, an error
;; colour, the reverse-video selection, and a highlight. Apps add their own named
;; faces (often `:inherit`-ing these) — see `std/tool/observer.blsp`.

(def-face :ui/default {})
(def-face :ui/header {:bold true :reverse true})
(def-face :ui/dim {:fg :dark-grey})
(def-face :ui/error {:fg :red :bold true})
(def-face :ui/selected {:reverse true})
(def-face :ui/highlight {:fg :cyan})

;; ---- faces: the :syntax/* theme seam ----------------------------------------
;; Syntax faces live here, in the shared registry, under
;; `:syntax/*` names, resolved once per lexing pass (`hl-faces`) — so an
;; app restyles the whole highlighter by redefining ONE face
;; (`(face-set :syntax/keyword {:fg \"#cba6f7\"})`), the same late-bound seam the
;; `:ui/*` faces and keymaps use. The DEFAULTS are the original palette keywords, so
;; the terminal REPL / observer are unchanged and keyword colours still honour the
;; user's terminal theme; only an app that opts in (the GUI editor) sees a richer
;; palette. (`def-face` returns the name; the registrations run at module load.)

(def-face :syntax/comment {:fg :dark-grey})
(def-face :syntax/string {:fg :green})
;; A DOCSTRING — the string a `def…` form documents itself with, as opposed to one it
;; returns. Distinct from `:syntax/string` on purpose: the two are the same token to a
;; lexer and completely different things to a reader (`(defn greeting () "doc" "hi")`
;; colours the prose and the value apart). Grey + italic reads as prose without
;; disappearing the way a comment does; a terminal that can't do italic still shows the
;; hue difference.
(def-face :syntax/doc {:fg :grey :italic true})
(def-face :syntax/number {:fg :yellow})
;; A language KEYWORD — Python's `def` / `return`, Rust's `fn` / `let`, Elixir's `do` / `end`: what a
;; tree-sitter table's anonymous keyword tokens report (`face-of-syntax`) and a lexer table's
;; `:keyword` role names. The Lisps' keywords are their special forms (`:syntax/special`); a Lisp
;; `:keyword` LITERAL is `:syntax/symbol`, below (ADR-616).
(def-face :syntax/keyword {:fg :magenta})
;; A SYMBOL used as a value (ADR-616): a Lisp `:keyword`, and `nil` / `true` / `false`, which the
;; reader classifies with them — and a data format's KEY (JSON, YAML, TOML, INI), a name written
;; as data. Apart from `:syntax/keyword` so a theme can leave a language's keywords plain and
;; colour its literals (Tonsky's rule); by default it IS the keyword face, the colour these
;; tokens always had.
(def-face :syntax/symbol {:inherit :syntax/keyword})
;; A CONSTANT a language names (ADR-616): `true` / `false` / `nil` / `None` / `null`, an Elixir
;; atom, a Ruby symbol — what tree-sitter and lexer tables coloured as specials. By default it IS
;; the special face, the colour they always had; a theme that colours literals names it.
(def-face :syntax/constant {:inherit :syntax/special})
; special forms / core macros
(def-face :syntax/special {:fg :blue :bold true})
; a call head
(def-face :syntax/function {:fg :cyan})
;; The NAME a definition binds — `f` in `(defn f …)`, `def f():`, `fn f()` — apart from a
;; call's head (ADR-614). By default it IS the call face, so a theme that names neither sees
;; no difference; one that colours definitions and leaves calls plain (Tonsky's rule) restyles
;; the two apart.
(def-face :syntax/definition {:inherit :syntax/function})
;; Brackets, commas and semicolons (ADR-614). Empty by default — the plain text colour — and
;; a lexer paints nothing for a face with no attributes, so only a theme that dims
;; punctuation pays a span per bracket.
(def-face :syntax/punctuation {})
; the matched bracket pair (REPL)
(def-face :syntax/match {:reverse true})
; a lone unmatched bracket (REPL)
(def-face :syntax/error {:fg :red :bold true})
;; Brackets coloured by DEPTH (Emacs's rainbow-delimiters), `:syntax/delimiter-1` the outermost,
;; cycling past the ninth — painted only by a lexer asked to (`lisp-line-lexer`'s `:rainbow`).
;; No colour of their own here: an app that wants the rainbow names its colours.
(doseq (depth (range 1 10)) (def-face (keyword (str "syntax/delimiter-" depth)) {}))
