;; std/editor/keymap.blsp — a rebindable key→command dispatcher.
;;
;; The shared input seam for interactive Brood UIs (the line editor, the process
;; observer, the coming text editor). A KEYMAP is a map `key → command`, where a
;; key is what `term/poll` returns (a 1-char string, or a keyword like `:up` /
;; `:ctrl-a`) and a command is either:
;;   - a **command symbol** — a global `(fn (state key) -> state)`, resolved *by
;;     symbol at dispatch time* so redefining the command (or rebinding the key)
;;     hot-swaps behaviour on the next keystroke (the late-binding that makes a
;;     self-editing UI possible, ADR-046/052); or
;;   - a nested **keymap** (a map) — a *prefix* the next key resolves within, i.e.
;;     a chord like `C-x C-e`. Chords are just data: nest the maps (or use
;;     `keymap-bind`); no chord is hardcoded here.
;;
;; Two dispatch entry points: `keymap-dispatch` is the flat, single-key fast path
;; (unchanged — what lineedit/observer use); `keymap-step` is the chord-aware
;; superset that threads a "pending prefix" through the caller's loop.
;;
;; This is the counterpart to the display seam: `std/editor/display.blsp` is "render-ops
;; out"; this is "key events in". Both are policy in Brood over a thin term-* seam.

(defmodule editor/keymap
  "A rebindable key→command dispatcher for interactive UIs. A *keymap* maps a key
(a `term/poll` value) to either a command **symbol** — a global `(fn (state key) ->
state)` — or a nested **keymap** (a prefix, for chords like `C-x C-e`). Bindings
resolve by symbol at dispatch time, so rebinding a key or redefining its command
hot-swaps behaviour.

    (def *my-keys* {:up 'go-up :down 'go-down})
    (keymap-dispatch *my-keys* state key (fn (s _) s))   ; flat: unbound → no-op

    ;; a chord, built as data — no specific binding baked into this module:
    (def *km* (keymap-bind {} [:ctrl-x :ctrl-e] 'eval-last-sexp))
    (keymap-step *km* pending state key fallback)        ; => [state' pending']

A key's Emacs spelling reads both ways: `key-description` prints `[:ctrl-x :ctrl-f]` as
`C-x C-f`, and `key-parse` reads it back, so a config file can bind a key the way help
names it.

Used by `std/editor/lineedit.blsp` (self-insert fallback) and `std/tool/observer.blsp` (no-op
fallback); the same pattern is how the editor's keymaps work.")

(defn keymap-dispatch (keymap state key fallback)
  "Dispatch `key` through `keymap` to its command — a global `(fn (state key) ->
state)` resolved by symbol (so redefining the command, or rebinding the key,
hot-swaps behaviour). An **unbound** key goes to `fallback` (a `(fn (state key) ->
state)` — e.g. self-insert, or a no-op `(fn (s _) s)`). A command that throws is
caught and leaves the state unchanged, so a bad binding can't crash the loop. The
flat, single-key path: a binding to a nested keymap (a chord prefix) is ignored
here — use `keymap-step` for chords. Pure apart from the symbol resolution;
testable without a terminal.

    (editor/keymap/keymap-dispatch {} 1 :z (fn (s k) (inc s)))   ;=> 2"
  (let (sym (get keymap key))
    (if (or (nil? sym) (map? sym))
      (fallback state key)
      (try ((reflect/eval sym) state key) (catch e state)))))

(defn keymap-resolve (keymap:map pending:any key:any -> vector)
  "One keystroke through a (possibly chorded) `keymap`, resolved to its BINDING and
**not run**: `[binding pending']`. The chord walk on its own, with no opinion about
what a binding means or how it is invoked.

  - a nested **keymap** → `[nil <sub-keymap>]`: `key` entered a prefix, and the
    caller threads `pending'` back in on the next keystroke;
  - any other value → `[binding nil]`: the chord completed on that binding;
  - **unbound** → `[nil nil]`.

\"Unbound\" and \"entered a prefix\" are told apart by `pending'`, and a caller that
needs to distinguish an unbound key at the TOP from a dead-end after a prefix has its
own `pending` to compare against — which is exactly what [[keymap-step]] does.

This is the part of dispatch that is not about calling: [[keymap-step]] is this plus
`reflect/eval`, and it exists separately because several callers want the binding
itself. `describe-key` reports what a key sequence WOULD run without running it; a
`which-key` panel names the command under a pending prefix; and a dispatcher with a
different calling convention — a transient menu (bedit's `transient-core`), whose
bindings are switches and options rather than `(state key)` commands — cannot use
`keymap-step` at all, because
`keymap-step`'s only way to tell you what it found is to call it. Each of those
otherwise re-implements this six-line walk, and a second implementation of chord
resolution is a second set of chord bugs.

Pure — no eval, no state, nothing to mock.

    (editor/keymap/keymap-resolve {:a 'save} nil :a)   ;=> [save nil]
    (editor/keymap/keymap-resolve {:a 'save} nil :zz)  ;=> [nil nil]"
  (keymap-classify (get (if (nil? pending) keymap pending) key)))

(defn keymap-classify (binding -> vector)
  "What one looked-up `binding` means to a chord walk, as [[keymap-resolve]] reports it:
`[nil binding]` for a nested keymap (a prefix entered), `[nil nil]` for nothing bound,
`[binding nil]` for a completed chord. For a caller that finds the binding its own way
— `editor/layers` asks its layers one at a time rather than merging their keymaps.

    (editor/keymap/keymap-classify 'save)   ;=> [save nil]
    (editor/keymap/keymap-classify nil)     ;=> [nil nil]"
  (cond
    (map? binding) [nil binding]
    (nil? binding) [nil nil]
    else [binding nil]))

(defn keymap-step (keymap pending state key fallback)
  "One keystroke through a (possibly chorded) `keymap`, returning `[state' pending']`
— the threaded counterpart to `keymap-dispatch`. `pending` is the prefix sub-keymap
a prior key left us mid-chord in, or `nil` for a fresh chord; thread the returned
`pending'` back in on the next keystroke. Resolution ([[keymap-resolve]]) looks `key`
up in `pending` when mid-chord, else in `keymap`:
  - binds to a nested **keymap** → enter that prefix: `[state <sub-keymap>]` (state
    unchanged; we wait for the next key);
  - binds to a **command symbol** → run it and reset: `[(command state key) nil]`
    (a throwing command leaves state unchanged, like `keymap-dispatch`);
  - **unbound at the top** (fresh, not mid-chord) → `[(fallback state key) nil]`;
  - **dead-end chord** (unbound *after* a prefix) → `[state nil]`: the key is
    dropped and the chord resets (Emacs-style \"undefined\"), so a partial chord
    never self-inserts via the fallback.
Pure apart from the symbol resolution; testable without a terminal."
  (keymap-run (keymap-resolve keymap pending key) pending state key fallback))

(defn keymap-run (resolved pending state key fallback)
  "The running half of [[keymap-step]]: act on `resolved`, a `[binding pending']` that
[[keymap-resolve]] (or [[keymap-classify]]) produced for `key`, returning `[state'
pending']` by the same rules. A caller that resolves a key without a merged keymap in
hand — `editor/layers/layer-dispatch` — steps through this.

    (first (editor/keymap/keymap-run [nil nil] nil 1 :z (fn (s k) (inc s))))   ;=> 2"
  (let ([binding entered] resolved)
    (cond
      (not (nil? entered)) [state entered]
      (nil? binding)
        (if (nil? pending)
          [(fallback state key) nil]
          [state nil])
      else [(try ((reflect/eval binding) state key) (catch e state)) nil])))

;; check-allow: deliberately non-tail — depth = the keymap's chord nesting, a few levels.
(check-allow :non-tail-recursion
  (defn keymap-where-is (keymap command)
    "Every key SEQUENCE bound to `command` in `keymap`, as a list of key vectors
  (`([:ctrl-x :ctrl-e] …)` — prefixes included, chords walked); `()` when nothing is
  bound to it. The inverse of `keymap-bind`, and the mechanism behind
  \"press-whatever-you-actually-have-bound\" help text: a UI names the COMMAND and
  asks the live keymap what key runs it, so documentation follows a rebinding
  instead of going stale (Emacs `where-is-internal` / `substitute-command-keys`).
  Pure over the keymap data — no dispatch, no eval.

    (editor/keymap/keymap-where-is {:a 'save :x {:q 'quit}} 'quit)   ;=> ([:x :q])"
    ;; `map?` FIRST: a nested keymap is a prefix, never a command — so passing a
    ;; sub-keymap as `command` finds nothing rather than matching by structural `=`.
    (mapcat keymap
      (fn (entry)
        (let ([k v] entry)
          (cond
            (map? v) (map (keymap-where-is v command) (fn (seq) (into [k] seq)))
            (= v command) (list [k])
            else '()))))))

;; check-allow: deliberately non-tail — depth = the keymap's chord nesting, a few levels.
(check-allow :non-tail-recursion
  (defn keymap-index (keymap)
    "Every binding in `keymap` at once — `{command -> (key-sequence …)}`, prefixes walked,
  each sequence a key vector. One walk.

  `keymap-where-is` answers the same question for ONE command, and walking the map per
  command is what a caller reaches for without thinking: a completion UI that shows the key
  beside each row (`M-x`) then walks the whole keymap once per visible row, twice if it also
  asks `keymap-commands`. Measured in bedit that was 48 ms per keystroke in `M-x` — for
  fifteen rows of marginalia. Build this once and each row is a lookup.

  Pure over the keymap data — no dispatch, no eval, no load; a command whose module has not
  been loaded appears here like any other, since a keymap names commands by symbol.

    (editor/keymap/keymap-index {:x {:s 'save :q 'quit}})   ;=> {save ([:x :s]), quit ([:x :q])}"
    (fold (keymap-bindings keymap)
      {}
      (fn (acc pair)
        (let ([command seq] pair)
          (assoc acc command (cons seq (or (get acc command) '()))))))))
(sig keymap-index (map -> map))

;; check-allow: deliberately non-tail — depth = the keymap's chord nesting, a few levels.
(check-allow :non-tail-recursion
  (defn keymap-bindings (keymap)
    "Every binding in `keymap` as a flat list of `[command key-sequence]` pairs — prefixes
  walked, in no particular order. The walk `keymap-index` groups; separate because the flat
  form is what a caller listing a whole keymap (a `describe-bindings`, a cheat sheet) wants,
  and because grouping with `append` per binding is what made a first cut of `keymap-index`
  nine times slower than this walk.

    (into #{} (editor/keymap/keymap-bindings {:a 'save :x {:q 'quit}}))   ;=> #{[save [:a]] [quit [:x :q]]}"
    (mapcat keymap
      (fn (entry)
        (let ([k v] entry)
          (cond
            (map? v) (map (keymap-bindings v) (fn (pair) (let ([c s] pair) [c (into [k] s)])))
            (symbol? v) (list [v [k]])
            else '()))))))
(sig keymap-bindings (map -> seqable))

(defn keymap-commands (keymap)
  "Every command symbol `keymap` binds, anywhere in it — prefixes walked, deduplicated, in
no particular order. The other inverse of `keymap-bind`: [[keymap-where-is]] asks \"which
keys run this command?\", this asks \"which commands does this keymap know about?\".

What it is FOR: a keymap binds commands by SYMBOL, late-bound, so it can name a command
whose module has not been loaded yet. That makes the keymap the one place an application
can discover a deferred feature's commands WITHOUT loading it — for a command palette, a
help listing, or an `M-x`-style by-name runner that would otherwise offer only what
happens to be in memory. Pure over the keymap data — no dispatch, no eval, no load.

    (sort (map (editor/keymap/keymap-commands {:a 'save :x {:q 'quit :s 'save}}) str))   ;=> (\"quit\" \"save\")"
  (seq/distinct (map (keymap-bindings keymap) first)))

;; check-allow: deliberately non-tail — depth = the bound key-sequence length — a few keys.
(check-allow :non-tail-recursion
  (defn keymap-bind (keymap keys command)
    "Bind a key sequence `keys` (a vector of one or more keys) to `command` (a symbol)
  in `keymap`, returning a new keymap — the ergonomic, data-only way to define a
  chord without baking any specific binding into this module. A one-key vector is a
  plain binding; a multi-key vector builds the intermediate prefix sub-keymaps (e.g.
  `[:ctrl-x :ctrl-e]`). Sibling bindings are preserved; an existing prefix sub-keymap
  is extended in place.

      (-> {} (keymap-bind [:ctrl-x :ctrl-e] 'eval-last-sexp)
             (keymap-bind [:ctrl-x :ctrl-s] 'save-buffer))

    (editor/keymap/keymap-bind {} [:ctrl-x :ctrl-s] 'save-buffer)   ;=> {:ctrl-x {:ctrl-s save-buffer}}"
    (if (= (count keys) 1)
      (assoc keymap (first keys) command)
      (let (k (first keys)
            existing (get keymap k)
            sub (if (map? existing) existing {}))
        (assoc keymap k (keymap-bind sub (rest keys) command))))))

;; check-allow: deliberately non-tail — depth = the keymaps' chord nesting, a few levels.
(check-allow :non-tail-recursion
  (defn keymap-merge (low high)
    "`high` laid over `low`, prefixes merged all the way down: each key SEQUENCE resolves to
`high`'s binding when `high` has one, else to `low`'s. Where both bind a key to a prefix
keymap the two sub-keymaps merge the same way, so `low`'s `C-c f` survives `high`'s
`C-c C-p` (Emacs's semantics for a mode map over the global map). A non-keymap binding in
`high` — a command, or an explicit nil — takes the whole key, prefix and all; a prefix in
`high` over a command in `low` is the prefix.

    (map/get-in (editor/keymap/keymap-merge {:ctrl-c {\"f\" 'find}} {:ctrl-c {:ctrl-p 'preview}}) [:ctrl-c \"f\"])   ;=> find
    (map/get-in (editor/keymap/keymap-merge {:ctrl-c {\"f\" 'find}} {:ctrl-c {:ctrl-p 'preview}}) [:ctrl-c :ctrl-p])   ;=> preview
    (editor/keymap/keymap-merge {:ctrl-c {\"f\" 'find}} {:ctrl-c nil})   ;=> {:ctrl-c nil}"
    (fold high
      low
      (fn (acc [key binding])
        (let (under (get acc key))
          (assoc acc
            key (if (and (map? binding) (map? under)) (keymap-merge under binding) binding)))))))

;; ---- key descriptions: the Emacs spelling of a key, both ways ------------------------
;; A key is what the frontends deliver (`host::gui::character_chord` / `named_key`, the one
;; rule both the window and the terminal spell keys by — ADR-328, ADR-441): a 1-char string,
;; or a keyword spelling its modifiers in a fixed order,
;; `[ctrl-meta-|ctrl-|alt-][shift-][super-]<name>`. A human writes the same key the way
;; Emacs prints it — `C-x C-f`, `M-%`, `C-M-<return>`. `key-description` is the printer and
;; `key-parse` its inverse (ADR-535), so help text and a config file speak one language:
;; whatever `describe-key` shows can be pasted into a binding.

(def- key-modifier-spellings
  ;; A keyword-name prefix and its Emacs spelling, LONGEST FIRST so `ctrl-meta-` is seen
  ;; before `ctrl-`. The list is the whole modifier vocabulary; add a row to add one.
  [["ctrl-meta-" "C-M-"]
    ["ctrl-" "C-"]
    ["meta-" "M-"]
    ["alt-" "M-"]
    ["shift-" "S-"]
    ["super-" "s-"]])

(def- key-angle-names
  ;; The named keys Emacs writes in angle brackets (`<insert>`, `<f5>`), beyond the function
  ;; keys `key-function-name?` recognises by shape: the ones ADR-441 named.
  #{"insert"
    "menu" "pause" "scroll-lock" "help" "find" "undo" "redo" "copy" "cut" "paste" "select" "execute"
    "cancel" "clear" "back" "forward" "volume-up" "volume-down" "volume-mute" "media-play-pause"
    "media-stop" "media-next" "media-previous"})

(def- key-plain-names
  ;; The named keys the printer writes bare (`left`, `C-enter`, `page-down`): the motion and
  ;; editing keys that carry modifiers in their name, and the three that keep their own.
  #{"up"
    "down" "left" "right" "home" "end" "page-up" "page-down" "enter" "backspace" "delete" "tab"
    "back-tab" "escape"})

(def- key-word-names
  ;; Emacs's own words for a key, as `kbd` reads them.
  {"RET" "enter" "TAB" "tab" "SPC" " " "ESC" "escape" "DEL" "backspace"})

(def- key-angle-aliases
  ;; Emacs's `<name>` for a key this vocabulary names otherwise.
  {"return" "enter"
   "backtab" "back-tab"
   "prior" "page-up"
   "next" "page-down"
   "deletechar" "delete"
   "kp-enter" "enter"})

(def- key-modifier-letters
  ;; The modifier a written `X-` prefix names.
  {"C" :ctrl "M" :meta "S" :shift "s" :super})

(defn- key-function-name? (name)
  "Whether `name` is a function key's, `f1` … `f24`."
  (and (> (string/length name) 1)
    (string/starts-with? name "f")
    (let (number (string/->number (string/substring name 1 (string/length name))))
      (and (int? number) (>= number 1) (<= number 24)))))

(defn- key-angle-name? (name)
  "Whether the key named `name` (its modifiers already spelled) is written `<name>`."
  (or (contains? key-angle-names name) (key-function-name? name)))

;; check-allow: deliberately non-tail — depth = the number of modifiers on one key (C-M-S-x
;; is three), not any input size.
(check-allow :non-tail-recursion
  (defn- key-name-description (name)
    "The Emacs spelling of a key keyword's NAME — its modifier prefixes replaced one at a
time, innermost last, and a bare space as `SPC`.

A prefix test per modifier rather than a chain of `string/replace` passes over every key:
inverting a keymap labels a few hundred keys, and seven scans each was ~40 µs a key."
    (let (hit (seq/find key-modifier-spellings (fn (p) (string/starts-with? name (first p)))))
      (cond
        (= name " ") "SPC"
        (nil? hit) (if (key-angle-name? name) (str "<" name ">") name)
        else
          (let ([prefix spelling] hit)
            (str spelling
              (key-name-description (string/substring name
                                      (string/length prefix)
                                      (string/length name)))))))))

(defn single-key-description (key)
  "The Emacs spelling of one key: `:ctrl-e` → `C-e`, `:alt-g` → `M-g`, `:ctrl-meta-i` →
`C-M-i`, `:ctrl-shift-left` → `C-S-left`, `:f5` → `<f5>`, a space as `SPC`, a 1-char string
as itself. [[key-parse]] reads every spelling this writes back to the same key.

    (editor/keymap/single-key-description :ctrl-meta-i)   ;=> \"C-M-i\"
    (editor/keymap/single-key-description (keyword \"ctrl- \"))   ;=> \"C-SPC\"
    (editor/keymap/single-key-description :super-f5)   ;=> \"s-<f5>\""
  (cond
    (string? key) (if (= key " ") "SPC" key)
    (keyword? key) (key-name-description (->string key))
    else (str key)))

(defn key-description (keys)
  "The Emacs spelling of a key sequence, its keys space-joined — Emacs's `key-description`.
The inverse of [[key-parse]].

    (editor/keymap/key-description [:ctrl-x :ctrl-f])   ;=> \"C-x C-f\"
    (editor/keymap/key-description [:alt-s \"o\"])   ;=> \"M-s o\""
  (string/join (map keys single-key-description) " "))

(defn- key-peel-modifiers (token modifiers)
  "`[modifiers rest]`: the `C-` / `M-` / `S-` / `s-` prefixes peeled off the front of
`token` into the set `modifiers`, for as long as a key is left after the dash — so `C--` is
Ctrl and `-`, and a lone `C` is the letter."
  (let (modifier (and (> (string/length token) 2)
                   (= (string/substring token 1 2) "-")
                   (get key-modifier-letters (string/substring token 0 1))))
    (if modifier
      (key-peel-modifiers (string/substring token 2 (string/length token))
        (conj modifiers modifier))
      [modifiers token])))

(defn- key-named-base (name)
  "The vocabulary's name for the named key written `name` (in angle brackets or bare), or
nil when it names none."
  (let (canonical (or (get key-angle-aliases name) name))
    (if (or (contains? key-plain-names canonical) (key-angle-name? canonical)) canonical nil)))

(defn- key-angle? (token)
  "Whether `token` is written in angle brackets, `<name>`."
  (and (> (string/length token) 2) (string/starts-with? token "<") (string/ends-with? token ">")))

(defn- key-base (token modifiers)
  "`[modifiers base]` for a written key after its outer modifiers: `base` is `[:char c]` or
`[:named name]`. A failure when `token` names no key. Angle brackets may hold modifiers of
their own (`<C-return>`, the older Emacs spelling)."
  (let (word (get key-word-names token))
    (cond
      (= word " ") [modifiers [:char " "]]
      (string? word) [modifiers [:named word]]
      (key-angle? token)
        (let ([inner-modifiers inner] (key-peel-modifiers (string/substring token
                                                            1
                                                            (dec (string/length token)))
                                        modifiers)
              name (key-named-base inner))
          (if (nil? name)
            (failure "key-parse: no such key: " token)
            [inner-modifiers [:named name]]))
      (= (count (string/->graphemes token)) 1) [modifiers [:char token]]
      else
        (let (name (key-named-base token))
          (if (nil? name)
            (failure "key-parse: not a key (one key per word, a named key as <name>): " token)
            [modifiers [:named name]])))))

(defn- key-case (glyph upper?)
  "`glyph` upper- or lower-cased, kept as it is when its other case is not one character
(`ß` upper-cases to `SS`) — the frontends' rule."
  (let (cased (if upper? (string/upper glyph) (string/lower glyph)))
    (if (= (count (string/->graphemes cased)) 1) cased glyph)))

(defn- key-chord-prefix (modifiers)
  "The Ctrl / Meta part of a key's name for the set `modifiers`."
  (let (ctrl (contains? modifiers :ctrl)
        meta (contains? modifiers :meta))
    (cond
      (and ctrl meta) "ctrl-meta-"
      ctrl "ctrl-"
      meta "alt-"
      else "")))

(defn- key-build (modifiers base)
  "The key the frontends deliver for `base` under `modifiers` (`character_chord` /
`named_key`). A character chord folds Shift into the glyph — Ctrl lower-cases it, otherwise
Shift upper-cases it and a written capital stays one (`M-O` is Alt+Shift+o) — and a named
key spells Shift in its name; Shift+Tab is `:back-tab`."
  (let ([kind name] base
        ctrl (contains? modifiers :ctrl)
        super (contains? modifiers :super)
        shift (contains? modifiers :shift)
        prefix (key-chord-prefix modifiers))
    (cond
      (= kind :named)
        (if (and (= name "tab") (= modifiers #{:shift}))
          :back-tab (keyword (str prefix (if shift "shift-" "") (if super "super-" "") name)))
      (or ctrl super (contains? modifiers :meta))
        (keyword (str prefix
                   (if super "super-" "")
                   (cond
                     ctrl (key-case name false)
                     shift (key-case name true)
                     else name)))
      shift (key-case name true)
      else name)))

(defn- key-parse-one (token)
  "One written key → the key, or a failure."
  (let ([modifiers unmodified] (key-peel-modifiers token #{})
        parsed (key-base unmodified modifiers))
    (if (failure? parsed)
      parsed
      (let ([all-modifiers base] parsed) (key-build all-modifiers base)))))

(defn- key-parse-words (words)
  "The keys `words` name, in order, or the first word's failure."
  (fold words
    []
    (fn (keys word)
      (if (failure? keys)
        keys
        (let (key (key-parse-one word)) (if (failure? key) key (conj keys key)))))))

(defn key-parse (text)
  "The key SEQUENCE an Emacs key description names — Emacs's `kbd` / `key-parse`: a vector
of the keys [[keymap-bind]] binds, or a `failure` naming the word that is not a key.

One key per space-separated word: modifiers `C-` `M-` `S-` `s-` (Ctrl, Meta, Shift, Super)
before a character (`C-x`, `M-%`, `C-M-$`), Emacs's words `RET` `TAB` `SPC` `ESC` `DEL`, and
a named key in angle brackets (`<f5>`, `<return>`, `<prior>`, `C-<left>`). Every spelling
[[key-description]] writes reads back to the same key, so whatever help shows for a key can
be pasted into a binding.

    (editor/keymap/key-parse \"C-x C-f\")   ;=> [:ctrl-x :ctrl-f]
    (editor/keymap/key-parse \"C-c t f\")   ;=> [:ctrl-c \"t\" \"f\"]
    (editor/keymap/key-parse \"C-M-<return>\")   ;=> [:ctrl-meta-enter]
    (editor/keymap/key-parse \"C-x RET\")   ;=> [:ctrl-x :enter]
    (editor/keymap/key-parse \"S-TAB\")   ;=> [:back-tab]
    (error-message (editor/keymap/key-parse \"C-x foo\"))   ;=> \"key-parse: not a key (one key per word, a named key as <name>): foo\""
  (let (words (if (string? text) (string/fields text) nil))
    (if (empty? words)
      (failure "key-parse: not a key sequence: " (if (string? text) (str "\"" text "\"") text))
      (key-parse-words words))))
