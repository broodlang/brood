;; std/editor/highlight.blsp — lexical syntax highlighting + bracket/call analysis.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - Pure data → data, no IO and no kernel surface (the analogue of
;;    `observe-frame`): every function takes a source string and returns spans /
;;    chunks / positions. That makes the whole module unit-testable without a
;;    terminal — `std/editor/lineedit.blsp` is the only piece that touches `term-*`.
;;  - Lexical, not semantic: this is a tree-sitter-style *highlighter*, not the
;;    type checker. It classifies tokens by shape + head-position (the first
;;    symbol after a `(` is a call/special-form), not by resolving what a name
;;    binds to. Cheap, robust on incomplete input, and written in Brood (ADR-006).
;;  - The faces are `display.blsp`-style maps (`{:fg :cyan}` …) so they feed
;;    straight into a `[:print str face]` op for `term/emit`. They're registered as
;;    `:syntax/*` faces in the shared registry (`std/editor/face.blsp`) and resolved
;;    live per span, so an app restyles the whole highlighter by redefining one face
;;    — see the faces section below.

; syntax faces live in the :syntax/* face registry, resolved live
(defmodule editor/highlight
  "Lexical syntax highlighting and bracket / call-site analysis for Brood source,
as pure functions over a source string (ADR-052):

  - `(highlight-spans src)` — `[start end face]` colour spans for the tokens.
  - `(highlight-window slice base)` — `highlight-spans` for a windowed `slice`, with
    every span shifted into the larger source's absolute coordinates by `base`.
  - `(safe-restart src pos)` — a top-level form start ≤ `pos` to (re)start lexing from,
    so a viewport can be fontified without lexing the whole buffer.
  - `(highlight-chunks full base line overrides)` — `[substring face]` chunks that
    tile a visible line (with caller `overrides`, e.g. bracket-match colours).
  - `(face-at spans pos)` / `(ranges-face ranges pos)` / `(fontify-runs text base spans ranges)`
    — the shared span→runs tiler: look up a span's face, merge an overlay `ranges`
    channel, and coalesce `text` into `[substring face]` runs (renderers turn each
    run into its own output — display ops, HTML, …).
  - `(bracket-match full pos)` — the bracket pair adjacent to cursor `pos`.
  - `(enclosing-call full pos)` — `[callee arg-index]` for the call enclosing the cursor.
  - `(symbol-prefix-at full pos)` / `(common-prefix strs)` — completion helpers.

Used by `std/editor/lineedit.blsp` (the REPL editor); pure, so independently testable."
  (:use editor/face))
;; Resolved snapshots of the defaults, kept under the original `hl-face-*` names for
;; consumers that read a face directly rather than re-resolving each frame: the REPL
;; line editor's bracket match/error (`std/editor/lineedit.blsp`) and the highlighter's own
;; tests. The live fontify path (`hl-walk`) instead calls `(face :syntax/…)` per
;; span, so an app's `face-set :syntax/…` restyles the editor on its next frame while
;; these snapshots (and so the default REPL look) stay put.
(def hl-face-comment (face :syntax/comment))
(def hl-face-string (face :syntax/string))
(def hl-face-doc (face :syntax/doc))
(def hl-face-number (face :syntax/number))
(def hl-face-keyword (face :syntax/keyword))
(def hl-face-symbol (face :syntax/symbol))
(def hl-face-constant (face :syntax/constant))
(def hl-face-special (face :syntax/special))
(def hl-face-function (face :syntax/function))
(def hl-face-definition (face :syntax/definition))
(def hl-face-match (face :syntax/match))
(def hl-face-error (face :syntax/error))

;; The names that highlight as a *keyword* (special forms + core macros). Read once
;; from the `(reflect/special-forms)` primitive — the canonical Rust `SPECIAL_FORMS`, shared
;; with the LSP — so this can't drift from the runtime / tooling (ADR-052).
(def- hl-special-forms (reflect/special-forms))
;; As a SET (map → true) so `special-form?` is an O(1) hash lookup, not an O(n) list
;; scan: it runs on every head-position atom on the fontify hot path.
(def- hl-special-set (fold hl-special-forms {} (fn (m s) (assoc m s true))))

(defn special-form? (s)
  "True if string `s` names a Brood special form / core macro that should highlight
as a keyword. Mirrors the LSP's SPECIAL_FORMS list.

    (editor/highlight/special-form? \"let\")   ;=> true
    (editor/highlight/special-form? \"foo\")   ;=> false"
  (= true (get hl-special-set s)))

;; The `def…` heads that carry a docstring, head -> `:fn` / `:head`. Read from the
;; kernel's canonical `(reflect/doc-forms)` — the same list the LSP's semantic tokens and the
;; generated VS Code / tree-sitter / Emacs grammars use — so "is this string a doc?"
;; has one answer across every editor (ADR-265).
(def- hl-doc-forms (reflect/doc-forms))

(defn doc-form? (s)
  "True if string `s` names a `def…` head whose form carries a docstring. Mirrors the
LSP's DOC_FORMS list.

    (editor/highlight/doc-form? \"defn\")   ;=> true
    (editor/highlight/doc-form? \"let\")    ;=> false"
  (not (nil? (get hl-doc-forms s))))

;; ---- character classes ------------------------------------------------------

(defn- hl-ws? (c)
  (or (= c " ") (= c "\t") (= c "\n") (= c "\r") (= c ",")))
(defn- hl-open? (c) (or (= c "(") (= c "[") (= c "{")))
(defn- hl-close? (c) (or (= c ")") (= c "]") (= c "}")))
(defn- hl-bracket? (c) (or (hl-open? c) (hl-close? c)))
(defn- hl-delim? (c)
  (or (hl-ws? c) (hl-bracket? c) (= c "\"") (= c ";")))

(defn- hl-number? (tok)
  "True if `tok` reads as a number (so it colours as one rather than a symbol). Asks the
native `scan-tokens` — the reader's own classification — rather than `string/->number`,
which reads DATA and by design refuses the shapes only source has: a radix literal
(`0xFF`), a ratio (`1/2`), an `M`-decimal (`1.50M`). One classifier, so the callee test
here and the face the fontifier paints cannot disagree (ADR-334)."
  (let (toks (reflect/scan-tokens tok))
    (and (= (count toks) 1) (= (nth (first toks) 2) :number))))

;; ---- scanning primitives (shared by lexer + matchers) -----------------------

;; The inner scans run on the native `string-span-until` char-class scanner (O(run) in
;; Rust) rather than per-char Brood recursion — these feed the bracket/call matchers,
;; which are on the render hot path. The delimiter set mirrors `hl-delim?`.
(def- hl-delim-chars " \t\n\r,()[]{}\";")

(defn- hl-to-eol (src:string i:int n:int -> int)
  "Index of the newline ending the line containing `i` (or `n` at end of input)."
  (math/min n (string/span-until src i "\n")))

; backslash: skip it and the escaped char
(defn- hl-string-close (src:string i:int n:int -> int)
  "Index just past the closing quote of a string whose body starts at `i` (one past
the opening quote), honouring `\\` escapes; -1 if the string is unterminated — a backslash
ending the text included, whose escaped character is not there (`\"a\\` at a line's end)."
  (let (j (if (>= i n) n (string/span-until src i "\\\"")))
    ; first backslash or quote (or end)
    (cond
      (>= j n) -1
      (= (string/char-at src j) "\"") (inc j)
      else (hl-string-close src (+ j 2) n))))

(defn- hl-string-end (src:string i:int n:int -> int)
  "Like `hl-string-close`, but `n` if the string is unterminated."
  (let (close (hl-string-close src i n)) (if (< close 0) n close)))
(defn- hl-atom-end (src:string i:int n:int -> int)
  "Index of the first delimiter at or after `i` — the end of an atom token."
  (math/min n (string/span-until src i hl-delim-chars)))

;; ---- the lexer: source -> colour spans --------------------------------------

;; `nil` / `true` / `false` colour as keyword-like literals (the LSP's T_KEYWORD),
;; regardless of position — so `(nil? x)` shows `nil` as a constant, not a call head.
;; (The native `scan-tokens` classifies those, and `:`-prefixed names, as `:keyword`.)

;; A `:keyword` / `:number` / `:comment` token paints in the `:syntax/*` face of its
;; own kind — the position-independent kinds; `:symbol` and `:string` are resolved by
;; position (head: special form vs call vs plain; doc position: doc vs. string value),
;; and `:open`/`:close` carry the punctuation face only when it paints (or a rainbow
;; depth face). The faces are resolved once per lexing pass
;; (`hl-faces`), so a live restyle of `:syntax/*` takes effect on the next re-lex.

;; ---- the form stack ---------------------------------------------------------
;; The lexer carries one frame per open bracket: `[open n head params?]` — the
;; bracket's text (only `(` opens head position), how many forms of this list have
;; STARTED, the head symbol's text (nil until seen), and whether the form at index 2
;; was itself a bracketed list (a parameter list). The old walk carried a single
;; `after` boolean, which answers "is this symbol a call head?" but not "is this
;; string a docstring?" — that one is positional (`(defn f (x) "doc" …)` documents,
;; `(defn f (x) "hi")` returns), so it needs the head and the index, not just a flag.

(defn- hl-push (stack open)
  "Open a frame for the bracket `open`."
  (cons [open 0 nil false] stack))

;; Past its third form nothing reads a frame's count, head or parameter flag (head position
;; is form 0, a docstring form 2 or 3), so a frame that far in is stored as ONE value
;; (`hl-frame`). The line lexer compares the states its lines start in to stop re-lexing after
;; an edit; with the count kept, adding a form anywhere in a long body changed the state of
;; every line after it until the body closed.
(defn- hl-frame (open n head params?)
  (if (> n 3) [open 4 nil false] [open n head params?]))

(defn- hl-advance (stack params?)
  "Advance the innermost frame past one started form; `params?` marks that form as a
bracketed list sitting in parameter position (index 2)."
  (if (empty? stack)
    stack
    (let ([open n head p] (first stack))
      (cons (hl-frame open (inc n) head (or p (and params? (= n 2)))) (rest stack)))))

(defn- hl-name (stack text)
  "Advance past a symbol, recording it as the list's head when it is the first form."
  (if (empty? stack)
    stack
    (let ([open n head p] (first stack))
      (cons (hl-frame open (inc n) (if (and (= n 0) (= open "(")) text head) p) (rest stack)))))

(defn- hl-head? (stack)
  "True when the form starting here is in HEAD position — the first form of a `(` list."
  (and (not (empty? stack))
    (let ([open n _ _] (first stack)) (and (= open "(") (= n 0)))))

(defn- hl-more-forms? (toks open-end?)
  "True if another form follows in the current list — the next non-comment token is
not this list's closing bracket. When the stream runs out first, `open-end?`: true when
the stream is one LINE and the list may go on below it."
  (cond
    (empty? toks) open-end?
    else
      (let ([_ _ kind _] (first toks))
        (cond
          (= kind :comment) (hl-more-forms? (rest toks) open-end?)
          else (not (= kind :close))))))

(defn- hl-doc? (stack toks open-end?)
  "True when the string token starting here is a DOCSTRING rather than a string value:
the enclosing form is a doc-carrying `def…` head (`(reflect/doc-forms)`), the string sits right
after the name — or after the parameter list — and, for the heads that build a function,
more body follows it (a function whose body is a lone string returns that string, which
is why `\"hello mylife\"` in `(defn greeting () \"Doc.\" \"hello mylife\")` stays a
string). `toks` is the stream AFTER the string."
  (and (not (empty? stack))
    (let ([open n head params?] (first stack)
          kind (get hl-doc-forms head))
      (and (= open "(")
        (not (nil? kind))
        (or (= n 2) (and (= n 3) params?))
        (or (= kind :head) (hl-more-forms? toks open-end?))))))

;; ---- the lexer walk ---------------------------------------------------------

(defn- hl-painted (name)
  ;; face `name` resolved, or nil when it has no attributes — a face that would paint
  ;; nothing costs no span
  (let (resolved (face name)) (if (or (nil? resolved) (empty? resolved)) nil resolved)))

(defn- hl-faces ()
  "The `:syntax/*` faces a lexing pass paints with, resolved ONCE per pass — a map
from token kind (`:comment` `:number` `:keyword` `:string` `:doc` `:special`
`:function` `:definition` `:punctuation`) to the attribute map — the `:keyword` token kind
(`:foo`, `nil`, `true`, `false`) paints `:syntax/symbol` (ADR-616); `:punctuation` is nil
when that face is empty (the default), so the brackets are left unpainted. Resolving
per span cost the inherit-chain walk per coloured token, a third of the pass on a
100-line band; per pass, a live `face-set` of a `:syntax/*` face still restyles the
editor on its next re-lex."
  {:comment (face :syntax/comment)
   :number (face :syntax/number)
   :keyword (face :syntax/symbol)
   :string (face :syntax/string)
   :doc (face :syntax/doc)
   :special (face :syntax/special)
   :function (face :syntax/function)
   :definition (face :syntax/definition)
   :punctuation (hl-painted :syntax/punctuation)})

(defn- hl-bracket (acc pass start end depth)
  ;; `acc` with the bracket at `[start, end)` painted: in the face of `depth` (0 the
  ;; outermost) when the pass paints a rainbow (`:rainbow`, the resolved depth faces), else
  ;; in the punctuation face when it has one, else `acc`
  (let (rainbow (:rainbow pass)
        punctuation (get (:faces pass) :punctuation))
    (cond
      (not (nil? rainbow)) (cons [start end (nth rainbow (math/mod depth (count rainbow)))] acc)
      (nil? punctuation) acc
      else (cons [start end punctuation] acc))))

;; ---- definitions: the name a `def…` form binds (ADR-614) -----------------------
;; A DEFINER is a `def…` head the pass's special-form set holds — Brood's `defn` / `def` /
;; `defmacro` / `defmodule`, elisp's `defun` / `defvar`, Clojure's `defn`, Scheme's `define` —
;; or a docstring-carrying one (`defn-`), or the private `-` form of one the set holds (`def-`);
;; the symbol right after it is the name it defines. Scheme's
;; `(define (f x) …)` puts the name at the head of the list in that place, so a list opened
;; there is pushed with the `:definition` marker as its head until its own head is read.

(defn- hl-definer? (head pass)
  ;; a `def…` head the special-form set holds, or a doc-carrying one (`defn-`, `defserver`),
  ;; or the private `-` form of one the set holds (`def-`)
  (and (string? head)
    (string/starts-with? head "def")
    (let (specials (:specials pass))
      (or (= true (get specials head))
        (doc-form? head)
        (and (string/ends-with? head "-")
          (= true (get specials (string/substring head 0 (dec (string/length head))))))))))

(defn- hl-name-place? (stack pass)
  "True when the form starting here is the NAME place of a definer: the second form of a
`(` list whose head defines."
  (and (not (empty? stack))
    (let ([open n head _] (first stack)) (and (= open "(") (= n 1) (hl-definer? head pass)))))

(defn- hl-defining-list? (stack)
  ;; the innermost frame is a list opened in a definer's name place, its head not yet read
  (and (not (empty? stack)) (= (nth (first stack) 2) :definition)))

(defn- hl-walk (toks stack acc pass)
  "Walk the `scan-tokens` stream into `[start end face]` colour spans, carrying the
form `stack` (head position, and enough shape to tell a docstring from a string).
`:symbol` needs position — head + special form → keyword face, head → call face, the name
place of a `def…` head → definition face, else uncoloured — and `:string` needs it too (doc
vs. value). `pass` is what the walk does not
change: `:faces` (the resolved `hl-faces`), `:specials`, and `:open-end?` (the stream is one
line of a longer source, see `hl-more-forms?`). Returns `[spans stack]`, the spans in
REVERSE and the stack the stream ended with."
  (if (empty? toks)
    [acc stack]
    (let ([s e kind text] (first toks)
          more (rest toks)
          faces (:faces pass))
      (cond
        ;; with a rainbow, a bracket takes its depth's face: an opener the depth it opens, a
        ;; closer the depth it closes, so a pair is one colour; without one, the punctuation
        ;; face when it paints anything. A list opened in a definer's name place (Scheme's
        ;; `(define (f x) …)`) is marked, so its head reads as the name.
        (= kind :open)
          (hl-walk more
            (let (pushed (hl-push (hl-advance stack true) text))
              (if (and (= text "(") (hl-name-place? stack pass))
                (cons ["(" 0 :definition false] (rest pushed))
                pushed))
            (hl-bracket acc pass s e (count stack))
            pass)
        (= kind :close)
          (hl-walk more
            (rest stack)
            (hl-bracket acc pass s e (math/max 0 (dec (count stack))))
            pass)
        ; a comment starts no form — the stack is untouched
        (= kind :comment) (hl-walk more stack (cons [s e (get faces :comment)] acc) pass)
        (= kind :symbol)
          (let (head? (hl-head? stack)
                f (cond
                    (and head? (= true (get (:specials pass) text))) (get faces :special)
                    (and head? (hl-defining-list? stack)) (get faces :definition)
                    head? (get faces :function)
                    (hl-name-place? stack pass) (get faces :definition)
                    else nil))
            (hl-walk more (hl-name stack text) (if (nil? f) acc (cons [s e f] acc)) pass))
        (= kind :string)
          (let (f (if (hl-doc? stack more (:open-end? pass)) (get faces :doc) (get faces :string)))
            (hl-walk more (hl-advance stack false) (cons [s e f] acc) pass))
        else
          (let (f (get faces kind))
            ; :number / :keyword
            (hl-walk more (hl-advance stack false) (if (nil? f) acc (cons [s e f] acc)) pass))))))

(defn highlight-spans (src &optional (specials hl-special-set))
  "Lexically tokenize Lisp `src` into a list of `[start end face]` colour spans
(character offsets, end-exclusive) for the tokens that carry a colour — comments,
strings (a `def…` form's docstring apart from a string value), numbers, keywords, and
head-position symbols (special forms vs calls), and the name a `def…` form binds
(`:syntax/definition`, ADR-614) — plus every bracket when `:syntax/punctuation` paints
anything (by default it does not).
Whitespace and plain variable references carry no span (the default colour). The
per-character scan is the native `scan-tokens`; this only assigns faces over the token
stream (O(tokens)), so it stays fast enough for per-frame fontification.

`specials` is the SET of head symbols that colour as keywords rather than as calls —
`{\"defun\" true …}` — and defaults to Brood's. Everything else this does is true of any
s-expression language: parens, `;` comments, `\"` strings, numbers. Passing another
dialect's set is therefore the whole of teaching it to colour, which is what an elisp or
Scheme mode needs and all it needs.

    (editor/highlight/highlight-spans \"x ; hi\")    ;=> ([2 6 {:fg :dark-grey}])
    (editor/highlight/highlight-spans \"(let x)\")   ;=> ([1 4 {:fg :blue, :bold true}])"
  (let ([spans _] (hl-walk (reflect/scan-tokens src)
                    '()
                    '()
                    {:faces (hl-faces) :specials specials :open-end? false}))
    (reverse spans)))
(sig highlight-spans (string -> any))

;; ---- windowed highlighting (fontify just a viewport) ------------------------
;; A large buffer is too costly to lex whole every frame. The editor instead lexes
;; only a slice — the visible lines plus a `safe-restart` lead-in for context — and
;; shifts the spans back into absolute coordinates with `highlight-window`.

(defn shift-spans (spans base)
  "Shift every `[start end face]` span by `base` — maps slice-local offsets into the
absolute coordinates of the larger source the slice came from. The one place windowed
fontification (any lexer's, mode-agnostic) re-bases its spans.

    (editor/highlight/shift-spans [[0 3 :keyword]] 10)   ;=> ([10 13 :keyword])"
  (map spans (fn ([s e f]) [(+ s base) (+ e base) f])))

(defn highlight-window (slice base)
  "Like `highlight-spans`, but for a windowed `slice` that begins at offset `base`
in some larger source: every `[start end face]` span is shifted by `base`, so the
result is in the larger source's absolute coordinates. Lets a viewport fontify only
its visible slice yet hand the renderer absolute offsets; `base` 0 is exactly
`highlight-spans`.

    (editor/highlight/highlight-window \"(let)\" 100)   ;=> ([101 104 {:fg :blue, :bold true}])"
  (shift-spans (highlight-spans slice) base))

(defn safe-restart (src pos)
  "The offset of the nearest *top-level form start* at or before `pos`: a depth-0 open
bracket (`(`/`[`/`{`) that lies OUTSIDE any string or comment, or 0 if there is none. A safe
point to (re)start lexing `src` from — head-position state is known-false there, so a
viewport can be highlighted from here without lexing everything above it (the Brood analogue
of Emacs `beginning-of-defun`). String/comment-aware and bracket-depth-tracked, so a bracket inside a
multi-line docstring is correctly skipped. The awareness needs a forward lexical pass from
the top (a backward scan can't know string state), which is O(pos) — run natively
(`scan-form-start`, the ADR-093 scanner family), because interpreted it stalled eldoc /
fontify-restart multi-second on every idle beat in a large file.

    (editor/highlight/safe-restart \"(a)\\n(b c)\" 7)   ;=> 4"
  (reflect/scan-form-start src pos))

(defn line-restart (src:string pos:int -> int)
  "A line-oriented lexer's `:fontify-restart`: `pos` itself. No token crosses a line (shell,
dotenv, dockerfile, every `editor/lexer` grammar), so lexing may (re)start at any line start
with nothing known-false — the viewport's own first line is a safe point, and the windowed
lead-in above it (an editor's backscan, 200 lines in bedit) is cut entirely instead of
re-lexed on every keystroke. Lives here, beside `safe-restart`, because a mode names its
restart by a SYMBOL resolved at render time: this module is loaded wherever anything is
fontified, where the lexer that happens to colour the buffer may not be.

    (editor/highlight/line-restart \"line one\" 4)   ;=> 4"
  pos)

;; ---- the line-state cache (ADR-471, ADR-483) -----------------------------------
;; A lexer that carries state from line to line (markdown's fenced block, org's #+BEGIN,
;; a heredoc) can only colour line N right if it knows how line N-1 ENDED. Lexing a
;; window with a fixed lead-in guesses at that and re-lexes the lead-in on every
;; keystroke; lexing from the top is exact and costs the whole file. The cache is the
;; third way, Emacs's and every incremental highlighter's: lines keep the state they
;; started in. An edit re-lexes from its first changed line only until a line starts in
;; the state it started in before — from there on, nothing it did can reach — and every
;; other line is reused, moved. A stateless lexer (one rule table, no carry) degenerates
;; to a per-line memo on the line's text.
;;
;; Pure data: the cache is a value the caller keeps (on its model, beside the rope it
;; describes) and threads back in. What it holds is LEAN (ADR-483), because it lives as
;; long as the buffer and is touched on every keystroke:
;;
;;  - No line text. Lines past an edit are unchanged by construction, so nothing needs
;;    their text to know they are the same lines.
;;  - Entries in a TREAP keyed by line, each key stored relative to its parent's. An edit
;;    drops the lines it touched and moves every line after it by re-basing ONE subtree:
;;    O(log n) whatever the edit added or removed, where a vector copied the whole tail.
;;  - Spans only near the windows shown lately (`lc-retained-windows`, each kept with a
;;    margin). Elsewhere a line keeps only its state-in, and only every
;;    `lc-checkpoint-every` lines: a far region shown again is re-lexed from the
;;    checkpoint above it, at most that many lines of lead-in.
;;
;; An entry is `[state-in]` (a checkpoint) or `[state-in spans state-out]` (a shown line,
;; spans line-relative so a line that moved keeps them). Entries at or above `:verified`
;; are exact; those below it are the old lines' entries after an edit whose re-lex has not
;; yet come back in step — TENTATIVE, one chain the next walk confirms or replaces. Line 0
;; always has an entry, so a walk always has somewhere to start.

(def- lc-checkpoint-every 32)
(def- lc-retained-windows 3)

(defn line-lexer (lex &optional (initial nil))
  "A line lexer for `line-cache-update`: `(lex line state)` returns `[spans state-out]` —
the `[start end face]` spans of `line` (its text without the newline, offsets relative to
it) and the state the next line starts in, given the `state` this one starts in. `initial`
is the state of the first line. States are compared with `=`, so keep them small values:
a keyword, a short vector (`[:fence \"```\"]`).

    (:initial (editor/highlight/line-lexer (fn (line state) [[] state]) :text))   ;=> :text"
  {:lex lex :initial initial :stateless? false})

(defn stateless-lexer (spans-of)
  "A line lexer whose lines colour on their own: `(spans-of line)` returns the line's
`[start end face]` spans, line-relative. `line-cache-update` keeps it as a memo on line
text — no state to carry, so no line above the window is ever lexed, and an unchanged
line is never lexed twice. Every `editor/lexer` grammar is one: `lexer-line-lexer`.

    (:stateless? (editor/highlight/stateless-lexer (fn (line) [])))   ;=> true"
  {:lex (fn (line state) [(spans-of line) nil]) :initial nil :stateless? true})

;; ---- the Lisp line lexer ------------------------------------------------------
;; `highlight-spans` over a line at a time, for the line-state cache. What a line hands
;; the next is everything the walk carries: the form stack (head position, docstring
;; position) and, when the line ends inside a string, that string's face. A windowed lex
;; has to guess both from a lead-in (`safe-restart`), and a lead-in that begins inside a
;; multi-line docstring guesses the string state backwards: every `"` after it pairs the
;; wrong way and the code reads as string. Carried, nothing is guessed.

(defn- hl-lex-code (line from n stack acc pass)
  "`[spans state]` for `line` from offset `from` on, outside any string, `acc` holding
the spans before `from` (reversed). A string the line opens and does not close carries
its face into the state."
  (let (toks (if (= from 0)
               (reflect/scan-tokens line)
               (map (reflect/scan-tokens (string/substring line from n))
                 (fn ([s e kind text]) [(+ s from) (+ e from) kind text])))
        [spans stack-out] (hl-walk toks stack acc pass)
        final (last toks)
        ;; a token's start is an int (scan-tokens' offsets, shifted by an int); the guard says so
        start (when final (first final))
        open? (and (int? start)
                (= (nth final 2) :string)
                (< (hl-string-close line (inc start) n) 0)))
    [(reverse spans) [stack-out (when open? (nth (first spans) 2))]]))

(defn- hl-lex-line (line state pass)
  (let ([stack string-face] state
        n (string/length line))
    (if (nil? string-face)
      (hl-lex-code line 0 n stack '() pass)
      (let (close (hl-string-close line 0 n))
        (cond
          (= n 0) ['() state]
          (< close 0) [(list [0 n string-face]) state]
          else (hl-lex-code line close n stack (list [0 close string-face]) pass))))))

(defn lisp-line-lexer (&optional (specials nil) (options {}))
  "`highlight-spans` as a `line-lexer`: a line's spans are what lexing the whole source
gives it, because each line starts in the state the line above ended in — the open forms
and, inside a multi-line string, that string's face. For `line-cache-update`, where a
windowed `highlight-spans` would need a `safe-restart` lead-in and the lead-in can begin
inside a docstring. `specials` is the head-symbol set, as for `highlight-spans` (nil for
Brood's). `options` takes `:rainbow` — true colours each bracket by its depth in the
`:syntax/delimiter-1` … `-9` faces (Emacs's rainbow-delimiters), exact across lines because
the depth is the stack the lines carry. The faces are resolved when the lexer is built.

One case reads differently: a string in a docstring's position that ends its line, with the
form's next form (or its close) on a later line, is a docstring here — every line of it, when
it runs over several — because the line cannot see whether the body goes on, where the
whole-source lex calls a lone last body string a value.

    (first ((:lex (editor/highlight/lisp-line-lexer)) \"doc.\\\" 1)\" [nil {:fg :grey :italic true}]))   ;=> ([0 5 {:fg :grey, :italic true}] [6 7 {:fg :yellow}])"
  (let (pass {:faces (hl-faces)
              :specials (or specials hl-special-set)
              :open-end? true
              :rainbow (when (:rainbow options)
                         (vec (map (range 1 10)
                                (fn (depth) (face (keyword (str "syntax/delimiter-" depth)))))))})
    (line-lexer (fn (line state) (hl-lex-line line state pass)) [nil nil])))

(defn line-cache ()
  "An empty line-state cache: what `line-cache-update` takes the first time, and what a
caller starts again from when the lexer changes (a new mode) — one cache serves one lexer.

    (:rope (editor/highlight/line-cache))   ;=> nil"
  {:rope nil :tree nil :verified nil :windows '() :memo {}})

;; ---- the line table: a treap with relative keys ----------------------------------
;; A node is `[left key value right priority]`; `key` is relative to the parent node's
;; absolute line (the root's to 0), so adding to a root's key moves its whole subtree.
;; Split and join return trees whose root key is absolute. The depth is O(log n) expected,
;; and the recursion below goes no deeper than the tree.

(defn- lc-node (left key value right priority) [left key value right priority])

(defn- lc-rebase (node delta)
  (if (nil? node) nil (assoc node 1 (+ (nth node 1) delta))))

(defn- lc-priority (line)
  ;; a spread of the line number (the treap's balance needs priorities that look random,
  ;; and a hash of the line is as good as random and keeps the cache a pure value)
  (%hash [line :line-cache]))

(check-allow :non-tail-recursion
  (defn- lc-split (node base line)
    "`[below rest]`: `node`'s entries (its key relative to `base`) before `line`, and from
`line` on."
    (if (nil? node)
      [nil nil]
      (let (at (+ base (nth node 1)))
        (if (< at line)
          (let ([below rest] (lc-split (nth node 3) at line))
            [(lc-node (nth node 0) at (nth node 2) (lc-rebase below (- at)) (nth node 4)) rest])
          (let ([below rest] (lc-split (nth node 0) at line))
            [below (lc-node (lc-rebase rest (- at)) at (nth node 2) (nth node 3) (nth node 4))]))))))

(check-allow :non-tail-recursion
  (defn- lc-join (low high)
    "One tree of `low` and `high`, every key of `low` before every key of `high`."
    (cond
      (nil? low) high
      (nil? high) low
      (> (nth low 4) (nth high 4))
        (let (at (nth low 1))
          (assoc low 3 (lc-rebase (lc-join (lc-rebase (nth low 3) at) high) (- at))))
      else
        (let (at (nth high 1))
          (assoc high 0 (lc-rebase (lc-join low (lc-rebase (nth high 0) at)) (- at)))))))

(defn- lc-get (node base line)
  (if (nil? node)
    nil
    (let (at (+ base (nth node 1)))
      (cond
        (= at line) (nth node 2)
        (< line at) (lc-get (nth node 0) at line)
        else (lc-get (nth node 3) at line)))))

(defn- lc-floor (node base line best)
  "`[key value]` of the last entry at or before `line`, else `best`."
  (if (nil? node)
    best
    (let (at (+ base (nth node 1)))
      (cond
        (= at line) [at (nth node 2)]
        (< line at) (lc-floor (nth node 0) at line best)
        else (lc-floor (nth node 3) at line [at (nth node 2)])))))

(defn- lc-last-key (node base best)
  (if (nil? node) best (let (at (+ base (nth node 1))) (lc-last-key (nth node 3) at at))))

(defn- lc-drop (tree from to)
  "`tree` without its entries in `[from, to)`."
  (let ([below rest] (lc-split tree 0 from)
        [_ above] (lc-split rest 0 to))
    (lc-join below above)))

(defn- lc-put (tree line value)
  (let ([below rest] (lc-split tree 0 line)
        [_ above] (lc-split rest 0 (inc line)))
    (lc-join (lc-join below (lc-node nil line value nil (lc-priority line))) above)))

(defn- lc-shift (tree from delta)
  "`tree` with every entry from `from` on moved by `delta` lines — one re-based subtree."
  (let ([below rest] (lc-split tree 0 from))
    (lc-join below (lc-rebase rest delta))))

(check-allow :non-tail-recursion
  (defn- lc-entries (node base from to acc)
    "The `[key value]` entries in `[from, to)`, in line order, before `acc`."
    (if (nil? node)
      acc
      (let (at (+ base (nth node 1))
            with-right (if (< (inc at) to) (lc-entries (nth node 3) at from to acc) acc)
            with-node (if (and (<= from at) (< at to))
                        (cons [at (nth node 2)] with-right)
                        with-right))
        (if (< from at) (lc-entries (nth node 0) at from to with-node) with-node)))))

;; ---- an edit, and the walk that colours a window -----------------------------------

(defn- lc-line-text (rope i)
  "Line `i` of `rope` without its newline — what a line lexer sees."
  (let (s (text/line rope i))
    (if (string/ends-with? s "\n") (string/substring s 0 (dec (string/length s))) s)))

(defn- lc-move-line (line first-line old-last new-last)
  ;; where a remembered window edge lands after an edit — only the eviction reads it, so
  ;; a line inside the edit going to its end is close enough
  (if (> line old-last) (+ line (- new-last old-last)) (math/min line (inc new-last))))

(defn- lc-edited (cache rope given)
  "`cache` moved onto `rope`, which differs from the cache's rope by `given` (`[start old-end
new-end]`, as `text/changed-range` answers) when the caller knows it, else by what a compare finds. The lines the edit touched lose their entries — except the
first, whose state-in no edit at or below it can change — and the lines after it are
re-based, now tentative. A walk not yet back in step from an earlier edit leaves one
tentative chain already; the entries between the two seams go too, so there is only ever
one chain to confirm."
  (let (old (:rope cache)
        change (if (nil? given) (text/changed-range old rope) given))
    (if (nil? change)
      (assoc cache :rope rope)
      (let ([start old-end new-end] change
            first-line (text/char->line rope start)
            old-last (text/char->line old old-end)
            new-last (text/char->line rope new-end)
            verified (:verified cache)
            seam (if (nil? verified) first-line (math/min first-line verified))
            dropped-to (if (nil? verified) old-last (math/max old-last verified))
            tree (:tree cache)
            at-first (lc-get tree 0 first-line)
            kept (if (and at-first (= seam first-line))
                   (lc-put tree first-line [(first at-first)])
                   tree)
            moved (lc-shift (lc-drop kept (inc seam) (inc dropped-to))
                    (inc dropped-to)
                    (- new-last old-last))
            from (first (lc-floor moved 0 seam [0 nil])))
        (assoc cache
          :rope rope
          :tree moved
          :verified (when (> (lc-last-key moved 0 0) from) from)
          :windows
            (map (:windows cache)
              (fn ([lo hi])
                [(lc-move-line lo first-line old-last new-last)
                  (lc-move-line hi first-line old-last new-last)])))))))

(defn- lc-walk-end (cache i state acc)
  "The walk stopped at line `i`, in `state`: a walk that got past the tentative seam
leaves a checkpoint there, so the next one resumes rather than starting over — or, when
the old entry there agrees, there is no seam left at all."
  (let (verified (:verified cache))
    (if (and (not (nil? verified)) (> i verified))
      (let (entry (lc-get (:tree cache) 0 i))
        (if (and entry (= (first entry) state))
          [(assoc cache :verified nil) acc]
          [(assoc cache :tree (lc-put (:tree cache) i [state]) :verified i) acc]))
      [cache acc])))

(defn- lc-walk (cache job i state last-key acc)
  "Colour on from line `i`, which starts in `state` (exact), to the window's end: reuse a
shown line whose state-in agrees, lex any other; keep a shown line's spans, and a
checkpoint every `lc-checkpoint-every` lines above the window. `last-key` is the last line
at or before `i` with an entry; `acc` the window's absolute spans so far, last first."
  (let (lo (:lo job)
        tree (:tree cache)
        verified (:verified cache)
        tentative? (and (not (nil? verified)) (> i verified)))
    (if (>= i (:hi job))
      (lc-walk-end cache i state acc)
      (let (entry (lc-get tree 0 i))
        (if (and tentative? entry (= (first entry) state))
          ;; back in step: the old chain is true from here on, and a line above the window
          ;; jumps to the window's own checkpoint
          (let (exact (assoc cache :verified nil))
            (if (< i lo) (lc-start exact job acc) (lc-walk exact job i state i acc)))
          (let (reuse? (and entry (= (count entry) 3) (= (first entry) state))
                [spans out] (if reuse?
                              [(nth entry 1) (nth entry 2)]
                              ((:lex job) (lc-line-text (:rope job) i) state))
                shown? (>= i lo)
                write (cond
                        reuse? nil
                        shown? [state spans out]
                        (and entry (not (= (first entry) state))) [state]
                        entry nil
                        (>= (- i last-key) lc-checkpoint-every) [state]
                        else nil)
                next-acc (if shown?
                           (let (base (text/line->char (:rope job) i))
                             (fold spans acc (fn (a [s e f]) (cons [(+ base s) (+ base e) f] a))))
                           acc))
            (lc-walk (if write (assoc cache :tree (lc-put tree i write)) cache)
              job
              (inc i)
              out
              (if (or entry write) i last-key)
              next-acc)))))))

(defn- lc-start (cache job acc)
  "Walk from the entry at or above the window — or from the seam, when that entry is
below it and so not yet known to be true."
  (let (tree (:tree cache)
        verified (:verified cache)
        [key entry] (lc-floor tree 0 (:lo job) [0 nil])
        from (if (and (not (nil? verified)) (> key verified)) verified key))
    (lc-walk cache job from (first (lc-get tree 0 from)) from acc)))

(defn- lc-covered? (windows line)
  (any? windows (fn ([lo hi]) (and (<= lo line) (< line hi)))))

(defn- lc-evict-range (cache from to)
  "Lines `[from, to)` no window keeps any more: a shown line's spans go, its state-in
stays every `lc-checkpoint-every` lines, and the lines between lose their entries."
  (let (windows (:windows cache)
        verified (:verified cache)
        tree (:tree cache)
        [before _] (lc-floor tree 0 (dec from) [0 nil])
        [evicted _] (fold (lc-entries tree 0 from to '())
                      [tree before]
                      (fn ([t kept] [key entry])
                        (cond
                          (or (= (count entry) 1) (lc-covered? windows key)) [t key]
                          (or (= key 0) (= key verified) (>= (- key kept) lc-checkpoint-every))
                            [(lc-put t key [(first entry)]) key]
                          else [(lc-drop t key (inc key)) kept]))))
    (assoc cache :tree evicted)))

(defn- lc-retain (cache lo hi)
  "Remember window `[lo, hi)` among the lately shown, and evict what fell out: a window
near the latest one grows it (so scrolling evicts the rows scrolled away, one at a time),
clamped to a margin of the window's height either side; a far one is a new window, and
the oldest past `lc-retained-windows` goes."
  (let (windows (:windows cache)
        margin (math/max lc-checkpoint-every (- hi lo))
        reach-lo (- lo margin)
        reach-hi (+ hi margin)
        latest (first windows))
    (if (and latest (<= (first latest) reach-hi) (>= (second latest) reach-lo))
      (let (merged [(math/max reach-lo (math/min (first latest) lo))
                     (math/min reach-hi (math/max (second latest) hi))]
            kept (assoc cache :windows (cons merged (rest windows))))
        (fold [[(first latest) (first merged)] [(second merged) (second latest)]]
          kept
          (fn (c [from to]) (if (< from to) (lc-evict-range c from to) c))))
      (let (all (cons [lo hi] windows)
            kept (assoc cache :windows (take all lc-retained-windows)))
        (fold (drop all lc-retained-windows)
          kept
          (fn (c [from to]) (if (< from to) (lc-evict-range c from to) c)))))))

(defn- lc-stateless (cache lexer rope lo hi)
  "The stateless path: lines `[lo, hi)` through the memo, which keeps exactly them."
  (let (lines (range lo (math/min hi (text/line-count rope)))
        memo (:memo cache)
        lex (:lex lexer)
        entries (map lines
                  (fn (i)
                    (let (text (lc-line-text rope i)
                          spans (get memo text))
                      [i text (if (nil? spans) (first (lex text nil)) spans)])))
        next-memo (fold entries {} (fn (m [_ text spans]) (assoc m text spans)))
        spans (fold entries
                '()
                (fn (acc [i _ line-spans])
                  (let (base (text/line->char rope i))
                    (fold line-spans acc (fn (a [s e f]) (cons [(+ base s) (+ base e) f] a)))))))
    [(assoc (line-cache) :rope rope :memo next-memo) (reverse spans)]))

(defn line-cache-update (cache lexer rope lo hi &optional (change nil))
  "`[cache' spans]`: the absolute `[start end face]` spans of lines `[lo, hi)` of `rope`,
coloured by `lexer` (`line-lexer` / `stateless-lexer`), and the cache to pass next time.
`cache` is the previous result's (`line-cache` at first), for any earlier rope: an edit
is found with `text/changed-range`, and only the lines from the first one it touched are
lexed again — up to the first that starts in the state it started in before, after which
the old lines are reused, moved. A stateful lexer is exact at any depth; what it keeps is
bounded — spans near the last few windows, a state every few dozen lines elsewhere — and
what an edit costs does not grow with how much of the document was ever shown. A
stateless one lexes only `[lo, hi)`, and of those only the lines whose text it has not
just seen.

`change`, when given, is what changed from the cache's rope to `rope` — `[start old-end
new-end]`, the shape `text/changed-range` answers — so an editor that knows its edit (its
buffer's splice log, `editor/buffer/buffer-splices-cover`) spares the compare of two whole
ropes that finding it costs. It must describe exactly that pair of texts; nil (the default)
compares them.

    (second (editor/highlight/line-cache-update (editor/highlight/line-cache) (editor/highlight/stateless-lexer (fn (line) (if (string/starts-with? line \"#\") [[0 (string/length line) :c]] []))) (text/from-string \"a\\n# b\") 0 2))   ;=> ([2 5 :c])"
  (if (:stateless? lexer)
    (lc-stateless cache lexer rope lo hi)
    (let (top (math/min hi (text/line-count rope))
          bottom (math/min lo top)
          moved (if (nil? (:tree cache))
                  (assoc cache :rope rope :tree (lc-put nil 0 [(:initial lexer)]))
                  (lc-edited cache rope change))
          [walked acc] (lc-start moved {:lex (:lex lexer) :rope rope :lo bottom :hi top} '()))
      [(lc-retain walked bottom top) (reverse acc)])))

(def- lc-far
  ;; what the walk answers when it ran out of lines to lex before the target
  :editor.highlight/far)

(defn- lc-state-walk (cache lex rope i state last-key target budget)
  "Lex from line `i`, which starts in `state` (exact), down to line `target`, answering
`[cache state-at-target]`: a checkpoint every `lc-checkpoint-every` lines and where an old
entry disagrees, and back in step with a tentative chain the moment its entry agrees. `budget`
is how many more lines it may lex (nil, any number); spent before the target, it answers
`[cache [lc-far line state]]` — where it stopped and the state that line starts in — keeping
the checkpoints it made."
  (let (tree (:tree cache)
        verified (:verified cache)
        tentative? (and (not (nil? verified)) (> i verified))
        entry (lc-get tree 0 i))
    (cond
      (>= i target) (lc-walk-end cache i state state)
      ;; back in step: the old chain is exact from here, so resume from its entry nearest the target
      (and tentative? entry (= (first entry) state))
        (let (exact (assoc cache :verified nil)
              [key found] (lc-floor (:tree exact) 0 target [i entry]))
          (lc-state-walk exact lex rope key (first found) key target budget))
      (and (not (nil? budget)) (<= budget 0))
        [(first (lc-walk-end cache i state state)) [lc-far i state]]
      else
        (let (reuse? (and entry (= (count entry) 3) (= (first entry) state))
              out (if reuse? (nth entry 2) (second (lex (lc-line-text rope i) state)))
              write (cond
                      (and entry (not (= (first entry) state))) [state]
                      entry nil
                      (>= (- i last-key) lc-checkpoint-every) [state]
                      else nil))
          (lc-state-walk (if write (assoc cache :tree (lc-put tree i write)) cache)
            lex
            rope
            (inc i)
            out
            (if (or entry write) i last-key)
            target
            (if (or (nil? budget) reuse?) budget (dec budget)))))))

(defn- lc-state (cache lexer rope line change budget)
  ;; `line-cache-state`'s walk, with a budget of lines to lex (nil for none)
  (if (:stateless? lexer)
    [cache (:initial lexer)]
    (let (moved (if (nil? (:tree cache))
                  (assoc cache :rope rope :tree (lc-put nil 0 [(:initial lexer)]))
                  (lc-edited cache rope change))
          target (math/max 0 (math/min line (text/line-count rope)))
          tree (:tree moved)
          verified (:verified moved)
          [key _] (lc-floor tree 0 target [0 nil])
          from (if (and (not (nil? verified)) (> key verified)) verified key))
      (lc-state-walk moved (:lex lexer) rope from (first (lc-get tree 0 from)) from target budget))))

(defn line-cache-state (cache lexer rope line &optional (change nil))
  "`[cache' state]`: the state line `line` of `rope` starts in, by a stateful `lexer`, and the
cache to pass next time — the question `syntax-ppss` answers in Emacs, for a caller that wants
a line's STATE rather than its colours (is this line inside a string, how deep in brackets).
It lexes from the cache's nearest checkpoint above `line` (at most `lc-checkpoint-every` lines
of an unedited region), or from the first line an edit touched, and keeps checkpoints as it
goes, so asking again near the same place costs a few lines. `change` is
`line-cache-update`'s. A line past the end starts in the state the last line ends in; a
stateless lexer's lines all start in its `:initial`. [[line-cache-state-within]] is the same
question with a budget.

    (second (editor/highlight/line-cache-state (editor/highlight/line-cache) (editor/highlight/line-lexer (fn (line state) [[] (+ state (string/length line))]) 0) (text/from-string \"ab\\ncde\\nf\") 2))   ;=> 5"
  (lc-state cache lexer rope line change nil))

(defn line-cache-state-within (cache lexer rope line limit &optional (change nil))
  "`[cache' known? state]`: [[line-cache-state]] lexing at most `limit` lines — for a caller on
a keypress that must not read a cold region (a large file whose cache is still being built, the
lines below an edit that changed every state after it). When the answer is further than that,
`known?` is false and `state` is `[line line-state]`, where the walk stopped and the (exact)
state that line starts in — a caller may go on from there itself — and the cache keeps the
checkpoints the walk made, so asking
again goes on from there; when it is in reach, as `line-cache-state`.

    (second (editor/highlight/line-cache-state-within (editor/highlight/line-cache) (editor/highlight/line-lexer (fn (line state) [[] (inc state)]) 0) (text/from-string \"a\\nb\\nc\\nd\") 3 1))   ;=> false"
  (let ([walked state] (lc-state cache lexer rope line change limit))
    (if (and (vector? state) (= (first state) lc-far))
      [walked false [(nth state 1) (nth state 2)]]
      [walked true state])))

;; ---- the shared span -> runs tiler ------------------------------------------
;; `face-at` / `ranges-face` / `fontify-runs` are the renderer-agnostic core: a
;; caller hands in the lexer `spans` plus one `ranges` overlay channel and gets
;; `[substring face]` runs back, then turns each run into its own output (display
;; ops, HTML, …). The offset/merge/coalesce math lives here once.

(defn face-at (spans pos)
  "The face of the `[start end face]` span covering offset `pos`, or nil. Linear
scan; spans need not be sorted.

    (editor/highlight/face-at [[0 3 :keyword] [4 6 :string]] 5)   ;=> :string
    (editor/highlight/face-at [[0 3 :keyword]] 3)                 ;=> nil"
  (cond
    (empty? spans) nil
    else
      (let ([s e f] (first spans))
        (if (and (>= pos s) (< pos e)) f (face-at (rest spans) pos)))))

(defn ranges-face (ranges pos)
  "Merge the faces of every `[lo hi face]` range in `ranges` covering offset `pos`
(later ranges win on key conflict via `into`), or nil when none cover it. Region
highlight, isearch overlays, and bracket-match are all such ranges.

    (editor/highlight/ranges-face [[0 5 {:bold true}] [2 8 {:fg :red}]] 3)   ;=> {:fg :red, :bold true}"
  (fold ranges
    nil
    (fn (acc [lo hi f])
      (cond
        (not (and (>= pos lo) (< pos hi))) acc
        (nil? acc) f
        else (into acc f)))))

(defn fontify-runs (text base spans ranges)
  "Coalesce `text` (its first char at buffer offset `base`) into a list of
`[substring face]` runs: each char's face is its `spans` lexer face with every
covering `ranges` (`[lo hi face]`) face merged on top, and a new run starts wherever
that face changes. The shared run-length tiler — callers turn runs into display ops
or HTML; `()` for empty `text`. `spans` must be ascending + non-overlapping (the
`highlight-spans` shape); `ranges` may overlap and be unordered (merged later-wins).
The whole tile + overlay-merge is the native `%span-runs` (it runs per visible line every
frame, including a region/isearch overlay during a drag-select), so this is a thin call.

    (editor/highlight/fontify-runs \"ab cd\" 0 [[0 2 :keyword]] [])   ;=> ([\"ab\" :keyword] [\" cd\" nil])"
  (%span-runs text base spans ranges))

(defn highlight-chunks (full:any base:any line:any overrides:seqable -> list)
  "Return `[substring face]` chunks that tile `line` — the visible region starting
at offset `base` in `full` — coloured by lexing `full`, with `overrides` (a list of
`[pos face]` in full-coordinates, e.g. bracket-match colours) merged over the lexer.
Adjacent chars of equal face coalesce into one chunk; feed each to a `[:print str
face]` op. A thin shell over `fontify-runs`: each `[pos face]` override is the
one-char range `[pos (inc pos) face]`.

    (editor/highlight/highlight-chunks \"(let x)\" 0 \"(let x)\" [])   ;=> ([\"(\" nil] [\"let\" {:fg :blue, :bold true}] [\" x)\" nil])"
  (fontify-runs line
    base
    (highlight-spans full)
    (map overrides (fn ([p f]) [p (inc p) f]))))

;; ---- bracket matching -------------------------------------------------------

(defn- hl-fwd-match (full:string i:int n:int depth:int -> int)
  "Scanning forward from `i` (just past an opener), the offset of the closer at
`depth` 0, or -1. Skips strings/comments so their brackets don't count."
  (if (>= i n)
    -1
    (let (c (string/char-at full i))
      (cond
        (= c "\"") (hl-fwd-match full (hl-string-end full (inc i) n) n depth)
        (= c ";") (hl-fwd-match full (hl-to-eol full (inc i) n) n depth)
        (hl-open? c) (hl-fwd-match full (inc i) n (inc depth))
        (hl-close? c) (if (= depth 0) i (hl-fwd-match full (inc i) n (dec depth)))
        else (hl-fwd-match full (inc i) n depth)))))

(defn- hl-opener-scan (full:string i:int n:int cp:int stack: (list int) -> int)
  "Forward scan maintaining a `stack` of opener offsets; on reaching closer `cp`,
return the matching opener (top of stack) or -1. Skips strings/comments."
  (if (>= i n)
    -1
    (let (c (string/char-at full i))
      (cond
        (= c "\"") (hl-opener-scan full (hl-string-end full (inc i) n) n cp stack)
        (= c ";") (hl-opener-scan full (hl-to-eol full (inc i) n) n cp stack)
        (hl-open? c) (hl-opener-scan full (inc i) n cp (cons i stack))
        (hl-close? c)
          (if (= i cp)
            (if (empty? stack) -1 (first stack))
            (hl-opener-scan full (inc i) n cp (rest stack)))
        else (hl-opener-scan full (inc i) n cp stack)))))

(defn- hl-closer-of (c)
  ;; the closing delimiter that pairs with opener `c`, or nil
  (cond (= c "(") ")" (= c "[") "]" (= c "{") "}" else nil))

(defn- hl-close-scan (full:string i:int pos:int n:int stack: (list int) -> (or int :text))
  "Forward scan to `pos` keeping a stack of open-bracket offsets: the innermost opener
enclosing `pos`, `-1` at top level, or `:text` when `pos` falls inside a string or a comment
— where a bracket is a character rather than structure.

The extra answer is why this is not [[enclosing-open]]'s scan: that one clamps its string and
comment skips at `pos`, so it cannot tell a form that encloses `pos` from a string that
happens to sit inside one."
  (if (>= i pos)
    (if (empty? stack) -1 (first stack))
    (let (c (string/char-at full i))
      (cond
        (= c "\"")
          (let (e (hl-string-end full (inc i) n))
            (if (> e pos) :text (hl-close-scan full e pos n stack)))
        (= c ";")
          (let (e (hl-to-eol full (inc i) n))
            (if (> e pos) :text (hl-close-scan full e pos n stack)))
        (hl-open? c) (hl-close-scan full (inc i) pos n (cons i stack))
        (hl-close? c) (hl-close-scan full (inc i) pos n (rest stack))
        else (hl-close-scan full (inc i) pos n stack)))))

(defn closer-redundant? (full: (or string rope) pos:int c:string -> bool)
  "Would typing the closing delimiter `c` at offset `pos` in `full` be redundant — is the
character already there that same closer, and is it the one closing the innermost form `pos`
sits in?

The question an editor asks before self-inserting a closer. In `(+ 1 2|)` typing `)` would
give `(+ 1 2))`, so the useful thing is to move over the one already there — Emacs's
`electric-pair-mode` skip, paredit's `close-round`.

Answering it needs the enclosing FORM, not just the next character. In `(foo (bar|)` the `)`
at point closes `(bar`, so moving over it is right and leaves `(foo` still to close; at top
level a stray `)` closes nothing and must be typed; and `[1 2|)` is a mismatch, where typing
the character the reader will complain about is more honest than silently stepping over it.

False inside a string or a comment — `\";)\"` is text — and false at the end of the buffer.
`full` is a string or the rope an editor holds (ADR-488); only the top-level form up to `pos`
is read from a rope.

    (editor/highlight/closer-redundant? \"(a)\" 2 \")\")   ;=> true
    (editor/highlight/closer-redundant? \"(a\" 2 \")\")    ;=> false
    (editor/highlight/closer-redundant? (text/from-string \"(a)\") 2 \")\")   ;=> true"
  (and (< pos (text/length full))
    (= (text/slice full pos (inc pos)) c)
    ;; From the start of the top-level form `pos` is in, not from 0: there nothing is open and
    ;; no string or comment is, so the scan answers exactly what one from 0 would — and a
    ;; `)` typed near the end of a 44k-line file stopped costing 1.2 s of interpreted scan.
    ;; The scan reads only that form up to and including `pos`: a string or comment that
    ;; runs past `pos` still runs past it when the text is cut just after `pos`.
    (let (start (reflect/scan-form-start full pos)
          window (text/slice full start (inc pos))
          at (- pos start)
          open (hl-close-scan window 0 at (string/length window) '()))
      (and (int? open)
        (>= open 0)
        (= (hl-closer-of (string/char-at window open)) c)))))

(defn bracket-match (full:string pos:int -> (or nil (vector any)))
  "Given source `full` and cursor offset `pos`, return `[a b]` (the offsets of the
matched bracket pair, `a` the opener) when the bracket adjacent to the cursor (the
one just left of it, else the one under it) has a match, `[p :unmatched]` when it
has none, or nil when the cursor isn't next to a bracket. Brackets inside strings
and comments are ignored.

    (editor/highlight/bracket-match \"(a (b))\" 3)   ;=> [3 5]"
  (let (n (string/length full)
        bi (cond
             (and (> pos 0) (hl-bracket? (string/char-at full (dec pos)))) (dec pos)
             (and (< pos n) (hl-bracket? (string/char-at full pos))) pos
             else -1))
    (if (< bi 0)
      nil
      (let (c (string/char-at full bi))
        (if (hl-open? c)
          (let (m (hl-fwd-match full (inc bi) n 0))
            (if (< m 0) [bi :unmatched] [bi m]))
          ;; from the top-level form the closer is in (nothing open there), not from 0
          (let (m (hl-opener-scan full (reflect/scan-form-start full bi) n bi '()))
            (if (< m 0) [bi :unmatched] [m bi])))))))

(defn enclosing-open (full pos)
  "The offset of the innermost *unclosed* opening bracket enclosing `pos`, or -1 when
`pos` is at top level. Strings and comments are skipped, so a `(` inside a string
doesn't count as nesting.

Public because it is the one fact an auto-indenter needs — which form am I inside,
and where does it start — and `enclosing-call` (right below) already computes it for
signature hints; exposing it beats a second, subtly-different scan in the editor.

The scan starts at the nearest top-level form start ([[safe-restart]]) rather than offset 0,
for the reason `enclosing-call` gives and by the same argument: a top-level open bracket is
top level, so nothing above it is still open, and every bracket enclosing `pos` is inside
that form. Sound, and the difference between O(enclosing form) and O(pos) — this scan is
interpreted, and at offset 600 of a 1.5 KB buffer the O(pos) version cost 1.4 ms, on every
newline an auto-indenter handles.

    (editor/highlight/enclosing-open \"(a (b c\" 6)   ;=> 3
    (editor/highlight/enclosing-open \"a b\" 1)       ;=> -1"
  (hl-enc-scan full (safe-restart full pos) pos (string/length full) '()))

;; ---- enclosing call (for signature hints) -----------------------------------

(defn- hl-enc-scan (full:string i:int pos:int n:int stack: (list int) -> int)
  "Forward scan to `pos` maintaining a stack of open-bracket offsets; returns the
innermost open bracket enclosing `pos`, or -1. Skips strings/comments (clamped at
`pos`)."
  (if (>= i pos)
    (if (empty? stack) -1 (first stack))
    (let (c (string/char-at full i))
      (cond
        (= c "\"") (hl-enc-scan full (math/min pos (hl-string-end full (inc i) n)) pos n stack)
        (= c ";") (hl-enc-scan full (math/min pos (hl-to-eol full (inc i) n)) pos n stack)
        (hl-open? c) (hl-enc-scan full (inc i) pos n (cons i stack))
        (hl-close? c) (hl-enc-scan full (inc i) pos n (rest stack))
        else (hl-enc-scan full (inc i) pos n stack)))))

(defn- hl-datum-starts (full:string i:int end:int n:int acc: (list int) -> (list int))
  "Start offsets (reverse order) of the complete datums in `[i, end)` at one nesting
level — atoms, strings, and whole bracketed forms each count once."
  (if (>= i end)
    acc
    (let (c (string/char-at full i))
      (cond
        (hl-ws? c) (hl-datum-starts full (inc i) end n acc)
        (= c ";") (hl-datum-starts full (hl-to-eol full (inc i) n) end n acc)
        (= c "\"") (hl-datum-starts full (hl-string-end full (inc i) n) end n (cons i acc))
        (hl-open? c)
          (let (m (hl-fwd-match full (inc i) n 0))
            (hl-datum-starts full (if (< m 0) end (inc m)) end n (cons i acc)))
        (hl-close? c) (hl-datum-starts full (inc i) end n acc)
        else (hl-datum-starts full (hl-atom-end full (inc i) n) end n (cons i acc))))))

(defn enclosing-call (full:string pos:int -> (or nil (tuple string int)))
  "Return `[callee arg-index]` for the innermost call `(…` enclosing cursor offset
`pos` — `callee` the head symbol's text and `arg-index` how many arguments precede
the cursor (0 = first arg) — or nil when the cursor isn't inside a call whose head
is a plain symbol.

The enclosing-bracket scan starts at the nearest top-level form start (`safe-restart`)
rather than offset 0: head-position state is known-balanced at a top-level form start, so
the scan walks only the *current* defun, not every character above `pos`. This makes
eldoc O(enclosing-form) instead of O(pos) — instant versus a multi-second stall when the
cursor sits deep in a large file.

    (editor/highlight/enclosing-call \"(foo a b\" 8)   ;=> [\"foo\" 1]"
  (let (n (string/length full)
        op (enclosing-open full pos))
    (if (or (< op 0) (not (= (string/char-at full op) "(")))
      nil
      (let (end (math/min pos n)
            starts (reverse (hl-datum-starts full (inc op) end n '())))
        (if (empty? starts)
          nil
          (let (cstart (first starts)
                cchar (string/char-at full cstart))
            (if (or (hl-open? cchar) (= cchar "\"") (= cchar ":"))
              nil
              (let (callee (string/substring full cstart (hl-atom-end full (inc cstart) n)))
                (if (hl-number? callee)
                  nil
                  (let (afterc (dec (count starts))
                        in-datum (and (> pos 0) (not (hl-delim? (string/char-at full (dec pos)))))
                        argi (if in-datum (math/max 0 (dec afterc)) afterc))
                    [callee argi]))))))))))

;; ---- completion helpers (pure; candidates supplied by the caller) -----------

(defn symbol-char? (c:string -> bool)
  "True if `c` (a 1-char string) can be part of a symbol token — not whitespace, a
bracket, `\"`, `;`, and not one of the reader-macro prefixes `' \` ~ ^ @ #` that
glue onto a symbol without being part of it (`'foo`, `~x`, `^pat`, `~@xs`). The ONE
word-boundary rule every completer uses: the mode source, the buffer-word scan and
an LSP source must agree on where the prefix starts, or a merge drops the sources
that disagree (a `'foo` prefix used to start at the quote for one and after it for
another — and the buffer-word candidates silently vanished).

    (editor/highlight/symbol-char? \"-\")   ;=> true
    (editor/highlight/symbol-char? \"(\")   ;=> false"
  (not (or (hl-delim? c) (= c "'") (= c "`") (= c "~") (= c "^") (= c "@") (= c "#"))))

(defn- hl-sym-start (full:string i:int -> int)
  "The offset where the symbol token ending at `i` begins."
  (if (or (<= i 0) (not (symbol-char? (string/char-at full (dec i)))))
    i
    (hl-sym-start full (dec i))))

(defn symbol-prefix-at (full:string pos:int -> (vector any))
  "Return `[start prefix]` for the symbol token ending at cursor offset `pos` —
`start` its offset, `prefix` its text — or `[pos \"\"]` when the cursor isn't on a
symbol.

    (editor/highlight/symbol-prefix-at \"(str/jo\" 7)   ;=> [1 \"str/jo\"]"
  (let (s (hl-sym-start full pos)) [s (string/substring full s pos)]))

(defn symbol-at (full:string pos:int -> (or nil (vector any)))
  "Return `[start text]` for the whole symbol token **containing** cursor offset `pos`, or
nil when `pos` is not on one.

[[symbol-prefix-at]]'s sibling, and a different question. That one answers what has been
TYPED so far — everything back to the token start, stopping dead at the cursor — which is
what completion needs. This one answers what the cursor is ON, running forward to the end of
the token as well, which is what a reader hovering over `(ma|p f xs)` is pointing at.

A cursor sitting immediately after a token counts as on it, the way Emacs's `symbol-at-point`
does — `(map|` reads as `map`, since that is where point lands after typing one.

    (editor/highlight/symbol-at \"(foo bar)\" 6)   ;=> [5 \"bar\"]"
  (let (start (hl-sym-start full pos)
        end (hl-atom-end full pos (string/length full))
        text (string/substring full start end))
    (when (not (= text "")) [start text])))

(defn- hl-cp2 (a b)
  "The longest common prefix of two strings."
  (hl-cp2-at a b 0 (math/min (string/length a) (string/length b))))
(defn- hl-cp2-at (a b i n)
  (if (or (>= i n) (not (= (string/char-at a i) (string/char-at b i))))
    (string/substring a 0 i)
    (hl-cp2-at a b (inc i) n)))

(defn common-prefix (strs)
  "The longest common string prefix shared by every string in `strs` (\"\" when
`strs` is empty or shares nothing).

    (editor/highlight/common-prefix [\"string/join\" \"string/jump\"])   ;=> \"string/j\"
    (editor/highlight/common-prefix [\"a\" \"b\"])                       ;=> \"\""
  (if (empty? strs)
    ""
    (fold (rest strs) (first strs) hl-cp2)))
