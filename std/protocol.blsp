(defmodule protocol
  "Open generic functions — Brood's polymorphism seam (ADR-158).

  `defprotocol` declares typed ops; `defimpl` registers a per-type implementation;
  each op dispatches on the runtime type (`type-of`) of its first argument. Open:
  impls for any type, including built-ins, can be added from anywhere, and a missing
  impl is a clear error rather than a silent fall-through.

  Two registries back it:
    *protocols* — name → its declared op specs, as DATA. This is the introspection
      hook the advisory type-checker and the LSP read to verify conformance and to
      offer autocomplete (`(protocol-ops 'Encode)` → the op specs).
    *impls*     — [protocol op] → {type-key → fn}. The runtime dispatch table,
      nested so an op's whole method set is one map: dispatch fetches it with a
      *constant* `[protocol op]` key (the macro emits it as a quoted literal, so it
      is not rebuilt per call) and then indexes by the argument's kind.

  Dispatch is on `type-of`, so the keys are runtime *kinds* — `:int`, `:string`,
  `:map`, `:vector`, … plus `:default`. Records are structural maps (ADR-130), so
  every `defrecord` value dispatches as `:map`: to specialise per record shape,
  branch on a `:type` key inside the `:map` impl. A second dispatch axis keyed on
  that field is a ROADMAP question, deliberately not shipped (ADR-011) — it would
  silently change what any map carrying a `:type` key dispatches to.

  **Register at load time.** `defprotocol`/`defimpl` update the two registry globals
  with `def`, i.e. a read-modify-write of an immutable map — so two processes
  registering *concurrently* can lose one update. Top-level `defimpl` forms (the
  normal case) run as the module loads and are safe; the rule is the same one
  telemetry's `attach`/`detach` follow — configuration time, not request time.

  Written entirely in Brood; the kernel's only involvement is the advisory
  conformance pass the checker/LSP run over `defprotocol`/`defbehaviour`/`defimpl`
  (`types/check/protocol.rs`) — which is why an impl that omits a declared op, or
  gets an arity wrong, is reported by `nest check`.")

; ---- registries -------------------------------------------------------------

; protocol-name → op specs (introspection / tooling)
(def *protocols* {})
; [protocol op] → {type-key → impl fn} (runtime dispatch)
(def *impls* {})
(defn register-protocol (pname specs)
  "Record protocol `pname`'s declared op specs (raw forms) for tooling."
  (def *protocols* (assoc *protocols* pname specs))
  nil)

(defn protocol-ops (pname)
  "The op specs declared for protocol `pname` (or nil) — what the type-checker / LSP
  read to know which ops a `defimpl` must provide, with what arities."
  (get *protocols* pname))

(defn register-impl (pname op key f)
  "Register impl `f` of `pname`'s `op` for dispatch key `key` (a type-of keyword).
  Read-modify-write of the `*impls*` global — register at load time (see the module
  docstring's concurrency note), as top-level `defimpl` does."
  (let (op-key [pname op]
        methods (or (get *impls* op-key) {}))
    (def *impls* (assoc *impls* op-key (assoc methods key f)))
    nil))

(defn impl-for (op-key key)
  "The impl of op `op-key` (a `[protocol op]` pair) for kind `key`, falling back to a
  `:default` impl, or nil. One map fetch for the op's method set, then one by kind —
  `get` tolerates a nil method set (an op with no impls yet)."
  (let (methods (get *impls* op-key))
    (or (get methods key)
      (get methods :default))))

(defn no-impl (op-key key)
  "The loud, located error an op raises when no impl (and no `:default`) covers kind
  `key`. Names the protocol, the op, and the kind, and lists the kinds that *are*
  implemented so a missing/misspelled `defimpl` is obvious."
  (let (pname (first op-key)
        op (second op-key)
        known (keys (or (get *impls* op-key) {})))
    (if (empty? known)
      (error "protocol " pname ": no implementation of " op " for " key)
      (error "protocol " pname ": no implementation of " op " for " key
        " — have " known))))

(defn satisfies? (pname x)
  "True if protocol `pname` is implemented for `x`'s kind — every declared op has an
  impl for `(type-of x)` (or a `:default`). Lets a caller branch instead of letting
  the op raise the missing-impl error. False for an unknown protocol."
  (let (key (type-of x)
        ops (protocol-ops pname))
    (if ops
      (every? (fn (spec) (impl-for [pname (first spec)] key)) ops)
      false)))

; ---- macros -----------------------------------------------------------------

(defmacro defprotocol (pname & specs)
  "Declare protocol `pname`. Each op spec `(op [args…] :-> ret)` becomes a generic
  function dispatching on its first argument's type. An optional leading docstring
  is allowed. Records the op specs in *protocols* for the type-checker / LSP.

    (defprotocol Encode
      \"JSON-encode a value.\"
      (encode [v] :-> string))"
  (let (ops (filter (fn (s) (pair? s)) specs))
    ; drop the optional leading docstring
    (cons 'do
      (cons (list 'protocol/register-protocol (list 'quote pname) (list 'quote ops))
        (map
          (fn (op)
            (let (op-name (first op)
                  ; arg vector → list; dispatch reads the FIRST arg's kind
                  arg-syms (map (fn (s) s) (second op))
                  first-arg (first arg-syms)
                  ; a *constant* [protocol op] key — a quoted literal, built once at
                  ; read time, not rebuilt on every call
                  op-key (list 'quote [pname op-name])
                  ; gensym'd temporaries so an op arg named `f`/`k` can't be captured
                  kind-sym (gensym)
                  impl-sym (gensym))
              (list 'defn
                op-name
                arg-syms
                (list 'let (list kind-sym (list 'type-of first-arg)
                                 impl-sym (list 'protocol/impl-for op-key kind-sym))
                  (list 'if impl-sym
                    ; direct, arity-correct call — no arg-list alloc, no `apply`
                    (cons impl-sym arg-syms)
                    (list 'protocol/no-impl op-key kind-sym))))))
          ops)))))

(defmacro defimpl (pname key & methods)
  "Register implementations of protocol `pname` for dispatch key `key` (a `type-of`
  keyword like `:int`/`:map`, or `:default`). Each method is `(op [args…] body…)`.

    (defimpl Encode :int (encode [n] (str n)))"
  (cons 'do
    (map
      (fn (m)
        (let (op-name (first m)
              ; arg vector → list
              arg-syms (map (fn (s) s) (second m))
              body (rest (rest m)))
          (list 'protocol/register-impl
            (list 'quote pname)
            (list 'quote op-name)
            key
            (cons 'fn (cons arg-syms body)))))
      methods)))

(defmacro defbehaviour (bname & specs)
  "Declare a behaviour `bname` — a contract a *module* satisfies by defining its ops
  as functions (unlike `defprotocol`, there's no value-dispatch; a module calls its
  own functions directly). Records the ops so the checker can verify that a module
  whose header says `(:implements bname)` defines each one at the right arity.

    (defbehaviour LiveModule
      (mount [params])
      (render [model])
      (handle-event [name params model]))"
  (let (ops (filter (fn (s) (pair? s)) specs))
    (list 'protocol/register-protocol (list 'quote bname) (list 'quote ops))))
