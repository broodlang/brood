;; Behaviour contracts — the module-satisfies-a-contract seam. CORE: this is part of
;; the language (loaded in the prelude), so `defbehaviour` and the registry are available
;; without a `require` or a `protocol/` prefix.
;;
;; `defbehaviour` declares the ops a *module* must define to satisfy a named contract.
;; There is no value dispatch: a module satisfies a behaviour by defining functions and
;; calls its own functions directly. It records the ops in `*protocols*` so the advisory
;; checker can verify that a module whose header says `(:implements bname)` defines each
;; one at the right arity (`types/check/protocol.rs`).
;;
;; This seam used to also carry `defprotocol`/`defimpl` — open generic functions
;; dispatching on `type-of`. Those were RETIRED in favour of `std/ability.blsp`, which
;; unifies value polymorphism and drivers-as-values with nominal dispatch. Behaviours stay
;; because a module-as-implementor contract — a namespace with no dispatch value, e.g. a
;; live view the router calls by name — is genuinely different from value dispatch.

; ---- the behaviour/interface registry (read by the checker + LSP) ------------

; interface-name → its declared op specs, as DATA
(defonce *protocols* {})

(defn register-protocol (pname specs)
  "Record interface `pname`'s declared op specs (raw forms) for the checker / LSP."
  (swap-registry! *protocols* (fn (m) (assoc m pname specs)))
  nil)

(defn ops (pname)
  "The op specs declared for interface `pname` (or nil) — which ops a module claiming
  `(:implements pname)` must define, and at what arities."
  (get *protocols* pname))

; ---- the behaviour macro ----------------------------------------------------

(defmacro defbehaviour (bname & specs)
  "Declare a behaviour `bname` — a contract a *module* satisfies by defining its ops as
  functions (unlike a value-dispatched `ability`, there is no runtime dispatch; a module
  calls its own functions directly). Records the ops so the checker can verify a module
  whose header says `(:implements bname)` defines each one at the right arity.

    (defbehaviour LiveModule
      (mount [params])
      (render [model])
      (handle-event [name params model]))"
  (let (ops (filter (fn (s) (pair? s)) specs))
    (list 'register-protocol (list 'quote bname) (list 'quote ops))))
