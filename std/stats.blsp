(defmodule stats
  "Descriptive statistics over numeric sequences.

All functions accept any sequence (list or vector) of numbers.
Empty sequences raise unless documented otherwise.

  (stats/mean [1 2 3 4 5])      ;; => 3.0
  (stats/median [3 1 2])        ;; => 2
  (stats/stddev [2 4 4 4 5 5 7 9]) ;; => 2.0
  (stats/percentile [1 2 3 4 5] 50) ;; => 3"
  (:use seq)
  (:use math))

;; ---- basic moments -----------------------------------------------------------

(defn mean (xs)
  "The arithmetic mean of `xs`. Always returns a float. Raises on an empty sequence.

    (stats/mean [1 2 3])     → 2.0"
  (let (n (count xs))
    (when (= n 0) (error "stats/mean: empty sequence"))
    (/ (* 1.0 (sum xs)) n)))

(defn- sum-of-squares (xs m)
  (fold xs 0 (fn (acc x) (+ acc (* (- x m) (- x m))))))

(defn variance (xs)
  "The population variance (divided by n) of `xs`. Raises on an empty sequence;
a 1-element sequence has population variance 0.0.

    (stats/variance [2 2 2])   → 0.0"
  (let (n (count xs))
    (when (< n 1) (error "stats/variance: empty sequence"))
    (let (m (mean xs))
      (/ (* 1.0 (sum-of-squares xs m)) n))))

(defn sample-variance (xs)
  "The sample variance (divided by n-1, Bessel's correction) of `xs`. Raises if fewer than 2 elements.

    (stats/sample-variance [2 4 4 4 5 5 7 9])   → 4.571428571428571"
  (let (n (count xs))
    (when (< n 2) (error "stats/sample-variance: need at least 2 elements"))
    (let (m (mean xs))
      (/ (* 1.0 (sum-of-squares xs m)) (- n 1)))))

(defn stddev (xs)
  "The population standard deviation of `xs`.

    (stats/stddev [2 2 2])   → 0.0"
  (sqrt (variance xs)))

(defn sample-stddev (xs)
  "The sample standard deviation of `xs` (Bessel's correction).

    (stats/sample-stddev [2 4 4 4 5 5 7 9])   → 2.138089935299395"
  (sqrt (sample-variance xs)))

;; ---- order statistics --------------------------------------------------------

(defn median (xs)
  "The median of `xs`. Raises on an empty sequence.
For an even-length sequence, returns the mean of the two middle values.

    (stats/median [3 1 2])   → 2"
  (let (n (count xs))
    (when (= n 0) (error "stats/median: empty sequence"))
    ;; Every index below is inside the sorted sequence (`n` is at least 1, `mid` at most
    ;; `n - 1`), a relation between two locals the checker does not hold (C12); the read
    ;; says so with the error it can never raise.
    (let (sorted (sort xs)
          mid (math/quot n 2)
          at (fn (i) (or (nth sorted i) (error "stats/median: index " i " outside " n))))
      (if (= (math/rem n 2) 1)
        (at mid)
        (/ (+ (at (- mid 1)) (at mid)) 2)))))
;; `(or list vector set)`, not `seqable`, for the three that SORT: `sort` materialises
;; through `Heap::seq_items` and raises on a string, a map or bytes, so `seqable` here
;; promised a domain the body cannot honour. The fold-only functions above keep the
;; wider declaration — they never sort.
(sig median ((seqable number) -> number))

(defn percentile (xs p)
  "The `p`-th percentile (0–100) of `xs` using the nearest-rank method.
  `p` = 0 returns the minimum; `p` = 100 returns the maximum.

    (stats/percentile [1 2 3 4] 50)   → 2"
  (let (n (count xs))
    (when (= n 0) (error "stats/percentile: empty sequence"))
    (when (or (< p 0) (> p 100))
      (error "stats/percentile: p must be in [0, 100], got " p))
    (let (sorted (sort xs)
          rank (math/max 1 (ceil (* (/ p 100.0) n)))
          idx (math/min (- n 1) (- rank 1)))
      (or (nth sorted idx) (error "stats/percentile: index " idx " outside " n)))))
(sig percentile ((seqable number) number -> number))

(defn quantile (xs q)
  "The `q`-th quantile (0.0–1.0) of `xs` using the nearest-rank method.

    (stats/quantile [1 2 3 4] 0.5)   → 2"
  (percentile xs (* q 100)))

;; ---- range and spread --------------------------------------------------------

(defn min (xs)
  "The smallest value in `xs`. Raises on an empty sequence.

    (stats/min [3 1 2])      → 1"
  (when (empty? xs) (error "stats/min: empty sequence"))
  (reduce xs math/min))
(sig min ((seqable number) -> number))

(defn max (xs)
  "The largest value in `xs`. Raises on an empty sequence.

    (stats/max [3 1 2])      → 3"
  (when (empty? xs) (error "stats/max: empty sequence"))
  (reduce xs math/max))
(sig max ((seqable number) -> number))

(defn range-of (xs)
  "The range (max − min) of `xs`. Raises on an empty sequence.

    (stats/range-of [3 1 2]) → 2"
  ;; Qualified: `max` is now defined in BOTH `math` (variadic over arguments) and here
  ;; (over a collection), so bare is ambiguous inside this module and the compiler says so.
  (- (stats/max xs) (stats/min xs)))

;; ---- frequency ---------------------------------------------------------------
;; `mode` uses the `seq` library's `frequencies` (a general sequence op, ADR-227);
;; no stats-local copy — it was a slower duplicate of the same function.

(defn mode (xs)
  "The most frequent value in `xs` (first occurrence wins on ties). Raises on empty.

    (stats/mode [1 1 2])     → 1"
  (when (empty? xs) (error "stats/mode: empty sequence"))
  (let (freq (frequencies xs))
    (fold (rest xs) (first xs) (fn (best x) (if (> (get freq x) (get freq best)) x best)))))
