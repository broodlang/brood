;; std/map.blsp — the map-transformation helper library (ADR-227).
;; A namespace (ADR-065): its functions are `map/merge-with`, `map/update-vals`, … —
;; consumers `(:use map)` to refer them bare, or call them qualified.
;;
;; The *core* map protocol stays bare in the prelude — `assoc`/`dissoc`/`get`/`keys`/
;; `vals`/`contains?`/`update`/`get-in`/`update-in`/`merge` (and `hash-map`,
;; which the record/ability machinery uses during bootstrap) are the universal map
;; surface. This module is the derived transformation helpers layered on top.
;;
;; Note the module is named `map`; the bare `map` *function* (map/filter/reduce) is
;; unaffected — a bare `map` still resolves to the function, and these helpers reach it
;; the same way (there is no `map/map`).
(defmodule map
  "Map transformations — the derived helpers over the bare map protocol.

The core ops (`assoc` `dissoc` `get` `keys` `vals` `contains?` `update` `merge`) stay bare in
the prelude and need no import; the path functions `get-in`, `assoc-in`, `update-in` and
`dissoc-in` are here (ADR-506).
This module adds: `reduce-kv` (fold over key and value), `merge-with` (combine on shared
keys), `update-vals` / `update-keys` (map value/key every), `select-keys` (project a
subset), `zipmap` (pair keys with values) and `shape-problems` / `shape-problem->string`
(is this map the right shape — missing, unknown and invalid keys, with a \"did you mean\"; ADR-760).
`(:use map)` for bare
access, or call qualified (`map/update-vals`).")

;; merge-with: on a shared key, combine with `(f existing new)` instead of replacing.
;; Read-modify-write per key, so it folds immutable `assoc` (each returns a fresh map). The
;; maps are one collection and the function comes last (ADR-507), so a list of maps threads.
(defn merge-with (maps f:fn)
  "Merge the collection `maps` left to right like `merge`, but when two share a key the combined value is `(f value-so-far next-value)` rather than just the latter. `nil` maps are skipped.

    (map/merge-with [{:a 1 :b 2} {:b 3}] +) ;=> {:a 1 :b 5}
    (map/merge-with [] +)                   ;=> {}"
  (fold maps
    {}
    (fn (acc m)
      (if (nil? m)
        acc
        (map/reduce-kv m acc (fn (a k v) (assoc a k (if (contains? a k) (f (get a k) v) v))))))))

(defn update-vals (m f)
  "A map like `m` with `f` applied to every value.

    (map/update-vals {:a 1 :b 2} inc) ;=> {:a 2 :b 3}"
  (into {} (map (%map-pairs m) (fn (p) [(first p) (f (second p))]))))
(defn update-keys (m f)
  "A map like `m` with `f` applied to every key (later keys win on a collision).

    (map/update-keys {:a 1} ->string) ;=> {\"a\" 1}"
  (into {} (map (%map-pairs m) (fn (p) [(f (first p)) (second p)]))))

(defn select-keys (m ks)
  "A map of just the entries of `m` whose key is in `ks` (keys absent from `m` are skipped).

    (map/select-keys {:a 1 :b 2 :c 3} [:a :c]) ;=> {:a 1 :c 3}"
  ;; One `%map-get` per key — which also yields the value — rather than
  ;; `contains?` (its own probe) plus a separate `get`. A present key returns its
  ;; stored value (used directly); only when that value happens to equal the
  ;; first sentinel do we disambiguate present-vs-absent with a second sentinel,
  ;; so a key stored with `nil`/`false` is still kept (contains?'s guarantee).
  (into {}
    (seq/keep ks
      (fn (k)
        (let (v (%map-get m k :%select-miss-a))
          (if (= v :%select-miss-a)
            (let (v2 (%map-get m k :%select-miss-b))
              (if (= v2 :%select-miss-b) nil [k v2]))
            [k v]))))))

(defn reduce-kv (m init f)
  "Fold over the entries of map `m`, calling `(f acc k v)`, starting from `init`.

    (map/reduce-kv {:a 1 :b 2} 0 (fn (acc k v) (+ acc v))) ;=> 3"
  (fold (%map-pairs m) init (fn (acc p) (f acc (first p) (second p)))))

;; ---- zipmap (ADR-251) -------------------------------------------------------
;; Published here rather than bare: it RETURNS a map, so it belongs with the map
;; helpers. The implementation is the prelude `%zipmap` internal, because
;; `defrecord`'s expansion builds its constructor body with it at boot.

(defn zipmap (ks vs)
  "A map pairing each key in `ks` with the value at the same position in `vs`,
stopping at the shorter.

    (map/zipmap [:a :b] [1 2])   ;=> {:a 1 :b 2}"
  (%zipmap ks vs))

;; ---- shape checks: is this map the right shape? (ADR-760) -----------------------
;; A manifest, a spec, a settings group or a plugin map is a map whose keys are a known set,
;; and what goes wrong with one is the same few things: a required key is missing, a key is
;; misspelt, a value is the wrong kind, or the thing is not a map at all. Each caller used to
;; hand-roll that walk and its "did you mean"; this is the one walk, answering problems as DATA
;; (so a caller can warn, fail, or show a diagnostic) and one sentence per problem.

(defn- shape-key-text (key)
  ;; how a key is printed: `:name`, `"name"`, `name`
  (pr-str key))

(defn- shape-sorted (collection)
  ;; keys in a stable order, whatever their kind, so problems come out the same every run
  (seq/sort-by (vec collection) shape-key-text))

(defn- shape-key-name (key)
  ;; what a suggestion compares: a keyword's or symbol's bare name, a string as it is — the
  ;; `:` every keyword shares is no evidence two keys are alike, and counted in the text it
  ;; lowered the distance enough that `:color` suggested `:cover`
  (cond
    (or (keyword? key) (symbol? key)) (->string key)
    (string? key) key
    else (pr-str key)))

(defn- shape-suggestion (key candidates)
  ;; the nearest of `candidates` to the unknown `key` by edit distance, or nil
  (let (by-name (into {} (map candidates (fn (candidate) [(shape-key-name candidate) candidate])))
        nearest (fuzzy/nearest (keys by-name) (shape-key-name key)))
    (if (empty? nearest) nil (get by-name (first nearest)))))

(defn shape-problems (value shape:map -> list)
  "What is wrong with `value` against `shape` — `{:required #{keys} :optional #{keys}
:check {key predicate}}`, every part optional, a key list any collection — as a list of problem
maps, `()` when it fits. A problem is `{:kind :not-a-map :value value}` (and nothing else is
checked), `{:kind :missing :key key}` for an absent required key, `{:kind :unknown :key key
:suggestion nearest}` for a key the shape does not name (`:suggestion` is the nearest unused
allowed key by edit distance between bare names, or nil), or `{:kind :invalid :key key :value
value}` for a present key whose `:check` predicate answers false. Missing come first, then
unknown, then invalid, each sorted by key. `map/shape-problem->string` says one as a sentence.

    (map/shape-problems {:name \"x\"} {:required #{:name} :optional #{:version}})   ;=> ()
    (map/shape-problems {:nmae \"x\"} {:required #{:name}})   ;=> ({:kind :missing :key :name} {:kind :unknown :key :nmae :suggestion :name})
    (map/shape-problems {:width \"wide\"} {:optional #{:width} :check {:width int?}})   ;=> ({:kind :invalid :key :width :value \"wide\"})
    (map/shape-problems 42 {:required #{:name}})   ;=> ({:kind :not-a-map :value 42})"
  (if (not (map? value))
    (list {:kind :not-a-map :value value})
    (let (required (into #{} (or (:required shape) []))
          allowed (into required (or (:optional shape) []))
          checks (or (:check shape) {})
          present (keys value)
          missing (seq/filter (shape-sorted required) (fn (key) (not (contains? value key))))
          unknown (seq/filter (shape-sorted present) (fn (key) (not (contains? allowed key))))
          unused (seq/filter (vec allowed) (fn (key) (not (contains? value key))))
          invalid (seq/filter (shape-sorted present)
                    (fn (key)
                      (and (contains? checks key) (not ((get checks key) (get value key)))))))
      (append (map missing (fn (key) {:kind :missing :key key}))
        (map unknown
          (fn (key) {:kind :unknown :key key :suggestion (shape-suggestion key unused)}))
        (map invalid (fn (key) {:kind :invalid :key key :value (get value key)}))))))

(defn shape-problem->string (problem:map -> string)
  "One problem from `map/shape-problems` as a sentence, with a \"did you mean\" for an unknown
key that has a near miss.

    (map/shape-problem->string {:kind :unknown :key :nmae :suggestion :name})   ;=> \"unknown key :nmae — did you mean :name?\"
    (map/shape-problem->string {:kind :unknown :key :zzz :suggestion nil})   ;=> \"unknown key :zzz\"
    (map/shape-problem->string {:kind :missing :key :name})   ;=> \"missing required key :name\"
    (map/shape-problem->string {:kind :invalid :key :width :value \"wide\"})   ;=> \"key :width has an invalid value \\\"wide\\\"\"
    (map/shape-problem->string {:kind :not-a-map :value 42})   ;=> \"expected a map, got 42\""
  (let (key-text (shape-key-text (:key problem)))
    (case (:kind problem)
      :missing (str "missing required key " key-text)
      :unknown
        (if (nil? (:suggestion problem))
          (str "unknown key " key-text)
          (str "unknown key "
            key-text
            " — did you mean "
            (shape-key-text (:suggestion problem))
            "?"))
      :invalid (str "key " key-text " has an invalid value " (pr-str (:value problem)))
      :not-a-map (str "expected a map, got " (pr-str (:value problem)))
      (error "map/shape-problem->string: not a shape problem: " (pr-str problem)))))
