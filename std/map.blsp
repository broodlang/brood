;; std/map.blsp — the map-transformation helper library (ADR-227).
;; A namespace (ADR-065): its functions are `map/merge-with`, `map/update-vals`, … —
;; consumers `(:use map)` to refer them bare, or call them qualified.
;;
;; The *core* map protocol stays bare in the prelude — `assoc`/`dissoc`/`get`/`keys`/
;; `vals`/`contains?`/`reduce-kv`/`update`/`get-in`/`update-in`/`merge` (and `hash-map`,
;; which the record/ability machinery uses during bootstrap) are the universal map
;; surface. This module is the derived transformation helpers layered on top.
;;
;; Note the module is named `map`; the bare `map` *function* (map/filter/reduce) is
;; unaffected — a bare `map` still resolves to the function, and these helpers reach it
;; the same way (there is no `map/map`).
(defmodule map
  "Map transformations — the derived helpers over the bare map protocol.

The core ops (`assoc` `dissoc` `get` `keys` `vals` `contains?` `reduce-kv`
`update` `get-in` `update-in` `merge`) stay bare in the prelude and need no import.
This module adds: `merge-with` (combine on shared keys), `update-vals` / `update-keys`
(map value/key every), and `select-keys` (project a subset). `(:use map)` for bare
access, or call qualified (`map/update-vals`).")

;; merge-with: on a shared key, combine with `(f existing new)` instead of replacing.
;; Read-modify-write per key, so it folds immutable `assoc` (each returns a fresh map).
(defn merge-with (f & maps)
  "Like `merge`, but when two maps share a key the combined value is `(f value-so-far next-value)` rather than just the latter. `nil` maps are skipped."
  (fold maps
    {}
    (fn (acc m)
      (if (nil? m)
        acc
        (map/reduce-kv m acc (fn (a k v) (assoc a k (if (contains? a k) (f (get a k) v) v))))))))

(defn update-vals (m f)
  "A map like `m` with `f` applied to every value."
  (into {} (map (%map-pairs m) (fn (p) [(first p) (f (second p))]))))
(sig update-vals (map any -> map))
(defn update-keys (m f)
  "A map like `m` with `f` applied to every key (later keys win on a collision)."
  (into {} (map (%map-pairs m) (fn (p) [(f (first p)) (second p)]))))
(sig update-keys (map any -> map))

(defn select-keys (m ks)
  "A map of just the entries of `m` whose key is in `ks` (keys absent from `m` are skipped)."
  ;; One `%map-get` per key — which also yields the value — rather than
  ;; `contains?` (its own probe) plus a separate `get`. A present key returns its
  ;; stored value (used directly); only when that value happens to equal the
  ;; first sentinel do we disambiguate present-vs-absent with a second sentinel,
  ;; so a key stored with `nil`/`false` is still kept (contains?'s guarantee).
  (into {}
    (seq/keep ks
      (fn (k)
        (let (v (%map-get m k :%select-miss-a))
          (if (= v :%select-miss-a)
            (let (v2 (%map-get m k :%select-miss-b))
              (if (= v2 :%select-miss-b) nil [k v2]))
            [k v]))))))

(defn reduce-kv (m init f)
  "Fold over the entries of map `m`, calling `(f acc k v)`, starting from `init`."
  (fold (%map-pairs m) init (fn (acc p) (f acc (first p) (second p)))))
(sig reduce-kv (map any any -> any))

;; ---- zipmap (ADR-251) -------------------------------------------------------
;; Published here rather than bare: it RETURNS a map, so it belongs with the map
;; helpers. The implementation is the prelude `%zipmap` internal, because
;; `defrecord`'s expansion builds its constructor body with it at boot.

(defn zipmap (ks vs)
  "A map pairing each key in `ks` with the value at the same position in `vs`,
stopping at the shorter.

    (map/zipmap [:a :b] [1 2])   → {:a 1 :b 2}"
  (%zipmap ks vs))
