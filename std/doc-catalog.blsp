(defmodule doc-catalog
  "The Brood function catalogue: every public builtin and prelude function mapped to a
  functional category (math, strings, filesystem, processes, and so on), plus the category
  order and display titles. Shared by nest docs --all and hive's hosted /reference so both
  present the language reference identically. Regenerate when the builtin/prelude surface
  changes; a name absent from the catalog categorises as :other.")

(def *category-order*
  [[:math "Math and numbers"]
    [:strings "Strings and text"]
    [:collections "Sequences and collections"]
    [:maps "Maps and records"]
    [:sets "Sets"]
    [:bytes "Bytes and binary"]
    [:predicates "Predicates"]
    [:convert "Types and conversion"]
    [:control "Control flow and macros"]
    [:patterns "Pattern matching"]
    [:functions "Functions and combinators"]
    [:io "Input and output"]
    [:filesystem "Filesystem"]
    [:processes "Processes and concurrency"]
    [:errors "Errors"]
    [:meta "Modules and reflection"]
    [:system "System and environment"]
    [:other "Other"]])

(def *catalog*
  {"*" :math
   "*err*" :io
   "*out*" :io
   "*show*" :meta
   "+" :math
   "-" :math
   "->" :control
   "->>" :control
   "->decimal" :convert
   "->float" :convert
   "-conj" :meta
