;; std/show.blsp — the display protocol for printing. (require 'show) / (:use show).
;;
;; Elixir's `String.Chars` for Brood: an OPEN generic that turns a value into the
;; string the screen printers show, so a record can define how it prints instead of
;; leaking its raw map form. Built entirely in Brood on the `ability` system (ADR-168)
;; — Rust hosts only the fast native renderer this falls back to.
;;
;; Design:
;;   - `(to-str x)` is the protocol op. Dispatches on x's identity: a record with a
;;     `Display` impl returns that; everything else falls to the `:default` impl,
;;     which is the native `str` — so an un-customized value prints exactly as before.
;;   - Loading this module makes the protocol AVAILABLE (the ability + any impls a
;;     library ships) but changes nothing on its own. The screen printers honor it
;;     only after the APP calls `(display-on)`, which installs the per-argument hook
;;     into the prelude's `*show*`. A library ships `impl Display …` proposals; the
;;     app disposes (ADR-172 §5/§8). `(display-off)` / `(binding (*show* nil) …)` undo it.
;;   - Only a RECORD argument is routed through `to-str` (built-ins stay on the fast
;;     native render — zero dispatch cost).
;;   - Scope is the SCREEN printers, matching the request ("printing to screen"):
;;     `str`/`pr-str`/`fmt` stay native. Reach for `(to-str x)` explicitly to honor
;;     the protocol inside a `str`/`fmt` (the Elixir `to_string` move).

(defmodule show
  "Display protocol for printing — Elixir's `String.Chars`, in Brood.

    (require 'show)                       ; make the Display protocol available
    (display-on)                          ; APP opt-in: screen printers now honor it
    (defmodule money (:use ability) (:use show))
    (defrecord* usd (cents))
    (impl Display money/usd
      (to-str [m] (str \"$\" (to-fixed (/ (get m :cents) 100.0) 2))))
    (println (usd 1050))                  ; => $10.50   (not a raw map)

`(to-str x)` converts any value to its display string: a record dispatches on its
nominal id (custom impl, else the native `str`); every built-in falls to `:default`
(the native `str`), so un-customized values are unchanged. `(display-on)` wires the
screen printers (`print`/`println`/`eprint`/`eprintln`) to honor it via the prelude's
`*show*` hook — an APP-level step, never a side effect of loading; `(display-off)`
restores the default, and `(binding (*show* nil) body…)` disables it for a scope.

Two protocols, mirroring Elixir:
  - **`Display`** / `(to-str x)` — the human display form (Elixir's `String.Chars`),
    what the screen printers show.
  - **`Inspect`** / `(inspect x)` — the debug form for logs / the REPL (Elixir's
    `Inspect`), plus `(inspectln x)` (the `IO.inspect` move; returns `x`). Distinct
    from `pr-str`, which must round-trip; `inspect` carries no such contract.

**Shipping an impl with a library:** put the `impl` at the TOP LEVEL of the module
that defines the record — loading the module (which a user must do to reach the
record) registers the impl, exactly like Elixir's `defimpl`. The impl is inert until
the APP calls `(display-on)`; a library must not call it itself (ADR-172 §5)."
  (:use ability))

;; The protocol. One op: a value → its display string. The `:default` impl is the
;; native `str`, so this is a pure *extension* seam — nothing prints differently
;; until a record supplies its own impl AND the app calls `(display-on)`.
(defability Display
  "A value's human display string — what `print`/`println` show for it." (to-str [self] :-> string))

;; Every built-in kind, and every record without a custom impl, lands here: the
;; native `str` — i.e. exactly what printing produced before this module loaded.
(impl Display :default (to-str [x] (str x)))

;; `Inspect` — the DEBUG form (Elixir's `Inspect`, Haskell's `Show`), the companion
;; to `Display`. `(inspect x)` is what you want in a log line or a REPL: unambiguous,
;; type-revealing, and free to include a wrapper a human reads (`#money<$10.50>`).
;; It is DISTINCT from `pr-str` on purpose — `pr-str` must *round-trip* (its output
;; re-reads to the same value), so it is a kernel guarantee this protocol must not
;; override. `inspect` carries no round-trip contract, so a record may shape it
;; freely. `:default` is `pr-str` (the readable form) for everything uncustomised.
(defability Inspect
  "A value's debug string — for logs / the REPL. Unlike `pr-str`, need not re-read."
  (inspect [self] :-> string))

(impl Inspect :default (inspect [x] (pr-str x)))

(defn inspectln (x)
  "Print `x`'s debug form (`inspect`) followed by a newline — the `IO.inspect` move,
  for tracing. Returns `x`, so it drops into a pipeline: `(-> v f inspectln g)`."
  (println (inspect x))
  x)

;; The per-print-argument hook `display-on` installs into `*show*`. Only a RECORD is
;; routed through `to-str` (a `defrecord*` value is the sole thing that can carry a
;; custom impl); every other value passes through untouched so the built-in renderer
;; stays on the fast path — no `identity-of`/`impl-for` lookup per printed int or string.
(defn show--print-hook (x)
  (if (record? x) (to-str x) x))

;; Activation is an explicit APP step, never a side effect of loading (ADR-172 §5/§8:
;; a library ships `impl Display` proposals; the app decides whether the screen
;; printers honor them). `display-on` is an ordinary `def` of the prelude's ambient
;; `*show*` dynamic var, so it takes effect process-wide — and across spawned
;; processes on their next print — Erlang-style. A library must NOT call it.
(defn display-on ()
  "Activate protocol printing: `print`/`println`/`eprint`/`eprintln` route each RECORD
  argument through `to-str`. An APP-level opt-in — call it once from your entry point;
  a library only registers impls, it never flips this. Reversible with `display-off`."
  (def *show* show--print-hook)
  nil)

(defn display-off ()
  "Deactivate protocol printing (restore the prelude default): records print their raw
  map form again. Scoped disabling for one call is `(binding (*show* nil) …)`."
  (def *show* nil)
  nil)
