;; std/string.blsp — the string-manipulation library (ADR-230).
;;
;; A namespace (ADR-065): its functions are `string/trim`, `string/split`,
;; `string/pad-left`, … — call them qualified, or `(:use string)` to refer them
;; bare. This is the home for every operation whose *subject is a string*:
;; trimming, padding, case, search, splitting/joining, and the char-content
;; conversions.
;;
;; What lives here vs. bare in the prelude — the boundary rule (ADR-230):
;;   - `string/*`  = "the first argument is a string" (this module).
;;   - bare        = operations over ANY collection (`map`/`filter`/`reduce`/`count`/
;;                   `contains?`/`includes?`/`index-of`/`join`? no — `join`
;;                   is string-flavoured, so it is here), plus the primitives
;;                   `str`/`string?`/`string`.
;;   - The scalar bridges that REINTERPRET a string as another type are
;;     `string/->number` and `string/->symbol`: module-rooted, and the source drops
;;     out of the name because the module already says it (the same rule as
;;     `string/->bytes` / `string/bytes->`). They were bare `string->number` /
;;     `string->symbol`, which read as a third naming convention beside `str` and
;;     `->float`; the reverse direction is `str`, which is bare and generic.
;;
;; Kernel seam: the low-level primitives are Rust builtins registered directly under
;; their `string/…` names — `string/substring` `string/split`
;; `string/upper` `string/lower` `string/normalize` `string/span`/`span-until`
;; `string/grapheme-*`/`substring-graphemes` `string/->codepoints`/`->graphemes`.
;; The functions below are pure Brood over those. Brood has no distinct char type, so
;; a "character" is a 1-char string; all indices are char-based, matching
;; `count` of a string. The helpers are tail-recursive (stack-safe over long strings).
;;
;; This module is `require`d by the prelude itself (its own `get`/`path-*`/`fmt`
;; helpers call `string/char-at`/`string/starts-with?`/… by late binding), so it is
;; always loaded — but it is still an ordinary embedded module: doc tooling sees it,
;; and a project may `(:use string)`.
(defmodule string
  "The string-manipulation library — every operation whose subject is a string:
trimming, padding, case folding, search, split/join, and char-content conversions.
The low-level primitives (`string/substring` `string/split`
`string/upper` `string/lower` …) are Rust builtins; the rest is pure Brood over them.
Bare-in-the-prelude by contrast: the generic collection ops (`map`/`filter`/`count`/
`contains?`/`includes?`/`index-of`). The scalar bridges that reinterpret a string as
another type live here too, module-rooted: `string/->number`, `string/->symbol`.")

;; ---- case -------------------------------------------------------------------

(defn capitalize (s:string -> string)
  "Return `s` with the first character upper-cased and the rest lower-cased.

    (string/capitalize \"hi there\")   ;=> \"Hi there\""
  (if (= (count s) 0)
    s
    (str (string/upper (string/substring s 0 1)) (string/lower (string/substring s 1)))))

(defn fold-case (s:string -> string)
  "`s` case-folded for comparison, **one character per character** — so an index into the
result is an index into `s`.

That property is the whole point, and `string/lower` does not have it: full Unicode
lowercasing is not a function on characters. `\"İ\"` (U+0130, one character) lowercases to
two, so a caller that folded a whole document to search it case-insensitively would get
back offsets into a string that does not exist, and land its match on the wrong
characters. Every character whose lowercase is not a single character is left as it is,
which is the *simple* case fold — what a text editor's case-insensitive search means.

Native (`%fold-case`): this is a per-character transform over a WHOLE string, and the
string is routinely a whole document — incremental search folded the buffer on every
keystroke, and the interpreted `map` + `join` below was most of the 148 ms that cost on a
5,700-line file. (Search no longer folds the buffer at all — `buffer-search-forward` streams
the rope through `%rope-find` — but every other caller gets the same fold for a pass instead
of a per-character interpreted loop.)

    (string/fold-case \"AbÇ\")   ;=> \"abç\""
  (%fold-case s))

(defn has-upper? (s:string -> bool)
  "Does `s` contain a character that case-folds to something else — i.e. did someone type
an upper-case letter?

The question an editor's search asks to decide whether to be case-sensitive (Emacs'
`isearch-no-upper-case-p`): a lower-case pattern matches anything, and the moment you
type a capital you meant it. Asked by FOLDING rather than by comparing against
`string/upper`, so a character with no case — a digit, a bracket, CJK — answers no.

    (string/has-upper? \"foo\")   ;=> false"
  (not (= s (fold-case s))))

;; ---- char access & content conversions --------------------------------------

(defn char-at (s:string i:int -> string)
  "The character (a 1-char string) at char index `i` of `s`.

    (string/char-at \"abc\" 1)   ;=> \"b\""
  (string/substring s i (inc i)))

(defn ->list (s:string -> (list string))
  "The characters of `s` as a list of 1-char strings.

    (string/->list \"ab\")   ;=> (\"a\" \"b\")"
  ;; One native O(n) `chars()` pass (via `string/split` on the empty separator). A
  ;; pure-Brood `(string/substring s i (inc i))` loop is O(n^2) — `substring` walks to char
  ;; boundary `i` each call — which silently makes every `(into [] (string/->list s))`
  ;; code-point vector O(n^2) to build (it defeated the json/base64 char-indexing
  ;; rewrites; see docs/devlog.md).
  (string/split s ""))

(defn list-> (cs)
  "Concatenate a list of strings (e.g. from `string/->list`) into one string.

    (string/list-> [\"a\" \"b\"])   ;=> \"ab\""
  (apply str cs))

(defn codepoints-> (cs:seqable -> string)
  "Build a string from a list (or vector) of Unicode codepoint integers — the
inverse of the `string/->codepoints` primitive.

    (string/codepoints-> [104 105])   ;=> \"hi\""
  ;; One native O(n) pass. This was `(apply str (map int->char cs))`, which allocated a
  ;; seq view, called a closure per code point to make a ONE-CHARACTER string, and then
  ;; concatenated N of those variadically — for a shape every text parser in std/ uses to
  ;; get back from the code vector `string/->codepoints` handed it.
  (%codepoints->string cs))

(defn ->bytes (s:string -> bytes)
  "Encode string `s` as a bytes value — its UTF-8 bytes. Inverse of `string/bytes->`.

    (string/->bytes \"hi\")  ;=> #b\"hi\""
  (%string->utf8-bytes s))

(defn bytes-> (b: (or nil bytes (list int) (vector int)) &optional mode:keyword -> string)
  "Decode UTF-8 bytes back to a string — a bytes value, or a list or vector of byte ints
(nil is the empty case). Inverse of `string/->bytes`. Invalid UTF-8 raises; pass
`:lossy` to read each invalid sequence as U+FFFD instead — text off the wire (a mail
part, a legacy file) is not always what it claims to be.

    (string/bytes-> #b\"hi\")   ;=> \"hi\"
    (string/->codepoints (string/bytes-> [104 255 105] :lossy))   ;=> [104 65533 105]"
  (%utf8-bytes->string b (= mode :lossy)))

(def- number->digits "0123456789abcdefghijklmnopqrstuvwxyz")

(defn- number->loop (n radix acc)
  "The digits of non-negative `n` in `radix`, most significant first, consed onto `acc`."
  (let (d (string/char-at number->digits (math/rem n radix))
        acc (str d acc))
    (if (< n radix) acc (number->loop (math/quot n radix) radix acc))))

(defn number-> (n:int &optional (radix:int 10) -> string)
  "Render integer `n` in `radix` (2..36, 10 by default), lowercase digits, a leading `-`
for a negative — the inverse of `string/->number` with the same radix contract, so
`(string/->number (string/number-> n 16) 16)` is `n`. The hex/octal/binary rendering
`string/format`'s `%x` builds on.

    (string/number-> 255 16)   ;=> \"ff\"
    (string/number-> -5 2)     ;=> \"-101\""
  (cond
    (or (< radix 2) (> radix 36)) (error "string/number->: radix must be 2..36, got " radix)
    (< n 0) (str "-" (number->loop (- n) radix ""))
    else (number->loop n radix "")))

;; ---- join -------------------------------------------------------------------

;; Collect `coll`'s elements interleaved with `sep` into a parts list (tail-
;; recursively, reversed), then build the string in one `apply str` pass.
;; Byte-identical to `seq/interpose-acc`, deliberately. `string/join` is one of the ops the
;; PRELUDE reaches for (it loads `string` at the first lookup that misses, ADR-335), and routing it through
;; `seq/interpose` would make every `join` drag in a second module. Three lines of
;; duplication buys that; noted here and there so neither looks like an oversight.
(defn- join-parts (sep coll acc)
  (if (empty? coll) acc (join-parts sep (rest coll) (cons (first coll) (cons sep acc)))))
(defn join (coll:any sep:any -> string)
  "Concatenate the strings in `coll` with `sep` between adjacent elements.

    (string/join [\"a\" \"b\" \"c\"] \", \")   ;=> \"a, b, c\"
    (string/join [\"solo\"] \"-\")         ;=> \"solo\"
    (string/join [] \",\")               ;=> \"\""
  ;; For the common case — a string separator over a list/vector/range — the
  ;; native `%string-join` walks `coll` once into one buffer (no intermediate
  ;; parts list, no reverse). The all-Brood path stays as a fallback for an
  ;; exotic (non-string) separator: it builds the interleaved parts list
  ;; (reversed) then concatenates in one `apply str` pass.
  ;; A lazy seq-view is realised first (the native walks it via `seq_items`,
  ;; which can't run a transducer). NOTE: this materialises the mapped strings —
  ;; the `strings` benchmark's full fusion would need a string-builder reducer
  ;; (a follow-up); join over a view behaves as over the eager `map` result.
  (let (coll (if (seqview? coll) (seq coll) coll))
    (if (string? sep)
      (%string-join sep coll)
      (if (empty? coll)
        ""
        (apply str (cons (first coll) (reverse (join-parts sep (rest coll) nil))))))))

;; ---- search & replace -------------------------------------------------------

(defn replace (s:string old:string new:any -> string)
  "Return `s` with every occurrence of `old` replaced by `new`. An empty `old`
leaves `s` unchanged.

    (string/replace \"a-b-c\" \"-\" \"+\")   ;=> \"a+b+c\"
    (string/replace \"aaa\" \"aa\" \"b\")    ;=> \"ba\"    ; left to right, no rescan
    (string/replace \"abc\" \"zz\" \"!\")    ;=> \"abc\""
  (if (= old "") s (join (string/split s old) new)))

;; String-only, so it lives here (ADR-230); its forward partner `index-of` stays bare
;; because that one is polymorphic over strings, lists and vectors.
(defn last-index-of (s:any needle:any &optional before:any -> int)
  "The 0-based char index of the **last** occurrence of `needle` in string `s` whose
start is strictly **before** `before` (default `(count s)`), or -1 if there is
none. The backward counterpart of `(index-of s needle from)` — what reverse
incremental search rides on.

    (string/last-index-of \"a.b.c\" \".\")   ;=> 3
    (string/last-index-of \"a.b.c\" \".\" 3)   ;=> 1
    (string/last-index-of \"xaaay\" \"aa\")   ;=> 2
    (string/last-index-of \"abc\" \"z\")   ;=> -1"
  ;; One native pass: a forward walk over `index-of` is O(matches × length), and this is
  ;; an editor hot path (reverse search, finding a line's start per keystroke).
  (%str-last-index-of s needle (or before (count s))))

(defn starts-with? (s:string prefix:string -> bool)
  "Does string `s` begin with `prefix`?

    (string/starts-with? \"hello\" \"he\")   ;=> true
    (string/starts-with? \"hello\" \"lo\")   ;=> false
    (string/starts-with? \"hello\" \"\")     ;=> true"
  (let (n (count prefix))
    (and (>= (count s) n) (= (string/substring s 0 n) prefix))))

(defn ends-with? (s:string suffix:string -> bool)
  "Does string `s` end with `suffix`?

    (string/ends-with? \"hello\" \"lo\")   ;=> true
    (string/ends-with? \"hello\" \"he\")   ;=> false"
  (let (sl (count s) ql (count suffix))
    (and (>= sl ql) (= (string/substring s (- sl ql) sl) suffix))))

(defn drop-prefix (s prefix)
  "`s` without its leading `prefix`, or `s` unchanged when it does not start with it.

    (string/drop-prefix \"v1.2.0\" \"v\")   ;=> \"1.2.0\"
    (string/drop-prefix \"1.2.0\" \"v\")    ;=> \"1.2.0\""
  (if (starts-with? s prefix) (string/substring s (count prefix)) s))

(defn drop-suffix (s suffix)
  "`s` without its trailing `suffix`, or `s` unchanged when it does not end with it.

    (string/drop-suffix \"main.blsp\" \".blsp\")   ;=> \"main\"
    (string/drop-suffix \"line\\r\" \"\\r\")         ;=> \"line\"
    (string/drop-suffix \"main\" \".blsp\")        ;=> \"main\""
  (if (ends-with? s suffix) (string/substring s 0 (- (count s) (count suffix))) s))

;; ---- whitespace: trimming & blank test --------------------------------------

;; The four characters `whitespace?` names, as one set for the native `string/span` —
;; which skips a run of them in Rust, where walking `char-at` allocated a one-character
;; string per step.
(def- whitespace-chars " \t\n\r")

(defn- whitespace? (c) (or (= c " ") (= c "\t") (= c "\n") (= c "\r")))

(defn blank? (s:string -> bool)
  "Is `s` empty or made up only of whitespace?

    (string/blank? \"  \")   ;=> true
    (string/blank? \" a \")  ;=> false"
  (= (string/span s 0 whitespace-chars) (count s)))

(defn trim-left (s:string -> string)
  "Remove leading whitespace from `s`.

    (string/trim-left \"  a\")   ;=> \"a\""
  (let (start (string/span s 0 whitespace-chars))
    (if (= start 0) s (string/substring s start (count s)))))

(defn- trim-right-to (s:string n:int end:int -> string)
  (if (and (> n 0) (whitespace? (char-at s (dec n))))
    (trim-right-to s (dec n) end)
    (if (= n end) s (string/substring s 0 n))))

(defn trim-right (s:string -> string)
  "Remove trailing whitespace from `s`.

    (string/trim-right \"a  \")   ;=> \"a\""
  (let (end (count s)) (trim-right-to s end end)))

(defn trim (s:string -> string)
  "Remove leading and trailing whitespace from `s`.

    (string/trim \"  a \")   ;=> \"a\""
  (trim-left (trim-right s)))

;; ---- padding & repetition ---------------------------------------------------
;; Column formatting for tabular/console output. `pad-*` left unchanged when the
;; string already meets the width (they never truncate).

(defn pad-left (s:string w:int &optional (pad:string " ") -> string)
  "Right-justify `s` in a field of width `w`, padding with `pad` (a single-character string, a space by default) on the left; `s` is returned unchanged if it is already at least `w` wide.

    (string/pad-left \"7\" 3)    ;=> \"  7\""
  (let (n (count s)) (if (>= n w) s (str (repeat (or pad " ") (- w n)) s))))

(defn pad-right (s:string w:int &optional (pad:string " ") -> string)
  "Left-justify `s` in a field of width `w`, padding with `pad` (a single-character string, a space by default) on the right; `s` is returned unchanged if it is already at least `w` wide.

    (string/pad-right \"7\" 3)   ;=> \"7  \""
  (let (n (count s)) (if (>= n w) s (str s (repeat (or pad " ") (- w n))))))

;; ---- fitting text to SCREEN CELLS --------------------------------------------
;; `pad-*` and `length` count characters, and a character is not a column: an emoji or a
;; CJK glyph takes two cells and a combining mark none. A mode line or a menu row laid out by
;; character count pushed everything after a wide name out of line with what was painted,
;; and the click zones with it. These measure with `display-width` and cut with
;; `width->index`, so a wide glyph is either whole or gone — never split.

(defn clip-cells (s w &optional (ellipsis nil))
  "`s` cut to at most `w` display cells. With an `ellipsis` (say `\"…\"`), a string that had
to be cut ends with it, the ellipsis's own cells counted inside `w`.

    (string/clip-cells \"abcdef\" 3)   ;=> \"abc\"
    (string/clip-cells \"日本語\" 3)   ;=> \"日\"
    (string/clip-cells \"abcdef\" 4 \"…\")   ;=> \"abc…\"
    (string/clip-cells \"abc\" 4 \"…\")   ;=> \"abc\""
  (cond
    (<= (string/display-width s) w) s
    (nil? ellipsis) (string/substring s 0 (string/width->index s (math/max 0 w)))
    else
      (let (room (math/max 0 (- w (string/display-width ellipsis))))
        (str (string/substring s 0 (string/width->index s room)) ellipsis))))
(sig clip-cells (string int &optional (or string nil) -> string))

(defn pad-right-cells (s:string w:int -> string)
  "`s` padded with spaces to exactly `w` display cells — or clipped to them (`clip-cells`)
when it is wider, so a bar always spans its field.

    (string/pad-right-cells \"日\" 4)   ;=> \"日  \"
    (string/pad-right-cells \"abcdef\" 3)   ;=> \"abc\""
  (let (fitted (clip-cells s w)
        n (string/display-width fitted))
    (if (>= n w) fitted (str fitted (repeat " " (- w n))))))

;; ---- fill: greedy word-wrap -------------------------------------------------

(defn- fill-pack (acc word prefix width)
  "Greedy line-accumulator step. `acc` is `[cur done]`: the current (in-progress) line and
the completed lines, newest first. Extend `cur` with `word` when the line — `prefix` and all —
still fits in `width` display columns (a wide glyph two, a tab to its tab stop at
`*tab-width*`, as `string/display-width` counts them); otherwise flush `cur` onto `done` and start a
fresh line at `word`. Prepending to `done` is O(1) (the caller reverses once)."
  (let ([cur done] acc)
    (cond
      (= cur "") [word done]
      (<= (string/display-width (str prefix cur " " word)) width) [(str cur " " word) done]
      else [word (cons cur done)])))

(defn fields (s:string &optional (sep:string " ") -> (or nil (list string)))
  "The non-empty, whitespace-trimmed pieces of `s` split on `sep` (default a single
space) — the tokens, where `split` is the exact partition. Stray and doubled separators
therefore vanish instead of producing empty pieces, and the result MAY be empty (nil),
which is why this is its own function rather than a flag on `split`: `split` always
returns at least one piece, and the checker leans on that.

    (string/fields \" 1  2 \")   ;=> (\"1\" \"2\")
    (string/fields \"a , b,,\" \",\")   ;=> (\"a\" \"b\")
    (string/fields \"   \")   ;=> nil"
  (seq/reject (map (split s sep) trim) empty?))

(defn- fill-unprefix (line prefix)
  ;; `line` without `prefix` when it starts with it, else as it is
  (if (and (not (= prefix "")) (starts-with? line prefix))
    (substring line (count prefix) (count line))
    line))

(defn fill (s:string width:any &optional (prefix:any "") -> string)
  "Greedily wrap `s` to `width` columns: collapse every run of whitespace (newlines, tabs,
spaces) to a single space, then re-break on word boundaries so each line is as full as it
can be without exceeding `width`. A single word longer than `width` keeps its own
(over-long) line rather than being split. Returns the rewrapped text, lines joined by
`\\n`; the empty string for blank input.

With a `prefix` — a comment's `;; `, a quote's `> `, an indent — it is taken off every input
line that starts with it and put on every output line, inside `width`. Without it a
commented paragraph came back as one line with the markers in the middle of it (`;; aa ;;
bb`).

A `prefix` may also be a pair `[first rest]`: the first line's prefix, then every later
line's — a HANGING indent. A list item keeps its bullet on the first line and its text
lined up under it after (`[\"- \" \"  \"]`); a paragraph whose first line is indented further
than the rest keeps both. Each line's room is `width` less its own prefix. [[fill-prefixes]]
finds the pair a paragraph uses, [[fill-prefix]] the first of them.

`width` is in display COLUMNS, as an editor's fill column is: a wide glyph counts two and a tab
reaches its tab stop at `*tab-width*` (`string/display-width`).

    (string/fill \"abc\" 10)   ;=> \"abc\"   ; already fits, so unchanged
    (string/fill \";; aa\\n;; bb\" 20 \";; \")   ;=> \";; aa bb\"
    (string/fill \"- aa bb cc\" 7 [\"- \" \"  \"])   ;=> \"- aa bb\\n  cc\""
  (let ([first-prefix rest-prefix] (if (string? prefix) [prefix prefix] prefix)
        lines (split s "\n")
        body (join (cons (fill-unprefix (first lines) first-prefix)
                     (map (rest lines) (fn (line) (fill-unprefix line rest-prefix))))
               "\n")
        flat (replace (replace body "\n" " ") "\t" " ")
        words (fields flat)
        ;; the line being packed is the first while no line is done
        [cur done] (fold words
                     ["" ()]
                     (fn (acc w)
                       (fill-pack acc w (if (empty? (second acc)) first-prefix rest-prefix) width)))
        filled (reverse (if (= cur "") done (cons cur done))))
    (if (empty? filled)
      ""
      (join (cons (str first-prefix (first filled))
              (map (rest filled) (fn (line) (str rest-prefix line))))
        "\n"))))

;; Emacs's `adaptive-fill-regexp`, in two parts. A line's MARKER is its indentation and a
;; comment or quote marker with the space after it — kept on every line of the paragraph. Its
;; BULLET, after that, is a list item's: `-` `+` `*` `•`, `1.` `2)`, and an Org checkbox —
;; kept on the first line only, the lines after it lined up under the item's text. A bullet
;; needs the space after it, so `*emphasis*` and `-flag` are words.
(def- fill-default-markers
  ;; the comment and quote markers a paragraph's lines keep when the caller names none — the
  ;; common cases of every language at once; an editor passes its mode's own
  [";" "#" "//" "--" ">"])
(def- fill-bullet-pattern "^(?:[-+*•]|[0-9]+[.)])[ \t]+(?:\\[[ xX-]\\][ \t]+)?")

(defn- fill-marker-pattern (markers)
  ;; indentation, then any run of `markers` (each repeatable: `;;`, `###`, `> >`) with the
  ;; spaces after them
  (if (empty? markers)
    "^[ \t]*"
    (str "^[ \t]*(?:(?:"
      (join (map markers (fn (marker) (str "(?:" (regex/escape marker) ")+"))) "|")
      ")[ \t]*)*")))

(defn- fill-match (pattern line)
  ;; the text `pattern` matches at the start of `line`, or ""
  (let (m (regex/find line pattern)
        text (if m (get m :text) nil))
    (if (string? text) text "")))

(defn- fill-bullet (line marker)
  ;; the list bullet after `marker` at the start of `line`, or ""
  (fill-match fill-bullet-pattern (substring line (count marker) (count line))))

(defn fill-prefixes (s:string &optional (markers:any nil) -> (tuple string string))
  "The `[first rest]` prefixes paragraph `s` fills with ([[fill]]): what its first line keeps,
and what every line after it starts with — Emacs's adaptive fill (`fill-context-prefix`).

The first is the first non-blank line's indentation, comment or quote marker and list bullet
(`-`, `+`, `*`, `•`, `1.`, `2)`, an Org `[ ]`). The markers are `markers` — a mode's own, Emacs's
`adaptive-fill-regexp` per mode: `[\"#\"]` for Python, `[\"//\" \"*\"]` for a C block comment's
` * ` lines, `[\">\"]` for prose — else the common ones of every language at once (`;` `#`
`//` `--` `>`). Only a marker
is kept on every line: in C, `#include` is no comment. The rest is the SECOND line's
indentation and marker when there is one — the paragraph says how it continues, so a hanging
indent, a comment and a docstring's indentation are all kept as written. A one-line paragraph
continues with its first prefix, its bullet turned to spaces: a list item's text lines up under
the item.

    (string/fill-prefixes \"  ;; hello\")   ;=> [\"  ;; \" \"  ;; \"]
    (string/fill-prefixes \"- item\")   ;=> [\"- \" \"  \"]
    (string/fill-prefixes \"1. first\\n   second\")   ;=> [\"1. \" \"   \"]
    (string/fill-prefixes \"> > quoted\")   ;=> [\"> > \" \"> > \"]
    (string/fill-prefixes \"#include <a.h>\" [\"//\" \"*\"])   ;=> [\"\" \"\"]"
  (let (pattern (fill-marker-pattern (if (nil? markers) fill-default-markers markers))
        lines (seq/reject (split s "\n") blank?)
        line (if (empty? lines) "" (first lines))
        marker (fill-match pattern line)
        bullet (fill-bullet line marker)
        first-prefix (str marker bullet))
    (cond
      (> (count lines) 1) [first-prefix (fill-match pattern (second lines))]
      (= bullet "") [first-prefix first-prefix]
      ;; the bullet's characters become spaces; a tab after it stays a tab
      else [first-prefix (str marker (regex/replace bullet "[^ \t]" " "))])))

(defn fill-prefix (s:string &optional (markers:any nil) -> string)
  "The fill prefix of paragraph `s`'s first line: its indentation, a comment or quote marker
(of `markers`, else every language's common ones) with the space after it, and a list bullet — the first of
[[fill-prefixes]]. Emacs's adaptive fill, for the common cases.

    (string/fill-prefix \"  ;; hello\")   ;=> \"  ;; \"
    (string/fill-prefix \"    code\")   ;=> \"    \"
    (string/fill-prefix \"* item\")   ;=> \"* \"
    (string/fill-prefix \"plain\")   ;=> \"\""
  (first (fill-prefixes s markers)))

(defn repeat (s:string n:int -> string)
  "The string `s` concatenated `n` times (the empty string if `n` <= 0).

    (string/repeat \"ab\" 3)   ;=> \"ababab\""
  ;; Doubling — O(log n) concatenations of O(n) total work. A gibibyte is the ceiling:
  ;; past it the allocation fails as an abort, not an error, and a width that large is a
  ;; typo or an attack.
  (when (> (* (count s) (math/max 0 n)) 1073741824)
    (error "string/repeat: " (* (count s) n) " characters is too large (max 1073741824)"))
  (%repeat-doubling "" s n))
(defn- %repeat-doubling (acc piece k)
  (cond
    (<= k 0) acc
    (= k 1) (str acc piece)
    else
      (%repeat-doubling (if (= (math/rem k 2) 1) (str acc piece) acc)
        (str piece piece)
        (math/quot k 2))))

;; ---- interpolation and printf ------------------------------------------------
;; `string/interp` is a MACRO, so nothing in the prelude's own expansion may use it.

;; `(string/interp "…{expr}…")` builds a string from a template, splicing the value of each
;; `{expr}` hole — any Brood expression, read at macro-expansion time — between the
;; literal chunks. `{{` / `}}` are literal braces; braces *inside* a hole nest, so
;; `{ {:a 1} }` reads a map. It expands to a plain `(str chunk expr …)`, so there is
;; zero runtime machinery — it is exactly the hand-written `str` call, minus the
;; quote-chopping. Reach for it wherever a message interleaves text and values:
;; `(error (string/interp "json: bad number '{tok}' at index {i}"))`.
(defn- interp-flush (buf parts)
  ;; push the accumulated literal chunk (reversed chars) onto `parts`, if non-empty
  (if (empty? buf) parts (cons (apply str (reverse buf)) parts)))
(defn- interp-hole (chars expr depth parts)
  ;; inside a {…} hole: accumulate the expression text until the matching `}`, then
  ;; `reflect/read-string` it into a form. Braces nest by `depth` (a map/set literal inside).
  (cond
    (empty? chars) (error "string/interp: unterminated '{' in template")
    (and (= (first chars) "}") (= depth 0))
      (interp-lit (rest chars)
        nil
        (cons (reflect/read-string expr) parts))
    (= (first chars) "{") (interp-hole (rest chars) (str expr "{") (inc depth) parts)
    (= (first chars) "}") (interp-hole (rest chars) (str expr "}") (dec depth) parts)
    else (interp-hole (rest chars) (str expr (first chars)) depth parts)))
(defn- interp-lit (chars buf parts)
  ;; scanning literal text: `buf` = reversed literal chars, `parts` = reversed forms
  (cond
    (empty? chars) (reverse (interp-flush buf parts))
    (and (= (first chars) "{") (= (second chars) "{"))
      (interp-lit (rest (rest chars))
        (cons "{" buf)
        parts)
    (and (= (first chars) "}") (= (second chars) "}"))
      (interp-lit (rest (rest chars))
        (cons "}" buf)
        parts)
    (= (first chars) "{") (interp-hole (rest chars) "" 0 (interp-flush buf parts))
    else (interp-lit (rest chars) (cons (first chars) buf) parts)))
(defmacro string/interp (template)
  "Build a string from a template, splicing each `{expr}` hole's value between the literal text: `(string/interp \"x={x} sum={(+ a b)}\")`. `{{`/`}}` are literal braces; braces nest inside a hole. Expands to a plain `(str …)`."
  (if (string? template)
    (cons '/str (interp-lit (string/->list template) nil nil))
    (error "string/interp: template must be a string literal, got " (pr-str template))))

;; ---- string formatting ------------------------------------------------------
;; A small `printf`-style helper for inline rendering. The supported specifiers
;; are a deliberate subset — the common cases for demos and tooling output:
;;   %s    any value, rendered via `str`
;;   %d    integer (any number; the type tag is a hint for the reader, not a
;;         converter — float in / float out, same as %s)
;;   %f    float with 6 fractional digits (matches the C/Java default)
;;   %.Nf  float with N fractional digits, rounded — uses `->fixed`
;;   %%    a literal `%`
;;   %x %X a non-negative integer in hex, lower/upper case (`string/number->`)
;;   %Nd %Ns %Nf %N.Mf %0Nx … a WIDTH before the specifier, right-aligned, zero-filled with
;;         the `0` flag (`%02x` → `0f`, `%8d` → `      42`, `%8.2f` → `    3.14`)
;;   %-Ns %-Nd … the `-` flag left-aligns in the field (`%-6s|` → `ab    |`) — ADR-379
;; Octal isn't built in — `string/number->` covers it explicitly. Errors on an
;; unknown spec or a format string that ends inside one; a missing arg renders
;; as `nil` (debuggable), extra args are ignored.
(defn string/format (template:string & args:any -> string)
  "Render `template`, replacing each %-specifier with the next of `args`. Supports `%s` `%d` `%f` `%.Nf` `%x` `%X` `%%`; a width before any of them right-aligns in a field (`%8d`, `%10s`, `%8.2f`), zero-filled with the `0` flag (`%02x`), and the `-` flag left-aligns (`%-10s`).

    (string/format \"%-6s|%6.2f|%03d\" \"ab\" 3.14159 7)   ;=> \"ab    |  3.14|007\"

The runtime half of the pair with [[string/interp]], which is a MACRO: `(string/interp \"x={x}\")` reads its
values from the surrounding scope and expands to a plain `(str …)` at compile time, so its
template must be a literal. This one parses at CALL time, so its template can be a value —
a config string, a translated message — with the arguments passed separately. Neither
subsumes the other.

Module-rooted rather than bare `format` because that name is also the source FORMATTER
(`std/format.blsp`, the 81 names behind `nest format`), and one word meaning two unrelated
things in the same image is a name worth spending to fix.

    (string/format \"%s has %d items (%.1f%%)\" \"cart\" 3 42.26)   ;=> \"cart has 3 items (42.3%)\""
  (format-loop template 0 (count template) args ""))

(defn- format-loop (template i n args acc)
  ;; The literal run up to the next `%` is copied in one piece (`string/span-until` finds
  ;; it natively), rather than one `char-at` and one `str` per character — which made the
  ;; output quadratic in the template's length.
  (let (j (string/span-until template i "%"))
    (cond
      (> j i) (format-loop template j n args (str acc (string/substring template i j)))
      (>= i n) acc
      else (format-spec template (inc i) n args acc))))

(defn- format-spec (template i n args acc)
  ;; called with `i` pointing one past the `%`
  (let (c (if (< i n) (string/char-at template i) nil)
        emit (fn (text) (format-loop template (inc i) n (rest args) (str acc text))))
    (cond
      (nil? c) (error "string/format: unterminated specifier (lone '%' at end of format string)")
      (= c "%") (format-loop template (inc i) n args (str acc "%"))
      (= c "s") (emit (str (first args)))
      (= c "d") (emit (format-int (first args) i))
      (= c "x") (emit (format-hex (first args) false))
      (= c "X") (emit (format-hex (first args) true))
      (= c "f") (emit (math/->fixed (first args) 6))
      ;; a width: `%8d`, `%02x`, `%10s`, `%8.2f` — digits (a leading 0 asks for zero fill)
      ;; then the specifier; `%-10s` left-justifies instead (ADR-379).
      (format-digit? c) (format-width template i n args acc (= c "0") false 0)
      (= c "-") (format-width template (inc i) n args acc false true 0)
      (= c ".") (format-prec template (inc i) n args acc 0)
      else (error (str "format: unrecognized specifier '%" c "' at column " i)))))

(defn- format-digit? (c)
  (let (d (string/->number c)) (and (int? d) (>= d 0) (<= d 9))))

(defn- format-hex (v upper?)
  "`v` in hex for `%x`/`%X`; a non-integer or a negative renders via `str` (readable, not
wrong), the way `%d` passes a float through."
  (if (and (int? v) (>= v 0))
    (let (h (string/number-> v 16)) (if upper? (string/upper h) h))
    (str v)))

(defn- format-width (template i n args acc zero? left? w)
  ;; called with `i` at a width digit (or just past a `-`); accumulates the width in `w`,
  ;; then applies it to the specifier that ends it: `d`/`x`/`X`/`s` right-aligned (`0`
  ;; fills with zeros), `-` left-aligned, and `f`/`.Nf` for a float in a field
  (cond
    (>= i n) (error "format: unterminated width specifier")
    (format-digit? (string/char-at template i))
      (let (d (string/->number (string/char-at template i)))
        (format-width template (inc i) n args acc zero? left? (if (int? d) (+ (* w 10) d) w)))
    (= (string/char-at template i) ".")
      (format-width-prec template (inc i) n args acc zero? left? w 0)
    else
      (let (c (string/char-at template i)
            body (cond
                   (= c "d") (format-int (first args) i)
                   (= c "s") (str (first args))
                   (= c "f") (math/->fixed (first args) 6)
                   (= c "x") (format-hex (first args) false)
                   (= c "X") (format-hex (first args) true)
                   else
                     (error (str "format: a width takes d, s, f, x or X, got '" c "' at column " i))))
        (format-loop template (inc i) n (rest args) (str acc (format-pad body w zero? left?))))))

(defn- format-width-prec (template i n args acc zero? left? w p)
  ;; `%8.2f` — a precision after a width; `i` is one past the `.`
  (cond
    (>= i n) (error "format: unterminated %W.Nf specifier")
    (format-digit? (string/char-at template i))
      (let (d (string/->number (string/char-at template i)))
        (format-width-prec template (inc i) n args acc zero? left? w (if (int? d) (+ (* p 10) d) p)))
    (= (string/char-at template i) "f")
      (format-loop template
        (inc i)
        n
        (rest args)
        (str acc (format-pad (math/->fixed (first args) p) w zero? left?)))
    else
      (error (str "format: a precision takes f, got '" (string/char-at template i) "' at column " i))))

;; `%d` takes an integer, and refuses anything else rather than rendering it with `str`.
(defn- format-int (v i)
  (if (int? v)
    (str v)
    (error (str "format: %d expects an integer, got " (pr-str v) " at column " i))))

;; A width past this is a typo or an attack, and the padding it asks for is built
;; through a range, whose own refusal named a mechanism the caller never saw.
(def- format-max-width 1000000)

(defn- format-pad (body w zero? left?)
  (when (> w format-max-width)
    (error "format: width " w " too large (max " format-max-width ")"))
  (cond
    left? (string/pad-right body w)
    zero? (string/pad-left body w "0")
    else (string/pad-left body w)))

(defn- format-prec (template i n args acc p)
  ;; called with `i` pointing one past the `.`, accumulating precision in `p`
  (cond
    (>= i n) (error "format: unterminated %.Nf specifier")
    (= (string/char-at template i) "f")
      (format-loop template
        (inc i)
        n
        (rest args)
        (str acc (math/->fixed (first args) p)))
    (format-digit? (string/char-at template i))
      (let (d (string/->number (string/char-at template i)))
        (format-prec template (inc i) n args acc (if (int? d) (+ (* p 10) d) p)))
    else
      (error (str "format: expected digit or 'f' after '.' in specifier, got '"
               (string/char-at template i)
               "' at column "
               i))))

;; ---- mixed scripts (homoglyphs, ADR-710) --------------------------------------------------
;; A Cyrillic `а` looks like a Latin `a`, so `pаypal` reads as `paypal` and is not. Unicode's
;; TR39 names the check: a word (an identifier, a domain name, a sender) should be written in
;; one script — with the combinations real text uses: Han with kana (Japanese), with Hangul
;; (Korean), with Bopomofo, and any of those with Latin. That is TR39's "highly restrictive"
;; level; what it refuses is the mixing an attacker relies on.

(def- *script-companions*
  ;; TR39's augmented script sets: the scripts a script may share a word with, each as the
  ;; writing systems it can belong to
  {:han #{:han :japanese :korean :bopomofo}
   :hiragana #{:japanese}
   :katakana #{:japanese}
   :hangul #{:korean}
   :bopomofo #{:bopomofo}})

(defn- single-script? (scripts)
  ;; whether every script in `scripts` can belong to one writing system
  (or (<= (count scripts) 1)
    (not (empty? (reduce (map scripts (fn (script) (get *script-companions* script #{script})))
                   set/intersection)))))

(defn mixed-script? (s:string -> bool)
  "Whether `s` mixes writing systems the way a homoglyph does: letters from scripts no word of
real text combines — Latin with Cyrillic or Greek, Cyrillic with Armenian — by Unicode TR39's
\"highly restrictive\" level. One script is fine, and so is Han with kana or Hangul, and any of
those with Latin; digits and punctuation belong to every script. Ask it of a WORD (an
identifier, a host name, a display name), not of prose, where a quoted Greek word is no attack.

    (string/mixed-script? \"paypal\")         ;=> false
    (string/mixed-script? \"p\\u{430}ypal\")   ;=> true
    (string/mixed-script? \"Unicode漢字\")    ;=> false
    (string/mixed-script? \"日本語のテキスト\")  ;=> false"
  (let (scripts (string/scripts s))
    (not (or (single-script? scripts)
           (and (includes? scripts :latin)
             (let (others (seq/reject scripts (fn (script) (= script :latin))))
               (and (single-script? others)
                 (any? others (fn (script) (contains? *script-companions* script))))))))))
