;; std/path.blsp — path string manipulation.
;;
;; The full and only path API. The prelude keeps ONE bootstrap helper — `%path-join` —
;; because the module loader has to build a path before any module can load; everything
;; else lives here.
;;
;; Contracts differ from that bootstrap helper deliberately, and the difference is the
;; reason this is the public one: `path/join` is variadic and resets on an absolute
;; segment, and `path/basename` strips a trailing slash ("/x/y/" -> "y") where the
;; two-arg boot version returned "". It also takes STRINGS — the boot version stringified
;; its arguments implicitly, which quietly accepted symbols.

(defmodule path
  "Path string manipulation: join, split, basename, dirname, extension, stem, normalize.

    (path/join \"/usr\" \"local\" \"bin\")   ;; => \"/usr/local/bin\"
    (path/basename \"/usr/local/bin/ls\")    ;; => \"ls\"
    (path/dirname \"/usr/local/bin/ls\")     ;; => \"/usr/local/bin\"
    (path/extension \"report.tar.gz\")       ;; => \".gz\"
    (path/stem \"report.tar.gz\")            ;; => \"report.tar\"
    (path/split \"/usr/local\")             ;; => (\"/\" \"usr\" \"local\")
    (path/normalize \"a/b/../c\")           ;; => \"a/c\"
    (path/relative-to \"/a/b/c\" \"/a/b\") ;; => \"c\"
    (path/with-extension \"foo.txt\" \".md\") ;; => \"foo.md\"")

;; ---- internal helpers -------------------------------------------------------

;; Join a non-empty list of components in order, inserting / between them.
(defn- path-glue (head rest-parts)
  (if (nil? rest-parts)
    head
    (let (p (first rest-parts)
          sep (if (or (string/ends-with? head "/") (string/starts-with? p "/")) "" "/"))
      (path-glue (str head sep p) (rest rest-parts)))))
(sig path-glue :total)

;; ---- components -------------------------------------------------------------

(defn basename (p:string -> string)
  "The last path component — everything after the final /. A trailing slash is
ignored so `(basename \"/usr/bin/\")` returns `\"bin\"`. `(basename \"/\")` returns `\"/\"`.

    (path/basename \"/a/b/c.txt\")   ;=> \"c.txt\""
  (let (n (count p)
        e (if (and (> n 1) (= (string/char-at p (- n 1)) "/")) (- n 1) n)
        i (string/last-index-of p "/" e))
    (cond
      (< i 0) (string/substring p 0 e)
      (= e 1) "/"
      ;; path is exactly "/"
      else (string/substring p (+ i 1) e))))

(defn dirname (p:string -> string)
  "The directory part of `p` — everything up to but not including the final /.
Returns `\".\"` for a bare name, `\"/\"` for the root. A root is its own directory: on
Windows that includes a drive's `C:/` (and a bare `C:`) and a UNC share's
`//server/share/`, so a walk up the tree ends there as it does at `/`.

    (path/dirname \"/a/b/c.txt\")    ;=> \"/a/b\"
    (path/dirname \"/\")             ;=> \"/\""
  (let (root (root-of p)
        n (count p)
        e (if (and (> n 1) (= (string/char-at p (- n 1)) "/")) (- n 1) n)
        i (string/last-index-of p "/" e))
    (cond
      (bare-drive? p) p
      (and root (<= i (dec (count root)))) root
      (< i 0) "."
      (= i 0) "/"
      else (string/substring p 0 i))))

(defn extension (p:string -> string)
  "The extension of `p`'s basename including the dot (e.g. `\".txt\"`), or `\"\"`.

    (path/extension \"/a/b/c.txt\")  ;=> \".txt\""
  (let (b (basename p)
        n (count b)
        i (string/last-index-of b "."))
    (if (<= i 0) "" (string/substring b i n))))

(defn stem (p)
  "The basename of `p` without its extension (`\"foo.tar.gz\"` → `\"foo.tar\"`).

    (path/stem \"/a/b/c.txt\")       ;=> \"c\""
  (let (b (basename p)
        i (string/last-index-of b "."))
    (if (<= i 0) b (string/substring b 0 i))))

(defn with-extension (p:string ext:string -> string)
  "Return `p` with its extension replaced by `ext` (which should include the dot,
or be `\"\"` to remove the extension entirely).

    (path/with-extension \"a/b.txt\" \".md\")   ;=> \"a/b.md\"
    (path/with-extension \"a/b.txt\" \"\")      ;=> \"a/b\""
  (let (d (dirname p) base (str (stem p) ext))
    (if (= d ".") base (str d "/" base))))

;; ---- join -------------------------------------------------------------------

(defn join (& parts)
  "Join path components with `/`. An absolute component (starting with `/`)
resets the path from that point, discarding everything before it. Returns `\".\"` for
an empty argument list.

    (path/join \"a\" \"b\" \"c.txt\")    ;=> \"a/b/c.txt\""
  (join-loop (seq parts) nil))
(sig join (& string -> string) :pure :total)

;; acc is built in reverse (cons prepends); reverse before gluing.
(defn- join-loop (parts acc)
  (if (nil? parts)
    (if (nil? acc)
      "."
      (let (rev (reverse acc))
        (path-glue (first rev) (rest rev))))
    (let (p (first parts))
      (cond
        (= p "") (join-loop (rest parts) acc)
        (rooted? p) (join-loop (rest parts) (list p))
        else (join-loop (rest parts) (cons p acc))))))
(sig join-loop :total)

;; ---- split ------------------------------------------------------------------

(defn split (p)
  "Split `p` into a list of components, dropping empty segments from
redundant slashes. An absolute path starts with the `\"/\"` component.

    (path/split \"a/b/c\")           ;=> (\"a\" \"b\" \"c\")"
  (let (parts (seq/filter (string/split p "/") (fn (s) (not (= s "")))))
    (if (string/starts-with? p "/") (cons "/" parts) parts)))

;; ---- normalize --------------------------------------------------------------

(defn normalize (p)
  "Resolve `.` and `..` components in `p`. Does not touch the filesystem.
`\"a/b/../c\"` → `\"a/c\"`;  `\"/a/b/../../c\"` → `\"/c\"`.

    (path/normalize \"a/./b/../c\")  ;=> \"a/c\"
    (path/normalize \"/..\")         ;=> \"/\"

A root stays: `..` above it is discarded. On Windows that root may be a drive's `C:/` or a
UNC share's `//server/share/` (kept with its two slashes)."
  (let (root (root-of p)
        absolute (not (nil? root))
        tail (cond
               (not absolute) p
               (>= (count root) (count p)) ""
               else (string/substring p (count root) (count p)))
        parts (seq/filter (string/split tail "/") (fn (s) (not (or (= s "") (= s ".")))))
        resolved (collapse-dots parts nil absolute))
    (cond
      (nil? resolved) (or root ".")
      absolute (str root (path-glue (first resolved) (rest resolved)))
      else (path-glue (first resolved) (rest resolved)))))

(defn- collapse-dots (parts stack absolute)
  (if (nil? parts)
    (reverse stack)
    (let (p (first parts))
      (cond
        ;; `..` pops a resolved segment off the stack
        (and (= p "..") (not (nil? stack)) (not (= (first stack) "..")))
          (collapse-dots (rest parts)
            (rest stack)
            absolute)
        ;; `..` that would climb above an absolute root is discarded — there is no
        ;; parent of `/`. (For a relative path it is kept, so `a/../..` → `..`.)
        (and (= p "..") absolute (nil? stack)) (collapse-dots (rest parts) stack absolute)
        else (collapse-dots (rest parts) (cons p stack) absolute)))))

;; ---- relative-to ------------------------------------------------------------

(defn relative-to (p base)
  "Express absolute path `p` relative to absolute `base` — the common prefix is
dropped and one `..` is emitted per remaining `base` component, so a fully
divergent pair still yields a valid relative path (`/x/y` from `/a/b` → `../../x/y`).

    (path/relative-to \"/a/b/c\" \"/a\")   ;=> \"b/c\""
  (let (p-parts (seq/filter (string/split p "/") (fn (s) (not (= s ""))))
        base-parts (seq/filter (string/split base "/") (fn (s) (not (= s "")))))
    (relative-strip p-parts base-parts)))

(defn- relative-strip (p-parts base-parts)
  (cond
    ;; consumed all of base — what remains of p is the relative path
    (nil? base-parts)
      (if (nil? p-parts)
        "."
        (path-glue (first p-parts) (rest p-parts)))
    ;; consumed all of p — need to go up for each remaining base component
    (nil? p-parts) (path-glue ".." (map (rest base-parts) (fn (_) "..")))
    ;; common prefix: keep stripping
    (= (first p-parts) (first base-parts)) (relative-strip (rest p-parts) (rest base-parts))
    ;; diverged: one `..` per remaining base component, then p
    else
      (let (ups (map base-parts (fn (_) "..")))
        (path-glue (first ups) (append (rest ups) p-parts)))))

;; ---- predicates -------------------------------------------------------------

;; Windows (ADR-592). Paths the runtime hands back there use `/` — Win32 accepts it, and
;; this module splits on nothing else — so what Windows adds here is only its ROOTS: a
;; drive letter (`C:/`, or `C:\` as a person types it) and a UNC share (`\\server`). Only
;; on Windows: elsewhere `C:/x` is a relative path whose first directory is named `C:`.
(defdyn path/*windows-rules* nil)
;; Which roots this module reads: nil (the default) asks the OS; true or false forces
;; Windows's rules or POSIX's — so a test on any host can pin both (`binding`).

(defn- windows? ()
  ;; a bool either way, so `absolute?` and the rest still declare one (sig_adoption_test)
  (let (forced path/*windows-rules*)
    (if (nil? forced) (= (%os-type) :windows) (= forced true))))

(defn- letter? (character)
  (includes? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" character))

(defn- unc-root (p)
  ;; Windows: `//server/share/` (or with `\`) — the root of a UNC path, in `/` form, or nil.
  ;; A share with no name yet (`//server`) roots at `//server/`.
  (when (and (windows?) (or (string/starts-with? p "//") (string/starts-with? p "\\\\")))
    (let (text (string/replace p "\\" "/")
          n (count text)
          server-end (index-of text "/" 2)
          share-end (if (< server-end 0) -1 (index-of text "/" (inc server-end))))
      (cond
        (= n 2) text
        (< server-end 0) (str text "/")
        (= server-end (dec n)) text
        (< share-end 0) (str text "/")
        else (string/substring text 0 (inc share-end))))))

(defn- root-of (p)
  ;; The root `p` starts with — `/`, and on Windows a drive's `C:/` or a UNC share's
  ;; `//server/share/`, in `/` form — or nil for a relative path. `dirname` and `normalize`
  ;; stop at it: it is its own parent, as `/` is.
  (cond
    (unc-root p) (unc-root p)
    (drive-rooted? p) (str (string/substring p 0 2) "/")
    (string/starts-with? p "/") "/"
    else nil))

(defn- bare-drive? (p)
  ;; Windows: `C:` alone — the drive's current directory; its own parent here
  (and (= (count p) 2)
    (= (string/char-at p 1) ":")
    (letter? (string/char-at p 0))
    (windows?)))

(defn- drive-rooted? (p)
  (and (>= (count p) 3)
    (= (string/char-at p 1) ":")
    (or (= (string/char-at p 2) "/") (= (string/char-at p 2) "\\"))
    (windows?)))

(defn- rooted? (p)
  (or (string/starts-with? p "/")
    (drive-rooted? p)
    (and (string/starts-with? p "\\\\") (windows?))))

(defn absolute? (p)
  "True if `p` is an absolute path: it starts with `/` — or, on Windows, with a drive
letter's root (`C:/`, `C:\\`) or a UNC share (`\\\\server`).

    (path/absolute? \"/a\")          ;=> true
    (path/absolute? \"a\")           ;=> false"
  (rooted? p))

(defn relative? (p)
  "True if `p` is a relative path — not [[absolute?]].

    (path/relative? \"a\")           ;=> true"
  (not (rooted? p)))

(defn- forward-slashes (native)
  ;; A path read from the environment, in the `/` form this module speaks: on Windows its
  ;; `\` become `/`; elsewhere a `\` is an ordinary character of a name and stays.
  (if (windows?) (string/replace native "\\" "/") native))

(defn- set-variable (name)
  (let (value (%getenv name)) (when (and value (not (= value ""))) value)))

(defn home (-> (or string nil))
  "The current user's home directory: `$HOME`, or on Windows — where a native shell sets no
`HOME` — `%USERPROFILE%`, in `/` form. Nil when neither is set. What `~` means to
[[absolute]] and [[abbreviate]], and where a program keeps its `~/.config`.

    (= (path/home) (path/absolute \"~\"))   ;=> true"
  (let (home (or (set-variable "HOME") (when (windows?) (set-variable "USERPROFILE"))))
    (when home (forward-slashes home))))

(defn temp-root (-> string)
  "The directory [[temp]] names its paths in: `/tmp`, or on Windows the user's temp
directory (`%TEMP%`, else `%TMP%`, in `/` form) — Windows has no `/tmp`, and `\\tmp` on
the current drive is usually not there.

    (file/dir? (path/temp-root))   ;=> true"
  (if (windows?)
    (forward-slashes (or (set-variable "TEMP") (set-variable "TMP") "C:/Windows/Temp"))
    "/tmp"))

;; Filesystem existence/type predicates are I/O and live in `file`
;; (`file/exists?`, `file/regular?`, `file/dir?`). `path` stays pure — it only
;; manipulates path strings and never touches the filesystem (ADR-234).

(defn- expand-user (path)
  "`path`, which starts `~name`, with that prefix replaced by the home of the user `name`
(`%user-home`) — or nil when `name` is no user."
  (let (slash (index-of path "/")
        end (if (< slash 0) (count path) slash)
        home (%user-home (string/substring path 1 end)))
    (when home (str home (string/substring path end (count path))))))

(defn absolute (path:string &optional base:string -> string)
  "Resolve `path` to an absolute path: a `/`-rooted path is returned unchanged, a
`~`/`~/…` path is expanded against `$HOME` and a `~name`/`~name/…` path against that
user's home (as a shell does), and any other (relative) path — a `~name` that is no user
among them — is joined onto `base` (default the current directory, `(file/cwd)`). The empty
string is returned as is. Makes a path absolute, not canonical — it does not collapse
`.`/`..` segments.

    (path/absolute? (path/absolute \"a\"))                     ;=> true
    (= (path/absolute \"~root/x\") (str (%user-home \"root\") \"/x\"))   ;=> true"
  (cond
    (or (= path "") (rooted? path)) path
    (= path "~") (or (home) path)
    (string/starts-with? path "~/") (str (or (home) "~") (string/substring path 1 (count path)))
    (string/starts-with? path "~") (or (expand-user path) (path/join (or base (file/cwd)) path))
    else (path/join (or base (file/cwd)) path)))

(defn abbreviate (path:string -> string)
  "`path` with a leading `$HOME` shortened to `~` — the inverse of [[absolute]]'s `~`
expansion, the way a shell prompt shows a directory. A path outside the home, or one
that merely starts with the home's text (`/home/me2` under `/home/me`), is unchanged.

    (path/abbreviate (str (%getenv \"HOME\") \"/src\"))   ;=> \"~/src\""
  (let (home-directory (home))
    (cond
      (nil? home-directory) path
      (= path home-directory) "~"
      (string/starts-with? path (str home-directory "/"))
        (str "~" (string/substring path (count home-directory) (count path)))
      else path)))

;; ---- a path as a person types it -------------------------------------------
;;
;; Emacs's `substitute-in-file-name`: what a path PROMPT reads, as opposed to what a shell
;; does. `$VAR` expands; a `//` or `/~/` part-way through starts the path over, so a
;; person can type a new path after the old one without clearing the line. Reading the
;; environment and the user database is all it does — whether a `~name` is a FILE in the
;; directory before it is the caller's question (`keep?`), since `path` never touches the
;; filesystem (ADR-234).

;; `$NAME`, `${NAME}`, or `$$` (a literal dollar)
(def- *env-reference* "\\$(?:\\$|\\{([A-Za-z_]\\w*)\\}|([A-Za-z_]\\w*))")

(defn expand-env (text:string -> string)
  "`text` with every `$NAME` and `${NAME}` replaced by that environment variable, and `$$`
by a literal `$` ([[escape-env]] is the inverse). A variable that is not set stays as
typed. Nothing else is read: no `~`, no glob, no command.

    (path/expand-env \"/tmp/$$x\")                                   ;=> \"/tmp/$x\"
    (path/expand-env \"$BROOD_SURELY_UNSET/a\")                      ;=> \"$BROOD_SURELY_UNSET/a\"
    (= (path/expand-env \"${HOME}/a\") (str (%getenv \"HOME\") \"/a\"))   ;=> true"
  (regex/replace text
    *env-reference*
    (fn (found)
      (if (= (:text found) "$$")
        "$"
        (let ([braced bare] (:groups found))
          (or (%getenv (:text (or braced bare))) (:text found)))))))

(defn escape-env (path:string -> string)
  "`path` with every `$` doubled, so [[expand-env]] and [[substitute]] read it back as
exactly that name — how a file name from the disk goes into text that will be expanded.

    (path/escape-env \"/tmp/a$b\")                      ;=> \"/tmp/a$$b\"
    (path/expand-env (path/escape-env \"/tmp/a$HOME\"))   ;=> \"/tmp/a$HOME\""
  (string/replace path "$" "$$"))

(defn- names-a-home? (component)
  "Is `component` (`~` or `~name`) a home: `~` always, `~name` when `name` is a user."
  (or (= component "~")
    (not (nil? (%user-home (string/substring component 1 (count component)))))))

(defn- drive-start? (text i n)
  ;; Windows: a drive root (`C:/`, `C:\`, or a bare `C:` at the end) starts a path over, as
  ;; `//` does — Emacs reads `/x/C:/y` as `C:/y` there (ADR-592). Elsewhere it is a name.
  (and (< (inc i) n)
    (= (string/char-at text (inc i)) ":")
    (letter? (string/char-at text i))
    (or (= (+ i 2) n) (= (string/char-at text (+ i 2)) "/") (= (string/char-at text (+ i 2)) "\\"))
    (windows?)))

(defn- restart-at? (text i n start keep? directory-of)
  "Does a new path begin at index `i` of `text` (length `n`, live from `start`)? At a `/`
right after a `/`, and at a `~` / `~name` component right after a `/` when it names a home
that `keep?` does not claim as an entry of the directory before it."
  (and (> i start)
    (= (string/char-at text (dec i)) "/")
    (or
      (and (= (string/char-at text i) "/")
        ;; Windows: a `//` the live text STARTS with is a UNC share, not a restart
        (not (and (= (dec i) start) (windows?))))
      (drive-start? text i n)
      (and (= (string/char-at text i) "~")
        (let (slash (index-of text "/" i)
              component (string/substring text i (if (< slash 0) n slash)))
          (and (names-a-home? component)
            (not (keep? (directory-of (string/substring text start i)) component))))))))

(defn- restart-scan (text i n start keep? directory-of)
  (cond
    (>= i n) start
    ;; the new path starts at the second slash — on Windows too: Emacs's
    ;; search_embedded_absfilename keeps `//` as a share only at the START of a name
    ;; (`restart-at?`), so `C:/x//srv/share` is `/srv/share`, as it is everywhere
    (restart-at? text i n start keep? directory-of)
      (restart-scan text (inc i) n i keep? directory-of)
    else (restart-scan text (inc i) n start keep? directory-of)))

(defn- never-kept (directory component) false)

(defn substitute-start (text:string &optional keep? -> int)
  "Where the part of `text` that still counts begins: 0, or the index of the last `//`'s
second slash or `/~/`'s `~` (on Windows also `/C:/`'s drive letter). Everything before it was overridden — a prompt paints it as a
shadow. `keep?`, when given, is `(fn (directory component) -> bool)`: true when the
`~name` `component` is a real entry of `directory` (the text before it, its variables
expanded) and so is a file there, not a home.

    (path/substitute-start \"~/src//etc/\")   ;=> 6
    (path/substitute-start \"/usr/lib/~/x\")  ;=> 9
    (path/substitute-start \"~/src/\")        ;=> 0"
  (restart-scan text 0 (count text) 0 (or keep? never-kept) expand-env))

(defn substitute (text:string &optional keep? -> string)
  "The path `text` means, the way Emacs reads a typed file name (`substitute-in-file-name`):
what follows the last `//` or `/~/` ([[substitute-start]]), with its variables expanded
([[expand-env]]). A variable whose value is an absolute path starts the path over too. A
`~` stays a `~` — [[absolute]] expands it. `keep?` as in [[substitute-start]].

    (path/substitute \"~/src//etc/hosts\")   ;=> \"/etc/hosts\"
    (path/substitute \"/usr/lib/~/notes\")   ;=> \"~/notes\"
    (path/substitute \"/tmp/$$x\")           ;=> \"/tmp/$x\"
    (path/substitute \"/srv/~/x\" (fn (directory component) true))   ;=> \"/srv/~/x\""
  (let (keep? (or keep? never-kept)
        typed (string/substring text (substitute-start text keep?) (count text))
        expanded (expand-env typed)
        start (restart-scan expanded 0 (count expanded) 0 keep? identity))
    (string/substring expanded start (count expanded))))

(defn temp (prefix:string -> string)
  "A fresh, unpredictable path under `/tmp` ([[temp-root]]: the user's temp directory on
Windows): `<prefix><32 hex chars>`, NOT created —
`file/spit` a file there or `file/mkdir` a directory. The name comes from the OS CSPRNG, so
it is unique across processes and across runs, and cannot be guessed ahead of time.

Reach for this instead of writing a program-specific constant like
`/tmp/myapp-worker.blsp`. A fixed name in a world-writable directory is two bugs: two
copies of the program fight over one file, and anyone on the machine can create that
path first — as a symlink to something you own — so the `file/spit` overwrites their choice
of file with your privileges. Neither is possible with a name they cannot predict.

    (path/temp \"myapp-\")   ;~> \"/tmp/myapp-…32 random hex chars…\""
  (path/join (temp-root) (str prefix (encoding/hex-encode-bytes (%random-bytes 16)))))

;; ---- file: URIs (RFC 8089) ----------------------------------------------------
;; What a language server, a browser or a file manager names a file with. Both directions
;; live here so they agree: a server sends `file:///c%3A/x` (VS Code's spelling, the colon
;; encoded and the drive lower-cased) and expects to recognise its own URIs in requests.

(defn- encode-segments (text)
  (string/join (map (string/split text "/") url/percent-encode) "/"))

(defn ->file-uri (p:string -> string)
  "The `file:` URI (RFC 8089) of the absolute path `p`, each segment percent-encoded (a
space is `%20`): `file:///a/b`. On Windows a drive path `C:/x` (or `C:\\x`) is
`file:///C:/x` and a UNC path `//server/share/x` is `file://server/share/x`.

    (path/->file-uri \"/my project/a.rs\")   ;=> \"file:///my%20project/a.rs\""
  (let (text (forward-slashes p))
    (cond
      (unc-root text) (str "file://" (encode-segments (string/substring text 2 (count text))))
      (drive-rooted? text)
        (str "file:///"
          (string/substring text 0 2)
          (encode-segments (string/substring text 2 (count text))))
      else (str "file://" (encode-segments text)))))

(defn- uri-authority (text)
  ;; `//host/x` → [host "/x"]; `//host` → [host "/"]
  (let (slash (index-of text "/" 2))
    (if (< slash 0)
      [(string/substring text 2 (count text)) "/"]
      [(string/substring text 2 slash) (string/substring text slash (count text))])))

(defn file-uri-> (uri:string -> (or string nil))
  "The path a `file:` `uri` names, percent-decoded — the inverse of [[->file-uri]] — or
nil when `uri` is not a `file:` URI. `file:///x`, `file:/x` and `file://localhost/x` are
`/x`; another host is a UNC path `//host/x`. On Windows a drive (`file:///C:/x`, or
`file:///c%3A/x` as VS Code writes it) is `C:/x`, its letter upper-cased. Text that does
not decode is left as it is.

    (path/file-uri-> \"file:///my%20project/a.rs\")   ;=> \"/my project/a.rs\""
  (when (string/starts-with? uri "file:")
    (let (after-scheme (string/substring uri 5 (count uri))
          [host raw] (if (string/starts-with? after-scheme "//")
                       (uri-authority after-scheme)
                       ["" after-scheme])
          decoded (url/percent-decode raw)
          local (if (string? decoded) decoded raw)
          drive? (and (windows?)
                   (>= (count local) 3)
                   (= (string/char-at local 0) "/")
                   (letter? (string/char-at local 1))
                   (= (string/char-at local 2) ":")))
      (cond
        drive?
          (str (string/upper (string/char-at local 1))
            (string/substring local 2 (count local)))
        (or (= host "") (= host "localhost")) local
        else (str "//" host local)))))
