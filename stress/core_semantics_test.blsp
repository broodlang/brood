;; STRESS — core language semantics battery, adapted from the shapes the R7RS
;; (Chibi) test suite exercises: the numeric tower's edges, equality, strings
;; (unicode, char-indexed), tail calls, closures/scoping, and error behavior.
;; Every case asserts Brood's DOCUMENTED semantics (docs/language.md); the
;; stress runner sweeps it across engines, so any tier divergence fails loudly.

(defmodule core-semantics-stress-test
  (:use test)
  (:use math))

(describe "numbers: i64 edges + bigint promotion"
  (test "overflow promotes to bigint, exactly"
    (do
      (assert= (+ 9223372036854775807 1) 9223372036854775808)
      (assert= (* 9223372036854775807 2) 18446744073709551614)
      (assert= (- (- 9223372036854775807) 2) -9223372036854775809)
      true))
  (test "bigint round-trips through arithmetic"
    (let (big (* 9223372036854775807 9223372036854775807))
      (do
        (assert= (quot big 9223372036854775807) 9223372036854775807)
        (assert= (rem big 9223372036854775807) 0)
        (assert= (- big big) 0)
        true)))
  (test "quot/rem truncate toward zero (C semantics)"
    (do
      (assert= (quot -7 2) -3)
      (assert= (quot 7 -2) -3)
      (assert= (rem -7 2) -1)
      (assert= (rem 7 -2) 1)
      (assert= (quot -9 3) -3)
      (assert= (rem -9 3) 0)
      true))
  ;; `/` on two integers is EXACT — an int when it divides evenly, otherwise a RATIO.
  ;; It only produces a float when an operand is already a float. This test asserted
  ;; `(/ 7 2)` = 3.5 and so had been failing on every `make stress` run since exact
  ;; rationals landed — the identical stale assertion KI-42 found in `breakage/`
  ;; (`(assert= 4.8 (/ 24 5))`), in the other suite that no CI job runs.
  (test "/ is exact for integer operands (int or ratio); float only if an operand is float"
    (do
      (assert= (/ 6 2) 3)
      (assert= (/ 7 2) 7/2)
      (assert= (/ -7 2) -7/2)
      (assert= (type-of (/ 7 2)) :ratio)
      ;; A float operand makes the result float, and an exact ratio converts on demand.
      (assert= (/ 7 2.0) 3.5)
      (assert= (/ 7.0 2) 3.5)
      (assert= (->float (/ 7 2)) 3.5)
      true))
  (test "division by zero errors, never wraps or NaNs (int)"
    (do
      (assert= (try (/ 1 0) (catch e :err)) :err)
      (assert= (try (quot 1 0) (catch e :err)) :err)
      (assert= (try (rem 1 0) (catch e :err)) :err)
      true))
  (test "no numeric coercion in = (ints and floats are distinct)"
    (do
      (assert= (= 1 1.0) false)
      (assert= (= 0 0.0) false)
      (assert= (< 1 1.5) true)
      ; ordering DOES compare across
      (assert= (< 1.5 2) true)
      true))
  (test "float identities"
    (do
      (assert= (= 0.0 -0.0) true)
      ; IEEE, not decimal
      (assert= (+ 0.1 0.2) 0.30000000000000004)
      (assert= (sqrt 2.0) 1.4142135623730951)
      (assert= (pow 2 62) 4611686018427387904)
      true))
  (test "min/max/abs/inc/dec edges"
    (do
      (assert= (max 1 2) 2)
      (assert= (min -1 -2) -2)
      (assert= (abs -9223372036854775807) 9223372036854775807)
      (assert= (inc 9223372036854775807) 9223372036854775808)
      true)))

(describe "equality: structural, deep, type-strict"
  (test "deep structural equality"
    (do
      (assert= (= [1 [2 {:a (list 3)}]] [1 [2 {:a (list 3)}]]) true)
      ; maps unordered
      (assert= (= {:a 1 :b 2} {:b 2 :a 1}) true)
      (assert= (= "abc" "abc") true)
      true))
  (test "lists and vectors are distinct types"
    (do
      (assert= (= '(1 2) [1 2]) false)
      ; empty list IS nil
      (assert= (= () nil) true)
      true))
  (test "keywords/symbols never equal other types"
    (do
      (assert= (= :a 'a) false)
      (assert= (= :a "a") false)
      (assert= (= :a :a) true)
      true)))

(describe "strings: char-indexed, unicode-aware"
  (test "length and indexing count CHARS, not bytes"
    (do
      (assert= (string/length "hé€") 3)
      (assert= (string/char-at "hé€" 1) "é")
      (assert= (string/char-at "hé€" 2) "€")
      (assert= (string/substring "hé€xyz" 1 4) "é€x")
      true))
  (test "split/join round-trip"
    (do
      (assert= (string/join "," (string/split "a,b,,c" ",")) "a,b,,c")
      (assert= (string/split "aXbXc" "X") (list "a" "b" "c"))
      true))
  (test "case, trim, predicates"
    (do
      (assert= (string/upper "abÉ") "ABÉ")
      (assert= (string/lower "ABÉ") "abé")
      (assert= (string/trim "  x  ") "x")
      (assert= (string/starts-with? "hé€" "hé") true)
      (assert= (string/ends-with? "hé€" "€") true)
      (assert= (includes? "hé€" "é") true)
      true))
  (test "number<->string round trips"
    (do
      (assert= (string->number "9223372036854775807") 9223372036854775807)
      (assert= (string->number "-3.5") -3.5)
      (assert= (number->string 255) "255")
      (assert= (string->number (number->string 0.1)) 0.1)
      true)))

;; deep tail recursion — R7RS's classic "iterate to 1e6 in O(1) stack"
(defn count-down (n) (if (= n 0) :done (count-down (- n 1))))
(defn mutual-a (n) (if (= n 0) :a (mutual-b (- n 1))))
(defn mutual-b (n) (if (= n 0) :b (mutual-a (- n 1))))

(describe "tail calls"
  (test "1M self-tail iterations, O(1) stack" (assert= (count-down 1000000) :done))
  (test "200k mutual-tail iterations" (assert= (mutual-a 200000) :a)))

(describe "closures + scoping"
  (test "closures capture bindings, not values-by-copy of outer rebinding"
    (let (mk (fn (n) (fn (x) (+ x n)))
          add5 (mk 5)
          add7 (mk 7))
      (do
        (assert= (add5 10) 15)
        (assert= (add7 10) 17)
        (assert= (add5 (add7 0)) 12)
        true)))
  (test "let bindings are sequential (let*)"
    (let (a 1 b (+ a 1) c (* b 2)) (assert= [a b c] [1 2 4])))
  (test "shadowing is lexical"
    (let (x 1)
      (let (f (fn () x))
        (let (x 2) (assert= [(f) x] [1 2]))))))

(describe "errors: try/catch semantics"
  (test "throw of a structured value round-trips"
    (assert= (try (throw [:tag 42 "msg"]) (catch e e)) [:tag 42 "msg"]))
  (test "errors unwind through deep recursion"
    (let (boom (fn (self n) (if (= n 0) (throw :deep) (self self (- n 1)))))
      (assert= (try (boom boom 50000) (catch e e)) :deep))))
