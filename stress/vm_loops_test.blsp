;; STRESS — VM/JIT loop machinery: preempt/resume (tier-on-resume), the
;; stuck-QUEUED sync compile, deopt feedback, and checksum exactness under
;; heavy concurrent preemption. Pure loops (no effects) — re-runs must be
;; invisible, and checksums catch any state corruption.

(defmodule vm-loops-stress-test (:use test))

(defn await-sums (n acc)
  (if (= n 0) acc (receive ([:sum v] (await-sums (- n 1) (+ acc v))) (after 60000 :timeout))))

;; A long native loop: preempted hundreds of times; the resume-tier path re-enters
;; native each timeslice. Checksum must be exact regardless of preempt points.
(defn sum-to (i n acc) (if (>= i n) acc (sum-to (+ i 1) n (+ acc i))))

(describe "loops: preempt/resume exactness"
  (test "16 concurrent 2M-iteration native loops checksum exactly"
    (let (me (self))
      (do
        (fold (fn (_ k) (spawn (send me [:sum (sum-to 0 2000000 0)]))) nil (range 16))
        (assert= (await-sums 16 0) (* 16 1999999000000))
        true)))
  (test "a float-crossing loop (deopt mid-run) still sums exactly"
    ;; ints then floats: the int-specialized arm deopts at the float boundary —
    ;; a PURE loop, so the re-run is legal; the result must still be exact.
    (do (assert= (float-cross 0 200000 0) 199995.5) true)))

;; ints for i<=199990, halves after: 199991 ints + 9 halves = 199991 + 4.5
(defn float-cross (i n acc)
  (if (>= i n) acc
    (float-cross (+ i 1) n (+ acc (if (> i 199990) 0.5 1)))))

;; Collatz checksum — the reduction-batched back-edge + preemption interplay.
(defn collatz-len (n steps)
  (if (= n 1) steps
    (collatz-len (if (= (rem n 2) 0) (quot n 2) (+ (* 3 n) 1)) (+ steps 1))))
(defn collatz-sum (i n acc)
  (if (> i n) acc (collatz-sum (+ i 1) n (+ acc (collatz-len i 0)))))

(describe "loops: collatz checksum under concurrency"
  (test "8 concurrent collatz sweeps agree with the sequential result"
    (let (me (self) want (collatz-sum 1 20000 0))
      (do
        (fold (fn (_ k) (spawn (send me [:sum (collatz-sum 1 20000 0)]))) nil (range 8))
        (assert= (await-sums 8 0) (* 8 want))
        true))))
