;; higher-order flows: closures over locals, fns as values, parametric results.
(defn twice (f x) (f (f x)))
(io/puts (twice inc 5) (twice (fn (s) (str s "-")) "a"))
(def ops [(fn (x) (+ x 1)) (fn (x) (* x 2))])
(io/puts (fold ops 10 (fn (acc f) (f acc))))
(defn make-adder (n) (fn (x) (+ x n)))
(io/puts ((make-adder 3) 4))
