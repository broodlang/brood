;; Brood feature tour
;; -------------------
;; Run it:   ./bin/cli examples/tour.blsp
;; Or play:  ./bin/cli        (starts the REPL)

;; Arithmetic — +, -, *, /, etc. are defined in Brood on a tiny Rust kernel.
(io/puts "1 + 2 * 3   =" (+ 1 (* 2 3)))
(io/puts "7 / 2       =" (/ 7 2))
(io/puts "10 mod 3    =" (math/mod 10 3))

;; defn, with optional args (default values)
(defn greet (name &optional (greeting "hello")) (str greeting ", " name))
(io/puts (greet "world"))
(io/puts (greet "world" "hi"))

;; Recursion is the loop — proper tail calls, so this doesn't grow the stack.
(defn sum-to (n acc) (if (= n 0) acc (sum-to (- n 1) (+ acc n))))
(io/puts "sum 1..100000 =" (sum-to 100000 0))

;; Higher-order functions over lists.
(io/puts "squares:" (map (list 1 2 3 4 5) (fn (x) (* x x))))
(io/puts "evens:  " (filter (list 1 2 3 4 5 6) (fn (x) (= 0 (math/mod x 2)))))
(io/puts "total:  " (reduce (list 1 2 3 4 5) 0 +))

;; Vectors are a data type with O(1) indexing (code is lists, data can be vectors).
(def v [10 20 30])
(io/puts "v[1] =" (nth v 1) " count =" (count v))

;; Macros — define your own control form.
(defmacro unless2 (c & body) `(if ~c nil (do ~@body)))
(io/puts (unless2 false "the body ran"))

;; Threading macro.
(io/puts "(-> 5 (+ 3) (* 2)) =" (-> 5 (+ 3) (* 2)))

;; Error handling.
(io/puts (try (/ 1 0) (catch e (str "caught: " e))))
(io/puts (try (throw :boom) (catch e (str "caught: " e))))

(io/puts "--- tour complete ---")
