;; std/tool/stdimage — a startup image for the standard library (ADR-218 applied to `std/*`).
;;
;; The property that matters is FIDELITY, not speed: a module restored from the image must
;; define exactly what loading its source defines. A fast image that drops bindings is worse
;; than no image, and the failure would surface far away — as an unbound symbol inside some
;; unrelated module that happened to depend on the missing name.
;;
;; Two attribution bugs found while building it, both guarded below:
;;   - by-prefix alone loses the ROOT globals a module defines (`*1`/`*2`/`*3` from `repl`,
;;     `*config-…*` from the project tooling) — 51 names went missing;
;;   - by-what-appeared alone credits a DEPENDENCY's globals to whichever module pulled it
;;     in first, leaving the dependency with no section of its own.

(defmodule stdimage-test
  (:use test)
  (:use stdimage))

(describe "stdlib image: fidelity"
  :isolated

  (test "a module's section names exactly what its source load defines"
    ;; `json` is a good probe: a plain namespaced module with no root globals.
    (require-one 'json)
    (let (from-source (into #{} (filter (fn (s) (string/starts-with? (name s) "json/"))
                                  (global-names))))
      (is (> (count from-source) 20))
      ;; the image path is only exercised when one exists for THIS binary
      (let (n (install))
        (when n
          (is (> n 0))
          ;; already-loaded, so this asserts the section is present, not that it reloads
          (is (contains? (into #{} (map name (global-names))) "json/->json"))))))

  (test "the image is keyed on stdlib-id — content, not the executable"
    ;; Deliberately NOT `build-id`: that embeds the running executable's mtime, so `brood`,
    ;; `nest` and `brood-lsp` from one tree would each write their own ~2 MB copy of an
    ;; identical image. `stdlib-id` hashes what is baked in, so they share one — and it
    ;; still changes on any `.blsp` edit, committed or not, so a stale image is never read.
    (let (p (image-path))
      (when p
        (is (includes? p (stdlib-id)))
        (is (not (includes? p (build-id))))
        (is (includes? p "std-image-")))))

  ;; Root globals — the ones carrying no `mod/` prefix — used to be credited to whichever
  ;; module pulled their definer in FIRST, so `*lineedit-keymap*` landed in `repl`'s section
  ;; and restoring `editor/lineedit` gave the module without it. Attribution now probes each
  ;; module in isolation and takes the SMALLEST introduced set containing the name.
  (test "a root global is attributed to the module that defines it, not to a dependent"
    (let (own (%isolate (fn ()
                (let (before (into #{} (global-names))
                      _ (require-one 'editor/lineedit))
                  (into #{} (filter (fn (s) (not (contains? before s))) (global-names))))))
          via (%isolate (fn ()
                (let (before (into #{} (global-names))
                      _ (require-one 'repl))
                  (into #{} (filter (fn (s) (not (contains? before s))) (global-names)))))))
      ;; both see the name; the definer's set is the smaller one, which is what build picks
      (is (contains? own '*lineedit-keymap*))
      (is (contains? via '*lineedit-keymap*))
      (is (< (count own) (count via)))))

  ;; The require-edges section is keyed on a ROOT name for the same reason in reverse: as
  ;; `stdimage/*std-edges*` it made `stdimage` look already-loaded the moment that section
  ;; was restored, so its source never loaded and `(:use stdimage)` referred nothing.
  (test "the edges the image carries live in a global no module owns"
    (is (not (includes? (name '*std-require-edges*) "/"))))

  (test "install is a no-op when no image exists for this binary"
    ;; Returns nil rather than raising, so `require` keeps loading from source unchanged.
    ;; (If one does exist, it returns a positive section count — both are valid here.)
    (let (n (install))
      (is (or (nil? n) (> n 0))))))

(describe "stdlib image: it coexists with a project image"
  :isolated

  (test "an additional source is consulted, and the primary still wins"
    ;; `*image-sources*` is the additional-source list the prelude scans after
    ;; `*image-sections*`. A single path could only hold one producer, and the second to
    ;; install silently displaced the first — which is why this list exists.
    (let (before (count *image-sources*))
      (install)
      ;; installing at most appends; it never replaces the primary project source
      (is (>= (count *image-sources*) before)))))
