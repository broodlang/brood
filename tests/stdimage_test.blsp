;; std/tool/stdimage — a startup image for the standard library (ADR-218 applied to `std/*`).
;;
;; The property that matters is FIDELITY, not speed: a module restored from the image must
;; define exactly what loading its source defines. A fast image that drops bindings is worse
;; than no image, and the failure would surface far away — as an unbound symbol inside some
;; unrelated module that happened to depend on the missing name.
;;
;; Two attribution bugs found while building it, both guarded below:
;;   - by-prefix alone loses the ROOT globals a module defines (`*1`/`*2`/`*3` from `repl`,
;;     `*config-…*` from the project tooling) — 51 names went missing;
;;   - by-what-appeared alone credits a DEPENDENCY's globals to whichever module pulled it
;;     in first, leaving the dependency with no section of its own.

(defmodule stdimage-test
  (:use test)
  (:use stdimage))

(describe "stdlib image: fidelity"
  :isolated (test "a module's section names exactly what its source load defines"
    ;; `json` is a good probe: a plain namespaced module with no root globals.
    (require-one 'json)
    (let (from-source (into #{}
                        (filter (fn (s) (string/starts-with? (->string s) "json/"))
                          (reflect/global-names))))
      (is (> (count from-source) 20))
      ;; the image path is only exercised when one exists for THIS binary
      (let (n (install))
        (when n
          (is (> n 0))
          ;; already-loaded, so this asserts the section is present, not that it reloads
          (is (contains? (into #{} (map ->string (reflect/global-names))) "json/->json"))))))

  (test "the image is keyed on system/stdlib-id — content, not the executable"
    ;; Deliberately NOT `system/build-id`: that embeds the running executable's mtime, so `brood`,
    ;; `nest` and `brood-lsp` from one tree would each write their own ~2 MB copy of an
    ;; identical image. `system/stdlib-id` hashes what is baked in, so they share one — and it
    ;; still changes on any `.blsp` edit, committed or not, so a stale image is never read.
    (let (p (image-path))
      (when p
        (is (includes? p (system/stdlib-id)))
        (is (not (includes? p (system/build-id))))
        (is (includes? p "std-image-")))))

  ;; Root globals — the ones carrying no `mod/` prefix — used to be credited to whichever
  ;; module pulled their definer in FIRST, so `*lineedit-keymap*` landed in `repl`'s section
  ;; and restoring `editor/lineedit` gave the module without it. Attribution now probes each
  ;; module in isolation and takes the SMALLEST introduced set containing the name.
  (test "a root global is attributed to the module that defines it, not to a dependent"
    (let (own (%isolate (fn ()
                          (let (before (into #{} (reflect/global-names))
                                _ (require-one 'editor/lineedit))
                            (into #{}
                              (filter (fn (s) (not (contains? before s))) (reflect/global-names))))))
          via (%isolate (fn ()
                          (let (before (into #{} (reflect/global-names))
                                _ (require-one 'repl))
                            (into #{}
                              (filter (fn (s) (not (contains? before s))) (reflect/global-names)))))))
      ;; both see the name; the definer's set is the smaller one, which is what build picks
      (is (contains? own '*lineedit-keymap*))
      (is (contains? via '*lineedit-keymap*))
      (is (< (count own) (count via)))))

  ;; The require-edges section is keyed on a ROOT name for the same reason in reverse: as
  ;; `stdimage/*std-edges*` it made `stdimage` look already-loaded the moment that section
  ;; was restored, so its source never loaded and `(:use stdimage)` referred nothing.
  (test "the edges the image carries live in a global no module owns"
    (is (not (includes? (->string '*std-require-edges*) "/"))))

  ;; The image is keyed on `system/stdlib-id` — the stdlib's CONTENT — deliberately the same for
  ;; `brood`, `nest` and `brood-lsp` from one tree so they share one copy. But those binaries
  ;; do NOT bake in the same modules: a lean runtime (what `nest release` and
  ;; `make install INSTALL_FEATURES=RUN_FEATURES` produce — what ships) has no dev-tools, and
  ;; `project`'s recorded edges name `test`. Replaying an edge to a module this binary cannot
  ;; load made the very next `require` die with `cannot find module 'test'`, i.e. installing
  ;; the image BROKE `require` on the shipped build — so its 4-33x win was never available
  ;; there. `require format` measured 62 ms from source against 12.8 ms restored.
  :isolated (test "a replayed edge naming a module this binary lacks does not break require"
    (let (fake {"somemod" ['definitely-not-a-real-module 'string]}
          _ (%merge-require-edges! fake)
          deps (get *require-edges* "somemod"))
      ;; the unloadable dep is dropped, the real one kept
      (is (nil? (seq/find (fn (d) (= (->string d) "definitely-not-a-real-module")) deps)))
      (is (not (nil? (seq/find (fn (d) (= (->string d) "string")) deps))))
      ;; and requiring still works afterwards
      (is (= :ok (try (do (require-one 'json) :ok) (catch e (get e :message)))))))

  (test "the image may accelerate a module this binary bakes, never ADD one"
    ;; The other half of the shared-key trade-off above, and the dangerous half. One image
    ;; serves `brood`, `nest` and `brood-lsp` because the key hashes every `std/**/*.blsp` on
    ;; DISK regardless of features — but a lean runtime bakes no dev-tools. Without a check,
    ;; `nest` writing the image lets a lean `brood` beside it MATERIALISE `test`: a module
    ;; that binary was built to exclude, present only because a dev tool ran on that machine.
    ;; It then works on the dev box and fails in production, where there is no image.
    ;;
    ;; `%std-image-serves?` is the rule. Verified by sabotage on a real lean build
    ;; (`make release-brood`, no dev-tools) against an image written by the dev-tools binary:
    ;; forced true, `(require-one 'test)` succeeds — "YES — LEAKED"; as written it is refused
    ;; while `json` still materialises from the same file.
    ;; `*std-image-file*` rather than `(%std-image-path)`: the predicate compares against the
    ;; image this process actually INSTALLED, and there may be none (no image built yet,
    ;; `BROOD_NO_STDIMAGE=1`, or a coverage run). With none installed there is no stdlib
    ;; image to restrict, so every section is by definition a project's — which is the
    ;; correct answer, and asserting the refusal there would be asserting against a
    ;; configuration that does not exist.
    (let (img *std-image-file*)
      ;; a project image (any other path) is unrestricted — it is the only thing that HAS
      ;; the project's own modules
      (is (%std-image-serves? "/some/project/image.bin" nil))
      (when img
        ;; the stdlib image serves a module this binary bakes…
        (is (%std-image-serves? img "(some embedded source)"))
        ;; …and refuses one it does not
        (is (not (%std-image-serves? img nil))))))

  (test "install is a no-op when no image exists for this binary"
    ;; Returns nil rather than raising, so `require` keeps loading from source unchanged.
    ;; (If one does exist, it returns a positive section count — both are valid here.)
    (let (n (install))
      (is (or (nil? n) (> n 0))))))

(describe "stdlib image: it coexists with a project image"
  :isolated (test "an additional source is consulted, and the primary still wins"
    ;; `*image-sources*` is the additional-source list the prelude scans after
    ;; `*image-sections*`. A single path could only hold one producer, and the second to
    ;; install silently displaced the first — which is why this list exists.
    (let (before (count *image-sources*))
      (install)
      ;; installing at most appends; it never replaces the primary project source
      (is (>= (count *image-sources*) before)))))

;; ---------------------------------------------------------------------------
;; What a materialised module owes beyond its bindings (ADR-256).
;;
;; These cover the four faults that made the image unshippable, three of which the
;; recorded design did not name. The first is the important one to keep: it is a RACE,
;; so every affected file passed when run alone — single-file reproduction, the first
;; thing anyone reaches for, hides it completely.

(describe "stdlib image: a materialised module is complete, not merely bound"
  (test "the image cache is bounded by COUNT, so stdlib edits cannot fill the disk"
    ;; The name carries `system/stdlib-id` — a content hash of every baked-in `.blsp` — so
    ;; every edit to the standard library mints a NEW ~2 MB image, and the machines that
    ;; build these are exactly the machines editing it. An age-based rule catches none of
    ;; them: measured 2026-08-27, 35 images / 74 MB, all from that day, and the prelude boot
    ;; cache beside it had reached 4192 files / 732 MB the same way. `build` prunes to the
    ;; newest few before writing.
    (let (dir (path/dirname (image-path)))
      (when (file/dir? dir)
        (let (n (count (filter (fn (e)
                                 (and (string/starts-with? e "std-image-")
                                   (string/ends-with? e ".bin")))
                         (file/ls dir))))
          ;; A bound, not an exact count: another binary in this tree (`nest`, `brood-lsp`)
          ;; legitimately writes its own, and the suite itself may have just built one.
          (is (<= n 12))))))

  (test "the image carries the registration tables, not just bindings"
    ;; `%std-impls` holds ability impls (an `impl` form is a top-level CALL, so
    ;; materialising skips it); `%std-regs` holds the rest — ability declarations,
    ;; record ids, multimethods, module docs. Without them a restored `datetime` is
    ;; bound and dispatches nothing.
    (let (p (image-path))
      (when (and p (file/exists? p))
        (let (idx (try (%image-index p (system/stdlib-id)) (catch _ nil)))
          (when idx
            (is (not (nil? (get idx "%std-edges"))))
            (is (not (nil? (get idx "%std-impls"))))
            (is (not (nil? (get idx "%std-regs")))))))))

  (test "registrations are attributed to the module that declared them"
    ;; Not to whichever module pulled the declarer in first — the same failure the root-global
    ;; attribution test above guards, in the registry dimension. `*impl-from*` records the
    ;; declaring namespace at registration, so this is exact rather than inferred.
    (require-one 'datetime)
    (let (by-mod (%std-impls-by-module)
          mine (or (%map-get by-mod "datetime" nil) []))
      (is (> (count mine) 0))
      ;; every tuple this module claims really was declared by it
      (is (empty? (filter (fn (r) (not (= (->string (get r 4)) "datetime"))) mine)))))

  :isolated (test "a module materialised under concurrency is never seen before its deps are"
    ;; THE regression test for the race. The image branch used to `provide` before following
    ;; the module's require-edges, so a process racing on the same first require saw the
    ;; module as loaded with its dependencies still missing and died on `unbound symbol:
    ;; rand/token` inside `uuid/v7`. 112 of the 157 failures under a boot-installed image were
    ;; this shape, and NONE of them reproduce single-threaded.
    ;;
    ;; Run in a subprocess because only a BOOT install exercises materialisation: a qualified
    ;; name auto-requires its module at compile time, so anything this file names has already
    ;; loaded from source. `reflect/eval-string` defers that compile into the spawned process, which is
    ;; what makes the requires race. Verified by sabotage — with `provide` moved back ahead of
    ;; the edge replay, this fails.
    ;; `exe` must be the BROOD runner, not `(os/exe-path)`. This test used to pass the
    ;; running binary straight through, which made it VACUOUS under the gate that matters:
    ;; the canonical suite runs inside `crates/lisp/tests/suite.rs`, so exe-path is the
    ;; libtest binary, which reads a positional argument as a test-NAME FILTER — it printed
    ;; `running 0 tests`, exited 0, and `(is (= code 0))` passed without the race ever
    ;; running. (Under `nest test` the same line failed instead: `nest <file.blsp>` is not a
    ;; subcommand, exit 2.) A regression test for KI-72 that never executes is worse than no
    ;; test, so resolve the real binary: beside the runner (`brood --test`, `nest test`) or
    ;; one level up (`target/release/deps/` → `target/release/`), and skip if absent.
    (let (dir (path/dirname (os/exe-path))
          exe (first (filter file/exists?
                       [(path/join dir "brood") (path/join dir ".." "brood")]))
          prog (path/temp "stdimage-race-")
          _ (file/spit prog
              (string/join "\n"
                ["(require-one 'stdimage) (stdimage/ensure)"
                  "(let (me (self)" "      ps (map (fn (i)"
                  "                (spawn (fn () (send me [:r (try [:ok (reflect/eval-string \"(uuid/v7)\")]"
                  "                                                 (catch e [:err (get e :message)]))]))))"
                  "           (range 0 24)))" "  (let (bad (fold (fn (acc _)"
                  "                    (receive ([:r [tag v]] (if (= tag :err) (append acc [v]) acc))))"
                  "              [] ps))" "    (when (> (count bad) 0)"
                  "      (io/puts (str \"FAILED \" (count bad) \" of 24: \" (first bad)))"
                  "      (system/halt 1))))"]))
          code (if exe (os/run-process "env" ["BROOD_STDIMAGE=1" exe prog]) 0))
      ;; `exe` nil means no brood binary beside the runner — a legitimate environment, not a
      ;; failure. Assert it separately so a skip is visible rather than silently green.
      (is (or (nil? exe) (string? exe)))
      (is (= code 0)))))
