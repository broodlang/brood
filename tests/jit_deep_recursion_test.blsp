;; KI-14 — a JIT'd deep recursion must not run the native stack into its guard page.
;;
;; `n_structure_100000_opening_arrays.json` recurses the JSON parser ~100 000 levels, and
;; its sibling `n_structure_open_array_object.json` ~50 000 levels through two mutually
;; recursive arms. Once those arms tier, the recursion runs native→native (a JIT'd frame
;; plus `brood_rt_call_slow` → `jit_dispatch_call` per level) and NONE of the guards saw
;; it: `jit_native_depth` stays near zero on that path, so the frame-count cap never fired
;; and the `stacker` headroom probe — gated behind depth ≥ 64 — was never called. The
;; worker died on its guard page: an abort `try`/`catch` cannot observe and no supervisor
;; can restart, taking the OS process rather than the green one. That is what hung
;; `brood_suite_passes`.
;;
;; It reproduces only when the arms are WARM — a cold spawn interprets and is fine — so
;; each case warms in this process first and then parses inside a spawned green process,
;; the shape the test framework itself produces.
;;
;; The assertion is deliberately weak (`:rejected`, the correct verdict for an invalid
;; document): the property under test is that a VALUE comes back at all rather than the
;; OS process dying. Register-only — discovered and run by `nest test`.
(defmodule jit-deep-recursion-test (:use test) (:use corpus))

;; These cases run in FULL by default (`BROOD_JDR_OF` unset). They are inherently
;; expensive — the property under test IS deep recursion, so the depth cannot be reduced
;; without losing it — and in a DEBUG build they cost ~210 s, 38% of the whole
;; `brood_suite_passes` wrapper. `crates/lisp/tests/suite.rs` turns this knob down for
;; that wrapper only; `nest test` / `make suite` stay exhaustive at ~2.7 s release.
;;
;; What the knob scales is *repetition*, never depth: the warm-up count, and how much of
;; the 188-document corpus the third case re-scans. Both deep documents are always parsed
;; at their full depth, in a spawned process, in every context — that is the regression.
;; Read from the ENVIRONMENT at the point of use, not from a global the wrapper defines
;; first: the wrapper's `def` would run before this file loads (the mistake the UCD knob's
;; comment records).
(def- jdr-of (max 1 (or (string->number (or (getenv "BROOD_JDR_OF") "")) 1)))

(defn- jdr-parse
  (path)
  (try (do (json/parse (slurp path)) :ok) (catch e :rejected)))

;; Warm in THIS process so the parser arms tier to native before the spawned run.
;; One pass already tiers the arms; extra passes only buy confidence, so they are the
;; first thing the knob drops.
(defn- jdr-warm
  (path k)
  (if (= k 0) :warmed (do (jdr-parse path) (jdr-warm path (- k 1)))))
(defn- jdr-warm-count (k) (max 1 (/ k jdr-of)))

;; Parse in a spawned green process — on a scheduler worker, which is where the
;; guard-page abort happened.
;;
;; The `after` deadline is a **liveness net**, not a performance bound: its job is to turn
;; "the worker died and will never reply" into a value rather than hanging. The guard-page
;; fix means deep recursion now DEOPTS to the VM and raises the catchable `MAX_BC_FRAMES`
;; error (→ `jdr-parse` returns `:rejected`) instead of aborting, so the worker is *slow*,
;; never dead — it just needs a generous net. The parse costs ~36 s of CPU at
;; `BROOD_RT_GC_FLOOR=1` and far more under the whole suite's drain + core contention
;; (`:serial` serialises only within this group; all units still run together). At 850 s it
;; clears any realistic contended run yet still sits under the `:slow` batch ceiling, so a
;; genuinely stuck worker is caught with a clean `:TIMED-OUT` rather than the hard kill.
(defn- jdr-in-spawn
  (path)
  (let (me (self))
    (spawn (send me [:r (jdr-parse path)]))
    (receive ([:r r] r) (after 850000 :TIMED-OUT))))

(describe "KI-14: deep JIT'd recursion drains instead of overflowing"
  ;; :serial — each case warms globals and leans on the whole worker stack; running them
  ;; against other tests' allocation would make a failure hard to attribute.
  ;;
  ;;
  ;; This file was briefly tagged `:conformance` and quarantined: it used to pass in 2.7 s
  ;; alone and hard-kill at the 120 s cap inside the full suite. That was KI-14 — the
  ;; RUNTIME collector re-walking a deep process's whole root stack at every safepoint —
  ;; and it is fixed, so these run with everything else again. Deep recursion is exactly
  ;; the shape that provoked it, which makes this file a useful canary for its return.
  ;;
  ;; `:slow` — the collector's *bounded* residual (a deep-recursing process still pays a
  ;; throttled-but-O(depth) drain-report cost) makes each case's warm + spawned parse
  ;; legitimately long once the whole suite's loaded code arms the drain AND every core is
  ;; contended; the whole-test wall-clock overran the 120 s default ceiling, hard-killing a
  ;; run that finishes fine given room. `:slow` buys the `*test-slow-timeout-ms*` (900 s)
  ;; batch budget — the same lever the conformance corpora use for work that is long, not
  ;; stuck. The underlying drain cost is left for an ADR-gated collector-perf pass.
  :serial
  :tags
  [:slow]
  (test "a 100k-deep document parses in a spawned process after warming"
    (require 'json)
    (let (p "tests/corpus/json/data/n_structure_100000_opening_arrays.json")
      (jdr-warm p (jdr-warm-count 3))
      (assert= (jdr-in-spawn p) :rejected)))
  (test "the alternating array/object document too"
    ;; This one survived the FIRST cut of the fix: the stamp encoded "already inside the
    ;; margin" as limit 0, which the prologue read as *guard disabled* — switching the
    ;; check off at exactly the moment it was needed.
    (require 'json)
    (let (p "tests/corpus/json/data/n_structure_open_array_object.json")
      (jdr-warm p (jdr-warm-count 2))
      (assert= (jdr-in-spawn p) :rejected)))
  (test "the whole n_ corpus scans in a spawned process after warming"
    ;; The scan the suite actually runs: 188 documents, warm parent then spawned child.
    (require 'json)
    (let (all (filter (fn (f) (= (substring (path-basename f) 0 1) "n"))
                (corpus-files "json"))
          ;; Discovery is asserted in full regardless of the knob; only the re-scan is
          ;; sampled. `index mod n` so the slice spreads across the corpus (and so keeps
          ;; the deep documents) rather than taking a prefix — deterministic either way.
          files (jdr-every-nth all jdr-of))
      (assert= 188 (count all))
      (jdr-scan-warm files)
      (assert= (jdr-scan-in-spawn files) (count files)))))

(defn- jdr-every-nth
  (xs n)
  (if (= n 1) xs (jdr-every-nth-go xs n 0 nil)))
(defn- jdr-every-nth-go
  (xs n i acc)
  (if (nil? xs)
    (reverse acc)
    (jdr-every-nth-go (rest xs)
      n
      (inc i)
      (if (= (rem i n) 0) (cons (first xs) acc) acc))))

(defn- jdr-scan
  (fs n)
  (if (nil? fs) n (do (jdr-parse (first fs)) (jdr-scan (rest fs) (inc n)))))
(defn- jdr-scan-warm (files) (jdr-scan files 0))
(defn- jdr-scan-in-spawn
  (files)
  (let (me (self))
    (spawn (send me [:r (jdr-scan files 0)]))
    ;; 850 s liveness net, as in `jdr-in-spawn` — generous headroom under the `:slow` ceiling.
    (receive ([:r r] r) (after 850000 :TIMED-OUT))))
