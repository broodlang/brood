;; Reader hardening — malformed / "silly syntax" must produce a clean parse error,
;; never a panic or segfault (added 2026-06-29, after a 500-input syntax fuzz run
;; found 0 crashes). `reflect/read-string` surfaces the reader directly; `assert-error`
;; confirms a clean error. Also pins a few valid-but-weird forms that MUST parse.
(defmodule reader-malformed-test (:use test))

;; one arg, fully balanced per line: (assert-error (reflect/read-string "S"))
(describe "malformed input errors cleanly (no crash)"
  (test "unbalanced / stray delimiters"
    (assert-error (reflect/read-string "(((("))
    (assert-error (reflect/read-string ")"))
    (assert-error (reflect/read-string "[1 2"))
    (assert-error (reflect/read-string "{:a"))
    (assert-error (reflect/read-string "([)]")))
  (test "unterminated / bad-escape strings"
    (assert-error (reflect/read-string "\"no end"))
    (assert-error (reflect/read-string "\"\\x\""))
    (assert-error (reflect/read-string "\"\\u{110000}\"")))
  ; float-shaped, malformed
  (test "number-shaped tokens that don't parse are a parse error, not a silent symbol"
    ;; a token with genuine numeric intent — a digit present, every sign in a valid
    ;; position — but that doesn't parse must fail loudly; it is NOT a symbol.
    ; valid float still parses
    (assert= (reflect/read-string "1e7") 10000000.0)
    ; float-shaped, malformed
    (assert-error (reflect/read-string "1e"))
    ; float-shaped, malformed
    (assert-error (reflect/read-string "1.2.3"))
    (assert-error (reflect/read-string "1e+")))
  (test "dangling reader sugar"
    (assert-error (reflect/read-string "'"))
    (assert-error (reflect/read-string "`"))
    (assert-error (reflect/read-string "~"))
    (assert-error (reflect/read-string "~@")))
  (test "pathologically deep nesting errors (depth cap), does not overflow"
    (assert-error (reflect/read-string (string/repeat "(" 100000)))
    (assert-error (reflect/read-string (string/repeat "[" 100000)))))

(describe "valid but unusual forms still parse correctly"
  (test "non-finite float literals read as floats"
    (assert= (type-of (reflect/read-string "inf")) :float)
    (assert= (type-of (reflect/read-string "nan")) :float))
  (test "dotted pair and empty containers"
    (assert= (reflect/read-string "(1 2 . 3)") (cons 1 (cons 2 3)))
    (assert= (reflect/read-string "[]") [])
    (assert= (reflect/read-string "()") '()))
  (test "nested form parses to the right structure"
    (assert= (reflect/read-string "(1 (2 (3)))") (list 1 (list 2 (list 3))))))

(describe "conventional identifiers read as symbols, not malformed numbers"
  ;; A token is only number-shaped with genuine numeric intent: a digit present AND
  ;; every `+`/`-` in a valid sign position (leading, or right after `e`/`E`). So
  ;; sign/dot-only or misplaced-sign tokens are ordinary symbols — matching Lisp
  ;; convention and the `scan-tokens` tooling classifier.
  (test "sign/dot runs with no digit are symbols"
    (is (symbol? (reflect/read-string "++")))
    (is (symbol? (reflect/read-string "--")))
    (is (symbol? (reflect/read-string "..."))))
  ;; A misplaced sign USED to make these symbols — `1+`/`1-` were readable as the
  ;; Emacs-Lisp increment names. They are digit-led, so the reader now reserves them
  ;; (see reader_hints_test.blsp). The ergonomic cost is nil: `inc`/`dec` are the
  ;; Brood spelling, nothing in the tree or the sibling projects ever used `1+`/`1-`,
  ;; and Clojure rejects the token too. What is bought is that `12-34` and `2+3` —
  ;; far more likely a typo than a name — now fail at the token instead of becoming
  ;; a symbol that goes unbound somewhere else entirely.
  (test "a digit-led token with a misplaced sign is reserved, not a symbol"
    (map ["1+" "1-" "2+3" "12-34"]
      (fn (t) (assert= (get (try (reflect/read-string t) (catch e e)) :kind) :parse))))
  (test "…but a sign run with no digit behind it is still a symbol"
    ;; `--5` leads with `-` followed by `-`, not a digit, so it is not digit-led.
    (is (symbol? (reflect/read-string "--5"))))
  (test "the read symbol is the expected one (round-trips through equality)"
    (assert= (reflect/read-string "++") '++)
    (assert= (reflect/read-string "...") '...)
    (assert= (reflect/read-string "--5") '--5))
  (test "a valid number is still a number, not a symbol"
    (is (number? (reflect/read-string "-5")))
    ; sign after e is a real exponent
    (is (number? (reflect/read-string "1e+5")))
    (is (number? (reflect/read-string ".5")))
    (is (number? (reflect/read-string "-.5")))))

(describe "symbols/keywords built from arbitrary strings round-trip via |…| bars"
  ;; `(symbol s)` / `(keyword s)` can intern any spelling; `pr-str` bar-quotes the
  ;; ones that aren't a clean token so `(reflect/read-string (pr-str x))` recovers `x`.
  (defn rt (v) (assert= v (reflect/read-string (pr-str v))))
  ; contains a backslash
  (test "symbols with awkward spellings round-trip"
    ; whitespace
    (rt (symbol "a b"))
    ; a delimiter
    (rt (symbol "a)b"))
    ; empty
    (rt (symbol ""))
    ; would read as a number
    (rt (symbol "123"))
    ; would read as nil
    (rt (symbol "nil"))
    ; would read as a keyword
    (rt (symbol ":foo"))
    ; the dotted-pair separator
    (rt (symbol "."))
    ; contains the bar
    (rt (symbol "a|b"))
    (rt (symbol "a\\b")))
  (test "keywords with awkward spellings round-trip"
    (rt (keyword ""))
    (rt (keyword "a b"))
    (rt (keyword "a}b"))
    (rt (keyword "a|b")))
  (test "a bar-quoted symbol reads to exactly the constructed symbol"
    (assert= (reflect/read-string "|a b|") (symbol "a b"))
    (assert= (reflect/read-string ":|a b|") (keyword "a b"))
    (assert= (reflect/read-string "||") (symbol ""))
    (is (symbol? (reflect/read-string "|a b|")))
    (is (keyword? (reflect/read-string ":|a b|"))))
  (test "an unterminated bar is a clean parse error, not a crash"
    (assert-error (reflect/read-string "|no end")))
  ; a numeric keyword name is fine bare
  (test "clean names still print WITHOUT bars (no needless escaping)"
    (assert= (pr-str 'hello) "hello")
    (assert= (pr-str :my-key) ":my-key")
    ; a valid symbol token
    (assert= (pr-str (symbol "foo1")) "foo1")
    (assert= (pr-str (keyword "123")) ":123"))
  ;; `symbol`/`keyword` can still BUILD a name the reader would reserve — they take
  ;; an arbitrary string. The round-trip is what must hold, and it does for free:
  ;; `printer::symbol_needs_bars` asks `atom::classify`, so the moment `1+` stopped
  ;; classifying as a Symbol the printer started bar-quoting it. No printer change
  ;; was needed — that is the ADR-025 one-definition rule earning its keep.
  (test "a programmatically-built reserved name round-trips through bars"
    (map ["1+" "1/2" "0x1F" "1_000"]
      (fn (n)
        (assert= (pr-str (symbol n)) (str "|" n "|"))
        (assert= (reflect/read-string (pr-str (symbol n))) (symbol n)))))
  (test "display (non-readable) prints the raw name, no bars"
    (assert= (str (symbol "a b")) "a b")
    (assert= (str (keyword "a b")) ":a b")))
