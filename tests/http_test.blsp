;; HTTP/1.0 server (std/http.blsp, ADR-062). Pure parsing/rendering/routing tests,
;; plus an end-to-end loopback request through a real spawned server.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule http-test (:use test) (:use net/http) (:use net/tcp))

(describe "http: request parsing"
  (test "method, path, version, and lower-cased headers"
    (let (r (parse-request "GET /hi HTTP/1.1\r\nHost: example\r\nContent-Length: 0\r\n\r\n"))
      (assert= (get r :method) "GET")
      (assert= (get r :path) "/hi")
      (assert= (get r :version) "HTTP/1.1")
      (assert= (get (get r :headers) "host") "example")))
  (test "a body after the blank line is captured"
    (let (r (parse-request "POST /x HTTP/1.0\r\nContent-Length: 5\r\n\r\nhello"))
      ;; :body is a bytes value (raw); decode it for a text body
      (assert= (utf8-bytes->string (get r :body)) "hello"))))

(describe "http: response rendering"
  (test "status line, Content-Length, and body (render-response is an iolist — ADR-139)"
    (let (s (utf8-bytes->string (bytes-concat (render-response (ok "<p>hi</p>")))))
      (is (string-contains? s "HTTP/1.0 200 OK"))
      (is (string-contains? s "Content-Length: 9"))
      (is (string-contains? s "\r\n\r\n<p>hi</p>"))))
  (test "Content-Length is the body's BYTE count, not codepoints (the UTF-8 bug)"
    ;; "héllo ☃" = 7 codepoints, 10 UTF-8 bytes — the old string-length render
    ;; said 7 and spec-honoring clients truncated the body.
    (let (s (utf8-bytes->string (bytes-concat (render-response (text-response "héllo ☃"))))
          b (bytes-concat (render-response {:status 200 :body (bytes 1 2 3)})))
      (is (string-contains? s "Content-Length: 10"))
      ;; a binary bytes body rides the plain-response path verbatim
      (is (= (match b ((bytes _ & r) (subbytes b (- (count b) 3))) (_ :no)) (bytes 1 2 3)))))
  (test "not-found renders a 404"
    (is (string-contains? (utf8-bytes->string (bytes-concat (render-response (not-found))))
          "404 Not Found"))))

(describe "http: routing + mime"
  (test "router dispatches by path and falls back to 404"
    (let (h (router {"/" (fn (req) (text-response "home"))}))
      (assert= (get (h {:path "/"}) :body) "home")
      (assert= (get (h {:path "/missing"}) :status) 404)))
  (test "mime-type guesses by extension"
    (assert= (mime-type "a/b.html") "text/html; charset=utf-8")
    (assert= (mime-type "a/b.png") "image/png")
    (assert= (mime-type "a/b.xyz") "application/octet-stream")))

(describe "http: streaming responses (the connection-handoff seam)"
  (test "render-head emits the status line + custom headers, no Content-Length"
    (let (h (utf8-bytes->string (bytes-concat (render-head 200 {"Content-Type" "text/event-stream"}))))
      (is (string-contains? h "HTTP/1.0 200 OK"))
      (is (string-contains? h "Content-Type: text/event-stream"))
      (is (string-contains? h "\r\n\r\n"))
      (refute (string-contains? h "Content-Length"))))
  (test "streaming? distinguishes a stream-response from a plain response"
    (is (streaming? (stream-response 200 {} (fn (sock) nil))))
    (refute (streaming? (ok "hi"))))
  (test "a stream-response keeps the connection open and pushes frames"
    (let (me (self))
      ;; A handler that hands the live socket to a stream-fn pushing two frames,
      ;; then closes — so a draining client sees both before EOF (deterministic).
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls
                   (fn (req)
                     (stream-response 200 {"Content-Type" "text/event-stream"}
                       (fn (sock)
                         (tcp-send sock "data: one\n\n")
                         (tcp-send sock "data: two\n\n")
                         (tcp-close sock))))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (c (tcp-connect "127.0.0.1" port))
          (tcp-send c "GET /events HTTP/1.0\r\nHost: localhost\r\n\r\n")
          (let (resp (utf8-bytes->string (tcp-drain c)))
            (tcp-close c)
            (is (string-contains? resp "text/event-stream"))
            (is (string-contains? resp "data: one"))
            (is (string-contains? resp "data: two"))
            ;; the streaming path sends no Content-Length / Connection: close
            (refute (string-contains? resp "Content-Length"))))))))

(describe "http: client url + response parsing"
  (test "parse-url splits scheme/host/port/path"
    (let (u (net/http/parse-url "https://api.github.com/zen"))
      (assert= (get u :scheme) "https")
      (assert= (get u :host) "api.github.com")
      (assert= (get u :port) 443)
      (assert= (get u :path) "/zen")))
  (test "parse-url defaults: http port 80, root path, explicit port"
    (assert= (get (net/http/parse-url "http://example.com") :port) 80)
    (assert= (get (net/http/parse-url "http://example.com") :path) "/")
    (assert= (get (net/http/parse-url "http://h:8080/x") :port) 8080))
  (test "parse-response reads the status line, headers, and body (a bytes value)"
    (let (r (parse-response "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nhi there"))
      (assert= (get r :status) 200)
      (assert= (get (get r :headers) "content-type") "text/plain")
      (is (bytes? (get r :body)))
      (assert= (body-text r) "hi there")))
  (test "parse-response takes wire bytes and keeps a binary body byte-faithful"
    (let (r (parse-response (bytes-concat ["HTTP/1.0 200 OK\r\nContent-Type: application/octet-stream\r\n\r\n"
                                           (bytes 255 0 128)])))
      (assert= (get r :status) 200)
      (assert= (get r :body) (bytes 255 0 128)))))

(describe "http: end-to-end over a loopback server"
  (test "a GET gets the handler's response back"
    (let (me (self))
      ;; the server owns its listener, so it runs in its own process. `spawn` is a
      ;; macro wrapping its expr in a thunk — pass the (do …), not a (fn () …).
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls (router {"/" (fn (req) (ok "<h1>brood</h1>"))})))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (c (tcp-connect "127.0.0.1" port))
          (tcp-send c "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
          (let (resp (utf8-bytes->string (tcp-drain c)))
            (tcp-close c)
            (is (string-contains? resp "200 OK"))
            (is (string-contains? resp "<h1>brood</h1>"))))))))

(describe "http: a binary request body survives byte-faithfully"
  ;; http-read-request reads in binary mode, so a POST body containing bytes that
  ;; aren't valid UTF-8 (0xFF 0x80) reaches the handler intact — the old text-mode
  ;; read replaced them with U+FFFD and miscounted Content-Length.
  (test "the handler sees the exact body bytes the client posted"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 ;; echo the body's bytes back as text so the client can verify
                 (serve-loop ls
                   (fn (req)
                     (text-response
                       (pr-str (into [] (bytes->list (get req :body))))))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (c (tcp-connect "127.0.0.1" port))
          ;; raw body bytes 0xFF 0x80 0x41 ride as a `bytes` leaf in the request
          ;; iolist — no mode games; sends are mode-independent (ADR-141)
          (tcp-send c ["POST /echo HTTP/1.0\r\nHost: localhost\r\n"
                       "Content-Length: 3\r\n\r\n"
                       (bytes 255 128 65)])
          (let (resp (utf8-bytes->string (tcp-drain c)))
            (tcp-close c)
            (is (string-contains? resp "200 OK"))
            ;; the body round-tripped as the exact bytes, not U+FFFD (65533)
            (is (string-contains? resp "[255 128 65]"))))))))

(describe "http: concurrent connections each get their own process"
  (test "many simultaneous GETs all complete (spawn-per-connection)"
    (let (me (self))
      ;; A handler that echoes the request path, so each concurrent client can
      ;; confirm it got *its own* response and not another connection's.
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls (fn (req) (text-response (get req :path)))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout))
            n 4)
        ;; Fire N clients at once, each in its own process; the server must serve
        ;; them in N separate handler processes (the connections overlap in time).
        (dotimes (i n)
          (spawn (do
                   (let (path (str "/" i)
                         resp (http-get (str "http://127.0.0.1:" port path)))
                     (send me [:done (get resp :status) (body-text resp)])))))
        ;; Fan-in: every client reports a 200 whose body is its own requested path.
        (dotimes (_ n)
          (receive
            ([:done status body]
              (assert= status 200)
              (is (string-contains? body "/")))
            (after 5000 (is false))))))))

(describe "http: request building (http/request-headers)"
  (test "adds Host / User-Agent / Connection, and Content-Length when there's a body"
    (let (h (net/http/request-headers {:host "localhost"} (string->utf8-bytes "abc") nil))
      (assert= (get h "Host") "localhost")
      (assert= (get h "User-Agent") "brood")
      (assert= (get h "Connection") "close")
      (assert= (get h "Content-Length") "3")))
  (test "no Content-Length for an empty body"
    (refute (contains? (net/http/request-headers {:host "h"} #b"" nil) "Content-Length")))
  (test "caller headers override the defaults and add new ones"
    (let (h (net/http/request-headers {:host "h"} #b"" {"User-Agent" "bw" "X-Token" "k"}))
      (assert= (get h "User-Agent") "bw")  ; overridden
      (assert= (get h "X-Token") "k"))))  ; added

(describe "http: end-to-end POST + headers over a loopback server"
  (test "http-post round-trips the method, body, and a custom header"
    (let (me (self))
      ;; a handler that echoes back the request's method | body | a custom header
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls
                   (fn (req)
                     (ok (str (get req :method)
                           "|"
                           (utf8-bytes->string (get req :body))
                           "|"
                           (get (get req :headers) "x-token"))))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (resp (http-post (str "http://127.0.0.1:" port "/act")
                     "{\"a\":1}"
                     {:headers {"X-Token" "secret" "Content-Type" "application/json"}}))
          (assert= (get resp :status) 200)
          ;; method echoed as POST, the JSON body intact, the custom header received
          (assert= (body-text resp) "POST|{\"a\":1}|secret")))))
  (test "http-get still works through http-request (delegation intact)"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls (fn (req) (text-response (str "got " (get req :path))))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (resp (http-get (str "http://127.0.0.1:" port "/zen")))
          (assert= (get resp :status) 200)
          (assert= (body-text resp) "got /zen"))))))

(describe "http: https end-to-end (a TLS serve-loop + http-get with :ca)"
  ;; The std server needs NOTHING for TLS: serve-loop accepts on whatever
  ;; listener it is given, and a tls-listen socket delivers the identical
  ;; [:tcp-accept …] / [:tcp …] shapes with transparent en/decryption (ADR-143).
  (test "the std server serves over TLS; http-get fetches with a private trust anchor"
    (let (me (self))
      (spawn (do
               (let (ck (tls-self-signed "localhost")
                     ls (tls-listen "127.0.0.1" 0 (first ck) (second ck)))
                 (send me [:ready (tcp-local-port ls) (first ck)])
                 (serve-loop ls (router {"/" (fn (req) (ok "<h1>secure brood</h1>"))})))))
      (let (pc (receive ([:ready p ct] [p ct]) (after 10000 :timeout)))
        (let (resp (http-get (str "https://localhost:" (first pc) "/")
                     {:ca (second pc)}))
          (assert= (get resp :status) 200)
          (is (string-contains? (body-text resp) "secure brood"))))))
  (test "a binary body is byte-faithful over https too"
    (let (me (self))
      (spawn (do
               (let (ck (tls-self-signed "localhost")
                     ls (tls-listen "127.0.0.1" 0 (first ck) (second ck)))
                 (send me [:ready (tcp-local-port ls) (first ck)])
                 (serve-loop ls
                   (fn (req)
                     (response 200 {"Content-Type" "application/octet-stream"}
                       (bytes 255 128 0 7)))))))
      (let (pc (receive ([:ready p ct] [p ct]) (after 10000 :timeout)))
        (let (resp (http-get (str "https://localhost:" (first pc) "/blob")
                     {:ca (second pc)}))
          (assert= (get resp :status) 200)
          (assert= (get resp :body) (bytes 255 128 0 7)))))))

(describe "http: incremental head scan (ADR-142)"
  (test "a head dripped in chunks parses — including a \\r\\n\\r\\n split across chunks"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls (fn (req) (text-response (get req :path)))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (c (tcp-connect "127.0.0.1" port))
          ;; three sends; the blank-line terminator straddles the 2nd/3rd chunk,
          ;; exercising the scan-from backup of (marker-length - 1) bytes
          (tcp-send c "GET /drip HTT")
          (tcp-send c "P/1.0\r\nHost: x\r\n\r")
          (tcp-send c "\n")
          (let (resp (utf8-bytes->string (tcp-drain c)))
            (tcp-close c)
            (is (string-contains? resp "200 OK"))
            (is (string-contains? resp "/drip")))))))
  (test "a head over *http-max-head-bytes* with no terminator is dropped, not buffered"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls (fn (req) (text-response "never"))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (c (tcp-connect "127.0.0.1" port)
              ;; 70 KiB of header-ish bytes, never a blank line
              junk (bytes-concat (map (fn (_) "X-Junk: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n")
                                   (range 0 1750))))
          (tcp-send c ["GET / HTTP/1.0\r\n" junk])
          ;; the server gives up and closes without ever responding
          (let (got (tcp-drain c))
            (tcp-close c)
            (assert= (byte-length got) 0)))))))

(describe "http: a binary RESPONSE body survives byte-faithfully (client side)"
  ;; The client reads in binary mode (ADR-141), so a response body that isn't
  ;; valid UTF-8 — an image, an archive — reaches the caller intact. Over the
  ;; old text-mode client this was impossible: 0xFF/0x80 became U+FFFD.
  (test "http-get returns the exact bytes the handler served"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls
                   (fn (req)
                     (response 200 {"Content-Type" "application/octet-stream"}
                       (bytes 255 128 65 0 7)))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (resp (http-get (str "http://127.0.0.1:" port "/blob")))
          (assert= (get resp :status) 200)
          (assert= (get (get resp :headers) "content-length") "5")
          (assert= (get resp :body) (bytes 255 128 65 0 7))))))
  (test "a non-ASCII text body round-trips: byte count on the wire, text to the caller"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls (fn (req) (text-response "héllo ☃"))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (resp (http-get (str "http://127.0.0.1:" port "/")))
          (assert= (get resp :status) 200)
          ;; 7 codepoints, 10 UTF-8 bytes — the :body carries the bytes,
          ;; body-text decodes them
          (assert= (count (get resp :body)) 10)
          (assert= (body-text resp) "héllo ☃")))))
  (test "a bytes POST body reaches the handler intact through http-post"
    (let (me (self))
      (spawn (do
               (let (ls (http-listen 0))
                 (send me [:port (tcp-local-port ls)])
                 (serve-loop ls
                   (fn (req)
                     (text-response (pr-str (into [] (bytes->list (get req :body))))))))))
      (let (port (receive ([:port p] p) (after 5000 :timeout)))
        (let (resp (http-post (str "http://127.0.0.1:" port "/up") (bytes 0 255 7)))
          (assert= (get resp :status) 200)
          (assert= (body-text resp) "[0 255 7]"))))))
