;; ADR-674 — "reduce before adding": one iteration form for effects (`doseq`). Stage 1
;; deprecated the forms it replaces (`dotimes`, `dolist`, `unless`, and the public
;; `match*`, now the `%match` engine); stage 2 removed them, each with a rename-ledger
;; entry so the unbound error names its replacement.
;;
;; Three properties matter and each is asserted at the entry point a user reaches:
;;   1. `doseq` takes every shape the removed forms took, and `for`'s whole binding grammar;
;;   2. a call of a removed form is unbound, and both the runtime error and the checker's
;;      diagnostic name the replacement (from `crates/lisp/src/renames.rs`);
;;   3. a deprecated MACRO warns where it is called, though the checker reads expanded code
;;      (a macro's call is gone by then — the reason `deprecated_macros.rs` exists).

(defmodule reduce-forms-test (:use test))

(defn- printed (thunk) (with-out-str (thunk)))

(defn- stability-messages (src)
  (seq/filter (map (reflect/check-string-structured src) (fn (d) (get d :message)))
    (fn (m) (includes? m "is deprecated"))))

;; A deprecated macro of this file's own, so the warning pass is tested on a form that
;; exists: the forms ADR-674 deprecated are gone, and the pass is generic.
(defmacro old-twice (x) `(* 2 ~x))
(meta old-twice :deprecated "0.1.0" :use 'new-twice)
(defmacro new-twice (x) `(* 2 ~x))

(describe "doseq is the one form for effects"
  (test "a counted loop is doseq over a range"
    (assert= (printed (fn () (doseq (i (range 3)) (io/write i)))) "012"))
  (test "a list, a vector, a set and a map each iterate"
    (assert= (printed (fn () (doseq (x '(1 2 3)) (io/write x)))) "123")
    (assert= (printed (fn () (doseq (x [1 2 3]) (io/write x)))) "123")
    (assert= (printed (fn () (doseq (x #{1}) (io/write x)))) "1")
    (assert= (printed (fn () (doseq ([k v] {:a 1}) (io/write (str k v))))) ":a1"))
  (test "for's binding grammar: several pairs (last fastest), :when, destructuring"
    (assert= (printed (fn () (doseq (x [1 2] y ["a" "b"]) (io/write (str x y))))) "1a1b2a2b")
    (assert= (printed (fn () (doseq (x [1 2 3] :when (math/odd? x)) (io/write x)))) "13")
    (assert= (printed (fn () (doseq ([a b] [[1 2] [3 4]]) (io/write (+ a b))))) "37"))
  (test "returns nil whatever the body returns, and runs nothing over an empty collection"
    (assert= (doseq (x [1 2]) (+ x 1)) nil)
    (assert= (printed (fn () (doseq (x []) (io/write x)))) "")
    (assert= (printed (fn () (doseq (i (range 0)) (io/write i)))) ""))
  (test "a body of several forms runs them all, in order"
    (assert= (printed (fn () (doseq (x [1 2]) (io/write (str "a" x)) (io/write (str "b" x)))))
      "a1b1a2b2"))
  (test "a long range runs in constant stack (the fold walks, nothing is collected)"
    (let (t (%table))
      (doseq (i (range 200000)) (%table-put t :last i))
      (assert= (%table-get t :last nil) 199999))))

(describe "doseq across processes"
  :isolated (test "workers spawned from a doseq each report back"
    (let (me (self))
      (doseq (i (range 8)) (spawn (send me [:done (* i i)])))
      (assert= (fold (range 8) 0 (fn (acc _) (+ acc (receive ([:done n] n))))) 140)))
  (test "a doseq inside each worker sends its whole walk"
    (let (me (self))
      (doseq (w (range 4)) (spawn (doseq (x [1 2 3] :when (> x w)) (send me [:x x]))))
      ;; workers 0..3 send the items greater than their index: 3 + 2 + 1 + 0
      (assert= (count (map (range 6) (fn (_) (receive ([:x x] x))))) 6)))
  (test "a function using doseq, read from a global, runs the same in many processes"
    (let (me (self))
      (doseq (_ (range 6))
        (spawn (send me [:s (with-out-str (doseq (i (range 3)) (io/write i)))])))
      (assert= (into [] (map (range 6) (fn (_) (receive ([:s s] s)))))
        ["012" "012" "012" "012" "012" "012"]))))

;; Each call's arguments evaluate to themselves, so the only unbound name is the head.
;; `reflect/eval-string`, so this file's own check never sees the removed names.
(def- *removed*
  [["(dotimes 3)" "dotimes" "renamed to doseq (i (range n)) body… (ADR-674)"]
    ["(dolist [1] 1)" "dolist" "renamed to doseq (ADR-674)"]
    ["(unless false 1)" "unless" "renamed to when (not test) body… (ADR-674)"]
    ["(match* :m 3 1)" "match*" "renamed to match expr (pattern body…)… (ADR-674)"]])

(describe "the removed forms are unbound, and the error names the replacement"
  (test "evaluating a call raises unbound with the ledger's pointer"
    (doseq ([src name pointer] *removed*)
      (let (msg (try (reflect/eval-string src) (catch e (error-message e))))
        (is (includes? msg (str "unbound symbol: " name)))
        (is (includes? msg pointer)))))
  (test "the checker reports the same call unbound, with the same pointer"
    (doseq ([src name pointer] *removed*)
      (let (unbound (seq/filter (map (reflect/check-string-structured (str "(defn f () " src ")"))
                                  (fn (d) (get d :message)))
                      (fn (m) (includes? m (str "unbound symbol: " name)))))
        (assert= (count unbound) 1)
        (is (includes? (first unbound) pointer)))))
  (test "none of the four is bound any more"
    (assert= (seq/filter ['dotimes 'dolist 'unless 'match*] bound?) nil)))

(describe "a deprecated macro warns where it is called"
  (test "the call names the replacement"
    (let (msgs (stability-messages "(defn f (n) (reduce-forms-test/old-twice n))"))
      (assert= (count msgs) 1)
      (is (includes? (first msgs) "is deprecated since 0.1.0"))
      (is (includes? (first msgs) "use `new-twice` instead"))))
  (test "check-allow :deprecated silences it, and quoted data never warns"
    (assert= (stability-messages "(defn f (n) (check-allow :deprecated (reduce-forms-test/old-twice n)))")
      nil)
    (assert= (stability-messages "(def q '(reduce-forms-test/old-twice 1))") nil))
  (test "a file's own definition of the name is its own, not the deprecated macro"
    (assert= (stability-messages "(defn reduce-forms-test/old-twice (x) x) (defn g () (reduce-forms-test/old-twice 1))")
      nil))
  (test "the replacements do not warn"
    (assert= (stability-messages "(defn f (ok xs) (when (not ok) (doseq (i (range 3)) (io/write i))) (doseq (x xs) (match x (n n))))")
      nil)))
