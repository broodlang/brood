;; ADR-674 — "reduce before adding": one iteration form for effects (`doseq`), and the
;; forms it replaces deprecated in stage 1 (`dotimes`, `dolist`, `unless`, and the public
;; `match*`, now the `%match` engine). Stage 2, before 1.0, removes them; until then each
;; still works, `nest check` warns at every use, and `nest format --migrate` rewrites it.
;;
;; Three properties matter and each is asserted at the entry point a user reaches:
;;   1. `doseq` takes every shape the retired forms took, and `for`'s whole binding grammar;
;;   2. a deprecated form warns where it is called, though the checker reads expanded code
;;      (a macro's call is gone by then — the reason `deprecated_macros.rs` exists);
;;   3. `migrate/text` turns each old form into the new one, and leaves strings, comments
;;      and quoted data alone.

(defmodule reduce-forms-test (:use test))

(defn- printed (thunk) (with-out-str (thunk)))

(defn- stability-messages (src)
  (seq/filter (map (reflect/check-string-structured src) (fn (d) (get d :message)))
    (fn (m) (includes? m "is deprecated"))))

(describe "doseq is the one form for effects"
  (test "a counted loop is doseq over a range"
    (assert= (printed (fn () (doseq (i (range 3)) (io/write i)))) "012"))
  (test "a list, a vector, a set and a map each iterate"
    (assert= (printed (fn () (doseq (x '(1 2 3)) (io/write x)))) "123")
    (assert= (printed (fn () (doseq (x [1 2 3]) (io/write x)))) "123")
    (assert= (printed (fn () (doseq (x #{1}) (io/write x)))) "1")
    (assert= (printed (fn () (doseq ([k v] {:a 1}) (io/write (str k v))))) ":a1"))
  (test "for's binding grammar: several pairs (last fastest), :when, destructuring"
    (assert= (printed (fn () (doseq (x [1 2] y ["a" "b"]) (io/write (str x y))))) "1a1b2a2b")
    (assert= (printed (fn () (doseq (x [1 2 3] :when (math/odd? x)) (io/write x)))) "13")
    (assert= (printed (fn () (doseq ([a b] [[1 2] [3 4]]) (io/write (+ a b))))) "37"))
  (test "returns nil whatever the body returns, and runs nothing over an empty collection"
    (assert= (doseq (x [1 2]) (+ x 1)) nil)
    (assert= (printed (fn () (doseq (x []) (io/write x)))) "")
    (assert= (printed (fn () (doseq (i (range 0)) (io/write i)))) ""))
  (test "a body of several forms runs them all, in order"
    (assert= (printed (fn () (doseq (x [1 2]) (io/write (str "a" x)) (io/write (str "b" x)))))
      "a1b1a2b2"))
  (test "a long range runs in constant stack (the fold walks, nothing is collected)"
    (let (t (%table))
      (doseq (i (range 200000)) (%table-put t :last i))
      (assert= (%table-get t :last nil) 199999))))

(describe "doseq across processes"
  :isolated (test "workers spawned from a doseq each report back"
    (let (me (self))
      (doseq (i (range 8)) (spawn (send me [:done (* i i)])))
      (assert= (fold (range 8) 0 (fn (acc _) (+ acc (receive ([:done n] n))))) 140)))
  (test "a doseq inside each worker sends its whole walk"
    (let (me (self))
      (doseq (w (range 4)) (spawn (doseq (x [1 2 3] :when (> x w)) (send me [:x x]))))
      ;; workers 0..3 send the items greater than their index: 3 + 2 + 1 + 0
      (assert= (count (map (range 6) (fn (_) (receive ([:x x] x))))) 6)))
  (test "a function using doseq, read from a global, runs the same in many processes"
    (let (me (self))
      (doseq (_ (range 6))
        (spawn (send me [:s (with-out-str (doseq (i (range 3)) (io/write i)))])))
      (assert= (into [] (map (range 6) (fn (_) (receive ([:s s] s)))))
        ["012" "012" "012" "012" "012" "012"]))))

(describe "the deprecated forms still work"
  ;; `check-allow`: this file is checked at zero warnings, and these are the calls we are
  ;; telling everyone not to make.
  (test "dotimes, dolist, unless and match* behave as they did"
    (check-allow :deprecated
      (do
        (assert= (printed (fn () (dotimes (i 3) (io/write i)))) "012")
        (assert= (printed (fn () (dolist (x '("a" "b")) (io/write x)))) "ab")
        (assert= (dotimes (i 2) (str i)) nil)
        (assert= (unless false :yes) :yes)
        (assert= (unless true :yes) nil)
        (assert= (match* :m 3 (n (* n 2))) 6)))))

(describe "a deprecated form warns where it is called"
  (test "each of the four names its replacement and the migration"
    (doseq ([src name use] [["(defn f (n) (dotimes (i n) (io/write i)))" "dotimes" "doseq"]
                             ["(defn f (xs) (dolist (x xs) (io/write x)))" "dolist" "doseq"]
                             ["(defn f (ok) (unless ok :no))" "unless" "when"]
                             ["(defn f (v) (match* :m v (n n)))" "match*" "match"]])
      (let (msgs (stability-messages src))
        (assert= (count msgs) 1)
        (is (includes? (first msgs) (str "`" name "` is deprecated since 0.51.0")))
        (is (includes? (first msgs) (str "use `" use "` instead")))
        (is (includes? (first msgs) "nest format --migrate")))))
  (test "check-allow :deprecated silences it, and quoted data never warns"
    (assert= (stability-messages "(defn f (ok) (check-allow :deprecated (unless ok :no)))") nil)
    (assert= (stability-messages "(def q '(unless a b))") nil))
  (test "a module's own definition of the name is its own, not the deprecated macro"
    (assert= (stability-messages "(defmodule own-unless (:shadow unless)) (defn unless (x) x) (defn g () (unless 1))")
      nil))
  (test "the replacements do not warn"
    (assert= (stability-messages "(defn f (ok xs) (when (not ok) (doseq (i (range 3)) (io/write i))) (doseq (x xs) (match x (n n))))")
      nil)))

(describe "nest format --migrate rewrites each form"
  (test "dotimes becomes doseq over a range"
    (assert= (migrate/text "(dotimes (i n) (f i))") "(doseq (i (range n)) (f i))")
    (assert= (migrate/text "(dotimes (i (count v)) (f i))") "(doseq (i (range (count v))) (f i))"))
  (test "dolist becomes doseq"
    (assert= (migrate/text "(dolist (x xs)\n  (f x))") "(doseq (x xs)\n  (f x))"))
  (test "unless becomes when over a not, and a negated test loses its not"
    (assert= (migrate/text "(unless ok (a) (b))") "(when (not ok) (a) (b))")
    (assert= (migrate/text "(unless (not ok) (go))") "(when ok (go))"))
  (test "match* becomes %match, root-scoped too"
    (assert= (migrate/text "(match* :m v (n n))") "(%match :m v (n n))")
    (assert= (migrate/text "(/match* :m v (n n))") "(/%match :m v (n n))"))
  (test "a root-escaped unless keeps its not root-escaped, as a prelude template needs"
    (assert= (migrate/text "`(/unless ~t ~@body)") "`(/when (/not ~t) ~@body)"))
  (test "a template is code it emits, so it is rewritten; quoted data is not"
    (assert= (migrate/text "`(unless ~t ~@body)") "`(when (not ~t) ~@body)")
    (assert= (migrate/text "'(unless a b)") "'(unless a b)")
    (assert= (migrate/text "(quote (dotimes (i 2) x))") "(quote (dotimes (i 2) x))"))
  (test "strings and comments come back byte for byte"
    (let (src "(def s \"(unless x y)\") ; (dolist (x xs))\n")
      (assert= src (migrate/text src))))
  (test "the rewrites nest"
    (assert= (migrate/text "(dotimes (i 3) (unless (done? i) (dolist (x (xs i)) (f x))))")
      "(doseq (i (range 3)) (when (not (done? i)) (doseq (x (xs i)) (f x))))"))
  (test "a migrated program runs as the original did"
    (let (src "(with-out-str (dotimes (i 3) (unless (= i 1) (dolist (x '(:a)) (io/write i x)))))")
      (assert= (reflect/eval-string src)
        (reflect/eval-string (migrate/text src))))))
