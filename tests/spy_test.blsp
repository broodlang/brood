;; Tests for `spy` — the homoiconic tree-tracing debug macro (ADR-173).
;; The core contract is referential transparency: `spy` returns its expression's
;; value unchanged and only adds trace side-effects through `*spy-sink*`. Tests
;; rebind the sink to a collector (or a no-op) so nothing leaks to stderr and the
;; trace can be asserted as data.
(defmodule spy-test (:use test))

;; A no-op sink: prove transparency without any output.
(defn silent (thunk) (binding (*spy-sink* (fn (entry) nil)) (thunk)))

;; A collecting sink: return a table of {source-string -> value} for :node entries.
(defn traced-nodes (thunk)
  (let (out (table))
    (binding (*spy-sink* (fn (entry)
                           (when (= (:spy entry) :node)
                             (table-put out (pr-str (:form entry)) (:value entry)))))
      (thunk))
    out))

(defn add5 (n) (+ n 5))

(describe "spy — referential transparency"
  (test "returns the value of a nested arithmetic expression unchanged"
    (assert= 27 (silent (fn () (spy (+ (* 5 4) (add5 2)))))))
  (test "returns the value of a pipeline unchanged"
    (assert= 6 (silent (fn () (spy (->> [1 2 3 4] (map inc) (filter even?) (reduce + 0)))))))
  (test "a plain literal or symbol passes through"
    (assert= 42 (silent (fn () (spy 42))))
    (assert= [1 2] (silent (fn () (spy [1 2])))))
  (test "propagates an error exactly as the bare expression would"
    (assert-error (silent (fn () (spy (+ 1 (first []))))))))

(describe "spy — the trace as data"
  (test "each call node's value is captured, keyed by its source form"
    (let (nodes (traced-nodes (fn () (spy (+ (* 2 3) (- 10 1))))))
      (assert= 6 (table-get nodes "(* 2 3)"))
      (assert= 9 (table-get nodes "(- 10 1)"))
      (assert= 15 (table-get nodes "(+ (* 2 3) (- 10 1))"))))
  (test "pipeline stages are traced (the general walker subsumes the pipe case)"
    (let (nodes (traced-nodes (fn () (spy (->> [1 2 3] (map inc) (reduce + 0))))))
      (assert= (list 2 3 4) (table-get nodes "(map inc [1 2 3])"))
      (assert= 9 (table-get nodes "(reduce + 0 (map inc [1 2 3]))")))))

(describe "spy — laziness is preserved"
  ; untaken branch absent
  (test "an untaken if branch never traces (and never runs)"
    (let (nodes (traced-nodes (fn () (spy (if (> 1 2) (add5 100) (add5 1))))))
      ; taken branch traced
      (assert= 6 (table-get nodes "(add5 1)"))
      (assert= nil (table-get nodes "(add5 100)"))))
  (test "a short-circuited `and` tail never traces"
    (let (nodes (traced-nodes (fn () (spy (and (> 1 2) (add5 100))))))
      (assert= nil (table-get nodes "(add5 100)"))))
  (test "a `let` traces its binding RHS and body"
    (let (nodes (traced-nodes (fn () (spy (let (x (+ 1 2) y (* 3 4)) (+ x y))))))
      (assert= 3 (table-get nodes "(+ 1 2)"))
      (assert= 12 (table-get nodes "(* 3 4)"))
      (assert= 15 (table-get nodes "(+ x y)")))))

(describe "spy — opaque positions"
  (test "an fn body is not traced, but the enclosing call result is"
    (let (nodes (traced-nodes (fn () (spy (map (fn (n) (* n n)) [1 2 3])))))
      ; fn body opaque
      (assert= nil (table-get nodes "(* n n)"))
      (assert= (list 1 4 9) (table-get nodes "(map (fn (n) (* n n)) [1 2 3])"))))
  (test "quoted data is left untouched"
    (assert= (list 'a 'b) (silent (fn () (spy (quote (a b))))))))

;; ---- cross-process: spy runs correctly on the worker pool, values cross heaps.
;; The sink is a process-local dynamic, so a worker traces (or silences) on its
;; own; the *returned value* is what crosses the heap boundary on `send`.
; 1+4+9+16
(describe "spy across processes"
  :isolated
  (test "a worker spy-computes a value and sends it; the parent gets it intact"
    (let (me (self))
      (spawn (binding (*spy-sink* (fn (entry) nil))
               (send me [:ok (spy (+ (* 6 7) (- 0 0)))])))
      (assert= 42 (receive ([:ok v] v)))))
  (test "many workers spy-build results; the parent folds them by fanning in"
    (letrec (spawn-n (fn (n)
                       (when (> n 0)
                         (let (me (self))
                           (spawn (binding (*spy-sink* (fn (entry) nil))
                                    (send me [:ok (spy (* n n))]))))
                         (spawn-n (dec n))))
             collect (fn (n acc)
                       (if (= n 0)
                         acc
                         (collect (dec n) (+ acc (receive ([:ok v] v)))))))
      (spawn-n 4)
      (assert= 30 (collect 4 0)))))
