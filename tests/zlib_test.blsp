(defmodule zlib-test (:use test))

(defn big (unit n)
  "A string of `unit` repeated `n` times — compressible test data."
  (apply str (map (fn (_) unit) (range 0 n))))

(describe "gzip/gunzip"
  (test "round-trips a string"
    (assert= "hello" (string/bytes-> (zlib/gunzip (zlib/gzip "hello")))))
  (test "round-trips a bytes value"
    (let (b (string/->bytes "the quick brown fox jumps over the lazy dog"))
      (assert= b (zlib/gunzip (zlib/gzip b)))))
  (test "compresses repetitive data smaller than the input"
    (let (s (big "ababababab" 100))
      (is (< (bytes/length (zlib/gzip s)) (bytes/length (string/->bytes s))))))
  (test "output carries the gzip magic bytes (0x1f 0x8b)"
    (let (gz (zlib/gzip "x"))
      (assert= 31 (bytes/at gz 0))
      (assert= 139 (bytes/at gz 1))))
  (test "gunzip raises on data that isn't gzip"
    (is (= :raised
          (try
            (do (zlib/gunzip (string/->bytes "definitely not gzip")) :ok)
            (catch e :raised))))))

(describe "zlib compress/uncompress (RFC 1950)"
  (test "round-trips"
    (assert= "payload"
      (string/bytes-> (zlib/uncompress (zlib/compress "payload")))))
  (test "empty input round-trips"
    (assert= "" (string/bytes-> (zlib/uncompress (zlib/compress ""))))))

(describe "raw deflate zip/unzip (RFC 1951)"
  (test "round-trips"
    (assert= "payload" (string/bytes-> (zlib/unzip (zlib/zip "payload")))))
  (test "raw deflate is smaller than gzip for the same data (no header/checksum)"
    (let (s (big "compress me " 50))
      (is (<= (bytes/length (zlib/zip s)) (bytes/length (zlib/gzip s)))))))

(describe "compression level (optional arg, 0-9)"
  (test "level 9 round-trips like the default"
    (assert= "hello world"
      (string/bytes-> (zlib/gunzip (zlib/gzip "hello world" 9)))))
  (test "level 0 (store) round-trips and is larger than level 9"
    (let (s (big "the quick brown fox " 80))
      (assert= s (string/bytes-> (zlib/gunzip (zlib/gzip s 0))))
      (is (> (bytes/length (zlib/gzip s 0)) (bytes/length (zlib/gzip s 9))))))
  (test "level 9 is no larger than the default for repetitive data"
    (let (s (big "ababababab " 100))
      (is (<= (bytes/length (zlib/gzip s 9)) (bytes/length (zlib/gzip s))))))
  (test "level applies to zlib/compress and zlib/zip too"
    (let (s (big "payload " 60))
      (assert= s (string/bytes-> (zlib/uncompress (zlib/compress s 9))))
      (assert= s (string/bytes-> (zlib/unzip (zlib/zip s 9))))
      (is (> (bytes/length (zlib/zip s 0)) (bytes/length (zlib/zip s 9))))))
  (test "an out-of-range level raises"
    (is (= :raised (try (do (zlib/gzip "x" 10) :ok) (catch e :raised))))
    (is (= :raised (try (do (zlib/gzip "x" -1) :ok) (catch e :raised))))))

(describe "brotli / unbrotli (RFC 7932, Content-Encoding: br)"
  (test "round-trips a string"
    (assert= "hello brotli"
      (string/bytes-> (zlib/unbrotli (zlib/brotli "hello brotli")))))
  (test "round-trips a bytes value"
    (let (b (string/->bytes "the quick brown fox jumps over the lazy dog"))
      (assert= b (zlib/unbrotli (zlib/brotli b)))))
  (test "compresses repetitive data smaller than the input"
    (let (s (big "ababababab " 100))
      (is (< (bytes/length (zlib/brotli s)) (bytes/length (string/->bytes s))))))
  (test "quality 11 is no larger than quality 0 for repetitive data"
    (let (s (big "the quick brown fox " 80))
      (assert= s (string/bytes-> (zlib/unbrotli (zlib/brotli s 11))))
      (is (<= (bytes/length (zlib/brotli s 11)) (bytes/length (zlib/brotli s 0))))))
  (test "beats gzip on repetitive text"
    (let (s (big "compress this text " 200))
      (is (<= (bytes/length (zlib/brotli s 11)) (bytes/length (zlib/gzip s 9))))))
  (test "empty input round-trips"
    (assert= "" (string/bytes-> (zlib/unbrotli (zlib/brotli "")))))
  (test "unbrotli raises on data that isn't brotli"
    (is (= :raised
          (try
            (do (zlib/unbrotli (string/->bytes "definitely not brotli xyz")) :ok)
            (catch e :raised)))))
  (test "an out-of-range quality raises"
    (is (= :raised (try (do (zlib/brotli "x" 12) :ok) (catch e :raised))))
    (is (= :raised (try (do (zlib/brotli "x" -1) :ok) (catch e :raised))))))
