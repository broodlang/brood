;;; Regression guard for the LINMAP wrapper-split (`BROOD_LINMAP=0` disables it).
;;;
;;; LINMAP proves a map accumulator is *linear* — no other reference can observe it — and
;;; rewrites the fold to build in place on a `Table`, snapshotting back to an immutable map
;;; at the end. That keeps ADR-026 intact: the mutation is an implementation detail of
;;; constructing the value, never a mutable value the language can see. Two ways it broke:
;;;
;;;   1. The wrapper applied `table/snapshot` to the loop's result **unconditionally**, but
;;;      the linearity proof deliberately admits a base case that returns something OTHER
;;;      than the accumulator — a whitelisted read of it, or a plain constant. Those folds
;;;      died with `table/snapshot: expected table, got int (3)`. The proof was right; the
;;;      wrapper had to account for what it allows.
;;;
;;;   2. The source rewrite descended into `(quote …)`, turning inert DATA into table ops:
;;;      `(io/puts '(%map-get acc 1))` printed `(table/get acc 1)`. The probe cannot catch
;;;      this — a quoted form compiles to one `Node::Const`, so the analysis sees no
;;;      accumulator use at all and passes while the rewrite walks straight through it.
;;;
;;;   3. (2026-09-16) The tally a Brood user WRITES — `(assoc m k (+ (get m k 0) e))` — was
;;;      an escape: only the kernel spelling `%map-int-add` was rewritten, so the idiomatic
;;;      fold ran 8x slower (brood-benchmarks `wordcount` 848 vs 99 ms). It is now fused into
;;;      `%table-add`, which adds exactly as `+` does — the cases below pin that the float,
;;;      bignum and error behaviour of the source survive, not just the integer case.
;;;      `crates/lisp/tests/linmap_idiom.rs` pins that the rewrite actually FIRES on each
;;;      shape (and declines the ones it must), by inspecting the expansion.
;;;
;;;   4. (2026-09-16) The SEED is the one thing the linearity proof cannot see. The wrapper
;;;      copies the accumulator's input map into its table, and a table cannot hold every
;;;      value a map can — `(lm-idiom '(:a) {:r <rope>})` raised `cannot send a rope` with the
;;;      rewrite on and returned the map with it off. `%table-from-map` now answers nil for
;;;      such a seed (and for a record, whose misses consult `Lookup`), and the wrapper runs
;;;      an unrewritten copy of the loop. The cases below seed with each such value.
;;;
;;; Every test asserts the value the fold should produce; each is checked against the
;;; disabled path in CI simply by the suite running under both engines, and by hand with
;;; `BROOD_LINMAP=0`, which must agree.

(defmodule linmap-soundness-test (:use test))

;; Base case returns a *derived scalar*, not the accumulator.
(defn lm-count-uniq (xs acc)
  (if (empty? xs)
    (%map-count acc)
    (lm-count-uniq (rest xs) (%map-int-add acc (first xs) 1))))

;; Base case returns a whitelisted *read* of the accumulator.
(defn lm-hits (xs acc)
  (if (empty? xs)
    (%map-get acc :a)
    (lm-hits (rest xs) (%map-int-add acc (first xs) 1))))

;; Base case returns a plain constant — the accumulator is never returned at all.
(defn lm-done (xs acc)
  (if (empty? xs) :done (lm-done (rest xs) (%map-int-add acc (first xs) 1))))

;; Base case returns the accumulator itself — the shape the optimisation is for.
(defn lm-tally (xs acc)
  (if (empty? xs) acc (lm-tally (rest xs) (%map-int-add acc (first xs) 1))))

;; The idiomatic tally — the shape a user writes (wordcount's `(+ 1 (get m k 0))` order).
(defn lm-idiom (xs acc)
  (if (empty? xs) acc (lm-idiom (rest xs) (assoc acc (first xs) (+ 1 (get acc (first xs) 0))))))

;; The other operand order, a let-bound key, and a compound addend (persistent-map's shape).
(defn lm-idiom-let (i acc)
  (if (>= i 12)
    acc
    (let (k (math/rem i 3))
      (lm-idiom-let (+ i 1) (assoc acc k (+ (get acc k 0) (+ 1 (math/rem k 7))))))))

;; A read of the accumulator beside the update, and a `get` read as the base case.
(defn lm-idiom-read (i acc)
  (if (>= i 6)
    (get acc 0 :absent)
    (lm-idiom-read (+ i 1) (assoc acc (math/rem i 2) (+ (get acc (math/rem i 2) 0) (get acc 1 0))))))

;; A 2-arity `get` as the base case (an absent key is nil, like the source).
(defn lm-idiom-get2 (i acc)
  (if (>= i 3) (get acc :never) (lm-idiom-get2 (+ i 1) (assoc acc :x (+ (get acc :x 0) 1)))))

;; A constant key, so the seed's value under it is what `+` sees.
(defn lm-idiom-const (i acc)
  (if (>= i 3) acc (lm-idiom-const (+ i 1) (assoc acc :x (+ (get acc :x 0) 9223372036854775807)))))

;; A record whose misses go through `Lookup`: the answer for an absent key is the ability's,
;; and a table would answer nil — so a tally seeded with one must run the loop as written.
(defrecord lm-counter (hits))
(impl Lookup
  lm-counter
  (lookup-get [c k] (if (= k :hits) (get c :hits) 100))
  (lookup-keys [c] (list :hits)))

;; `inc`, `dec` and `-` spellings of the same tally.
(defn lm-inc (xs acc)
  (if (empty? xs) acc (lm-inc (rest xs) (assoc acc (first xs) (inc (get acc (first xs) 0))))))
(defn lm-dec (xs acc)
  (if (empty? xs) acc (lm-dec (rest xs) (assoc acc (first xs) (dec (get acc (first xs) 0))))))
(defn lm-sub (i acc)
  (if (>= i 4) acc (lm-sub (+ i 1) (assoc acc :k (- (get acc :k 0) (* 2 i))))))

;; The same tally through a `fold` / `reduce` literal (ADR-360 §6) — no defn threads the map.
;; `check-allow`: one caller below hands `lm-fold` the seed `5` on purpose (the runtime
;; error is the assertion), and since the fold callback's accumulator is seeded from `init`
;; (2026-09-20) the checker sees that `m` can be `5` at the `assoc` — it is right.
(check-allow :type-mismatch
  (defn lm-fold (xs seed) (fold xs seed (fn (m x) (assoc m x (inc (get m x 0)))))))
(defn lm-reduce (xs seed) (reduce xs seed (fn (m x) (assoc m x (+ 2 (get m x 0))))))
(defn lm-fold-read (xs seed) (fold xs seed (fn (m x) (assoc m x (+ (get m x 0) (get m :w 0))))))
(check-allow :type-mismatch
  (defn lm-fold-shadowed (xs)
    (let (fold (fn (c i f) :mine)) (fold xs {} (fn (m x) (assoc m x (inc (get m x 0))))))))

;; Quoted data alongside a qualifying accumulator fold.
(defn lm-quoted (xs acc)
  (if (empty? xs)
    (list acc '(%map-get acc 1))
    (lm-quoted (rest xs) (%map-int-add acc (first xs) 1))))

(describe "LINMAP wrapper-split soundness"
  (test "a base case returning a derived scalar"
    (assert= 3 (lm-count-uniq '(:a :b :a :c) {})))

  (test "a base case returning a read of the accumulator"
    (assert= 2 (lm-hits '(:a :b :a) {})))

  (test "a base case returning a constant"
    (assert= :done (lm-done '(:a) {})))

  (test "a base case returning the accumulator is still an immutable map"
    (let (out (lm-tally '(:a :b :a) {}))
      (assert= 2 (%map-get out :a))
      (assert= 1 (%map-get out :b))
      ;; It must come back as a map, not leak the in-place table.
      (assert= :map (type-of out))))

  (test "the idiomatic tally builds the same map as the kernel spelling"
    (assert= (lm-tally '(:a :b :a :c :a) {}) (lm-idiom '(:a :b :a :c :a) {}))
    (assert= {:a 3 :b 1 :c 1} (lm-idiom '(:a :b :a :c :a) {}))
    (assert= :map (type-of (lm-idiom '(:a) {}))))

  (test "the idiomatic tally seeds from the map it is given"
    (assert= {:a 13 :b 1 :c 0} (lm-idiom '(:a :b :a :c :a) {:a 10 :b 0 :c -1})))

  (test "a let-bound key and a compound addend"
    ;; keys 0,1,2 four times each; addend 1 + (rem k 7) = 1, 2, 3
    (assert= {0 4 1 8 2 12} (lm-idiom-let 0 {})))

  (test "a read of the accumulator beside the update, and as the base case"
    ;; i=0: k0 += 0 (k1 absent) → {0 0}; i=1: k1 += 0 → {0 0, 1 0}; the rest add 0 too.
    (assert= 0 (lm-idiom-read 0 {}))
    ;; Seeded k1 = 5: k0 += k1 and k1 += k1 alternate — 5, 10, 15, 20, 35, 40 — so k0 is 35.
    (assert= 35 (lm-idiom-read 0 {1 5}))
    (assert= :absent (lm-idiom-read 6 {}))
    (assert= nil (lm-idiom-get2 0 {})))

  (test "the fused add adds exactly as + does: floats, bignums, and its error"
    ;; A float stored under the key: `(+ 1.5 1)` is 2.5, where a table-incr would raise.
    (assert= {:a 2.5 :b 1} (lm-idiom '(:a :b) {:a 1.5}))
    ;; An int seed with a float addend in the let shape — the sum is a float.
    (assert= {0 4.5 1 8 2 12} (lm-idiom-let 0 {0 0.5}))
    ;; i64 overflow promotes to a bignum, as `+` does — never a range error.
    (assert= (* 3 9223372036854775807) (get (lm-idiom-const 0 {}) :x))
    ;; A non-number under the key is `+`'s own error, naming `+`.
    (assert-error "+: expected number" (lm-idiom '(:a) {:a "s"})))

  (test "a seed a table cannot hold runs the loop as written"
    ;; A rope, a builtin and a lazy view cannot be sent, so they cannot be table values.
    (let (r (text/from-string "x"))
      (assert= {:r r :a 2} (lm-idiom '(:a :a) {:r r}))
      (assert= 2 (get (lm-idiom '(:a :a) {:r r}) :a))
      (assert= :rope (type-of (get (lm-idiom '(:a) {:r r}) :r))))
    (let (out (lm-idiom '(:a) {:f string/length}))
      (assert= 1 (get out :a))
      (assert= 2 ((get out :f) "hi")))
    (let (out (lm-idiom '(:a :b) {:v (seq/lmap (list 0 1 2) inc)}))
      (assert= 1 (get out :a))
      (assert= (list 1 2 3) (seq (get out :v))))
    ;; The plain shape still takes the table path — the split is visible only as speed,
    ;; so pin that a plain seed's result is a map, not a table, either way.
    (assert= :map (type-of (lm-idiom '(:a) {:b 1}))))

  (test "a record seed keeps its Lookup answers"
    ;; `get` consults `Lookup` only when the map lookup answers nil — so the tally's
    ;; `(get c :zz 0)` never reaches it (the default is 0) and counts from 0 either way,
    ;; while the 2-arity `(get acc :never)` base case is 100 through `Lookup`, where a table
    ;; would have answered nil. The result is still the record (its `:__id__` kept).
    (let (out (lm-idiom '(:zz :zz) (lm-counter 5)))
      (assert= 2 (get out :zz))
      (assert= 5 (get out :hits))
      (assert= (lm-counter 5) (dissoc out :zz)))
    (assert= 100 (lm-idiom-get2 0 (lm-counter 5)))
    (assert= nil (lm-idiom-get2 0 {:hits 5})))

  (test "inc, dec and - are the same tally"
    (assert= {:a 3 :b 1} (lm-inc '(:a :b :a :a) {}))
    (assert= {:a -3 :b -1} (lm-dec '(:a :b :a :a) {}))
    (assert= {:k -12} (lm-sub 0 {}))
    (assert= {:k 2.5 :x 1} (lm-inc '(:x) {:k 2.5}))
    (assert= {:k 1.5} (lm-dec '(:k) {:k 2.5}))
    ;; Past i64::MIN `dec` promotes, as `-` does — and its error names `-`, as `dec`'s would.
    (assert= (- -9223372036854775808 1) (get (lm-dec '(:k) {:k -9223372036854775808}) :k))
    (assert-error "-: expected number" (lm-dec '(:k) {:k "s"}))
    (assert-error "+: expected number" (lm-inc '(:k) {:k "s"})))

  (test "a fold literal is the same tally as the loop"
    (assert= (lm-idiom '(:a :b :a :c :a) {}) (lm-fold '(:a :b :a :c :a) {}))
    (assert= {:a 6 :b 2} (lm-reduce '(:a :b :a :a) {}))
    (assert= :map (type-of (lm-fold '(:a) {})))
    (assert= {:w 5 :a 10} (lm-fold-read '(:a :a) {:w 5}))
    ;; The seed is what it is: a rope keeps the loop as written, a record its Lookup
    ;; answers, a non-map its own error — the same as the source on every one.
    (let (r (text/from-string "x"))
      (assert= {:r r :a 2} (lm-fold '(:a :a) {:r r})))
    (assert= 2 (get (lm-fold '(:zz :zz) (lm-counter 5)) :zz))
    (assert-error "get: expected a collection" (lm-fold '(:a) 5))
    ;; A shadowed `fold` is the shadow's, untouched.
    (assert= :mine (lm-fold-shadowed '(:a)))
    ;; `seq/frequencies` is this shape now.
    (assert= {:a 3 :b 1 :c 1} (seq/frequencies '(:a :b :a :c :a)))
    (assert= {} (seq/frequencies nil)))

  (test "quoted data is left alone by the source rewrite"
    (let (out (lm-quoted '(:a) {}))
      (assert= 1 (%map-get (first out) :a))
      ;; The datum must still be `(%map-get acc 1)` — not rewritten to a table op.
      (assert= '%map-get (first (first (rest out)))))))
