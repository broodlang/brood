;; The string library: kernel primitives `upper`/`lower`/`string->number` (Rust)
;; plus the Brood layer over `substring`/`str` (char-at, string->list, index-of,
;; join, string-split, replace, trim, …). Register-only — discovered and run by
;; `nest test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule strings-test (:use test))

(describe "case folding"
  (test "upper / lower"
    (assert= (string/upper "Hello, World!") "HELLO, WORLD!")
    (assert= (string/lower "Hello, World!") "hello, world!"))
  (test "idempotent on already-cased / non-alpha"
    (assert= (string/upper "ABC 123") "ABC 123")
    (assert= (string/lower "abc 123") "abc 123"))
  (test "Unicode-aware" (assert= (string/upper "ß") "SS") (assert= (string/upper "naïve") "NAÏVE")))

(describe "string <-> number"
  (test "integers parse to ints"
    (assert= (string->number "42") 42)
    (assert= (string->number "-7") -7))
  (test "floats parse to floats"
    (assert= (string->number "3.5") 3.5)
    (assert= (string->number "-0.25") -0.25))
  (test "non-numbers and partial matches are nil"
    (assert= (string->number "x") nil)
    (assert= (string->number "3abc") nil)
    (assert= (string->number "") nil)
    (assert= (string->number " 5") nil))
  (test "str is string->number's inverse"
    (assert= (str 42) "42")
    (assert= (str 3.5) "3.5")
    (assert= (string->number (str 99)) 99))
  (test "integers past i64 parse to bignums, not lossy floats"
    (assert= (string->number "98765432109876543210987654321")
      98765432109876543210987654321)
    (assert= (string->number "-98765432109876543210987654321")
      -98765432109876543210987654321)
    ;; the round-trip that used to silently round through f64
    (assert= (string->number (str 98765432109876543210987654321))
      98765432109876543210987654321)))

(describe "characters & lists"
  (test "char-at is char-indexed"
    (assert= (string/char-at "hello" 0) "h")
    (assert= (string/char-at "hello" 4) "o"))
  (test "string->list yields 1-char strings"
    (assert= (string/->list "abc") (list "a" "b" "c"))
    (assert= (string/->list "") nil))
  (test "list->string reassembles"
    (assert= (string/list-> (list "a" "b" "c")) "abc")
    (assert= (string/list-> (string/->list "round-trip")) "round-trip")))

(describe "substring"
  (test "three-arg form takes the range [start, end)"
    (assert= (string/substring "hello" 1 4) "ell")
    (assert= (string/substring "hello" 0 0) ""))
  (test "two-arg form runs from start to the end"
    (assert= (string/substring "hello" 2) "llo")
    (assert= (string/substring "hello" 0) "hello")
    (assert= (string/substring "hello" 5) ""))
  (test "two-arg form is equivalent to passing the length"
    (assert= (string/substring "hello" 2) (string/substring "hello" 2 (string/length "hello")))))

(describe "display-width"
  (test "ASCII is one cell per character (like string-length)"
    (assert= (display-width "hello") 5)
    (assert= (display-width "") 0))
  (test "emoji and CJK are two cells wide"
    (assert= (display-width "😀") 2)
    (assert= (display-width "a😀b") 4)
    (assert= (display-width "中文") 4))
  (test "a multi-codepoint emoji cluster is one double-width glyph"
    ;; string-length counts codepoints (>1); display-width counts cells (2).
    (is (> (string/length "👨‍👩‍👧") 1))
    (assert= (display-width "👨‍👩‍👧") 2)))

;; The grapheme-INDEXED accessors (ADR-159). `string->graphemes` already gave the
;; clusters, but only as a whole vector — so the documented-correct cursor step
;; ("step by cluster, never by codepoint") cost a vector of every cluster in the
;; string on every keystroke. These walk to the index. Every case below uses a
;; DECOMPOSED "é" (`e` + U+0301) so codepoint and cluster indices genuinely differ:
;; that is the whole point, and a precomposed U+00E9 would silently prove nothing.
; 4 clusters, 5 codepoints
(def gr-s (str "a" "e\u{301}" "👍" "b"))
(describe "grapheme-count / grapheme-at / substring-graphemes"
  (test "cluster count differs from the codepoint count"
    (assert= (string/grapheme-count gr-s) 4)
    (assert= (string/length gr-s) 5)
    (assert= (string/grapheme-count "") 0)
    (assert= (string/grapheme-count "abc") 3))
  (test "grapheme-at reads the i-th cluster whole"
    (assert= (string/grapheme-at gr-s 0) "a")
    (assert= (string/grapheme-at gr-s 1) "e\u{301}")
    (assert= (string/grapheme-at gr-s 2) "👍")
    (assert= (string/grapheme-at gr-s 3) "b"))
  (test "grapheme-at agrees with string->graphemes at every index"
    (let (v (string/->graphemes gr-s))
      (assert= (map (fn (i) (string/grapheme-at gr-s i)) (range (string/grapheme-count gr-s)))
        (map (fn (i) (nth v i)) (range (count v))))))
  (test "out of range yields the default, never an error (like nth/get)"
    (assert= (string/grapheme-at gr-s 99) nil)
    (assert= (string/grapheme-at gr-s 99 :none) :none)
    (assert= (string/grapheme-at gr-s -1) nil)
    (assert= (string/grapheme-at gr-s -1 :none) :none)
    (assert= (string/grapheme-at "" 0) nil))
  (test "substring-graphemes slices on cluster boundaries"
    (assert= (string/substring-graphemes gr-s 1 3) (str "e\u{301}" "👍"))
    (assert= (string/substring-graphemes gr-s 2) "👍b")
    (assert= (string/substring-graphemes gr-s 0 1) "a"))
  (test "the range is clamped at both ends, like take/drop"
    (assert= (string/substring-graphemes gr-s 0 99) gr-s)
    (assert= (string/substring-graphemes gr-s 3 1) "")
    (assert= (string/substring-graphemes gr-s 99) "")
    (assert= (string/substring-graphemes gr-s -5 2) (str "a" "e\u{301}")))
  (test "slicing round-trips the whole string"
    (assert= (string/substring-graphemes gr-s 0) gr-s)
    (assert= (str (string/substring-graphemes gr-s 0 2) (string/substring-graphemes gr-s 2)) gr-s))
  (test "codepoint substring CAN split a cluster — the reason these exist"
    ;; `(string/substring gr-s 1 2)` takes the bare `e` and orphans the combining mark;
    ;; the grapheme form keeps them together.
    (assert= (string/substring gr-s 1 2) "e")
    (assert= (string/substring-graphemes gr-s 1 2) "e\u{301}")))

(describe "escapes"
  ;; Beyond the named `\e` / `\n` / `\t` / `\r` / `\0` / `\\` / `\"`, Brood
  ;; strings also support `\xHH` (two-hex-digit byte) and `\u{H..H}` (Unicode
  ;; codepoint). `\e` and `\x1b` and `\u{1b}` all produce ESC.
  (test "\\xHH decodes a two-hex-digit byte"
    (assert= "\x1b" "\e")
    (assert= "\x41" "A"))
  (test "\\u{H..H} decodes a Unicode codepoint"
    (assert= "\u{1b}" "\e")
    (assert= "\u{41}" "A")
    ;; 😀 is U+1F600; the literal char round-trips through the string too.
    (assert= "\u{1F600}" "😀"))
  ;; A malformed `\x`/`\u{}` is a hard read error (kernel audit) — the old
  ;; pass-through silently produced wrong output ("\xZZ" became "xZZ").
  ;; Driven through `read-string` so the error is raised at runtime where
  ;; `assert-error` can catch it (a literal in this file would fail the load).
  (test "malformed hex escapes are read errors"
    (assert-error (read-string "\"\\xZZ\""))
    (assert-error (read-string "\"\\u{}\""))
    (assert-error (read-string "\"\\u{nothex}\""))
    (assert-error (read-string "\"\\u{110000}\"")))
  (test "unknown punctuation/digit escapes pass through as literal X"
    ;; `\X` for punctuation or a digit stays literal — how you write a literal
    ;; metacharacter in a regex string (`\.` etc.), and not a footgun.
    (assert= (read-string "\"\\.\"") ".")
    (assert= (read-string "\"\\/\"") "/")
    (assert= (read-string "\"\\1\"") "1"))
  (test "unknown ALPHABETIC escapes are a hard error (regex-class footgun)"
    ;; `"\d+"` used to silently become `"d+"`, breaking regex patterns with no
    ;; error. An unknown letter escape now rejects — the user wants `\\d`.
    (assert-error (read-string "\"\\q\""))
    (assert-error (read-string "\"\\d+\""))
    (assert-error (read-string "\"\\w\""))
    (assert-error (read-string "\"\\s\""))))

(describe "search"
  (test "index-of finds the first occurrence"
    (assert= (index-of "hello world" "o") 4)
    (assert= (index-of "hello world" "world") 6))
  (test "index-of is -1 when absent" (assert= (index-of "hello" "z") -1))
  (test "the empty needle is found at 0" (assert= (index-of "hello" "") 0))
  (test "includes?"
    (is (includes? "hello" "ell"))
    (refute (includes? "hello" "xyz")))
  ;; index-of — index-of with a start offset (the incremental-search primitive)
  (test "index-of defaults to the whole string (from 0)"
    (assert= (index-of "hello world" "o") 4)
    (assert= (index-of "hello" "z") -1))
  ; from == length: no more
  (test "index-of finds the first occurrence at or after `from`"
    ; skips the o at 4
    (assert= (index-of "hello world" "o" 5) 7)
    (assert= (index-of "aaa" "a" 1) 1)
    (assert= (index-of "aaa" "a" 3) -1))
  ; past end: clamped, absent
  (test "index-of clamps `from` and matches the empty needle at `from`"
    ; negative clamps to 0
    (assert= (index-of "hello" "l" -5) 2)
    (assert= (index-of "hello" "" 3) 3)
    (assert= (index-of "hello" "x" 99) -1))
  ;; last-index-of — the backward counterpart (reverse incremental search)
  (test "last-index-of finds the last occurrence before `before`"
    ; default before = length
    (assert= (last-index-of "hello world" "o") 7)
    ; strictly before 7 → the first o
    (assert= (last-index-of "hello world" "o" 7) 4)
    (assert= (last-index-of "abcabc" "bc") 4)
    (assert= (last-index-of "abcabc" "bc" 4) 1))
  (test "last-index-of is -1 when absent or nothing is before `before`"
    (assert= (last-index-of "hello" "z") -1)
    (assert= (last-index-of "hello" "h" 0) -1))

  ;; `index-of`'s `from` and `last-index-of` both moved into the kernel: `from` no longer
  ;; builds `(string/substring coll from n)` first, and `last-index-of` is one native pass instead
  ;; of a Brood loop calling `index-of` per match (which was O(matches × length) — 16.5×
  ;; then 16.4× per 4× of input; it is now flat, 540 ms → 1 ms at 6400 repeats). These pin
  ;; the semantics that move touched, especially the ones a byte-vs-char slip would break.
  (test "index-of `from` offsets are CHAR indices, not bytes"
    (assert= (index-of "héllo héllo" "l") 2)
    (assert= (index-of "héllo héllo" "l" 5) 8)
    (assert= (index-of "a😀b😀c" "b" 0) 2)
    (assert= (index-of "a😀b😀c" "😀" 2) 3))
  (test "last-index-of `before` offsets are CHAR indices, not bytes"
    (assert= (last-index-of "héllo héllo" "l") 9)
    (assert= (last-index-of "héllo héllo" "l" 9) 8)
    (assert= (last-index-of "a😀b😀c" "😀") 3))
  (test "last-index-of keeps a match that starts before `before` but ends after it"
    ;; The bound is on the match's START. "bc" at 4 runs to 6, yet starts before 5.
    (assert= (last-index-of "abcabc" "bc" 5) 4))
  (test "last-index-of clamps `before` at both ends"
    (assert= (last-index-of "abcabc" "b" 99) 4)
    (assert= (last-index-of "abcabc" "b" 0) -1)
    (assert= (last-index-of "abcabc" "b" -7) -1))
  (test "last-index-of on an empty haystack"
    (assert= (last-index-of "" "a") -1)
    (assert= (last-index-of "" "") -1))
  ;; `string-length` reads a char count cached on the heap slot (it used to be a full
  ;; `chars().count()` scan). The cache is written at construction and must survive every
  ;; way a string can move: GC promotion to the old generation, `def` into the shared
  ;; RUNTIME region, and a deep copy across a process boundary. A stale or missing count
  ;; would show as a wrong length or a wrong index — and, because the same field doubles
  ;; as the "is this pure ASCII" test for char↔byte conversion, as wrong SEARCH results on
  ;; non-ASCII text specifically.
  (test "string-length counts code points, not bytes"
    (assert= 5 (string/length "hello"))
    (assert= 5 (string/length "héllo"))
    (assert= 3 (string/length "a😀b"))
    (assert= 0 (string/length ""))
    (assert= 2 (string/length "😀😀")))
  (test "the length is right for a freshly built string, not just a literal"
    (assert= 11 (string/length (str "héllo" " " "wörld")))
    (assert= 4 (string/length (string/substring "héllo wörld" 0 4)))
    (assert= 3 (string/length (apply str (repeat 3 "é"))))
    ;; 1300 chars / 2600 BYTES, and over SHARED_BLOB_THRESHOLD — so this also covers the
    ;; shared-blob construction path, where the count is measured through the blob rather
    ;; than an inline String.
    (assert= 1300 (string/length (apply str (repeat 1300 "é")))))
  (test "the length survives a round-trip through another process"
    ;; A send deep-copies into the receiver's heap, rebuilding the slot — and so its count.
    (let (me (self))
      (spawn (send me [:len (string/length "héllo 😀 wörld")]))
      (assert= 13 (receive ([:len n] n) (after 5000 :timeout)))))

  ;; `substring` takes an ASCII fast path (char index == byte offset → a direct slice)
  ;; because `char-at`, `starts-with?` and `ends-with?` are all Brood over it, so its
  ;; per-call cost is the floor for most string code. It used to copy the whole source
  ;; string per call: `(string/char-at s 3)` on a 216 KB string cost ~11.5 µs and scaled with the
  ;; string, not with the work. A byte offset escaping onto the non-ASCII path would split
  ;; a character, so this checks EVERY range against a char-level reference.
  (test "substring matches a char-level reference over every range"
    (let (ref-sub (fn (s i j) (apply str (take (- j i) (drop i (string/->list s)))))
          chk (fn (s)
                (let (n (string/length s))
                  (every? (fn (i)
                            (every? (fn (j) (= (string/substring s i j) (ref-sub s i j)))
                              (range i (inc n))))
                    (range 0 (inc n))))))
      (is (chk "hello world"))
      (is (chk "héllo wörld"))
      (is (chk "a😀b😀c"))
      (is (chk "aé😀b🎉c"))
      (is (chk "éééééé"))
      (is (chk ""))
      (is (chk "😀"))))
  (test "substring's 2-arg form and bounds are unchanged"
    (assert= "llo" (string/substring "hello" 2))
    (assert= "😀b" (string/substring "a😀b" 1))
    (assert= "" (string/substring "abc" 3 3))
    (is (try (do (string/substring "abc" 0 4) false) (catch e true)))
    (is (try (do (string/substring "abc" -1 2) false) (catch e true))))
  (test "string-span scans runs correctly on non-ASCII text"
    ;; Same fast path, in the tokenizer inner loop: `start` is a CHAR index.
    (assert= 3 (string/span "aaabbb" 0 "a"))
    (assert= 6 (string/span "aaabbb" 3 "b"))
    (assert= 3 (string/span "ééé😀" 0 "é"))
    (assert= 4 (string/span "ééé😀" 3 "😀"))
    (assert= 2 (string/span-until "ab|cd" 0 "|"))
    (assert= 5 (string/span-until "éb|cd" 3 "|")))

  (test "search on non-ASCII text agrees with the char count"
    ;; If the ASCII flag were computed wrongly, these would return byte offsets.
    (let (s "héllo wörld héllo")
      (assert= 17 (string/length s))
      (assert= 12 (index-of s "héllo" 1))
      (assert= 12 (last-index-of s "héllo"))
      (assert= 7 (index-of s "ö"))))

  (test "last-index-of finds the last of many, at scale"
    ;; 4000 occurrences: the old forward-scan-per-match shape was quadratic here.
    (let (s (apply str (repeat 4000 "xyNEEDLE")))
      (assert= (- (* 8 4000) 6) (last-index-of s "NEEDLE"))))
  ; clamped to length, no infinite loop
  (test "last-index-of handles the empty needle without looping"
    ;; the empty needle matches at every position 0..length; the last one before
    ;; `before` is before-1 (clamped). A `before` past the length must not loop.
    (assert= (last-index-of "abc" "") 2)
    (assert= (last-index-of "abc" "" 2) 1)
    (assert= (last-index-of "abc" "" 0) -1)
    (assert= (last-index-of "abc" "" 99) 3))
  ;; index-of also works on lists and vectors (linear scan; structural `=`).
  (test "index-of on a list/vector finds the element index"
    (assert= (index-of (list 10 20 30) 20) 1)
    (assert= (index-of [10 20 30] 30) 2)
    (assert= (index-of (list :a :b :c) :b) 1))
  (test "index-of is -1 for a missing element on lists/vectors"
    (assert= (index-of (list 1 2 3) 99) -1)
    (assert= (index-of [] :anything) -1))
  ;; includes? wraps the common membership test for any collection.
  (test "includes? works on lists, vectors, strings, and maps"
    (is (includes? (list 1 2 3) 2))
    (refute (includes? (list 1 2 3) 9))
    (is (includes? [10 20] 20))
    (is (includes? "hello" "ell"))
    (is (includes? {:a 1 :b 2} 2))
    (refute (includes? {:a 1} 99))))

(describe "join"
  (test "places the separator between elements"
    (assert= (string/join ", " (list "a" "b" "c")) "a, b, c"))
  (test "single element has no separator" (assert= (string/join ", " (list "solo")) "solo"))
  (test "empty collection is the empty string" (assert= (string/join ", " nil) "")))

(describe "split"
  (test "splits on each occurrence" (assert= (string/split "a,b,c" ",") (list "a" "b" "c")))
  (test "keeps empty fields" (assert= (string/split "a,,b" ",") (list "a" "" "b")))
  (test "no separator present yields the whole string"
    (assert= (string/split "abc" ",") (list "abc")))
  (test "multi-char separator" (assert= (string/split "a::b::c" "::") (list "a" "b" "c")))
  (test "empty separator splits into characters"
    (assert= (string/split "abc" "") (list "a" "b" "c")))
  (test "split then join round-trips"
    (assert= (string/join "," (string/split "x,y,z" ",")) "x,y,z")))

(describe "replace"
  (test "replaces every occurrence" (assert= (string/replace "a-b-c" "-" "+") "a+b+c"))
  (test "multi-char old / new"
    (assert= (string/replace "one fish two fish" "fish" "cat") "one cat two cat"))
  (test "absent pattern is unchanged" (assert= (string/replace "hello" "z" "!") "hello"))
  (test "empty old leaves the string unchanged" (assert= (string/replace "hello" "" "!") "hello")))

(describe "whitespace"
  (test "blank?"
    (is (string/blank? ""))
    (is (string/blank? "   "))
    (is (string/blank? "\t\n "))
    (refute (string/blank? " x ")))
  (test "trim removes both ends"
    (assert= (string/trim "  hi there  ") "hi there")
    (assert= (string/trim "\n\thi\n") "hi")
    (assert= (string/trim "no-padding") "no-padding"))
  (test "triml / trimr remove one end"
    (assert= (string/triml "  hi  ") "hi  ")
    (assert= (string/trimr "  hi  ") "  hi"))
  (test "all-whitespace trims to empty" (assert= (string/trim "    ") "")))

(describe "padding & repetition"
  (test "string-repeat concatenates n copies"
    (assert= (string/repeat "=" 5) "=====")
    (assert= (string/repeat "ab" 3) "ababab"))
  (test "string-repeat with n <= 0 is empty"
    (assert= (string/repeat "x" 0) "")
    (assert= (string/repeat "x" -2) ""))
  (test "pad-left right-justifies with spaces"
    (assert= (string/pad-left "42" 6) "    42")
    (assert= (string/pad-left "" 3) "   "))
  (test "pad-right left-justifies with spaces"
    (assert= (string/pad-right "hi" 6) "hi    ")
    (assert= (string/pad-right "" 3) "   "))
  (test "pad-* never truncate an over-wide string"
    (assert= (string/pad-left "toolong" 3) "toolong")
    (assert= (string/pad-right "toolong" 3) "toolong"))
  (test "pad-* are exact-width at the boundary"
    (assert= (string/length (string/pad-left "ab" 2)) 2)
    (assert= (string/length (string/pad-right "ab" 5)) 5)))

(describe "->fixed (fixed-decimal rendering)"
  (test "renders exactly n decimal places"
    (assert= (->fixed 3.14159 2) "3.14")
    (assert= (->fixed 0.015873015873 4) "0.0159"))
  (test "pads short fractions with trailing zeros"
    (assert= (->fixed 1.5 3) "1.500")
    (assert= (->fixed 2 2) "2.00"))
  (test "n = 0 gives an integer-looking string (no point)"
    (assert= (->fixed 3.7 0) "4")
    (assert= (->fixed 3.2 0) "3"))
  (test "rejects a negative decimal count" (assert-error (->fixed 1.0 -1)))
  ;; A huge count would materialise a ~1 GB string (kernel audit #6); bounded.
  (test "rejects an absurd decimal count instead of allocating gigabytes"
    (assert-error (->fixed 1.0 1000000000)))
  ;; "1." + 1000 zeros
  (test "a generous-but-bounded count is still allowed"
    (assert= (count (->fixed 1.0 1000)) 1002))
  (test "lines up in a fixed-width column via pad-left"
    (assert= (string/pad-left (->fixed 1.5 2) 7) "   1.50")))

(describe "format (printf-style)"
  (test "a format string with no specifiers is returned unchanged"
    (assert= (format "") "")
    (assert= (format "hello, world") "hello, world"))
  (test "%% renders a literal %"
    (assert= (format "100%%") "100%")
    (assert= (format "%%done") "%done"))
  (test "%s renders any value via str"
    (assert= (format "got: %s" "x") "got: x")
    (assert= (format "got: %s" 42) "got: 42")
    (assert= (format "got: %s" :foo) "got: :foo")
    (assert= (format "got: %s" nil) "got: nil")
    (assert= (format "got: %s" [1 2 3]) "got: [1 2 3]"))
  (test "%d renders a number"
    (assert= (format "n=%d" 42) "n=42")
    (assert= (format "n=%d" -7) "n=-7"))
  (test "%f renders a float with 6 fractional digits (C default)"
    (assert= (format "pi=%f" 3.141592653589793) "pi=3.141593"))
  (test "%.Nf renders a float with N fractional digits"
    (assert= (format "pi=%.2f" 3.14159) "pi=3.14")
    (assert= (format "%.0f" 3.7) "4")
    (assert= (format "%.4f" 0.015873015873) "0.0159"))
  (test "mixed specifiers consume args left-to-right"
    (assert= (format "x = %d, y = %.2f" 42 3.14159) "x = 42, y = 3.14")
    (assert= (format "%s/%s" "a" "b") "a/b"))
  (test "extra args are ignored; missing args render as nil"
    (assert= (format "one") "one")
    (assert= (format "%s" "a" "b" "c") "a")
    (assert= (format "%s %s" "a") "a nil"))
  (test "rejects an unknown specifier or a truncated one"
    (assert-error (format "what is %q" 1))
    (assert-error (format "ends in %"))
    (assert-error (format "ends in %.2"))
    (assert-error (format "%.xf" 1.0))))

;; ---- across processes -------------------------------------------------------
;; Each worker builds a padded string from data and sends it back (deep copy
;; across per-process heaps); the parent fans in and checks the strings survived
;; the round-trip intact. :isolated so it doesn't contend for the runner's
;; mailbox with the parallel suite.
(defn str-pad-worker (parent i) (send parent [:p i (string/pad-left (str i) 4)]))
(defn str-spawn-padders (parent n)
  (when (> n 0) (spawn (str-pad-worker parent n)) (str-spawn-padders parent (- n 1))))
(defn str-collect (got total acc)
  (if (= got total) acc (str-collect (+ got 1) total (receive ([:p i s] (assoc acc i s))))))

(describe "string formatting across processes"
  :isolated
  (test "padded strings round-trip through 20 workers unchanged"
    (str-spawn-padders (self) 20)
    (let (merged (str-collect 0 20 {}))
      (assert= (count merged) 20)
      (assert= (get merged 1) "   1")
      (assert= (get merged 20) "  20")))
  (test "string-repeat result survives a send"
    (let (me (self))
      (spawn (send me (string/repeat "-" 8)))
      (assert= (receive) "--------"))))

(describe "capitalize"
  (test "basic"
    (assert= (string/capitalize "hello") "Hello"))
  (test "already capitalized"
    (assert= (string/capitalize "Hello World") "Hello world"))
  (test "all caps lowered except first"
    (assert= (string/capitalize "HELLO") "Hello"))
  (test "empty string"
    (assert= (string/capitalize "") ""))
  (test "single char"
    (assert= (string/capitalize "a") "A")))

(describe "string->codepoints / codepoints->string"
  (test "ASCII codepoints"
    (assert= (string/->codepoints "ABC") [65 66 67]))
  (test "empty string"
    (assert= (string/->codepoints "") []))
  (test "roundtrip via codepoints"
    (let (s "Hello, 世界")
      (assert= s (string/codepoints-> (string/->codepoints s)))))
  (test "codepoints->string from a vector"
    (assert= "ABC" (string/codepoints-> [65 66 67])))
  (test "non-ASCII codepoint"
    (assert= (string/->codepoints "é") [233]))
  (test "astral codepoint (one code point, not surrogates)"
    (assert= (string/->codepoints "🙂") [128578]))
  (test "across processes: codes vector survives send/receive"
    (let (me (self))
      (spawn (send me [:codes (string/->codepoints "héλ🙂")]))
      (receive
        ([:codes v] (do
                      (assert= v [104 233 955 128578])
                      (assert= "héλ🙂" (string/codepoints-> v))))))))

(describe "string-span / string-span-until (native char-class scanners)"
  ; at end → end
  (test "string-span: end of the run of set-members from start"
    ; three spaces
    (assert= (string/span "   abc" 0 " \t\n") 3)
    ; first char not in set → start
    (assert= (string/span "abc" 0 " ") 0)
    (assert= (string/span "aaab" 0 "a") 3)
    (assert= (string/span "abc" 3 "x") 3))
  (test "string-span-until: end of the run of NON-members (stops at a set char)"
    ; up to the space
    (assert= (string/span-until "abc def" 0 " ") 3)
    ; no delimiter → whole string
    (assert= (string/span-until "abc" 0 ";") 3)
    (assert= (string/span-until "(foo bar)" 1 " ()") 4))
  ; 'é' is one char
  (test "char-indexed, not byte-indexed (multibyte)"
    (assert= (string/span-until "é x" 0 " ") 1))
  (test "empty set: span is empty, span-until is the whole tail"
    (assert= (string/span "abc" 0 "") 0)
    (assert= (string/span-until "abc" 0 "") 3)))

;; ---- long multi-byte strings: char<->byte conversion ------------------------
;;
;; A char index is a byte offset only for pure-ASCII text, so every char-indexed
;; string builtin has a second complexity regime on multi-byte text. The kernel gives a
;; long non-ASCII string slot a sparse char->byte index (`LocalString` in
;; `core/heap.rs`) so the conversion is a lookup plus a bounded walk instead of a walk
;; from the start. These cases exist because a wrong offset there is a silent
;; wrong-substring, not a crash: each one is cross-checked against the code-point
;; reference, on text long enough (> 256 chars) to be indexed and shaped to straddle the
;; index's 32-char stride.

;; 1-, 2-, 3- and 4-byte chars in every stride position; 500 chars / 1000 bytes.
(def- mb-unit "aé漢🙂x")
(def- mb-text (apply str (repeat 100 mb-unit)))
(def- mb-chars (into [] (string/->list mb-text)))
;; The other shape that matters: an ASCII run whose string is non-ASCII only at the end,
;; so a conversion inside the run cannot take either fast path.
(def- mb-tail (str (apply str (repeat 400 "x")) "é"))

;; Every occurrence of `needle`, by char index — one `index-of` per hit with a rising
;; `from`, which is the shape whose conversion cost the index removes.
(defn- mb-scan
  (s needle i acc)
  (let (j (index-of s needle i))
    (if (< j 0) (reverse acc) (mb-scan s needle (inc j) (cons j acc)))))

(describe "long multi-byte strings (indexed char<->byte conversion)"
  (test "every char index agrees with the code-point reference"
    (assert= (into [] (map (fn (i) (string/char-at mb-text i)) (range 0 (string/length mb-text))))
      mb-chars))
  (test "substring from a rising start is the reference tail"
    (assert= (into [] (map (fn (i) (string/substring mb-text i (+ i 5))) [0 1 31 32 33 100 495]))
      (into [] (map (fn (i) (apply str (subvec mb-chars i (+ i 5)))) [0 1 31 32 33 100 495]))))
  (test "substring to the end, and the whole string"
    (assert= (string/substring mb-text 497) "漢🙂x")
    (assert= (string/substring mb-text 0 (string/length mb-text)) mb-text))
  (test "an incremental scan finds every occurrence at its char index"
    ;; `🙂` is char 3 of each 5-char unit. This is the `inc-scan` sweep row's shape.
    (assert= (into [] (mb-scan mb-text "🙂" 0 nil))
      (into [] (map (fn (k) (+ 3 (* 5 k))) (range 0 100)))))
  (test "reverse search, with and without a bound"
    (assert= (last-index-of mb-text "🙂") 498)
    (assert= (last-index-of mb-text "🙂" 498) 493)
    (assert= (last-index-of mb-text "漢" 3) 2)
    (assert= (last-index-of mb-text "zz") -1))
  (test "char-class scans start from a converted offset"
    (assert= (string/span-until mb-text 100 "🙂") 103)
    (assert= (string/span mb-tail 0 "x") 400)
    (assert= (string/span-until mb-tail 32 "é") 400))
  (test "a non-ASCII string with an ASCII interior converts inside the run"
    (assert= (string/char-at mb-tail 399) "x")
    (assert= (string/char-at mb-tail 400) "é")
    (assert= (index-of mb-tail "é" 100) 400)
    (assert= (string/substring mb-tail 398 401) "xxé"))
  (test "across processes: the receiver's own slot converts the same way"
    ;; The string crosses as a deep copy into a fresh slot, so the receiver builds its
    ;; own index — the send path must not carry a stale one.
    (let (me (self))
      (spawn (send me
               [:idx
                 (index-of mb-text "🙂" 400)
                 :sub
                 (string/substring mb-text 400 405)
                 :last
                 (last-index-of mb-text "漢")]))
      (receive
        ([:idx i :sub s :last l] (do
                                   (assert= i 403)
                                   (assert= s mb-unit)
                                   (assert= l 497)))))))

(describe "string/->bytes + string/bytes->"
  (test "to-bytes returns a bytes value"
    (is (bytes? (string/->bytes "hello"))))
  (test "from-bytes round-trips a string"
    (assert= "hello, brood!" (string/bytes-> (string/->bytes "hello, brood!"))))
  (test "empty string round-trips"
    (assert= "" (string/bytes-> (string/->bytes ""))))
  (test "UTF-8 multi-byte character"
    (assert= "café" (string/bytes-> (string/->bytes "café")))))
