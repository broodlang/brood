(defmodule agent-test (:use test))

(describe "agent/start + get"
  (test "initial state via get identity"
    (let (a (agent/start (fn () 42)))
      (assert= 42 (agent/get a identity))
      (agent/stop a)))
  (test "get applies function to state"
    (let (a (agent/start (fn () 10)))
      (assert= 20 (agent/get a (fn (n) (* n 2))))
      (agent/stop a)))
  (test "get does not change state"
    (let (a (agent/start (fn () 99)))
      (agent/get a (fn (n) (* n 100)))
      (assert= 99 (agent/get a identity))
      (agent/stop a))))

(describe "agent/update"
  (test "update changes state"
    (let (a (agent/start (fn () 0)))
      (agent/update a inc)
      (assert= 1 (agent/get a identity))
      (agent/stop a)))
  (test "multiple updates accumulate"
    (let (a (agent/start (fn () 0)))
      (agent/update a inc)
      (agent/update a inc)
      (agent/update a (fn (n) (* n 10)))
      (assert= 20 (agent/get a identity))
      (agent/stop a)))
  (test "update returns :ok"
    (let (a (agent/start (fn () nil)))
      (assert= :ok (agent/update a identity))
      (agent/stop a))))

(describe "agent/get-and-update"
  (test "returns old value and updates state"
    (let (a (agent/start (fn () 5))
          result (agent/get-and-update a (fn (n) [n (* n 2)])))
      (assert= 5 result)
      (assert= 10 (agent/get a identity))
      (agent/stop a))))

(describe "agent/cast"
  (test "cast applies update asynchronously"
    (let (a (agent/start (fn () 0)))
      (agent/cast a inc)
      ;; synchronise via get (which is synchronous — ensures cast has processed)
      (assert= 1 (agent/get a identity))
      (agent/stop a))))

(describe "agent/stop"
  (test "stop returns :ok"
    (let (a (agent/start (fn () nil)))
      (assert= :ok (agent/stop a)))))

(describe "agent/start-link"
  (test "start-link returns a pid"
    (let (a (agent/start-link (fn () 0)))
      (is (pid? a))
      (agent/stop a)))
  (test "start-link agent behaves like start"
    (let (a (agent/start-link (fn () 10)))
      (assert= 20 (agent/get a (fn (n) (* n 2))))
      (agent/stop a))))

(describe "agent with map state"
  (test "counter map"
    (let (a (agent/start (fn () {}))
          _ (agent/update a (fn (m) (assoc m :x 1)))
          _ (agent/update a (fn (m) (assoc m :y 2))))
      (assert= {:x 1 :y 2} (agent/get a identity))
      (agent/stop a))))

(describe "agent: an unmatched message is dropped, not left in the mailbox"
  ;; `agent-loop` had no catch-all, so a stray send matched no clause and sat in the
  ;; agent's mailbox forever — growing it and being re-scanned by every later
  ;; selective receive. `gen` has always dropped one (OTP's default handle_info).
  (test "strays are consumed, and the agent keeps working"
    (let (a (agent/start (fn () 0)))
      (dotimes (i 20) (send a :stray))
      (send a [:not-an-envelope 1 2])
      ;; forces the loop to walk past everything queued before this call
      (agent/update a inc)
      (assert= 1 (agent/get a identity))
      (sleep 30)
      (assert= 0 (proc/mailbox-size a))
      (agent/stop a))))

(describe "agent: a dead agent raises instead of hanging forever"
  ;; Every op was a bare `(receive ([:reply ^r v] v))` — no monitor, no deadline — so
  ;; a stopped or crashed agent parked the caller with nothing left to wake it.
  ;; They now ride `gen`'s `call`, which monitors the server.
  (test "get / update / get-and-update / stop raise on a stopped agent"
    (let (a (agent/start (fn () 1)))
      (agent/stop a)
      (sleep 60)
      ;; check-allow :discarded-catch — a did-it-throw assertion: the caught error is the answer
      (assert= :raised
        (try (do (agent/get a identity) :no-error) (catch e :raised)))
      (assert= :raised
        (try (do (agent/update a inc) :no-error) (catch e :raised)))
      (assert= :raised
        (try (do (agent/get-and-update a (fn (n) [n n])) :no-error) (catch e :raised)))
      (assert= :raised
        (try (do (agent/stop a) :no-error) (catch e :raised)))))
  (test "a crashed agent raises too"
    (let (a (agent/start (fn () 0)))
      ;; a cast fn that throws has no caller to report to, so it kills the agent
      (agent/cast a (fn (n) (error "agent boom")))
      (sleep 60)
      (assert= :raised
        (try (do (agent/get a identity) :no-error) (catch e :raised))))))

(describe "agent: a raising f is the caller's error, and the agent keeps its state"
  ;; `update` replied :ok BEFORE applying f, so a throwing f reported success and then
  ;; killed the agent. Now f runs first; its error comes back to the caller and the
  ;; agent keeps the state it had.
  (test "update re-raises f's error and keeps the old state"
    (let (a (agent/start (fn () 7)))
      (assert= "agent boom"
        (try
          (do (agent/update a (fn (n) (error "agent boom"))) :no-error)
          (catch e (error-message e))))
      (assert= 7 (agent/get a identity))
      (assert= :ok (agent/update a inc))
      (assert= 8 (agent/get a identity))
      (agent/stop a)))
  (test "get re-raises f's error and the agent stays alive"
    (let (a (agent/start (fn () 3)))
      (assert= "get boom"
        (try
          (do (agent/get a (fn (n) (error "get boom"))) :no-error)
          (catch e (error-message e))))
      (assert= 3 (agent/get a identity))
      (agent/stop a)))
  (test "get-and-update re-raises f's error, or a malformed result, keeping the state"
    (let (a (agent/start (fn () 5)))
      (assert= :raised
        (try
          (do (agent/get-and-update a (fn (n) (error "gau boom"))) :no-error)
          (catch e :raised)))
      (assert= :raised
        (try (do (agent/get-and-update a (fn (n) n)) :no-error) (catch e :raised)))
      (assert= 5 (agent/get a identity))
      (agent/stop a)))
  (test "concurrent callers: the failing ones raise, the others' updates all land"
    (let (a (agent/start (fn () 0))
          me (self))
      (dotimes (i 20)
        (spawn (send me
                 [:done
                   (try
                     (do
                       (agent/update a
                         (fn (n) (if (math/even? i) (inc n) (error "odd " i))))
                       :ok)
                     (catch e :raised))])))
      (let (outcomes (map (range 20)
                       (fn (_) (receive ([:done outcome] outcome) (after 5000 :timeout)))))
        (assert= 10 (count (seq/filter outcomes (fn (o) (= o :ok)))))
        (assert= 10 (count (seq/filter outcomes (fn (o) (= o :raised))))))
      (assert= 10 (agent/get a identity))
      (agent/stop a))))
