;; std/tool/reload.blsp's `on-reload` callback (added alongside ADR-123's
;; live-session trigger for `nest run --watch`, docs/type-soundness-reload.md):
;; a 1-ary fn invoked after each successful reload/load, with its own errors
;; caught so a broken callback (e.g. a checker hiccup) can never take the
;; watcher down. `nest run --watch` wires `project-check/check-sources` in
;; as this callback inside a project; these tests exercise the callback
;; contract directly, independent of `nest`/the checker.
(defmodule reload-watch-test (:use-internals reload) (:use test) (:use reload))

;; Drop any fixtures a prior run left in /tmp (at load, before any test runs). Missing
;; until 2026-08-05 (KI-30): this file's 926 leftover directories were the second-largest
;; pile in /tmp.
(purge-stale-temp "brood-reload-")

;; Poll `reload-watch-test-wait` (bounded) instead of a selective `receive`:
;; a test-framework worker process may already carry other pending mailbox
;; traffic, and this keeps the assertion independent of message ordering.
(defn- reload-watch-test-wait (pred budget-ms)
  (cond
    (pred) true
    (<= budget-ms 0) false
    else (do (proc/sleep 100) (reload-watch-test-wait pred (- budget-ms 100)))))

(describe "on-change: on-reload callback"
  (test "fires after a successful reload, with the reloaded path"
    ;; The watcher (and this test's own callback) announce the reload on stdout;
    ;; captured so the suite's output stays clean. See the next test for why this
    ;; is safe.
    (with-out-str
      (let (dir (temp-dir "brood-reload-"))
        (file/mkdir dir)
        (let (f (path/join dir "w.blsp"))
          (file/spit f "(def rwt-val 1)\n")
          (reflect/load f)
          (on-change f (fn (p) (io/puts "[reload-watch-test] on-reload fired" p)))
          ;; `file-mtime` is millisecond-resolution; without a gap here the two
          ;; `spit`s can land in the same millisecond and the watcher correctly
          ;; sees no change at all (not a watcher bug — a race in the test).
          (proc/sleep 100)
          (file/spit f "(def rwt-val 2)\n")
          (is (reload-watch-test-wait (fn () (= (reflect/eval 'rwt-val) 2)) 3000))
          (assert= (reflect/eval 'rwt-val) 2)))))

  (test "on-reload's own errors are caught, never propagated to the watcher"
    ;; The watcher announces each reload on stdout, and this test deliberately
    ;; makes the callback throw — so the `[reload] on-reload failed … boom` lines
    ;; are the expected result, not a problem. `with-out-str` keeps them out of the
    ;; suite's output (it captures spawned processes too, which is where the
    ;; watcher prints from). Assertions THROW rather than print, so wrapping the
    ;; body cannot hide a failure.
    (with-out-str
      (let (dir (temp-dir "brood-reload-"))
        (file/mkdir dir)
        (let (f (path/join dir "w2.blsp"))
          (file/spit f "(def rwt-val2 1)\n")
          (reflect/load f)
          ;; Dated 2020, so the edit below is newer than the baseline whatever the clock's
          ;; resolution — and edited at once, with no pause: `on-change` reads the baseline
          ;; before it returns. It used to read it in the watcher process, whenever that got a
          ;; worker; under ASan that was after this edit, so the edit WAS the baseline and was
          ;; never reloaded.
          (file/set-mtime f 1577836800000)
          ;; A callback that always throws — the def must still take effect
          ;; (on-reload runs *after* system/reload-defs already succeeded) and the
          ;; watcher must survive to reload again on a later edit.
          (on-change f (fn (_p) (throw "boom")))
          (file/spit f "(def rwt-val2 2)\n")
          (is (reload-watch-test-wait (fn () (= (reflect/eval 'rwt-val2) 2)) 3000))
          (assert= (reflect/eval 'rwt-val2) 2)
          (proc/sleep 100)
          (file/spit f "(def rwt-val2 3)\n")
          (is (reload-watch-test-wait (fn () (= (reflect/eval 'rwt-val2) 3)) 3000))
          (assert= (reflect/eval 'rwt-val2) 3))))))

(describe "on-change: the directory walk"
  (test "a symlinked directory is not entered, so a cycle watches each file once"
    (let (d (temp-dir "brood-reload-")
          sub (path/join d "sub"))
      (file/mkdir d)
      (file/mkdir sub)
      (file/spit (path/join sub "deep.blsp") "")
      (%os-cmd "/bin/ln" ["-s" d (path/join sub "up")])
      (assert= (reload/reload-collect-blsp d) (list (path/join sub "deep.blsp"))))))
