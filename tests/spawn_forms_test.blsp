;; Every `spawn` body shape must actually RUN its body — no shape may silently do
;; nothing. Regression for the bare-function-name footgun: `(spawn worker)` used to
;; expand to `(%spawn (fn () worker))`, whose body merely *evaluates* the symbol to
;; the closure and exits — so the worker never ran. It now wraps a bare symbol as a
;; CALL, `(fn () (worker))` (Erlang's `spawn(fun name/0)`), so it runs like every
;; other shape.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule spawn-forms-test (:use test))

;; A top-level 0-arg worker: the one shape that can't capture its parent lexically
;; (a bare global name carries no closure), so it resolves the parent by registered
;; name. Reports that it actually ran.
(defn- spawn-forms-report-bare
  ()
  (send (proc/whereis :spawn-forms-bare-parent) :ran-bare))

(describe "spawn: every body shape runs its body (no silent no-op)"
  (test "(spawn fn-name) — a bare function name is CALLED, not yielded-and-discarded"
    (proc/register :spawn-forms-bare-parent (self))
    (spawn spawn-forms-report-bare)
    (assert= (receive (m m) (after *test-wait-ms* :NEVER-RAN)) :ran-bare))

  (test "(spawn (expr)) — a call expression runs"
    (let (me (self))
      (spawn (send me :ran-call)))
    (assert= (receive (m m) (after *test-wait-ms* :NEVER-RAN)) :ran-call))

  (test "(spawn (fn () body)) — an explicit zero-arg thunk runs"
    (let (me (self))
      (spawn (fn () (send me :ran-thunk))))
    (assert= (receive (m m) (after *test-wait-ms* :NEVER-RAN)) :ran-thunk))

  (test "(spawn name fn-name) — the named form also calls a bare function name"
    (proc/register :spawn-forms-named-parent (self))
    (spawn :spawn-forms-worker spawn-forms-report-named)
    (assert= (receive (m m) (after *test-wait-ms* :NEVER-RAN)) :ran-named)))

;; Worker for the named-form test (defined after its first textual use is fine — a
;; global resolves at call time).
(defn- spawn-forms-report-named
  ()
  (send (proc/whereis :spawn-forms-named-parent) :ran-named))
