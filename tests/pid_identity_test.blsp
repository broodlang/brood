;; Pid identity across `node-start` — the captured-before-vs-self-after footgun.
;; A pid captured pre-node-start is stamped `nonode`; the same process's `(self)`
;; afterwards carries the node name. Routing always treated both as "this runtime"
;; (`dist::is_local`); value equality and hashing now do too — otherwise every
;; pre-node-start captured pid (a subscriber record, a registry entry, a pid-keyed
;; marker) silently stops matching the moment the node comes up. This bit myedit's
;; collab presence for real: the shared buffer process was spawned before the
;; daemon's node-start, so `[:buffer-updated pid …]` pushes matched no slot.
(defmodule pid-identity-test (:use test))

(describe "pid identity across node-start"
  :isolated
  (test "a pid captured before node-start equals (self) after — and still works as a map key"
    (let (before (self)
          keyed {before :cursor}
          ;; `node-start` is ONE-SHOT per runtime — a second listener would need a second
          ;; port, so calling it twice is an error by design — and `:isolated` rolls back
          ;; `def`s, not runtime node state. Nothing at the test level can undo it, so a
          ;; second run of this test in the SAME image must not call it again (KI-25: this
          ;; is why the test failed under `--repeat-until-failure`, and it was NOT a JIT
          ;; cache surviving isolation). Every ordinary `nest test` is a fresh image, so
          ;; the first run exercises the real nonode→node stamp change; a re-run in the
          ;; same image still checks that equality, hashing and receive-pattern matching
          ;; on pids all agree with each other.
          _ (if (= (node-name) :nonode)
              (node-start (keyword (str "pid-eq-" (now))) "127.0.0.1:0" (node-cookie))
              nil))
      (let (after (self))
        ;; same process, either stamp: equal both ways round
        (is (= before after))
        (is (= after before))
        ;; and hash-compatible: the pre-start key resolves under the post-start pid …
        (assert= (get keyed after) :cursor)
        ;; … and vice versa (a map built after finds the pre-start value)
        (assert= (get {after :here} before) :here)
        ;; a selective receive pinned on the OLD stamp still matches a message
        ;; carrying the NEW one (receive patterns compare with =)
        (send (self) [:from after])
        (assert= (receive ([:from ^before] :matched) (after *test-wait-ms* :no-match)) :matched)))))
