;; std/proc/crash-report.blsp — the default crash reporter (ADR-305): one system-monitor
;; subscriber that prints each abnormal exit once per crash site. :isolated because the
;; reporter registers a global name and holds a runtime-global subscription; every test
;; uses a `:sink` so nothing reaches stderr and the report text can be asserted on.

(defmodule crash-report-test (:use test) (:use crash-report))

(defn- crash-report-collect (me)
  "A sink that forwards each report to the test process."
  (fn (text) (send me [:report text])))

(defn- crash-report-drain ()
  "Drop any report left in this mailbox by an earlier test (an isolated unit's tests
share one worker process)."
  (receive ([:report _] (crash-report-drain)) (after 0 nil)))

;; KI-121. The reporter subscribes to `proc/system-monitor`, which is RUNTIME-global: a
;; sink armed here receives the abnormal exit of ANY process in the runtime, and a full
;; `-j8` suite crashes processes constantly. `:isolated` serialises the units, not the
;; runtime — a straggler or a parallel non-isolated unit elsewhere can still be dying. So
;; "the next report" was never this test's report, and one run of the suite proved it by
;; reading a neighbour's crash text. Every assertion below therefore names WHICH crash it
;; means, and reports that do not match are dropped rather than asserted on.
;;
;; The wait is a DEADLINE, not a per-message window: a fresh `after` on each skipped
;; neighbour would let steady crash traffic extend the wait without bound.

(defn- crash-report-next-where (match? deadline)
  "The next report satisfying `match?`, or :none once `deadline` (an `os/now` stamp)
passes. A report that does not match belongs to another test — drop it and keep waiting."
  (let (remaining (- deadline (os/now)))
    (if (<= remaining 0)
      :none (receive
        ([:report text] (if (match? text) text (crash-report-next-where match? deadline)))
        (after remaining :none)))))

(defn- crash-report-next-of (pids)
  "The next report naming one of `pids`."
  (crash-report-next-where (fn (text) (any? pids (fn (pid) (includes? text (pr-str pid)))))
    (+ (os/now) *test-wait-ms*)))

(defn- crash-report-next-saying (fragment)
  "The next report containing `fragment` — for a crash whose pid the test never sees
(a `spawn-link`ed grandchild)."
  (crash-report-next-where (fn (text) (includes? text fragment))
    (+ (os/now) *test-wait-ms*)))

(defn- crash-report-quiet-where? (match? deadline)
  "True if no report satisfying `match?` arrives before `deadline`."
  (let (remaining (- deadline (os/now)))
    (if (<= remaining 0)
      true
      (receive
        ([:report text] (if (match? text) false (crash-report-quiet-where? match? deadline)))
        (after remaining true)))))

(defn- crash-report-quiet-of? (pids)
  "True if none of `pids` is reported within 100 ms."
  (crash-report-quiet-where? (fn (text) (any? pids (fn (pid) (includes? text (pr-str pid)))))
    (+ (os/now) 100)))

(defn- crash-report-boom (x)
  "A named frame for the trace assertions."
  (error "boom: " x))

(describe "crash-report rendering"
  (test "an error map renders headline, kind/code/position, hint and frames"
    (let (reason [:error
                   {:kind :arith-error
                    :message "division by zero"
                    :code "E0031"
                    :file "src/w.blsp"
                    :line 14
                    :col 9
                    :hint "check the divisor"
                    :trace (list {:fn "w/step" :file "src/w.blsp" :line 14 :col 9}
                             {:fn "w/loop" :file "src/w.blsp" :line 9 :col 5})}]
          text (render (self) reason))
      (is (string/starts-with? text (str "[crash] " (pr-str (self)) " exited: division by zero")))
      (is (includes? text "kind :arith-error  code E0031  at src/w.blsp:14:9"))
      (is (includes? text "hint: check the divisor"))
      (is (includes? text "at w/step (src/w.blsp:14:9)"))
      (is (includes? text "at w/loop (src/w.blsp:9:5)"))
      (is (string/ends-with? text "(further crashes at this site are not reported)"))))

  (test "a thrown non-map value and a bare exit reason render their printed form"
    (is (includes? (render (self) [:error [:bad-state 3]]) "exited: [:bad-state 3]"))
    (is (includes? (render (self) :boom) "exited: :boom")))

  (test "the trace is capped at eight frames"
    (let (frames (map (range 1 21) (fn (i) {:fn (str "f" i) :file "x.blsp" :line i}))
          text (render (self) [:error {:kind :x :message "m" :trace frames}]))
      (is (includes? text "at f8 (x.blsp:8)"))
      (is (not (includes? text "at f9 "))))))

(describe "crash-report listener"
  :isolated (test "a spawned process that raises is reported, with its trace; a clean exit is not"
    (let (me (self))
      (crash-report-drain)
      (start {:sink (crash-report-collect me)})
      (is (running?))
      (let (clean (spawn :done))
        ;; non-tail so the `error` frame carries this file's position (a tail call
        ;; collapses into its caller's frame and records none)
        (let (crasher (spawn (+ 1 (crash-report-boom 1)))
              text (crash-report-next-of [crasher]))
          (is (string? text))
          (is (includes? text (pr-str crasher)))
          (is (includes? text "boom: 1"))
          (is (includes? text "kind :user"))
          ;; Match the FILE NAME and a position, not a path prefix: `nest test` loads a
          ;; discovered file by ABSOLUTE path and an explicitly-named one relatively, so
          ;; pinning "tests/…" passed alone and failed under discovery — a property of how
          ;; the runner was invoked, never of the trace.
          (is (includes? text "at error ("))
          (is (includes? text "crash_report_test.blsp:"))
          ;; neither a second report for this site nor anything for the clean exit
          (is (crash-report-quiet-of? [crasher clean]))))
      (stop)))

  :isolated (test "start is idempotent; stop disarms and drops the subscription"
    (let (me (self)
          _ (crash-report-drain)
          first-pid (start {:sink (crash-report-collect me)}))
      (assert= first-pid (start {:sink (crash-report-collect me)}))
      (stop)
      (sleep 50)
      (is (not (running?)))
      (assert= [] (proc/system-monitor :all))
      (let (after-stop (spawn (error "unreported")))
        (is (crash-report-quiet-of? [after-stop])))))

  :isolated (test "one report per site: a crash loop at one site prints once, a second site prints again"
    (let (me (self))
      (crash-report-drain)
      (start {:sink (crash-report-collect me)})
      ;; one raise site (a loop re-running the same spawn), a different message each
      ;; time: one report. (`crash-report-boom` tail-calls `error`, so the recorded
      ;; site is the call that entered it — this `dotimes` body.)
      ;; Which iteration's crash is reported first is scheduling order; the site is not.
      (let (boomers (map (range 0 3) (fn (i) (spawn (+ 1 (crash-report-boom i))))))
        (is (includes? (crash-report-next-of boomers) "exited: boom: "))
        (is (crash-report-quiet-of? boomers))
        ;; a different raise site is a different report
        (let (elsewhere (spawn (error "elsewhere")))
          (is (includes? (crash-report-next-of [elsewhere]) "elsewhere"))))
      (stop)))

  ;; KI-121, pinned deterministically rather than left to load. The sighting was a
  ;; neighbouring test's crash text arriving first; simulating that is just a `[:report …]`
  ;; queued ahead of this test's own, which is exactly what the runtime-global subscription
  ;; delivers. With the unscoped helper this test reads the neighbour's report and fails.
  :isolated (test "a neighbouring test's report is skipped, not asserted on (KI-121)"
    (let (me (self))
      (crash-report-drain)
      (send me [:report "[crash] <pid 90001> exited: a neighbouring test's crash"])
      (start {:sink (crash-report-collect me)})
      (let (mine (spawn (+ 1 (crash-report-boom :mine))))
        (is (includes? (crash-report-next-of [mine]) "boom: :mine"))
        ;; and a foreign report must not break a quiet assertion either
        (send me [:report "[crash] <pid 90002> exited: another neighbour"])
        (is (crash-report-quiet-of? [mine])))
      (stop)))

  :isolated (test "deliberate exits — :normal, :killed, :shutdown — are never reported"
    (let (me (self))
      (crash-report-drain)
      (start {:sink (crash-report-collect me)})
      (let (victim (spawn (receive (:never nil)))
            polite (spawn (receive (:never nil))))
        (exit victim :kill)
        (exit polite :shutdown)
        (is (crash-report-quiet-of? [victim polite])))
      (stop)))

  :isolated (test "the starting process is never reported, and a linked crash still is"
    (let (me (self))
      (crash-report-drain)
      (start {:sink (crash-report-collect me)})
      ;; a supervised-style crash: the child is linked to a trapping parent; the
      ;; parent handles it, and the reporter STILL reports it (OTP logs handled crashes)
      (spawn (do
               (proc/trap-exit true)
               (spawn-link (crash-report-boom :linked))
               (receive ([:EXIT _ _] :handled))))
      (is (includes? (crash-report-next-saying "boom: :linked") "boom: :linked"))
      (stop)))

  :isolated (test "the reporter coexists with a telemetry watch-runtime subscription"
    (let (me (self))
      (crash-report-drain)
      (start {:sink (crash-report-collect me)})
      (telemetry/start)
      (let (watcher (telemetry/watch-runtime {:spawn true}))
        (assert= 2 (count (proc/system-monitor :all)))
        (spawn (crash-report-boom :under-watch))
        (is (includes? (crash-report-next-saying "under-watch") "under-watch"))
        (telemetry/stop-watch-runtime watcher)
        (sleep 50)
        ;; the watcher leaving does not take the reporter with it
        (is (running?))
        (assert= 1 (count (proc/system-monitor :all))))
      (telemetry/stop)
      (stop)))

  :isolated (test "%crash-report-arm-default honours BROOD_NO_CRASH_REPORT only when set; otherwise arms once"
    (if (os/env "BROOD_NO_CRASH_REPORT")
      (assert= nil (%crash-report-arm-default))
      (let (pid (%crash-report-arm-default))
        (is (not (nil? pid)))
        (assert= pid (%crash-report-arm-default))
        (stop))))

  ;; The lazy arm registers the shim under the name `stop`/`running?` look up, and the
  ;; literal `:crash-reporter` is written in BOTH the prelude and `crash-report-name`
  ;; here. If those ever disagree the shim is armed but unreachable: `running?` answers
  ;; false while a listener is subscribed, and `stop` returns having stopped nothing.
  :isolated (test "the lazily-armed shim is found by running? and stop"
    (stop)
    (is (not (running?)))
    (let (pid (%crash-report-arm-default))
      (is (not (nil? pid)))
      (is (running?))
      (assert= 1 (count (proc/system-monitor :all)))
      (stop)
      (is (not (running?)))
      (assert= 0 (count (proc/system-monitor :all))))))

;; The laziness itself cannot be tested from THIS file: its own `(:use crash-report)`
;; header loads the module before any test runs, so `*features*` already contains it.
;; The guard lives in `crates/lisp/tests/crash_report_lazy.rs`, which runs a real
;; `brood file` — the entry point a user actually reaches — and reads the module list
;; out of `BROOD_IMAGE_TRACE`.
