;; Records — `defrecord` (ADR-130): named, optionally-typed maps. A record is a
;; plain immutable map with a positional constructor and one accessor per field;
;; there is no new Value/tag and no `rec?` predicate (records are structural).
(defmodule record-test (:use test))

(defrecord point (x y))
(defrecord vec3 ((x int) (y int) (z int)))   ; typed fields

(describe "defrecord: construction and access"
  (test "the constructor builds a map keyed by field"
    (assert= (point 3 4) {:x 3 :y 4}))
  (test "accessors read each field"
    (let (p (point 3 4))
      (assert= (point-x p) 3)
      (assert= (point-y p) 4)))
  (test "a record IS a plain map"
    (is (map? (point 1 2)))
    (assert= (get (point 1 2) :x) 1)
    (assert= (keys (point 1 2)) (list :x :y))))

(describe "defrecord: records are immutable maps"
  (test "functional update via assoc returns a fresh record"
    (let (p (point 3 4) q (assoc p :x 9))
      (assert= q {:x 9 :y 4})
      (assert= p {:x 3 :y 4})))                ; original unchanged
  (test "merge works too"
    (assert= (merge (point 1 2) {:y 20}) {:x 1 :y 20}))
  (test "equality is structural"
    (is (= (point 1 2) (point 1 2)))
    (is (= (point 1 2) {:x 1 :y 2}))           ; a record is just its map
    (refute (= (point 1 2) (point 1 3)))))

(describe "defrecord: typed fields"
  (test "typed constructor and accessors work at runtime"
    (let (v (vec3 1 2 3))
      (assert= v {:x 1 :y 2 :z 3})
      (assert= (vec3-z v) 3)))
  (test "a field defaults to nil when built from a partial map (records are maps)"
    (assert= (point-y {:x 1}) nil)))

;; Records cross process boundaries as the maps they are — build in a worker,
;; send home, read with the accessors (proves the map round-trips per-heap).
(describe "defrecord: across processes"
  :isolated
  (test "a record built in a spawned process survives the send"
    (let (me (self))
      (spawn (fn () (send me (point 11 22))))
      (receive
        (p (do (assert= (point-x p) 11)
               (assert= (point-y p) 22)
               (assert= p {:x 11 :y 22})))))))
