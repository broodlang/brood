;; Records — `defrecord` (ADR-130): named, optionally-typed maps that ALSO carry a
;; nominal identity (a reserved `:__id__` `:module/name` keyword), so `ability` dispatch
;; tells them apart from a bare map and from other records (Elixir-struct semantics — a
;; record is NOT `=` to a bare map with the same fields). `record?`/`record-id`/`fields`
;; are the clean, id-free view. A record is still a plain immutable map underneath:
;; `get`/`assoc`/`merge` work, plus one accessor per field.
(defmodule record-test (:use test))

(defrecord point (x y))
; typed fields
(defrecord vec3 ((x int) (y int) (z int)))

(describe "defrecord: construction and access"
  (test "the constructor builds a record keyed by field, with a nominal id"
    (assert= (fields (point 3 4)) {:x 3 :y 4})
    (assert= (record-id (point 3 4)) :record-test/point))
  (test "accessors read each field"
    (let (p (point 3 4))
      (assert= (point-x p) 3)
      (assert= (point-y p) 4)))
  (test "a record IS a plain map underneath (plus the reserved :__id__)"
    (is (map? (point 1 2)))
    (assert= (get (point 1 2) :x) 1)
    (assert= (get (point 1 2) :__id__) :record-test/point)
    ;; the field keys plus :__id__ — membership, not order: map key order is hash-order
    ;; under CHAMP (ADR-040). `fields` is the id-free view.
    (let (ks (keys (point 1 2)))
      (assert= (count ks) 3)
      (is (includes? ks :x))
      (is (includes? ks :y))
      (is (includes? ks :__id__)))
    (assert= (keys (fields (point 1 2))) (keys {:x 1 :y 2}))))

(describe "defrecord: records are immutable maps"
  ; original unchanged
  (test "functional update via assoc returns a fresh record"
    (let (p (point 3 4) q (assoc p :x 9))
      (assert= (fields q) {:x 9 :y 4})
      (assert= (fields p) {:x 3 :y 4})
      ; the id rides along through assoc
      (assert= (record-id q) :record-test/point)))
  (test "merge works too"
    (assert= (fields (merge (point 1 2) {:y 20})) {:x 1 :y 20})))

(describe "defrecord: identity and nominal equality"
  (test "record? / record-id / fields are the clean API"
    (is (record? (point 1 2)))
    (refute (record? {:x 1 :y 2}))
    (assert= (record-id (point 1 2)) :record-test/point)
    (assert= (record-id {:x 1 :y 2}) nil)
    (assert= (fields (point 1 2)) {:x 1 :y 2}))
  (test "two records with the same fields ARE equal"
    (is (= (point 1 2) (point 1 2)))
    (refute (= (point 1 2) (point 1 3))))
  (test "a record is NOT = to a bare map with the same fields (nominal, not structural)"
    (refute (= (point 1 2) {:x 1 :y 2})))
  (test "records of different shapes are never equal"
    (refute (= (point 1 2) (vec3 1 2 0)))))

(describe "defrecord: typed fields"
  (test "typed constructor and accessors work at runtime"
    (let (v (vec3 1 2 3))
      (assert= (fields v) {:x 1 :y 2 :z 3})
      (assert= (vec3-z v) 3)))
  (test "an accessor on a bare map without that field returns nil (records are maps)"
    (assert= (point-y {:x 1}) nil)))

;; Records cross process boundaries as the maps they are — build in a worker, send home,
;; read with the accessors and the id (proves the record round-trips per-heap).
(describe "defrecord: across processes"
  :isolated
  (test "a record built in a spawned process survives the send, id and all"
    (let (me (self))
      (spawn (fn () (send me (point 11 22))))
      (receive
        (p (do
             (assert= (point-x p) 11)
             (assert= (point-y p) 22)
             (is (record? p))
             (assert= (record-id p) :record-test/point)))))))
