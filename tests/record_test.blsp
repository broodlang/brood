;; Records — `defrecord` (ADR-130): named, optionally-typed maps that ALSO carry a
;; nominal identity (a reserved `:__id__` `:module/name` keyword), so `ability` dispatch
;; tells them apart from a bare map and from other records (Elixir-struct semantics — a
;; record is NOT `=` to a bare map with the same fields). `record?`/`record-id`/`fields`
;; are the clean, id-free view. A record is still a plain immutable map underneath:
;; `get`/`assoc`/`merge` work, plus one accessor per field.
(defmodule record-test (:use test) (:use math))

(defrecord point (x y))
; typed fields
(defrecord vec3 ((x int) (y int) (z int)))

(describe "defrecord: construction and access"
  (test "the constructor builds a record keyed by field, with a nominal id"
    (assert= (fields (point 3 4)) {:x 3 :y 4})
    (assert= (record-id (point 3 4)) :record-test/point))
  (test "accessors read each field"
    (let (p (point 3 4))
      (assert= (point-x p) 3)
      (assert= (point-y p) 4)))
  (test "a record IS a plain map underneath; :__id__ is directly accessible"
    (is (map? (point 1 2)))
    (assert= (get (point 1 2) :x) 1)
    ;; the identity is still reachable by direct key access (get), even though the
    ;; collection view hides it (next test) — `get`/`assoc` treat the record as a map.
    (assert= (get (point 1 2) :__id__) :record-test/point))
  (test "the collection view (Seqable) is the fields — :__id__ never leaks"
    ;; count/keys/vals/seq/map/fold go through the record's `Seqable` view (its fields,
    ;; id-free) — so `:__id__` doesn't leak into iteration (it did before ADR-172 §7's
    ;; collection protocol). `(count r)` is the field count, not the raw map size.
    (assert= (count (point 1 2)) 2)
    (let (ks (keys (point 1 2)))
      (assert= (count ks) 2)
      (is (includes? ks :x))
      (is (includes? ks :y))
      (refute (includes? ks :__id__)))
    ;; compare as MAPS/sets, never a fixed list order — map key order is hash-derived
    ;; (CHAMP), so it differs between builds; `(seq r)` reconstructs to the field map.
    (assert= (into {} (seq (point 1 2))) {:x 1 :y 2})
    (assert= (into #{} (keys (point 1 2))) #{:x :y})))

(describe "defrecord: records are immutable maps"
  ; original unchanged
  (test "functional update via assoc returns a fresh record"
    (let (p (point 3 4) q (assoc p :x 9))
      (assert= (fields q) {:x 9 :y 4})
      (assert= (fields p) {:x 3 :y 4})
      ; the id rides along through assoc
      (assert= (record-id q) :record-test/point)))
  (test "merge works too"
    (assert= (fields (merge (point 1 2) {:y 20})) {:x 1 :y 20})))

(describe "defrecord: identity and nominal equality"
  (test "record? / record-id / fields are the clean API"
    (is (record? (point 1 2)))
    (refute (record? {:x 1 :y 2}))
    (assert= (record-id (point 1 2)) :record-test/point)
    (assert= (record-id {:x 1 :y 2}) nil)
    (assert= (fields (point 1 2)) {:x 1 :y 2}))
  (test "two records with the same fields ARE equal"
    (is (= (point 1 2) (point 1 2)))
    (refute (= (point 1 2) (point 1 3))))
  (test "a record is NOT = to a bare map with the same fields (nominal, not structural)"
    (refute (= (point 1 2) {:x 1 :y 2})))
  (test "records of different shapes are never equal"
    (refute (= (point 1 2) (vec3 1 2 0)))))

(describe "defrecord: typed fields"
  (test "typed constructor and accessors work at runtime"
    (let (v (vec3 1 2 3))
      (assert= (fields v) {:x 1 :y 2 :z 3})
      (assert= (vec3-z v) 3)))
  (test "an accessor on a bare map without that field returns nil (records are maps)"
    (assert= (point-y {:x 1}) nil)))

;; ---- the collection protocol: a custom record joins iteration (Seqable) + build (Conjable) ----
(defrecord stack (items))
(impl Seqable stack (->seq [s] (get s :items))) ; iterate the items, not the fields
(impl Conjable stack (-conj [s x] (stack (cons x (get s :items))))) ; prepend on conj
(describe "defrecord: custom collection (Seqable + Conjable)"
  (test "Seqable — a custom record iterates its own way"
    (let (s (stack (list 10 20 30)))
      (assert= (seq s) (list 10 20 30))
      (assert= (count s) 3) ; not 1 (the one `items` field)
      (assert= (fold + 0 s) 60)
      (assert= (map inc s) (list 11 21 31))
      (assert= (filter even? s) (list 10 20 30))))
  (test "the accessors first/rest/empty?/nth route through Seqable too"
    (let (s (stack (list 10 20 30)))
      (assert= (first s) 10)
      (assert= (rest s) (list 20 30))
      (assert= (nth s 1) 20)
      (refute (empty? s))
      (is (empty? (stack (list))))))
  (test "Conjable — conj/into build the custom collection its own way"
    (assert= (seq (conj (stack (list)) 1)) (list 1))
    (assert= (seq (fold conj (stack (list)) (list 1 2 3))) (list 3 2 1)) ; prepend
    (assert= (seq (into (stack (list)) (list :a :b :c))) (list :c :b :a)))
  (test "a record WITHOUT impls still iterates/conj's as its fields (map behaviour)"
    (assert= (into {} (seq (point 1 2))) {:x 1 :y 2}) ; as a map — hash-order-independent
    (assert= (count (point 1 2)) 2)
    (assert= (fields (conj (point 1 2) [:z 3])) {:x 1 :y 2 :z 3})))

;; ---- Ord: a record defines its own sort order ----
(defrecord ver (major minor))
(defmethod compare-to
  [ver ver]
  (a b)
  (let (c (compare (get a :major) (get b :major)))
    (if (= c 0) (compare (get a :minor) (get b :minor)) c)))

(describe "defrecord: custom Ord"
  (test "sort/sort-by use a record's Ord (semantic-version order, not map order)"
    (let (vs (list (ver 1 5) (ver 1 2) (ver 2 0) (ver 1 10)))
      (assert= (map (fn (v) [(get v :major) (get v :minor)]) (sort vs))
        (list [1 2] [1 5] [1 10] [2 0]))
      (assert= (map (fn (v) (get v :minor)) (sort-by (fn (v) v) vs))
        (list 2 5 10 0))))
  (test "built-in sort is unchanged"
    (assert= (sort (list 3 1 2)) (list 1 2 3))
    (assert= (sort (list "b" "a" "c")) (list "a" "b" "c"))))

;; ---- Num: a record does arithmetic via +/-/*// (multimethods on both operands, ADR-179;
;; kernel-dispatched, no hot-path cost). Same-type add/sub; scale by an int scalar for mul/div
;; (`*` is commutative, so `(* 3 (usd …))` works via the derived mirror; `/` is not). ----
(defrecord usd (cents))
(defmethod num-add [usd usd] (a b) (usd (+ (get a :cents) (get b :cents))))
(defmethod num-sub [usd usd] (a b) (usd (- (get a :cents) (get b :cents))))
(defmethod num-mul [usd :int] (m n) (usd (* (get m :cents) n))) ; scale by a scalar
(defmethod num-div [usd :int] (m n) (usd (quot (get m :cents) n)))

(describe "defrecord: custom Num"
  (test "a Num record uses +/-/*// (dispatched from the kernel %add fallback)"
    (assert= (get (+ (usd 500) (usd 250)) :cents) 750)
    (assert= (get (- (usd 500) (usd 250)) :cents) 250)
    (assert= (get (* (usd 500) 3) :cents) 1500)
    (assert= (get (* 3 (usd 500)) :cents) 1500) ; commutative: the [:int usd] mirror is derived
    (assert= (get (/ (usd 900) 3) :cents) 300)
    ;; variadic + folds through the same dispatch
    (assert= (get (+ (usd 100) (usd 200) (usd 300)) :cents) 600))
  (test "a pair with no method is a loud :no-method error, not a silent coercion"
    ;; `usd` has no `[usd usd]` mul method — mixing errors instead of silently coercing.
    (let (e (try (* (usd 5) (usd 5)) (catch e e)))
      (assert= (get e :kind) :no-method)
      (assert= (get e :multi) 'num-mul)))
  (test "a hand-written {:__id__ nil} is a plain map, not a record (truthy-id rule)"
    ;; matches `record?`/`identity-of`: a nil id dispatches as :map, so arithmetic gives the
    ;; ordinary number error rather than routing to the Num multimethod.
    (let (e (try (apply + (list 5 {:__id__ nil})) (catch e (error-message e))))
      (is (includes? e "got map"))))
  (test "int/float arithmetic is untouched by the Num seam"
    (assert= (+ 1 2 3) 6)
    (assert= (* 2 3 4) 24)
    (assert= (+ 1.5 2.5) 4.0)))

;; Records cross process boundaries as the maps they are — build in a worker, send home,
;; read with the accessors and the id (proves the record round-trips per-heap).
(describe "defrecord: across processes"
  :isolated
  (test "a record built in a spawned process survives the send, id and all"
    (let (me (self))
      (spawn (fn () (send me (point 11 22))))
      (receive
        (p (do
             (assert= (point-x p) 11)
             (assert= (point-y p) 22)
             (is (record? p))
             (assert= (record-id p) :record-test/point)))))))
