;; TLS sockets (tls/listen / tls/request / tls/self-signed) over the net
;; reactor (ADR-143). Real loopback handshakes: the server runs on a
;; tls/self-signed cert and the client trusts it via tls/request's ca-pem
;; argument (the private-CA trust anchor) — the first in-tree end-to-end TLS
;; coverage; before ca-pem the client could only talk to Mozilla-rooted hosts.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule tls-test (:use test) (:use suite-helpers) (:use tcp :exclude [send]))

(defn- tls-serve-one (reply)
  "Spawn a TLS echo-ish server: accept ONE connection, read one chunk, send
`reply`, close. Returns [port cert] to the caller."
  (let (me (self))
    (spawn (do
             (let (ck (tls/self-signed "localhost")
                   cert (first ck)
                   key (second ck)
                   ls (tls/listen "127.0.0.1" 0 cert key))
               (send me [:ready (tcp/local-port ls) cert])
               (let (c (receive ([:tcp-accept ^ls cs] cs) (after test/*wait-ms* :timeout)))
                 (tcp/controlling-process c (self))
                 (receive ([:tcp ^c _] nil) (after 10000 nil))
                 (tcp/send c reply)
                 (tcp/close c)))))
    (receive ([:ready port cert] [port cert]) (after test/*wait-ms* :timeout))))

(defn- exchanged (r)
  "`r` as the `[…]` it should be, or a failed test.

  The helpers that drive a loopback exchange answer `:timeout | vector`, so `first`/`second` on the result are unchecked. A `:timeout` here means the exchange did not happen, which is worth failing on
  by name rather than reading `nil` out of a keyword."
  (if (vector? r) r (error "exchanged: expected a vector, got " r)))

(describe "tls: loopback round trip (self-signed + ca-pem trust)"
  :isolated (test "handshake, request, response, close — full exchange"
    (let (pc (tls-serve-one "secret reply")
          port (first (exchanged pc))
          cert (second (exchanged pc)))
      (let (s (tls/request "localhost" port "hello over tls" cert))
        (let (resp (string/bytes-> (drain s)))
          (assert= resp "secret reply")))))
  (test "a binary-mode TLS response is byte-faithful bytes"
    (let (pc (tls-serve-one (bytes 0 255 128 65))
          port (first (exchanged pc))
          cert (second (exchanged pc)))
      (let (s (tls/request "localhost" port "gimme bytes" cert true))
        (assert= (drain s) (bytes 0 255 128 65)))))
  (test "an iolist request (with a bytes leaf) reaches the server byte-faithfully"
    (let (me (self))
      (spawn
        (do
          (let (ck (tls/self-signed "localhost")
                ls (tls/listen "127.0.0.1" 0 (first ck) (second ck)))
            (send me [:ready (tcp/local-port ls) (first ck)])
            (let (c (receive ([:tcp-accept ^ls cs] cs) (after test/*wait-ms* :timeout)))
              ;; Binary mode BEFORE handing over control, not after. `tcp/controlling-process`
              ;; starts messages flowing to this process, so a request already in flight can
              ;; be delivered in the window before `tcp/set-binary` lands — as a *string*,
              ;; and `bytes->list` below then kills this process, leaving the client to drain
              ;; nothing (`resp` = ""). A fast box wins that race; a 2-core one loses it about
              ;; 1 run in 3 (measured 2026-08-11 under `taskset -c 0,1`), which is what made
              ;; this test redden CI while passing locally. Configuring the socket before
              ;; anyone is receiving from it closes the window entirely.
              ;;
              ;; This is the codebase's established convention, not a new idea: the HTTP
              ;; server does the same thing for the same reason, and its comment names the
              ;; prior occurrence — "setting binary after the handoff left a window where a
              ;; first chunk was decoded as lossy text (the old http binary-body flake)"
              ;; (`std/net/http.blsp`). A sweep of every `tcp/controlling-process` /
              ;; `tcp/set-binary` pair found this file as the only remaining outlier;
              ;; `tests/tcp_test.blsp`'s ~17 pairs are safe because there the client sends
              ;; only AFTER the server has configured the socket, so nothing is in flight.
              (tcp/set-binary c true)
              (tcp/controlling-process c (self))
              (let (got (receive ([:tcp ^c d] d) (after test/*wait-ms* :timeout)))
                (tcp/send c (pr-str (into [] (seq got))))
                (tcp/close c))))))
      (let (port-cert (receive ([:ready p ct] [p ct]) (after test/*wait-ms* :timeout))
            s (tls/request "localhost"
                (first (exchanged port-cert))
                ["HEAD " (bytes 1 254) " TAIL"]
                (second (exchanged port-cert))))
        (let (resp (string/bytes-> (drain s)))
          ;; "HEAD " = 72 69 65 68 32, then 1 254, then " TAIL" = 32 84 65 73 76
          (assert= resp "[72 69 65 68 32 1 254 32 84 65 73 76]")))))
  (test "an untrusted cert is a clean [:tcp-error …], not a hang"
    (let (pc (tls-serve-one "unreachable")
          port (first (exchanged pc)))
      ;; no ca-pem → the self-signed cert is rejected against the Mozilla roots
      (let (s (tls/request "localhost" port "x"))
        (let (out (receive
                    ([:tcp-error ^s msg] [:error msg])
                    ([:tcp-closed ^s] :closed)
                    (after test/*wait-ms* :timeout)))
          (assert= (first (exchanged out)) :error))))))

;; ---- tcp/close silences a TLS stream ----------------------------------------------
;; The TLS twin of tcp_test's "nothing reaches the owner after tcp/close": the server
;; closes while the client's request is still arriving and its own reply is still
;; queued. Nothing more for the socket may reach the server — no rest of the request,
;; no `[:tcp-closed]` — and the client must still get the whole reply.

(defn- tls-close-mid-request (ls cert request reply)
  "One round on listener `ls`: a client sends `request`; on its first chunk, send `reply`
  and close. Returns `[late received]` — the messages for the socket that arrived after
  the ones queued at the close were taken, and how many bytes the client read."
  (let (me (self)
        port (or (tcp/local-port ls) (error "the TLS listener reported no local port"))
        client (spawn (let (s (tls/request "localhost" port request cert true))
                        (send me [:received (self) (count (drain s))])))
        s (receive ([:tcp-accept ^ls cs] cs) (after test/*wait-ms* (error "no TLS accept"))))
    (tcp/controlling-process s (self))
    (receive ([:tcp ^s _] nil) (after test/*wait-ms* (error "the TLS client never wrote")))
    (tcp/send s reply)
    (tcp/close s)
    (late-messages s 0 0)
    (let (late (late-messages s 100 0))
      [late (receive ([:received ^client n] n) (after test/*wait-ms* :timeout))])))

(defn- first-noisy-tls-close (ls cert request reply remaining)
  "Run `tls-close-mid-request` `remaining` times; the first round whose result is not
  `[0 reply-length]`, as `[remaining result]`, or nil."
  (if (= remaining 0)
    nil
    (let (result (tls-close-mid-request ls cert request reply))
      (if (= result [0 (string/length reply)])
        (first-noisy-tls-close ls cert request reply (dec remaining))
        [remaining result]))))

(describe "tls: nothing reaches the owner after tcp/close"
  :isolated (test "a TLS stream closed mid-request delivers nothing more, and the reply arrives whole"
    (let (ck (tls/self-signed "localhost")
          ls (tls/listen "127.0.0.1" 0 (first ck) (second ck))
          outcome (first-noisy-tls-close ls
                    (first ck)
                    (string/repeat "q" (* 256 1024))
                    (string/repeat "r" (* 2 1024 1024))
                    6))
      (tcp/close ls)
      (assert= outcome nil))))

(describe "tls: a listener refuses PEM it cannot use, naming which half is wrong"
  (defn- listen-error (cert key)
    (try (do (tls/listen "127.0.0.1" 0 cert key) nil) (catch e (get e :message))))
  (test "a key PEM with no private key in it"
    (let (cert (first (tls/self-signed "localhost")))
      (is (includes? (listen-error cert "not a pem") "no private key in key PEM"))))
  (test "a certificate PEM with no certificate in it"
    (let (key (second (tls/self-signed "localhost")))
      (is (includes? (listen-error "not a pem" key) "no certificates in cert PEM")))))
