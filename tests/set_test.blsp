;; Sets — the first-class `#{…}` kernel type (ADR-060): a distinct `Value::Set`
;; backed by the same CHAMP trie as a map (element→true), so it shares structural
;; equality and O(log n) membership but is its OWN kind (`set?` true, `map?` false,
;; prints `#{…}`, never `=` to a map). The `set` library (std/set.blsp) adds the
;; constructor from a collection and the algebra (union/intersection/difference/
;; subset?).
;;
;; Register-only — discovered and run by `nest test` (and cargo test, via
;; crates/lisp/tests/suite.rs). The whole suite runs each test in its own green
;; process, so these already run across cores; the final :isolated block adds
;; explicit spawn/send/receive coverage (a set deep-copies across per-process
;; heaps as a set — proving the Message::Set / wire round-trip).

;; This test file is itself a namespace so it can `(:use set)` — referring set's
;; functions (`set`/`conj`/`union`/…) bare. The framework is still root, so
;; `(require 'test)`/`(:use test)` as before.
(defmodule set-test (:use set) (:use test))

;; Tail-recursive [lo, hi) (the test body runs in a small-stack green process).
(defn st-range (lo hi) (st-range--down (- hi 1) lo nil))
(defn st-range--down (i lo acc) (if (< i lo) acc (st-range--down (- i 1) lo (cons i acc))))

(describe "set literals & kind"
  (test "`#{…}` reads, evaluates its elements, and dedups"
    (assert= #{1 2 3} (set [1 2 3]))
    (assert= #{(+ 1 1) 2 (* 1 3)} #{2 3})
    (assert= (count #{1 1 2 3 3 3}) 3))
  (test "a set is its own kind — set? yes, map? no, type-of :set"
    (is (set? #{1 2}))
    (is (set? (set [1 2])))
    (refute (map? #{1 2}))
    (refute (set? {1 true}))
    (refute (set? [1 2]))
    (assert= (type-of #{1}) :set))
  (test "a set is never = to the map with the same keys"
    (refute (= #{1 2} {1 true 2 true}))
    (refute (= {1 true} #{1})))
  (test "set equality is order-independent"
    (assert= #{1 2 3} #{3 2 1})
    (refute (= #{1 2 3} #{1 2}))))

(describe "set construction & membership"
  (test "set dedups its input"
    (assert= (set [1 1 2 3 3 3]) #{1 2 3})
    (assert= (count (set [1 1 2 3 3 3])) 3))
  (test "the empty set"
    (is (empty? #{}))
    (is (empty? (set [])))
    (is (empty? (set nil))))
  (test "membership is contains?, size is count, elements seq out"
    (let (s (set [:a :b :c]))
      (is (contains? s :a))
      (refute (contains? s :z))
      (assert= (count s) 3)
      (assert= (into [] (sort s)) [:a :b :c])))
  (test "a set of vector coordinates works (structural keys)"
    (let (live #{[0 0] [1 2]})
      (is (contains? live [1 2]))
      (refute (contains? live [9 9]))
      (assert= (count live) 2))))

;; `conj`/`disj` are PRELUDE functions that dispatch on the collection kind — not
;; `set/…` names. They were module-local (and so shadowed the polymorphic prelude
;; `conj` under `(:use set)`, breaking `(conj [1 2] 3)` in any file that imported
;; this module) until 2026-07-26. These cases run in a `(:use set)` file, so they
;; also pin that the import no longer shadows them.
(describe "conj & disj"
  (test "conj adds; re-adding is a no-op"
    (assert= (conj (set [1 2]) 3) #{1 2 3})
    (assert= (conj (set [1 2]) 2) #{1 2}))
  (test "conj is variadic on a set, like every other collection"
    (assert= (conj #{1} 2 3) #{1 2 3}))
  (test "disj removes; removing an absent element is a no-op"
    (assert= (disj (set [1 2 3]) 2) #{1 3})
    (assert= (disj (set [1 2]) 9) #{1 2}))
  (test "disj is variadic"
    (assert= (disj #{1 2 3} 1 3) #{2}))
  (test "conj/disj return fresh sets (no mutation)"
    (let (s (set [1 2]))
      (conj s 3)
      (disj s 1)
      (assert= s #{1 2})))
  (test "the same conj still works on every other kind inside a (:use set) file"
    (assert= (conj [1 2] 3) [1 2 3])
    (assert= (conj (list 2 3) 1) (list 1 2 3))
    (assert= (conj {:a 1} [:b 2]) {:a 1 :b 2})
    (assert= (conj nil 1) (list 1))))

;; A set is a first-class member of the collection protocol: the prelude ops
;; dispatch to it with no `(:use set)` needed. Before 2026-07-26 `conj` errored
;; ("not a collection"), `into` poured into a LIST and lost the dedup, and `get`
;; indexed positionally — so `(get #{10 20} 10)` was nil while `(get #{10 20} 0)`
;; was 20, an answer wrong under any reading.
(describe "a set in the collection protocol"
  (test "get looks up by MEMBERSHIP, yielding the element (never an index)"
    (assert= (get #{10 20} 10) 10)
    (assert= (get #{10 20} 20) 20)
    (assert= (get #{10 20} 0) nil)
    (assert= (get #{10 20} 0 :absent) :absent)
    ;; get and contains? now agree on a set (they disagreed before)
    (is (contains? #{10 20} 10))
    (refute (contains? #{10 20} 0)))
  (test "into a set adds and dedups, keeping the set kind"
    (assert= (into #{} [1 1 2]) #{1 2})
    (is (set? (into #{} [1 1 2])))
    (assert= (into #{1} #{2 3}) #{1 2 3})
    (assert= (into #{1} nil) #{1}))
  (test "first/rest/count/empty? treat a set as its elements"
    (assert= (count #{1 2 3}) 3)
    (is (empty? #{}))
    (is (contains? #{1 2 3} (first #{1 2 3})))
    (assert= (count (rest #{1 2 3})) 2))
  (test "vec / seq realise a set to its elements"
    (assert= (count (vec #{1 2 3})) 3)
    (assert= (sort (vec #{3 1 2})) (list 1 2 3))))

(describe "set algebra"
  (test "union"
    (assert= (union #{1 2 3} #{3 4 5}) #{1 2 3 4 5})
    (assert= (union #{1 2} #{}) #{1 2}))
  (test "intersection"
    (assert= (intersection #{1 2 3} #{2 3 4}) #{2 3})
    (is (empty? (intersection #{1 2} #{3 4}))))
  (test "difference"
    (assert= (difference #{1 2 3} #{2}) #{1 3})
    (assert= (difference #{1 2} #{1 2 3}) #{}))
  (test "subset?"
    (is (subset? #{1 2} #{1 2 3}))
    (is (subset? #{} #{1}))
    (refute (subset? #{1 4} #{1 2 3})))
  (test "the algebra over a larger range is consistent"
    (let (a (set (st-range 0 50)) b (set (st-range 25 75)))
      (assert= (count (union a b)) 75)
      (assert= (count (intersection a b)) 25)
      (assert= (count (difference a b)) 25)
      (is (subset? (intersection a b) a)))))

;; ---- explicit concurrency: a set deep-copies across heaps (Message::Set) ------
(defn st-build-echo (parent ks) (send parent (set ks)))
(defn st-spawn-builders (parent n)
  (when (> n 0) (spawn (st-build-echo parent (st-range 0 n))) (st-spawn-builders parent (- n 1))))
(defn st-collect (got total acc)
  (if (= got total) acc (st-collect (+ got 1) total (receive (s (union acc s))))))

(describe "sets across processes"
  :isolated
  (test "a set round-trips through a worker unchanged"
    (let (me (self) _w (spawn (st-build-echo me [:x :y [1 2]])))
      (let (got (receive))
        (is (set? got))
        (assert= got #{:x :y [1 2]}))))
  (test "sets built in many workers fan in and union correctly"
    (let (me (self))
      (st-spawn-builders me 4)
      ; workers send (set 0..1), (set 0..2), (set 0..3), (set 0..4);
      ; their union is #{0 1 2 3}.
      (assert= (st-collect 0 4 #{}) (set (st-range 0 4))))))
