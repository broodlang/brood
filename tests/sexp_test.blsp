;; std/sexp — structural (s-expression) navigation over Brood's parse-source CST.
;; Reusable Brood-code tooling (the editor's brood-mode binds these, but they're not
;; editor-specific). Register-only — run by `nest test` (and cargo test, via suite.rs).

(defmodule sexp-test (:use test) (:use sexp) (:use editor/buffer))
(require 'sexp)
(require 'editor/buffer)

;; (defn f (x)\n  (+ x 1))   — outer list [0,22); 'defn' [1,5); 'f' [6,7);
;; (x) [8,11); inner (+ x 1) [14,21).
(def src "(defn f (x)\n  (+ x 1))")

; forward-sexp spans (def y 1)
(describe "sexp navigation (pure, over the parse-source CST)"
  ; from the space → end of 'f'
  (test "forward over the whole top form, and over inner atoms"
    ; before outer → end of the whole form
    (assert= (point-forward src 0) 22)
    ; → end of 'defn'
    (assert= (point-forward src 1) 5)
    (assert= (point-forward src 5) 7))
  ; end of 'defn' → its start
  (test "backward"
    ; before close → start of the top form
    (assert= (point-backward src 22) 0)
    (assert= (point-backward src 5) 1))
  ; at top level → unchanged
  (test "down-list enters, up-list leaves"
    ; just inside the outer list
    (assert= (point-down src 0) 1)
    ; inside (+ x 1) → its open paren
    (assert= (point-up src 15) 14)
    ; inside outer → its open paren
    (assert= (point-up src 1) 0)
    (assert= (point-up src 0) 0))
  (test "beginning-of-defun finds the enclosing top-level form"
    (assert= (point-defun-start src 15) 0)
    (assert= (point-defun-start src 8) 0))
  (test "end-of-defun finds the enclosing top-level form's close"
    (assert= (point-defun-end src 15) 22)
    (assert= (point-defun-end src 8) 22))
  ;; forward-list/backward-list step over the ATOM siblings and stop only at lists: from the
  ;; start of `defn` the next list is `(x)` [8,11), then the inner `(+ x 1)` [14,21).
  (test "forward-list / backward-list skip atoms and land on list boundaries"
    (assert= (point-list-forward src 1) 11)
    (assert= (point-list-forward src 11) 21)
    ; no further list → unchanged
    (assert= (point-list-forward src 21) 21)
    (assert= (point-list-backward src 21) 14)
    (assert= (point-list-backward src 14) 8)
    (assert= (point-list-backward src 8) 8))
  (test "up-list leaves the enclosing list forward, past its close"
    ; inside (+ x 1) → past its `)`
    (assert= (point-up-forward src 15) 21)
    ; inside the outer form → past its `)`
    (assert= (point-up-forward src 1) 22)
    ; at top level → unchanged
    (assert= (point-up-forward src 0) 0))
  (test "positions account for delimiters & reader-macro prefixes"
    ;; "'(a) [b]"  → quoted list [0,4), vector [5,8)
    (assert= (point-forward "'(a) [b]" 0) 4)
    (assert= (point-forward "'(a) [b]" 4) 8))
  (test "a column-0 bracket inside a multi-line docstring doesn't break motion below it"
    ;; the `(x)` line sits at column 0 INSIDE the docstring; narrow must not treat it as a
    ;; top-level form start (else it slices mid-string and the CST parse of the fragment fails,
    ;; leaving forward-sexp stuck). Regression for the reported `(defmodule …"…(…"…)` bug.
    (let (src "(defmodule m\n\"doc\n(x)\nend\")\n(def y 1)"
          dp (index-of src "(def y"))
      ; not the in-docstring (x)
      (let ([base sub] (narrow src dp))
        (assert= base 0))
      (assert= (point-forward src dp) (string-length src)))))
;; Structural motion narrows to the forms around point (`sexp/narrow`) so it's
;; O(neighbouring forms), not O(buffer). These pin that the narrowed answer equals the
;; whole-buffer one, including deep in a file with many preceding top-level forms (where
;; the un-narrowed walk is what made `forward-sexp` stall for a second).
(describe "sexp navigation narrows without changing the answer"
  ;; brute-force references: the same queries over the WHOLE-buffer CST, un-narrowed.
  (defn bf-enc (text point) (enclosing (tree text) point))
  (defn bf-forward (text point)
    (let (nxt (first (filter (fn (f) (>= (get f :start) point)) (forms-of (bf-enc text point)))))
      (if (nil? nxt) point (get nxt :end))))
  (defn bf-backward (text point)
    (let (prev (last (filter (fn (f) (<= (get f :end) point)) (forms-of (bf-enc text point)))))
      (if (nil? prev) point (get prev :start))))
  (def many
    (str (join "" (map (fn (i) (str "(defn f" i " () " i ")\n")) (range 300)))
      "(map g (h x))"))
  (def n (string-length many))
  (test "narrowed motion matches the whole-buffer walk at many points (incl. deep + boundaries)"
    (doseq (p [0 1 25 (- n 13) (- n 12) (- n 7) (- n 6) (- n 1)])
      (assert= (point-forward many p) (bf-forward many p))
      (assert= (point-backward many p) (bf-backward many p))))
  (test "narrow genuinely slices (base ≤ point, slice shorter than the whole text)"
    (let ([base sub] (narrow many (- n 6)))
      (is (<= base (- n 6)))
      (is (> (string-length sub) 0))
      (is (< (string-length sub) n)))))

(describe "sexp buffer commands"
  (test "forward moves point to the end of the next sexp"
    (assert= (get (forward (make-buffer "(+ 1 2)") nil) :point) 7))
  (test "down enters the next list, up leaves it"
    (let (b (down (make-buffer "(a b)") nil))
      (assert= (get b :point) 1)
      (assert= (get (up b nil) :point) 0))))

;; `tree` is the kernel's `parse-source-positioned` — the position-annotated CST the
;; navigation runs over. These pin the node shape the queries above depend on.
(describe "parse-source-positioned (the kernel CST behind sexp/tree)"
  ; one top-level form, no trivia
  (test "the root is a positioned container node spanning the whole text"
    (let (r (tree "(a b)"))
      (assert= (get r :kind) :root)
      (assert= (get r :start) 0)
      (assert= (get r :end) 5)
      (assert= (count (get r :kids)) 1)))
  (test "a leaf carries its raw :text and half-open positions"
    (let (lst (first (forms-of (tree "(ab cd)")))
          ab (first (forms-of lst)))
      (assert= (get ab :kind) :symbol)
      (assert= (get ab :text) "ab")
      (assert= (get ab :start) 1)
      (assert= (get ab :end) 3)))
  (test "positions are CHARACTER offsets, not bytes (multibyte leading content)"
    ;; "é" is two UTF-8 bytes but one character; the symbol after it starts at char 2.
    ; the "é" symbol at char 0
    (let (x (first (forms-of (tree "é x"))))
      (assert= (get x :start) 0))
    (let (forms (forms-of (tree "é x"))
          x (first (rest forms)))
      ; "x" at char 2 (byte 3) — char offset
      (assert= (get x :start) 2)
      (assert= (get x :end) 3))))

;; The paredit family: pure structural edits returning [new-text new-point], nil when
;; the op doesn't apply. Slurp/barf are inverses; raise/splice collapse a level.
; multi-line → only to end of line
(describe "sexp structural edits (paredit, pure over the CST)"
  (test "slurp-forward pulls the next sibling in; barf-forward expels the last"
    (assert= (point-slurp-forward "(foo) bar" 2) ["(foo bar)" 2])
    (assert= (point-barf-forward "(foo bar)" 2) ["(foo) bar" 2]))
  (test "slurp-backward pulls the previous sibling in; barf-backward expels the first"
    (assert= (point-slurp-backward "foo (bar)" 6) ["(foo bar)" 6])
    (assert= (point-barf-backward "(foo bar)" 6) ["foo (bar)" 6]))
  ; point on c
  (test "raise replaces the enclosing list with the child at point"
    (assert= (point-raise "(a (b c) d)" 6) ["(a c d)" 3]))
  (test "splice drops the enclosing delimiters, keeping the contents"
    (assert= (point-splice "(a (b) c)" 4) ["(a b c)" 3]))
  (test "wrap-round wraps the form at point, point landing just inside"
    (assert= (point-wrap-round "foo bar" 0) ["(foo) bar" 1]))
  (test "transpose swaps the forms either side of point, keeping the separator in place"
    ;; between `a` and `b` → swapped, point past both
    (assert= (point-transpose "(a b)" 2) ["(b a)" 4])
    ;; separator width is preserved where it was, not carried with the forms
    (assert= (point-transpose "(a   b)" 2) ["(b   a)" 6])
    ;; point INSIDE a form → that form is the one "after", so it swaps with its predecessor
    (assert= (point-transpose "(a foo)" 4) ["(foo a)" 6])
    ;; whole lists transpose as units
    (assert= (point-transpose "((a b) (c d))" 6) ["((c d) (a b))" 12]))
  (test "transpose is nil with nothing on one side"
    ; only one form in the list
    (assert= (point-transpose "(a)" 2) nil)
    (assert= (point-transpose "(a b)" 1) nil))
  ; not inside any list
  (test "ops return nil when inapplicable (no sibling, top level)"
    ; nothing after to slurp
    (assert= (point-slurp-forward "(foo)" 2) nil)
    (assert= (point-splice "foo" 1) nil))
  (test "point-kill-end caps at the enclosing close, never breaking parens"
    ; kill foo bar, keep the )
    (assert= (point-kill-end "(foo bar)" 1) 8)
    (assert= (point-kill-end "(foo\n bar)" 1) 4)))

(describe "top-level-forms"
  (test "each top-level form, in order, with half-open offsets"
    (let (forms (top-level-forms "(+ 1 2)\n(defn f (x) x)"))
      (assert= (count forms) 2)
      (assert= (get (first forms) :start) 0)
      (assert= (get (first forms) :end) 7)
      (assert= (get (first (rest forms)) :start) 8)
      (assert= (get (first (rest forms)) :end) 22)))
  (test "comments and whitespace are not forms"
    (assert= (count (top-level-forms ";; just a comment\n\n  (a)  ")) 1))
  (test "empty and blank text have no forms"
    (assert= (top-level-forms "") ())
    (assert= (top-level-forms "  \n ;; c\n") ()))
  (test "answers over incomplete source (mid-typing) without raising"
    ;; the reader's CST recovers: the closed form is there with exact offsets
    (let (forms (top-level-forms "(done 1)\n(unclosed"))
      (is (>= (count forms) 1))
      (assert= (get (first forms) :end) 8))))

;; `scan-form-start-2` replaced the two `scan-form-start` calls `narrow` used to make, and it
;; must return exactly what that pair returned — including for the awkward inputs the lexical
;; pass exists to handle (a bracket inside a comment, a string spanning a newline, an
;; unterminated string swallowing the rest). Checked over EVERY position of each text, because
;; an off-by-one at one offset is precisely how a structural motion goes subtly wrong.
(describe "scan-form-start-2 is equivalent to the two calls it replaced"
  (test "matches (scan-form-start p) + (scan-form-start (dec start)) at every position"
    (let (pair-old (fn (text p)
                     (let (start (scan-form-start text p)
                           base (if (> start 0) (scan-form-start text (- start 1)) 0))
                       [base start]))
          texts (list "(a)\n(b)\n(c)\n"
                  ; plain
                  "(a)\n; (b)\n(c)\n" ; a form start inside a comment
                  "(a \"str\n(b)\" x)\n(c)\n" ; a form start inside a multi-line string
                  "(a)\n(b \"unterminated\n(c)\n" ; unterminated string swallows the rest
                  "  (indented)\n(top)\n" ; only column 0 counts
                  "no-forms-here\n" ; none at all
                  "(only)\n" "")
          bad (fold (fn (acc text)
                      (fold (fn (a p)
                              (if (= (pair-old text p) (scan-form-start-2 text p))
                                a
                                (cons [text p] a)))
                        acc
                        (range 0 (+ 2 (string-length text)))))
                nil texts))
      (assert= 0 (count bad)))))
