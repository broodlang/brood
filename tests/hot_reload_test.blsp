;; Hot reload / late binding (ADR-013) — the core property: a running process
;; picks up a `def` redefinition's NEW behaviour on its next lookup, across the
;; inline cache, the JIT fast-link, and RUNTIME compaction. Previously only
;; indirectly covered (concurrency_race proves a rebind-underfoot doesn't crash;
;; jit_shared_spawn proves between-batch JIT invalidation). This asserts the
;; behaviour change directly, including cross-process and under concurrent load.
;; `:isolated` — these `def` shared globals; isolate from the concurrent suite.
(defmodule hot-reload-test (:use test) (:use debug))

; zero garbage results across 1600 calls
(describe "late binding (def redefinition is visible on the next call)"
  :isolated (test "a caller picks up a redefined global fn within the same process"
    (def hr-a (fn () 1))
    (defn hr-call-a () (hr-a))
    (let (before (hr-call-a) _ (def hr-a (fn () 2)) after (hr-call-a))
      (assert= before 1)
      (assert= after 2)))

  (test "a JIT-tiered call site re-resolves after redefinition (fast-link invalidated)"
    (def hr-b (fn (x) (* x 2)))
    ;; warm hr-b past the tier threshold so its call site is JIT-linked
    (defn hr-warm (i) (if (= i 0) :done (do (hr-b 5) (hr-warm (- i 1)))))
    (hr-warm 5000)
    (let (warmed (hr-b 5) _ (def hr-b (fn (x) (* x 100))) redef (hr-b 5))
      (assert= warmed 10)
      (assert= redef 500)))

  ; the new fn works
  (test "arity change on redefinition: an old-arity call errors cleanly (no corruption)"
    ;; This test changes an arity ON PURPOSE, so the kernel's reload diagnostic is
    ;; expected rather than informative — silence it for this test's scope so it
    ;; doesn't look like a problem in the suite's output.
    (def *reload-diagnostics* false)
    (def hr-c (fn (x) x))
    (def hr-c (fn (x y) (+ x y)))
    ; 1-arg call against the new 2-arg fn
    (assert-error (hr-c 5))
    (assert= (hr-c 5 7) 12))
  (test "a parked process observes a redefinition made while it was waiting"
    (def hr-d (fn (x) (* x 2)))
    (let (me (self)
          w (spawn (do (send me [:r (hr-d 5)]) (receive (:go :ok)) (send me [:r (hr-d 5)]))))
      (let (old (receive ([:r v] v)))
        ; redefine while the worker is parked in receive
        (def hr-d (fn (x) (* x 100)))
        (send w :go)
        (let (new (receive ([:r v] v)))
          (assert= old 10)
          (assert= new 500)))))

  (test "concurrent redefinition under load never yields a torn/garbage value"
    ;; 16 workers each call hr-e 100×; every result must be one of the impls'
    ;; outputs (10/20/30) — never garbage — while main redefines hr-e underfoot.
    (def hr-e (fn () 10))
    (defn hr-valid? (v) (or (= v 10) (= v 20) (= v 30)))
    (defn hr-worker (parent n bad)
      (if (= n 0)
        (send parent [:done bad])
        (hr-worker parent (- n 1) (if (hr-valid? (hr-e)) bad (+ bad 1)))))
    (defn hr-spawn (parent k)
      (when (> k 0) (spawn (hr-worker parent 100 0)) (hr-spawn parent (- k 1))))
    (defn hr-churn (k)
      (when (> k 0)
        (def hr-e (fn () 20))
        (def hr-e (fn () 30))
        (def hr-e (fn () 10))
        (hr-churn (- k 1))))
    (defn hr-collect (got total bad)
      (if (= got total) bad (hr-collect (+ got 1) total (+ bad (receive ([:done b] b))))))
    (let (me (self))
      (hr-spawn me 16)
      ; redefine hr-e ~600× while workers run
      (hr-churn 200)
      (assert= (hr-collect 0 16 0) 0))))

;; Hot reload reaches a receive loop running in NATIVE code (ADR-410). One loop function per
;; test, because each test redefines its own. A redefinition makes the native loop hand over to
;; the VM, whose `SelfCall` re-resolves the name (the ADR-013 guard), so the loop runs the new
;; code from its next iteration. That holds whether the loop is parked in `receive` or busy
;; draining a full mailbox. Sabotaging that guard reddens the first, second and fourth tests.
(defn hrn-a (total)
  (receive
    ([:add n] (hrn-a (+ total n)))
    ([:get from] (do (send from [:total total]) (hrn-a total)))
    (:stop total)))
(defn hrn-b (total)
  (receive
    ([:add n] (hrn-b (+ total n)))
    ([:hold ms] (do (proc/sleep ms) (hrn-b total)))
    ([:get from] (do (send from [:total total]) (hrn-b total)))
    (:stop total)))
(defn hrn-c (total)
  (receive
    ([:add n] (hrn-c (+ total n)))
    ([:get from] (do (send from [:total total]) (hrn-c total)))
    (:stop total)))
(defn hrn-d (total)
  (receive
    ([:add n] (hrn-d (+ total n)))
    ([:get from] (do (send from [:total total]) (hrn-d total)))
    (:stop total)))

(defn hrn-total (pid) (send pid [:get (self)]) (receive ([:total t] t) (after 20000 :timeout)))
(defn hrn-warm (pid) (doseq (_k (range 3000)) (send pid [:add 1])) (hrn-total pid))
;; An arm's tier once a queued background compile has finished.
(defn hrn-tier (f tries)
  (let (state (get (%jit-arm-state f 1) :state))
    (if (and (= state :queued) (> tries 0)) (do (proc/sleep 10) (hrn-tier f (- tries 1))) state)))
(defn hrn-times-ten (name)
  (reflect/eval-string (str "(defn hot-reload-test/"
                         name " (total) (receive ([:add n] (hot-reload-test/" name
                         " (+ total (* 10 n)))) ([:get from] (do (send from [:total total]) (hot-reload-test/"
                         name " total))) (:stop total)))")))
(defn hrn-spy-kinds (acc) (receive ([:spy k] (hrn-spy-kinds (cons k acc))) (after 50 acc)))

(describe "hot reload reaches native receive loops"
  :isolated (test "a parked native loop runs the redefinition from its next iteration"
    (let (pid (spawn (hrn-a 0)))
      (assert= 3000 (hrn-warm pid))
      (when (%native-tier?) (assert= :native (hrn-tier hrn-a 500)))
      (proc/sleep 20)
      (hrn-times-ten "hrn-a")
      ;; The first message is handled by the activation that was parked (old code, +1); its
      ;; tail call enters the new code (+10).
      (send pid [:add 1])
      (send pid [:add 1])
      (assert= 3011 (hrn-total pid))
      (send pid :stop)))
  :isolated (test "a busy native loop runs the redefinition without waiting for a park"
    (let (pid (spawn (hrn-b 0)))
      (assert= 3000 (hrn-warm pid))
      (when (%native-tier?) (assert= :native (hrn-tier hrn-b 500)))
      ;; The redefinition lands while the loop sleeps in a clause body (the 50 ms makes sure
      ;; it is in there: without it the def won the race 9 runs in 10 and landed while the
      ;; loop was parked, the case above), and 200 000 messages queue behind it; it then
      ;; drains them with no park in between. Native code sees the def at its back-edge
      ;; epoch guard, which runs once per tick batch (128 iterations): up to a batch may run
      ;; the old body (+1 instead of +10). Before the guard existed for every self-loop,
      ;; all 200 000 did (203 000).
      (send pid [:hold 300])
      (proc/sleep 50)
      (hrn-times-ten "hrn-b")
      (doseq (_k (range 200000)) (send pid [:add 1]))
      (let (total (hrn-total pid))
        (is (<= (- (+ 3000 (* 10 200000)) total) (* 9 128))))
      (send pid :stop)))
  :isolated (test "proc/info reads a parked native loop"
    (let (pid (spawn (hrn-c 0)))
      (hrn-warm pid)
      (when (%native-tier?) (assert= :native (hrn-tier hrn-c 500)))
      (proc/sleep 20)
      (let (before (proc/info pid))
        (assert= :waiting (get before :status))
        (doseq (_k (range 2000)) (send pid [:add 1]))
        (hrn-total pid)
        (proc/sleep 20)
        (let (after (proc/info pid))
          (assert= :waiting (get after :status))
          (assert= 0 (get after :mailbox))
          (assert= true (> (get after :reductions) (get before :reductions)))))
      (send pid :stop)))
  :isolated (test "trace-fn sees a native loop's calls, and untrace-fn puts it back"
    (let (me (self)
          pid (spawn (hrn-d 0)))
      (hrn-warm pid)
      (when (%native-tier?) (assert= :native (hrn-tier hrn-d 500)))
      (proc/sleep 20)
      (def *spy-sink* (fn (e) (send me [:spy (get e :spy)])))
      (trace-fn 'hot-reload-test/hrn-d)
      (send pid [:add 1])
      (send pid [:add 1])
      (assert= 3002 (hrn-total pid))
      (assert= true (>= (count (seq/filter (hrn-spy-kinds (list)) (fn (k) (= k :call)))) 2))
      (untrace-fn 'hot-reload-test/hrn-d)
      (def *spy-sink* nil)
      (send pid [:add 1])
      (assert= 3003 (hrn-total pid))
      (assert= (list) (hrn-spy-kinds (list)))
      (send pid :stop))))

;; A native self-loop with no hoisted global had no back-edge epoch guard, so it never saw a
;; `def` of itself while it ran: a compute loop spun on its old body until it finished, and
;; hot reload — which the VM's `SelfCall` re-resolution gives every interpreted loop — did
;; not reach it. Here the loop would run for hours; the redefinition makes it return. Without
;; the guard the wait times out (and the spinner is killed).
(defn hrn-spin (n acc) (if (= n 0) acc (hrn-spin (- n 1) (+ acc 1))))

(describe "hot reload reaches native compute loops"
  :isolated (test "a running native self-loop picks up a redefinition of itself"
    (when (%native-tier?)
      (let (me (self)
            pid (spawn (send me [:spun (hrn-spin 1000000000000 0)])))
        (proc/sleep 50)
        (reflect/eval-string "(defn hot-reload-test/hrn-spin (n acc) acc)")
        (let (got (receive ([:spun r] r) (after test/*wait-ms* :still-spinning)))
          (when (= got :still-spinning) (exit pid :kill))
          (is (int? got)))))))
