;; The documentation-site renderer (std/docsite.blsp): a pure `model -> HTML string`.
;; Register-only — discovered and run by `nest test`.

(defmodule docsite-test (:use test) (:use docsite))

(def sample-model
  {:name "demo"
   :version "0.1.0"
   :modules [{:module "my/mod"
              :doc "A demo module.\n\nSecond paragraph with `code` in it."
              :defs [{:name "foo"
                      :sig "(foo x y)"
                      :doc "Adds `x` and `y`."
                      :macro false
                      :type "(int, int -> int)"}
                      {:name "bar" :sig "(bar z)" :doc nil :macro true :type nil}]}
              {:module "my/empty" :doc nil :defs []}]})

(describe "docsite: escaping"
  (test "the HTML metacharacters are escaped (& first)"
    (assert= (docsite/escape "a<b>&c") "a&lt;b&gt;&amp;c"))
  (test "a non-string is coerced then escaped"
    (assert= (docsite/escape 42) "42")))

(describe "docsite: prose"
  (test "blank lines split paragraphs"
    (assert= (docsite/prose "one\n\ntwo") "<p>one</p><p>two</p>"))
  (test "backtick pairs become inline code, escaped"
    (assert= (docsite/prose "call `f<x>`") "<p>call <code>f&lt;x&gt;</code></p>"))
  (test "nil and blank render to the empty string"
    (assert= (docsite/prose nil) "")
    (assert= (docsite/prose "   ") ""))
  ; an indented code example renders as a <pre> with its newlines PRESERVED (not collapsed into
  ; one run-on <p>) and dedented — the fix for the scrambled module docstrings.
  (test "an indented code block becomes a dedented <pre>, line breaks kept"
    (assert= (docsite/prose "prose here\n\n    (a 1)\n    (b 2)")
      "<p>prose here</p><pre class=\"doc-example\"><code>(a 1)\n(b 2)</code></pre>"))
  (test "code-block content is HTML-escaped, backticks left literal"
    (assert= (docsite/prose "    (f `x` <y>)")
      "<pre class=\"doc-example\"><code>(f `x` &lt;y&gt;)</code></pre>"))
  (test "a non-indented block stays a <p> with inline code"
    (assert= (docsite/prose "call `f`") "<p>call <code>f</code></p>")))

(describe "docsite: anchors"
  (test "module and def anchors slugify slashes"
    (assert= (docsite/module-anchor "my/mod") "m-my-mod")
    (assert= (docsite/def-anchor "my/mod" "foo") "d-my-mod-foo")))

(describe "docsite: render (whole page)"
  (test "a wrapped render is a self-contained document"
    (let (html (docsite/render sample-model {}))
      (is (includes? html "<!doctype html>"))
      (is (includes? html "<title>demo</title>"))
      (is (includes? html "<div class=\"docsite\">"))
      ; the sidebar lists the module
      (is (includes? html "class=\"nav-module-link\""))
      ; a definition renders its signature, type, and a macro tag where due
      (is (includes? html "(foo x y)"))
      (is (includes? html "(int, int -&gt; int)"))
      (is (includes? html "class=\"tag\">macro"))
      ; an undocumented def and an empty module have their placeholders
      (is (includes? html "Undocumented."))
      (is (includes? html "No public definitions."))))
  (test "an unwrapped render is a bare fragment (no doctype), still scoped"
    (let (fragment (docsite/render sample-model {:wrap? false}))
      (refute (includes? fragment "<!doctype html>"))
      (is (includes? fragment "<div class=\"docsite\">"))))
  (test "the fragment stylesheet is namespaced under .docsite"
    (is (includes? (docsite/render-css) ".docsite .def{")))
  ;; The fragment carries the Filter box but not the script that drives it, so an
  ;; embedding host needs both hand-offs. Only `render-css` existed, so the hosted
  ;; reference shipped a search box that accepted typing and did nothing — correct
  ;; HTML, no server-side symptom, invisible to every check but using it.
  (test "an unwrapped fragment ships the filter input, and render-js wires it up"
    (let (fragment (docsite/render sample-model {:wrap? false}))
      (is (includes? fragment "id=\"docsite-filter\""))
      (refute (includes? fragment "<script"))
      (let (js (docsite/render-js))
        (is (includes? js "<script"))
        (is (includes? js "docsite-filter"))
        (is (includes? js "addEventListener")))))
  (test "a wrapped page needs no separate render-js — it inlines the same script"
    (let (html (docsite/render sample-model {}))
      (is (includes? html "id=\"docsite-filter\""))
      (is (includes? html "<script"))))
  ;; Searching a MODULE name used to show its heading with every definition hidden: each
  ;; `.def` had already failed its own text test, so `agent` returned a bare header instead
  ;; of agent's functions. A module-level match must make the whole module a result.
  ;; Verified behaviourally by executing the emitted script against a stub DOM (3 of 3 defs
  ;; shown, against 1 of 3 before); this pins the shape so it cannot silently revert.
  (test "a module-name match shows the module's definitions, not just its heading"
    (let (js (docsite/render-js))
      ;; the module-level verdict, computed before the per-def loop
      (is (includes? js "var whole="))
      ;; …and consulted by it, so a module hit shows every def
      (is (includes? js "whole||hits(d,t)"))
      ;; the sidebar follows the same rule, so nav and content agree
      (is (includes? js "whole||hits(li,t)"))))
  (test "an explicit :title overrides the model name"
    (is (includes? (docsite/render sample-model {:title "Custom"}) "<title>Custom</title>"))))

;; The theming hand-off — the sibling of the `render-js` gap above, and the same shape of
;; failure. `render-css` emitted a hard-coded LIGHT palette and the dark styles were
;; reachable only from the wrapped page, so a `:wrap? false` host could take the light
;; palette or override ~30 selectors by hand. hive did the latter, to put the reference on
;; a dark page. What makes this fixed is not that dark values exist somewhere but that no
;; rule names a colour any more, so redefining a variable cannot be out-voted by a rule.
(describe "docsite: the fragment stylesheet is themeable"
  (test "render-css declares its palette as custom properties on .docsite"
    (let (css (docsite/render-css))
      (is (includes? css ".docsite{--docsite-fg:"))
      (is (includes? css "--docsite-accent:#2563eb"))
      (is (includes? css "--docsite-surface:#f8fafc"))))
  (test "every rule reads a variable rather than a literal"
    (let (css (docsite/render-css))
      (is (includes? css "color:var(--docsite-accent)"))
      (is (includes? css "background:var(--docsite-surface)"))
      (is (includes? css "border:1px solid var(--docsite-border)"))))
  ;; The load-bearing one. A host redefining `--docsite-accent` gets nothing if a rule
  ;; still says `#2563eb`, so the absence of the literal IS the feature — assert it
  ;; directly rather than trusting that the rewrite was complete.
  (test "no colour literal survives in the rules, only in the declarations"
    (let (css (docsite/render-css)
          decls (string/substring css 0 (index-of css "}"))
          rules (string/substring css (+ 1 (index-of css "}"))))
      (is (includes? decls "#2563eb"))
      (refute (includes? rules "#2563eb"))
      (refute (includes? rules "#f8fafc"))
      (refute (includes? rules "#1f2933"))))
  ;; `prefers-color-scheme` is the viewer's OS, which is not the embedding host's theme —
  ;; conflating the two is exactly what painted dark-mode grey onto hive's white page.
  (test "render-css-dark redefines the same names and imposes no media query"
    (let (dark (docsite/render-css-dark))
      (is (includes? dark ".docsite{"))
      (is (includes? dark "--docsite-surface:#12161c"))
      (is (includes? dark "--docsite-fg:#e4e7eb"))
      (refute (includes? dark "prefers-color-scheme"))))
  ;; The standalone page owns its whole background, so it MAY follow the OS — and now does
  ;; it by swapping variables, not by carrying a second copy of the rules that can drift.
  (test "a wrapped page still opts into OS dark, via the variables"
    (let (html (docsite/render sample-model {}))
      (is (includes? html "@media (prefers-color-scheme:dark){.docsite{--docsite-fg:"))))
  ;; Regression: the guide headings were a hard `#1f2933` that the dark block never
  ;; overrode, so a dark standalone page drew near-black headings on a near-black
  ;; background. Routing them through `--docsite-fg` fixes it; this pins that.
  (test "guide headings follow the foreground variable, so OS dark reaches them"
    (is (includes? (docsite/render-css)
          ".docsite .guide-body h1{font-size:1.5rem;margin:1rem 0 .5rem;color:var(--docsite-fg)}"))))

(describe "docsite: guides"
  (test "a guide renders as a section (raw HTML) with a sidebar link"
    (let (html (docsite/render {:name "g" :guides [{:title "Intro" :html "<p>hi</p>"}] :modules []}
                 {}))
      (is (includes? html "id=\"g-Intro\""))
      (is (includes? html "<p>hi</p>"))
      (is (includes? html "href=\"#g-Intro\"")))))

(describe "docsite: namespaces + sections"
  (test "a :qualified? module renders its defs as their qualified call form"
    (let (html (docsite/render {:name "d"
                                :modules [{:module "math"
                                           :qualified? true
                                           :defs [{:name "sqrt" :sig "(sqrt x)"}
                                                   {:name "pi" :sig "pi"}]}]}
                 {:wrap? false}))
      (is (includes? html "(math/sqrt x)"))
      (is (includes? html "math/pi"))))
  (test "a non-:qualified? (prelude-category) module keeps its defs bare"
    (let (html (docsite/render {:name "d"
                                :modules [{:module "Math and numbers"
                                           :qualified? false
                                           :defs [{:name "+" :sig "(+ & xs)"}]}]}
                 {:wrap? false}))
      (is (includes? html "(+ &amp; xs)"))
      (refute (includes? html "Math and numbers/+"))))
  (test ":section renders one top-level doc-section heading per distinct section"
    (let (html (docsite/render {:name "d"
                                :modules [{:module "A"
                                           :section "Core"
                                           :defs [{:name "x" :sig "(x)"}]}
                                           {:module "B"
                                            :section "Core"
                                            :defs [{:name "y" :sig "(y)"}]}
                                           {:module "m"
                                            :section "Library"
                                            :qualified? true
                                            :defs [{:name "z" :sig "(z)"}]}]}
                 {:wrap? false}))
      (is (includes? html "class=\"doc-section\">Core"))
      (is (includes? html "class=\"doc-section\">Library"))
      (is (includes? html "class=\"nav-section\">Core"))))
  (test "a module with no :section renders with no doc-section heading (backward compatible)"
    (let (html (docsite/render {:name "d"
                                :modules [{:module "plain" :defs [{:name "a" :sig "(a)"}]}]}
                 {:wrap? false}))
      (refute (includes? html "doc-section")))))
