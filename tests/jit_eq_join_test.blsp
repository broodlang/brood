;;; Regression guards for the two deopt-thrash mechanisms behind KI-132 — the JIT
;;; latching the syntax highlighter's walk onto the VM. `BROOD_JIT_BAIL_TRACE=1` over one
;;; fontify pass named four helpers `reason=deopt-thrash-latched … deopts=16`, and neither
;;; cause was the one the entry guessed:
;;;
;;;   1. `=` WITH A STRING OPERAND DEOPTED PER ACTIVATION. `eq_dispatch` (jit_lower/emit.rs)
;;;      compared Int×Int and Sym/Keyword identity inline and DEOPTED for every other tag —
;;;      so `hl-head?`'s `(= open "(")` fell out of native code on every call, sixteen
;;;      calls latched the arm `BAILED`, and it ran interpreted for the rest of the process.
;;;      The residual case now calls `brood_rt_equal` — `Heap::equal`, exactly `%eq` — and
;;;      only a lazy seq-view (which needs the evaluator to realise) deopts.
;;;   2. A TYPE-MIXED JOIN WAS AN UNCONDITIONAL DEOPT. A join block's operand-stack params
;;;      are typed by the FIRST edge to reach it; a later edge whose repr disagreed
;;;      (`(or p 7)`: `p` a boxed slot on one edge, a raw int on the other) was compiled as
;;;      a jump to `deopt`, so `hl-advance`'s `(or p (and params? (= n 2)))` deopted on every
;;;      frame where `p` was false. Edges are now deferred (`control::PendingEdge`) and a
;;;      join is typed with every predecessor in hand; a disagreement widens to a spill
;;;      slot holding the tagged value.
;;;
;;; Two kinds of guard here. The VALUE cases pin engine agreement (the suite runs them on
;;; the JIT and the VM); the TIER cases pin that the arm STAYS NATIVE, through
;;; `%jit-arm-state`, because both bugs produced the right answer slowly — a value test
;;; passed against them, which is how KI-132 sat open. Sabotage-verified (2026-09-15):
;;; restoring the deopt in `eq_dispatch`'s residual case fails "string `=` keeps the arm
;;; native" with `:bailed`; restoring the first-edge-wins typing fails every "join" tier
;;; case the same way. The value cases pass either way — they are guards against the fix
;;; ever miscompiling, not reproductions.

(defmodule jit-eq-join-test (:use test))

;; Drive `f` through `batch` until its `argc`-ary arm has settled on a tier (native or
;; latched), or give up after `rounds` batches. Tiering is asynchronous — the background
;; compiler installs the code some calls after the arm went hot — so a fixed call count
;; would be a flake either way.
(defn- settle (f argc batch rounds)
  (batch)
  (let (st (get (%jit-arm-state f argc) :state))
    (if (or (= st :native) (= st :bailed) (= rounds 0))
      st
      (settle f argc batch (- rounds 1)))))

(defn- times (n thunk) (if (= n 0) nil (do (thunk) (times (- n 1) thunk))))

(defn- count-true (f v i acc)
  (if (= i 0) acc (count-true f v (- i 1) (if (f v) (+ acc 1) acc))))

;; --- 1. `=` beyond Int×Int / Sym/Keyword ---------------------------------------------

;; `hl-head?`'s shape: a string compared per activation, an int compared beside it.
(defn ej-streq (v) (let ([open n] v) (and (= open "(") (= n 0))))
(defn ej-str-ne (v) (let ([open n] v) (= open "[")))
(defn ej-float-eq (v) (let ([a b] v) (= a b)))
(defn ej-vec-eq (v) (let ([a b] v) (= a b)))
(defn ej-nil-eq (v) (let ([a b] v) (= a b)))
(defn ej-int-float (v) (let ([a b] v) (= a b)))
(defn ej-kw-str (v) (let ([a b] v) (= a b)))

(describe "JIT `=` on non-scalar operands"
  (test "string `=` computes the same answer as the VM"
    (assert= 3000 (count-true ej-streq ["(" 0] 3000 0))
    (assert= 0 (count-true ej-streq ["[" 0] 3000 0))
    (assert= 0 (count-true ej-streq ["(" 1] 3000 0))
    (assert= 0 (count-true ej-str-ne ["(" 0] 3000 0))
    (assert= 3000 (count-true ej-str-ne ["[" 0] 3000 0)))

  (test "float, vector, nil, mixed-number and keyword-vs-string `=`"
    (assert= 500 (count-true ej-float-eq [1.5 1.5] 500 0))
    (assert= 0 (count-true ej-float-eq [1.5 2.5] 500 0))
    (assert= 500 (count-true ej-vec-eq [[1 [2 "x"]] [1 [2 "x"]]] 500 0))
    (assert= 0 (count-true ej-vec-eq [[1 2] [1 3]] 500 0))
    (assert= 500 (count-true ej-nil-eq [nil nil] 500 0))
    (assert= 0 (count-true ej-nil-eq [nil false] 500 0))
    ;; Whatever `=` says about 1 vs 1.0, native and VM must say the same thing.
    (assert= (if (= 1 1.0) 500 0) (count-true ej-int-float [1 1.0] 500 0))
    (assert= 0 (count-true ej-kw-str [:a "a"] 500 0)))

  (test "string `=` keeps the arm native (was: deopt per activation, latched at 16)"
    (when (%native-tier?)
      (let (st (settle ej-streq 1 (fn () (count-true ej-streq ["(" 0] 4000 0)) 40))
        (assert= :native st)
        (assert= 0 (get (%jit-arm-state ej-streq 1) :deopts))))))

;; --- 2. type-mixed joins -------------------------------------------------------------

;; `hl-advance`'s shape: `(or p X)` with `p` a boxed slot (false on most frames) and `X`
;; a scalar — the two edges into the `or`'s join disagree.
(defn ej-or-bool (v) (let ([open n head p] v) (or p (= n 2))))
(defn ej-or-int (v) (let ([open n head p] v) (or p 7)))
(defn ej-or-nil (v) (let ([open n head p] v) (or head (= n 2))))
;; The join's value flowing on: into a vector, a call argument, a truthiness test.
(defn ej-if-live (c x) (let (r (if c x 7)) [r x]))
(defn ej-if-arg (c) (list (if c "s" 7) 1))
(defn ej-if-truthy (c a b) (if (if c 7 (< a b)) :t :f))
(defn ej-if-eq-true (c a b) (let (t (if c 7 (< a b))) (= t true)))
(defn ej-if-handle (c) (if c [1 2] 7))
(defn ej-nested (p q) (or (and p q) 3))
(defn ej-hl-advance (stack params?)
  (if (empty? stack)
    stack
    (let ([open n head p] (first stack))
      (cons [open (+ n 1) head (or p (and params? (= n 2)))] (rest stack)))))

;; A materialised float on both edges: `param_repr` had no float repr, typed the join `Int`,
;; and `as_int` deopted on the float every time (found while closing the two above).
(defn ej-float-join (x acc) (+ acc (if (< x 0) 0.5 1.5)))
(defn- drive-float (i acc) (if (= i 0) acc (drive-float (- i 1) (ej-float-join (- 5 i) acc))))

;; The OTHER widening: an arm with two non-tail calls reserves block-argument spill slots,
;; so its mixed join widens into the frame (`Slot(spill)`) rather than into extra block
;; params (`Words`). A closure arm, because the profitability gate refuses a named defn of
;; this shape. Verified to take that path by disabling `Words` in the lowering: this still
;; lowers and still computes 111000.
(defn- ej-g (x) (+ x 1))
(defn ej-spill-run (xs flag)
  (reduce xs 0 (fn (acc x) (+ (ej-g x) (ej-g acc) (if (or flag (< x 3)) 1 0)))))
(defn- drive-spill (i acc)
  (if (= i 0) acc (drive-spill (- i 1) (+ acc (ej-spill-run [1 2 3 4 5 6] (= 0 (bit/and i 1)))))))

(defn- drive-advance (i st)
  (if (= i 0) st (drive-advance (- i 1) (ej-hl-advance st true))))

(describe "JIT type-mixed joins"
  (test "`(or p X)` yields the right value on every edge"
    (assert= 3000 (count-true ej-or-bool ["(" 2 nil false] 3000 0))
    (assert= 0 (count-true ej-or-bool ["(" 3 nil false] 3000 0))
    (assert= 3000 (count-true ej-or-bool ["(" 3 nil true] 3000 0))
    (assert= 7 (ej-or-int ["(" 2 nil false]))
    (assert= true (ej-or-int ["(" 2 nil true]))
    (assert= 3000 (count-true ej-or-int ["(" 2 nil false] 3000 0))
    (assert= true (ej-or-nil ["(" 2 nil false]))
    (assert= "h" (ej-or-nil ["(" 3 "h" false]))
    (assert= false (ej-or-nil ["(" 3 nil false])))

  (test "a widened join never clobbers a live local, and its value flows on intact"
    (times 2000 (fn () (ej-if-live true "x") (ej-if-live false "x")))
    (assert= ["x" "x"] (ej-if-live true "x"))
    (assert= [7 "x"] (ej-if-live false "x"))
    (assert= (list "s" 1) (ej-if-arg true))
    (assert= (list 7 1) (ej-if-arg false))
    (times 2000 (fn () (ej-if-truthy true 1 2) (ej-if-truthy false 1 2) (ej-if-truthy false 2 1)))
    (assert= :t (ej-if-truthy true 1 2))
    (assert= :t (ej-if-truthy false 1 2))
    (assert= :f (ej-if-truthy false 2 1))
    (times 2000 (fn () (ej-if-eq-true true 1 2) (ej-if-eq-true false 1 2)))
    (assert= false (ej-if-eq-true true 1 2))
    (assert= true (ej-if-eq-true false 1 2))
    (assert= false (ej-if-eq-true false 2 1))
    (times 2000 (fn () (ej-if-handle true) (ej-if-handle false)))
    (assert= [1 2] (ej-if-handle true))
    (assert= 7 (ej-if-handle false))
    (times 2000 (fn () (ej-nested true 5) (ej-nested false 5) (ej-nested true false)))
    (assert= 5 (ej-nested true 5))
    (assert= 3 (ej-nested false 5))
    (assert= 3 (ej-nested true false)))

  (test "a mixed join in a two-call arm (widened into the spill slot)"
    (assert= 111000 (drive-spill 3000 0)))

  (test "a float on both edges of a join"
    ;; 19 995 halves and five 1.5s — every term a multiple of 0.5, so the sum is exact.
    (assert= 10005.0 (drive-float 20000 0.0)))

  (test "the highlighter walk's frame advance"
    (let (st (drive-advance 3000 (list ["(" 0 nil false])))
      (assert= ["(" 3000 nil true] (first st))))

  (test "`(or p X)` keeps the arm native (was: the second edge deopted, latched at 16)"
    (when (%native-tier?)
      (assert= :native
        (settle ej-or-bool 1 (fn () (count-true ej-or-bool ["(" 2 nil false] 4000 0)) 40))
      (assert= :native
        (settle ej-or-int 1 (fn () (count-true ej-or-int ["(" 2 nil false] 4000 0)) 40))
      (assert= :native
        (settle ej-if-truthy 3 (fn () (times 4000 (fn () (ej-if-truthy false 1 2)))) 40))
      (assert= :native
        (settle ej-hl-advance 2 (fn () (drive-advance 4000 (list ["(" 0 nil false]))) 40))
      (assert= :native (settle ej-float-join 2 (fn () (drive-float 4000 0.0)) 40)))))

;; --- 3. `first`/`rest` beyond pairs ---------------------------------------------------

;; The inline `first`/`rest` tag-checked for a pair and DEOPTED for anything else — the
;; same class as `=` above: `second` (`(first (rest x))`) over a vector deopted per
;; activation and was latched on `http`. The non-pair path now calls
;; `brood_rt_first`/`_rest`, which answer nil / vector / range / bytes / set and the type
;; error, and deopt only for a record or a seq-view.
;; One test hands it "abc" ON PURPOSE (the type error must be the VM's from native code),
;; and the checker reads that site into `v`.
(check-allow :type-mismatch
  (defn ej-second (v) (second v)))
(defn ej-first-range (r) (first r))
(defn ej-rest-vec-sum (v) (+ (first (rest v)) (first (rest (rest v)))))
;; `rest` of a vector ALLOCATES a list, which can grow the pair slab and move its base —
;; and this arm (no call, no cons) hoists the pair-slab bases at entry. Reading the LOCAL
;; pair `p` after the fallback must go through the re-fetched base: without that this
;; shape read through a stale pointer and segfaulted while it was being built.
(defn ej-rest-then-pair (v p) (if (first (rest v)) (first p) 0))
(defn- drive-rest-pair (i acc)
  (if (= i 0)
    acc
    (drive-rest-pair (- i 1) (+ acc (ej-rest-then-pair [1 2 3] (list (+ i 1) 9))))))

(describe "JIT `first`/`rest` beyond pairs"
  (test "second / first / rest on vectors, ranges and nil"
    (assert= 2 (ej-second [1 2 3]))
    (assert= 2 (ej-second (list 1 2 3)))
    (assert= nil (ej-second [1]))
    (assert= nil (ej-second nil))
    (assert= 5 (ej-first-range (range 5 9)))
    (assert= 5 (ej-rest-vec-sum [1 2 3]))
    (assert= 5 (ej-rest-vec-sum (list 1 2 3)))
    (times 3000 (fn () (ej-second [1 2 3]) (ej-first-range (range 5 9)) (ej-rest-vec-sum [1 2 3])))
    (assert= 2 (ej-second [1 2 3]))
    (assert= 5 (ej-rest-vec-sum [1 2 3])))

  (test "the type error is the VM's, from native code too"
    (times 3000 (fn () (ej-second [1 2 3])))
    ;; `second` is `(first (rest x))`, so the error that fires is `rest`'s.
    (is (includes? (or (error-of (ej-second "abc")) "") "rest: expected")))

  (test "a local pair read after a `rest`-of-vector fallback (hoisted pair bases)"
    ;; sum over i of (i+1) for i = 1..3000 = 3000*3001/2 + 3000
    (assert= 4504500 (drive-rest-pair 3000 0)))

  (test "`second` of a vector keeps the arm native (was: deopt per activation, latched)"
    (when (%native-tier?)
      ;; `second` itself — the prelude arm that latched on `http`; `ej-second` is a
      ;; one-call forwarder to it and never becomes the hot arm.
      (assert= :native (settle second 1 (fn () (times 4000 (fn () (ej-second [1 2 3])))) 40))
      (assert= :native (settle ej-rest-then-pair 2 (fn () (drive-rest-pair 4000 0)) 40)))))

;; --- 4. `empty?` beyond nil / pair -----------------------------------------------------

;; The inline `empty?` tag-checked for nil or a pair and DEOPTED for anything else — so
;; every prelude loop of the shape `(cond (empty? coll) … (first coll) … (rest coll))`
;; deopted AT ENTRY on each activation handed a vector, a string, a set or bytes, and ran
;; its whole scan on the VM. `json`'s `needs-escape?` is `(any? (string/->codepoints s)
;; …)`: 7 910 entry deopts per encode, and nothing latched it, because a `SelfCall` arm is
;; never deopt-watched — which is also why `:deopts` (the feedback's consecutive count)
;; reads 0 for it and only `:deopts-total` can see this class. The non-nil/non-pair path
;; now calls `brood_rt_is_empty`, which sizes a vector / string / set / bytes / range /
;; rope / table itself and deopts only for a map or a seq-view.
(def ej-cps (string/->codepoints "a plain ascii string, nothing to escape"))
(defn- ej-any-ctrl? (v) (any? v (fn (c) (< c 32))))
(defn- ej-every-small? (v) (every? v (fn (c) (< c 128))))
(defn- ej-empty-str (s) (empty? s))
(defn- ej-empty-set (s) (empty? s))
(defn- ej-empty-bytes (b) (empty? b))
(defn- drive-any (i acc)
  (if (= i 0) acc (drive-any (- i 1) (if (ej-any-ctrl? ej-cps) acc (+ acc 1)))))

(describe "JIT `empty?` beyond nil and pairs"
  (test "empty? on strings, sets, bytes, vectors and ranges computes the VM's answer"
    (times 3000
      (fn ()
        (ej-empty-str "")
        (ej-empty-str "x")
        (ej-empty-set #{})
        (ej-empty-set #{1})
        (ej-empty-bytes (bytes))
        (ej-empty-bytes (bytes 1))))
    (assert= true (ej-empty-str ""))
    (assert= false (ej-empty-str "x"))
    (assert= true (ej-empty-set #{}))
    (assert= false (ej-empty-set #{1}))
    (assert= true (ej-empty-bytes (bytes)))
    (assert= false (ej-empty-bytes (bytes 1)))
    (assert= false (ej-any-ctrl? ej-cps))
    (assert= true (ej-every-small? ej-cps))
    (assert= false (ej-any-ctrl? [65 66]))
    (assert= false (ej-any-ctrl? []))
    (assert= true (ej-every-small? [])))

  (test "`any?` over a vector keeps the arm native with NO entry deopts (was: one per call)"
    (when (%native-tier?)
      (assert= 4000 (drive-any 4000 0))
      (assert= :native (settle any? 2 (fn () (drive-any 4000 0)) 40))
      ;; `:deopts` is the feedback's and never moves for a `SelfCall` loop; the class
      ;; this guards is only visible in the cumulative count (sabotage: deopt a vector in
      ;; `is_empty_without_eval` → ~20 000 here, `:deopts` still 0).
      (assert= 0 (get (%jit-arm-state any? 2) :deopts-total)))))

;; --- 5. A polymorphic param on a `SelfCall` arm ---------------------------------------

;; The tier-time profile is ONE activation's snapshot of the frame. An arm whose param is
;; sometimes an int and sometimes not, sampled on an int, register-carries the slot as an
;; i64 and deopts AT ENTRY (reason 106) on every activation that hands it anything else —
;; `json/emit (v acc)` sampled with `v = 1` deopted on every map, 4 819 times per `json`
;; row, forever: a `SelfCall` arm has no deopt feedback (a loop's deopt normally follows
;; productive iterations, so counting activations would mis-bail it). Now every deopt
;; feeds `jit_any_deopt_feedback`: sixteen entry-tag deopts mark the slot polymorphic and
;; reset the arm, and it re-tiers with that slot boxed — one recompile, never a bail, and
;; the compile thread's dedupe and the shared code cache both know not to hand the old
;; code back (both did, in the first cut).
(defn ej-poly (v acc)
  (if (int? v)
    (+ acc v)
    (if (empty? v) acc (ej-poly (first v) (+ acc 1)))))
;; 31 int activations per list activation, so the profile almost surely samples an int.
(defn- drive-poly (i acc)
  (if (= i 0)
    acc
    (drive-poly (- i 1)
      (+ acc (ej-poly (if (= (math/rem i 32) 0) (list 7) i) 0)))))

(describe "JIT polymorphic param on a self-tail arm"
  (test "the answer is the VM's throughout"
    (assert= 2 (ej-poly (list 1) 0))
    (assert= 5 (ej-poly 5 0))
    (assert= 0 (ej-poly nil 0)))

  (test "sixteen entry deopts re-lower the arm with the slot boxed (was: one per call, forever)"
    (when (%native-tier?)
      (drive-poly 4000 0)
      (assert= :native (settle ej-poly 2 (fn () (drive-poly 4000 0)) 40))
      (drive-poly 20000 0)
      (let (st (%jit-arm-state ej-poly 2))
        (assert= :native (get st :state))
        ;; At most the sixteen that earned the re-lowering; the 600+ list activations
        ;; after it run the boxed native. (Sabotage: never reset the arm → hundreds.)
        (is (<= (get st :deopts-total) 16))))))

;; --- 6. A float-carrying self-tail loop with a non-tail call lowers (§7.9) ---------------

;; `plan_general_lowering` used to refuse a named self-tail arm with non-tail calls whenever
;; its profile showed a `Float` param — `mandelbrot`'s `row-sum`, the one arm in the corpus
;; the clause reached. The premise (its floats arrive boxed from a thrash-latched callee)
;; ended with KI-109; the clause is gone, and `BROOD_FLOAT_VETO=1` restores it (sabotage:
;; run this file under it and this test reads `:bailed`).
(defn ej-scale (x) (* x 1.5))
(defn ej-float-loop (i y0 acc)
  (if (>= i 200) acc (ej-float-loop (+ i 1) y0 (+ acc (ej-scale y0)))))

(describe "JIT admits a float-carrying self-tail loop with a non-tail call"
  (test "the answer is the VM's"
    (assert= 300.0 (ej-float-loop 0 1.0 0.0)))

  (test "the arm lowers (was: refused as call-mediated-boxed for its float slot)"
    (when (%native-tier?)
      (assert= :native
        (settle ej-float-loop 3 (fn () (times 40 (fn () (ej-float-loop 0 1.0 0.0)))) 40)))))
