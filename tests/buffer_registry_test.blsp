;; editor/buffer-registry — the named directory of buffer processes (a second frame, a
;; remote session and a mirror share one buffer set through it).
(defmodule buffer-registry-test
  (:use test)
  (:use editor/buffer)
  (:use editor/buffer-server)
  (:use editor/buffer-registry)
  (:use-internals editor/buffer-registry))

(defn- drain (acc)
  "Every `[:registry-…]` notification already in the mailbox, oldest first."
  (receive
    ([:registry-added k _n _p meta] (drain (cons [:added k meta] acc)))
    ([:registry-renamed old k n meta] (drain (cons [:renamed old k n] acc)))
    ([:registry-removed k why] (drain (cons [:removed k why] acc)))
    (after 0 (reverse acc))))

(describe "buffer-registry"
  (test "the first share spawns the process, later ones get the same pid, entries list it"
    (let (reg (registry-start)
          a (registry-share reg "notes" "hello" {:file "/tmp/notes" :type :text})
          b (registry-share reg "notes" "IGNORED" {:file "/tmp/notes" :type :text}))
      (is (pid? a))
      (assert= a b)
      ;; the process holds the FIRST text
      (assert= (buffer-query a buffer-text) "hello")
      (let (entries (registry-entries reg))
        (assert= (count entries) 1)
        (assert= (:name (first entries)) "notes")
        (assert= (:key (first entries)) "/tmp/notes")
        (assert= (:proc (first entries)) a)
        (assert= (map/get-in (first entries) [:meta :type]) :text))
      (registry-stop reg)))
  (test "a watcher is told of every share and remove; remove stops the process"
    (let (reg (registry-start))
      (registry-watch reg (self))
      (let (a (registry-share reg "a" "" {})
            _ (registry-share reg "b" "" {})
            _ (registry-share reg "a" "" {}))
        ; a repeat share announces nothing
        (registry-remove reg "a")
        ;; the round-trips above are barriers: every notification is queued by now
        (assert= (drain '()) (list [:added "a" {}] [:added "b" {}] [:removed "a" :killed]))
        (assert= (map (registry-entries reg) :name) (list "b"))
        (assert= (registry-remove reg "nope") nil)
        ;; the removed process is gone: an edit reaches nobody
        (is (nil? (proc/info a))) ; stopped: no 2 s stop-buffer timeout
        (registry-unwatch reg (self))
        (registry-remove reg "b")
        (assert= (registry-entries reg) []) ; barrier
        (assert= (drain '()) (list))) ; unwatched: no :removed for b
      (registry-stop reg)))
  (test "a process that dies is dropped and announced :died; a re-share spawns afresh"
    (let (reg (registry-start))
      (registry-watch reg (self))
      (let (a (registry-share reg "x" "text" {}))
        (exit a :kill)
        ;; the registry learns of the death through its monitor (a third process) and
        ;; announces the drop to its watchers
        (assert= :died (receive ([:registry-removed "x" why] why) (after test/*wait-ms* :timeout)))
        (assert= (registry-entries reg) [])
        (let (b (registry-share reg "x" "text again" {}))
          (is (not (= a b)))
          (assert= (buffer-query b buffer-text) "text again")
          (assert= (drain '()) (list [:added "x" {}] [:added "x" {}]))))
      (registry-stop reg)))
  (test "registry-stop ends every process and answers the count"
    (let (reg (registry-start)
          a (registry-share reg "p" "" {})
          b (registry-share reg "q" "" {}))
      (assert= (registry-stop reg) 2)
      (is (nil? (proc/info a))) ; stopped: no 2 s stop-buffer timeout
      (is (nil? (proc/info b))))))

(describe "buffer-registry — a re-share that outruns the death notice"
  (test "sharing a name whose process is dead spawns afresh even before the [:down] is folded"
    (let (reg (registry-start)
          a (registry-share reg "x" "text" {}))
      ;; kill, and re-share as soon as the process is GONE: `exit` is a signal (the victim
      ;; dies at its next reduction tick), so wait for that — bounded — rather than racing
      ;; it; the registry's own [:down] for the death may still be queued, which is the case
      (let (a-monitor (monitor a))
        (exit a :kill)
        (receive ([:down ^a-monitor ^a _] :ok) (after test/*wait-ms* :timeout)))
      (is (nil? (proc/info a)))
      (let (b (registry-share reg "x" "again" {}))
        (is (not (= a b)))
        (is (not (nil? (proc/info b))))
        (assert= (buffer-query b buffer-text) "again"))
      (registry-stop reg))))

(describe "buffer-registry — a document is its file, not its name"
  (test "two files with the same display name are two processes"
    (let (reg (registry-start)
          a (registry-share reg "README.md" "project a" {:file "/a/README.md"})
          b (registry-share reg "README.md" "project b" {:file "/b/README.md"}))
      (is (not (= a b)))
      (assert= (buffer-query a buffer-text) "project a")
      (assert= (buffer-query b buffer-text) "project b")
      (assert= (count (registry-entries reg)) 2)
      (registry-stop reg)))
  (test "a buffer with no file is keyed by its name"
    (let (reg (registry-start)
          a (registry-share reg "*scratch*" "" {})
          b (registry-share reg "*scratch*" "other" {}))
      (assert= a b)
      (assert= (map (registry-entries reg) :key) (list "*scratch*"))
      (registry-stop reg)))
  (test "rekey follows a write to another file, keeps the process, and tells watchers"
    (let (reg (registry-start))
      (registry-watch reg (self))
      (let (a (registry-share reg "a.txt" "x" {:file "/p/a.txt"})
            k (registry-rekey reg "/p/a.txt" "b.txt" {:file "/p/b.txt"}))
        (assert= k "/p/b.txt")
        (assert= (map (registry-entries reg) :key) (list "/p/b.txt"))
        (assert= (:name (first (registry-entries reg))) "b.txt")
        ;; the old identity is free again, the new one is the same process
        (assert= (registry-share reg "b.txt" "" {:file "/p/b.txt"}) a)
        (is (not (= (registry-share reg "a.txt" "" {:file "/p/a.txt"}) a)))
        (assert= (take (drain '()) 2)
          (list [:added "/p/a.txt" {:file "/p/a.txt"}] [:renamed "/p/a.txt" "/p/b.txt" "b.txt"])))
      (registry-stop reg)))
  (test "rekey onto a live document's identity is refused; an unknown key answers nil"
    (let (reg (registry-start)
          _ (registry-share reg "a" "" {:file "/a"})
          _ (registry-share reg "b" "" {:file "/b"}))
      (assert= (registry-rekey reg "/a" "b" {:file "/b"}) :taken)
      (assert= (registry-rekey reg "/nope" "c" {:file "/c"}) nil)
      (assert= (count (registry-entries reg)) 2)
      (registry-stop reg))))

;; `{:mirror true}`: the registry keeps every document's text, folded from the process's own
;; pushes, and a process that dies comes back from it under the same key. Barriers, not
;; sleeps: a `buffer-query` returns once the process has handled our edit (and so queued its
;; push to the registry), and a `registry-share` returns once the registry has folded
;; everything before it. Only the runtime's `[:down]` cannot be ordered against anything we
;; send, so the respawn is awaited on the watcher notice that announces it.
(defn- await-added (key)
  (receive ([:registry-added ^key _ p _] p) (after test/*wait-ms* :timeout)))

(describe "buffer-registry with a mirror"
  (test "a process that dies is respawned from the mirror, every acknowledged edit kept"
    (let (reg (registry-start {:mirror true})
          p1 (registry-share reg "doc" "seed" {:file "/tmp/mirror-doc"}))
      (registry-watch reg (self))
      (buffer-splice p1 4 4 "+more" :someone)
      (assert= (buffer-query p1 buffer-text) "seed+more")
      (registry-share reg "doc" "ignored" {:file "/tmp/mirror-doc"}) ; the registry folded it
      (exit p1 :kill)
      (assert= :died
        (receive ([:registry-removed "/tmp/mirror-doc" why] why) (after test/*wait-ms* :timeout)))
      (let (p2 (await-added "/tmp/mirror-doc"))
        (is (pid? p2))
        (is (not (= p1 p2)))
        (assert= (buffer-query p2 buffer-text) "seed+more")
        (assert= p2 (registry-share reg "doc" "stale-local" {:file "/tmp/mirror-doc"})))
      (registry-stop reg)))
  (test "edits on the respawned process keep folding into the mirror"
    (let (reg (registry-start {:mirror true})
          p1 (registry-share reg "doc" "a" {}))
      (registry-watch reg (self))
      (exit p1 :kill)
      (let (p2 (await-added "doc"))
        (buffer-splice p2 1 1 "b" :someone)
        (assert= (buffer-query p2 buffer-text) "ab")
        (registry-share reg "doc" "" {})
        (exit p2 :kill)
        (assert= (buffer-query (await-added "doc") buffer-text) "ab"))
      (registry-stop reg)))
  (test "a removed document is not respawned"
    (let (reg (registry-start {:mirror true})
          _ (registry-share reg "gone" "x" {}))
      (registry-remove reg "gone")
      (assert= (registry-entries reg) [])
      (registry-stop reg)))
  (test "without the option nothing changes: a died process is dropped, not respawned"
    (let (reg (registry-start)
          p1 (registry-share reg "plain" "x" {}))
      (registry-watch reg (self))
      (exit p1 :kill)
      (assert= :died
        (receive ([:registry-removed "plain" why] why) (after test/*wait-ms* :timeout)))
      (assert= (registry-entries reg) [])
      (registry-stop reg))))

;; ADR-579: a document's text properties (a program's colours) are part of it — shared from
;; a holder's copy, kept by the mirror, given back by a respawn.
(describe "buffer-registry — text properties are part of the document"
  (test "a document shared with properties starts its process with them"
    (let (reg (registry-start)
          p (registry-share reg "log" {:text "ok\n" :properties {:ansi [[0 2 {:fg 2}]]}} {}))
      (assert= (buffer-query p (fn (b) (buffer-properties b :ansi))) [[0 2 {:fg 2}]])
      (registry-stop reg)))
  (test "a respawn from the mirror keeps the properties an append brought"
    (let (reg (registry-start {:mirror true})
          p1 (registry-share reg "out" "$ make\n" {}))
      (registry-watch reg (self))
      (buffer-splice p1 7 7 "ERROR\n" :someone nil {:ansi [[0 5 {:fg 1}]]})
      (buffer-query p1 buffer-text) ; a barrier: the push is on its way to the registry
      (registry-share reg "out" "" {}) ; and a second: the registry folded it
      (exit p1 :kill)
      (let (p2 (await-added "out"))
        (assert= (buffer-query p2 buffer-text) "$ make\nERROR\n")
        (assert= (buffer-query p2 (fn (b) (buffer-properties b :ansi))) [[7 12 {:fg 1}]]))
      (registry-stop reg))))

;; ADR-579: a property change reaches the mirror as one, so a respawn keeps it.
(describe "buffer-registry — the mirror takes a property change"
  (test "a respawn from the mirror keeps properties put on text already there"
    (let (reg (registry-start {:mirror true})
          p1 (registry-share reg "out" "ERROR\n" {}))
      (registry-watch reg (self))
      (buffer-splice p1 0 0 "" :someone nil [:put-properties 5 {:ansi [[0 5 {:fg 1}]]}])
      (buffer-query p1 buffer-text) ; a barrier: the push is on its way to the registry
      (registry-share reg "out" "" {}) ; and a second: the registry folded it
      (exit p1 :kill)
      (let (p2 (await-added "out"))
        (assert= (buffer-query p2 buffer-text) "ERROR\n")
        (assert= (buffer-query p2 (fn (b) (buffer-properties b :ansi))) [[0 5 {:fg 1}]]))
      (registry-stop reg))))

;; ADR-593: a registry owned by a process lives as long as it does — one per served
;; session, owned by the session that outlives its loop, ends with the session.
(describe "buffer-registry — an owner's lifetime"
  (test "the registry outlives a holder but not its owner: the owner's end stops every document"
    (let (owner (spawn (receive (:go nil)))
          reg (registry-start {:owner owner})
          watch-registry (monitor reg)
          holder (spawn (registry-share reg "notes" "kept" {:file "/tmp/owned-notes"}))
          watch-holder (monitor holder))
      ;; the holder (a session's loop) ends; its document does not
      (receive ([:down ^watch-holder _ _] nil) (after test/*wait-ms* nil))
      (let (entries (registry-entries reg)
            proc (:proc (first entries))
            watch-proc (monitor proc))
        (assert= (count entries) 1)
        (assert= (buffer-query proc buffer-text) "kept")
        ;; the owner (the session) ends: the registry and the document go with it
        (send owner :go)
        (assert= (receive ([:down ^watch-registry _ _] :ended) (after test/*wait-ms* :alive))
          :ended)
        (assert= (receive ([:down ^watch-proc _ _] :stopped) (after test/*wait-ms* :alive))
          :stopped))))
  (test "an owner already gone ends the registry at once"
    (let (owner (spawn nil)
          watch-owner (monitor owner))
      (receive ([:down ^watch-owner _ _] nil) (after test/*wait-ms* nil))
      (let (reg (registry-start {:owner owner})
            watch-registry (monitor reg))
        (assert= (receive ([:down ^watch-registry _ _] :ended) (after test/*wait-ms* :alive))
          :ended))))
  (test "without an owner the registry lives until it is stopped"
    (let (owner (spawn (receive (:go nil)))
          reg (registry-start)
          watch-registry (monitor reg))
      (send owner :go)
      (assert= (receive ([:down ^watch-registry _ _] :ended) (after 200 :alive)) :alive)
      (registry-stop reg))))

(describe "buffer-registry — a watcher that ends is dropped (ADR-605)"
  (test "each restarted loop that watches leaves no dead pid behind"
    ;; a served session's loop watches its registry; one that dies is restarted under a new
    ;; pid and watches again — the dead one must not stay a watcher for the session's life
    (let (reg (registry-start)
          first-loop (spawn (receive (:stop nil)))
          watch-first (monitor first-loop)
          next-loop (spawn (receive (:stop nil))))
      (registry-watch reg first-loop)
      (registry-watch reg next-loop)
      (registry-watch reg next-loop)
      (assert= (into #{} (editor/buffer-registry/registry-watchers reg)) #{first-loop next-loop})
      (exit first-loop :kill)
      (receive ([:down ^watch-first _ _] nil) (after test/*wait-ms* nil))
      ;; the registry folds the death before the call that follows it (FIFO behind the monitor)
      (letrec (await-dropped (fn (left)
                               (let (watchers (editor/buffer-registry/registry-watchers reg))
                                 (if (or (= watchers [next-loop]) (<= left 0))
                                   watchers
                                   (receive (after 10 (await-dropped (dec left))))))))
        (assert= (await-dropped 100) [next-loop]))
      ;; and an unwatch stops its monitor too: its end is no message the registry acts on
      (registry-unwatch reg next-loop)
      (assert= (editor/buffer-registry/registry-watchers reg) [])
      (send next-loop :stop)
      (registry-stop reg))))
