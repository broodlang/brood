;; std/layers — composable behaviour layers (Phase 1: the buffer-free core).
;; Register-only — run by `nest test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule layers-test (:use test) (:use editor/keymap) (:use editor/layers))

;; ---- fixtures: commands, hooks, and layers (def'd globals, by qualified symbol) ----
;; A test context is a map {:log <string> :layers <list>}; commands/hooks append to
;; :log so the path through dispatch/hooks is visible.
; layers-test/cmd-x
(defn cmd-x (s k) (assoc s :log (str (get s :log) "X")))
(defn cmd-y (s k) (assoc s :log (str (get s :log) "Y")))

(defn hk-a-on (s) (assoc s :log (str (get s :log) "[a-on]")))
(defn hk-a-off (s) (assoc s :log (str (get s :log) "[a-off]")))
(defn hk-b-on (s) (assoc s :log (str (get s :log) "[b-on]")))
(defn hk-focus (s) (assoc s :log (str (get s :log) "F")))
(defn hk-boom (s) (throw "boom"))

(def layer-a
  {:name 'a
   :keymap (keymap-bind {} ["x"] 'layers-test/cmd-x)
   :hooks {:activate '(layers-test/hk-a-on)
           :deactivate '(layers-test/hk-a-off)
           :on-focus '(layers-test/hk-focus)}})
(def layer-b
  {:name 'b
   :keymap (keymap-bind {} ["y"] 'layers-test/cmd-y)
   :hooks {:activate '(layers-test/hk-b-on) :on-focus '(layers-test/hk-focus)}})
; binds x→Y
(def layer-hi {:name 'hi :keymap (keymap-bind {} ["x"] 'layers-test/cmd-y)})
(def layer-boom {:name 'boom :hooks {:activate '(layers-test/hk-boom)}})
(def layer-chord {:name 'chord :keymap (keymap-bind {} [:ctrl-x :ctrl-e] 'layers-test/cmd-x)})

; a no-op fallback
(defn no-fb (s k) s)
;; ---- collection & precedence ------------------------------------------------
(describe "layer-collect & precedence"
  (test "collects a facet from active layers, highest-precedence (head) first"
    (let (ctx (push-layer (push-layer {:log ""} 'layers-test/layer-a) 'layers-test/layer-hi))
      ;; pushed a, then hi → hi is the head (highest precedence)
      (assert= (map (layer-collect ctx :keymap) (fn (km) (get km "x")))
        (list 'layers-test/cmd-y 'layers-test/cmd-x))))
  (test "layers lacking the facet are dropped"
    (let (ctx (push-layer {:log ""} 'layers-test/layer-boom))
      ; boom has no :keymap
      (is (empty? (layer-collect ctx :keymap))))))

;; ---- stack ops --------------------------------------------------------------
(describe "stack ops"
  (test "push / active? / remove by :name"
    (let (ctx (push-layer {:log ""} 'layers-test/layer-a))
      (is (layer-active? ctx 'a))
      (is (not (layer-active? ctx 'b)))
      (is (not (layer-active? (remove-layer ctx 'a) 'a))))))

;; ---- lifecycle hooks --------------------------------------------------------
(describe "activate / deactivate"
  (test "activate-layer runs the layer's :activate hooks"
    (assert= (get (activate-layer {:log ""} 'layers-test/layer-a) :log) "[a-on]"))

  (test "activate-layer fires only the new layer's :activate, not already-active ones"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-a))
      ; [a-on]
      (assert= (get (activate-layer ctx 'layers-test/layer-b) :log) "[a-on][b-on]")))

  (test "deactivate-layer runs :deactivate then removes"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-a)
          ctx2 (deactivate-layer ctx 'a))
      (assert= (get ctx2 :log) "[a-on][a-off]")
      (is (not (layer-active? ctx2 'a)))))

  (test "deactivate of an inactive name is a no-op"
    (assert= (deactivate-layer {:log ""} 'nope) {:log ""}))

  (test "a throwing hook is isolated — state unchanged, layer still on"
    (let (ctx (activate-layer {:log "keep"} 'layers-test/layer-boom))
      (assert= (get ctx :log) "keep")
      (is (layer-active? ctx 'boom))))

  (test "replace-base-layer deactivates the old base and activates the new"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-a)
          ctx2 (replace-base-layer ctx 'layers-test/layer-b))
      (assert= (get ctx2 :log) "[a-on][a-off][b-on]")
      (is (layer-active? ctx2 'b))
      (is (not (layer-active? ctx2 'a))))))

;; ---- fanned events ----------------------------------------------------------
(describe "run-event (fanned across active layers)"
  (test "fans an event across every active layer, highest precedence first"
    (let (ctx (activate-layer (activate-layer {:log ""} 'layers-test/layer-a) 'layers-test/layer-b))
      ;; both a and b handle :on-focus → hk-focus appends F, once per layer
      (assert= (get (run-event ctx :on-focus) :log) "[a-on][b-on]FF")))
  (test "no-op when no active layer handles the event"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-a))
      (assert= (run-event ctx :on-blur) ctx))))

;; ---- keymap composition + dispatch ------------------------------------------
(describe "active-keymap & layer-dispatch"
  ; hi (head) wins
  (test "active-keymap merges layers with the head winning"
    (let (ctx (push-layer (push-layer {:log ""} 'layers-test/layer-a) 'layers-test/layer-hi))
      (assert= (get (active-keymap ctx) "x") 'layers-test/cmd-y)))
  (test "layer-dispatch resolves through the layers and runs the command"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-a)
          r (layer-dispatch ctx nil "x" no-fb))
      (assert= (get (first r) :log) "[a-on]X")
      (assert= (second r) nil)))

  (test "an unbound key falls through to the fallback"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-a)
          r (layer-dispatch ctx nil "z" (fn (s _) (assoc s :log (str (get s :log) "?")))))
      (assert= (get (first r) :log) "[a-on]?")))

  (test "a chord living in a layer dispatches across two keystrokes"
    (let (ctx (push-layer {:log ""} 'layers-test/layer-chord)
          r1 (layer-dispatch ctx nil :ctrl-x no-fb))
      ; pending sub-keymap
      (assert= (second r1) {:ctrl-e 'layers-test/cmd-x})
      (let (r2 (layer-dispatch (first r1) (second r1) :ctrl-e no-fb))
        (assert= (get (first r2) :log) "X")
        (assert= (second r2) nil)))))

;; ---- across processes -------------------------------------------------------
;; Layers and commands are shared code (def'd globals), resolved by symbol, so the
;; whole machinery works off the root process.
(defn lt-worker (parent)
  (let (ctx (activate-layer {:log ""} 'layers-test/layer-a)
        r (layer-dispatch ctx nil "x" layers-test/no-fb))
    (send parent (get (first r) :log))))

(describe "layers across processes"
  :isolated (test "activate + dispatch resolve and run inside a spawned process"
    (let (me (self))
      (spawn (lt-worker me))
      (assert= (receive) "[a-on]X"))))

;; ---- Phase 2: buffer-type binding -------------------------------------------
;; :isolated so register-* (which rebinds the global registries) can't leak into
;; other test files; unique :type keys keep tests independent within the block too.
(describe "buffer-type binding"
  :isolated (test "register-type-layers / layers-for-type round-trip"
    (register-type-layers :t-rt (list 'layers-test/layer-a 'layers-test/layer-b))
    (assert= (layers-for-type :t-rt) (list 'layers-test/layer-a 'layers-test/layer-b))
    (is (empty? (layers-for-type :t-missing))))

  (test "REGRESSION: the registries survive a module RE-LOAD (defonce, not def)"
    ;; A registered type/file-rule must not be wiped when this module re-runs its own
    ;; registry defs — the case an IMAGED start hits (ADR-218): the image restores the
    ;; registries' values in the root section, then a project module's `(:use
    ;; editor/layers)` re-loads this std file from its EMBEDDED source. A plain `(def
    ;; *type-layers* {})` there dropped every deferred module's type; `defonce` keeps it.
    (register-type-layers :t-reload (list 'layers-test/layer-a))
    (register-file-type ".reload-ext" :t-reload-ext)
    (is (not (empty? (layers-for-type :t-reload))))
    ;; Re-run editor/layers's ACTUAL embedded source — exactly what `%require-force-in`
    ;; does for an imaged `(:use editor/layers)`. With `def` this reset the registries to
    ;; empty; the assertions below fail unless the defs are `defonce`.
    (%load-module-source (or (%builtin-module "editor/layers")
                           (error "layers-test: no module source"))
      (%builtin-module-file "editor/layers"))
    (is (not (empty? (layers-for-type :t-reload)))) ; the type survived the reload
    (assert= (buffer-type-for {:file "x.reload-ext"}) :t-reload-ext)) ; and the file rule
  (test "buffer-type-for matches a filename suffix"
    (register-file-type ".foo" :t-foo)
    (assert= (buffer-type-for {:file "x.foo"}) :t-foo))

  (test "buffer-type-for matches a predicate spec"
    (register-file-type (fn (f) (= f "Makefile")) :t-make)
    (assert= (buffer-type-for {:file "Makefile"}) :t-make))

  (test "most-recently-registered rule wins (first match, newest-first)"
    (register-file-type ".bar" :t-bar1)
    (register-file-type ".bar" :t-bar2)
    (assert= (buffer-type-for {:file "x.bar"}) :t-bar2))

  (test "no file → explicit :type, else :fundamental"
    (assert= (buffer-type-for {:type :special}) :special)
    (assert= (buffer-type-for {}) :fundamental))

  (test "a file with no matching rule and no :type → :fundamental"
    (assert= (buffer-type-for {:file "x.no-such-ext"}) :fundamental))

  (test "set-buffer-type sets :type without seeding layers"
    (let (b (set-buffer-type {} :special))
      (assert= (get b :type) :special)
      (is (nil? (get b :layers)))))

  (test "init-buffer-layers seeds layers in registry order, activating base-first"
    (register-type-layers :t-init (list 'layers-test/layer-a 'layers-test/layer-b))
    (let (b (init-buffer-layers (set-buffer-type {:log ""} :t-init)))
      (assert= (get b :type) :t-init)
      ;; registry order preserved (layer-a head/highest, layer-b base/last)…
      (assert= (get b :layers) (list 'layers-test/layer-a 'layers-test/layer-b))
      ;; …but :activate fires base-first, so layer-b ([b-on]) before layer-a ([a-on])
      (assert= (get b :log) "[b-on][a-on]")))

  (test "init-buffer-layers resolves type from filename when no :type is set"
    (register-file-type ".lisp-ext" :t-byfile)
    (register-type-layers :t-byfile (list 'layers-test/layer-a))
    (let (b (init-buffer-layers {:log "" :file "x.lisp-ext"}))
      (assert= (get b :type) :t-byfile)
      (is (layer-active? b 'a))
      (assert= (get b :log) "[a-on]"))))

;; ---- Phase 3: scopes, focus/close, teardown ---------------------------------
(defn hk-blur (s) (assoc s :log (str (get s :log) "B!")))
(defn hk-close (s) (assoc s :log (str (get s :log) "C")))
(defn hk-cl-off (s) (assoc s :log (str (get s :log) "D")))
(def layer-fb
  {:name 'fb :hooks {:on-focus '(layers-test/hk-focus) :on-blur '(layers-test/hk-blur)}})
(def layer-close
  {:name 'cl :hooks {:on-close '(layers-test/hk-close) :deactivate '(layers-test/hk-cl-off)}})

(describe "scopes & focus lifecycle"
  (test "scope-keymap composes scopes, the earlier (higher-precedence) scope winning"
    (let (buffer (push-layer {} 'layers-test/layer-hi)
          ; binds x→cmd-y
          window (push-layer {} 'layers-test/layer-a))
      ; binds x→cmd-x
      ;; buffer scope listed first → shadows the window
      (assert= (get (scope-keymap (list buffer window)) "x") 'layers-test/cmd-y)))

  (test "scope-dispatch resolves through the scopes but runs the command on the state"
    (let (buffer (push-layer {} 'layers-test/layer-a)
          ; binds x→cmd-x
          model {:log "M"}
          r (scope-dispatch (list buffer) model nil "x" no-fb))
      ;; cmd-x runs on the model (not the buffer the keymap came from)
      (assert= (get (first r) :log) "MX")
      (assert= (second r) nil)))

  ; to focused
  (test "switch-focus fires :on-blur on the old context and :on-focus on the new"
    (let (from (activate-layer {:log ""} 'layers-test/layer-fb)
          to (activate-layer {:log ""} 'layers-test/layer-fb)
          r (switch-focus from to))
      ; from blurred
      (assert= (get (first r) :log) "B!")
      (assert= (get (second r) :log) "F")))
  (test "switch-focus tolerates a nil side"
    (assert= (switch-focus nil (activate-layer {:log ""} 'layers-test/layer-fb))
      [nil {:log "F" :layers (list 'layers-test/layer-fb)}]))

  (test "close-context fans :on-close then deactivates every layer"
    (let (ctx (activate-layer {:log ""} 'layers-test/layer-close)
          closed (close-context ctx))
      ; :on-close (C) then :deactivate (D)
      (assert= (get closed :log) "CD")
      (is (not (layer-active? closed 'cl))))))

;; ---- taking companions with you ---------------------------------------------
;; A mode that owns a second buffer (a tutorial's workings pane, a REPL transcript) can
;; ask for it to be closed too. It cannot close it itself — a hook is `(ctx) -> ctx` and
;; layers does not know what container the app keeps contexts in — so it NAMES it and the
;; app performs it, the way a layer names a command and the keymap dispatches it.
(defn companion-close (ctx) (request-close (request-close ctx "*Workings*") "*Spy*"))
(def layer-companions {:name 'comp :hooks {:on-close '(layers-test/companion-close)}})

(describe "close-requests — a closing context names its companions"
  (test "nothing is requested by default"
    (assert= (close-requests {}) '())
    (assert= (close-requests (close-context (activate-layer {:log ""} 'layers-test/layer-close)))
      '()))

  (test "an :on-close hook's requests survive on the closed context, in order"
    (let (closed (close-context (activate-layer {} 'layers-test/layer-companions)))
      (assert= (close-requests closed) (list "*Workings*" "*Spy*"))))

  (test "a request is recorded once, however many layers ask"
    ;; two layers owning the same companion is one close, not two
    (let (ctx (activate-layer (activate-layer {} 'layers-test/layer-companions)
                'layers-test/layer-companions))
      (assert= (close-requests (close-context ctx)) (list "*Workings*" "*Spy*"))))

  (test "request-close returns the context, so a hook can thread it"
    (let (ctx (request-close {:keep true} "*X*"))
      (is (:keep ctx))
      (assert= (close-requests ctx) (list "*X*")))))

;; ---- Phase 3: async cleanup (the reason :on-close exists) -------------------
;; A layer that spawns a worker on focus must be able to kill it on close. The
;; worker is one-shot: on :stop it acks its parent and exits.
(defn demo-worker (parent) (receive (:stop (send parent :stopped))))
(defn demo-start (ctx) (assoc ctx :worker (spawn (demo-worker (get ctx :parent)))))
(defn demo-stop (ctx) (send (get ctx :worker) :stop) ctx)
(def layer-async
  {:name 'async :hooks {:on-focus '(layers-test/demo-start) :on-close '(layers-test/demo-stop)}})

(describe "layers async lifecycle across processes"
  :isolated (test "an :on-focus-spawned worker is torn down by :on-close"
    (let (me (self)
          ctx (activate-layer {:parent me} 'layers-test/layer-async)
          ; spawns the worker, pid in :worker
          focused (run-event ctx :on-focus)
          _ (close-context focused))
      ; :on-close sends it :stop
      ;; the worker acks its stop — proving :on-focus spawned and :on-close cleaned up
      (assert= (receive) :stopped))))

;; ---- active-layers + always-on system layers --------------------------------
(describe "system layers & active-layers"
  :isolated (test "active-layers resolves refs to maps, highest precedence first"
    (let (ctx (push-layer (push-layer {} 'layers-test/layer-a) 'layers-test/layer-hi))
      (assert= (map (active-layers ctx) (fn (l) (get l :name))) (list 'hi 'a))))
  (test "system layers are appended (lowest precedence) to every buffer"
    (register-type-layers :t-sys (list 'layers-test/layer-a))
    (register-system-layer 'layers-test/layer-b)
    (let (b (init-buffer-layers (set-buffer-type {} :t-sys)))
      (assert= (map (active-layers b) (fn (l) (get l :name))) (list 'a 'b)))))

;; ---- prefixes compose across layers (ADR-514) -------------------------------
;; A mode that binds one chord under a prefix (a terminal's C-x C-x) keeps the lower
;; layer's other chords under it (the global C-x b), as Emacs's keymaps compose.

(def layer-global
  {:name 'global
   :keymap (-> {}
             (keymap-bind [:ctrl-x "b"] 'layers-test/cmd-x)
             (keymap-bind [:ctrl-x :ctrl-x] 'layers-test/cmd-x)
             (keymap-bind [:ctrl-x "r" "j"] 'layers-test/cmd-x))})

(def layer-term
  {:name 'term
   :keymap (-> {}
             (keymap-bind [:ctrl-x :ctrl-x] 'layers-test/cmd-y)
             (keymap-bind [:ctrl-x "c"] 'layers-test/cmd-y)
             (keymap-bind [:ctrl-x "r" "s"] 'layers-test/cmd-y))})

; one binds the C-x prefix itself to a command, and C-x s explicitly to nothing
(def layer-owner {:name 'owner :keymap {:ctrl-x 'layers-test/cmd-y}})
(def layer-hider {:name 'hider :keymap {:ctrl-x {"s" nil}}})

(defn- chord (ctx keys)
  "Dispatch `keys` one at a time through `ctx`'s layers; the `:log` the commands left."
  (get (first (fold keys [ctx nil] (fn (acc k) (layer-dispatch (first acc) (second acc) k no-fb))))
    :log))

(def term-over-global {:log "" :layers (list 'layers-test/layer-term 'layers-test/layer-global)})

(describe "prefixes compose across layers"
  (test "a lower layer's chord resolves through a higher layer that binds only others"
    (assert= (chord term-over-global [:ctrl-x "b"]) "X"))
  (test "a higher layer's chord still wins over a lower one's"
    (assert= (chord term-over-global [:ctrl-x :ctrl-x]) "Y")
    (assert= (chord term-over-global [:ctrl-x "c"]) "Y"))
  (test "a three-key chord merges at each level"
    (assert= (chord term-over-global [:ctrl-x "r" "j"]) "X")
    (assert= (chord term-over-global [:ctrl-x "r" "s"]) "Y"))
  (test "an explicit nil hides the lower key and nothing beside it"
    (let (ctx {:log ""
               :layers (list {:name 'hide :keymap {:ctrl-x {"b" nil}}} 'layers-test/layer-global)})
      (assert= (chord ctx [:ctrl-x "b"]) "")
      (assert= (chord ctx [:ctrl-x :ctrl-x]) "X")))
  (test "a command bound to the prefix itself still owns it"
    (let (ctx {:log "" :layers (list 'layers-test/layer-owner 'layers-test/layer-global)})
      (assert= (layer-binding ctx :ctrl-x) 'layers-test/cmd-y)
      ;; the prefix ran its command; "b" is a fresh key, unbound at the top
      (assert= (chord ctx [:ctrl-x "b"]) "Y")))
  (test "a command between two prefix maps stops the merge below it"
    (let (ctx {:log ""
               :layers (list 'layers-test/layer-term
                         'layers-test/layer-owner 'layers-test/layer-global)})
      (assert= (chord ctx [:ctrl-x "c"]) "Y")
      ;; owner's command replaced global's map, so only term's own C-x map is left
      (assert= (layer-binding ctx :ctrl-x) (get (:keymap layer-term) :ctrl-x))
      (assert= (chord ctx [:ctrl-x "b"]) "")))
  (test "a prefix one layer owns comes back with exactly that layer's bindings"
    (assert= (layer-binding {:layers (list 'layers-test/layer-global 'layers-test/layer-a)} :ctrl-x)
      (get (:keymap layer-global) :ctrl-x)))
  (test "active-keymap answers what layer-binding answers"
    (let (stacks (list (get term-over-global :layers)
                   (list 'layers-test/layer-owner 'layers-test/layer-global)
                   (list 'layers-test/layer-term 'layers-test/layer-owner 'layers-test/layer-global)
                   (list 'layers-test/layer-global 'layers-test/layer-owner)))
      (assert= (into []
                 (seq/reject stacks
                   (fn (stack)
                     (let (ctx {:layers stack})
                       (= (get (active-keymap ctx) :ctrl-x) (layer-binding ctx :ctrl-x))))))
        [])))
  (test "scope-binding merges a prefix across scopes: the buffer's map over the model's"
    (let (buffer {:layers (list 'layers-test/layer-term)}
          model {:layers (list 'layers-test/layer-global)}
          sub (scope-binding (list buffer model) :ctrl-x))
      (assert= (get sub "b") 'layers-test/cmd-x)
      (assert= (get sub "c") 'layers-test/cmd-y)
      (assert= (get sub :ctrl-x) 'layers-test/cmd-y)
      (assert= sub (get (scope-keymap (list buffer model)) :ctrl-x)))))

;; ---- scope-bindings: the keymap with its provenance kept --------------------
;; The point of these is the SHADOW rule. Prefixes compose across layers (ADR-514), so a
;; layer that binds one key under a prefix leaves the lower layer's other keys in force —
;; but one that binds the prefix itself to a command hides the whole chord, and help that
;; tested only the leaf would report a binding dispatch will never reach.

(def layer-low
  {:name 'low :keymap {"a" 'layers-test/cmd-x :ctrl-x {"k" 'layers-test/cmd-x}}})

(def layer-high
  {:name 'high :keymap {"b" 'layers-test/cmd-y :ctrl-x {"s" 'layers-test/cmd-y}}})

(defn- sb-in (layers sequence)
  "The `scope-bindings` entry for key `sequence` in the stack `layers` (head highest)."
  (seq/find (scope-bindings (list {:layers layers})) (fn (e) (= (get e :sequence) sequence))))

(defn- sb-from (layers layer sequence)
  "The `scope-bindings` entry `layer` makes for key `sequence` in the stack `layers` — for a
sequence two layers both bind, where `sb-in` finds the higher one's."
  (seq/find (scope-bindings (list {:layers layers}))
    (fn (e) (and (= (get e :sequence) sequence) (= (get e :layer) layer)))))

(defn- sb-for (sequence)
  "The `scope-bindings` entry for key `sequence` in the high-over-low fixture stack."
  (sb-in (list 'layers-test/layer-high 'layers-test/layer-low) sequence))

(describe "scope-bindings keeps the layer a binding came from"
  (test "an unshadowed binding names its layer and nothing shadows it"
    (let (e (sb-for ["a"]))
      (assert= [(get e :command) (get e :layer) (get e :shadowed-by)]
        ['layers-test/cmd-x 'low nil])))
  (test "the higher layer's own binding is in force"
    (assert= (get (sb-for ["b"]) :shadowed-by) nil))
  (test "a chord under a prefix a higher layer also binds is NOT shadowed"
    ;; low binds C-x k and high binds C-x s: the two C-x maps merge, so C-x k is in force
    (assert= (get (sb-for [:ctrl-x "k"]) :shadowed-by) nil))
  (test "the higher layer's own chord binding is in force"
    (assert= (get (sb-for [:ctrl-x "s"]) :shadowed-by) nil))
  (test "the same full sequence higher up shadows it; another under the prefix does not"
    (assert= (get (sb-in (list 'layers-test/layer-low 'layers-test/layer-chord) [:ctrl-x :ctrl-e])
               :shadowed-by)
      nil)
    ;; both layers bind C-x k: top's is in force, low's is the one it shadows
    (let (stack (list {:name 'top :keymap {:ctrl-x {"k" 'layers-test/cmd-y}}}
                  'layers-test/layer-low))
      (assert= (get (sb-from stack 'top [:ctrl-x "k"]) :shadowed-by) nil)
      (assert= (get (sb-from stack 'low [:ctrl-x "k"]) :shadowed-by) 'top)))
  (test "a command bound to the prefix shadows every chord under it"
    (assert= (get (sb-in (list 'layers-test/layer-owner 'layers-test/layer-low) [:ctrl-x "k"])
               :shadowed-by)
      'owner))
  (test "an explicit nil shadows the key it names and nothing beside it"
    (let (stack (list 'layers-test/layer-hider 'layers-test/layer-high))
      (assert= (get (sb-in stack [:ctrl-x "s"]) :shadowed-by) 'hider)
      (assert= (get (sb-in stack ["b"]) :shadowed-by) nil)))
  (test "a prefix map higher up shadows a lower command on that key"
    (assert= (get (sb-in (list 'layers-test/layer-low 'layers-test/layer-owner) [:ctrl-x])
               :shadowed-by)
      'low))
  (test "what is in force agrees with what scope-keymap dispatches"
    ;; the property that matters: every unshadowed binding is reachable through the merged
    ;; keymap, and every shadowed one is not — help derived from dispatch, not beside it
    (let (stacks (list (list 'layers-test/layer-high 'layers-test/layer-low)
                   (list 'layers-test/layer-owner 'layers-test/layer-low)
                   (list 'layers-test/layer-low 'layers-test/layer-owner)
                   (list 'layers-test/layer-hider 'layers-test/layer-high 'layers-test/layer-low)))
      (assert= (into []
                 (mapcat stacks
                   (fn (stack)
                     (let (ctxs (list {:layers stack})
                           km (scope-keymap ctxs))
                       (seq/filter (scope-bindings ctxs)
                         (fn (e)
                           (not (= (= (map/get-in km (get e :sequence)) (get e :command))
                                  (nil? (get e :shadowed-by))))))))))
        [])))
  (test "a layer with no keymap contributes nothing and breaks nothing"
    (assert= (count (scope-bindings (list {:layers (list {:name 'bare})}))) 0)))

(describe "layer-facet — the first layer's value, without resolving the rest"
  (test "answers what the head of layer-collect does"
    (let (ctx {:layers [{:name 'a} {:name 'b :x 1} {:name 'c :x 2}]})
      (assert= (first (layer-collect ctx :x)) (layer-facet ctx :x))
      (assert= 1 (layer-facet ctx :x))))
  (test "nil when no layer defines the facet"
    (assert= nil (layer-facet {:layers [{:name 'a}]} :x))
    (assert= nil (layer-facet {} :x)))
  (test "stops at the first layer that has it — later layers are never resolved"
    ;; the third layer is an unbound symbol: resolving it would raise
    (let (ctx {:layers [{:name 'a} {:name 'b :x 1} 'layers-test/no-such-layer]})
      (assert= 1 (layer-facet ctx :x)))))

(describe "shebang-interpreter — the program a `#!` line names"
  (test "a direct path, an env indirection, env's -S flag, and arguments"
    (assert= (shebang-interpreter "#!/bin/bash") "bash")
    (assert= (shebang-interpreter "#!/usr/bin/env bash\n") "bash")
    (assert= (shebang-interpreter "#!/usr/bin/env -S python3 -u") "python3")
    (assert= (shebang-interpreter "#!/bin/sh -e") "sh")
    (assert= (shebang-interpreter "#! /usr/bin/zsh") "zsh"))
  (test "a line that is not a shebang is nil"
    (is (nil? (shebang-interpreter "# just a comment")))
    (is (nil? (shebang-interpreter "")))))
