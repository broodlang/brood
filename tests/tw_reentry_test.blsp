(defmodule tw-reentry-test
  "The tree-walker→VM router (eval/mod.rs `tw_vm_route`): a VM-eligible callee invoked
from tree-walked code runs on the engine instead of inheriting its caller's ~10× defer
(measured 60× on an eligible helper hammered from an autogensym-deferred driver). These
pin the two behaviours that must survive it: routed calls compute the same values, and
mixed-eligibility mutual TAIL recursion still cannot overflow — past TW_REENTRY_BUDGET
the router stands down and the tree-walker's own 'tail loop absorbs the cycle flat."
  (:use test))

(describe "tree-walker→VM routing"
  (test "a routed helper computes what a tree-walked one does"
    ;; driver defers (autogensym template keeps its quasiquote on the runtime path);
    ;; helper is eligible and routed. Value must match the plain computation.
    (let (helper (fn (n acc) (if (= n 0) acc (helper (- n 1) (+ acc (* n 3))))))
      ;; direct (VM) reference value
      (assert= 60300 (helper 200 0))))

  (test "mixed-eligibility mutual tail recursion does not overflow"
    ;; f is VM-eligible; g's arm defers (autogensym). 300k alternations: with an
    ;; unbounded router this is 300k live Rust frames; with the budget it must
    ;; complete. The assertion is completion with the right answer.
    (do
      (defn tw-f (n) (if (= n 0) :done (tw-g (- n 1))))
      (defn tw-g (n) (do `(a# ~n) (tw-f n)))
      (assert= :done (tw-f 300000))))

  ;; The router let a `defn`-inside-`let` loop reach the VM for the first time, and the
  ;; VM's two in-place self-tail resets (the IC fast path for `(defn f … (f …))`, and
  ;; `Inst::SelfCall`) nil-ed EVERY frame slot and refilled only the params — so the
  ;; capture slots holding the enclosing lexicals were gone after one iteration. The
  ;; breakage suite's P40 (`(let (me (self)) (spawn … (defn drain (sock acc) … (send me …)
  ;; … (drain sock …))))`) sent to `nil`. Before the router the same shape was reached
  ;; only from tree-walked callers and tree-walked throughout, which is why nothing had
  ;; ever exercised a captured arm on either reset path. The deferring argument
  ;; (`list`/`str`, a variadic prelude defn) is what keeps the loop on the IC path.
  (test "a captured lexical survives the VM's self-tail frame reset (routed entry)"
    (let (k :captured)
      (defn tw-cap-routed (n acc)
        (if (= n 0) [acc k] (tw-cap-routed (- n 1) (list acc n))))
      (assert= :captured (second (tw-cap-routed 3 nil)))))

  (test "a captured lexical survives the VM's self-tail frame reset (VM entry, both arg shapes)"
    (do
      (defn tw-cap-mk (deferring?)
        (let (k :captured)
          (defn tw-cap-vm (n acc)
            (if (= n 0)
              k
              (tw-cap-vm (- n 1) (if deferring? (list acc n) (+ 0 1)))))
          (tw-cap-vm 3 nil)))
      (assert= :captured (tw-cap-mk true))
      (assert= :captured (tw-cap-mk false))))

  (test "a captured lexical survives a HOT self-tail loop (tiers through the VM into native)"
    (do
      (defn tw-cap-hot-mk ()
        (let (k 7)
          (defn tw-cap-hot (n acc) (if (= n 0) acc (tw-cap-hot (- n 1) (+ (first (list acc k)) k))))
          (tw-cap-hot 200000 0)))
      (assert= 1400000 (tw-cap-hot-mk))))

  (test "the P40 shape: a spawned drainer reports to a captured pid after recursing"
    (let (me (self))
      (def w
        (spawn (do
                 (defn tw-cap-drain (sock acc)
                   (let (event (receive ([:d d] [:data d]) ([:done] :done) (after 3000 :timeout)))
                     (if (= :done event)
                       (send me [:tw-cap-got acc])
                       (tw-cap-drain sock (str acc (second event))))))
                 (tw-cap-drain :sock ""))))
      (send w [:d "a"])
      (send w [:d "b"])
      (send w [:d "c"])
      (send w [:done])
      (assert= "abc" (receive ([:tw-cap-got acc] acc) (after 4000 :timeout))))))
