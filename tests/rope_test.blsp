;; Ropes (ADR-045): the editor buffer's text storage — `text/from-string` plus the
;; rope-* primitive kernel (count / line-count / insert / delete / slice / line
;; / char<->line). Immutable like every Brood value: every edit returns a
;; *fresh* rope and leaves its input untouched. Process-local: a rope lives in
;; one process's heap and never crosses in a message — its content moves as a
;; string (`text/->string`), which the across-processes block below proves.
;;
;; Register-only — discovered and run by `nest test` (and cargo test, via
;; crates/lisp/tests/suite.rs). The whole suite runs in parallel (each test is
;; its own green process), so even the single-process tests here exercise ropes
;; on multiple cores; the final :isolated block adds explicit spawn/send/receive.

(defmodule rope-test (:use test))

;; ---- file-local helpers (defined once at load; survive :isolated rollback) ----

;; A worker that builds a rope from its own text, edits it, and sends the
;; resulting *string* back to `parent` (ropes themselves don't cross heaps).
;; This *is* the process body — `spawn` wraps the call form in a thunk, so
;; `(spawn (rt-editor me "x"))` runs this in the new process.
(defn rt-editor (parent text)
  (let (r (text/from-string text)
        r2 (text/insert r 0 ">> "))
    (send parent (text/->string r2))))

;; A minimal buffer-as-process: holds a rope in its loop state and serves
;; [:insert idx s], [:text reply] messages. Previews the Phase-1 model.
(defn rt-buffer (r)
  (receive
    ([:insert idx s] (rt-buffer (text/insert r idx s)))
    ([:text reply] (send reply (text/->string r)) (rt-buffer r))
    ([:stop reply] (send reply :stopped))))

(describe "rope construction & predicates"
  (test "text/from-string builds a rope"
    (is (rope? (text/from-string "hello")))
    (assert= (type-of (text/from-string "x")) :rope)
    (refute (rope? "hello"))
    (refute (rope? 3)))
  (test "round-trips through a string"
    (assert= (text/->string (text/from-string "hello\nworld\n")) "hello\nworld\n")
    (assert= (text/->string (text/from-string "")) ""))
  (test "empty rope" (assert= (text/length (text/from-string "")) 0)))

(describe "rope measurement"
  (test "length is the character count"
    (assert= (text/length (text/from-string "hello")) 5)
    ; multi-byte chars count as 1 (char-indexed, like strings)
    (assert= (text/length (text/from-string "héllo")) 5))
  (test "line-count counts lines (a trailing newline ends a line)"
    (assert= (text/line-count (text/from-string "")) 1)
    (assert= (text/line-count (text/from-string "one line")) 1)
    (assert= (text/line-count (text/from-string "a\nb")) 2)
    (assert= (text/line-count (text/from-string "a\nb\n")) 3)))

(describe "rope edits are immutable (return a fresh rope)"
  (test "insert returns a fresh rope; the original is unchanged"
    (let (r (text/from-string "hello"))
      (let (r2 (text/insert r 5 " world"))
        (assert= (text/->string r2) "hello world")
        (assert= (text/->string r) "hello"))))
  (test "insert at the front and middle"
    (assert= (text/->string (text/insert (text/from-string "ello") 0 "h")) "hello")
    (assert= (text/->string (text/insert (text/from-string "helo") 3 "l")) "hello"))
  (test "delete returns a fresh rope; the original is unchanged"
    (let (r (text/from-string "hello world"))
      (let (r2 (text/delete r 5 11))
        (assert= (text/->string r2) "hello")
        (assert= (text/->string r) "hello world"))))
  (test "delete an empty range is a no-op (fresh, equal)"
    (assert= (text/->string (text/delete (text/from-string "hello") 2 2)) "hello"))
  (test "insert then delete composes"
    (let (r (text/from-string "abc"))
      ; "abc" -insert@1-> "aXYZbc" -delete[0,2)-> "YZbc"
      (assert= (text/->string (text/delete (text/insert r 1 "XYZ") 0 2)) "YZbc"))))

(describe "rope slicing & lines"
  (test "slice returns the char range as a string"
    (let (r (text/from-string "hello world"))
      (assert= (text/slice r 0 5) "hello")
      (assert= (text/slice r 6 11) "world")
      (assert= (text/slice r 0 0) "")))
  (test "text/line returns each line including its trailing newline"
    (let (r (text/from-string "alpha\nbeta\ngamma"))
      (assert= (text/line r 0) "alpha\n")
      (assert= (text/line r 1) "beta\n")
      (assert= (text/line r 2) "gamma"))))

(describe "rope char<->line mapping"
  ; 'f'
  (test "char->line finds the line containing a char index"
    (let (r (text/from-string "ab\ncd\nef"))
      ; 'a'
      (assert= (text/char->line r 0) 0)
      ; 'c'
      (assert= (text/char->line r 3) 1)
      (assert= (text/char->line r 7) 2)))
  (test "line->char finds where a line begins"
    (let (r (text/from-string "ab\ncd\nef"))
      (assert= (text/line->char r 0) 0)
      (assert= (text/line->char r 1) 3)
      (assert= (text/line->char r 2) 6)))
  (test "char->line and line->char round-trip on line starts"
    (let (r (text/from-string "ab\ncd\nef"))
      (assert= (text/char->line r (text/line->char r 1)) 1)
      (assert= (text/char->line r (text/line->char r 2)) 2))))

(describe "rope equality"
  (test "ropes are = by text content, not identity"
    (is (= (text/from-string "abc") (text/from-string "abc")))
    (refute (= (text/from-string "abc") (text/from-string "abd"))))
  (test "an edit that reproduces the text is = to the original text's rope"
    (let (r (text/from-string "ab"))
      (is (= (text/delete (text/insert r 2 "Xc") 2 3) (text/from-string "abc")))))
  (test "a rope is not = to the equivalent string (distinct types)"
    (refute (= (text/from-string "abc") "abc"))))

(describe "rope out-of-bounds errors"
  (test "insert past the end raises" (assert-error (text/insert (text/from-string "ab") 99 "x")))
  (test "insert at a negative index raises"
    (assert-error (text/insert (text/from-string "ab") -1 "x")))
  (test "delete past the end raises" (assert-error (text/delete (text/from-string "ab") 0 99)))
  (test "delete with end < start raises" (assert-error (text/delete (text/from-string "abc") 2 1)))
  (test "slice past the end raises" (assert-error (text/slice (text/from-string "ab") 0 99)))
  (test "line past the end raises" (assert-error (text/line (text/from-string "ab") 5)))
  (test "char->line past the end raises"
    (assert-error (text/char->line (text/from-string "ab") 99))))

(describe "ropes across processes"
  :isolated

  ;; A rope is process-local: sending one directly is a clean error, not a
  ;; silent copy. The blessed path is to send its content as a string.
  (test "sending a rope in a message raises"
    (assert-error (send (self) (text/from-string "nope"))))

  ;; Workers each build + edit a rope on their own core and send back strings;
  ;; the parent fans them in. Proves rope ops run concurrently across cores and
  ;; that the content crosses heaps as a string (deep-copied, GC-safe).
  (test "fan-out / fan-in: workers edit ropes, return strings"
    (let (me (self))
      (spawn (rt-editor me "alpha"))
      (spawn (rt-editor me "beta"))
      (spawn (rt-editor me "gamma"))
      ;; collect 3 results, order-independent, into a sorted list
      (let (got (sort (list (receive) (receive) (receive))))
        (assert= got (list ">> alpha" ">> beta" ">> gamma")))))

  ;; The buffer-as-process model (Phase 1 preview): a process owns a rope in its
  ;; loop, mutates by looping with a fresh rope, and serves its text on request.
  (test "a buffer process holds a rope and serves edits"
    (let (me (self)
          buf (spawn (rt-buffer (text/from-string "hello"))))
      (send buf [:insert 5 " world"])
      (send buf [:insert 0 ">> "])
      (send buf [:text me])
      (assert= (receive) ">> hello world")
      (send buf [:stop me])
      (assert= (receive) :stopped))))

;; ---- a rope is a sized collection (ADR-253) -----------------------------------
;; `count` and `empty?` used to raise `empty?: expected collection, got rope` — the
;; seam that kept ropes out of the bare vocabulary. A rope counts in CHARACTERS, so
;; it agrees with the string it stands for; that agreement is the property worth
;; pinning, since the two must never disagree about the same text.
(describe "a rope counts and tests empty like the string it stands for"
  (test "count is the character count, and agrees with string/length"
    (assert= (count (text/from-string "hello")) 5)
    (assert= (count (text/from-string "")) 0)
    (let (s "hello world, a longer one")
      (assert= (count (text/from-string s)) (string/length s))))

  (test "count agrees with the string after an edit, not just at construction"
    (let (r (text/insert (text/from-string "hello") 5 " world"))
      (assert= (count r) (string/length (text/->string r)))))

  (test "a multi-byte character counts once, as a character"
    ;; the failure this guards: counting BYTES would make a rope disagree with
    ;; `string/length` on any non-ASCII text
    (let (s "héllo")
      (assert= (count (text/from-string s)) (string/length s))
      (assert= (count (text/from-string s)) 5)))

  (test "empty? is true only for the empty rope"
    (is (empty? (text/from-string "")))
    (is (not (empty? (text/from-string "x")))))

  (test "across processes: a rope built in a spawned process counts there"
    ;; a rope is process-local, so the COUNT crosses, not the rope
    (let (me (self)
          _ (spawn (fn ()
                     (let (r (text/from-string "hello world"))
                       (send me
                         [:counted
                           (count r)
                           (empty? r)
                           (empty? (text/from-string ""))]))))
          reply (receive ([:counted n e1 e2] [n e1 e2])))
      (assert= reply [11 false true]))))
