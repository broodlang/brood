;; Ropes (ADR-045): the editor buffer's text storage — `text/string->` plus the
;; rope-* primitive kernel (count / line-count / insert / delete / slice / line
;; / char<->line). Immutable like every Brood value: every edit returns a
;; *fresh* rope and leaves its input untouched. Process-local: a rope lives in
;; one process's heap and never crosses in a message — its content moves as a
;; string (`text/->string`), which the across-processes block below proves.
;;
;; Register-only — discovered and run by `nest test` (and cargo test, via
;; crates/lisp/tests/suite.rs). The whole suite runs in parallel (each test is
;; its own green process), so even the single-process tests here exercise ropes
;; on multiple cores; the final :isolated block adds explicit spawn/send/receive.

(defmodule rope-test (:use test))

;; ---- file-local helpers (defined once at load; survive :isolated rollback) ----

;; A worker that builds a rope from its own text, edits it, and sends the
;; resulting *string* back to `parent` (ropes themselves don't cross heaps).
;; This *is* the process body — `spawn` wraps the call form in a thunk, so
;; `(spawn (rt-editor me "x"))` runs this in the new process.
(defn rt-editor (parent text)
  (let (r (text/string-> text)
        r2 (text/insert r 0 ">> "))
    (send parent (text/->string r2))))

;; A minimal buffer-as-process: holds a rope in its loop state and serves
;; [:insert idx s], [:text reply] messages. Previews the Phase-1 model.
(defn rt-buffer (r)
  (receive
    ([:insert idx s] (rt-buffer (text/insert r idx s)))
    ([:text reply] (send reply (text/->string r)) (rt-buffer r))
    ([:stop reply] (send reply :stopped))))

(describe "rope construction & predicates"
  (test "text/string-> builds a rope"
    (is (rope? (text/string-> "hello")))
    (assert= (type-of (text/string-> "x")) :rope)
    (refute (rope? "hello"))
    (refute (rope? 3)))
  (test "round-trips through a string"
    (assert= (text/->string (text/string-> "hello\nworld\n")) "hello\nworld\n")
    (assert= (text/->string (text/string-> "")) ""))
  (test "empty rope" (assert= (count (text/string-> "")) 0)))

(describe "rope measurement"
  (test "count is the character count"
    (assert= (count (text/string-> "hello")) 5)
    ; multi-byte chars count as 1 (char-indexed, like strings)
    (assert= (count (text/string-> "héllo")) 5))
  (test "line-count counts lines (a trailing newline ends a line)"
    (assert= (text/line-count (text/string-> "")) 1)
    (assert= (text/line-count (text/string-> "one line")) 1)
    (assert= (text/line-count (text/string-> "a\nb")) 2)
    (assert= (text/line-count (text/string-> "a\nb\n")) 3)))

(describe "rope edits are immutable (return a fresh rope)"
  (test "insert returns a fresh rope; the original is unchanged"
    (let (r (text/string-> "hello"))
      (let (r2 (text/insert r 5 " world"))
        (assert= (text/->string r2) "hello world")
        (assert= (text/->string r) "hello"))))
  (test "insert at the front and middle"
    (assert= (text/->string (text/insert (text/string-> "ello") 0 "h")) "hello")
    (assert= (text/->string (text/insert (text/string-> "helo") 3 "l")) "hello"))
  (test "delete returns a fresh rope; the original is unchanged"
    (let (r (text/string-> "hello world"))
      (let (r2 (text/delete r 5 11))
        (assert= (text/->string r2) "hello")
        (assert= (text/->string r) "hello world"))))
  (test "delete an empty range is a no-op (fresh, equal)"
    (assert= (text/->string (text/delete (text/string-> "hello") 2 2)) "hello"))
  (test "insert then delete composes"
    (let (r (text/string-> "abc"))
      ; "abc" -insert@1-> "aXYZbc" -delete[0,2)-> "YZbc"
      (assert= (text/->string (text/delete (text/insert r 1 "XYZ") 0 2)) "YZbc"))))

(describe "rope slicing & lines"
  (test "slice returns the char range as a string"
    (let (r (text/string-> "hello world"))
      (assert= (text/slice r 0 5) "hello")
      (assert= (text/slice r 6 11) "world")
      (assert= (text/slice r 0 0) "")))
  (test "text/line returns each line including its trailing newline"
    (let (r (text/string-> "alpha\nbeta\ngamma"))
      (assert= (text/line r 0) "alpha\n")
      (assert= (text/line r 1) "beta\n")
      (assert= (text/line r 2) "gamma"))))

(describe "rope char<->line mapping"
  ; 'f'
  (test "char->line finds the line containing a char index"
    (let (r (text/string-> "ab\ncd\nef"))
      ; 'a'
      (assert= (text/char->line r 0) 0)
      ; 'c'
      (assert= (text/char->line r 3) 1)
      (assert= (text/char->line r 7) 2)))
  (test "line->char finds where a line begins"
    (let (r (text/string-> "ab\ncd\nef"))
      (assert= (text/line->char r 0) 0)
      (assert= (text/line->char r 1) 3)
      (assert= (text/line->char r 2) 6)))
  (test "char->line and line->char round-trip on line starts"
    (let (r (text/string-> "ab\ncd\nef"))
      (assert= (text/char->line r (text/line->char r 1)) 1)
      (assert= (text/char->line r (text/line->char r 2)) 2))))

(describe "rope equality"
  (test "ropes are = by text content, not identity"
    (is (= (text/string-> "abc") (text/string-> "abc")))
    (refute (= (text/string-> "abc") (text/string-> "abd"))))
  (test "an edit that reproduces the text is = to the original text's rope"
    (let (r (text/string-> "ab"))
      (is (= (text/delete (text/insert r 2 "Xc") 2 3) (text/string-> "abc")))))
  (test "a rope is not = to the equivalent string (distinct types)"
    (refute (= (text/string-> "abc") "abc"))))

(describe "rope out-of-bounds errors"
  (test "insert past the end raises" (assert-error (text/insert (text/string-> "ab") 99 "x")))
  (test "insert at a negative index raises"
    (assert-error (text/insert (text/string-> "ab") -1 "x")))
  (test "delete past the end raises" (assert-error (text/delete (text/string-> "ab") 0 99)))
  (test "delete with end < start raises" (assert-error (text/delete (text/string-> "abc") 2 1)))
  (test "slice past the end raises" (assert-error (text/slice (text/string-> "ab") 0 99)))
  (test "line past the end raises" (assert-error (text/line (text/string-> "ab") 5)))
  (test "char->line past the end raises"
    (assert-error (text/char->line (text/string-> "ab") 99)))
  (test "a bad range names the bound that is wrong"
    (let (rope (text/string-> "abc"))
      (assert= (error-message (error-of (text/delete rope -1 2)))
        "runtime error: %rope-delete: range start -1 out of bounds (valid 0..=3)")
      (assert= (error-message (error-of (text/slice rope 0 9)))
        "runtime error: %rope-slice: range end 9 out of bounds (valid 0..=3)")
      (assert= (error-message (error-of (text/delete rope 2 1)))
        "runtime error: %rope-delete: range end 1 is before its start 2"))))

(describe "ropes across processes"
  :isolated

  ;; A rope is process-local: sending one directly is a clean error, not a
  ;; silent copy. The blessed path is to send its content as a string.
  (test "sending a rope in a message raises"
    (assert-error (send (self) (text/string-> "nope"))))

  ;; Workers each build + edit a rope on their own core and send back strings;
  ;; the parent fans them in. Proves rope ops run concurrently across cores and
  ;; that the content crosses heaps as a string (deep-copied, GC-safe).
  (test "fan-out / fan-in: workers edit ropes, return strings"
    (let (me (self))
      (spawn (rt-editor me "alpha"))
      (spawn (rt-editor me "beta"))
      (spawn (rt-editor me "gamma"))
      ;; collect 3 results, order-independent, into a sorted list
      (let (got (sort (list (receive) (receive) (receive))))
        (assert= got (list ">> alpha" ">> beta" ">> gamma")))))

  ;; The buffer-as-process model (Phase 1 preview): a process owns a rope in its
  ;; loop, mutates by looping with a fresh rope, and serves its text on request.
  (test "a buffer process holds a rope and serves edits"
    (let (me (self)
          buf (spawn (rt-buffer (text/string-> "hello"))))
      (send buf [:insert 5 " world"])
      (send buf [:insert 0 ">> "])
      (send buf [:text me])
      (assert= (receive) ">> hello world")
      (send buf [:stop me])
      (assert= (receive) :stopped))))

;; ---- a rope is a sized collection (ADR-253) -----------------------------------
;; `count` and `empty?` used to raise `empty?: expected collection, got rope` — the
;; seam that kept ropes out of the bare vocabulary. A rope counts in CHARACTERS, so
;; it agrees with the string it stands for; that agreement is the property worth
;; pinning, since the two must never disagree about the same text.
(describe "a rope counts and tests empty like the string it stands for"
  (test "count is the character count, and agrees with the string's count"
    (assert= (count (text/string-> "hello")) 5)
    (assert= (count (text/string-> "")) 0)
    (let (s "hello world, a longer one")
      (assert= (count (text/string-> s)) (count s))))

  (test "count agrees with the string after an edit, not just at construction"
    (let (r (text/insert (text/string-> "hello") 5 " world"))
      (assert= (count r) (count (text/->string r)))))

  (test "a multi-byte character counts once, as a character"
    ;; the failure this guards: counting BYTES would make a rope disagree with
    ;; the string's `count` on any non-ASCII text
    (let (s "héllo")
      (assert= (count (text/string-> s)) (count s))
      (assert= (count (text/string-> s)) 5)))

  (test "empty? is true only for the empty rope"
    (is (empty? (text/string-> "")))
    (is (not (empty? (text/string-> "x")))))

  (test "across processes: a rope built in a spawned process counts there"
    ;; a rope is process-local, so the COUNT crosses, not the rope
    (let (me (self)
          _ (spawn (fn ()
                     (let (r (text/string-> "hello world"))
                       (send me
                         [:counted
                           (count r)
                           (empty? r)
                           (empty? (text/string-> ""))]))))
          reply (receive ([:counted n e1 e2] [n e1 e2])))
      (assert= reply [11 false true]))))

;; ---- text/skip-forward / skip-backward (%rope-skip) --------------------------
;; What a word motion, M-m and M-SPC measure: how far a run of characters from (or not
;; from) a set reaches. Native, and reading only the run — M-f used to flatten the whole
;; buffer to a string on every keystroke to find the end of one word.

(describe "text/skip-forward and skip-backward"
  (test "forward over a run IN the set stops at the first character outside it"
    (assert= (text/skip-forward (text/string-> "  \tab") 0 " \t" true) 3))
  (test "forward over a run NOT in the set stops at the first character inside it"
    (assert= (text/skip-forward (text/string-> "word, next") 0 " ," false) 4))
  (test "backward stops where the run began"
    (assert= (text/skip-backward (text/string-> "one two") 7 " " false) 4)
    (assert= (text/skip-backward (text/string-> "one   two") 6 " " true) 3))
  (test "a run that reaches the edge of the text stops there"
    (assert= (text/skip-forward (text/string-> "aaa") 0 "a" true) 3)
    (assert= (text/skip-backward (text/string-> "aaa") 3 "a" true) 0))
  (test "no run at all answers where it started"
    (assert= (text/skip-forward (text/string-> "ab") 1 " " true) 1)
    (assert= (text/skip-backward (text/string-> "ab") 1 " " true) 1))
  (test "an index past the end is clamped, not an error"
    (assert= (text/skip-forward (text/string-> "ab") 99 " " true) 2))
  (test "indices are CHARACTERS, not bytes"
    ;; é is two bytes: a byte walk would answer 5
    (assert= (text/skip-forward (text/string-> "ééé x") 0 " " false) 3)))

(describe "rope search past the end"
  ;; An empty needle with `before` past the rope's end looped forever: the forward scan
  ;; clamps a start past the end back to the end, so it never advanced. Reached from the
  ;; editor's backward search with an empty pattern at a stale position.
  (test "an empty needle answers the last index strictly before `before`, clamped"
    (let (r (text/string-> "ab"))
      (assert= (%rope-rfind r "" 3 false) 2)
      (assert= (%rope-rfind r "" 1000 true) 2)
      (assert= (%rope-rfind r "" 2 false) 1)
      (assert= (%rope-rfind r "" 0 false) -1)
      (assert= (editor/buffer/buffer-search-backward (editor/buffer/make-buffer "ab") "" 3) 2)))
  (test "a non-empty needle with `before` past the end finds the last match"
    (let (r (text/string-> "abcabc"))
      (assert= (%rope-rfind r "abc" 1000 false) 3)
      (assert= (%rope-rfind r "ABC" 1000 true) 3))))

;; ---- the char where a line ends, newline included (ADR-760) -----------------
(describe "text/after-line->char"
  (test "is the next line's start, and the text's end on the last line"
    (let (rope (text/string-> "ab\ncd\nef"))
      (assert= (text/after-line->char rope 0) 3)
      (assert= (text/after-line->char rope 1) 6)
      (assert= (text/after-line->char rope 2) 8)))
  (test "bounds exactly what text/line reads"
    (let (rope (text/string-> "one\ntwo\n\nlast"))
      (doseq (line (range 0 (text/line-count rope)))
        (assert= (text/slice rope (text/line->char rope line) (text/after-line->char rope line))
          (text/line rope line)))))
  (test "after a trailing newline the empty last line ends at the text's end"
    (let (rope (text/string-> "ab\n"))
      (assert= (text/line-count rope) 2)
      (assert= (text/after-line->char rope 1) 3)))
  (test "an empty text's one line ends at 0"
    (assert= (text/after-line->char (text/string-> "") 0) 0))
  (test "line-count itself, as line->char takes it, is the empty line at the text's end"
    (let (rope (text/string-> "ab"))
      (assert= (text/line->char rope 1) 2)
      (assert= (text/after-line->char rope 1) 2)))
  (test "a line past line-count, or a negative one, raises naming the call and the line"
    (assert= (error-message (error-of (text/after-line->char (text/string-> "ab") 2)))
      "text/after-line->char: line 2 is out of bounds (valid 0..1)")
    (assert-error (text/after-line->char (text/string-> "ab") -1))))

(describe "a line breaks at LF, CR or CRLF — and nowhere else (ADR-772)"
  (test "a form feed, a vertical tab, NEL and U+2028/U+2029 break no line"
    (doseq (separator ["\u{c}" "\u{b}" "\u{85}" "\u{2028}" "\u{2029}"])
      (let (rope (text/string-> (str "a" separator "b")))
        (assert= (text/line-count rope) 1)
        (assert= (text/char->line rope 2) 0)
        (assert= (text/line-text rope 0) (str "a" separator "b")))))
  (test "a lone CR breaks a line, and so does LF"
    (let (rope (text/string-> "ab\rcd\nef"))
      (assert= (text/line-count rope) 3)
      (assert= (text/line->char rope 1) 3)
      (assert= (text/line->char rope 2) 6)
      (assert= (text/char->line rope 3) 1)
      (assert= (text/char->line rope 6) 2)))
  (test "CRLF is ONE break"
    (let (rope (text/string-> "ab\r\ncd"))
      (assert= (text/line-count rope) 2)
      (assert= (text/line->char rope 1) 4)
      (assert= (text/char->line rope 3) 0)
      (assert= (text/char->line rope 4) 1)))
  (test "end-of-line in a buffer with a form feed stays on its line"
    (let (buf (editor/buffer/end-of-line (editor/buffer/make-buffer "x\u{c}y\nz")))
      (assert= (editor/buffer/buffer-point buf) 3)))
  (test "a buffer search's ^ and $ agree with the rope's lines"
    (assert= (regex/rope-find (text/string-> "x\u{c}ab") "^ab" 0) nil)
    (assert= (get (regex/rope-find (text/string-> "x\rab") "^ab" 0) :start) 2)
    (assert= (get (regex/rope-find (text/string-> "x\r\nab") "^ab" 0) :start) 3)
    (assert= (get (regex/rope-find (text/string-> "xy\r\nab") "y$" 0) :start) 1)
    (assert= (get (regex/rope-find (text/string-> "x\r\nab") "x.*" 0) :text) "x")))

(describe "text/line-text and text/line-end->char"
  (test "a line's text drops LF, CR or CRLF, and the last line has none"
    (let (rope (text/string-> "ab\ncd\ref\r\ngh"))
      (assert= (map (range 0 (text/line-count rope)) (fn (line) (text/line-text rope line)))
        (list "ab" "cd" "ef" "gh"))
      (assert= (map (range 0 (text/line-count rope)) (fn (line) (text/line-end->char rope line)))
        (list 2 5 8 12))))
  (test "line-end->char and line->char bound line-text"
    (let (rope (text/string-> "one\r\ntwo\n\nlast"))
      (doseq (line (range 0 (text/line-count rope)))
        (assert= (text/slice rope (text/line->char rope line) (text/line-end->char rope line))
          (text/line-text rope line)))))
  (test "an empty last line after a trailing newline, and line-count itself"
    (let (rope (text/string-> "ab\n"))
      (assert= (text/line-text rope 1) "")
      (assert= (text/line-end->char rope 1) 3)
      (assert= (text/line-end->char rope 2) 3)))
  (test "a line out of range raises"
    (assert-error (text/line-text (text/string-> "ab") 1))
    (assert-error (text/line-end->char (text/string-> "ab") 2))
    (assert-error (text/line-end->char (text/string-> "ab") -1))))

(describe "text/char->utf16 and text/utf16->char"
  (test "an astral character takes two units, a BMP one one"
    (let (rope (text/string-> "a\u{1F600}é b"))
      (assert= (map (range 0 6) (fn (idx) (text/char->utf16 rope idx))) (list 0 1 3 4 5 6))
      (assert= (map [0 1 3 4 5 6] (fn (unit) (text/utf16->char rope unit))) (list 0 1 2 3 4 5))))
  (test "a unit inside a surrogate pair answers its character"
    (assert= (text/utf16->char (text/string-> "a\u{1F600}b") 2) 1))
  (test "out of range raises"
    (assert-error (text/char->utf16 (text/string-> "ab") 3))
    (assert-error (text/utf16->char (text/string-> "ab") 3))))

;; ---- word syntax (%skip-word, ADR-774) ---------------------------------------
;; A word is letters and digits of any script plus the extra characters a word syntax
;; declares. The scans take a rope or a string and agree on both.

(describe "text word syntax"
  (test "letters, digits and combining marks are word characters; punctuation is not"
    (is (text/word-char? "a" nil))
    (is (text/word-char? "9" nil))
    (is (text/word-char? "λ" nil))
    (is (text/word-char? "\u{301}" nil))
    (refute (text/word-char? "_" nil))
    (refute (text/word-char? "-" nil))
    (refute (text/word-char? "'" nil))
    (refute (text/word-char? "" nil)))
  (test "a syntax's :word-chars are word characters too"
    (is (text/word-char? "'" {:word-chars "'"}))
    (is (text/word-char? "_" {:word-chars "_-"}))
    (refute (text/word-char? "." {:word-chars "_-"})))
  (test "forward-word skips the gap, then the word"
    (assert= (text/forward-word "foo_bar baz" 0 nil) 3)
    (assert= (text/forward-word "foo_bar baz" 3 nil) 7)
    (assert= (text/forward-word "foo_bar baz" 0 {:word-chars "_"}) 7)
    (assert= (text/forward-word "ab" 2 nil) 2))
  (test "backward-word skips the gap, then the word"
    (assert= (text/backward-word "x.y = don't" 11 nil) 10)
    (assert= (text/backward-word "x.y = don't" 11 {:word-chars "'"}) 6)
    (assert= (text/backward-word "ab" 0 nil) 0))
  (test "a rope and the same string answer alike"
    (let (line "  (foo-bar \"é don't\") 42.5 "
          rope (text/string-> line)
          syntax {:word-chars "'"})
      (assert= (map (range 0 (count line)) (fn (at) (text/forward-word rope at syntax)))
        (map (range 0 (count line)) (fn (at) (text/forward-word line at syntax))))
      (assert= (map (range 0 (count line)) (fn (at) (text/backward-word rope at syntax)))
        (map (range 0 (count line)) (fn (at) (text/backward-word line at syntax))))))
  (test "word-bounds is the word at or just before an index"
    (assert= (text/word-bounds "foo.bar" 5 nil) [4 7])
    (assert= (text/word-bounds "foo.bar" 4 nil) [4 7])
    (assert= (text/word-bounds "foo.bar" 3 nil) [0 3])
    (assert= (text/word-bounds (text/string-> "a - b") 2 nil) nil)
    (assert= (text/word-bounds "don't" 1 {:word-chars "'"}) [0 5]))
  (test "indices are characters, and an index past the end is clamped"
    (assert= (text/forward-word "ééé x" 0 nil) 3)
    (assert= (text/forward-word "ab" 99 nil) 2)
    (assert= (text/backward-word "ab cd" 99 nil) 3)))

(describe "text word scans across processes"
  :isolated (test "workers scanning one shared rope agree with the caller"
    (let (rope (text/string-> (string/join (map (range 0 200) (fn (_) "foo_bar don't ")) ""))
          expected (text/forward-word rope 1000 nil)
          caller (self)
          workers (map (range 0 4)
                    (fn (_) (spawn (fn () (send caller [:at (text/forward-word rope 1000 nil)]))))))
      (assert= (map workers (fn (_) (receive ([:at at] at)))) [expected expected expected expected]))))
