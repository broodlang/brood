;; The `sig` adoption pilot (ADR-153): std modules now carry real signatures, so
;; these assert the two things that make them worth writing — the checker enforces
;; them ACROSS module boundaries, and both the argument and the result type flow.
;;
;; They also pin the two gaps the adoption exposed: `bytes`/`decimal` are spellable
;; type names, and a `sig` must sit BELOW its definition (because
;; `BROOD_CONTRACTS=1` turns it into a rebinding).
;;
;; Register-only — discovered and run by `nest test` (and cargo test, via
;; crates/lisp/tests/suite.rs).

(defmodule sig-adoption-test (:use test) (:use path))

;; `check-source` returns the advisory warnings for a source string, which is how
;; we assert on a *static* diagnostic without failing this file's own compile pass.
(defn warns-of (src)
  "The advisory warning messages for `src`, as a list of strings."
  (map (fn (w) (get w :message)) (reflect/check-string-structured src)))

(defn warns-about? (src needle)
  "Does checking `src` produce a warning containing `needle`?"
  (any? (fn (w) (includes? w needle)) (warns-of src)))

(describe "sig: std modules carry signatures the checker enforces"
  (test "a declared std signature is enforced at a call site in another module"
    (is (warns-about? "(defmodule t1 (:use path)) (defn f () (basename 42))"
          "argument 1 expects string"))
    ;; …and the qualified spelling resolves to the same declaration
    (is (warns-about? "(defmodule t2) (defn f () (path/basename 42))"
          "argument 1 expects string")))

  (test "the RESULT type flows too — a bool result into a string position"
    (is (warns-about? "(defmodule t3 (:use path)) (defn f () (string/length (absolute? \"/tmp\")))"
          "expects string")))

  (test "correct calls stay silent (no false positives)"
    (assert= (warns-of "(defmodule t4 (:use path)) (defn f () (basename \"/usr/bin/env\"))") nil)
    (assert= (warns-of "(defmodule t5 (:use path)) (defn f (p) (basename p))") nil))

  (test "the annotated functions still behave"
    (assert= (basename "/usr/bin/env") "env")
    (assert= (dirname "/usr/bin/env") "/usr/bin")
    (assert= (extension "a/b.tar.gz") ".gz")
    (is (absolute? "/x"))
    (refute (absolute? "x"))
    (assert= (split "/a/b") '("/" "a" "b"))))

(describe "sig: the type grammar can name every runtime kind it narrows"
  ;; `bytes` and `decimal` are what `type-of` returns and what `bytes?`/`decimal?`
  ;; narrow to, but neither had a *spelling* in an annotation — so no signature
  ;; could describe std/encoding, std/hash, or std/net/tcp, which are all bytes.
  (test "bytes is a usable type name"
    (is (warns-about? "(sig wb (bytes -> int)) (defn wb (b) (byte-length b)) (defn p () (wb \"str\"))"
          "expects bytes")))

  (test "decimal is a usable type name"
    (is (warns-about? "(sig wd (decimal -> decimal)) (defn wd (d) d) (defn p () (wd 1))"
          "expects decimal")))

  (test "an unrecognised type name is REPORTED, never guessed (ADR-259)"
    ;; The zero-false-positive contract still holds — a typo invents no constraint, so
    ;; the call `(q 42)` is not flagged. What changed is that the typo itself is now
    ;; said out loud: a declaration that is ignored when wrong is a gate that cannot
    ;; fail, and a `sig` is read ahead of every other signature source.
    (is (warns-about? "(sig q (strng -> int)) (defn q (x) 1) (defn p () (q 42))"
          "sig q: unknown type `strng`"))
    (refute (warns-about? "(sig q (strng -> int)) (defn q (x) 1) (defn p () (q 42))"
              "q: argument 1"))
    ;; A capitalised unknown name stays silent — that is an ability used as a type,
    ;; whose module a single-file check may not have loaded (ADR-181/186).
    (assert= (warns-of "(sig w (Shape -> int)) (defn w (x) 1) (defn p () (w 42))") nil)))

(describe "sig: placement is load-bearing under BROOD_CONTRACTS=1"
  ;; `sig` is a pure declaration by default, so placement is free. With contracts
  ;; on it expands to `sig!`, which REBINDS the name — so the definition has to
  ;; exist first. A misplaced sig used to die with a bare `unbound symbol: mod/name`
  ;; that took the whole module load with it; now it names the fix.
  (test "the declaration itself is placement-independent (default mode)"
    (assert= (warns-of "(sig ab (string -> string)) (defn ab (s) s)") nil)
    (assert= (warns-of "(defn ba (s) s) (sig ba (string -> string))") nil))

  (test "no std sig sits directly above a definition of the same name"
    ;; The invariant, checked structurally against the baked-in sources: a `sig`
    ;; written above its `defn` breaks `BROOD_CONTRACTS=1` for that whole module,
    ;; and nothing in the default-mode suite would notice.
    (dolist (m (list "path" "json" "set"))
      (let (lines (string/split (or (%builtin-module m) "") "\n"))
        (assert= (sig-misplaced lines) nil)))))

;; Does line `b` define the name `(sig NAME …)` line `a` declares? That adjacency is
;; the placement that breaks under contracts mode.
(defn- sig-above-def?
  (a b)
  (and (string/starts-with? a "(sig ")
    (let (nm (second (string/split a " ")))
      (or (string/starts-with? b (str "(defn " nm " "))
        (string/starts-with? b (str "(def " nm " "))))))

;; Every misplaced `(sig …)` line in `lines` (empty when the invariant holds).
(defn- sig-misplaced
  (lines)
  (seq/keep (fn (pair) (let ([a b] pair) (when (sig-above-def? a b) a)))
    (seq/zip lines (rest lines))))

;; ---- occurrence typing: inferred params check callers, zero annotations (ADR-190) ----
;; Pass 2.8 now carries each same-file function's inferred PARAMETER demands (not just its
;; return), and the caller arg-check consumes them. Sound: the demands under-constrain (a
;; superset of the true valid-argument type), so a flagged argument is one that genuinely
;; errors at runtime — never a false positive.
(describe "occurrence typing — inferred params flag callers"
  (test "a param inferred from a primitive use checks callers"
    (is (warns-about? "(defmodule ot1) (defn needstr (s) (string/length s)) (defn c () (needstr 5))"
          "expects string")))
  (test "a correct caller is silent"
    (assert= (warns-of "(defmodule ot2) (defn needstr (s) (string/length s)) (defn c () (needstr \"hi\"))")
      nil))
  (test "an unconstrained param never flags (no demand → sound)"
    (assert= (warns-of "(defmodule ot3) (defn id2 (s) s) (defn c () (id2 5))") nil))
  (test "a guarded use never constrains the param (sound)"
    (assert= (warns-of "(defmodule ot4) (defn g (s) (if (string? s) (string/length s) 0)) (defn c () (g 5))")
      nil)))

(describe "occurrence typing — a sealed ability op derives the param"
  (test "a param used as a sealed op's arg is inferred to the member union; a non-member caller is flagged"
    ;; The derived domain is the member union, and it RENDERS as the names you would write
    ;; in a `sig` — `ot5/circle | ot5/rect` — not as the `:__id__` shape that carries the
    ;; identity, which was the representation leaking into the message.
    (is (warns-about? "(defmodule ot5) (defrecord circle (r)) (defrecord rect (w h)) (defability Shape :sealed [circle rect] (area [self] :-> float)) (impl Shape circle (area [c] 1.0)) (impl Shape rect (area [r] 1.0)) (defn shout (s) (area s)) (defn c () (shout 5))"
          "ot5/circle | ot5/rect")))
  (test "a member caller is silent"
    (assert= (warns-of "(defmodule ot6) (defrecord circle (r)) (defability Shape :sealed [circle] (area [self] :-> float)) (impl Shape circle (area [c] 1.0)) (defn shout (s) (area s)) (defn c () (shout (circle 2)))")
      nil))
  (test "a :default impl makes the op accept any value — no demand (sound)"
    (assert= (warns-of "(defmodule ot7) (defrecord circle (r)) (defability Shape :sealed [circle] (area [self] :-> float)) (impl Shape circle (area [c] 1.0)) (impl Shape :default (area [_] 0.0)) (defn shout (s) (area s)) (defn c () (shout 5))")
      nil)))

(describe "sig: a declaration must agree with what it annotates (ADR-259)"
  ;; The file being checked is never loaded, so `arity_of` sees nothing for its own
  ;; functions — which made a declared sig the ONLY arity source a same-file call had.
  ;; A wrong one therefore *suppressed* the correct check: the call type-checked clean
  ;; and died on its first run.
  (test "a sig whose arity contradicts the definition is reported"
    (is (warns-about? "(sig q3 (int -> int)) (defn q3 (a b) a)"
          "declares 1 argument(s) but the definition takes 2")))
  (test "…and the definition, not the sig, is what the call is checked against"
    (is (warns-about? "(sig q3 (int -> int)) (defn q3 (a b) a) (defn c () (q3 5))"
          "wrong number of arguments — expected 2, got 1")))
  (test "a sig that merely narrows a multi-arm definition stays silent"
    (refute (warns-about? "(sig f (int -> int)) (defn f ((a) a) ((a b) a))" "sig f:")))
  (test "a sig for a name the file never defines is reported"
    (is (warns-about? "(sig ghost (int -> int))" "nothing named `ghost` is defined here")))
  (test "a same-file call is arity-checked at all"
    (is (warns-about? "(defn f (x y) x) (defn c () (f 1))"
          "wrong number of arguments — expected 2, got 1"))
    (refute (warns-about? "(defn f (x y) x) (defn c () (f 1 2))" "wrong number"))))

(describe "a parameter's type is its domain (ADR-261)"
  ;; The old rule credited only unconditional demands, so a body that branches on what
  ;; its argument *is* — the ordinary shape of Brood code — constrained nothing.
  (test "a value no branch admits is flagged"
    (is (warns-about? "(defn f (x) (if (string? x) (string/length x) (+ x 1))) (defn c () (f :kw))"
          "f: argument 1 expects")))
  (test "…and both admitted types stay silent"
    (refute (warns-about? "(defn f (x) (if (string? x) (string/length x) (+ x 1))) (defn c () (f \"s\"))"
              "f: argument"))
    (refute (warns-about? "(defn f (x) (if (string? x) (string/length x) (+ x 1))) (defn c () (f 5))"
              "f: argument")))
  (test "a `when` body constrains nothing — it may not run"
    (refute (warns-about? "(defn f (b x) (when b (string/length x))) (defn c () (f true 5))"
              "f: argument")))
  (test "a match's clause patterns are its domain"
    (is (warns-about? "(defn f (x) (match x ((:ok v) v) ((:error e) e))) (defn c () (f 5))"
          "f: argument 1 expects")))
  (test "a destructuring head constrains the argument"
    (is (warns-about? "(defn f ([a b]) (+ a b)) (defn c () (f 5))" "f: argument 1 expects")))
  (test "guarded clauses give a multi-clause function its domain"
    (is (warns-about? "(defn g ((x) :when (string? x) (string/length x)) ((x) :when (int? x) (+ x 1))) (defn c () (g :kw))"
          "no clause accepts these arguments"))
    (refute (warns-about? "(defn g ((x) :when (string? x) (string/length x)) ((x) :when (int? x) (+ x 1))) (defn c () (g 5))"
              "no clause accepts")))
  (test "an unguarded catch-all clause keeps every call silent"
    (refute (warns-about? "(defn g ((x) :when (string? x) 1) ((x) x)) (defn c () (g :kw))"
              "no clause accepts"))))

(describe "a union of shapes is checkable (ADR-262/263)"
  (test "a union of tuple shapes rejects a member of neither"
    (is (warns-about? "(sig f ((or (tuple int) (tuple string)) -> any)) (defn f (t) t) (defn c () (f [true]))"
          "expects (tuple int) | (tuple string)")))
  (test "…and admits either alternative"
    (refute (warns-about? "(sig f ((or (tuple int) (tuple string)) -> any)) (defn f (t) t) (defn c () (f [1]))"
              "f: argument"))
    (refute (warns-about? "(sig f ((or (tuple int) (tuple string)) -> any)) (defn f (t) t) (defn c () (f [\"s\"]))"
              "f: argument")))
  (test "a union of record shapes rejects a map matching neither"
    (is (warns-about? "(sig f ((or (record :a int) (record :b int)) -> any)) (defn f (m) m) (defn c () (f {:zzz 1}))"
          "expects {a: int} | {b: int}")))
  (test "`(not T)` is a type a sig can name"
    (is (warns-about? "(sig f ((not nil) -> any)) (defn f (x) x) (defn c () (f nil))"
          "f: argument 1 expects"))
    (refute (warns-about? "(sig f ((not nil) -> any)) (defn f (x) x) (defn c () (f 5))"
              "f: argument")))
  (test "a complement reads as a complement, not a tag dump"
    (is (warns-about? "(defn f (x) (if (string? x) 1 (string/length x)))" "(not string)"))))

(describe "a record is closed, and openness is a type (ADR-264)"
  ;; A shape that says only what a value must HAVE cannot say what it is NOT — and
  ;; without that, a union of shapes is representable but useless.
  (test "an undeclared key is rejected by a closed record"
    (is (warns-about? "(sig f ((record :name string) -> any)) (defn f (m) m) (defn c () (f {:name \"Ada\" :extra :k}))"
          "f: argument 1 expects")))
  (test "…and admitted by an open one"
    (refute (warns-about? "(sig f ((record &open :name string) -> any)) (defn f (m) m) (defn c () (f {:name \"Ada\" :extra :k}))"
              "f: argument")))
  (test "an open record still enforces the fields it declares"
    (is (warns-about? "(sig f ((record &open :name string) -> any)) (defn f (m) m) (defn c () (f {:name 42}))"
          "f: argument 1 expects")))
  (test "a field read through a tagged union resolves"
    (is (warns-about? "(sig f ((or (record :ok int) (record :error string)) -> any)) (defn f (r) (string/length (get r :ok)))"
          "string/length")))
  (test "an open alternative says nothing about the key, so the union says nothing"
    (refute (warns-about? "(sig f ((or (record :ok int) (record &open :error string)) -> any)) (defn f (r) (string/length (get r :ok)))"
              "string/length")))
  (test "a key absent from a fully-read literal is nil"
    (is (warns-about? "(defn f () (string/length (get {:a 1} :b)))" "string/length")))
  (test "a literal the checker could not read completely stays open"
    (refute (warns-about? "(defn f () (string/length (get {:a 1 :b (zzz)} :other)))"
              "string/length")))
  (test "a defrecord accessor takes any record carrying its field"
    (refute (warns-about? "(defrecord point ((x int) (y int))) (defn c () (point-x (point 1 2)))"
              "point-x"))))

;; ---- exact division: `(/ int int)` is `int | ratio` --------------------------
;;
;; `/` is the one contagious operator that is not int-closed, so the arithmetic rule used to
;; fall through and the checker made NO claim about `(/ x 2)` — the most ordinary arithmetic
;; expression there is. Brood's division is exact: an `int` when it divides evenly, a `ratio`
;; when it does not (`(/ 4 2)` → 2, `(/ 3 2)` → 3/2), and never a float at any arity.

(describe "exact division has a type"
  (test "declaring float over integer division is provably wrong"
    (is (warns-about? "(defmodule dv1) (sig c (int -> float)) (defn c (x) (/ x 2))"
          "int | ratio")))
  (test "the runtime agrees with the claim, both arms"
    (assert= :int (type-of (/ 4 2)))
    (assert= :ratio (type-of (/ 3 2)))
    (assert= :ratio (type-of (/ 2)))
    (assert= :int (type-of (/ 12 2 3)))
    (assert= :ratio (type-of (/ 12 5 3))))
  ;; The residue that stays DEFERRED (ADR-011): `int | ratio` declared `int` is right for an
  ;; even numerator, and proving that needs range analysis. Adding the rule must not smuggle
  ;; in the false positive the deferral exists to avoid.
  (test "the merely-wider case is still not flagged"
    (refute (warns-about? "(defmodule dv2) (sig a (int -> int)) (defn a (x) (/ x 2))"
              "declared return type"))
    (refute (warns-about? "(defmodule dv3) (sig b (int -> number)) (defn b (x) (/ x 2))"
              "declared return type")))
  (test "a float operand is still contagious"
    (is (warns-about? "(defmodule dv4) (sig g (int -> int)) (defn g (x) (/ x 2.0))"
          "yields float"))
    (refute (warns-about? "(defmodule dv5) (sig f (int -> float)) (defn f (x) (/ x 2.0))"
              "declared return type"))))

;; ---- shifting ONE ratio by whole numbers: exactly a ratio --------------------
;;
;; `(+ 1 1/2)` is 3/2 and can be nothing else, but the ratio-closure rule answered
;; `int | ratio` for it — the union it gives every ring expression over ints and ratios.
;; True, and useless where it is read: a live evaluator showing a value beside its type puts
;; "or it could be an int" next to the 3/2 it just printed.
;;
;; What makes the narrower answer sound is a representation invariant, so the runtime arms
;; below are the load-bearing half of this block: a `Ratio` whose denominator is 1 is demoted
;; to an `Int` when it is CONSTRUCTED, so no ratio is ever integral, and `n ± p/q` is
;; `(nq ± p)/q` — same denominator, still not 1. Two ratios can cancel (`(+ 1/2 1/2)`), and
;; multiplication cancels one against a whole number (`(* 2 1/2)`), so both keep the union.

(describe "adding whole numbers to one ratio"
  (test "the runtime never yields an int from an int shifted by a ratio"
    (assert= :ratio (type-of (+ 1 1/2)))
    (assert= :ratio (type-of (- 1 1/2)))
    (assert= :ratio (type-of (+ 1 2 1/2)))
    (assert= :ratio (type-of (inc 1/2)))
    (assert= :ratio (type-of (- 1/2)))
    ;; the invariant the rule rests on, stated directly
    (assert= :int (type-of 4/2))
    (assert= :int (type-of (+ 1/2 1/2))))

  (test "declaring int over it is provably wrong now, not merely wider"
    (is (warns-about? "(defmodule rt1) (sig a (int -> int)) (defn a (x) (+ x 1/2))"
          "yields ratio")))

  (test "a second ratio operand can cancel, and keeps the union"
    (refute (warns-about? "(defmodule rt2) (sig b (ratio -> int)) (defn b (x) (+ x 1/2))"
              "declared return type"))
    (refute (warns-about? "(defmodule rt3) (sig c (int -> int)) (defn c (x) (* x 1/2))"
              "declared return type")))

  ;; Across processes, because a ratio crosses a heap boundary as a deep copy and the
  ;; invariant has to survive the round trip — a ratio rebuilt with denominator 1 on the
  ;; far side would make the checker's claim false where it is least visible.
  (test "the invariant survives a send between processes"
    (let (parent (self)
          worker (spawn (fn ()
                          (receive
                            ([:go from] (send from [:back (+ 1 1/2) (+ 1/2 1/2)]))))))
      (send worker [:go parent])
      (receive
        ([:back shifted cancelled] (assert= :ratio (type-of shifted))
          (assert= :int (type-of cancelled))
          (assert= 3/2 shifted))))))
