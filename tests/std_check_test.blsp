;; The advisory checker, run over the standard library itself — the gate `std/` never
;; had. Register-only: discovered and run by `nest test` (and cargo test, via
;; crates/lisp/tests/suite.rs).
;;
;; WHY THIS EXISTS. `nest check` in this repo checks `:source-paths`, and this repo's
;; source paths are `tests/support` — the standard library lives OUTSIDE them, because
;; it is embedded into the binary rather than built as a project. So nothing was
;; checking the ~80 files that every Brood program loads.
;;
;; What that let through, found on 2026-08-18: `std/tool/complete.blsp` was rewritten
;; to stop requiring `project` (it was loading 2967 lines on every TAB press) and kept
;; one call to `plist-get` — a `project` export. The reference was now unbound, but
;; every path in that module is wrapped in a `complete-safely` net by design, so the
;; failure degraded exactly as designed: `nest remove <TAB>` silently offered nothing.
;; No test failed. A module whose contract is "never raise" cannot be guarded by
;; watching for raises, and this is the gate that catches it instead.
;;
;; `check-file` resolves each file's own requires, so no module needs loading first
;; and the result does not depend on the order files are visited.

(defmodule std-check-test (:use test))

;; Every `.blsp` under `dir`, recursively. `cons` + `append-two` (not `append`) so the
;; walk stays linear in the file count.
(defn- std-check-files
  (dir)
  (if (file/dir? dir)
    (fold (fn (acc entry)
            (let (p (path-join dir entry))
              (cond
                (file/dir? p) (append-two (std-check-files p) acc)
                (string/ends-with? entry ".blsp") (cons p acc)
                else acc)))
      nil
      (file/ls dir))
    nil))

(describe "the standard library carries no checker warnings"
  (test "std/ is discoverable from the suite's working directory"
    ;; Not ceremony: with a wrong cwd the walk returns nil and every assertion below
    ;; passes vacuously. Fail loudly instead of reporting a green gate over zero files.
    (is (> (count (std-check-files "std")) 50)))

  (test "check-file reports nothing for any std file"
    (let (warnings (fold (fn (acc path)
                           (append acc (or (reflect/check-file path) nil)))
                     nil
                     (sort (std-check-files "std"))))
      ;; Assert on the warnings themselves, so a failure names the file, line and lint
      ;; rather than only a count.
      (assert= warnings nil))))
