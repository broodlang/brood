;; Pattern matching — the exhaustive suite. Register-only; run via `brood test`
;; (and `cargo test`, via crates/lisp/tests/suite.rs), which discovers every
;; tests/**/*_test.blsp and runs them together.
;;
;; Covers every variation of the pattern grammar and all three surfaces (`match`,
;; refutable `let`, `fn`/`defn` clauses): literals, wildcard, binds, quoted
;; symbols, pins, list and vector patterns, `& rest`, deep nesting, non-linear
;; (repeated-variable) constraints, guards, clause ordering, the structured
;; no-match crash, and the compile-time checks. See docs/pattern-matching.md.
;;
;; NOTE on testing compile-time errors: the compile pass expands `match` while a
;; top-level form is loaded, so a malformed pattern written directly in a test
;; body would fail at *load* time (before the test runs). To catch those errors
;; at runtime, we trigger expansion explicitly with `(macroexpand 'form)` (for
;; `match`) or `(reflect/eval (reflect/read-string "…"))` (for `let`/`fn`, which lower in the
;; compile pass, not the `macroexpand` builtin).

(defmodule pattern-matching-test (:use test))

;; ─────────────────────────────────────────────────────────────────────────────
;; LITERALS — matched by `=` (type-sensitive)
;; ─────────────────────────────────────────────────────────────────────────────
(describe "literal patterns"
  (test "integers"
    (assert= (match 2 (1 :a) (2 :b) (3 :c) (_ :z)) :b)
    (assert= (match -7 (-7 :neg) (_ :z)) :neg)
    (assert= (match 0 (0 :zero) (_ :z)) :zero))
  (test "floats" (assert= (match 3.14 (3.14 :pi) (_ :z)) :pi))
  (test "strings"
    (assert= (match "hi" ("yo" :a) ("hi" :b) (_ :z)) :b)
    (assert= (match "" ("" :empty) (_ :z)) :empty))
  (test "keywords" (assert= (match :b (:a 1) (:b 2) (:c 3)) 2))
  (test "booleans"
    (assert= (match true (true :t) (false :f)) :t)
    (assert= (match false (true :t) (false :f)) :f))
  (test "nil" (assert= (match nil (nil :n) (_ :z)) :n))
  (test "type-sensitive = (1 and 1.0 differ)"
    (assert= (match 1.0 (1 :int) (_ :other)) :other)
    (assert= (match 1 (1 :int) (_ :other)) :int))
  (test "no literal matches -> falls to catch-all" (assert= (match 99 (1 :a) (2 :b) (_ :z)) :z)))

;; ─────────────────────────────────────────────────────────────────────────────
;; WILDCARD and BARE-SYMBOL BIND
;; ─────────────────────────────────────────────────────────────────────────────
(describe "wildcard and bind"
  (test "_ matches anything, binds nothing"
    (assert= (match 5 (_ :anything)) :anything)
    (assert= (match [1 2 3] (_ :anything)) :anything)
    (assert= (match nil (_ :anything)) :anything))
  (test "bare symbol binds and is usable in the body"
    (assert= (match 21 (n (* n 2))) 42)
    (assert= (match :kw (x x)) :kw))
  (test "bind shadows an outer binding" (assert= (let (x 1) (match 99 (x x))) 99))
  (test "multiple wildcards in one pattern"
    (assert= (match [1 2 3] ([_ y _] y)) 2)
    (assert= (match (list 1 2 3) ((_ _ z) z)) 3)))

;; ─────────────────────────────────────────────────────────────────────────────
;; QUOTED SYMBOLS — match a symbol by value (the bind trap, avoided)
;; ─────────────────────────────────────────────────────────────────────────────
(describe "quoted-symbol patterns"
  (test "'sym matches that symbol"
    (assert= (match 'foo ('foo :yes) (_ :no)) :yes)
    (assert= (match 'bar ('foo :yes) (_ :no)) :no))
  (test "'sym does not bind (would-be trap)"
    ;; a bare `none` binds; 'none compares. Prove the difference:
    (assert= (match :anything ('none :was-none) (other other)) :anything)
    (assert= (match 'none ('none :was-none) (other other)) :was-none))
  (test "quoted symbol inside a structure"
    (assert= (match [:tag 'go] ([:tag 'go] :matched) (_ :no)) :matched)
    (assert= (match [:tag 'stop] ([:tag 'go] :matched) (_ :no)) :no)))

;; ─────────────────────────────────────────────────────────────────────────────
;; PINS — ~expr matches the current value of expr
;; ─────────────────────────────────────────────────────────────────────────────
(describe "pin patterns"
  (test "pin a let-bound variable"
    (assert= (let (k :ok) (match :ok (^k :match) (_ :no))) :match)
    (assert= (let (k :ok) (match :err (^k :match) (_ :no))) :no))
  (test "pin inside a vector (tagged) pattern"
    (assert= (let (expected :ok) (match [:ok 9] ([^expected v] v) (_ :no))) 9)
    (assert= (let (expected :ok) (match [:err 9] ([^expected v] v) (_ :no))) :no))
  (test "pin inside a list pattern"
    (assert= (let (h 1) (match (list 1 2 3) ((^h & t) t) (_ :no))) (list 2 3)))
  (test "pin an arbitrary expression"
    (assert= (match 4 (^(+ 2 2) :four) (_ :no)) :four)
    (assert= (match 5 (^(+ 2 2) :four) (_ :no)) :no))
  (test "pin nested deeply"
    (assert= (let (target 7) (match [:a [:b 7]] ([:a [:b ^target]] :hit) (_ :no))) :hit)))

;; ─────────────────────────────────────────────────────────────────────────────
;; LIST PATTERNS
;; ─────────────────────────────────────────────────────────────────────────────
(describe "list patterns"
  (test "empty list / ()"
    (assert= (match nil (() :empty) (_ :no)) :empty)
    (assert= (match (list) (() :empty) (_ :no)) :empty)
    (assert= (match (list 1) (() :empty) (_ :no)) :no))
  (test "fixed length, element-wise"
    (assert= (match (list 1 2 3) ((a b c) (list c b a))) (list 3 2 1)))
  (test "length mismatch falls through"
    (assert= (match (list 1 2) ((a b c) :three) (_ :other)) :other)
    (assert= (match (list 1 2 3 4) ((a b c) :three) (_ :other)) :other))
  (test "head + & rest"
    (assert= (match (list 1 2 3 4) ((h & t) (list h t))) (list 1 (list 2 3 4)))
    (assert= (match (list 9) ((h & t) (list h t))) (list 9 nil)))
  ; rest may be empty
  (test "several heads + rest"
    (assert= (match (list 1 2 3 4 5) ((a b & rest) (list a b rest))) (list 1 2 (list 3 4 5))))
  (test "& binds the whole list" (assert= (match (list 1 2 3) ((& all) all)) (list 1 2 3)))
  (test "(h & t) requires at least one element"
    (assert= (match nil ((h & t) :nonempty) (_ :empty)) :empty))
  (test "literal heads (list-tagged data)"
    (assert= (match (list :ok 42) ((:ok v) v) (_ :no)) 42)
    (assert= (match (list :err 1) ((:ok v) v) (_ :no)) :no))
  (test "mixed literals and binds"
    (assert= (match (list 1 :go 3) ((1 tag n) (list tag n)) (_ :no)) (list :go 3))))

;; ─────────────────────────────────────────────────────────────────────────────
;; VECTOR PATTERNS — fixed-length tuples, the tagged-data idiom
;; ─────────────────────────────────────────────────────────────────────────────
(describe "vector patterns"
  (test "empty vector"
    (assert= (match [] ([] :empty) (_ :no)) :empty)
    (assert= (match [1] ([] :empty) (_ :no)) :no))
  (test "fixed length" (assert= (match [1 2 3] ([a b c] (+ a b c))) 6))
  (test "length mismatch falls through" (assert= (match [1 2] ([a b c] :three) (_ :other)) :other))
  (test "a list is not a vector (and vice versa)"
    (assert= (match (list 1 2) ([a b] :vec) (_ :not-vec)) :not-vec)
    (assert= (match [1 2] ((a b) :lst) (_ :not-lst)) :not-lst))
  (test "tagged vector — the idiom"
    (assert= (match [:ok 42] ([:ok v] v) ([:err e] (list :e e))) 42)
    (assert= (match [:err 99] ([:ok v] v) ([:err e] (list :e e))) (list :e 99)))
  (test "1- and 3-tuples"
    (assert= (match [42] ([x] x) (_ :no)) 42)
    (assert= (match [2 3 4] ([a b c] (* a b c))) 24)))

(describe "map patterns"
  (test "binds :keys" (assert= (match {:a 1 :b 2} ({:keys [a b]} (+ a b))) 3))
  (test "absent key binds nil"
    (assert= (match {:a 1} ({:keys [a b]} (list a b))) (list 1 nil)))
  (test ":or supplies a default for an absent key"
    (assert= (match {:a 1} ({:keys [a b] :or {b 9}} (list a b))) (list 1 9)))
  (test ":or is ignored when the key is present"
    (assert= (match {:a 1 :b 2} ({:keys [a b] :or {b 9}} b)) 2))
  (test "a non-map falls through"
    (assert= (match 5 ({:keys [a]} a) (_ :not-a-map)) :not-a-map)
    (assert= (match [1 2] ({:keys [a]} a) (_ :not-a-map)) :not-a-map))
  (test "extra map entries are ignored"
    (assert= (match {:a 1 :b 2 :c 3} ({:keys [a]} a)) 1))
  (test "nested under a vector pattern"
    (assert= (match [:pt {:x 1 :y 2}] ([:pt {:keys [x y]}] (list x y))) (list 1 2))))

;; ─────────────────────────────────────────────────────────────────────────────
;; NESTING / COMPOSITION
;; ─────────────────────────────────────────────────────────────────────────────
(describe "nested patterns"
  (test "vector in vector" (assert= (match [:add [1 2]] ([:add [a b]] (+ a b))) 3))
  (test "vector in list and list in vector"
    (assert= (match (list :pair [10 20]) ((tag [x y]) (list tag x y))) (list :pair 10 20))
    (assert= (match [:wrap (list 1 2 3)] ([:wrap (a b c)] (+ a b c))) 6))
  (test "deeply nested" (assert= (match [:a [:b [:c 42]]] ([:a [:b [:c v]]] v)) 42))
  (test "rest of structured elements"
    (assert= (match (list [:p 1] [:p 2] [:p 3]) (([:p a] & more) (list a more)))
      (list 1 (list [:p 2] [:p 3]))))
  (test "mixed literal + bind + nested across forms"
    (assert= (match [:line [0 0] [3 4]] ([:line [x1 y1] [x2 y2]] (list x1 y1 x2 y2)))
      (list 0 0 3 4))))

;; ─────────────────────────────────────────────────────────────────────────────
;; NON-LINEAR — a repeated variable is an equality constraint
;; ─────────────────────────────────────────────────────────────────────────────
(describe "non-linear patterns"
  (test "vector [x x]"
    (assert= (match [3 3] ([x x] :eq) (_ :ne)) :eq)
    (assert= (match [3 4] ([x x] :eq) (_ :ne)) :ne))
  (test "list (x x)"
    (assert= (match (list 5 5) ((x x) :eq) (_ :ne)) :eq)
    (assert= (match (list 5 6) ((x x) :eq) (_ :ne)) :ne))
  (test "three repeats [x x x]"
    (assert= (match [7 7 7] ([x x x] :all-eq) (_ :no)) :all-eq)
    (assert= (match [7 7 8] ([x x x] :all-eq) (_ :no)) :no))
  (test "repeat across nested sub-patterns [[x] [x]]"
    (assert= (match [[1] [1]] ([[x] [x]] :eq) (_ :ne)) :eq)
    (assert= (match [[1] [2]] ([[x] [x]] :eq) (_ :ne)) :ne))
  (test "repeat across a list and a vector (x [x])"
    (assert= (match (list 3 [3]) ((x [x]) :eq) (_ :ne)) :eq)
    (assert= (match (list 3 [4]) ((x [x]) :eq) (_ :ne)) :ne))
  (test "non-linear combined with a literal"
    (assert= (match [:pair 8 8] ([:pair x x] :eq) (_ :ne)) :eq)
    (assert= (match [:pair 8 9] ([:pair x x] :eq) (_ :ne)) :ne))
  (test "equality is structural (works on collections)"
    (assert= (match [(list 1 2) (list 1 2)] ([x x] :eq) (_ :ne)) :eq)
    (assert= (match [(list 1 2) (list 1 3)] ([x x] :eq) (_ :ne)) :ne)))

;; ─────────────────────────────────────────────────────────────────────────────
;; GUARDS — :when after a pattern
;; ─────────────────────────────────────────────────────────────────────────────
(describe "guards"
  (test "guard gates the clause"
    (assert= (match 7 (n :when (> n 0) :pos) (0 :zero) (_ :neg)) :pos)
    (assert= (match -3 (n :when (> n 0) :pos) (0 :zero) (_ :neg)) :neg))
  (test "a falsy guard falls through to the next clause"
    (assert= (match 5 (n :when (> n 100) :big) (n :when (> n 0) :small) (_ :z)) :small))
  (test "guard sees pattern bindings"
    (assert= (match [3 4] ([a b] :when (< a b) :ascending) (_ :no)) :ascending)
    (assert= (match [4 3] ([a b] :when (< a b) :ascending) (_ :no)) :no))
  (test "guard sees outer bindings"
    (assert= (let (limit 10) (match 5 (n :when (< n limit) :under) (_ :over))) :under))
  (test "guard with non-linear pattern"
    (assert= (match [2 2] ([x x] :when (> x 0) :pos-eq) (_ :no)) :pos-eq)
    (assert= (match [2 3] ([x x] :when (> x 0) :pos-eq) (_ :no)) :no))
  (test "guard on a destructured tag"
    (assert= (match [:n 5] ([:n v] :when (> v 0) :pos) ([:n v] :nonpos)) :pos)
    (assert= (match [:n 0] ([:n v] :when (> v 0) :pos) ([:n v] :nonpos)) :nonpos)))

;; ─────────────────────────────────────────────────────────────────────────────
;; FUNCTION-HEAD GUARDS — :when on fn/defn clause heads (ADR-226). A guarded clause
;; routes the whole fn through the same match engine the pattern clauses use, so the
;; guard is evaluated (the native arity path bound by argument count could not).
;; ─────────────────────────────────────────────────────────────────────────────
(defn fhg-sign ((n) :when (< n 0) :neg)
  ((n) :when (> n 0) :pos)
  ((n) :zero))

(describe "function-head guards (:when on fn/defn clause heads)"
  (test "a guard gates an arity clause, falling through to a later clause"
    (let (classify (fn ((n) :when (< n 0) :negative)
                     ((n) :when (= n 0) :zero)
                     ((n) :positive)))
      (assert= :negative (classify -5))
      (assert= :zero (classify 0))
      (assert= :positive (classify 7))))
  (test "a guard sees every param of a multi-arg clause"
    (let (cmp (fn ((a b) :when (> a b) :gt) ((a b) :when (< a b) :lt) ((a b) :eq)))
      (assert= :gt (cmp 3 1))
      (assert= :lt (cmp 1 3))
      (assert= :eq (cmp 2 2))))
  (test "guards combine with mixed arities"
    (let (area (fn ((r) :when (> r 0) (* 3 r r))
                 ((w h) :when (and (> w 0) (> h 0)) (* w h))
                 ((r) :bad)))
      (assert= 12 (area 2))
      (assert= 12 (area 3 4))
      (assert= :bad (area -1))))
  (test "a single guarded clause is a precondition — a failed guard raises"
    (let (only-pos (fn ((n) :when (> n 0) n)))
      (assert= 5 (only-pos 5))
      (is (try (do (only-pos -1) false) (catch _ true)))))
  (test "guarded clauses preserve tail calls (deep recursion stays O(1) stack)"
    (let (count-down (fn ((n acc) :when (= n 0) acc)
                       ((n acc) (count-down (- n 1) (+ acc 1)))))
      (assert= 50000 (count-down 50000 0))))
  (test "defn clause heads take guards too"
    (assert= :neg (fhg-sign -2))
    (assert= :pos (fhg-sign 5))
    (assert= :zero (fhg-sign 0)))
  (test ":when combined with &optional/& in one fn is rejected"
    (is (try
          (do (reflect/eval '(fn ((r) :when (> r 0) r) ((& xs) :bad))) false)
          (catch e (includes? (str (error-message e)) "guard-dispatched")))))
  (test "across processes: a guarded fn dispatches correctly in spawned workers"
    (let (me (self)
          sign (fn ((n) :when (< n 0) :neg) ((n) :when (> n 0) :pos) ((n) :zero))
          _ (map (fn (k) (spawn (fn () (send me [k (sign k)])))) (list -2 0 2))
          results (fold (fn (acc _) (cons (receive) acc)) nil (range 3))
          table (fold (fn (mp pair) (assoc mp (first pair) (second pair))) {} results))
      (assert= :neg (get table -2))
      (assert= :pos (get table 2))
      (assert= :zero (get table 0)))))

;; ─────────────────────────────────────────────────────────────────────────────
;; CLAUSE ORDERING, BODIES, AND match AS AN EXPRESSION
;; ─────────────────────────────────────────────────────────────────────────────
(describe "clauses and bodies"
  ;; the duplicate `1` clause is deliberate (proving the first wins) — opt the
  ;; expression out of the redundant-clause lint.
  (test "first matching clause wins"
    (assert= (check-allow :unreachable-clause (match 1 (1 :first) (1 :second) (_ :z))) :first))
  (test "explicit catch-all binding"
    (assert= (match 99 (1 :one) (other (list :got other))) (list :got 99)))
  (test "multi-form body is an implicit do (last value)"
    (assert= (match 3 (n :first-form-discarded (+ n n))) 6))
  (test "empty body yields nil" (assert= (match 3 (3) (_ :no)) nil))
  (test "match nests as an expression"
    (assert= (+ 1 (match 2 (2 10) (_ 0))) 11)
    (assert= (list (match :a (:a 1)) (match :b (:b 2))) (list 1 2)))
  (test "match inside let, let inside match"
    (assert= (let (v (match 1 (1 :one))) v) :one)
    (assert= (match 5 (n (let (d (* n 2)) d))) 10)))

;; ─────────────────────────────────────────────────────────────────────────────
;; RUNTIME FAILURE — a structured, catchable [:match-error ctx value patterns]
;; ─────────────────────────────────────────────────────────────────────────────
(describe "no-match failure"
  (test "an unmatched value raises" (assert-error (match 42 ([:ok v] v) ([:err e] e))))
  (test "the failure is structured and matchable"
    (assert= (try
               (match 42 ([:ok v] v) ([:err e] e))
               (catch e (match e ([:match-error ctx val pats] (list ctx val)) (_ :other))))
      (list :match 42)))
  (test "the failure carries the patterns tried"
    (assert= (try
               (match 7 (1 :a) (2 :b))
               (catch e (match e ([:match-error ctx val pats] pats) (_ :no))))
      (list 1 2)))
  (test "an empty match always fails" (assert-error (match :anything)))
  (test "a totalised match never fails" (assert= (match :anything (_ :ok)) :ok)))

;; ─────────────────────────────────────────────────────────────────────────────
;; COMPILE-TIME CHECKS — fire while the macro expands (triggered via macroexpand)
;; ─────────────────────────────────────────────────────────────────────────────
(describe "compile-time errors"
  (test "unreachable clause after a catch-all (_)"
    (assert-error (macroexpand '(match 1 (_ :always) (2 :dead)))))
  (test "unreachable clause after a bare-symbol bind"
    (assert-error (macroexpand '(match 1 (x :always) (2 :dead)))))
  (test "a guarded irrefutable clause is NOT unreachable"
    (assert= (try (do (macroexpand '(match 1 (x :when (> x 0) :pos) (_ :np))) :ok) (catch e :err))
      :ok))
  (test "malformed & — must be followed by exactly one tail pattern"
    (assert-error (macroexpand '(match (list 1) ((a & b c) :x))))
    (assert-error (macroexpand '(match (list 1) ((a &) :x)))))
  (test ":when with no guard" (assert-error (macroexpand '(match 1 (x :when)))))
  (test "& is not allowed in a vector pattern"
    (assert-error (macroexpand '(match [1 2] ([a & b] :x)))))
  (test "a clause that isn't a (pattern body...) list" (assert-error (macroexpand '(match 1 5))))
  (test "& rest still works (sanity: a valid & does not error)"
    (assert= (match (list 1 2 3) ((a & b) (list a b))) (list 1 (list 2 3))))
  ;; ADR-152: reject the shape, never reinterpret it. `(not …)` and a map `:as` are
  ;; the two that stay rejected — `or`/`and`/`{key subpattern}` became real patterns
  ;; in ADR-160 (see the groups below), but these two would still silently mean
  ;; something else.
  (test "(not …) is rejected — a negative match binds nothing, so it's a guard"
    (assert-error (macroexpand '(match 2 ((not 1) :hit) (_ :miss))))
    ;; the spelling it points at
    (assert= (match 2 (x :when (not (= x 1)) :hit) (_ :miss)) :hit))
  (test "a map pattern's :as is rejected — it would test for an :as KEY"
    (assert-error (macroexpand '(match {:a 1} ({:keys [a] :as m} a))))
    ;; the `and` spelling it points at
    (assert= (match {:a 1} ((and m {:keys [a]}) [a m])) [1 {:a 1}]))
  (test "the :keys / :or subset and the `{}` any-map pattern still behave"
    (assert= (match {:a 1 :b 2} ({:keys [a b]} (+ a b))) 3)
    (assert= (match {} ({:keys [a] :or {a 7}} a)) 7)
    (assert= (match {:z 1} ({} :any-map) (_ :no)) :any-map)))

;; ─────────────────────────────────────────────────────────────────────────────
;; ALTERNATIVE / CONJUNCTION PATTERNS (ADR-160)
;; ─────────────────────────────────────────────────────────────────────────────
(describe "or patterns"
  (test "the first matching alternative wins"
    (assert= (match 2 ((or 1 2) :hit) (_ :miss)) :hit)
    (assert= (match 3 ((or 1 2) :hit) (_ :miss)) :miss)
    (assert= (map (fn (x) (match x ((or :a :b :c) :abc) (_ :other))) [:a :b :c :d])
      (list :abc :abc :abc :other)))
  (test "alternatives may bind, as long as every one binds the same names"
    (assert= (match [2 9] ((or [1 x] [2 x]) x) (_ :miss)) 9)
    (assert= (match [1 9] ((or [1 x] [2 x]) x) (_ :miss)) 9))
  (test "alternatives that bind DIFFERENT names are a compile error"
    ;; else the body would reference a name only some alternatives bind, and which
    ;; it is would depend on the input (Rust rejects this for the same reason).
    (assert-error (macroexpand '(match 1 ((or a 2) a)))))
  (test "or nests inside other patterns"
    (assert= (match (list :x 2) (((or :x :y) n) n) (_ :no)) 2)
    (assert= (map (fn (m) (match m ((or {:a v} {:b v}) v) (_ :no))) [{:a 1} {:b 2} {:c 3}])
      (list 1 2 :no)))
  (test "or works at every binding site, not just match"
    (assert= (let ((or [1 x] [2 x]) [2 42]) x) 42)
    (assert= ((fn ((or 1 2)) :small) 2) :small))
  (test "an or clause in tail position stays O(1) stack"
    ;; `success` is duplicated per alternative precisely so each stays in tail
    ;; position — a thunk would have cost the TCO guarantee.
    (assert= (letrec (go (fn (n) (match n ((or 0 -1) :done) (_ (go (- n 1))))))
               (go 30000))
      :done)))

(describe "and patterns"
  (test "every pattern must match the same value"
    (assert= (match 5 ((and 5 x) x) (_ :no)) 5)
    (assert= (match 6 ((and 5 x) x) (_ :no)) :no))
  (test "capture-the-whole-while-destructuring — Brood's `:as`"
    (assert= (match {:a 1 :b 2} ((and whole {:keys [a]}) [a (count whole)])) [1 2])
    (assert= (match [1 2] ((and w [a b]) [w a b])) [[1 2] 1 2]))
  (test "later patterns see the names earlier ones bound"
    ;; a repeated name is an equality constraint, as everywhere else
    (assert= (match [7 7] ((and [a b] [_ ^a]) a) (_ :no)) 7)
    (assert= (match [7 8] ((and [a b] [_ ^a]) a) (_ :no)) :no)))

(describe "general map sub-patterns"
  (test "{key subpattern} matches the value at that key"
    (assert= (match {:a 1 :b 2} ({:a v} v)) 1)
    (assert= (match {:status 200} ({:status 200} :ok) (_ :other)) :ok)
    (assert= (match {:status 404} ({:status 200} :ok) (_ :other)) :other))
  (test "an explicit key must be PRESENT — unlike lenient :keys"
    ;; {:k pat} is an Erlang/Elixir map pattern (fails if absent); {:keys [k]} is
    ;; Clojure destructuring (binds nil if absent). Both, on purpose.
    (assert= (match {:b 1} ({:a v} v) (_ :absent)) :absent)
    (assert= (match {:b 1} ({:keys [a]} (list :bound a))) (list :bound nil)))
  (test "sub-patterns nest to any depth"
    (assert= (match {:a {:b 7}} ({:a {:b n}} n) (_ :no)) 7)
    (assert= (match {:a {:b 7}} ({:a {:b 8}} :eight) (_ :no)) :no)
    (assert= (match {:a [1 2]} ({:a [x y]} (+ x y)) (_ :no)) 3))
  (test "explicit keys mix with :keys / :or in one pattern"
    (assert= (match {:t :x :n 3} ({:t :x :keys [n]} n) (_ :no)) 3)
    (assert= (match {:t :y :n 3} ({:t :x :keys [n]} n) (_ :no)) :no))
  (test "a non-keyword key works too (keys are literals in pattern position)"
    (assert= (match {[1 2] :v} ({[1 2] found} found) (_ :no)) :v)
    (assert= (match {"k" 1} ({"k" v} v) (_ :no)) 1))
  (test "general sub-patterns work at every binding site"
    (assert= (let ({:a v} {:a 5}) v) 5)
    (assert= ((fn ({:a v}) v) {:a 6}) 6)
    (assert= (do (defn pm-sub ({:a v}) v) (pm-sub {:a 7})) 7)))

;; ─────────────────────────────────────────────────────────────────────────────
;; TAIL POSITION — a match-driven loop must not overflow
;; ─────────────────────────────────────────────────────────────────────────────
(describe "tail position"
  (test "deep match loop does not overflow"
    (defn pm-count-down (n) (match n (0 :done) (_ (pm-count-down (- n 1)))))
    (assert= (pm-count-down 20000) :done))
  (test "match in an accumulator loop"
    (defn pm-sum (n acc) (match n (0 acc) (_ (pm-sum (- n 1) (+ acc n)))))
    (assert= (pm-sum 1000 0) 500500)))

;; ─────────────────────────────────────────────────────────────────────────────
;; REFUTABLE / DESTRUCTURING let
;; ─────────────────────────────────────────────────────────────────────────────
(describe "destructuring let"
  (test "tuple (vector) bind" (assert= (let ([:ok v] [:ok 42]) v) 42))
  (test "list bind" (assert= (let ((a b c) (list 1 2 3)) (+ a b c)) 6))
  (test "list with & rest" (assert= (let ((h & t) (list 1 2 3)) (list h t)) (list 1 (list 2 3))))
  (test "nested" (assert= (let ([:pt [x y]] [:pt [3 4]]) (+ x y)) 7))
  (test "plain symbol unchanged" (assert= (let (a 1 b 2) (+ a b)) 3))
  (test "sequential, freely mixing symbols and patterns"
    (assert= (let (x 1 [a b] [10 20] y (+ x a)) (list x a b y)) (list 1 10 20 11)))
  (test "a later binding sees an earlier destructured one"
    (assert= (let ([a b] [2 3] s (+ a b)) s) 5))
  (test "non-linear inside a let pattern"
    (assert= (let ([x x] [4 4]) x) 4)
    (assert-error (let ([x x] [4 5]) x)))
  (test "pin inside a let pattern" (assert= (let (tag :ok) (let ([^tag v] [:ok 9]) v)) 9))
  (test "map bind" (assert= (let ({:keys [a b]} {:a 1 :b 2}) (+ a b)) 3))
  (test "map bind with :or default"
    (assert= (let ({:keys [a b] :or {b 40}} {:a 2}) (+ a b)) 42))
  (test "refutable: a non-match raises, with :let context"
    (assert-error (let ([:ok v] [:err 1]) v))
    (assert= (try
               (let ([:ok v] [:err 404]) v)
               (catch e (match e ([:match-error ctx val pats] (list ctx val)) (_ :other))))
      (list :let [:err 404])))
  (test "malformed let pattern is a compile-time error"
    (assert-error (reflect/eval (reflect/read-string "(let ((a & b c) (list 1)) a)")))))

;; ─────────────────────────────────────────────────────────────────────────────
;; fn / defn — multi-clause dispatch and pattern parameters  (:serial: defs globals)
;; ─────────────────────────────────────────────────────────────────────────────
(describe "fn / defn clauses"
  :serial (test "multi-clause recursion (fac)"
    ;; deliberately non-tail (`* n (recurse)`) — the point is multi-clause recursion.
    (check-allow :non-tail-recursion
      (defn pm-fac ((0) 1) ((n) (* n (pm-fac (- n 1))))))
    (assert= (pm-fac 0) 1)
    (assert= (pm-fac 5) 120))
  (test "multi-clause with a guard"
    (defn pm-sign ((n) :when (> n 0) :pos) ((0) :zero) ((n) :neg))
    (assert= (pm-sign 5) :pos)
    (assert= (pm-sign 0) :zero)
    (assert= (pm-sign -2) :neg))
  (test "multi-clause dispatch on tagged data"
    (defn pm-unwrap (([:ok v]) v) (([:err e]) (list :error e)))
    (assert= (pm-unwrap [:ok 7]) 7)
    (assert= (pm-unwrap [:err 9]) (list :error 9)))
  (test "multi-clause with several params per clause"
    (defn pm-add ((a b) (+ a b)))
    (assert= (pm-add 3 4) 7))
  (test "multi-clause with & rest in a clause"
    (defn pm-tail ((h & t) t) (() :empty))
    (assert= (pm-tail 1 2 3) (list 2 3))
    (assert= (pm-tail) :empty))
  (test "different-arity clauses dispatch by arg count"
    (defn pm-ar ((a) :one) ((a b) :two))
    (assert= (pm-ar 1) :one)
    (assert= (pm-ar 1 2) :two))
  (test "anonymous single-clause fn with a tuple param"
    (assert= ((fn ([x y]) (* x y)) [3 4]) 12)
    (assert= ((fn (a [x y]) (+ a x y)) 1 [2 3]) 6))
  (test "anonymous fn with a nested pattern param"
    (assert= ((fn ([:pt [x y]]) (+ x y)) [:pt [5 6]]) 11))
  (test "map-destructuring param"
    (defn pm-mag ({:keys [x y]}) (+ (* x x) (* y y)))
    (assert= (pm-mag {:x 3 :y 4}) 25))
  (test "pattern param coexists with &optional"
    (defn pm-box (a [x y] &optional (c 10)) (+ a x y c))
    (assert= (pm-box 1 [2 3]) 16)
    (assert= (pm-box 1 [2 3] 100) 106))
  (test "pattern param coexists with & rest"
    (defn pm-first ([x y] & rest) (list x y rest))
    (assert= (pm-first [1 2] 3 4 5) (list 1 2 (list 3 4 5))))
  (test "no clause matched raises"
    (defn pm-only-ok (([:ok v]) v))
    (assert-error (pm-only-ok [:err 1])))
  (test "defn forwards single-clause unchanged" (defn pm-sq (x) (* x x)) (assert= (pm-sq 9) 81)))

;; ── Regression: pattern binders reaching eval *unlowered* (ADR-022 fallback) ──
;; A pattern `let`/`fn` normally lowers to `match*` in the compile pass, but can
;; reach the evaluator unlowered — built inside a quasiquote unquote (which the
;; compile pass leaves opaque), or produced by a macro expanded lazily within its
;; own defining form. eval's let/fn lower it on the fly, so these still work
;; (they used to fail with a misleading "expected a symbol").
(describe "lowering fallback"
  (test "pattern let inside a quasiquote unquote (evaluated at runtime)"
    (assert= `(answer ~(let ((a b) (list 1 2)) (+ a b))) (list 'answer 3)))
  (test "multi-clause fn inside a quasiquote unquote"
    (assert= `(r ~((fn ((0) :z) ((n) :nz)) 5)) (list 'r :nz)))
  (test "shadowing = does not break a match (the matcher emits %eq)"
    (assert= (let (= (fn (a b) false)) (match 1 (1 :one) (_ :other))) :one)
    (assert= (let (= (fn (a b) true)) (match 1 (2 :two) (_ :other))) :other)))

;; :serial — these define a macro/global, like the fn/defn group above.
(describe "lowering fallback via same-form macros"
  :serial (test "a macro expanded within its defining form yields a pattern let"
    (defmacro pm-with-pair (v & body) `(let ((a b) ~v) ~@body))
    (assert= (pm-with-pair (list 3 4) (+ a b)) 7))
  (test "a macro expanded within its defining form yields a multi-clause fn"
    (defmacro pm-def-fac (name) `(def ~name (fn ((0) 1) ((n) (* n (~name (- n 1)))))))
    (pm-def-fac pm-qfac)
    (assert= (pm-qfac 5) 120)))

;; ---- record patterns: (record name {map-pattern}?) — ADR-186 ----
;; A record is a map carrying a nominal `:__id__`; a record pattern asserts that id (derived
;; syntactically from the name) and then matches an ordinary map pattern against the fields.
(defrecord pm-circle (r))
(defrecord pm-rect (w h))
(defrecord pm-pt (x y))

(describe "record patterns"
  (test "matches a defrecord value by nominal id and binds fields"
    (assert= (match (pm-circle 5) ((record pm-circle {:r r}) r)) 5)
    (assert= (match (pm-rect 3 4) ((record pm-rect {:w w :h h}) (* w h))) 12))
  (test ":keys shorthand composes inside a record pattern"
    (assert= (match (pm-pt 1 2) ((record pm-pt {:keys [x y]}) [x y])) [1 2]))
  (test "an id-only record pattern (no field map) matches any instance"
    (assert= (match (pm-circle 9) ((record pm-circle) :yes)) :yes))
  (test "a non-matching record id falls through to the next clause"
    (assert= (match (pm-rect 1 1)
               ((record pm-circle {:r r}) :circle)
               ((record pm-rect {:w w :h h}) :rect))
      :rect))
  (test "a plain map with the same fields is NOT a record match"
    (assert= (match {:r 5} ((record pm-circle {:r r}) :circle) (_ :map)) :map))
  (test "a non-map value is NOT a record match"
    (assert= (match 42 ((record pm-circle {:r r}) :circle) (_ :other)) :other))
  (test "a record pattern composes with a :when guard"
    (assert= (match (pm-circle 10)
               ((record pm-circle {:r r}) :when (> r 5) :big)
               ((record pm-circle {}) :small))
      :big))
  (test "a qualified id (mod/name) matches the value's baked id"
    (assert= (match (pm-rect 2 2)
               ((record pattern-matching-test/pm-rect {:w w :h h}) [w h]))
      [2 2]))
  (test "a record pattern nests inside other patterns"
    (assert= (match [:shape (pm-circle 7)]
               ([:shape (record pm-circle {:r r})] r))
      7)))

;; ---- record patterns across processes: a record survives send (deep copy) and matches ----
(defn pm-shape-worker (parent s)
  (spawn (send parent
           [:s
             (match s
               ((record pm-circle {:r r}) [:circle r])
               ((record pm-rect {:w w :h h}) [:rect (* w h)]))])))
(describe "record patterns across processes"
  :isolated (test "a record pattern matches a value received from another process"
    (let (parent (self))
      (pm-shape-worker parent (pm-circle 4))
      (pm-shape-worker parent (pm-rect 2 3))
      (let (a (receive ([:s v] v))
            b (receive ([:s v] v)))
        (is (includes? (list a b) [:circle 4]))
        (is (includes? (list a b) [:rect 6]))))))

;; No (run-tests) call: register-only. The project test runner (`brood test`,
;; ADR-020) discovers this file and runs the whole suite once.
