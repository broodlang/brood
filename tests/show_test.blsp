;; The display protocol (std/show.blsp): the `Display` ability + `to-str`, and the
;; `*show*` hook that makes the screen printers let a record define how it prints
;; (Elixir's `String.Chars`). Register-only — discovered and run by `nest test`.
(defmodule show-test (:use ability) (:use show) (:use test))

(defrecord* usd (cents))
(impl Display
  show-test/usd (to-str [m] (str "$" (to-fixed (/ (get m :cents) 100.0) 2))))

; a record WITHOUT a custom Display impl
(defrecord* plain (a))

;; Activation is an app step now (ADR-172 §5/§8): loading `show` only makes the
;; protocol available — the screen printers honor it once the app opts in here.
(display-on)

(describe "to-str — the protocol op"
  (test "built-ins fall to :default (native str)"
    (assert= (to-str 42) "42")
    (assert= (to-str "hi") "hi")
    (assert= (to-str [1 2]) (str [1 2])))
  (test "a record with an impl returns its custom display"
    (assert= (to-str (usd 1050)) "$10.50")
    (assert= (to-str (usd 5)) "$0.05"))
  (test "a record without an impl falls to :default (its raw map form)"
    (assert= (to-str (plain 7)) (str (plain 7)))
    (is (includes? (to-str (plain 7)) ":__id__")))
  (test "usable inside str/fmt — the Elixir to_string move"
    (assert= (str "total=" (to-str (usd 999))) "total=$9.99")))

(describe "screen printers honor Display"
  (test "println routes a record through to-str"
    (assert= (with-out-str (println (usd 1050))) "$10.50\n"))
  (test "print, with mixed built-in + record args (space-joined, like print always is)"
    (assert= (with-out-str (print (usd 500))) "$5.00")
    ;; print space-joins its args (`%render`), so a label + record reads "cost $5.00"
    (assert= (with-out-str (print "cost" (usd 500))) "cost $5.00"))
  (test "a no-impl record still prints its raw form"
    (is (includes? (with-out-str (println (plain 7))) ":__id__")))
  (test "built-ins render identically with the hook installed and disabled"
    ;; the hook only touches records, so every built-in arg is byte-for-byte the same
    (assert= (with-out-str (println 42 " " [1 2] " " {:k 1}))
      (with-out-str (binding (*show* nil) (println 42 " " [1 2] " " {:k 1}))))))

(describe "*show* is an ordinary dynamic var"
  (test "(binding (*show* nil) …) disables the protocol for a scope"
    (assert= (with-out-str (binding (*show* nil) (println (usd 100))))
      (str (usd 100) "\n")))
  (test "the record prints custom again outside the binding"
    (assert= (with-out-str (println (usd 100))) "$1.00\n")))

;; Cross-process: the protocol rides on records, which deep-copy across heaps on
;; `send`; and `*show*` is a global, so a spawned process honors it too. A worker
;; builds a record and sends it home; the parent prints it through the protocol,
;; and a second worker prints one in its OWN process (captured via with-out-str,
;; which is inherited by spawned children).
(describe "Display across processes"
  :isolated
  (test "a record sent home prints via the protocol in the parent"
    (let (me (self))
      (spawn (send me [:price (usd 2500)]))
      (assert= (with-out-str (receive ([:price p] (println p)))) "$25.00\n")))
  (test "a worker prints a record in its own process, honoring *show*"
    (let (me (self))
      (assert= (with-out-str (do
                               (spawn (do (print (usd 199)) (send me :done)))
                               (receive (:done :ok))))
        "$1.99"))))
