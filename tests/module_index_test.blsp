;;; The project's file → modules index (ADR-380, `std/tool/module-index.blsp`): which
;;; `(defmodule …)` forms each source file declares, cached on disk per file by size and
;;; mtime, so a warm start reads no source file to learn the module graph.
;;;
;;; Observed through `last-scan`: a fresh root parses every file, an unchanged one parses
;;; none, an edited file re-parses itself alone — and a root asked about again after another
;;; root was queried answers from the FILE on disk (the memo is per root, the disk is the
;;; truth between processes). Sabotage-verified: with the size/mtime comparison forced true
;;; the "edited file" case reads the old module name; with it forced false the "second
;;; query" case parses everything.

(defmodule module-index-test (:use test) (:use module-index))

(purge-stale-temp "modidx-")

(defn- fixture-root! ()
  (let (root (temp-dir "modidx-"))
    (file/mkdir root)
    (file/mkdir (path/join root "src"))
    root))

;; The index file of `root` — `index-path` answers `nil | string` (a nil root has none), and
;; every root here is a real one.
(defn- idx-file (root) (or (index-path root) ""))

;; A source file declaring each of `mods` in turn (ADR-223: a file may open several modules).
(defn- write-mod! (root name mods)
  (let (p (path/join root "src" (str name ".blsp")))
    (file/spit p (string/join (map mods (fn (m) (str "(defmodule " m ")\n(defn f () 1)\n"))) ""))
    p))

(describe "the module index answers which modules each file declares (ADR-380)"
  :isolated (test "a fresh root parses every file; the same query again parses none"
    (let (root (fixture-root!)
          a (write-mod! root "a" (list "alpha"))
          b (write-mod! root "b" (list "beta" "beta-extra"))
          r (index-files root (list a b)))
      (assert= (list 'alpha) (get r a))
      (assert= (list 'beta 'beta-extra) (get r b))
      (assert= {:files 2 :hits 0 :parsed 2} (last-scan))
      (is (file/exists? (idx-file root)))
      (let (r2 (index-files root (list a b)))
        (assert= (list 'alpha) (get r2 a))
        (assert= (list 'beta 'beta-extra) (get r2 b))
        (assert= {:files 2 :hits 2 :parsed 0} (last-scan)))))

  (test "an edited file re-parses itself alone, and its new module name is what is answered"
    (let (root (fixture-root!)
          a (write-mod! root "a" (list "alpha"))
          b (write-mod! root "b" (list "beta")))
      (index-files root (list a b))
      ;; The rename changes the file's size, so the entry cannot match whatever the mtime
      ;; clock did (its resolution is a millisecond, and two writes can share one).
      (write-mod! root "a" (list "alpha-renamed"))
      (let (r (index-files root (list a b)))
        (assert= (list 'alpha-renamed) (get r a))
        (assert= (list 'beta) (get r b))
        (assert= {:files 2 :hits 1 :parsed 1} (last-scan)))))

  (test "a file with no module header, and one that does not parse, are indexed as declaring nothing"
    (let (root (fixture-root!)
          bare (path/join root "src" "bare.blsp")
          broken (path/join root "src" "broken.blsp"))
      (file/spit bare "(defn top () 1)\n")
      (file/spit broken "(defmodule oops\n(defn f ( 1)\n")
      (let (r (index-files root (list bare broken)))
        (is (contains? r bare))
        (assert= nil (get r bare))
        (assert= nil (get r broken)))
      (index-files root (list bare broken))
      ;; Both are recorded, so neither is read again.
      (assert= {:files 2 :hits 2 :parsed 0} (last-scan))))

  (test "a file that does not exist answers nil, is neither counted nor recorded, and writes no index"
    (let (root (fixture-root!)
          ghost (path/join root "src" "ghost.blsp"))
      (assert= nil (modules-of root ghost))
      (assert= {:files 1 :hits 0 :parsed 0} (last-scan))
      (assert= nil (modules-of root ghost))
      (assert= {:files 1 :hits 0 :parsed 0} (last-scan))
      (is (not (file/exists? (idx-file root))))))

  (test "the index on disk is what a fresh process would read: another root's file answers without a parse"
    (let (root (fixture-root!)
          a (write-mod! root "a" (list "alpha"))
          other (fixture-root!)
          o (write-mod! other "o" (list "omega")))
      (index-files root (list a))
      ;; Forget the in-process memo the way a new process would have to.
      (%isolate (fn () (module-index/index-files other (list o))))
      (assert= (list 'omega) (get (index-files other (list o)) o))
      (assert= {:files 1 :hits 1 :parsed 0} (last-scan))
      ;; The file itself is the persisted form: readable, versioned, one line per entry.
      (let (text (file/slurp (idx-file root)))
        (is (string/starts-with? text "(brood-module-index "))
        (is (includes? text (pr-str a)))
        (is (includes? text "(alpha)")))))

  (test "a corrupt or foreign-version index is ignored, not trusted"
    (let (root (fixture-root!)
          a (write-mod! root "a" (list "alpha")))
      (file/mkdir (path/join root ".brood"))
      (file/spit (idx-file root)
        (str "(brood-module-index 999)\n" (pr-str (list a 1 1 (list 'stale))) "\n"))
      (assert= (list 'alpha) (modules-of root a))
      (assert= {:files 1 :hits 0 :parsed 1} (last-scan))
      (file/spit (idx-file root) "this is not an index at all (")
      (%isolate (fn () (module-index/modules-of root a)))
      (assert= (list 'alpha) (modules-of root a))))

  (test "a nil root remembers within the process and writes nothing"
    (let (root (fixture-root!)
          a (write-mod! root "a" (list "alpha")))
      (assert= (list 'alpha) (modules-of nil a))
      (assert= {:files 1 :hits 0 :parsed 1} (last-scan))
      (assert= (list 'alpha) (modules-of nil a))
      (assert= {:files 1 :hits 1 :parsed 0} (last-scan))
      (is (not (file/exists? (idx-file root)))))))
