;; std/tool/audit.blsp — the surface audit, and the ADR-308 gate it exists to hold.
;;
;; The argument-order check is the load-bearing one. A reversed-args rename is the one
;; rename mistake with no natural gate — the arity is unchanged and no name is unbound,
;; so `nest check` is silent and the wrong answer surfaces somewhere else entirely
;; (KI-71; and again during ADR-308, when `seq/remove-nth` and `seq/transduce` were each
;; left behind by their siblings). This asserts the whole public surface, by name.

(defmodule audit-test (:use test) (:use audit))

(describe "surface audit: argument order"
  (test "no public function puts a callback or index ahead of its collection"
    ;; Compared as the NAME LIST, not a count: a failure then prints which function
    ;; broke the convention, which is the entire fix instruction.
    (assert= [] (reversed-args)))

  (test "a declared signature takes as many parameters as its function does"
    ;; Found two real bugs on its first run: `string/grapheme-at` and
    ;; `string/substring-graphemes` both declare `Arity::range(2, 3)` but listed only
    ;; two fixed `Sig` params and no optional, so the checker could not type their
    ;; third argument at all.
    (assert= [] (sig-arity-mismatches)))

  (test "the convention is judged per function, and recognises both shapes"
    (is (data-first? 'map))
    (is (data-first? 'fold))
    (is (data-first? 'seq/transduce))
    ;; a function with no recognisable collection/subject pair is vacuously fine
    (is (data-first? 'count)))

  (test "sort is judged on its declared types, not vacuously"
    ;; `sort` is the one this gate missed. It names its parameters `coll`/`more`, and
    ;; `more` is in NEITHER vocabulary — so a name-only judgement finds no subject and
    ;; passes whatever the order is, which is how `(sort > [3 1 2])` survived the whole
    ;; ADR-308 wave. Only the signature makes the check real, and only if the comparator
    ;; is declared as an ARROW: `arrow-type?` is `(includes? t "->")`, so a bare `fn`
    ;; would be the same vacuous pass in a new spelling. Assert the arrow explicitly —
    ;; `(data-first? 'sort)` alone is true either way and cannot tell them apart.
    (is (data-first? 'sort))
    (is (any? (sig-params 'sort) (fn (t) (includes? t "->"))))))

(describe "surface audit: docs and examples"
  (test "the audit sees a real surface, so an empty result would not pass vacuously"
    (is (> (count (public-names)) 300)))

  (test "documented? and exemplified? read the binding's docstring"
    (is (documented? 'audit/report))
    (is (exemplified? 'audit/data-first?))
    (is (not (exemplified? 'audit/undocumented))))

  (test "report returns the four counts it prints"
    (let (r (with-out-str (report)))
      (is (includes? r "surface audit"))
      (is (includes? r "no docstring"))
      (is (includes? r "no example"))
      (is (includes? r "reversed args")))))

;; The two counts, held. Until 2026-09-08 they were "recorded here as a WATCH so the numbers
;; are visible and cannot silently grow unnoticed" — and nothing asserted them. The comment
;; said 23 undocumented and 224 example-less; the real numbers were 0 and 1155, because the
;; earlier reading predates `load-everything` (before it the audit judged only what happened
;; to be loaded, which was a fraction of the surface). A watch that asserts nothing does not
;; watch: it reports the number it was told, forever.
(describe "surface audit: the documentation debt only shrinks"
  (test "the audit sees the WHOLE surface, not just what happens to be loaded"
    ;; `exampleless` below is a ceiling, and a ceiling over a short list passes for the wrong
    ;; reason. Assert the surface first, so a regression in `load-everything` fails HERE
    ;; instead of quietly making the ratchet easy.
    (is (> (load-everything) 50))
    (is (> (count (public-names)) 1000)))

  (test "every public name carries a docstring"
    ;; At zero, so it is a hard gate rather than a ratchet: a new public function without a
    ;; docstring fails here. Asserted as the NAME LIST — a count says a rule was broken, the
    ;; list says by what.
    (assert= [] (undocumented)))

  (test "no more public names lack a `form → result` example than yesterday"
    ;; A RATCHET, not a target. 1138 names carry a docstring with no executed example, and
    ;; that is real debt — but a hard gate at zero cannot land in one session, and no gate at
    ;; all is what let the number grow unwatched. So: this number may be LOWERED whenever
    ;; examples are written, and may never rise. Adding a public function means adding its
    ;; example, or the ceiling stops you.
    ;;
    ;; Each example is an executed test (`doc_examples_test.blsp`), so lowering this is not a
    ;; documentation chore with no verification behind it — it is coverage.
    ;; Compared through `math/max` rather than with `<=`, so the failure PRINTS the number
    ;; that broke it — the ceiling against the count that exceeded it is the whole diagnosis,
    ;; where a plain false-against-true would send you back to run the audit by hand.
    (assert= 1138 (math/max 1138 (count (exampleless))))))
