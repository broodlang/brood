(defmodule queue-test (:use test) (:use math))

(describe "FIFO queue"
  (test "new queue is empty"
    (is (empty? (queue/empty))))
  (test "size 0 when empty"
    (assert= 0 (count (queue/empty))))
  (test "push increases size"
    (assert= 1 (count (queue/push (queue/empty) :a))))
  (test "pop returns empty on empty queue"
    (assert= :empty (queue/pop (queue/empty))))
  (test "peek returns empty on empty queue"
    (assert= :empty (queue/peek (queue/empty))))
  (test "FIFO order preserved"
    (let (q (-> (queue/empty)
              (queue/push 1)
              (queue/push 2)
              (queue/push 3)))
      (let (r1 (queue/pop q)
            r2 (queue/pop (second r1))
            r3 (queue/pop (second r2)))
        (assert= 1 (first r1))
        (assert= 2 (first r2))
        (assert= 3 (first r3))
        (is (empty? (second r3))))))
  (test "peek does not remove"
    (let (q (queue/push (queue/empty) :x))
      (assert= :x (queue/peek q))
      (assert= :x (queue/peek q))
      (assert= 1 (count q))))
  (test "seq preserves order"
    (let (q (-> (queue/empty)
              (queue/push :a)
              (queue/push :b)
              (queue/push :c)))
      (assert= [:a :b :c] (into [] (seq q)))))
  (test "queue/list->"
    (let (q (queue/list-> [10 20 30]))
      (assert= 10 (queue/peek q))
      (assert= 3 (count q))))
  ;; a queue is a first-class collection — the generic ops work on it directly
  ;; (seqable + conjable, ADR-172 §7), not just the bespoke `queue-*` functions.
  (test "generic collection ops work on a queue"
    (let (q (queue/list-> [1 2 3 4]))
      (assert= [1 2 3 4] (into [] q)) ; seqable
      (assert= 4 (count q))
      (assert= (list 10 20 30 40) (map (fn (n) (* n 10)) q))
      (assert= 10 (fold + 0 q))
      (assert= (list 2 4) (filter even? q))
      (assert= [1 2 3 4 5] (into [] (conj q 5))))) ; conjable
  (test "interleaved push/pop"
    (let (q0 (queue/empty)
          q1 (queue/push q0 :a)
          q2 (queue/push q1 :b)
          r1 (queue/pop q2)
          q3 (queue/push (second r1) :c)
          r2 (queue/pop q3)
          r3 (queue/pop (second r2)))
      (assert= :a (first r1))
      (assert= :b (first r2))
      (assert= :c (first r3)))))

(describe "min-priority queue"
  (test "new pq is empty"
    (is (empty? (pq/empty))))
  (test "size 0"
    (assert= 0 (count (pq/empty))))
  (test "pop empty returns :empty"
    (assert= :empty (pq/pop (pq/empty))))
  (test "peek empty returns :empty"
    (assert= :empty (pq/peek (pq/empty))))
  (test "min priority comes out first"
    (let (pq (-> (pq/empty)
               (pq/insert 3 :low)
               (pq/insert 1 :high)
               (pq/insert 2 :med)))
      (assert= :high (pq/peek pq))
      (let (r1 (pq/pop pq)
            r2 (pq/pop (second r1))
            r3 (pq/pop (second r2)))
        (assert= :high (first r1))
        (assert= :med (first r2))
        (assert= :low (first r3))
        (is (empty? (second r3))))))
  (test "seq in priority order"
    (let (pq (-> (pq/empty)
               (pq/insert 5 :e)
               (pq/insert 1 :a)
               (pq/insert 3 :c)))
      (assert= [:a :c :e] (into [] (seq pq)))))
  (test "equal priorities"
    (let (pq (-> (pq/empty)
               (pq/insert 1 :x)
               (pq/insert 1 :y)))
      (assert= 2 (count pq))))
  (test "equal priorities pop in insertion order (stable / FIFO)"
    (let (pq (-> (pq/empty)
               (pq/insert 1 :a)
               (pq/insert 1 :b)
               (pq/insert 1 :c)))
      (assert= [:a :b :c] (into [] (seq pq))))))

;; Both structures are records, so each has a nominal identity rather than being "a map
;; with the right keys" / "a list of pairs". That is what `queue?`/`pq?` test, what keeps
;; either from comparing `=` to a look-alike, and what carries their print form.
(describe "queue and pq are records with their own identity"
  (test "queue? / pq? are true only for the real thing"
    (is (queue? (queue/empty)))
    (is (queue? (queue/push (queue/empty) 1)))
    (is (not (queue? (pq/empty))))
    (is (pq? (pq/empty)))
    (is (pq? (pq/insert (pq/empty) 1 :a)))
    (is (not (pq? (queue/empty)))))
  (test "neither is a plain collection in disguise"
    (is (not (queue? {:front nil :back nil :size 0})))
    (is (not (pq? (list [1 :a]))))
    (is (not (= (queue/empty) {:front nil :back nil :size 0}))))
  (test "each carries its record id"
    (assert= (record-id (queue/empty)) :queue/queue)
    (assert= (record-id (pq/empty)) :pq/pq))
  ;; An EMPTY pq used to be `nil` (a bare list), and `()` is the one falsy collection in
  ;; Brood — so `(if pq …)` took the else branch on an empty queue. A record is truthy.
  (test "an empty pq is truthy, unlike the bare list it used to be"
    (is (if (pq/empty) true false))
    (is (empty? (pq/empty))))
  (test "a queue displays as a summary and inspects as its contents"
    (assert= (->string (queue/empty)) "#<queue empty>")
    (let (q (queue/list-> (list 1 2 3)))
      (assert= (->string q) "#<queue 3 front=1>")
      (assert= (inspect q) "#<queue (1 2 3)>")))
  (test "a pq displays as a summary and inspects as its entries"
    (assert= (->string (pq/empty)) "#<pq empty>")
    (let (pq (-> (pq/empty) (pq/insert 2 :b) (pq/insert 1 :a)))
      (assert= (->string pq) "#<pq 2 min=1>")
      (assert= (inspect pq) "#<pq ([1 :a] [2 :b])>"))))

;; Cross-process: a record deep-copies on `send` and keeps its `:__id__`, so a queue
;; built in a worker is still a queue here — identity survives the heap crossing.
(describe "queue across processes"
  :isolated (test "queues built in workers arrive as queues and pop in order"
    (let (me (self))
      (doseq (i (range 4))
        (spawn (send me [:q (queue/list-> (list i (+ i 10)))])))
      (let (results (map (fn (_) (receive ([:q q] q) (after *test-wait-ms* :timeout)))
                      (range 4)))
        (is (every? queue? results))
        (is (every? (fn (q) (= (count q) 2)) results))
        (assert= (into [] (sort (map (fn (q) (queue/peek q)) results))) [0 1 2 3]))))
  (test "a pq survives a round trip and keeps its ordering"
    (let (me (self)
          pq (-> (pq/empty) (pq/insert 3 :c) (pq/insert 1 :a)))
      (spawn (send me [:pq pq]))
      (let (back (receive ([:pq p] p) (after *test-wait-ms* :timeout)))
        (is (pq? back))
        (assert= (into [] (seq back)) [:a :c])))))
