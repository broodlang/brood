;;; Regression guard for the pipeline fusion + counted range loop (ADR-360 §7).
;;;
;;; `(-> (range n) (seq/lfilter p) (seq/lmap f) (reduce init rf))` is rewritten at compile
;;; time into one `fold` literal over the base (each stage substituted in place or called by
;;; name), and a `fold` over a `(range …)` with a literal `fn` into a counted `letrec` loop.
;;; Every test asserts the value the pipeline should produce; `BROOD_LINMAP=0` disables both
;;; rewrites and must agree. The expansions themselves are pinned in
;;; `crates/lisp/tests/linmap_idiom.rs`.

(defmodule pipeline-fusion-test (:use test))

(defn pf-mult35? (i) (or (= 0 (math/rem i 3)) (= 0 (math/rem i 5))))

;; A stage whose expression has a side effect, to pin evaluation order and count.
(def *pf-log* (table/new))
(defn pf-note (k) (table/incr *pf-log* k) k)
(defn pf-make-pred (tag) (pf-note tag) (fn (x) (> x 1)))

(describe "pipeline fusion"
  (test "filter/map/reduce over a range is the sum of the squares"
    (assert= 155553889038886
      (-> (range 100000) (seq/lfilter pf-mult35?) (seq/lmap (fn (i) (* i i))) (reduce 0 +))))

  (test "every stage kind, over a list, a vector and a range"
    (assert= 20
      (-> '(1 2 3 4)
        (seq/lkeep (fn (v) (when (= 0 (math/rem v 2)) (* v 10))))
        (seq/lreject (fn (v) (= v 40)))
        (reduce 0 +)))
    (assert= 20
      (-> [1 2 3 4]
        (seq/lkeep (fn (v) (when (= 0 (math/rem v 2)) (* v 10))))
        (seq/lreject (fn (v) (= v 40)))
        (reduce 0 +)))
    (assert= 20
      (-> (range 1 5)
        (seq/lkeep (fn (v) (when (= 0 (math/rem v 2)) (* v 10))))
        (seq/lreject (fn (v) (= v 40)))
        (reduce 0 +)))
    ;; a symbol stage (called by name) and a literal reducer
    (assert= 20 (reduce (seq/lmap (range 4) inc) 0 (fn (a b) (+ a (* 2 b))))))

  (test "a later stage's free variable is not captured by an earlier stage's parameter"
    ;; The filter binds `x`; the map reads the OUTER `x` (100). A naive substitution would
    ;; read the element instead.
    (let (x 100)
      (assert= 900
        (-> (range 5) (seq/lfilter (fn (x) (> x 1))) (seq/lmap (fn (y) (* y x))) (reduce 0 +)))))

  (test "a literal that rebinds its own parameter is called, not substituted, and still right"
    (assert= 10 (-> (range 4) (seq/lmap (fn (x) (let (x (+ x 1)) x))) (reduce 0 +))))

  (test "stage expressions are evaluated once each, in source order, before the fold runs"
    (let (r (-> (range 4)
              (seq/lfilter (pf-make-pred :first))
              (seq/lmap (fn (v) (pf-note :map) v))
              (reduce 0 (fn (a v) (pf-note :rf) (+ a v)))))
      (assert= 5 r)
      (assert= 1 (table/get *pf-log* :first))
      ;; the map and reducer bodies ran once per surviving element (2 and 3)
      (assert= 2 (table/get *pf-log* :map))
      (assert= 2 (table/get *pf-log* :rf))))

  (test "a parameter inside a vector, map or set literal is substituted with the rest"
    ;; The substitution walked lists only, so a literal kept the parameter's name: unbound
    ;; in the fused body, or — when the reducer's parameter shadowed an outer binding — the
    ;; outer value, silently.
    (assert= [[1] [2] [3]] (fold (seq/lmap [1 2 3] (fn (x) [x])) [] (fn (acc v) (conj acc v))))
    (assert= [{:v 2} {:v 3} {:v 4}]
      (let (x 0) (fold (seq/lmap [1 2 3] inc) [] (fn (acc x) (conj acc {:v x})))))
    (assert= [#{2} #{3} #{4}]
      (let (x 0) (fold (seq/lmap [1 2 3] inc) [] (fn (acc x) (conj acc #{x})))))
    (assert= [{1 :k} {2 :k}] (fold (seq/lmap [1 2] (fn (x) {x :k})) [] (fn (acc v) (conj acc v)))))

  (test "a literal that rebinds or quotes its parameter inside a collection is called, and right"
    (assert= [[10 1] [10 2]]
      (fold (seq/lmap [1 2] (fn (x) [(let (x 10) x) x])) [] (fn (acc v) (conj acc v))))
    (assert= [['x 1] ['x 2]] (fold (seq/lmap [1 2] (fn (x) ['x x])) [] (fn (acc v) (conj acc v)))))

  (test "the reducer's error is the same error"
    (assert-error "+: expected number" (-> (range 3) (seq/lmap str) (reduce 0 +)))))

(describe "a fold over a range is a counted loop"
  (test "sums, empty ranges, negative steps and strides"
    (assert= 45 (fold (range 10) 0 (fn (acc x) (+ acc x))))
    (assert= 7 (fold (range 0) 7 (fn (acc x) (+ acc x))))
    (assert= '(1 4 7 10) (fold (range 10 0 -3) nil (fn (acc x) (cons x acc))))
    (assert= [2 4 6 8] (fold (range 2 9 2) [] (fn (acc x) (conj acc x))))
    (assert= 4999950000 (fold (range 100000) 0 (fn (acc x) (+ acc x)))))

  (test "the body's effects run once per element, in order"
    (let (seen (table/new))
      (fold (range 3) 0 (fn (acc x) (table/incr seen x) (+ acc x)))
      (assert= 1 (table/get seen 0))
      (assert= 1 (table/get seen 2))
      (assert= nil (table/get seen 3))))

  (test "a body error is the body's error"
    (assert-error "+: expected number" (fold (range 3) 0 (fn (acc x) (+ acc (str x))))))

  (test "a non-literal reducer takes the ordinary fold; a vector and a list loop too"
    (assert= 45 (fold (range 10) 0 +))
    (assert= 6 (fold '(1 2 3) 0 (fn (acc x) (+ acc x))))
    (assert= 6 (fold [1 2 3] 0 (fn (acc x) (+ acc x))))
    (assert= 0 (fold nil 0 (fn (acc x) (+ acc x))))
    (assert= 0 (fold [] 0 (fn (acc x) (+ acc x))))
    (assert= '(3 2 1) (fold '(1 2 3) nil (fn (acc x) (cons x acc))))
    (assert= [1 2 3] (fold [1 2 3] [] (fn (acc x) (conj acc x))))
    ;; a map folds as its [k v] pairs, through the ordinary fold
    (assert= 3 (fold {:a 1 :b 2} 0 (fn (acc kv) (+ acc (nth kv 1)))))
    ;; a string is not seqable here either way
    (assert-error "expected" (fold "abc" 0 (fn (acc _x) (+ acc 1)))))

  (test "a list fold stops at a failure accumulator (ADR-315), a vector fold does not"
    (let (f (failure "stop"))
      (assert= f (fold '(1 2 3) 0 (fn (acc x) (if (= x 2) f (if (int? acc) (+ acc x) acc)))))
      ;; the step after the failure never runs
      (let (seen (table/new))
        (fold '(1 2 3) 0 (fn (acc x) (table/incr seen x) (if (= x 2) f acc)))
        (assert= nil (table/get seen 3)))))

  (test "a shadowed name anywhere in the form declines the rewrite, and the shadow wins"
    (assert= 9 (let (range (fn (_n) (list 9))) (fold (range 3) 0 (fn (_acc x) x))))))

;; `(reduce coll init f)` is `(fold coll init f)` and takes the same counted loop.
(describe "a reduce over a range with a literal is the same loop"
  (test "sums, empty ranges, negative steps and strides"
    (assert= 45 (reduce (range 10) 0 (fn (acc x) (+ acc x))))
    (assert= 7 (reduce (range 0) 7 (fn (acc x) (+ acc x))))
    (assert= '(1 4 7 10) (reduce (range 10 0 -3) nil (fn (acc x) (cons x acc))))
    (assert= [2 4 6 8] (reduce (range 2 9 2) [] (fn (acc x) (conj acc x)))))

  (test "nested, with the outer element captured — the nqueens shape"
    (assert= 285
      (reduce (range 10) 0 (fn (acc i) (+ acc (reduce (range i) 0 (fn (a _j) (+ a i))))))))

  (test "the body's effects run once per element; its error is its own"
    (let (seen (table/new))
      (reduce (range 3) 0 (fn (acc x) (table/incr seen x) (+ acc x)))
      (assert= 1 (table/get seen 2))
      (assert= nil (table/get seen 3)))
    (assert-error "+: expected number" (reduce (range 3) 0 (fn (acc x) (+ acc (str x))))))

  (test "other collections, the two-argument form, and a shadowed reduce"
    (assert= 6 (reduce [1 2 3] 0 (fn (acc x) (+ acc x))))
    (assert= 6 (reduce '(1 2 3) 0 (fn (acc x) (+ acc x))))
    (assert= 6 (reduce (range 4) (fn (acc x) (+ acc x))))
    (assert= :mine (let (reduce (fn (_c _i _f) :mine)) (reduce (range 3) 0 (fn (_acc x) x))))))

(describe "across processes: a rewritten reduce in many processes at once"
  :isolated (test "eight workers each fold their own range and agree"
    (let (me (self)
          _ (each (range 1 9)
              (fn (k)
                (spawn (fn () (send me [k (reduce (range (* k 1000)) 0 (fn (acc x) (+ acc x)))])))))
          got (map (range 1 9) (fn (_) (receive ([k s] [k s]) (after 30000 :timeout)))))
      (each got
        (fn (r)
          (is (vector? r))
          (let ([k s] r) (assert= (/ (* (* k 1000) (- (* k 1000) 1)) 2) s)))))))
