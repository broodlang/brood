;; The dirty-native offload pool (ADR-144): long/blocking natives run on a
;; small OS pool via `(offload f & args)`, parking only the calling process —
;; the BEAM dirty-scheduler shape. Mechanism `%offload` (kernel), policy the
;; prelude wrapper (selective receive on the job token, errors rethrow).
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule offload-test (:use test))

(describe "offload: results round-trip the pool"
  (test "a pure native (%digest) gives the same answer offloaded and direct"
    (let (data (string/->bytes "the brood digs deep")
          direct (%digest :sha256 data)
          pooled (offload %digest :sha256 data))
      (is (bytes? pooled))
      (assert= pooled direct)))
  (test "file IO through the pool: file/spit, file/slurp-bytes, cleanup"
    (let (path (str "/tmp/brood-offload-" (os/now-ns) ".bin")
          payload (bytes 0 255 128 65 7))
      (offload file/spit-bytes path payload)
      (let (back (offload file/slurp-bytes path))
        (file/rm path)
        (assert= back payload)))))

(describe "offload: errors and refusals are clean"
  (test "an error inside the offloaded native rethrows here, catchable"
    (is (= (try (offload file/slurp "/definitely/not/a/file/brood-offload-test") (catch e :caught))
          :caught)))
  (test "a native outside the allow list is refused"
    (is (= (try (%offload bytes/concat [[]]) (catch e :refused)) :refused)))
  (test "a Brood closure is not a native — wrong type"
    (is (= (try (%offload includes? [(list 1) 1]) (catch e :not-native)) :not-native))))

(describe "offload: concurrency & selectivity"
  (test "waiting for the pool is a selective receive — other mail stays queued"
    (send (self) [:decoy :untouched])
    (let (r (offload %digest :sha256 (string/->bytes "x")))
      (is (bytes? r))
      ;; the decoy was not consumed by the offload wait
      (assert= (receive ([:decoy v] v) (after *test-wait-ms* :lost)) :untouched)))
  (test "many processes offload at once; every result is correct"
    (let (parent (self)
          n 8)
      (dotimes (i n)
        (spawn (do
                 (let (data (string/->bytes (str "worker-" i))
                       direct (%digest :sha256 data)
                       pooled (offload %digest :sha256 data))
                   (send parent [:done i (= pooled direct)])))))
      (dotimes (_ n)
        (receive
          ([:done i ok] (is ok))
          (after 10000 (is false)))))))
