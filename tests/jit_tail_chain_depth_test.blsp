;; tests/jit_tail_chain_depth_test.blsp — KI-11: the JIT's tail-chain follow-through
;; must stay inside the native-recursion cap.
;;
;; `jit_run_fast_link` runs a JIT'd callee's native code, then handles its outcome. Three
;; of those outcomes re-enter the evaluator — the outcome-4 tail-chain follow-through
;; (`apply_value`) and the two deopt/preempt re-runs — and all of them run on the
;; `jit_run_fast_link` frame that is *still on the native stack*. The depth counter used
;; to be rolled back before the outcome was handled, so `JIT_NATIVE_DEPTH_LIMIT` stopped
;; bounding anything: a chain of tail-calling delegators oscillated between `depth` and
;; `depth+1` indefinitely while the native stack grew, and the process died of a stack
;; overflow — an abort, so `try`/`catch` could not see it, the crash-dump hook never
;; fired, and no supervisor could restart it (the OS process went, not the green
;; process). Fixed 2026-07-26 by re-raising the depth across each re-entrant call.
;;
;; The shape that triggers it is specific, which is why no existing depth test caught it:
;; a *cycle* of functions where at least one link is a plain tail-call delegator (so the
;; callee's native returns outcome 4) and the cycle is entered from a non-tail position.
;; Plain deep self-recursion — even with a large frame, even mutual, even building a
;; deeply nested value — all stayed under the cap and ran fine to 200,000.
;;
;; Found by JSONTestSuite's 20k-deep documents; `std/json`'s
;; `json-value` -> `json-array` -> `json-array-acc` -> `json-value` is exactly this
;; cycle, with `json-array` as the delegator.

(defmodule jit-tail-chain-depth-test (:use test))

;; The minimal repro. `tc-delegate` is a pure tail-call delegator; `tc-step` enters the
;; cycle from a non-tail position (the result is destructured, so the call cannot be a
;; tail call). Non-tail by construction, so the checker's warning is expected and correct.
(check-allow :non-tail-recursion
  (defn- tc-value (n) (if (= n 0) [0 n] (tc-delegate (- n 1))))
  (defn- tc-delegate (n) (tc-step n))
  (defn- tc-step (n) (let ([v j] (tc-value n)) [(+ v 1) j])))

(describe "KI-11: JIT tail-chain recursion stays bounded"
  :tags
  [:regression]

  ;; The old threshold was between 10,000 and 20,000 levels; 30,000 is comfortably past
  ;; it and still fast. A regression here does not fail the test — it aborts the whole
  ;; test process — so a green run is the whole signal.
  (test "a tail-delegator cycle survives 30,000 non-tail levels"
    (assert= (tc-value 30000) [30000 0]))

  ;; 5,000 levels: comfortably past the 1500-level native cap (so the VM drain path is
  ;; exercised) without paying for the 100,000-level corpus document, which has its own
  ;; `:isolated` test in the JSON conformance runner.
  ;;
  ;; The two halves assert DIFFERENT things, and they have to, because the depth limit is
  ;; ambient. `json-array-acc` recurses through a native callback, so the guard trips on
  ;; *remaining native stack* — which depends on how deep the Rust stack already is when the
  ;; parse starts. A test running in a green process on a worker thread therefore has less
  ;; headroom than the same code at top level. Measured 2026-08-17: a 2000-deep document
  ;; parses fine at top level (3000 does too) and failed inside a full suite run with
  ;; **522672 bytes left against the 524288-byte reserve** — a 1.6 KB margin, i.e. none.
  ;; This test was flaky for exactly that reason: it asserted SUCCESS at a depth where
  ;; success is not guaranteed. "It passed at 2000 on my machine" is not evidence.
  (test "deeply nested JSON is rejected, not fatal"
    ;; Past every cap: must raise a catchable error, never abort the process.
    (let (deep (str (string-repeat "[" 5000)))
      (assert-error (json/parse deep)))
    ;; Past the 1500-level native cap, so the VM drain path is exercised: the contract here
    ;; is only what this test is named for — NOT FATAL. Either outcome is correct; an
    ;; uncaught error escaping, or an abort, is not.
    (let (edge (str (string-repeat "[" 2000) (string-repeat "]" 2000))
          outcome (try
                    (if (vector? (json/parse edge)) :parsed :not-a-vector)
                    (catch e :rejected)))
      (is (or (= outcome :parsed) (= outcome :rejected))))
    ;; Well inside the envelope on any thread: a valid document MUST parse, so the depth
    ;; cap cannot be silently rejecting well-formed input.
    (let (ok (str (string-repeat "[" 800) (string-repeat "]" 800)))
      (is (vector? (json/parse ok)))))

  ;; The shapes that always worked, kept so a future depth change has to keep them
  ;; working — these are the ones that stay on the small-frame native path.
  (test "plain deep non-tail self-recursion still runs deep"
    (check-allow :non-tail-recursion
      (defn- tc-plain (n) (if (= n 0) 0 (+ 1 (tc-plain (- n 1))))))
    (assert= (tc-plain 100000) 100000)))
