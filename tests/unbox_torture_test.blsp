;;; Regression guard for the unboxed register JIT workers (i64 + f64) — the
;;; `jit_lower_i64_arm` path: int-/float-only recursive arms lowered to a register
;;; calling convention (no boxing / roots-staging at the recursive call boundary).
;;;
;;; The suite runs every test through BOTH engines (JIT default-on and the VM,
;;; ADR-076), so each `assert=` below is an automatic JIT-vs-VM differential — it
;;; pins the worker's behaviour on the edges a plain compute test misses:
;;;   • the depth cliff (>1400 native frames → sentinel → deopt to the boxed path)
;;;   • overflow → deopt → VM recompute with BigInt (exact bignum out)
;;;   • ÷0 / i64::MIN÷-1 guards → the VM's exact error
;;;   • multi-arg, `let` binders, rem/quot/bitwise, and the f64 sibling (inf, /).
;;; These edges were fuzzed clean (int+float differential over ~1600 programs);
;;; this file locks the concrete cases into CI.

(defmodule unbox-torture-test (:use test))

;; ---- integer worker ----
;; Every worker below is deliberately *non-tail* recursive — the whole point is
;; to exercise the JIT's recursive-arm lowering and the depth cliff. `check-allow`
;; opts the group out of the (correct, but here intentional) non-tail lint.
; ÷0 at n=0, via `/`
(check-allow :non-tail-recursion
  (defn ut-fib (n) (if (< n 2) n (+ (ut-fib (- n 1)) (ut-fib (- n 2)))))
  (defn ut-deep (n) (if (< n 1) 0 (+ 1 (ut-deep (- n 1)))))
  (defn ut-fact (n) (if (< n 1) 1 (* n (ut-fact (- n 1)))))
  (defn ut-ack (m n)
    (if (< m 1)
      (+ n 1)
      (if (< n 1) (ut-ack (- m 1) 1) (ut-ack (- m 1) (ut-ack m (- n 1))))))
  (defn ut-digsum (n) (if (< n 1) 0 (+ (math/rem n 10) (ut-digsum (math/quot n 10)))))
  (defn ut-xor (n) (if (< n 1) 0 (bit/xor n (ut-xor (- n 1)))))
  (defn ut-let (n) (if (< n 2) n (let (h (math/quot n 2)) (+ (ut-let (- n 1)) (ut-let (- n 2)) h))))
  ; ÷0 at n=0
  (defn ut-div0 (n) (if (< n 0) 0 (+ (math/rem 10 n) (ut-div0 (- n 1)))))
  ; exact `/` stays in the worker
  (defn ut-div (n) (if (< n 1) 1 (/ (* 2 (ut-div (- n 1))) 1)))
  ; inexact `/` deopts to Float
  (defn ut-div-inexact (n) (if (< n 2) n (+ (ut-div-inexact (- n 1)) (/ n 3))))
  (defn ut-div-slash0 (n) (if (< n 0) 0 (+ (/ 10 n) (ut-div-slash0 (- n 1))))))
(describe "unboxed-i64 register worker"
  (test "shallow-wide recursion (fib)"
    (assert= 832040 (ut-fib 30)))

  ; deeper: boxed drains via jit_native_depth
  (test "depth cliff: just under (i64 worker), and over (→ boxed drain) — all correct"
    ; under the 1400 cap: stays in the i64 worker
    (assert= 1399 (ut-deep 1399))
    ; crosses the cap: depth-bail → boxed path
    (assert= 1401 (ut-deep 1401))
    (assert= 2000 (ut-deep 2000)))
  (test "overflow → deopt → VM BigInt (exact)"
    ; 20! still fits i64
    (assert= 2432902008176640000 (ut-fact 20))
    ; 21! first overflow → BigInt
    (assert= 51090942171709440000 (ut-fact 21))
    (assert= 15511210043330985984000000 (ut-fact 25)))

  ;; `:isolated` so this CPU-heavy compute runs ALONE on the runner instead of
  ;; competing with the rest of the ~2700-case suite (fair reduction-scheduling
  ;; would otherwise starve a long CPU-bound green process when thousands are
  ;; runnable). Input is deliberately right-sized: `ack(3,8)` peaks at recursion
  ;; depth ~2045 — already past the JIT's 1400-frame cliff, so it exercises BOTH
  ;; the in-worker register path (`ack(3,6)`, depth 509 < cliff) AND the boxed
  ;; deopt-drain (`ack(3,8)`). `ack(3,10)` was dropped: it adds ~16× wall-clock
  ;; (~45M calls, mostly on the slow drain path) for ZERO extra code-path
  ;; coverage, and pushed a slow shared CI runner past the 120s per-test cap.
  ; crosses the 1400 depth cliff → boxed drain
  (test "multi-arg non-tail recursion (Ackermann)"
    :isolated
    ; stays in the i64 register worker (depth < cliff)
    (assert= 509 (ut-ack 3 6))
    ; ack(3,8) recurses ~2045-deep. Under the VM (the engine that JITs, so the one
    ; this torture case is actually for) that fits the stack budget. The tree-walker
    ; spends more native stack per eval frame and tips ~1.4 KB over the 12 MiB budget,
    ; so run the deep case only on the VM — same guard as observability_test's
    ; engine-specific assertions, and it must accept `BROOD_TIER=0` as well as its
    ; `BROOD_VM=0` alias.
    (when (not (%tree-walker?))
      (assert= 2045 (ut-ack 3 8))))
  ; XOR 1..1000 (1000 ≡ 0 mod 4)
  (test "rem/quot + bitwise in the worker"
    (assert= 15 (ut-digsum 12345))
    (assert= 1000 (ut-xor 1000)))
  (test "let binders carried in SSA vars"
    (assert= 24465 (ut-let 20)))

  (test "÷0 deep in the worker raises the VM's exact error"
    (assert-error (ut-div0 5)))

  ;; Since ADR-196 an inexact int `/` deopts to a RATIO, not a Float — the unboxed i64
  ;; worker still has to bail out of its register, just to a different heap value.
  ;; Verified identical under the JIT, BROOD_NO_JIT=1 and the tree-walker.
  (test "int / : exact stays in the worker, inexact deopts to a ratio, ÷0 is the VM's exact error"
    (assert= (ut-div 10) 1024)
    (assert= (ut-div-inexact 20) 212/3)
    (assert= (->float (ut-div-inexact 20)) 70.66666666666667)
    (assert-error (ut-div-slash0 5))))

;; ---- float sibling ---- (also deliberately non-tail; see the integer group)
(check-allow :non-tail-recursion
  (defn ut-ffib (n) (if (< n 2.0) n (+ (ut-ffib (- n 1.0)) (ut-ffib (- n 2.0)))))
  (defn ut-fpow (b n) (if (< n 1.0) 1.0 (* b (ut-fpow b (- n 1.0)))))
  (defn ut-fdeep (n) (if (< n 1.0) 0.0 (+ 1.0 (ut-fdeep (- n 1.0)))))
  (defn ut-flet (n)
    (if (< n 2.0) n (let (h (/ n 2.0)) (+ (ut-flet (- n 1.0)) (ut-flet (- n 2.0)) h)))))

;; Recursive so it tiers to the float register worker (a flat fn would stay boxed); the
;; division is the last thing it does, on the worker's unboxed f64 path.
(check-allow :non-tail-recursion
  (defn ut-fdiv0 (x d)
    (if (< x 1.0) (/ 1.0 d) (+ (ut-fdiv0 (- x 1.0) d) 1.0))))

(describe "unboxed-f64 register worker"
  (test "float shallow-wide recursion"
    (assert= 17711.0 (ut-ffib 22.0)))

  (test "float multi-arg + division"
    (assert= 1048576.0 (ut-fpow 2.0 20.0)))

  (test "deep float past the cliff → boxed"
    (assert= 2000.0 (ut-fdeep 2000.0)))

  (test "float let bindings"
    (assert= 26555.0 (ut-flet 20.0)))

  ;; Brood's `/` RAISES on a zero divisor; it does not yield IEEE infinity (`prim_div`
  ;; tests `b == 0.0` first). The float worker emitted a bare `fdiv`, so a JIT'd `(/ x 0.0)`
  ;; returned `inf` where every other engine raised — a JIT-only wrong answer, and the
  ;; float sibling of the ÷0 guard the integer path always had.
  (test "float division by zero raises, like the VM"
    (assert= :div0 (try (ut-fdiv0 6.0 0.0) (catch e :div0))))

  ;; `b == 0.0` is true for negative zero too, so the guard must catch it.
  (test "float division by negative zero also raises"
    (assert= :div0 (try (ut-fdiv0 6.0 -0.0) (catch e :div0))))

  (test "a nonzero divisor still divides in registers"
    ;; 1.0/2.0 at the base, then +1.0 once per level for x = 6.0 down to 1.0.
    (assert= 6.5 (ut-fdiv0 6.0 2.0))))
