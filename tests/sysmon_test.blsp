;; The kernel system monitor (`proc/system-monitor` + telemetry `watch-runtime`):
;; runtime events — :spawn / :exit / :gc / :deopt — pushed to one subscriber as
;; `[:system kind subject-pid detail]` messages (the observability event
;; stream's kernel sources).
;;
;; All blocks are :isolated — subscriptions are runtime-global state (one per
;; subscriber pid since ADR-305), so running these concurrently with anything that
;; spawns processes would cross-talk. Each test disarms AND flushes leftover [:system …] events before
;; it ends: an isolated unit's tests share one worker process (= one mailbox),
;; so a backlog from an earlier test would otherwise satisfy a later receive
;; (surfaced by BROOD_GC_STRESS flooding :gc events).
;;
;; (These also pass under BROOD_VM=0 since the TreeWalkGuard fix — a
;; native-nested receive under the tree-walker used to re-run its thunk.)

(defmodule sysmon-test (:use test))

(defn- sysmon-churn (n acc) (if (= n 0) acc (sysmon-churn (- n 1) (cons n acc))))

(defn- sysmon-drain-until (kind subject)
  "Receive [:system …] messages until one matches `kind` about `subject` (or a
5s timeout → :timeout). Other system events are consumed and dropped."
  (receive
    ([:system ^kind ^subject detail] detail)
    ([:system _ _ _] (sysmon-drain-until kind subject))
    (after *test-wait-ms* :timeout)))

(defn- sysmon-wait-disarm (n)
  "Poll until the kernel monitor reads back as nil (the async death-disarm), or
`n` attempts run out. Returns the final config (nil on success)."
  (if (or (nil? (proc/system-monitor)) (= n 0))
    (proc/system-monitor)
    (do (sleep 20) (sysmon-wait-disarm (- n 1)))))

(defn- sysmon-wait-empty (n)
  "Poll until no subscription remains (the async death-disarm), or `n` attempts
run out. Returns the final `:all` listing ([] on success)."
  (if (or (empty? (proc/system-monitor :all)) (= n 0))
    (proc/system-monitor :all)
    (do (sleep 20) (sysmon-wait-empty (- n 1)))))

;; `:quiet` unless a :gc event ABOUT `subject` arrives within `ms`; events about any
;; other process are consumed and ignored (they are stragglers from an earlier,
;; broader subscription — see the threshold test).
(defn- sysmon-quiet-about (subject ms)
  (let (deadline (+ (os/now) ms))
    (receive
      ([:system :gc ^subject _] :got-one)
      ([:system :gc _ _] (sysmon-quiet-about subject (math/max 0 (- deadline (os/now)))))
      (after ms :quiet))))

(defn- sysmon-done ()
  "End-of-test hygiene: disarm, then drain any [:system …] backlog out of this
worker's mailbox so it can't satisfy a later test's receive."
  (proc/system-monitor nil)
  (receive ([:system _ _ _] (sysmon-done)) (after 0 nil)))

(describe "system-monitor arming"
  :isolated (test "read / arm / clear round-trip, previous config returned"
    ; unarmed by default
    (assert= nil (proc/system-monitor))
    ; arm-all: previous was nil
    (assert= nil (proc/system-monitor (self)))
    (let (cfg (proc/system-monitor))
      (assert= (self) (get cfg :pid))
      (assert= true (get cfg :gc))
      (assert= true (get cfg :spawn))
      (assert= true (get cfg :exit))
      (assert= true (get cfg :deopt))
      (assert= 0 (get cfg :gc-min-pause-us)))
    (let (prev (proc/system-monitor nil))
      ; clear returns the old config
      (assert= (self) (get prev :pid)))
    (assert= nil (proc/system-monitor)))

  (test "an opts map selects exactly its truthy keys"
    (proc/system-monitor (self) {:exit true :gc-min-pause-us 250})
    (let (cfg (proc/system-monitor))
      (assert= false (get cfg :gc))
      (assert= false (get cfg :spawn))
      (assert= true (get cfg :exit))
      (assert= false (get cfg :deopt))
      (assert= 250 (get cfg :gc-min-pause-us)))
    (proc/system-monitor nil)))

(describe "system-monitor events"
  :isolated (test "spawn and exit events arrive with pid, parent, and reason"
    (proc/system-monitor (self) {:spawn true :exit true})
    (let (me (self)
          child (spawn :done))
      ; detail = parent pid
      (assert= me (sysmon-drain-until :spawn child))
      (assert= :normal (sysmon-drain-until :exit child)))
    (sysmon-done))

  (test "exit events carry the abnormal structured reason"
    (proc/system-monitor (self) {:exit true})
    (let (child (spawn (error "event stream")))
      (let (reason (sysmon-drain-until :exit child))
        ;; the same [:error {…}] shape monitors and links see
        (assert= :error (first reason))
        (assert= "event stream" (get (first (rest reason)) :message))))
    (sysmon-done))

  (test "gc events report the collection with a pause figure"
    (proc/system-monitor (self) {:gc true})
    (let (worker (spawn (do (sysmon-churn 50000 ()) (dev/gc-collect) :ok)))
      (let (m (sysmon-drain-until :gc worker))
        (is (map? m))
        (is (>= (get m :pause-us) 0))
        (is (> (get m :collections) 0))
        (is (>= (get m :live) 0))))
    (sysmon-done))

  (test "a gc-min-pause-us threshold suppresses cheap collections"
    ;; 10-minute threshold: no minor collection takes that long, so nothing about
    ;; OUR worker may arrive. Wait for the worker to finish, then prove silence.
    ;;
    ;; Pinned to `worker` on purpose. The previous test armed an UNTHRESHOLDED :gc
    ;; subscription, which under a loaded suite reports every collection in the
    ;; runtime; an event that had already passed the subscriber filter when
    ;; `sysmon-done` disarmed lands AFTER its zero-wait drain (the emitter snapshots
    ;; its targets, then delivers — Erlang's system_monitor has the same window), and
    ;; sat in this unit's shared mailbox until this receive took it as `:got-one`
    ;; (seen once in a full run, 2026-09-04). Such a straggler is about some other
    ;; process; `worker` did not exist when the old subscription was live, so an
    ;; event about it can only have come through THIS subscription — which is the
    ;; claim under test.
    (proc/system-monitor (self) {:gc true :gc-min-pause-us 600000000})
    (let (worker (spawn (do (sysmon-churn 50000 ()) (dev/gc-collect) :ok))
          wm (monitor worker))
      (receive ([:down ^wm ^worker _] :ok) (after *test-wait-ms* :timeout))
      (assert= :quiet (sysmon-quiet-about worker 200)))
    (sysmon-done))

  (test "no self-reporting, and the monitor's death disarms the stream"
    ;; a watcher process arms itself, then dies — the kernel must clear the
    ;; config rather than keep charging every event site
    (let (watcher (spawn (do (proc/system-monitor (self)) (receive (:never nil)))))
      ; let it arm
      (sleep 50)
      ;; the read form is the CALLER's subscription — the watcher's shows under :all
      (assert= nil (proc/system-monitor))
      (assert= [watcher] (mapv (proc/system-monitor :all) (fn (c) (get c :pid))))
      (exit watcher :kill)
      (assert= [] (sysmon-wait-empty 100))))

  (test "one subscription per subscriber pid: two coexist, each selecting its own kinds"
    (let (me (self)
          other (spawn (do
                         (proc/system-monitor (self) {:spawn true})
                         (receive ([:system :spawn p _] (send me [:other-saw p])))
                         (receive (:never nil)))))
      (sleep 50)
      (proc/system-monitor me {:exit true})
      (assert= 2 (count (proc/system-monitor :all)))
      (let (child (spawn :done))
        ;; both subscribers hear about the same child, each through its own selection
        (assert= child (receive ([:other-saw p] p) (after *test-wait-ms* :timeout)))
        (assert= child (receive ([:system :exit ^child _] child) (after *test-wait-ms* :timeout))))
      ;; clearing OURS leaves the other's in place; clearing BY PID removes it
      (proc/system-monitor nil)
      (assert= nil (proc/system-monitor))
      (assert= [other] (mapv (proc/system-monitor :all) (fn (c) (get c :pid))))
      (assert= other (get (proc/system-monitor nil other) :pid))
      (assert= [] (proc/system-monitor :all))
      (exit other :kill))
    (sysmon-done))

  (test ":exit-abnormal reports a crash and not a clean exit"
    (proc/system-monitor (self) {:exit-abnormal true})
    (let (cfg (proc/system-monitor))
      (assert= false (get cfg :exit))
      (assert= true (get cfg :exit-abnormal)))
    (let (clean (spawn :done)
          crasher (spawn (error "boom")))
      (assert= :crashed
        (receive
          ([:system :exit ^crasher [:error _]] :crashed)
          ([:system :exit ^clean _] :clean-was-reported)
          (after *test-wait-ms* :timeout)))
      (assert= :quiet (receive ([:system :exit ^clean _] :clean-was-reported) (after 100 :quiet))))
    (sysmon-done)))

(describe "telemetry watch-runtime"
  :isolated (test "kernel events flow through the telemetry seam as [:runtime …] events"
    (telemetry/start)
    (let (me (self))
      (telemetry/attach :t-spawn
        [:runtime :spawn]
        (fn (_ _ md) (send me [:saw :spawn (get md :pid)])))
      (telemetry/attach :t-exit
        [:runtime :exit]
        (fn (_ _ md) (send me [:saw :exit (get md :pid)])))
      (let (watcher (telemetry/watch-runtime {:spawn true :exit true}))
        (let (child (spawn :done))
          (assert= child (receive ([:saw :spawn p] p) (after *test-wait-ms* :timeout)))
          (assert= child (receive ([:saw :exit p] p) (after *test-wait-ms* :timeout))))
        (telemetry/stop-watch-runtime watcher)
        ;; stopping the watcher disarms the kernel monitor
        (assert= nil (sysmon-wait-disarm 100)))
      (telemetry/detach :t-spawn)
      (telemetry/detach :t-exit)
      (telemetry/stop))))
