;; The kernel system monitor (`system-monitor` + telemetry `watch-runtime`):
;; runtime events — :spawn / :exit / :gc / :deopt — pushed to one subscriber as
;; `[:system kind subject-pid detail]` messages (the observability event
;; stream's kernel sources).
;;
;; All blocks are :isolated — the monitor is a runtime-global singleton, so
;; running these concurrently with anything that spawns processes would
;; cross-talk. Each test disarms AND flushes leftover [:system …] events before
;; it ends: an isolated unit's tests share one worker process (= one mailbox),
;; so a backlog from an earlier test would otherwise satisfy a later receive
;; (surfaced by BROOD_GC_STRESS flooding :gc events).
;;
;; Engine note: under the legacy tree-walker (BROOD_VM=0) an :isolated test that
;; parks in `receive` misbehaves in the runner (pre-existing framework
;; limitation — tests/maps_test.blsp hangs the same way there); the suite's
;; supported engine is the VM, where all of these pass, GC_STRESS included.

(defmodule sysmon-test (:use test))

(defn sysmon--churn (n acc) (if (= n 0) acc (sysmon--churn (- n 1) (cons n acc))))

(defn sysmon--drain-until (kind subject)
  "Receive [:system …] messages until one matches `kind` about `subject` (or a
5s timeout → :timeout). Other system events are consumed and dropped."
  (receive
    ([:system ~kind ~subject detail] detail)
    ([:system _ _ _] (sysmon--drain-until kind subject))
    (after 5000 :timeout)))

(defn sysmon--wait-disarm (n)
  "Poll until the kernel monitor reads back as nil (the async death-disarm), or
`n` attempts run out. Returns the final config (nil on success)."
  (if (or (nil? (system-monitor)) (= n 0))
    (system-monitor)
    (do (sleep 20) (sysmon--wait-disarm (- n 1)))))

(defn sysmon--done ()
  "End-of-test hygiene: disarm, then drain any [:system …] backlog out of this
worker's mailbox so it can't satisfy a later test's receive."
  (system-monitor nil)
  (receive ([:system _ _ _] (sysmon--done)) (after 0 nil)))

(describe "system-monitor arming" :isolated
  (test "read / arm / clear round-trip, previous config returned"
    (assert= nil (system-monitor))               ; unarmed by default
    (assert= nil (system-monitor (self)))        ; arm-all: previous was nil
    (let (cfg (system-monitor))
      (assert= (self) (get cfg :pid))
      (assert= true (get cfg :gc))
      (assert= true (get cfg :spawn))
      (assert= true (get cfg :exit))
      (assert= true (get cfg :deopt))
      (assert= 0 (get cfg :gc-min-pause-us)))
    (let (prev (system-monitor nil))             ; clear returns the old config
      (assert= (self) (get prev :pid)))
    (assert= nil (system-monitor)))

  (test "an opts map selects exactly its truthy keys"
    (system-monitor (self) {:exit true :gc-min-pause-us 250})
    (let (cfg (system-monitor))
      (assert= false (get cfg :gc))
      (assert= false (get cfg :spawn))
      (assert= true (get cfg :exit))
      (assert= false (get cfg :deopt))
      (assert= 250 (get cfg :gc-min-pause-us)))
    (system-monitor nil)))

(describe "system-monitor events" :isolated
  (test "spawn and exit events arrive with pid, parent, and reason"
    (system-monitor (self) {:spawn true :exit true})
    (let (me    (self)
          child (spawn :done))
      (assert= me (sysmon--drain-until :spawn child))  ; detail = parent pid
      (assert= :normal (sysmon--drain-until :exit child)))
    (sysmon--done))

  (test "exit events carry the abnormal structured reason"
    (system-monitor (self) {:exit true})
    (let (child (spawn (error "event stream")))
      (let (reason (sysmon--drain-until :exit child))
        ;; the same [:error {…}] shape monitors and links see
        (assert= :error (first reason))
        (assert= "event stream" (get (first (rest reason)) :message))))
    (sysmon--done))

  (test "gc events report the collection with a pause figure"
    (system-monitor (self) {:gc true})
    (let (worker (spawn (do (sysmon--churn 50000 ()) (gc-collect) :ok)))
      (let (m (sysmon--drain-until :gc worker))
        (is (map? m))
        (is (>= (get m :pause-us) 0))
        (is (> (get m :collections) 0))
        (is (>= (get m :live) 0))))
    (sysmon--done))

  (test "a gc-min-pause-us threshold suppresses cheap collections"
    ;; 10-minute threshold: no minor collection takes that long, so nothing
    ;; may arrive. Wait for the worker to finish, then prove silence.
    (system-monitor (self) {:gc true :gc-min-pause-us 600000000})
    (let (worker (spawn (do (sysmon--churn 50000 ()) (gc-collect) :ok))
          wm     (monitor worker))
      (receive ([:down ~wm ~worker _] :ok) (after 5000 :timeout))
      (assert= :quiet (receive ([:system :gc _ _] :got-one) (after 200 :quiet))))
    (sysmon--done))

  (test "no self-reporting, and the monitor's death disarms the stream"
    ;; a watcher process arms itself, then dies — the kernel must clear the
    ;; config rather than keep charging every event site
    (let (watcher (spawn (do (system-monitor (self)) (receive (:never nil)))))
      (sleep 50)                                 ; let it arm
      (assert= watcher (get (system-monitor) :pid))
      (exit watcher :kill)
      (assert= nil (sysmon--wait-disarm 100)))))

(describe "telemetry watch-runtime" :isolated
  (test "kernel events flow through the telemetry seam as [:runtime …] events"
    (require 'telemetry)
    (telemetry/start-telemetry)
    (let (me (self))
      (telemetry/attach :t-spawn [:runtime :spawn]
        (fn (_ _ md) (send me [:saw :spawn (get md :pid)])))
      (telemetry/attach :t-exit [:runtime :exit]
        (fn (_ _ md) (send me [:saw :exit (get md :pid)])))
      (let (watcher (telemetry/watch-runtime {:spawn true :exit true}))
        (let (child (spawn :done))
          (assert= child (receive ([:saw :spawn p] p) (after 5000 :timeout)))
          (assert= child (receive ([:saw :exit p] p) (after 5000 :timeout))))
        (telemetry/stop-watch-runtime watcher)
        ;; stopping the watcher disarms the kernel monitor
        (assert= nil (sysmon--wait-disarm 100)))
      (telemetry/detach :t-spawn)
      (telemetry/detach :t-exit)
      (telemetry/stop-telemetry))))
