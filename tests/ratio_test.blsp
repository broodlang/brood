;;; Exact rational numbers (`std/ratio.blsp`) — a Brood-first prototype for the
;;; freeze-list `ratios` row (ADR-070). A ratio is a `defrecord` that does
;;; arithmetic via the `Num` ability, orders via `Ord`/`compare-to`, and prints via
;;; `Display`. See the module docstring for the prototype's deliberate limits (no
;;; `1/2` literal, not `=` to an equal int, no `pr-str` round-trip — all of which
;;; need a kernel `Value::Ratio`).

(defmodule ratio-test (:use test) (:use ratio))

(describe "ratio: construction"
  (test "reduces to lowest terms and carries a positive denominator"
    (assert= (to-str (rational 1 2)) "1/2")
    (assert= (to-str (rational 4 2)) "2/1")     ; reduced
    (assert= (to-str (rational 6 3)) "2/1")
    (assert= (to-str (rational 1 -2)) "-1/2")   ; sign moved onto the numerator
    (assert= (to-str (rational -2 -4)) "1/2")
    (assert= (to-str (rational 0 5)) "0/1"))
  (test "ratio? recognises ratios and nothing else"
    (is (ratio? (rational 1 2)))
    (is (not (ratio? 3)))
    (is (not (ratio? {:num 1 :den 2}))))       ; a plain map is not a ratio
  (test "a zero denominator is a loud error"
    (let (e (try (rational 1 0) (catch e (error-message e))))
      (is (includes? e "denominator is zero")))))

(describe "ratio: arithmetic via +/-/*//"
  (test "ratio ∘ ratio"
    (assert= (to-str (+ (rational 1 2) (rational 1 3))) "5/6")
    (assert= (to-str (+ (rational 1 2) (rational 1 2))) "1/1")   ; result reduces
    (assert= (to-str (- (rational 3 4) (rational 1 4))) "1/2")
    (assert= (to-str (* (rational 2 3) (rational 3 4))) "1/2")
    (assert= (to-str (/ (rational 1 2) (rational 3 4))) "2/3"))
  (test "ratio ∘ int, both directions"
    (assert= (to-str (+ (rational 1 2) 2)) "5/2")
    (assert= (to-str (+ 2 (rational 1 2))) "5/2")    ; :commutative mirror
    (assert= (to-str (- (rational 1 2) 1)) "-1/2")
    (assert= (to-str (- 1 (rational 1 3))) "2/3")    ; int − ratio (explicit method)
    (assert= (to-str (* (rational 1 2) 3)) "3/2")
    (assert= (to-str (* 3 (rational 1 2))) "3/2")    ; mirror
    (assert= (to-str (/ (rational 5 6) 5)) "1/6")
    (assert= (to-str (/ 1 (rational 2 3))) "3/2"))   ; int / ratio (explicit method)
  (test "variadic + folds through the same dispatch"
    (assert= (to-str (+ (rational 1 2) (rational 1 3) (rational 1 6))) "1/1"))
  (test "a ratio and float pair has no method — a loud no-method error"
    (let (e (try (+ (rational 1 2) 1.5) (catch e e)))
      (assert= (get e :kind) :no-method))))

(describe "ratio: ordering + equality"
  (test "compares by value (cross-multiplied)"
    (is (< (rational 1 3) (rational 1 2)))
    (is (> (rational 3 4) (rational 5 7)))       ; 0.75 > 0.714…
    (is (<= (rational 1 2) (rational 2 4)))
    (is (< (rational 1 3) 1))                     ; ratio vs int
    (is (> 1 (rational 1 3))))                    ; :antisymmetric mirror
  (test "sort orders ratios by value"
    (assert= (map to-str (sort (list (rational 3 4) (rational 1 2) (rational 2 3))))
      (list "1/2" "2/3" "3/4")))
  (test "two reduced-equal ratios are structurally = (and hash together)"
    (is (= (rational 2 4) (rational 1 2)))
    (is (= (rational 6 3) (rational 2 1)))
    ;; ...but a ratio is NOT = to an equal integer (prototype limit — needs a kernel type)
    (is (not (= (rational 4 2) 2)))))

(describe "ratio: conversion"
  (test "ratio->float is the inexact value"
    (assert= (ratio->float (rational 1 4)) 0.25)
    (assert= (ratio->float (rational 3 2)) 1.5)))

;; ---- across processes -------------------------------------------------------
;; A ratio is a record, so it deep-copies + re-interns its id across per-process
;; heaps on a `send`. Build it in a worker, send it home, and confirm it is still a
;; valid ratio whose arithmetic/ordering still dispatch after the round-trip.

(defn ratio-worker (parent) (send parent (+ (rational 1 2) (rational 1 3))))

(describe "ratio: across processes"
  :isolated
  (test "a ratio built in another process round-trips a send, methods intact"
    (let (me (self) _ (spawn (ratio-worker me)))
      (let (r (receive))
        (is (ratio? r))
        (assert= (to-str r) "5/6")
        (assert= (to-str (* r 6)) "5/1")          ; arithmetic still dispatches
        (is (< r (rational 1 1)))))))              ; ordering still dispatches
