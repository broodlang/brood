(defmodule proc/hibernate-test (:use test))

(describe "proc/hibernate"
  (test "returns a byte count and leaves the process working"
    ;; A process that allocated, then hibernates, must still compute correctly —
    ;; the caches it dropped are rebuilt on the next call.
    (let (before (fold (range 200) 0 +)
          freed (proc/hibernate)
          after (fold (range 200) 0 +))
      (assert= before 19900)
      (assert= after 19900)
      (is (>= freed 0))))

  (test "survives across a receive and keeps identity"
    (let (me (self))
      (spawn (do (proc/hibernate) (send me [:ok (self)])))
      (receive ([:ok p] (is (not (nil? p)))))))

  (test "a hibernated process still answers messages"
    (let (me (self)
          worker (spawn (receive
                          ([:go n] (do (proc/hibernate) (send me [:sum (fold (range n) 0 +)]))))))
      (send worker [:go 100])
      (assert= (receive ([:sum v] v)) 4950))))
