;; The fold-leaks-failure lint: a `reduce`/`fold` whose step can return a failure hands
;; one back as the NEXT step's accumulator. Unless the callback answers for that case,
;; a later element runs against a failure — in the motivating bug, `(conj <failure> x)`,
;; which raises. `(calc "1 q")` returned a failure and looked fine; `(calc "1 q 2")` blew up.
;;
;; The checker had already discovered this and thrown it away: its accumulator fixpoint
;; failed to stabilise, which is precisely the symptom, and it silently widened the result
;; to `any` instead of saying so.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule fold-failure-lint-test (:use test) (:use seq))

(defn- fold-warnings (src)
  (count (keep (or (reflect/check-string-structured src) [])
           (fn (d)
             (if (string/starts-with? (get d :message) "reduce: the callback can return a failure")
               d
               nil)))))

(describe "checker: a fold whose step can fail but does not handle a failed accumulator"
  (test "an inline callback that can return a failure is reported"
    (assert= (fold-warnings "(reduce xs '() (fn (acc n) (if (number? n) (conj acc n) (failure \"bad\"))))")
      1))

  (test "a callback that cannot fail is not reported"
    (assert= (fold-warnings "(reduce xs '() (fn (acc n) (conj acc n)))") 0))

  (test "a callback that guards on failure? is not reported"
    ;; the fix the warning recommends must not itself warn — the analysis types EVERY
    ;; clause against the widened accumulator, including ones a guard excludes, so an
    ;; unstable fixpoint alone would flag the guarded program too
    (assert= (fold-warnings "(reduce xs '() (fn (acc n) (if (failure? acc) acc (conj acc n))))")
      0))

  (test "a clause-guarded callback is not reported either"
    (assert= (fold-warnings "(reduce xs '() (fn ((acc _) :when (failure? acc) acc) ((acc n) (conj acc n))))")
      0))

  (test "a callback passed by NAME is out of scope"
    ;; its body is not in hand at the call site, and guessing from the inferred arrow
    ;; reproduced the false positive this lint exists to avoid
    (assert= (fold-warnings "(reduce xs '() step)") 0)))
