;; A cursor steps by grapheme cluster (ADR-422). Every case is built on a DECOMPOSED `e` +
;; U+0301 and a ZWJ family sequence, where clusters and code points genuinely differ — a
;; precomposed é would pass while proving nothing (ADR-159's trap).

(defmodule grapheme-cursor-test (:use test))

(def- fam "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}")
;; clusters start at code points 0 (a), 1 (é), 3 (the family), 8 (z); the length is 9
(def- sample (str "ae\u{301}" fam "z"))

(describe "the rope and string boundaries"
  (test "next and previous boundaries cross whole clusters, on a rope"
    (let (r (text/string-> sample))
      (assert= '(1 3 8 9) (map [0 1 3 8] (fn (i) (text/next-grapheme r i))))
      (assert= '(0 1 3 8) (map [1 3 8 9] (fn (i) (text/prev-grapheme r i))))
      (assert= 9 (text/next-grapheme r 9))
      (assert= 0 (text/prev-grapheme r 0))
      (assert= 8 (text/forward-graphemes r 0 3))
      (assert= 1 (text/backward-graphemes r 9 3))))
  (test "the same on a string, clamped at both ends"
    (assert= 3 (string/next-grapheme sample 1))
    (assert= 1 (string/prev-grapheme sample 3))
    (assert= 9 (string/next-grapheme sample 99))
    (assert= 0 (string/prev-grapheme sample -4))))

(describe "the editor never splits a cluster"
  (test "buffer motion steps over a whole cluster"
    (let (b (editor/buffer/goto-char (editor/buffer/make-buffer sample) 1))
      (assert= 3 (editor/buffer/buffer-point (editor/buffer/forward-char b)))
      (assert= 8 (editor/buffer/buffer-point (editor/buffer/forward-char b 2)))
      (assert= 1
        (editor/buffer/buffer-point (editor/buffer/backward-char (editor/buffer/goto-char b 8) 2)))))
  (test "buffer deletion removes a whole cluster"
    (let (b (editor/buffer/goto-char (editor/buffer/make-buffer sample) 1))
      (assert= (str "a" fam "z") (editor/buffer/buffer-text (editor/buffer/delete-char b)))
      (assert= "ae\u{301}z"
        (editor/buffer/buffer-text (editor/buffer/delete-backward-char (editor/buffer/goto-char b 8))))))
  (test "the line editor moves and deletes by cluster"
    (let (st (editor/lineedit/lineedit-insert (editor/lineedit/lineedit-init "" []) "xe\u{301}"))
      (assert= 1 (get (editor/lineedit/lineedit-backward-char st nil) :point))
      (assert= "x" (get (editor/lineedit/lineedit-delete-backward st nil) :text)))))

(describe "cluster steps across processes"
  ;; a rope is heap-local and does not cross processes: each worker builds its own from the text
  :isolated (test "workers step their own rope of the same text and agree"
    (let (me (self)
          text (string/join (map (range 50) (fn (_) sample)) ""))
      (doseq (w (range 4))
        (spawn (fn () (send me [w (text/forward-graphemes (text/string-> text) 0 (* 4 (+ w 1)))]))))
      (let (got (fold (range 4) {} (fn (acc _) (receive ([w at] (assoc acc w at))))))
        (doseq (w (range 4))
          ;; every four clusters is one `sample` of nine code points
          (assert= (* 9 (+ w 1)) (get got w)))))))
