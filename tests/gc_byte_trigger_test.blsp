;; The collector's byte trigger (KI-307). A collection used to be due only when a process
;; had made enough OBJECTS, but one object can own any number of bytes: 150 vectors of 40 000
;; elements are a few hundred objects and ~144 MB of element arrays. Below the object floor no
;; collection ran at all, and a loop doing that repeatedly (a `conj` loop, before ADR-511
;; made `conj` append in place) reached 12 GB resident in three seconds and starved the
;; processes beside it of memory bandwidth. A collection is now also due once a process has made
;; enough fresh buffer bytes — spilled vectors, string text, byte blobs.
;;
;; Each case counts its own process's collections around a loop whose object count can
;; trigger at most one (the floor is 4096 objects at its lowest, under the suite's
;; fan-out), so two or more can only come from the bytes.

(defmodule gc-byte-trigger-test (:use test))

(defn collections ()
  (get (dev/gc-stats) :collections))

;; n vectors of `size` elements, 24 bytes each, built and dropped; the total of their counts.
;; Built by the kernel append straight from a range, which makes the one vector and nothing
;; else: `vec` walks the range into a list first, and those cells alone would cross the
;; object floor, so the case could not tell which trigger fired.
(defn big-vectors (n size)
  (fold (range n) 0 (fn (acc _) (+ acc (count (%vector-concat [] (range size)))))))

;; A string grown one `str` at a time: n strings of up to 10·n bytes.
(defn str-build (n)
  (fold (range n) "" (fn (acc _) (str acc "0123456789"))))

(describe "a collection is due on the bytes a process makes, not only its object count"
  (test "large vectors built and dropped collect as they pile up"
    (let (before (collections)
          total (big-vectors 150 40000)
          after (collections))
      (do
        (assert= total 6000000)
        (assert (>= (- after before) 2)))))

  (test "a string grown by str collects as its dead copies pile up"
    (let (before (collections)
          built (str-build 3000)
          after (collections))
      (do
        (assert= (count built) 30000)
        (assert (>= (- after before) 2))))))

(describe "the byte trigger across processes"
  :isolated (test "workers building large vectors at once each collect on their own bytes"
    (let (parent (self)
          workers (map (range 4)
                    (fn (k)
                      (spawn (fn ()
                               (let (before (collections)
                                     total (big-vectors 150 (+ 40000 k))
                                     after (collections))
                                 (send parent
                                   {:worker k :total total :collections (- after before)}))))))
          replies (map workers
                    (fn (_) (receive ({:worker k :total t :collections n} [k t n])))))
      (do
        (assert= (count replies) 4)
        (assert (every? replies (fn ([k t n]) (and (= t (* 150 (+ 40000 k))) (>= n 2)))))))))
