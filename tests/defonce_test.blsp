;; `defonce` must be a no-op on a second definition of an ALREADY-BOUND name — including a
;; module-level one. The bug it regressed: `defonce` expanded to `(bound? '*x*)`, and a bare
;; quoted symbol is not rewritten to the module namespace, so the check read at ROOT (always
;; unbound) and re-`def`d every time. Fixed by resolving the name against the loading module
;; (`%defonce-qualified-name`). This regressed real registries wiped on an imaged start (ADR-218).

(defmodule defonce-test (:use test))

;; Two defonce forms at load. If defonce works, the second SEES the first's binding
;; (module-qualified) and is a no-op; *dx* stays :first. If it read at root, it would re-def.
(defonce *dx* :first)
(defonce *dx* :second)

;; A plain second `def` DOES overwrite — the contrast that proves defonce is doing the guard.
(def *dy* :first)
(def *dy* :second)

(describe "defonce (module-level)"
  (test "a second defonce of a bound module var is a no-op"
    (assert= *dx* :first)) ; not :second — the second defonce saw *dx* already bound
  (test "…whereas a plain def overwrites (the contrast)"
    (assert= *dy* :second))
  (test "%defonce-qualified-name prefixes the current module, passes bare/qualified through"
    ;; at runtime current-ns is nil, so a bare name passes through unchanged…
    (assert= (%defonce-qualified-name '*z*) '*z*)
    ;; …and an already-qualified one is never doubled
    (assert= (%defonce-qualified-name 'foo/*z*) 'foo/*z*)))
