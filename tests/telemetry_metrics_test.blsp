;; std/telemetry.blsp metric aggregators — the Elixir Telemetry.Metrics folded in
;; Brood over the ADR-106 attach seam: counter / sum / last-value (gauge) / summary
;; (running count/mean/stddev/min/max) + every-Nth sampling. State lives in a shared
;; `table` (ADR-107); folds run serially in the one listener process.
;;
;; :isolated — each block starts/stops its own listener, resets the metrics table,
;; and detach-all's, so the shared handler + metrics globals don't race. Bodies stay
;; tail-recursive (small green-process stack). Register-only — `nest test` finds it.

;; `:use-internals telemetry` grants the node-liveness tests access to the private
;; diff helpers (`telemetry-absent`) — the ADR-146 @testable seam.
(defmodule telemetry-metrics-test
  (:use test)
  (:use telemetry)
  (:use-internals telemetry)
  (:use math :only [abs]))

(defn tmm-emit-n (event m n)
  "Emit `event` with measurements `m`, `n` times (tail-recursive)."
  (when (> n 0) (emit event m) (tmm-emit-n event m (- n 1))))

(describe "telemetry metrics: counter / sum / gauge"
  :isolated (test "counter tallies each emit of its event"
    (start)
    (detach-all)
    (reset-metrics)
    (counter :c [:http :req])
    (tmm-emit-n [:http :req] {} 5)
    ; a different event is not counted
    (emit [:other] {})
    (sync)
    (let (got (metric :c))
      (stop)
      (assert= (get got :count) 5)
      (assert= (get got :kind) :counter)))

  (test "sum adds a measurement across emits (float-safe)"
    (start)
    (detach-all)
    (reset-metrics)
    (sum :s [:pay] :amount)
    (emit [:pay] {:amount 1.5})
    (emit [:pay] {:amount 2.25})
    (emit [:pay] {:amount 0.25})
    (sync)
    (let (got (metric :s))
      (stop)
      (assert= (get got :sum) 4.0)))

  (test "last-value keeps the latest measurement (a gauge)"
    (start)
    (detach-all)
    (reset-metrics)
    (last-value :g [:pool] :inflight)
    (emit [:pool] {:inflight 3})
    (emit [:pool] {:inflight 7})
    (emit [:pool] {:inflight 2})
    (sync)
    (let (got (metric :g))
      (stop)
      (assert= (get got :value) 2)
      (assert= (get got :kind) :gauge)))

  (test "metric is nil before its event has fired"
    (start)
    (detach-all)
    (reset-metrics)
    (counter :never [:nope])
    (sync)
    (let (got (metric :never))
      (stop)
      (is (nil? got)))))

(describe "telemetry metrics: summary (running statistics)"
  :isolated (test "count / sum / min / max / mean / stddev over a fold"
    (start)
    (detach-all)
    (reset-metrics)
    (summary :lat [:http :req] :duration)
    (emit [:http :req] {:duration 10})
    (emit [:http :req] {:duration 20})
    (emit [:http :req] {:duration 30})
    (sync)
    (let (got (metric :lat))
      (stop)
      (assert= (get got :count) 3)
      (assert= (get got :sum) 60)
      (assert= (get got :min) 10)
      (assert= (get got :max) 30)
      (assert= (get got :mean) 20)
      ;; variance = (100+400+900)/3 - 20^2 = 66.666…, stddev ≈ 8.165
      (is (< (abs (- (get got :stddev) 8.16496580927726)) 0.0001))))

  (test "a single sample has stddev 0"
    (start)
    (detach-all)
    (reset-metrics)
    (summary :one [:e] :v)
    (emit [:e] {:v 42})
    (sync)
    (let (got (metric :one))
      (stop)
      (assert= (get got :count) 1)
      (assert= (get got :mean) 42)
      (assert= (get got :stddev) 0.0))))

; nil for an unknown / non-distribution metric
(describe "telemetry metrics: distribution (bucketed histogram)"
  :isolated (test "buckets by upper bound, with an overflow bucket"
    (start)
    (detach-all)
    (reset-metrics)
    (distribution :d [:http :req] :duration [10 50 100])
    ;; 5→≤10, 10→≤10, 30→≤50, 75→≤100, 200→overflow
    (emit [:http :req] {:duration 5})
    (emit [:http :req] {:duration 10})
    (emit [:http :req] {:duration 30})
    (emit [:http :req] {:duration 75})
    (emit [:http :req] {:duration 200})
    (sync)
    (let (got (metric :d))
      (stop)
      (assert= (get got :kind) :distribution)
      (assert= (get got :count) 5)
      (assert= (get got :sum) 320)
      (assert= (get got :min) 5)
      (assert= (get got :max) 200)
      (assert= (get got :mean) 64)
      (let (bs (get got :buckets))
        (assert= (count bs) 4)
        (assert= (get (nth bs 0) :le) 10)
        (assert= (get (nth bs 0) :count) 2)
        (assert= (get (nth bs 1) :le) 50)
        (assert= (get (nth bs 1) :count) 1)
        (assert= (get (nth bs 2) :le) 100)
        (assert= (get (nth bs 2) :count) 1)
        (assert= (get (nth bs 3) :le) :inf)
        (assert= (get (nth bs 3) :count) 1))))

  (test "unsorted buckets are normalized to ascending"
    (start)
    (detach-all)
    (reset-metrics)
    (distribution :d [:e] :v [100 10 50])
    (emit [:e] {:v 5})
    (sync)
    (let (bs (get (metric :d) :buckets))
      (stop)
      (assert= (get (nth bs 0) :le) 10)
      (assert= (get (nth bs 0) :count) 1)))

  (test "metric-percentile estimates a quantile by bucket interpolation"
    (start)
    (detach-all)
    (reset-metrics)
    (distribution :d [:e] :v [10 20 30])
    ;; 5× at 5 (→≤10 bucket), 5× at 15 (→≤20 bucket): b0=5, b1=5
    (tmm-emit-n [:e] {:v 5} 5)
    (tmm-emit-n [:e] {:v 15} 5)
    (sync)
    (let (p50 (metric-percentile :d 0.5)
          p90 (metric-percentile :d 0.9)
          none (metric-percentile :nope 0.5))
      (stop)
      ;; rank 5 lands at b0's top edge → 10; rank 9 is 4/5 into b1 [10,20] → 18
      (is (< (abs (- p50 10)) 0.0001))
      (is (< (abs (- p90 18)) 0.0001))
      (is (nil? none)))))
(describe "telemetry metrics: snapshot & sampling"
  :isolated (test "metrics-snapshot returns every metric's reader value"
    (start)
    (detach-all)
    (reset-metrics)
    (counter :a [:e])
    (summary :b [:e] :v)
    (emit [:e] {:v 5})
    (emit [:e] {:v 15})
    (sync)
    (let (snap (metrics-snapshot))
      (stop)
      (assert= (into [] (sort (keys snap))) [:a :b])
      (assert= (get (get snap :a) :count) 2)
      (assert= (get (get snap :b) :mean) 10)))

  (test "sample-every folds only every nth event"
    (let (me (self))
      (start)
      (detach-all)
      (reset-metrics)
      ;; the wrapped handler forwards `:fired` only on every 3rd emit
      (attach :s [:hot] (sample-every :s 3 (fn (e m md) (send me :fired))))
      ; 10 emits → the 3rd/6th/9th fire = 3
      (tmm-emit-n [:hot] {} 10)
      (sync)
      (let (n (tmm-drain 0))
        (stop)
        (assert= n 3)))))

;; Count `:fired` messages already in the mailbox (sync has flushed the
;; listener, so every fire's send has landed) until a short quiet gap.
(defn tmm-drain (n) (receive (:fired (tmm-drain (+ n 1))) (after 150 n)))

(describe "telemetry metrics: across processes"
  :isolated (test "concurrent emitters aggregate into one counter (serial listener)"
    (start)
    (detach-all)
    (reset-metrics)
    (counter :total [:tick])
    (let (me (self))
      ;; four workers each emit 25 ticks; the listener folds all 100 serially.
      (tmm-spawn-emitters me 4 25)
      (tmm-await 4))
    (sync)
    (let (got (metric :total))
      (stop)
      (assert= (get got :count) 100))))

(defn tmm-spawn-emitters (parent workers per)
  (when (> workers 0)
    (spawn (do (tmm-emit-n [:tick] {} per) (send parent :done)))
    (tmm-spawn-emitters parent (- workers 1) per)))
(defn tmm-await (n)
  (if (= n 0) :ok (receive (:done (tmm-await (- n 1))) (after *test-wait-ms* :timeout))))

;; Node up/down through the telemetry stream (`watch-nodes`). A live two-node
;; cluster is exercised by the dist suite; here we test the deterministic core —
;; the peer-set diff and the `[:runtime :nodeup]`/`[:runtime :nodedown]` emit seam
;; `watch-nodes` polls into — plus the watcher lifecycle on a single node.

(defn tnode-drain (acc) (receive (m (tnode-drain (cons m acc))) (after 150 (reverse acc))))

(describe "telemetry: node liveness (watch-nodes)"
  :isolated
  ; :b gone
  (test "absent computes the added / removed peers of two peer sets"
    ; added
    (assert= (into [] (telemetry/telemetry-absent '(:a :b :c) '(:a))) [:b :c])
    ; none removed
    (assert= (empty? (telemetry/telemetry-absent '(:a) '(:a :b))) true)
    (assert= (into [] (telemetry/telemetry-absent '(:a :b) '(:a :c))) [:b]))
  (test "a membership change re-emits [:runtime :nodeup]/[:runtime :nodedown]"
    (let (me (self))
      (start)
      (detach-all)
      (attach :up [:runtime :nodeup] (fn (e m md) (send me [:up (get md :node)])))
      (attach :down [:runtime :nodedown] (fn (e m md) (send me [:down (get md :node)])))
      ;; poll 1 — known {:a}, current {:a :b}: :b appears (up = current∖known)
      (dolist (n (telemetry/telemetry-absent '(:a :b) '(:a)))
        (emit [:runtime :nodeup] {} {:node n}))
      (dolist (n (telemetry/telemetry-absent '(:a) '(:a :b)))
        (emit [:runtime :nodedown] {} {:node n}))
      ;; poll 2 — known {:a :b}, current {:a}: :b vanishes (down = known∖current)
      (dolist (n (telemetry/telemetry-absent '(:a) '(:a :b)))
        (emit [:runtime :nodeup] {} {:node n}))
      (dolist (n (telemetry/telemetry-absent '(:a :b) '(:a)))
        (emit [:runtime :nodedown] {} {:node n}))
      (sync)
      (let (got (into [] (tnode-drain '())))
        (stop)
        (assert= got [[:up :b] [:down :b]]))))

  (test "watch-nodes starts and stops cleanly with no spurious events (single node)"
    (let (me (self))
      (start)
      (detach-all)
      (attach :any [:runtime :nodeup] (fn (e m md) (send me :spurious)))
      (let (w (watch-nodes 20))
        (check-allow :type-mismatch
          (is (not (nil? w))))
        ; several poll cycles, no peers → no emits
        (sleep 80)
        (stop-watch-nodes w))
      (sync)
      (let (spurious (receive (:spurious true) (after 100 false)))
        (stop)
        (is (not spurious))))))

;; ---- defevent — typed emitter + declared schema (checker-validated) ----------
;; A declared event (module level, so the emitter fn exists). The checker validates
;; `(tmm-req-stop …)` calls via the emitted `sig`; these tests cover the runtime half.
(defevent tmm-req-stop
  [:tmm :req :stop]
  :measurements ((duration int))
  :metadata ((path string)))

(describe "defevent — the typed emitter"
  :isolated (test "the emitter emits its event with the declared measurement/metadata maps"
    (reset-metrics)
    (detach-all)
    (start)
    (let (box (table/new))
      (attach :cap [:tmm :req :stop] (fn (e m md) (table/put box :got {:e e :m m :md md})))
      (tmm-req-stop 15 "/x")
      (sync)
      (let (got (table/get box :got))
        (assert= [:tmm :req :stop] (get got :e))
        (assert= {:duration 15} (get got :m))
        (assert= {:path "/x"} (get got :md))))
    (detach-all)
    (stop)))

(describe "defevent — the schema registry"
  (test "the schema is registered for introspection"
    (let (s (event-schema [:tmm :req :stop]))
      (assert= 'tmm-req-stop (get s :name))
      (assert= {:duration 'int} (get s :measurements))
      (assert= {:path 'string} (get s :metadata))))
  (test "an undeclared event has no schema"
    (assert= nil (event-schema [:not :declared]))))

(describe "defevent — runtime presence-check (pure)"
  (test "telemetry-check-event reports each missing declared key by kind"
    ;; complete payload → no problems
    (assert= nil (telemetry/telemetry-check-event [:tmm :req :stop] {:duration 1} {:path "/"}))
    ;; missing measurement key
    (assert= (list [:measurements :duration])
      (telemetry/telemetry-check-event [:tmm :req :stop] {} {:path "/"}))
    ;; missing both
    (assert= (list [:measurements :duration] [:metadata :path])
      (telemetry/telemetry-check-event [:tmm :req :stop] {} {})))
  (test "an undeclared event never reports a problem"
    (assert= nil (telemetry/telemetry-check-event [:undeclared] {} {})))
  (test "validate flips the listener flag"
    (validate true)
    (assert= true *telemetry-validate*)
    (validate false)
    (assert= false *telemetry-validate*)))

;; ---- unified runtime vitals (snapshot builtins → one stream) -----------------
(describe "telemetry — runtime-snapshot + watch-vitals"
  :isolated (test "runtime-snapshot folds the stat builtins into one map"
    (let (snap (runtime-snapshot))
      (is (int? (get snap :processes)))
      ;; dev-tools builds have gc/vm/sched; each key is present (nil only on a lean build)
      (is (contains? snap :gc))
      (is (contains? snap :sched))
      (is (contains? snap :metrics))))
  (test "watch-vitals samples vitals onto the stream, foldable into a gauge"
    (reset-metrics)
    (detach-all)
    (start)
    (last-value :vproc [:runtime :vitals] :processes)
    (let (w (watch-vitals 15))
      (sleep 70)
      (sync)
      (stop-watch-vitals w)
      (let (g (metric :vproc))
        (is (not (nil? g)))
        (is (int? (get g :value)))))
    (detach-all)
    (stop)))

;; ---- remote tier: subscribe/forward protocol (ADR-053 shape) -----------------
;; Single-runtime protocol test: the target agent, the subscriber watcher and the local
;; listener share one runtime here (cross-node routing is transparent dist `send`, covered
;; by the dist suite). It exercises subscribe → attach forwarder → forward on emit →
;; re-emit locally.
(describe "telemetry — remote tier"
  :isolated (test "a target emit is forwarded to a subscriber and re-emitted into the local stream"
    (reset-metrics)
    (detach-all)
    (start)
    (let (cap (table/new))
      (attach :remote-cap [:remote :hits] (fn (e m md) (table/put cap :got {:m m :md md})))
      (let (agent (spawn (telemetry/telemetry-serve-loop nil))
            watcher (telemetry/telemetry-subscribe-to agent [:app :hit] [:remote :hits]))
        (sleep 30)
        ;; a target-side emit rides the forwarder to the subscriber, which re-emits locally
        (emit [:app :hit] {:count 1} {:path "/x"})
        (sleep 30)
        (sync)
        (let (got (table/get cap :got))
          (assert= {:count 1} (get got :m))
          (assert= "/x" (get (get got :md) :path))
          ;; the origin event is tagged into the re-emitted metadata
          (assert= [:app :hit] (get (get got :md) :remote-event)))
        (stop-subscribe-remote watcher)
        (stop-serve agent)))
    (detach-all)
    (stop)))
