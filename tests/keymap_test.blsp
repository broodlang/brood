;; std/keymap — the rebindable key→command dispatcher, plus chord (prefix-keymap)
;; support: `keymap-bind` (define chords as data) and `keymap-step` (chord-aware
;; dispatch threading a pending prefix). Register-only — run by `nest test` (and
;; cargo test, via crates/lisp/tests/suite.rs).

(defmodule keymap-test (:use test) (:use editor/keymap))

;; Commands are `(state key) -> state`; we accumulate a string so the path is
;; visible. Stored in keymaps as **qualified** symbols (resolved by `reflect/eval` at
;; dispatch time), matching how `std/lineedit` stores its bindings.
(defn km-cmd-e (s k) (str s "E"))
(defn km-cmd-x (s k) (str s "X"))
(defn km-boom (s k) (throw "boom"))
; fallback: marks an unhandled key
(defn km-fb (s k) (str s "?"))
;; Thread a whole key sequence through keymap-step (tail-recursive), returning the
;; final [state pending].
(defn km-run* (km pending state keys)
  (if (empty? keys)
    [state pending]
    (let (r (keymap-step km pending state (first keys) km-fb))
      (km-run* km (second r) (first r) (rest keys)))))
(defn km-run (km keys state) (km-run* km nil state keys))

(describe "keymap-bind builds chords as data"
  (test "a one-key sequence is a plain binding"
    (assert= (keymap-bind {} ["a"] 'keymap-test/km-cmd-x) {"a" 'keymap-test/km-cmd-x}))
  (test "a multi-key sequence nests prefix sub-keymaps"
    (assert= (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e)
      {:ctrl-x {:ctrl-e 'keymap-test/km-cmd-e}}))
  (test "sibling bindings are preserved; an existing prefix is extended"
    (let (km (-> {}
               (keymap-bind [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e)
               (keymap-bind [:ctrl-x :ctrl-s] 'keymap-test/km-cmd-x)
               (keymap-bind ["a"] 'keymap-test/km-cmd-x)))
      (assert= km
        {:ctrl-x {:ctrl-e 'keymap-test/km-cmd-e :ctrl-s 'keymap-test/km-cmd-x}
         "a" 'keymap-test/km-cmd-x}))))

(describe "keymap-step chord dispatch"
  (test "a flat command runs and resets pending"
    (let (km (keymap-bind {} ["a"] 'keymap-test/km-cmd-x))
      (assert= (keymap-step km nil "S" "a" km-fb) ["SX" nil])))

  (test "a prefix key enters its sub-keymap, leaving state untouched"
    (let (km (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e))
      (assert= (keymap-step km nil "S" :ctrl-x km-fb) ["S" {:ctrl-e 'keymap-test/km-cmd-e}])))

  (test "completing the chord runs the command and resets"
    (let (km (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e))
      (assert= (km-run km [:ctrl-x :ctrl-e] "S") ["SE" nil])))

  (test "a dead-end chord drops the key and resets (no fallback / self-insert)"
    (let (km (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e))
      ;; :ctrl-x then an unbound :ctrl-q — state unchanged, pending cleared.
      (assert= (km-run km [:ctrl-x :ctrl-q] "S") ["S" nil])))

  (test "a fresh unbound key goes to the fallback"
    (let (km (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e))
      (assert= (keymap-step km nil "S" :ctrl-z km-fb) ["S?" nil])))

  (test "a throwing command leaves state unchanged (loop can't crash)"
    (let (km (keymap-bind {} ["b"] 'keymap-test/km-boom))
      (assert= (keymap-step km nil "S" "b" km-fb) ["S" nil]))))

(describe "keymap-dispatch flat fast-path is unchanged"
  (test "a flat command still runs"
    (assert= (keymap-dispatch {:a 'keymap-test/km-cmd-x} "S" :a km-fb) "SX"))
  (test "an unbound key goes to fallback"
    (assert= (keymap-dispatch {:a 'keymap-test/km-cmd-x} "S" :z km-fb) "S?"))
  (test "a chord-prefix binding is ignored here (treated as unbound → fallback)"
    (let (km (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e))
      (assert= (keymap-dispatch km "S" :ctrl-x km-fb) "S?"))))

;; ---- across processes -------------------------------------------------------
;; Keymaps are plain data and commands are symbols (resolved against shared code),
;; so chord dispatch works in any process. A worker threads a chord and replies.
(defn km-worker (parent km keys) (send parent (first (km-run km keys ""))))

(describe "keymap chords across processes"
  :isolated (test "a spawned process can resolve and run a chord"
    (let (me (self)
          km (keymap-bind {} [:ctrl-x :ctrl-e] 'keymap-test/km-cmd-e))
      (spawn (km-worker me km [:ctrl-x :ctrl-e]))
      (assert= (receive) "E"))))

;; ---- keymap-where-is: the inverse of keymap-bind ------------------------------
;; The mechanism behind help text that names a COMMAND and renders whatever key is
;; actually bound to it (Emacs `where-is-internal`), so docs follow a rebinding.

(describe "keymap-where-is"
  (test "a flat binding answers its own key"
    (assert= (keymap-where-is {:ctrl-f 'forward-char} 'forward-char) (list [:ctrl-f])))

  (test "a chord answers the whole sequence, prefix included"
    (let (km (keymap-bind {} [:ctrl-x :ctrl-e] 'eval-last-sexp))
      (assert= (keymap-where-is km 'eval-last-sexp) (list [:ctrl-x :ctrl-e]))))

  (test "several keys bound to one command all come back"
    (let (km (-> {}
               (keymap-bind [:ctrl-n] 'next-line)
               (keymap-bind [:down] 'next-line)))
      (assert= (count (keymap-where-is km 'next-line)) 2)
      (is (includes? (keymap-where-is km 'next-line) [:ctrl-n]))
      (is (includes? (keymap-where-is km 'next-line) [:down]))))

  (test "an unbound command is (), not an error"
    (assert= (keymap-where-is {:ctrl-f 'forward-char} 'no-such-command) ())
    (assert= (keymap-where-is {} 'anything) ()))

  (test "deep chords and mixed depths"
    (let (km (-> {}
               (keymap-bind [:ctrl-c "t" "p"] 'test-project)
               (keymap-bind ["q"] 'quit)))
      (assert= (keymap-where-is km 'test-project) (list [:ctrl-c "t" "p"]))
      (assert= (keymap-where-is km 'quit) (list ["q"]))))

  (test "a prefix sub-keymap is never itself reported as a binding"
    (let (km (keymap-bind {} [:ctrl-x "b"] 'switch-buffer))
      (assert= (keymap-where-is km (get km :ctrl-x)) ())))

  (test "round-trips with keymap-bind for every bound sequence"
    (let (seqs (list [:ctrl-a] [:ctrl-x "s"] [:ctrl-c :ctrl-n])
          km (fold seqs {} (fn (acc s) (keymap-bind acc s 'target))))
      (assert= (count (keymap-where-is km 'target)) 3)
      (doseq (s seqs) (is (includes? (keymap-where-is km 'target) s))))))

;; ---- the keymap inverted in ONE walk ----------------------------------------
;; `keymap-where-is` answers for one command and walks the whole map to do it. A UI showing
;; the key beside every row of a command list therefore walked the map per row — 48 ms a
;; keystroke in bedit's `M-x`, for fifteen rows. `keymap-index` is that walk done once; these
;; pin it against the two inverses it has to agree with.
(describe "keymap-index / keymap-bindings"
  (test "every binding, grouped by command, agreeing with keymap-where-is"
    (let (km (keymap-bind (keymap-bind (keymap-bind (keymap-bind {} [:ctrl-n] 'a/next)
                                         [:ctrl-x :ctrl-e]
                                         'a/eval)
                            [:ctrl-x "o"]
                            'a/other)
               [:down]
               'a/next)
          idx (keymap-index km))
      (doseq (c (keymap-commands km))
        (assert= (sort (keymap-where-is km c)) (sort (get idx c))))
      ;; a command bound twice appears once, with both sequences
      (assert= 2 (count (get idx 'a/next)))
      (assert= (sort (keymap-commands km)) (sort (keys idx)))))

  (test "the flat form carries the same pairs"
    (let (km (keymap-bind (keymap-bind {} [:ctrl-x :ctrl-e] 'a/eval) [:ctrl-n] 'a/next)
          pairs (keymap-bindings km))
      (assert= 2 (count pairs))
      (is (includes? pairs ['a/eval [:ctrl-x :ctrl-e]]))
      (is (includes? pairs ['a/next [:ctrl-n]]))))

  (test "an empty keymap indexes to nothing, and a prefix alone binds nothing"
    (assert= {} (keymap-index {}))
    (assert= '() (keymap-bindings {}))
    (assert= {} (keymap-index {:ctrl-x {}}))))

;; ---- key-parse / key-description: the Emacs spelling of a key, both ways ------------

(def km-canonical-keys
  ;; One of every shape the frontends deliver (`character_chord` / `named_key`).
  ["a"
    "A"
    "é"
    " "
    "<"
    "-"
    :ctrl-x :ctrl--
    (keyword "ctrl- ")
    (keyword "ctrl-meta- ")
    :alt-x :alt-O
    (keyword "alt->")
    (keyword "alt-%")
    (keyword "ctrl-meta-$")
    :ctrl-meta-i :super-s
    :super-S :ctrl-super-s
    (keyword "alt-super->")
    :left :shift-up
    :ctrl-left :ctrl-shift-left
    :alt-shift-up :ctrl-meta-delete
    :enter :ctrl-enter
    :ctrl-meta-enter :backspace
    :ctrl-backspace :delete
    :page-up :page-down
    :home :end
    :tab :back-tab
    :escape :f1
    :f12 :f24
    :ctrl-f5 :shift-f5
    :super-f12 :insert
    :menu :volume-up
    :media-play-pause])

(describe "key-parse reads an Emacs key description"
  (test "characters, chords and prefixes"
    (assert= [:ctrl-x :ctrl-f] (key-parse "C-x C-f"))
    (assert= [:ctrl-c "t" "f"] (key-parse "C-c t f"))
    (assert= [(keyword "alt-%")] (key-parse "M-%"))
    (assert= [(keyword "ctrl-meta-$")] (key-parse "C-M-$"))
    (assert= [(keyword "ctrl-meta-$")] (key-parse "M-C-$"))
    (assert= [:ctrl--] (key-parse "C--"))
    (assert= ["C"] (key-parse "C"))
    (assert= [:ctrl-x "4" :ctrl-f] (key-parse "  C-x   4 C-f ")))

  (test "Emacs's words for keys"
    (assert= [:enter] (key-parse "RET"))
    (assert= [:tab] (key-parse "TAB"))
    (assert= [" "] (key-parse "SPC"))
    (assert= [(keyword "ctrl- ")] (key-parse "C-SPC"))
    (assert= [:escape] (key-parse "ESC"))
    (assert= [:backspace] (key-parse "DEL"))
    (assert= [:ctrl-x :backspace] (key-parse "C-x DEL")))

  (test "named keys in angle brackets, and their Emacs aliases"
    (assert= [:f5] (key-parse "<f5>"))
    (assert= [:ctrl-meta-enter] (key-parse "C-M-<return>"))
    (assert= [:ctrl-meta-enter] (key-parse "<C-M-return>"))
    (assert= [:ctrl-left] (key-parse "C-<left>"))
    (assert= [:page-up :page-down] (key-parse "<prior> <next>"))
    (assert= [:back-tab] (key-parse "<backtab>"))
    (assert= [:back-tab] (key-parse "S-TAB"))
    (assert= [:shift-up] (key-parse "S-<up>")))

  (test "Shift folds into a character the way the keyboard does"
    (assert= ["A"] (key-parse "S-a"))
    (assert= [:alt-O] (key-parse "M-O"))
    (assert= [:alt-O] (key-parse "M-S-o"))
    (assert= [:ctrl-a] (key-parse "C-S-a"))
    (assert= [:ctrl-a] (key-parse "C-A")))

  (test "what is not a key is a failure naming it"
    (is (failure? (key-parse "")))
    (is (failure? (key-parse "   ")))
    (is (failure? (key-parse nil)))
    (is (failure? (key-parse "C-x foo")))
    (is (includes? (error-message (key-parse "C-x foo")) "foo"))
    (is (failure? (key-parse "<nope>")))
    (is (failure? (key-parse "<f25>")))
    (is (failure? (key-parse "H-x")))))

(describe "key-description is key-parse's inverse"
  (test "a sequence prints the way Emacs writes it"
    (assert= "C-x C-f" (key-description [:ctrl-x :ctrl-f]))
    (assert= "C-SPC" (key-description [(keyword "ctrl- ")]))
    (assert= "M-s o" (key-description [:alt-s "o"]))
    (assert= "C-S-left" (key-description [:ctrl-shift-left]))
    (assert= "s-<f12>" (key-description [:super-f12])))

  (test "every key the frontends deliver reads back from its description"
    (doseq (key km-canonical-keys)
      (assert= [key] (key-parse (single-key-description key)))))

  (test "a whole sequence round-trips"
    (assert= km-canonical-keys (key-parse (key-description km-canonical-keys)))))

(describe "keymap-merge lays one keymap over another, prefixes merged deeply"
  (test "both keymaps' chords under a shared prefix survive"
    (let (merged (keymap-merge {:ctrl-c {"f" 'a/find}} {:ctrl-c {:ctrl-p 'a/preview}}))
      (assert= 'a/find (map/get-in merged [:ctrl-c "f"]))
      (assert= 'a/preview (map/get-in merged [:ctrl-c :ctrl-p]))))
  (test "the same sequence: the higher keymap wins, at any depth"
    (assert= {:ctrl-x {:ctrl-c {"q" 'a/high}}}
      (keymap-merge {:ctrl-x {:ctrl-c {"q" 'a/low}}} {:ctrl-x {:ctrl-c {"q" 'a/high}}})))
  (test "a command or nil in the higher keymap takes the prefix whole"
    (assert= {:ctrl-c 'a/cmd} (keymap-merge {:ctrl-c {"f" 'a/find}} {:ctrl-c 'a/cmd}))
    (assert= {:ctrl-c nil} (keymap-merge {:ctrl-c {"f" 'a/find}} {:ctrl-c nil})))
  (test "a prefix in the higher keymap replaces a lower command"
    (assert= {:ctrl-c {"f" 'a/find}} (keymap-merge {:ctrl-c 'a/cmd} {:ctrl-c {"f" 'a/find}}))))

(describe "a stack of keymaps: one rule for a key and for the merged map"
  (def- km-stack
    [{:c {:p 'a/top-p} :m {:n {:o 'a/top-o}}}
      {:c 'a/middle :m {:n 'a/middle-n} :u nil}
      {:c {:f 'a/low-f} :m {:n {:s 'a/low-s}} :u 'a/low-u}])
  (test "a middle command under a higher prefix is passed over, at any depth"
    (assert= 'a/low-f (get (keymap-stack-binding km-stack :c) :f))
    (assert= 'a/low-s (map/get-in (keymap-merge-stack km-stack) [:m :n :s]))
    (assert= 'a/top-o (map/get-in (keymap-merge-stack km-stack) [:m :n :o])))
  (test "the first keymap's command or nil hides the rest"
    (assert= nil (keymap-stack-binding km-stack :u))
    (is (contains? (keymap-merge-stack km-stack) :u))
    (assert= 'a/middle (keymap-stack-binding (rest km-stack) :c)))
  (test "every key of the merged map is what the stack binds it to"
    (let (merged (keymap-merge-stack km-stack))
      (doseq (key (keys merged))
        (assert= (keymap-stack-binding km-stack key) (get merged key))))))
