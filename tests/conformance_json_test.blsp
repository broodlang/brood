;; tests/conformance_json_test.blsp — "Parsing JSON is a Minefield" against std/json.
;;
;; The corpus (nst/JSONTestSuite, MIT; see tests/corpus/json/README.md) is the one
;; from Nicolas Seriot's survey that found essentially every shipped JSON parser
;; disagreeing with every other. Each file is one document, and its name is the
;; verdict RFC 8259 requires:
;;
;;   y_*  MUST parse
;;   n_*  MUST be rejected
;;   i_*  implementation-defined — either verdict conforms (huge numbers, lone
;;        surrogates, deep nesting). Reported, never failed.
;;
;; A file that is not valid UTF-8 cannot become a Brood string at all, so `slurp`
;; raises before `parse` is reached. That counts as a rejection, which is the
;; right verdict — several `n_` cases exist precisely to check that a parser does not
;; accept mis-encoded bytes.
;;
;; All 318 documents are swept, deep-nesting ones included. Two of them —
;; `n_structure_100000_opening_arrays.json` (100,000 levels) and
;; `n_structure_open_array_object.json` (~50,000) — are what found KI-11, an unbounded
;; native recursion on the JIT's tail-chain follow-through, and both reject cleanly since
;; that was fixed on 2026-07-26. Past the 1500-level native cap the recursion drains on the
;; VM's heap-backed frames; the two together cost ~600 ms.
;;
;; They were briefly skipped on the belief that they cost >120 s under parallel load. That
;; was a misdiagnosis: `*test-timeout-ms*` is a wall deadline for an entire *batch* of
;; parallel workers, not a per-test ceiling, so a batch that overran blamed whichever
;; worker reported last. Nothing here is slow. See `crates/lisp/tests/suite.rs` for the
;; actual fix.

(defmodule conformance-json-test (:use test) (:use corpus))

(defn- js-verdict (path)
  "`:ok` if `path` parses as JSON, `:rejected` if anything refuses it."
  (try
    (do (json/decode (file/slurp path)) :ok)
    (catch e :rejected)))

(defn- js-kind (path) (string/substring (path/basename path) 0 1))

;; [oks rejects wrongs] for one class, where `wrongs` lists the offending basenames.
(defn- js-scan (files kind want oks rejects wrong)
  (cond
    (nil? files) [oks rejects (reverse wrong)]
    (not (= (js-kind (first files)) kind)) (js-scan (rest files) kind want oks rejects wrong)
    else
      (let (v (js-verdict (first files))
            ok (= v :ok))
        (js-scan (rest files)
          kind
          want
          (if ok (inc oks) oks)
          (if ok rejects (inc rejects))
          (if (or (nil? want) (= v want))
            wrong
            (cons (path/basename (first files)) wrong))))))

(describe "JSONTestSuite: RFC 8259 accept/reject"
  :tags [:conformance]

  (test "the corpus is present"
    (is (corpus-present? "json"))
    (is (> (count (corpus-files "json")) 300)))

  (test "every y_ document parses"
    (let ([oks _ wrong] (js-scan (corpus-files "json") "y" :ok 0 0 nil))
      (is (> oks 80))
      (assert= (take 5 wrong) ())
      (assert= (count wrong) 0)))

  (test "every n_ document is rejected"
    (let ([_ rejects wrong] (js-scan (corpus-files "json") "n" :rejected 0 0 nil))
      (is (> rejects 150))
      (assert= (take 5 wrong) ())
      (assert= (count wrong) 0)))

  ;; No assertion on the verdict — the point is that an implementation-defined
  ;; document produces *a* verdict rather than hanging or killing the process.
  (test "every i_ document terminates with a verdict"
    (let ([oks rejects wrong] (js-scan (corpus-files "json") "i" nil 0 0 nil))
      (assert= wrong ())
      (is (> (+ oks rejects) 30)))))

;; The specific traps the corpus is famous for, named so the sweep's coverage is
;; legible without opening 318 files.
(describe "JSONTestSuite: the classic traps"
  :tags [:conformance]

  (test "a bare scalar is a valid JSON text (RFC 8259 §2, not the 2006 grammar)"
    (assert= (json/decode "123") 123)
    (assert= (json/decode "\"s\"") "s")
    (assert= (json/decode "true") true)
    (assert= (json/decode "null") nil))

  (test "trailing commas, comments and single quotes are rejected"
    (assert-error (json/decode "[1,]"))
    (assert-error (json/decode "{\"a\":1,}"))
    (assert-error (json/decode "[1] // comment"))
    (assert-error (json/decode "['a']")))

  (test "the number grammar rejects what looks numeric but isn't"
    ; leading zero
    (assert-error (json/decode "01"))
    ; trailing point
    (assert-error (json/decode "1."))
    ; leading point
    (assert-error (json/decode ".1"))
    ; leading plus
    (assert-error (json/decode "+1"))
    ; empty exponent
    (assert-error (json/decode "1e"))
    (assert-error (json/decode "Infinity"))
    (assert-error (json/decode "NaN")))

  (test "unescaped control characters are rejected inside a string"
    (assert-error (json/decode "[\"a\nb\"]"))
    (assert-error (json/decode "[\"a\tb\"]")))

  (test "escapes and astral surrogate pairs decode"
    (assert= (json/decode "\"\\u0041\"") "A")
    (assert= (json/decode "\"\\/\"") "/")
    ;; U+1D11E MUSICAL SYMBOL G CLEF, as the surrogate pair JSON must spell it with
    (assert= (json/decode "\"\\uD834\\uDD1E\"") "\u{1D11E}")))
