;;; Regression guard: a *nested* VM activation must not overflow the native stack.
;;;
;;; The VM's ordinary calls cost no Rust stack — they push heap frames inside one
;;; `vm_run_bc` loop, capped by `MAX_BC_FRAMES`, which is why 200 000-deep non-tail
;;; recursion returns cleanly. But an `&optional` default, every native callback and the
;;; `%try` BUILTIN re-enter through `exec_value` → `exec_call` → `vm_apply` → `vm_run_bc`,
;;; adding real Rust frames per Brood level. Nothing on that path reaches `reflect/eval`, so
;;; the tree-walker's byte guard never saw it: a `try` recursion at n=200000 died on the guard
;;; page — `fatal runtime error: stack overflow, aborting`, exit 134, core dumped.
;;;
;;; That failure mode is the reason this matters beyond one program: a SIGSEGV takes the
;;; **OS process**, not the green process, so `try`/`catch` cannot observe it and no
;;; supervisor can restart it. `vm_apply` now probes the remaining native stack and raises
;;; the ordinary catchable depth error instead (the VM sibling of the JIT's KI-14 fix).
;;;
;;; An inline `try` no longer takes that path (ADR-400): its body is bytecode in the
;;; driver's own loop, so it recurses on heap frames like any call. The guard is exercised
;;; through the `%try` builtin called with a thunk that is not a literal `fn` — the shape
;;; the compiler does not inline, which still re-enters natively per level.
;;;
;;; The exact depth reached is deliberately NOT asserted — it is a function of frame size
;;; and the reserve, and pinning it would make this a change-detector. What must hold is:
;;; the program finishes, the error is catchable, and the heap-frame paths still recurse
;;; deep.

(defmodule vm-nested-stack-guard-test (:use test))

(check-allow :non-tail-recursion
  ;; The native re-entry shape: each level calls the `%try` builtin, which runs the thunk
  ;; through a nested evaluation.
  ;; check-allow :discarded-catch — a did-it-throw assertion: the caught error is the answer
  (defn nsg-try (n)
    (if (= n 0)
      0
      (let (body (fn () (+ 1 (nsg-try (- n 1)))))
        (%try body (fn (_e) 0)))))
  ;; The same recursion with no `try` — stays in heap frames.
  (defn nsg-plain (n) (if (= n 0) 0 (+ 1 (nsg-plain (- n 1)))))
  ;; The same `%try` re-entry, but re-raising instead of swallowing, so the depth error
  ;; escapes to the caller — that is what makes catchability observable.
  (defn nsg-raise (n)
    (if (= n 0)
      0
      (+ 1 (let (body (fn () (nsg-raise (- n 1)))) (%try body (fn (e) (throw e)))))))
  ;; An inline `try` (ADR-400): its body runs in the driver, on heap frames.
  ;; check-allow :discarded-catch — the catch never fires; the depth is the answer
  (defn nsg-inline-try (n) (if (= n 0) 0 (try (+ 1 (nsg-inline-try (- n 1))) (catch _e 0)))))

(describe "nested-activation native stack guard"
  (test "deep recursion through the %try builtin terminates instead of aborting"
    ;; Before the fix this never returned — the OS process died with SIGSEGV.
    ;; Two million levels is past every engine's limit: the VM's native-stack guard trips
    ;; long before, and the tree-walker — where `%try` is a heap frame since ADR-416 stage 3,
    ;; so this shape never re-enters natively — stops at its frame cap.
    (let (out (nsg-try 2000000))
      (is (int? out))
      ;; The inner `catch` swallowed the depth error, so the count is the depth the
      ;; guard allowed — bounded under the requested two million.
      (is (> out 0))
      (is (< out 2000000))))

  (test "the depth error is catchable, not fatal"
    ;; `nsg-raise` re-raises, so the depth error propagates out to this `try` — the
    ;; whole claim: an ordinary catchable error, where a SIGSEGV was unobservable.
    (assert= :caught (try (nsg-raise 2000000) (catch _e :caught))))

  (test "an inline try recursion runs on heap frames and goes deep"
    (assert= 200000 (nsg-inline-try 200000)))

  (test "non-tail recursion without a try still uses heap frames and goes deep"
    ;; The guard must not have narrowed the ordinary VM path.
    (assert= 200000 (nsg-plain 200000))))

;; ---- `reflect/eval` in tail position is NOT a tail call -------------------------------
;; A self-call made THROUGH `reflect/eval` looks tail-recursive and is not: `reflect/eval` is a native
;; function, so it re-enters the evaluator on the Rust stack and each round adds a frame.
;; Reported as "eval doesn't kick in tail optimisation" — it is the native re-entry, not a
;; TCO bug, and every ordinary tail shape survives `reflect/eval` (the second test pins that, so a
;; future change cannot quietly break real TCO and hide behind this note).
(defn nsg-eval-self (n) (if (= n 0) :ok (reflect/eval (list 'nsg-eval-self (- n 1)))))
(reflect/eval '(defn nsg-evald-if (n acc) (if (= n 0) acc (nsg-evald-if (- n 1) (+ acc 1)))))
(reflect/eval '(defn nsg-evald-cond (n) (cond (= n 0) :ok else (nsg-evald-cond (- n 1)))))
(reflect/eval '(defn nsg-evald-mutA (n) (if (= n 0) :ok (nsg-evald-mutB (- n 1)))))
(reflect/eval '(defn nsg-evald-mutB (n) (if (= n 0) :ok (nsg-evald-mutA (- n 1)))))

(describe "eval and tail calls"
  (check-allow :non-tail-recursion
    (test "a self-call made THROUGH eval is not a tail call — it is catchable, not fatal"
      (assert= :caught (try (nsg-eval-self 50000) (catch _e :caught)))))
  (test "the error names eval, so the cause is not mistaken for a TCO bug"
    (let (hint (try (do (nsg-eval-self 50000) "") (catch e (get e :hint))))
      (is (includes? hint "eval"))))
  ;; The other half: ordinary tail recursion DEFINED through eval keeps proper tail calls.
  ;; `:unbound` because these are defined BY `reflect/eval` at load — the static checker cannot see
  ;; a name that only exists after a runtime `reflect/eval`, and that is the point of the test.
  (check-allow :unbound
    (test "a tail-recursive fn defined via eval still has O(1) stack"
      (assert= 300000 (nsg-evald-if 300000 0))
      (assert= :ok (nsg-evald-cond 300000))
      (assert= :ok (nsg-evald-mutA 300000))
      (assert= :ok (reflect/eval '(letrec (g (fn (n) (if (= n 0) :ok (g (- n 1))))) (g 300000)))))))
