;;; Regression guard: a *nested* VM activation must not overflow the native stack.
;;;
;;; The VM's ordinary calls cost no Rust stack — they push heap frames inside one
;;; `vm_run_bc` loop, capped by `MAX_BC_FRAMES`, which is why 200 000-deep non-tail
;;; recursion returns cleanly. But a `try` body, an `&optional` default and every native
;;; callback re-enter through `exec_value` → `exec_call` → `vm_apply` → `vm_run_bc`,
;;; adding real Rust frames per Brood level. Nothing on that path reaches `eval`, so the
;;; tree-walker's byte guard never saw it: `(defn f (n) (if (= n 0) 0 (try (+ 1 (f (- n 1)))
;;; (catch e 0))))` at n=200000 died on the guard page — `fatal runtime error: stack
;;; overflow, aborting`, exit 134, core dumped.
;;;
;;; That failure mode is the reason this matters beyond one program: a SIGSEGV takes the
;;; **OS process**, not the green process, so `try`/`catch` cannot observe it and no
;;; supervisor can restart it. `vm_apply` now probes the remaining native stack and raises
;;; the ordinary catchable depth error instead (the VM sibling of the JIT's KI-14 fix).
;;;
;;; The exact depth reached is deliberately NOT asserted — it is a function of frame size
;;; and the reserve, and pinning it would make this a change-detector. What must hold is:
;;; the program finishes, the error is catchable, and the non-`try` path still recurses
;;; deep on heap frames.

(defmodule vm-nested-stack-guard-test (:use test))

(check-allow :non-tail-recursion
  ;; The `try` shape: each level re-enters the VM natively.
  (defn nsg-try (n) (if (= n 0) 0 (try (+ 1 (nsg-try (- n 1))) (catch e 0))))
  ;; The same recursion with no `try` — stays in heap frames.
  (defn nsg-plain (n) (if (= n 0) 0 (+ 1 (nsg-plain (- n 1)))))
  ;; The same `try` re-entry, but re-raising instead of swallowing, so the depth error
  ;; escapes to the caller — that is what makes catchability observable.
  (defn nsg-raise (n) (if (= n 0) 0 (+ 1 (try (nsg-raise (- n 1)) (catch e (throw e)))))))

(describe "nested-activation native stack guard"
  (test "deep recursion through a try body terminates instead of aborting"
    ;; Before the fix this never returned — the OS process died with SIGSEGV.
    (let (out (nsg-try 200000))
      (is (int? out))
      ;; The inner `catch` swallowed the depth error, so the count is the depth the
      ;; guard allowed — bounded well under the requested 200 000.
      (is (> out 0))
      (is (< out 200000))))

  (test "the depth error is catchable, not fatal"
    ;; `nsg-raise` re-raises, so the depth error propagates out to this `try` — the
    ;; whole claim: an ordinary catchable error, where a SIGSEGV was unobservable.
    (assert= :caught (try (nsg-raise 200000) (catch e :caught))))

  (test "non-tail recursion without a try still uses heap frames and goes deep"
    ;; The guard must not have narrowed the ordinary VM path.
    (assert= 200000 (nsg-plain 200000))))

;; ---- `eval` in tail position is NOT a tail call -------------------------------
;; A self-call made THROUGH `eval` looks tail-recursive and is not: `eval` is a native
;; function, so it re-enters the evaluator on the Rust stack and each round adds a frame.
;; Reported as "eval doesn't kick in tail optimisation" — it is the native re-entry, not a
;; TCO bug, and every ordinary tail shape survives `eval` (the second test pins that, so a
;; future change cannot quietly break real TCO and hide behind this note).
(defn nsg-eval-self (n) (if (= n 0) :ok (eval (list 'nsg-eval-self (- n 1)))))
(eval '(defn nsg-evald-if   (n acc) (if (= n 0) acc (nsg-evald-if (- n 1) (+ acc 1)))))
(eval '(defn nsg-evald-cond (n) (cond (= n 0) :ok else (nsg-evald-cond (- n 1)))))
(eval '(defn nsg-evald-mutA (n) (if (= n 0) :ok (nsg-evald-mutB (- n 1)))))
(eval '(defn nsg-evald-mutB (n) (if (= n 0) :ok (nsg-evald-mutA (- n 1)))))

(describe "eval and tail calls"
  (check-allow :non-tail-recursion
    (test "a self-call made THROUGH eval is not a tail call — it is catchable, not fatal"
      (assert= :caught (try (nsg-eval-self 50000) (catch e :caught)))))
  (test "the error names eval, so the cause is not mistaken for a TCO bug"
    (let (hint (try (do (nsg-eval-self 50000) "") (catch e (get e :hint))))
      (is (includes? hint "eval"))))
  ;; The other half: ordinary tail recursion DEFINED through eval keeps proper tail calls.
  ;; `:unbound` because these are defined BY `eval` at load — the static checker cannot see
  ;; a name that only exists after a runtime `eval`, and that is the point of the test.
  (check-allow :unbound
    (test "a tail-recursive fn defined via eval still has O(1) stack"
      (assert= 300000 (nsg-evald-if 300000 0))
      (assert= :ok (nsg-evald-cond 300000))
      (assert= :ok (nsg-evald-mutA 300000))
      (assert= :ok (eval '(letrec (g (fn (n) (if (= n 0) :ok (g (- n 1))))) (g 300000)))))))
