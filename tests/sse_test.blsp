;; std/sse.blsp — a Server-Sent Events client. The wire grammar is parsed by pure
;; functions (unit-tested directly); `with-events` (std/ui.blsp) merges pushed events
;; into a ui-run loop; and one end-to-end test streams frames from a loopback server.

(defmodule sse-test (:use-internals sse) (:use test) (:use sse) (:use editor/ui))

(describe "sse — pure event-field parsing"
  (test "parses event / data / id, stripping one space after the colon"
    (let (ev (sse/parse-event "event: run_started\ndata: {\"id\":42}\nid: 7"))
      (assert= (get ev :event) "run_started")
      (assert= (get ev :data) "{\"id\":42}")
      (assert= (get ev :id) "7")))
  (test "multiple data lines join with a newline"
    (assert= (get (sse/parse-event "data: a\ndata: b\ndata: c") :data) "a\nb\nc"))
  (test "missing type defaults to \"message\"; missing data to \"\""
    (assert= (get (sse/parse-event "data: x") :event) "message")
    (assert= (get (sse/parse-event "event: ping") :data) ""))
  (test "comment lines (:-prefixed) are ignored"
    (assert= (get (sse/parse-event ": keep-alive\ndata: y") :data) "y"))
  (test "a value with no leading space is kept verbatim"
    (assert= (get (sse/parse-event "data:tight") :data) "tight")))

(describe "sse — frame splitting + line endings"
  (test "frames splits complete blocks from a trailing remainder"
    (let ([blocks rest] (sse/frames "x: 1\n\ny: 2\n\nrest"))
      (assert= blocks (list "x: 1" "y: 2"))
      (assert= rest "rest")))
  (test "no complete frame yet → no blocks, all remainder"
    (let ([blocks rest] (sse/frames "partial data"))
      (assert= blocks '())
      (assert= rest "partial data")))
  ;; The edges of the one-split extraction (2026-08-04): a buffer that ends exactly on a
  ;; blank line leaves an EMPTY remainder rather than dropping the last event, and an empty
  ;; buffer splits to no pieces at all — the case the guard in `frames` exists for.
  (test "a buffer ending on a blank line has an empty remainder"
    (let ([blocks rest] (sse/frames "x: 1\n\ny: 2\n\n"))
      (assert= blocks (list "x: 1" "y: 2"))
      (assert= rest "")))
  (test "an empty buffer yields no blocks and an empty remainder"
    (let ([blocks rest] (sse/frames ""))
      (assert= blocks '())
      (assert= rest "")))
  (test "many events in ONE chunk all come out, in order"
    ;; The shape the `sse frames-1c` sweep row measures: one socket read holding k events.
    (let (blob (apply str (repeat 500 "data: tick\n\n"))
          [blocks rest] (sse/frames blob))
      (assert= (count blocks) 500)
      (assert= (first blocks) "data: tick")
      (assert= rest "")))
  (test "normalise turns \\r\\n and \\r into \\n"
    (assert= (sse/normalize "a\r\nb\rc\nd") "a\nb\nc\nd"))
  (test "feed carries a \\r\\n split across two reads instead of reading a blank line"
    ;; `normalize` on the first read alone would turn its trailing \r into a line end,
    ;; and the \n opening the second read into another — a blank line that ends the
    ;; event after "a" and starts a second one holding "b".
    (let ([first-events first-state] (sse/feed ["" ""] "data: a\r")
          [second-events second-state] (sse/feed first-state "\ndata: b\r\n\r\n"))
      (assert= (count first-events) 0)
      (assert= (map second-events :data) (list "a\nb"))
      (assert= second-state ["" ""])))
  (test "feed returns every event a read completes and keeps the rest"
    (let ([events state] (sse/feed ["data: 1" ""] "\n\nevent: e\ndata: 2\n\ndata: 3"))
      (assert= (map events :data) (list "1" "2"))
      (assert= (map events :event) (list "message" "e"))
      (assert= state ["data: 3" ""])))
  (test "feed skips the empty blocks a run of blank lines leaves"
    (let ([events _] (sse/feed ["" ""] "\n\n\n\ndata: x\n\n"))
      (assert= (map events :data) (list "x")))))

(describe "sse — the response head"
  (test "split-head waits for the blank line"
    (assert= (sse/split-head "HTTP/1.0 200 OK\r\nContent-Type: text/event-stream\r\n") nil))
  (test "split-head splits at the CRLF blank line and keeps the rest verbatim"
    (assert= (sse/split-head "HTTP/1.0 200 OK\r\nA: b\r\n\r\ndata: x\r\n")
      ["HTTP/1.0 200 OK\r\nA: b" "data: x\r\n"]))
  (test "split-head accepts a lax server's bare \\n\\n"
    (assert= (sse/split-head "HTTP/1.0 200 OK\nA: b\n\ndata: x")
      ["HTTP/1.0 200 OK\nA: b" "data: x"]))
  (test "parse-head reads the status and the headers, names lower-cased"
    (assert= (sse/parse-head "HTTP/1.1 429 Too Many Requests\r\nContent-Type: application/json\r\nRetry-After: 3")
      {:status 429 :headers {"content-type" "application/json" "retry-after" "3"}}))
  (test "a status line that does not parse reads as status 0"
    (assert= (get (sse/parse-head "garbage") :status) 0)
    (assert= (get (sse/parse-head "HTTP/1.1 abc") :status) 0)))

(describe "sse — server-side frame building"
  (test "a single-line payload becomes one data: line + the blank line"
    (assert= (sse/frame "hello") "data: hello\n\n"))
  (test "a multi-line payload prefixes every line with data:"
    (assert= (sse/frame "a\nb\nc") "data: a\ndata: b\ndata: c\n\n"))
  (test "an event type adds the leading event: line"
    (assert= (sse/frame "x" "tick") "event: tick\ndata: x\n\n"))
  (test "headers declares text/event-stream and disables caching"
    (let (h (sse/headers))
      (assert= (get h "Content-Type") "text/event-stream")
      (assert= (get h "Cache-Control") "no-cache")))
  (test "frame is the inverse of parse-event (round-trip)"
    (let ([blocks _] (sse/frames (sse/frame "a\nb" "tick"))
          ev (sse/parse-event (or (first blocks) (error "sse-test: no blocks parsed"))))
      (assert= (get ev :event) "tick")
      (assert= (get ev :data) "a\nb"))))

(describe "sse — frame cannot be made to inject a field or an event"
  ;; `frame` split data on `\n` only and spliced the event type verbatim, so a bare
  ;; `\r` in data ended the data line on the client, and a newline in the event type
  ;; started a field of the caller's choosing.
  (test "a CR in data is a line end, not a smuggled field (parsed by our own reader)"
    (let ([events _] (sse/feed ["" ""] (sse/frame "ok\r\rdata: injected")))
      (assert= 1 (count events))
      (assert= "ok\n\ndata: injected" (get (first events) :data))))
  (test "every terminator is split: \\r\\n, \\r and \\n"
    (assert= (sse/frame "a\r\nb\rc\nd") "data: a\ndata: b\ndata: c\ndata: d\n\n"))
  (test "CR or LF in the event type raises"
    (assert-error (sse/frame "x" "a\ndata: evil"))
    (assert-error (sse/frame "x" "a\revil"))))

(describe "with-events — merges [:sse …] into ui-run input"
  (test "a queued sse message is returned by :poll before the underlying display"
    (let (fake {:poll (fn (ms) :keyboard) :size (fn () [80 24])}
          wrapped (with-events fake))
      ;; empty mailbox → delegate to the wrapped display's poll
      (assert= ((get wrapped :poll) 0) :keyboard)
      ;; the stream opening is input too
      (send (self) [:sse-open 200])
      (assert= ((get wrapped :poll) 0) [:sse-open 200])
      ;; a queued [:sse …] comes out first
      (send (self) [:sse {:event "x" :data "1"}])
      (assert= ((get wrapped :poll) 0) [:sse {:event "x" :data "1"}])
      ;; …and [:sse-closed …] too
      (send (self) [:sse-closed :closed])
      (assert= ((get wrapped :poll) 0) [:sse-closed :closed])
      ;; mailbox drained → back to delegating
      (assert= ((get wrapped :poll) 0) :keyboard)))
  (test "non-poll ops pass through unchanged"
    (let (wrapped (with-events {:poll (fn (ms) nil) :size (fn () [120 40])}))
      (assert= ((get wrapped :size)) [120 40]))))

(describe "sse — end-to-end over a loopback event-stream server"
  (test "connect yields :sse-open, the pushed events, then :sse-closed"
    (let (me (self))
      ;; a tiny server: accept, read the request, stream the head + two frames, close.
      (spawn (do
               (let (ls (tcp/listen "127.0.0.1" 0))
                 (send me [:port (tcp/local-port ls)])
                 (receive
                   ([:tcp-accept ^ls c] (do
                                          (tcp/controlling-process c (self))
                                          (receive
                                            ([:tcp ^c _] (do
                                                           (tcp/send c
                                                             "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n\r\n")
                                                           (tcp/send c
                                                             "event: hello\r\ndata: world\r\n\r\n")
                                                           (tcp/send c
                                                             "data: {\"n\":1}\r\n\r\n")
                                                           (tcp/close c)))
                                            (after 5000 nil))))
                   (after 5000 nil)))))
      (let (port (receive ([:port p] p) (after *test-wait-ms* :timeout)))
        (connect (str "http://127.0.0.1:" port "/events") me)
        (let (open (receive ([:sse-open s] s) (after *test-wait-ms* :timeout))
              e1 (receive ([:sse e] e) (after *test-wait-ms* :timeout))
              e2 (receive ([:sse e] e) (after *test-wait-ms* :timeout))
              closed (receive ([:sse-closed r] r) (after *test-wait-ms* :timeout)))
          (assert= open 200)
          (assert= (get e1 :event) "hello")
          (assert= (get e1 :data) "world")
          (assert= (get e2 :event) "message")
          (assert= (get e2 :data) "{\"n\":1}")
          (is (not (= closed :timeout))))))))

;; ---- end to end: any method, headers, body, http and https, refusals ---------------

(defn- start-server (handler)
  "Serve `handler` over plain http on a fresh port: `[server-pid port]`."
  (let (me (self)
        server (spawn (let (ls (http/listen 0))
                        (send me [:listening (tcp/local-port ls)])
                        (http/serve-loop ls handler))))
    [server (receive ([:listening port] port) (after *test-wait-ms* :timeout))]))

(defn- start-tls-server (handler)
  "Serve `handler` over TLS on a fresh port with a `tls/self-signed` cert for localhost:
`[server-pid port cert-pem]` — the cert is the client's `:ca`."
  (let (me (self)
        server (spawn (let (pair (tls/self-signed "localhost")
                            ls (tls/listen "127.0.0.1" 0 (first pair) (second pair)))
                        (send me [:listening (tcp/local-port ls) (first pair)])
                        (http/serve-loop ls handler))))
    (receive
      ([:listening port cert] [server port cert])
      (after *test-wait-ms* [server :timeout nil]))))

(defn- serve-raw (payloads)
  "Accept one plain connection, read the request, send each of `payloads` (an iolist
each) with a pause between them — so each is likely its own read on the other side —
then close. Returns the port."
  (let (me (self))
    (spawn (let (ls (tcp/listen "127.0.0.1" 0))
             (send me [:port (tcp/local-port ls)])
             (receive
               ([:tcp-accept ^ls c] (do
                                      (tcp/controlling-process c (self))
                                      (receive ([:tcp ^c _] nil) (after 5000 nil))
                                      (doseq (payload payloads)
                                        (tcp/send c payload)
                                        (sleep 30))
                                      (tcp/close c)))
               (after 5000 nil))))
    (receive ([:port p] p) (after *test-wait-ms* :timeout))))

(defn- collect-stream (acc)
  "Every message of one stream, in order, through its `[:sse-closed …]`."
  (receive
    ([:sse-open status] (collect-stream (conj acc [:open status])))
    ([:sse ev] (collect-stream (conj acc [:event (get ev :event) (get ev :data)])))
    ([:sse-closed reason] (conj acc [:closed reason]))
    (after *test-wait-ms* (conj acc :timeout))))

(defn- echo-request (req)
  "A handler streaming back what it was sent: the method, one header, the body."
  (http/stream-response 200
    (sse/headers)
    (fn (sock)
      (sse/emit sock (get req :method) "method")
      (sse/emit sock (or (get (get req :headers) "authorization") "none") "auth")
      (sse/emit sock (http/body-text req) "body")
      (tcp/close sock))))

(defn- refuse-request (req)
  (http/response 401
    {"Content-Type" "application/json"}
    "{\"error\":{\"message\":\"bad key\"}}"))

(describe "sse — end to end: a streaming POST, refusals, cancellation"
  (test "a POST with headers and a JSON body streams its events over http"
    (let ([server port] (start-server echo-request)
          body "{\"model\":\"m\",\"stream\":true,\"text\":\"café\"}")
      (connect (str "http://127.0.0.1:" port "/v1/chat")
        (self)
        {:method "POST"
         :headers {"Authorization" "Bearer k" "Content-Type" "application/json"}
         :body body})
      (assert= (collect-stream [])
        [[:open 200]
          [:event "method" "POST"]
          [:event "auth" "Bearer k"]
          [:event "body" body]
          [:closed :closed]])
      (exit server :kill)))
  (test "the same POST over https, trusting a self-signed cert through :ca"
    (let ([server port cert] (start-tls-server echo-request))
      (connect (str "https://localhost:" port "/v1/chat")
        (self)
        {:method "POST" :headers {"Authorization" "Bearer k"} :body "{\"n\":1}" :ca cert})
      (assert= (collect-stream [])
        [[:open 200]
          [:event "method" "POST"]
          [:event "auth" "Bearer k"]
          [:event "body" "{\"n\":1}"]
          [:closed :closed]])
      (exit server :kill)))
  (test "https without the :ca rejects the self-signed cert as a closed stream, never an open"
    (let ([server port _] (start-tls-server echo-request))
      (connect (str "https://localhost:" port "/") (self))
      (let (messages (collect-stream []))
        (assert= (count messages) 1)
        (assert= (first (first messages)) :closed)
        (is (string? (second (first messages)))))
      (exit server :kill)))
  (test "a non-2xx status ends the stream with its status, headers and body — no :sse-open"
    (let ([server port] (start-server refuse-request))
      (connect (str "http://127.0.0.1:" port "/") (self) {:method "POST" :body "{}"})
      (let (messages (collect-stream [])
            reason (second (first messages)))
        (assert= (count messages) 1)
        (assert= (get reason :status) 401)
        (assert= (get (get reason :headers) "content-type") "application/json")
        (assert= (get reason :body) "{\"error\":{\"message\":\"bad key\"}}"))
      (exit server :kill)))
  (test "a character split across two reads, and a \\r\\n split across two, arrive whole"
    ;; é is C3 A9: the first read ends on C3, the next starts with A9.
    (let (port (serve-raw [["HTTP/1.0 200 OK\r\nContent-Type: text/event-stream\r\n\r\ndata: caf"
                             (bytes 195)]
                            [(bytes 169) "\r"]
                            "\ndata: line\r\n\r\n"]))
      (connect (str "http://127.0.0.1:" port "/") (self))
      (assert= (collect-stream [])
        [[:open 200] [:event "message" "café\nline"] [:closed :closed]])))
  (test "a refused connection is one :sse-closed carrying the error"
    ;; Port 1: a test process cannot bind below 1024, so nothing can be listening. A port
    ;; that was just free and closed again was a race under the parallel suite — another
    ;; test's server could take it in the gap and accept, and the stream then ended
    ;; `[:closed :closed]` instead of carrying the refusal (CI, 2026-09-30, tree-walker).
    (connect "http://127.0.0.1:1/" (self))
    (let (messages (collect-stream []))
      (assert= (count messages) 1)
      (assert= (first (first messages)) :closed)
      (is (string? (second (first messages))))))
  (test "a CR/LF in a header raises in the caller, before anything is sent"
    (assert-error (connect "http://127.0.0.1:1/" (self) {:headers {"X-A" "b\r\nX-Injected: 1"}}))
    (assert-error (connect "ftp://127.0.0.1/" (self))))
  (test "the reader stops when its subscriber exits"
    (let (me (self)
          [server port] (start-server
                          (fn (_)
                            (http/stream-response 200
                              (sse/headers)
                              (fn (sock)
                                (sse/emit sock "hello")
                                ;; hold the stream open far past the test's wait
                                (sleep 60000)
                                (tcp/close sock)))))
          _ (spawn (do
                     (send me [:reader (connect (str "http://127.0.0.1:" port "/") (self))])
                     (receive ([:sse _] nil) (after *test-wait-ms* nil))))
          reader (receive ([:reader pid] pid) (after *test-wait-ms* :timeout))
          watch (monitor reader))
      (assert= (receive ([:down ^watch _ _] :stopped) (after *test-wait-ms* :timeout)) :stopped)
      (exit server :kill))))
