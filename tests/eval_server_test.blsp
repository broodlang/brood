;; std/tool/eval-server.blsp — the wire codec (pure), the capturing eval core,
;; and the timed answer path (spawned evaluator + deadline kill). The stdin/stdout
;; loop itself is two lines over these and is exercised end-to-end by its clients
;; (myedit's sandbox); everything of substance is testable in-image here.

(defmodule eval-server-test (:use-internals eval-server) (:use test))

;; ---- codec --------------------------------------------------------------------

(describe "eval-server codec"
  (test "a request round-trips through one line"
    (let (line (evsrv-encode-request 7 "(+ 1 2)" 2000)
          req (evsrv-decode-request line))
      (assert= (get req :id) 7)
      (assert= (get req :src) "(+ 1 2)")
      (assert= (get req :timeout-ms) 2000)))

  (test "multi-line source with strings and quotes stays one physical line"
    (let (src "(defn f (x)\n  (str \"a\\\"b\" x))\n(f \"\\n\")"
          line (evsrv-encode-request 1 src nil))
      (is (= (index-of line "\n") -1))
      (assert= (get (evsrv-decode-request line) :src) src)))

  (test "a nil timeout-ms survives the round-trip"
    (assert= (get (evsrv-decode-request (evsrv-encode-request 3 "1" nil)) :timeout-ms)
      nil))

  (test "garbage lines decode to nil, not an error"
    (assert= (evsrv-decode-request "not a map") nil)
    (assert= (evsrv-decode-request "(unclosed") nil)
    (assert= (evsrv-decode-request "") nil)
    (assert= (evsrv-decode-request "{:id \"seven\" :src \"1\"}") nil) ; id not an int
    (assert= (evsrv-decode-request "{:id 1}") nil)) ; no :src
  (test "a reply round-trips, and a non-map reply line decodes to nil"
    (let (r (evsrv-decode-reply (evsrv-encode-reply {:id 4 :ok true :value "3"})))
      (assert= (get r :id) 4)
      (assert= (get r :ok) true))
    (assert= (evsrv-decode-reply "loose print from a stray process") nil)))

;; ---- eval-capturing -----------------------------------------------------------

(describe "eval-capturing"
  (test "value of the last form, no output"
    (let (r (eval-capturing "(+ 1 2) (* 2 21)"))
      (assert= (get r :ok) true)
      (assert= (get r :value) "42")
      (assert= (get r :output) "")
      (is (int? (get r :ms)))))

  (test "keeps both halves: the value AND what was printed"
    (let (r (eval-capturing "(do (io/write \"hi\") 7)"))
      (assert= (get r :value) "7")
      (assert= (get r :output) "hi")))

  (test "an error keeps the output printed before the throw"
    (let (r (eval-capturing "(do (io/write \"before\") (error \"boom\"))"))
      (assert= (get r :ok) false)
      (is (includes? (get r :error) "boom"))
      (assert= (get r :output) "before")))

  (test "an unreadable source is an error reply, not a raise"
    (assert= (get (eval-capturing "(unclosed") :ok) false))

  (test "a failed eval leaves no dangling capture"
    (eval-capturing "(error \"x\")")
    (assert= (with-out-str (io/write "clean")) "clean"))

  (test "a huge value elides instead of flooding the reply"
    (is (includes? (get (eval-capturing "(range 10000)") :value) "…"))))

;; ---- answer: the timed path ----------------------------------------

(describe "answer"
  (test "a normal request answers with its own id"
    (let (r (answer {:id 9 :src "(+ 20 22)"}))
      (assert= (get r :id) 9)
      (assert= (get r :ok) true)
      (assert= (get r :value) "42")))

  (test "session defs persist across requests"
    (answer {:id 1 :src "(defn evsrv-test-triple-x9 (n) (* 3 n))"})
    (assert= (get (answer {:id 2 :src "(evsrv-test-triple-x9 14)"}) :value)
      "42"))

  (test "a runaway eval times out, is killed, and the session survives"
    (let (r (answer {:id 5 :src "(letrec (go (fn () (go))) (go))" :timeout-ms 60}))
      (assert= (get r :ok) false)
      (assert= (get r :timeout) true)
      (assert= (get r :id) 5))
    ;; the image is intact: the very next request evaluates normally
    (assert= (get (answer {:id 6 :src "(+ 1 1)"}) :value) "2"))

  (test "an evaluated error is a reply, never a raise"
    (let (r (answer {:id 8 :src "(error \"deliberate\")"}))
      (assert= (get r :ok) false)
      (is (includes? (get r :error) "deliberate")))))

;; ---- review fixes: mailbox hygiene, malformed timeouts, output bound, :trace ---

(describe "answer mailbox hygiene"
  (test "successful requests leave NO dead letters (the demonitor DOWN drain)"
    ;; demonitor is best-effort in this runtime: the child's :normal DOWN is
    ;; usually queued before we demonitor. Without the drain + down-flush each
    ;; request leaks one — 10 requests, then assert the mailbox is EMPTY.
    (dotimes (i 10) (answer {:id i :src "(+ 1 1)"}))
    (eval-server/eval-server-flush-stale) ; belt: what a next request would do
    (assert= (get (proc/info (self)) :mailbox) 0)))

(describe "malformed requests cannot kill the server"
  (test "a non-int :timeout-ms fails decode (one bad line = one skipped line)"
    (assert= (evsrv-decode-request "{:id 1 :src \"1\" :timeout-ms \"abc\"}") nil))
  (test "a non-vector :trace fails decode"
    (assert= (evsrv-decode-request "{:id 1 :src \"1\" :trace \"fac\"}") nil))
  (test "the answer path clamps a garbage timeout that slipped past decode"
    (let (r (answer {:id 3 :src "(+ 1 2)" :timeout-ms "abc"}))
      (assert= (get r :ok) true)
      (assert= (get r :value) "3"))))

(describe "output bounding"
  (test "a println flood is capped with a truncation marker"
    (let (r (eval-capturing "(dotimes (i 5000) (io/puts i))"))
      (is (<= (string/length (get r :output)) (+ eval-server/*output-cap-chars* 64)))
      (is (includes? (get r :output) "…[output truncated]"))))
  (test "evaluated code stealing the capture yields \"\" output, not nil"
    (let (r (eval-capturing "(do (%capture-take) :done)"))
      (assert= (get r :output) "")
      (assert= (get r :ok) true))))

;; `:trace :all` — the answer to "trace whatever this actually calls". A client cannot
;; compute that list: it can only walk the source it has, which by construction never
;; mentions a helper defined in an earlier request. Only the image knows what it defines,
;; so the resolution happens here.
(describe "boundary tracing (:trace :all)"
  (test "a request may carry :all, and it survives the wire"
    (let (req (evsrv-decode-request (evsrv-encode-request 3 "(f 1)" nil :all)))
      (assert= (get req :trace) :all)))

  (test "an empty trace vector is still omitted, but :all is never mistaken for one"
    (is (not (includes? (evsrv-encode-request 1 "1" nil []) ":trace")))
    (is (includes? (evsrv-encode-request 1 "1" nil :all) ":trace :all")))

  (test "session-globals excludes the language, and a module required mid-session"
    (baseline-globals)
    (eval-capturing "(defn evsrv-sg-mine (x) x)")
    (let (names (session-globals))
      (is (includes? names "evsrv-sg-mine"))
      ;; the language itself is baseline, never "yours"
      (is (not (includes? names "map")))
      (is (not (includes? names "fold")))
      ;; and a namespaced name belongs to whatever module brought it, not to the session
      (is (empty? (seq/filter names (fn (n) (includes? n "/")))))))

  ;; The whole point, in one test: request 3's source names only `evsrv-all-top`, and the
  ;; trace still shows `evsrv-all-helper` underneath it. A source-walking client (which is
  ;; what every client was reduced to) sees one frame here and reports it as the whole story.
  :isolated (test ":all traces a helper the source never mentions"
    (baseline-globals)
    (eval-capturing "(defn evsrv-all-helper (n) (* n 2))")
    (eval-capturing "(defn evsrv-all-top (n) (evsrv-all-helper (+ n 1)))")
    (let (r (eval-capturing "(evsrv-all-top 3)" :all)
          traced (into #{} (map (get r :spy) (fn (e) (get e :fn)))))
      (assert= (get r :value) "8")
      (is (contains? traced "evsrv-all-top"))
      (is (contains? traced "evsrv-all-helper"))))

  :isolated (test "naming the caller alone sees only the caller — what :all is for"
    (eval-capturing "(defn evsrv-named-helper (n) (* n 2))")
    (eval-capturing "(defn evsrv-named-top (n) (evsrv-named-helper (+ n 1)))")
    (let (r (eval-capturing "(evsrv-named-top 3)" ["evsrv-named-top"])
          traced (into #{} (map (get r :spy) (fn (e) (get e :fn)))))
      (assert= (get r :value) "8")
      (is (contains? traced "evsrv-named-top"))
      (is (not (contains? traced "evsrv-named-helper")))))

  ;; The cap is the safety net for `:all` more than for a name list: a session can define
  ;; a lot, and tracing all of it must still bound what comes back.
  ;;
  ;; The trace registry is a plain global, so `%isolate` DOES roll it back along with every
  ;; other binding — what it cannot do is stop a CONCURRENT test's `untrace-all` (every
  ;; traced request's teardown) from stripping this wrapper mid-recursion, which is why the
  ;; three `:all` cases are `:isolated`: alone, the count is the cap exactly. They carried
  ;; the marker for months without being isolated (KI-107 — a bare `:isolated` before a
  ;; test form was a no-op until `describe` learned to read it), and this assertion failed
  ;; at 3-8% for as long as the other `:all` tests could reach it. `<=` stays the claim
  ;; that matters (`:all` cannot flood a reply); `> 0` keeps it from passing vacuously.
  :isolated (test ":all traces, and cannot exceed the spy cap"
    (baseline-globals)
    (let (r (eval-capturing "(defn evsrv-all-chat ((0) 1) ((n) (* n (evsrv-all-chat (- n 1)))))\n(evsrv-all-chat 200)"
              :all))
      (assert= (get r :ok) true)
      (is (> (count (get r :spy)) 0)) ; it really traced
      (is (<= (count (get r :spy)) eval-server/*spy-entry-cap*)))))

(describe "teardown restores only what the request traced (KI-107)"
  ;; The flake this closes was one request's teardown stripping ANOTHER's wrapper: it called
  ;; `debug/untrace-all`, which restores every entry in a registry that is shared globals, so
  ;; the victim's trace stopped mid-recursion and its reply came back with an empty `:spy` —
  ;; about 1 run in 15, with no error anywhere. `:isolated` never prevented it, because a test
  ;; step awaits its worker and not the processes that worker spawned.
  ;;
  ;; Asserted DETERMINISTICALLY rather than by re-running the race: install a trace outside a
  ;; request, run a traced request, and require the outside trace to survive its teardown.
  ;; With `untrace-all` back in `eval-capturing` this fails every single run — which is what a
  ;; guard for a 7% flake has to do to be worth anything.
  ;; The parent's cleanup after a KILLED evaluator, which is the residual that survived
  ;; scoping the ordinary teardown: it used to call `debug/untrace-all` and so restored the
  ;; whole image, taking wrappers from requests that were still running. This file times out
  ;; on purpose elsewhere, so that path really does fire beside the tracing tests.
  :isolated (test "a timed-out evaluator's cleanup leaves another holder's trace alone"
    (reflect/eval (list 'defn 'evsrv-ki107-bystander '(x) '(+ x 7)))
    (debug/trace-hold 'evsrv-ki107-bystander)
    (let (r (answer {:id 501 :src "(letrec (go (fn () (go))) (go))" :timeout-ms 60}))
      (assert= (get r :timeout) true))
    (is (debug/traced-current? 'evsrv-ki107-bystander))
    (debug/trace-release 'evsrv-ki107-bystander)
    (refute (debug/traced-current? 'evsrv-ki107-bystander)))

  ;; The refcount itself, stated directly rather than through a request: two holders, and the
  ;; wrapper survives the first release. This is the half a request-level test cannot show,
  ;; because a request holds each name exactly once — and it is the half that closes the
  ;; residual, where request A installs, B finds it already traced, and A tears down first.
  :isolated (test "a held trace survives another holder letting go"
    (reflect/eval (list 'defn 'evsrv-ki107-shared '(x) '(+ x 1)))
    (debug/trace-hold 'evsrv-ki107-shared)
    (debug/trace-hold 'evsrv-ki107-shared)
    (is (debug/traced-current? 'evsrv-ki107-shared))
    (assert= (debug/trace-release 'evsrv-ki107-shared) 1)
    (is (debug/traced-current? 'evsrv-ki107-shared)) ; ← the second holder still has it
    (assert= (debug/trace-release 'evsrv-ki107-shared) 0)
    (refute (debug/traced-current? 'evsrv-ki107-shared)))

  ;; An INTERACTIVE trace is the holder of its own install, so a request cannot release it out
  ;; from under the REPL: `trace-fn` counts as one holder, a hold makes two.
  :isolated (test "a plain trace-fn counts as a holder, so a scope cannot steal it"
    (reflect/eval (list 'defn 'evsrv-ki107-manual '(x) '(* 3 x)))
    (debug/trace-fn 'evsrv-ki107-manual)
    (debug/trace-hold 'evsrv-ki107-manual)
    (debug/trace-release 'evsrv-ki107-manual)
    (is (debug/traced-current? 'evsrv-ki107-manual))
    (debug/untrace-fn 'evsrv-ki107-manual)
    (refute (debug/traced-current? 'evsrv-ki107-manual))
    ;; …and `untrace-fn` dropped the hold, so a late release is a no-op rather than a lie
    (assert= (debug/trace-release 'evsrv-ki107-manual) nil))

  :isolated (test "a request's teardown leaves alone a trace it did not install"
    (reflect/eval (list 'defn 'evsrv-ki107-outsider '(x) '(* 2 x)))
    (debug/trace-fn 'evsrv-ki107-outsider)
    (is (debug/traced-current? 'evsrv-ki107-outsider))
    (let (r (eval-capturing "(defn evsrv-ki107-inner (x) (+ x 1))\n(evsrv-ki107-inner 1)"
              ["evsrv-ki107-inner"]))
      (assert= (get r :ok) true)
      (is (> (count (get r :spy)) 0)))
    (is (debug/traced-current? 'evsrv-ki107-outsider))
    ;; …and the request DID restore its own: the inner name is no longer wrapped.
    (refute (debug/traced-current? 'evsrv-ki107-inner))
    (debug/untrace-fn 'evsrv-ki107-outsider)))

(describe "boundary tracing (:trace)"
  ;; :isolated — tracing rebinds globals and `untrace-all` clears a SHARED registry,
  ;; so these must not run beside each other (concurrently they flipped each other's
  ;; wrappers in and out: a traced loop would keep or lose its tail-calls at random).
  :isolated (test "a defn and its call in ONE request still trace (install-per-form)"
    (let (r (eval-capturing "(defn evsrv-t-fac ((0) 1) ((n) (* n (evsrv-t-fac (- n 1)))))\n(evsrv-t-fac 3)"
              ["evsrv-t-fac"]))
      (assert= (get r :ok) true)
      (assert= (get r :value) "6")
      (let (spy (get r :spy)
            calls (seq/filter spy (fn (e) (= (get e :kind) "call")))
            returns (seq/filter spy (fn (e) (= (get e :kind) "return"))))
        (assert= (count calls) 4) ; fac 3, 2, 1, 0
        (assert= (count returns) 4)
        (assert= (get (first calls) :fn) "evsrv-t-fac")
        (assert= (get (first calls) :args) "(3)")
        (assert= (get (last returns) :value) "6"))))

  (test "traces are restored after the request (the next untraced call emits nothing)"
    ;; self-contained: trace in request 1, call untraced in request 2
    (eval-capturing "(defn evsrv-t-restored (x) (* 3 x))\n(evsrv-t-restored 1)"
      ["evsrv-t-restored"])
    (let (r (eval-capturing "(evsrv-t-restored 2)"))
      ; no :trace this time
      (assert= (get r :value) "6")
      (assert= (get r :spy) nil)))

  (test "a chatty traced recursion collects at most the cap"
    ;; NON-tail recursion re-resolves the global each level, so every level is traced
    (let (r (eval-capturing "(defn evsrv-t-chat ((0) 1) ((n) (* n (evsrv-t-chat (- n 1)))))\n(evsrv-t-chat 200)"
              ["evsrv-t-chat"]))
      (assert= (get r :ok) true)
      (assert= (count (get r :spy)) eval-server/*spy-entry-cap*))) ; 402 entries -> capped
  (test "tracing costs tail-calls only UP TO the cap: each traced self-call is a real crossing"
    ;; Inherent to boundary tracing while it is recording — the wrapper must return after
    ;; the call, so the self-call is not in tail position (the caveat Erlang/Emacs tracing
    ;; carries too). So a TAIL loop is traced per-iteration: a 300-deep traced loop fills
    ;; the spy cap, where TCO would have shown a single crossing.
    (let (r (eval-capturing "(defn evsrv-t-loop ((0) :done) ((n) (evsrv-t-loop (- n 1))))\n(evsrv-t-loop 300)"
              ["evsrv-t-loop"]))
      (assert= (get r :ok) true)
      (assert= (get r :value) ":done")
      (assert= (count (get r :spy)) eval-server/*spy-entry-cap*)) ; 600 crossings -> capped
    ;; …and UNTRACED the same loop is O(1) stack at any depth, as the language promises
    (assert= (get (eval-capturing "(defn evsrv-t-ok ((0) :done) ((n) (evsrv-t-ok (- n 1))))\n(evsrv-t-ok 200000)")
               :value)
      ":done"))

  (test "REGRESSION: a traced tail loop far past the frame limit reports its cap and RUNS"
    ;; The bug this pins: the cap silently dropped entries while the traced program kept
    ;; paying a frame per level, so the deep loop died at ~1 048 576 frames with
    ;; `recursion too deep` — and what died was a tutorial box whose whole subject is
    ;; "tail calls run in constant stack". Now the sink answers `:spy-stop` at the cap and
    ;; the tracer uninstalls itself, so the rest of the loop is a real tail loop.
    ;; 1.2M: comfortably past the VM's 1 048 576-frame limit (the thing being proved),
    ;; and not a second more of suite time than that needs.
    (let (r (eval-capturing "(defn evsrv-t-deep ((0) :liftoff) ((n) (evsrv-t-deep (- n 1))))\n(evsrv-t-deep 1200000)"
              ["evsrv-t-deep"]))
      (assert= (get r :ok) true)
      (assert= (get r :value) ":liftoff")
      (assert= (count (get r :spy)) eval-server/*spy-entry-cap*)))

  (test "tracing a name that never becomes a function is silently no trace"
    (let (r (eval-capturing "(+ 1 2)" ["no-such-fn-xyz"]))
      (assert= (get r :ok) true)
      (assert= (get r :spy) ())))

  (test "a traced request round-trips through the answer path"
    (let (r (answer {:id 42
                     :src "(defn evsrv-t-dbl (x) (* 2 x))\n(evsrv-t-dbl 21)"
                     :trace ["evsrv-t-dbl"]}))
      (assert= (get r :id) 42)
      (assert= (get r :value) "42")
      (is (>= (count (get r :spy)) 2)))))

(describe "tracing must never resurrect a stale definition (regression)"
  :isolated
  ;; `trace-fn` keeps the pre-instrumentation value in a registry and prefers it when
  ;; re-tracing. Installing a trace after EVERY form therefore re-captured the older
  ;; function once the source redefined it, and the wrapper called that — so a fixed
  ;; exercise reported the old answer and a broken one reported the fixed answer,
  ;; depending on history. Traces are now installed once, before the first call form.
  (test "a traced defn+call reports the definition IN THE SOURCE, not a previous one"
    ;; define it wrong, then right, then wrong again — each verdict must be honest
    (assert= (get (eval-capturing "(defn evsrv-t-tri (x) (+ x 3))\n(evsrv-t-tri 14)"
                    ["evsrv-t-tri"])
               :value)
      "17")
    (assert= (get (eval-capturing "(defn evsrv-t-tri (x) (* x 3))\n(evsrv-t-tri 14)"
                    ["evsrv-t-tri"])
               :value)
      "42")
    (assert= (get (eval-capturing "(defn evsrv-t-tri (x) (+ x 3))\n(evsrv-t-tri 14)"
                    ["evsrv-t-tri"])
               :value)
      "17"))

  (test "a PRIVATE (defn-) redefinition is a definition too — a later traced request sees it"
    ;; `defn-` was missing from the definition list, so its request installed the traces
    ;; FIRST, the `defn-` rebound under them, and the teardown restored the old body —
    ;; every request after reported the definition before the edit (bedit playground).
    (eval-capturing "(defn- evsrv-t-priv (acc val) val)" :all)
    (eval-capturing "(defn evsrv-t-priv-use (xs) (reduce xs '() evsrv-t-priv))" :all)
    (assert= (get (eval-capturing "(evsrv-t-priv-use [\"1\" \"2\"])"
                    ["evsrv-t-priv" "evsrv-t-priv-use"])
               :value)
      "\"2\"")
    (eval-capturing "(defn- evsrv-t-priv (acc val) (conj acc (string/->number val)))" :all)
    (let (r (eval-capturing "(evsrv-t-priv-use [\"1\" \"2\"])" ["evsrv-t-priv" "evsrv-t-priv-use"]))
      (assert= (get r :value) "(2 1)")
      (assert= (get (first (seq/filter (get r :spy)
                             (fn (e)
                               (and (= (get e :kind) "return") (= (get e :fn) "evsrv-t-priv")))))
                 :value)
        "(1)")))

  (test "a redefinition MID-request is traced as redefined: traces are re-installed per form"
    ;; No definition-form predicate any more: `trace-fn` is generation-aware, so the
    ;; server (re)installs before every form and a name the previous form redefined is
    ;; wrapped afresh around its new body.
    (let (r (eval-capturing "(defn evsrv-t-mid (x) (+ x 1))\n(evsrv-t-mid 1)\n(defn evsrv-t-mid (x) (* x 10))\n(evsrv-t-mid 1)"
              ["evsrv-t-mid"])
          returns (map (seq/filter (get r :spy) (fn (e) (= (get e :kind) "return")))
                    (fn (e) (get e :value))))
      (assert= (get r :value) "10")
      (assert= (list "2" "10") returns)))

  (test "the traced call is wrapped exactly once (no double-wrapping)"
    (let (r (eval-capturing "(defn evsrv-t-once (x) (* 2 x))\n(evsrv-t-once 5)" ["evsrv-t-once"])
          calls (seq/filter (get r :spy) (fn (e) (= (get e :kind) "call"))))
      (assert= (get r :value) "10")
      (assert= (count calls) 1)))

  (test "an untraced request after a traced one sees the source's own definition"
    (eval-capturing "(defn evsrv-t-plain (x) (* 5 x))\n(evsrv-t-plain 2)" ["evsrv-t-plain"])
    (assert= (get (eval-capturing "(evsrv-t-plain 3)") :value) "15"))

  (test "a recursive traced fn still reports every level"
    (let (r (eval-capturing "(defn evsrv-t-f ((0) 1) ((n) (* n (evsrv-t-f (- n 1)))))\n(evsrv-t-f 4)"
              ["evsrv-t-f"]))
      (assert= (get r :value) "24")
      (assert= (count (seq/filter (get r :spy) (fn (e) (= (get e :kind) "call")))) 5))))

(describe "process accounting (:procs)"
  :isolated (test "a plain evaluation leaves nothing running"
    (assert= (get (eval-capturing "(+ 1 2)") :procs) {:alive 0}))

  (test "a round-trip that finishes leaves nothing running"
    ;; The child sends and dies — correctly reported as 0, and deliberately NOT guessed at
    ;; as a spawn count (see the docstring).
    ;;
    ;; It WAITS for the child's `:down` rather than assuming the send implies the death.
    ;; Receiving `:hi` only proves the message was delivered, and the child still has to
    ;; finish and be reaped after that — so under a loaded scheduler `:alive` could sample
    ;; the child mid-teardown and read 1. Seen once in a full-suite run, then not again in
    ;; four; monitoring makes the ordering a fact instead of a likelihood.
    (let (r (eval-capturing (str "(let (me (self))"
                              "  (let (child (spawn (send me :hi)) mref (monitor child))"
                              "    (receive (:hi nil))" "    (receive ([:down ^mref _ _] :got))))")))
      (assert= (get r :value) ":got")
      (assert= (get-in r [:procs :alive]) 0)))

  (test "a process left PARKED is reported as still running — the leak is visible"
    (let (r (eval-capturing "(do (spawn (receive (:never nil))) :spawned-and-left)"))
      (assert= (get r :value) ":spawned-and-left")
      (is (>= (get-in r [:procs :alive]) 1)))))

(describe "the session namespace"
  (test "a defmodule in one request governs the definitions of the next"
    ;; Each request evaluates in its own green process, and the compile namespace is
    ;; per process — so this used to define a bare `probe-fn` and answer
    ;; `unbound symbol: evsrv-ns-probe/probe-fn` for the third request.
    (answer {:id 1 :src "(defmodule evsrv-ns-probe)"})
    (let (defined (answer {:id 2 :src "(defn probe-fn (x) x)"})
          called (answer {:id 3 :src "(evsrv-ns-probe/probe-fn 41)"}))
      (assert= (get defined :value) "evsrv-ns-probe/probe-fn")
      (is (get called :ok))
      (assert= (get called :value) "41")))

  (test "the module's (:use …) imports carry over too, and a return to root sticks"
    ;; The first fix carried only the namespace: `assert=` was `unbound symbol:
    ;; evsrv-use-probe/assert=` one request later. Imports are per-process state as well.
    (answer {:id 1 :src "(defmodule evsrv-use-probe (:use test))"})
    (let (defined (answer {:id 2 :src "(defn checked (x) (assert= x x) x)"})
          called (answer {:id 3 :src "(evsrv-use-probe/checked 7)"})
          back (answer {:id 4 :src "(%in-ns nil)"})
          root (answer {:id 5 :src "(reflect/current-ns)"}))
      (assert= (get defined :value) "evsrv-use-probe/checked")
      (is (get called :ok))
      (assert= (get called :value) "7")
      (is (get back :ok))
      (assert= (get root :value) "nil"))))

(describe ":check requests — the checker's verdict, structured and whole"
  (test "the codec round-trips a check request, and a non-boolean :check is rejected"
    (let (line (evsrv-encode-check 3 "(+ 1 x)" 2000)
          req (evsrv-decode-request line))
      (assert= (get req :id) 3)
      (assert= (get req :check) true)
      (is (nil? (evsrv-decode-request "{:id 3 :src \"x\" :check 1}")))))
  (test "answer runs the checker instead of the evaluator: diagnostics as maps, nothing evaluated"
    (let (r (answer {:id 11 :src "(io/puts (undefined-fn-zz 1))" :check true}))
      (assert= (get r :ok) true)
      (is (nil? (get r :value))) ; not an eval
      (is (any? (get r :diagnostics) (fn (d) (includes? (get d :message) "undefined-fn-zz"))))
      (is (every? (get r :diagnostics) (fn (d) (and (int? (get d :line)) (int? (get d :col))))))))
  (test "a clean source checks to an empty list; a source that does not parse too"
    (assert= (get (answer {:id 12 :src "(+ 1 2)" :check true}) :diagnostics) ())
    (assert= (get (answer {:id 13 :src "(+ 1" :check true}) :diagnostics) ())))

;; ---- the test request: this project's suite, in the session ----------------------
;; The third request kind, and the one that STREAMS: a suite has something to say per
;; test, and holding it all until the end would turn the only part a reader watches into
;; a wait. Worth having in a session because a one-shot run of a single file in a project
;; of sixty modules spends most of its time loading the project, not running tests.

(describe "eval-server test requests"
  (test "a test request round-trips, carrying files rather than source"
    ;; `:specs` and not `:src`: what it names is FILES — the tests already exist on disk,
    ;; and sending their text would evaluate a copy rather than run the thing you are
    ;; looking at
    (let (line (evsrv-encode-test 4 [["tests/a_test.blsp" nil] ["tests/b_test.blsp" 12]] 60000)
          req (evsrv-decode-request line))
      (assert= (get req :id) 4)
      (assert= (get req :test) true)
      (assert= (get req :timeout-ms) 60000)
      (assert= (count (get req :specs)) 2)
      (assert= (second (second (get req :specs))) 12)
      ;; …and it carries no :src at all, which the decoder must not insist on
      (is (nil? (get req :src)))))

  (test "the whole project suite is an empty spec list"
    (let (req (evsrv-decode-request (evsrv-encode-test 1 [] nil)))
      (assert= (get req :specs) [])
      (assert= (get req :test) true)))

  (test "a test request with non-vector specs fails decode like any other bad line"
    (assert= (evsrv-decode-request "{:id 1 :test true :specs \"tests/\"}") nil)
    ;; and a non-test request still has to carry a string :src
    (assert= (evsrv-decode-request "{:id 1 :specs []}") nil))

  ;; The reason a session may run tests at all. `describe`/`test` REGISTER by consing onto
  ;; `*units*`, so an image that loads the same file twice registers every unit twice —
  ;; measured before the reset was called here: a 27-test file answered 27, then 54, then
  ;; 81. A runner that is wrong in a way that looks like a passing suite.
  ;; `:isolated` because these two CLEAR THE TEST REGISTRY, and the suite running them is
  ;; itself in it — without a private copy of the globals they empty the run they are part
  ;; of, and the count they then measure is whatever the parallel batch happened to leave.
  ;; Both go through `answer-test`, the public seam, rather than the private loader
  ;; underneath it: `evsrv-test-load` resets the registry, so it can have no `form → result`
  ;; example (one executed inside the suite would empty the run it is part of) and is
  ;; therefore private — which is the right shape anyway, since what a client can reach is
  ;; a request.
  :isolated (test "loading the same file twice does not double the registry"
    (let (f (str (test/temp-dir "evsrv-test-") "/x_test.blsp"))
      (file/mkdir (path/dirname f))
      (file/spit f "(defmodule x-test (:use test))\n(describe \"x\" (test \"one\" (is true)))\n")
      (let (once (do (answer-test {:id 1 :test true :specs [[f nil]]}) (count *units*))
            twice (do (answer-test {:id 2 :test true :specs [[f nil]]}) (count *units*)))
        (assert= once twice)
        ;; …and the reset is total: what was registered before this run is gone too, which
        ;; is what makes each run own its registry
        (is (<= once 1)))
      (file/rm f)))

  ;; The filter is asserted by what it RUNS, not by the pair list the private loader
  ;; returns — two tests on known lines, so a line-spec is observably narrower than the
  ;; bare file. That is the property the pair list existed to produce.
  :isolated (test "the lines a spec carries become the runner's filter, and a bare file none"
    (let (f (str (test/temp-dir "evsrv-test-") "/y_test.blsp"))
      (file/mkdir (path/dirname f))
      (file/spit f
        "(defmodule y-test (:use test))\n(describe \"y\"\n  (test \"one\" (is true))\n  (test \"two\" (is true)))\n")
      (let (whole (answer-test {:id 3 :test true :specs [[f nil]]})
            just-one (answer-test {:id 4 :test true :specs [[f 3]]}))
        (assert= (get (get whole :summary) :total) 2)
        (assert= (get (get just-one :summary) :total) 1))
      (file/rm f)))
  (test "a broken test file is a reply, not a dead server"
    ;; the sink is cleared on the way out either way, or the NEXT run would stream its
    ;; verdicts into a request that has already been answered
    (let (r (answer-test {:id 9 :test true :specs [["/no/such/file_test.blsp" nil]]}))
      (assert= (get r :id) 9)
      (assert= (get r :ok) false)
      (is (includes? (get r :error) "test run failed"))
      (is (nil? *test-report-sink*)))))

;; The channel is shared with whatever the evaluated code prints, and a print with no
;; trailing newline does not get a line of its own — it gets the front of the next one.
(describe "a reply that something prefixed"
  (test "is salvaged from its first brace"
    (let (r (evsrv-decode-reply "....{:id 3 :ok true :value \"7\"}"))
      (assert= (get r :id) 3)
      (assert= (get r :value) "7")))
  (test "an unprefixed reply still reads as it always did"
    (assert= (get (evsrv-decode-reply "{:id 1 :ok true}") :id) 1))
  (test "and a line with no map in it is still nil"
    (is (nil? (evsrv-decode-reply "hello from a spawned process")))
    (is (nil? (evsrv-decode-reply "....")))
    (is (nil? (evsrv-decode-reply "")))
    ;; a brace that opens nothing readable is not a reply either
    (is (nil? (evsrv-decode-reply "note: {unclosed")))))

;; ---- the requests that move or stop work ----------------------------------------
(describe "eval-server: stopping, and attaching elsewhere"
  (test "a teststop round-trips and needs no payload"
    ;; the bug this shape had: an empty payload made the request line three fields, and a
    ;; three-field line was dropped — so a stop cost the full timeout and a respawn
    (let (req (evsrv-decode-request (evsrv-encode-teststop 4)))
      (assert= (get req :id) 4)
      (assert= (get req :teststop) true)
      (is (nil? (get req :src)))))

  (test "an attach carries the node and its cookie; a detach carries neither"
    (let (a (evsrv-decode-request (evsrv-encode-attach 7 "app@host:4370" "secret"))
          d (evsrv-decode-request (evsrv-encode-detach 8)))
      (assert= (get a :attach) "app@host:4370")
      (assert= (get a :cookie) "secret")
      (assert= (get d :detach) true)
      (is (nil? (get d :attach)))))

  (test "a malformed attach is dropped like any other bad line"
    (assert= (evsrv-decode-request "{:id 1 :attach 42}") nil)
    ;; …and an ordinary request still has to carry a string :src
    (assert= (evsrv-decode-request "{:id 1}") nil)))
