;; std/editor/serve.blsp — serving a `ui-run` app to remote frontends (ADR-090).
;; The daemon runs the app; a thin client paints pushed frames and ships back keys.
;; Here the *test process plays the client* in-process — local pids `send`/`receive`
;; exactly as remote ones do (a node link is just a longer copy), so the full
;; serve → frame → key → frame → quit protocol is exercised without a node or a TTY.
;; The cross-node, real-TCP variant is `crates/cli/tests/serve_attach.rs`.

(defmodule serve-test
  (:use-internals editor/serve)
  (:use-internals editor/attach)
  (:use test)
  (:use editor/serve)
  (:use editor/attach)
  (:use editor/serve-protocol)
  (:use editor/display)
  (:use editor/ui))

;; A tiny served app: a counter. `"+"` increments, `"q"` quits; the view paints the
;; count. An async `[:note n]` event (a non-key mailbox message — the event-bus shape)
;; sets the count directly. Each client gets a fresh model from `mk`.
(defn mk () {:n 0})
(defn vw (m c r)
  [(text 0
     0
     (str "n="
       (get m :n)
       (if (get m :who) (str " who=" (get m :who)) "")))])
(defn up (m input c r)
  (cond
    (= input "+") (assoc m :n (+ (get m :n) 1))
    (= input "q") (assoc m :done true)
    (and (vector? input) (= (first input) :note)) (assoc m :n (nth input 1))
    ;; the identity event a named attach delivers before any key (serve-session)
    (and (vector? input) (= (first input) :client-opts)) (assoc m :who (get (nth input 1) :name))
    else m))

;; The text string of a frame's first `[:text row col s]` op — what the app rendered.
(defn frame-text (f) (nth (first f) 3))

;; A helper "client" process: attach to `mgr`, press `"+"` once, and report the
;; frame text it sees back to `report`. Used to prove two clients are independent.
(defn probe (mgr report)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached s]
      (do
        ;; consume the initial frame (drawn at n=0 before any key), then press "+"
        ;; and report the frame that key produces
        (receive ([:frame _] nil) (after test/*wait-ms* nil))
        (send s [:key "+"])
        (receive
          ([:frame f] (send report [:probed (frame-text f)]))
          (after test/*wait-ms* (send report [:probed :no-frame])))))
    (after test/*wait-ms* (send report [:probed :no-attach]))))

;; A scripted GUI-style display for the any-display client (`attach-display-loop`):
;; `:draw` reports the frame's text to `report`. Input is NOT read via `:poll` — the
;; unified client loop reads the mailbox directly (as a real gui-display's input does),
;; so the test injects keys by `send`ing them to the client process.
(defn gui-mock-display (report)
  {:enter (fn () nil)
   :leave (fn () (send report [:drew :left]))
   :size (fn () [80 24])
   :draw (fn (f) (send report [:drew (frame-text f)]))
   :poll (fn (_ms) nil)})

;; A GUI client played in-process: attach to `mgr`, tell the test our pid + session, then
;; run the unified any-display loop. The test drives it by `send`ing keys to our pid.
(defn gui-probe (mgr ready)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached session] (do
                           (send ready [:ready (self) session])
                           (editor/attach/attach-display-loop nil session (gui-mock-display ready))))
    (after test/*wait-ms* (send ready [:ready :no-attach :no-attach]))))

;; A shared-session client played in-process: attach, announce our pid, then loop —
;; reporting each CHANGED frame's text (deduped, so tick re-renders don't spam the test)
;; and shipping a [:press k] from the test to the shared session as a keystroke.
(defn shared-client-loop (session report last)
  (receive
    ([:frame f] (let (t (frame-text f))
                  (do
                    (when (not (= t last)) (send report [:cframe (self) t]))
                    (shared-client-loop session report t))))
    ([:press k] (do (send session [:key k]) (shared-client-loop session report last)))
    ([:bye] nil)))

(defn shared-client (mgr report)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached session] (do
                           (send report [:cready (self)])
                           (shared-client-loop session report :none)))
    (after test/*wait-ms* (send report [:cready :no-attach]))))

;; Receive `[:drew t]` frames until one equals `want` (skipping tick re-renders of an
;; unchanged frame), or time out — the deduped wait the local-window test drives.
(defn wait-drew (want)
  (receive ([:drew t] (if (= t want) :ok (wait-drew want))) (after test/*wait-ms* :timeout)))

;; Every message already queued here, oldest first.
(defn drain-mailbox (acc) (receive (m (drain-mailbox (conj acc m))) (after 0 acc)))

;; Run the window client (`attach-display-loop`) in its own process over the display
;; `(display-of me)` builds, with `messages` (a string is window input, on the priority
;; lane) and then the daemon's `[:bye]` queued BEFORE it looks — a backlog — and answer
;; what the display and the session were sent, in order, once the client has ended.
(defn drive-backlog (display-of messages)
  (let (me (self)
        [client watch] (spawn-monitor (receive
                                        (:go (editor/attach/attach-display-loop nil
                                               me
                                               (display-of me))))))
    (doseq (m messages) (if (string? m) (proc/send-priority client m) (send client m)))
    (send client [:bye])
    (send client :go)
    (receive ([:down ^watch _ _] nil) (after test/*wait-ms* nil))
    (drain-mailbox [])))

(describe "editor/serve — attach-display-local (the host's own window)"
  :isolated (test "the operator attaches a local display to the session it serves in the same runtime"
    ;; No node link: attach-display-local handshakes with the local manager (proc/whereis serve-name)
    ;; and runs the unified loop, so a served daemon can also show the host a live window.
    (let (report (self))
      ; register a manager under serve-name in THIS (isolated) runtime
      (serve mk vw up)
      (let (host (spawn (fn () (attach-display-local (gui-mock-display report)))))
        ; the fresh model paints to the host's window
        (is (= (wait-drew "n=0") :ok))
        ; a window key ships to the session -> new frame
        (send host "+")
        (is (= (wait-drew "n=1") :ok))
        ; the window's X detaches and leaves cleanly
        (send host :close)
        (is (= (wait-drew :left) :ok))))))

(describe "editor/serve — serving a ui-run app to a remote frontend"
  (test "an attached client gets a session pid, the initial frame, then key-driven frames"
    (let (mgr (spawn (editor/serve/serve-manager mk vw up)))
      ; the daemon's session manager
      (send mgr [:attach (self) 80 24])
      (let (session (receive ([:attached s] s) (after test/*wait-ms* :no-attach)))
        (is (not (= session :no-attach)))
        ;; the session renders immediately on start — the first frame is the fresh model
        (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))) "n=0")
        ;; a key we ship drives the app; the next frame reflects it
        (send session [:key "+"])
        (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))) "n=1")
        (send session [:key "+"])
        (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))) "n=2")
        ;; "q" sets :done; ui-run quits and :leave tells the client to restore (:bye)
        (send session [:key "q"])
        (assert= (receive ([:bye] :bye) (after test/*wait-ms* :no-bye)) :bye))))

  (test "each client gets an independent session with its own model"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw up)))
      ;; two clients attach to the same manager and each press "+" once
      (spawn (probe mgr me))
      (spawn (probe mgr me))
      ;; if the model were shared, one would see n=2; independent ⇒ both see n=1
      (assert= (receive ([:probed t] t) (after test/*wait-ms* :none)) "n=1")
      (assert= (receive ([:probed t] t) (after test/*wait-ms* :none)) "n=1")))

  (test "a session that dies without a clean :bye still notifies the client (monitor)"
    ;; `make-model` runs *before* ui-run, so a throw there kills the session before
    ;; `:leave`/`[:bye]` can fire. The client monitors the session pid (as attach-session
    ;; does), so it learns via `[:down …]` instead of hanging — the robustness fix.
    (let (bad-mk (fn () (error "boom in make-model"))
          mgr (spawn (editor/serve/serve-manager bad-mk vw up)))
      (send mgr [:attach (self) 80 24])
      ;; [:attached] is sent before make-model runs, so we still get the session pid
      (let (session (receive ([:attached s] s) (after test/*wait-ms* :no-attach)))
        (is (not (= session :no-attach)))
        (monitor session)
        (assert= (receive ([:down _ _ _] :down) (after test/*wait-ms* :no-down)) :down))))

  (test "serve registers the manager under the well-known serve-name"
    ;; the only test that touches the global `:ui` name (avoids cross-test clashes)
    (do
      (serve mk vw up)
      (is (not (nil? (proc/whereis serve-name))))))

  (test "attach-display (GUI client): frames paint to the display, input ships back, :close tears down"
    ;; The terminal client reads input from the TTY; a GUI client reads window input from
    ;; the SAME mailbox the daemon pushes frames to, so `attach-display-loop` unifies both
    ;; in one receive. This drives that loop with a scripted display and in-process pids —
    ;; the full frame → key → frame → detach protocol, no node or window.
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw up)))
      (spawn (gui-probe mgr me))
      (let ([client session] (receive ([:ready c s] [c s]) (after test/*wait-ms* [nil nil])))
        (is (not (nil? client)))
        (is (not (= client :no-attach)))
        ;; the session renders the fresh model immediately; the client paints it
        (assert= (receive ([:drew t] t) (after test/*wait-ms* :none)) "n=0")
        ;; a window key lands in the client's mailbox -> shipped to the session -> new frame
        (send client "+")
        (assert= (receive ([:drew t] t) (after test/*wait-ms* :none)) "n=1")
        (send client "+")
        (assert= (receive ([:drew t] t) (after test/*wait-ms* :none)) "n=2")
        ;; the window's close button ships [:detach]; the session's remote-display maps that
        ;; to :close, ui-run quits, and the session process ends — observed via a monitor.
        (monitor session)
        (send client :close)
        (assert= (receive ([:down _ _ _] :down) (after test/*wait-ms* :no-down)) :down))))

  (test "serve-shared: two clients share ONE model — an edit by one is seen by both"
    ;; Unlike `serve` (a fresh model per client), `serve-shared` runs a single ui-run and
    ;; fans it to all clients while merging their input. Two in-process clients attach to the
    ;; SAME session; a "+" from one increments the shared model and BOTH see the new frame.
    (let (me (self)
          hub (spawn (editor/serve/shared-hub () nil [80 24]))
          session (spawn (ui-run (mk) vw up (editor/serve/shared-display hub)))
          mgr (spawn (editor/serve/serve-shared-manager session hub)))
      (let (_a (spawn (shared-client mgr me))
            aid (receive ([:cready c] c) (after test/*wait-ms* :none)))
        (is (not (= aid :none)))
        ;; A sees the shared model's initial frame
        (assert= (receive ([:cframe _ t] t) (after test/*wait-ms* :none)) "n=0")
        ;; B attaches to the SAME session and also sees n=0
        (let (_b (spawn (shared-client mgr me))
              bid (receive ([:cready c] c) (after test/*wait-ms* :none)))
          (is (not (= bid :none)))
          (assert= (receive ([:cframe _ t] t) (after test/*wait-ms* :none)) "n=0")
          ;; A presses "+"; the shared model increments and BOTH clients get the n=1 frame
          (send aid [:press "+"])
          (let (t1 (receive ([:cframe _ t] t) (after test/*wait-ms* :none))
                t2 (receive ([:cframe _ t] t) (after test/*wait-ms* :none)))
            (assert= t1 "n=1")
            (assert= t2 "n=1"))))))

  (test "serve-stop ends every live session — the client's monitor fires"
    (let (mgr (spawn (editor/serve/serve-manager mk vw up)))
      (send mgr [:attach (self) 80 24])
      (let (session (receive ([:attached s] s) (after test/*wait-ms* :no-attach)))
        (is (not (= session :no-attach)))
        (monitor session)
        ; the session is live
        (receive ([:frame _] nil) (after test/*wait-ms* nil))
        ; one session ended
        (assert= (editor/serve/serve-stop mgr) 1)
        (assert= (receive ([:down _ _ _] :down) (after test/*wait-ms* :no-down)) :down))))

  (test "remote-display: :draw ships a frame, :size reports the attach size, :poll maps input"
    (let (d (remote-display (self) 80 24))
      ;; :draw sends the frame to the client (us) verbatim
      ((get d :draw) [:A-FRAME])
      (assert= (receive ([:frame f] f) (after 5000 :none)) [:A-FRAME])
      ;; :size is the size reported at attach…
      (assert= ((get d :size)) [80 24])
      ;; …until the client ships a resize, which reaches the app too (ADR-587)
      (send (self) [:key [:resize 100 30] false])
      (assert= ((get d :poll) 500) [:resize 100 30])
      (assert= ((get d :size)) [100 30])
      (send (self) [:key [:resize 90 20]])
      (assert= ((get d :poll-input)) [:resize 90 20])
      (assert= ((get d :size)) [90 20])
      ;; :poll returns a shipped key, and maps a detach request to :close (ui-run quits)
      (send (self) [:key "z"])
      (assert= ((get d :poll) 500) "z")
      (send (self) [:detach])
      (assert= ((get d :poll) 500) :close)
      ;; any OTHER mailbox message passes through as async app input (the event bus) —
      ;; a served app's task replies / buffer pushes reach update, as on a local display
      (send (self) [:note 9])
      (assert= ((get d :poll) 500) [:note 9])
      ;; nothing waiting ⇒ nil after the timeout (ui-run treats it as :tick)
      (assert= ((get d :poll) 1) nil)))
  (test "remote-display: a key down in the client's window holds the session's idle timers"
    ;; the client ships whether a key is down with each input, and :key-held? answers the
    ;; last one, so a served ui-run waits through a held key as a local window's does
    (let (d (remote-display (self) 80 24))
      (refute ((get d :key-held?)))
      (send (self) [:key "a" true])
      (assert= ((get d :poll) 500) "a")
      (is ((get d :key-held?)))
      (send (self) [:key [:key-up "a"] false])
      (assert= ((get d :poll) 500) [:key-up "a"])
      (refute ((get d :key-held?)))))
  (test "remote-display: the pixel-space seam ships a texture, its release and the window options"
    ;; The three entries a game's `run-on` uses (ADR-374): each becomes one client-bound
    ;; message the thin client's loop applies to its own display — so a served game's
    ;; sprite sheet lands in the client's window and the window is told to report pixels.
    (let (d (remote-display (self) 80 24))
      ((get d :texture) 7 [1 2 3 4] 1 1)
      (assert= (receive ([:texture tex rgba w h] [tex rgba w h]) (after 5000 :none))
        [7 [1 2 3 4] 1 1])
      ((get d :texture-free) 7)
      (assert= (receive ([:texture-free tex] tex) (after 5000 :none)) 7)
      ((get d :configure) {:input :pixels :title "game"})
      (assert= (receive ([:window o] o) (after 5000 :none)) {:input :pixels :title "game"})
      ((get d :sound) 5 [0 0 0 0] 8000 1)
      (assert= (receive ([:sound-data snd pcm rate ch] [snd pcm rate ch]) (after 5000 :none))
        [5 [0 0 0 0] 8000 1])
      ((get d :sound-free) 5)
      (assert= (receive ([:sound-free snd] snd) (after 5000 :none)) 5)))

  (test "attach-display-loop applies a shipped texture and window options to the local display"
    ;; A fake display records what the loop hands it; a display WITHOUT the entries (the
    ;; terminal) must not be asked — the message is dropped, not a crash. `[:bye]` ends
    ;; the loop, as the app quitting does.
    (let (log (table/new)
          display {:draw (fn (f) (table/put log :frame f))
                   :texture (fn (tex _rgba w h) (table/put log :texture [tex w h]))
                   :configure (fn (o) (table/put log :window o))
                   :leave (fn () nil)}
          bare {:draw (fn (_f) nil) :leave (fn () nil)})
      (send (self) [:texture 3 [0 0 0 0] 1 1])
      (send (self) [:window {:input :pixels}])
      (send (self) [:frame [:clear]])
      (send (self) [:bye])
      (editor/attach/attach-display-loop nil (self) display)
      (assert= (table/get log :texture) [3 1 1])
      (assert= (table/get log :window) {:input :pixels})
      (assert= (table/get log :frame) [:clear])
      ;; the bare display: the same messages, nothing to apply them to, no error
      (send (self) [:texture 3 [0 0 0 0] 1 1])
      (send (self) [:texture-free 3])
      (send (self) [:window {:input :pixels}])
      (send (self) [:bye])
      (assert= (editor/attach/attach-display-loop nil (self) bare) nil)))

  ;; ADR-490: the client's own window input goes out before it paints a backlog of frames
  (test "attach-display-loop ships a queued key before it paints queued frames"
    (let (me (self)
          client (spawn (receive
                          (:go (editor/attach/attach-display-loop nil
                                 me
                                 {:draw (fn (f) (send me [:drew f]))
                                  :leave (fn () nil)
                                  :poll-input (fn ()
                                                (let (taken (proc/take-priority))
                                                  (if (nil? taken) nil (first taken))))})))))
      (doseq (i (range 50)) (send client [:frame [:frame-number i]]))
      (proc/send-priority client "k")
      (send client [:bye])
      (send client :go)
      (assert= (receive ([:key k _held?] k) ([:drew f] [:drew-first f]) (after 5000 :none)) "k")))

  ;; ADR-492: a backlog paints once, the newest frame, with every seam message applied in
  ;; the order the daemon sent it relative to that frame
  (test "attach-display-loop paints only the newest of a backlog, every texture uploaded"
    (let (seen (drive-backlog (fn (me)
                                {:draw (fn (f) (send me [:drew f]))
                                 :texture (fn (tex _rgba _w _h) (send me [:uploaded tex]))
                                 :leave (fn () nil)})
                 (mapcat (range 20)
                   (fn (i) [[:texture i [0 0 0 0] 1 1] [:frame [[:sprite i 0 0 1 1]]]]))))
      (assert= (vec (seq/filter seen (fn (e) (= (first e) :drew))))
        [[:drew [[:sprite 19 0 0 1 1]]]])
      (assert= (vec (map (seq/filter seen (fn (e) (= (first e) :uploaded))) second))
        (vec (range 20)))
      ;; every upload, the newest frame's own included, before the one paint
      (assert= (last seen) [:drew [[:sprite 19 0 0 1 1]]])))

  (test "a hung-up terminal client detaches — its SIGHUP is not shipped to the session as a key"
    (let (seen (drive-backlog (fn (_me) {:draw (fn (_f) nil) :leave (fn () nil)})
                 [[:signal :hup] [:frame [[:text 0 0 "after"]]]]))
      (do
        (assert= (first seen) [:detach])
        (is (empty? (seq/filter seen (fn (e) (= (first e) :key))))))))

  (test "a texture freed after the newest frame is freed only after that frame is painted"
    (assert= (drive-backlog (fn (me)
                              {:draw (fn (f) (send me [:drew f]))
                               :texture-free (fn (tex) (send me [:freed tex]))
                               :leave (fn () nil)})
               [[:frame [[:sprite 0 0 0 1 1]]]
                 [:texture-free 0]
                 [:frame [[:sprite 2 0 0 1 1]]]
                 [:texture-free 2]])
      [[:freed 0] [:drew [[:sprite 2 0 0 1 1]]] [:freed 2]]))

  (test "a skipped frame's sound and burst ride on the frame painted"
    (assert= (drive-backlog (fn (me) {:draw (fn (f) (send me [:drew f])) :leave (fn () nil)})
               [[:frame [[:clear] [:sound 4 0.5]]]
                 [:frame [[:clear] [:scroll-region 0 0 [[:burst 7 3]]] [:music 5]]]
                 [:frame [[:text 0 0 "last"]]]])
      [[:drew [[:text 0 0 "last"] [:sound 4 0.5] [:burst 7 3]]]]))

  (test "a skipped frame's sound is played before the free that followed it"
    ;; the daemon played sound 4 in a frame, then freed it: carried past the free to the
    ;; next paint, it would play a freed (or reused) sound. A frame whose one-shots a seam
    ;; message follows is painted in its turn instead.
    (assert= (drive-backlog (fn (me)
                              {:draw (fn (f) (send me [:drew f]))
                               :sound-free (fn (snd) (send me [:freed snd]))
                               :leave (fn () nil)})
               [[:frame [[:clear] [:sound 4 0.5]]]
                 [:sound-free 4]
                 [:frame [[:text 0 0 "a"]]]
                 [:frame [[:text 0 0 "last"]]]])
      [[:drew [[:clear] [:sound 4 0.5]]] [:freed 4] [:drew [[:text 0 0 "last"]]]]))

  (test "a key queued behind a backlog still goes before its paint"
    (assert= (drive-backlog (fn (me)
                              {:draw (fn (f) (send me [:drew f]))
                               :leave (fn () nil)
                               :poll-input (fn ()
                                             (let (taken (proc/take-priority))
                                               (if (nil? taken) nil (first taken))))})
               [[:frame [[:text 0 0 "1"]]] "k" [:frame [[:text 0 0 "2"]]]])
      [[:key "k" false] [:drew [[:text 0 0 "2"]]]]))

  (test "remote-display ships a frame newest-wins, and one carrying a sound plainly"
    ;; the sink takes nothing until every send is queued, as a client behind its daemon
    (let (me (self)
          sink (spawn (receive (:go (send me [:got (drain-mailbox [])]))))
          display (editor/serve/remote-display sink 80 24))
      ((get display :draw) [[:text 0 0 "1"]])
      ((get display :draw) [[:sound 1]])
      ((get display :draw) [[:text 0 0 "2"]])
      ((get display :texture) 3 [0 0 0 0] 1 1)
      ((get display :draw) [[:text 0 0 "3"]])
      (send sink :go)
      (assert= (receive ([:got seen] seen) (after test/*wait-ms* :none))
        [[:frame [[:sound 1]]] [:texture 3 [0 0 0 0] 1 1] [:frame [[:text 0 0 "3"]]]])))

  (test "an async (non-key) mailbox message reaches a served app's update — the event bus"
    ;; The editor pattern: a spawned task / buffer process sends `[:tag …]` straight to the
    ;; ui-run process's mailbox and update folds it. On a served session those messages land
    ;; in the SESSION's mailbox; remote-display's :poll must deliver them (not strand them).
    (let (mgr (spawn (editor/serve/serve-manager mk vw up)))
      (send mgr [:attach (self) 80 24])
      (let (session (receive ([:attached s] s) (after test/*wait-ms* :no-attach)))
        (is (not (= session :no-attach)))
        (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))) "n=0")
        ;; not a [:key …] — an async event, as a buffer push or task reply would arrive
        (send session [:note 42])
        (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))) "n=42"))))

  (test "an attach with an identity opts map reaches the app as [:client-opts …] before any key"
    ;; The 5-element [:attach client cols rows opts] handshake: the session queues the opts
    ;; to its own mailbox before ui-run starts, so the FIRST event the app folds is its
    ;; participant identity — the seam a collaborative app reads a name from. A plain
    ;; 4-element attach (every other test here) still works: opts default to {}.
    (let (mgr (spawn (editor/serve/serve-manager mk vw up)))
      (send mgr [:attach (self) 80 24 {:name "alice"}])
      (let (session (receive ([:attached s] s) (after test/*wait-ms* :no-attach)))
        (is (not (= session :no-attach)))
        ;; the first frame already reflects the identity (folded before the initial render's
        ;; first poll returns a key) — or at latest the next one; accept either
        (let (t (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))))
          (if (includes? t "who=alice")
            (is true)
            (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none)))
              "n=0 who=alice"))))))

  (test "an async mailbox message reaches a SHARED session's update too"
    (let (me (self)
          hub (spawn (editor/serve/shared-hub () nil [80 24]))
          session (spawn (ui-run (mk) vw up (editor/serve/shared-display hub)))
          mgr (spawn (editor/serve/serve-shared-manager session hub)))
      (let (_a (spawn (shared-client mgr me))
            aid (receive ([:cready c] c) (after test/*wait-ms* :none)))
        (is (not (= aid :none)))
        (assert= (receive ([:cframe _ t] t) (after test/*wait-ms* :none)) "n=0")
        (send session [:note 7])
        (assert= (receive ([:cframe _ t] t) (after test/*wait-ms* :none)) "n=7")))))

;; ---- the busy cursor across the link (ADR-491) ----------------------------------
;; A served loop busy past its quit key's busy-ms tells its client, which shows it in its
;; window; a thin client's own window cannot ask a loop on another node.

;; Spin until the wall clock reaches `deadline` (ms): a turn that keeps its loop busy.
(defn busy-until (deadline) (if (>= (os/now) deadline) nil (busy-until deadline)))

;; The counter app, whose "slow" key keeps its update busy for 700 ms.
(defn slow-up (m input c r)
  (if (= input "slow") (do (busy-until (+ (os/now) 700)) (assoc m :n 99)) (up m input c r)))

;; The `[:busy on]` words the client is sent, in order, until `want` of them came.
(defn busy-words (want acc)
  (if (= (count acc) want)
    acc
    (receive
      ([:busy on] (busy-words want (conj acc on)))
      (after test/*wait-ms* (conj acc :timeout)))))

(describe "editor/serve — the busy cursor of a served session"
  (test "a served loop busy past its busy-ms tells its client so, and again when it is done"
    (let (me (self)
          session (spawn (ui-run (mk) vw slow-up (remote-display me 80 24))))
      (receive ([:frame _] nil) (after test/*wait-ms* nil))
      (send session [:key "slow" false])
      (assert= (busy-words 2 []) [true false])
      ;; a quick key after it says nothing: the loop never passes its busy-ms
      (send session [:key "+" false])
      (assert= (receive ([:busy on] on) (after 600 :quiet)) :quiet)
      (send session [:key "q" false])))

  (test "a shared session's busy word reaches every client"
    (let (me (self)
          hub (spawn (editor/serve/shared-hub () nil [80 24]))
          session (spawn (ui-run (mk) vw slow-up (editor/serve/shared-display hub))))
      (send hub [:add me])
      (send session [:key "slow"])
      (assert= (busy-words 2 []) [true false])
      (send session [:key "q"])))

  (test "the window client shows the daemon's busy word through its display's :busy"
    (let (log (table/new)
          display {:draw (fn (_f) nil)
                   :busy (fn (on) (table/put log :busy (conj (table/get log :busy []) on)))
                   :leave (fn () nil)})
      (send (self) [:busy true])
      (send (self) [:frame [:clear]])
      (send (self) [:busy false])
      (send (self) [:bye])
      (editor/attach/attach-display-loop nil (self) display)
      (assert= (table/get log :busy) [true false])
      ;; a display with no :busy (a terminal) drops it
      (send (self) [:busy true])
      (send (self) [:bye])
      (assert= (editor/attach/attach-display-loop nil
                 (self)
                 {:draw (fn (_f) nil) :leave (fn () nil)})
        nil))))

;; A session that outlives its client (`serve` given `:resume-ms`): a named client's death
;; parks its session, and the next attach under the same name takes it over where it was.
;; The app shows the lost / back events it folds, so a frame says what it was told.
(defn resume-up (m input c r)
  (cond
    (= input [:client-lost]) (assoc m :who "lost")
    (= input [:client-back]) (assoc m :who "back")
    else (up m input c r)))

(defn resume-client-wait (report)
  ;; wait to be told to die — its death is the dropped link. Until then a live window:
  ;; it answers the session's ping, and tells `report` of a [:bye]. Told :deaf, it stops
  ;; answering — a link that dropped with nobody the wiser yet
  (receive
    (:die nil)
    (:deaf (resume-client-deaf report))
    ([:ping from asked] (do (send from [:pong asked]) (resume-client-wait report)))
    ([:bye] (do (send report :old-client-bye) (resume-client-wait report)))
    (_ (resume-client-wait report))))

(defn resume-client-deaf (report)
  (receive
    (:die nil)
    ([:bye] (do (send report :old-client-bye) (resume-client-deaf report)))
    (_ (resume-client-deaf report))))

(defn await-frame-prefix (prefix)
  ;; the text of the first frame that starts with `prefix`, skipping those before it (the
  ;; identity's frame can come before or after a key's); :none if none does
  (receive
    ([:frame f] (if (string/starts-with? (frame-text f) prefix)
                  (frame-text f)
                  (await-frame-prefix prefix)))
    (after test/*wait-ms* :none)))

(defn resume-client (mgr report opts)
  ;; attach as `opts`, press "+", say the session and the frame it drew, then wait to be
  ;; told to die — its death is the dropped link
  (send mgr [:attach (self) 80 24 opts])
  (receive
    ([:attached s] (do
                     (receive ([:frame _] nil) (after test/*wait-ms* nil))
                     (send s [:key "+"])
                     (let (seen (await-frame-prefix "n=1"))
                       (send report [:client s seen])
                       (resume-client-wait report))))
    (after test/*wait-ms* (send report [:client nil :no-attach]))))

(defn await-frame-text (wanted)
  ;; `wanted` once a frame says it, skipping the frames before it; :none if none does
  (receive
    ([:frame f] (if (= (frame-text f) wanted) wanted (await-frame-text wanted)))
    (after test/*wait-ms* :none)))

(describe "serve: a session outlives a dropped client (:resume-ms)"
  (test "a named client's session parks when it dies, and the same name takes it back"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session seen] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (is (string/starts-with? seen "n=1"))
      (monitor session)
      (send first-client :die)
      ;; the session is still there, parked: no [:down] for it
      (assert= (receive ([:down _ ^session _] :down) (after 300 :alive)) :alive)
      (send mgr [:attach me 80 24 {:name "ann"}])
      ;; adopted: the SAME session, the last frame first, then the app told it is back
      (assert= (receive ([:attached s] s) (after test/*wait-ms* :none)) session)
      (is (string/starts-with? (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none)))
            "n=1"))
      (assert= (await-frame-text "n=1 who=back") "n=1 who=back")
      (send session [:key "+"])
      (assert= (frame-text (receive ([:frame f] f) (after test/*wait-ms* :none))) "n=2 who=back")
      (send session [:key "q"])))

  (test "another name gets a session of its own, not the parked one"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (send first-client :die)
      (send mgr [:attach me 80 24 {:name "bob"}])
      (let (other (receive ([:attached s] s) (after test/*wait-ms* :none)))
        (is (not (= other session)))
        (send other [:key "q"])
        (exit session :kill))))

  (test "an anonymous client's session ends with it — it could be handed to anyone"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (monitor session)
      (send first-client :die)
      (assert= (receive ([:down _ ^session _] :down) (after test/*wait-ms* :alive)) :down)))

  (test "a parked session no one comes back for ends when its time is up"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms 100}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (monitor session)
      (send first-client :die)
      (assert= (receive ([:down _ ^session reason] reason) (after test/*wait-ms* :alive))
        :client-gone)))

  (test "an adopt without the manager's token, or for a live session, is ignored"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (send session [:adopt (ref) me 80 24])
      (assert= (receive ([:attached s] s) (after 300 :ignored)) :ignored)
      (send first-client :die)
      (send session [:adopt (ref) me 80 24])
      (assert= (receive ([:attached s] s) (after 300 :ignored)) :ignored)
      (exit session :kill)))

  (test "without :resume-ms a dropped client still ends its session"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (monitor session)
      (send first-client :die)
      (assert= (receive ([:down _ ^session _] :down) (after test/*wait-ms* :alive)) :down))))

(describe "serve: an attach while the old client's death is not yet known (:resume-ms)"
  (test "an old client that still answers keeps its session: two windows on purpose"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (send mgr [:attach me 80 24 {:name "ann"}])
      (let (other (receive ([:attached s] s) (after test/*wait-ms* :none)))
        (is (not (= other :none)))
        (is (not (= other session)))
        (send other [:key "q"])
        (send first-client :die)
        (exit session :kill))))

  (test "an old client that no longer answers hands its session over, and is told bye"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw resume-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (send first-client :deaf)
      (send mgr [:attach me 80 24 {:name "ann"}])
      (assert= (receive ([:attached s] s) (after test/*wait-ms* :none)) session)
      (assert= (await-frame-text "n=1 who=back") "n=1 who=back")
      (assert= (receive (:old-client-bye :bye) (after test/*wait-ms* :none)) :bye)
      ;; the old client's death, when the network finally says so, is no longer this
      ;; session's business: it keeps serving the new one
      (send first-client :die)
      (send session [:key "+"])
      (assert= (await-frame-text "n=2 who=back") "n=2 who=back")
      (send session [:key "q"])))

  (test "a window client answers the session's ping, and does not ship it as a key"
    (let (display {:draw (fn (_f) nil) :leave (fn () nil)})
      (send (self) [:ping (self) :asked])
      (send (self) [:bye])
      (editor/attach/attach-display-loop nil (self) display)
      (assert= (receive ([:pong r] r) (after 0 :none)) :asked)
      (assert= (receive ([:key k _] k) (after 0 :none)) :none))))

(defn poll-input-until (display ms)
  ;; the display's next input, polled until one comes or `ms` is up — the client's death
  ;; reaches the mailbox when the kernel delivers it, which a single poll can miss
  (let (input ((get display :poll-input)))
    (cond
      (not (nil? input)) input
      (<= ms 0) :none
      else (receive (after 10 (poll-input-until display (- ms 10)))))))

(describe "serve: a client that takes a session over is given the window as it stands"
  (test "options, live textures and sounds, and the last frame without its sound"
    (let (me (self)
          token (ref)
          old (spawn (receive (_ nil)))
          display (editor/serve/remote-display old 80 24 {:ms :forever :manager me :token token})
          draw (get display :draw))
      (monitor old)
      ((get display :configure) {:title "game"})
      ((get display :configure) {:input :pixels})
      ((get display :texture) 1 :rgba-one 2 2)
      ((get display :texture) 2 :rgba-two 2 2)
      ((get display :texture-free) 1)
      ((get display :sound) 7 :pcm 44100 1)
      (draw [[:clear] [:sound 7 1.0] [:text 0 0 "board"]])
      ;; the old client goes: the session parks
      (exit old :kill)
      (assert= (poll-input-until display test/*wait-ms*) [:client-lost])
      (assert= (receive ([:parked _ t] t) (after test/*wait-ms* :none)) token)
      (send (self) [:adopt token me 100 30])
      (assert= ((get display :poll-input)) [:client-back])
      (assert= ((get display :size)) [100 30])
      (assert= (receive ([:attached _] :attached) (after 0 :none)) :attached)
      (assert= (receive ([:window o] o) (after 0 :none)) {:title "game" :input :pixels})
      (assert= (receive ([:texture id _ _ _] id) (after 0 :none)) 2) ; 1 was freed
      (assert= (receive ([:texture id _ _ _] id) (after 0 :none)) :none)
      (assert= (receive ([:sound-data id _ _ _] id) (after 0 :none)) 7)
      (assert= (receive ([:frame f] f) (after 0 :none)) [[:clear] [:text 0 0 "board"]]))))

;; An app update that refuses anything but its own model, as a real app's does (bedit's
;; `ed-update` checks its argument): the manager once handed ITS state to the app's
;; update on a hand-over, because its parameter named `update` shadowed the function.
(defn strict-up (m input c r)
  (if (contains? m :n) (resume-up m input c r) (error "strict-up: not this app's model")))

(describe "serve: the manager keeps serving after a hand-over"
  (test "a session handed over by a silent client, then another attach, both answered"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw strict-up {:resume-ms :forever}))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [session _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      (monitor mgr)
      (send first-client :deaf)
      (send mgr [:attach me 80 24 {:name "ann"}])
      (assert= (receive ([:attached s] s) (after test/*wait-ms* :none)) session)
      (send mgr [:attach me 80 24 {:name "bob"}])
      (let (other (receive ([:attached s] (if (= s session) :same s)) (after test/*wait-ms* :none)))
        (is (not (= other :none)))
        (is (not (= other :same)))
        (assert= (receive ([:down _ ^mgr _] :manager-died) (after 0 :serving)) :serving)
        (exit other :kill)
        (exit session :kill)
        (send first-client :die)))))

;; ---- the client's clipboard, across the link (ADR-539) ---------------------------
;; A served app asks its CLIENT's machine for the clipboard: "c" copies; "v" asks, and the
;; answer for that ask, an event, is pasted into the model (`clip=`); an answer for any other
;; ref is counted as `ignored`; "+" counts keys, so a frame shows the loop kept taking them
;; while an ask was out.
(defn clip-view (m c r)
  [(text 0
     0
     (str "n=" (get m :n 0) " clip=" (get m :clip "none") " ignored=" (get m :ignored 0)))])

(defn clip-up (m input c r)
  (match input
    ("c" (assoc m :sent (editor/serve/client-clipboard-set "copied")))
    ("v" (assoc m :asked (editor/serve/client-clipboard-ask)))
    ("+" (assoc m :n (inc (get m :n 0))))
    ;; the PRIMARY pair (ADR-562): a highlight, and a middle click's ask
    ("h" (assoc m :sent (editor/serve/client-primary-set "highlighted")))
    ("m" (assoc m :asked (editor/serve/client-primary-ask)))
    ([:clipboard ref text] (if (and (not (nil? ref)) (= ref (get m :asked)))
                             (assoc m :clip (or text "nothing") :asked nil)
                             (assoc m :ignored (inc (get m :ignored 0)))))
    ([:primary ref text] (if (and (not (nil? ref)) (= ref (get m :asked)))
                           (assoc m :clip (str "primary " (or text "nothing")) :asked nil)
                           (assoc m :ignored (inc (get m :ignored 0)))))
    (_ m)))

(defn clip-attach (mgr)
  ;; attach the test process as the client; the session pid, its first frame taken
  (send mgr [:attach (self) 80 24])
  (let (session (receive ([:attached s] s) (after test/*wait-ms* nil)))
    (receive ([:frame _] nil) (after test/*wait-ms* nil))
    session))

(defn clip-attach-can (mgr)
  ;; attach the test process as a client that says it handles PRIMARY (ADR-562), as this
  ;; runtime's `attach` does
  (send mgr [:attach (self) 80 24 {:can [:primary]}])
  (let (session (receive ([:attached s] s) (after test/*wait-ms* nil)))
    (receive ([:frame _] nil) (after test/*wait-ms* nil))
    session))

(describe "serve: the session's clipboard is its client's (ADR-539)"
  (test "a copy in the session reaches its client as [:clipboard-set text]"
    (let (mgr (spawn (editor/serve/serve-manager (fn () {}) clip-view clip-up))
          session (clip-attach mgr))
      (send session [:key "c"])
      (assert= (receive ([:clipboard-set text] text) (after test/*wait-ms* :none)) "copied")
      (exit session :kill)))

  (test "a paste asks without waiting, and the client's answer arrives as an event"
    (let (mgr (spawn (editor/serve/serve-manager (fn () {}) clip-view clip-up))
          session (clip-attach mgr))
      (send session [:key "v"])
      (let (question (receive ([:clipboard-get from asked] [from asked]) (after test/*wait-ms* nil)))
        ;; the ask is out and unanswered: the loop still takes a key and draws it
        (send session [:key "+"])
        (assert= (await-frame-text "n=1 clip=none ignored=0") "n=1 clip=none ignored=0")
        (send (first question) [:clipboard (second question) "from the client"]))
      (assert= (await-frame-text "n=1 clip=from the client ignored=0")
        "n=1 clip=from the client ignored=0")
      (exit session :kill)))

  (test "a client that never answers is answered for at the timeout"
    (let (mgr (spawn (editor/serve/serve-manager (fn () {}) clip-view clip-up))
          session (clip-attach mgr)
          started (os/now))
      (send session [:key "v"])
      (let (asked (receive ([:clipboard-get _ asked] asked) (after test/*wait-ms* nil)))
        (is (not (nil? asked)))
        (assert= (await-frame-text "n=0 clip=nothing ignored=0") "n=0 clip=nothing ignored=0")
        (let (waited (- (os/now) started))
          (is (>= waited 450))
          (is (< waited 3000)))
        ;; the real answer, too late: an event the app takes as one for no ask of its own
        (send session [:clipboard asked "late"])
        (assert= (await-frame-text "n=0 clip=nothing ignored=1") "n=0 clip=nothing ignored=1"))
      (exit session :kill)))

  (test "outside a served session there is no client to ask"
    (assert= [(editor/serve/served-client)
               (editor/serve/client-clipboard-set "x")
               (editor/serve/client-clipboard-ask 0)
               (editor/serve/client-primary-set "x")
               (editor/serve/client-primary-ask 0)]
      [nil nil nil nil nil]))

  (test "a highlight in the session owns its client's PRIMARY (ADR-562)"
    (let (mgr (spawn (editor/serve/serve-manager (fn () {}) clip-view clip-up))
          session (clip-attach-can mgr))
      (send session [:key "h"])
      (assert= (receive ([:primary-set text] text) (after test/*wait-ms* :none)) "highlighted")
      (exit session :kill)))

  (test "a middle click asks for the client's PRIMARY, answered as an event"
    (let (mgr (spawn (editor/serve/serve-manager (fn () {}) clip-view clip-up))
          session (clip-attach-can mgr))
      (send session [:key "m"])
      (let (question (receive ([:primary-get from asked] [from asked]) (after test/*wait-ms* nil)))
        (send (first question) [:primary (second question) "selected there"]))
      (assert= (await-frame-text "n=0 clip=primary selected there ignored=0")
        "n=0 clip=primary selected there ignored=0")
      (exit session :kill)))

  (test "a client that does not say it can is sent no PRIMARY message at all"
    ;; an older client: its window would ship one back as a key, its terminal let them pile
    (let (mgr (spawn (editor/serve/serve-manager (fn () {}) clip-view clip-up))
          session (clip-attach mgr))
      (send session [:key "h"])
      (send session [:key "m"])
      (send session [:key "+"])
      ;; the `+` drawn: the two keys before it were folded, and asked nothing of us
      (assert= (await-frame-text "n=1 clip=none ignored=0") "n=1 clip=none ignored=0")
      (assert= (receive ([:primary-set _] :sent) ([:primary-get _ _] :asked) (after 0 :nothing))
        :nothing)
      (exit session :kill)))

  (test "the window client sets and answers through its display's PRIMARY"
    (let (me (self)
          asked (ref))
      (let (seen (drive-backlog (fn (me)
                                  {:draw (fn (_f) nil)
                                   :leave (fn () nil)
                                   :primary-set (fn (text) (send me [:set-primary text]))
                                   :primary-get (fn () "highlighted on the client")})
                   [[:primary-set "drag"] [:primary-get me asked]])
            answer (or (seq/find seen (fn (message) (= (first message) :primary)))
                     (receive
                       ([:primary ^asked text] [:primary asked text])
                       (after test/*wait-ms* :none))))
        (assert= (first seen) [:set-primary "drag"])
        (assert= answer [:primary asked "highlighted on the client"]))))

  (test "the window client sets and answers through its display's clipboard"
    (let (me (self)
          asked (ref))
      (let (seen (drive-backlog (fn (me)
                                  {:draw (fn (_f) nil)
                                   :leave (fn () nil)
                                   :clipboard-set (fn (text) (send me [:set text]))
                                   :clipboard-get (fn () "on the client")})
                   [[:clipboard-set "copied"] [:clipboard-get me asked]])
            ;; the get is answered by a reader beside the loop, which may outlive the loop
            answer (or (seq/find seen (fn (message) (= (first message) :clipboard)))
                     (receive
                       ([:clipboard ^asked text] [:clipboard asked text])
                       (after test/*wait-ms* :none))))
        (assert= (first seen) [:set "copied"])
        (assert= answer [:clipboard asked "on the client"]))))

  (test "a slow clipboard does not hold the window client's painting back"
    ;; the clipboard's owner takes its time answering (a busy app, a big selection): the
    ;; client must go on painting and shipping keys while it is read, and answer when it is
    (let (me (self)
          asked (ref)
          display {:draw (fn (f) (send me [:drew (frame-text f)]))
                   :leave (fn () nil)
                   :clipboard-get (fn () (receive (after 800 "slow to read")))}
          client (spawn (editor/attach/attach-display-loop nil me display)))
      (send client [:clipboard-get me asked])
      (send client [:frame [(text 0 0 "painted meanwhile")]])
      ;; the frame is painted long before the clipboard answers
      (assert= (receive
                 ([:drew text] text)
                 ([:clipboard ^asked _] :answered-first)
                 (after 600 :none))
        "painted meanwhile")
      (assert= (receive ([:clipboard ^asked text] text) (after test/*wait-ms* :none))
        "slow to read")
      (send client [:bye]))))

;; ---- ADR-593: a session supervises its loop -----------------------------------------
;; The served counter, able to die: "crash" — or a `[:crash]` from anywhere, since a parked
;; loop has no keys — kills its loop outright (an exit signal, which no `try` in `ui-run`
;; catches). Every count is handed to the session (`serve-retain`), and a restarted loop
;; shows how many restarts it is.
(defn crash-up (m input c r)
  (cond
    (or (= input "crash") (= input [:crash])) (do (exit (self) :boom) (receive (after 0 nil)) m)
    (and (vector? input) (= (first input) :session-restarted))
      (assoc m :who (str "restarted " (:restarts (second input))))
    else
      (let (next (resume-up m input c r))
        (do (when (not (= (:n next) (:n m))) (serve-retain (:n next))) next))))

;; `serve` options supervising the counter: the crash hook reports what it was handed to
;; `report`, and a restart starts from the retained count. `supervise` adds to (or
;; overrides) the hooks, `extra` to the options.
(defn crash-opts (report supervise extra)
  (merge {:supervise (merge {:on-crash (fn (retained death)
                                         (do
                                           (send report
                                             [:saved retained (:restarting? death) (:reason death)])
                                           :saved))
                             :restart (fn (retained _death) {:n (or retained 0)})}
                       supervise)}
    extra))

;; A window client that watches the loop it attached to, as `attach-display` does — so a
;; client that ended on its loop's death would end here — and says when it has ended.
(defn supervised-window-client (mgr report)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached loop-process] (do
                                (monitor loop-process)
                                (send report [:ready (self)])
                                (editor/attach/attach-display-loop nil
                                  loop-process
                                  (gui-mock-display report))
                                (send report [:client-ended])))
    (after test/*wait-ms* (send report [:ready :no-attach]))))

;; A served typewriter that can die: a one-letter key is appended (and the text retained),
;; "crash" kills the loop, a restarted loop says so. The ORDER keys fold in shows in the text.
(defn typing-up (m input c r)
  (cond
    (= input "crash") (do (exit (self) :boom) (receive (after 0 nil)) m)
    (and (vector? input) (= (first input) :session-restarted))
      (assoc m :who (str "restarted " (:restarts (second input))))
    (and (string? input) (= (count input) 1))
      (let (typed (str (or (:typed m) "") input)) (do (serve-retain typed) (assoc m :typed typed)))
    else m))

(defn typing-vw (m c r)
  [(text 0 0 (str "typed=" (or (:typed m) "") (if (get m :who) (str " who=" (get m :who)) "")))])

;; The served session's buffers, in a registry the SESSION owns: the model shows the text
;; of its one document, read from the document's process — which outlives the loop.
(defn registry-notes (registry)
  (let (entries (editor/buffer-registry/registry-entries registry))
    (editor/buffer-server/buffer-query (:proc (first entries)) editor/buffer/buffer-text)))

(defn registry-mk ()
  (let (registry (editor/buffer-registry/registry-start {:owner (served-session)}))
    (do
      (editor/buffer-registry/registry-share registry "notes" "unsaved text" {:file "/tmp/notes"})
      (serve-retain {:registry registry})
      {:n 0 :registry registry :notes (registry-notes registry)})))

(defn registry-vw (m c r)
  [(text 0 0 (str "notes=" (:notes m) (if (get m :who) (str " who=" (get m :who)) "")))])

;; The crash hook an editor has: every document's text written out ("auto-saved") from its
;; process, into `directory`; the paths written.
(defn save-documents (registry directory)
  (into []
    (map (editor/buffer-registry/registry-entries registry)
      (fn (entry)
        (let (path (str directory "/" (:name entry)))
          (do
            (file/spit path
              (editor/buffer-server/buffer-query (:proc entry) editor/buffer/buffer-text))
            path))))))

(describe "serve: a session supervises its loop (ADR-593)"
  (test "a loop that dies runs the crash hook and is restarted for the same client from what it retained"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw crash-up (crash-opts me {} {}))))
      (send mgr [:attach me 80 24])
      (let (first-loop (receive ([:attached s] s) (after test/*wait-ms* :none))
            session (receive ([:session s] s) (after test/*wait-ms* :none)))
        (is (pid? session))
        (is (not (= first-loop session)))
        (monitor session)
        (send first-loop [:key "+"])
        (send first-loop [:key "+"])
        (assert= (await-frame-text "n=2") "n=2")
        (send first-loop [:key "crash"])
        (assert= (receive
                   ([:saved retained restarting? reason] [retained restarting? reason])
                   (after test/*wait-ms* :none))
          [2 true :boom])
        ;; the client is told the new loop, under the same session, and the count is back
        (let ([next-loop told] (receive
                                 ([:reattached l s _] [l s])
                                 (after test/*wait-ms* [:none :none])))
          (is (pid? next-loop))
          (is (not (= next-loop first-loop)))
          (assert= told session)
          (assert= (await-frame-text "n=2 who=restarted 1") "n=2 who=restarted 1")
          (send next-loop [:key "+"])
          (assert= (await-frame-text "n=3 who=restarted 1") "n=3 who=restarted 1")
          ;; a quit is no death: the session ends with it, no hook, no restart
          (send next-loop [:key "q"])
          (assert= (receive ([:down _ ^session reason] reason) (after test/*wait-ms* :alive))
            :normal)
          (assert= (receive ([:saved _ _ _] :saved) (after 0 :none)) :none)))))

  (test "the window client keeps its window through the restart and ships to the new loop"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw crash-up (crash-opts me {} {}))))
      (spawn (supervised-window-client mgr me))
      (let (client (receive ([:ready c] c) (after test/*wait-ms* :no-attach)))
        (is (pid? client))
        (assert= (wait-drew "n=0") :ok)
        (send client "+")
        (assert= (wait-drew "n=1") :ok)
        (send client "crash")
        (assert= (wait-drew "n=1 who=restarted 1") :ok)
        (send client "+")
        (assert= (wait-drew "n=2 who=restarted 1") :ok)
        ;; the dead loop's [:down] did not end the client
        (assert= (receive ([:client-ended] :ended) (after 0 :running)) :running)
        (send client :close)
        (assert= (receive ([:client-ended] :ended) (after test/*wait-ms* :running)) :ended))))

  (test "keys typed into a loop that dies, before it took them, reach the new loop in order"
    ;; the window client numbers each key it ships to a supervised session; the dead loop
    ;; took "crash" and none after it, so the restarted loop is sent c d e again, in order,
    ;; and folds them after its start events — and never "crash", which would kill it again
    (let (me (self)
          opts {:supervise {:restart (fn (retained _death) {:typed (or retained "")})}}
          mgr (spawn (editor/serve/serve-manager (fn () {:typed ""}) typing-vw typing-up opts)))
      (spawn (supervised-window-client mgr me))
      (let (client (receive ([:ready c] c) (after test/*wait-ms* :no-attach)))
        (is (pid? client))
        (assert= (wait-drew "typed=") :ok)
        (send client "a")
        (send client "b")
        (assert= (wait-drew "typed=ab") :ok)
        ;; all four in the client's mailbox at once: shipped before the loop has died
        (send client "crash")
        (send client "c")
        (send client "d")
        (send client "e")
        (assert= (wait-drew "typed=abcde who=restarted 1") :ok)
        (send client "f")
        (assert= (wait-drew "typed=abcdef who=restarted 1") :ok)
        (send client :close))))

  (test "the session's documents outlive its loop, and are saved when the budget runs out"
    (let (me (self)
          directory (test/temp-dir "brood-serve-saved-")
          _ (file/mkdir directory)
          opts {:supervise {:max 1
                            :on-crash (fn (retained death)
                                        (let (saved (save-documents (:registry retained) directory))
                                          (do
                                            (send me
                                              [:saved (:registry retained) (:restarting? death)])
                                            saved)))
                            :restart (fn (retained _death)
                                       {:n 0
                                        :registry (:registry retained)
                                        :notes (registry-notes (:registry retained))})}}
          mgr (spawn (editor/serve/serve-manager registry-mk registry-vw crash-up opts)))
      (send mgr [:attach me 80 24])
      (let (first-loop (receive ([:attached s] s) (after test/*wait-ms* :none))
            session (receive ([:session s] s) (after test/*wait-ms* :none)))
        (monitor session)
        (assert= (await-frame-text "notes=unsaved text") "notes=unsaved text")
        (send first-loop [:key "crash"])
        (let ([registry restarting?] (receive
                                       ([:saved registry restarting?] [registry restarting?])
                                       (after test/*wait-ms* [nil :none])))
          (is (pid? registry))
          (is restarting?)
          (monitor registry)
          ;; the restarted loop read the text from the document's process, which lived on
          (let (next-loop (receive ([:reattached l _ _] l) (after test/*wait-ms* :none)))
            (assert= (await-frame-text "notes=unsaved text who=restarted 1")
              "notes=unsaved text who=restarted 1")
            ;; a second death inside the window: past `:max 1` — saved, and the session ends
            (send next-loop [:key "crash"])
            (assert= (receive ([:saved _ again?] again?) (after test/*wait-ms* :none)) false)
            (assert= (receive ([:down _ ^session reason] reason) (after test/*wait-ms* :alive))
              :boom)
            ;; the registry was the session's: it ended with it, its documents saved first
            (assert= (receive ([:down _ ^registry _] :ended) (after test/*wait-ms* :alive)) :ended)
            (assert= (file/slurp (str directory "/notes")) "unsaved text"))))))

  (test "a parked session's loop that dies is restarted parked, and its user takes it back"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk
                       vw
                       crash-up
                       (crash-opts me {} {:resume-ms :forever})))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [first-loop seen] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none]))
          watch-client (monitor first-client))
      (is (string/starts-with? seen "n=1"))
      (send first-client :die)
      (receive ([:down ^watch-client _ _] nil) (after test/*wait-ms* nil))
      ;; let the loop fold its client's death and park
      (receive (after 200 nil))
      (send first-loop [:crash])
      (assert= (receive
                 ([:saved retained restarting? _] [retained restarting?])
                 (after test/*wait-ms* :none))
        [1 true])
      ;; the same name comes back: the restarted loop, parked, is handed to it
      (send mgr [:attach me 80 24 {:name "ann"}])
      (let (next-loop (receive ([:attached s] s) (after test/*wait-ms* :none)))
        (is (pid? next-loop))
        (is (not (= next-loop first-loop)))
        ;; the retained count, and the restarted loop takes this client's keys (whether its
        ;; `[:client-back]` or its own start events fold first is the input lane's to say)
        (is (string/starts-with? (await-frame-prefix "n=1") "n=1"))
        (send next-loop [:key "+"])
        (is (string/starts-with? (await-frame-prefix "n=2") "n=2"))
        (send next-loop [:key "q"]))))

  (test "without a restart the hook still runs and the session ends, its client with it"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw crash-up (crash-opts me {:restart nil} {}))))
      (send mgr [:attach me 80 24])
      (let (first-loop (receive ([:attached s] s) (after test/*wait-ms* :none))
            session (receive ([:session s] s) (after test/*wait-ms* :none)))
        (monitor session)
        (send first-loop [:key "crash"])
        (assert= (receive ([:saved _ restarting? _] restarting?) (after test/*wait-ms* :none))
          false)
        (assert= (receive ([:down _ ^session reason] reason) (after test/*wait-ms* :alive)) :boom)
        (assert= (receive ([:attached s] s) (after 0 :none)) :none))))

  (test "a session with no supervision ends when its loop dies, as before"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk vw crash-up)))
      (send mgr [:attach me 80 24])
      (let (first-loop (receive ([:attached s] s) (after test/*wait-ms* :none))
            session (receive ([:session s] s) (after test/*wait-ms* :none)))
        (monitor session)
        (send first-loop [:key "crash"])
        (assert= (receive ([:down _ ^session reason] reason) (after test/*wait-ms* :alive)) :boom))))

  (test "serve-retain and served-session say nothing outside a served session"
    (do
      (assert= (served-session) nil)
      (assert= (serve-retain {:anything 1}) nil))))

;; ---- ADR-605: only the hand-overs no loop handled are given to a restarted one ----------

;; A client that attaches as `opts` and reports to `report` every attach it is told of —
;; `[:observed-attached loop]` and `[:observed-reattached loop]` — and every ping and bye,
;; answering pings while not told :deaf. The second user of a name, whose own session must
;; never be taken from it by another session's restart.
(defn observing-client (mgr report opts)
  (send mgr [:attach (self) 80 24 opts])
  (observing-client-loop report true))

(defn observing-client-loop (report answers?)
  (receive
    ([:attached s] (do (send report [:observed-attached s]) (observing-client-loop report answers?)))
    ([:reattached s _ _] (do
                           (send report [:observed-reattached s])
                           (observing-client-loop report answers?)))
    ([:ping from asked] (do
                          (when answers? (send from [:pong asked]))
                          (send report [:observed-ping])
                          (observing-client-loop report answers?)))
    ([:bye] (do (send report [:observed-bye]) (observing-client-loop report answers?)))
    (:deaf (observing-client-loop report false))
    (:die nil)
    (_ (observing-client-loop report answers?))))

;; A client that attaches as `opts`, reports the loop and the SESSION it was told, and waits
;; to be told to die — its death is the dropped link.
(defn session-client (mgr report opts)
  (send mgr [:attach (self) 80 24 opts])
  (let (loop-process (receive ([:attached s] s) (after test/*wait-ms* nil))
        session (receive ([:session s] s) (after test/*wait-ms* nil)))
    (do (send report [:session-client loop-process session]) (receive (:die nil)))))

;; A client that attaches as `opts` and ships three NUMBERED keys, as a client attached to a
;; supervised session does, then reports the loop and waits to be told to die.
(defn numbered-client (mgr report opts)
  (send mgr [:attach (self) 80 24 opts])
  (receive
    ([:attached s] (do
                     (send s [:key "+" false 1])
                     (send s [:key "+" false 2])
                     (send s [:key "+" false 3])
                     (send report [:numbered-client s])
                     (receive (:die nil))))
    (after test/*wait-ms* (send report [:numbered-client nil]))))

;; The counter, whose FIRST loop dies folding a client's return — before it can take a key
;; of the client that came back. A restarted loop's model has no :first.
(defn back-crash-up (m input c r)
  (if (and (= input [:client-back]) (:first m))
    (do (exit (self) :boom) (receive (after 0 nil)) m)
    (resume-up m input c r)))

(defn await-down (watch)
  (receive ([:down ^watch _ _] :down) (after test/*wait-ms* :alive)))

(describe "serve: a restarted loop is given only the hand-overs no loop handled (ADR-605)"
  (test "a declined claim is not replayed to a restarted parked loop, hijacking its claimant"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk
                       vw
                       crash-up
                       (crash-opts me {} {:resume-ms :forever})))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [first-loop _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none]))
          ;; the same name again while the first still answers: declined, a session of its own
          second-client (spawn (observing-client mgr me {:name "ann"}))
          own (receive ([:observed-attached s] s) (after test/*wait-ms* :none))
          watch-first (monitor first-client))
      (is (pid? own))
      (is (not (= own first-loop)))
      (send first-client :die)
      (await-down watch-first)
      ;; let the first session's loop fold its client's death and park
      (receive (after 200 nil))
      (send first-loop [:crash])
      (assert= (receive ([:saved _ restarting? _] restarting?) (after test/*wait-ms* :none)) true)
      ;; the restarted parked loop leaves the second client alone
      (assert= (receive
                 ([:observed-attached s] [:hijacked s])
                 ([:observed-reattached s] [:hijacked s])
                 (after 500 :untouched))
        :untouched)
      ;; and the manager still has the first session parked: the name takes it back
      (send mgr [:attach me 80 24 {:name "ann"}])
      (let (back (receive ([:attached s] s) (after test/*wait-ms* :none)))
        (is (pid? back))
        (is (not (= back own)))
        (is (not (= back first-loop)))
        (send back [:key "q"]))
      (send second-client :die)))

  (test "a claim that took the session is not replayed: the restarted loop asks its client nothing"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk
                       vw
                       crash-up
                       (crash-opts me {} {:resume-ms :forever})))
          first-client (spawn (resume-client mgr me {:name "ann"}))
          [first-loop _] (receive ([:client s t] [s t]) (after test/*wait-ms* [nil :none])))
      ;; the first client's link dropped unnoticed: the second takes its session over
      (send first-client :deaf)
      (let (claimant (spawn (observing-client mgr me {:name "ann"}))
            taken (receive ([:observed-attached s] s) (after test/*wait-ms* :none)))
        (assert= taken first-loop)
        (assert= (receive (:old-client-bye :bye) (after test/*wait-ms* :none)) :bye)
        ;; the claimant goes deaf too, so a replayed claim's ping would cost it the session
        (send claimant :deaf)
        (send first-loop [:crash])
        (assert= (receive
                   ([:observed-reattached s] (not (= s first-loop)))
                   (after test/*wait-ms* :none))
          true)
        (assert= (receive
                   ([:observed-ping] :pinged)
                   ([:observed-bye] :told-bye)
                   (after 2000 :quiet))
          :quiet)
        (send claimant :die)
        (send first-client :die))))

  (test "a client that adopts a session starts a fresh ledger: a restart resends all its keys"
    (let (me (self)
          opts {:resume-ms :forever :supervise {:restart (fn (_retained _death) {:n 0})}}
          mgr (spawn (editor/serve/serve-manager (fn () {:n 0 :first true}) vw back-crash-up opts))
          old (spawn (numbered-client mgr me {:name "ann"}))
          first-loop (receive ([:numbered-client s] s) (after test/*wait-ms* nil))
          watch-old (monitor old))
      (is (pid? first-loop))
      ;; let the loop take the old client's three keys
      (receive (after 200 nil))
      (send old :die)
      (await-down watch-old)
      (receive (after 200 nil))
      ;; this client adopts it; the loop dies folding [:client-back], before any key of ours
      (send mgr [:attach me 80 24 {:name "ann"}])
      (let (adopted (receive ([:attached s] s) (after test/*wait-ms* :none)))
        (is (pid? adopted))
        (send adopted [:key "+" false 1])
        ;; none of OUR keys was taken — not the old client's 3, which would drop our 1..3
        (assert= (receive ([:reattached _ _ taken] taken) (after test/*wait-ms* :none)) nil))))

  (test "a parked session's restarted loop lives only as long as the session had left"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager mk
                       vw
                       crash-up
                       (crash-opts me {} {:resume-ms 1000})))
          client (spawn (session-client mgr me {:name "ann"}))
          [first-loop session] (receive
                                 ([:session-client l s] [l s])
                                 (after test/*wait-ms* [nil nil]))
          watch-session (monitor session)
          watch-client (monitor client))
      (is (pid? session))
      (send client :die)
      (await-down watch-client)
      ;; most of its time to live gone, the parked loop dies and is restarted
      (receive (after 700 nil))
      (send first-loop [:crash])
      (assert= (receive ([:saved _ restarting? _] restarting?) (after test/*wait-ms* :none)) true)
      ;; it ends when the session's time is up, about 300 ms on — not a fresh second later
      (assert= (receive ([:down ^watch-session _ reason] reason) (after 650 :alive)) :client-gone)))

  (test "a session keeps only the deaths its restart budget counts"
    (do
      (assert= (editor/serve/serve-recent-deaths [1000 50000 59000 61000] 70000 60000)
        [50000 59000 61000])
      (assert= (editor/serve/serve-recent-deaths [] 70000 60000) [])
      (is (editor/serve/serve-restart-allowed? [1000 2000 3000] 70000 3 60000))
      (is (not (editor/serve/serve-restart-allowed? [50000 59000 61000] 70000 3 60000)))))

  (test "a handled hand-over leaves the pending list; an unhandled one stays"
    (let (adopt [:adopt :token :client 80 24]
          claim [:claim :token :client 80 24])
      (assert= (editor/serve/serve-pending-handled [adopt claim] adopt) [claim])
      (assert= (editor/serve/serve-pending-handled [adopt claim] [:client-can :other []])
        [adopt claim])
      (assert= (editor/serve/serve-pending-handled [] adopt) []))))
