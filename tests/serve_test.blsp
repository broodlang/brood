;; std/editor/serve.blsp — serving a `ui-run` app to remote frontends (ADR-090).
;; The daemon runs the app; a thin client paints pushed frames and ships back keys.
;; Here the *test process plays the client* in-process — local pids `send`/`receive`
;; exactly as remote ones do (a node link is just a longer copy), so the full
;; serve → frame → key → frame → quit protocol is exercised without a node or a TTY.
;; The cross-node, real-TCP variant is `crates/cli/tests/serve_attach.rs`.

(defmodule serve-test (:use test) (:use editor/serve) (:use editor/display) (:use editor/ui))

;; A tiny served app: a counter. `"+"` increments, `"q"` quits; the view paints the
;; count. Each client gets a fresh model from `mk`.
(defn mk () {:n 0})
(defn vw (m c r) [(text 0 0 (str "n=" (get m :n)))])
(defn up (m input c r)
  (cond
    (= input "+") (assoc m :n (+ (get m :n) 1))
    (= input "q") (assoc m :done true)
    :else m))

;; The text string of a frame's first `[:text row col s]` op — what the app rendered.
(defn frame-text (f) (nth (first f) 3))

;; A helper "client" process: attach to `mgr`, press `"+"` once, and report the
;; frame text it sees back to `report`. Used to prove two clients are independent.
(defn probe (mgr report)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached s]
      (do
        ;; consume the initial frame (drawn at n=0 before any key), then press "+"
        ;; and report the frame that key produces
        (receive ([:frame _] nil) (after 2000 nil))
        (send s [:key "+"])
        (receive ([:frame f] (send report [:probed (frame-text f)]))
          (after 2000 (send report [:probed :no-frame])))))
    (after 2000 (send report [:probed :no-attach]))))

;; A scripted GUI-style display for the any-display client (`attach--display-loop`):
;; `:draw` reports the frame's text to `report`. Input is NOT read via `:poll` — the
;; unified client loop reads the mailbox directly (as a real gui-display's input does),
;; so the test injects keys by `send`ing them to the client process.
(defn gui-mock-display (report)
  {:enter (fn () nil)
   :leave (fn () (send report [:drew :left]))
   :size (fn () [80 24])
   :draw (fn (f) (send report [:drew (frame-text f)]))
   :poll (fn (ms) nil)})

;; A GUI client played in-process: attach to `mgr`, tell the test our pid + session, then
;; run the unified any-display loop. The test drives it by `send`ing keys to our pid.
(defn gui-probe (mgr ready)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached session]
      (do (send ready [:ready (self) session])
        (editor/serve/attach--display-loop nil session (gui-mock-display ready))))
    (after 2000 (send ready [:ready :no-attach :no-attach]))))

;; A shared-session client played in-process: attach, announce our pid, then loop —
;; reporting each CHANGED frame's text (deduped, so tick re-renders don't spam the test)
;; and shipping a [:press k] from the test to the shared session as a keystroke.
(defn shared-client-loop (session report last)
  (receive
    ([:frame f] (let (t (frame-text f))
                  (do (when (not (= t last)) (send report [:cframe (self) t]))
                    (shared-client-loop session report t))))
    ([:press k] (do (send session [:key k]) (shared-client-loop session report last)))
    ([:bye] nil)))

(defn shared-client (mgr report)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached session] (do (send report [:cready (self)])
                           (shared-client-loop session report :none)))
    (after 2000 (send report [:cready :no-attach]))))

(describe "editor/serve — serving a ui-run app to a remote frontend"
  (test "an attached client gets a session pid, the initial frame, then key-driven frames"
    (let (mgr (spawn (editor/serve/serve--manager mk vw up)))  ; the daemon's session manager
      (send mgr [:attach (self) 80 24])
      (let (session (receive ([:attached s] s) (after 2000 :no-attach)))
        (is (not (= session :no-attach)))
        ;; the session renders immediately on start — the first frame is the fresh model
        (assert= (frame-text (receive ([:frame f] f) (after 2000 :none))) "n=0")
        ;; a key we ship drives the app; the next frame reflects it
        (send session [:key "+"])
        (assert= (frame-text (receive ([:frame f] f) (after 2000 :none))) "n=1")
        (send session [:key "+"])
        (assert= (frame-text (receive ([:frame f] f) (after 2000 :none))) "n=2")
        ;; "q" sets :done; ui-run quits and :leave tells the client to restore (:bye)
        (send session [:key "q"])
        (assert= (receive ([:bye] :bye) (after 2000 :no-bye)) :bye))))

  (test "each client gets an independent session with its own model"
    (let (me (self)
          mgr (spawn (editor/serve/serve--manager mk vw up)))
      ;; two clients attach to the same manager and each press "+" once
      (spawn (probe mgr me))
      (spawn (probe mgr me))
      ;; if the model were shared, one would see n=2; independent ⇒ both see n=1
      (assert= (receive ([:probed t] t) (after 3000 :none)) "n=1")
      (assert= (receive ([:probed t] t) (after 3000 :none)) "n=1")))

  (test "a session that dies without a clean :bye still notifies the client (monitor)"
    ;; `make-model` runs *before* ui-run, so a throw there kills the session before
    ;; `:leave`/`[:bye]` can fire. The client monitors the session pid (as attach--session
    ;; does), so it learns via `[:down …]` instead of hanging — the robustness fix.
    (let (bad-mk (fn () (error "boom in make-model"))
          mgr (spawn (editor/serve/serve--manager bad-mk vw up)))
      (send mgr [:attach (self) 80 24])
      ;; [:attached] is sent before make-model runs, so we still get the session pid
      (let (session (receive ([:attached s] s) (after 2000 :no-attach)))
        (is (not (= session :no-attach)))
        (monitor session)
        (assert= (receive ([:down _ _ _] :down) (after 2000 :no-down)) :down))))

  (test "serve registers the manager under the well-known serve-name"
    ;; the only test that touches the global `:ui` name (avoids cross-test clashes)
    (do
      (serve mk vw up)
      (is (not (nil? (whereis serve-name))))))

  (test "attach-display (GUI client): frames paint to the display, input ships back, :close tears down"
    ;; The terminal client reads input from the TTY; a GUI client reads window input from
    ;; the SAME mailbox the daemon pushes frames to, so `attach--display-loop` unifies both
    ;; in one receive. This drives that loop with a scripted display and in-process pids —
    ;; the full frame → key → frame → detach protocol, no node or window.
    (let (me (self)
          mgr (spawn (editor/serve/serve--manager mk vw up)))
      (spawn (gui-probe mgr me))
      (let ([client session] (receive ([:ready c s] [c s]) (after 2000 [nil nil])))
        (is (not (nil? client)))
        (is (not (= client :no-attach)))
        ;; the session renders the fresh model immediately; the client paints it
        (assert= (receive ([:drew t] t) (after 2000 :none)) "n=0")
        ;; a window key lands in the client's mailbox -> shipped to the session -> new frame
        (send client "+")
        (assert= (receive ([:drew t] t) (after 2000 :none)) "n=1")
        (send client "+")
        (assert= (receive ([:drew t] t) (after 2000 :none)) "n=2")
        ;; the window's close button ships [:detach]; the session's remote-display maps that
        ;; to :close, ui-run quits, and the session process ends — observed via a monitor.
        (monitor session)
        (send client :close)
        (assert= (receive ([:down _ _ _] :down) (after 2000 :no-down)) :down))))

  (test "serve-shared: two clients share ONE model — an edit by one is seen by both"
    ;; Unlike `serve` (a fresh model per client), `serve-shared` runs a single ui-run and
    ;; fans it to all clients while merging their input. Two in-process clients attach to the
    ;; SAME session; a "+" from one increments the shared model and BOTH see the new frame.
    (let (me (self)
          hub (spawn (editor/serve/shared--hub () nil [80 24]))
          session (spawn (ui-run (mk) vw up (editor/serve/shared--display hub)))
          mgr (spawn (editor/serve/serve-shared--manager session hub)))
      (let (a (spawn (shared-client mgr me))
            aid (receive ([:cready c] c) (after 2000 :none)))
        (is (not (= aid :none)))
        ;; A sees the shared model's initial frame
        (assert= (receive ([:cframe _ t] t) (after 2000 :none)) "n=0")
        ;; B attaches to the SAME session and also sees n=0
        (let (b (spawn (shared-client mgr me))
              bid (receive ([:cready c] c) (after 2000 :none)))
          (is (not (= bid :none)))
          (assert= (receive ([:cframe _ t] t) (after 2000 :none)) "n=0")
          ;; A presses "+"; the shared model increments and BOTH clients get the n=1 frame
          (send aid [:press "+"])
          (let (t1 (receive ([:cframe _ t] t) (after 2000 :none))
                t2 (receive ([:cframe _ t] t) (after 2000 :none)))
            (assert= t1 "n=1")
            (assert= t2 "n=1"))))))

  (test "remote-display: :draw ships a frame, :size reports the attach size, :poll maps input"
    (let (d (remote-display (self) 80 24))
      ;; :draw sends the frame to the client (us) verbatim
      ((get d :draw) [:A-FRAME])
      (assert= (receive ([:frame f] f) (after 5000 :none)) [:A-FRAME])
      ;; :size is the size reported at attach (live resize deferred)
      (assert= ((get d :size)) [80 24])
      ;; :poll returns a shipped key, and maps a detach request to :close (ui-run quits)
      (send (self) [:key "z"])
      (assert= ((get d :poll) 500) "z")
      (send (self) [:detach])
      (assert= ((get d :poll) 500) :close)
      ;; nothing waiting ⇒ nil after the timeout (ui-run treats it as :tick)
      (assert= ((get d :poll) 1) nil))))
