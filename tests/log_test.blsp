;; std/log.blsp — the async, safe logger. Verifies delivery, level filtering
;; (global and per-backend), live add-backend, the no-logger stderr fallback, and
;; safety under concurrency (many processes logging through one logger, no loss).
;;
;; All blocks are :isolated: the logger registers the global name :logger and an
;; :isolated unit runs alone with rolled-back globals, so parallel tests can't race
;; the registry. Bodies stay tail-recursive (a test runs in a small-stack green
;; process). Register-only — `nest test` discovers it.

(defmodule log-test (:use test) (:use log) (:use io))

;; ---- file-local helpers -----------------------------------------------------
;; A backend that forwards each formatted line to `pid` (so the test can receive
;; what the logger emitted).
(defn lt-collect (pid) (fn-backend (fn (s) (send pid [:line s]))))

;; Receive one line, or :timeout.
(defn lt-line () (receive ([:line s] s) (after *test-wait-ms* :timeout)))

;; Tail-recursive drain of `n` lines into a list (ascending arrival order).
(defn lt-drain (n acc)
  (if (= n 0)
    (reverse acc)
    (receive
      ([:line s] (lt-drain (- n 1) (cons s acc)))
      (after 5000 (reverse (cons :timeout acc))))))

;; Tail-recursive [0, n).
(defn lt-upto (n) (lt-upto-down (- n 1) nil))
(defn- lt-upto-down (i acc) (if (< i 0) acc (lt-upto-down (- i 1) (cons i acc))))

;; ---- delivery + formatting --------------------------------------------------
(describe "log: delivery and levels"
  :isolated
  (test "a log call delivers a formatted line to a backend"
    (let (me (self))
      (start-logger {:level :debug :backends [(lt-collect me)]})
      (info "hello")
      (let (line (lt-line))
        (stop-logger)
        (is (includes? line "hello"))
        (is (includes? line "INFO")))))

  (test "structured meta does not break the default line"
    (let (me (self))
      (start-logger {:level :debug :backends [(lt-collect me)]})
      (log :error "boom" {:code 500})
      (let (line (lt-line))
        (stop-logger)
        (is (includes? line "boom"))
        (is (includes? line "ERROR")))))

  (test "a level below the logger's global minimum is dropped"
    (let (me (self))
      (start-logger {:level :info :backends [(lt-collect me)]})
      (debug "drop-me")
      (info "keep-me")
      ;; only the :info line should arrive; the first one through must be it
      (let (line (lt-line))
        (stop-logger)
        (is (includes? line "keep-me")))))

  (test "per-backend :min-level filters independently of the logger level"
    (let (me (self))
      (start-logger {:level :debug
                     :backends [(backend (fn-port (fn (s) (send me [:line s])))
                                  {:min-level :warn})]})
      (info "below")
      (error "above")
      (let (line (lt-line))
        (stop-logger)
        (is (includes? line "above")))))

  (test "per-backend :filter routes by record category (one logger, many sinks)"
    (let (me (self))
      ;; two category backends on ONE logger: each writes only its own records.
      (start-logger {:level :debug
                     :backends [(backend (fn-port (fn (s) (send me [:line :lsp s])))
                                  {:filter (fn (r) (= (get (get r :meta) :category) :lsp))})
                                 (backend (fn-port (fn (s)
                                                     (send me
                                                       [:line
                                                         :other s])))
                                   {:filter (fn (r)
                                              (not (= (get (get r
                                                             :meta)
                                                        :category)
                                                     :lsp)))})]})
      (info "to-lsp" {:category :lsp})
      (info "to-other")
      ;; collect the two delivered lines, tagged by which backend sent them
      (let (a (receive ([:line tag s] [tag s]) (after *test-wait-ms* :timeout))
            b (receive ([:line tag s] [tag s]) (after *test-wait-ms* :timeout)))
        (stop-logger)
        (let (lsp-line (if (= (first a) :lsp) (second a) (second b))
              other-line (if (= (first a) :other) (second a) (second b)))
          (is (includes? lsp-line "to-lsp"))
          ; the :lsp backend did NOT get the uncategorized one
          (refute (includes? lsp-line "to-other"))
          (is (includes? other-line "to-other")))))))

;; ---- lifecycle --------------------------------------------------------------
(describe "log: lifecycle"
  :isolated
  (test "add-backend routes subsequent logs to the new backend"
    (let (me (self))
      (start-logger {:level :debug :backends []})
      (add-backend (lt-collect me))
      (sleep 40)
      ; let the add-backend cast land first
      (info "after-add")
      (let (line (lt-line))
        (stop-logger)
        (is (includes? line "after-add")))))

  (test "with no logger running, log falls back and never throws"
    (stop-logger)
    (sleep 80)
    ; let any prior logger's name clear from the registry
    (is (nil? (logger)))
    ;; fallback path writes to stderr; the call must still return nil cleanly
    (assert= (info "nowhere") nil)))

;; ---- the LogBackend ability -------------------------------------------------
;; A backend is any value with a `LogBackend` impl, so a backend that does something
;; other than "format one line and write it" needs no change to std/log.blsp. This one
;; sends the record itself (not a formatted line) and reuses the standard level/filter
;; gate via `backend-passes?`.

(defrecord raw-backend (target min-level filter))

(impl LogBackend
  log-test/raw-backend
  (backend-emit [b record]
    (when (backend-passes? b record)
      (send (get b :target) [:rec record]))
    nil))

(describe "log: a third-party LogBackend"
  :isolated
  (test "a custom backend record receives records instead of formatted lines"
    (let (me (self))
      (start-logger {:level :debug :backends [(raw-backend me :debug nil)]})
      (info "structured" {:category :lsp})
      (let (rec (receive ([:rec r] r) (after *test-wait-ms* :timeout)))
        (stop-logger)
        (assert= (get rec :level) :info)
        (assert= (get rec :msg) "structured")
        (assert= (get (get rec :meta) :category) :lsp))))
  (test "a custom backend reusing backend-passes? honours :min-level"
    (let (me (self))
      (start-logger {:level :debug :backends [(raw-backend me :warn nil)]})
      (info "dropped")
      (error "kept")
      (let (rec (receive ([:rec r] r) (after *test-wait-ms* :timeout)))
        (stop-logger)
        (assert= (get rec :msg) "kept"))))
  (test "custom and stock backends coexist on one logger"
    (let (me (self))
      (start-logger {:level :debug :backends [(raw-backend me :debug nil) (lt-collect me)]})
      (info "both")
      ;; one record from the custom backend, one formatted line from the stock one
      (let (first-message (receive
                            ([:rec r] [:rec r])
                            ([:line s] [:line s])
                            (after *test-wait-ms* :timeout))
            second-message (receive
                             ([:rec r] [:rec r])
                             ([:line s] [:line s])
                             (after *test-wait-ms* :timeout)))
        (stop-logger)
        (is (not (= (first first-message) (first second-message))))))))

(describe "log: the stock backend is a record"
  (test "backend builds a line-backend with the documented defaults"
    (let (b (backend (fn-port (fn (s) s))))
      (is (record? b))
      (assert= (record-id b) :log/line-backend)
      (assert= (get b :min-level) :debug)
      (is (nil? (get b :filter)))))
  (test "a backend prints as itself, naming its sink"
    (assert= (to-str (stdout-backend)) "#<log-backend #<port stdout> min=:debug>")
    (assert= (to-str (backend (stderr-port) {:min-level :warn}))
      "#<log-backend #<port stderr> min=:warn>")
    (is (includes? (to-str (backend (stdout-port) {:filter (fn (r) true)})) "filtered")))
  (test "file-backend writes through a file-port"
    (assert= (record-id (get (file-backend "/tmp/brood-log-test.log") :sink)) :io/file-port))
  (test "satisfies? reports whether a value can serve as a backend"
    (is (satisfies? 'LogBackend (stdout-backend)))
    (is (satisfies? 'LogBackend (raw-backend (self) :debug nil)))
    (is (not (satisfies? 'LogBackend {:sink (fn (s) s)})))))

;; ---- concurrency ------------------------------------------------------------
(describe "log: safe under concurrency"
  :isolated
  (test "N processes each log once; every line arrives, none lost or interleaved"
    (let (me (self) n 40)
      (start-logger {:level :debug :backends [(lt-collect me)]})
      (fold (fn (acc i) (spawn (info (str "w" i))) acc) nil (lt-upto n))
      (let (got (lt-drain n nil))
        (stop-logger)
        (assert= (count got) n)
        (is (not (includes? got :timeout)))))))
