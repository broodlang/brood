;; `spawn-monitor` — atomic spawn + monitor (the monitor-side twin of `spawn-link`).
;;
;; The property under test is not "a monitor fires" (that is `monitor`'s own coverage) but
;; that the DOWN carries the child's **real** exit reason even when the child is already
;; gone by the time the parent's next instruction runs. The two-step
;; `(let (p (spawn …) r (monitor p)) …)` only holds that while the spawner never yields
;; between the two calls; open a gap and `monitor` takes its already-dead branch, firing a
;; synthetic `:noproc` in place of the reason. Measured before the primitive existed:
;; adjacent, 0 of 300 runs lost the reason; with one 5 ms yield between them, 40 of 40 did.
;; Nothing raises in that case — the receive fires, carrying a reason that says only
;; "already gone" — so a test that merely checks "a DOWN arrived" passes on the bug.
;;
;; Register-only. Each test runs in its own green process on the worker pool, so this is
;; exercised across cores; the `:isolated` block at the end fans out concurrently.

(defmodule spawn-monitor-test (:use test))

;; The gap that breaks the two-step form, widened until the child has certainly exited:
;; a loaded box or a boundary-trace wrapper amounts to the same yield. `eventually` polls
;; with `sleep`. (A bare `(receive (after 5 nil))` used to match anything and eat the very
;; `[:down …]` the test waits for; since ADR-520 it waits like `sleep`.)
(defn- await-exit (pid)
  (eventually "the child exiting" (fn () (not (proc/alive? pid)))))

(describe "spawn-monitor: the reason survives the gap"

  (test "returns [pid ref]"
    (let ([p r] (spawn-monitor :ok))
      (is (= (type-of p) :pid))
      (is (= (type-of r) :ref))
      ;; drain, so the DOWN doesn't outlive the test into a sibling's mailbox
      (receive ([:down ^r _ _] nil) (after test/*wait-ms* nil))))

  (test "a crash reports its REAL reason, not :noproc, across a yield"
    (let ([p r] (spawn-monitor (error "i fell over")))
      (await-exit p)
      (let (reason (receive ([:down ^r ^p reason] reason) (after test/*wait-ms* :lost)))
        ;; The shape is `[:error {:message … :kind … :trace …}]`. Asserting the TAG is what
        ;; matters here — `:noproc` is a bare keyword, so `(first reason)` raising or
        ;; yielding anything but `:error` is exactly the regression.
        (assert= :error (first reason))
        (assert= "i fell over" (:message (second reason))))))

  (test "a :normal exit reports :normal, not :noproc, across a yield"
    ;; This is the case that silently misleads a supervisor: `:noproc` is not `:normal`,
    ;; so a `:transient` child's clean exit reads as abnormal and gets restarted.
    (let ([p r] (spawn-monitor :ok))
      (await-exit p)
      (assert= :normal
        (receive ([:down ^r ^p reason] reason) (after test/*wait-ms* :lost)))))

  (test "the DOWN names the pid that was spawned"
    (let ([p r] (spawn-monitor :ok))
      (assert= p (receive ([:down ^r pid _] pid) (after test/*wait-ms* :lost)))))

  (test "a zero-arg lambda body is passed through, not re-wrapped"
    ;; Same contract as `spawn`/`spawn-link`: `(fn () …)` is the thunk, not a value to wrap.
    (let ([_p r] (spawn-monitor (fn () (error "from a lambda"))))
      (let (reason (receive ([:down ^r _ reason] reason) (after test/*wait-ms* :lost)))
        (assert= :error (first reason))
        (assert= "from a lambda" (:message (second reason))))))

  ;; The contrast case, kept as documentation of the semantics `spawn-monitor` exists to
  ;; avoid — monitoring a pid that is ALREADY dead is legitimately `:noproc`, and that is
  ;; unchanged. (The link suite pins the same thing for `link`.)
  (test "monitoring an already-dead pid is still :noproc"
    (let ([p first-ref] (spawn-monitor :ok))
      ; p is dead once its first DOWN has arrived
      (receive ([:down ^first-ref ^p _] :ok) (after test/*wait-ms* :timeout))
      (let (r (monitor p))
        (assert= :noproc
          (receive ([:down ^r ^p reason] reason) (after test/*wait-ms* :lost)))))))

(describe "spawn-monitor: across processes"
  :isolated (test "every child's reason arrives intact under a concurrent fan-out"
    ;; The single-process cases above each wait out one child. This one puts real contention behind
    ;; the gap: N watchers, each spawn-monitoring a crasher and reporting what it saw. A
    ;; regression here shows up as `:noproc` in place of the reason, so the assertion is on
    ;; the reasons themselves, not on the count of DOWNs.
    (let (me (self)
          n 24
          watcher (fn ()
                    (let ([p r] (spawn-monitor (error "fell")))
                      (await-exit p)
                      (send me
                        [:saw (receive ([:down ^r _ reason] reason) (after test/*wait-ms* :lost))]))))
      (dotimes (_ n) (spawn (watcher)))
      (let (collect (fn (collect i bad)
                      (if (>= i n)
                        bad
                        (receive
                          ([:saw reason]
                            (collect collect
                              (+ i 1)
                              ;; the TAG, not the whole reason: the payload
                              ;; carries a trace, and `:noproc` is a keyword
                              ;; with no tag at all
                              (if (and (vector? reason) (= (first reason) :error))
                                bad
                                (cons reason bad))))
                          (after test/*wait-ms* (cons :timeout bad))))))
        ;; Name what went wrong rather than just a count — a `:noproc` here and a `:lost`
        ;; here mean different bugs.
        (assert= '() (collect collect 0 '()))))))

;; docs/language.md § Monitors: a crash reason is `[:error m]` where `m` is the map a `catch`
;; in the dying process would have bound. It was built from the error's text alone, so a
;; thrown map arrived as its printed string and a contract violation as `:kind :user`, its
;; `:blame`/`:expected`/`:got` gone. The standard fields a bound map lacks are filled in.
(defn- down-reason-of (thunk)
  (let ([p r] (spawn-monitor (thunk)))
    (receive ([:down ^r ^p reason] reason) (after test/*wait-ms* :lost))))

(defn- smt-int-only (n) n)
(sig! smt-int-only (int -> int))

(describe "spawn-monitor: the reason is what a catch would bind"
  (test "a thrown map arrives as thrown, with the standard fields filled in"
    (let ([tag m] (down-reason-of (fn () (throw {:kind :overdrawn :account 7 :short 12.50M}))))
      (assert= :error tag)
      (assert= :overdrawn (:kind m))
      (assert= 7 (:account m))
      (assert= 12.50M (:short m))
      (is (string? (:message m)))))
  (test "a contract violation keeps its kind and blame"
    (let ([tag m] (down-reason-of (fn () (check-allow :type-mismatch (smt-int-only "x")))))
      (assert= :error tag)
      (assert= :contract (:kind m))
      (assert= :caller (:blame m))
      (assert= "x" (:got m))))
  (test "a built-in error and a thrown string still read as structured error maps"
    (let ([_ arity] (down-reason-of (fn () (apply (fn (a) a) [])))
          [_ thrown] (down-reason-of (fn () (throw "plain"))))
      (assert= :arity (:kind arity))
      (assert= :user (:kind thrown))
      (assert= "plain" (:message thrown)))))
