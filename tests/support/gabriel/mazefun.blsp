;; tests/support/gabriel/mazefun.blsp — the Gabriel MAZEFUN benchmark, ported to Brood.
;;
;; Marc Feeley's maze generator, written to construct a maze "in a purely functional
;; way": the cave is a list of lists, and every pierce rebuilds the rows it touches
;; rather than assigning into them. That makes it the one benchmark in this corpus whose
;; *original* already obeys Brood's immutability rule — a rare thing in a 1980s Lisp
;; benchmark suite, and the reason it ports with no design decisions at all.
;;
;; It is also the most demanding oracle here: the result is an 11x11 grid of symbols, so
;; a single mis-flooded cavity changes one cell and fails. The maze is deterministic
;; because upstream's shuffle runs its own LCG from a fixed seed (`initial-random` 0) —
;; no reliance on a host RNG, which is what makes the vendored expected grid meaningful.
;;
;; Transcription notes. Three of upstream's names collide with prelude names whose
;; behaviour differs, and inside a module a local `def` shadows the prelude for the whole
;; file, so each is renamed rather than redefined:
;;
;;   upstream `for`     -> `mazefun--tabulate`   (prelude `for` is the comprehension MACRO)
;;   upstream `shuffle` -> `mazefun--shuffle`    (prelude `shuffle` is seeded differently)
;;   upstream `foldl`   -> prelude `fold`        (same argument order, (acc x))
;;
;; `list-read` is prelude `nth`; `list-write` and `list-remove-pos` have no list-level
;; prelude equivalent and are ported verbatim. Positions are `[i j]` vectors rather than
;; dotted pairs: Brood has dotted pairs, but a vector is the idiomatic tuple and `=` is
;; structural either way, so the cavity-id comparisons behave identically. Cavity ids
;; never reach the output — `cave->maze` maps them to `_`/`*` — so the choice cannot
;; affect the oracle.

(defmodule gabriel/mazefun
  "The Gabriel MAZEFUN benchmark (a purely functional maze generator) — a conformance
port. The oracle is upstream's own expected output in
`tests/corpus/gabriel/data/mazefun.input`.")

;; ---- list and matrix helpers -------------------------------------------------

;; Non-tail: `foldr` folds right, so the recursion has to unwind before combining.
(check-allow :non-tail-recursion
  (defn mazefun--foldr (f base lst)
    (if (nil? lst)
      base
      (f (first lst) (mazefun--foldr f base (rest lst))))))

;; `(f lo) (f lo+1) … (f hi-1)` as a list — upstream's `for`.
(defn mazefun--tabulate (lo hi f)
  (map f (range lo hi)))

(defn mazefun--concat (lists)
  (mazefun--foldr append nil lists))

(check-allow :non-tail-recursion
  (defn mazefun--list-write (lst i val)
    (if (= i 0)
      (cons val (rest lst))
      (cons (first lst) (mazefun--list-write (rest lst) (- i 1) val)))))

(check-allow :non-tail-recursion
  (defn mazefun--list-remove-pos (lst i)
    (if (= i 0)
      (rest lst)
      (cons (first lst) (mazefun--list-remove-pos (rest lst) (- i 1))))))

(defn mazefun--duplicates? (lst)
  (cond
    (nil? lst) false
    (includes? (rest lst) (first lst)) true
    else (mazefun--duplicates? (rest lst))))

(defn mazefun--make-matrix (n m init)
  (mazefun--tabulate 0 n (fn (i) (mazefun--tabulate 0 m (fn (j) (init i j))))))

(defn mazefun--matrix-read (mat i j)
  (nth (nth mat i) j))

(defn mazefun--matrix-write (mat i j val)
  (mazefun--list-write mat i (mazefun--list-write (nth mat i) j val)))

;; `[rows cols]` — upstream returns a dotted pair.
(defn mazefun--matrix-size (mat)
  [(count mat) (count (first mat))])

(defn mazefun--matrix-map (f mat)
  (map (fn (row) (map f row)) mat))

;; ---- upstream's own LCG, so the maze is reproducible -------------------------

(def mazefun--initial-random 0)

(defn mazefun--next-random (current)
  (rem (+ (* current 3581) 12751) 131072))

;; Non-tail (the `cons` wraps the recursion), matching upstream's `shuffle-aux`.
(check-allow :non-tail-recursion
  (defn mazefun--shuffle--acc (lst current)
    (if (nil? lst)
      nil
      (let (next (mazefun--next-random current)
            i (rem next (count lst)))
        (cons (nth lst i)
          (mazefun--shuffle--acc (mazefun--list-remove-pos lst i) next))))))

(defn mazefun--shuffle (lst)
  (mazefun--shuffle--acc lst mazefun--initial-random))

;; ---- the maze ---------------------------------------------------------------

(defn mazefun--neighboring-cavities (pos cave)
  (let ([n m] (mazefun--matrix-size cave)
        [i j] pos)
    (append (if (and (> i 0) (mazefun--matrix-read cave (- i 1) j))
              (list [(- i 1) j])
              nil)
      (if (and (< i (- n 1)) (mazefun--matrix-read cave (+ i 1) j))
        (list [(+ i 1) j])
        nil)
      (if (and (> j 0) (mazefun--matrix-read cave i (- j 1)))
        (list [i (- j 1)])
        nil)
      (if (and (< j (- m 1)) (mazefun--matrix-read cave i (+ j 1)))
        (list [i (+ j 1)])
        nil))))

;; Flood-fill: rename every cell of the cavity `old-cavity-id` to `new-cavity-id`.
;; Non-tail through the `fold`'s closure — the recursion is the fill.
(check-allow :non-tail-recursion
  (defn mazefun--change-cavity--from (cave pos new-cavity-id old-cavity-id)
    (let ([i j] pos
          cavity-id (mazefun--matrix-read cave i j))
      (if (= cavity-id old-cavity-id)
        (fold (fn (c nc)
                (mazefun--change-cavity--from c nc new-cavity-id old-cavity-id))
          (mazefun--matrix-write cave i j new-cavity-id)
          (mazefun--neighboring-cavities pos cave))
        cave))))

(defn mazefun--change-cavity (cave pos new-cavity-id)
  (let ([i j] pos)
    (mazefun--change-cavity--from cave
      pos
      new-cavity-id
      (mazefun--matrix-read cave i j))))

(defn mazefun--pierce (pos cave)
  (let ([i j] pos)
    (mazefun--matrix-write cave i j pos)))

(defn mazefun--try-to-pierce (pos cave)
  (let (ncs (mazefun--neighboring-cavities pos cave))
    (if (mazefun--duplicates? (map (fn (nc) (let ([i j] nc) (mazefun--matrix-read cave i j))) ncs))
      cave
      (mazefun--pierce pos
        (fold (fn (c nc) (mazefun--change-cavity c nc pos))
          cave ncs)))))

(defn mazefun--pierce-randomly (possible-holes cave)
  (if (nil? possible-holes)
    cave
    (mazefun--pierce-randomly (rest possible-holes)
      (mazefun--try-to-pierce (first possible-holes) cave))))

(defn cave->maze (cave)
  "The cave with each cavity id rendered as `_` (open) and each wall as `*`."
  (mazefun--matrix-map (fn (x) (if x '_ '*)) cave))

(defn make-maze (n m)
  "An `n` x `m` maze as a list of rows of `_`/`*` symbols. `n` and `m` must be odd;
returns the symbol `error` otherwise, as upstream does."
  (if (not (and (odd? n) (odd? m)))
    'error
    (let (cave (mazefun--make-matrix n
                 m
                 (fn (i j)
                   (if (and (even? i) (even? j))
                     [i j]
                     false)))
          possible-holes (mazefun--concat (mazefun--tabulate 0
                                            n
                                            (fn (i)
                                              (mazefun--concat (mazefun--tabulate 0
                                                                 m
                                                                 (fn (j)
                                                                   (if (= (even? i) (even? j))
                                                                     nil
                                                                     (list [i j])))))))))
      (cave->maze (mazefun--pierce-randomly (mazefun--shuffle possible-holes) cave)))))
