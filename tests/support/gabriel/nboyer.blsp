;; tests/support/gabriel/nboyer.blsp — the Gabriel BOYER benchmark, ported to Brood.
;;
;; Bob Boyer's theorem prover: 106 rewrite rules are filed by the head symbol of their
;; left-hand side, then a propositional term is rewritten to normal form and checked for
;; tautology. Upstream calls it "fairly CONS intensive" and it is the most demanding
;; program in this corpus — deep non-tail recursion over a term graph that the rewriter
;; keeps rebuilding, with unification allocating a substitution per attempted rule.
;;
;; The oracle is unusually strong for a benchmark. Upstream deliberately reports the
;; **number of rewrites**, "because it is too easy for a buggy version to return the
;; correct boolean result" — so a port or an engine that takes a wrong branch, tries
;; rules in the wrong order, or unifies too eagerly produces a wrong integer even when it
;; still answers "yes, a tautology".
;;
;; ---------------------------------------------------------------------------------
;; The one real design decision: upstream mutates, and Brood cannot.
;;
;; Upstream's 1997 rewrite replaced property lists with *symbol-records* — a mutable
;; two-slot vector per symbol, holding the symbol and its lemma list. `translate-term`
;; then substitutes those records for the constructor symbols inside every term, so a
;; term carries direct pointers to its head's lemma list and `add-lemma` can extend that
;; list in place, after the terms referring to it were built. Upstream notes the result:
;; "translated terms can be circular structures, which can't be compared using Scheme's
;; equal?", hence its hand-written `term-equal?`/`term-member?`.
;;
;; None of that survives immutability (ADR-026), and none of it needs to. The mutation is
;; pure *staging*: every lemma is added during setup, and the rewriting phase only ever
;; reads. So this port keeps plain symbols in terms and puts the lemma database in one
;; immutable map, built once by a fold and then read-only:
;;
;;   upstream                                  this port
;;   ----------------------------------------  ------------------------------------------
;;   symbol-record vector, mutated by `put`    an immutable `{head-symbol -> lemmas}` map
;;   `translate-term` rewrites heads to records  omitted — terms keep their symbols
;;   `get-lemmas (car term)`                   `(get db (first term))`
;;   `term-equal?` (records are `eq?`-compared)  `=` — terms are now acyclic trees
;;   `term-member?`                            `includes?`
;;   `rewrite-count` global, `set!`-bumped     threaded: `rewrite` returns `[term count]`
;;   `unify-subst` global, `set!`-accumulated  threaded: unify returns a subst or `:fail`
;;
;; This is behaviour-identical, and the rewrite count proves it: symbol records stand in
;; 1:1 for symbols, so identity comparison and structural comparison are the same
;; relation on these terms; the map preserves upstream's per-symbol lemma ORDER (each new
;; lemma conses onto the front, and `rewrite-with-lemmas` tries them in that order), which
;; is what the count depends on. The threading is not a shortcut around the rule — a
;; `Value::Table` counter would have been — it is the functional form of the same program.
;;
;; Two sentinels are load-bearing. Unification returns `:fail` rather than a falsy value
;; because a *successful* unification can legitimately produce an EMPTY substitution, and
;; Brood's empty list is `nil`, which is falsy — `(if subst …)` would read success as
;; failure. `nboyer-lookup` returns `:none` for the same reason: a variable can be bound
;; to a term that is itself nil-shaped. Keywords can never appear in a term, so neither
;; sentinel can collide with real data.

(defmodule gabriel/nboyer
  "The Gabriel BOYER benchmark (a rewrite-rule theorem prover) — a conformance port. The
oracle is the rewrite count published in upstream's own source header; see
`tests/corpus/gabriel/README.md`.")

;; ---- upstream's data, verbatim ------------------------------------------------
;; The 106 rewrite rules, read straight from `nboyer.scm`'s `(quote (…))` block. It is
;; ordinary quoted data in Brood too, so the block is copied unchanged rather than
;; transcribed — the one part of a port with no room for judgement and every room for a
;; typo. Note `nil` inside a term reads as Brood's nil literal rather than a symbol; it is
;; consistent on both sides of every comparison and, exactly as in upstream, a bare
;; non-pair in a rule's left-hand side acts as a pattern variable either way.

(def- nboyer-lemma-data
  '((equal (compile form)
      (reverse (codegen (optimize form)
                 (nil)))) (equal (eqp x
                                                                                                     y)
                                                                                              (equal (fix x)
                                                                                                (fix y)))
     (equal (greaterp x y)
       (lessp y x))
     (equal (lesseqp x y)
       (not (lessp y x)))
     (equal (greatereqp x y)
       (not (lessp x y)))
     (equal (boolean x)
       (or (equal x (t))
         (equal x (f))))
     (equal (iff x y)
       (and (implies x y)
         (implies y x)))
     (equal (even1 x)
       (if (zerop x)
         (t)
         (odd (_1- x))))
     (equal (countps- l pred)
       (countps-loop l pred (zero)))
     (equal (fact- i)
       (fact-loop i 1))
     (equal (reverse- x)
       (reverse-loop x (nil)))
     (equal (divides x y)
       (zerop (remainder y x)))
     (equal (assume-true var alist)
       (cons (cons var (t))
         alist))
     (equal (assume-false var alist)
       (cons (cons var (f))
         alist))
     (equal (tautology-checker x)
       (tautologyp (normalize x)
         (nil)))
     (equal (falsify x)
       (falsify1 (normalize x)
         (nil)))
     (equal (prime x)
       (and (not (zerop x))
         (not (equal x (add1 (zero))))
         (prime1 x (_1- x))))
     (equal (and p q)
       (if p
         (if q
           (t)
           (f))
         (f)))
     (equal (or p q)
       (if p
         (t)
         (if q
           (t)
           (f))))
     (equal (not p)
       (if p
         (f)
         (t)))
     (equal (implies p q)
       (if p
         (if q
           (t)
           (f))
         (t)))
     (equal (fix x)
       (if (numberp x)
         x
         (zero)))
     (equal (if (if a b c)
              d
              e)
       (if a
         (if b d e)
         (if c d e)))
     (equal (zerop x)
       (or (equal x (zero))
         (not (numberp x))))
     (equal (plus (plus x y)
              z)
       (plus x (plus y z)))
     (equal (equal (plus a b)
              (zero))
       (and (zerop a)
         (zerop b)))
     (equal (difference x x)
       (zero))
     (equal (equal (plus a b)
              (plus a c))
       (equal (fix b)
         (fix c)))
     (equal (equal (zero)
              (difference x y))
       (not (lessp y x)))
     (equal (equal x (difference x y))
       (and (numberp x)
         (or (equal x (zero))
           (zerop y))))
     (equal (meaning (plus-tree (append x y))
              a)
       (plus (meaning (plus-tree x)
               a)
         (meaning (plus-tree y)
           a)))
     (equal (meaning (plus-tree (plus-fringe x))
              a)
       (fix (meaning x a)))
     (equal (append (append x y)
              z)
       (append x (append y z)))
     (equal (reverse (append a b))
       (append (reverse b)
         (reverse a)))
     (equal (times x (plus y z))
       (plus (times x y)
         (times x z)))
     (equal (times (times x y)
              z)
       (times x (times y z)))
     (equal (equal (times x y)
              (zero))
       (or (zerop x)
         (zerop y)))
     (equal (exec (append x y)
              pds envrn)
       (exec y
         (exec x pds envrn)
         envrn))
     (equal (mc-flatten x y)
       (append (flatten x)
         y))
     (equal (member x (append a b))
       (or (member x a)
         (member x b)))
     (equal (member x (reverse y))
       (member x y))
     (equal (length (reverse x))
       (length x))
     (equal (member a (intersect b c))
       (and (member a b)
         (member a c)))
     (equal (nth (zero)
              i)
       (zero))
     (equal (exp i (plus j k))
       (times (exp i j)
         (exp i k)))
     (equal (exp i (times j k))
       (exp (exp i j)
         k))
     (equal (reverse-loop x y)
       (append (reverse x)
         y))
     (equal (reverse-loop x (nil))
       (reverse x))
     (equal (count-list z (sort-lp x y))
       (plus (count-list z x)
         (count-list z y)))
     (equal (equal (append a b)
              (append a c))
       (equal b c))
     (equal (plus (remainder x y)
              (times y (quotient x y)))
       (fix x))
     (equal (power-eval (big-plus1 l i base)
              base)
       (plus (power-eval l base)
         i))
     (equal (power-eval (big-plus x y i base)
              base)
       (plus i
         (plus (power-eval x base)
           (power-eval y base))))
     (equal (remainder y 1)
       (zero))
     (equal (lessp (remainder x y)
              y)
       (not (zerop y)))
     (equal (remainder x x)
       (zero))
     (equal (lessp (quotient i j)
              i)
       (and (not (zerop i))
         (or (zerop j)
           (not (equal j 1)))))
     (equal (lessp (remainder x y)
              x)
       (and (not (zerop y))
         (not (zerop x))
         (not (lessp x y))))
     (equal (power-eval (power-rep i base)
              base)
       (fix i))
     (equal (power-eval (big-plus (power-rep i base)
                          (power-rep j base)
                          (zero)
                          base)
              base)
       (plus i j))
     (equal (gcd x y)
       (gcd y x))
     (equal (nth (append a b)
              i)
       (append (nth a i)
         (nth b (difference i (length a)))))
     (equal (difference (plus x y)
              x)
       (fix y))
     (equal (difference (plus y x)
              x)
       (fix y))
     (equal (difference (plus x y)
              (plus x z))
       (difference y z))
     (equal (times x (difference c w))
       (difference (times c x)
         (times w x)))
     (equal (remainder (times x z)
              z)
       (zero))
     (equal (difference (plus b (plus a c))
              a)
       (plus b c))
     (equal (difference (add1 (plus y z))
              z)
       (add1 y))
     (equal (lessp (plus x y)
              (plus x z))
       (lessp y z))
     (equal (lessp (times x z)
              (times y z))
       (and (not (zerop z))
         (lessp x y)))
     (equal (lessp y (plus x y))
       (not (zerop x)))
     (equal (gcd (times x z)
              (times y z))
       (times z (gcd x y)))
     (equal (value (normalize x)
              a)
       (value x a))
     (equal (equal (flatten x)
              (cons y (nil)))
       (and (nlistp x)
         (equal x y)))
     (equal (listp (gopher x))
       (listp x))
     (equal (samefringe x y)
       (equal (flatten x)
         (flatten y)))
     (equal (equal (greatest-factor x y)
              (zero))
       (and (or (zerop y)
              (equal y 1))
         (equal x (zero))))
     (equal (equal (greatest-factor x y)
              1)
       (equal x 1))
     (equal (numberp (greatest-factor x y))
       (not (and (or (zerop y)
                   (equal y 1))
              (not (numberp x)))))
     (equal (times-list (append x y))
       (times (times-list x)
         (times-list y)))
     (equal (prime-list (append x y))
       (and (prime-list x)
         (prime-list y)))
     (equal (equal z (times w z))
       (and (numberp z)
         (or (equal z (zero))
           (equal w 1))))
     (equal (greatereqp x y)
       (not (lessp x y)))
     (equal (equal x (times x y))
       (or (equal x (zero))
         (and (numberp x)
           (equal y 1))))
     (equal (remainder (times y x)
              y)
       (zero))
     (equal (equal (times a b)
              1)
       (and (not (equal a (zero)))
         (not (equal b (zero)))
         (numberp a)
         (numberp b)
         (equal (_1- a)
           (zero))
         (equal (_1- b)
           (zero))))
     (equal (lessp (length (delete x l))
              (length l))
       (member x l))
     (equal (sort2 (delete x l))
       (delete x (sort2 l)))
     (equal (dsort x)
       (sort2 x))
     (equal (length (cons x1
                      (cons x2
                        (cons x3
                          (cons x4
                            (cons x5
                              (cons x6 x7)))))))
       (plus 6 (length x7)))
     (equal (difference (add1 (add1 x))
              2)
       (fix x))
     (equal (quotient (plus x (plus x y))
              2)
       (plus x (quotient y 2)))
     (equal (sigma (zero)
              i)
       (quotient (times i (add1 i))
         2))
     (equal (plus x (add1 y))
       (if (numberp y)
         (add1 (plus x y))
         (add1 x)))
     (equal (equal (difference x y)
              (difference z y))
       (if (lessp x y)
         (not (lessp y z))
         (if (lessp z y)
           (not (lessp y x))
           (equal (fix x)
             (fix z)))))
     (equal (meaning (plus-tree (delete x y))
              a)
       (if (member x y)
         (difference (meaning (plus-tree y)
                       a)
           (meaning x a))
         (meaning (plus-tree y)
           a)))
     (equal (times x (add1 y))
       (if (numberp y)
         (plus x (times x y))
         (fix x)))
     (equal (nth (nil)
              i)
       (if (zerop i)
         (nil)
         (zero)))
     (equal (last (append a b))
       (if (listp b)
         (last b)
         (if (listp a)
           (cons (car (last a))
             b)
           b)))
     (equal (equal (lessp x y)
              z)
       (if (lessp x y)
         (equal (t) z)
         (equal (f) z)))
     (equal (assignment x (append a b))
       (if (assignedp x a)
         (assignment x a)
         (assignment x b)))
     (equal (car (gopher x))
       (if (listp x)
         (car (flatten x))
         (zero)))
     (equal (flatten (cdr (gopher x)))
       (if (listp x)
         (cdr (flatten x))
         (cons (zero)
           (nil))))
     (equal (quotient (times y x)
              y)
       (if (zerop y)
         (zero)
         (fix x)))
     (equal (get j (set i val mem))
       (if (eqp j i)
         val
         (get j mem)))))

;; The test problem, from `nboyer.scm`'s `alist` and `term` globals (upstream's `.input`
;; file carries only the iteration count, the scaling parameter and the expected rewrite
;; count). Renamed with an `nboyer-` prefix because `alist`/`term` are too generic to
;; refer bare from a test module.

(def nboyer-alist
  '((x f
      (plus (plus a b)
        (plus c (zero)))) (y f
                                                            (times (times a b)
                                                              (plus c d)))
     (z f
       (reverse (append (append a b)
                  (nil))))
     (u equal
       (plus a b)
       (difference x y))
     (w lessp
       (remainder a b)
       (member a (length b)))))

(def nboyer-term
  '(implies (and (implies x y)
              (and (implies y z)
                (and (implies z u)
                  (implies u w))))
     (implies x w)))

;; ---- phase one: build the lemma database -------------------------------------

;; A lemma is `(equal LHS RHS)`, filed under the head symbol of its LHS and consed onto
;; the front of that symbol's list — so the LAST lemma read is tried FIRST. The rewrite
;; count depends on that order.
(defn- nboyer-add-lemma
  (db lemma)
  (if (and (pair? lemma) (= (first lemma) 'equal) (pair? (second lemma)))
    (let (head (first (second lemma)))
      (assoc db head (cons lemma (get db head))))
    (error "nboyer: add-lemma did not like term: " (pr-str lemma))))

(defn setup-boyer ()
  "The lemma database — a map from a term's head symbol to its lemmas, in the order
`rewrite` must try them. Built once; read-only thereafter."
  (fold nboyer-add-lemma {} nboyer-lemma-data))

;; ---- substitution ------------------------------------------------------------

;; A substitution is a list of `[var term]` pairs, most recent first, so the first hit
;; wins — upstream conses onto the front and looks up with `assq`.
(defn- nboyer-lookup
  (var subst)
  (if (nil? subst)
    :none
    (let ([v term] (first subst))
      (if (= v var) term (nboyer-lookup var (rest subst))))))

(check-allow :non-tail-recursion
  (defn- nboyer-apply-subst
    (subst term)
    (if (not (pair? term))
      (let (found (nboyer-lookup term subst))
        (if (= found :none) term found))
      (cons (first term) (nboyer-apply-subst-lst subst (rest term))))))

(check-allow :non-tail-recursion
  (defn- nboyer-apply-subst-lst
    (subst lst)
    (if (nil? lst)
      nil
      (cons (nboyer-apply-subst subst (first lst))
        (nboyer-apply-subst-lst subst (rest lst))))))

;; ---- one-way unification -----------------------------------------------------
;; Matches `term1` against the rule pattern `term2`, where any non-pair in the pattern is
;; a variable. Returns the extended substitution, or `:fail`.

(check-allow :non-tail-recursion
  (defn- nboyer-unify1
    (term1 term2 subst)
    (if (not (pair? term2))
      (let (found (nboyer-lookup term2 subst))
        (cond
          (not (= found :none)) (if (= term1 found) subst :fail)
          ;; Upstream's 1997 bug fix: a NUMBER in a pattern is a literal, not a
          ;; variable. Its comment notes this alone made the benchmark 10-25% slower.
          (number? term2) (if (= term1 term2) subst :fail)
          else (cons [term2 term1] subst)))
      (cond
        (not (pair? term1)) :fail
        (= (first term1) (first term2)) (nboyer-unify1-lst (rest term1) (rest term2) subst)
        else :fail))))

(check-allow :non-tail-recursion
  (defn- nboyer-unify1-lst
    (lst1 lst2 subst)
    (cond
      (nil? lst1) (if (nil? lst2) subst :fail)
      (nil? lst2) :fail
      else
        (let (extended (nboyer-unify1 (first lst1) (first lst2) subst))
          (if (= extended :fail)
            :fail
            (nboyer-unify1-lst (rest lst1) (rest lst2) extended))))))

;; ---- rewriting ---------------------------------------------------------------
;; Each of these returns `[value rewrite-count]`. The count is bumped on ENTRY to
;; `rewrite`, including for a non-pair, which is where upstream's `set!` sits.

(check-allow :non-tail-recursion
  (defn- nboyer-rewrite
    (term db count)
    (let (count (+ count 1))
      (if (not (pair? term))
        [term count]
        (let ([args count2] (nboyer-rewrite-args (rest term) db count))
          (nboyer-rewrite-with-lemmas (cons (first term) args)
            (get db (first term))
            db
            count2))))))

(check-allow :non-tail-recursion
  (defn- nboyer-rewrite-args
    (lst db count)
    (if (nil? lst)
      [nil count]
      (let ([head count1] (nboyer-rewrite (first lst) db count)
            [tail count2] (nboyer-rewrite-args (rest lst) db count1))
        [(cons head tail) count2]))))

(check-allow :non-tail-recursion
  (defn- nboyer-rewrite-with-lemmas
    (term lemmas db count)
    (if (nil? lemmas)
      [term count]
      (let (lemma (first lemmas)
            subst (nboyer-unify1 term (second lemma) nil))
        (if (= subst :fail)
          (nboyer-rewrite-with-lemmas term (rest lemmas) db count)
          (nboyer-rewrite (nboyer-apply-subst subst (seq/third lemma)) db count))))))

;; ---- the tautology checker ---------------------------------------------------

(def- nboyer-true-term '(t))
(def- nboyer-false-term '(f))

(defn- nboyer-truep
  (x lst)
  (or (= x nboyer-true-term) (includes? lst x)))

(defn- nboyer-falsep
  (x lst)
  (or (= x nboyer-false-term) (includes? lst x)))

(check-allow :non-tail-recursion
  (defn- nboyer-tautologyp
    (x true-lst false-lst)
    (cond
      (nboyer-truep x true-lst) true
      (nboyer-falsep x false-lst) false
      (not (pair? x)) false
      (= (first x) 'if)
        (cond
          (nboyer-truep (second x) true-lst) (nboyer-tautologyp (seq/third x)
                                               true-lst false-lst)

          (nboyer-falsep (second x) false-lst) (nboyer-tautologyp (nth x 3)
                                                 true-lst false-lst)

          else
            (and (nboyer-tautologyp (seq/third x)
                   (cons (second x) true-lst)
                   false-lst)
              (nboyer-tautologyp (nth x 3) true-lst (cons (second x) false-lst))))
      else false)))

;; ---- the driver --------------------------------------------------------------

;; Upstream's scaling parameter: wrap the term in `(or term (f))` n times, which leaves
;; the tautology valid but multiplies the work. n=0 is 95,024 rewrites; each step up is
;; roughly 3x (see the table in the README).
(defn- nboyer-scale
  (term n)
  (if (= n 0) term (nboyer-scale (list 'or term '(f)) (- n 1))))

;; `((var . term) …)` from `((var head args…) …)`: the entry's head is the variable and
;; its TAIL is the term bound to it.
(defn- nboyer-subst-of-alist
  (alist)
  (map (fn (entry) [(first entry) (rest entry)]) alist))

(defn test-boyer (alist term n db)
  "The number of rewrites needed to prove `term` (scaled by `n`) under lemma database
`db`, or `false` if it does not reduce to a tautology."
  (let (problem (nboyer-apply-subst (nboyer-subst-of-alist alist)
                  (nboyer-scale term n))
        [normal count] (nboyer-rewrite problem db 0))
    (if (nboyer-tautologyp normal nil nil) count false)))
