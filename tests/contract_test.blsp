;; Runtime type contracts — `(sig! …)` (docs/type-annotations.md).
;;
;; `(sig …)` informs the advisory checker only; `(sig! …)` *also* installs a
;; runtime contract (the opt-in "strong arrow"): every argument and the result
;; are checked at call time and a mismatch throws. This is the *sound* half — a
;; value the static checker trusted can never silently slip through. Place a
;; `sig!` after the function's definition (it rebinds the name, preserving arity).
(defmodule contract-test
  (:use test)
  ;; `project-advisory-warning?` is module-private: the stability tests below assert that a
  ;; deprecation PRINTS but does not gate the build, and that classifier is the thing that
  ;; decides it (ADR-283).
  (:use-internals project-check))

(defn c-add (a b) (+ a b))
(sig! c-add (int int -> int))

;; A function that lies about its return type — the body returns a string. The
;; static checker now (correctly) sees the declared-return-vs-body mismatch, so
;; this deliberate negative test opts out of the lint; the *runtime* `sig!`
;; contract is what we're exercising (it throws — asserted below).
(check-allow :type-mismatch
  (defn c-bad-ret (x) "not an int"))
(sig! c-bad-ret (int -> int))

(defn c-id (x) x)
(sig! c-id ((or int nil) -> (or int nil)))

(describe "runtime contracts (sig!)"
  (test "a correct call passes through unchanged"
    (assert= (c-add 2 3) 5))
  (test "a bad first argument throws"
    (assert-error (c-add "x" 3)))
  (test "a bad second argument throws too"
    (assert-error (c-add 1 :k)))
  (test "a bad *result* throws — the fn can't lie about its return type"
    (assert-error (c-bad-ret 1)))
  (test "a union type accepts either member"
    (assert= (c-id 7) 7)
    (assert= (c-id nil) nil))
  (test "a union type still rejects a non-member"
    (assert-error (c-id "s"))))

;; --- element-level (list E) / (vector E) checks --------------------------------

(defn c-sum-list (xs) (reduce xs 0 +))
(sig! c-sum-list ((list int) -> int))

(defn c-first-vec (v) (first v))
(sig! c-first-vec ((vector string) -> (or nil string)))

(describe "element-level sequence type checks"
  (test "(list int) accepts a list of ints"
    (assert= (c-sum-list (list 1 2 3)) 6))
  (test "(list int) rejects a list containing a non-int"
    (assert-error (c-sum-list (list 1 "two" 3))))
  (test "(list int) accepts an empty list"
    (assert= (c-sum-list nil) 0))
  (test "(vector string) accepts a vector of strings"
    (assert= (c-first-vec ["a" "b"]) "a"))
  (test "(vector string) rejects a vector containing a non-string"
    (assert-error (c-first-vec [1 "b"]))))

;; --- (set E) and (seqable E) ---------------------------------------------------
;; `(set E)` had NO arm in `type-matches?` until 2026-09-17: the grammar has accepted it
;; since element types shipped, so a declared `(set int)` fell through to "unknown
;; compound → accept" and the contract checked nothing at all. `(seqable E)` is new with
;; ADR-365 and must not repeat it — a grammar the checker enforces and the contract does
;; not is the trusted-declaration problem (A5) with extra steps.

(defn c-set-size (s) (count s))
(sig! c-set-size ((set int) -> int))

(defn c-seq-count (xs) (count xs))
(sig! c-seq-count ((seqable number) -> int))

(describe "(set E) and (seqable E) contracts"
  (test "(set int) accepts a set of ints"
    (assert= (c-set-size #{1 2 3}) 3))
  (test "(set int) rejects a set holding a non-int"
    (assert-error (c-set-size #{1 "two"})))
  (test "(set int) rejects a value that is not a set at all"
    (assert-error (c-set-size [1 2])))
  ;; `(seqable E)` is every SHAPE a sequence comes in — and the empty list, which `nil` is.
  (test "(seqable number) accepts each sequence shape"
    (assert= (c-seq-count [1 2]) 2)
    (assert= (c-seq-count (list 1 2 3)) 3)
    (assert= (c-seq-count #{1 2}) 2)
    (assert= (c-seq-count nil) 0))
  (test "(seqable number) rejects a sequence holding something else"
    (assert-error (c-seq-count ["a"])))
  ;; …and the two members of bare `seqable` it deliberately excludes. The contract must
  ;; agree with the checker here or one declaration means two things.
  (test "(seqable number) rejects a map and a bytes — their elements are not the element"
    (assert-error (c-seq-count {:a 1}))
    (assert-error (c-seq-count (bytes [1 2])))))

;; --- keyword-literal (singleton) types ----------------------------------------
;; A bare keyword in a sig is a *literal* type — the value must be exactly that
;; keyword. `(or :a :b …)` enumerates the allowed values (set-theoretic literals).

;; `nil` is the "off" alternative — the lattice and type-matches? both already
;; handle the nil literal, so an enumerated keyword set mixes cleanly with it.
;; (Bool/string literals are still a deferred slice; `false` is NOT a literal
;; type. Int literals shipped — see the next section below.)
(defn c-mode (m) m)
(sig! c-mode ((or :maximized :fullboth :fullscreen nil) -> any))

(defn c-exact (k) k)
(sig! c-exact (:ok -> :ok))

(describe "keyword-literal type contracts"
  (test "an enumerated value passes"
    (assert= (c-mode :maximized) :maximized)
    (assert= (c-mode :fullboth) :fullboth)
    (assert= (c-mode nil) nil))
  (test "a keyword outside the set throws"
    (assert-error (c-mode :bogus)))
  (test "a non-keyword outside the set throws"
    (assert-error (c-mode 42)))
  (test "a single keyword literal matches only that exact value"
    (assert= (c-exact :ok) :ok)
    (assert-error (c-exact :nope))))

;; --- int-literal (singleton) types (ADR-117) ------------------------------------
;; A bare int in a sig is likewise a *literal* type — the value must be exactly
;; that int. `(or 200 404 500)` enumerates the allowed values, same machinery as
;; the keyword-literal case above (an independent tag, so the two compose freely
;; — e.g. `(or :ok 5)` — though that's not exercised by a dedicated contract here).

(defn c-status (s) s)
(sig! c-status ((or 200 404 500) -> any))

(defn c-exact-int (n) n)
(sig! c-exact-int (5 -> 5))

(describe "int-literal type contracts"
  (test "an enumerated value passes"
    (assert= (c-status 200) 200)
    (assert= (c-status 404) 404))
  (test "an int outside the set throws"
    (assert-error (c-status 999)))
  (test "a non-int outside the set throws"
    (assert-error (c-status "200")))
  (test "a single int literal matches only that exact value"
    (assert= (c-exact-int 5) 5)
    (assert-error (c-exact-int 6))))

;; --- bool/string-literal (singleton) types (ADR-120) ----------------------------
;; Same machinery again, two more kinds. `false` is a legitimate literal type now
;; (the keyword-era "false isn't a literal type" guidance was scoped to avoiding
;; `false`/`nil` confusion in an *enumerated keyword* set, not a blanket rule).

(defn c-flag (b) b)
(sig! c-flag (false -> any))

(defn c-method (m) m)
(sig! c-method ((or "GET" "POST") -> any))

(describe "bool/string-literal type contracts"
  (test "the exact bool literal passes"
    (assert= (c-flag false) false))
  (test "the other bool value throws"
    (assert-error (c-flag true)))
  (test "a non-bool throws"
    (assert-error (c-flag 1)))
  (test "an enumerated string value passes"
    (assert= (c-method "GET") "GET")
    (assert= (c-method "POST") "POST"))
  (test "a string outside the set throws"
    (assert-error (c-method "DELETE")))
  (test "a non-string throws"
    (assert-error (c-method :get))))

;; --- rest params in sig! -------------------------------------------------------

(defn c-sum (& xs) (reduce xs 0 +))
(sig! c-sum (& int -> int))

(defn c-join-strs (sep & parts) (string/join parts sep))
(sig! c-join-strs (string & string -> string))

(describe "rest param contracts (sig! with &)"
  (test "pure variadic: correct rest args pass"
    (assert= (c-sum 1 2 3 4) 10))
  (test "pure variadic: a non-int rest arg throws"
    (assert-error (c-sum 1 2 "oops")))
  (test "pure variadic: zero rest args pass"
    (assert= (c-sum) 0))
  (test "fixed + rest: correct args pass"
    (assert= (c-join-strs ", " "a" "b" "c") "a, b, c"))
  (test "fixed + rest: bad fixed arg throws"
    (assert-error (c-join-strs 42 "a" "b")))
  (test "fixed + rest: bad rest arg throws"
    (assert-error (c-join-strs ", " "a" 99 "c"))))

;; --- intersection types (and A B …) --------------------------------------------

(defn c-head (xs) (first xs))
(sig! c-head ((and pair (list int)) -> int))

(defn c-never (x) x)
; NEVER — nothing satisfies both
(sig! c-never ((and int string) -> int))
(describe "intersection type checks (and)"
  (test "(and pair (list int)) accepts a non-empty list of ints"
    (assert= (c-head (list 1 2 3)) 1))
  (test "(and pair (list int)) rejects nil (not pair?)"
    (assert-error (c-head nil)))
  (test "(and pair (list int)) rejects a list with a non-int element"
    (assert-error (c-head (list "a" "b"))))
  (test "(and int string) is NEVER — even an int is rejected"
    (assert-error (c-never 1)))
  (test "(and int string) is NEVER — even a string is rejected"
    (assert-error (c-never "a"))))

;; --- map key/value types (map K V) ---------------------------------------------

(defn c-lookup (m k) (get m k 0))
(sig! c-lookup ((map keyword int) keyword -> int))

(describe "map key/value type checks (map K V)"
  (test "(map keyword int) accepts a keyword-int map"
    (assert= (c-lookup {:a 1 :b 2} :a) 1))
  (test "(map keyword int) rejects a map with a string key"
    (assert-error (c-lookup {"a" 1} :a)))
  (test "(map keyword int) rejects a map with a non-int value"
    (assert-error (c-lookup {:a "one"} :a)))
  (test "(map keyword int) rejects a non-map argument"
    (assert-error (c-lookup (list 1 2) :a)))
  (test "(map keyword int) accepts an empty map"
    (assert= (c-lookup {} :x) 0)))

;; --- record/shape types (record :k T …) -----------------------------------------
;; Heterogeneous, keyword-keyed map shapes — per-key types with required/optional
;; presence, distinct from the uniform-K/V `(map K V)` above. The runtime `sig!`
;; contract enforces every field (docs/type-records.md). The static checker now
;; arg-checks a `(record …)` param too; the calls below live inside
;; `test`/`assert-error` thunks the checker walks opaquely, so the deliberately-wrong
;; ones don't draw a static warning regardless.
;;
;; A record is **CLOSED** unless it says `&open` (ADR-264): an undeclared key must be
;; absent. Both shapes are exercised here, because the runtime contract and the checker
;; have to agree about which one a declaration means.

(defn c-user (m) m)
(sig! c-user ((record :name string :age (optional int)) -> any))

(defn c-user-open (m) m)
(sig! c-user-open ((record &open :name string :age (optional int)) -> any))

(describe "record type checks (record …)"
  (test "a required field present and correctly typed passes"
    (assert= (c-user {:name "Ada"}) {:name "Ada"}))
  (test "a required field missing throws"
    (assert-error (c-user {:age 30})))
  (test "a required field with the wrong type throws"
    (assert-error (c-user {:name 42})))
  (test "an optional field absent passes"
    (assert= (c-user {:name "Ada"}) {:name "Ada"}))
  (test "an optional field present as nil passes"
    (assert= (c-user {:name "Ada" :age nil}) {:name "Ada" :age nil}))
  (test "an optional field present with the wrong (non-nil) type throws"
    (assert-error (c-user {:name "Ada" :age "old"})))
  (test "an extra, undeclared key throws — a record is closed"
    (assert-error (c-user {:name "Ada" :age 30 :extra :k})))
  (test "…and passes under `&open`, which is what open means"
    (assert= (c-user-open {:name "Ada" :age 30 :extra :k})
      {:name "Ada" :age 30 :extra :k}))
  (test "`&open` still enforces the fields it declares"
    (assert-error (c-user-open {:age 30}))
    (assert-error (c-user-open {:name 42})))
  (test "a non-map argument throws"
    (assert-error (c-user (list 1 2)))))

;; --- type variables (?A) --------------------------------------------------------
;; Type variables are static-only constraints — `?A` is unknown to `type-matches?`
;; so it accepts any value (correct: the static checker handles the precision).
;; The sig! wrapper still enforces the non-variable parts (base types, shape).

(defn c-identity (x) x)
(sig! c-identity (?A -> ?A))

(defn c-my-first (xs) (first xs))
(sig! c-my-first ((list ?A) -> ?A))

(defn c-const (x y) x)
(sig! c-const (?A ?B -> ?A))

(describe "type variable annotations (?A)"
  (test "identity with ?A accepts an int"
    (assert= (c-identity 42) 42))
  (test "identity with ?A accepts a string"
    (assert= (c-identity "hi") "hi"))
  (test "identity with ?A accepts nil"
    (assert= (c-identity nil) nil))
  (test "(list ?A) accepts a list of ints"
    (assert= (c-my-first (list 1 2 3)) 1))
  (test "(list ?A) accepts a list of strings"
    (assert= (c-my-first (list "a" "b")) "a"))
  (test "(list ?A) still rejects a non-list"
    (assert-error (c-my-first 42)))
  (test "two vars ?A and ?B independently accept any types"
    (assert= (c-const 1 "two") 1)))

;; --- tuple (positional vector) types (ADR-128) ----------------------------------

(defn c-pair (t) t)
(sig! c-pair ((tuple int string) -> any))

(defn c-empty (t) t)
(sig! c-empty ((tuple) -> any))

(describe "tuple type contracts"
  (test "a matching vector passes"
    (assert= (c-pair [1 "x"]) [1 "x"]))
  (test "a wrong-position type throws"
    (assert-error (c-pair ["x" 1])))
  (test "the wrong arity throws"
    (assert-error (c-pair [1 "x" true])))
  (test "a non-vector throws"
    (assert-error (c-pair (list 1 "x"))))
  (test "the empty tuple accepts only the empty vector"
    (assert= (c-empty []) [])
    (assert-error (c-empty [1]))))

;; `(list T U …)` with two or more types is the positional LIST shape — what the checker
;; reads `(list a b)` as — and the contract means the same: exact arity, each position.
(defn c-two (l) l)
(sig! c-two ((list int string) -> any))
(defn c-uniform (l) l)
(sig! c-uniform ((list int) -> any))

(describe "list shape contracts"
  (test "a matching two-element list passes"
    (assert= (c-two (list 1 "x")) (list 1 "x")))
  (test "a wrong-position type throws"
    (check-allow :type-mismatch (assert-error (c-two (list "x" 1)))))
  (test "the wrong arity throws"
    (check-allow :type-mismatch (assert-error (c-two (list 1 "x" true)))))
  (test "a vector is not a list"
    (check-allow :type-mismatch (assert-error (c-two [1 "x"]))))
  (test "one type is still the uniform list, any length"
    (assert= (c-uniform (list 1 2 3)) (list 1 2 3))
    (assert= (c-uniform nil) nil)
    (check-allow :type-mismatch (assert-error (c-uniform (list 1 "x"))))))

;; --- intervals and lengths (ADR-350) --------------------------------------------
;; The grammar could say `(int 0 _)` and `(len (list E) 1 _)` since 2026-09-14 and the
;; contract checked the tag alone: a declaration the checker trusted could lie at run
;; time. Since 2026-09-17 the bound is checked too — `nil` counts 0, `_` is an open end.
(defn c-byte (n) n)
(sig! c-byte ((int 0 255) -> any))
(defn c-non-neg (n) n)
(sig! c-non-neg ((int 0 _) -> any))
(defn c-non-empty (xs) xs)
(sig! c-non-empty ((len (list int) 1 _) -> any))
(defn c-short (s) s)
(sig! c-short ((len string _ 3) -> any))
(defn c-pair-len (v) v)
(sig! c-pair-len ((len (vector any) 2 2) -> any))

(describe "interval and length contracts"
  (test "an int inside its interval passes, outside it throws"
    (assert= (c-byte 0) 0)
    (assert= (c-byte 255) 255)
    (check-allow :type-mismatch (assert-error (c-byte 256)))
    (check-allow :type-mismatch (assert-error (c-byte -1)))
    (check-allow :type-mismatch (assert-error (c-byte 1.5))))
  (test "an open end is unbounded on that side"
    (assert= (c-non-neg 1000000) 1000000)
    (check-allow :type-mismatch (assert-error (c-non-neg -1))))
  (test "a length bound reads the count, and nil counts 0"
    (assert= (c-non-empty (list 1)) (list 1))
    (check-allow :type-mismatch (assert-error (c-non-empty nil)))
    (check-allow :type-mismatch (assert-error (c-non-empty (list "x")))))
  (test "a string and a vector are counted too, and a non-countable never fits"
    (assert= (c-short "abc") "abc")
    (check-allow :type-mismatch (assert-error (c-short "abcd")))
    (assert= (c-pair-len [1 2]) [1 2])
    (check-allow :type-mismatch (assert-error (c-pair-len [1])))
    (check-allow :type-mismatch (assert-error (c-pair-len 5)))))

;; --- recursive types (ADR-349) ---------------------------------------------------
;; `type-matches?` had no `rec` case, so a `sig!` over `(rec X …)` accepted any compound.
;; The body is now matched with `X` standing for the whole, one level per level of the
;; value; an inner `(rec X …)` closes its own name.
(defn c-json (v) v)
(sig! c-json ((rec json (or nil bool number string (vector json) (map string json))) -> any))
(defn c-nested-rec (v) v)
(sig! c-nested-rec
  ((rec outer (or int (vector (rec inner (or string (vector inner)))) (vector outer))) -> any))

(describe "recursive type contracts"
  (test "a value that nests itself passes at every depth"
    (assert= (c-json 1) 1)
    (assert= (c-json [1 "a" [true nil]]) [1 "a" [true nil]])
    (assert= (c-json {"k" [1 {"n" nil}]}) {"k" [1 {"n" nil}]}))
  (test "a wrong leaf deep inside throws"
    (check-allow :type-mismatch (assert-error (c-json [1 [2 [:kw]]])))
    (check-allow :type-mismatch (assert-error (c-json {"k" [1 {"n" 'sym}]})))
    (check-allow :type-mismatch (assert-error (c-json {:kw 1}))))
  (test "an inner binder closes its own name"
    (assert= (c-nested-rec [1 [2]]) [1 [2]])
    (assert= (c-nested-rec [["a" ["b"]]]) [["a" ["b"]]])
    ;; inside `inner`, `inner` is strings and vectors of them — never an int
    (check-allow :type-mismatch (assert-error (c-nested-rec [["a" [1]]])))))

;; --- the complement `(not T)` (ADR-263) -----------------------------------------
;; The lattice has computed complements since ADR-023 — the else-branch of a type
;; guard is one — but the grammar could not say one, so "anything but nil" could
;; not be written down. The runtime `type-matches?` implements the same clause, so
;; a `sig!` contract and the checker agree on what a complement admits.

(defn c-not-nil (x) x)
(sig! c-not-nil ((not nil) -> any))

(defn c-int-not-five (n) n)
(sig! c-int-not-five ((and int (not 5)) -> any))

(describe "complement type contracts"
  (test "a complement admits everything outside the negated set"
    (assert= (c-not-nil 1) 1)
    (assert= (c-not-nil "s") "s")
    (assert= (c-not-nil false) false))
  (test "a complement rejects a member of the negated set"
    (assert-error (c-not-nil nil)))
  (test "a complement composes with an intersection"
    (assert= (c-int-not-five 4) 4)
    (assert-error (c-int-not-five 5))
    (assert-error (c-int-not-five "x"))))

;; Stability metadata (ADR-283). The definitions and their `(meta …)` live at TOP LEVEL,
;; beside each other, exactly as `(sig …)` does — and for the same reason: both are
;; annotations on a definition, and `meta` resolves its name to the current namespace the
;; way a `def` head is resolved. Written inside a function body the two can disagree about
;; which namespace is current, so the annotation would key off a different symbol than the
;; definition it annotates.
(defn m-since (s) s)
(meta m-since :since "0.9.0")

(defn m-new (s) s)
(defn m-old (s) s)
(meta m-old :deprecated "0.14.0" :use 'm-new)

(defn m-wobbly (s) s)
(meta m-wobbly :beta "the options map may still change")

(defn m-old2 (s) s)
(meta m-old2 :deprecated "0.14.0")

(defn- stability-messages (src)
  "The stability diagnostics the checker reports for `src`."
  (seq/filter (map (reflect/check-string-structured src) (fn (d) (get d :message)))
    (fn (m) (or (includes? m "is deprecated") (includes? m "is beta")))))

(describe "stability metadata (meta …)"

  (test "`:since` records, and is documentation only — nothing warns"
    ;; QUALIFIED: `%meta-of` resolves its argument to the *current* namespace, which
    ;; inside a test body is not the defining module's.
    (assert= "0.9.0" (get (%meta-of 'contract-test/m-since) :since))
    (assert= []
      (apply vector
        (stability-messages "(defn u () (contract-test/m-since 1))"))))

  (test "`:deprecated` warns at each use and names the replacement"
    (let (msgs (stability-messages "(defn u (s) (contract-test/m-old s))"))
      (assert= true
        (any? msgs (fn (m) (and (includes? m "is deprecated since 0.14.0") (includes? m "m-new")))))))

  (test "a deprecation is ADVISORY — it prints, it does not gate the build"
    ;; The point of a deprecation is to say "this is going away" while the code still
    ;; works. One that fails CI is a removal with extra steps.
    (assert= true
      (project-check/project-advisory-warning? "f.blsp:1:1: warning: `x` is deprecated since 0.14.0 — use `y` instead"))
    (assert= false
      (project-check/project-advisory-warning? "f.blsp:1:1: warning: unbound symbol: zz")))

  (test "a cap the checker hit is reported but never gates (B6)"
    ;; The checker's four budgets (fixpoint rounds, specialization fuel, expression
    ;; depth) decline soundly — the affected answers read as unknown — and the file
    ;; says so with a `checker gave up:` note. It has to be VISIBLE (a file the checker
    ;; largely gave up on must not read as checked) and it must not fail the build,
    ;; because the commonest cause is inherent: a file that defines and uses its own
    ;; macro.
    (assert= true
      (project-check/project-advisory-warning? "f.blsp: note: checker gave up: an unexpanded macro call keeps every caller-derived parameter unknown in this file")))

  (test "`:beta` warns with its reason"
    (let (msgs (stability-messages "(defn u (s) (contract-test/m-wobbly s))"))
      (assert= true
        (any? msgs (fn (m) (includes? m "is beta — the options map may still change"))))))

  (test "`(check-allow :deprecated …)` silences a deliberate use"
    ;; A library calls its own deprecated name from the shim that replaces it.
    (assert= []
      (apply vector
        (stability-messages "(defn u (s) (check-allow :deprecated (contract-test/m-old2 s)))")))))

;; The first prelude name to carry a deprecation, and the reason the machinery above exists
;; on a real surface rather than only on this file's fixtures. `not=` buys a spelling, not a
;; capability — its body IS `(not (= a b))` — so it is on the way out; see the note beside
;; the definition in `std/prelude/core.blsp` for the two measurements and the variadic trap.
;; A bare prelude name needs no qualification here: `%meta-of` resolves against the COMPILE
;; namespace, which is absent at runtime, unlike the module-defined fixtures above.
(describe "not= is deprecated"

  (test "the metadata is recorded, and names the replacement"
    (assert= "0.19.1" (get (%meta-of 'not=) :deprecated))
    (assert= 'not (get (%meta-of 'not=) :use)))

  (test "a use is diagnosed, pointing at `not`"
    (let (msgs (stability-messages "(defn u (a b) (not= a b))"))
      (assert= true
        (any? msgs
          (fn (m)
            (and (includes? m "`not=` is deprecated since 0.19.1")
              (includes? m "use `not` instead")))))))

  (test "it still WORKS — a deprecation is not a removal"
    ;; `check-allow` because this file is checked at zero warnings like every other, and
    ;; the whole point of the test is to call the name we are telling everyone not to call.
    (check-allow :deprecated
      (do
        (assert= true (not= 1 2))
        (assert= false (not= 1 1))
        ;; The trap the deprecation note names: this reads "pairwise different" and is
        ;; the negation of the whole `=` chain.
        (assert= true (not= 1 2 1))
        (assert= (not (= 1 2)) (not= 1 2))))))
