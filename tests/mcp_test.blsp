;; `(:load mcp)`: the module under test loads at THIS file's load, not at the first
;; `mcp/…` call (ADR-335). The watch-runtime tests arm a monitor and read a 300 ms window;
;; with the load happening inside that first call, the helper's burst — 20 ms after the
;; spawn — had come and gone before the monitor existed, under the tree-walker from source
;; (the load is slow there), and the window collected nothing (CI's differential job).
(defmodule mcp-test
  (:use test)
  (:load mcp)
  (:use-internals mcp))

;; The `reflect/eval` MCP tool must evaluate *every* form in a multi-form `:source` and
;; return the last value — not silently drop everything after the first form (the
;; old `reflect/read-first` behaviour, which made a pasted batch of `defn`s run only the
;; first). See docs/devlog.md and the brood-life feedback triage.
(describe "mcp eval tool"
  ;; `:isolated`: the source defines `mcpt-a`/`mcpt-b` at root through the tool, and a test
  ;; that leaves globals behind is visible to every later file in an unscoped run —
  ;; `audit_test` read them as two undocumented public names whenever the two files were
  ;; named together (`nest test FILE…` loads the named files into one image).
  :isolated (test "runs every form in a multi-form source, returns the last value"
    (assert= {:value "21"}
      (mcp/eval-tool {:source "(defn mcpt-a (x) (* x 2)) (defn mcpt-b (x) (+ x 1)) (mcpt-b (mcpt-a 10))"})))
  (test "a def and its use in the same batch both take effect"
    (assert= {:value "42"} (mcp/eval-tool {:source "(def mcpt-q 41) (+ mcpt-q 1)"})))
  (test "a single form still works"
    (assert= {:value "5"} (mcp/eval-tool {:source "(+ 2 3)"})))
  (test "a non-string :source is rejected (thrown for the dispatcher to catch)"
    (assert-error (mcp/eval-tool {:source 42})))
  (test "a parse error surfaces as :error, not a drop"
    (is (contains? (mcp/eval-tool {:source "(+ 1"}) :error)))
  (test "a value the source throws comes back with where it was raised"
    (let (error (get (mcp/eval-tool {:source "(+ 1\n  (throw :mcpt-thrown))"}) :error))
      (assert= (get error :kind) :user)
      (assert= (get error :payload) :mcpt-thrown)
      (assert= (get error :line) 2))))

;; The LLM-native tools error and find-pattern (thin wrappers over
;; std/tool/explain.blsp — 2026-07-23).
(describe "mcp error / find-pattern tools"
  (test "error returns the structured explanation for a code"
    (let (r (mcp/explain-error-tool {:code "E0044"}))
      (assert= (get r :code) "E0044")
      (is (includes? (get r :fix) "tail-recursive"))))
  (test "error rejects a non-string :code"
    (assert-error (mcp/explain-error-tool {:code 44})))
  (test "find-pattern returns idiom matches for an intent"
    (let (r (mcp/find-pattern-tool {:query "build a string"}))
      (is (> (count (get r :matches)) 0))
      (is (any? (get r :matches) (fn (e) (includes? (get e :idiom) "iolist"))))))
  (test "find-pattern rejects a non-string :query"
    (assert-error (mcp/find-pattern-tool {:query 1})))
  (test "both tools are in the catalogue"
    (let (names (map (mcp/tools) (fn (t) (get t :name))))
      (is (includes? names "error"))
      (is (includes? names "find-pattern")))))

;; watch-runtime — the runtime-event STREAM tool (a trace, not a snapshot;
;; 2026-07-24). It arms a system-monitor subscription on the handler process, so :isolated
;; (runs alone — no cross-talk with other tests' spawns/GCs).
(defn mcpt-burst (n) (when (> n 0) (spawn (+ 1 1)) (mcpt-burst (- n 1))))

;; Small bursts `gap` ms apart UNTIL TOLD TO STOP, so the watcher's window holds events
;; whenever its subscription opens. A single burst 5 ms after the spawn came and went before
;; a loaded CI runner scheduled the watcher (KI-155), and a fixed ~500 ms spread only moved
;; the deadline; a helper that runs until the window has closed has none. What is left for a
;; `count 0` to mean is an event the system monitor lost — a real bug, not a slow runner.
(defn mcpt-until-stopped (gap)
  (mcpt-burst 3)
  (receive (:stop nil) (after gap (mcpt-until-stopped gap))))

;; Run `watch` (a thunk) with the burst helper going for its whole duration.
(defn mcpt-watching (watch)
  (let (helper (spawn (mcpt-until-stopped 25))
        r (watch))
    (send helper :stop)
    r))

(describe "mcp watch-runtime tool"
  :isolated (test "collects spawn/exit runtime events over a window"
    ;; a burst of trivial short-lived processes, from a helper process (so the
    ;; watcher — this test process — sees their :spawn/:exit, not its own). The window
    ;; is generous: it was 300 ms, and the tree-walker differential job on a loaded
    ;; runner saw the burst land outside it (count 0) — a slow runner, not a lost event.
    (let (r (mcpt-watching (fn () (mcp/watch-runtime-tool {:ms 1500})))
          evs (get r :events)
          kinds (map evs (fn (e) (get e :kind))))
      (is (> (get r :count) 0))
      (is (includes? kinds :spawn))
      (is (includes? kinds :exit))
      ;; every event carries the documented shape
      (is (every? evs (fn (e) (and (contains? e :kind) (contains? e :pid) (contains? e :detail)))))))
  (test "the :filter selects only the requested kinds"
    (let (r (mcpt-watching (fn () (mcp/watch-runtime-tool {:ms 1500 :filter {:exit true}})))
          evs (get r :events))
      (is (> (count evs) 0))
      (is (every? evs (fn (e) (= (get e :kind) :exit))))))
  (test "the tool is in the catalogue"
    (is (includes? (map (mcp/tools) (fn (t) (get t :name))) "watch-runtime"))))

;; Ability/record introspection + snippet type-check + lookup :type (2026-07-30).
(describe "mcp ability introspection tools"
  (test "abilities lists the core abilities"
    (is (includes? (get (mcp/abilities-tool {}) :abilities) "Display")))
  :isolated (test "ability describes ops, sealed members, requires, and impls"
    (mcp/eval-tool {:source "(defrecord mcpt-circle (r)) (defability McptShape :sealed [mcpt-circle] (mcpt-area (self) :-> float) (mcpt-big? (self o) :-> bool (> (mcpt-area self) 0))) (impl McptShape mcpt-circle (mcpt-area (c) 1.0))"})
    (let (r (mcp/ability-tool {:name "McptShape"}))
      (assert= (get r :sealed) true)
      (is (includes? (get r :members) "mcpt-circle"))
      (is (includes? (get r :impls) "mcpt-circle"))
      (assert= (count (get r :ops)) 2)
      ;; the provided op carries :provided true; the required one false
      (let (provided (seq/filter (get r :ops) (fn (o) (get o :provided))))
        (assert= (count provided) 1))))
  (test "an unknown ability name returns an :error map, not a throw"
    (is (contains? (mcp/ability-tool {:name "NoSuchAbilityXyz"}) :error))))

(describe "mcp check-source tool"
  (test "flags a type error in a snippet"
    (is (not (empty? (get (mcp/check-source-tool {:source "(defn f (x) (count 5))"}) :diagnostics)))))
  (test "is clean for well-typed code"
    (assert= {:diagnostics []} (mcp/check-source-tool {:source "(+ 1 2)"})))
  (test "a non-string :source is rejected"
    (assert-error (mcp/check-source-tool {:source 42}))))

(describe "mcp lookup carries the checker type"
  (test "lookup includes a :type signature string"
    (is (string? (get (mcp/lookup-tool {:name "count"}) :type)))))

;; ---- the server: JSON-RPC dispatch (`handle`/`respond`), driven in-image ----------
;;
;; The transport (stdin/stdout framing) is exercised end to end against the binary by
;; `crates/nest/tests/mcp.rs`; these cases drive the dispatcher with a catalogue and an
;; emitter of their own.

(defn mcpt-spin () (mcpt-spin))

(defn mcpt-raise (x)
  "Throw a bare string through a non-tail call, so the raise has a frame to trace."
  (+ 1 (throw (str "deep: " x))))

(def mcpt-catalogue
  (list {:name "double"
         :description "Double :n"
         :schema {:type "object" :properties {:n {:type "integer"}}}
         :handler (fn (args) (* (get args :n) 2))}
    {:name "chatty" :schema {:type "object"} :handler (fn (_args) (io/write "debug line") 42)}
    {:name "text" :schema {:type "object"} :handler (fn (_args) "plain")}
    {:name "soft-fail" :schema {:type "object"} :handler (fn (_args) {:error "nope"})}
    {:name "throws" :schema {:type "object"} :handler (fn (_args) (throw "throws: bad input"))}
    {:name "throws-deep" :schema {:type "object"} :handler (fn (_args) (+ 1 (mcpt-raise 1)))}
    {:name "divides" :schema {:type "object"} :handler (fn (_args) (/ 1 0))}
    {:name "dies"
     :schema {:type "object"}
     :handler (fn (_args) (exit (self) :kill) (receive (after 5000 nil)))}
    {:name "closure" :schema {:type "object"} :handler (fn (_args) (fn () 1))}
    {:name "shapes" :schema {:type "object"} :handler (fn (args) (list? (get args :items)))}
    {:name "eval" :schema {:type "object"} :handler (fn (_args) (mcpt-spin))}
    {:name "reports"
     :schema {:type "object"}
     :handler (fn (_args) (mcp/progress 1 3 "step-one"))}
    {:name "checks"
     :schema {:type "object"}
     :handler (fn (args) (count (project-check/check-structured (get args :root))))}
    {:description "no name, so not listed" :schema {}}
    {:name "no-schema"}))

(defn mcpt-session ()
  (let (me (self))
    {:catalogue (fn () mcpt-catalogue)
     :emit (fn (message) (send me [:mcpt-emitted message]))
     :deadline-ms 300}))

(defn mcpt-object (value)
  "`value`, which the test expects to be a map (a reply, a JSON object); an error otherwise
— `mcp/handle` also answers `:exit` and nil, which no test reading a reply expects."
  (if (map? value) value (error "mcp-test: expected a map, got " (pr-str value))))
(sig mcpt-object (any -> map))

(defn mcpt-request (method params)
  (mcpt-object (mcp/handle {:jsonrpc "2.0" :id 1 :method method :params params} (mcpt-session))))

(defn mcpt-call (name arguments)
  (mcpt-request "tools/call" {:name name :arguments arguments}))

(defn mcpt-emitted (acc)
  (receive ([:mcpt-emitted m] (mcpt-emitted (conj acc m))) (after 0 acc)))

(describe "mcp server lifecycle"
  (test "initialize names the server and its capabilities"
    (let (result (get (mcpt-request "initialize" {}) :result))
      (assert= (map/get-in result [:serverInfo :name]) "nest-mcp")
      (assert= (get result :capabilities) {:tools {} :resources {} :prompts {}})))
  (test "a request echoes its id under jsonrpc 2.0"
    (let (reply (mcp/handle {:jsonrpc "2.0" :id "abc" :method "ping"} (mcpt-session)))
      (assert= reply {:jsonrpc "2.0" :id "abc" :result {}})))
  (test "shutdown answers null"
    (assert= (get (mcpt-request "shutdown" {}) :result) nil)
    (is (contains? (mcpt-request "shutdown" {}) :result)))
  (test "an unknown method is -32601; an unknown notification gets no reply"
    (assert= (map/get-in (mcpt-request "no/such/method" {}) [:error :code]) -32601)
    (assert= (mcp/handle {:jsonrpc "2.0" :method "bogus/notification"} (mcpt-session)) nil))
  (test "exit (a notification) ends the session"
    (assert= (mcp/handle {:jsonrpc "2.0" :method "exit"} (mcpt-session)) :exit))
  (test "a line that is not JSON is a -32700 with a null id, not the end of the session"
    (let (reply (mcpt-object (mcp/respond "this is not json{{{" (mcpt-session))))
      (assert= (map/get-in reply [:error :code]) -32700)
      (is (contains? reply :id))
      (assert= (get reply :id) nil)
      (is (string? (map/get-in reply [:error :data]))))
    (assert= (get (mcpt-object (mcp/respond "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\"}"
                                 (mcpt-session)))
               :result)
      {})))

(describe "mcp tools/list and tools/call"
  (test "tools/list projects the catalogue, skipping malformed entries"
    (let (tools (map/get-in (mcpt-request "tools/list" {}) [:result :tools])
          names (map tools (fn (t) (get t :name))))
      (is (includes? names "double"))
      (refute (includes? names "no-schema"))
      (assert= (count tools) 13)
      (assert= (first tools)
        {:name "double"
         :description "Double :n"
         :inputSchema {"type" "object" "properties" {"n" {"type" "integer"}}}})))
  (test "the std catalogue lists every tool with an object schema"
    (let (tools (map/get-in (mcp/handle {:jsonrpc "2.0" :id 1 :method "tools/list"}
                              (assoc (mcpt-session) :catalogue (fn () (mcp/tools))))
                  [:result :tools])
          names (map tools (fn (t) (get t :name))))
      (doseq (expected ["eval"
                         "load" "write" "edit" "lookup" "macroexpand" "format" "check" "run-tests"
                         "processes" "process-info" "node" "callers"])
        (is (includes? names expected)))
      (is (every? tools (fn (t) (= (map/get-in t [:inputSchema "type"]) "object"))))))
  (test "a handler's value comes back as indented JSON text"
    (assert= (map/get-in (mcpt-call "double" {:n 21}) [:result :content])
      [{:type "text" :text "42"}])
    (assert= (map/get-in (mcpt-call "text" {}) [:result :content 0 :text]) "plain"))
  (test "what a handler prints rides back as a second block, never on the channel"
    (assert= (map/get-in (mcpt-call "chatty" {}) [:result :content])
      [{:type "text" :text "42"} {:type "text" :text "[captured stdout]\ndebug line"}]))
  (test "a map with a non-null error is a soft failure"
    (let (result (get (mcpt-call "soft-fail" {}) :result))
      (assert= (get result :isError) true)
      (assert= (map/get-in result [:content 0 :text]) "{\n  \"error\": \"nope\"\n}")))
  (test "arguments arrive keyword-keyed, with arrays as lists"
    (assert= (map/get-in (mcpt-call "shapes" {:items [1 2]}) [:result :content 0 :text]) "true"))
  (test "an unknown tool is -32602"
    (let (error (get (mcpt-call "nope" {}) :error))
      (assert= (get error :code) -32602)
      (is (string/starts-with? (get error :message) "no such tool"))))
  (test "a thrown value is a -32603 whose data is :user, with where it was raised"
    (let (error (get (mcpt-call "throws" {}) :error)
          data (get error :data))
      (assert= (get error :code) -32603)
      (assert= (get error :message) "error: throws: bad input")
      (assert= (get data "kind") "user")
      (assert= (get data "message") "throws: bad input")
      (is (string/ends-with? (get data "file") "mcp_test.blsp"))
      (is (int? (get data "line")))
      (is (int? (get data "col")))))
  (test "a value thrown below the handler carries the trace through it"
    (let (data (map/get-in (mcpt-call "throws-deep" {}) [:error :data]))
      (assert= (get data "kind") "user")
      (is (int? (get data "line")))
      (is (any? (or (get data "trace") ())
            (fn (frame) (string/ends-with? (or (get frame "fn") "") "mcpt-raise"))))))
  (test "a kernel error travels whole in the error data"
    (let (error (get (mcpt-call "divides" {}) :error))
      (assert= (get error :code) -32603)
      (assert= (map/get-in error [:data "kind"]) "runtime")
      (assert= (map/get-in error [:data "code"]) "E0040")
      (is (includes? (map/get-in error [:data "message"]) "division by zero"))))
  (test "a result with no JSON shape is a -32603"
    (let (error (get (mcpt-call "closure" {}) :error))
      (assert= (get error :code) -32603)
      (is (includes? (get error :message) "no JSON representation"))))
  (test "a handler process that dies is an error reply, and the next call is served"
    (let (error (get (mcpt-call "dies" {}) :error))
      (assert= (get error :code) -32603)
      (assert= (map/get-in error [:data "kind"]) "panic"))
    (assert= (map/get-in (mcpt-call "double" {:n 1}) [:result :content 0 :text]) "2"))
  (test "an eval past the deadline is killed and answered, not waited on"
    (let (result (get (mcpt-call "eval" {}) :result))
      (assert= (get result :isError) true)
      (is (includes? (map/get-in result [:content 0 :text]) "time limit"))))
  (test "a progressToken streams the handler's reports as notifications"
    (let (reply (mcpt-request "tools/call"
                  {:name "reports" :arguments {} :_meta {:progressToken "tok-42"}})
          emitted (mcpt-emitted []))
      (assert= (map/get-in reply [:result :content 0 :text]) "true")
      (assert= emitted
        [{:jsonrpc "2.0"
          :method "notifications/progress"
          :params {:progressToken "tok-42" :progress 1 :total 3 :message "step-one"}}])))
  ;; The project checker reports each file it checks — through `mcp/progress`, which it
  ;; reaches only when `nest mcp` has loaded this module. `:isolated`: it sets the
  ;; project root globals.
  :isolated (test "a project check under a progressToken reports each checked file"
    (let (root (str "/tmp/mcpt-check-" (rand/token 8)))
      (file/mkdir root)
      (file/mkdir (path/join root "src"))
      (file/spit (path/join root "project.blsp")
        "(project :name \"mcpt\" :source-paths [\"src\"])\n")
      (file/spit (path/join root "src/lib.blsp") "(defmodule lib)\n(defn g () 1)\n")
      (let (reply (mcpt-request "tools/call"
                    {:name "checks" :arguments {:root root} :_meta {:progressToken "tok-7"}})
            emitted (mcpt-emitted []))
        (file/rmdir root)
        (assert= (map/get-in reply [:result :content 0 :text]) "0")
        (assert= emitted
          [{:jsonrpc "2.0"
            :method "notifications/progress"
            :params {:progressToken "tok-7" :progress 1 :total 1 :message "checked lib.blsp"}}]))))
  (test "without a progressToken, progress is a no-op answering false"
    (let (reply (mcpt-call "reports" {}))
      (assert= (map/get-in reply [:result :content 0 :text]) "false")
      (assert= (mcpt-emitted []) []))))

(describe "mcp resources and prompts"
  (test "resources/list names every document"
    (let (uris (map (map/get-in (mcpt-request "resources/list" {}) [:result :resources])
                 (fn (r) (get r :uri))))
      (assert= (sort uris)
        (sort (list "brood://docs/brood-for-claude"
                "brood://docs/language" "brood://docs/decisions" "brood://docs/types"
                "brood://docs/error-codes" "brood://prelude")))))
  (test "resources/read serves the bound document text"
    (binding (mcp/*documents* {"prelude" "(def x 1)"})
      (assert= (map/get-in (mcpt-request "resources/read" {:uri "brood://prelude"})
                 [:result :contents])
        [{:uri "brood://prelude" :mimeType "text/markdown" :text "(def x 1)"}])
      (assert= (map/get-in (mcpt-request "resources/read" {:uri "brood://nope"}) [:error :code])
        -32602)))
  (test "prompts list and serve brood-task, and refuse an unknown name"
    (binding (mcp/*documents* {"brood-task" "orient yourself"})
      (assert= (map (map/get-in (mcpt-request "prompts/list" {}) [:result :prompts])
                 (fn (p) (get p :name)))
        (list "brood-task"))
      (assert= (map/get-in (mcpt-request "prompts/get" {:name "brood-task"})
                 [:result :messages 0 :content :text])
        "orient yourself")
      (assert= (map/get-in (mcpt-request "prompts/get" {:name "nope"}) [:error :code]) -32602))))

(describe "mcp JSON projection"
  (test "data kinds project onto JSON"
    (assert= (mcp-server/json-data {:n 42
                                    :f 1.5
                                    :s "hello"
                                    :items (list 1 2 3)
                                    :nested {:k "v"}
                                    :flag true
                                    :absent nil})
      {"n" 42 "f" 1.5 "s" "hello" "items" [1 2 3] "nested" {"k" "v"} "flag" true "absent" nil})
    (assert= (mcp-server/json-data [:kw 'sym #{1}]) ["kw" "sym" [1]])
    (assert= (mcp-server/json-data 12345678901234567890123) "12345678901234567890123")
    (assert= (mcp-server/json-data 1/3) "1/3"))
  (test "a pid is a $type-tagged object"
    (let (pid (mcpt-object (mcp-server/json-data (self))))
      (assert= (get pid "$type") "pid")
      (is (int? (get pid "id")))
      (is (string? (get pid "node")))))
  (test "colliding keys, functions and non-finite floats are errors, not dropped data"
    (is (includes? (error-of (mcp-server/json-data {:foo 1 "foo" 2})) "colliding"))
    (assert-error (mcp-server/json-data (fn (x) x)))
    (assert-error (mcp-server/json-data (/ 1.0 0.0)))
    (assert= (mcp-server/json-data {:foo 1 :bar 2}) {"foo" 1 "bar" 2}))
  (test "indented JSON sorts keys and indents two spaces a level"
    (assert= (mcp-server/pretty-json {"b" [1 2] "a" {} "c" []} "")
      "{\n  \"a\": {},\n  \"b\": [\n    1,\n    2\n  ],\n  \"c\": []\n}")))

(describe "mcp staleness warning"
  (test "a binary modified after the server started is stale; a missing one never is"
    (let (path (str "/tmp/mcpt-stale-" (rand/token 8)))
      (file/spit path "x")
      (is (mcp/rebuilt-since? path 0))
      (refute (mcp/rebuilt-since? path (+ (os/now) 3600000)))
      (file/rm path))
    (refute (mcp/rebuilt-since? "/no/such/nest-binary-xyz" 0))
    (refute (mcp/rebuilt-since? nil 0)))
  (test "the warning rides on a tools/call reply and on no other"
    (let (tool-reply {:jsonrpc "2.0" :id 1 :result {:content [{:type "text" :text "42"}]}})
      (assert= (map/get-in (mcp/with-warning tool-reply "STALE") [:result :content])
        [{:type "text" :text "42"} {:type "text" :text "STALE"}]))
    (assert= (mcp/with-warning {:jsonrpc "2.0" :id 1 :result {:capabilities {}}} "STALE") nil)
    (assert= (mcp/with-warning {:jsonrpc "2.0" :id 1 :error {:code -32601 :message "x"}} "STALE")
      nil)
    (is (includes? (mcp/staleness-warning "/x/nest") "STALE"))))
