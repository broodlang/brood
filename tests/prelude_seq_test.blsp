(defmodule prelude-seq-test (:use test) (:use seq) (:use math))

(describe "chunk-every"
  (test "even split"
    (assert= [[1 2] [3 4] [5 6]] (into [] (map (fn (x) (into [] x)) (chunk-every 2 [1 2 3 4 5 6])))))
  (test "trailing chunk kept"
    (assert= [[1 2] [3]] (into [] (map (fn (x) (into [] x)) (chunk-every 2 [1 2 3])))))
  (test "larger than collection"
    (assert= [[1 2 3]] (into [] (map (fn (x) (into [] x)) (chunk-every 5 [1 2 3])))))
  (test "empty collection"
    (assert= nil (chunk-every 3 nil)))
  (test "chunk size 1"
    (assert= [[1] [2] [3]] (into [] (map (fn (x) (into [] x)) (chunk-every 1 [1 2 3]))))))

(describe "chunk-by"
  (test "groups consecutive equal values"
    (assert= [[1 1] [2] [1 1 1]]
      (into [] (map (fn (x) (into [] x)) (chunk-by identity [1 1 2 1 1 1])))))
  (test "by key function"
    (let (r (chunk-by even? [2 4 1 3 6]))
      (assert= [[2 4] [1 3] [6]] (into [] (map (fn (x) (into [] x)) r)))))
  (test "empty"
    (assert= nil (chunk-by identity nil)))
  (test "all same"
    (assert= [[1 1 1]] (into [] (map (fn (x) (into [] x)) (chunk-by identity [1 1 1]))))))

(describe "scan"
  (test "running sum"
    (assert= '(0 1 3 6 10) (scan + 0 '(1 2 3 4))))
  (test "empty collection"
    (assert= '(0) (scan + 0 nil)))
  (test "single element"
    (assert= '(0 1) (scan + 0 '(1))))
  (test "reductions alias"
    (assert= (scan + 0 '(1 2 3)) (scan + 0 '(1 2 3)))))

(describe "mapcat"
  (test "basic mapcat"
    (assert= '(1 2 2 4 3 6) (mapcat (fn (x) (list x (* x 2))) '(1 2 3))))
  (test "empty"
    (assert= nil (mapcat (fn (x) (list x)) nil)))
  (test "same as mapcat"
    (assert= (mapcat (fn (x) (list x x)) '(1 2 3))
      (mapcat (fn (x) (list x x)) '(1 2 3)))))

(describe "zip-with"
  (test "addition of pairs"
    (assert= '(5 7 9) (zip-with + '(1 2 3) '(4 5 6))))
  (test "stops at shorter"
    (assert= '(1 4) (zip-with * '(1 2 3) '(1 2))))
  (test "first empty"
    (assert= nil (zip-with + nil '(1 2))))
  (test "builds pairs"
    (assert= '([1 4] [2 5]) (zip-with (fn (a b) [a b]) '(1 2) '(4 5)))))

(describe "intersperse"
  (test "basic"
    (assert= '(1 0 2 0 3) (interpose 0 '(1 2 3))))
  (test "single element unchanged"
    (assert= '(1) (interpose 0 '(1))))
  (test "empty"
    (assert= nil (interpose 0 nil)))
  (test "alias for interpose"
    (assert= (interpose :x '(a b c)) (interpose :x '(a b c)))))

(describe "min-by"
  (test "by string length"
    (assert= "a" (min-by string/length '("ccc" "bb" "a"))))
  (test "by identity"
    (assert= 1 (min-by identity '(3 1 2))))
  (test "by negative"
    (assert= 5 (min-by (fn (n) (- n)) '(3 1 5 2)))))

(describe "max-by"
  (test "by string length"
    (assert= "ccc" (max-by string/length '("ccc" "bb" "a"))))
  (test "by identity"
    (assert= 3 (max-by identity '(3 1 2))))
  (test "by negative"
    (assert= 1 (max-by (fn (n) (- n)) '(3 1 5 2)))))

(describe "reduce-while"
  (test "halts early when the reducer returns :halt"
    (assert= 105 (reduce-while (fn (a x) (if (> a 100) [:halt a] [:cont (+ a x)])) 0 (range 1000))))
  (test "all :cont behaves like fold"
    (assert= 15 (reduce-while (fn (a x) [:cont (+ a x)]) 0 [1 2 3 4 5])))
  (test "halts on the first element"
    (assert= :seed (reduce-while (fn (a x) [:halt a]) :seed [1 2 3])))
  (test "empty collection yields the init unchanged"
    (assert= :init (reduce-while (fn (a x) [:cont x]) :init [])))
  (test "finds the first element over a threshold"
    (assert= 4 (reduce-while (fn (a x) (if (> x 3) [:halt x] [:cont a])) nil [1 2 3 4 5])))
  (test "folds a map's [k v] pairs"
    (assert= 6 (reduce-while (fn (a [k v]) [:cont (+ a v)]) 0 {:a 1 :b 2 :c 3})))
  (test "errors on a return that is neither [:cont acc] nor [:halt acc]"
    (is (try (do (reduce-while (fn (a x) 42) 0 [1]) false) (catch _ true))))
  (test "across processes: the reduced value round-trips through send"
    :isolated (let (me (self)
          n 6
          expected (reduce-while (fn (a x) (if (> a 100) [:halt a] [:cont (+ a x)])) 0 (range 1000)))
      (map (fn (_)
             (spawn (fn ()
                      (send me
                        (reduce-while (fn (a x) (if (> a 100) [:halt a] [:cont (+ a x)]))
                          0
                          (range 1000))))))
        (range n))
      (let (results (fold (fn (acc _) (cons (receive) acc)) nil (range n)))
        (assert= n (count results))
        (is (every? (fn (r) (= r expected)) results))))))

(describe "distinct-by"
  (test "keeps the first item for each distinct key, order-preserving"
    (assert= (list [1 :a] [2 :c]) (distinct-by (fn (p) (nth p 0)) [[1 :a] [1 :b] [2 :c] [1 :d]])))
  (test "identity key behaves like distinct"
    (assert= (list 1 2 3) (distinct-by (fn (x) x) [1 1 2 2 3 1])))
  (test "keeps nil/false-valued keys distinctly"
    (assert= (list nil false 0) (distinct-by (fn (x) x) [nil nil false false 0 0])))
  (test "empty input"
    (assert= nil (distinct-by (fn (x) x) [])))
  (test "reachable qualified as seq/distinct-by"
    (assert= (list 1 2) (seq/distinct-by (fn (x) (math/mod x 2)) [1 3 2 4])))
  (test "across processes: the deduped value round-trips through send"
    :isolated (let (me (self)
          n 6
          input [[1 :a] [1 :b] [2 :c] [3 :d] [3 :e] [2 :f]]
          expected (distinct-by (fn (p) (nth p 0)) input))
      (map (fn (_)
             (spawn (fn () (send me (distinct-by (fn (p) (nth p 0)) input)))))
        (range n))
      (let (results (fold (fn (acc _) (cons (receive) acc)) nil (range n)))
        (assert= n (count results))
        (is (every? (fn (r) (= r expected)) results))))))
