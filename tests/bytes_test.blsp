;; The `bytes` value type (Value::Bytes): the `#b"…"` literal, the surface API,
;; the generic sequence protocol, equality/hashing, and survival across GC.
(defmodule bytes-test (:use test))

;; def'd into a global → promoted to the shared RUNTIME region (exercises the
;; promote + RUNTIME-flush paths).
(def *global-bytes* (bytes 1 2 3 255))

(describe "bytes: construction, predicate, type"
  (test "literal equals the constructor; type-of; predicate"
    (is (= #b"Hi!" (bytes 72 105 33)))
    (is (= (type-of #b"x") :bytes))
    (is (bytes? #b""))
    (refute (bytes? "x"))
    (refute (bytes? [1 2 3])))
  (test "construct from a vector or a list"
    (is (= (bytes [1 2 255]) #b"\x01\x02\xff"))
    (is (= (bytes (list 65 66)) #b"AB")))
  (test "a non-byte int is rejected"
    (is (= (first (try (bytes 256) (catch _ [:error]))) :error))
    (is (= (first (try (bytes -1) (catch _ [:error]))) :error))))

(describe "bytes: sequence protocol"
  (test "count / byte-length"
    (is (= (count (bytes 1 2 3)) 3))
    (is (= (bytes/length #b"hello") 5))
    (is (= (count #b"") 0)))
  (test "nth / get / byte-at yield ints 0–255"
    (let (b (bytes 10 20 30))
      (is (= (nth b 0) 10))
      (is (= (get b 2) 30))
      (is (= (bytes/at b 1) 20))
      (is (= (nth b 9 :none) :none))))
  (test "first / rest / empty?"
    (is (= (first (bytes 7 8 9)) 7))
    (is (= (rest (bytes 7 8 9)) (bytes 8 9)))
    (is (= (first #b"") nil))
    (is (empty? #b""))
    (refute (empty? #b"x"))))

(describe "bytes: slicing, concat, conversions"
  (test "subbytes"
    (is (= (bytes/slice #b"hello" 1 3) #b"el"))
    (is (= (bytes/slice #b"hello" 2) #b"llo")))
  (test "bytes-concat (literals and constructed)"
    (is (= (bytes/concat #b"ab" (bytes 67) #b"\xff") #b"abC\xff"))
    (is (= (bytes/concat) #b"")))
  (test "string<->bytes is UTF-8"
    (is (= (string/->bytes "AB") #b"AB"))
    (is (= (string/->bytes "é") #b"\xc3\xa9"))
    (is (= (string/bytes-> #b"\xc3\xa9") "é"))
    (is (= (string/bytes-> (string/->bytes "round-trip ✓")) "round-trip ✓")))
  (test "bytes->list"
    (is (= (seq (bytes 1 2 3)) (list 1 2 3)))))

; #b"k" and (bytes 107) are equal keys
(describe "bytes: equality + hashing"
  (test "content equality, not identity"
    (is (= #b"abc" (bytes 97 98 99)))
    (refute (= #b"abc" #b"abd")))
  (test "works as a map key (content hash matches content equality)"
    (let (m (assoc {} #b"k" 42))
      (is (= (get m (bytes 107)) 42)))))
(describe "bytes: GC survival"
  :isolated (test "LOCAL bytes survive forced collections with content intact"
    (let (mk (fn (i) (bytes (math/mod i 256) (math/mod (* i 3) 256) 255))
          xs (into [] (map mk (range 1000))))
      (dev/gc-collect)
      ;; churn: 30k throwaway bytes to force tenuring + a major collection
      (count (into [] (map (fn (i) (bytes (math/mod i 256))) (range 30000))))
      (dev/gc-collect)
      (is (= (count xs) 1000))
      (is (= (nth xs 0) (mk 0)))
      (is (= (nth xs 500) (mk 500)))
      (is (= (nth xs 999) (mk 999)))
      (is (= (bytes/at (nth xs 999) 2) 255))))
  (test "a promoted (global) bytes survives collection"
    (dev/gc-collect)
    (is (= *global-bytes* (bytes 1 2 3 255)))
    (is (= (bytes/length *global-bytes*) 4))))

(describe "bytes: pattern matching (Elixir-style binary destructuring)"
  (test "literal pattern matches by content"
    (is (= (match #b"GET" (#b"GET" :get) (#b"PUT" :put) (_ :other)) :get))
    (is (= (match (bytes 1 2) (#b"\x01\x02" :ok) (_ :no)) :ok)))
  (test "head bytes + rest"
    (is (= (match (bytes 1 2 3 4) ((bytes a b & rest) [a b rest]) (_ :no))
          [1 2 (bytes 3 4)])))
  (test "literal prefix then capture the tail"
    (is (= (match #b"GET /index" ((bytes #b"GET " & p) (string/bytes-> p)) (_ :other))
          "/index"))
    (is (= (match #b"POST /x"
             ((bytes #b"GET " & p) [:get (string/bytes-> p)])
             ((bytes #b"POST " & p) [:post (string/bytes-> p)])
             (_ :other))
          [:post "/x"])))
  (test "dynamic size — a length byte then that many bytes (TLV)"
    (is (= (match (bytes 3 65 66 67 99 100)
             ((bytes len (body len) & rest) [len (string/bytes-> body) rest])
             (_ :no))
          [3 "ABC" (bytes 99 100)])))
  (test "fixed length is enforced (no & rest means exact)"
    (is (= (match (bytes 1 2) ((bytes a b) [a b]) (_ :wrong)) [1 2]))
    (is (= (match (bytes 1 2 3) ((bytes a b) [a b]) (_ :wrong)) :wrong)))
  (test "_ skips bytes"
    (is (= (match (bytes 10 20 30) ((bytes _ x _) x) (_ :no)) 20)))
  (test "no clause matches falls through to the catch-all"
    (is (= (match #b"hi" ((bytes #b"GET " & p) p) (_ :fallthrough)) :fallthrough)))
  (test "a non-bytes value never matches a bytes pattern"
    (is (= (match [1 2 3] ((bytes a & r) a) (_ :not-bytes)) :not-bytes)))
  (test "non-linear: a repeated binder requires equal bytes"
    (is (= (match (bytes 5 5) ((bytes a a) :equal) (_ :diff)) :equal))
    (is (= (match (bytes 5 6) ((bytes a a) :equal) (_ :diff)) :diff))))

(describe "bytes: typed integer segments (bit syntax)"
  (test "unsigned widths, big-endian by default"
    (is (= (match (bytes 1 2) ((bytes (x :u16)) x) (_ :no)) 258))
    (is (= (match (bytes 0 0 1 0) ((bytes (x :u32)) x) (_ :no)) 256))
    (is (= (match (bytes 1 2 3) ((bytes (x :u8) (y :u16)) [x y]) (_ :no)) [1 515])))
  (test "explicit -be spellings equal the default"
    (is (= (match (bytes 1 2) ((bytes (x :u16-be)) x) (_ :no)) 258)))
  (test "little-endian variants"
    (is (= (match (bytes 2 1) ((bytes (x :u16-le)) x) (_ :no)) 258))
    (is (= (match (bytes 0 1 0 0) ((bytes (x :u32-le)) x) (_ :no)) 256)))
  (test "signed segments read two's complement"
    (is (= (match (bytes 255) ((bytes (x :i8)) x) (_ :no)) -1))
    (is (= (match (bytes 127) ((bytes (x :i8)) x) (_ :no)) 127))
    (is (= (match (bytes 255 254) ((bytes (x :i16)) x) (_ :no)) -2))
    (is (= (match (bytes 254 255) ((bytes (x :i16-le)) x) (_ :no)) -2)))
  (test "64-bit segments round-trip through int->bytes"
    (is (= (match (bytes/int-> 123456789012345 8) ((bytes (x :u64)) x) (_ :no))
          123456789012345))
    (is (= (match (bytes/int-> -5 8) ((bytes (x :i64)) x) (_ :no)) -5)))
  (test "length is enforced — too-short or unconsumed bytes fall through"
    (is (= (match (bytes 1) ((bytes (x :u16)) x) (_ :short)) :short))
    (is (= (match (bytes 1 2 3) ((bytes (x :u16)) x) (_ :inexact)) :inexact)))
  (test "(_ :u32) skips the segment's width"
    (is (= (match (bytes 9 9 9 9 7) ((bytes (_ :u32) x) x) (_ :no)) 7)))
  (test "a typed length prefix drives a sized segment (TLV with :u16 length)"
    (is (= (match (bytes/concat [(bytes/int-> 3 2) #b"ABC" (bytes 9)])
             ((bytes (len :u16) (body len) & rest) [len (string/bytes-> body) rest])
             (_ :no))
          [3 "ABC" (bytes 9)])))
  (test "non-linear: a repeated typed binder requires an equal value"
    (is (= (match (bytes 0 5 0 5) ((bytes (a :u16) (a :u16)) :equal) (_ :diff)) :equal))
    (is (= (match (bytes 0 5 0 6) ((bytes (a :u16) (a :u16)) :equal) (_ :diff)) :diff)))
  (test "mixes with literals, one-byte binders, and & rest — a mini frame header"
    (is (= (match (bytes/concat [(bytes 127 2) (bytes/int-> 5 2) #b"hello" #b"!"])
             ((bytes 127 kind (len :u16) (payload len) & more) [kind
                                                                 len
                                                                 (string/bytes-> payload)
                                                                 more])
             (_ :no))
          [2 5 "hello" (bytes 33)])))
  (test "an unknown spec keyword is a clean expand-time error"
    (is (= (try
             (eval '(match (bytes 1) ((bytes (x :u3)) x) (_ :no)))
             (catch e :bad-spec))
          :bad-spec))))

(describe "bytes: integer decode/encode helpers"
  (test "bytes-uint / bytes-int read at offsets, both endians"
    (is (= (bytes/uint (bytes 1 2 3 4) 1 2) 515))
    (is (= (bytes/uint-le (bytes 1 2 3 4) 1 2) 770))
    (is (= (bytes/int (bytes 0 255) 1 1) -1))
    (is (= (bytes/int-le (bytes 254 255) 0 2) -2)))
  (test "int->bytes round-trips, both endians"
    (is (= (bytes/int-> 258 2) (bytes 1 2)))
    (is (= (bytes/int-le-> 258 2) (bytes 2 1)))
    (is (= (bytes/int-> -1 2) (bytes 255 255)))
    (is (= (bytes/int (bytes/int-> -123456 4) 0 4) -123456))
    (is (= (bytes/uint-le (bytes/int-le-> 987654321 5) 0 5) 987654321)))
  (test "encoding truncates to the width (the bit-syntax convention)"
    (is (= (bytes/int-> 256 1) (bytes 0)))
    (is (= (bytes/int-> 511 1) (bytes 255))))
  (test "width outside 1–8 is a clean error"
    (is (= (try (bytes/uint (bytes 1) 0 0) (catch e :bad-width)) :bad-width))
    (is (= (try (bytes/int-> 1 9) (catch e :bad-width)) :bad-width)))
  (test "a :u64 read past the i64 range widens to a big integer (Erlang parity)"
    (is (= (bytes/uint (bytes 255 0 0 0 0 0 0 0) 0 8) 18374686479671623680))
    (is (= (match (bytes 255 255 255 255 255 255 255 255) ((bytes (x :u64)) x) (_ :no))
          18446744073709551615)))
  (test "typed reads cross processes — parse in a worker, send the fields home"
    (let (parent (self))
      (spawn (fn ()
               (send parent
                 (match (bytes/concat [(bytes/int-> 7 2) #b"payload"])
                   ((bytes (n :u16) & body) [n (string/bytes-> body)])
                   (_ :no)))))
      (is (= (receive (m m)) [7 "payload"])))))

;; ---- iolists (ADR-139): nested trees flattened once at the write boundary ----
(describe "iolists"
  (test "bytes-concat flattens nesting, strings (UTF-8), bytes, and byte ints"
    (is (= (bytes/concat ["ab" ["cd" nil "e"] (bytes 102) 103])
          #b"abcdefg"))
    (is (= (bytes/concat "x" [(bytes 121)] [[122]]) #b"xyz")))
  (test "empty iolists yield empty bytes"
    (is (= (bytes/concat) #b""))
    (is (= (bytes/concat nil [] [nil [nil]]) #b"")))
  (test "an improper tail is a final leaf (Erlang iolist parity)"
    (is (= (bytes/concat (cons "x" "y")) #b"xy")))
  (test "a non-leaf value is rejected"
    (is (= (try (bytes/concat [1.5]) (catch e :rejected)) :rejected))
    (is (= (try (bytes/concat [999]) (catch e :rejected)) :rejected))
    (is (= (try (bytes/concat [:kw]) (catch e :rejected)) :rejected)))
  (test "spit/slurp round-trips an iolist tree; spit-append appends one"
    (let (path (str "/tmp/brood-iolist-" (rand/token 8) ".txt"))
      (file/spit path ["a" ["b" nil "c"] (bytes 100) 101])
      (is (= (file/slurp path) "abcde"))
      (file/spit-append path [":" (bytes 120 121)])
      (is (= (file/slurp path) "abcde:xy"))
      (file/spit-bytes path ["A" [66] (bytes 67)])
      (is (= (file/slurp-bytes path) #b"ABC"))
      (file/spit-bytes-append path [[68] "E"])
      (is (= (file/slurp-bytes path) #b"ABCDE"))
      (file/rm path)))
  (test "deep nesting flattens (and survives the heap walkers)"
    ;; 40k-deep left-nested list. The flattener uses an explicit worklist, and
    ;; since the 2026-07-20 walker hardening (stacker segmented growth) the
    ;; kernel's promote/GC/equal/hash walkers survive this depth too — see
    ;; tests/deep_values_test.blsp for the dedicated coverage.
    (let (deep (fold (fn (acc _) (list acc)) (list "x") (range 40000)))
      (is (= (bytes/concat deep) #b"x")))))
