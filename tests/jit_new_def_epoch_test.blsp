;;; Regression guard for ADR-217: the JIT's code epoch moves on a REBIND, not on a
;;; first-time `def`.
;;;
;;; `jit_tier`'s hot-reload guard invalidates a compiled arm whenever the global epoch
;;; moved since it compiled. That epoch used to be `RuntimeCode::version`, which every
;;; `def` bumps — including a `def` that binds a brand-new name, which cannot possibly
;;; invalidate compiled code (an inlined prim's head had to be *bound* for `resolve_prim`
;;; to inline it at all). So defining globals while other code ran threw away native code
;;; and re-tiered it, over and over: a 4000-module load re-lowered 12 distinct arms 2294
;;; times each, and the JIT measured a 43% net LOSS against no JIT at all.
;;;
;;; The risk in narrowing it is the opposite error — MISSING an invalidation, which is a
;;; silent wrong answer rather than a crash. So the load-bearing case here is the second
;;; test: a rebind of a dependency must still be seen by an already-hot, already-tiered
;;; arm, even with a pile of first-time `def`s in between.
;;;
;;; `:isolated` for the same reason as `jit_self_rebind_test`: these redefine globals they
;;; also assert on, so a second run in one image (`--repeat-until-failure`, `nest test
;;; --failed`) would otherwise start from the redefined state (KI-25).

(defmodule jit-new-def-epoch-test (:use test))

;; A user-level operator, so it is redefinable (a builtin `+` is reserved). The hot arm
;; calls it in a tail loop, which is the shape that tiers.
(defn nde-op (a b) (+ a b))
(defn nde-hot (n acc) (if (< n 1) acc (nde-hot (- n 1) (nde-op acc 1))))

;; Defining `k` globals under fresh names nobody else reads.
(defn nde-fresh-defs (tag k)
  (cond
    (= k 0) nil
    else
      (do
        (eval (list 'def (symbol (str "nde-fresh-" tag "-" k)) k))
        (nde-fresh-defs tag (- k 1)))))

(describe "ADR-217: first-time defs leave a hot arm alone; a rebind still invalidates it"
  :isolated (test "a hot arm keeps answering correctly while new globals are defined around it"
    (assert= 5000 (nde-hot 5000 0))
    (nde-fresh-defs "a" 200)
    (assert= 5000 (nde-hot 5000 0))
    (nde-fresh-defs "b" 200)
    (assert= 5000 (nde-hot 5000 0)))

  ;; The one that matters: the arm is hot and tiered, 200 first-time `def`s go by (none of
  ;; which may invalidate it), and THEN its callee is rebound. The rebind must win.
  (test "rebinding the callee is honoured after a run of first-time defs"
    (nde-hot 5000 0)
    (nde-fresh-defs "c" 200)
    (def nde-op (fn (a b) (+ a 10)))
    (assert= 50000 (nde-hot 5000 0)))

  ;; And the rebind must stick across further first-time defs — i.e. narrowing the epoch
  ;; did not merely delay the invalidation to the next unrelated `def`.
  (test "the rebound callee stays in effect through more first-time defs"
    (def nde-op (fn (a b) (+ a 3)))
    (assert= 15000 (nde-hot 5000 0))
    (nde-fresh-defs "d" 200)
    (assert= 15000 (nde-hot 5000 0))))
