;; Persistent child processes (the kernel proc-* primitives, ADR-104). Real OS
;; children (`cat`, `sh`) on this host, driven over the mailbox seam (ADR-059):
;; a child's stdout/stderr/exit are delivered to its *owning* process's mailbox,
;; so each test owns the child in ONE process and drives it with plain `receive`.
;; :isolated keeps these (real pipes + reaper threads) off the shared worker churn.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule proc-test (:use test))

;; Helpers for the UTF-8 read-boundary regression test below. Both are tail-recursive.
(defn- proc-test-grow
  (s n)
  "Double `s` (a string of 3-byte chars) until it is at least `n` long."
  (if (>= (count s) n) s (proc-test-grow (str s s) n)))

(defn- proc-test-drain
  (p want acc)
  "Concatenate inbound [:proc …] chunks from `p` until they reassemble `want`
   (or a 3 s lull ends the stream — a corrupt reassembly then fails the ="
  (if (= acc want)
    acc
    (receive
      ([:proc ^p d] (proc-test-drain p want (str acc d)))
      (after 3000 acc))))

(describe "proc: handle + type-of"
  :isolated
  (test "proc/spawn returns a distinct :subprocess handle"
    (let (p (proc/spawn "cat" []))
      (assert= (type-of p) :subprocess)
      (refute (= (type-of 5) :subprocess))
      (refute (= (type-of "x") :subprocess))
      (proc/close p))))

(describe "proc: stdin echo via mailbox delivery"
  :isolated
  (test "proc/send to `cat` comes back as [:proc handle data]"
    (let (p (proc/spawn "cat" []))
      (proc/send p "ping over proc")
      (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= got "ping over proc")
        ;; proc/close SIGKILLs the child: it exits via a signal, so the final
        ;; [:proc-closed …] carries a nil code (no exit status).
        (proc/close p)
        (let (code (receive ([:proc-closed ^p c] c) (after *test-wait-ms* :timeout)))
          (is (nil? code)))))))

(describe "proc: binary mode is byte-faithful"
  :isolated
  ;; Binary mode governs the INBOUND decode only (ADR-141): the reader delivers
  ;; chunks as first-class `bytes` values, so arbitrary bytes (incl. 0x00 and
  ;; bytes ≥ 0x80 that are NOT valid UTF-8) round-trip through `cat` exactly —
  ;; the text-mode default would mangle them via from_utf8_lossy. Outbound
  ;; proc/send is mode-independent: bytes ride verbatim, strings as UTF-8.
  (test "raw bytes sent to `cat` come back unchanged in binary mode"
    (let (p (proc/spawn "cat" []))
      (proc/set-binary p true)
      ;; bytes 0x00 0xFF 0x80 0x41 — 0xFF 0x80 alone is invalid UTF-8. Binary mode
      ;; delivers a `bytes` value and proc/send accepts one, so they round-trip.
      (let (sent (bytes 0 255 128 65))
        (proc/send p sent)
        (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
          (assert= got sent)
          (assert= (into [] (bytes/->list got)) [0 255 128 65])
          (proc/close p)))))

  (test "a string leaf is its UTF-8 bytes even in binary mode (ADR-141)"
    (let (p (proc/spawn "cat" []))
      (proc/set-binary p true)
      ; U+03C0 = 0xCF 0x80 in UTF-8
      (proc/send p "π")
      (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= got (bytes 207 128))
        (proc/close p)))))

(describe "proc: stdout stream + exit code"
  :isolated
  (test "a child's stdout then [:proc-closed handle code] with its exit status"
    (let (p (proc/spawn "sh" ["-c" "printf hello; exit 3"]))
      (let (out (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= out "hello")
        (let (code (receive ([:proc-closed ^p c] c) (after *test-wait-ms* :timeout)))
          (assert= code 3))))))

(describe "proc: stderr is a separate channel"
  :isolated
  (test "stderr arrives as [:proc-err …], never mixed into [:proc …]"
    (let (p (proc/spawn "sh" ["-c" "printf oops 1>&2"]))
      (let (err (receive ([:proc-err ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= err "oops")
        (proc/close p)))))

(describe "proc: :cwd runs the child in a chosen directory"
  :isolated
  ;; Without :cwd the child inherits ours; with it, `pwd` reports the given dir.
  (test "proc/spawn opts :cwd sets the working directory"
    (let (p (proc/spawn "sh" ["-c" "pwd"] {:cwd "/"}))
      (let (out (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= out "/\n")
        (let (code (receive ([:proc-closed ^p c] c) (after *test-wait-ms* :timeout)))
          (assert= code 0))))))

(describe "proc: :env adds environment variables"
  :isolated
  (test "proc/spawn opts :env is visible to the child"
    (let (p (proc/spawn "sh" ["-c" "printf %s \"$MYVAR\""] {:env {"MYVAR" "hello"}}))
      (let (out (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= out "hello")
        (proc/close p)))))

(describe "proc: text mode reassembles a multi-byte char split across a read boundary"
  :isolated
  ;; Regression guard for the UTF-8 chunk-boundary fix. The reader's buffer is
  ;; 64 KiB and 65536 is not a multiple of 3, so a run of 3-byte characters
  ;; (え = E3 81 88) is GUARANTEED to have a character straddling the first read
  ;; boundary. Before the carry-across-reads fix the split char was mangled into
  ;; U+FFFD by a per-chunk from_utf8_lossy; now the reader carries the incomplete
  ;; tail into the next read, so the echoed payload reassembles exactly.
  (test "a >64 KiB run of 3-byte chars round-trips through `cat` uncorrupted"
    (let (payload (proc-test-grow "え" 70000)
          p (proc/spawn "cat" []))
      (proc/send p payload)
      (let (got (proc-test-drain p payload ""))
        ; no U+FFFD anywhere
        (assert= got payload)
        (proc/close p)))))

(describe "proc: the handle crosses processes"
  :isolated
  ;; The handle is a global-registry id, so it survives a `send`/`spawn` deep-copy
  ;; (Message::Subprocess round-trip) and `proc/send` works from a non-owner — but
  ;; the child's output still lands in the *owner's* (here, the test's) mailbox.
  (test "a worker process writes to a child this process owns"
    (let (_me (self)
          p (proc/spawn "cat" []))
      (spawn (proc/send p "from a worker"))
      (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (proc/close p)
        (assert= got "from a worker")))))
