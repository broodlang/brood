;; Persistent child processes (the kernel proc-* primitives, ADR-104). Real OS
;; children (`cat`, `sh`) on this host, driven over the mailbox seam (ADR-059):
;; a child's stdout/stderr/exit are delivered to its *owning* process's mailbox,
;; so each test owns the child in ONE process and drives it with plain `receive`.
;; :isolated keeps these (real pipes + reaper threads) off the shared worker churn.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule proc-test (:use test))

;; Helpers for the UTF-8 read-boundary regression test below. Both are tail-recursive.
(defn- proc-test-grow (s n)
  "Double `s` (a string of 3-byte chars) until it is at least `n` long."
  (if (>= (count s) n) s (proc-test-grow (str s s) n)))

(defn- proc-test-drain (p want acc)
  "Concatenate inbound [:proc …] chunks from `p` until they reassemble `want`
   (or a 3 s lull ends the stream — a corrupt reassembly then fails the ="
  (if (= acc want)
    acc
    (receive
      ([:proc ^p d] (proc-test-drain p want (str acc d)))
      (after *test-wait-ms* acc))))

(describe "proc: handle + type-of"
  :isolated (test "os/spawn returns a distinct :subprocess handle"
    (let (p (os/spawn "cat" []))
      (assert= (type-of p) :subprocess)
      (refute (= (type-of 5) :subprocess))
      (refute (= (type-of "x") :subprocess))
      (os/close p))))

(describe "proc: stdin echo via mailbox delivery"
  :isolated (test "os/write to `cat` comes back as [:proc handle data]"
    (let (p (os/spawn "cat" []))
      (os/write p "ping over proc")
      (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= got "ping over proc")
        ;; os/close SIGKILLs the child: it exits via a signal, so the final
        ;; [:proc-closed …] carries a nil code (no exit status).
        (os/close p)
        (let (code (receive ([:proc-closed ^p c] c) (after *test-wait-ms* :timeout)))
          (is (nil? code)))))))

(describe "proc: a child that stops reading cannot pin the caller (KI-97 item 2)"
  :isolated
  ;; `os/write` used to `write_all` on the CALLING thread. A pipe write is bounded by
  ;; the OS buffer, so a child that never drains its stdin blocked that thread forever —
  ;; and the caller is a scheduler worker, which cannot be preempted mid-syscall
  ;; (ADR-059), so a handful of these drained the pool with nothing able to recover them.
  ;; Writes now go to a per-child writer thread over a bounded queue.
  ;;
  ;; `sleep 30` never reads its stdin at all. This is a PROOF, not a smoke test: a pipe
  ;; buffer is ~64 KiB, so a synchronous `write_all` of ~1.6 MB into a child that never
  ;; reads cannot possibly return — it blocks once the buffer fills. Reaching the
  ;; assertions below therefore establishes that the write no longer happens on this
  ;; thread. (That is also why this needs no sabotage run to be convincing.)
  (test "writing far past the pipe buffer to a non-reading child still returns"
    (let (p (os/spawn "sleep" ["30"])
          chunk (string/repeat "x" 8192))
      ;; ~1.6 MB, far beyond any pipe buffer. Pre-fix this never returned.
      (dotimes (i 200) (os/write p chunk))
      ;; Still alive and still scheduling — the point of the whole exercise.
      (assert= (type-of p) :subprocess)
      (assert= (+ 1 1) 2)
      (os/close p))))

(describe "proc: binary mode is byte-faithful"
  :isolated
  ;; Binary mode governs the INBOUND decode only (ADR-141): the reader delivers
  ;; chunks as first-class `bytes` values, so arbitrary bytes (incl. 0x00 and
  ;; bytes ≥ 0x80 that are NOT valid UTF-8) round-trip through `cat` exactly —
  ;; the text-mode default would mangle them via from_utf8_lossy. Outbound
  ;; os/write is mode-independent: bytes ride verbatim, strings as UTF-8.
  (test "raw bytes sent to `cat` come back unchanged in binary mode"
    (let (p (os/spawn "cat" []))
      (os/set-binary p true)
      ;; bytes 0x00 0xFF 0x80 0x41 — 0xFF 0x80 alone is invalid UTF-8. Binary mode
      ;; delivers a `bytes` value and os/write accepts one, so they round-trip.
      (let (sent (bytes 0 255 128 65))
        (os/write p sent)
        (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
          (assert= got sent)
          (assert= (into [] (seq got)) [0 255 128 65])
          (os/close p)))))

  (test "a string leaf is its UTF-8 bytes even in binary mode (ADR-141)"
    (let (p (os/spawn "cat" []))
      (os/set-binary p true)
      ; U+03C0 = 0xCF 0x80 in UTF-8
      (os/write p "π")
      (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= got (bytes 207 128))
        (os/close p)))))

(describe "proc: stdout stream + exit code"
  :isolated (test "a child's stdout then [:proc-closed handle code] with its exit status"
    (let (p (os/spawn "sh" ["-c" "printf hello; exit 3"]))
      (let (out (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= out "hello")
        (let (code (receive ([:proc-closed ^p c] c) (after *test-wait-ms* :timeout)))
          (assert= code 3))))))

(describe "proc: stderr is a separate channel"
  :isolated (test "stderr arrives as [:proc-err …], never mixed into [:proc …]"
    (let (p (os/spawn "sh" ["-c" "printf oops 1>&2"]))
      (let (err (receive ([:proc-err ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= err "oops")
        (os/close p)))))

(describe "proc: :cwd runs the child in a chosen directory"
  :isolated
  ;; Without :cwd the child inherits ours; with it, `pwd` reports the given dir.
  (test "os/spawn opts :cwd sets the working directory"
    (let (p (os/spawn "sh" ["-c" "pwd"] {:cwd "/"}))
      (let (out (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= out "/\n")
        (let (code (receive ([:proc-closed ^p c] c) (after *test-wait-ms* :timeout)))
          (assert= code 0))))))

(describe "proc: :env adds environment variables"
  :isolated (test "os/spawn opts :env is visible to the child"
    (let (p (os/spawn "sh" ["-c" "printf %s \"$MYVAR\""] {:env {"MYVAR" "hello"}}))
      (let (out (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (assert= out "hello")
        (os/close p)))))

(describe "proc: text mode reassembles a multi-byte char split across a read boundary"
  :isolated
  ;; Regression guard for the UTF-8 chunk-boundary fix. The reader's buffer is
  ;; 64 KiB and 65536 is not a multiple of 3, so a run of 3-byte characters
  ;; (え = E3 81 88) is GUARANTEED to have a character straddling the first read
  ;; boundary. Before the carry-across-reads fix the split char was mangled into
  ;; U+FFFD by a per-chunk from_utf8_lossy; now the reader carries the incomplete
  ;; tail into the next read, so the echoed payload reassembles exactly.
  (test "a >64 KiB run of 3-byte chars round-trips through `cat` uncorrupted"
    (let (payload (proc-test-grow "え" 70000)
          p (os/spawn "cat" []))
      (os/write p payload)
      (let (got (proc-test-drain p payload ""))
        ; no U+FFFD anywhere
        (assert= got payload)
        (os/close p)))))

(describe "proc: the handle crosses processes"
  :isolated
  ;; The handle is a global-registry id, so it survives a `send`/`spawn` deep-copy
  ;; (Message::Subprocess round-trip) and `os/write` works from a non-owner — but
  ;; the child's output still lands in the *owner's* (here, the test's) mailbox.
  (test "a worker process writes to a child this process owns"
    (let (_me (self)
          p (os/spawn "cat" []))
      (spawn (os/write p "from a worker"))
      (let (got (receive ([:proc ^p d] d) (after *test-wait-ms* :timeout)))
        (os/close p)
        (assert= got "from a worker")))))

(describe "proc: a child dies with its owning process"
  :isolated
  ;; Erlang port semantics: when the owning green process exits — normally or by a
  ;; crash — the scheduler's retirement path (`retire_pid_tail`) closes every child
  ;; it still owns, exactly as it already closes its sockets. Before this hook
  ;; existed, an owner that exited without `os/close` orphaned the OS child forever:
  ;; the registry entry leaked, and both reader threads kept draining output into a
  ;; dead pid's mailbox for the child's whole life.
  ;;
  ;; **Verified by sabotage.** With the `close_process_procs` call removed from
  ;; `retire_pid_tail`, the `os/write` below succeeds (`cat` is alive on a live
  ;; handle) and the case fails with `:wrote`.
  (test "an exited owner's subprocess handle is closed and its child reaped"
    (let (me (self)
          _owner (spawn (send me [:handle (os/spawn "cat" [])])))
      (let (p (receive ([:handle h] h) (after *test-wait-ms* :NO-HANDLE)))
        ;; The owner exited right after the send; give retirement a moment to land.
        (sleep 300)
        ;; The handle must be dead: a write to it errors ("no such subprocess").
        (assert= (try (do (os/write p "x") :wrote) (catch e :closed)) :closed)))))

;; ---- pseudo-terminals --------------------------------------------------------
;; The difference a pty makes is not cosmetic: a program that asks `isatty` and is
;; told no drops its prompt, its line editing and its unbuffered output. That is why
;; an editor cannot host a REPL over pipes, and it is the whole reason `spawn-pty`
;; exists — so the property to assert is exactly that the child sees a terminal.

(defn- pty-drain (acc)
  "Everything the child writes until it exits or falls quiet."
  (receive
    ([:proc p d] (pty-drain (str acc d)))
    ([:proc-closed p code] acc)
    (after *test-wait-ms* acc)))

(describe "proc: a pty child is in a terminal, a piped one is not"
  ;; The same command, the same shell, the same question — two answers.
  :isolated (test "isatty says yes under spawn-pty"
    (let (_p (os/spawn-pty "sh" ["-c" "if [ -t 0 ]; then echo TTY; else echo PIPE; fi"])
          out (pty-drain ""))
      (assert= "TTY" (string/trim out))))

  :isolated (test "and no under spawn — which is what pipes are for"
    (let (_p (os/spawn "sh" ["-c" "if [ -t 0 ]; then echo TTY; else echo PIPE; fi"])
          out (pty-drain ""))
      (assert= "PIPE" (string/trim out)))))

(describe "proc: a pty carries one channel, not two"
  ;; A terminal has no separate error stream — the child's stderr IS its terminal.
  ;; Anything expecting `[:proc-err …]` from a pty is expecting the wrong shape.
  :isolated (test "stderr arrives on the same stream as stdout"
    (let (_p (os/spawn-pty "sh" ["-c" "echo out; echo err >&2"])
          out (pty-drain ""))
      (is (includes? out "out"))
      (is (includes? out "err")))))

(describe "proc: a pty has a size"
  :isolated (test "the child is told the window it was given"
    (let (_p (os/spawn-pty "sh" ["-c" "stty size"] {:cols 100 :rows 30})
          out (pty-drain ""))
      ;; `stty size` prints "rows cols"
      (assert= "30 100" (string/trim out))))

  :isolated (test "resize-pty changes it, which is how a full-screen child redraws"
    (let (p (os/spawn-pty "sh" ["-c" "sleep 0.3; stty size"] {:cols 80 :rows 24})
          _ (os/resize-pty p 120 40)
          out (pty-drain ""))
      (assert= "40 120" (string/trim out))))

  :isolated (test "resizing a piped child is refused rather than silently ignored"
    (let (p (os/spawn "cat" []))
      (assert= :refused (try (do (os/resize-pty p 80 24) :resized) (catch e :refused)))
      (os/close p))))

;; A pty costs a descriptor, and a descriptor that is never closed is a leak that only
;; shows up as a process that dies after a few hundred sessions. `close` used to
;; destructure the registry entry as `Proc { child, .. }`, which dropped the master fd on
;; the floor — it is a bare integer with no `Drop` — so every REPL opened cost one fd for
;; the life of the editor.
(describe "proc: a pty session gives its descriptors back"
  :isolated (test "opening and closing many sessions does not accumulate fds"
    (let (count-fds (fn ()
                      ;; a count that did not parse is a broken measurement, not a zero —
                      ;; silently treating it as one would make this gate unable to fail
                      (let (r (os/cmd "sh" ["-c" "ls /proc/self/fd | wc -l"])
                            n (string/->number (string/trim (get r :stdout))))
                        (if (number? n) n (error "fd count did not parse: " (get r :stdout)))))
          ;; a couple of warm-up sessions first: the first spawn allocates thread-local
          ;; and reader-thread state that is not per-session, and counting from zero
          ;; would charge that to the loop
          _ (letrec (warm (fn (n)
                            (when (> n 0)
                              (let (p (os/spawn-pty "sh" ["-c" "exit 0"]))
                                (sleep 30)
                                (os/close p)
                                (warm (dec n))))))
              (warm 3))
          _ (sleep 200)
          before (count-fds)
          _ (letrec (churn (fn (n)
                             (when (> n 0)
                               (let (p (os/spawn-pty "sh" ["-c" "exit 0"]))
                                 (sleep 30)
                                 (os/close p)
                                 (churn (dec n))))))
              (churn 12))
          _ (sleep 400)
          after (count-fds))
      ;; twelve sessions leaked twelve fds before the fix; a couple of descriptors of
      ;; slack absorbs reader threads still winding down
      (is (< (- after before) 6)))))

;; The reason all of the above exists: an interactive interpreter, hosted.
(defn- pty-await (acc want)
  "Read until `want` appears. An interactive child never exits and never falls
quiet on its own, so waiting for EOF here would mean waiting out the timeout —
twice — for a test whose answer arrived in milliseconds."
  (if (includes? acc want)
    acc
    (receive
      ([:proc p d] (pty-await (str acc d) want))
      ([:proc-closed p code] acc)
      (after *test-wait-ms* acc))))

(describe "proc: an interactive REPL under a pty"
  :isolated (test "a shell prompts, echoes and answers — none of which it does on a pipe"
    (let (p (os/spawn-pty "sh" ["-i"] {:cols 80 :rows 24})
          _ (os/write p "echo forty-two\n")
          out (pty-await "" "forty-two")
          _ (os/close p))
      ;; the echo of what was typed is itself the proof of a terminal: a pipe has no
      ;; echo, because there is no line discipline to do it
      (is (includes? out "forty-two")))))
