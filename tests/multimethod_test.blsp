;; Multiple dispatch — `defmulti` / `defmethod` (ADR-179). Dispatch on the IDENTITY-TUPLE of
;; the arguments: exact match, then a declared `:default`, else a loud `%no-method` error —
;; never a nearest guess. A `:commutative`/`:antisymmetric` algebra derives each off-diagonal
;; binary method's mirror. `defmulti`/`defmethod` are core (prelude), so they refer bare.
(defmodule multimethod-test (:use test))

(defmulti mm-combine :commutative)
(defmethod mm-combine [:int :string] (n s) (str n s))
(defmethod mm-combine [:int :int] (a b) (+ a b))

(defmulti mm-cmp :antisymmetric)
(defmethod mm-cmp [:int :string] (n s) 1) ; an int sorts after a string, say
(defmulti mm-desc) ; no algebra
(defmethod mm-desc :default (x) :other)
(defmethod mm-desc [:int] (n) :int)

(describe "multiple dispatch"
  (test "an exact identity-tuple dispatches to its method"
    (assert= (mm-combine 2 3) 5)
    (assert= (mm-combine 1 "x") "1x"))
  (test "a :commutative op derives the mirror — same result in both orders"
    (assert= (mm-combine "x" 1) "1x")
    (assert= (mm-combine "x" 1) (mm-combine 1 "x")))
  (test "a :antisymmetric op derives the NEGATED mirror"
    (assert= (mm-cmp 5 "a") 1)
    (assert= (mm-cmp "a" 5) -1))
  (test "the diagonal is authored explicitly and is not clobbered by a mirror"
    (assert= (mm-combine 2 3) 5))
  (test ":default is the catch-all, consulted only when no exact tuple matches"
    (assert= (mm-desc 7) :int)
    (assert= (mm-desc "hi") :other)
    (assert= (mm-desc :k) :other))
  (test "no method and no :default raises a structured :%no-method error"
    ;; `x`/`k` are vars so the static missing-method check can't judge the call — this
    ;; exercises the RUNTIME error path (the checker's call-site pass covers the literal case).
    (let (x 1.5
          k :kw
          e (try (mm-combine x k) (catch e e)))
      (assert= (get e :kind) :%no-method)
      (assert= (get e :multi) 'mm-combine)
      (assert= (get e :key) [:float :keyword])
      (is (includes? (get e :have) [:int :int]))
      (is (includes? (error-message e) "no method")))))

;; ---- across processes: methods live in the shared code region; a spawned process resolves
;; them against its own heap and the produced value round-trips back through `send`. ----
(defn mm-spawn-workers (parent pairs)
  (when (not (empty? pairs))
    (let (p (first pairs))
      (spawn (send parent [:r (mm-combine (nth p 0) (nth p 1))])))
    (mm-spawn-workers parent (rest pairs))))

(defn mm-collect (got total acc)
  (if (= got total)
    acc
    (mm-collect (+ got 1) total (receive ([:r v] (cons v acc))))))

(describe "multiple dispatch across processes"
  :isolated (test "spawned processes resolve methods (incl. derived mirrors) and send results back"
    (let (pairs [[2 3] [1 "x"] ["y" 4]])
      ; exact, exact, and a commutative-mirror hit
      (mm-spawn-workers (self) pairs)
      (let (got (mm-collect 0 (count pairs) nil))
        ;; order-independent: each worker returns its own result
        (assert= (sort-by got str) (sort-by (list 5 "1x" "4y") str))))))

;; ---- a declared return type (`:-> RET`) --------------------------------------
;; A `defmulti`'s body is the dispatch machinery, so its inferred type is opaque and a call
;; site could not be typed at all. The declaration is the only static handle — the same role
;; an ability op's `:-> RET` plays — and it is a CONTRACT rather than a guess because every
;; method body is checked against it (`check_method_returns`). Without that check, declaring
;; `:-> int` while a method returned a string would be worse than not declaring at all: the
;; checker would confidently type every call wrong.

(defmulti mm-typed :-> int)
(defmethod mm-typed [:string] (s) (string/length s))
(defmethod mm-typed [:int] (n) n)

(defmulti mm-typed-alg :commutative :-> int)
(defmethod mm-typed-alg [:int :string] (n s) (+ n (string/length s)))

(describe "defmulti :-> RET — the declared return type"
  (test "a declared return is recorded and readable"
    (assert= (multi-return-type 'mm-typed) 'int)
    (assert= (multi-return-type 'mm-typed-alg) 'int))

  (test "an undeclared multimethod records none — absent, not nil-valued"
    (assert= (multi-return-type 'mm-combine) nil))

  (test "the declaration does not disturb dispatch"
    (assert= (mm-typed "abcd") 4)
    (assert= (mm-typed 7) 7))

  (test "an algebra keyword and a return type coexist, and the mirror still derives"
    (assert= (mm-typed-alg 2 "xyz") 5)
    ;; the :commutative mirror — authored [:int :string], called [:string :int]
    (assert= (mm-typed-alg "xyz" 2) 5))

  ;; The checker half, exercised through `check-string-structured` so a warning is a VALUE
  ;; rather than a build failure. A conforming method is silent; a non-conforming one names
  ;; the multi, the dispatch key, the declared type, and what the body actually yields.
  (defn- mm-warnings (src)
    (map (reflect/check-string-structured src) (fn (d) (get d :message))))

  (test "a method whose body conforms to the declared return is silent"
    (assert= (mm-warnings "(defmulti k :-> int) (defmethod k [:int] (n) n)") (list)))

  (test "a method that violates the declared return warns, naming the key and both types"
    (let (w (mm-warnings "(defmulti k :-> int) (defmethod k [:string] (s) \"nope\")"))
      (is (not (empty? w)))
      (is (includes? (first w) "multimethod k"))
      (is (includes? (first w) "[:string]"))
      (is (includes? (first w) "declared return type int"))))

  (test "an undeclared multimethod constrains nothing"
    (assert= (mm-warnings "(defmulti k) (defmethod k [:string] (s) \"anything\") (defmethod k [:int] (n) n)")
      (list)))

  (test "a declared `any` return imposes no constraint"
    (assert= (mm-warnings "(defmulti k :-> any) (defmethod k [:string] (s) \"fine\")") (list)))

  ;; ABSENT is not `nil`. `nil` is a legal return type — `sig` and `defability` both take
  ;; `:-> nil` — so "was a return declared?" is a question about POSITION, never about the
  ;; value read. Testing it with `(nil? ret)` was wrong in BOTH directions at once: it
  ;; rejected a legal `:-> nil`, and (because it also demanded the arrow be the FIRST opt)
  ;; it let a dangling `:->` past whenever an algebra preceded it, silently discarding the
  ;; declaration the author was reaching for.
  (test "a dangling `:->` is an error wherever it appears"
    (is (not (nil? (error-of (macroexpand (quote (defmulti dang :->)))))))
    (is (not (nil? (error-of (macroexpand (quote (defmulti dang :commutative :->))))))))

  (test "`:-> nil` is a legal declaration, not a missing one"
    (assert= (mm-warnings "(defmulti k :-> nil) (defmethod k [:int] (n) nil)") (list)))

  (test "and a declared nil return is ENFORCED, not silently dropped"
    ;; The whole point of distinguishing it: `render` promises nil, so using its result as a
    ;; number is a provable mismatch. Before, a nil return was indistinguishable from no
    ;; declaration at all and this warned nowhere.
    (let (w (mm-warnings "(defmulti k :-> nil) (defmethod k [:int] (n) nil) (defn u () (+ 1 (k 5)))"))
      (is (not (empty? w)))
      (is (any? w (fn (m) (includes? m "got nil")))))))
