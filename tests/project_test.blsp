;; Project manifest + entry-point resolution (std/project.blsp). Covers the
;; `:main` parser and the default entry. Register-only — discovered and run by
;; `nest test` (and cargo test, via crates/lisp/tests/suite.rs).
;;
;; `run-project` itself is not exercised in-language: it walks from `cwd` to a
;; project.blsp, which the brood-repo suite already sits inside, so we can't
;; isolate it from here without changing the working directory. The hand-run
;; equivalent — `nest new foo && cd foo && nest run` — is the integration check.

(defmodule project-test
  (:use-internals project)
  (:use-internals scaffold)
  (:use test)
  (:use project))

;; Drop any fixtures a prior run left in /tmp (at load, before any test runs).
(purge-stale-temp "brood-dup-")
(purge-stale-temp "brood-fmt-plugin-")
(purge-stale-temp "brood-manifest-")

(describe "project: :main parsing"
  (test "a bare symbol defaults the fn name to `main`"
    (assert= (project/project-parse-main 'foo) '(foo main)))
  (test "a 2-list of symbols is taken as (module fn)"
    (assert= (project/project-parse-main '(foo bar)) '(foo bar)))
  (test "a 1-list is rejected"
    (assert= "project: :main must be a module symbol or '(module fn), got (foo)"
      (try (project/project-parse-main '(foo)) (catch e e))))
  (test "a 3-list is rejected"
    (assert= "project: :main must be a module symbol or '(module fn), got (foo bar baz)"
      (try (project/project-parse-main '(foo bar baz)) (catch e e))))
  (test "a non-symbol head is rejected"
    (is (string? (try (project/project-parse-main '("foo" main)) (catch e e)))))
  (test "a non-symbol fn is rejected"
    (is (string? (try (project/project-parse-main '(foo "main")) (catch e e)))))
  (test "a string is rejected"
    (is (string? (try (project/project-parse-main "main") (catch e e)))))
  ;; `:main 'app` reads as `(quote app)` (the manifest is data, never evaluated),
  ;; which would silently misparse to module `quote` — guard it with a fix-it.
  (test "a quoted symbol is rejected with a drop-the-quote fix-it"
    (let (msg (try (project/project-parse-main '(quote app)) (catch e e)))
      (and (is (includes? msg "drop the leading quote"))
        (is (includes? msg "`:main app`")))))
  (test "a quoted list is rejected with a drop-the-quote fix-it"
    (is (includes? (try (project/project-parse-main '(quote (app start))) (catch e e))
          "drop the leading quote"))))

(describe "project: default entry"
  (test "*project-main* defaults to (main main)"
    ;; A manifest with no :main key never assigns *project-main*, so the default
    ;; stays in place. The brood repo's own project.blsp omits :main, so this
    ;; reflects the live value the runner would use.
    (assert= *project-main* '(main main))))

(describe "project: :dependencies parsing (ADR-037)"
  ;; A parsed dep is a RECORD, one per manifest kind — its identity *is* its kind, so
  ;; the package manager dispatches the `Dependency` ability on it instead of reading a
  ;; `:kind` field. A record is never `=` to a bare map, so these compare constructors.
  (test "a :git entry normalises to a dep-git record"
    (assert= (project/project-parse-dep '[parser :git "https://example.com/p.git" :ref "v1.2.0"])
      (assoc (project/dep-git 'parser "https://example.com/p.git" "v1.2.0") :optional false)))
  (test "a :path entry normalises to a dep-path record"
    (assert= (project/project-parse-dep '[shared :path "../shared"])
      (assoc (project/dep-path 'shared "../shared") :optional false)))
  (test "each kind gets its own identity, and dep? recognises them all"
    (let (git-dep (project/project-parse-dep '[a :git "u" :ref "r"])
          path-dep (project/project-parse-dep '[b :path "p"])
          tarball-dep (project/project-parse-dep '[c :tarball "u" :sha256 "abc"])
          registry-dep (project/project-parse-dep '[d :version "1.0.0"]))
      (assert= (record-id git-dep) :project/dep-git)
      (assert= (record-id path-dep) :project/dep-path)
      (assert= (record-id tarball-dep) :project/dep-tarball)
      (assert= (record-id registry-dep) :project/dep-registry)
      (is (every? project/dep? (list git-dep path-dep tarball-dep registry-dep)))
      (is (project/dep-path? path-dep))
      (is (not (project/dep-path? git-dep)))
      (is (not (project/dep? {:name 'x :path "p"})))))
  (test "a dep displays as its manifest source — the nest tree line"
    (assert= (to-str (project/dep-path 'shared "../shared")) "shared  (path \"../shared\")")
    (assert= (to-str (project/dep-git 'p "https://x.git" "v1")) "p  (git https://x.git @ v1)")
    (assert= (to-str (project/dep-tarball 'q "https://x.tgz" "ab")) "q  (tarball https://x.tgz)")
    (assert= (to-str (project/dep-registry 'r "1.2.0")) "r  (registry v1.2.0)"))
  (test "parse-deps maps over the whole vector"
    (assert= (project/project-parse-deps '[[a :path "../a"] [b :path "../b"]])
      (list (assoc (project/dep-path 'a "../a") :optional false)
        (assoc (project/dep-path 'b "../b") :optional false))))
  (test "nil dependencies parse to nil"
    (assert= (project/project-parse-deps nil) nil))
  (test "a non-vector :dependencies value is rejected"
    (is (includes? (try (project/project-parse-deps '(a b)) (catch e e)) "must be a vector")))
  (test "a non-symbol dep name is rejected"
    (is (includes? (try (project/project-parse-dep '["parser" :path "../p"]) (catch e e))
          "must be a symbol")))
  (test "an unknown source kind is rejected"
    (is (includes? (try (project/project-parse-dep '[parser :svn "../p"]) (catch e e))
          "must be :git, :path, :tarball, or :version")))
  (test "a :git dep without a :ref is rejected"
    (is (includes? (try
                     (project/project-parse-dep '[parser :git "https://x.git"])
                     (catch e e))
          "needs a :ref")))
  (test "a reserved opt is rejected so the manifest stays forward-compatible"
    (is (includes? (try
                     (project/project-parse-dep '[parser
                                                   :git "https://x.git" :ref "v1" :branch "main"])
                     (catch e e))
          "reserved for a future version")))
  (test "an entry that is too short is rejected"
    (is (includes? (try (project/project-parse-dep '[parser :path]) (catch e e))
          "too short"))))

;; `:isolated` — `project-apply` clobbers the ambient `*project-*` globals; roll them back.
(describe "project: :optional deps and :dev-dependencies (ADR-172)"
  :isolated
  (test ":optional defaults to false"
    (assert= (get (project/project-parse-dep '[a :path "../a"]) :optional) false))
  (test ":optional true is recorded on any dep kind"
    (assert= (get (project/project-parse-dep '[a :path "../a" :optional true]) :optional) true)
    (assert= (get (project/project-parse-dep '[a :git "u" :ref "r" :optional true]) :optional) true))
  (test ":dev-dependencies parse and tag :dev true, kept separate from :dependencies"
    (project/project-apply '(:name demo
                              :dependencies
                              [[core :git "u" :ref "r"]]
                              :dev-dependencies
                              [[testkit :path "../tk"]]))
    ; production deps stay in their own slot, untagged
    (assert= (map :name *project-dependencies*) (list 'core))
    (assert= (map :dev *project-dependencies*) (list nil))
    ; dev deps land in their own slot, tagged :dev true
    (assert= (map :name *project-dev-dependencies*) (list 'testkit))
    (assert= (map :dev *project-dev-dependencies*) (list true)))
  (test "no :dev-dependencies parses to an empty dev-dep list"
    (project/project-apply '(:name demo :dependencies [[core :path "../c"]]))
    (assert= *project-dev-dependencies* nil)))

;; `:isolated` runs against a rolled-back private copy of the globals (ADR-017),
;; so the *project-* globals this clobbers via `(project ...)` don't leak.
(describe "project: the (project ...) manifest macro treats its args as data"
  :isolated
  (test "bare dep-name symbols survive without quoting; :dependencies populates *project-dependencies*"
    (project
      :name "demo"
      :version "0.0.1"
      :dependencies [[parser :git "https://example.com/p.git" :ref "v1"] [shared :path "../shared"]])
    (assert= *project-dependencies*
      (list (assoc (project/dep-git 'parser "https://example.com/p.git" "v1") :optional false)
        (assoc (project/dep-path 'shared "../shared") :optional false)))))

;; `:format-plugins` rules must resolve for EVERY dep kind: a `:path` dep's manifest
;; is read in place, a fetched dep's (:git/:tarball/:registry) from its `_deps/<name>/`
;; checkout. Regression: a project that swapped a framework from a `:path` to a `:git`
;; dep silently lost the framework's formatter rules.
(describe "project: :format-plugins manifest resolution"
  :isolated
  (test "a :path dep's manifest is read in place, relative to the root"
    (project :name "demo" :dependencies [[shared :path "../shared"]])
    (assert= (project/project-dep-manifest-path 'shared "/proj")
      "/proj/../shared/project.blsp"))
  (test "a :git dep's manifest is read from its _deps checkout"
    (project
      :name "demo"
      :dependencies [[hatch :git "https://example.com/hatch.git" :ref "v1"]])
    (assert= (project/project-dep-manifest-path 'hatch "/proj")
      "/proj/_deps/hatch/project.blsp"))
  (test "a :tarball dep's manifest is read from its _deps checkout too"
    (project
      :name "demo"
      :dependencies [[grid :tarball "https://example.com/grid.tar.gz" :sha256 "abc"]])
    (assert= (project/project-dep-manifest-path 'grid "/proj")
      "/proj/_deps/grid/project.blsp"))
  (test "an undeclared dep has no manifest"
    (project :name "demo" :dependencies [[shared :path "../shared"]])
    (assert= (project/project-dep-manifest-path 'nope "/proj") nil))
  (test "a :git plugin's :format-headers reach the effective header table"
    (let (root (temp-dir "brood-fmt-plugin-")
          hatch (path-join (path-join root "_deps") "hatch"))
      (make-dir hatch)
      (spit (path-join hatch "project.blsp")
        "(project :name \"hatch\" :format-headers {deflive 0 on 2 tick 2})\n")
      (project
        :name "demo"
        :dependencies [[hatch :git "https://example.com/hatch.git" :ref "v1"]]
        :format-plugins [hatch]
        :format-headers {on 1})
      ;; the plugin's rules land, and the project's own :format-headers win on a clash
      (assert= (project/project-effective-format-headers root)
        {'deflive 0 'on 1 'tick 2})))
  (test "an unfetched plugin degrades to no extra rules rather than erroring"
    (project
      :name "demo"
      :dependencies [[hatch :git "https://example.com/hatch.git" :ref "v1"]]
      :format-plugins [hatch])
    (assert= (project/project-effective-format-headers "/nonexistent-project-root") {}))
  ;; A plugin naming a dep the manifest never declared is a typo. It warns to stderr
  ;; (not assertable here — `with-out-str` captures stdout only), but it must still
  ;; contribute nothing and, crucially, not cost a correctly-declared sibling its
  ;; rules.
  (test "a plugin that is not in :dependencies contributes nothing, and WARNS"
    (project :name "demo" :dependencies [[shared :path "../shared"]] :format-plugins [typo])
    ;; `with-err-str` both asserts the warning and keeps it out of the suite's
    ;; output — the warning firing here is the correct behaviour, not noise to fix.
    (let (warning (with-err-str (assert= (project/project-effective-format-headers "/proj") {})))
      (and (is (includes? warning "typo"))
        (is (includes? warning "not in :dependencies")))))
  (test "a bogus plugin entry does not suppress a valid sibling's rules"
    (let (root (temp-dir "brood-fmt-plugin-")
          hatch (path-join (path-join root "_deps") "hatch"))
      (make-dir hatch)
      (spit (path-join hatch "project.blsp")
        "(project :name \"hatch\" :format-headers {deflive 0 tick 2})\n")
      (project
        :name "demo"
        :dependencies [[hatch :git "https://example.com/hatch.git" :ref "v1"]]
        :format-plugins [typo hatch])
      (with-err-str (assert= (project/project-effective-format-headers root)
                      {'deflive 0 'tick 2})))))

(describe "project: scaffold templates (ADR-037)"
  (test "the .gitignore template ignores the package cache"
    (is (includes? (scaffold/project-gitignore-template) "_deps/")))
  (test "the .gitattributes template maps .blsp to Clojure but keeps it out of the language stats"
    (let (a (scaffold/project-gitattributes-template))
      (is (includes? a "*.blsp"))
      (is (includes? a "linguist-language=Clojure"))
      (is (includes? a "linguist-detectable=false"))))
  (test "the manifest template documents how to add :dependencies"
    (let (m (scaffold/project-manifest-template "demo"))
      (is (includes? m ":dependencies"))
      ;; still a valid manifest: the first form is the (project …) call
      (let (form (read-string m))
        (assert= (first form) 'project)
        (assert= (plist-get (rest form) :name) "demo")))))

(describe "project: bundle module naming (ADR-038)"
  ;; A release bundle keys modules by require-name, not bare stem, so a namespaced
  ;; module (net/sse) keeps its namespace and resolves through %builtin-module — the
  ;; bug behind `./app: require: cannot find module 'net/sse'` after `nest release`.
  (test "project--bundle-name keeps the namespace relative to the source dir"
    (assert= (project/project-bundle-name "/p/src" "/p/src/main.blsp") "main")
    (assert= (project/project-bundle-name "/p/src" "/p/src/net/sse.blsp") "net/sse")
    (assert= (project/project-bundle-name "/p/src/" "/p/src/a/b/c.blsp") "a/b/c"))
  (test "a path not under the source dir falls back to its bare stem"
    (assert= (project/project-bundle-name "/other" "/p/src/x.blsp") "x")))

(describe "project: namespace-aware duplicate global detection (ADR-065)"
  (test "project/project--file-def-names resolves names to ns/name (ambient earmuffs stay root; defmodule skipped)"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (f (path-join dir "a.blsp"))
        (spit f
          "(defmodule a \"x\")\n(defn main () 1)\n(def k 2)\n(defmacro m (x) x)\n(defdyn *d* 0)\n(defn helper (y) y)\n")
        ;; Under `(defmodule a)` every binding resolves to `a/…`, except the
        ;; ambient `*d*` earmuff which stays root (mirrors the kernel resolver).
        (assert= (sort (project/project-file-def-names f))
          (sort ["*d*" "a/helper" "a/k" "a/m" "a/main"])))))
  (test "the same short name in two DIFFERENT namespaces is not a collision"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (fa (path-join dir "a.blsp") fb (path-join dir "b.blsp"))
        (spit fa "(defmodule alpha)\n(defn main () 1)\n")
        (spit fb "(defmodule beta)\n(defn main () 2)\n")
        ;; alpha/main vs beta/main — distinct keys, no warning.
        (assert= (project/project-duplicate-def-warnings-seq [fa fb]) nil))))
  (test "the same name in the SAME namespace IS flagged (qualified)"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (fa (path-join dir "a.blsp") fb (path-join dir "b.blsp"))
        (spit fa "(defmodule shared)\n(defn main () 1)\n(defn only-a () 1)\n")
        (spit fb "(defmodule shared)\n(defn main () 2)\n(defn only-b () 2)\n")
        (let (warns (project/project-duplicate-def-warnings-seq [fa fb]))
          (assert= (count warns) 1)
          (is (includes? (first warns) "shared/main"))
          (refute (includes? (first warns) "only-a"))))))
  (test "an ambient *earmuff* name collides across namespaces (it stays root)"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (fa (path-join dir "a.blsp") fb (path-join dir "b.blsp"))
        (spit fa "(defmodule alpha)\n(defdyn *cfg* 1)\n")
        (spit fb "(defmodule beta)\n(defdyn *cfg* 2)\n")
        (let (warns (project/project-duplicate-def-warnings-seq [fa fb]))
          (assert= (count warns) 1)
          (is (includes? (first warns) "*cfg*"))))))
  (test "files with no defmodule share the root namespace — same name still collides"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (fa (path-join dir "a.blsp") fb (path-join dir "b.blsp"))
        (spit fa "(defn main () 1)\n(defn only-a () 1)\n")
        (spit fb "(defn main () 2)\n(defn only-b () 2)\n")
        (let (warns (project/project-duplicate-def-warnings-seq [fa fb]))
          (assert= (count warns) 1)
          (is (includes? (first warns) "main"))
          (refute (includes? (first warns) "only-a"))))))
  (test "no duplicates yields no warnings"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (fa (path-join dir "a.blsp") fb (path-join dir "b.blsp"))
        (spit fa "(defmodule alpha)\n(defn alpha-fn () 1)\n")
        (spit fb "(defmodule beta)\n(defn beta-fn () 2)\n")
        (assert= (project/project-duplicate-def-warnings-seq [fa fb]) nil))))
  ;; The cached, extract-based path (ADR-119) must agree with the sequential one.
  ;; Build extracts by hand (dummy mtime 0) so this needs no disk cache, and compare
  ;; both the duplicate-defs and unused-private derivations against the -seq/-agg forms.
  (test "extract-based passes agree with the from-scratch passes"
    (let (dir (temp-dir "brood-dup-"))
      (make-dir dir)
      (let (fa (path-join dir "a.blsp") fb (path-join dir "b.blsp"))
        (spit fa
          "(defmodule shared)\n(defn main () 1)\n(defn shared--helper () 1)\n(defn shared--dead () 1)\n(defn use-it () (shared--helper))\n")
        (spit fb "(defmodule shared)\n(defn main () 2)\n")
        (let (files [fa fb]
              extracts (fold (fn (m p)
                               (let ([c pr dn] (project/project-scan-file-entry p))
                                 (map-assoc m p [0 c pr dn])))
                         {}
                         files)
              source-set (fold (fn (m p) (map-assoc m p true)) {} files))
          ;; duplicate-defs: extract path == sequential path
          (assert= (sort (project/project-duplicate-def-warnings extracts source-set))
            (sort (project/project-duplicate-def-warnings-seq files)))
          ;; unused-private: shared--dead is unreferenced (warn), shared--helper is used
          (let (warns (project/project-unused-private-warnings extracts))
            (assert= (count warns) 1)
            (is (includes? (first warns) "shared--dead"))
            (refute (any? (fn (w) (includes? w "shared--helper")) warns))))))))

;; The Phase-2 check-result cache primitives (ADR-119): `check-file-deps` returns
;; `[warnings dep-keys fingerprint]`, and `check-deps-fp` recomputed on those
;; dep-keys reproduces the fingerprint (deterministic + stable against the current
;; image). The whole-project soundness — that a cached warning is reused iff every
;; observed global fact is unchanged — is covered by the differential battery.
(describe "project: incremental check-cache primitives (ADR-119 Phase 2)"
  (test "check-file-deps returns [warnings dep-keys fp]; check-deps-fp is stable"
    (let (dir (temp-dir "brood-p2-"))
      (make-dir dir)
      (let (f (path-join dir "m.blsp"))
        (spit f "(defmodule p2m)\n(defn p2m-g (x) (p2m-h x))\n(defn p2m-h (a b) (+ a b))\n")
        (let (r (check-file-deps f))
          (assert= (count r) 3)
          (is (vector? r))
          ;; dep-keys is the observations map; fp is a non-empty string
          (is (map? (nth r 1)))
          (is (string? (nth r 2)))
          ;; recomputing the fingerprint of the same dep-keys against the unchanged
          ;; image reproduces it exactly (the reuse test the cache relies on)
          (assert= (check-deps-fp (nth r 1)) (nth r 2))
          (assert= (check-deps-fp (nth r 1)) (check-deps-fp (nth r 1))))))))

;; The source loader is load-once *within a walk* (a module another file already
;; `require`d isn't loaded a second time when the walk reaches its file) and on
;; `:skip-loaded` (the check pre-flight skips anything already provided). Both guard
;; against re-evaluating a module — which re-runs its `defmacro`s (the "macro
;; redefined" hot-reload warning) and wipes any state it just built. Regression: the
;; myedit editor defines `defcommand` in interactive.blsp, which commands.blsp
;; `:use`s to register every command into a registry; the walker force-reloading
;; interactive.blsp after commands.blsp ran wiped that registry (and warned).
;; `:isolated` — these tests mutate process-global project state (the module
;; load-path via `project-setup`, `*features*`, and the fixture load counters like
;; `zzz/*zzz-loads*`). Run concurrently they race other tests' `project-setup` (a peer
;; clobbers the load-path between this unit's setup and its walk → "cannot find
;; module 'zzz'"). Isolation runs them alone against a rolled-back private copy of
;; the globals, so the walk sees its own freshly-`spit` project. (KI-2 class.)
(describe "project: source load-once"
  :isolated
  (test "project--file-feature reads a file's (defmodule NAME) as a string"
    (let (dir (temp-dir "brood-feat-"))
      (make-dir dir)
      (let (f (path-join dir "m.blsp"))
        (spit f "(defmodule featmod \"doc\")\n(defn g () 1)\n")
        (assert= (project/project-file-feature f) "featmod"))))
  (test "a file with no defmodule header has no feature (nil → always loaded)"
    (let (dir (temp-dir "brood-feat-"))
      (make-dir dir)
      (let (f (path-join dir "m.blsp"))
        (spit f "(defn g () 1)\n")
        (is (nil? (project/project-file-feature f))))))
  (test "an unparseable file yields nil (the load surfaces the real error)"
    (let (dir (temp-dir "brood-feat-"))
      (make-dir dir)
      (let (f (path-join dir "m.blsp"))
        ; unbalanced — won't parse
        (spit f "(defmodule oops \n")
        (is (nil? (project/project-file-feature f))))))
  ;; The fixtures below bump a counter on every evaluation, so the counter is exactly
  ;; how many times the file was actually loaded. The counter lives in the *fixture
  ;; module's* namespace and is read back qualified (`zzz/*zzz-loads*`): an earmuff
  ;; is no longer ambient by spelling, so the module's own `(def *zzz-loads* …)`
  ;; defines `zzz/*zzz-loads*` — which is exactly the name to seed and to assert on.
  ; loaded once, not twice
  (test "a module another file already require'd is NOT reloaded when the walk reaches it"
    ;; aaa.blsp `:use`s zzz (loading zzz via require); the walk then reaches zzz.blsp.
    ;; The fix skips it — without it, zzz would load twice (re-defmacro, state wipe).
    (let (root (temp-dir "brood-walk-"))
      (make-dir root)
      (make-dir (path-join root "src"))
      (let (src (path-join root "src"))
        (spit (path-join src "aaa.blsp") "(defmodule aaa (:use zzz))\n")
        (spit (path-join src "zzz.blsp") "(defmodule zzz)\n(def *zzz-loads* (inc *zzz-loads*))\n")
        (def zzz/*zzz-loads* 0)
        (project/project-setup root)
        (project/project-load-sources root)
        (assert= zzz/*zzz-loads* 1))))
  (test ":skip-loaded skips an already-provided module; a later walk reloads it"
    (let (root (temp-dir "brood-skip-"))
      (make-dir root)
      (make-dir (path-join root "src"))
      (let (f (path-join (path-join root "src") "skipfix.blsp"))
        (spit f "(defmodule skipfix)\n(def *skip-load-count* (inc *skip-load-count*))\n")
        (def skipfix/*skip-load-count* 0)
        (project/project-setup root)
        ; first walk: loads → 1
        (project/project-load-sources root)
        (assert= skipfix/*skip-load-count* 1)
        (is (member? "skipfix" *features*))
        ; pre-flight: provided → skip → 1
        (project/project-load-sources root :skip-loaded)
        (assert= skipfix/*skip-load-count* 1)
        ; later walk: reloads edits → 2
        (project/project-load-sources root)
        (assert= skipfix/*skip-load-count* 2)))))

;; A malformed manifest used to be either cryptic or SILENT. `:source-paths "src"`
;; (an easy mistake, since one path is the common case) surfaced as
;; a bare `type error: first: …` raised from inside `map`, with
;; nothing pointing at the manifest; and a first form that wasn't `(project …)` —
;; a typo like `(porject …)` — was skipped entirely, so every setting in it was
;; quietly ignored and the project silently ran on defaults.
(describe "project: manifest validation"
  (test "a vector of path strings is accepted"
    (assert= (project/project-check-paths :source-paths ["src" "lib"]) ["src" "lib"]))
  (test "a list of path strings is accepted"
    (assert= (project/project-check-paths :source-paths (list "src")) (list "src")))
  (test "a bare string is rejected, naming the key and the fix"
    (let (msg (try (project/project-check-paths :source-paths "src") (catch e e)))
      (and (is (includes? msg ":source-paths"))
        (is (includes? msg "not a bare string"))
        (is (includes? msg "[\"src\"]")))))
  (test "a vector of non-strings is rejected"
    (is (includes? (try (project/project-check-paths :source-paths [5]) (catch e e))
          "must contain only strings")))
  (test "a number is rejected"
    (is (includes? (try (project/project-check-paths :test-paths 5) (catch e e))
          "must be a vector of path strings")))
  (test "the fix-it example matches the key it is about"
    ;; suggesting ["src"] for :test-paths would be actively misleading
    (is (includes? (try (project/project-check-paths :test-paths 5) (catch e e))
          "[\"tests\"]"))))

(describe "project: manifest loading errors point at the file"
  :isolated
  (test "an unparseable manifest names the file, line, and column"
    (let (dir (temp-dir "brood-manifest-")
          manifest (path-join dir "project.blsp"))
      (make-dir dir)
      (spit manifest "(project :name \"x\"\n")
      (let (msg (try (project/project-apply-manifest manifest) (catch e e)))
        (and (is (includes? msg "cannot parse"))
          (is (includes? msg manifest))
          (is (includes? msg "line"))))))
  (test "an empty manifest says so rather than failing obscurely"
    (let (dir (temp-dir "brood-manifest-")
          manifest (path-join dir "project.blsp"))
      (make-dir dir)
      (spit manifest "")
      (is (includes? (try (project/project-apply-manifest manifest) (catch e e))
            "cannot parse"))))
  (test "a first form that is not (project …) is REJECTED, not silently ignored"
    (let (dir (temp-dir "brood-manifest-")
          manifest (path-join dir "project.blsp"))
      (make-dir dir)
      (spit manifest "(porject :name \"x\")\n")
      (let (msg (try (project/project-apply-manifest manifest) (catch e e)))
        (and (is (includes? msg "must begin with a (project"))
          (is (includes? msg "porject"))
          (is (includes? msg "being ignored"))))))
  (test "a non-list manifest is rejected"
    (let (dir (temp-dir "brood-manifest-")
          manifest (path-join dir "project.blsp"))
      (make-dir dir)
      (spit manifest "42\n")
      (is (includes? (try (project/project-apply-manifest manifest) (catch e e))
            "must begin with a (project"))))
  (test "a well-formed manifest still applies"
    (let (dir (temp-dir "brood-manifest-")
          manifest (path-join dir "project.blsp"))
      (make-dir dir)
      (spit manifest "(project :name \"applied\" :version \"9.9.9\")\n")
      (project/project-apply-manifest manifest)
      (assert= *project-name* "applied"))))

;; The scaffolded library module is named after the PROJECT, not a fixed `hello`.
;; With a fixed name, no two scaffolded projects could ever depend on each other —
;; both provided `hello`, and `nest add` refused with a module-name collision
;; (namespaces aren't package-rooted yet, ADR-070). The name must also be safe to
;; write as a bare symbol and as a filename, and `project--valid-name?` permits
;; punctuation that a symbol shouldn't carry.
(describe "project: the scaffolded library module's name"
  (test "an ordinary name is used as-is"
    (assert= (scaffold/project-module-name "greeter") "greeter"))
  (test "hyphens and underscores are kept"
    (assert= (scaffold/project-module-name "my-cool_lib") "my-cool_lib"))
  (test "a dot becomes a hyphen, so the name reads as one symbol"
    (assert= (scaffold/project-module-name "my.app") "my-app"))
  (test "other punctuation is replaced too"
    (assert= (scaffold/project-module-name "a+b!c") "a-b-c"))
  (test "a leading digit is prefixed, since a symbol must not read as a number"
    (assert= (scaffold/project-module-name "2fast") "p-2fast"))
  (test "a name of only punctuation degrades to something usable"
    (assert= (scaffold/project-module-name "+++") "lib"))
  (test "the reserved `main` is renamed, so the library can't collide with the entry module"
    (assert= (scaffold/project-module-name "main") "main-lib"))
  (test "a non-ASCII name is not silently mangled into nothing"
    ;; Every character is replaced, but the result is still a usable symbol.
    (is (> (string-length (scaffold/project-module-name "日本")) 0)))
  (test "the derived name is stable"
    (assert= (scaffold/project-module-name "x") (scaffold/project-module-name "x"))))

;; Package identity accessor (ADR-172): resolve a namespace/qualified name → its package,
;; and enrich a stack trace with per-frame :package. `*ns-package*` is bound directly here
;; (no project scan needed to test the pure lookup).
(describe "package identity: ns-package"
  (test "resolves a module name and a qualified name to its owning package"
    (binding (*ns-package* {'widget 'myapp (symbol "editor/display") 'myapp})
      (assert= (ns-package 'widget) 'myapp)
      (assert= (ns-package (symbol "widget/w")) 'myapp)
      (assert= (ns-package (symbol "editor/display/draw")) 'myapp)
      (assert= (ns-package (symbol "unknown/f")) nil)
      (assert= (ns-package 'map) nil)))
  (test "trace-with-packages annotates each frame with :package"
    (binding (*ns-package* {'widget 'myapp})
      (assert= (trace-with-packages (list {:fn "widget/w"} {:fn "map"}))
        (list {:fn "widget/w" :package 'myapp} {:fn "map" :package nil})))))

;; regression: ns-package must tolerate nil (an anonymous / top-level trace frame has no
;; :fn), and trace-with-packages must not crash on such a frame.
(describe "package identity: ns-package handles missing names"
  (test "nil / empty in → nil out (no crash)"
    (assert= (ns-package nil) nil)
    (assert= (ns-package "") nil))
  (test "trace-with-packages tolerates a frame with no :fn"
    (binding (*ns-package* {'widget 'myapp})
      (assert= (trace-with-packages (list {:fn "widget/w"} {:file "x" :line 2}))
        (list {:fn "widget/w" :package 'myapp} {:file "x" :line 2 :package nil})))))

;; Package-rooted namespaces (ADR-070): a release bundle is flat (keyed by require-name),
;; so two source files that would embed under one name are rejected at bundle time — the
;; safety guard that replaces the cross-dep collision check dropped once dev-time rooting
;; made cross-dep collisions impossible. Tested on the cwd-free helper directly.
(describe "bundle: duplicate module names are rejected"
  (test "two providers of one require-name error loudly"
    (is (includes? (try
                     (project/bundle-reject-duplicate-names (list "app" "parser" "lib" "parser"))
                     (catch e e))
          "same module name")))
  (test "distinct require-names pass"
    (assert= (project/bundle-reject-duplicate-names (list "app" "net/sse" "lib")) nil)))

;; ---- the :brood runtime-version gate (ADR-209) -------------------------------
;; A project may require a minimum/compatible runtime with `:brood "<constraint>"`,
;; checked against `(brood-version)` at setup. Met = silent; unmet = a hard, clear
;; error naming the constraint and the running version. We drive `project--check-brood-
;; version` directly by binding the dynvar it reads, so no fixture project or cwd
;; change is needed.

(describe "project: (brood-version)"
  (test "returns this runtime's semantic version as a valid MAJOR.MINOR.PATCH string"
    (require 'version)
    (is (string? (brood-version)))
    (is (version/version-valid? (brood-version)))))

(describe "project: the :brood runtime gate"
  (test "no constraint is a no-op (nothing to satisfy)"
    (binding (*project-brood* nil)
      (assert= nil (project/project-check-brood-version))))
  (test "a satisfied constraint passes silently"
    ;; the running version always satisfies >= 0.0.0
    (binding (*project-brood* ">= 0.0.0")
      (assert= nil (project/project-check-brood-version)))
    (binding (*project-brood* (str "<= " (brood-version)))
      (assert= nil (project/project-check-brood-version))))
  (test "an unmet constraint errors, naming the requirement and the running version"
    (binding (*project-brood* ">= 999.0")
      (let (message (try (project/project-check-brood-version) (catch e (error-message e))))
        (is (includes? message "requires Brood"))
        (is (includes? message ">= 999.0"))
        (is (includes? message (brood-version))))))
  (test "a caret/tilde constraint is honoured like any other range"
    (binding (*project-brood* "^999.0")
      (is (includes? (try (project/project-check-brood-version) (catch e (error-message e)))
            "requires Brood"))))
  (test "a non-string constraint is a clear manifest error"
    (binding (*project-brood* 42)
      (is (includes? (try (project/project-check-brood-version) (catch e (error-message e)))
            "must be a version-constraint string")))))
