;; std/codemod — the CST-backed, context-aware rename behind `nest rename`.
;;
;; The property that matters is LOSSLESSNESS: the rewrite reassembles the file from its
;; CST leaves, so anything that is not a matching symbol token must survive byte-for-byte.
;; A rename wave that corrupts a docstring, a `;` comment, or quoted data is exactly the
;; failure these tests pin down — it happened (a `sed`-style wave rewrote "the offload
;; pool" in prose and clobbered the prelude's own `defn offload` head), which is why the
;; default rename is CST-backed and `--text` is the opt-in escape hatch.

(defmodule codemod-test (:use test) (:use codemod))

(def src
  (str "(defn foo (x) \"doc mentions foo\" (bar x)) ; foo in a comment\n"
    "(quote foo)\n" "(foo 1)\n" "'(foo 2)\n" "(foobar foo)\n" "`(a ~foo ~@foo)\n" "[foo {:k foo}]\n"
    "#{foo}"))

(describe "cst-rename-text — context-aware symbol rewriting"

  (test "an unmatched name leaves the source byte-identical"
    (is (= src (cst-rename-text src "no-such-name" "zap"))))

  (test "a docstring mentioning the name is never rewritten"
    (is (includes? (cst-rename-text src "foo" "zap") "\"doc mentions foo\"")))

  (test "a ; comment mentioning the name is never rewritten"
    (is (includes? (cst-rename-text src "foo" "zap") "; foo in a comment")))

  (test "quoted data is inert by default"
    (let (out (cst-rename-text src "foo" "zap"))
      (is (includes? out "(quote foo)"))
      (is (includes? out "'(foo 2)"))))

  (test ":in-quote opts quoted data in"
    (let (out (cst-rename-text src "foo" "zap" :in-quote))
      (is (includes? out "(quote zap)"))
      (is (includes? out "'(zap 2)"))))

  (test "a longer identifier containing the name is left alone"
    (is (includes? (cst-rename-text src "foo" "zap") "(foobar zap)")))

  (test "ordinary call positions are rewritten"
    (is (includes? (cst-rename-text src "foo" "zap") "(zap 1)")))

  (test "an unquote inside a quasiquote is live code and is rewritten"
    (is (includes? (cst-rename-text src "foo" "zap") "`(a ~zap ~@zap)")))

  (test "vectors, maps and sets are rewritten and keep their delimiters"
    (let (out (cst-rename-text src "foo" "zap"))
      (is (includes? out "[zap {:k zap}]"))
      (is (includes? out "#{zap}"))))

  (test ":refs-only leaves the definition head alone"
    (let (out (cst-rename-text src "foo" "zap" :refs-only))
      (is (includes? out "(defn foo (x)"))
      (is (includes? out "(zap 1)"))))

  (test ":defs-only rewrites only the definition head"
    (let (out (cst-rename-text src "foo" "zap" :defs-only))
      (is (includes? out "(defn zap (x)"))
      (is (includes? out "(foo 1)"))))

  (test "every def head form is recognised for :refs-only"
    (for (head ["defn" "defn-" "def" "def-" "defmacro" "defdyn" "defrecord"])
      (let (text (str "(" head " thing 1)\n(thing)")
            out (cst-rename-text text "thing" "other" :refs-only))
        ;; the definition keeps its name; the reference below moves
        (is (includes? out (str "(" head " thing")))
        (is (includes? out "(other)")))))

  ;; The regression that motivated the whole tool: a wrapper kind whose sigil the
  ;; rewriter did not know silently DELETED itself from the output (`~@` vanished from
  ;; 24 stdlib files). Losslessness over every reader macro is the guard.
  (test "every reader-macro wrapper round-trips"
    (for (form ["'x" "`x" "`(a ~b)" "`(a ~@b)" "^:kw x" "#{a b}" "{:a 1}" "[1 2]"])
      (is (= form (cst-rename-text form "no-such-name" "zap"))))))

(describe "cst-rename-text :swap — a reversed-arguments rename"
  (test "a two-argument call is renamed with its arguments exchanged, nested calls too"
    (assert= (cst-rename-text "(member? x (member? a b))" "member?" "includes?" :swap)
      "(includes? (includes? b a) x)"))
  (test "only a two-argument CALL moves — other arities, references and vectors stay"
    (let (text "(member? a)\n(member? a b c)\n(map member? xs)\n[member? a b]")
      (assert= (cst-rename-text text "member?" "includes?" :swap) text)))
  (test "a comment between the arguments stays where it was"
    (assert= (cst-rename-text "(member? a ; why\n  b)" "member?" "includes?" :swap)
      "(includes? b ; why\n  a)"))
  (test "the name inside a string or comment is not a call"
    (let (text "\"(member? a b)\" ; (member? a b)\n")
      (assert= (cst-rename-text text "member?" "includes?" :swap) text)))
  (test "a byte-string argument moves as one argument"
    (assert= (cst-rename-text "(member? #b\"ab\" x)" "member?" "includes?" :swap)
      "(includes? x #b\"ab\")"))
  (test "quoted data is left alone"
    (let (text "'(member? a b)")
      (assert= (cst-rename-text text "member?" "includes?" :swap) text))))

(describe "rename modes compose"
  (test "--refs-only with --in-quote renames quoted references and leaves the definition"
    (let (out (cst-rename-text "(defn foo (x) x) (foo 1) '(foo 2)"
                "foo"
                "zap"
                [:refs-only :in-quote]))
      (assert= out "(defn foo (x) x) (zap 1) '(zap 2)"))))

;; `nest move`: a definition leaves its module with its sig, its comments and its
;; check-allow, and every reference follows it.
(def move-source
  (str "(defmodule a (:use x))\n\n"
    ";; helps\n(defn- helper (n) n)\n\n"
    ";; the mover\n;; two lines\n(sig mover (int -> int))\n(defn mover (n) (helper n)) ; trailing\n\n"
    "(check-allow :t (defn- quiet (n) (a/mover n)))\n\n" "(defn stays (n) (mover n))\n"))

(describe "move-text"
  (test "the definition goes with its sig and the comments above it; the source keeps the rest"
    (let (moved (move-text move-source "(defmodule b)" ["mover"]))
      (is (includes? (:destination moved) ";; the mover\n;; two lines\n(sig mover (int -> int))"))
      (is (includes? (:destination moved) "(defn mover (n) (a/helper n))"))
      (refute (includes? (:source moved) "(defn mover"))
      (refute (includes? (:source moved) "two lines"))
      (is (includes? (:source moved) ";; helps\n(defn helper (n) n)"))))
  (test "what stays reaches the moved name in its new module"
    (let (moved (move-text move-source "(defmodule b)" ["mover"]))
      (is (includes? (:source moved) "(defn stays (n) (b/mover n))"))
      (is (includes? (:source moved) "(b/mover n)"))))
  (test "a check-allow wrapper moves with its definition, its own references bare"
    (let (moved (move-text move-source "(defmodule b)" ["mover" "quiet"]))
      (is (includes? (:destination moved) "(check-allow :t (defn- quiet (n) (mover n)))"))))
  (test "the helpers left behind are named, and a two-way reach is flagged"
    (let (moved (move-text move-source "(defmodule b)" ["mover"]))
      (assert= (:helpers moved) ["helper"])
      (is (:cycle? moved))))
  (test "a private name the source still reaches is made public"
    (let (moved (move-text "(defmodule a)\n(defn- f (n) n)\n(defn g (n) (f n))\n"
                  "(defmodule b)"
                  ["f"]))
      (is (includes? (:destination moved) "(defn f (n) n)"))))
  (test "the destination's own references to a moved name become bare"
    (let (moved (move-text move-source "(defmodule b)\n(defn user (n) (a/mover n))" ["mover"]))
      (is (includes? (:destination moved) "(defn user (n) (mover n))"))))
  (test "a quoted qualified name — a value a keymap holds — follows the move but stays qualified"
    (let (moved (move-text "(defmodule a)\n(defn f (m) (= (:last m) 'a/f))\n(defn g (m) 'f)"
                  "(defmodule b)"
                  ["f" "g"]))
      (is (includes? (:destination moved) "(defn f (m) (= (:last m) 'b/f))"))
      (is (includes? (:destination moved) "(defn g (m) 'f)"))))
  (test "a comment ending the definition's line goes with it"
    (let (moved (move-text "(defmodule a)\n(defn f (n) n) ; why\n(defn g (n) n)\n"
                  "(defmodule b)"
                  ["f"]))
      (is (includes? (:destination moved) "(defn f (n) n) ; why"))
      (refute (includes? (:source moved) "why"))))
  (test "a name the destination already defines is reported, not defined twice"
    (assert= (:clashing (move-text "(defmodule a)\n(defn f (n) n)"
                          "(defmodule b)\n(defn f (n) (a/f n))"
                          ["f"]))
      ["f"]))
  (test "an :only list naming nothing moved stays as written"
    (assert= (move-references-text "(:use a\n  :only [g\n    h])" "a" "b" ["f"])
      "(:use a\n  :only [g\n    h])"))
  (test "a name not defined at the top is reported missing"
    (assert= (:missing (move-text move-source "(defmodule b)" ["nope"])) ["nope"])))

(describe "move-references-text"
  (test "qualified references follow, quoted ones too; bare ones where the file :uses the module"
    (assert= (move-references-text "(:use a) (f 1) (a/f 2) '(a/f) (g 3)" "a" "b" ["f"])
      "(:use a) (b/f 1) (b/f 2) '(b/f) (g 3)"))
  (test "prose that names it qualified follows too"
    (assert= (move-references-text "(defn h () \"see \\\\[a/f]\") ; a/f here" "a" "b" ["f"])
      "(defn h () \"see \\\\[b/f]\") ; b/f here"))
  (test "a file that does not :use the module keeps its bare names"
    (assert= (move-references-text "(f 1) (a/f 2)" "a" "b" ["f"]) "(f 1) (b/f 2)"))
  (test "a moved name leaves an :only list"
    (assert= (move-references-text "(:use a :only [f g]) (f 1)" "a" "b" ["f"])
      "(:use a :only [g]) (b/f 1)"))
  (test "a file reaching the internals keeps its bare names and gains the new module's"
    (assert= (move-references-text "(defmodule t\n  (:use-internals a))\n(f 1)" "a" "b" ["f"])
      "(defmodule t\n  (:use-internals a)\n  (:use-internals b))\n(f 1)")))

(describe "move-references-text: what a name means in the file it is in"
  (test "a parameter, a pattern or a local that shadows a moved name stays"
    (doseq (form ["(defn g (f) (f 1))"
                   "(defn g ({:keys [f]}) (f))" "(let (f 1) (f))" "(match x (f (f)))"
                   "(doseq (f xs) (f))" "(try 1 (catch f (f)))"])
      (let (text (str "(defmodule z (:use a))\n" form "\n"))
        (assert= (move-references-text text "a" "b" ["f"]) text))))

  (test "beside a shadow, the global still moves, whatever comes before it on the line"
    (assert= (move-references-text "(defmodule z (:use a))\n\"é\" (f) (let (f 1) f) (f)\n"
               "a"
               "b"
               ["f"])
      "(defmodule z (:use a))\n\"é\" (b/f) (let (f 1) f) (b/f)\n"))

  (test "a name this file defines is its own, and so is one `:only` left out"
    (let (own "(defmodule z (:use a))\n(defn f () 1)\n(f)\n")
      (assert= (move-references-text own "a" "b" ["f"]) own))
    (let (only "(defmodule z (:use a :only [g]))\n(f)\n(g)\n")
      (assert= (move-references-text only "a" "b" ["f"]) only)))

  (test "an alias follows"
    (assert= (move-references-text "(defmodule z (:alias a :as m))\n(m/f)\n" "a" "b" ["f"])
      "(defmodule z (:alias a :as m))\n(b/f)\n"))

  (test "a name in a template is code, and in quoted data a value"
    (assert= (move-references-text "(defmodule z (:use a))\n`(f ~x)\n'f\n" "a" "b" ["f"])
      "(defmodule z (:use a))\n`(b/f ~x)\n'f\n"))

  (test "prose follows a qualified name; a longer name, a keyword and a string do not"
    (let (text "(defmodule z)\n;; see a/f, and a/f.\n(defn g () \"a/f is here\" [shop/a/f :a/f \"/a/f\"])\n")
      (assert= (move-references-text text "a" "b" ["f"])
        "(defmodule z)\n;; see b/f, and b/f.\n(defn g () \"b/f is here\" [shop/a/f :a/f \"/a/f\"])\n")))

  (test "a def's string is its value, not a docstring"
    (let (text "(defmodule z)\n(def route \"a/f\")\n")
      (assert= (move-references-text text "a" "b" ["f"]) text))))

(describe "move-text: the moved code and what stays"
  (test "a parameter named like a moved name or a helper stays"
    (let (moved (move-text "(defmodule a)\n(defn helper () 1)\n(defn f (helper) (helper))\n(defn g (f) (f))\n"
                  "(defmodule b)"
                  ["f"]))
      (is (includes? (:destination moved) "(defn f (helper) (helper))"))
      (is (includes? (:source moved) "(defn g (f) (f))"))
      (assert= (:helpers moved) [])))

  (test "a helper a moved macro's template calls is reached through its module"
    (let (moved (move-text "(defmodule a)\n(defn helper (x) x)\n(defmacro m (x) `(helper ~x))\n"
                  "(defmodule b)"
                  ["m"]))
      (is (includes? (:destination moved) "`(a/helper ~x)"))))

  (test "a sig! goes with its definition"
    (let (moved (move-text "(defmodule a)\n(sig! f (int -> int))\n(defn f (x) x)\n"
                  "(defmodule b)"
                  ["f"]))
      (is (includes? (:destination moved) "(sig! f (int -> int))"))
      (refute (includes? (:source moved) "sig!"))))

  (test "a definition sharing a check-allow is named, not moved blind"
    (let (moved (move-text "(defmodule a)\n(check-allow :t (defn x () 1) (defn y () (x)))\n"
                  "(defmodule b)"
                  ["y"]))
      (assert= (:bundled moved) ["y"])))

  (test "blank lines inside a string survive taking a form out"
    (let (moved (move-text "(defmodule a)\n(defn f () 1)\n\n\n\n(def s \"one\n\n\n\ntwo\")\n"
                  "(defmodule b)"
                  ["f"]))
      (is (includes? (:source moved) "\"one\n\n\n\ntwo\"")))))
