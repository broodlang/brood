;; Tests for `std/tool/debug` — the process-native tracing debugger.
;; The whole feature is about processes, so these ARE the cross-process coverage:
;; workers spy/park/span concurrently and fan into one debugger process. Bodies are
;; tail-recursive (green-process stacks are small), concurrent assertions settle via
;; `wait-until` rather than a fixed sleep, and every receive has a deadline.
(defmodule debug-test (:use test) (:use debug) (:use-internals debug))

;; Poll the debugger's state until `pred` holds and return true; raise if it has not
;; within `test/*wait-ms*`.
(defn wait-until (dbg pred)
  (eventually "the debugger's state to settle" (fn () (pred (debugger-state dbg)))))

;; Release every parked step until the stepping worker reports `[:result r]`, and return
;; `r` — or `:timeout` once `deadline` passes.
(defn drive-to-result (dbg deadline)
  (receive
    ([:result r] r)
    (after 5
      (if (> (os/now) deadline)
        :timeout (do (resume-all dbg) (drive-to-result dbg deadline))))))

(defn trace-count (state)
  (count (seq/filter (get state :events) (fn (e) (= (get e :kind) :trace)))))

;; A varying classification most workers agree on, a couple don't (math/mod 5 == 0).
(defn classify (n) (if (= 0 (math/mod n 5)) :flag :ok))

;; A long-lived server with NO debugger wiring — it should handle each request in the
;; sender's causal context, adopted transparently from the message (send-level).
(defn sl-server ()
  (receive
    ([:req n from] (span (str "srv-" n) (fn () (debug/spy (* n n))))
      (send from [:done n])
      (sl-server))
    ([:halt] nil)
    (after test/*wait-ms* nil)))

;; B adopts a context from a message, then spawns a child that reports whether IT sees
;; a debugger — used to prove an adopted context does not leak onward through spawn.
(defn leak-b (reporter)
  (receive
    ([:go] (spawn (send reporter [:child-has (not (nil? (debug/tc-debugger)))])))
    (after test/*wait-ms* nil)))
(defn exit-count (state)
  (count (seq/filter (get state :events) (fn (e) (= (get e :kind) :span-exit)))))

(describe "debugger — no-op when unwired"
  (test "break returns nil and does not block with no *debugger*"
    (assert= nil (break "x" 1 2)))
  (test "span runs its thunk and returns the value with no *debugger*"
    (assert= 42 (span "s" (fn () 42)))))

(describe "debugger — trace fan-in across processes"
  :isolated (test "spy events from many workers fan into one debugger's ordered log"
    (let (dbg (start-debugger) me (self))
      (doseq (i (range 4))
        (let (n i)
          (spawn (with-debugger dbg (fn () (debug/spy (* (inc n) n)) (send me [:done]))))))
      (letrec (drain (fn (k)
                       (if (= k 0)
                         :ok (receive ([:done] (drain (dec k))) (after test/*wait-ms* :timeout)))))
        (assert= :ok (drain 4)))
      (assert= true (wait-until dbg (fn (s) (>= (trace-count s) 4))))
      (stop-debugger dbg))))

(describe "debugger — break parks without a timeout"
  :isolated (test "a parked process shows in :paused and finishes only after resume"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (break "bp" :v 1) (send me [:done]))))
      ;; it parks (no timeout) — confirm before resuming
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      ;; the parked snapshot carries the label + named values
      (let (snap (first (vals (paused dbg))))
        (assert= "bp" (get snap :label))
        (assert= {:v 1} (get snap :vals)))
      ;; only resuming lets it finish
      (resume-all dbg)
      (assert= :done (receive ([:done] :done) (after test/*wait-ms* :timeout)))
      (stop-debugger dbg)))
  (test "many processes park simultaneously and all resume (no single-session limit)"
    (let (dbg (start-debugger) me (self))
      (doseq (i (range 5))
        (let (n i)
          (spawn (with-debugger dbg (fn () (break (str "bp-" n)) (send me [:done]))))))
      (assert= true (wait-until dbg (fn (s) (= 5 (count (get s :paused))))))
      (assert= 5 (resume-all dbg))
      (letrec (drain (fn (k acc)
                       (if (= k 0)
                         acc
                         (receive
                           ([:done] (drain (dec k) (inc acc)))
                           (after test/*wait-ms* acc)))))
        (assert= 5 (drain 5 0)))
      (stop-debugger dbg))))

(describe "debugger — causal tree across processes"
  :isolated (test "span-spawn nests child spans under the parent, on distinct pids"
    (let (dbg (start-debugger))
      (with-debugger dbg
        (fn ()
          (span "root"
            (fn ()
              (doseq (i (range 3)) (let (n i) (span-spawn (str "w" n) (fn () (debug/spy (* n 2))))))
              nil))))
      ;; wait until root + 3 worker spans have all closed
      (assert= true (wait-until dbg (fn (s) (>= (exit-count s) 4))))
      (let (tree (causal-tree dbg))
        (assert= 1 (count tree))
        (let (root (first tree))
          (assert= "root" (get root :label))
          (assert= 3 (count (get root :children)))
          ;; every child ran in a DIFFERENT process than the root
          (let (root-pid (get root :pid)
                child-pids (map (get root :children) (fn (c) (get c :pid))))
            (refute (any? child-pids (fn (p) (= p root-pid)))))))
      ;; `print-causal` renders the same tree as an outline: the root, then its three
      ;; children indented under it, each line tagged with its span's pid.
      (let (lines (seq/reject (string/split (with-out-str (print-causal dbg)) "\n") string/blank?))
        (assert= (count lines) 4)
        (is (string/starts-with? (str (first lines)) "root ["))
        (is (every? (rest lines) (fn (line) (string/starts-with? line "  w")))))
      (stop-debugger dbg))))

(describe "debugger — transparent causal propagation (kernel-propagated *trace-context*)"
  :isolated (test "a PLAIN spawn (no span-spawn, no with-debugger in the child) inherits the context and nests"
    (let (dbg (start-debugger))
      (with-debugger dbg
        (fn ()
          (span "root"
            (fn ()
              (doseq (i (range 3))
                (let (n i) (spawn (span (str "c" n) (fn () (debug/spy (* n 2)))))))
              nil))))
      (assert= true (wait-until dbg (fn (s) (>= (exit-count s) 4))))
      (let (tree (causal-tree dbg))
        (assert= 1 (count tree))
        (let (root (first tree))
          (assert= "root" (get root :label))
          (assert= 3 (count (get root :children)))
          (let (root-pid (get root :pid)
                child-pids (map (get root :children) (fn (c) (get c :pid))))
            (refute (any? child-pids (fn (p) (= p root-pid)))))))
      (stop-debugger dbg)))
  (test "a plain spawn hitting break inherits the debugger and parks — no rewiring"
    (let (dbg (start-debugger) me (self))
      (with-debugger dbg
        (fn () (spawn (do (break "inherited" :x 9) (send me [:done])))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (assert= "inherited" (get (first (vals (paused dbg))) :label))
      (resume-all dbg)
      (assert= :done (receive ([:done] :done) (after test/*wait-ms* :timeout)))
      (stop-debugger dbg))))

(describe "debugger — send-level causality (context follows a message)"
  :isolated (test "a server handles a request in the SENDER's causal context, across processes"
    (let (dbg (start-debugger))
      (let (srv (spawn (sl-server)))
        (with-debugger dbg
          (fn ()
            (span "req"
              (fn ()
                (send srv [:req 6 (self)])
                (receive ([:done _] :ok) (after test/*wait-ms* :timeout))))))
        (assert= true (wait-until dbg (fn (s) (>= (exit-count s) 2))))
        (let (tree (causal-tree dbg))
          (assert= 1 (count tree))
          (let (root (first tree))
            (assert= "req" (get root :label))
            (assert= 1 (count (get root :children)))
            (let (child (first (get root :children)))
              (assert= "srv-6" (get child :label))
              (assert= 36 (get child :value))
              ;; the handler ran in a DIFFERENT process (the server), yet nests under req
              (refute (= (get child :pid) (get root :pid))))))
        (send srv [:halt])
        (stop-debugger dbg)))))

(describe "debugger — an adopted context does not leak onward"
  :isolated (test "a context adopted from a message is NOT propagated to a child the adopter spawns"
    (let (dbg (start-debugger) me (self))
      (let (b (spawn (leak-b me)))
        (with-debugger dbg
          (fn () (span "a" (fn () (send b [:go])))))
        ;; b adopted a's context to handle [:go], but the child it spawns must not see it
        (assert= [:child-has false]
          (receive ([:child-has v] [:child-has v]) (after test/*wait-ms* :timeout)))
        (stop-debugger dbg)))))

(describe "debugger — single-step evaluation"
  :isolated (test "step parks at each spy node; resuming walks through them to the right value"
    (let (dbg (start-debugger) me (self))
      ;; a process that single-steps through (+ (* 2 3) 4) and reports its result
      (spawn (with-debugger dbg (fn () (send me [:result (step (+ (* 2 3) 4))]))))
      ;; it parks at the first node — drive it: resume until it finishes
      (is (eventually "the stepper to park" (fn () (> (count (paused dbg)) 0))))
      ;; stepping is transparent — the expression still yields the right value
      (assert= 10 (drive-to-result dbg (+ (os/now) test/*wait-ms*)))
      (stop-debugger dbg))))

(describe "debugger — eval in a paused process's captured scope"
  :isolated (test "eval-at evaluates an expression against a breakpoint's named locals"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (break "bp" :n 6 :total 10) (send me [:done]))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (assert= 6 (eval-at dbg 1 "n"))
      (assert= 60 (eval-at dbg 1 "(* n total)"))
      (assert= 22 (eval-at dbg 1 "(+ (* n 2) total)"))
      (resume-all dbg)
      (assert= :done (receive ([:done] :done) (after test/*wait-ms* :timeout)))
      (stop-debugger dbg))))

(describe "debugger — aggregate / population queries"
  :isolated (test "value-distribution, modal-value and outliers summarise many workers"
    (let (dbg (start-debugger) me (self))
      (doseq (i (range 10))
        (let (n i)
          (spawn (with-debugger dbg (fn () (debug/spy (classify n)) (send me [:done]))))))
      (letrec (drain (fn (k)
                       (if (= k 0)
                         :ok (receive ([:done] (drain (dec k))) (after test/*wait-ms* :timeout)))))
        (assert= :ok (drain 10)))
      (assert= true (wait-until dbg (fn (s) (>= (trace-count s) 10))))
      ;; n = 0..9: mod 5 == 0 for 0 and 5 -> two :flag, eight :ok
      (assert= {:flag 2 :ok 8} (value-distribution dbg "(classify n)"))
      (assert= :ok (modal-value dbg "(classify n)"))
      (assert= 2 (count (outliers dbg "(classify n)")))
      (stop-debugger dbg))))

(describe "debugger — data-driven breakpoints"
  :isolated (test "break-when parks only when its predicate holds"
    (let (dbg (start-debugger) me (self))
      ;; false predicate -> no park, worker runs straight through
      (spawn (with-debugger dbg (fn () (break-when false "no" :x 1) (send me [:passed]))))
      (assert= :passed (receive ([:passed] :passed) (after test/*wait-ms* :timeout)))
      ;; true predicate -> parks until resumed
      (spawn (with-debugger dbg (fn () (break-when true "yes" :x 2) (send me [:passed2]))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (resume-all dbg)
      (assert= :passed2 (receive ([:passed2] :passed2) (after test/*wait-ms* :timeout)))
      (stop-debugger dbg))))

;; A module-level target for the trace-fn/break-fn tests: instrumentation rebinds a
;; GLOBAL by name, so the subject must be one (a let-local has no name to rebind).
(defn tfn-square (n) (* n n))
(defn tfn-add (a b) (+ a b))
(defn tfn-redef (x) (* x 10)) ; redefined under a trace by the untrace-fn test
(defn tfn-rewrap (x) (* x 10)) ; redefined under a trace, then traced again
(defn tfn-held (x) (inc x)) ; held and released by the trace-hold test
(defn tfn-broken-twice (x) (inc x)) ; break-fn'd twice over
(describe "debugger — function-boundary instrumentation (trace-fn / break-fn)"
  :isolated (test "trace-hold counts holders, trace-holds shows them, the last release untraces"
    (trace-hold 'debug-test/tfn-held)
    (trace-hold 'debug-test/tfn-held)
    (assert= (get (trace-holds) 'debug-test/tfn-held) 2)
    (assert= (trace-release 'debug-test/tfn-held) 1)
    (assert= (trace-release 'debug-test/tfn-held) 0)
    (is (nil? (get (trace-holds) 'debug-test/tfn-held)))
    (assert= (tfn-held 1) 2))
  :isolated (test "trace-fn emits :call and :return through *spy-sink* and is value-transparent"
    (let (me (self))
      (trace-fn 'debug-test/tfn-square)
      (let (r (binding (*spy-sink* (fn (e) (send me [:spy-entry e])))
                (tfn-square 7)))
        (assert= 49 r)
        (let (call (receive ([:spy-entry e] e) (after test/*wait-ms* :timeout))
              ret (receive ([:spy-entry e] e) (after test/*wait-ms* :timeout)))
          (assert= :call (get call :spy))
          (assert= 'debug-test/tfn-square (get call :fn))
          (assert= (list 7) (get call :args))
          (assert= :return (get ret :spy))
          (assert= 49 (get ret :value))))
      (untrace-fn 'debug-test/tfn-square)))
  (test "untrace-fn restores the original — the sink sees nothing afterwards"
    (let (me (self))
      (trace-fn 'debug-test/tfn-add)
      (untrace-fn 'debug-test/tfn-add)
      (assert= 5
        (binding (*spy-sink* (fn (e) (send me [:spy-entry e])))
          (tfn-add 2 3)))
      (assert= :quiet (receive ([:spy-entry e] e) (after 50 :quiet)))))
  (test "a function redefined WHILE traced keeps its redefinition through untrace-fn"
    ;; The restore used to put the pre-trace body back over whatever was live, which
    ;; discarded an edit made under the trace — silently. Now it restores only when the
    ;; wrapper is still what is bound.
    (do
      (trace-fn 'debug-test/tfn-redef)
      (reflect/eval '(defn debug-test/tfn-redef (x) (* x 100)))
      (untrace-fn 'debug-test/tfn-redef)
      (assert= 300 (tfn-redef 3))
      (refute (includes? (traced-fns) 'debug-test/tfn-redef))))
  (test "trace-fn on a name redefined under its trace re-wraps the NEW body"
    (let (me (self))
      (trace-fn 'debug-test/tfn-rewrap)
      (reflect/eval '(defn debug-test/tfn-rewrap (x) (* x 1000)))
      (refute (traced-current? 'debug-test/tfn-rewrap)) ; the generation moved
      (trace-fn 'debug-test/tfn-rewrap)
      (is (traced-current? 'debug-test/tfn-rewrap))
      (assert= 3000
        (binding (*spy-sink* (fn (e) (send me [:spy-entry e])))
          (tfn-rewrap 3)))
      ;; drain BOTH entries — an isolated describe shares one process across its tests,
      ;; and a `:call` left in the mailbox would surface in the next test's receive
      ;; `test/*wait-ms*`: both WAIT for an entry that is expected, so the timeout is a
      ;; failure deadline. (The `:quiet` assertions elsewhere in this file stay short —
      ;; those prove ABSENCE, where a short wait is the whole point.)
      (assert= '(3) (receive ([:spy-entry {:spy :call :args a}] a) (after test/*wait-ms* :none)))
      (assert= 3000
        (receive ([:spy-entry {:spy :return :value v}] v) (after test/*wait-ms* :none)))
      (untrace-fn 'debug-test/tfn-rewrap)
      (assert= 3000 (tfn-rewrap 3)))) ; the redefinition is what remains
  (test "REGRESSION: a REFUSED trace registers nothing, so teardown stays clean"
    ;; `list` passes every check trace-fn makes (it is a function) and is still refused
    ;; at the rebind — it is a reserved prelude name (E0030, ADR-166). The registry used
    ;; to be written before that refusal, so the name was left listed as traced while it
    ;; wasn't: `untrace-all` then raised the same refusal, out of a caller that had
    ;; already handled the failed install. That is how a speculative trace list (an
    ;; editor tracing whatever a snippet calls) killed an unrelated evaluation.
    (do
      (assert-error (trace-fn 'list))
      (refute (includes? (traced-fns) 'list))
      (assert= 0 (untrace-all)))) ; nothing to restore, and it doesn't raise
  (test "untrace-all is not stopped by one stubborn entry"
    ;; teardown must leave nothing instrumented even if a restore fails: a poisoned
    ;; registry entry (planted here the way the old trace-fn planted one) must not
    ;; strand the real traces after it.
    (do
      (trace-fn 'debug-test/tfn-square)
      (def debug/*traced-fns* (assoc debug/*traced-fns* 'list (fn (& args) args)))
      (untrace-all)
      (assert= 0 (count (seq/filter (traced-fns) (fn (s) (= s 'debug-test/tfn-square)))))
      ;; and `list` still means what Brood says it means
      (assert= (list 1 2) '(1 2))))

  (test "re-tracing is idempotent: the registry keeps the ORIGINAL, not a wrapper"
    (do
      (trace-fn 'debug-test/tfn-add)
      (trace-fn 'debug-test/tfn-add) ; twice — must not stack wrappers
      (untrace-fn 'debug-test/tfn-add)
      (let (me (self))
        (assert= 5
          (binding (*spy-sink* (fn (e) (send me [:spy-entry e])))
            (tfn-add 2 3)))
        (assert= :quiet (receive ([:spy-entry e] e) (after 50 :quiet))))))
  (test "traced-fns lists the instrumented names; untrace-all clears them"
    (do
      (trace-fn 'debug-test/tfn-square)
      (trace-fn 'debug-test/tfn-add)
      (assert= 2 (count (traced-fns)))
      (assert= 2 (untrace-all))
      (assert= 0 (count (traced-fns)))))
  (test "break-fn parks the caller with :args in scope for eval-at, then delegates"
    (let (dbg (start-debugger) me (self))
      (break-fn 'debug-test/tfn-square)
      (spawn (with-debugger dbg (fn () (send me [:result (tfn-square 6)]))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      ;; the snapshot: label = the fn name, :args = the argument list
      (let (snap (second (first (vec (paused dbg)))))
        (assert= "debug-test/tfn-square" (get snap :label))
        (assert= (list 6) (get (get snap :vals) :args)))
      (assert= (list 6) (eval-at dbg 1 "args"))
      (resume-all dbg)
      (assert= 36 (receive ([:result r] r) (after test/*wait-ms* :timeout)))
      (untrace-fn 'debug-test/tfn-square)
      (stop-debugger dbg)))
  ;; Two debug sessions breaking one function (two DAP clients, or one setting its
  ;; breakpoints again) wrapped the first wrapper: a call parked twice, and the second park
  ;; had no one to resume it.
  (test "breaking a name twice parks a call once"
    (let (dbg (start-debugger) me (self))
      (break-fn 'debug-test/tfn-broken-twice)
      (break-fn 'debug-test/tfn-broken-twice)
      (spawn (with-debugger dbg (fn () (send me [:result (tfn-broken-twice 4)]))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (resume-all dbg)
      (assert= 5 (receive ([:result r] r) (after test/*wait-ms* :timeout)))
      (untrace-fn 'debug-test/tfn-broken-twice)
      (assert= 0 (count (seq/filter (traced-fns) (fn (s) (= s 'debug-test/tfn-broken-twice)))))
      (stop-debugger dbg))))

;; A tail-recursive countdown, as a GLOBAL so trace-fn has a name to rebind. The
;; self-call is the last thing the (n) clause does, so untraced this runs in constant
;; stack at any depth — which is exactly what the tracer must not take away.
(defn tfn-countdown
  ((0) :liftoff)
  ((n) (tfn-countdown (- n 1))))

;; A sink bounded to `cap` entries, answering `:spy-stop` once it is full — the
;; bounded-sink contract from `*spy-sink*`, and what every display sink should do.
(defn bounded-sink (acc cap)
  (fn (e)
    (let (n (or (table/get acc :n) 0))
      (if (< n cap)
        (do
          (table/put acc :n (inc n))
          (table/put acc :entries (cons e (or (table/get acc :entries) '())))
          (when (>= (inc n) cap) :spy-stop))
        :spy-stop))))

(describe "trace-fn — a sink that says when it is full stops costing the traced program"
  :isolated (test "`:spy-stop` ends the trace: the sink sees its budget and not one entry more"
    (let (acc (table/new))
      (trace-fn 'debug-test/tfn-countdown)
      (assert= :liftoff
        (binding (*spy-sink* (bounded-sink acc 10))
          (tfn-countdown 5000)))
      (untrace-fn 'debug-test/tfn-countdown)
      (assert= 10 (table/get acc :n))
      ;; every kept entry is a :call — a stopped tracer delegates in tail position, so
      ;; there is no :return to emit (and for a tail call there never was one to see)
      (assert= 10 (count (seq/filter (table/get acc :entries) (fn (e) (= :call (:spy e))))))
      (table/drop acc)))
  (test "REGRESSION: a traced tail loop deeper than the VM's frame limit still returns"
    ;; The wrapper emits `:return` AFTER the call, so a traced self-call is no longer a
    ;; tail call and each level costs a frame: this loop used to die at ~1 048 576 with
    ;; `recursion too deep`, and a tutorial box teaching "tail calls run in constant
    ;; stack" was the thing that broke. Past the sink's budget the wrapper delegates in
    ;; tail position, so the depth below is only bounded by patience.
    (let (acc (table/new))
      (trace-fn 'debug-test/tfn-countdown)
      (assert= :liftoff
        (binding (*spy-sink* (bounded-sink acc 50))
          (tfn-countdown 1200000)))
      (untrace-fn 'debug-test/tfn-countdown)
      (assert= 50 (table/get acc :n))
      (table/drop acc)))
  (test "a sink that never stops still gets its :return entries (the default contract)"
    (let (me (self))
      (trace-fn 'debug-test/tfn-square)
      (assert= 81
        (binding (*spy-sink* (fn (e) (send me [:spy-entry e]) nil))
          (tfn-square 9)))
      (untrace-fn 'debug-test/tfn-square)
      (assert= :call (:spy (receive ([:spy-entry e] e) (after test/*wait-ms* :timeout))))
      (assert= :return (:spy (receive ([:spy-entry e] e) (after test/*wait-ms* :timeout)))))))

(describe "debugger — step parks carry an eval-at-able :vals map"
  :isolated (test "eval-at resolves `value` at a step park (the :vals shape matches break's)"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (send me [:result (step (* 2 3))]))))
      (is (eventually "the stepper to park" (fn () (> (count (paused dbg)) 0))))
      ;; the first parked node's value is in scope as `value`
      (let (v (eval-at dbg 1 "value"))
        (is (int? v)))
      ;; drive the remaining steps to completion
      (assert= 6 (drive-to-result dbg (+ (os/now) test/*wait-ms*)))
      (stop-debugger dbg))))

;; The `,resume` / `,step` REPL meta-command handlers (driven by `pry` through the REPL
;; command registry). They read the debugger from the `debug/*session*` dynamic that
;; `pry` binds, so the tests bind it the same way and call the handlers directly —
;; `pry` itself needs a TTY (`run`), which a test can't provide.
(describe "debugger — ,resume / ,step meta-command handlers"
  :isolated (test "no active session is a friendly no-op, not a crash"
    ;; debug/*session* defaults to nil; the handler must tolerate that
    (assert= nil (debug/debug-repl-resume ""))
    (assert= nil (debug/debug-repl-step "")))

  (test ",resume with no arg releases every parked process"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (break "a" :x 1) (send me [:done :a]))))
      (spawn (with-debugger dbg (fn () (break "b" :x 2) (send me [:done :b]))))
      (assert= true (wait-until dbg (fn (s) (= 2 (count (get s :paused))))))
      (binding (debug/*session* dbg) (debug/debug-repl-resume ""))
      (assert= true (wait-until dbg (fn (s) (= 0 (count (get s :paused))))))
      (stop-debugger dbg)))

  (test ",resume N releases only the Nth parked process"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (break "a" :x 1) (send me [:done :a]))))
      (spawn (with-debugger dbg (fn () (break "b" :x 2) (send me [:done :b]))))
      (assert= true (wait-until dbg (fn (s) (= 2 (count (get s :paused))))))
      (binding (debug/*session* dbg) (debug/debug-repl-resume "1"))
      ;; exactly one released — the queue drops to a single parked process
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (binding (debug/*session* dbg) (debug/debug-repl-resume ""))
      (assert= true (wait-until dbg (fn (s) (= 0 (count (get s :paused))))))
      (stop-debugger dbg)))

  (test ",step advances a single parked process"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (break "a" :x 1) (send me [:done :a]))))
      (spawn (with-debugger dbg (fn () (break "b" :x 2) (send me [:done :b]))))
      (assert= true (wait-until dbg (fn (s) (= 2 (count (get s :paused))))))
      (binding (debug/*session* dbg) (debug/debug-repl-step ""))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (binding (debug/*session* dbg) (debug/debug-repl-resume ""))
      (stop-debugger dbg))))

;; Path B (ADR-174): `break` auto-captures EVERY in-scope local via the `%scope`
;; compiler intrinsic, so `eval-at` evaluates against the full local scope — not just the
;; values named at the breakpoint. This is the flagship debugger gap the roadmap named.
(defn pb-worker (a b done)
  ;; params a,b + a couple of lets, none named at the break — all must be reachable
  ;; from eval-at. They're referenced after the break (a realistic breakpoint), so the
  ;; checker sees them used while the point stands: eval-at reaches them without them
  ;; being passed to `break`.
  (let (sum (+ a b) prod (* a b))
    (break "pb")
    (send done [:result sum prod])))

(describe "debugger — path B: automatic local capture via %scope"
  :isolated (test "eval-at reaches locals that were NOT named at break (params + lets)"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (pb-worker 3 4 me))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      ;; none of these were passed to `break`, yet they resolve
      (assert= 3 (eval-at dbg 1 "a"))
      (assert= 4 (eval-at dbg 1 "b"))
      (assert= 7 (eval-at dbg 1 "sum"))
      (assert= 12 (eval-at dbg 1 "prod"))
      ;; and a computed expression over several of them
      (assert= 84 (eval-at dbg 1 "(* sum prod)"))
      (resume-all dbg)
      (assert= [:result 7 12]
        (receive ([:result s p] [:result s p]) (after test/*wait-ms* :timeout)))
      (stop-debugger dbg)))

  (test "an explicitly-named val overrides a captured local of the same name"
    ;; :a is passed as 99, shadowing the local a=3 in the snapshot
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (let (a 3) (break "ov" :a 99) (send me [:done a])))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (assert= 99 (eval-at dbg 1 "a"))
      (resume-all dbg)
      (stop-debugger dbg)))

  (test "break-when auto-captures scope too (only when the predicate holds)"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (let (x -5) (break-when (< x 0) "neg") (send me [:ok])))))
      (assert= true (wait-until dbg (fn (s) (= 1 (count (get s :paused))))))
      (assert= -5 (eval-at dbg 1 "x"))
      (resume-all dbg)
      (stop-debugger dbg)))

  (test "break-when does NOT park when the predicate is false"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg (fn () (let (x 5) (break-when (< x 0) "neg") (send me [:ok])))))
      ;; it should reach :ok without ever parking
      (assert= [:ok] (receive ([:ok] [:ok]) (after test/*wait-ms* :timeout)))
      (assert= 0 (count (paused dbg)))
      (stop-debugger dbg))))

;; `(proc/flag :no-break true)` — infrastructure other processes wait on (a buffer process,
;; a registry) must never park: whoever asked it something would freeze, and nothing could
;; resume it. bedit's breakpoints parked its own buffer processes until this existed.
(describe "debugger — a :no-break process passes a breakpoint"
  :isolated (test "with a debugger in context, it runs straight through"
    (let (dbg (start-debugger) me (self))
      (spawn (with-debugger dbg
               (fn () (proc/flag :no-break true) (break "bp" :v 1) (send me [:done]))))
      (assert= :done (receive ([:done] :done) (after test/*wait-ms* :parked)))
      (assert= 0 (count (paused dbg)))
      (stop-debugger dbg)))
  (test "the flag reads back, and is off by default"
    (let (me (self))
      (spawn (send me [:default (proc/flag :no-break)]))
      (assert= false (receive ([:default v] v) (after test/*wait-ms* :timeout)))
      (spawn (do (proc/flag :no-break true) (send me [:set (proc/flag :no-break)])))
      (assert= true (receive ([:set v] v) (after test/*wait-ms* :timeout))))))
