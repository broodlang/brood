;; std/io.blsp — output ports: the redirectable sink behind print/println.
;; Verifies that `with-out`/`with-err` reroute the prelude's print/println to a
;; port, that the default ports are unchanged (so `with-out-str` still captures),
;; and that a `process-port` carries output across a process boundary as
;; `[:write s]` (the buffer/editor path). Register-only — `nest test` discovers it.

(defmodule io-test (:use test) (:use io :exclude [inspect]))

;; A record with BOTH a Display and an Inspect impl — the pair the writers must keep
;; distinct (`puts` shows the display form, `inspect` the debug form).
(defrecord money (amount))
(impl Display money (->string [m] (str "$" (get m :amount))))
(impl Inspect money (inspect [m] (str "#money<$" (get m :amount) ">")))

(describe "io: ports reroute print/println"
  ;; These send to (self) and receive — no globals, no spawn — so they can run in
  ;; parallel with the rest of the suite.
  (test "with-out routes println to a process-port"
    (let (me (self))
      (with-out (process-port me) (io/puts "hi"))
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "hi\n")))

  (test "with-out routes print (no newline) and joins args with spaces"
    (let (me (self))
      (with-out (process-port me) (io/write "a" "b" 42))
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "a b 42")))

  (test "fn-port hands each written string to a callback"
    (let (me (self))
      (with-out (fn-port (fn (s) (send me [:write s]))) (io/puts "cb"))
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "cb\n")))

  (test "write writes a string straight to a port"
    (let (me (self))
      (emit (process-port me) "direct")
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "direct")))

  (test "with-err reroutes eprintln"
    (let (me (self))
      (with-err (process-port me) (io/puts "err" :to *err*))
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "err\n"))))

(describe "io: the prelude defaults are untouched"
  (test "with-out-str still captures stdout (regression for the print rewire)"
    (assert= (with-out-str (io/puts "x")) "x\n"))

  (test "with-out restores the previous port on exit"
    (let (me (self))
      (with-out (process-port me) (io/puts "redirected"))
      ;; the redirect is over; the default (capturable) port is back
      (assert= (with-out-str (io/puts "back")) "back\n")))

  (test "with-out restores even when the body throws"
    (let (me (self))
      ;; check-allow :discarded-catch — a did-it-throw assertion: the caught error is the answer
      (check-allow :discarded-catch (try (with-out (process-port me) (throw "boom")) (catch e nil)))
      (assert= (with-out-str (io/puts "after-throw")) "after-throw\n"))))

;; ---- the Port ability -------------------------------------------------------
;; `write` is an ability op, so a port is any value with an impl: a bare 1-arg fn
;; (the original representation, kept working by the `:fn` impl) or a record that
;; carries its target and prints as itself.

(describe "io: ports are Port impls"
  (test "a bare 1-arg fn is a port"
    (let (me (self))
      (emit (fn (s) (send me [:write s])) "raw fn")
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "raw fn")))
  (test "port? is true for a fn port and for each port record"
    (is (port? (fn (s) s)))
    (is (port? (stdout-port)))
    (is (port? (stderr-port)))
    (is (port? (process-port (self))))
    (is (port? (file-port "/tmp/nonexistent"))))
  (test "port? is false for a value that cannot be written to"
    (is (not (port? 42)))
    (is (not (port? "a string")))
    (is (not (port? {:not :a-port}))))
  (test "a port record prints as itself, not as a field map"
    (assert= (->string (stdout-port)) "#<port stdout>")
    (assert= (->string (stderr-port)) "#<port stderr>")
    (assert= (->string (file-port "/tmp/x.log")) "#<port file /tmp/x.log>")
    (is (includes? (->string (process-port (self))) "#<port process ")))
  (test "a stdout port record still routes through the capture stack"
    (assert= (with-out-str (emit (stdout-port) "captured")) "captured"))
  (test "port-fn adapts a record port to the bare fn *out* holds"
    (let (me (self)
          f (port-fn (process-port me)))
      (is (fn? f))
      (f "adapted")
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "adapted")))
  (test "port-fn passes a fn port straight through"
    (let (f (fn (s) s))
      (is (= (port-fn f) f)))))

;; A port defined *outside* std/io — the point of the ability. `counting-port` wraps
;; another port and rewrites what is written, with no change to io.blsp.
(defrecord counting-port (target))
(impl Port
  io-test/counting-port
  ;; The op is `emit` — `write` is the caller-facing function now.
  (emit [p s] (emit (get p :target) (str "[" (string/length s) "] " s))))

(describe "io: a third-party port type"
  (test "a record from another module is a port once it impls Port"
    (is (port? (counting-port (stdout-port))))
    (assert= (with-out-str (emit (counting-port (stdout-port)) "abc")) "[3] abc"))
  (test "with-out installs a third-party port like any other"
    (let (me (self))
      (with-out (counting-port (process-port me)) (io/write "xy"))
      (assert= (receive ([:write s] s) (after *test-wait-ms* :timeout)) "[2] xy")))
  (test "a value with no Port impl raises the named ability error"
    (assert-error (emit 42 "nope"))))

;; The DEFAULT `*out*`/`*err*` are the primitives `%write-out`/`%write-err`, whose
;; `type-of` is `:native` — not `:fn`. `Port` only had a `:fn` impl, so `io/port?` was
;; false for the two ports the language ships with, `(io/puts … :to *err*)` declined the
;; target, and the port leaked into the output as `:to #<native %write-err>`.
;;
;; Every existing test passed through it: `with-err-str` rebinds `*err*` to a Brood
;; closure, which IS `:fn`. The default was the broken case and nothing exercised it.
(describe "the shipped ports are ports"

  (test "the default *out* and *err* satisfy Port"
    (is (io/port? *out*))
    (is (io/port? *err*)))

  (test "a native port is a valid :to target, and does not leak into the output"
    ;; Routed through a capture so the assertion sees what a real stderr write would say.
    (let (captured (with-err-str (io/puts "routed" :to *err*)))
      (is (includes? captured "routed"))
      (is (not (includes? captured ":to")))))

  (test "a Brood closure port still works — the case that always passed"
    (is (io/port? (fn (s) s)))))

;; The three writers, as chosen: `write` is raw, `puts` adds the newline, `inspect` shows
;; the re-readable form. `write` is the CALLER's name; the port ability's seam is `emit`,
;; so a name a user reaches for is not spent on the implementor's side of the contract.
(describe "io/write, io/puts, io/inspect"

  (test "write adds no newline; puts does"
    ;; `%render` space-joins, so two values render as "a b" — `write` differs from
    ;; `puts` only in the trailing newline, not in the separator.
    (assert= "a b" (with-out-str (io/write "a" "b")))
    (assert= "a b\n" (with-out-str (io/puts "a" "b"))))

  (test "inspect shows the re-readable form, where puts shows the display form"
    ;; The whole point of the pair: a string with an escape prints as two lines through
    ;; `puts` and as its source form through `inspect`.
    (assert= "a\nb\n" (with-out-str (io/puts "a\nb")))
    (assert= "\"a\\nb\"\n" (with-out-str (io/inspect "a\nb"))))

  ;; `*show*` is a DISPLAY transform (it renders a record through `Display`), so it must
  ;; not run on the inspect path: applying it first flattened the record to its `Display`
  ;; string before `inspect-render` could ask the `Inspect` ability, and a custom `inspect`
  ;; impl could never be seen — `#money<$5>` came out as `"$5"`. Guards that ordering.
  (test "inspect honors an Inspect impl, and puts still honors Display"
    (assert= "#money<$5>\n" (with-out-str (io/inspect (io-test/money 5))))
    (assert= "$5\n" (with-out-str (io/puts (io-test/money 5)))))

  (test "all three take a :to port"
    (let (buf (with-err-str (io/write "w" :to *err*)
                (io/puts "p" :to *err*)
                (io/inspect "i" :to *err*)))
      (is (includes? buf "w"))
      (is (includes? buf "p"))
      (is (includes? buf "\"i\""))))

  (test "emit is the port seam, and it is not `write`"
    ;; `write` used to be the ability op, which is what forced the caller-facing function
    ;; to be named `print`. Pinning the split so it cannot silently swap back.
    (is (bound? 'io/emit))
    (is (bound? 'io/write))
    (assert= "direct" (with-out-str (emit (fn (s) (io/write s)) "direct")))))
