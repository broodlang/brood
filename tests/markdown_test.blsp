;; std/markdown — the Markdown renderer, tested where it lives. The cases moved here with
;; the function from `docs_test.blsp` (ADR-356); `docs_test` keeps the guide-page cases that
;; exercise the generator's use of it.
(defmodule markdown-test (:use test) (:use markdown))

(describe "markdown/->html"
  (test "the subset renders"
    (assert= (->html "# Hi") "<h1>Hi</h1>")
    (is (includes? (->html "a `b` c") "<code>b</code>"))
    (is (includes? (->html "see [x](/y)") "<a href=\"/y\">x</a>"))
    (is (includes? (->html "- one\n- two") "<li>one</li>"))
    (is (includes? (->html "```\n(+ 1 2)\n```") "<pre><code>(+ 1 2)</code></pre>")))

  (test "everything is escaped"
    (is (includes? (->html "a <b> c") "&lt;b&gt;")))

  (test "an unterminated link is text, not a crash"
    (assert= (->html "a [b c") "<p>a [b c</p>")
    (assert= (->html "cost $[5 today") "<p>cost $[5 today</p>"))

  ;; The reason this is a core module: an app renders at request time on a runtime that
  ;; carries no developer tooling — so it must not live in one.
  (test "it is a CORE module, present on every runtime"
    (is (includes? (reflect/builtin-modules) "markdown"))))

(describe "markdown/->html — the README subset"
  (test "strong and emphasis, with arithmetic and identifiers left alone"
    (assert= (->html "a **b** c *d*") "<p>a <strong>b</strong> c <em>d</em></p>")
    (assert= (->html "2 * 3 * 4") "<p>2 * 3 * 4</p>")
    (assert= (->html "x_y_z **open") "<p>x_y_z **open</p>")
    (assert= (->html "**see [x](/y)**") "<p><strong>see <a href=\"/y\">x</a></strong></p>"))

  (test "an angle-bracket URL is a link; a tag or a placeholder is text"
    (assert= (->html "at <https://a.b/c>.")
      "<p>at <a href=\"https://a.b/c\">https://a.b/c</a>.</p>")
    (assert= (->html "<b>x</b> <your token>") "<p>&lt;b&gt;x&lt;/b&gt; &lt;your token&gt;</p>")
    (assert= (->html "<javascript:alert(1)>") "<p>&lt;javascript:alert(1)&gt;</p>"))

  (test "ordered lists, continued items, and a list that resumes after a code block"
    (assert= (->html "1. one\n2. two\n   more") "<ol><li>one</li><li>two more</li></ol>")
    (assert= (->html "1. one\n\n   ```\n   code\n   ```\n\n2. two")
      "<ol><li>one</li></ol><pre><code>code</code></pre><ol start=\"2\"><li>two</li></ol>"))

  (test "h4, quotes and rules"
    (assert= (->html "#### D") "<h4>D</h4>")
    (assert= (->html "> a\n> b") "<blockquote><p>a b</p></blockquote>")
    (assert= (->html "a\n\n---\n\nb") "<p>a</p><hr><p>b</p>")))

(describe "markdown/->html — indented code"
  (test "four spaces after a blank line is code, dedented, blank lines inside kept"
    (assert= (->html "p\n\n    (a)\n\n      (b)\n\nq")
      "<p>p</p><pre><code>(a)\n\n  (b)</code></pre><p>q</p>"))

  (test "fewer than four is prose by default; :code-indent lowers the bar"
    (assert= (->html "p\n\n  (a)") "<p>p</p><p>  (a)</p>")
    (assert= (->html "p\n\n  (a)" {:code-indent 1}) "<p>p</p><pre><code>(a)</code></pre>"))

  (test "an indented line inside a paragraph or list is not code"
    (assert= (->html "a\n    b") "<p>a     b</p>")
    (assert= (->html "- a\n    b") "<ul><li>a b</li></ul>")))
