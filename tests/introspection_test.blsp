;; Introspection primitives for editor tooling (ADR-025; docs/lsp.md):
;; doc, arglist, global-names, bound?. Register-only — discovered and run by
;; `brood test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule introspection-test (:use test))

;; Load the subsystem modules whose members the discovery tests below look up
;; (apropos / all-globals / doc-search / bound? see a name only once its module is loaded).
;; Referencing the function *values* auto-requires the module without calling them.
(do rand/int rand/float term/raw-enter gui/open node/connect nil)

(describe "docstrings"
  (test "a leading string is a docstring when more body follows"
    (defn squared (x) "Return x times itself." (* x x))
    (assert= (doc squared) "Return x times itself.")
    ;; …and it is stripped from the body, not evaluated/returned.
    (assert= (squared 4) 16))
  (test "a lone string body is the return value, not a docstring"
    (defn greeting (who) "hello")
    (assert= (doc greeting) nil)
    (assert= (greeting 'x) "hello"))
  (test "macros carry docstrings too"
    (defmacro bump (x) "Add one." `(+ ~x 1))
    (assert= (doc bump) "Add one."))
  (test "a function with a destructured parameter keeps its docstring"
    (defn add-pair ([x y]) "Sum a 2-vector." (+ x y))
    (assert= (doc add-pair) "Sum a 2-vector.")
    ; was dropped by the fn-lowering path
    (assert= (add-pair [3 4]) 7))
  ; …and the doc isn't returned/evaluated
  (test "a multi-clause defn keeps its (leading) docstring"
    (defn sign "Describe a number's sign."
      ((0) :zero)
      ((n) :when (> n 0) :positive)
      ((n) :negative))
    (assert= (doc sign) "Describe a number's sign.")
    (assert= (list (sign -3) (sign 0) (sign 9)) (list :negative :zero :positive)))
  (test "doc of a non-function is nil" (assert= (doc 42) nil) (assert= (doc "a string") nil)))

(describe "arglist"
  (test "required params" (defn pair (a b) (list a b)) (assert= (arglist pair) '(a b)))
  (test "&optional params are listed after a marker"
    (defn opt (a &optional (b 10)) (+ a b))
    (assert= (arglist opt) '(a &optional b)))
  (test "& rest is reconstructed"
    (defn variadic (a b & more) a)
    (assert= (arglist variadic) '(a b & more)))
  (test "arglist of a non-function is nil" (assert= (arglist 42) nil)))

(describe "global table introspection"
  (test "bound? reflects the global table"
    (defn a-defined-name () nil)
    (is (bound? 'introspection-test/a-defined-name))
    (is (bound? 'map))
    ; a prelude binding
    (refute (bound? 'definitely-not-bound-xyz)))
  (test "bound? wants a symbol" (assert-error (bound? 42)))
  (test "global-names includes prelude and user definitions"
    (defn another-name () nil)
    (is (includes? (reflect/global-names) 'map))
    (is (includes? (reflect/global-names) 'introspection-test/another-name))))

;; source-location (ADR-031; docs/lsp.md §Cross-file): loading a file records
;; where each *top-level* def/defn/defmacro was defined, so tooling can answer
;; cross-file goto-definition by querying the running image. `sl-subject` must be
;; top-level (a nested def inside a `test` block isn't recorded — by design).
(defn sl-subject (x) (* x x))
;; Sends the parent its own view of the site, to prove a spawned process sees the
;; same shared def-site table (it lives in the runtime code region, like globals).
(defn sl-worker (parent) (send parent (reflect/source-location 'introspection-test/sl-subject)))

(describe "source-location (cross-file def sites)"
  (test "records a top-level defn's site in this file"
    (let (loc (reflect/source-location 'introspection-test/sl-subject))
      (refute (nil? loc))
      (is (vector? loc))
      (assert= (count loc) 3)
      ; [file line col]
      (is (string? (first loc)))
      ; the file it was loaded from
      (is (int? (first (rest loc))))))
  ; the line
  (test "a prelude global resolves to the materialised prelude file"
    ;; Prelude defns have a recorded site (the unpacked stdlib copy).
    ;; What stays `nil`: a Rust builtin (no .blsp source) or an unknown
    ;; name.
    (let (loc (reflect/source-location 'map))
      (is (vector? loc))
      (is (string? (first loc))))
    (assert= (reflect/source-location 'no-such-name-xyz) nil))
  (test "the site is visible from a spawned process (shared runtime code)"
    (let (me (self) _w (spawn (sl-worker me)))
      ;; the worker's copied-across value equals the parent's own lookup
      (assert= (receive) (reflect/source-location 'introspection-test/sl-subject)))))

;; Discovery over the flat namespace (std/prelude.blsp): apropos matches names,
;; doc-search matches docstrings, all-globals lists everything. Built on the
;; global-names/doc primitives above.

(describe "discovery (apropos / all-globals / doc-search)"
  ; 'map' has no "rand" in it
  (test "apropos finds globals by name substring"
    (let (hits (apropos "rand"))
      (is (includes? hits 'rand/int))
      (is (includes? hits 'rand/float))
      (refute (includes? hits 'map))))
  (test "apropos accepts a string, symbol, or keyword pattern"
    (assert= (apropos "shuffle") (apropos 'shuffle))
    (assert= (apropos "shuffle") (apropos :shuffle)))
  (test "apropos of a nonsense pattern is empty"
    (assert= (apropos "zzz-no-such-thing-zzz") nil))
  ; it's an alias
  ;; `:isolated` — the last assertion requires two reads of the global table to agree, and
  ;; the suite runs tests in parallel against ONE runtime table, so another test's `def`
  ;; landing between them fails it. Found by a repeat-until-failure baseline (2026-08-05):
  ;; it failed on iteration 2 at two seeds, which is the timing shift, not a re-run bug.
  (test "all-globals lists every global and includes the prelude"
    :isolated (let (g (reflect/global-names))
      (is (> (count g) 100))
      (is (includes? g 'map))
      (is (includes? g 'rand/int))
      (assert= g (reflect/global-names))))
  (test "doc-search finds globals whose docstring mentions a word"
    (let (names (map (doc-search "uniformly random") first))
      (is (includes? names 'seq/shuffle))
      (is (includes? names 'seq/sample))))
  (test "doc-search returns [name doc] pairs with real docstrings"
    (let (hits (doc-search "xorshift"))
      (refute (empty? hits))
      (let ([nm d] (first hits))
        (is (symbol? nm))
        (is (string? d)))))
  ;; A multi-term query matches globals carrying *some* of the terms (no
  ;; docstring need hold the whole phrase) — the §3.3 fix. Each of these
  ;; returned nil under the old whole-query substring matcher.
  (test "doc-search ranks by multi-term overlap, not whole-phrase containment"
    (is (includes? (map (doc-search "remote node distributed") first) 'node/connect))
    (is (includes? (map (doc-search "remote node distributed") first) 'node/start))
    (is (includes? (map (doc-search "node up down notification") first) 'node/monitor))
    (is (includes? (map (doc-search "raw mode single keypress") first) 'term/raw-enter)))
  (test "doc-search is case-insensitive"
    (assert= (map (doc-search "XORSHIFT") first) (map (doc-search "xorshift") first)))
  (test "doc-search of a blank query is empty"
    (assert= (doc-search "") nil)
    (assert= (doc-search "   ") nil)))

;; Runtime introspection: per-process GC observability (Tier-1;
(describe "pos-stats"
  (test "is a map with the documented keys, and bytes track CAPACITY not entry count"
    (let (s (dev/pos-stats))
      (is (map? s))
      (is (number? (get s :local-forms)))
      (is (>= (get s :local-forms) 0))
      (is (number? (get s :runtime-forms)))
      (is (>= (get s :runtime-forms) 0))
      ;; capacity is never below what it holds
      (is (>= (get s :local-cap) (get s :local-forms)))
      (is (>= (get s :runtime-cap) (get s :runtime-forms)))
      ;; bytes are derived from capacity, so a table with spare slots still reports
      ;; the memory it occupies — that is the whole point of the surface (a `retain`
      ;; in the GC drops entries without releasing slots).
      (is (>= (get s :local-bytes) 0))
      (is (>= (get s :runtime-bytes) 0))
      (is (= (> (get s :local-cap) 0) (> (get s :local-bytes) 0)))))
  (test "the local table does not keep its high-water capacity across collections"
    ;; Guards the gc.rs hysteresis shrink. The minor-collection path `retain`s dead
    ;; entries out of `form_pos` in place, and `HashMap` never shrinks itself, so
    ;; without the shrink this table keeps its PEAK capacity for the process's life.
    ;; Verified by sabotage against a pre-fix binary on the identical probe: capacity
    ;; 20 017 / 660 KB there, 1 792 / 59 KB here — so this bound separates the two by
    ;; an order of magnitude and is not a tight fit to one machine's rounding.
    (let (churn (fn (n)
                  (if (= n 0)
                    nil
                    (do
                      (reflect/read-all "(defn f (a b) (if (> a b) (+ a 1) (- b 1)))")
                      (churn (- n 1)))))
          _ (churn 4000)
          _ (dev/gc-collect)
          s (dev/pos-stats))
      ;; the live set is tiny after the churn is dropped; capacity must have followed it
      ;; down rather than staying at the high-water mark
      (is (< (get s :local-cap) 8192))
      (is (< (get s :local-bytes) 300000))))
  (test "recording a positioned form is reflected in the local table"
    ;; `read` stamps positions on LOCAL list forms, so reading source must not
    ;; DECREASE the recorded count. (Exact growth is not asserted: a collection may
    ;; drop dead entries between the two samples.)
    (let (before (get (dev/pos-stats) :local-forms)
          _ (reflect/read-all "(defn probe-fn (a b) (if (> a b) a b))")
          after (get (dev/pos-stats) :local-forms))
      (is (>= after before)))))

;; docs/memory-review.md §7). gc-stats reports the *calling* process's own heap.
(describe "gc-stats"
  (test "is a map with the documented counter keys"
    (let (s (dev/gc-stats))
      (is (map? s))
      ;; cumulative counters since process start — non-negative integers
      (is (number? (get s :collections)))
      (is (>= (get s :collections) 0))
      (is (number? (get s :copied)))
      (is (number? (get s :reclaimed)))
      ;; live snapshot + the next-collection trigger
      (is (number? (get s :live)))
      (is (>= (get s :live) 0))
      (is (number? (get s :live-bytes)))
      (is (number? (get s :threshold)))
      (is (> (get s :threshold) 0))))
  (test "live count rises after allocating retained data"
    ;; allocate a chunk we keep referenced — :live must reflect it
    (let (before (get (dev/gc-stats) :live)
          kept (range 500)
          after (get (dev/gc-stats) :live))
      (is (> (count kept) 0))
      (is (>= after before)))))

;; type-signature (ADR-031; the checker signature the LSP hover + `nest mcp`
;; `lookup` share — a thin builtin over the checker's `signature_string`).
(describe "type-signature"
  (test "returns the checker's arrow signature for a builtin"
    (let (sig (reflect/type-signature 'count))
      (is (string? sig))
      (is (includes? sig "-> int"))))
  (test "accepts a string name too, same as the symbol"
    (assert= (reflect/type-signature "inc") (reflect/type-signature 'inc)))
  (test "an interned-but-unbound name has no signature"
    (assert= (reflect/type-signature 'no-such-global-xyz) nil))
  (test "a never-interned string name is nil, not an error"
    (assert= (reflect/type-signature "definitely-not-a-real-global-42") nil)))

;; expr-type — the same question for an expression with no name. `type-signature` needs a
;; global to ask about, which leaves a REPL or a scratch buffer nothing to ask with: the
;; thing you just typed is anonymous. The checker already computes this walking any form;
;; it simply had no way out.
(describe "expr-type"
  ;; A literal types as ITSELF, not as its tag — the checker keeps singleton literal types,
  ;; which is how it knows `(if true a b)` never takes the second branch. Worth pinning:
  ;; anything rendering these to a human has to expect `"1"` where it assumed `"int"`.
  (test "a literal types as the singleton it is; a call types as its result"
    (assert= (reflect/expr-type "1") "1")
    (assert= (reflect/expr-type ":score") ":score")
    (assert= (reflect/expr-type "(+ 1 2)") "int"))

  (test "the type follows the call, not the arguments"
    (assert= (reflect/expr-type "(str 1 2)") "string"))

  (test "only the FIRST form is typed — the rest are somebody else's question"
    (assert= (reflect/expr-type "(+ 1 2)\n\"later\"") "int"))

  ;; Both read live from a buffer that is unbalanced half the time, so neither may raise.
  ;; `check-string-structured` answers () there; the honest analogue for one type is nil.
  (test "unparsable input is nil, never an error"
    (assert= (reflect/expr-type "(+ 1") nil)
    (assert= (reflect/expr-type "") nil)
    (assert= (reflect/expr-type "   ") nil))

  ;; A lambda has an arrow type of its own now (KI-85 closed the gap where it had none):
  ;; `any` per parameter, the body's type as the result.
  ;; A constructed record knows its fields in the LIVE image too: `defrecord` declares a
  ;; `?field` variable per undeclared field, and the image-side signature path resolves
  ;; it per call like a same-file declaration — so hover and this agree with `nest check`.
  (test "a record constructor call carries its argument types, from the live image"
    (defrecord ispt (x y))
    (assert= (reflect/expr-type "(:x (ispt 1 2))") "1")
    ;; rendered by NAME with its fields — `ispt{x: 1, y: 2}` — not as the raw shape
    (let (t (reflect/expr-type "(ispt 1 2)"))
      (is (includes? t "ispt{"))
      (is (includes? t "x: 1"))
      (is (includes? t "y: 2"))))

  (test "a lambda literal types as an arrow"
    (assert= (reflect/expr-type "(fn (n) (str n))") "(any) -> string"))

  ;; …but only when the result is knowable. Identity returns whatever it was handed, and
  ;; a call to a name the checker cannot see is unknown — nil, never a guess.
  (test "an expression the checker has no opinion about is nil, not a guess"
    (assert= (reflect/expr-type "(fn (x) x)") nil)
    (assert= (reflect/expr-type "(no-such-fn-anywhere 1)") nil))

  ;; The question expr-type structurally cannot answer, and the reason `source-signatures`
  ;; below exists: a definition form evaluates to its own NAME, so the type of its value is
  ;; the type of a symbol and says nothing about the function.
  (test "a definition is not an expression about its function"
    (assert= (reflect/expr-type "(defn ixt-two (n) (* 2 n))") nil)))

;; source-signatures — `file-signatures` for text that is not a file. An editor buffer
;; mid-edit is not on disk, and neither is one form a live evaluator just ran.
(describe "source-signatures"
  (test "a definition's inferred signature, in source syntax"
    (let (sigs (reflect/source-signatures "(defn ixs-len (s) (string/length s))")
          hit (first sigs))
      (assert= (count sigs) 1)
      (assert= (:name hit) "ixs-len")
      (assert= (:sig hit) "(string -> int)")
      (assert= (:declared? hit) false)
      (assert= (:informative? hit) true)))

  ;; The same widening `file-signatures` reports, and the reason this is worth pinning: an
  ;; all-`any` arrow is a signature the checker CAN write and which says nothing, so a
  ;; caller showing hints has to be able to tell the two apart.
  (test "an arrow that says nothing is marked uninformative rather than withheld"
    (let (hit (first (reflect/source-signatures "(defn ixs-id (n) (quot n 2))")))
      (assert= (:sig hit) "(any -> any)")
      (assert= (:informative? hit) false)))

  ;; A pattern-dispatched multi-clause defn used to read as an arity-0 `(-> any)`; its
  ;; clauses say what each position admits.
  (test "a pattern-clause definition has a real signature"
    (let (hit (first (reflect/source-signatures "(defn ixs-tok (((x y & acc) \"+\") (conj acc (+ y x))) ((acc val) (conj acc (string/->number val))))")))
      (assert= (:sig hit) "(any string -> any)")
      (assert= (:informative? hit) true)))

  ;; A named reducer whose own signature says nothing about its result gets re-typed under
  ;; what `reduce` hands it (call-site specialization) — the same precision an inline fn had.
  (test "a named callback's result flows from what the combinator hands it"
    (let (sigs (reflect/source-signatures "(defn ixs-step (acc val) (conj acc (string/->number val)))\n(defn ixs-run (xs) (first (reduce xs '() ixs-step)))")
          run (seq/find sigs (fn (e) (= (:name e) "ixs-run"))))
      (assert= (:sig run) "(seqable -> (or failure nil number))")))

  ;; ── ADR-308 guard: the checker's structural reasoning about combinators ──────
  ;; `infer.rs` reads the collection and the callback out of a `map`/`keep`/`fold`/
  ;; `reduce` call to type the result. Those positions are hard-coded there, and when
  ;; they went stale during the data-first move the inference degraded to plain `any`
  ;; — no error, no warning, just lost precision that one test happened to catch.
  ;; These pin a KNOWN-PRECISE result per combinator, so the next reorder fails here
  ;; by name. The companion gate over the curated signatures themselves is
  ;; `types::check::sigs::convention_tests::curated_combinators_put_the_callback_last`.
  (test "combinator result inference survives the argument order (ADR-308)"
    (let (sig-of (fn (src name)
                   (let (hit (seq/find (reflect/source-signatures src)
                               (fn (e) (= (:name e) name))))
                     (if (nil? hit) :no-such-fn (:sig hit)))))
      ;; map: element type flows through the callback's return
      (assert= "(seqable -> (or nil (list string)))"
        (sig-of "(defn icb-m (xs) (map xs (fn (x) (str x))))" "icb-m"))
      ;; fold: accumulator seeded from init, stepped by the callback
      (assert= "(seqable -> int)"
        (sig-of "(defn icb-f (xs) (fold xs 0 (fn (a x) (+ a 1))))" "icb-f"))
      ;; reduce/2 — no init: the accumulator starts at the collection's first element,
      ;; so a typed collection is what makes the result provable (an untyped one is
      ;; honestly `any`, which a STALE position also yields — hence the literal here)
      (assert= "(-> int)"
        (sig-of "(defn icb-r () (reduce [1 2 3] (fn (a x) (+ a x))))" "icb-r"))
      ;; seq/keep — `map` then drop nils; its own arm in `infer.rs`. Keyed QUALIFIED,
      ;; like `seq/interpose`: `keep` lives in `seq` (ADR-227), so an arm matching the
      ;; bare name never fired at all and the element type was silently lost. The
      ;; element type has the callback's nil REMOVED — dropping nil is what `keep`
      ;; does, so `(or nil number)` narrows to `number` (see infer.rs).
      (assert= "(seqable -> (or nil (list number)))"
        (sig-of "(defn icb-k (xs) (seq/keep xs (fn (x) (string/->number x))))" "icb-k"))))

  ;; An INLINE pattern-clause literal is two spellings of the named `token` reducer the
  ;; Rust tests pin — and it read `(string -> any)` while the named spelling was precise,
  ;; because the literal is lowered to a variadic `match*` lambda before call sites are
  ;; typed. The surface pre-pass now records the literal's clauses by printed head list
  ;; and `clause_lambda_ret` recovers them (found on an RPN reduce, 2026-08-31).
  (test "an inline pattern-clause reduce callback keeps the named spelling's precision"
    (let (hit (first (reflect/source-signatures "(defn calc (expr) (-> expr (string/split) (reduce '() (fn (((x y & acc) \"+\") (conj acc (+ x y))) ((acc val) (conj acc (string/->number val))))) (first)))")))
      (assert= (:sig hit) "(string -> (or failure nil number))")))

  (test "a declared sig is reported as declared, and wins"
    (let (hit (first (reflect/source-signatures "(sig ixs-d (int -> int))\n(defn ixs-d (x) x)")))
      (assert= (:sig hit) "(int -> int)")
      (assert= (:declared? hit) true)))

  (test "every definition in the text, in order"
    (assert= (map (reflect/source-signatures "(defn ixs-a (n) n)\n(defn ixs-b (n) n)") :name)
      (list "ixs-a" "ixs-b")))

  (test "text that defines nothing has no signatures"
    (assert= (reflect/source-signatures "(+ 1 2)") '()))

  ;; Same discipline as expr-type and check-string-structured: read live, from a buffer
  ;; that is unbalanced half the time, so it must not raise.
  (test "unparsable input is (), never an error"
    (assert= (reflect/source-signatures "(defn broken (x") '())
    (assert= (reflect/source-signatures "") '())))

;; source-deps — what each top-level form defines and uses. The question a live evaluator
;; has to answer to re-run only the forms an edit could affect: without it, "everything
;; below the edit" is the only correct answer, and a buffer of twenty forms costs twenty
;; evaluations per keystroke-settling.
(describe "source-deps"
  (defn deps-of (src) (reflect/source-deps src))

  (test "one entry per top-level form, in document order"
    (let (d (deps-of "(defn ixd-twice (n) (* 2 n))\n(ixd-twice 4)\n"))
      (assert= (count d) 2)
      (assert= (:defines (first d)) (list "ixd-twice"))
      (is (includes? (:references (second d)) "ixd-twice"))
      (assert= (:defines (second d)) '())))

  ;; The edge that makes the answer usable: a parameter is not a use of the global that
  ;; shares its name, or every form would depend on every other.
  (test "locals are not references"
    (let (d (first (deps-of "(defn ixd-f (n) (inc n))")))
      (is (includes? (:references d) "inc"))
      (is (not (includes? (:references d) "n")))))

  (test "syntax is not a dependency — no form defines `defn`"
    (let (r (:references (first (deps-of "(defn ixd-g (x) (if x 1 2))"))))
      (is (not (includes? r "defn")))
      (is (not (includes? r "if")))))

  ;; Private definitions are most of a real module (ADR-146) and bind globals like any
  ;; other; their parameters are local like any other.
  (test "a private definition defines, and scopes its parameters"
    (let (d (first (deps-of "(defn- ixd-h (n) (inc n))")))
      (assert= (:defines d) (list "ixd-h"))
      (is (not (includes? (:references d) "n")))))

  (test "a quoted symbol is data, not a use"
    (is (not (includes? (:references (first (deps-of "(list 'ixd-nope)"))) "ixd-nope"))))

  (test "text with no forms has no entries"
    (assert= (reflect/source-deps "") '())
    (assert= (reflect/source-deps ";; just a comment\n") '())))

;; `system/features` / `system/feature?` — asking the BUILD what it can do.
;;
;; The gap this closes: a builtin from an absent optional feature is still bound
;; and still raises when called, so `bound?` answers yes on a runtime that cannot
;; do the thing. The only alternative was calling it and matching on the error's
;; prose, which breaks silently whenever the message is reworded.
(describe "features"
  (test "returns a vector of keywords"
    (let (fs (system/features))
      (is (vector? fs))
      (assert= (count (filter fs (fn (f) (not (keyword? f))))) 0)))

  (test "the jit is on in a default build" (is (includes? (system/features) :jit)))

  (test "the list is stable within a build" (assert= (system/features) (system/features))))

(describe "os/exe-path — where this binary lives"
  (test "it answers an absolute path, or nil when the platform won't say"
    ;; nil is a legitimate answer (a sandbox with no /proc/self/exe), so accept either —
    ;; what must NOT happen is a raise, since callers ask opportunistically
    (let (p (os/exe-path))
      (is (or (nil? p) (and (string? p) (string/starts-with? p "/"))))))

  (test "and it points at something that exists — the sibling lookup depends on that"
    ;; the point of the primitive: `(path-join (parent-directory (os/exe-path)) "nest")` has to be a
    ;; real place to look
    (let (p (os/exe-path))
      (when (string? p)
        (is (file/exists? p))
        (is (file/dir? (path/dirname p))))))

  (test "it is stable within a process"
    (assert= (os/exe-path) (os/exe-path))))

(describe "system/feature?"
  (test "true for a feature this build has" (is (system/feature? :jit)))
  (test "false for one it does not have, rather than an error"
    (refute (system/feature? :no-such-feature)))
  (test "agrees with the list"
    (assert= (system/feature? :jit) (includes? (system/features) :jit)))

  ;; The whole reason this exists.
  (test "a bound builtin does not imply a working feature"
    (is (bound? 'gui/open))
    (is (or (system/feature? :gui) (not (system/feature? :gui))))))
