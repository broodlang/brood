;; Per-process resource limits — `(proc/flag :max-heap n)` (BEAM
;; `max_heap_size` analogue; ROADMAP "Robustness gaps vs BEAM / .NET" #2).
;;
;; Coverage:
;;   - flag read/set/clear returns the previous value
;;   - exceeding the limit raises catchable E0045 in the offending process
;;   - clearing the limit inside the catch rescues the process
;;   - a capped spawned process dies ALONE; siblings/parent unaffected
;;   - unknown flags and bad values error cleanly

;; The `(after 30000 …)` guards here are deliberately ABOVE the shared
;; `*test-wait-ms*` (20s): these cases build large structures while a memory cap is
;; armed, so they are legitimately slow rather than merely load-sensitive. Don't
;; "normalise" them down to the knob.

(defmodule process-limit-test (:use test))

(defn build (acc) (build (cons 1 acc)))

(defn build-capped (bytes)
  "Set a heap cap, then allocate unboundedly; returns the caught [kind code]."
  (try
    (do (proc/flag :max-heap bytes) (build ()))
    (catch e (do (proc/flag :max-heap nil) [(get e :kind) (get e :code)]))))

(describe "proc/flag :max-heap"
  (test "read/set/clear returns the previous value"
    (assert= nil (proc/flag :max-heap))
    (assert= nil (proc/flag :max-heap 50000000))
    (assert= 50000000 (proc/flag :max-heap))
    (assert= 50000000 (proc/flag :max-heap nil))
    (assert= nil (proc/flag :max-heap)))

  (test "exceeding the limit raises catchable E0045"
    (assert= [:runtime "E0045"] (build-capped 2000000)))

  (test "clearing the limit in the catch rescues the process"
    ;; build-capped clears it in the handler; more allocation then succeeds
    (build-capped 2000000)
    (assert= 1000 (count (into () (range 1000)))))

  (test "unknown flag errors cleanly"
    (assert-error (proc/flag :no-such-flag 1)))

  (test "bad :max-heap value errors cleanly"
    (assert-error (proc/flag :max-heap -5))
    (assert-error (proc/flag :max-heap "big"))))

(describe "process isolation"
  (test "a capped process dies alone; the monitoring parent survives"
    (let (pid (spawn (fn () (do (proc/flag :max-heap 2000000) (build ())))))
      (let (m (monitor pid))
        (assert= :worker-died
          (receive
            ([:down ^m ^pid _] :worker-died)
            (after 30000 :timeout)))))
    ;; the parent's own limit is untouched and it can still allocate
    (assert= nil (proc/flag :max-heap))
    (assert= 100 (count (into () (range 100)))))

  (test "the limit is per-process: an uncapped sibling is unaffected"
    (let (me (self))
      (spawn
        (fn ()
          (do
            (proc/flag :max-heap 2000000)
            ;; check-allow :discarded-catch — the heap-cap kill is the event under test, not something to read
            (check-allow :discarded-catch (try (build ()) (catch _ nil)))
            (send me [:capped-done]))))
      (spawn (fn () (send me [:sibling (count (into () (range 5000)))])))
      (assert= 5000 (receive ([:sibling n] n) (after 30000 :timeout)))
      (assert= :ok (receive ([:capped-done] :ok) (after 30000 :timeout))))))

;; ── proc/flag :max-mailbox (ADR-307) ─────────────────────────────────────────
;; The queue-length twin of :max-heap: senders arm the breach at enqueue, the
;; flooded process raises catchable E0046 at its next safepoint or receive.
;; Senders are never blocked; nothing is dropped.

(defn flood (pid n)
  "Send `n` messages to `pid`."
  (dotimes (_ n) (send pid :flood)))

(describe "proc/flag :max-mailbox"
  (test "read/set/clear returns the previous value"
    (assert= nil (proc/flag :max-mailbox))
    (assert= nil (proc/flag :max-mailbox 64))
    (assert= 64 (proc/flag :max-mailbox))
    (assert= 64 (proc/flag :max-mailbox nil))
    (assert= nil (proc/flag :max-mailbox)))

  (test "bad values error cleanly"
    (assert-error (proc/flag :max-mailbox 0))
    (assert-error (proc/flag :max-mailbox -3))
    (assert-error (proc/flag :max-mailbox "many")))

  (test "a flooded parked receiver dies with catchable E0046; the senders are untouched"
    (let (me (self)
          victim (spawn
                   (do
                     (proc/flag :max-mailbox 8)
                     (send me [:ready (self)])
                     ;; parks on a pattern the flood never matches — the breach
                     ;; is noticed at the receive re-scan, not a VM safepoint
                     (receive (:never nil))))
          _ (receive ([:ready ^victim] nil) (after 30000 (error "no ready")))
          m (monitor victim))
      (flood victim 32)
      (assert= [:runtime "E0046"]
        (receive
          ([:down ^m _ [:error e]] [(get e :kind) (get e :code)])
          (after 30000 :timeout)))))

  ;; KI-103: this is a correct test of a BROKEN feature, and it fails intermittently — the
  ;; worker is killed inside `(proc/flag :max-mailbox nil)` by the same breach it is
  ;; clearing, because every further `send` over the bound re-arms the sticky flag. It
  ;; mostly passes under the VM and fails ~3 in 4 under `BROOD_VM=0`. Left asserting the
  ;; INTENDED behaviour rather than weakened to match the defect: the day the bound grows
  ;; hysteresis, this goes green on its own and nothing has to be remembered.
  (test "the handler can drain and clear the bound — the process recovers"
    (let (me (self)
          expected 32
          worker (spawn
                   (do
                     (proc/flag :max-mailbox 8)
                     (send me [:ready (self)])
                     (try
                       (receive (:never nil))
                       (catch e
                         ;; drain everything, lift the bound, prove we lived
                         (do
                           (proc/flag :max-mailbox nil)
                           ;; The bound trips at message 9 of 32, so the handler starts
                           ;; draining while `flood` is still sending — `after 0` would
                           ;; stop at whatever had ARRIVED. Drain until the expected count
                           ;; is in hand, with a long backstop that only expires if
                           ;; something is genuinely broken.
                           ;;
                           ;; This used a 100 ms grace, which is a wall clock standing in
                           ;; for synchronisation: it beat the sender on an idle machine
                           ;; and lost under a full concurrent suite run, where it drained
                           ;; fewer than 32 and failed. A timeout is a failure deadline
                           ;; here, never a wait.
                           ;; Drain until the parent's `:done` SENTINEL, not until a count
                           ;; or a clock. Both of those were races: `(after 100 n)` beat the
                           ;; sender on an idle machine and lost under a loaded suite, and
                           ;; counting to 32 with a 30 s backstop then raced the PARENT's own
                           ;; 30 s — a slow run (the tree-walker is ~10x) reported after the
                           ;; parent had given up, so the failure read `:timeout` rather than
                           ;; a count. Message order is preserved per sender, so `:done`
                           ;; cannot arrive before the floods that precede it: the sentinel
                           ;; makes the count exact with no timing in it at all. The `after`
                           ;; that remains is an anti-hang deadline and nothing else.
                           (letrec (drain (fn (n)
                                            (receive
                                              (:flood (drain (+ n 1)))
                                              (:done n)
                                              (after *test-wait-ms* n))))
                             (send me [:recovered (get e :code) (drain 0)]))))))))
      (receive ([:ready ^worker] nil) (after 30000 (error "no ready")))
      (flood worker expected)
      (send worker :done)
      (let ([code drained] (receive ([:recovered c n] [c n]) (after 30000 [:timeout 0])))
        (assert= "E0046" code)
        (assert= expected drained))))

  (test "a busy (non-receiving) flooded process trips at a safepoint"
    (let (me (self)
          victim (spawn
                   (do
                     (proc/flag :max-mailbox 8)
                     (send me [:ready (self)])
                     ;; wait for the go signal, then compute forever — the
                     ;; breach must reach it through the VM safepoint probe
                     (receive (:go nil))
                     (letrec (spin (fn (n) (spin (+ n 1)))) (spin 0))))
          _ (receive ([:ready ^victim] nil) (after 30000 (error "no ready")))
          m (monitor victim))
      (flood victim 32)
      (send victim :go)
      (assert= "E0046"
        (receive
          ([:down ^m _ [:error e]] (get e :code))
          (after 30000 :timeout)))))

  (test "an uncapped sibling is unaffected by a capped victim's death"
    (let (me (self)
          victim (spawn (do
                          (proc/flag :max-mailbox 4)
                          (send me [:ready (self)])
                          (receive (:never nil))))
          echo (spawn (receive ([:ping from] (send from :pong))))
          _ (receive ([:ready ^victim] nil) (after 30000 (error "no ready"))))
      (flood victim 16)
      (send echo [:ping me])
      (assert= :pong (receive (:pong :pong) (after 30000 :timeout))))))
