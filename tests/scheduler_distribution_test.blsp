;; Scheduler distribution — work must actually reach more than one worker.
;;
;; The existing coverage proves the *mechanisms*: `work_stealing.rs` (the steal path
;; fires and no process is lost while stolen), `live_migration.rs`, `preemption.rs`,
;; `concurrency_race.rs`. Nothing asserted that a fan-out is *spread*, and
;; `(sched-stats)` is the only distribution signal reachable from Brood — it has no
;; per-worker breakdown, so these are the strongest claims the current observability
;; supports.
;;
;; Written after a 2026-07-28 session where a scaling number looked catastrophic
;; (two workers appearing to give exactly 1.0x speedup) and turned out to be a
;; measurement error — `BROOD_J=1` floors the pool at 2, so the "1 worker" and
;; "2 worker" runs were the same configuration. Hence the deliberate shape below:
;; every assertion is *conditional on the pool the runtime reports*, never on an
;; assumed worker count.
;;
;; Register-only — discovered and run by `nest test`.
(defmodule scheduler-distribution-test (:use test))

(defn workers () (get (dev/sched-stats) :workers))

;; A fan-out big enough that a single worker draining it alone would be obvious,
;; but small enough to stay fast in the suite. Each child does real (if brief) work
;; so a worker can actually be caught busy while a peer goes idle — the window the
;; steal path needs.
(def fan-size 200)

(defn burn (i acc)
  (if (>= i 20000) acc (burn (+ i 1) (bit/and (+ (* acc 1103515245) 12345) 2147483647))))

(sig burn (int int -> int))
(defn fan (me i)
  (if (>= i fan-size) nil (do (spawn (send me [:done (burn 0 i)])) (fan me (+ i 1)))))

(defn drain (got)
  (if (>= got fan-size) got (drain (receive ([:done _] (+ got 1))))))

;; The steal case's fan: a child's cost runs from nothing to a full `burn` with its index, so the queues the
;; round-robin spill fills drain at different rates and a worker that empties its own can
;; find a peer's backlog. Tagged apart from `fan`, so its replies are never confused.
(defn uneven-fan (me i)
  (if (>= i fan-size)
    nil
    (do
      (spawn (send me [:uneven (burn (* 1000 (math/rem (* i 7919) 31)) i)]))
      (uneven-fan me (+ i 1)))))

(defn uneven-drain (got)
  (if (>= got fan-size) got (uneven-drain (receive ([:uneven _] (+ got 1))))))

(defn steal-within (me before tries)
  "Run uneven fans until the steal counter moves past `before`; false after `tries`."
  (cond
    (> (get (dev/sched-stats) :steals) before) true
    (= tries 0) false
    else (do (uneven-fan me 0) (uneven-drain 0) (steal-within me before (- tries 1)))))

(describe "scheduler distribution"
  (test "every spawned process runs exactly once under fan-out"
    ;; The unconditional guard: correctness cannot depend on how many workers the
    ;; machine has. A lost or double-counted process fails here regardless of pool size.
    (let (me (self))
      (fan me 0)
      (assert= (drain 0) fan-size)))

  (test "a fan-out reaches more than one worker"
    ;; `:peak-threads` is the high-water count of processes *running concurrently*.
    ;; On a pool of one it can only ever be 1, so the claim is conditional — the
    ;; lesson from the measurement error above.
    (let (me (self) w (workers))
      (fan me 0)
      (drain 0)
      (if (> w 1)
        (assert= (> (get (dev/sched-stats) :peak-threads) 1) true)
        ;; single-worker pool: nothing to distribute to, so only the invariant holds
        (assert= (>= (get (dev/sched-stats) :peak-threads) 1) true))))

  (test "the steal path fires when there is a pool to steal across"
    :isolated
    ;; Complements `work_stealing.rs` (which pins a 2-worker pool in its own test
    ;; binary): here we assert it on the *default* pool the suite actually runs with,
    ;; so a regression that only shows at nproc workers is still caught.
    ;; A steal needs a worker that is IDLE while a peer has a backlog, and nothing makes
    ;; one fan produce that: spawn already spills round-robin (docs/scheduler.md), so a
    ;; fan of equal children ends balanced, and with two workers it finished with no
    ;; steal in 6 of 12 runs (tier 2, `BROOD_J=2`). So the children here cost unequally,
    ;; the test runs alone (`:isolated`, no neighbour keeping the workers busy), and up to
    ;; ten fans are tried: a working steal path fires in one of them, a broken one never.
    (let (me (self) w (workers) before (get (dev/sched-stats) :steals))
      (if (> w 1)
        (assert= (steal-within me before 10) true)
        (do
          (uneven-fan me 0)
          (uneven-drain 0)
          ;; a one-worker pool has no peer to steal from — the counter must not move
          (assert= (get (dev/sched-stats) :steals) before)))))

  (test "spawn/exit accounting balances over a fan-out"
    ;; Every spawned process must also be accounted as exited once the fan drains —
    ;; a leak here is how a registry or lifecycle bug shows up first.
    (let (me (self) s0 (get (dev/sched-stats) :spawned))
      (fan me 0)
      (drain 0)
      (let (spawned (- (get (dev/sched-stats) :spawned) s0))
        (assert= (>= spawned fan-size) true)))))
