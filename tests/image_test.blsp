;; tests/image_test.blsp — `image-thumb`: decode an encoded image + downscale to a
;; row-major RGBA8 buffer. The fixture is a hand-built 2×2 PNG (every pixel 10,20,30)
;; inlined as a byte vector, so the test touches no disk — `image-thumb` accepts a
;; bytes value, a vector, or a list of byte ints (the `collect_bytes` coercion).
(defmodule image-test (:use test))

(def *png-2x2*
  [137
    80 78 71 13 10 26 10 0 0 0 13 73 72 68 82 0 0 0 2 0 0 0 2 8 2 0 0 0 253 212 154 115 0 0 0 16 73
    68 65 84 120 156 99 224 18 145 3 34 6 8 5 0 6 78 0 241 56 99 50 129 0 0 0 0 73 69 78 68 174 66
    96 130])

(describe "image-thumb: decode + downscale to RGBA"
  (test "decodes a 2x2 PNG to a {:width :height :rgba} map"
    (let (t (gui/image-thumb *png-2x2* 8 8))
      (is (map? t))
      ; already within 8x8, so the 2x2 source is unchanged
      (assert= (get t :width) 2)
      (assert= (get t :height) 2)
      ; :rgba is a width*height*4 bytes value
      (is (bytes? (get t :rgba)))
      (assert= (count (get t :rgba)) 16)
      ; the first pixel is the fixture colour (10,20,30), fully opaque
      (let ({:rgba px} t)
        (assert= [(bytes/at px 0) (bytes/at px 1) (bytes/at px 2) (bytes/at px 3)]
          [10 20 30 255]))))

  (test "downscales to fit the max box, preserving aspect"
    ;; a 2x2 source capped at 1x1 collapses to 1x1 (one RGBA pixel)
    (let (t (gui/image-thumb *png-2x2* 1 1))
      (assert= (get t :width) 1)
      (assert= (get t :height) 1)
      (assert= (count (get t :rgba)) 4)))

  (test "non-image bytes and non-positive dims degrade to nil, never throw"
    (is (nil? (gui/image-thumb (string/->bytes "not an image") 8 8)))
    (is (nil? (gui/image-thumb *png-2x2* 0 8)))
    (is (nil? (gui/image-thumb *png-2x2* 8 -1)))))

(describe "image-thumbs: many images decoded side by side"
  (test "answers what image-thumb does for each, in order, a bad one nil"
    (let (sources [*png-2x2* (string/->bytes "not an image") (apply bytes *png-2x2*) *png-2x2*]
          thumbs (gui/image-thumbs sources 8 8))
      (assert= (count thumbs) 4)
      (assert= thumbs (seq/mapv sources (fn (source) (gui/image-thumb source 8 8))))
      (is (nil? (nth thumbs 1)))
      (assert= (get (nth thumbs 3) :width) 2)))

  (test "many more images than cores keep their order"
    (let (sources (seq/mapv (range 64) (fn (index) (if (= 0 (math/rem index 5)) [1 2 3] *png-2x2*)))
          thumbs (gui/image-thumbs sources 1 1))
      (assert= (seq/mapv thumbs (fn (thumb) (when thumb (get thumb :width))))
        (seq/mapv (range 64) (fn (index) (if (= 0 (math/rem index 5)) nil 1))))))

  (test "nothing, a list, and non-positive dims"
    (assert= (gui/image-thumbs [] 8 8) [])
    (assert= (count (gui/image-thumbs (list *png-2x2*) 8 8)) 1)
    (assert= (gui/image-thumbs [*png-2x2* *png-2x2*] 0 8) [nil nil])))
