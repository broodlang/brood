(defmodule template-test (:use test))

(describe "render"
  (test "substitutes a string key"
    (assert= "Hello, World!"
      (template/render "Hello, {{name}}!" {"name" "World"})))
  (test "substitutes a keyword key"
    (assert= "Hi, Alice!"
      (template/render "{{greeting}}, {{name}}!" {:greeting "Hi" :name "Alice"})))
  (test "multiple substitutions"
    (assert= "1 + 2 = 3"
      (template/render "{{a}} + {{b}} = {{c}}" {"a" "1" "b" "2" "c" "3"})))
  (test "unknown key renders as empty string"
    (assert= "Hello, !"
      (template/render "Hello, {{missing}}!" {})))
  (test "no markers returns template unchanged"
    (assert= "no markers here"
      (template/render "no markers here" {})))
  (test "spaces around key are trimmed"
    (assert= "hello"
      (template/render "{{ name }}" {"name" "hello"})))
  (test "non-string value is coerced to string"
    (assert= "count: 42"
      (template/render "count: {{n}}" {"n" 42})))
  (test "empty template"
    (assert= "" (template/render "" {"x" "y"})))
  (test "unclosed {{ is passed through unchanged"
    (assert= "{{oops"
      (template/render "{{oops" {"oops" "x"})))
  (test "adjacent markers"
    (assert= "ab"
      (template/render "{{a}}{{b}}" {"a" "a" "b" "b"})))

  ;; `render` splits on `{{` and joins once, rather than re-slicing the rest of the
  ;; template per marker (which made it O(n²) — 12x per 4x of input). These pin the
  ;; boundary cases that rewrite moved through: text on either side of an unterminated
  ;; marker, a stray `}}`, and correctness at a size where the old shape was visible.
  (test "an unclosed {{ keeps the text after it"
    (assert= "a {{oops rest"
      (template/render "a {{oops rest" {"oops" "x"})))
  (test "a substituted marker before an unclosed one still substitutes"
    (assert= "X then {{oops"
      (template/render "{{a}} then {{oops" {"a" "X"})))
  (test "a stray }} with no marker is literal"
    (assert= "a }} b" (template/render "a }} b" {})))
  (test "text before, between and after markers is preserved"
    (assert= "<1|2>" (template/render "<{{a}}|{{b}}>" {"a" 1 "b" 2})))
  (test "many markers render correctly, not just quickly"
    ;; 500 markers: the old implementation got this right but quadratically. Guards the
    ;; rewrite's chunk ordering — an off-by-one in the split/join reverses or drops text.
    (let (tmpl (apply str (repeat 500 "x{{a}}"))
          out (template/render tmpl {"a" "-"}))
      (assert= 1000 (string/length out))
      (assert= (apply str (repeat 500 "x-")) out))))

(describe "render-all"
  (test "maps template over a list of rows"
    (assert= ["Hello, Alice!" "Hello, Bob!"]
      (into []
        (template/render-all "Hello, {{name}}!"
          [{"name" "Alice"} {"name" "Bob"}]))))
  (test "empty list"
    (is (nil? (template/render-all "{{x}}" nil)))))

;; ---- substituted values render through display ------------------------------

(defrecord usd (cents))
(impl display template-test/usd (->string [m] (str "$" (get m :cents))))

(describe "render uses display for substituted values"
  (test "a record substitutes as its display string, not its field map"
    (assert= (template/render "Total: {{amount}}" {"amount" (usd 1050)}) "Total: $1050")
    (assert= (template/render "{{amount}}" {:amount (usd 25)}) "$25"))
  (test "a number still substitutes as its digits"
    (assert= (template/render "n={{n}}" {"n" 42}) "n=42"))
  (test "a missing key is still the empty string"
    (assert= (template/render "x={{nope}}" {}) "x=")))
