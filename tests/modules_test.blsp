;; Module system + path/string helpers (ADR-019). Register-only — discovered and
;; run by `brood test` (and cargo test, via crates/lisp/tests/suite.rs).

; file: the require-race fixtures
(defmodule modules-test (:use test))
(describe "strings: substring & affixes"
  (test "substring is char-indexed"
    (assert= (substring "hello" 1 4) "ell")
    (assert= (substring "hello" 0 0) "")
    (assert= (substring "hello" 0 5) "hello"))
  (test "substring out of range raises"
    (assert-error (substring "hi" 0 9))
    (assert-error (substring "hi" -1 1)))
  (test "starts-with? / ends-with?"
    (is (starts-with? "foobar" "foo"))
    (refute (starts-with? "foobar" "bar"))
    (is (ends-with? "foo_test.blsp" "_test.blsp"))
    (refute (ends-with? "foo.blsp" "_test.blsp"))
    (is (ends-with? "x" ""))))

(describe "paths"
  (test "path-join" (assert= (path-join "a" "b") "a/b") (assert= (path-join "a/" "b") "a/b"))
  (test "parent-dir"
    (assert= (parent-dir "/a/b/c") "/a/b")
    (assert= (parent-dir "/foo") "/")
    (assert= (parent-dir "rel") ".")))

;; :serial — these mutate the shared *features* global, so run them one-at-a-time.
(describe "modules: member? / provide / require"
  :serial
  (test "member?" (is (member? 2 (list 1 2 3))) (refute (member? 9 (list 1 2 3))))
  (test "provide records a feature idempotently"
    (provide 'demo-feature)
    (is (member? "demo-feature" *features*))
    (provide 'demo-feature)
    (assert= (count (filter (fn (x) (= x "demo-feature")) *features*)) 1))
  (test "require returns the list of feature names and is idempotent"
    (assert= (require 'test) (list "test"))
    ; variadic now: a list of names
    (assert= (require 'test 'docs) (list "test" "docs")))
  (test "require of a missing module raises" (assert-error (require 'no-such-module-xyz)))

  ;; The partial-load race: `defmodule` used to provide its feature at the TOP of the
  ;; file, so a require racing another process's load returned while the module was
  ;; half-evaluated — the caller's very next `mod/fn` call hit unbound. Now a load in
  ;; flight is tracked in *features-loading*; a concurrent requirer WAITS for the
  ;; loader's end-of-file provide. Wide module (400 defs) to keep the window open.
  (test "concurrent (require 'mod) from many processes never sees a half-loaded module"
    (let (path "/tmp/reqrace-mod.blsp"
          src (str "(defmodule reqrace-mod)\n"
                (join "\n" (map (fn (i) (str "(def v" i " " i ")")) (range 400)))
                "\n(defn ready () :ok)\n")
          saved-path *load-path*
          me (self))
      (spit path src)
      (set-load-path! (cons "/tmp" *load-path*))
      (doseq (k (range 8))
        (spawn (send me
                 [:req-race (try
                              (do (require 'reqrace-mod) (reqrace-mod/ready))
                              (catch e [:err (error-message e)]))])))
      (let (results (map (fn (_) (receive ([:req-race r] r) (after *test-wait-ms* :timeout)))
                      (range 8)))
        (set-load-path! saved-path)
        (delete-file path)
        (is (every? (fn (r) (= r :ok)) results)))))

  ;; A FAILED load must clear the in-flight marker: a stale self-marker would make
  ;; the same process's retry match the circular-require arm and "succeed" without
  ;; loading (the later mod/fn call dies unbound with no pointer to the real error),
  ;; while every other process stalls out the full await window per attempt.
  (test "a failed require clears its loading marker; the retry re-raises the real error"
    (let (_ (try (require 'no-such-module-xyz) (catch e :expected)))
      (refute (contains? *features-loading* "no-such-module-xyz"))
      ;; the retry must fail the SAME way — not fake success via a stale marker
      (assert-error (require 'no-such-module-xyz))))

  ;; The circular-require contract survives the fix: a module being loaded that
  ;; (directly or via :use) requires itself back must NOT deadlock or reload — the
  ;; loader pid matches the in-flight marker, so the inner require returns at once.
  (test "a circular require inside one file's own load returns immediately"
    (let (path "/tmp/reqcirc-mod.blsp"
          ;; the module requires ITSELF mid-file — the degenerate cycle
          src "(defmodule reqcirc-mod)\n(require 'reqcirc-mod)\n(defn ok () :yes)\n"
          saved-path *load-path*)
      (spit path src)
      (set-load-path! (cons "/tmp" *load-path*))
      (require 'reqcirc-mod)
      (set-load-path! saved-path)
      (delete-file path)
      (assert= (reqcirc-mod/ok) :yes))))

;; `:implements` is read by the type checker (types/check/protocol.rs), which pulls the
;; clause out of the header source; the loader only has to tolerate it. It was left out
;; of `defmodule--clause-heads` when unrecognised clauses became a hard error, so every
;; module claiming a protocol failed to load — caught by a downstream app (willem) whose
;; suite stopped loading entirely.
(describe "defmodule: the (:implements …) checker annotation"
  (test "a header claiming a protocol loads"
    (%load-string "(defmodule impl-a (:implements LiveModule)) (defn mount (p) p)")
    (assert= (impl-a/mount 7) 7))
  (test "it composes with the loader's own clauses"
    (%load-string "(defmodule impl-b) (defn helper () :ok)")
    (%load-string "(defmodule impl-c (:use impl-b) (:implements LiveModule)) (defn go () (helper))")
    (assert= (impl-c/go) :ok))
  (test "a genuinely unrecognised clause is still a hard error"
    ;; The tightening this restores an exception to must keep working — a misspelled
    ;; clause that silently does nothing is the failure mode it exists to prevent.
    (is (= (try (%load-string "(defmodule impl-d (:require foo))") (catch e :rejected))
          :rejected)))
  (test "the error names :implements among the accepted clauses"
    ;; `error` raises a plain string here, not a structured map — hence `str`, not
    ;; `(get e :message)`.
    (let (message (try (%load-string "(defmodule impl-e (:nonsense x))") (catch e (str e))))
      (is (includes? message ":implements")))))
