;; Module system + path/string helpers (ADR-019). Register-only — discovered and
;; run by `brood test` (and cargo test, via crates/lisp/tests/suite.rs).

; file: the require-race fixtures
(defmodule modules-test (:use test))
(describe "strings: substring & affixes"
  (test "substring is char-indexed"
    (assert= (string/substring "hello" 1 4) "ell")
    (assert= (string/substring "hello" 0 0) "")
    (assert= (string/substring "hello" 0 5) "hello"))
  (test "substring out of range raises"
    (assert-error (string/substring "hi" 0 9))
    (assert-error (string/substring "hi" -1 1)))
  (test "starts-with? / ends-with?"
    (is (string/starts-with? "foobar" "foo"))
    (refute (string/starts-with? "foobar" "bar"))
    (is (string/ends-with? "foo_test.blsp" "_test.blsp"))
    (refute (string/ends-with? "foo.blsp" "_test.blsp"))
    (is (string/ends-with? "x" ""))))

(describe "paths"
  (test "path-join" (assert= (path/join "a" "b") "a/b") (assert= (path/join "a/" "b") "a/b"))
  (test "parent-directory"
    (assert= (path/dirname "/a/b/c") "/a/b")
    (assert= (path/dirname "/foo") "/")
    (assert= (path/dirname "rel") ".")))

;; Concurrent `provide` must not lose a feature (KI-22's class). `provide` is a
;; read-modify-write of one shared global (`(def *features* (assoc *features* key true))`
;; in effect), so two processes providing at once each read the old map and each write
;; their own successor, dropping one — unless the whole sequence runs inside the kernel's
;; registry lock, which is why it goes through `%registry-update!`. This was a real
;; intermittent suite failure: "provide records a feature idempotently" saw its own
;; feature missing from `*features*` on the very next line.
(defn mt-conc-feature (i) (str "mt-conc-feature-" i))

(describe "modules: concurrent provide (KI-22 class)"
  :isolated (test "no feature is lost when many processes provide at once"
    (let (n 120)
      (concurrently n (fn (i) (provide (symbol (mt-conc-feature i)))))
      (assert= (count (seq/reject (range n) (fn (i) (contains? *features* (mt-conc-feature i))))) 0))))

;; :serial — these mutate the shared *features* global, so run them one-at-a-time.
(describe "modules: includes? / provide / require"
  :serial (test "includes?" (is (includes? (list 1 2 3) 2)) (refute (includes? (list 1 2 3) 9)))
  (test "provide records a feature idempotently"
    (provide 'demo-feature)
    (is (contains? *features* "demo-feature"))
    (provide 'demo-feature)
    ;; idempotent: still exactly one entry after a second provide. A map makes a
    ;; duplicate structurally impossible, so this now guards the *key spelling* —
    ;; a `provide` that stored the symbol rather than its name would add a second.
    (assert= (count (seq/filter (keys *features*) (fn (k) (= k "demo-feature")))) 1))
  (test "require returns the list of feature names and is idempotent"
    (assert= (require-one 'test) "test")
    ; variadic now: a list of names
    (assert= (map (list 'test 'docs) require-one) (list "test" "docs")))
  (test "require of a missing module raises" (assert-error (require-one 'no-such-module-xyz)))

  ;; ADR-216: the load-once check must be O(1) in the number of loaded features, not a
  ;; linear scan. As a list it was O(N) per require, so loading N modules was O(N²) —
  ;; 137 s of a 217 s 10 000-module load was this one lookup. Guarded by SHAPE, not by
  ;; timing (a wall-clock assert would be flaky under a loaded CI box): `*features*` must
  ;; be a map, and a miss must not depend on how many features are already present.
  (test "the load-once check is a map lookup, not a list scan"
    (is (map? *features*))
    (provide 'adr216-probe)
    (is (contains? *features* "adr216-probe"))
    (refute (contains? *features* "adr216-absent"))
    ;; adding many features must not change the answer for an absent one
    (map (range 200) (fn (i) (provide (symbol (str "adr216-bulk-" i)))))
    (refute (contains? *features* "adr216-absent"))
    (is (contains? *features* "adr216-bulk-199")))

  ;; The partial-load race: `defmodule` used to provide its feature at the TOP of the
  ;; file, so a require racing another process's load returned while the module was
  ;; half-evaluated — the caller's very next `mod/fn` call hit unbound. Now a load in
  ;; flight is tracked in *features-loading*; a concurrent requirer WAITS for the
  ;; loader's end-of-file provide. Wide module (400 defs) to keep the window open.
  (test "a concurrent load of the same module from many processes never sees it half-loaded"
    (let (path "/tmp/reqrace-mod.blsp"
          src (str "(defmodule reqrace-mod)\n"
                (string/join (map (range 400) (fn (i) (str "(def v" i " " i ")"))) "\n")
                "\n(defn ready () :ok)\n")
          saved-path *load-path*
          me (self))
      (file/spit path src)
      (reflect/set-load-path (cons "/tmp" *load-path*))
      (doseq (_k (range 8))
        (spawn (send me
                 [:req-race
                   (try
                     (do (require-one 'reqrace-mod) (reqrace-mod/ready))
                     (catch e [:err (error-message e)]))])))
      (let (results (map (range 8)
                      (fn (_) (receive ([:req-race r] r) (after test/*wait-ms* :timeout)))))
        (reflect/set-load-path saved-path)
        (file/rm path)
        (is (every? results (fn (r) (= r :ok)))))))

  ;; A FAILED load must clear the in-flight marker: a stale self-marker would make
  ;; the same process's retry match the circular-require arm and "succeed" without
  ;; loading (the later mod/fn call dies unbound with no pointer to the real error),
  ;; while every other process stalls out the full await window per attempt.
  (test "a failed require clears its loading marker; the retry re-raises the real error"
    (let (_ (try (require-one 'no-such-module-xyz) (catch _e :expected)))
      (refute (contains? *features-loading* "no-such-module-xyz"))
      ;; the retry must fail the SAME way — not fake success via a stale marker
      (assert-error (require-one 'no-such-module-xyz))))

  ;; The circular-require contract survives the fix: a module being loaded that
  ;; (directly or via :use) requires itself back must NOT deadlock or reload — the
  ;; loader pid matches the in-flight marker, so the inner require returns at once.
  (test "a circular require inside one file's own load returns immediately"
    (let (path "/tmp/reqcirc-mod.blsp"
          ;; the module requires ITSELF mid-file — the degenerate cycle
          src "(defmodule reqcirc-mod)\n(require-one 'reqcirc-mod)\n(defn ok () :yes)\n"
          saved-path *load-path*)
      (file/spit path src)
      (reflect/set-load-path (cons "/tmp" *load-path*))
      (require-one 'reqcirc-mod)
      (reflect/set-load-path saved-path)
      (file/rm path)
      (assert= (reqcirc-mod/ok) :yes)))

  ;; The same cycle split across two processes: one holds `xcyc-a` and requires `xcyc-b`,
  ;; the other holds `xcyc-b` and requires `xcyc-a`, so each load can only finish after the
  ;; other's. It deadlocked until the 30 s backstop force-loaded one end a second time while
  ;; its first load was still in flight — the parallel cold build met it on bedit (`panes`
  ;; half-published, `aside`'s `ed-layout-now` left bare). The pause after each claim makes
  ;; the cycle certain: both processes hold their module before either asks for the other's.
  ;; The process that sees the cycle backs out, and both end with both modules loaded, well
  ;; inside the backstop.
  (test "a require cycle split across two processes resolves, both modules whole"
    (let (a-path "/tmp/xcyc-a.blsp"
          b-path "/tmp/xcyc-b.blsp"
          saved-path *load-path*
          me (self))
      (file/spit a-path
        "(defmodule xcyc-a)\n(receive (after 300 nil))\n(require-one 'xcyc-b)\n(defn a () :a)\n")
      (file/spit b-path
        "(defmodule xcyc-b)\n(receive (after 300 nil))\n(require-one 'xcyc-a)\n(defn b () :b)\n")
      (reflect/set-load-path (cons "/tmp" *load-path*))
      (let (pids (seq/mapv ['xcyc-a 'xcyc-b]
                   (fn (first-module)
                     (spawn (send me
                              [:xcyc
                                (try
                                  (do (require-one first-module) [(xcyc-a/a) (xcyc-b/b)])
                                  (catch e [:err (error-message e)]))]))))
            results (seq/mapv (range 2)
                      (fn (_) (receive ([:xcyc r] r) (after 10000 :timeout))))
            ;; On a timeout, what the loader's registries held for the two keys — who claims
            ;; each, who waits on it, whether it was provided — so a red run says why.
            stuck (when (includes? results :timeout)
                    {:pids pids
                     :loading (seq/filter (%map-pairs *features-loading*)
                                (fn (pair) (string/starts-with? (first pair) "xcyc")))
                     :waiting (seq/filter (%map-pairs *features-waiting*)
                                (fn (pair) (string/starts-with? (first pair) "xcyc")))
                     :provided [(%registry-member? '*features* "xcyc-a")
                                 (%registry-member? '*features* "xcyc-b")]}))
        (reflect/set-load-path saved-path)
        (file/rm a-path)
        (file/rm b-path)
        (assert= [results stuck] [[[:a :b] [:a :b]] nil]))))

  ;; The same cycle met under HEADER clauses, as real projects meet it (`(:use …)`): P holds
  ;; `hcyc-a`, whose header chain `hcyc-c1` → `hcyc-c2` waits on `hcyc-b`, which Q holds while
  ;; it waits on `hcyc-a`. P is the one that backs out. The header pass's quiet require used
  ;; to swallow the cycle error, so each header level met the cycle again on its own require
  ;; and the waits doubled per level — `hcyc-c2`'s body ran four times before the break got
  ;; out, and a deeper chain outlasted Q's 30 s backstop. Broken once, it runs twice: the
  ;; load the break abandoned and the retry.
  (test "a require cycle met under header clauses backs out once, not once per level"
    (let (dir "/tmp"
          saved-path *load-path*
          me (self)
          spit (fn (name src) (file/spit (str dir "/" name ".blsp") src)))
      (proc/register :hcyc-runs me)
      (spit "hcyc-a" "(defmodule hcyc-a (:use hcyc-c1))\n(defn a () :a)\n")
      (spit "hcyc-c1" "(defmodule hcyc-c1 (:use hcyc-c2))\n(defn c1 () :c1)\n")
      (spit "hcyc-c2"
        (str "(defmodule hcyc-c2)\n(send (proc/whereis :hcyc-runs) :hcyc-c2-ran)\n"
          "(receive (after 300 nil))\n(require-one 'hcyc-b)\n(defn c2 () :c2)\n"))
      (spit "hcyc-b"
        "(defmodule hcyc-b)\n(receive (after 300 nil))\n(require-one 'hcyc-a)\n(defn b () :b)\n")
      (reflect/set-load-path (cons dir *load-path*))
      (map ['hcyc-a 'hcyc-b]
        (fn (first-module)
          (spawn (send me
                   [:hcyc
                     (try
                       (do (require-one first-module) [(hcyc-a/a) (hcyc-b/b) (hcyc-c2/c2)])
                       (catch e [:err (error-message e)]))]))))
      (let (results (seq/mapv (range 2) (fn (_) (receive ([:hcyc r] r) (after 20000 :timeout))))
            runs (letrec (count-runs (fn (n)
                                       (receive (:hcyc-c2-ran (count-runs (inc n))) (after 0 n))))
                   (count-runs 0)))
        (proc/unregister :hcyc-runs)
        (reflect/set-load-path saved-path)
        (doseq (m ["hcyc-a" "hcyc-c1" "hcyc-c2" "hcyc-b"]) (file/rm (str dir "/" m ".blsp")))
        (assert= [results runs] [[[:a :b :c2] [:a :b :c2]] 2]))))

  ;; A refer-all against a module ANOTHER process is mid-load is not a cycle. `require-one`
  ;; waits for that load and returns on its `provide`, which lands inside `%require-force` a
  ;; few instructions before the loader clears its marker — so a `(:use m)` evaluated in that
  ;; window saw the marker and was refused as "circular `(:use m)`" on a module with no `:use`
  ;; at all. That is how `nest release` refused every hive bundle since v0.28.0: the boot
  ;; loop loads in one process while a supervisor a module started at load pulls modules in
  ;; from another (2026-09-16). The claim is a CYCLE only when THIS process holds it.
  (test "a refer-all sees another process's finishing load as loaded, and its own as a cycle"
    (%load-string "(defmodule refer-race-target) (defn hello () :hi)")
    ;; another process's marker over a module that is already provided: refer succeeds
    (let (other (spawn (fn () (receive ([:stop] :ok)))))
      (%registry-update! '*features-loading* :assoc ["refer-race-target"] other)
      (let (r (try (do (%refer 'refer-race-target nil nil) :referred) (catch e (error-message e))))
        (%registry-update! '*features-loading* :dissoc ["refer-race-target"] nil)
        (send other [:stop])
        (assert= r :referred)))
    ;; our OWN marker is the cycle the check exists for
    (%registry-update! '*features-loading* :assoc ["refer-race-target"] (self))
    (let (r (try (do (%refer 'refer-race-target nil nil) :referred) (catch e (error-message e))))
      (%registry-update! '*features-loading* :dissoc ["refer-race-target"] nil)
      (is (includes? (str r) "circular")))))

;; `:implements` is read by the type checker (types/check/protocol.rs), which pulls the
;; clause out of the header source; the loader only has to tolerate it. It was left out
;; of `%defmodule-clause-heads` when unrecognised clauses became a hard error, so every
;; module claiming a protocol failed to load — caught by a downstream app (willem) whose
;; suite stopped loading entirely.
(describe "defmodule: the (:implements …) checker annotation"
  (test "a header claiming a protocol loads"
    (%load-string "(defmodule impl-a (:implements LiveModule)) (defn mount (p) p)")
    (assert= (impl-a/mount 7) 7))
  (test "it composes with the loader's own clauses"
    (%load-string "(defmodule impl-b) (defn helper () :ok)")
    (%load-string "(defmodule impl-c (:use impl-b) (:implements LiveModule)) (defn go () (helper))")
    (assert= (impl-c/go) :ok))
  (test "a genuinely unrecognised clause is still a hard error"
    ;; The tightening this restores an exception to must keep working — a misspelled
    ;; clause that silently does nothing is the failure mode it exists to prevent.
    (is (= (try (%load-string "(defmodule impl-d (:require foo))") (catch _e :rejected)) :rejected)))
  (test "the error names :implements among the accepted clauses"
    (let (message (try
                    (%load-string "(defmodule impl-e (:nonsense x))")
                    (catch e (error-message e))))
      (is (includes? message ":implements")))))

;; `(:use …)` import policy (ADR-065 + ADR-235): importing two modules that
;; export the same name is FINE — the clash resolves lazily, reported only if that bare name
;; is actually used (then resolvable with `:only`/`:exclude`, an alias, or a qualified call).
;; An import that shadows a prelude/root name is allowed but WARNS. Providers are set up with
;; `%load-string` (which `provide`s them, so a later `(:use …)` finds them).
(describe "modules: (:use …) import clashes and shadows"
  :isolated (test "importing two modules that share a name is fine until the name is used bare"
    (%load-string "(defmodule clpa) (defn thing (x) (list :a x))")
    (%load-string "(defmodule clpb) (defn thing (x) (list :b x))")
    ;; both :used, shared name NEVER referenced -> loads clean (no eager clash)
    ;; check-allow :discarded-catch — a did-it-throw assertion: the caught error is the answer
    (is (check-allow :discarded-catch
          (try
            (do (%load-string "(defmodule clcons (:use clpa) (:use clpb))") true)
            (catch _e false))))
    ;; referencing the shared bare name -> use-site ambiguity error naming both candidates
    (let (msg (try
                (do
                  (%load-string "(defmodule clconsu (:use clpa) (:use clpb)) (defn f (x) (thing x))")
                  :no-error)
                (catch e (error-message e))))
      (is (includes? (str msg) "ambiguous"))
      (is (includes? (str msg) "clpa/thing"))
      (is (includes? (str msg) "clpb/thing"))))
  (test ":exclude resolves a :use collision (the other module's name wins)"
    (%load-string "(defmodule clpa2) (defn thing (x) (list :a x))")
    (%load-string "(defmodule clpb2) (defn thing (x) (list :b x))")
    (%load-string (str "(defmodule clcons2 (:use clpa2) (:use clpb2 :exclude [thing]))"
                    " (defn f (x) (thing x))"))
    (assert= (clcons2/f 5) (list :a 5)))
  ;; Shadowing a prelude name via `:use` is ALLOWED (the import wins for a bare
  ;; reference) but warns on stderr — the warning is a compile-time advisory printed
  ;; directly (like the reload diagnostics), not through Brood's redirectable stream,
  ;; so this checks the behaviour; reach the prelude original as `/inc`.
  (test "a :use import that shadows a prelude name is allowed (the import wins)"
    (%load-string "(defmodule shdprov) (defn inc (x) (list :shd x))")
    (%load-string
      (str "(defmodule shdcons (:use shdprov))"
        " (defn mine (x) (inc x))" ; imported shdprov/inc wins
        " (defn orig (x) (/inc x))")) ; /inc still reaches prelude
    (assert= (shdcons/mine 5) (list :shd 5))
    (assert= (shdcons/orig 5) 6))
  (test "a module's defdyn is imported like any public name (ADR-722)"
    ;; Bare inside the importer, both to read and to `binding`; an importer that excludes
    ;; the name may declare its own.
    (%load-string "(defmodule dynprov) (defdyn *dynknob* 1) (defn knob () *dynknob*)")
    (%load-string (str "(defmodule dyncons (:use dynprov))"
                    " (defn read () *dynknob*)" " (defn bound () (binding (*dynknob* 9) (knob)))"))
    (%load-string (str "(defmodule dynown (:use dynprov :exclude [*dynknob*]))"
                    " (defdyn *dynknob* :own) (defn read () *dynknob*)"))
    (assert= (dyncons/read) 1)
    (assert= (dyncons/bound) 9)
    (assert= (dynown/read) :own)
    (assert= dynprov/*dynknob* 1))
  (test "a bare def or defdyn of an imported dynamic is refused, the qualified one sets it (ADR-722)"
    ;; Each used to set the one root variable; read as a new `dynset/*setknob*` it would
    ;; change the program silently.
    (%load-string "(defmodule setprov) (defdyn *setknob* 1)")
    (doseq (body ["(defn set-it () (def *setknob* 5))" "(defdyn *setknob* 5)"])
      (is (includes? (try
                       (do (%load-string (str "(defmodule dynset (:use setprov)) " body)) nil)
                       (catch e (error-message e)))
            "write `setprov/*setknob*` to set it")))
    (%load-string "(defmodule dynset2 (:use setprov)) (defn set-it () (def setprov/*setknob* 5))")
    (dynset2/set-it)
    (assert= setprov/*setknob* 5))
  (test "a macro template's binding of a root dynamic is pinned to it, not to the caller's own"
    ;; A root macro's `(binding (*print-length* 3) …)` expands in the CALLER's module, and
    ;; `binding` resolves its names there: a module with its own `tbm/*print-length*` used to
    ;; have the macro rebind that, while everything reading the root knob kept its value.
    (%load-string "(defmacro tbm-with-pl3 (& body) `(binding (*print-length* 3) ~@body))")
    (%load-string (str "(defmodule tbm) (defdyn tbm/*print-length* :mine)"
                    " (defn seen () (tbm-with-pl3 [/*print-length* tbm/*print-length*]))"))
    (assert= (tbm/seen) [3 :mine]))
  (test "a defonce run later, inside a function, checks its own module's name"
    (%load-string "(defmodule dfm) (defn later () (defonce *late* 9) *late*)")
    (assert= (dfm/later) 9)
    (def dfm/*late* 10)
    (assert= (dfm/later) 10))
  (test "an ambiguously imported dynamic is refused as a bare head and is a clash in binding"
    (%load-string "(defmodule amba) (defdyn *amx* 1)")
    (%load-string "(defmodule ambb) (defdyn *amx* 2)")
    (is (includes? (try
                     (do
                       (%load-string "(defmodule ambc (:use amba) (:use ambb)) (defdyn *amx* 3)")
                       nil)
                     (catch e (error-message e)))
          "a dynamic variable it imports"))
    (is (includes? (try
                     (do
                       (%load-string "(defmodule ambd (:use amba) (:use ambb)) (defn f () (binding (*amx* 4) 0))")
                       nil)
                     (catch e (error-message e)))
          "imported from more than one module")))
  (test "binding names a symbol, or says so"
    (is (includes? (try
                     (do (reflect/eval (reflect/read-string "(binding (1 2) nil)")) nil)
                     (catch e (error-message e)))
          "binding: each name must be a symbol"))))

;; A genuine circular `(:use …)` refer-all can't import a complete public set (the
;; other module is still mid-load), so it's a clear error rather than a silent
;; partial import; `:only` (lazy) stays cycle-safe. File-based (require loads from
;; the load-path), like the circular-require test above.
(describe "modules: circular :use"
  :serial (test "a circular :use refer-all errors clearly; :only is cycle-safe"
    (let (dir "/tmp"
          a1 (str dir "/cyca.blsp")
          b1 (str dir "/cycb.blsp")
          a2 (str dir "/cyca2.blsp")
          b2 (str dir "/cycb2.blsp")
          saved *load-path*)
      (file/spit a1 "(defmodule cyca (:use cycb))\n(defn a-one () 1)\n")
      (file/spit b1 "(defmodule cycb (:use cyca))\n(defn b-one () 1)\n")
      (file/spit a2 "(defmodule cyca2 (:use cycb2 :only [b-one]))\n(defn a-one () 1)\n")
      (file/spit b2 "(defmodule cycb2 (:use cyca2 :only [a-one]))\n(defn b-one () (a-one))\n")
      (reflect/set-load-path (cons dir *load-path*))
      (let (refer-all-err (try
                            (do (require-one 'cyca) :no-error)
                            (catch e (error-message e)))
            only-ok (try
                      (do (require-one 'cyca2) (cycb2/b-one))
                      (catch e [:err (error-message e)])))
        (reflect/set-load-path saved)
        (doseq (p (list a1 b1 a2 b2)) (file/rm p))
        (is (includes? (str refer-all-err) "circular"))
        (assert= only-ok 1)))))
