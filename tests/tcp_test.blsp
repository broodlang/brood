;; TCP sockets (std/tcp.blsp + the kernel tcp-* primitives, ADR-059/060). Real
;; loopback connections on 127.0.0.1 with an OS-assigned port (tcp-listen 0).
;;
;; The model delivers a socket's events to its *owning* process's mailbox, so each
;; test owns the listener, the client, and the accepted server-side socket in ONE
;; process and drives the exchange with plain `receive` — no extra spawn needed.
;; :isolated keeps these (real fds + timers) off the shared worker churn.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule tcp-test (:use test) (:use net/tcp))

(describe "tcp: predicate + handles"
  :isolated
  (test "socket? distinguishes sockets from other values"
    (let (ls (tcp-listen "127.0.0.1" 0))
      (is (socket? ls))
      (refute (socket? 5))
      (refute (socket? "x"))
      (tcp-close ls)))
  (test "tcp-local-port reports the OS-assigned port"
    (let (ls (tcp-listen "127.0.0.1" 0))
      (is (> (tcp-local-port ls) 0))
      (tcp-close ls))))

(describe "tcp: loopback echo via mailbox delivery"
  :isolated
  (test "accept, client send, server echo — all in one process"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            ;; the accept notification carries the server-side socket
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (is (socket? s))
        ;; an accepted socket is passive — take ownership to start receiving
        (tcp-controlling-process s (self))
        (tcp-send c "ping over tcp")
        ;; the server side (owned here too) receives the client's bytes
        (let (got (receive ([:tcp ^s d] d) (after *test-wait-ms* :timeout)))
          (assert= got "ping over tcp")
          (tcp-send s "pong back")
          (let (back (receive ([:tcp ^c d] d) (after *test-wait-ms* :timeout)))
            (tcp-close c)
            (tcp-close s)
            (tcp-close ls)
            (assert= back "pong back")))))))

(describe "tcp: EOF surfaces as [:tcp-closed …]"
  :isolated
  (test "closing one end delivers [:tcp-closed sock] to the other"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp-close s)
        (let (ev (receive ([:tcp-closed ^c] :closed) (after *test-wait-ms* :timeout)))
          (tcp-close c)
          (tcp-close ls)
          (assert= ev :closed))))))

(describe "tcp: tcp-drain collects a request/response"
  :isolated
  (test "drain concatenates chunks until the peer closes; returns bytes"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        ;; server writes a reply in two chunks then closes
        (tcp-send s "hello, ")
        (tcp-send s "world")
        (tcp-close s)
        (let (reply (tcp-drain c))
          (tcp-close c)
          (tcp-close ls)
          (is (bytes? reply))
          (assert= (utf8-bytes->string reply) "hello, world"))))))

(describe "tcp: opt-in idle timeout (tcp-set-idle-timeout)"
  :isolated
  (test "an armed, silent connection is reaped with [:tcp-closed]"
    ;; Neither side speaks; the client's armed idle bound reaps it. (The reap is
    ;; detected on the reactor's ~1s housekeep tick, so allow slack.)
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp-set-idle-timeout c 500)
        (let (ev (receive ([:tcp-closed ^c] :idle-closed) (after *test-wait-ms* :not-reaped)))
          (tcp-close s)
          (tcp-close ls)
          (assert= ev :idle-closed)))))
  (test "the idle clock starts at establishment, not at arm-time"
    ;; Regression: arming idle on a still-passive accepted socket, then claiming it
    ;; after longer than the bound, wrongly counted the pre-claim wait and reaped
    ;; the connection the instant it was established. It must start alive.
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        ; arm while still unclaimed/passive
        (tcp-set-idle-timeout s 500)
        ; wait past the bound, passive
        (sleep 1200)
        ; establish now
        (tcp-controlling-process s (self))
        (let (ev (receive ([:tcp-closed ^s] :reaped-BUG) (after 300 :alive)))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= ev :alive)))))
  (test "activity resets the timer — an active connection is NOT reaped"
    ;; idle bound 2000ms, but send every ~1200ms: the second send (at 1200ms)
    ;; resets the timer, so at 2400ms — past a single idle window — the connection
    ;; is still open. Without a reset it would have been reaped at ~2000ms.
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-idle-timeout c 2000)
        (tcp-send c "a")
        (sleep 1200)
        ; resets the idle stamp at ~1200ms
        (tcp-send c "b")
        ; ~2400ms total, but only ~1200ms since activity
        (sleep 1200)
        (let (still (receive ([:tcp-closed ^c] :reaped-BUG) (after 100 :alive)))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= still :alive))))))

(describe "tcp: binary mode is inbound-only (ADR-141)"
  :isolated
  (test "binary inbound is bytes; string leaves always go out as UTF-8"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        ;; one iolist send from the (text-mode) client: raw bytes + a non-ASCII
        ;; string leaf — the string must arrive as its UTF-8 bytes, proving the
        ;; send path ignores mode (no Latin-1 byte-string rule anymore)
        (tcp-send c [(bytes 0 255 128) "é"])
        (tcp-close c)
        (let (got (tcp-drain s))
          (tcp-close s)
          (tcp-close ls)
          (assert= got (bytes 0 255 128 195 169)))))))

(describe "tcp: framed reads — tcp-read-until / tcp-read-n"
  :isolated
  (test "tcp-read-until returns the frame up to+including the delimiter, plus the remainder"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "line one\r\nline two\r\n\r\nbody bytes here")
        (let (r (tcp-read-until s "\r\n\r\n"))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "line one\r\nline two\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "body bytes here")))))
  (test "tcp-read-until spans chunk boundaries (delimiter split across sends)"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "abc\r")
        (tcp-send c "\n\r\nxyz")
        (let (r (tcp-read-until s "\r\n\r\n"))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "abc\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "xyz")))))
  ;; The scan keeps only the last (|sep|-1) bytes of history, so a delimiter spread
  ;; over as many chunks as it has bytes is the exact boundary case — one byte per
  ;; chunk means every straddle slot is in use. A `tail` off by one loses the match
  ;; and the read hangs to EOF instead of framing.
  (test "tcp-read-until finds a delimiter delivered one byte per chunk"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        ;; drive the mailbox directly: the kernel is free to coalesce real socket
        ;; reads, and this case is precisely about NOT being coalesced.
        (dolist (b (list "a" "b" "\r" "\n" "\r" "\n" "z"))
          (send (self) [:tcp s (bytes-concat b)]))
        (let (r (tcp-read-until s "\r\n\r\n"))
          (assert= (utf8-bytes->string (nth r 0)) "ab\r\n\r\n")
          ;; `rest` is only surplus from the chunk that COMPLETED the delimiter, and
          ;; here that chunk is the bare "\n" — so "z" is not surplus, it is still an
          ;; unreceived message. It must survive for the next framed read.
          (assert= (utf8-bytes->string (nth r 1)) "")
          (let (r2 (tcp-read-n s 1))
            (tcp-close c)
            (tcp-close s)
            (tcp-close ls)
            (assert= (utf8-bytes->string (nth r2 0)) "z"))))))
  ;; A near-miss that shares a prefix with the delimiter must not be reported: the
  ;; straddle window carries "\r\n\r" forward, so a following "x" has to reject.
  (test "tcp-read-until does not match a partial delimiter carried across chunks"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        ;; the last chunk both completes the delimiter and carries surplus, so this
        ;; also pins the cut offset (computed from the running total + an index into
        ;; the straddle probe, never from a scan of the whole buffer).
        (dolist (b (list "h" "\r\n\r" "x" "\r\n" "\r\ntail"))
          (send (self) [:tcp s (bytes-concat b)]))
        (let (r (tcp-read-until s "\r\n\r\n"))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "h\r\n\rx\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "tail")))))
  ;; The frame boundary is computed from a running byte total plus an offset into the
  ;; straddle probe, not from a scan of the whole buffer — so the cut must still land
  ;; correctly after many chunks have gone by.
  (test "tcp-read-until cuts at the right offset after many chunks"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (dotimes (i 200) (send (self) [:tcp s (bytes-concat "0123456789")]))
        (send (self) [:tcp s (bytes-concat "END\r\n\r\nrest")])
        (let (r (tcp-read-until s "\r\n\r\n"))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (byte-length (nth r 0)) (+ 2000 3 4))
          (assert= (utf8-bytes->string (nth r 1)) "rest")))))
  (test "tcp-read-until returns [:closed acc] when the delimiter never arrives"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "no delimiter here")
        (tcp-close c)
        (let (r (tcp-read-until s "\r\n\r\n"))
          (tcp-close s)
          (tcp-close ls)
          (assert= (first r) :closed)
          (assert= (utf8-bytes->string (nth r 1)) "no delimiter here")))))
  (test "tcp-read-n returns exactly n bytes and the surplus"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "0123456789EXTRA")
        (let (r (tcp-read-n s 10))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "0123456789")
          (assert= (utf8-bytes->string (nth r 1)) "EXTRA")))))
  (test "tcp-read-n accumulates across chunks"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "aaa")
        (tcp-send c "bbbbb")
        (let (r (tcp-read-n s 6))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "aaabbb")
          (assert= (utf8-bytes->string (nth r 1)) "bb")))))
  (test "tcp-read-n returns [:closed acc] on early EOF"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "short")
        (tcp-close c)
        (let (r (tcp-read-n s 100))
          (tcp-close s)
          (tcp-close ls)
          (assert= (first r) :closed)
          (assert= (utf8-bytes->string (nth r 1)) "short"))))))

;; The limits a server needs against an untrusted peer. Each case is the shape an
;; HTTP worker actually has to answer: a client that goes silent (408), one that
;; never sends the delimiter (413), one that declares an absurd Content-Length
;; (413 before reading a byte). Without these the combinators hold a process open
;; or accumulate without bound, which is why hatch could not adopt them.
(describe "tcp: framed-read limits — :timeout-ms / :max-bytes"
  :isolated
  (test "tcp-read-until returns [:timeout acc] when the peer goes silent"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        ;; a partial head, then silence — the slow-loris hold
        (tcp-send c "GET / HTTP/1.1\r\n")
        (let (r (tcp-read-until s "\r\n\r\n" {:timeout-ms 150}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (first r) :timeout)
          (assert= (utf8-bytes->string (nth r 1)) "GET / HTTP/1.1\r\n")))))
  (test "tcp-read-until returns [:too-large acc] when the delimiter never arrives"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c (string-repeat "x" 200))
        (let (r (tcp-read-until s "\r\n\r\n" {:max-bytes 64 :timeout-ms 2000}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (first r) :too-large)))))
  (test "a frame landing exactly on :max-bytes is delivered, not rejected"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        ;; 6 bytes of head + 4 of delimiter = exactly 10
        (tcp-send c "abcdef\r\n\r\n")
        (let (r (tcp-read-until s "\r\n\r\n" {:max-bytes 10 :timeout-ms 2000}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "abcdef\r\n\r\n")))))
  (test "tcp-read-until with limits set still returns a normal frame"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "HEAD\r\n\r\nBODY")
        (let (r (tcp-read-until s "\r\n\r\n" {:max-bytes 4096 :timeout-ms 2000}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "HEAD\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "BODY")))))
  (test "tcp-read-n refuses an over-cap declared length before reading anything"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        ;; nothing is sent: the point is that the cap is decided from `n` alone,
        ;; so this returns immediately rather than blocking for bytes
        (let (r (tcp-read-n s 1000000 {:max-bytes 1024}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (first r) :too-large)))))
  (test "tcp-read-n returns [:timeout acc] when the body stalls mid-stream"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "abc")
        (let (r (tcp-read-n s 100 {:timeout-ms 150}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (first r) :timeout)
          (assert= (utf8-bytes->string (nth r 1)) "abc")))))
  (test "tcp-read-n with limits set still returns a normal body"
    (let (ls (tcp-listen "127.0.0.1" 0)
          port (tcp-local-port ls))
      (let (c (tcp-connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp-controlling-process s (self))
        (tcp-set-binary s true)
        (tcp-send c "0123456789EXTRA")
        (let (r (tcp-read-n s 10 {:max-bytes 4096 :timeout-ms 2000}))
          (tcp-close c)
          (tcp-close s)
          (tcp-close ls)
          (assert= (utf8-bytes->string (nth r 0)) "0123456789")
          (assert= (utf8-bytes->string (nth r 1)) "EXTRA"))))))
