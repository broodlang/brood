;; TCP sockets (std/tcp.blsp + the kernel tcp-* primitives, ADR-059/060). Real
;; loopback connections on 127.0.0.1 with an OS-assigned port (tcp/listen 0).
;;
;; The model delivers a socket's events to its *owning* process's mailbox, so each
;; test owns the listener, the client, and the accepted server-side socket in ONE
;; process and drives the exchange with plain `receive` — no extra spawn needed.
;; :isolated keeps these (real fds + timers) off the shared worker churn.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule tcp-test (:use test) (:use tcp :exclude [send]))

(describe "tcp: predicate + handles"
  :isolated
  (test "socket? distinguishes sockets from other values"
    (let (ls (tcp/listen "127.0.0.1" 0))
      (is (socket? ls))
      (refute (socket? 5))
      (refute (socket? "x"))
      (tcp/close ls)))
  (test "tcp/local-port reports the OS-assigned port"
    (let (ls (tcp/listen "127.0.0.1" 0))
      (is (> (tcp/local-port ls) 0))
      (tcp/close ls))))

(describe "tcp: loopback echo via mailbox delivery"
  :isolated
  (test "accept, client send, server echo — all in one process"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            ;; the accept notification carries the server-side socket
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (is (socket? s))
        ;; an accepted socket is passive — take ownership to start receiving
        (tcp/controlling-process s (self))
        (tcp/send c "ping over tcp")
        ;; the server side (owned here too) receives the client's bytes
        (let (got (receive ([:tcp ^s d] d) (after *test-wait-ms* :timeout)))
          (assert= got "ping over tcp")
          (tcp/send s "pong back")
          (let (back (receive ([:tcp ^c d] d) (after *test-wait-ms* :timeout)))
            (tcp/close c)
            (tcp/close s)
            (tcp/close ls)
            (assert= back "pong back")))))))

(describe "tcp: EOF surfaces as [:tcp-closed …]"
  :isolated
  (test "closing one end delivers [:tcp-closed sock] to the other"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp/close s)
        (let (ev (receive ([:tcp-closed ^c] :closed) (after *test-wait-ms* :timeout)))
          (tcp/close c)
          (tcp/close ls)
          (assert= ev :closed))))))

(describe "tcp: drain collects a request/response"
  :isolated
  (test "drain concatenates chunks until the peer closes; returns bytes"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        ;; server writes a reply in two chunks then closes
        (tcp/send s "hello, ")
        (tcp/send s "world")
        (tcp/close s)
        (let (reply (drain c))
          (tcp/close c)
          (tcp/close ls)
          (is (bytes? reply))
          (assert= (utf8-bytes->string reply) "hello, world"))))))

(describe "tcp: opt-in idle timeout (tcp/set-idle-timeout)"
  :isolated
  (test "an armed, silent connection is reaped with [:tcp-closed]"
    ;; Neither side speaks; the client's armed idle bound reaps it. (The reap is
    ;; detected on the reactor's ~1s housekeep tick, so allow slack.)
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp/set-idle-timeout c 500)
        (let (ev (receive ([:tcp-closed ^c] :idle-closed) (after *test-wait-ms* :not-reaped)))
          (tcp/close s)
          (tcp/close ls)
          (assert= ev :idle-closed)))))
  (test "the idle clock starts at establishment, not at arm-time"
    ;; Regression: arming idle on a still-passive accepted socket, then claiming it
    ;; after longer than the bound, wrongly counted the pre-claim wait and reaped
    ;; the connection the instant it was established. It must start alive.
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        ; arm while still unclaimed/passive
        (tcp/set-idle-timeout s 500)
        ; wait past the bound, passive
        (sleep 1200)
        ; establish now
        (tcp/controlling-process s (self))
        (let (ev (receive ([:tcp-closed ^s] :reaped-BUG) (after 300 :alive)))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= ev :alive)))))
  (test "activity resets the timer — an active connection is NOT reaped"
    ;; Idle bound 2000 ms, five sends 500 ms apart. Both halves of the property hold with
    ;; margin: total elapsed (~2500 ms) is PAST the bound, so an implementation that ignored
    ;; activity would have reaped by now — and no more than ~500 ms ever passes since a send,
    ;; a **4x** margin under the bound.
    ;;
    ;; It used to send every 1200 ms, which left only 1.67x, and a `sleep` that overshoots
    ;; (a green process rescheduled late on a loaded box) then crosses the bound and the test
    ;; reports `:reaped-BUG`. Seen once 2026-08-17 under a doubled load — KI-43's shape, a
    ;; deadline standing in for an event. Here the deadline is the *subject*, so it cannot be
    ;; replaced by waiting on an event; the fix is margin on both sides instead.
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-idle-timeout c 2000)
        ;; Each send resets the idle stamp; the last one leaves ~500 ms on the clock.
        (dotimes (_ 5)
          (tcp/send c "a")
          (sleep 500))
        (let (still (receive ([:tcp-closed ^c] :reaped-BUG) (after 100 :alive)))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= still :alive))))))

(describe "tcp: binary mode is inbound-only (ADR-141)"
  :isolated
  (test "binary inbound is bytes; string leaves always go out as UTF-8"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after *test-wait-ms* :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; one iolist send from the (text-mode) client: raw bytes + a non-ASCII
        ;; string leaf — the string must arrive as its UTF-8 bytes, proving the
        ;; send path ignores mode (no Latin-1 byte-string rule anymore)
        (tcp/send c [(bytes 0 255 128) "é"])
        (tcp/close c)
        (let (got (drain s))
          (tcp/close s)
          (tcp/close ls)
          (assert= got (bytes 0 255 128 195 169)))))))

(describe "tcp: framed reads — read-until / read-n"
  :isolated
  (test "read-until returns the frame up to+including the delimiter, plus the remainder"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "line one\r\nline two\r\n\r\nbody bytes here")
        (let (r (read-until s "\r\n\r\n"))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "line one\r\nline two\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "body bytes here")))))
  (test "read-until spans chunk boundaries (delimiter split across sends)"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "abc\r")
        (tcp/send c "\n\r\nxyz")
        (let (r (read-until s "\r\n\r\n"))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "abc\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "xyz")))))
  ;; The scan keeps only the last (|sep|-1) bytes of history, so a delimiter spread
  ;; over as many chunks as it has bytes is the exact boundary case — one byte per
  ;; chunk means every straddle slot is in use. A `tail` off by one loses the match
  ;; and the read hangs to EOF instead of framing.
  (test "read-until finds a delimiter delivered one byte per chunk"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; drive the mailbox directly: the kernel is free to coalesce real socket
        ;; reads, and this case is precisely about NOT being coalesced.
        (dolist (b (list "a" "b" "\r" "\n" "\r" "\n" "z"))
          (send (self) [:tcp s (bytes-concat b)]))
        (let (r (read-until s "\r\n\r\n"))
          (assert= (utf8-bytes->string (nth r 0)) "ab\r\n\r\n")
          ;; `rest` is only surplus from the chunk that COMPLETED the delimiter, and
          ;; here that chunk is the bare "\n" — so "z" is not surplus, it is still an
          ;; unreceived message. It must survive for the next framed read.
          (assert= (utf8-bytes->string (nth r 1)) "")
          (let (r2 (read-n s 1))
            (tcp/close c)
            (tcp/close s)
            (tcp/close ls)
            (assert= (utf8-bytes->string (nth r2 0)) "z"))))))
  ;; A near-miss that shares a prefix with the delimiter must not be reported: the
  ;; straddle window carries "\r\n\r" forward, so a following "x" has to reject.
  (test "read-until does not match a partial delimiter carried across chunks"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; the last chunk both completes the delimiter and carries surplus, so this
        ;; also pins the cut offset (computed from the running total + an index into
        ;; the straddle probe, never from a scan of the whole buffer).
        (dolist (b (list "h" "\r\n\r" "x" "\r\n" "\r\ntail"))
          (send (self) [:tcp s (bytes-concat b)]))
        (let (r (read-until s "\r\n\r\n"))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "h\r\n\rx\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "tail")))))
  ;; The frame boundary is computed from a running byte total plus an offset into the
  ;; straddle probe, not from a scan of the whole buffer — so the cut must still land
  ;; correctly after many chunks have gone by.
  (test "read-until cuts at the right offset after many chunks"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (dotimes (i 200) (send (self) [:tcp s (bytes-concat "0123456789")]))
        (send (self) [:tcp s (bytes-concat "END\r\n\r\nrest")])
        (let (r (read-until s "\r\n\r\n"))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (byte-length (nth r 0)) (+ 2000 3 4))
          (assert= (utf8-bytes->string (nth r 1)) "rest")))))
  (test "read-until returns [:closed acc] when the delimiter never arrives"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "no delimiter here")
        (tcp/close c)
        (let (r (read-until s "\r\n\r\n"))
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :closed)
          (assert= (utf8-bytes->string (nth r 1)) "no delimiter here")))))
  (test "read-n returns exactly n bytes and the surplus"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "0123456789EXTRA")
        (let (r (read-n s 10))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "0123456789")
          (assert= (utf8-bytes->string (nth r 1)) "EXTRA")))))
  (test "read-n accumulates across chunks"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "aaa")
        (tcp/send c "bbbbb")
        (let (r (read-n s 6))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "aaabbb")
          (assert= (utf8-bytes->string (nth r 1)) "bb")))))
  (test "read-n returns [:closed acc] on early EOF"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "short")
        (tcp/close c)
        (let (r (read-n s 100))
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :closed)
          (assert= (utf8-bytes->string (nth r 1)) "short"))))))

;; The limits a server needs against an untrusted peer. Each case is the shape an
;; HTTP worker actually has to answer: a client that goes silent (408), one that
;; never sends the delimiter (413), one that declares an absurd Content-Length
;; (413 before reading a byte). Without these the combinators hold a process open
;; or accumulate without bound, which is why hatch could not adopt them.
(describe "tcp: framed-read limits — :timeout-ms / :max-bytes"
  :isolated
  (test "read-until returns [:timeout acc] when the peer goes silent"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; a partial head, then silence — the slow-loris hold
        (tcp/send c "GET / HTTP/1.1\r\n")
        (let (r (read-until s "\r\n\r\n" {:timeout-ms 150}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :timeout)
          (assert= (utf8-bytes->string (nth r 1)) "GET / HTTP/1.1\r\n")))))
  (test "read-until returns [:too-large acc] when the delimiter never arrives"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c (string/repeat "x" 200))
        (let (r (read-until s "\r\n\r\n" {:max-bytes 64 :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :too-large)))))
  (test "a frame landing exactly on :max-bytes is delivered, not rejected"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; 6 bytes of head + 4 of delimiter = exactly 10
        (tcp/send c "abcdef\r\n\r\n")
        (let (r (read-until s "\r\n\r\n" {:max-bytes 10 :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "abcdef\r\n\r\n")))))
  (test "read-until with limits set still returns a normal frame"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "HEAD\r\n\r\nBODY")
        (let (r (read-until s "\r\n\r\n" {:max-bytes 4096 :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "HEAD\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "BODY")))))
  (test "read-n refuses an over-cap declared length before reading anything"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; nothing is sent: the point is that the cap is decided from `n` alone,
        ;; so this returns immediately rather than blocking for bytes
        (let (r (read-n s 1000000 {:max-bytes 1024}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :too-large)))))
  (test "read-n returns [:timeout acc] when the body stalls mid-stream"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "abc")
        (let (r (read-n s 100 {:timeout-ms 150}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :timeout)
          (assert= (utf8-bytes->string (nth r 1)) "abc")))))
  (test "read-n with limits set still returns a normal body"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "0123456789EXTRA")
        (let (r (read-n s 10 {:max-bytes 4096 :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "0123456789")
          (assert= (utf8-bytes->string (nth r 1)) "EXTRA"))))))

;; The bound the other two leave open. A peer that drip-feeds — one byte, just inside
;; the idle timeout, forever — defeats `:timeout-ms` (every chunk re-arms it) and is
;; only SIZE-bounded by `:max-bytes`, so it can hold a worker for max-bytes × idle.
;; `:deadline-ms` is a total budget measured once at the call, so a drip that never
;; completes the frame is cut off on time. Found by hatch, whose HTTP head reader had
;; hand-rolled exactly this and so could not adopt the combinators without it.
(defn drip-bytes (sock n gap)
  "Send `n` single bytes `gap` ms apart — a peer that is always talking and never
  finishes its frame."
  (when (> n 0)
    (tcp/send sock "x")
    (sleep gap)
    (drip-bytes sock (- n 1) gap)))

(describe "tcp: framed-read limits — :deadline-ms (total budget)"
  :isolated
  (test "a drip that keeps re-arming the idle timeout is still cut off by the deadline"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; 40ms between bytes against a 250ms idle timeout: the idle timer is re-armed
        ;; every time and can never fire. Only the 300ms total deadline ends this.
        (spawn (drip-bytes c 100 40))
        (let (started (now)
              r (read-until s "\r\n\r\n" {:timeout-ms 250 :deadline-ms 300})
              elapsed (- (now) started))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :timeout)
          ;; It really was the deadline, not the drip running out: we stopped near 300ms,
          ;; well before the drip would have finished (100 x 40ms = 4s). The bound is 3s, not
          ;; something tight around 300ms — a wall-clock assertion has to survive a loaded
          ;; machine, and anything under 4s still discriminates "the deadline fired" from
          ;; "we waited for the peer".
          (assert= (< elapsed 3000) true)
          ;; and bytes really were arriving throughout — the idle timer was being reset
          (assert= (> (byte-length (nth r 1)) 1) true)))))
  (test "a frame that arrives inside the deadline is delivered normally"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "GET / HTTP/1.1\r\n\r\nBODY")
        (let (r (read-until s "\r\n\r\n" {:timeout-ms 2000 :deadline-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "GET / HTTP/1.1\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "BODY")))))
  (test "an already-expired deadline fires at once rather than waiting"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; :deadline-ms 0 — the budget is gone before the first receive. The wait is
        ;; floored at 1ms, so this must return immediately, not block on `after 0`.
        (let (started (now)
              r (read-until s "\r\n\r\n" {:deadline-ms 0})
              elapsed (- (now) started))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :timeout)
          ;; generous for a call that should return in ~1ms — it only has to prove we did not
          ;; block, and a wall-clock bound must survive a loaded machine
          (assert= (< elapsed 3000) true)))))
  (test "read-n is bounded by the deadline too"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; a declared 100-byte body that drips in and never completes in time
        (spawn (drip-bytes c 100 40))
        (let (started (now)
              r (read-n s 100 {:timeout-ms 250 :deadline-ms 300})
              elapsed (- (now) started))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :timeout)
          ;; same bound, same reasoning as the read-until case above
          (assert= (< elapsed 3000) true))))))

;; `:seed` — the bytes a caller already holds. A protocol reading frame after frame off one
;; stream ends each read holding the surplus past the frame it wanted, so the next read starts
;; with bytes in hand; those may contain the delimiter, or its first half. hatch's HTTP worker
;; re-enters its head read with the leftover of a pipelined request, which is exactly this.
(describe "tcp: framed reads — :seed (bytes already in hand)"
  :isolated
  (test "a seed containing the whole frame returns without reading the socket"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; nothing is ever sent on the socket — the answer is entirely in the seed
        (let (r (read-until s
                  "\r\n\r\n"
                  {:seed (string->utf8-bytes "GET / HTTP/1.1\r\n\r\nEXTRA") :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "GET / HTTP/1.1\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "EXTRA")))))
  (test "a delimiter straddling the seed and the first chunk is still found"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        ;; the seed ends mid-terminator ("\r\n\r"); the socket delivers the final "\n".
        ;; This is the case a caller cannot handle by scanning the seed itself.
        (tcp/send c "\nBODY")
        (let (r (read-until s
                  "\r\n\r\n"
                  {:seed (string->utf8-bytes "GET / HTTP/1.1\r\n\r") :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "GET / HTTP/1.1\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "BODY")))))
  (test "a seed short of the delimiter continues into the socket"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "Host: x\r\n\r\nREST")
        (let (r (read-until s
                  "\r\n\r\n"
                  {:seed (string->utf8-bytes "GET / HTTP/1.1\r\n") :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "REST")))))
  (test "the seed counts toward :max-bytes"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (let (r (read-until s
                  "\r\n\r\n"
                  {:seed (string->utf8-bytes (string/repeat "x" 200))
                   :max-bytes 64
                   :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (first r) :too-large)))))
  (test "an empty seed behaves exactly like no seed"
    (let (ls (tcp/listen "127.0.0.1" 0)
          port (tcp/local-port ls))
      (let (c (tcp/connect "127.0.0.1" port)
            s (receive ([:tcp-accept ^ls cs] cs) (after 5000 :timeout)))
        (tcp/controlling-process s (self))
        (tcp/set-binary s true)
        (tcp/send c "LINE\r\n\r\nTAIL")
        (let (r (read-until s "\r\n\r\n" {:seed #b"" :timeout-ms 2000}))
          (tcp/close c)
          (tcp/close s)
          (tcp/close ls)
          (assert= (utf8-bytes->string (nth r 0)) "LINE\r\n\r\n")
          (assert= (utf8-bytes->string (nth r 1)) "TAIL"))))))
