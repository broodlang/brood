;; The bridge's pure half: what goes on the wire and what is accepted off it. The
;; server itself is exercised by hand (serve an app, `editor/web/listen`, then curl or a
;; tab) — a test that bound a port would fight other suites for it.
(defmodule editor-web-test (:use editor/web) (:use-internals editor/web) (:use test))

(describe "frame-json"
  (test "a frame's ops become JSON arrays, keywords as strings"
    (assert= (frame-json [[:clear] [:quad 0 0 1 1 :red 0.0]])
      "[[\"clear\"],[\"quad\",0,0,1,1,\"red\",0.0]]"))

  (test "a frame the encoder cannot carry (raw bytes in a bitboard op) is nil, not an error"
    (assert= (frame-json [[:cells 0 0 8 1 (bytes 255) :red]]) nil)))

(describe "texture-json"
  (test "bytes and int vectors both encode as base64 pixels"
    (let (expected {:tex 3 :w 1 :h 1 :rgba "AQIDBA=="})
      (assert= (json/decode (texture-json 3 (bytes 1 2 3 4) 1 1)) expected)
      (assert= (json/decode (texture-json 3 [1 2 3 4] 1 1)) expected))))

(describe "parse-input: read, never evaluated, only a window's shapes"
  (test "a key, a keyword and a mouse vector are accepted as data"
    (assert= (parse-input "\"a\"") "a")
    (assert= (parse-input ":escape") :escape)
    (assert= (parse-input "[:mouse :press :left 20 10 [] 1]") [:mouse :press :left 20 10 [] 1])
    (assert= (parse-input "[:key-up \"a\"]") [:key-up "a"]))

  (test "a call form, a map, a number and garbage are dropped"
    (assert= (parse-input "(system/halt 1)") nil)
    (assert= (parse-input "{:a 1}") nil)
    (assert= (parse-input "42") nil)
    (assert= (parse-input "[:unterminated") nil)
    (assert= (parse-input "") nil)))

(describe "input-tab"
  (test "the tab id is the path's tail, and nothing else matches"
    (assert= (input-tab "/input/7") 7)
    (assert= (input-tab "/input/") nil)
    (assert= (input-tab "/input/x") nil)
    (assert= (input-tab "/events") nil)))

;; A stand-in for a session's loop: every message it is sent goes to `report` as `[tag m]`.
(defn web-loop-stand-in (report tag)
  (receive (m (do (send report [tag m]) (web-loop-stand-in report tag)))))

(defn web-post (id text)
  (editor/web/input {:path (str "/input/" id) :body (string/->bytes text)}))

(defn web-next (tag)
  (receive ([^tag m] m) (after test/*wait-ms* :none)))

(describe "a tab's input across a restarted loop (ADR-605)"
  (test "an input posted while the stream takes in a restart goes to the new loop, numbered after the rest"
    ;; the stream process owns the tab's input: a post is queued behind the [:reattached …]
    ;; it has not folded yet, so it is never sent to the dead loop, nor wiped from the log
    ;; by the resend, nor its number reused
    (let (me (self)
          id 900001
          supervisor (spawn (receive (:stop nil)))
          old-loop (spawn (web-loop-stand-in me :old))
          new-loop (spawn (web-loop-stand-in me :new))
          tab (spawn (editor/web/tab-run nil id old-loop)))
      (send tab [:session supervisor])
      ;; the post waits for the stream to know the tab: it answers 404 until then
      (letrec (await-tab (fn (left)
                           (when (and (> left 0) (not (= (table/get (editor/web/tabs) id nil) tab)))
                             (receive (after 10 (await-tab (dec left)))))))
        (await-tab 200))
      (assert= (:status (web-post id "\"a\"")) 204)
      (assert= (web-next :old) [:key "a" false 1])
      ;; the dead loop took none; the restart and a post race to the stream
      (send tab [:reattached new-loop supervisor nil])
      (web-post id "\"b\"")
      (assert= (web-next :new) [:key "a" false 1])
      (assert= (web-next :new) [:key "b" false 2])
      (web-post id "\"c\"")
      (assert= (web-next :new) [:key "c" false 3])
      (assert= (receive ([:old m] m) (after 0 :none)) :none)
      (assert= (:status (web-post 900002 "\"d\"")) 404)
      (exit tab :kill)
      (send supervisor :stop))))
