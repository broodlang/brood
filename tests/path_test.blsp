(defmodule path-test (:use test))

(describe "path/basename"
  (test "simple file"
    (assert= "file.txt" (path/basename "/usr/local/file.txt")))
  (test "no directory"
    (assert= "file.txt" (path/basename "file.txt")))
  (test "trailing slash ignored"
    (assert= "bin" (path/basename "/usr/local/bin/")))
  (test "root"
    (assert= "/" (path/basename "/")))
  (test "nested"
    (assert= "c" (path/basename "a/b/c"))))

(describe "path/dirname"
  (test "simple"
    (assert= "/usr/local" (path/dirname "/usr/local/file.txt")))
  (test "top-level"
    (assert= "/" (path/dirname "/file.txt")))
  (test "bare name gives ."
    (assert= "." (path/dirname "file.txt")))
  (test "trailing slash"
    (assert= "/usr" (path/dirname "/usr/bin/")))
  (test "nested"
    (assert= "a/b" (path/dirname "a/b/c"))))

(describe "path/extension"
  (test "simple extension"
    (assert= ".txt" (path/extension "file.txt")))
  (test "compound extension takes last"
    (assert= ".gz" (path/extension "report.tar.gz")))
  (test "no extension"
    (assert= "" (path/extension "Makefile")))
  (test "hidden file no extension"
    (assert= "" (path/extension ".gitignore")))
  (test "hidden file with extension"
    (assert= ".toml" (path/extension ".cargo.toml")))
  (test "path with directory"
    (assert= ".rs" (path/extension "/src/main.rs"))))

(describe "path/stem"
  (test "simple"
    (assert= "file" (path/stem "file.txt")))
  (test "compound — keeps all but last extension"
    (assert= "report.tar" (path/stem "report.tar.gz")))
  (test "no extension"
    (assert= "Makefile" (path/stem "Makefile")))
  (test "hidden file"
    (assert= ".gitignore" (path/stem ".gitignore"))))

(describe "path/join"
  (test "two absolute parts"
    (assert= "/usr/local" (path/join "/usr" "local")))
  (test "absolute resets"
    (assert= "/b/c" (path/join "a" "/b" "c")))
  (test "trailing slash in segment"
    (assert= "/usr/local/bin" (path/join "/usr/local" "bin")))
  (test "no args gives ."
    (assert= "." (path/join)))
  (test "single absolute"
    (assert= "/" (path/join "/")))
  (test "relative components"
    (assert= "a/b/c" (path/join "a" "b" "c"))))

(describe "path/split"
  (test "absolute path"
    (assert= '("/" "usr" "local" "bin") (path/split "/usr/local/bin")))
  (test "relative path"
    (assert= '("a" "b" "c") (path/split "a/b/c")))
  (test "double slash collapsed"
    (assert= '("/" "usr" "bin") (path/split "/usr//bin")))
  (test "single slash"
    (assert= '("/") (path/split "/"))))

(describe "path/normalize"
  (test "removes dot"
    (assert= "a/c" (path/normalize "a/./c")))
  (test "removes double-dot"
    (assert= "a/c" (path/normalize "a/b/../c")))
  (test "absolute with .."
    (assert= "/a/c" (path/normalize "/a/b/../c")))
  (test "multiple .."
    (assert= "c" (path/normalize "a/b/../../c")))
  (test "already clean"
    (assert= "a/b/c" (path/normalize "a/b/c")))
  (test "empty becomes ."
    (assert= "." (path/normalize "a/..")))
  (test ".. above an absolute root is discarded (no parent of /)"
    (assert= "/" (path/normalize "/.."))
    (assert= "/" (path/normalize "/a/../.."))
    (assert= "/a" (path/normalize "/../../a"))
    (assert= "/" (path/normalize "/a/b/../../..")))
  (test "a relative path still keeps leading .. (only the absolute root clamps)"
    (assert= ".." (path/normalize "a/../.."))
    (assert= "../x" (path/normalize "a/../../x"))))

(describe "path/relative-to"
  (test "child path"
    (assert= "c" (path/relative-to "/a/b/c" "/a/b")))
  (test "same path"
    (assert= "." (path/relative-to "/a/b" "/a/b")))
  (test "sibling"
    (assert= "../d" (path/relative-to "/a/d" "/a/b")))
  (test "deeper sibling"
    (assert= "../../x/y" (path/relative-to "/a/x/y" "/a/b/c"))))

(describe "path/absolute?"
  (test "absolute"
    (is (path/absolute? "/usr/local")))
  (test "relative"
    (is (not (path/absolute? "usr/local"))))
  (test "dot"
    (is (not (path/absolute? ".")))))

(describe "path/with-extension"
  (test "replace extension"
    (assert= "foo.md" (path/with-extension "foo.txt" ".md")))
  (test "remove extension"
    (assert= "foo" (path/with-extension "foo.txt" "")))
  (test "add extension"
    (assert= "Makefile.bak" (path/with-extension "Makefile" ".bak"))))

(describe "path/abbreviate"
  (test "a path under the home starts with ~, the home itself is ~"
    (let (home (or (%getenv "HOME") ""))
      (assert= (path/abbreviate (str home "/src/x")) "~/src/x")
      (assert= (path/abbreviate home) "~")))
  (test "a path outside the home is unchanged — even one that starts with its text"
    (let (home (%getenv "HOME"))
      (assert= (path/abbreviate "/tmp/x") "/tmp/x")
      (assert= (path/abbreviate (str home "2/x")) (str home "2/x"))))
  (test "round-trips with absolute"
    (let (home (%getenv "HOME"))
      (assert= (path/absolute (path/abbreviate (str home "/a"))) (str home "/a")))))

(describe "path/absolute and ~"
  (test "~ and ~/ are the home"
    (let (home (%getenv "HOME"))
      (when home
        (assert= (path/absolute "~") home)
        (assert= (path/absolute "~/a/b") (str home "/a/b")))))
  (test "~name and ~name/ are that user's home"
    (let (root-home (%user-home "root"))
      (when root-home
        (assert= (path/absolute "~root") root-home)
        (assert= (path/absolute "~root/x/") (str root-home "/x/")))))
  (test "a ~name that is no user is a relative file name"
    (assert= (path/absolute "~brood-surely-no-such-user/x" "/base")
      "/base/~brood-surely-no-such-user/x")))

(describe "%user-home"
  (test "an unknown user has no home"
    (assert= (%user-home "brood-surely-no-such-user") nil))
  (test "the empty name is no user"
    (assert= (%user-home "") nil)))

(describe "path/expand-env"
  (test "$NAME and ${NAME} are the environment's"
    (let (home (%getenv "HOME"))
      (assert= (path/expand-env "$HOME/a") (str home "/a"))
      (assert= (path/expand-env "${HOME}x") (str home "x"))))
  (test "$$ is a literal dollar, and an unset variable stays as typed"
    (assert= (path/expand-env "a$$b") "a$b")
    (assert= (path/expand-env "$$HOME") "$HOME")
    (assert= (path/expand-env "/x/$BROOD_SURELY_UNSET/y") "/x/$BROOD_SURELY_UNSET/y"))
  (test "a lone or trailing $ is left alone"
    (assert= (path/expand-env "a$") "a$")
    (assert= (path/expand-env "$1") "$1"))
  (test "escape-env is its inverse"
    (assert= (path/expand-env (path/escape-env "/t/a$HOME$$")) "/t/a$HOME$$")))

(describe "path/substitute"
  (test "// starts the path over"
    (assert= (path/substitute "~/src//etc/hosts") "/etc/hosts")
    (assert= (path/substitute-start "~/src//etc/") 6))
  (test "/~/ starts over at the home, still spelled ~"
    (assert= (path/substitute "/usr/lib/~/notes") "~/notes")
    (assert= (path/substitute-start "/usr/lib/~/x") 9))
  (test "a ~name that is no user is an ordinary component"
    (assert= (path/substitute "/tmp/~brood-surely-no-such-user/x")
      "/tmp/~brood-surely-no-such-user/x"))
  (test "keep? claims a ~ component as a file of the directory before it"
    (let (seen (path/substitute "/srv/$$a/~/x" (fn (directory _component) (= directory "/srv/$a/"))))
      (assert= seen "/srv/$a/~/x")))
  (test "a variable that holds an absolute path starts over too"
    (assert= (path/substitute "/tmp/$HOME/a") (str (%getenv "HOME") "/a")))
  (test "nothing to substitute is the text as typed"
    (assert= (path/substitute "") "")
    (assert= (path/substitute "a/b") "a/b")
    (assert= (path/substitute-start "/") 0)))

;; Windows's roots (ADR-592), pinned on every host by `path/*windows-rules*`: a walk up the
;; tree (`dirname` until it stops changing) must end at the drive or the share, never fall
;; through to "." and so to the working directory.
(defn- windows-rules (thunk) (binding (path/*windows-rules* true) (thunk)))
(defn- posix-rules (thunk) (binding (path/*windows-rules* false) (thunk)))

(defn- walk-up (p)
  (let (parent (path/dirname p)) (if (= parent p) p (walk-up parent))))

(describe "path roots on Windows: a drive and a share are fixed points"
  (test "dirname stops at the drive's root"
    (windows-rules (fn ()
                     (assert= (path/dirname "C:/Users") "C:/")
                     (assert= (path/dirname "C:/") "C:/")
                     (assert= (path/dirname "C:") "C:")
                     (assert= (path/dirname "C:/a/b") "C:/a")
                     (assert= (path/dirname "C:\\Users") "C:/"))))
  (test "dirname stops at a UNC share's root"
    (windows-rules (fn ()
                     (assert= (path/dirname "//srv/share/x") "//srv/share/")
                     (assert= (path/dirname "//srv/share/") "//srv/share/")
                     (assert= (path/dirname "//srv/share/x/y") "//srv/share/x"))))
  (test "a walk up ends at the root it started under"
    (windows-rules (fn ()
                     (assert= (walk-up "C:/Users/me/src/app/a.rs") "C:/")
                     (assert= (walk-up "D:/work") "D:/")
                     (assert= (walk-up "//srv/share/proj/a") "//srv/share/"))))
  (test "normalize keeps the root, and .. above it is discarded"
    (windows-rules (fn ()
                     (assert= (path/normalize "C:/") "C:/")
                     (assert= (path/normalize "C:/..") "C:/")
                     (assert= (path/normalize "C:/a/../b") "C:/b")
                     (assert= (path/normalize "//srv/share/x") "//srv/share/x")
                     (assert= (path/normalize "//srv/share/x/../..") "//srv/share/"))))
  (test "a typed path keeps a leading // as a share; // part-way restarts at the second slash"
    (windows-rules (fn ()
                     (assert= (path/substitute "//srv/share/x") "//srv/share/x")
                     (assert= (path/substitute "C:/x//srv/share") "/srv/share")
                     (assert= (path/substitute "/x/C:/y") "C:/y"))))
  (test "under POSIX rules nothing changes: C: is a name, // restarts"
    (posix-rules (fn ()
                   (assert= (path/dirname "C:/Users") "C:")
                   (assert= (path/normalize "C:/..") ".")
                   (assert= (path/normalize "//srv/share/x") "/srv/share/x")
                   (assert= (path/substitute "/a//etc") "/etc")
                   (assert= (walk-up "/a/b/c") "/")))))

(describe "file: URIs (RFC 8089)"
  (test "a POSIX path, segments percent-encoded, and back"
    (posix-rules (fn ()
                   (assert= (path/->file-uri "/my project/a.rs") "file:///my%20project/a.rs")
                   (assert= (path/file-uri-> "file:///my%20project/a.rs") "/my project/a.rs")
                   (assert= (path/file-uri-> "file:/x/y") "/x/y")
                   (assert= (path/file-uri-> "file://localhost/x") "/x")
                   (assert= (path/file-uri-> "file:///c%3A/x") "/c:/x"))))
  (test "a drive path is file:///C:/x, and VS Code's file:///c%3A/x reads back as C:/x"
    (windows-rules (fn ()
                     (assert= (path/->file-uri "C:/x/a b.rs") "file:///C:/x/a%20b.rs")
                     (assert= (path/->file-uri "C:\\x\\a.rs") "file:///C:/x/a.rs")
                     (assert= (path/file-uri-> "file:///C:/x/a.rs") "C:/x/a.rs")
                     (assert= (path/file-uri-> "file:///c%3A/x/a.rs") "C:/x/a.rs")
                     (assert= (path/file-uri-> (path/->file-uri "C:/x y/é.rs")) "C:/x y/é.rs"))))
  (test "a UNC path is the URI's host"
    (windows-rules (fn ()
                     (assert= (path/->file-uri "//srv/share/x") "file://srv/share/x")
                     (assert= (path/file-uri-> "file://srv/share/x") "//srv/share/x"))))
  (test "anything else is not a file URI"
    (is (nil? (path/file-uri-> "https://example.org/x")))))
