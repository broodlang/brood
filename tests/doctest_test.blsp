;; Tests for `std/tool/doctest.blsp` — the engine behind the docstring gate.
;;
;; The engine itself is exercised end-to-end by `tests/doc_examples_test.blsp`, which points
;; it at the whole standard library. These cases pin the PARTS, so a failure says which rule
;; broke rather than only that some example somewhere stopped holding.

(defmodule doctest-test (:use test))

(describe "example-lines"
  (test "only an indented line with a form before ` ;=> ` is a case"
    ;; The indent is the whole discriminator between an example and a sentence — much prose
    ;; names values that do not exist outside the sentence.
    (assert= 1 (count (doctest/example-lines "prose\n    (+ 1 1)   ;=> 2")))
    (assert= [] (apply vector (doctest/example-lines "see (+ 1 1) ;=> 2 for why")))
    (assert= [] (apply vector (doctest/example-lines "    (+ 1 1) is two")))
    (assert= [] (apply vector (doctest/example-lines "")))))

(describe "check"
  (test "a holding example returns nil"
    (assert= nil (doctest/check "p" "    (+ 1 1)   ;=> 2"))
    (assert= nil (doctest/check "p" "    (->string :a)  ;=> \"a\"")))
  (test "a broken one describes the gap, naming both sides"
    (let (m (doctest/check "p" "    (+ 1 1)   ;=> 3"))
      (is (not (nil? m)))
      (is (includes? m "got 2"))
      (is (includes? m "documented 3"))))
  (test "a comment after the result is ignored"
    (assert= nil (doctest/check "p" "    (+ 1 1)   ;=> 2  ; two")))
  ;; Both markers are comments, so the scan that finds them must skip string literals —
  ;; in the form and in the result.
  (test "a semicolon inside a string is not a marker"
    (assert= nil (doctest/check "p" "    (str \"a;=> b\")   ;=> \"a;=> b\""))
    (assert= nil (doctest/check "p" "    (str \"a; b\")   ;=> \"a; b\"")))
  ;; A documented list is written `(:a :b)`, which as a FORM would call `:a`. It is READ,
  ;; so it is the list value it depicts.
  (test "the expected side is read as a value, not evaluated as a form"
    (assert= nil (doctest/check "p" "    (list :a :b)   ;=> (:a :b)")))
  ;; A printed map is in the trie's order, which moves when anything else in the image
  ;; changes — including an unrelated kernel primitive. Comparing as a VALUE is what makes
  ;; the example stable; comparing the printed text is what made one fire spuriously.
  (test "a map is compared as a value, so key order cannot break it"
    (assert= nil (doctest/check "p" "    (assoc {:a 1} :b 2)   ;=> {:b 2, :a 1}"))
    (assert= nil (doctest/check "p" "    (assoc {:a 1} :b 2)   ;=> {:a 1, :b 2}")))
  (test "a raising example is matched on its RAISED text, never silently accepted"
    (is (not (nil? (doctest/check "p" "    (/ 1 0)   ;=> 0")))))
  ;; A line the selector CALLS an example must not then be dropped in silence — that is an
  ;; unchecked promise wearing the shape of a checked one. A second marker is the typo that
  ;; would buy it, since it reads as a comment after the result.
  (test "a line that looks like an example but does not parse is reported, not dropped"
    (is (includes? (doctest/check "p" "    (+ 1 1)   ;=> 2 ;=> 3") "malformed example"))
    (is (includes? (doctest/check "p" "    (+ 1 1)   ;=> 2 ;~> 3") "malformed example"))
    (is (includes? (doctest/check "p" "    (+ 1 1)   ;=>") "malformed example")))
  (test "but a line that is not an example at all stays nil"
    (assert= nil (doctest/check "p" "    (+ 1 1)"))
    (assert= nil (doctest/check "p" "not indented   ;=> 2"))
    (assert= nil (doctest/check "p" "    ;; a comment line   ;=> 2"))))

(describe "examples are written with the full namespace"
  ;; An example runs at the top level — not inside the module of the
  ;; name it documents. The module's own bare name is the slip that invites, so the failure
  ;; names the qualified spelling.
  (test "a case calling its module's bare name fails, naming the qualified one"
    (let (fault (doctest/check "string/trim" "    (trim \" a \")   ;=> \"a\""))
      (is (includes? fault "unbound symbol: trim"))
      (is (includes? fault "write `string/trim`"))))
  (test "so does an illustration"
    (is (includes? (doctest/check "string/trim" "    (trim s)   ;~> \"a\"") "write `string/trim`")))
  (test "the qualified spelling holds"
    (assert= nil (doctest/check "string/trim" "    (string/trim \" a \")   ;=> \"a\"")))
  (test "a name bound nowhere gets no hint"
    (is (not (includes? (doctest/check "string/trim" "    (nope 1)   ;=> 1") "write `")))))

(describe "the retired ` → ` marker"
  ;; The sweep that moved every docstring to ` ;=> ` is only complete if a line it missed is
  ;; loud. Skipping it would drop that example from the gate without a word.
  (test "an indented line still written with the arrow is reported"
    (is (includes? (doctest/check "p" "    (+ 1 1)   → 2") "old marker")))
  (test "an arrow in prose, a comment or a string is not"
    (assert= nil (doctest/check "p" "see (+ 1 1) → 2 for why"))
    (assert= nil (doctest/check "p" "    (+ 1 1)   ;=> 2  ; one → two"))
    (assert= nil (doctest/check "p" "    (str \"a → b\")   ;=> \"a → b\""))))

(describe "the selector and the parser agree"
  ;; They disagreed once: the selector tested the raw line while the parser stripped the
  ;; trailing comment first, so a line whose only marker sat inside a comment was selected
  ;; and then silently dropped. One line in std/ hit it.
  (test "a marker that only appears inside a later comment is not an example"
    (assert= []
      (apply vector
        (doctest/example-lines "    (defrecord c (r))   ; (c 2) ;=> {:r 2}"))))
  (test "a marker that opens the comment still is, comment and all"
    (assert= 1 (count (doctest/example-lines "    (+ 1 1)   ;=> 2  ; two")))
    (assert= nil (doctest/check "p" "    (+ 1 1)   ;=> 2  ; two"))))

(describe "failures-under"
  (test "scopes to a prefix, so one package's gate ignores every other"
    ;; Nothing is named `zzz-no-such-package/`, so the scoped run is empty even though the
    ;; image is full of documented names.
    (assert= [] (doctest/failures-under "zzz-no-such-package/"))
    (is (> (count (doctest/documented-names)) 0))
    (assert= [] (apply vector (doctest/documented-names-under "zzz-no-such-package/"))))
  (test "the standard library's own examples hold"
    (assert= [] (doctest/failures-under "string/"))))

(describe "illustrations — ` ;~> ` examples for results that depend on the world"
  (test "an illustration is read and its callee checked, never evaluated"
    ;; `file/slurp` of a file that does not exist would RAISE if evaluated: a nil here is
    ;; the proof it was not.
    (is (nil? (doctest/check "x" "    (file/slurp \"/no/such/file\")   ;~> \"…the text…\""))))
  (test "a callee that does not exist fails"
    (is (includes? (doctest/check "x" "    (file/slurpp \"a\")   ;~> \"…\"") "not defined")))
  (test "a form that does not read fails"
    (is (includes? (doctest/check "x" "    (file/slurp \"a\"   ;~> \"…\"") "does not read")))
  (test "a special form is a fine head"
    (is (nil? (doctest/check "x" "    (let (p \"a\") (file/slurp p))   ;~> \"…\""))))
  ;; Never run, so after a rename or an argument reorder the argument COUNT is the one thing
  ;; that notices an illustration went stale.
  (test "an argument count no arm of the callee takes fails, naming the arities"
    (let (fault (doctest/check "x" "    (file/slurp \"a\" \"b\" \"c\")   ;~> \"…\""))
      (is (includes? fault "passes 3 arguments"))
      (is (includes? fault "(path)"))))
  (test "every arm of a multi-arity callee counts, and so do optional and rest parameters"
    ;; `table/get` has a 2- and a 3-arity arm; `str` takes any number
    (is (nil? (doctest/check "x" "    (table/get t :k :default)   ;~> …")))
    (is (nil? (doctest/check "x" "    (table/get t :k)   ;~> …")))
    (is (includes? (doctest/check "x" "    (table/get t)   ;~> …") "passes 1 argument"))
    (is (nil? (doctest/check "x" "    (str 1 2 3 4 5)   ;~> …"))))
  (test "a `…` argument stands for any number"
    (is (nil? (doctest/check "x" "    (file/slurp …)   ;~> …"))))
  (test "a result continuing the line above is prose, not an illustration"
    (assert= 0 (count (doctest/illustration-lines "x\n    (f 1)\n    ;~> {:a 1}"))))
  (test "the audit counts an illustration as an example"
    (is (audit/exemplified? 'doctest/illustration-lines))))

(describe "fenced-blocks — which markdown blocks run"
  (test "clojure, lisp and brood blocks run, each with the line its code starts on"
    (assert= [{:line 2 :source "(+ 1 1)"} {:line 5 :source "(+ 2 2)"} {:line 8 :source "(+ 3 3)"}]
      (doctest/fenced-blocks "```clojure\n(+ 1 1)\n```\n```lisp\n(+ 2 2)\n```\n```brood\n(+ 3 3)\n```")))
  (test "a fragment, another language and an untagged block never run"
    (assert= []
      (doctest/fenced-blocks "```clojure fragment\n(f …)\n```\n```rust\nfn f() {}\n```\n```\n(+ 1 1)\n```")))
  (test "a block inside a list item loses the item's indent"
    (assert= [{:line 3 :source "(+ 1 1)\n  (+ 2 2)"}]
      (doctest/fenced-blocks "- item\n  ```clojure\n  (+ 1 1)\n    (+ 2 2)\n  ```"))))

(describe "block-faults — one block as a small program"
  (test "unmarked lines are setup, and a marked line sees what they defined"
    (assert= [] (doctest/block-faults "a.md" 1 "(def block-x 2)\n(+ block-x 1)   ;=> 3")))
  (test "a marked line may close a form the lines above opened"
    (assert= [] (doctest/block-faults "a.md" 1 "(let (y 4)\n  (+ y 1))   ;=> 5")))
  (test "a wrong result names the document line and the whole form"
    (let (faults (doctest/block-faults "a.md" 10 "(let (y 4)\n  (+ y 1))   ;=> 6"))
      (assert= 1 (count faults))
      (is (string/starts-with? (first faults) "a.md:11: (let (y 4) (+ y 1))"))
      (is (includes? (first faults) "got 5"))))
  ;; Without this a block whose setup is broken would pass, since its cases would never run.
  (test "setup that raises fails the block, and stops it"
    (let (faults (doctest/block-faults "a.md" 1 "(no-such-fn 1)\n(+ 1 1)   ;=> 3"))
      (assert= 1 (count faults))
      (is (includes? (first faults) "setup raised: unbound symbol: no-such-fn"))))
  (test "so does setup after the last case"
    (is (includes? (first (doctest/block-faults "a.md" 1 "(+ 1 1)   ;=> 2\n(no-such-fn)"))
          "setup raised")))
  (test "a raise documented as `RAISED …` holds"
    (assert= [] (doctest/block-faults "a.md" 1 "(error \"boom\")   ;=> RAISED boom")))
  (test "an illustration is checked, not run"
    (assert= [] (doctest/block-faults "a.md" 1 "(file/slurp \"/no/such/file\")   ;~> \"…\""))
    (is (includes? (first (doctest/block-faults "a.md" 1 "(file/slurpp \"a\")   ;~> \"…\""))
          "not defined")))
  (test "an old marker is reported"
    (is (includes? (first (doctest/block-faults "a.md" 1 "(+ 1 1)   → 2")) "old marker")))
  (test "an arrow inside a string is not one, so the setup around it still runs"
    (assert= []
      (doctest/block-faults "a.md" 1 "(defn arrow-doc ()\n  \"a → b\"\n  1)\n(arrow-doc)   ;=> 1"))))

(describe "markdown-failures — each block in a process of its own"
  (test "a holding document has no failures; a failing block names its line"
    (let (path (str (path/temp "doctest-test-") ".md"))
      (file/spit path "# T\n\n```clojure\n(+ 1 1)   ;=> 2\n```\n\n```lisp\n(+ 1 1)   ;=> 3\n```\n")
      (let (faults (doctest/markdown-failures path))
        (file/rm path)
        (assert= 1 (count faults))
        (is (includes? (first faults) (str path ":8: (+ 1 1)"))))))
  ;; In one process the second block would see the first one's `def`.
  (test "a block's definitions do not reach the next block"
    (let (path (str (path/temp "doctest-test-") ".md"))
      (file/spit path
        "```clojure\n(def leaked-from-block 1)\n```\n```clojure\nleaked-from-block   ;=> 1\n```\n")
      (let (faults (doctest/markdown-failures path))
        (file/rm path)
        (assert= 1 (count faults))
        (is (includes? (first faults) "unbound symbol: leaked-from-block")))))
  (test "a block that ends its process is reported, never dropped"
    (let (path (str (path/temp "doctest-test-") ".md"))
      (file/spit path "```clojure\n(system/halt 3)\n```\n")
      (let (faults (doctest/markdown-failures path))
        (file/rm path)
        (assert= 1 (count faults))
        (is (includes? (first faults) "block did not finish — exit 3"))))))

(describe "block-faults — a multi-line string is text"
  ;; A docstring's later lines inside a block are part of a string, not examples: an arrow
  ;; or a marker there is prose about the function the block defines.
  (test "a marker or an arrow on a string's continuation line is not checked"
    (assert= []
      (doctest/block-faults "a.md"
        1
        "(defn arrow-doc ()\n  \"Doc.\n\n    (arrow-doc)   ;=> 99\n    a → b\"\n  1)\n(arrow-doc)   ;=> 1"))))

;; `nest test --doc FILE` / `nest doctest FILE.blsp`: one source file's examples, each failure
;; placed at the example's own line.
(describe "failures-in-file"
  (test "a wrong example is reported at its line, a holding one is not"
    (let (path (str (path/temp "doctest-file-") ".blsp"))
      (file/spit path
        (str "(defmodule doctest-file-probe)\n"
          "\n" "(defn two ()\n" "  \"Two.\n" "\n" "    (doctest-file-probe/two)   ;=> 2\n"
          "    (doctest-file-probe/two)   ;=> 3\"\n" "  2)\n" "\n" "(defn- quoted ()\n"
          "  \"A quote, escaped in the source.\n" "\n"
          "    (doctest-file-probe/quoted)   ;=> \\\"[q]\\\"\"\n" "  \"q\")\n"))
      (reflect/load path)
      (let (fails (doctest/failures-in-file path "probe.blsp"))
        (file/rm path)
        (assert= 2 (count fails))
        (is (string/starts-with? (first fails) "probe.blsp:7: doctest-file-probe/two:"))
        (is (includes? (first fails) "got 2, documented 3"))
        ;; a private helper's example counts too, found through its escaped source text
        (is (string/starts-with? (second fails) "probe.blsp:13: doctest-file-probe/quoted:")))))
  (test "a file that does not exist has nothing to report"
    (assert= [] (doctest/failures-in-file "/no/such/file.blsp"))))
