;; Tests for the ergonomic prelude additions: string interpolation (`fmt`),
;; binding-conditionals (`if-let`/`when-let`), conditional
;; and short-circuit threading (`cond->`/`some->`), `doto`, and `run!`.
(defmodule ergonomics-test (:use test) (:use math))

(describe "fmt — string interpolation"
  (test "splices expression values between literal text"
    (let (a 3 b 4)
      (assert= "sum=7 a=3" (string/interp "sum={(+ a b)} a={a}"))))
  (test "no holes is the literal string"
    (assert= "plain text" (string/interp "plain text")))
  (test "doubled braces are literal braces"
    (assert= "a {brace} b" (string/interp "a {{brace}} b")))
  (test "braces nest inside a hole (a map literal)"
    (assert= "m={:a 1}" (string/interp "m={ {:a 1} }")))
  (test "adjacent holes"
    (let (x 1 y 2) (assert= "12" (string/interp "{x}{y}"))))
  (test "composes with error"
    (assert-error (throw (string/interp "bad value: {(+ 1 2)}")))))

(describe "if-let / when-let"
  (test "if-let binds and takes the then branch on a truthy value"
    (assert= 11 (if-let (v (get {:x 10} :x)) (inc v) :none)))
  (test "if-let takes the else branch on nil"
    (assert= :none (if-let (v (get {:x 10} :y)) (inc v) :none)))
  (test "if-let with no else yields nil when absent"
    (assert= nil (if-let (v (get {} :y)) v)))
  (test "when-let runs the body only when present"
    (assert= 20 (when-let (v (get {:x 20} :x)) v))
    (assert= nil (when-let (v (get {:x 20} :y)) v)))
  (test "destructuring target tests the source value, not the pattern"
    (assert= 3 (if-let ([a b] [1 2]) (+ a b) :none))
    (assert= :none (if-let ([a b] nil) (+ a b) :none))))

(describe "some-> / some->>"
  (test "some-> threads as first arg and short-circuits on nil"
    (assert= 6 (some-> {:a {:b 5}} (get :a) (get :b) inc))
    (assert= nil (some-> {:a {:b 5}} (get :nope) (get :b) inc)))
  (test "some->> threads as last arg"
    (assert= [2 4] (some->> [1 2 3 4] (map inc) (filter even?) (into [])))))

(describe "cond-> / cond->>"
  (test "cond-> applies a step only when its guard is truthy"
    (assert= {:a 1} (cond-> {} true (assoc :a 1) false (assoc :b 2)))
    (assert= {:a 1 :b 2} (cond-> {} true (assoc :a 1) true (assoc :b 2))))
  (test "leaves the value untouched when all guards are false"
    (assert= 5 (cond-> 5 false inc false dec))))

(describe "with — sequential match-binding with fall-through"
  (test "runs the body with every binding in scope when all steps match"
    (assert= 30
      (with ([:ok a] [:ok 10]
              [:ok b]
              [:ok 20])
        (+ a b))))
  (test "the body may be several forms; the last is the result"
    (assert= 3
      (with ([:ok x] [:ok 1])
        (+ x x)
        (+ x x x))))
  (test "a step that fails its pattern short-circuits and passes the value through"
    (assert= [:error :nope]
      (with ([:ok a] [:ok 10]
              [:ok b]
              [:error :nope]
              [:ok c]
              [:ok 99])
        (+ a b c))))
  (test "bindings from earlier steps are visible to later step expressions"
    (assert= 15
      (with ([:ok a] [:ok 5]
              [:ok b]
              [:ok (* a 2)])
        (+ a b))))
  (test "an :else section runs the short-circuited value through match clauses"
    (assert= {:error "unknown"}
      (with ([:ok a] [:error :no-user])
        [:ok a]
        :else ([:error :no-user] {:error "unknown"})
        ([:error e] {:error e}))))
  (test ":else sees whichever step missed, matched by a later generic clause"
    (assert= {:error :no-card}
      (with ([:ok a] [:ok 1]
              [:ok b]
              [:error :no-card])
        [:ok b]
        :else ([:error :no-user] {:error "unknown"})
        ([:error e] {:error e}))))
  (test "with no bindings the body runs unconditionally"
    (assert= 42 (with () 42)))
  (test "non-tuple patterns work too — destructures and binds like match"
    (assert= 7
      (with ({:n a} {:n 3}
              [_ b]
              [:tag 4])
        (+ a b)))))

(describe "doto"
  (test "runs side-effecting forms and returns the original value"
    (let (t (table/new))
      (assert= t (doto t (table/put :a 1) (table/put :b 2)))
      (assert= 1 (table/get t :a))
      (assert= 2 (table/get t :b)))))

(describe "tap / then"
  (test "then applies f and returns its result"
    (assert= 6 (then 5 inc))
    (assert= 3 (then [1 2 3] count)))
  (test "tap runs f for effect and returns x unchanged"
    (let (t (table/new))
      (assert= 42 (tap 42 (fn (v) (table/put t :seen v))))
      (assert= 42 (table/get t :seen))))
  (test "then threads an arbitrary call into a -> pipeline"
    (assert= 10 (-> 3 (then (fn (n) (* n n))) (then inc)))
    (assert= 900 (-> 100 (then (fn (n) (- 1000 n))))))
  (test "tap keeps the value flowing through a -> pipeline"
    (let (t (table/new))
      (assert= 22 (-> 10 (then inc) (tap (fn (v) (table/put t :mid v))) (then (fn (v) (* v 2)))))
      (assert= 11 (table/get t :mid))))
  (test "across processes: tap/then compose in spawned workers"
    (let (me (self)
          _ (map (fn (k)
                   (spawn (fn () (send me (-> k (then (fn (n) (* n n))) (tap (fn (_) nil)))))))
              (list 1 2 3))
          results (fold (fn (acc _) (cons (receive) acc)) nil (range 3)))
      (assert= [1 4 9] (into [] (sort results))))))

(describe "run!"
  (test "applies a fn for effect and returns nil"
    (let (t (table/new))
      (assert= nil (run! (fn (x) (table/put t x true)) [:a :b :c]))
      (assert= true (table/get t :b)))))

;; ---- the combinator family (2026-07-26 review: `comp` had shipped alone) ----
(describe "partial / complement / constantly"
  (test "partial fixes the leading arguments"
    (assert= 6 ((partial + 1 2) 3))
    (assert= (list 1 2) ((partial list 1) 2))
    (assert= "ab" ((partial str "a") "b")))
  (test "partial with no bound arguments is the function itself"
    (assert= 3 ((partial +) 1 2)))
  (test "partial composes with a higher-order op (the reason it exists)"
    (assert= (list 11 12 13) (map (partial + 10) (list 1 2 3))))
  (test "complement negates a predicate"
    (is ((complement odd?) 2))
    (refute ((complement odd?) 3))
    (assert= (list 2 4) (filter (complement odd?) (list 1 2 3 4))))
  (test "constantly ignores its arguments"
    (assert= :x ((constantly :x)))
    (assert= :x ((constantly :x) 1 2 3))
    (assert= (list :x :x) (map (constantly :x) (list 1 2)))))

(describe "case — literal dispatch"
  (test "dispatches on the value, flat test/result pairs"
    (assert= 2 (case :b :a 1 :b 2 :none))
    (assert= 1 (case :a :a 1 :b 2 :none)))
  (test "a lone trailing form is the default"
    (assert= :none (case :zz :a 1 :b 2 :none)))
  (test "with no default, no match raises like match"
    (assert-error (case :zz :a 1)))
  (test "tests may be any literal kind"
    (assert= :one (case 1 1 :one 2 :two :other))
    (assert= :s (case "hi" "hi" :s :other))
    (assert= :t (case true true :t false :f))
    (assert= :n (case nil nil :n :other))
    (assert= :sym (case 'foo 'foo :sym :other)))
  ;; The reason `case` earns a name next to `match`: it CANNOT silently bind.
  (test "a bare symbol test is rejected (it would bind, not compare)"
    (assert-error (macroexpand '(case :a foo 1))))
  (test "a destructuring test is rejected — that is what match is for"
    (assert-error (macroexpand '(case [1 2] [a b] 1)))
    (assert-error (macroexpand '(case {:a 1} {:keys [a]} 1)))))

(describe "comment"
  (test "ignores its body entirely and returns nil"
    (assert= nil (comment (this body is never evaluated)))
    (assert= nil (comment)))
  (test "does not evaluate — an unbound name inside is harmless"
    (assert= nil (comment (no-such-function-anywhere 1 2 3))))
  (test "a comment between forms doesn't disturb them"
    (let (a 1)
      (comment (a is 1 here))
      (assert= 1 a))))

(describe "vec / nan? / infinite?"
  (test "vec is the named (into [] …)"
    (assert= [1 2 3] (vec (list 1 2 3)))
    (assert= [1 2 3] (vec [1 2 3]))
    (assert= [] (vec nil)))
  ;; `math/nan?` / `math/infinite?` (they were bare, and `(and (float? x) …)`, so a STRING
  ;; answered `false` — a category error reported as a fact). One impl per numeric type,
  ;; no `:default`, so a non-number raises (ADR-254).
  (test "math/nan? identifies the float that isn't equal to itself"
    (is (math/nan? nan))
    (is (math/nan? (- nan)))
    (refute (math/nan? 1.0))
    (refute (math/nan? 0))
    (refute (math/nan? inf)))
  (test "math/infinite? covers both infinities only"
    (is (math/infinite? inf))
    (is (math/infinite? -inf))
    (refute (math/infinite? 1.0))
    (refute (math/infinite? 1))
    (refute (math/infinite? nan)))
  (test "both REFUSE a non-number rather than answering false"
    ;; `(nan? "nan")` used to be `false`. A string is not "not NaN" — the question does
    ;; not apply, and saying `false` makes that indistinguishable from a computed answer.
    (is (includes? (error-message (try (math/nan? "nan") (catch e e))) "no impl"))
    (is (includes? (error-message (try (math/infinite? nil) (catch e e))) "no impl"))))

(describe "transduce — transducers as public surface (ADR-161)"
  (test "a composed stage stack reduces in one pass"
    (assert= 165 (seq/transduce (comp (seq/xfilter odd?) (seq/xmap (fn (n) (* n n)))) + 0 (range 10)))
    (assert= [2 3 4] (seq/transduce (seq/xmap inc) conj [] (list 1 2 3))))
  (test "stages compose LEFT to right in data-flow order"
    ;; filter-then-map keeps the odds (1,3) then increments → [2 4];
    ;; map-then-filter increments first (1,2,3,4) then keeps the odds → [1 3].
    ;; (Vector accumulator: `conj` APPENDS to a vector but PREPENDS to a list, so a
    ;; list here would read reversed and obscure the ordering being tested.)
    (assert= [2 4] (seq/transduce (comp (seq/xfilter odd?) (seq/xmap inc)) conj [] (range 4)))
    (assert= [1 3] (seq/transduce (comp (seq/xmap inc) (seq/xfilter odd?)) conj [] (range 4))))
  (test "xkeep drops nil results; xremove is the complement of xfilter"
    (assert= [1 3 5] (seq/transduce (seq/xkeep (fn (n) (if (odd? n) n nil))) conj [] (range 6)))
    (assert= [0 2 4] (seq/transduce (seq/xremove odd?) conj [] (range 6))))
  (test "a user-written stage is a plain fn — the reason this is public"
    (defn erg-xtake-while (pred)
      (fn (rf) (fn (acc x) (if (pred x) (rf acc x) acc))))
    (assert= [0 1 2] (seq/transduce (erg-xtake-while (fn (n) (< n 3))) conj [] (range 6))))
  (test "the l* combinators share the machinery and agree"
    (assert= (seq/transduce (comp (seq/xfilter odd?) (seq/xmap inc)) + 0 (range 10))
      (reduce + 0 (->> (range 10) (lfilter odd?) (lmap inc))))))

(describe "dissoc-in"
  (test "removes a nested key, leaving the rest"
    (assert= {:a {:c 2}} (dissoc-in {:a {:b 1 :c 2}} [:a :b]))
    (assert= {:b 2} (dissoc-in {:a 1 :b 2} [:a])))
  (test "a path that doesn't exist is a no-op"
    (assert= {:a {:b 1}} (dissoc-in {:a {:b 1}} [:x :y]))
    (assert= {:a {:b 1}} (dissoc-in {:a {:b 1}} [:a :zz])))
  (test "an emptied branch is left in place, not pruned"
    (assert= {:a {}} (dissoc-in {:a {:b 1}} [:a :b])))
  (test "completes the nested family — the inverse of assoc-in"
    (let (m {:x {:y 1}})
      (assert= m (dissoc-in (assoc-in m [:x :z] 2) [:x :z])))))

(describe "for takes multiple body forms"
  ;; It took exactly one until 2026-07-26 — the only iteration form that did
  ;; (`doseq`/`dotimes`/`let`/`when` all take `body…`).
  (test "earlier forms run for effect, the last is collected"
    (let (t (table/new))
      (assert= (list 1 2) (for (x [1 2]) (table/put t x true) x))
      (assert= true (table/get t 1))))
  (test "a single body form still behaves"
    (assert= (list 10 30) (for (x [1 2 3] :when (odd? x)) (* x 10)))))

;; ---- cross-process: the new forms survive send/spawn like any Brood code ----
(describe "ergonomics across processes"
  :isolated (test "a closure using fmt + a letrec loop deep-copies across a send and runs on the receiver"
    (let (me (self))
      (spawn (send me
               [:result
                 (letrec (go (fn (i acc) (if (= i 3) acc (go (inc i) (string/interp "{acc}{i}")))))
                   (go 0 ""))]))
      (assert= "012" (receive ([:result r] r)))))
  (test "with matches a result tuple that a worker built and sent across the heap boundary"
    (let (me (self))
      (spawn (send me [:ok {:score 41}]))
      (assert= 42
        (with ([:ok m] (receive (r r))
                {:score n}
                m)
          (inc n)))))
  (test "with's :else handles a worker-sent failure the same as a local one"
    (let (me (self))
      (spawn (send me [:error :worker-down]))
      (assert= {:error :worker-down}
        (with ([:ok v] (receive (r r)))
          [:ok v]
          :else ([:error e] {:error e})))))
  (test "many workers each send a result; with folds them by fanning in"
    (letrec (spawn-n (fn (n)
                       (when (> n 0)
                         (let (me (self)) (spawn (send me [:ok n])))
                         (spawn-n (dec n))))
             collect (fn (n acc)
                       (if (= n 0)
                         acc
                         (collect (dec n)
                           (with ([:ok v] (receive (r r))) (+ acc v))))))
      (spawn-n 5)
      (assert= 15 (collect 5 0)))))
