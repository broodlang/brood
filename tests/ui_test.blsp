;; The reusable app framework (std/ui.blsp): the `ui-run` loop and the display
;; composition. The frontends themselves (`editor/frontend/*term-display*`/`gui-display`) need a
;; real terminal / window, so here we drive `ui-run` with a *scripted* display —
;; `:poll` reading the test process's own mailbox, `:draw` echoing frames back —
;; which is enough to exercise the loop (render → poll → update → done) and the
;; broadcast composition without any IO.

(defmodule ui-test
  (:use-internals editor/ui)
  (:use-internals editor/frontend)
  (:use test)
  (:use editor/ui)
  (:use editor/frontend)
  (:use editor/display)
  ;; `:exclude [inspect]` — `io/inspect` WRITES, while the root `inspect` is the `Inspect`
  ;; ability op that RETURNS a string. Referring the writer bare here would shadow the op.
  (:use io :exclude [inspect])
  (:use suite-helpers))

;; Collect every [:saw x] message now in the mailbox, in send order — the tests
;; below have `view` announce each model it renders with `(send me [:saw …])`, so
;; the drained sequence is exactly the frames that rendered cleanly.
(defn drain-saw (acc)
  (receive ([:saw x] (drain-saw (cons x acc))) (after 0 (reverse acc))))

;; Like drain-saw, but for the [:folded x] echoes `update` announces — the inputs it
;; actually processed (so a coalescing test can prove EVERY input was folded even when
;; only one frame rendered).
(defn drain-folded (acc)
  (receive ([:folded x] (drain-folded (cons x acc))) (after 0 (reverse acc))))

;; A scripted display: inputs arrive as `[:input …]` messages (selectively polled,
;; so interleaved `[:saw …]` render-echoes are skipped and survive for `drain-saw`).
(defn- r-display (me)
  {:enter (fn () nil)
   :leave (fn () :left)
   :size (fn () [80 24])
   :draw (fn (f) nil)
   :poll (fn (ms) (receive ([:input i] i) (after 0 :tick)))})

(describe "ui-run — the TEA app loop"
  (test "loops until the model is :done, then returns the :leave result"
    (let (me (self))
      ; one input waiting in our mailbox
      (send me "x")
      (assert=
        (ui-run {:done false}
          ; view: empty frame
          (fn (m c r) [])
          ; first input quits
          (fn (m input c r) (assoc m :done true))
          {:enter (fn () nil)
           :leave (fn () :left)
           :size (fn () [80 24])
           :draw (fn (f) nil)
           :poll (fn (ms) (receive (m m) (after 0 :tick)))})
        :left)))

  ;; An app asks "is there a loop to send my answer back to?" before it fires work at
  ;; another process — the answer must hold in `update` (where the firing happens) and
  ;; name THIS loop, so a second window's loop is not mistaken for the first's.
  (test "update runs with editor/ui/*loop* bound to the loop's own pid; outside a loop it is nil"
    (let (me (self))
      (is (nil? editor/ui/*loop*))
      (send me "x")
      (ui-run {:done false}
        (fn (m c r) [])
        (fn (m input c r) (do (send me [:loop editor/ui/*loop*]) (assoc m :done true)))
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [80 24])
         :draw (fn (f) nil)
         :poll (fn (ms) (receive (m m) (after 0 :tick)))})
      (assert= (receive ([:loop p] p) (after 200 :none)) me)
      (is (nil? editor/ui/*loop*))))

  (test "a nil poll (timeout) is delivered to update as :tick"
    (let (me (self))
      ; nil ⇒ :tick
      (ui-run {:done false}
        (fn (m c r) [])
        (fn (m input c r) (do (send me [:saw input]) (assoc m :done true)))
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [80 24])
         :draw (fn (f) nil)
         :poll (fn (ms) nil)})
      (assert= (receive ([:saw x] x) (after 200 :none)) :tick)))

  (test "view gets the model + size, and its frame is what gets drawn"
    (let (me (self))
      (ui-run {:done false :label "hi"}
        (fn (m c r) [(text 0 0 (str (get m :label) " " c "x" r))])
        (fn (m input c r) (assoc m :done true))
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [40 10])
         ; echo the drawn frame
         :draw (fn (f) (send me [:frame f]))
         :poll (fn (ms) nil)})
      (let (f (receive ([:frame fr] fr) (after 200 :none)))
        (is (includes? (nth (first f) 3) "hi 40x10")))))

  (test "tick-ms comes from the model (default 1000)"
    (assert= (editor/ui/ui-tick-ms {}) 1000)
    (assert= (editor/ui/ui-tick-ms {:tick-ms 250}) 250))

  (test "a :close input (the window's X button) quits regardless of update"
    (let (me (self))
      ; the close button, waiting in the mailbox
      (send me :close)
      (assert=
        (ui-run {:done false}
          (fn (m c r) [])
          ;; update NEVER sets :done — only :close can stop this loop,
          ;; proving ui-run quits on :close without update's help.
          (fn (m input c r) (do (send me [:update-saw input]) m))
          {:enter (fn () nil)
           :leave (fn () :left)
           :size (fn () [80 24])
           :draw (fn (f) nil)
           :poll (fn (ms) (receive (m m) (after 0 :tick)))})
        :left)
      ;; update is bypassed entirely for :close (the loop quits before calling it).
      (assert= (receive ([:update-saw x] x) (after 100 :never-called)) :never-called)))

  (test "an app that claims :close (:close-is-input?) sees it in update and quits on its own terms"
    ;; the editor's case: ask about unsaved work first. Two closes queued — the app
    ;; refuses the first (it stays open) and accepts the second by setting :done.
    (let (me (self))
      (send me :close)
      (send me :close)
      (assert= (ui-run {:done false :close-is-input? true :closes 0}
                 (fn (m c r) [])
                 (fn (m input c r)
                   (if (= input :close)
                     (let (n (inc (:closes m)))
                       (do
                         (send me [:update-saw n])
                         (assoc m :closes n :done (= n 2))))
                     m))
                 {:enter (fn () nil)
                  :leave (fn () :left)
                  :size (fn () [80 24])
                  :draw (fn (f) nil)
                  :poll (fn (ms) (receive (m m) (after 0 :tick)))})
        :left)
      ;; update saw BOTH closes: the first did not end the loop
      (assert= (receive ([:update-saw x] x) (after 100 :never)) 1)
      (assert= (receive ([:update-saw x] x) (after 100 :never)) 2)))

  (test "quit-request? recognises :close, not the Escape key or other input"
    (is (quit-request? :close))
    ; the Escape key is NOT a close request
    (is (not (quit-request? :escape)))
    (is (not (quit-request? "q")))
    (is (not (quit-request? :tick)))))

(describe "display-broadcast — one frame to many frontends"
  (test "fans :draw to every member and reports the smallest common size"
    (let (me (self)
          d1 {:enter (fn () nil)
              :leave (fn () nil)
              :size (fn () [80 24])
              :draw (fn (f) (send me [:d1 f]))
              :poll (fn (ms) nil)}
          d2 {:enter (fn () nil)
              :leave (fn () nil)
              :size (fn () [60 30])
              :draw (fn (f) (send me [:d2 f]))
              :poll (fn (ms) nil)}
          b (display-broadcast [d1 d2]))
      ; min cols (60), min rows (24)
      (assert= ((get b :size)) [60 24])
      ((get b :draw) [:FRAME])
      (assert= (receive ([:d1 f] f) (after 200 :none)) [:FRAME])
      (assert= (receive ([:d2 f] f) (after 200 :none)) [:FRAME]))))

(describe "ui-run — let-it-crash at the render loop (resilient loop)"
  (test "a throwing view rolls back to the last good frame and keeps looping"
    (let (me (self))
      ; a -> b   (good)
      (send me [:input :go-b])
      ; b -> bad (a model whose view throws)
      (send me [:input :go-boom])
      ; recover, then -> c
      (send me [:input :go-c])
      (send me [:input :quit])
      (assert=
        (ui-run {:tag :a}
          (fn (m c r)
            ; the wedged model can't render
            (when (get m :boom) (throw "view boom"))
            ; announce a clean render
            (send me [:saw (get m :tag)])
            [])
          (fn (m input c r)
            (cond
              (= input :go-b) {:tag :b}
              (= input :go-boom) {:tag :bad :boom true}
              (= input :go-c) {:tag :c}
              (= input :quit) (assoc m :done true)
              else m))
          (r-display me))
        :left)
      ;; a, b, (bad throws — no render; rolled back to b, which is already on screen, so
      ;; nothing is redrawn — ADR-444), c: the loop recovered to the last good frame.
      (assert= (drain-saw []) (list :a :b :c))))

  (test "a throwing update drops the bad input and keeps the current model"
    (let (me (self))
      ; 0 -> 1
      (send me [:input :inc])
      ; update throws — dropped, model unchanged
      (send me [:input :boom])
      ; continues off n=1 (not 0), so reaches 2
      (send me [:input :inc])
      (send me [:input :quit])
      (ui-run {:n 0}
        (fn (m c r) (send me [:saw (get m :n)]) [])
        (fn (m input c r)
          (cond
            (= input :inc) (assoc m :n (+ (get m :n) 1))
            (= input :boom) (throw "update boom")
            (= input :quit) (assoc m :done true)
            else m))
        (r-display me))
      ;; rendered n: 0, 1 (boom dropped — model held at 1, already drawn, so no frame), 2.
      (assert= (drain-saw []) (list 0 1 2))))

  (test "a throw on the FIRST render is fatal — re-raised, and :leave still runs"
    (let (me (self))
      (assert=
        (try
          (ui-run {}
            ; first render throws, no last-good yet
            (fn (m c r) (throw :startup-boom))
            (fn (m input c r) m)
            {:enter (fn () nil)
             ; teardown must still happen
             :leave (fn () (send me [:left]))
             :size (fn () [80 24])
             :draw (fn (f) nil)
             :poll (fn (ms) :tick)})
          (catch e e))
        :startup-boom)
      ;; the outer try restored the terminal (ran :leave) before re-raising
      (is (= [:left] (receive ([:left] [:left]) (after 100 :no))))))

  (test "a recovered error is logged to stderr (via *err*)"
    (let (me (self))
      (send me [:input :boom])
      (send me [:input :quit])
      (let (logged (with-err (fn-port (fn (s) (send me [:err s])))
                     (ui-run {:n 0}
                       (fn (m c r) [])
                       (fn (m input c r)
                         (cond
                           (= input :boom) (throw "kaboom!")
                           (= input :quit) (assoc m :done true)
                           else m))
                       (r-display me))
                     (receive ([:err s] s) (after 0 ""))))
        (is (includes? logged "update error"))
        (is (includes? logged "kaboom!"))))))

;; overlay-route — the modal-overlay dispatch fallthrough shared by the editor's
;; transient overlays and the observer's minibuffer. An overlay is a record implementing
;; `Overlay` (ADR-183); a record that skips `overlay-owns?` is capture-all and one that
;; skips `overlay-exit` needs no dismiss step.
(describe "overlay-route"
  (defrecord ov-mini ()) ; capture-all: only active?/handle implemented
  (impl Overlay
    ov-mini
    (overlay-active? (_ m) (get m :mini))
    (overlay-handle (_ m k) (assoc m :typed k)))
  (defrecord ov-pop ()) ; discriminating: all four ops
  (impl Overlay
    ov-pop
    (overlay-active? (_ m) (get m :pop))
    (overlay-owns? (_ m k) (= k "x"))
    (overlay-handle (_ m k) (assoc m :popped k))
    (overlay-exit (_ m) (assoc m :pop nil :exited true)))
  (def rec-overlays (list (ov-mini) (ov-pop)))
  (defn rec-fallback (m k) (assoc m :dispatched k))
  (test "no overlay open → fallback"
    (assert= (get (overlay-route rec-overlays {} "a" rec-fallback) :dispatched) "a"))
  (test "an owning overlay handles its key"
    (assert= (get (overlay-route rec-overlays {:pop true} "x" rec-fallback) :popped) "x"))
  (test "a record without overlay-owns? captures every key (the :default policy)"
    (let (r (overlay-route rec-overlays {:mini true} "a" rec-fallback))
      (assert= (get r :typed) "a")
      (is (nil? (get r :dispatched)))))
  (test "a non-owned key exits the overlay then falls through (dismiss-and-process)"
    (let (r (overlay-route rec-overlays {:pop true} "a" rec-fallback))
      (is (get r :exited))
      (is (nil? (get r :pop)))
      (assert= (get r :dispatched) "a")))
  (test "list order is precedence (first active wins)"
    (assert= (get (overlay-route rec-overlays {:mini true :pop true} "x" rec-fallback) :typed)
      "x"))
  (test "overlay-active returns the first active overlay, or nil"
    (is (nil? (overlay-active rec-overlays {})))
    (assert= (overlay-active rec-overlays {:pop true}) (ov-pop))))

;; ui-coalesce-motion — collapse a flood of per-cell mouse :drag / :move events to the
;; latest of its kind, so a fast drag renders once at the final position instead of once
;; per cell crossed, and a hover costs one turn, not one per cell.
(describe "ui-coalesce-motion"
  (test "non-motion messages pass through untouched (incl. nil on timeout)"
    (assert= (editor/frontend/ui-coalesce-motion "x") "x")
    (assert= (editor/frontend/ui-coalesce-motion :tick) :tick)
    (assert= (editor/frontend/ui-coalesce-motion [:mouse :press :left 3 3 []])
      [:mouse :press :left 3 3 []])
    (is (nil? (editor/frontend/ui-coalesce-motion nil))))
  (test "queued drags collapse to the latest; other messages stay in the mailbox"
    (let (me (self))
      (send me [:mouse :drag :left 6 6 []])
      (send me [:mouse :drag :left 7 7 []])
      ; a key after the drags — must survive
      (send me "k")
      ;; pass in the first drag (as the poll would); the queued drags drain to the last
      (assert= (editor/frontend/ui-coalesce-motion [:mouse :drag :left 5 5 []])
        [:mouse :drag :left 7 7 []])
      (assert= (receive (m m) (after 200 :none)) "k")))
  (test "queued moves collapse to the latest too"
    (let (me (self))
      (send me [:mouse :move nil 6 6 []])
      (send me [:mouse :move nil 7 7 []])
      (send me :tick)
      (assert= (editor/frontend/ui-coalesce-motion [:mouse :move nil 5 5 []])
        [:mouse :move nil 7 7 []])
      (assert= (receive (m m) (after 200 :none)) :tick)))
  ;; a window adds the pointer's fractional position after a nil 7th slot
  (test "a window's motion, with its {:at …} position, collapses too"
    (let (me (self))
      (send me [:mouse :drag :left 6 6 [] nil {:at [6.5 6.5]}])
      (send me [:mouse :drag :left 7 7 [] nil {:at [7.5 7.5]}])
      (send me "k")
      (assert= (editor/frontend/ui-coalesce-motion [:mouse :drag :left 5 5 [] nil {:at [5.5 5.5]}])
        [:mouse :drag :left 7 7 [] nil {:at [7.5 7.5]}])
      (assert= (receive (m m) (after 200 :none)) "k")))
  (test "a move never swallows a drag, nor a drag a move — a press between them matters"
    (let (me (self))
      (send me [:mouse :drag :left 6 6 []])
      (send me [:mouse :move nil 7 7 []])
      (assert= (editor/frontend/ui-coalesce-motion [:mouse :move nil 5 5 []])
        [:mouse :move nil 7 7 []])
      ;; the drag is still queued, in place
      (assert= (receive (m m) (after 200 :none)) [:mouse :drag :left 6 6 []]))))

;; ui-drain-input — fold every input ALREADY queued into one turn (one render), so an
;; app that streams async events into its own mailbox (a test/run feed, collab deltas)
;; doesn't pay one full frame per event. Opt-in per app via `:coalesce-input?`.
(describe "ui-drain-input"
  ; a display whose :poll(0) returns the next queued message (any shape), nil when empty —
  ; like a real frontend at timeout, so the drain terminates on the empty queue.
  (defn- di-display (me)
    {:poll (fn (ms) (receive (m m) (after 0 nil)))})
  (defn- di-count (m i c r) (update m :acc (fn (a) (conj a i))))
  ;; a drain with a budget no test outlasts, starting a turn whose first fold was background
  (defn- di-drain (model me fuel)
    (editor/ui/ui-drain-input model
      di-count
      (di-display me)
      80
      24
      fuel
      (+ (os/now-ns) 60000000000)
      :budget))
  (test "folds the whole queued backlog, then stops at the empty poll (no pending)"
    (let (me (self)
          _ (do (send me [:input :a]) (send me [:input :b]) (send me [:input :c]))
          result (di-drain {:acc []} me 1024))
      (assert= (:acc (first result)) [[:input :a] [:input :b] [:input :c]]) ; all three folded
      (is (nil? (second result))))) ; queue drained clean
  (test "an empty queue folds nothing — the model passes through unchanged"
    (let (me (self))
      (assert= (di-drain {:acc [:x]} me 1024) [{:acc [:x]} nil :budget])))
  (test "a :close pulled mid-drain comes back as pending (the loop acts on it, not update)"
    (let (me (self)
          _ (do (send me [:input :a]) (send me :close) (send me [:input :b]))
          result (di-drain {:acc []} me 1024))
      (assert= (:acc (first result)) [[:input :a]]) ; folded :a, then stopped at :close
      (assert= (second result) :close))) ; handed back (":b" stays queued)
  (test "fuel bounds a single batch — the rest drains on the next turn"
    (let (me (self)
          _ (do (send me [:input :a]) (send me [:input :b]) (send me [:input :c]))
          result (di-drain {:acc []} me 2))
      (assert= (:acc (first result)) [[:input :a] [:input :b]]) ; only 2 folded (fuel = 2)
      (is (nil? (second result))))))

;; The loop-level behaviour: with :coalesce-input? a queued burst renders ONCE; without it,
;; the legacy once-per-input frames are untouched (the opt-in is inert by default).
(defn- ci-display (me)
  {:enter (fn () nil)
   :leave (fn () :left)
   :size (fn () [80 24])
   :draw (fn (f) nil)
   ; selective on [:input] so the view's [:saw] / update's [:folded] echoes survive to drain
   :poll (fn (ms) (receive ([:input i] i) (after 0 nil)))})

(describe "ui-run — input coalescing (:coalesce-input?)"
  (test "a queued burst folds into ONE render, but every input is still processed"
    (let (me (self))
      (send me [:input :inc])
      (send me [:input :inc])
      (send me [:input :inc])
      (send me [:input :quit])
      (ui-run {:n 0 :coalesce-input? true :fold-budget-ms 60000}
        (fn (m c r) (do (send me [:saw (get m :n)]) []))
        (fn (m input c r)
          (do
            (send me [:folded input])
            (cond
              (= input :inc) (assoc m :n (+ (get m :n) 1))
              (= input :quit) (assoc m :done true)
              else m)))
        (ci-display me))
      (assert= (drain-saw []) (list 0)) ; one frame — the burst coalesced
      (assert= (drain-folded []) (list :inc :inc :inc :quit)))) ; yet all four inputs folded
  (test "without the flag the same burst renders once per input (opt-in only)"
    (let (me (self))
      (send me [:input :inc])
      (send me [:input :inc])
      (send me [:input :quit])
      (ui-run {:n 0}
        (fn (m c r) (do (send me [:saw (get m :n)]) []))
        (fn (m input c r)
          (cond
            (= input :inc) (assoc m :n (+ (get m :n) 1))
            (= input :quit) (assoc m :done true)
            else m))
        (ci-display me))
      (assert= (drain-saw []) (list 0 1 2))))) ; per-input frames: 0, 1, 2

;; ---- input before background (ADR-490) ---------------------------------------
;; The loop runs in a child process whose mailbox is filled before it starts, so the
;; backlog is real: the display's `:poll` is that mailbox in arrival order and its
;; `:poll-input` the priority lane, exactly as `gui-display` has them. `update` records
;; what it folded, in order, and on `:quit` reports that to the test; `view` reports
;; each render.
(defn- lane-display ()
  {:enter (fn () nil)
   :leave (fn () nil)
   :size (fn () [80 24])
   :draw (fn (frame) nil)
   :poll-input (fn ()
                 (let (taken (proc/take-priority))
                   (if (nil? taken) nil (first taken))))
   :poll-tagged (fn (ms)
                  (let (received (proc/receive-lane 0))
                    (if (nil? received) nil [(first received) (= (second received) :priority)])))
   :poll (fn (ms) (receive (message message) (after 0 nil)))})

(defn- lane-tag (input)
  (if (vector? input) (first input) input))

(defn- lane-record (model input)
  (update model :seen (fn (seen) (conj seen input))))

(defn- lane-update (parent)
  (fn (model input cols rows)
    (cond
      (= input :tick) model
      (= input :quit)
        (do (send parent [:seen (:seen (lane-record model input))]) (assoc model :done true))
      else (lane-record model input))))

(defn- lane-start (parent model step)
  "The loop's process, parked until `:go` so the test can queue its backlog first."
  (spawn (receive
           (:go (ui-run (assoc model :seen [])
                  (fn (model cols rows) (do (send parent [:rendered]) []))
                  step
                  (lane-display))))))

(defn- lane-await-seen ()
  (receive ([:seen seen] seen) (after 20000 :timed-out)))

(defn- lane-count-renders (n)
  (receive ([:rendered] (lane-count-renders (inc n))) (after 0 n)))

(defn- lane-position (seen input)
  (index-of seen input))

(describe "display-poll-tagged — a wrapper that replaces :poll"
  (test "a display's own :poll-tagged answers while its :poll is the one it was made with"
    (let (display (display-polls (fn (ms) ["queued" false])))
      (assert= (display-poll-tagged display 0) ["queued" false])
      (assert= ((get display :poll) 0) "queued")))
  (test "a :poll replaced over a std display is what the loop asks, not the bypassed :poll-tagged"
    ;; the pre-ADR-490 wrapping idiom: `(assoc display :poll …)` to see a message first
    (let (display (assoc (merge {:poll-input (fn () nil)}
                           (display-polls (fn (ms) ["queued" false])))
                    :poll (fn (ms) "the wrapper's")))
      (assert= (display-poll-tagged display 0) ["the wrapper's" false])))
  (test "with-events over a std display still sees its events first"
    (let (display (with-events (display-polls (fn (ms) nil))))
      (send (self) [:sse "pushed"])
      (assert= (display-poll-tagged display 0) [[:sse "pushed"] false]))))

(describe "ui-run — input before background (ADR-490)"
  (test "a key sent AFTER 5000 background messages is folded before them (coalescing)"
    (let (me (self)
          loop (lane-start me {:coalesce-input? true} (lane-update me)))
      (doseq (i (range 5000)) (send loop [:background i]))
      (proc/send-priority loop "k")
      (send loop :quit)
      (send loop :go)
      (let (seen (lane-await-seen))
        (assert= (count seen) 5002)
        (is (< (lane-position seen "k") 10))
        ; and the background is all there, in its own order
        (assert= (seq/filter seen vector?) (map (range 5000) (fn (i) [:background i]))))))
  (test "the same key jumps the backlog in a non-coalescing app too"
    (let (me (self)
          loop (lane-start me {} (lane-update me)))
      (doseq (i (range 500)) (send loop [:background i]))
      (proc/send-priority loop "k")
      (send loop :quit)
      (send loop :go)
      (let (seen (lane-await-seen))
        (assert= (lane-position seen "k") 0)
        (assert= (count seen) 502))))
  (test "inputs keep their own order among themselves"
    (let (me (self)
          loop (lane-start me {:coalesce-input? true} (lane-update me)))
      (send loop [:background 0])
      (proc/send-priority loop "a")
      (send loop [:background 1])
      (proc/send-priority loop [:mouse :press :left 3 4 []])
      (send loop [:background 2])
      (proc/send-priority loop "b")
      (proc/send-priority loop :up)
      (send loop :quit)
      (send loop :go)
      (assert= (vec (seq/filter (lane-await-seen)
                      (fn (input) (not (= (lane-tag input) :background)))))
        ["a" [:mouse :press :left 3 4 []] "b" :up :quit])))
  ;; every key folded queues the next one, so input is ALWAYS waiting: background
  ;; progresses only through each turn's one arrival-order fold — the drain's, or for a
  ;; non-coalescing app the turn after one whose input jumped the queue — and must finish
  (for (coalesce? [true false])
    (test (str "background still moves while input never stops (coalesce " coalesce? ")")
      (let (me (self)
            step (fn (model input cols rows)
                   (cond
                     (= input :tick) model
                     (= input "k") (do (proc/send-priority (self) "k") (update model :keys inc))
                     (= (count (:background model)) 19)
                       (do
                         (send me [:seen [(:keys model) (conj (:background model) input)]])
                         (assoc model :done true))
                     else (update model :background (fn (seen) (conj seen input)))))
            loop (lane-start me
                   {:coalesce-input? coalesce? :fold-budget-ms 1 :keys 0 :background []}
                   step))
        (doseq (i (range 20)) (send loop [:background i]))
        (proc/send-priority loop "k")
        (send loop :go)
        (let (report (lane-await-seen))
          (exit loop :kill)
          (is (not (= report :timed-out)))
          (assert= (second report) (vec (map (range 20) (fn (i) [:background i]))))
          (is (>= (first report) 20))))))
  ;; Only the USER's input holds an idle timer back. Each background message folded
  ;; queues the next, so the flood never stops on its own: the idle timer has to fire
  ;; in the middle of it, or the run reports that it starved.
  (for (coalesce? [true false])
    (test (str "an idle timer fires during a background flood (coalesce " coalesce? ")")
      (let (me (self)
            started (os/now)
            step (fn (model input cols rows)
                   (cond
                     (= (lane-tag input) :timer)
                       (do (send me [:seen [:fired (:background model)]]) (assoc model :done true))
                     (> (- (os/now) started) 3000)
                       (do
                         (send me [:seen [:starved (:background model)]])
                         (assoc model :done true))
                     (= (lane-tag input) :background)
                       (do (send (self) [:background 0]) (update model :background inc))
                     else model))
            loop (lane-start me
                   {:coalesce-input? coalesce?
                    :background 0
                    :timers {:idle {:after 20 :idle? true}}}
                   step))
        (send loop [:background 0])
        (send loop :go)
        (let (report (lane-await-seen))
          (exit loop :kill)
          (assert= (first report) :fired)
          (is (> (second report) 0))))))
  (test "a flood renders between budget slices, not once at the end"
    (let (me (self)
          sliced (lane-start me {:coalesce-input? true :fold-budget-ms 0} (lane-update me)))
      (doseq (i (range 50)) (send sliced [:background i]))
      (send sliced :quit)
      (send sliced :go)
      (lane-await-seen)
      ; every background fold spends the whole (zero) budget: a render after each
      (is (>= (lane-count-renders 0) 50)))
    (let (me (self)
          whole (lane-start me {:coalesce-input? true :fold-budget-ms 60000} (lane-update me)))
      (doseq (i (range 50)) (send whole [:background i]))
      (send whole :quit)
      (send whole :go)
      (lane-await-seen)
      ; the same flood inside one budget: the first frame, then one at the end
      (is (<= (lane-count-renders 0) 2)))))

(describe "proc/send-latest — newest-wins (ADR-490)"
  ;; The race a delivery cannot see: the receiver has the older message OUT of its queue
  ;; for a pattern check when the newer one lands. A guard that sends the newer copy is
  ;; that window made deterministic — the older one must not be handed over.
  (test "a message superseded while it is out for a pattern check is never delivered"
    (proc/send-latest (self) :race [:p 1])
    (assert= (receive
               ([:p n] :when
                 (do (when (= n 1) (proc/send-latest (self) :race [:p 2])) (number? n))
                 n))
      2)
    (assert= (receive (message message) (after 0 :empty)) :empty))
  (test "the same, for a candidate matched in place behind an unmatched message"
    (send (self) :other)
    (proc/send-latest (self) :race [:p 1])
    (assert= (receive
               ([:p n] :when
                 (do (when (= n 1) (proc/send-latest (self) :race [:p 2])) (number? n))
                 n))
      2)
    (assert= (receive (message message) (after 0 :empty)) :other)
    (assert= (receive (message message) (after 0 :empty)) :empty))
  ;; an app addresses its loop by name (bedit's `:editor`): the name is a local process,
  ;; so the lane survives it — bare, and as a `{:name :node}` address naming this node
  (test "a locally registered name keeps both lanes"
    (let (me (self)
          loop (lane-start me {:coalesce-input? true} (lane-update me))
          address {:name :ui-test-lanes :node (node/name)})
      (proc/register :ui-test-lanes loop)
      (doseq (i (range 10)) (proc/send-latest :ui-test-lanes :progress [:progress i]))
      (proc/send-latest address :progress [:progress 10])
      (send loop [:background 0])
      (proc/send-priority :ui-test-lanes "k")
      (proc/send-priority address "j")
      (send loop :quit)
      (send loop :go)
      ; one [:progress] survives; "j" waits behind the turn's one arrival-order fold
      (assert= (lane-await-seen) ["k" [:progress 10] "j" [:background 0] :quit])))
  (test "a queued message is replaced by a newer one with its key; unkeyed ones all arrive"
    (let (me (self)
          loop (lane-start me {:coalesce-input? true} (lane-update me)))
      (doseq (i (range 100))
        (proc/send-latest loop [:diagnostics "a.rs"] [:diagnostics "a.rs" i])
        (send loop [:background i]))
      (proc/send-latest loop [:diagnostics "b.rs"] [:diagnostics "b.rs" 0])
      (proc/send-latest loop :progress [:progress 7])
      (send loop :quit)
      (send loop :go)
      (let (seen (lane-await-seen))
        (assert= (vec (seq/filter seen (fn (input) (= (lane-tag input) :diagnostics))))
          [[:diagnostics "a.rs" 99] [:diagnostics "b.rs" 0]])
        (assert= (vec (seq/filter seen (fn (input) (= (lane-tag input) :progress))))
          [[:progress 7]])
        (assert= (count (seq/filter seen (fn (input) (= (lane-tag input) :background)))) 100)))))

(describe "ui-run — the watchdog (ADR-490)"
  (test "a slow update is reported once, naming the input's tag"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (assoc model :done true)
                   (= (lane-tag input) :sleepy) (do (proc/sleep 30) model)
                   else model))
          loop (lane-start me
                 {:slow-ms 10 :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (send loop [:quick 1])
      (send loop [:sleepy "a large payload the report must not print"])
      (send loop :quit)
      (send loop :go)
      (let (report (receive ([:slow report] report) (after 5000 :none)))
        (assert= (:phase report) "update")
        (assert= (:tag report) :sleepy)
        (is (>= (:ms report) 10))
        ;; asleep, not collecting: the report says how little of it was GC
        (is (<= 0 (:gc-ms report) (:ms report))))
      (assert= (receive ([:slow report] report) (after 100 :none)) :none)))
  (test "a slow update says how much of it was garbage collection"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (assoc model :done true)
                   ;; allocates enough to collect several times, and keeps none of it
                   (= (lane-tag input) :garbage)
                     (do (count (fold (range 400000) () (fn (acc n) (cons [n (str n)] acc)))) model)
                   else model))
          loop (lane-start me
                 {:slow-ms 0 :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (send loop [:garbage 1])
      (send loop :quit)
      (send loop :go)
      (let (report (letrec (next (fn ()
                                   ;; the view may be reported too, at a 0 ms line
                                   (let (report (receive
                                                  ([:slow report] report)
                                                  (after 10000 :none)))
                                     (if (and (map? report) (not (= (:tag report) :garbage)))
                                       (next)
                                       report))))
                     (next)))
        (assert= (:tag report) :garbage)
        (is (> (:gc-ms report) 0))
        (is (<= (:gc-ms report) (:ms report))))))
  (test "proc/gc-us counts the calling process's collections"
    (let (before (proc/gc-us))
      (count (fold (range 400000) () (fn (acc n) (cons [n (str n)] acc))))
      (is (> (proc/gc-us) before))))
  (test "a run of slow updates is reported once per quiet period, an interrupted one always"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (assoc model :done true)
                   (= (lane-tag input) :sleepy) (do (proc/sleep 30) model)
                   (= (lane-tag input) :stuck) (quit-spin 0)
                   else model))
          loop (lane-start me
                 {:slow-ms 10
                  :event-ceiling-ms 50
                  :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (send loop [:sleepy 1])
      (send loop [:sleepy 2])
      (send loop [:sleepy 3])
      (send loop [:stuck 4])
      (send loop :quit)
      (send loop :go)
      (assert= (:tag (receive ([:slow report] report) (after 5000 :none))) :sleepy)
      ; three slow folds, one report — and the interrupted one is still reported
      (let (next (receive ([:slow report] report) (after 5000 :none)))
        (assert= (:tag next) :stuck)
        (is (:interrupted next)))
      (assert= (receive ([:slow report] report) (after 100 :none)) :none)))
  (test "a slow view is reported, at most once per quiet period"
    (let (me (self)
          loop (spawn (receive
                        (:go (ui-run {:n 0
                                      :slow-ms 10
                                      :on-slow (fn (report) (send me [:slow report]))}
                               (fn (model cols rows) (do (proc/sleep 20) []))
                               (fn (model input cols rows)
                                 (if (= input :quit) (assoc model :done true) (update model :n inc)))
                               (lane-display))))))
      (send loop [:a])
      (send loop [:b])
      (send loop :quit)
      (send loop :go)
      (let (report (receive ([:slow report] report) (after 5000 :none)))
        (assert= (:phase report) "view")
        (assert= (:tag report) :view))
      ; three slow frames, one report
      (assert= (receive ([:slow report] report) (after 300 :none)) :none))))

;; ADR-444: a turn whose model comes back `=` to the one on screen renders nothing.
(describe "ui-run — a turn that changes nothing draws nothing"
  (test "inputs that leave the model unchanged cost no view and no draw"
    (let (me (self))
      (send me [:input :inc])
      (send me [:input :noop])
      (send me [:input :noop])
      (send me [:input :inc])
      (send me [:input :quit])
      (ui-run {:n 0}
        (fn (m c r) (do (send me [:saw (get m :n)]) []))
        (fn (m input c r)
          (cond
            (= input :inc) (assoc m :n (+ (get m :n) 1))
            (= input :quit) (assoc m :done true)
            else m))
        (ci-display me))
      (assert= (drain-saw []) (list 0 1 2))))
  (test "an equal model rebuilt by update is still a no-op turn"
    (let (me (self))
      (send me [:input :rebuild])
      (send me [:input :quit])
      (ui-run {:n 0}
        (fn (m c r) (do (send me [:saw (get m :n)]) []))
        (fn (m input c r)
          (cond
            (= input :rebuild) {:n (get m :n)}
            (= input :quit) (assoc m :done true)
            else m))
        (ci-display me))
      (assert= (drain-saw []) (list 0))))
  (test "a skipped turn tells a display with :settle that it is over, and draws nothing"
    (let (me (self))
      (send me [:input :inc])
      (send me [:input :noop])
      (send me [:input :noop])
      (send me [:input :inc])
      (send me [:input :quit])
      (ui-run {:n 0}
        (fn (m c r) [])
        (fn (m input c r)
          (cond
            (= input :inc) (assoc m :n (+ (get m :n) 1))
            (= input :quit) (assoc m :done true)
            else m))
        (assoc (ci-display me)
          :draw (fn (f) (send me [:saw :draw]))
          :settle (fn () (send me [:saw :settle]))))
      (assert= (drain-saw []) (list :draw :draw :settle :settle :draw)))))
;; ---- named timers (ADR-102) ------------------------------------------------
;; The firing logic is pure (deadline math over a clock map + the timer specs), so it
;; tests deterministically with hand-supplied `now`/`clock` — no wall-clock, no loop.
;; The one integration test drives `ui-run` with a `:now-fn` (the injected clock) and a
;; nil-returning poll, so a due timer fires without any real sleeping.

(describe "ui-deadline — when a timer next wants to fire"
  ; fired → fire+ms
  (test "repeating: counts from the last fire, or from arm before the first fire"
    ; never fired → arm+ms
    (assert= (editor/ui/ui-deadline {:every 100} 1000 nil 500) 1100)
    (assert= (editor/ui/ui-deadline {:every 100} 1000 1300 500) 1400))
  ; fire doesn't move it
  (test "one-shot: always counts from arm (fixed), ignoring the last fire"
    (assert= (editor/ui/ui-deadline {:after 100} 1000 nil 500) 1100)
    (assert= (editor/ui/ui-deadline {:after 100} 1000 1300 500) 1100))
  (test "idle: counts from the later of the base and last-input (input pushes it out)"
    (assert= (editor/ui/ui-deadline {:after 100 :idle? true} 1000 nil 1500) 1600)
    (assert= (editor/ui/ui-deadline {:every 100 :idle? true} 1000 1200 1500) 1600)))

; repeating: deadline moved past fire
(describe "ui-timer-live? — can the timer still fire"
  (test "never-fired is live; a fired one-shot (deadline at-or-before fire) is done"
    ; never fired
    (is (editor/ui/ui-timer-live? nil 1100))
    ; one-shot: deadline == fire → done
    (is (not (editor/ui/ui-timer-live? 1100 1100)))
    (is (editor/ui/ui-timer-live? 1000 1100))))
(describe "ui-clock-init — per-iteration clock bookkeeping"
  (test "first pass seeds last-input=now and arms each timer at now"
    (let (c (editor/ui/ui-clock-init {} {:a {:every 100}} 5000))
      (assert= (get c :last-input) 5000)
      (assert= (get c :armed) {:a 5000})
      (assert= (get c :fired) {})))
  (test "preserves existing arm/fire/last-input and GCs removed timers"
    (let (c (editor/ui/ui-clock-init {:last-input 100 :armed {:a 50 :b 60} :fired {:a 70}}
              ; :b is gone
              {:a {:every 100}}
              5000))
      (assert= (get c :last-input) 100)
      ; :a kept at its original arm, :b dropped
      (assert= (get c :armed) {:a 50})
      (assert= (get c :fired) {:a 70})))
  (test "a newly-appeared timer is armed at now; established ones keep their arm"
    (let (c (editor/ui/ui-clock-init {:last-input 100 :armed {:a 50} :fired {}}
              {:a {:every 100} :c {:after 10}}
              5000))
      (assert= (get c :armed) {:a 50 :c 5000}))))

(describe "ui-poll-ms — how long to park"
  ; overdue → 1
  (test "the soonest live deadline minus now, at least 1ms"
    (assert= (editor/ui/ui-poll-ms {:a {:every 100}}
               {:last-input 1000 :armed {:a 1000} :fired {}}
               1000)
      100)
    (assert= (editor/ui/ui-poll-ms {:a {:every 100}}
               {:last-input 1000 :armed {:a 1000} :fired {}}
               1200)
      1))
  (test "the earliest of several timers wins"
    (assert= (editor/ui/ui-poll-ms {:a {:every 100} :b {:every 50}}
               {:last-input 1000 :armed {:a 1000 :b 1000} :fired {}}
               1000)
      50))
  (test "no live timer (a fired one-shot, or no timers) → the idle cap (60000)"
    (assert= (editor/ui/ui-poll-ms {:a {:after 100}}
               {:last-input 1000 :armed {:a 1000} :fired {:a 1100}}
               1200)
      60000)
    (assert= (editor/ui/ui-poll-ms {} {:last-input 1000 :armed {} :fired {}} 1200)
      60000)))

; b's deadline (1050) is earlier than a's (1100)
(describe "ui-fire — service the due timer"
  (test "a due timer fires [:timer name] and records the firing"
    (let (fr (editor/ui/ui-fire {:a {:every 100}}
               {:last-input 1000 :armed {:a 1000} :fired {}}
               1200))
      (assert= (first fr) [:timer :a])
      (assert= (get (get (second fr) :fired) :a) 1200)))
  (test "nothing due → [nil clock-unchanged]"
    (let (clock {:last-input 1000 :armed {:a 1000} :fired {}}
          fr (editor/ui/ui-fire {:a {:every 100}} clock 1050))
      (is (nil? (first fr)))
      (assert= (second fr) clock)))
  ; deadline (arm+ms=1100) not past the recorded fire (1100)
  (test "a one-shot fires once — after firing it's done until re-armed"
    (let (fr (editor/ui/ui-fire {:a {:after 100}}
               {:last-input 1000 :armed {:a 1000} :fired {:a 1100}}
               1300))
      (is (nil? (first fr)))))
  ; deadline = max(1000,1300)+100 = 1400 > fire 1200
  (test "an idle one-shot re-arms once new input pushes its deadline past the last fire"
    (let (fr (editor/ui/ui-fire {:a {:after 100 :idle? true}}
               {:last-input 1300 :armed {:a 1000} :fired {:a 1200}}
               1500))
      (assert= (first fr) [:timer :a])))
  (test "the earliest due timer fires when several are overdue"
    (let (fr (editor/ui/ui-fire {:a {:every 100} :b {:every 50}}
               {:last-input 1000 :armed {:a 1000 :b 1000} :fired {}}
               2000))
      (assert= (first fr) [:timer :b]))))

;; A key held down is not idle: before its first repeat no input arrives, yet an idle beat,
;; a debounce or a caret blink must not run in that gap. Idle timers wait for the key to come
;; up, at most `*ui-held-quiet-ms*` (2000) past the last input; other timers are untouched.
(describe "idle timers while a key is held"
  (test "an idle deadline is at least the held quiet past the last input; others keep theirs"
    (assert= (editor/ui/ui-deadline {:after 100 :idle? true} 1000 nil 1500 true) 3500)
    (assert= (editor/ui/ui-deadline {:after 100 :idle? true} 1000 nil 1500 false) 1600)
    (assert= (editor/ui/ui-deadline {:every 100} 1000 nil 1500 true) 1100))
  (test "the loop parks past the hold instead of firing the beat"
    (let (clock {:last-input 1000 :armed {:beat 1000} :fired {} :key-held? true})
      (assert= (editor/ui/ui-poll-ms {:beat {:after 120 :idle? true}} clock 1000) 2000)
      (is (nil? (first (editor/ui/ui-fire {:beat {:after 120 :idle? true}} clock 1500))))
      (assert= (first (editor/ui/ui-fire {:beat {:after 120 :idle? true}} clock 3000))
        [:timer :beat])))
  (test "a broadcast display has a key down when any of its displays does"
    (is ((get (editor/frontend/display-broadcast [{:key-held? (fn () false)}
                                                   {:key-held? (fn () true)}])
           :key-held?)))
    (refute ((get (editor/frontend/display-broadcast [{:key-held? (fn () false)} {}]) :key-held?)))))
(describe "ui-run — timers drive the loop"
  (test "a due timer is folded into update as [:timer name] (clock injected via :now-fn)"
    (let (me (self))
      ;; an :after-0 timer is due immediately at the injected clock (constant 1000);
      ;; update quits on the first firing so the loop can't spin.
      ; nil ⇒ timeout ⇒ ui-fire
      (ui-run {:done false :timers {:beat {:after 0}} :now-fn (fn () 1000)}
        (fn (m c r) [])
        (fn (m input c r) (do (send me [:saw input]) (assoc m :done true)))
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [80 24])
         :draw (fn (f) nil)
         :poll (fn (ms) nil)})
      (assert= (receive ([:saw x] x) (after 200 :none)) [:timer :beat])))

  (test "a real input still folds normally when timers are present"
    (let (me (self))
      (send me [:input "z"])
      (ui-run {:done false :timers {:beat {:every 100000}} :now-fn (fn () 1000)}
        (fn (m c r) [])
        (fn (m input c r) (do (send me [:saw input]) (assoc m :done true)))
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [80 24])
         :draw (fn (f) nil)
         :poll (fn (ms) (receive ([:input i] i) (after 0 nil)))})
      (assert= (receive ([:saw x] x) (after 200 :none)) "z"))))

(describe "ui-memo — memoised view fragments (ADR-336)"
  (test "ui-memo-marker? names a [:ui/memo key deps ops] marker and nothing else"
    (is (ui-memo-marker? [:ui/memo [:line 1] [:a] (list (text 1 0 "x"))]))
    (refute (ui-memo-marker? [:text 1 0 "x"]))
    (refute (ui-memo-marker? (list :ui/memo [:line 1] [:a] nil))))

  (test "outside a loop it is just the thunk: plain ops, no marker"
    (assert= (ui-memo [:line 1] [:a] (fn () (list (text 1 0 "x")))) (list [:text 1 0 "x"]))
    (is (nil? editor/ui/*memo*)))

  (test "inside a loop it reuses the ops while deps are =, recomputes when they change"
    (let (me (self)
          ;; the view counts every real computation of the fragment
          ;; The thunk sends on purpose — that IS the count — which is exactly what the
          ;; checker's memo lint exists to flag (ADR-351), so it is opted out here.
          view (fn (m c r)
                 (append [(clear)]
                   (check-allow :pure
                     (ui-memo [:frag]
                       (get m :deps)
                       (fn ()
                         (do
                           (send me [:computed (get m :n)])
                           (list (text 0 0 (str "n" (get m :n))))))))))
          update (fn (m input c r)
                   (case input
                     :same (assoc m :n (inc (get m :n)))
                     :change (assoc m :n (inc (get m :n)) :deps [:b])
                     :quit (assoc m :done true)
                     m)))
      (send me [:input :same])
      (send me [:input :change])
      (send me [:input :same])
      (send me [:input :quit])
      (ui-run {:done false :n 0 :deps [:a]}
        view
        update
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [40 10])
         :draw (fn (f) (send me [:frame f]))
         :poll (fn (ms) (receive ([:input i] i) (after 0 :quit)))})
      ;; computed at n=0 (first turn), reused at n=1 (same deps), recomputed at n=2
      ;; (deps changed), reused at n=3
      (assert= (receive ([:computed x] x) (after 100 :none)) 0)
      (assert= (receive ([:computed x] x) (after 100 :none)) 2)
      (assert= (receive ([:computed x] x) (after 100 :none)) :none)
      ;; and every frame the frontend saw is plain — the marker is spliced away
      (let (frames (letrec (go (fn (acc)
                                 (receive ([:frame f] (go (cons f acc))) (after 0 (reverse acc)))))
                     (go (list))))
        (assert= (count frames) 4)
        (assert= (nth frames 0) [[:clear] [:text 0 0 "n0"]])
        ;; the reused fragment paints last turn's ops, by design: its deps said nothing changed
        (assert= (nth frames 1) [[:clear] [:text 0 0 "n0"]])
        (assert= (nth frames 2) [[:clear] [:text 0 0 "n2"]])
        (assert= (nth frames 3) [[:clear] [:text 0 0 "n2"]]))))

  (test "ui-harvest splices markers (nested, and inside a scroll-region) and tables them"
    (let (inner [:ui/memo [:l 2] [:d2] (list (text 2 0 "b"))]
          outer [:ui/memo [:pane] [:d1] (list (text 1 0 "a") inner)]
          [frame table] (ui-harvest [(clear) outer (scroll-region 0.5 [inner]) (cursor 0 0)]))
      (assert= frame
        [[:clear]
          [:text 1 0 "a"]
          [:text 2 0 "b"]
          [:scroll-region 0.5 [[:text 2 0 "b"]]]
          [:cursor 0 0]])
      (assert= (get table [:l 2]) [[:d2] (list [:text 2 0 "b"])])
      ;; an entry keeps its ops as emitted, inner marker included, so a hit replays it
      (assert= (get table [:pane]) [[:d1] (list [:text 1 0 "a"] inner)])))

  (test "an outer fragment that hits keeps its inner fragments in the next table"
    ;; The second turn replays the outer entry (what `ui-memo` does on a hit). Its inner
    ;; fragment must be tabled again, or the first turn the outer misses recomputes it.
    (let (inner [:ui/memo [:l 2] [:d2] (list (text 2 0 "b"))]
          outer [:ui/memo [:pane] [:d1] (list (text 1 0 "a") inner)]
          [_ first-table] (ui-harvest [outer])
          replayed [:ui/memo [:pane] [:d1] (second (get first-table [:pane]))]
          [frame second-table] (ui-harvest [replayed]))
      (assert= frame [[:text 1 0 "a"] [:text 2 0 "b"]])
      (assert= (get second-table [:l 2]) [[:d2] (list [:text 2 0 "b"])])))

  (test "ui-harvest recurses into a cell-region the way it does a scroll-region"
    ;; a memoised pane body zoomed to another size is a marker INSIDE a cell-region: the
    ;; marker must still be spliced and tabled, and the region rebuilt around the result
    (let (inner [:ui/memo [:body] [:d] (list (text 0 0 "z"))]
          [frame table] (ui-harvest [(cell-region 1 2 30 8 21.0 [inner]) (cursor 0 0)]))
      (assert= frame [[:cell-region 1 2 30 8 21.0 [[:text 0 0 "z"]]] [:cursor 0 0]])
      (assert= (get table [:body]) [[:d] (list [:text 0 0 "z"])])))

  (test "a frame without markers harvests to itself and an empty table"
    (assert= (ui-harvest [(clear) (text 0 0 "x")]) [[[:clear] [:text 0 0 "x"]] {}]))

  (test "keep-markers? hands the frame back as it is, and tables the markers all the same"
    (let (inner [:ui/memo [:l 2] [:d2] (list (text 2 0 "b")) true]
          outer [:ui/memo [:pane] [:d1] (list (text 1 0 "a") inner) false]
          frame [(clear) outer (scroll-region 0.5 [inner])]
          [kept table] (ui-harvest frame true))
      (assert= kept frame)
      (assert= (get table [:l 2]) [[:d2] (list [:text 2 0 "b"])])
      (assert= (get table [:pane]) [[:d1] (list [:text 1 0 "a"] inner)])))

  (test "a display with :fragments? sees the markers, flagged reused only when they were"
    ;; ADR-470: the GUI window reuses its parse of a fragment the loop reused, so the flag
    ;; must be exactly "these ops are last turn's value": false on a recompute
    (let (me (self)
          view (fn (m c r)
                 (append [(clear)] (ui-memo [:frag] (get m :deps) (fn () (list (text 0 0 "x"))))))
          update (fn (m input c r)
                   (case input
                     :same (assoc m :n 1)
                     :change (assoc m :deps [:b])
                     :quit (assoc m :done true)
                     m)))
      (send me [:input :same])
      (send me [:input :change])
      (send me [:input :quit])
      (ui-run {:done false :n 0 :deps [:a]}
        view
        update
        {:enter (fn () nil)
         :leave (fn () nil)
         :size (fn () [40 10])
         :draw (fn (f) (send me [:frame f]))
         :fragments? true
         :poll (fn (ms) (receive ([:input i] i) (after 0 :quit)))})
      (let (flags (letrec (go (fn (acc)
                                (receive
                                  ([:frame f] (go (cons (nth (second f) 4) acc)))
                                  (after 0 (reverse acc)))))
                    (go (list))))
        ;; first turn computes, the same deps reuse, new deps recompute
        (assert= flags (list false true false))))))

(describe "ui-memo — a nil key opts out"
  (test "inside a loop table, a nil key computes and emits no marker"
    (assert= (binding (editor/ui/*memo* {}) (ui-memo nil [:a] (fn () (list (text 1 0 "x")))))
      (list [:text 1 0 "x"]))))

;; ---- a timer fires when it is DUE, not only when input stops -----------------
;; `ui-loop` used to service timers only on a poll TIMEOUT, so a non-idle timer starved for
;; as long as input kept arriving — and a continuous stream (a wheel's kinetic glide, a
;; drag, a held key) is exactly when an app is pacing something with one. bedit's font zoom
;; applied once at the start of a spin and then stood still while its size climbed.
;;
;; The poll here never returns nil: it hands back a queued input, or `:more` (not nil), so
;; nothing can fire on a timeout. A non-idle timer must still fire; an `:idle?` one must
;; still wait, because its deadline counts from the input that just landed.

(defn- ui-under-input (spec)
  "Run `ui-run` against a poll that always has something; the update echoes what it folded
(`[:saw …]`, drained afterwards) since `ui-run` itself returns the `:leave` result."
  (let (me (self))
    (doseq (_ (range 10)) (send me [:input "a"]))
    (ui-run {:timers {:paced spec} :done false :now-fn (fn () 1000)}
      (fn (m c r) [])
      (fn (m input c r)
        (cond
          (and (vector? input) (= (first input) :timer)) (do (send me [:saw :tick]) m)
          (= input :more) (assoc m :done true) ; the queue is empty: stop
          else (do (send me [:saw :key]) m)))
      {:enter (fn () nil)
       :leave (fn () nil)
       :size (fn () [80 24])
       :draw (fn (f) nil)
       ;; never nil — a timeout is the one thing this test must not rely on
       :poll (fn (ms) (receive ([:input i] i) (after 0 :more)))})))

(describe "timers under continuous input"
  (test "a non-idle timer fires while input keeps arriving"
    ;; a frozen clock and an :after-0 timer: due on sight, so the test turns on WHETHER the
    ;; input turn services timers at all, not on how fast the run happens to be
    (let (_ (ui-under-input {:after 0})
          saw (drain-saw ()))
      (assert= (count (seq/filter saw (fn (x) (= x :key)))) 10)
      (is (> (count (seq/filter saw (fn (x) (= x :tick)))) 0))))
  (test "an :idle? timer still waits for the input to settle"
    (let (_ (ui-under-input {:after 1 :idle? true})
          saw (drain-saw ()))
      (assert= (count (seq/filter saw (fn (x) (= x :key)))) 10)
      (assert= (count (seq/filter saw (fn (x) (= x :tick)))) 0))))

(describe "editor/ui — display-texture (the pixel-space seam through a display map)"
  (test "the handle comes from gui/alloc-texture and the upload goes through the display"
    (let (log (table/new)
          display {:texture (fn (tex rgba w h) (table/put log :upload [tex rgba w h]))}
          tex (display-texture display [9 9 9 9] 1 1))
      (assert= (gui/texture-size tex) [1 1])
      (assert= (table/get log :upload) [tex [9 9 9 9] 1 1])))

  (test "the image-map form unpacks width, height and rgba"
    (let (log (table/new)
          display {:texture (fn (tex rgba w h) (table/put log :upload [w h]))}
          tex (display-texture display {:width 2 :height 1 :rgba [0 0 0 0 0 0 0 0]}))
      (assert= (gui/texture-size tex) [2 1])
      (assert= (table/get log :upload) [2 1])))

  (test "a display without :texture (the terminal) still hands back a sized handle"
    (let (tex (display-texture {} [1 2 3 4] 1 1))
      (assert= (gui/texture-size tex) [1 1]))))

(describe "editor/ui — display-sound (a sound through a display map)"
  (test "the handle knows the sound's length and the upload goes through the display"
    (let (log (table/new)
          display {:sound (fn (snd pcm rate ch) (table/put log :upload [snd rate ch]))}
          snd (display-sound display [0 0 0 0 0 0 0 0] 4))
      ;; four PCM16 mono samples at 4 Hz: one second
      (assert= (gui/sound-seconds snd) 1.0)
      (assert= (table/get log :upload) [snd 4 1])))

  (test "stereo halves the seconds per byte; a display without :sound still hands back a handle"
    (let (snd (display-sound {} [0 0 0 0 0 0 0 0] 4 2))
      (assert= (gui/sound-seconds snd) 0.5))))

;; ---- quit (ADR-491) ----------------------------------------------------------------

(defn- quit-spin (n)
  "A loop that never ends: only an interrupt stops it."
  (quit-spin (inc n)))

(defn- busy-for (ms)
  "Work that runs `ms` and then ends — at safepoints throughout, so an interrupt can land in it."
  (letrec (spin (fn (until) (if (< (os/now) until) (spin until) nil))) (spin (+ (os/now) ms))))

(defn- quit-stubborn (swallowed)
  "Work that catches EVERY error, an interrupt too, and goes on: Emacs's quit is not an
error a catch-all sees, so the kernel keeps raising it (sticky) until the window closes."
  (do
    (check-allow :discarded-catch (try (quit-spin 0) (catch e nil)))
    (quit-stubborn (inc swallowed))))

(defn- quit-count-to (n limit)
  "Count to `limit` — a fold that runs a while and then finishes."
  (if (= n limit) n (quit-count-to (inc n) limit)))

(defn- quit-busy-until (deadline)
  "Keep busy until the wall clock reaches `deadline` (ms) — a command that takes a while."
  (if (>= (os/now) deadline) nil (quit-busy-until deadline)))

(defn- quit-await (tag)
  (receive ([^tag value] value) (after 20000 :timed-out)))

(describe "proc/interrupt — the kernel's quit (ADR-491)"
  (test "a running process in its window is stopped, and proc/interruptible says so"
    (let (me (self)
          spinner (spawn (let (r (proc/interruptible nil
                                   (fn () (do (send me [:spinning true]) (quit-spin 0)))))
                           (send me [:caught [(first r) (:kind (second r)) (:code (second r))]]))))
      (quit-await :spinning)
      (is (proc/interrupt spinner))
      (assert= (quit-await :caught) [:interrupted :interrupted "E0047"])))
  (test "a try inside the window catches the interrupt like any error — and cannot keep it"
    (let (me (self)
          worker (spawn
                   (let (r (proc/interruptible nil
                             (fn ()
                               (do
                                 (send me [:spinning true])
                                 (try (quit-spin 0) (catch e :swallowed))
                                 ;; swallowed — but it is sticky: the first safepoint after
                                 ;; the handler raises it again, long before this ends
                                 (quit-count-to 0 1000000000)
                                 :finished))))
                     (send me [:outer [(first r) (:kind (second r))]]))))
      (quit-await :spinning)
      (is (proc/interrupt worker))
      (assert= (quit-await :outer) [:interrupted :interrupted])))
  (test "a process blocked in receive is not interrupted, now or later"
    (let (me (self)
          parked (spawn (let (r (proc/interruptible nil
                                  (fn ()
                                    (do
                                      (send me [:parked true])
                                      (receive (:go (quit-count-to 0 100000)))))))
                          (send me [:finished r]))))
      (quit-await :parked)
      ; it may not have reached its receive yet: wait until it is parked there
      (letrec (wait (fn ()
                      (when (not (= (get (proc/info parked) :status) :waiting))
                        (do (proc/sleep 1) (wait)))))
        (wait))
      (is (not (proc/interrupt parked)))
      (send parked :go)
      (assert= (quit-await :finished) [:ok 100000])))
  (test "a vector quit key matches a tagged message on the ordinary lane, as a wire key arrives"
    (let (me (self)
          worker (spawn (do
                          (proc/set-quit-key [:key :ctrl-g] 0)
                          (let (r (proc/interruptible nil
                                    (fn () (do (send me [:spinning true]) (quit-spin 0)))))
                            (send me [:outer [(first r) (receive ([:key k held?] [k held?]))]])))))
      (quit-await :spinning)
      ; an atom on the ordinary lane is not a key: nothing happens
      (send worker :ctrl-g)
      (send worker [:key :ctrl-g true])
      (assert= (quit-await :outer) [:interrupted [:ctrl-g true]])))
  (test "a closed window is never interrupted"
    (is (not (proc/interrupt (self))))))

(describe "ui-run — quit (ADR-491)"
  (test "C-g on the priority lane stops an update looping forever; the model is the old one"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (do (send me [:seen (:seen model)]) (assoc model :done true))
                   (= input :spin) (do (send me [:spinning true]) (quit-spin 0))
                   (= input :tick) model
                   else (lane-record model input)))
          loop (lane-start me
                 {:quit-busy-ms 0 :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (proc/send-priority loop :spin)
      (send loop :go)
      (quit-await :spinning)
      (proc/send-priority loop :ctrl-g)
      (let (report (quit-await :slow))
        (assert= (:phase report) "update")
        (assert= (:tag report) :spin)
        (assert= (:input report) true)
        (is (:interrupted report)))
      (proc/send-priority loop :quit)
      ; the spin never reached the model; the C-g is still folded, as the app's own key
      (assert= (lane-await-seen) [:ctrl-g])))
  (test "an update that catches everything in a loop is still stopped, and the loop runs on"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (do (send me [:seen (:seen model)]) (assoc model :done true))
                   (= input :stubborn) (do (send me [:spinning true]) (quit-stubborn 0))
                   (= input :tick) model
                   else (lane-record model input)))
          loop (lane-start me
                 {:quit-busy-ms 0 :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (proc/send-priority loop :stubborn)
      (send loop :go)
      (quit-await :spinning)
      (proc/send-priority loop :ctrl-g)
      (let (report (quit-await :slow))
        (assert= (:tag report) :stubborn)
        (is (:interrupted report)))
      (proc/send-priority loop "after")
      (proc/send-priority loop :quit)
      (assert= (lane-await-seen) [:ctrl-g "after"])))
  (test "a display that cannot tell input calls a burst's every key input: no ceiling stops one"
    ;; No `:poll-input`: everything its `:poll` gives is the user's, as before ADR-490. The
    ;; second key of a coalesced burst is folded by the drain's budget branch, which must
    ;; pass that on, or the background ceiling stops the user's own command.
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (do (send me [:seen (:seen model)]) (assoc model :done true))
                   (= input "slow")
                     (do (quit-busy-until (+ (os/now) 150)) (lane-record model :slow-done))
                   (= input :tick) model
                   else (lane-record model input)))
          loop (spawn (receive
                        (:go (ui-run {:seen []
                                      :coalesce-input? true
                                      :event-ceiling-ms 50
                                      :on-slow (fn (report) (send me [:slow report]))}
                               (fn (model cols rows) [])
                               step
                               (dissoc (lane-display) :poll-input :poll-tagged))))))
      (send loop "a")
      (send loop "slow")
      (send loop :quit)
      (send loop :go)
      (assert= (lane-await-seen) ["a" :slow-done])
      (is (not (:interrupted (receive ([:slow report] report) (after 0 {})))))))
  (test "a background event past the ceiling is interrupted by the loop and reported"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (do (send me [:seen (:seen model)]) (assoc model :done true))
                   (= (lane-tag input) :stuck) (quit-spin 0)
                   (= input :tick) model
                   else (lane-record model input)))
          loop (lane-start me
                 {:event-ceiling-ms 50 :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (send loop [:stuck "a reply whose fold never ends"])
      (send loop [:after 1])
      (send loop :quit)
      (send loop :go)
      (let (report (quit-await :slow))
        (assert= (:phase report) "update")
        (assert= (:tag report) :stuck)
        (assert= (:input report) false)
        (is (:interrupted report))
        (is (>= (:ms report) 50)))
      (assert= (lane-await-seen) [[:after 1]])))
  (test "a :command? timer's fold is the user's: no background ceiling stops it (ADR-564)"
    ;; a step past the ceiling, on a repeating timer that drops itself when the step is
    ;; done: stopped at the ceiling it would keep the model it began from and run again
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (assoc model :done true)
                   (= input [:timer :step])
                     (do (busy-for 150) (send me [:stepped]) (assoc model :timers {}))
                   else model))
          loop (lane-start me
                 {:timers {:step {:every 1 :command? true}}
                  :event-ceiling-ms 50
                  :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (send loop :go)
      (assert= (receive ([:stepped] :once) (after 3000 :never)) :once)
      (assert= (receive ([:stepped] :again) (after 300 :no)) :no)
      (is (not (:interrupted (receive ([:slow report] report) (after 0 {})))))
      (send loop :quit)))
  (test "a plain timer's fold past the ceiling is stopped, as any background fold"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (assoc model :done true)
                   (= input [:timer :step])
                     (do (busy-for 150) (send me [:stepped]) (assoc model :timers {}))
                   else model))
          loop (lane-start me
                 {:timers {:step {:after 1}}
                  :event-ceiling-ms 50
                  :on-slow (fn (report) (send me [:slow report]))}
                 step))
      (send loop :go)
      (is (:interrupted (receive ([:slow report] report) (after 3000 {}))))
      (assert= (receive ([:stepped] :done) (after 300 :no)) :no)
      (send loop :quit)))
  (test "a fast fold is untouched: C-g is an ordinary key, and nothing is reported"
    (let (me (self)
          loop (lane-start me
                 {:on-slow (fn (report) (send me [:slow report]))}
                 (lane-update me)))
      (proc/send-priority loop :ctrl-g)
      (proc/send-priority loop "x")
      (send loop :quit)
      (send loop :go)
      (assert= (lane-await-seen) [:ctrl-g "x" :quit])
      (assert= (receive ([:slow report] report) (after 50 :none)) :none)))
  (test "with no quit key a C-g stops nothing: a long user command runs to its end"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (do (send me [:seen (:seen model)]) (assoc model :done true))
                   (= input :long)
                     (do
                       (send me [:started true])
                       (lane-record model [:long (quit-count-to 0 3000000)]))
                   (= input :tick) model
                   else (lane-record model input)))
          loop (lane-start me {:quit-key nil :quit-busy-ms 0 :slow-ms 60000} step))
      (proc/send-priority loop :long)
      (send loop :go)
      (quit-await :started)
      (proc/send-priority loop :ctrl-g)
      (proc/send-priority loop :quit)
      (assert= (lane-await-seen) [[:long 3000000] :ctrl-g])))
  (test "a display that ships keys as [:key k] (a served session) gets its C-g in that shape"
    (let (me (self)
          step (fn (model input cols rows)
                 (cond
                   (= input :quit) (do (send me [:seen (:seen model)]) (assoc model :done true))
                   (= input :spin) (do (send me [:spinning true]) (quit-spin 0))
                   (= input :tick) model
                   else (lane-record model input)))
          display (assoc (lane-display) :quit-message (fn (key) [:key key]))
          loop (spawn (receive
                        (:go (ui-run {:seen []
                                      :quit-busy-ms 0
                                      :on-slow (fn (report) (send me [:slow report]))}
                               (fn (model cols rows) [])
                               step
                               display)))))
      (proc/send-priority loop :spin)
      (send loop :go)
      (quit-await :spinning)
      ; the wire shape, on the ordinary lane: a thin client's key
      (send loop [:key :ctrl-g true])
      (let (report (quit-await :slow))
        (assert= (:tag report) :spin)
        (is (:interrupted report)))
      (proc/send-priority loop :quit)
      (assert= (lane-await-seen) [[:key :ctrl-g true]])))
  (test "an interrupted view keeps the last frame, and the next model is drawn"
    (let (me (self)
          loop (spawn (receive
                        (:go (ui-run {:slow false
                                      :quit-busy-ms 0
                                      :on-slow (fn (report) (send me [:slow report]))}
                               (fn (model cols rows)
                                 (if (:slow model)
                                   (do (send me [:viewing true]) (quit-spin 0))
                                   [[:clear]]))
                               (fn (model input cols rows)
                                 (cond
                                   (= input :slow) (assoc model :slow true)
                                   (= input :ctrl-g) (assoc model :slow false :quit-seen true)
                                   (= input :quit) (assoc model :done true)
                                   else model))
                               (assoc (lane-display)
                                 :draw (fn (frame) (send me [:drew frame]))))))))
      (send loop :go)
      (assert= (quit-await :drew) [[:clear]])
      (proc/send-priority loop :slow)
      (quit-await :viewing)
      (proc/send-priority loop :ctrl-g)
      (let (report (quit-await :slow))
        (assert= (:phase report) "view")
        (is (:interrupted report)))
      ; the C-g is folded next, and its (fast) model is what the screen shows next
      (assert= (quit-await :drew) [[:clear]])
      (proc/send-priority loop :quit)))
  (test "a view that throws rolls back to the last model that RENDERED, not one interrupted"
    ;; :n 1's view is stopped by a C-g (once: a second render of it would draw), the C-g
    ;; moves the model to :n 2, whose view throws. The rollback must land on :n 0, the
    ;; last model drawn — the interrupted :n 1 never was.
    (let (me (self)
          spun (table/new)
          loop (spawn (receive
                        (:go (ui-run {:n 0 :quit-busy-ms 0}
                               (fn (model cols rows)
                                 (cond
                                   (and (= (:n model) 1) (not (table/get spun :once false)))
                                     (do
                                       (table/put spun :once true)
                                       (send me [:viewing true])
                                       (quit-spin 0))
                                   (= (:n model) 2) (error "view: a model that cannot be drawn")
                                   else [[:text 0 0 (str (:n model))]]))
                               (fn (model input cols rows)
                                 (cond
                                   (= input :inc) (assoc model :n 1)
                                   (= input :ctrl-g) (assoc model :n 2)
                                   (= input :quit) (assoc model :done true)
                                   else model))
                               (assoc (lane-display)
                                 :draw (fn (frame) (send me [:drew frame]))))))))
      (send loop :go)
      (assert= (quit-await :drew) [[:text 0 0 "0"]])
      (proc/send-priority loop :inc)
      (quit-await :viewing)
      (proc/send-priority loop :ctrl-g)
      ;; :n 0 is still on screen, so the rollback has nothing to draw; rolled back to the
      ;; interrupted :n 1, the loop drew it
      (assert= (receive ([:drew frame] frame) (after 300 :nothing-new)) :nothing-new)
      (proc/send-priority loop :quit))))

;; The terminal's quit key, end to end: a real `ui-run` over `editor/frontend/*term-display*` under a
;; pseudo-terminal. Its keys reach the loop through the reader thread `term/forward-input`
;; starts, on the priority lane, so a C-g typed while `update` loops forever stops it —
;; which the terminal, read by the loop itself, could not do before (ADR-491).
;; The app runs under `nest run`, found beside the running binary: under the cargo suite
;; `(os/exe-path)` is the libtest harness, which reads `run` as a test-name filter and
;; never draws.
(defn- term-quit-await-file (path ms)
  "Poll for `path` to exist, every 10 ms, up to `ms`: true when it does."
  (cond
    (file/exists? path) true
    (<= ms 0) false
    else (do (proc/sleep 10) (term-quit-await-file path (- ms 10)))))

(describe "ui-run — a terminal C-g (ADR-491)"
  :isolated (test "C-g in a terminal stops an update looping forever"
    (let (dir (test/temp-dir "brood-term-quit-")
          script (str dir "/app.blsp")
          marker (fn (name) (str dir "/" name)))
      (do
        (file/mkdir dir)
        (file/spit script
          (str "(defmodule term-quit-app (:use editor/ui))\n"
            "(defn spin (n) (spin (inc n)))\n"
            "(defn mark (name) (file/spit (str "
            (pr-str dir)
            " \"/\" name) name))\n"
            "(ui-run {:quit-busy-ms 0 "
            ":on-slow (fn (r) (when (:interrupted r) (mark \"interrupted\")))}\n"
            "  (fn (m c r) (do (mark \"drawn\") [[:clear]]))\n"
            "  (fn (m input c r) (cond (= input \"s\") (do (mark \"spinning\") (spin 0))\n"
            "                          (= input :ctrl-g) (do (mark \"quit-folded\") m)\n"
            "                          (= input \"q\") (assoc m :done true)\n"
            "                          else m))\n"
            "  editor/frontend/*term-display*)\n"
            "(mark \"exited\")\n"))
        (let (nest (sibling-binary "nest")
              p (os/spawn-pty nest ["run" script] {:cols 80 :rows 24}))
          (is (term-quit-await-file (marker "drawn") 20000))
          (os/write p "s")
          (is (term-quit-await-file (marker "spinning") 20000))
          (os/write p 7)
          (is (term-quit-await-file (marker "interrupted") 20000))
          (is (term-quit-await-file (marker "quit-folded") 20000))
          (os/write p "q")
          (is (term-quit-await-file (marker "exited") 20000))
          (os/close p)
          (file/rmdir dir))))))
