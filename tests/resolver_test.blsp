;; Tests for `std/resolver` — the dependency version resolver (ADR-209). The resolver
;; is a pure backtracking, newest-compatible solver over an injected `provider`, so the
;; whole thing is exercised offline: each test builds a literal package universe (what
;; versions exist, what each requires) and asserts the picked solution — or the conflict
;; message when none exists. No network, no registry, no filesystem.
;;
;; The design choices these pin: NEWEST compatible wins; a later decision must respect an
;; earlier one (which is what forces backtracking); a dead end reports the real conflict
;; and who required what, not a bland failure.

(defmodule resolver-test (:use test) (:use resolver))

;; the oracle (below) checks constraints directly, so it names `version` explicitly

;; ---- file-local helpers (defined once at load; survive :isolated rollback) ----
;; A provider from two literal tables: `versions` is {name -> [version ...]}; `deps` is
;; {name -> {version -> [[dep-name constraint] ...]}}. A missing entry is nil (no
;; versions / no deps), which is exactly what the resolver must tolerate.
(defn rt-prov (versions deps)
  (make-provider (fn (nm) (get versions nm))
    (fn (nm v) (get (get deps nm) v))))

(defn rt-ok (roots p)
  (match (resolve roots p)
    ([:ok solution] solution)
    ([:error message] (error (str "expected a solution, got error: " message)))))

(defn rt-err (roots p)
  (match (resolve roots p)
    ([:error message] message)
    ([:ok solution] (error (str "expected a conflict, got solution: " (pr-str solution))))))

(defn rt-ok-pref (roots p preferred)
  (match (resolve roots p preferred)
    ([:ok solution] solution)
    ([:error message] (error (str "expected a solution, got error: " message)))))

;; A provider with no deps anywhere — every release requires nothing.
(defn rt-leaf-prov (versions) (rt-prov versions {}))

(describe "resolver: the provider"
  (test "versions and deps are read straight through the two closures"
    (let (p (rt-prov {'foo ["1.0.0" "2.0.0"]} {'foo {"2.0.0" [['bar ">= 1.0"]]}}))
      (assert= ["1.0.0" "2.0.0"] (provider-versions p 'foo))
      (assert= [['bar ">= 1.0"]] (provider-deps p 'foo "2.0.0"))))
  (test "an unknown package yields nil versions, not a crash"
    (let (p (rt-leaf-prov {'foo ["1.0.0"]}))
      (assert= nil (provider-versions p 'missing)))))

(describe "resolver: a single root"
  (test "picks the only version"
    (assert= {'foo "1.0.0"}
      (rt-ok [['foo nil]] (rt-leaf-prov {'foo ["1.0.0"]}))))
  (test "a nil constraint means any version — newest wins"
    (assert= {'foo "2.3.0"}
      (rt-ok [['foo nil]] (rt-leaf-prov {'foo ["1.0.0" "2.3.0" "2.0.0"]}))))
  (test "an empty-string constraint also means any version"
    (assert= {'foo "2.0.0"}
      (rt-ok [['foo ""]] (rt-leaf-prov {'foo ["1.0.0" "2.0.0"]}))))
  (test "a range constraint narrows to the newest that fits"
    (assert= {'foo "1.9.0"}
      (rt-ok [['foo "^1.2"]] (rt-leaf-prov {'foo ["1.1.0" "1.9.0" "2.0.0"]}))))
  (test "an exact constraint pins that version even when newer exist"
    (assert= {'foo "1.2.0"}
      (rt-ok [['foo "= 1.2.0"]] (rt-leaf-prov {'foo ["1.2.0" "1.3.0" "2.0.0"]}))))
  (test "a conjunction range constraint is honoured"
    (assert= {'foo "1.5.0"}
      (rt-ok [['foo ">= 1.2, < 2.0"]] (rt-leaf-prov {'foo ["1.1.0" "1.5.0" "2.0.0"]})))))

(describe "resolver: transitive dependencies"
  (test "a dep is fetched and pinned to its newest compatible version"
    (let (p (rt-prov {'foo ["1.5.0"] 'bar ["2.0.0" "2.1.0" "3.0.0"]}
              {'foo {"1.5.0" [['bar ">= 2.0"]]}}))
      (assert= {'foo "1.5.0" 'bar "3.0.0"} (rt-ok [['foo "^1.2"]] p))))
  (test "a chain a -> b -> c resolves all three"
    (let (p (rt-prov {'a ["1.0.0"] 'b ["1.0.0"] 'c ["1.0.0"]}
              {'a {"1.0.0" [['b nil]]} 'b {"1.0.0" [['c nil]]}}))
      (assert= {'a "1.0.0" 'b "1.0.0" 'c "1.0.0"} (rt-ok [['a nil]] p))))
  (test "a caret on a transitive dep caps its major"
    (let (p (rt-prov {'a ["1.0.0"] 'd ["1.0.0" "1.4.0" "2.0.0"]}
              {'a {"1.0.0" [['d "^1.0.0"]]}}))
      (assert= {'a "1.0.0" 'd "1.4.0"} (rt-ok [['a nil]] p)))))

(describe "resolver: shared (diamond) dependencies"
  (test "two paths onto the same package intersect their constraints"
    ;; a wants d ^1.0.0 (so < 2.0), b wants d >= 1.1.0 -> newest in [1.1.0, 2.0.0) = 1.1.0
    (let (p (rt-prov {'a ["1.0.0"] 'b ["1.0.0"] 'd ["1.0.0" "1.1.0" "2.0.0"]}
              {'a {"1.0.0" [['d "^1.0.0"]]} 'b {"1.0.0" [['d ">= 1.1.0"]]}}))
      (assert= {'a "1.0.0" 'b "1.0.0" 'd "1.1.0"} (rt-ok [['a nil] ['b nil]] p))))
  (test "a root pin and a transitive range agree on one version"
    (let (p (rt-prov {'a ["1.0.0"] 'd ["1.0.0" "1.1.0" "1.2.0"]}
              {'a {"1.0.0" [['d ">= 1.0.0"]]}}))
      ;; root pins d = 1.1.0 directly; a is happy with anything >= 1.0.0
      (assert= {'a "1.0.0" 'd "1.1.0"} (rt-ok [['a nil] ['d "= 1.1.0"]] p)))))

(describe "resolver: backtracking"
  (test "falls back to an older version of a package when the newest dead-ends"
    ;; a@2.0.0 needs c = 1.0.0, but b forces c = 2.0.0 -> a@2.0.0 is impossible,
    ;; so the search must fall back to a@1.0.0 (which needs c = 2.0.0, and agrees).
    (let (p (rt-prov {'a ["1.0.0" "2.0.0"] 'b ["1.0.0"] 'c ["1.0.0" "2.0.0"]}
              {'a {"2.0.0" [['c "= 1.0.0"]] "1.0.0" [['c "= 2.0.0"]]}
               'b {"1.0.0" [['c "= 2.0.0"]]}}))
      (assert= {'a "1.0.0" 'b "1.0.0" 'c "2.0.0"} (rt-ok [['a nil] ['b nil]] p))))
  (test "backtracks across two levels to satisfy a deep constraint"
    ;; top@2 -> mid ^2 ; top@1 -> mid ^1 ; leaf forces mid = 1.5.0
    (let (p (rt-prov {'top ["1.0.0" "2.0.0"] 'mid ["1.5.0" "2.5.0"] 'leaf ["1.0.0"]}
              {'top {"2.0.0" [['mid "^2.0.0"]] "1.0.0" [['mid "^1.0.0"]]}
               'leaf {"1.0.0" [['mid "= 1.5.0"]]}}))
      (assert= {'top "1.0.0" 'mid "1.5.0" 'leaf "1.0.0"}
        (rt-ok [['top nil] ['leaf nil]] p)))))

(describe "resolver: cycles"
  (test "a mutual dependency resolves when the versions agree"
    (let (p (rt-prov {'a ["1.0.0"] 'b ["1.0.0"]}
              {'a {"1.0.0" [['b nil]]} 'b {"1.0.0" [['a nil]]}}))
      (assert= {'a "1.0.0" 'b "1.0.0"} (rt-ok [['a nil]] p))))
  (test "a self-dependency at a compatible version is fine"
    (let (p (rt-prov {'a ["1.0.0"]} {'a {"1.0.0" [['a ">= 1.0.0"]]}}))
      (assert= {'a "1.0.0"} (rt-ok [['a nil]] p)))))

(describe "resolver: conflicts and error messages"
  (test "an unsatisfiable diamond names BOTH conflicting requirers and what shared offers"
    (let (p (rt-prov {'foo ["1.0.0"] 'baz ["1.0.0"] 'shared ["1.0.0" "1.5.0" "2.0.0"]}
              {'foo {"1.0.0" [['shared "^1.0.0"]]}
               'baz {"1.0.0" [['shared "^2.0.0"]]}})
          message (rt-err [['foo nil] ['baz nil]] p))
      ;; a pub-style structured proof: BOTH requirements on `shared` (foo wants ^1, baz wants ^2)
      ;; combined into a "Because … and …" chain that ends in "version solving failed", plus what
      ;; `shared` actually offers — so the reader follows why no version spans both
      (is (includes? message "Because"))
      (is (includes? message "foo 1.0.0 requires shared ^1.0.0"))
      (is (includes? message "baz 1.0.0 requires shared ^2.0.0"))
      (is (includes? message "version solving failed"))
      ;; an unconstrained root requirement reads "requires foo", not "requires foo (any version)"
      (is (includes? message "your project requires foo"))
      (is (not (includes? message "(any version)")))
      (is (includes? message "shared available: 2.0.0, 1.5.0, 1.0.0"))))
  (test "a dependency chain that dead-ends renders a structured, minimal derivation"
    (let (p (rt-prov {'a ["1.0.0"] 'b ["1.0.0"] 'c ["1.0.0"]}
              {'a {"1.0.0" [['b "^1.0.0"]]}
               'b {"1.0.0" [['c "^2.0.0"]]}})
          message (rt-err [['a nil]] p))
      ;; each real link in the chain appears once, joined by the derivation
      (is (includes? message "a 1.0.0 requires b ^1.0.0"))
      (is (includes? message "b 1.0.0 requires c ^2.0.0"))
      (is (includes? message "Because"))
      (is (includes? message "c available: 1.0.0"))))
  (test "only the packages that actually clash are named, not every requirer"
    ;; x wants s ^1, y wants s ^2, z wants s ^3 — PubGrub finds ONE clashing pair and the
    ;; derivation names just those two, leaving the irrelevant third requirer out.
    (let (p (rt-prov {'x ["1.0.0"] 'y ["1.0.0"] 'z ["1.0.0"] 's ["1.0.0" "2.0.0" "3.0.0"]}
              {'x {"1.0.0" [['s "^1.0.0"]]}
               'y {"1.0.0" [['s "^2.0.0"]]}
               'z {"1.0.0" [['s "^3.0.0"]]}})
          message (rt-err [['x nil] ['y nil] ['z nil]] p))
      (is (includes? message "Because"))
      ;; exactly two of the three requirers are named in the proof
      (is (= 2
            (count (filter (fn (pkg) (includes? message (str pkg " 1.0.0 requires s")))
                     ["x" "y" "z"]))))))
  (test "a required package the provider does not know is a clear error"
    (let (p (rt-prov {'foo ["1.0.0"]} {'foo {"1.0.0" [['ghost ">= 1.0"]]}})
          message (rt-err [['foo nil]] p))
      (is (includes? message "ghost"))
      (is (includes? message "no versions"))))
  (test "a root whose constraint matches nothing reports the available set"
    (let (p (rt-leaf-prov {'foo ["1.0.0" "1.1.0"]})
          message (rt-err [['foo ">= 2.0"]] p))
      (is (includes? message "foo"))
      (is (includes? message "your project"))
      (is (includes? message "1.0.0"))))
  (test "a package with zero published versions fails closed"
    (let (p (rt-prov {'foo []} {})
          message (rt-err [['foo nil]] p))
      (is (includes? message "no versions")))))

(describe "resolver: preferred versions (lock stability)"
  (test "a preferred version is kept even when a newer one also satisfies"
    (let (p (rt-leaf-prov {'foo ["1.0.0" "1.1.0" "1.2.0"]}))
      ;; no preference: newest compatible
      (assert= {'foo "1.2.0"} (rt-ok [['foo "^1.0"]] p))
      ;; foo pinned to 1.0.0: kept, not upgraded
      (assert= {'foo "1.0.0"} (rt-ok-pref [['foo "^1.0"]] p {'foo "1.0.0"}))))
  (test "a preferred version that no longer satisfies is ignored (newest that fits wins)"
    (let (p (rt-leaf-prov {'foo ["1.0.0" "2.0.0" "2.1.0"]}))
      ;; pinned 1.0.0, but the constraint is now ^2.0 — the stale pin is dropped
      (assert= {'foo "2.1.0"} (rt-ok-pref [['foo "^2.0"]] p {'foo "1.0.0"}))))
  (test "adding a new dep keeps the existing dep at its preferred version"
    ;; the whole point: a lock pins foo=1.0.0; adding bar must not drag foo to 1.1.0
    (let (p (rt-leaf-prov {'foo ["1.0.0" "1.1.0"] 'bar ["1.0.0" "2.0.0"]}))
      (assert= {'foo "1.0.0" 'bar "2.0.0"}
        (rt-ok-pref [['foo "^1.0"] ['bar nil]] p {'foo "1.0.0"}))))
  (test "preference does not lose completeness — it still backtracks off a dead-end pin"
    ;; a pinned at 2.0.0 needs c=1.0.0, but b forces c=2.0.0, so the pin can't hold;
    ;; the search must still reach the valid a=1.0.0 / c=2.0.0 solution
    (let (p (rt-prov {'a ["1.0.0" "2.0.0"] 'b ["1.0.0"] 'c ["1.0.0" "2.0.0"]}
              {'a {"2.0.0" [['c "= 1.0.0"]] "1.0.0" [['c "= 2.0.0"]]}
               'b {"1.0.0" [['c "= 2.0.0"]]}}))
      (assert= {'a "1.0.0" 'b "1.0.0" 'c "2.0.0"}
        (rt-ok-pref [['a nil] ['b nil]] p {'a "2.0.0"}))))
  (test "a preference for a package not in the graph is harmless"
    (let (p (rt-leaf-prov {'foo ["1.0.0" "1.1.0"]}))
      (assert= {'foo "1.1.0"} (rt-ok-pref [['foo "^1.0"]] p {'ghost "9.9.9"})))))

(describe "resolver: tangled-but-solvable graphs (PubGrub resolves them, no exponential search)"
  ;; b1..bN each have two versions; `check` needs b1 = 1.0.0 but is discovered LAST, so
  ;; newest-first picks b1 = 2.0.0 early and only meets the conflict at the very end — the
  ;; shape that makes NAIVE backtracking explore all 2^(N-1) combinations. PubGrub's unit
  ;; propagation and conflict-driven learning resolve it in near-linear steps: it learns
  ;; "b1 must be 1.0.0" from the conflict and never re-explores the dead branch.
  (defn rt-tangled (n)
    (let (bs (map (fn (i) (str "b" i)) (range 1 (+ n 1))))
      [(fold (fn (m nm) (assoc m nm ["1.0.0" "2.0.0"])) {"check" ["1.0.0"]} bs)
        (assoc (fold (fn (m nm) (assoc m nm {"1.0.0" [] "2.0.0" []})) {} bs)
          "check" {"1.0.0" [['b1 "= 1.0.0"]]})
        (append (map (fn (nm) [(symbol nm) ">= 1.0"]) bs) (list ['check nil]))]))
  (defn rt-tangled-provider (versions deps)
    (make-provider (fn (nm) (get versions (if (symbol? nm) (name nm) nm)))
      (fn (nm v) (get (get deps (if (symbol? nm) (name nm) nm)) v))))
  (test "a 12-deep tangle that would explode under naive backtracking resolves correctly"
    (let ([versions deps roots] (rt-tangled 12)
          p (rt-tangled-provider versions deps)
          solution (rt-ok roots p))
      ;; forced: check needs b1 = 1.0.0; every other b is free and takes the newest (2.0.0)
      (assert= "1.0.0" (get solution 'b1))
      (assert= "1.0.0" (get solution 'check))
      (assert= "2.0.0" (get solution 'b2))
      (assert= "2.0.0" (get solution 'b12))))
  (test "a deeper tangle (20) still resolves without blowing up"
    (let ([versions deps roots] (rt-tangled 20)
          p (rt-tangled-provider versions deps)
          solution (rt-ok roots p))
      (assert= "1.0.0" (get solution 'b1))
      (assert= "1.0.0" (get solution 'check)))))

(describe "resolver: pre-releases"
  (test "a plain range picks the newest RELEASE, skipping a newer pre-release"
    (assert= {'foo "1.1.0"}
      (rt-ok [['foo "^1.0"]] (rt-leaf-prov {'foo ["1.0.0" "1.1.0-rc.1" "1.1.0"]}))))
  (test "a range that names a pre-release resolves to it"
    (assert= {'foo "1.1.0-rc.1"}
      (rt-ok [['foo ">= 1.1.0-rc"]] (rt-leaf-prov {'foo ["1.1.0-rc.1"]}))))
  (test "only a pre-release under a plain range is unsatisfiable"
    (is (includes? (rt-err [['foo "^1.0"]] (rt-leaf-prov {'foo ["1.1.0-rc.1"]}))
          "foo"))))

(describe "resolver: scale"
  (test "a 120-package transitive graph resolves completely"
    ;; a realistic DAG — each package depends on a few lower-indexed ones with loose ranges,
    ;; so there is essentially no backtracking. Guards the incremental work-list and the
    ;; compiled-constraint fast path against an O(n²) or re-parse-every-check regression:
    ;; if either returned, a 120-package solve would crawl and eventually trip the suite cap.
    (let (n 120
          nm (fn (i) (symbol (str "p" i)))
          versions (fold (fn (m i) (assoc m (nm i) ["1.0.0" "1.1.0" "2.0.0"])) {} (range 0 n))
          deps (fold (fn (m i)
                       (let (ds (if (= i 0)
                                  []
                                  (seq/distinct (seq/keep (fn (j)
                                                    (when (and (>= j 0) (< j i)) [(nm j) ">= 1.0"]))
                                              (list (- i 1) (quot i 2) (- i 3))))))
                         (assoc m (nm i) {"1.0.0" ds "1.1.0" ds "2.0.0" ds})))
                 {}
                 (range 0 n))
          p (make-provider (fn (name) (get versions name)) (fn (name v) (get (get deps name) v)))
          solution (rt-ok [[(nm (- n 1)) ">= 1.0"]] p))
      ;; the root reaches the whole chain (each p_i links to p_{i-1}), so all N resolve,
      ;; each to the newest that fits (2.0.0)
      (assert= n (count (keys solution)))
      (is (every? (fn (kv) (= (nth kv 1) "2.0.0")) (map-pairs solution))))))

(describe "resolver: determinism"
  (test "the same universe resolves to the same solution every time"
    (let (p (rt-prov {'a ["1.0.0" "2.0.0"] 'b ["1.0.0"] 'c ["1.0.0" "2.0.0"]}
              {'a {"2.0.0" [['c "= 1.0.0"]] "1.0.0" [['c "= 2.0.0"]]}
               'b {"1.0.0" [['c "= 2.0.0"]]}}))
      (assert= (rt-ok [['a nil] ['b nil]] p) (rt-ok [['a nil] ['b nil]] p))
      (assert= (rt-ok [['a nil] ['b nil]] p) (rt-ok [['b nil] ['a nil]] p)))))

;; ---- explicit concurrency: a solution is a plain value that crosses heaps --------
;; The resolver produces a map; per the repo's convention every value-carrying feature
;; is exercised across processes too. Each worker resolves the same universe in its own
;; green process (its own heap) and sends the solution back; the parent asserts they all
;; deep-copy across unchanged and agree — proving both determinism and message round-trip.

(defn rt-worker (parent versions deps roots)
  (send parent [:sol (resolve roots (rt-prov versions deps))]))

(defn rt-spawn (parent n versions deps roots)
  (when (> n 0)
    (spawn (rt-worker parent versions deps roots))
    (rt-spawn parent (- n 1) versions deps roots)))

(defn rt-collect (got total acc)
  (if (= got total)
    acc
    (rt-collect (+ got 1) total (receive ([:sol s] (cons s acc))))))

(describe "resolver across processes"
  :isolated
  (test "many workers resolve the same graph to the same solution"
    (let (versions {'a ["1.0.0" "2.0.0"] 'b ["1.0.0"] 'c ["1.0.0" "2.0.0"]}
          deps {'a {"2.0.0" [['c "= 1.0.0"]] "1.0.0" [['c "= 2.0.0"]]}
                'b {"1.0.0" [['c "= 2.0.0"]]}}
          roots [['a nil] ['b nil]]
          expected [:ok {'a "1.0.0" 'b "1.0.0" 'c "2.0.0"}])
      (rt-spawn (self) 16 versions deps roots)
      (let (results (rt-collect 0 16 nil))
        (assert= 16 (count results))
        (is (every? (fn (r) (= r expected)) results))))))

;; ---- generative oracle: the solver vs brute-force enumeration (ADR-209) -------
;; The strongest check here: over hundreds of SEEDED random universes, the backtracking
;; solver's yes/no must match an independent brute-force ORACLE, and every solution it
;; returns must actually satisfy the graph. The oracle shares no code with the solver — it
;; enumerates every one-version-per-package assignment and asks "is the closure reachable
;; from the roots consistent?" — so agreement across a wide sample is strong evidence the
;; solver is both SOUND (never claims a solution that doesn't hold, never a solvable graph
;; unsolvable) and COMPLETE (never gives up when a solution exists). A disagreement is
;; returned as a self-describing counterexample (the universe + roots), not a bare failure.

;; -- universe: {name -> {version -> [[dep-name constraint] ...]}} --
(defn rt-o-versions (universe nm) (keys (get universe nm)))
(defn rt-o-deps (universe nm version) (get (get universe nm) version))

(defn rt-o-provider (universe)
  (make-provider (fn (nm) (rt-o-versions universe nm))
    (fn (nm version) (rt-o-deps universe nm version))))

;; Every full assignment {name -> chosen version}, one per package that HAS a version
;; (a versionless package is simply absent — treated as "missing/unsatisfiable" downstream).
(defn rt-o-assignments (universe)
  (fold (fn (acc nm)
          (let (versions (rt-o-versions universe nm))
            (if (empty? versions)
              acc
              (apply append
                (map (fn (assignment) (map (fn (v) (assoc assignment nm v)) versions)) acc)))))
    (list {})
    (keys universe)))

;; Walk the closure reachable from `queue` under `assignment`; true iff every reachable
;; package is assigned AND every dependency constraint it names is satisfied by the
;; assignment (a reachable but unassigned/versionless package fails the closure).
(defn rt-o-closure-ok? (queue universe assignment visited)
  (cond
    (empty? queue) true
    (contains? visited (first queue)) (rt-o-closure-ok? (rest queue) universe assignment visited)
    else
      (let (nm (first queue)
            chosen (get assignment nm))
        (if (nil? chosen)
          false
          (let (deps (rt-o-deps universe nm chosen))
            (if (every? (fn (d)
                          (let (dep-version (get assignment (nth d 0)))
                            (and dep-version (version/satisfies? dep-version (nth d 1)))))
                  deps)
              (rt-o-closure-ok? (append (rest queue) (map (fn (d) (nth d 0)) deps))
                universe
                assignment
                (assoc visited nm true))
              false))))))

;; An assignment resolves the roots iff every root is assigned + satisfies its constraint
;; AND the closure it reaches is consistent.
(defn rt-o-resolves? (roots universe assignment)
  (and (every? (fn (r)
                 (let (v (get assignment (nth r 0)))
                   (and v (version/satisfies? v (nth r 1)))))
         roots)
    (rt-o-closure-ok? (map (fn (r) (nth r 0)) roots) universe assignment {})))

;; The oracle: is there ANY assignment that resolves the roots?
(defn rt-o-solvable? (roots universe)
  (any? (fn (assignment) (rt-o-resolves? roots universe assignment)) (rt-o-assignments universe)))

;; -- random universe generator (seeded; every gen returns [value next-seed]) --
(def rt-g-versions ["1.0.0" "1.1.0" "2.0.0"])
(def rt-g-constraints ["^1.0" "^2.0" ">= 1.0" "< 2.0" "= 1.0.0" "= 2.0.0" nil])
(def rt-g-packages ['a 'b 'c])

(defn rt-g-version-set (seed)
  ;; 1..3 versions (a prefix of the pool, so they stay ordered)
  (let ([k s1] (rand/int seed 3)) [(take (+ k 1) rt-g-versions) s1]))

(defn rt-g-deps (seed pkg others acc)
  (if (empty? others)
    [acc seed]
    (let ([include s1] (rand/int seed 2))
      (if (= include 1)
        (let ([c s2] (seq/sample s1 rt-g-constraints))
          (rt-g-deps s2 pkg (rest others) (cons [(first others) c] acc)))
        (rt-g-deps s1 pkg (rest others) acc)))))

(defn rt-g-version-map (seed pkg versions acc)
  (if (empty? versions)
    [acc seed]
    (let ([deps s1] (rt-g-deps seed pkg (filter (fn (p) (not (= p pkg))) rt-g-packages) nil))
      (rt-g-version-map s1 pkg (rest versions) (assoc acc (first versions) deps)))))

(defn rt-g-package (seed pkg)
  (let ([versions s1] (rt-g-version-set seed))
    (rt-g-version-map s1 pkg versions {})))

(defn rt-g-universe-map (seed packages acc)
  (if (empty? packages)
    [acc seed]
    (let ([pkgmap s1] (rt-g-package seed (first packages)))
      (rt-g-universe-map s1 (rest packages) (assoc acc (first packages) pkgmap)))))

(defn rt-g-roots (seed packages acc)
  (if (empty? packages)
    [acc seed]
    (let ([include s1] (rand/int seed 2))
      (if (= include 1)
        (let ([c s2] (seq/sample s1 rt-g-constraints))
          (rt-g-roots s2 (rest packages) (cons [(first packages) c] acc)))
        (rt-g-roots s1 (rest packages) acc)))))

(defn rt-g-universe (seed)
  ;; [universe roots next-seed] — roots forced non-empty so there's always something to solve
  (let ([universe s1] (rt-g-universe-map seed rt-g-packages {})
        [roots s2] (rt-g-roots s1 rt-g-packages nil))
    (if (empty? roots)
      (let ([c s3] (seq/sample s2 rt-g-constraints)) [universe (list ['a c]) s3])
      [universe roots s2])))

;; Compare the solver against the oracle for one universe. nil = agreement; otherwise a
;; self-describing counterexample map naming the kind of disagreement.
(defn rt-o-check (universe roots)
  (let (result (resolve roots (rt-o-provider universe))
        solvable (rt-o-solvable? roots universe))
    (match result
      ([:ok solution] (cond
                        (not solvable)
                          {:kind :unsound-claimed-ok
                           :universe universe
                           :roots roots
                           :solution solution}
                        (not (rt-o-resolves? roots universe solution))
                          {:kind :invalid-solution
                           :universe universe
                           :roots roots
                           :solution solution}
                        else nil))
      ([:error message] (if solvable
                          {:kind :incomplete-gave-up
                           :universe universe
                           :roots roots
                           :message message}
                          nil)))))

(defn rt-o-scan (n seed)
  ;; the first counterexample across `n` seeded universes, or nil if all agree
  (if (= n 0)
    nil
    (let ([universe roots next] (rt-g-universe seed)
          problem (rt-o-check universe roots))
      (if problem problem (rt-o-scan (dec n) next)))))

(describe "resolver: fuzz vs a brute-force oracle"
  (test "the solver's decision matches enumeration over 400 random universes"
    ;; a counterexample surfaces as the asserted value, so a failure prints the exact
    ;; universe + roots that disagreed rather than a bare 'false'
    (assert= nil (rt-o-scan 400 1)))
  (test "a second, disjoint seed range also agrees"
    (assert= nil (rt-o-scan 400 987654321)))
  (test "the oracle itself is wired correctly on known cases"
    ;; a sanity check on the oracle so a broken oracle can't hide a broken solver
    (is (rt-o-solvable? [['a "^1.0"]] {'a {"1.0.0" []}}))
    (refute (rt-o-solvable? [['a "^2.0"]] {'a {"1.0.0" []}}))
    (is (rt-o-solvable? [['a nil]] {'a {"1.0.0" [['b "^1.0"]]} 'b {"1.0.0" []}}))
    (refute (rt-o-solvable? [['a nil]] {'a {"1.0.0" [['b "^2.0"]]} 'b {"1.0.0" []}}))))
