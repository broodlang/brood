;; The unused-binder lints for anonymous `fn` clauses (a checker SURFACE pass, so it
;; sees clauses as written — by the time the main walk runs, a pattern clause has been
;; lowered to `match*` and its binders are synthetic `let`s the unused-`let` lint
;; deliberately exempts; removing that exemption fires 69 times across std/ + tests/).
;;
;; The bug that motivated it: `(reduce toks '() (fn ((acc "+") "+") ((acc n) n)))`
;; ignores the accumulator in every arm, so the fold never folds and the result is
;; whatever the last token produced. Silent — and the inferred type degraded to `any`
;; rather than saying so.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule unused-binding-test (:use test) (:use suite-helpers) (:use seq))

(defn- count-of (src want)
  (count (keep (checker-messages src) (fn (m) (if (= m want) m nil)))))

(defn- unused-count (src)
  (count (keep (checker-messages src) (fn (m) (if (string/starts-with? m "unused ") m nil)))))

(describe "checker: an unused PATTERN binding in an anonymous fn clause"
  (test "the accumulator no arm reads is reported, once per clause"
    (assert= (count-of "(reduce xs '() (fn ((acc \"+\") \"+\") ((acc n) n)))"
               "unused pattern binding: acc")
      2))

  (test "a binder the body reads is not reported"
    (assert= (unused-count "(reduce xs '() (fn ((acc \"+\") acc) ((acc n) (conj acc n))))") 0))

  (test "per CLAUSE: used in one arm, unused in another, reports only the other"
    (assert= (count-of "(reduce xs '() (fn ((acc \"+\") acc) ((acc n) n)))"
               "unused pattern binding: acc")
      1))

  (test "the _ convention silences it"
    (assert= (unused-count "(reduce xs '() (fn ((_acc \"+\") \"+\") ((_acc n) n)))") 0)))

(describe "checker: the unused-binder exemptions match the sibling unused-let lint"
  (test "a gensym temporary is exempt, but a user name merely CONTAINING __ is not"
    ;; the first version tested `name.contains("__")`, which is a guess: it exempts
    ;; gensyms and silently swallows `my__thing` too. The interner knows the difference.
    (assert= (count-of "(map xs (fn ((my__thing) :a) ((my__thing y) y)))"
               "unused parameter: my__thing")
      2))

  (test "a binder shadowing a builtin is exempt, as it is in a let"
    ;; you do not accidentally name a binder after a builtin, so an unused shadow is a
    ;; deliberate scope-isolation test — and `_`-prefixing cannot express it, because
    ;; that changes the very name being shadowed
    (assert= (unused-count "(map xs (fn ((list) :a) ((list y) y)))") 0))

  (test "the wording follows the LOWERING, which is per fn and not per clause"
    ;; one pattern head anywhere sends the whole dispatch through `match*`, so every
    ;; clause's binders are pattern binders — including the all-symbol head. Deciding
    ;; per clause called that one a "parameter", describing a construct the program
    ;; does not have.
    (let (src "(map xs (fn ((a) :plain) ((b \"lit\") :pat)))")
      (assert= (count-of src "unused pattern binding: a") 1)
      (assert= (count-of src "unused pattern binding: b") 1))))

(describe "checker: an unused binder at every other binding form"
  (test "each binding form reports the binder nothing reads"
    ;; before, only a plain symbol in `let`/`letrec` was ever reported: a destructured
    ;; `let` and every macro binding form lower to synthetic lets the main lint exempts
    (assert= (count-of "(let ([p q] v) p)" "unused let binding: q") 1)
    (assert= (count-of "(match v ([p q] p) (_ 0))" "unused pattern binding: q") 1)
    (assert= (count-of "(receive ([:x p q] p) (after 10 :t))" "unused pattern binding: q") 1)
    (assert= (count-of "(try (v) (catch e 1))" "unused catch binding: e") 1)
    (assert= (count-of "(dotimes (i 3) (f))" "unused loop binding: i") 1)
    (assert= (count-of "(for (x xs) 1)" "unused loop binding: x") 1)
    (assert= (count-of "(fold-for (acc 0 x xs) x)" "unused loop binding: acc") 1)
    (assert= (count-of "(when-let (x v) 1)" "unused let binding: x") 1)
    (assert= (count-of "(with (x v y 2) y)" "unused let binding: x") 1))

  (test "a plain let symbol is reported once, by the main lint"
    (assert= (count-of "(defn f (v) (let (x 1) v))" "unused let binding: x") 1)
    ;; one destructured pattern lowers the whole list, so the plain name is the surface
    ;; pass's to report, and it was reported by neither
    (assert= (count-of "(defn f (v) (let ([p _q] v spare 1) p))" "unused let binding: spare") 1))

  (test "the pattern grammar's non-binders and self-reads are silent"
    ;; a pin compares, a quote is a literal, `or` alternatives bind the same names, a
    ;; repeat is an equality test, a bytes size reads an earlier segment, `:or` holds
    ;; defaults, `record` names a type, and a :when guard reads its clause's binders
    (each
      [(str "(match v ([:down ^r reason] reason) ('none 0) ((or [1 a] [2 a]) a) "
         "([x x] 1) ((record point {:x px}) px) ({:keys [a b] :or {a 0}} (+ a b)) "
         "(n :when (> n 0) :pos) (_ 2))")
        "(match f ((bytes (len :u16) (payload len) & rest) [payload rest]))"
        ;; an &optional slot's default is an expression: `do` here is no binder
        "(match xs ((_a &optional (b (do (io/write \"d\") 0))) b))"
        "(for (x v :when (> x 1) y [1 2]) [x y])" "(letrec ([a b] [1 2]) [a b])"
        "(try (v) (catch {:kind :type} 1) (catch _e 2))"]
      (fn (src) (assert= (unused-count src) 0)))))

(describe "checker: an unused PARAMETER in an anonymous fn arity clause"
  (test "an arity clause that never reads its parameter is reported"
    (assert= (count-of "(map xs (fn ((x) 1) ((x y) y)))" "unused parameter: x") 2))

  (test "the single-arm spelling is the same function and gets the same answer"
    ;; `(fn (acc x) acc)` was never linted while `(fn ((acc x) acc))` was
    (assert= (count-of "(reduce xs (fn (acc x) acc))" "unused parameter: x") 1)
    (assert= (count-of "(reduce xs (fn ((acc x) acc)))" "unused parameter: x") 1)
    (assert= (unused-count "(reduce xs (fn (acc _x) acc))") 0)
    (assert= (count-of "(map xs (fn ([k v]) k))" "unused pattern binding: v") 1))

  (test "a typed parameter binds its NAME, and the result type is not a binder"
    ;; read as written, `position:int` was a binder no body could ever read
    (assert= (unused-count "(map xs (fn (p:int) (+ p 1)))") 0)
    (assert= (unused-count "(map xs (fn (p: int -> int) (+ p 1)))") 0)
    (assert= (count-of "(map xs (fn (p:int k:int) p))" "unused parameter: k") 1))

  (test "a fn inside a map or set literal is linted like one in a vector"
    ;; the walk skipped `{…}` and `#{…}`, so callback specs were never checked
    (assert= (count-of "(f {:on-complete (fn (mm text) mm)})" "unused parameter: text") 1)
    (assert= (count-of "(f #{(fn (mm text) mm)})" "unused parameter: text") 1))

  (test "a parameter read by a later parameter's default is used"
    (assert= (unused-count "(map xs (fn (a &optional (b (fn () a))) (b)))") 0))

  (test "a parameter used only in a :when guard is NOT unused"
    ;; the guard is part of the clause — `n` is read by `(< n 0)`
    (assert= (unused-count "(map xs (fn ((n) :when (< n 0) :neg) ((n) :when (> n 0) :pos)))") 0))

  (test "a definition's own parameters are its published arglist and are never reported"
    ;; introspection, LSP hover and `doc` all show them; an unused one is often the
    ;; contract (an ability impl, a dispatch arm). Only genuinely anonymous fns are linted.
    (assert= (unused-count "(defn f ((a) :one) ((a b) :two))") 0)
    (assert= (unused-count "(def f (fn ((a) :one) ((a b) :two)))") 0))

  (test "the CLI and the editor agree — the same source, both checker entry points"
    ;; `nest check FILE` walks un-expanded forms (a `defn` is still a `defn`);
    ;; `check-string-structured` walks expanded ones (`defn` is already `(def f (fn …))`).
    ;; Deciding by which tree we were handed warned in the editor and not on the command
    ;; line for identical source, so the exemption is structural instead.
    (assert= (unused-count "(defn f ((a) :one) ((a b) :two))") 0)))

;; ---- a special form used as a value ------------------------------------------------
;; Not an unused-binder lint, but it lives here because it is the same family: a checker
;; diagnostic about a name in a position it cannot occupy. `is_unbound` deliberately
;; exempts a syntactic keyword — `fn` is not a global and never will be — which left the
;; commonest paren slip in the language silent, reporting a symptom two levels down.

(describe "checker: a special form's name in a VALUE position"
  (test "names the form that lost its parentheses, not a symptom two levels down"
    ;; `(reduce '() fn (acc token) acc)` used to report only `unbound symbol: acc`, twice
    (let (msgs (checker-messages "(defn calc (xs) (reduce xs '() fn (acc token) acc))"))
      (is (any? msgs (fn (m) (string/starts-with? m "fn is a special form, not a value"))))))

  (test "a LOCAL of that name is an ordinary variable, not a slip"
    ;; several keyword names are ordinary words — `std/editor/keymap.blsp` and
    ;; `std/prelude/control.blsp` both bind a local called `binding`, and reading it is fine
    (assert= (count-of "(defn f (binding) (str binding))" "binding is a special form, not a value")
      0))

  (test "and a called special form is untouched"
    (assert= (count (or (reflect/check-string-structured "(defn g (xs) (map xs (fn (x) x)))") []))
      0)))

(describe "checker: `:when` written inside the head list"
  (test "names the misplacement, not the match error it causes"
    ;; `((acc num :when (string? num)) body)` becomes a FOUR-parameter head, so the clause
    ;; stops matching and every call dies with a `:match` error naming the clauses
    ;; rather than the slip. Nothing said anything until this.
    (let (msgs (checker-messages "(defn f (xs) (reduce xs '() (fn ((acc num :when (string? num)) acc))))"))
      (is (any? msgs (fn (m) (string/starts-with? m "`:when` belongs after the head list"))))))

  (test "and the correct spelling is silent"
    (assert= (count (or (reflect/check-string-structured "(defn f (xs) (reduce xs '() (fn ((acc num) :when (string? num) acc))))")
                      []))
      0)))

(describe "checker: a callback's parameters are typed from what the combinator hands over"
  (test "an element-consuming combinator seeds a single-clause callback"
    ;; `(map ["s"] (fn (p) (+ p 1)))` was silent: `p` bound `any`, and `any` is consistent
    ;; with `number`. Only `fold`/`reduce` had a callback seed.
    (assert= (count-of "(defn f () (map [\"s\"] (fn (p) (+ p 1))))"
               "+: argument 1 expects number, got \"s\" (p)")
      1))

  (test "and a CLAUSE-form callback too"
    ;; `lambda_literal_arity` bails on the clause form, so a callback written to match on
    ;; its element got no seed at all — the shape people reach for first
    (assert= (count-of "(defn f () (map [\"s\"] (fn ((p) (+ p 1)))))"
               "+: argument 1 expects number, got \"s\" (p)")
      1))

  (test "a correct callback stays silent"
    (assert= (count (or (reflect/check-string-structured "(defn f () (map [1 2] (fn (p) (+ p 1))))")
                      []))
      0)))

(describe "checker: a bare symbol evaluated for effect"
  (test "reports the `f(x)` shape, which is two forms and not a call"
    (let (msgs (checker-messages "(defn a (n) (do string?(n) 1))"))
      (is (any? msgs (fn (m) (includes? m "is how `string?(x)` reads to the reader"))))))

  (test "a QUALIFIED name read for effect is the auto-load idiom, not dead code"
    ;; `mod/name` auto-loads its module (ADR-227) — `introspection_test` opens with
    ;; `(do rand/int term/raw-enter … nil)` for exactly that reason, so reading a name is
    ;; NOT always effect-free
    (assert= (count (or (reflect/check-string-structured "(defn a () (do rand/int 1))") []))
      0)))
