;; std/ansi — `strip`, the escape-sequence stripper for subprocess pipe output.
;; (Distinct from `editor/ansi`, which BUILDS escape strings and is covered by
;; `ansi_test.blsp`.) This module had no tests at all, which was noticed while fixing
;; its scan: it read one char with `char-at` (O(i) on UTF-8) and called `string-length`
;; (`chars().count()`, O(n)) per character, so stripping was O(n²) twice over — 7.6×
;; then 14.0× per 4× of input, and 1.58 s for ~90 KB of colourised output. It now walks
;; a code-point vector with a threaded length, like `url.blsp` / `csv.blsp`.
;;
;; The rewrite changed how every character is indexed, so these pin behaviour rather
;; than speed — and UTF-8 deliberately, since that is exactly what a byte/char mix-up
;; would break.

(defmodule ansi-strip-test (:use test) (:use ansi))

(describe "strip: what it removes"
  (test "plain text is returned unchanged"
    (assert= "hello world" (strip "hello world")))
  (test "an SGR colour sequence is removed, its text kept"
    (assert= "ok" (strip (str "\e" "[32mok" "\e" "[0m"))))
  (test "cursor sequences are removed"
    (assert= "ab" (strip (str "a" "\e" "[2Jb")))
    (assert= "ab" (strip (str "a" "\e" "[1;5Hb"))))
  (test "bare carriage returns are dropped"
    (assert= "abc" (strip "a\rbc"))
    ;; the no-ESC fast path handles this one — same answer, different code path
    (assert= "line" (strip "line\r")))
  (test "several sequences in one string"
    (assert= "redgreen"
      (strip (str "\e" "[31mred" "\e" "[0m" "\e" "[32mgreen" "\e" "[0m"))))
  (test "a sequence at the very start and at the very end"
    (assert= "x" (strip (str "\e" "[1mx")))
    (assert= "x" (strip (str "x" "\e" "[0m"))))

  ;; Boundary handling: the scan must terminate rather than run past the end.
  (test "an unterminated CSI at the end consumes the rest"
    (assert= "a" (strip (str "a" "\e" "[32"))))
  (test "an ESC at the very end does not run off the end"
    (assert= "a" (strip (str "a" "\e"))))
  (test "an ESC not followed by [ drops the ESC and the next char"
    (assert= "ac" (strip (str "a" "\e" "bc"))))
  (test "empty and escape-only inputs"
    (assert= "" (strip ""))
    (assert= "" (strip (str "\e" "[0m")))
    (assert= "" (strip "\r\r\r"))))

(describe "strip: UTF-8 is indexed by code point, not byte"
  ;; The scan walks a code-point vector; a byte index leaking in would split or drop
  ;; multi-byte characters. Accents are 2 bytes, emoji 4.
  (test "accented text survives untouched"
    (assert= "héllo wörld" (strip "héllo wörld")))
  (test "accented text around a stripped sequence"
    (assert= "héllo" (strip (str "\e" "[32mhéllo" "\e" "[0m"))))
  (test "emoji survive, including after a sequence"
    (assert= "a😀b" (strip (str "a" "\e" "[1m😀b" "\e" "[0m")))
    (assert= "😀😀" (strip (str "😀" "\e" "[0m😀"))))
  (test "a CR between multi-byte characters is dropped cleanly"
    (assert= "é😀" (strip "é\r😀"))))

(describe "strip: at scale"
  ;; 2000 colourised lines. The old implementation produced the right answer here too,
  ;; just quadratically — this guards the rewrite's index arithmetic, where an
  ;; off-by-one would silently eat or duplicate characters far into the input.
  (test "many lines strip to exactly the plain text"
    (let (line (str "\e" "[32mok" "\e" "[0m  a test name\r\n")
          want (apply str (repeat 2000 "ok  a test name\n"))
          got (strip (apply str (repeat 2000 line))))
      (assert= (string/length want) (string/length got))
      (assert= want got))))

;; ---- ansi/render: the escapes as LAYOUT, not as noise ------------------------
;; `strip` deletes the escapes, which is right for a build log and wrong for a
;; pseudo-terminal, where they are how the program draws. The case that motivated
;; `render` is an interactive line editor: `iex` echoes what you typed, then moves up
;; a line, erases, and prints the line again with its prompt. Stripped, both copies
;; survive and the buffer shows the input twice.

(defn- esc (s) (str (string/int->char 27) s))

(describe "ansi/render — a line editor's redraw"
  ;; Captured from a real `iex` under a pty: echo, ESC[A ESC[J, reprint, result, prompt.
  (test "the redraw replaces the echo instead of doubling it"
    (assert= (ansi/render ""
               (str "1 + 41\r\n"
                 (esc "[A")
                 (esc "[J")
                 "iex(1)> 1 + 41\r\n"
                 (esc "[33m")
                 "42"
                 (esc "[0m")
                 "\r\niex(2)> "))
      "iex(1)> 1 + 41\n42\niex(2)> "))

  (test "which is exactly what strip cannot do"
    ;; the same input through `strip` keeps both copies — not a defect in `strip`,
    ;; but the reason `render` exists beside it
    (is (includes? (ansi/strip (str "1 + 41\r\n" (esc "[A") (esc "[J") "iex(1)> 1 + 41\r\n"))
          "1 + 41\niex(1)> 1 + 41"))))

(describe "ansi/render — the vocabulary it models"
  (test "carriage return overwrites from the start of the line"
    (assert= (ansi/render "abc" "\rX") "Xbc")
    (assert= (ansi/render "abc" "\rXYZ!") "XYZ!"))
  (test "newline starts a line, and ordinary text appends"
    (assert= (ansi/render "a" "\nb") "a\nb")
    (assert= (ansi/render "plain" " more") "plain more"))
  (test "cursor left/right move without writing"
    (assert= (ansi/render "hello" (esc "[2D")) "hello")
    (assert= (ansi/render "hello" (str (esc "[2D") "X")) "helXo"))
  (test "erase to end of line truncates there"
    (assert= (ansi/render "hello world" (str (esc "[6D") (esc "[K"))) "hello")
    (assert= (ansi/render "hello world" (str (esc "[6D") (esc "[K") "there")) "hellothere"))
  (test "erase to end of display drops the lines below too"
    ;; the cursor sits at column 5 (the length of "three"), past the end of "one" —
    ;; erasing from there must not pad the short line out to meet it
    (assert= (ansi/render "one\ntwo\nthree" (str (esc "[2A") (esc "[J"))) "one")
    (assert= (ansi/render "one\ntwo" (str (esc "[A") (esc "[J") "ONE")) "oneONE"))
  (test "column and next/previous line"
    (assert= (ansi/render "hello" (str (esc "[1G") "J")) "Jello")
    ;; `[K` erases the LINE, not what is below it — the line under the cursor stays
    (assert= (ansi/render "one\ntwo" (str (esc "[F") (esc "[K") "X")) "X\ntwo"))
  ;; colour is the sequence it sees most, and the one it must ignore rather than model
  (test "colour and unmodelled sequences are dropped, not written"
    (assert= (ansi/render "" (str (esc "[33m") "42" (esc "[0m"))) "42")
    (assert= (ansi/render "" (str (esc "[?25l") "x" (esc "[?25h"))) "x")))

(describe "ansi/render — the boundaries it does not pretend to cover"
  ;; Stated as tests so the limits are a decision rather than a surprise. A program
  ;; that positions absolutely or draws full-screen needs a real emulator.
  (test "absolute positioning is ignored rather than approximated"
    (assert= (ansi/render "abc" (str (esc "[1;1H") "X")) "abcX"))
  (test "text with no escapes at all takes the append path unchanged"
    (assert= (ansi/render "abc" "def") "abcdef")
    (assert= (ansi/render "" "") ""))
  (test "a lone ESC that opens nothing takes its byte with it"
    (assert= (ansi/render "a" (str (string/int->char 27) "7b")) "ab")))
