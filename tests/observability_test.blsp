;; Observability timing tier (ROADMAP survey gap #4, slice 1): GC pause
;; durations on `gc-stats`, scheduler counters on `sched-stats`, and the
;; sampling CPU profiler (`profile-start` / `profile-stop`).
;;
;; Assertions are structural (keys exist, counters are monotonic and
;; consistent) rather than timing-exact, so loaded CI can't flake them. The
;; profiler test is :isolated — it arms a process-global singleton.

(defmodule observability-test (:use test))

(defn obs-churn (n acc) (if (= n 0) acc (obs-churn (- n 1) (cons n acc))))

(describe "gc-stats pause durations"
  (test "pause keys exist and are consistent after forced churn"
    (obs-churn 200000 ())
    (let (s (dev/gc-stats))
      (is (> (get s :collections) 0))
      (is (> (get s :pause-total-us) 0))
      (is (>= (get s :pause-total-us) (get s :pause-max-us)))
      (is (>= (get s :pause-max-us) (get s :pause-last-us)))
      (is (>= (get s :pause-last-us) 0)))))

(describe "sched-stats"
  (test "counters exist, move with activity, and stay consistent"
    (let (me (self))
      (doseq (_ (range 8)) (spawn (send me :done)))
      (doseq (_ (range 8)) (receive (:done nil))))
    (let (s (dev/sched-stats))
      (is (> (get s :spawned) 0))
      (is (> (get s :exited) 0))
      (is (>= (get s :spawned) (get s :exited)))
      (is (>= (get s :preempts) 0))
      (is (>= (get s :steals) 0))
      (is (>= (get s :migrations) 0))
      (is (> (get s :workers) 0))
      (is (>= (get s :peak-threads) 1)))))

(describe "sampling profiler"
  :isolated (test "catches a hot named fn; stop is idempotent"
    (dev/profile-start 999)
    (obs-churn 800000 ())
    (obs-churn 800000 ())
    (let (prof (dev/profile-stop))
      ;; samples come from the VM driver's frame boundaries — the legacy
      ;; tree-walker is by design not sampled, so the content assertions only apply on
      ;; the default engine. Ask the runtime, not the environment.
      (when (not (%tree-walker?))
        (is (> (count prof) 0))
        ;; every entry is {:stack (...) :count n}
        (let (e (first prof))
          (is (list? (get e :stack)))
          (is (> (get e :count) 0)))
        ;; the hot fn shows up somewhere in the histogram (module-qualified)
        (is (includes? (mapcat prof (fn (e) (get e :stack))) "observability-test/obs-churn"))))
    ;; a second stop with nothing armed is an empty histogram, not an error
    (assert= 0 (count (dev/profile-stop)))
    ;; restart works after a stop
    (dev/profile-start 500)
    (obs-churn 400000 ())
    (is (>= (count (dev/profile-stop)) 0))))

(defn obs-other-churn (n acc) (if (= n 0) acc (obs-other-churn (- n 1) (cons n acc))))

(describe "sampling one process"
  ;; Every process that runs takes a sample per tick, so a busy program's profile is the
  ;; sum of all of them; `(profile-start hz pid)` keeps only the process you asked about.
  :isolated (test "a pid-scoped profile holds that process's frames and no other's"
    (let (me (self)
          _ (spawn (fn () (obs-other-churn 3000000 ()) (send me :other-done)))
          _ (dev/profile-start 999 me))
      (obs-churn 800000 ())
      (obs-churn 800000 ())
      (receive (:other-done nil) (after 60000 nil))
      (let (frames (mapcat (dev/profile-stop) (fn (e) (get e :stack))))
        (when (not (%tree-walker?))
          (is (includes? frames "observability-test/obs-churn"))
          (is (not (includes? frames "observability-test/obs-other-churn"))))))))
