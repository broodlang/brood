;; File & filesystem library (std/file.blsp). Fixtures live under a unique
;; /tmp directory per test, so cases don't collide.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule file-test (:use test) (:use file) (:use seq))

;; Drop any fixtures a prior run left in /tmp (at load, before any test runs).
(purge-stale-temp "brood-file-")
(purge-stale-temp "brood-file-swap-")

;; A fresh, created /tmp dir per call. `temp-dir` names it with `rand/token`
;; (unique across processes *and* runs) — a bare gensym name recurs across runs,
;; and a killed run's leftovers then poison the next (list-files sees extras,
;; spit-append appends to stale content). See std/test.blsp.
(defn ftmp ()
  (let (d (temp-dir "brood-file-"))
    (file/mkdir d)
    d))

; all distinct — none clobbered
(describe "file: whole-file read/write/append"
  (test "spit then slurp round-trips"
    (let (p (path/join (ftmp) "a.txt"))
      (file/spit p "hello")
      (assert= (file/slurp p) "hello")))
  (test "spit-append adds to existing content (and creates if absent)"
    (let (p (path/join (ftmp) "b.txt"))
      (file/spit-append p "one")
      (file/spit-append p "two")
      (assert= (file/slurp p) "onetwo")))
  (test "spit-append is the atomic primitive spit-append aliases"
    (let (p (path/join (ftmp) "c.txt"))
      ; creates when absent
      (file/spit-append p "x")
      (file/spit-append p "y")
      (assert= (file/slurp p) "xy")))
  (test "concurrent appends from many processes all land (atomic O_APPEND)"
    ;; The point of the atomic primitive over a read-modify-write: N processes each
    ;; appending a distinct line never lose or clobber a write. 40 workers each
    ;; append one line; the file must end up with exactly 40 distinct lines.
    (let (p (path/join (ftmp) "log.txt")
          me (self)
          n 40)
      (doseq (i (range n))
        (spawn (fn () (file/spit-append p (str "worker-" i "\n")) (send me :done))))
      ; barrier: all workers finished
      (fa-await n)
      (let (lines (seq/filter (string/split (file/slurp p) "\n") (fn (l) (not (empty? l)))))
        ; none lost
        (assert= (count lines) n)
        (assert= (count (frequencies lines)) n)))))
;; Collect `n` :done messages (order-independent) — a simple fan-in barrier.
(defn fa-await (n) (when (> n 0) (receive (:done (fa-await (dec n))))))

;; Read `p` `n` times; every read must be one of `whole` (a set of complete contents).
(defn- fa-read-whole (p whole n torn)
  (if (= n 0)
    torn
    (let (seen (file/slurp p))
      (fa-read-whole p whole (dec n) (if (contains? whole seen) torn (inc torn))))))

(describe "file: replace"
  (test "keeps the mode and leaves nothing beside the file"
    (let (dir (ftmp) p (path/join dir "run.sh"))
      (file/spit p "old")
      (os/cmd "chmod" ["751" p])
      (file/replace p "new")
      (assert= (file/slurp p) "new")
      (assert= (math/mod (:mode (file/stat p)) 512) 489)
      (assert= (into [] (file/ls dir)) ["run.sh"])))
  (test "takes bytes as well as text"
    (let (p (path/join (ftmp) "data.bin"))
      (file/replace p [0 200 255])
      (assert= (vec (file/slurp-bytes p)) [0 200 255]))))

(describe "file: spit-atomic"
  (test "writes the whole text and leaves no temp file behind"
    (let (d (ftmp)
          p (path/join d "state.edn"))
      (file/spit-atomic p "one")
      (file/spit-atomic p "two")
      (assert= (file/slurp p) "two")
      (assert= (vec (file/ls d)) ["state.edn"])))
  ;; The property it exists for. Writers rewrite the file with large distinct contents while a
  ;; reader reads it in a loop: a plain `file/spit` truncates first, so the reader sees an empty
  ;; or a partial file; every read here must be one of the complete texts.
  (test "concurrent writers and a reader: every read is one whole text"
    (let (p (path/join (ftmp) "shared.txt")
          me (self)
          texts (map (range 4) (fn (i) (string/repeat (->string i) 200000)))
          whole (into #{} texts))
      (file/spit-atomic p (first texts))
      (doseq (t texts)
        (spawn (fn () (doseq (_ (range 25)) (file/spit-atomic p t)) (send me :done))))
      (let (torn (fa-read-whole p whole 200 0))
        (fa-await 4)
        (assert= torn 0)
        (is (empty? (seq/filter (file/ls (path/dirname p)) (fn (f) (string/ends-with? f ".tmp")))))))))

(describe "file: size / delete / rename"
  (test "file-size reports byte length, nil when missing"
    (let (p (path/join (ftmp) "s.txt"))
      (file/spit p "12345")
      (assert= (file/size p) 5)
      (assert= (file/size (path/join (ftmp) "nope.txt")) nil)))
  ; missing → nil
  (test "file-stat reports size/dir?/symlink? in one map, nil when missing"
    (let (d (ftmp)
          f (path/join d "stat.txt")
          _ (file/spit f "12345")
          sf (file/stat f)
          sd (file/stat d))
      (assert= (get sf :size) 5)
      (refute (get sf :dir?))
      (refute (get sf :symlink?))
      ; the dir itself
      (is (get sd :dir?))
      ; epoch-ms last-modified
      (is (number? (get sf :mtime)))
      ; epoch-ms last-access
      (is (number? (get sf :atime)))
      ; hard-link count
      (is (>= (get sf :nlink) 1))
      (is (number? (get sf :uid)))
      ; resolved name (or numeric id)
      (is (string? (get sf :owner)))
      (is (string? (get sf :group)))
      (assert= (file/stat (path/join d "nope.txt")) nil)))
  ; no-op when already gone
  (test "delete-file removes a file and is idempotent"
    (let (p (path/join (ftmp) "d.txt"))
      (file/spit p "x")
      (is (regular? p))
      (file/rm p)
      (refute (file/exists? p))
      (assert= (file/rm p) nil)))
  (test "rename-file moves content to a new path"
    (let (d (ftmp) a (path/join d "a.txt") b (path/join d "b.txt"))
      (file/spit a "moved")
      (file/rename a b)
      (refute (file/exists? a))
      (assert= (file/slurp b) "moved")))
  (test "copy-file duplicates content, leaving the original"
    (let (d (ftmp) a (path/join d "src.txt") b (path/join d "dst.txt"))
      (file/spit a "copied")
      (file/cp a b)
      ; original still there
      (assert= (file/slurp a) "copied")
      (assert= (file/slurp b) "copied"))))

(describe "file: line I/O"
  (test "write-lines / read-lines round-trip without a trailing blank line"
    (let (p (path/join (ftmp) "c.txt"))
      (write-lines p ["alpha" "beta" "gamma"])
      (assert= (read-lines p) (list "alpha" "beta" "gamma"))))
  (test "read-lines of an empty file is nil"
    (let (p (path/join (ftmp) "empty.txt"))
      (file/spit p "")
      (assert= (read-lines p) nil)))
  ;; write-lines built its output with `(fold (fn (acc l) (str acc l "\n")) "" lines)`,
  ;; recopying the whole accumulator per line — O(total²). 16 000 lines took 1888 ms;
  ;; one `join` pass makes it 1 ms. These pin the edge cases the rewrite has to keep
  ;; identical (the empty case especially: an unguarded trailing newline would write a
  ;; one-byte file where the fold wrote an empty one).
  (test "write-lines terminates every line, including a single one"
    (let (p (path/join (ftmp) "one.txt"))
      (write-lines p ["solo"])
      (assert= (file/slurp p) "solo\n")))
  (test "write-lines of nothing writes an empty file, not a newline"
    (let (p (path/join (ftmp) "none.txt"))
      (write-lines p ())
      (assert= (file/slurp p) "")
      (assert= (read-lines p) nil)))
  (test "write-lines accepts any seqable, not just a list"
    (let (p (path/join (ftmp) "seq.txt"))
      (write-lines p ["a" "b"])
      (assert= (file/slurp p) "a\nb\n")
      (write-lines p (list "c" "d"))
      (assert= (file/slurp p) "c\nd\n")))
  ;; The shape guard: 8x the lines must not cost ~64x the time. Generous bound —
  ;; this is a regression tripwire, not a benchmark (see handoff §5 on noise).
  (test "write-lines is linear in the number of lines"
    (let (p (path/join (ftmp) "scale.txt")
          mk (fn (n) (map (range n) (fn (i) (str "line " i " with a little payload"))))
          ms (fn (n)
               (let (ls (mk n) t0 (os/now-ns))
                 (do (write-lines p ls) (math/quot (- (os/now-ns) t0) 1000000))))
          small (ms 2000)
          big (ms 16000))
      ;; quadratic would be ~64x small (measured 37 -> 1888 before the fix)
      (is (< big (+ 200 (* 12 small)))))))

(describe "file: predicates"
  (test "file? is true for a regular file, false for a directory"
    (let (d (ftmp) p (path/join d "f.txt"))
      (file/spit p "x")
      (is (regular? p))
      (refute (regular? d))
      (is (file/dir? d))))
  (test "file-exists? covers files and directories"
    (let (d (ftmp) p (path/join d "f.txt"))
      (file/spit p "x")
      (is (file/exists? p))
      (is (file/exists? d))
      (refute (file/exists? (path/join d "nope.txt"))))))

(describe "file: directory listing"
  (test "list-files and list-dirs separate files from subdirectories"
    (let (d (ftmp))
      (file/spit (path/join d "f1.txt") "a")
      (file/spit (path/join d "f2.txt") "b")
      (file/mkdir (path/join d "sub"))
      (assert= (sort (list-files d)) (list "f1.txt" "f2.txt"))
      (assert= (list-dirs d) (list "sub"))))
  (test "walk-files collects files recursively as full paths"
    (let (d (ftmp))
      (file/spit (path/join d "top.txt") "a")
      (file/mkdir (path/join d "sub"))
      (file/spit (path/join (path/join d "sub") "deep.txt") "b")
      (assert= (sort (walk-files d))
        (sort (list (path/join d "top.txt") (path/join (path/join d "sub") "deep.txt"))))))
  (test "walk-files lists a symlinked directory but does not enter it, so a cycle terminates"
    (let (d (ftmp)
          sub (path/join d "sub"))
      (file/mkdir sub)
      (file/spit (path/join sub "deep.txt") "b")
      (%os-cmd "/bin/ln" ["-s" d (path/join sub "up")])
      (assert= (sort (walk-files d)) (list (path/join sub "deep.txt") (path/join sub "up"))))))

;; `extension`/`stem` are pure path-string ops and live in `path` (covered by
;; path_test); `file` no longer duplicates them (ADR-234). `path-absolute` below is
;; the prelude's always-available path helper.
(describe "file: prelude path-absolute helper"
  (test "path-absolute"
    ; already absolute → unchanged
    (assert= (path/absolute "/etc/hosts") "/etc/hosts")
    ; empty → empty
    (assert= (path/absolute "") "")
    ; relative → joined onto base
    (assert= (path/absolute "foo/bar" "/base") "/base/foo/bar")
    ; default base is (file/cwd)
    (assert= (path/absolute "rel") (path/join (file/cwd) "rel"))
    ; ~ expands against $HOME
    (assert= (path/absolute "~/x") (str (os/env "HOME") "/x"))
    (assert= (path/absolute "~") (os/env "HOME"))))

;; `%file-swap` — atomic compare-and-swap of a file's whole contents, serialised
;; across processes by an exclusive lock. The mechanism behind a safe
;; read-modify-write whose "modify" step is Brood code: `nest add` splicing an entry
;; into project.blsp used to lose an update under concurrency (both editors read the
;; original, both wrote, the second erased the first — and both reported success).
;;
;; Cross-process serialisation can't be shown from one test process; it is covered
;; end-to-end by `crates/nest/tests/manifest_race.rs`, which runs real concurrent
;; `nest add`s. What's pinned here is the CAS contract those retries depend on.
(describe "%file-swap: compare-and-swap"
  (test "creates the file when the expected content is empty"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "first"))
      (assert= (file/slurp data) "first")))
  (test "swaps when the current content matches"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "old")
      (is (%file-swap lock data "old" "new"))
      (assert= (file/slurp data) "new")))
  (test "REFUSES the swap when the content has changed, and leaves it alone"
    ;; This is the property the retry loop rests on: a stale `expected` must not
    ;; overwrite whatever landed in between.
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "changed-by-someone-else")
      (refute (%file-swap lock data "what-i-read-earlier" "mine"))
      (assert= (file/slurp data) "changed-by-someone-else")))
  (test "a second swap with the now-stale expected also fails"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "v1")
      (is (%file-swap lock data "v1" "v2"))
      (refute (%file-swap lock data "v1" "v3"))
      (assert= (file/slurp data) "v2")))
  (test "an empty new value is a legitimate swap, not a no-op"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "content")
      (is (%file-swap lock data "content" ""))
      (assert= (file/slurp data) "")))
  (test "a missing file reads as empty, so expecting content fails"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "absent"))
      (file/mkdir dir)
      (refute (%file-swap lock data "something" "new"))
      (refute (file/exists? data))))
  (test "the lock file is created on demand"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "made-on-demand.lock")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "x"))
      (is (file/exists? lock))))
  (test "no temp file is left behind"
    ;; The write goes via a temp file + rename (so a crash can't leave a truncated
    ;; manifest); nothing should survive a successful swap.
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "x"))
      (assert= (sort (seq/filter (file/ls dir) (fn (f) (includes? f ".swap.")))) nil)))
  (test "repeated swaps thread through, each seeing the last"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "a"))
      (is (%file-swap lock data "a" "ab"))
      (is (%file-swap lock data "ab" "abc"))
      (assert= (file/slurp data) "abc"))))

(describe "temp-path"
  (test "unpredictable and unique — never the same path twice"
    (let (a (path/temp "x-") b (path/temp "x-"))
      (is (string/starts-with? a "/tmp/x-"))
      (is (not (= a b)))
      ;; long enough that it cannot be guessed and pre-created as a symlink by
      ;; another user on the machine — the reason a fixed /tmp name is unsafe
      (is (>= (- (string/length a) (string/length "/tmp/x-")) 32))))

  (test "it creates nothing — the caller decides file or directory"
    (is (not (file/exists? (path/temp "unmade-"))))))

(describe "file: copy-tree and move"
  (test "copy-tree copies a whole directory, leaving the original"
    (let (dir (ftmp)
          from (path/join dir "src")
          to (path/join dir "dst"))
      (file/mkdir (path/join from "sub"))
      (file/spit (path/join from "a.txt") "a")
      (file/spit (path/join from "sub" "b.txt") "b")
      (file/copy-tree from to)
      (assert= (file/slurp (path/join to "a.txt")) "a")
      (assert= (file/slurp (path/join to "sub" "b.txt")) "b")
      (is (file/exists? (path/join from "sub" "b.txt")))))
  (test "copy-tree of a single file is a copy"
    (let (dir (ftmp) from (path/join dir "f") to (path/join dir "g"))
      (file/spit from "x")
      (file/copy-tree from to)
      (assert= (file/slurp to) "x")))
  (test "copy-tree throws on a missing source"
    (assert-error (file/copy-tree (path/join (ftmp) "nothing") (path/join (ftmp) "dst"))))
  (test "move renames a directory within one filesystem"
    (let (dir (ftmp) from (path/join dir "d") to (path/join dir "e"))
      (file/mkdir from)
      (file/spit (path/join from "a") "1")
      (file/move from to)
      (is (not (file/exists? from)))
      (assert= (file/slurp (path/join to "a")) "1")))
  (test "move crosses filesystems: copied, then the original removed"
    ;; /dev/shm is its own tmpfs mount on Linux, so a rename from /tmp into it is EXDEV
    ;; (where both are one filesystem the rename simply succeeds — the outcome is the same)
    (if (not (file/dir? "/dev/shm"))
      (is true)
      (let (dir (ftmp)
            from (path/join dir "tree")
            to (path/join "/dev/shm" (path/basename (temp-dir "brood-file-move-"))))
        (file/mkdir (path/join from "sub"))
        (file/spit (path/join from "sub" "a") "moved")
        (file/move from to)
        (let (text (file/slurp (path/join to "sub" "a")))
          (file/rmdir to)
          (assert= text "moved")
          (is (not (file/exists? from)))))))
  (test "move throws what rename throws when the source is missing"
    (assert-error (file/move (path/join (ftmp) "nothing") (path/join (ftmp) "x")))))

(describe "file: trash"
  (test "trash-info percent-encodes Path= a segment at a time"
    (assert= (file/trash-info "/tmp/a b/c%d.txt" "2026-11-08T09:15:00")
      "[Trash Info]\nPath=/tmp/a%20b/c%25d.txt\nDeletionDate=2026-11-08T09:15:00\n"))
  (test "a bound trash home is a freedesktop trash"
    (binding (file/*trash-home* "/x/Trash")
      (assert= (file/trash-location) {:kind :freedesktop :dir "/x/Trash"})))
  (test "a test run never trashes into the real home"
    ;; nest test points XDG_DATA_HOME into its scratch home
    (let (location (file/trash-location))
      (when (not (failure? location))
        (let (scratch (os/env "BROOD_TEST_SCRATCH"))
          (is (and (string? scratch) (string/starts-with? (:dir location) scratch)))))))
  (test "a file goes to files/ with its .trashinfo beside it"
    (let (dir (ftmp)
          trash (path/join dir "Trash")
          victim (path/join dir "old notes.txt"))
      (file/spit victim "keep me")
      (let (went (binding (file/*trash-home* trash) (file/trash victim))
            info (file/slurp (path/join trash "info" "old notes.txt.trashinfo")))
        (assert= went (path/join trash "files" "old notes.txt"))
        (is (not (file/exists? victim)))
        (assert= (file/slurp went) "keep me")
        (is (string/starts-with? info "[Trash Info]\nPath="))
        (is (includes? info "old%20notes.txt\n"))
        (is (regex/match? info
              "DeletionDate=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\n")))))
  (test "a clash takes a numbered name"
    (let (dir (ftmp) trash (path/join dir "Trash") victim (path/join dir "a"))
      (file/spit victim "1")
      (binding (file/*trash-home* trash) (file/trash victim))
      (file/spit victim "2")
      (let (second (binding (file/*trash-home* trash) (file/trash victim)))
        (assert= second (path/join trash "files" "a.2"))
        (assert= (file/slurp second) "2")
        (is (file/exists? (path/join trash "info" "a.2.trashinfo"))))))
  (test "a directory goes whole"
    (let (dir (ftmp) trash (path/join dir "Trash") victim (path/join dir "d"))
      (file/mkdir (path/join victim "sub"))
      (file/spit (path/join victim "sub" "f") "x")
      (let (went (binding (file/*trash-home* trash) (file/trash victim)))
        (is (not (file/exists? victim)))
        (assert= (file/slurp (path/join went "sub" "f")) "x"))))
  (test "a missing file is a failure, and nothing is written"
    (let (dir (ftmp) trash (path/join dir "Trash"))
      (let (result (binding (file/*trash-home* trash) (file/trash (path/join dir "nope"))))
        (is (failure? result))
        (is (includes? (error-message result) "no such file"))
        (is (not (file/exists? trash))))))
  (test "a refused move takes its info file back"
    ;; a trash INSIDE the directory trashed: no rename moves a directory into itself
    (let (dir (ftmp) victim (path/join dir "v") trash (path/join victim "Trash"))
      (file/mkdir victim)
      (file/spit (path/join victim "keep") "x")
      (let (result (binding (file/*trash-home* trash) (file/trash victim)))
        (is (failure? result))
        (is (file/exists? victim))
        (is (empty? (file/ls (path/join trash "info")))))))
  (test "the recycle bin is Windows' alone"
    (when (not (= (os/type) :windows))
      (assert-error (%file-recycle "/tmp/whatever")))))

(describe "file: symlinks and permission bits"
  (test "read-link answers a link's target as stored, nil for a plain file or a missing path"
    (let (d (ftmp)
          plain (path/join d "plain.txt")
          link (path/join d "link"))
      (file/spit plain "x")
      (assert= (file/symlink "plain.txt" link) nil)
      (assert= (file/read-link link) "plain.txt")
      (is (get (file/stat link) :symlink?))
      (assert= (file/slurp link) "x")
      (assert= (file/read-link plain) nil)
      (assert= (file/read-link (path/join d "missing")) nil)))
  (test "a dangling link is made and read, unresolved"
    (let (d (ftmp)
          link (path/join d "dangling"))
      (assert= (file/symlink "../nowhere/at-all" link) nil)
      (refute (file/exists? link))
      (assert= (file/read-link link) "../nowhere/at-all")
      (is (get (file/stat link) :symlink?))))
  (test "a taken name is refused with a failure, the entry left as it was"
    (let (d (ftmp)
          taken (path/join d "taken")
          dangling (path/join d "dangling"))
      (file/spit taken "keep")
      (let (refused (file/symlink "elsewhere" taken))
        (is (failure? refused))
        (is (includes? (error-message refused) "taken")))
      (assert= (file/slurp taken) "keep")
      (assert= (file/read-link taken) nil)
      ;; a dangling link still takes its name
      (file/symlink "a" dangling)
      (is (failure? (file/symlink "b" dangling)))
      (assert= (file/read-link dangling) "a")))
  (test "{:replace true} redirects a link and replaces a file, leaving no temp link behind"
    (let (d (ftmp)
          link (path/join d "link")
          plain (path/join d "plain"))
      (file/symlink "first" link)
      (assert= (file/symlink "second" link {:replace true}) nil)
      (assert= (file/read-link link) "second")
      (file/spit plain "x")
      (assert= (file/symlink "second" plain {:replace true}) nil)
      (assert= (file/read-link plain) "second")
      (assert= (file/symlink "third" (path/join d "fresh") {:replace true}) nil)
      (assert= (file/ls d) (list "fresh" "link" "plain"))))
  (test "{:replace true} refuses a real directory"
    (let (d (ftmp)
          inner (path/join d "inner"))
      (file/mkdir inner)
      (is (failure? (file/symlink "x" inner {:replace true})))
      (is (file/dir? inner))
      (assert= (file/read-link inner) nil)))
  (test "a symlink into a missing directory is a failure"
    (is (failure? (file/symlink "x" (path/join (ftmp) "no-such-dir" "link")))))
  (test "chmod sets the bits file/stat reads back"
    (let (f (path/join (ftmp) "tool"))
      (file/spit f "#!/bin/sh\n")
      (assert= (file/chmod f 0o755) nil)
      (assert= (:mode (file/stat f)) 0o755)
      (is (:exec? (file/stat f)))
      (file/chmod f 0o640)
      (assert= (:mode (file/stat f)) 0o640)
      (refute (:exec? (file/stat f)))))
  (test "chmod follows a symlink to its target"
    (let (d (ftmp)
          f (path/join d "target")
          link (path/join d "link"))
      (file/spit f "x")
      (file/chmod f 0o600)
      (file/symlink "target" link)
      (file/chmod link 0o644)
      (assert= (:mode (file/stat f)) 0o644)))
  (test "chmod of a missing path is a failure; a mode past the permission bits raises"
    (let (f (path/join (ftmp) "f"))
      (is (failure? (file/chmod f 0o644)))
      (file/spit f "x")
      (assert-error (file/chmod f 0o10000))
      (assert-error (file/chmod f -1)))))
