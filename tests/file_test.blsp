;; File & filesystem library (std/file.blsp). Fixtures live under a unique
;; /tmp directory per test, so cases don't collide.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule file-test (:use test) (:use file))

;; Drop any fixtures a prior run left in /tmp (at load, before any test runs).
(purge-stale-temp "brood-file-")

;; A fresh, created /tmp dir per call. `temp-dir` names it with `random-token`
;; (unique across processes *and* runs) — a bare gensym name recurs across runs,
;; and a killed run's leftovers then poison the next (list-files sees extras,
;; append-file appends to stale content). See std/test.blsp.
(defn ftmp ()
  (let (d (temp-dir "brood-file-"))
    (make-dir d)
    d))

; all distinct — none clobbered
(describe "file: whole-file read/write/append"
  (test "write-file then read-file round-trips"
    (let (p (path-join (ftmp) "a.txt"))
      (write-file p "hello")
      (assert= (read-file p) "hello")))
  (test "append-file adds to existing content (and creates if absent)"
    (let (p (path-join (ftmp) "b.txt"))
      (append-file p "one")
      (append-file p "two")
      (assert= (read-file p) "onetwo")))
  (test "spit-append is the atomic primitive append-file aliases"
    (let (p (path-join (ftmp) "c.txt"))
      ; creates when absent
      (spit-append p "x")
      (spit-append p "y")
      (assert= (slurp p) "xy")))
  (test "concurrent appends from many processes all land (atomic O_APPEND)"
    ;; The point of the atomic primitive over a read-modify-write: N processes each
    ;; appending a distinct line never lose or clobber a write. 40 workers each
    ;; append one line; the file must end up with exactly 40 distinct lines.
    (let (p (path-join (ftmp) "log.txt")
          me (self)
          n 40)
      (dotimes (i n)
        (spawn (fn ()
                 (spit-append p (str "worker-" i "\n"))
                 (send me :done))))
      ; barrier: all workers finished
      (fa-await n)
      (let (lines (filter (fn (l) (not (empty? l))) (string-split (slurp p) "\n")))
        ; none lost
        (assert= (count lines) n)
        (assert= (count (frequencies lines)) n)))))
;; Collect `n` :done messages (order-independent) — a simple fan-in barrier.
(defn fa-await (n) (when (> n 0) (receive (:done (fa-await (dec n))))))

(describe "file: size / delete / rename"
  (test "file-size reports byte length, nil when missing"
    (let (p (path-join (ftmp) "s.txt"))
      (write-file p "12345")
      (assert= (file-size p) 5)
      (assert= (file-size (path-join (ftmp) "nope.txt")) nil)))
  ; missing → nil
  (test "file-stat reports size/dir?/symlink? in one map, nil when missing"
    (let (d (ftmp)
          f (path-join d "stat.txt")
          _ (write-file f "12345")
          sf (file-stat f)
          sd (file-stat d))
      (assert= (get sf :size) 5)
      (refute (get sf :dir?))
      (refute (get sf :symlink?))
      ; the dir itself
      (is (get sd :dir?))
      ; epoch-ms last-modified
      (is (number? (get sf :mtime)))
      ; epoch-ms last-access
      (is (number? (get sf :atime)))
      ; hard-link count
      (is (>= (get sf :nlink) 1))
      (is (number? (get sf :uid)))
      ; resolved name (or numeric id)
      (is (string? (get sf :owner)))
      (is (string? (get sf :group)))
      (assert= (file-stat (path-join d "nope.txt")) nil)))
  ; no-op when already gone
  (test "delete-file removes a file and is idempotent"
    (let (p (path-join (ftmp) "d.txt"))
      (write-file p "x")
      (is (file? p))
      (delete-file p)
      (refute (path-exists? p))
      (assert= (delete-file p) nil)))
  (test "rename-file moves content to a new path"
    (let (d (ftmp) a (path-join d "a.txt") b (path-join d "b.txt"))
      (write-file a "moved")
      (rename-file a b)
      (refute (path-exists? a))
      (assert= (read-file b) "moved")))
  (test "copy-file duplicates content, leaving the original"
    (let (d (ftmp) a (path-join d "src.txt") b (path-join d "dst.txt"))
      (write-file a "copied")
      (copy-file a b)
      ; original still there
      (assert= (read-file a) "copied")
      (assert= (read-file b) "copied"))))

(describe "file: line I/O"
  (test "write-lines / read-lines round-trip without a trailing blank line"
    (let (p (path-join (ftmp) "c.txt"))
      (write-lines p ["alpha" "beta" "gamma"])
      (assert= (read-lines p) (list "alpha" "beta" "gamma"))))
  (test "read-lines of an empty file is nil"
    (let (p (path-join (ftmp) "empty.txt"))
      (write-file p "")
      (assert= (read-lines p) nil))))

(describe "file: predicates"
  (test "file? is true for a regular file, false for a directory"
    (let (d (ftmp) p (path-join d "f.txt"))
      (write-file p "x")
      (is (file? p))
      (refute (file? d))
      (is (dir? d))))
  (test "path-exists? covers files and directories"
    (let (d (ftmp) p (path-join d "f.txt"))
      (write-file p "x")
      (is (path-exists? p))
      (is (path-exists? d))
      (refute (path-exists? (path-join d "nope.txt"))))))

(describe "file: directory listing"
  (test "list-files and list-dirs separate files from subdirectories"
    (let (d (ftmp))
      (write-file (path-join d "f1.txt") "a")
      (write-file (path-join d "f2.txt") "b")
      (make-dir (path-join d "sub"))
      (assert= (sort (list-files d)) (list "f1.txt" "f2.txt"))
      (assert= (list-dirs d) (list "sub"))))
  (test "walk-files collects files recursively as full paths"
    (let (d (ftmp))
      (write-file (path-join d "top.txt") "a")
      (make-dir (path-join d "sub"))
      (write-file (path-join (path-join d "sub") "deep.txt") "b")
      (assert= (sort (walk-files d))
        (sort (list (path-join d "top.txt") (path-join (path-join d "sub") "deep.txt")))))))

(describe "file: path helpers"
  (test "path-extension"
    (assert= (path-extension "a/b.txt") ".txt")
    (assert= (path-extension "a/b") "")
    (assert= (path-extension ".bashrc") ""))
  (test "path-stem"
    (assert= (path-stem "a/b.txt") "b")
    (assert= (path-stem "a/b") "b"))
  (test "path-absolute"
    ; already absolute → unchanged
    (assert= (path-absolute "/etc/hosts") "/etc/hosts")
    ; empty → empty
    (assert= (path-absolute "") "")
    ; relative → joined onto base
    (assert= (path-absolute "foo/bar" "/base") "/base/foo/bar")
    ; default base is (cwd)
    (assert= (path-absolute "rel") (path-join (cwd) "rel"))
    ; ~ expands against $HOME
    (assert= (path-absolute "~/x") (str (getenv "HOME") "/x"))
    (assert= (path-absolute "~") (getenv "HOME"))))
