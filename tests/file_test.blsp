;; File & filesystem library (std/file.blsp). Fixtures live under a unique
;; /tmp directory per test, so cases don't collide.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule file-test (:use test) (:use file) (:use seq))

;; Drop any fixtures a prior run left in /tmp (at load, before any test runs).
(purge-stale-temp "brood-file-")
(purge-stale-temp "brood-file-swap-")

;; A fresh, created /tmp dir per call. `temp-dir` names it with `rand/token`
;; (unique across processes *and* runs) — a bare gensym name recurs across runs,
;; and a killed run's leftovers then poison the next (list-files sees extras,
;; spit-append appends to stale content). See std/test.blsp.
(defn ftmp ()
  (let (d (temp-dir "brood-file-"))
    (file/mkdir d)
    d))

; all distinct — none clobbered
(describe "file: whole-file read/write/append"
  (test "spit then slurp round-trips"
    (let (p (path/join (ftmp) "a.txt"))
      (file/spit p "hello")
      (assert= (file/slurp p) "hello")))
  (test "spit-append adds to existing content (and creates if absent)"
    (let (p (path/join (ftmp) "b.txt"))
      (file/spit-append p "one")
      (file/spit-append p "two")
      (assert= (file/slurp p) "onetwo")))
  (test "spit-append is the atomic primitive spit-append aliases"
    (let (p (path/join (ftmp) "c.txt"))
      ; creates when absent
      (file/spit-append p "x")
      (file/spit-append p "y")
      (assert= (file/slurp p) "xy")))
  (test "concurrent appends from many processes all land (atomic O_APPEND)"
    ;; The point of the atomic primitive over a read-modify-write: N processes each
    ;; appending a distinct line never lose or clobber a write. 40 workers each
    ;; append one line; the file must end up with exactly 40 distinct lines.
    (let (p (path/join (ftmp) "log.txt")
          me (self)
          n 40)
      (dotimes (i n)
        (spawn (fn () (file/spit-append p (str "worker-" i "\n")) (send me :done))))
      ; barrier: all workers finished
      (fa-await n)
      (let (lines (filter (fn (l) (not (empty? l))) (string/split (file/slurp p) "\n")))
        ; none lost
        (assert= (count lines) n)
        (assert= (count (frequencies lines)) n)))))
;; Collect `n` :done messages (order-independent) — a simple fan-in barrier.
(defn fa-await (n) (when (> n 0) (receive (:done (fa-await (dec n))))))

(describe "file: size / delete / rename"
  (test "file-size reports byte length, nil when missing"
    (let (p (path/join (ftmp) "s.txt"))
      (file/spit p "12345")
      (assert= (file/size p) 5)
      (assert= (file/size (path/join (ftmp) "nope.txt")) nil)))
  ; missing → nil
  (test "file-stat reports size/dir?/symlink? in one map, nil when missing"
    (let (d (ftmp)
          f (path/join d "stat.txt")
          _ (file/spit f "12345")
          sf (file/stat f)
          sd (file/stat d))
      (assert= (get sf :size) 5)
      (refute (get sf :dir?))
      (refute (get sf :symlink?))
      ; the dir itself
      (is (get sd :dir?))
      ; epoch-ms last-modified
      (is (number? (get sf :mtime)))
      ; epoch-ms last-access
      (is (number? (get sf :atime)))
      ; hard-link count
      (is (>= (get sf :nlink) 1))
      (is (number? (get sf :uid)))
      ; resolved name (or numeric id)
      (is (string? (get sf :owner)))
      (is (string? (get sf :group)))
      (assert= (file/stat (path/join d "nope.txt")) nil)))
  ; no-op when already gone
  (test "delete-file removes a file and is idempotent"
    (let (p (path/join (ftmp) "d.txt"))
      (file/spit p "x")
      (is (regular? p))
      (file/rm p)
      (refute (file/exists? p))
      (assert= (file/rm p) nil)))
  (test "rename-file moves content to a new path"
    (let (d (ftmp) a (path/join d "a.txt") b (path/join d "b.txt"))
      (file/spit a "moved")
      (file/rename a b)
      (refute (file/exists? a))
      (assert= (file/slurp b) "moved")))
  (test "copy-file duplicates content, leaving the original"
    (let (d (ftmp) a (path/join d "src.txt") b (path/join d "dst.txt"))
      (file/spit a "copied")
      (file/cp a b)
      ; original still there
      (assert= (file/slurp a) "copied")
      (assert= (file/slurp b) "copied"))))

(describe "file: line I/O"
  (test "write-lines / read-lines round-trip without a trailing blank line"
    (let (p (path/join (ftmp) "c.txt"))
      (write-lines p ["alpha" "beta" "gamma"])
      (assert= (read-lines p) (list "alpha" "beta" "gamma"))))
  (test "read-lines of an empty file is nil"
    (let (p (path/join (ftmp) "empty.txt"))
      (file/spit p "")
      (assert= (read-lines p) nil)))
  ;; write-lines built its output with `(fold (fn (acc l) (str acc l "\n")) "" lines)`,
  ;; recopying the whole accumulator per line — O(total²). 16 000 lines took 1888 ms;
  ;; one `join` pass makes it 1 ms. These pin the edge cases the rewrite has to keep
  ;; identical (the empty case especially: an unguarded trailing newline would write a
  ;; one-byte file where the fold wrote an empty one).
  (test "write-lines terminates every line, including a single one"
    (let (p (path/join (ftmp) "one.txt"))
      (write-lines p ["solo"])
      (assert= (file/slurp p) "solo\n")))
  (test "write-lines of nothing writes an empty file, not a newline"
    (let (p (path/join (ftmp) "none.txt"))
      (write-lines p ())
      (assert= (file/slurp p) "")
      (assert= (read-lines p) nil)))
  (test "write-lines accepts any seqable, not just a list"
    (let (p (path/join (ftmp) "seq.txt"))
      (write-lines p ["a" "b"])
      (assert= (file/slurp p) "a\nb\n")
      (write-lines p (list "c" "d"))
      (assert= (file/slurp p) "c\nd\n")))
  ;; The shape guard: 8x the lines must not cost ~64x the time. Generous bound —
  ;; this is a regression tripwire, not a benchmark (see handoff §5 on noise).
  (test "write-lines is linear in the number of lines"
    (let (p (path/join (ftmp) "scale.txt")
          mk (fn (n) (map (fn (i) (str "line " i " with a little payload")) (range n)))
          ms (fn (n)
               (let (ls (mk n) t0 (os/now-ns))
                 (do (write-lines p ls) (math/quot (- (os/now-ns) t0) 1000000))))
          small (ms 2000)
          big (ms 16000))
      ;; quadratic would be ~64x small (measured 37 -> 1888 before the fix)
      (is (< big (+ 200 (* 12 small)))))))

(describe "file: predicates"
  (test "file? is true for a regular file, false for a directory"
    (let (d (ftmp) p (path/join d "f.txt"))
      (file/spit p "x")
      (is (regular? p))
      (refute (regular? d))
      (is (file/dir? d))))
  (test "file-exists? covers files and directories"
    (let (d (ftmp) p (path/join d "f.txt"))
      (file/spit p "x")
      (is (file/exists? p))
      (is (file/exists? d))
      (refute (file/exists? (path/join d "nope.txt"))))))

(describe "file: directory listing"
  (test "list-files and list-dirs separate files from subdirectories"
    (let (d (ftmp))
      (file/spit (path/join d "f1.txt") "a")
      (file/spit (path/join d "f2.txt") "b")
      (file/mkdir (path/join d "sub"))
      (assert= (sort (list-files d)) (list "f1.txt" "f2.txt"))
      (assert= (list-dirs d) (list "sub"))))
  (test "walk-files collects files recursively as full paths"
    (let (d (ftmp))
      (file/spit (path/join d "top.txt") "a")
      (file/mkdir (path/join d "sub"))
      (file/spit (path/join (path/join d "sub") "deep.txt") "b")
      (assert= (sort (walk-files d))
        (sort (list (path/join d "top.txt") (path/join (path/join d "sub") "deep.txt")))))))

;; `extension`/`stem` are pure path-string ops and live in `path` (covered by
;; path_test); `file` no longer duplicates them (ADR-234). `path-absolute` below is
;; the prelude's always-available path helper.
(describe "file: prelude path-absolute helper"
  (test "path-absolute"
    ; already absolute → unchanged
    (assert= (path/absolute "/etc/hosts") "/etc/hosts")
    ; empty → empty
    (assert= (path/absolute "") "")
    ; relative → joined onto base
    (assert= (path/absolute "foo/bar" "/base") "/base/foo/bar")
    ; default base is (file/cwd)
    (assert= (path/absolute "rel") (path/join (file/cwd) "rel"))
    ; ~ expands against $HOME
    (assert= (path/absolute "~/x") (str (os/env "HOME") "/x"))
    (assert= (path/absolute "~") (os/env "HOME"))))

;; `%file-swap` — atomic compare-and-swap of a file's whole contents, serialised
;; across processes by an exclusive lock. The mechanism behind a safe
;; read-modify-write whose "modify" step is Brood code: `nest add` splicing an entry
;; into project.blsp used to lose an update under concurrency (both editors read the
;; original, both wrote, the second erased the first — and both reported success).
;;
;; Cross-process serialisation can't be shown from one test process; it is covered
;; end-to-end by `crates/nest/tests/manifest_race.rs`, which runs real concurrent
;; `nest add`s. What's pinned here is the CAS contract those retries depend on.
(describe "%file-swap: compare-and-swap"
  (test "creates the file when the expected content is empty"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "first"))
      (assert= (file/slurp data) "first")))
  (test "swaps when the current content matches"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "old")
      (is (%file-swap lock data "old" "new"))
      (assert= (file/slurp data) "new")))
  (test "REFUSES the swap when the content has changed, and leaves it alone"
    ;; This is the property the retry loop rests on: a stale `expected` must not
    ;; overwrite whatever landed in between.
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "changed-by-someone-else")
      (refute (%file-swap lock data "what-i-read-earlier" "mine"))
      (assert= (file/slurp data) "changed-by-someone-else")))
  (test "a second swap with the now-stale expected also fails"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "v1")
      (is (%file-swap lock data "v1" "v2"))
      (refute (%file-swap lock data "v1" "v3"))
      (assert= (file/slurp data) "v2")))
  (test "an empty new value is a legitimate swap, not a no-op"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (file/spit data "content")
      (is (%file-swap lock data "content" ""))
      (assert= (file/slurp data) "")))
  (test "a missing file reads as empty, so expecting content fails"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "absent"))
      (file/mkdir dir)
      (refute (%file-swap lock data "something" "new"))
      (refute (file/exists? data))))
  (test "the lock file is created on demand"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "made-on-demand.lock")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "x"))
      (is (file/exists? lock))))
  (test "no temp file is left behind"
    ;; The write goes via a temp file + rename (so a crash can't leave a truncated
    ;; manifest); nothing should survive a successful swap.
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "x"))
      (assert= (sort (filter (fn (f) (includes? f ".swap.")) (file/ls dir))) nil)))
  (test "repeated swaps thread through, each seeing the last"
    (let (dir (temp-dir "brood-file-swap-")
          lock (path/join dir "l")
          data (path/join dir "d"))
      (file/mkdir dir)
      (is (%file-swap lock data "" "a"))
      (is (%file-swap lock data "a" "ab"))
      (is (%file-swap lock data "ab" "abc"))
      (assert= (file/slurp data) "abc"))))

(describe "temp-path"
  (test "unpredictable and unique — never the same path twice"
    (let (a (path/temp "x-") b (path/temp "x-"))
      (is (string/starts-with? a "/tmp/x-"))
      (is (not (= a b)))
      ;; long enough that it cannot be guessed and pre-created as a symlink by
      ;; another user on the machine — the reason a fixed /tmp name is unsafe
      (is (>= (- (string/length a) (string/length "/tmp/x-")) 32))))

  (test "it creates nothing — the caller decides file or directory"
    (is (not (file/exists? (path/temp "unmade-"))))))
