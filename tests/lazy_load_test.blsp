;;; Lazy module loading (ADR-335): a qualified reference loads its module on FIRST USE, not
;;; when the referencing file loads.
;;;
;;; The fixtures are tiny modules written to a temp dir on `*load-path*` at file load, so
;;; nothing else in the suite can load them behind the assertions' back — the "not loaded
;;; yet" half of every case depends on that. Each fixture's top level leaves a marker file,
;;; which is how a load-time EFFECT is observed from outside.

(defmodule lazy-load-test (:use test))

(purge-stale-temp "lazyload-")
(purge-stale-temp "loadpath-")

(def- *dir* (temp-dir "lazyload-"))
(file/mkdir *dir*)
(reflect/add-load-path *dir*)

(defn- fixture (name body)
  (file/spit (path/join *dir* (str name ".blsp")) (str "(defmodule " name ")\n" body)))

;; A plain module; its load writes a marker.
(fixture "lazyprobe-a"
  (str "(file/spit \""
    (path/join *dir* "a-loaded")
    "\" \"yes\")\n"
    "(defn answer () 42)\n"))
;; The racing module appends to its marker, so a double load would leave two bytes.
(fixture "lazyprobe-race"
  (str "(file/spit-append \""
    (path/join *dir* "race-loaded")
    "\" \"x\")\n"
    "(defn answer () 42)\n"))
;; The module a hot function's COLD branch references.
(fixture "lazyprobe-jit" "(defn answer () 42)\n")
;; A module whose load throws — the error must surface at first use, not be hidden.
(fixture "lazyprobe-broken" "(error \"lazyprobe-broken: deliberately broken\")\n")

(defn- loaded? (name) (contains? *features* name))

;; ── an operand reference is deferred ──────────────────────────────────────────
;; `lazyprobe-a/answer` in VALUE position: recorded at compile, loaded at first use.

(defn- use-a () (let (f lazyprobe-a/answer) (f)))

;; ── the JIT shape ──────────────────────────────────────────────────────────────
;; A hot function whose cold branch holds the only reference to `lazyprobe-jit`. The entry
;; hoist resolves every global the arm mentions, so without the tier-up pre-load this arm
;; would deopt on every activation (interpreted for good) and never load anything.
(defn- hot-pick (n) (if (< n 0) (apply lazyprobe-jit/answer nil) (+ n 1)))
(defn- hot-drive (i n acc)
  (if (= i n) acc (hot-drive (+ i 1) n (+ acc (hot-pick i)))))

(describe "lazy module loading (ADR-335)"
  (test "a qualified operand reference loads its module on first use, not at load"
    (let (marker (path/join *dir* "a-loaded")
          out (in-child
                (str
                  ;; the marker is a shared file: the in-process checker load
                  ;; may already have written it — the child starts from a clean one
                  "(when (file/exists? \"" marker "\") (file/rm \"" marker "\"))\n"
                  "(defn use-a () (let (f lazyprobe-a/answer) (f)))\n"
                  "(io/puts (str \"before=\" (contains? *features* \"lazyprobe-a\")"
                  " \" marker-before=\" (file/exists? \"" marker "\")))\n"
                  "(io/puts (str \"v=\" (use-a)))\n"
                  "(io/puts (str \"after=\" (contains? *features* \"lazyprobe-a\")"
                  " \" marker-after=\" (file/exists? \"" marker "\")))\n")))
      (when out
        ;; Not loaded at the referencing load — `use-a` compiled, nothing loaded…
        (is (includes? out "before=false marker-before=false"))
        (assert= true (includes? out "v=42"))
        ;; …and the module's load-time effect happened at first use, and exactly then.
        (is (includes? out "after=true marker-after=true")))))

  (test "a hot function's cold branch into an unloaded module is pre-loaded at tier-up"
    (let (out (in-child
                (str "(defn hot-pick (n) (if (< n 0) (apply lazyprobe-jit/answer nil) (+ n 1)))\n"
                  "(defn hot-drive (i n acc) (if (= i n) acc (hot-drive (+ i 1) n (+ acc (hot-pick i)))))\n"
                  "(io/puts (str \"before=\" (contains? *features* \"lazyprobe-jit\")))\n"
                  ;; Well past the tiering threshold; the branch is never taken.
                  "(io/puts (str \"sum=\" (hot-drive 0 100000 0)))\n"
                  ;; The pre-load ran when the arm was elected for compilation: the module is
                  ;; loaded although nothing ever called into it — when an election can happen
                  ;; at all. Under `BROOD_NO_JIT=1` / `BROOD_TIER=1` no arm tiers, nothing
                  ;; pre-loads, and the branch below loads it on first use like any other.
                  ;; `%native-tier?` is a DEV-TOOLS primitive, and the sibling `brood` beside a
                  ;; `make release` nest is the LEAN binary — the child died `unbound symbol`
                  ;; on it (2026-09-16). Ask the question here and hand the child the answer.
                  "(io/puts (str \"native="
                  (%native-tier?)
                  " after-drive=\" (contains? *features* \"lazyprobe-jit\")))\n"
                  "(io/puts (str \"cold=\" (hot-pick -1) \" after-call=\" (contains? *features* \"lazyprobe-jit\")))\n")))
      (when out
        (is (includes? out "before=false"))
        (assert= true (includes? out "sum=5000050000"))
        (when (includes? out "native=true")
          (is (includes? out "after-drive=true")))
        (is (includes? out "cold=42 after-call=true")))))

  (test "the unbound error is unchanged for a typo, in a module that exists or not"
    (let (in-module (try (let (f lazyprobe-a/nope) f) (catch e (error-message e)))
          no-module (try (let (f nomod-xyz/thing) f) (catch e (error-message e))))
      (is (includes? in-module "unbound symbol: lazyprobe-a/nope"))
      (is (includes? no-module "unbound symbol: nomod-xyz/thing"))))

  (test "an error inside the module surfaces at first use rather than being hidden"
    (let (msg (try (let (f lazyprobe-broken/anything) f) (catch e (error-message e))))
      (is (includes? msg "deliberately broken")))))

(describe "lazy loading under concurrency"
  :isolated (test "sixteen processes racing the same first use produce ONE load"
    (is (not (loaded? "lazyprobe-race")))
    (let (me (self))
      (doseq (_ (range 16))
        (spawn (send me
                 [:race
                   (try
                     (let (f lazyprobe-race/answer) (f))
                     (catch e [:err (error-message e)]))])))
      (let (results (map (range 16)
                      (fn (_) (receive ([:race r] r) (after *test-wait-ms* :timeout)))))
        (is (every? results (fn (r) (= r 42))))
        (is (loaded? "lazyprobe-race"))
        ;; One byte: the module body evaluated exactly once.
        (assert= "x" (file/slurp (path/join *dir* "race-loaded")))))))

;; ── a qualified CALL HEAD defers too, when an image vouches for its kind ──────
;; A head must load eagerly if it might be a macro. The stdlib image records every
;; binding's kind (the v6 footer), so a head into an imaged std module whose name is not a
;; recorded macro waits for its first call; a recorded macro still loads before expansion.
;; Without an installed image there is no kind index and heads are eager, so these cases
;; only assert the deferral when this process materialised one (CI's source-path job runs
;; with `BROOD_NO_STDIMAGE=1`).

(fixture "lazyprobe-head" "(defn go () (url/percent-encode \"a b\"))\n")
(fixture "lazyprobe-mac" "(defn go () (telemetry/span [:lazy-load-test :probe] {} 7))\n")

;; The fixtures are reached through OPERAND references (`run-fixture f`), never a call head:
;; a head into a temp-dir module no image describes is eager, so `(lazyprobe-mac/go)` written
;; in a test body would load the fixture while the `describe` compiled — before the test runs.
(defn- run-fixture (f) (f))

;; Run `src` in a FRESH `brood` with this file's fixture dir on its load path and return its
;; stdout (trimmed), or nil when no binary sits beside the runner (a legitimate environment —
;; the callers assert the skip is visible). `BROOD_NO_CHECK=1`: the file runner's pre-flight
;; checker would otherwise load the fixtures before the program's first line. A non-zero exit
;; comes back as the child's stderr, so a failure names itself.
;;
;; Why a child at all: "not loaded yet" is a fact about a whole runtime, and this runtime
;; shares its globals with every other test file's units. Since ADR-339 a module load
;; survives a sibling's isolate, and since ADR-340 the checker — which two units in this very
;; file run in-process — materialises every module a LOADED module's bodies name, `use-a`
;; and `hot-pick` included. In this process the fixtures are therefore loaded by the time
;; these units run; only a fresh runtime can show the deferral.
(defn- in-child (src)
  (let (dir (path/dirname (or (os/exe-path) ""))
        exe (first (seq/filter [(path/join dir "brood") (path/join dir ".." "brood")] file/exists?)))
    (when exe
      (let (prog (path/temp "lazyload-child-"))
        (file/spit prog (str "(reflect/add-load-path \"" *dir* "\")\n" src))
        (let (r (os/cmd "env" ["BROOD_NO_CHECK=1" exe prog]))
          (if (= 0 (get r :exit))
            (os/cmd-out r)
            (str "CHILD FAILED: " (get r :stderr ""))))))))

;; The function-head case observes "not loaded yet" in a SUBPROCESS. Since ADR-339 a module
;; load is a runtime-wide fact that survives a sibling file's `%isolate`, so in the full
;; suite `url` is loaded by its own test file at some point — and a global `loaded?` here
;; cannot tell a sibling's load landing in the window from the deferral under test (it did:
;; the unit passed alone and failed beside `url_test`). A child `brood` where nothing else
;; runs can. `exe` is resolved as `stdimage_test` resolves it: beside the runner or one up.
(describe "lazy call heads (the image's kind index)"
  (test "a function head into an imaged module loads at first call, not at the referencing load"
    (let (dir (path/dirname (or (os/exe-path) ""))
          exe (first (seq/filter [(path/join dir "brood") (path/join dir ".." "brood")]
                       file/exists?))
          prog (path/temp "lazyhead-")
          _ (file/spit prog
              (string/join [(str "(reflect/add-load-path \"" *dir* "\")")
                             "(defn run-fixture (f) (f))"
                             "(let (before (contains? *features* \"url\"))"
                             "  (require-one 'lazyprobe-head)"
                             "  (let (after-ref (contains? *features* \"url\")"
                             "        v (run-fixture lazyprobe-head/go)"
                             "        after-call (contains? *features* \"url\"))"
                             "    (io/puts (str \"before=\" before \" imaged=\" (%std-image-installed)"
                             "               \" after-ref=\" after-ref \" v=\" v \" after-call=\" after-call))))"]
                "\n"))
          ;; Through `env`: `os/cmd` takes no environment, and without `BROOD_NO_CHECK` the
          ;; file runner's pre-flight checker loads `url` before the program's first line.
          result (if exe (os/cmd "env" ["BROOD_NO_CHECK=1" exe prog]) nil))
      (is (or (nil? exe) (string? exe)))
      (when result
        ;; The child's stderr IS the diagnosis when it fails; compare it, not just the code.
        (assert= "" (if (= (get result :exit) 0) "" (get result :stderr "")))
        (let (out (os/cmd-out result))
          (is (includes? out "before=false"))
          ;; The deferral itself — only an imaged child has the kind index to defer on.
          (when (includes? out "imaged=true")
            (is (includes? out "after-ref=false")))
          (is (includes? out "v=a%20b"))
          (is (includes? out "after-call=true"))))))

  (test "a MACRO head into an imaged module still loads before expansion, and expands"
    (require-one 'lazyprobe-mac)
    ;; The macro's module had to load while `lazyprobe-mac` compiled — a call form that
    ;; should have expanded and did not would be a silently different program.
    (is (loaded? "telemetry"))
    (assert= 7 (run-fixture lazyprobe-mac/go))))

;; --- ADR-335 follow-up: a load path the FILE sets up ---------------------------
;;
;; The checker walks a whole file before any of it runs, so a `*load-path*` entry
;; the program adds for itself did not exist yet when the forms that depend on it
;; were checked. A MACRO reached that way therefore read as an unknown head — and
;; an unknown head's arguments are walked as if they were evaluated code, so every
;; operand of the macro was reported as an unbound symbol.
;;
;; Found on wos, an OS written in Brood: an aarch64 assembler exposed as
;; `(aarch64/asm (movz x0, 0x0900, lsl 16) …)` behind `(reflect/add-load-path
;; "compiler")`. Nine false warnings per build on a file that assembles, boots and
;; prints.
;;
;; The fix evaluates a top-level load-path form during the check, exactly as the
;; checker already evaluates a top-level `(require …)` and for the same reason. It
;; makes the checker MORE complete, not less: the module resolves, so the macro is
;; recognised and its arguments are left alone, while every other form in the file
;; — and every genuine error in it — is still checked.
;; :isolated because checking one of these strings EVALUATES its `add-load-path`
;; — see `is_load_path_form` — which mutates the runtime-wide `*load-path*` for
;; the duration of the check. The check restores it, but another process
;; resolving a module inside that window would see the wider path, and the suite
;; runs its tests concurrently by design. Same property `(require …)` in a
;; checked file already has; this block simply does not race it.
(describe "a load path the file sets up is honoured by the checker"
  :isolated (def- *lp-dir* (temp-dir "loadpath-"))
  (file/mkdir *lp-dir*)
  (file/spit (path/join *lp-dir* "lpmacro.blsp")
    "(defmodule lpmacro)\n(defmacro shout (& forms) (count forms))\n")

  (test "a macro behind a file's own add-load-path resolves, so its arguments are syntax"
    (let (src (str "(reflect/add-load-path \""
                *lp-dir* "\")\n" "(defn go () (lpmacro/shout (movz x0 255) (wfe)))\n")
          warnings (map (reflect/check-string-structured src) (fn (w) (get w :message))))
      (is (not (any? warnings (fn (w) (includes? w "unbound symbol: movz")))))
      (is (not (any? warnings (fn (w) (includes? w "unbound symbol: wfe")))))))

  (test "and every other form in the same file is still checked"
    ;; the point of resolving rather than silencing: real errors must survive
    (let (src (str "(reflect/add-load-path \""
                *lp-dir* "\")\n" "(defn go () (lpmacro/shout (movz x0 255)))\n"
                "(defn oops () (genuinely-missing 1))\n")
          warnings (map (reflect/check-string-structured src) (fn (w) (get w :message))))
      (is (any? warnings (fn (w) (includes? w "unbound symbol: genuinely-missing"))))))

  (test "a call into a module that truly cannot be resolved is still walked into"
    ;; the recursion stays: silencing an unknown head's arguments would trade one
    ;; false positive for a blind spot, and this is the half that proves it did not
    (let (warnings (map (reflect/check-string-structured "(defn go () (nosuchmod/emit (genuinely-missing 1)))")
                     (fn (w) (get w :message))))
      (is (any? warnings (fn (w) (includes? w "unbound symbol: genuinely-missing")))))))

;; ── the absence memo does not outlive the search that failed ──────────────────
;; The miss path remembers a module it could not FIND, so `(mod/nope)` in a loop does not
;; re-run the filesystem search per iteration (measured 1.22 s -> 0.26 s for 2000 lookups
;; under the tree-walker, which is what reddened the differential CI job). ADR-335 declined a
;; permanent memo because "a module absent now may exist later" — that is exactly this case,
;; and it is the reason the memo is cleared by a load-path change.
(describe "a remembered absence is forgotten when the search path changes"
  (test "a module absent before the path grew resolves after it"
    (let (late-dir (temp-dir "lazyload-late-"))
      (file/mkdir late-dir)
      ;; Miss it FIRST, while it is genuinely unreachable — this is what records the absence.
      (is (not (bound? 'lazyprobe-late/answer)))
      (let (before (try (reflect/eval '(lazyprobe-late/answer)) (catch e (get e :kind))))
        (assert= :unbound before))
      ;; Now put it on disk and widen the path. The recorded absence must not survive.
      (file/spit (path/join late-dir "lazyprobe-late.blsp")
        "(defmodule lazyprobe-late)\n(defn answer () 7)\n")
      (reflect/add-load-path late-dir)
      (assert= 7 (reflect/eval '(lazyprobe-late/answer))))))
