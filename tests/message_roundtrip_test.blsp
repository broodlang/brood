;; Cross-process message round-trip fidelity. A value SENT to another process and
;; echoed back must `=` the original, for EVERY value shape — this exercises the
;; deep-copy serialization across per-process heaps (to_message / from_message /
;; promote / freeze), which the single-process identity tests never touch. A
;; deep-copy bug (a dropped map entry, a truncated bignum, a mangled nested vector)
;; shows up as a round-tripped value that no longer equals the original.

(defmodule message-roundtrip-test (:use test))

(defn echo (parent) (receive (v (send parent [:echoed v]))))

;; send `v` to a fresh echo worker and get it back (or :timeout). `me` is a
;; captured local — spawn evaluates the worker form in the CHILD, but local vars
;; are captured, so the worker sends back to THIS process.
(defn roundtrip (v)
  (let (me (self) w (spawn (echo me)))
    (do
      (send w v)
      (receive ([:echoed back] back) (after *test-wait-ms* :timeout)))))

(defn lcg (s) (rem (+ (* s 1103515245) 12345) 2147483648))

;; a random depth-bounded value: ints/bignums/floats/strings/keywords at the
;; leaves, lists/vectors/maps in the interior. Deliberately non-tail — the
;; recursion is bounded by `depth` (≤ 4 here), never deep.
(check-allow :non-tail-recursion
  (defn rand-val (s depth)
    (let (c (rem s 7))
      (if (or (= depth 0) (< c 3))
        (cond
          (= c 0) (- (rem s 1000000) 500000)
          (= c 1) (* (- (rem s 2000) 1000) 1000000000000)
          (= c 2) (/ (- (rem s 2000) 1000) 7.0)
          else (str "s" (rem s 100000)))
        (cond
          (= c 3) (if (= (rem s 2) 0) :kw-a :kw-b)
          (= c 4) (list (rand-val (lcg s) (- depth 1))
                    (rand-val (lcg (lcg s)) (- depth 1)))
          (= c 5) [(rand-val (lcg s) (- depth 1)) (rand-val (lcg (lcg s)) (- depth 1))]
          else {(rem s 10) (rand-val (lcg s) (- depth 1))
                :k (rand-val (lcg (lcg s)) (- depth 1))})))))

(defn check-rt (s n)
  (if (= n 0)
    true
    (let (v (rand-val s 4))
      (if (= (roundtrip v) v) (check-rt (lcg s) (- n 1)) false))))

(describe "values survive a cross-process send round-trip unchanged"
  (test "int" (assert= (roundtrip 42) 42))
  (test "bignum"
    (assert= (roundtrip 123456789012345678901234567890)
      123456789012345678901234567890))
  (test "float" (assert= (roundtrip 3.141592653589793) 3.141592653589793))
  (test "string" (assert= (roundtrip "héllo wörld ☃") "héllo wörld ☃"))
  (test "keyword" (assert= (roundtrip :some-key) :some-key))
  (test "empty coll" (assert= (roundtrip [{} [] (list)]) [{} [] (list)]))
  (test "nested list" (assert= (roundtrip (list 1 (list 2 3) 4)) (list 1 (list 2 3) 4)))
  (test "vector of maps" (assert= (roundtrip [{:a 1} {:b [2 3]}]) [{:a 1} {:b [2 3]}]))
  (test "deep nested"
    (assert= (roundtrip {:xs [1 2 {:y (list :a :b)}] :n 999999999999})
      {:xs [1 2 {:y (list :a :b)}] :n 999999999999}))
  (test "300 random nested values round-trip identically"
    (is (check-rt 20260717 300))))

;; A closure crossing a local send is handed over as a shared-code handle when it is
;; already shared (it captures no locals) and deep-copied otherwise (ADR-194). Both
;; routes must be indistinguishable to the program: same result, same late binding of
;; free globals, same behaviour after the closure is retained across a `def` reload.
(def reload-probe 10)

(defn free-thunk () (* reload-probe 2))       ; captures nothing -> already shared

(defn holder (parent)
  (receive ([:hold f] (receive ([:call from] (do (send from [:got (f)]) (holder parent)))))))

(defn hold-then-call (f)
  (let (me (self) h (spawn (holder me)))
    (do (send h [:hold f])
        (send h [:call me])
        (receive ([:got v] v) (after *test-wait-ms* :timeout)))))

(describe "closures survive a send by either route (shared handle or copy)"
  (test "a closure capturing no locals runs correctly on the receiver"
    (assert= 20 (hold-then-call free-thunk)))

  (test "an inline closure over only globals runs correctly on the receiver"
    (assert= 20 (hold-then-call (fn () (* reload-probe 2)))))

  (test "a closure capturing a local carries its captured value"
    (let (n 7)
      (assert= 21 (hold-then-call (fn () (* n 3))))))

  ;; The same computation reached both ways: the first closure names only globals, so it
  ;; travels as a shared handle; the second captures `n`, so it is deep-copied. Same answer.
  (test "the shared-handle route and the copy route agree"
    (let (n 10)
      (assert= [20 20]
        [(hold-then-call (fn () (* reload-probe 2)))
          (hold-then-call (fn () (* n 2)))])))

  ;; A local binding shadows the global lexically, so this closure captures the LOCAL
  ;; and takes the copy route — pinned here because it is the boundary the rule turns on.
  (test "a local shadowing a global is captured, not resolved as the global"
    (let (reload-probe 100)
      (assert= 200 (hold-then-call (fn () (* reload-probe 2))))))

  (test "a closure capturing a local is unaffected by the global of the same name"
    (let (reload-probe 3)
      (assert= 6 (hold-then-call (fn () (* reload-probe 2)))))))

;; The retained-handle case: the receiver holds the closure across a redefinition of the
;; global it calls. Free globals are late-bound, so it must see the NEW value — a shared
;; handle must not pin the old binding. Its own global + `:isolated`, because it rebinds
;; one and the suite runs every test concurrently in its own process.
(def reload-target 10)
(defn reload-thunk () (* reload-target 2))

(describe "a retained shared closure follows a hot-reloaded global"
  :isolated
  (test "a closure held by another process sees a global redefined after it was sent"
    (let (me (self)
          h (spawn (holder me))
          _ (send h [:hold reload-thunk])
          _ (def reload-target 50)
          _ (send h [:call me]))
      (assert= 100 (receive ([:got v] v) (after *test-wait-ms* :timeout))))))


;; ---- receive-mark (ADR-195) -------------------------------------------------
;; A `receive` whose every clause pins a ref THIS process minted may skip messages that
;; predate the ref. These pin the cases where it must NOT skip, since a wrong skip loses a
;; message rather than merely being slow.

(defn echo-ref (parent r) (send parent [:reply r :pong]))

(describe "receive-mark: a pinned-ref receive never loses an older message"
  (test "a message queued BEFORE the ref is still there afterwards"
    ;; The mark lets the pinned receive skip it; it must remain queued for the next receive.
    (let (_ (send (self) [:early 1])
          r (ref)
          _ (send (self) [:reply r :pong])
          got (receive ([:reply ^r v] v) (after *test-wait-ms* :timeout))
          leftover (receive ([:early n] n) (after *test-wait-ms* :timeout)))
      (assert= :pong got)
      (assert= 1 leftover)))

  (test "a ref minted by ANOTHER process scans from the front"
    ;; The mark is keyed on the ref WE last minted. A ref minted elsewhere must not inherit
    ;; it — here the reply tagged with the foreign ref is queued BEFORE we mint our own,
    ;; so a receive that wrongly used our mark would skip straight past it and time out.
    (let (me (self)
          _ (spawn (let (theirs (ref)) (do (send me [:handoff theirs])
                                           (send me [:reply theirs :from-elsewhere]))))
          their-ref (receive ([:handoff x] x) (after *test-wait-ms* :timeout))
          _ (ref)                       ; mint ours AFTER their reply is already queued
          got (receive ([:reply ^their-ref v] v) (after *test-wait-ms* :timeout)))
      (assert= :from-elsewhere got)))

  (test "a second ref evicts the mark; the first ref still receives"
    ;; One mark slot: minting r2 evicts r1's. A receive pinned on r1 must then scan from the
    ;; front and still find its reply.
    (let (r1 (ref)
          _ (send (self) [:reply r1 :first])
          r2 (ref)
          _ (send (self) [:reply r2 :second])
          got1 (receive ([:reply ^r1 v] v) (after *test-wait-ms* :timeout))
          got2 (receive ([:reply ^r2 v] v) (after *test-wait-ms* :timeout)))
      (assert= :first got1)
      (assert= :second got2)))

  (test "the same ref serves two receives"
    (let (r (ref)
          _ (send (self) [:reply r :a])
          _ (send (self) [:reply r :b])
          a (receive ([:reply ^r v] v) (after *test-wait-ms* :timeout))
          b (receive ([:reply ^r v] v) (after *test-wait-ms* :timeout)))
      (assert= :a a)
      (assert= :b b)))

  (test "a pinned receive with nothing to match still times out"
    (let (r (ref)
          _ (send (self) [:early 2]))
      (assert= :timeout (receive ([:reply ^r v] v) (after 50 :timeout)))
      (assert= 2 (receive ([:early n] n) (after *test-wait-ms* :timeout)))))

  (test "a real round trip through another process, with a backlog queued first"
    (let (me (self)
          _ (send me [:junk :a])
          _ (send me [:junk :b])
          r (ref)
          _ (spawn (echo-ref me r))
          got (receive ([:reply ^r v] v) (after *test-wait-ms* :timeout))
          j1 (receive ([:junk x] x) (after *test-wait-ms* :timeout))
          j2 (receive ([:junk x] x) (after *test-wait-ms* :timeout)))
      (assert= :pong got)
      (assert= :a j1)
      (assert= :b j2))))
