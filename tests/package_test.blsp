;; Package manager — Slice 1: :path deps end-to-end (std/package.blsp, ADR-037).
;; Covers the canonical tree hash, reading a dep's manifest, transitive
;; resolution + conflict detection, the lock-file round-trip, and `ensure-deps`'s
;; load-path output. Fixtures are real directories built under /tmp with a unique
;; gensym'd root per test, so the cases don't collide and need no network/git.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

;; `:use-internals project` as well as `package`: the `:enhances` tests reach
;; `project-parse-enhances`, the manifest-validation helper, the same way the rest of
;; this suite tests `package`'s cwd-free helpers directly rather than through a verb.
(defmodule package-test
  (:use-internals package)
  (:use-internals project)
  (:use test)
  (:use package)
  (:use project))

;; Drop any fixtures a prior run left in /tmp (at load, before any test runs).
(purge-stale-temp "brood-pkg-")

;; Build a throwaway project dir `<tmp>/<name>` with a manifest + one src module.
;; `deps-vec` is a literal :dependencies vector string (or nil for none).
;; The fixture root is `(temp-dir …)` (random, unique across processes and runs) —
;; see std/test.blsp for why a bare gensym path is the wrong tool here.
(defn pkg-fixture-root () (temp-dir "brood-pkg-"))

;; Turn a fixture dir into a one-commit git repo (so :git deps can be exercised
;; offline via a file:// URL — no network). Returns the file:// URL.
(defn pkg-git-init (dir)
  ;; `-b main` pins the initial branch: a bare `git init` uses the ambient
  ;; `init.defaultBranch` (often `master` on CI runners), but the deps below pin
  ;; `:ref "main"`, so without this the ref wouldn't resolve on those hosts.
  (run-process "git" (list "-C" dir "init" "-q" "-b" "main"))
  (run-process "git" (list "-C" dir "config" "user.email" "t@example.com"))
  (run-process "git" (list "-C" dir "config" "user.name" "Test"))
  ;; Disable commit/tag signing in the fixture repo: the dev's global config may
  ;; force SSH/GPG signing (e.g. via 1Password), which would fail here — an unlocked
  ;; agent isn't a test prerequisite, and these throwaway commits don't need signing.
  (run-process "git" (list "-C" dir "config" "commit.gpgsign" "false"))
  (run-process "git" (list "-C" dir "config" "tag.gpgsign" "false"))
  (run-process "git" (list "-C" dir "add" "-A"))
  (run-process "git" (list "-C" dir "commit" "-q" "-m" "init"))
  (str "file://" dir))
(defn pkg-git-tag (dir tag) (run-process "git" (list "-C" dir "tag" tag)))

;; Build a .tar.gz of fixture dir `<parent>/<wrapper>` (so the archive has the
;; single `<wrapper>/` prefix the resolver strips). Returns [file-url sha256] — a
;; file:// URL keeps :tarball resolution offline, like pkg-git-init's for :git.
(require 'hash)
(require 'net/http)
(require 'encoding)
(require 'crypto)
(require 'json)
(defn pkg-tar-init (parent wrapper)
  (let (archive (path-join parent (str wrapper ".tar.gz")))
    (run-process "tar" (list "-czf" archive "-C" parent wrapper))
    (list (str "file://" archive) (hash/sha256-bytes (slurp-bytes archive)))))

(defn pkg-write-project (root nm src-module body deps-line)
  (make-dir (path-join root "src"))
  (spit (path-join root "project.blsp")
    (str "(project :name \"" nm "\" :version \"0.1.0\"" deps-line ")\n"))
  (spit (path-join (path-join root "src") (str src-module ".blsp"))
    (str "(defmodule " src-module " \"fixture\")\n" body "\n")))

(describe "package: canonical tree hash"
  (test "is deterministic for the same content"
    (let (root (pkg-fixture-root))
      (pkg-write-project root "a" "a" "(defn f () 1)" "")
      (assert= (package-tree-hash root) (package-tree-hash root))))
  (test "changes when a file's content changes"
    (let (root (pkg-fixture-root))
      (pkg-write-project root "a" "a" "(defn f () 1)" "")
      (let (h1 (package-tree-hash root))
        (spit (path-join (path-join root "src") "a.blsp")
          "(defmodule a \"fixture\")\n(defn f () 2)\n")
        (refute (= h1 (package-tree-hash root))))))
  (test "skips _deps/ so a nested cache doesn't perturb the hash"
    (let (root (pkg-fixture-root))
      (pkg-write-project root "a" "a" "(defn f () 1)" "")
      (let (h1 (package-tree-hash root))
        (make-dir (path-join root "_deps"))
        (spit (path-join (path-join root "_deps") "junk.blsp") "(def x 1)")
        (assert= h1 (package-tree-hash root))))))

(describe "package: reading a dependency's manifest"
  (test "extracts a dep's own :dependencies"
    (let (root (pkg-fixture-root))
      (pkg-write-project root
        "a" "a" "(defn f () 1)" " :dependencies [[b :path \"../b\"]]")
      (assert= (package/package-manifest-deps (path-join root "project.blsp"))
        (list (assoc (dep-path 'b "../b") :optional false)))))
  (test "a manifest without :dependencies yields nil"
    (let (root (pkg-fixture-root))
      (pkg-write-project root "a" "a" "(defn f () 1)" "")
      (assert= (package/package-manifest-deps (path-join root "project.blsp")) nil)))
  (test "a missing manifest yields nil"
    (assert= (package/package-manifest-deps "/tmp/does-not-exist-xyz/project.blsp") nil)))

(describe "package: resolving :path deps"
  (test "a single path dep resolves to an entry with name/kind/path/sha/deps"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) (str \"hi \" w))" "")
      (pkg-write-project app-dir
        "app" "main" "(defn main () 1)" " :dependencies [[greeter :path \"../greeter\"]]")
      (let (entries (resolve-deps app-dir
                      (list (dep-path 'greeter "../greeter"))
                      nil))
        (assert= (count entries) 1)
        (let (e (first entries))
          (assert= (get e :name) 'greeter)
          (assert= (dep-kind e) :path)
          (assert= (get e :path) "../greeter")
          (is (string? (get e :sha256)))
          (assert= (get e :deps) nil)))))
  (test "transitive path deps are resolved depth-first into a flat list"
    (let (parent (pkg-fixture-root)
          a (path-join parent "a")
          b (path-join parent "b")
          app (path-join parent "app"))
      (pkg-write-project b "b" "b" "(defn bf () 1)" "")
      (pkg-write-project a "a" "a" "(defn af () 1)" " :dependencies [[b :path \"../b\"]]")
      (pkg-write-project app "app" "main" "(defn main () 1)" " :dependencies [[a :path \"../a\"]]")
      (let (entries (resolve-deps app (list (dep-path 'a "../a")) nil))
        (assert= (map (fn (e) (get e :name)) entries) (list 'a 'b)))))
  (test "a missing path dep is a clear error"
    (let (app (pkg-fixture-root))
      (pkg-write-project app "app" "main" "(defn main () 1)" "")
      (is (includes? (try
                       (resolve-deps app
                         (list (dep-path 'gone "../gone"))
                         nil)
                       (catch e e))
            "not found")))))

;; :git deps (Slice 2) — exercised against a local git repo over a file:// URL, so
;; the suite stays offline. Covers cloning into _deps/, commit pinning, the lock
;; fields, transitive resolution, the direct-beats-transitive rule, and the loud
;; conflict error.
(describe "package: resolving :git deps"
  (test "a :git dep clones into _deps/, pins a commit, and records a sha"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (let (url (pkg-git-init dep-dir))
        (pkg-git-tag dep-dir "v1.0.0")
        (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
        (let (entries (resolve-deps app-dir
                        (list (dep-git 'greeter url "v1.0.0"))
                        nil))
          (assert= (count entries) 1)
          (let (e (first entries))
            (assert= (dep-kind e) :git)
            (assert= (get e :url) url)
            (assert= (get e :ref) "v1.0.0")
            (is (string? (get e :commit)))
            (is (string? (get e :sha256)))
            (is (dir? (path-join (path-join app-dir "_deps") "greeter")))
            (is (file-exists? (path-join (path-join (path-join app-dir "_deps") "greeter")
                                ".brood-pkg.blsp"))))))))
  (test "a second resolve reuses the locked commit (cache hit, no re-clone)"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (let (url (pkg-git-init dep-dir))
        (pkg-git-tag dep-dir "v1.0.0")
        (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
        (let (dep (list (dep-git 'greeter url "v1.0.0"))
              e1 (first (resolve-deps app-dir dep nil)))
          (write-lockfile app-dir (list e1))
          ;; re-resolve with the lock present: same commit + sha, cache untouched
          (let (e2 (first (resolve-deps app-dir dep (read-lockfile app-dir))))
            (assert= (get e2 :commit) (get e1 :commit))
            (assert= (get e2 :sha256) (get e1 :sha256)))))))
  (test "transitive :git deps are flattened; a direct pin beats a transitive one"
    (let (parent (pkg-fixture-root)
          ansi (path-join parent "ansi")
          greeter (path-join parent "greeter")
          app (path-join parent "app"))
      (pkg-write-project ansi "ansi" "ansi" "(defn bold (s) s)" "")
      (let (ansi-url (pkg-git-init ansi))
        (pkg-git-tag ansi "v1.0.0")
        (pkg-git-tag ansi "v2.0.0")
        ;; greeter (transitively) wants ansi v1.0.0
        (pkg-write-project greeter
          "greeter"
          "greeter"
          "(defn g () 1)"
          (str " :dependencies [[ansi :git \"" ansi-url "\" :ref \"v1.0.0\"]]"))
        (let (greeter-url (pkg-git-init greeter))
          (pkg-git-tag greeter "v1.0.0")
          (pkg-write-project app "app" "main" "(defn main () 1)" "")
          ;; app pins ansi v2.0.0 directly + depends on greeter → v2 wins, no error
          (let (entries (resolve-deps app
                          (list (dep-git 'ansi ansi-url "v2.0.0")
                            (dep-git 'greeter greeter-url "v1.0.0"))
                          nil)
                idx (package/package-index-by-name entries))
            (assert= (sort (map (fn (e) (get e :name)) entries)) (list 'ansi 'greeter))
            (assert= (get (get idx 'ansi) :ref) "v2.0.0"))))))
  (test "two transitive :git deps at different refs, with no direct pin, error loudly"
    (let (parent (pkg-fixture-root)
          ansi (path-join parent "ansi")
          greeter (path-join parent "greeter")
          pretty (path-join parent "pretty")
          app (path-join parent "app"))
      (pkg-write-project ansi "ansi" "ansi" "(defn bold (s) s)" "")
      (let (ansi-url (pkg-git-init ansi))
        (pkg-git-tag ansi "v1.0.0")
        (pkg-git-tag ansi "v2.0.0")
        (pkg-write-project greeter
          "greeter"
          "greeter"
          "(defn g () 1)"
          (str " :dependencies [[ansi :git \"" ansi-url "\" :ref \"v1.0.0\"]]"))
        (pkg-write-project pretty
          "pretty"
          "pretty"
          "(defn p () 1)"
          (str " :dependencies [[ansi :git \"" ansi-url "\" :ref \"v2.0.0\"]]"))
        (let (greeter-url (pkg-git-init greeter)
              pretty-url (pkg-git-init pretty))
          (pkg-write-project app "app" "main" "(defn main () 1)" "")
          (is (includes? (try
                           (resolve-deps app
                             (list (dep-git 'greeter greeter-url "main")
                               (dep-git 'pretty pretty-url "main"))
                             nil)
                           (catch e e))
                "conflicting dependency")))))))

;; --- :tarball deps (ADR-037 v2) ---------------------------------------------
;; A .tar.gz artifact + mandatory :sha256, extracted (wrapper stripped) into
;; _deps/. Exercised offline via a file:// URL to a locally-built archive.
(describe "package: resolving :tarball deps"
  (test "a :tarball dep downloads, sha-verifies, and strip-extracts into _deps/"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (let (ts (pkg-tar-init parent "greeter")
            url (first ts)
            sha (second ts))
        (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
        (let (entries (resolve-deps app-dir
                        (list (dep-tarball 'greeter url sha))
                        nil))
          (assert= (count entries) 1)
          (let (e (first entries)
                target (path-join (path-join app-dir "_deps") "greeter"))
            (assert= (dep-kind e) :tarball)
            (assert= (get e :url) url)
            (assert= (get e :sha256) sha)
            (is (dir? target))
            ;; strip-components=1 dropped the wrapper: the manifest is at the dep root
            (is (file-exists? (path-join target "project.blsp")))
            (is (file-exists? (path-join target "src/greeter.blsp")))
            (is (file-exists? (path-join target ".brood-pkg.blsp"))))))))
  (test "a wrong :sha256 errors loudly (the integrity pin)"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (let (ts (pkg-tar-init parent "greeter") url (first ts))
        (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
        (is (includes? (try
                         (resolve-deps app-dir
                           (list (dep-tarball 'greeter url "deadbeef"))
                           nil)
                         (catch e (error-message e)))
              "sha256 mismatch")))))
  (test "a second resolve is a cache hit (locked sha), no re-extract"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (let (ts (pkg-tar-init parent "greeter") url (first ts) sha (second ts))
        (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
        (let (dep (list (dep-tarball 'greeter url sha))
              e1 (first (resolve-deps app-dir dep nil)))
          (write-lockfile app-dir (list e1))
          (let (e2 (first (resolve-deps app-dir dep (read-lockfile app-dir))))
            (assert= (dep-kind e2) :tarball)
            (assert= (get e2 :sha256) sha))))))
  (test ":tarball deps parse; a missing :sha256 is rejected"
    (assert= (project/project-parse-deps [['foo :tarball "https://x/foo.tar.gz" :sha256 "abc"]])
      (list (assoc (dep-tarball 'foo "https://x/foo.tar.gz" "abc") :optional false)))
    (is (includes? (try
                     (project/project-parse-deps [['foo :tarball "https://x/foo.tar.gz"]])
                     (catch e (error-message e)))
          "sha256"))))

;; --- the registry: search / publish / :version deps (hive HTTP API) ---------
;; The registry is a hosted HTTP service. These tests run a real loopback server
;; (std/net/http) serving canned registry responses, and drive the client against
;; it — a genuine end-to-end round-trip (download → sha256-verify → extract), no
;; network and no global-state mutation.

;; Spawn a loopback HTTP server running `handler`; return its base URL. The server
;; process lives for the rest of the test run (killed with the suite).
(defn mock-registry-start (handler)
  (let (me (self))
    (spawn (do
             (let (ls (net/http/http-listen 0))
               (send me [:reg-port (tcp-local-port ls)])
               (net/http/serve-loop ls handler))))
    (let (port (receive ([:reg-port p] p) (after *test-wait-ms* :timeout)))
      (str "http://127.0.0.1:" port))))

;; A handler serving one published package `nm`@`version`: search, release metadata
;; (declaring `checksum`), and the tarball `bytes`. Anything else is a 404 (so an
;; unknown version exercises the not-found path).
(defn mock-registry-handler (nm version desc checksum bytes)
  (fn (req)
    (let (path (get req :path)
          release-path (str "/api/v1/packages/" nm "/releases/" version))
      (cond
        (starts-with? path "/api/v1/packages?")
          (net/http/ok (str "{\"packages\":[{\"name\":\""
                         nm "\",\"latest_version\":\"" version "\",\"description\":\"" desc "\"}]}"))
        (= path (str release-path "/tarball"))
          (net/http/response 200
            {"Content-Type" "application/gzip"}
            bytes)
        (= path release-path)
          (net/http/ok (str "{\"checksum\":\""
                         checksum "\",\"version\":\"" version "\",\"dependencies\":[]}"))
        else (net/http/not-found)))))

;; Build a root-level tarball of a fixture package (files at the archive root, the
;; layout hive serves and the resolver extracts with strip 0). Returns [bytes sha256].
(defn mock-package-tarball (parent nm)
  (let (dep-dir (path-join parent nm))
    (pkg-write-project dep-dir nm nm "(defn greet (w) w)" "")
    (let (archive (path-join parent (str nm ".tar.gz")))
      (run-process "tar" (list "-czf" archive "-C" dep-dir "."))
      (let (bytes (slurp-bytes archive)) [bytes (hash/sha256-bytes bytes)]))))

;; A handler whose release points at an EXTERNAL tarball — it serves the wrapped tarball over
;; HTTP at `/ext/<nm>.tar.gz` (the client rejects a non-http(s) source_url) and metadata whose
;; `:source_url` points there. `cfg` (a table) carries the server's base URL, filled in after
;; `mock-registry-start` returns (its ephemeral port is only known then). No hive `/tarball`.
(defn mock-registry-handler-external (cfg nm version checksum wrapped-bytes)
  (fn (req)
    (let (path (get req :path)
          src (str (table-get cfg :base "") "/ext/" nm ".tar.gz"))
      (cond
        (= path (str "/ext/" nm ".tar.gz"))
          (net/http/response 200 {"Content-Type" "application/gzip"} wrapped-bytes)
        (= path (str "/api/v1/packages/" nm "/releases/" version))
          (net/http/ok (json/json-encode {:checksum checksum
                                          :version version
                                          :source_url src
                                          :dependencies []}))
        else (net/http/not-found)))))

;; Build a WRAPPED tarball — files under a single `nm/` dir, the `tar czf pkg/` / GitHub
;; layout an external source uses (extracted with strip 1). Returns [bytes sha256].
(defn mock-package-tarball-wrapped (parent nm)
  (let (dep-dir (path-join parent nm))
    (pkg-write-project dep-dir nm nm "(defn greet (w) w)" "")
    (let (archive (path-join parent (str nm "-wrapped.tar.gz")))
      (run-process "tar" (list "-czf" archive "-C" parent nm))
      [(slurp-bytes archive) (hash/sha256-bytes (slurp-bytes archive))])))

;; A handler serving a SIGNED hosted release (ADR-212): its metadata carries `:signature` +
;; `:pubkey` (hex) alongside the checksum, and the tarball at `/tarball`.
(defn mock-registry-handler-signed (nm version checksum bytes signature pubkey)
  (fn (req)
    (let (path (get req :path)
          release-path (str "/api/v1/packages/" nm "/releases/" version))
      (cond
        (= path (str release-path "/tarball"))
          (net/http/response 200 {"Content-Type" "application/gzip"} bytes)
        (= path release-path)
          (net/http/ok (json/json-encode {:checksum checksum
                                          :version version
                                          :signature signature
                                          :pubkey pubkey
                                          :dependencies []}))
        else (net/http/not-found)))))

;; A valid [signature-hex pubkey-hex] over the release's canonical payload (name, version,
;; checksum — the same bytes package-signing-payload builds), from a fresh keypair.
(defn mock-sign (nm version checksum)
  (let (kp (crypto/keypair)
        payload (string->utf8-bytes (str nm "\n" version "\n" checksum)))
    [(encoding/hex-encode-bytes (crypto/sign (get kp :private) payload))
      (encoding/hex-encode-bytes (get kp :public))]))

(describe "package: the hosted registry"
  (test "a :version dep downloads, sha256-verifies, and extracts the tarball"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [bytes checksum] (mock-package-tarball parent "greeter")
          base (mock-registry-start (mock-registry-handler "greeter"
                                      "1.0.0" "greetings" checksum bytes)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (let (e (package/package-resolve-registry app-dir (dep-registry 'greeter "1.0.0") nil base))
        (assert= (dep-kind e) :registry)
        (assert= (get e :version) "1.0.0")
        (assert= (get e :sha256) checksum)
        (let (extracted (path-join (path-join app-dir "_deps") "greeter"))
          (is (dir? extracted))
          (is (file-exists? (path-join extracted "project.blsp"))))
        ;; lock row: [greeter :registry "1.0.0" :sha256 <sha> :deps …]
        (let (row (dep-lock-vec e))
          (assert= (vector-ref row 1) :registry)
          (assert= (vector-ref row 2) "1.0.0")
          (assert= (vector-ref row 3) :sha256)
          (assert= (vector-ref row 4) checksum)))))
  (test "a release pointing at an external tarball URL is fetched, sha-verified, strip-1 extracted"
    ;; the registry serves ONLY metadata (with :source_url); the bytes live at an external HTTP
    ;; URL (a second path on the same loopback) — proving hive need not hold the tarball
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [wrapped-bytes checksum] (mock-package-tarball-wrapped parent "extdep")
          cfg (table)
          base (mock-registry-start (mock-registry-handler-external cfg
                                      "extdep" "1.0.0" checksum wrapped-bytes)))
      (table-put cfg :base base)
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (let (e (package/package-resolve-registry app-dir (dep-registry 'extdep "1.0.0") nil base))
        (assert= (dep-kind e) :registry)
        (assert= (get e :version) "1.0.0")
        (assert= (get e :sha256) checksum)
        (let (extracted (path-join (path-join app-dir "_deps") "extdep"))
          (is (dir? extracted))
          ;; strip-1 put the wrapped package's project.blsp at the package root
          (is (file-exists? (path-join extracted "project.blsp")))))))
  (test "an external-URL release still refuses a sha256 mismatch"
    ;; the checksum is verified regardless of source — the registry is never trusted for bytes
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [wrapped-bytes _real] (mock-package-tarball-wrapped parent "extbad")
          cfg (table)
          base (mock-registry-start (mock-registry-handler-external cfg
                                      "extbad" "1.0.0" "deadbeef" wrapped-bytes)))
      (table-put cfg :base base)
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (is (includes? (try
                       (package/package-resolve-registry app-dir
                         (dep-registry 'extbad "1.0.0")
                         nil
                         base)
                       (catch e (error-message e)))
            "sha256 mismatch"))))
  (test "a registry-supplied file:// source URL is refused (trust boundary, ADR-211)"
    ;; a compromised/MITM'd registry must NOT be able to point the client at a local file:
    ;; the client rejects any non-http(s) source_url even though the checksum would 'match'
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [wrapped-bytes _sha] (mock-package-tarball-wrapped parent "evil")
          ;; write the wrapped tarball to disk and point source_url at it via file://
          local (path-join parent "evil-local.tar.gz")
          _ (spit-bytes local wrapped-bytes)
          file-url (str "file://" local)
          checksum (hash/sha256-bytes (slurp-bytes local))
          ;; serve metadata whose source_url is the file:// URL, and a matching checksum
          base (mock-registry-start (fn (req)
                                      (if (= (get req :path) "/api/v1/packages/evil/releases/1.0.0")
                                        (net/http/ok (json/json-encode {:checksum checksum
                                                                        :version "1.0.0"
                                                                        :source_url file-url
                                                                        :dependencies []}))
                                        (net/http/not-found)))))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (is (includes? (try
                       (package/package-resolve-registry app-dir
                         (dep-registry 'evil "1.0.0")
                         nil
                         base)
                       (catch e (error-message e)))
            "non-http(s) source URL"))))
  (test "a signed release verifies and pins the signer's public key (TOFU, ADR-212)"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [bytes checksum] (mock-package-tarball parent "signdep")
          [signature pubkey] (mock-sign "signdep" "1.0.0" checksum)
          base (mock-registry-start (mock-registry-handler-signed "signdep"
                                      "1.0.0" checksum bytes signature pubkey)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (let (e (package/package-resolve-registry app-dir (dep-registry 'signdep "1.0.0") nil base))
        (assert= (dep-kind e) :registry)
        ;; the verified signer's key is pinned on the entry and written into the lock row
        ;; (both the :pubkey keyword and its value appear in the lock vector)
        (assert= (get e :pubkey) pubkey)
        (is (includes? (seq (dep-lock-vec e)) :pubkey))
        (is (includes? (seq (dep-lock-vec e)) pubkey)))))
  (test "signature checking is advisory — a bad signature warns but still installs"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [bytes checksum] (mock-package-tarball parent "sigbad")
          ;; a syntactically-valid but WRONG signature (a fresh key over the wrong message)
          [_sig pubkey] (mock-sign "sigbad" "1.0.0" checksum)
          bad-sig (encoding/hex-encode-bytes (crypto/sign (get (crypto/keypair) :private)
                                               (string->utf8-bytes "not the checksum")))
          base (mock-registry-start (mock-registry-handler-signed "sigbad"
                                      "1.0.0" checksum bytes bad-sig pubkey)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      ;; resolves anyway (advisory never blocks), and the extraction lands
      (let (e (package/package-resolve-registry app-dir (dep-registry 'sigbad "1.0.0") nil base))
        (assert= (get e :version) "1.0.0")
        (is (dir? (path-join (path-join app-dir "_deps") "sigbad"))))))
  (test "an unsigned release pins no key and leaves the lock uncluttered"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [bytes checksum] (mock-package-tarball parent "plaindep")
          base (mock-registry-start (mock-registry-handler "plaindep" "1.0.0" "d" checksum bytes)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (let (e (package/package-resolve-registry app-dir (dep-registry 'plaindep "1.0.0") nil base))
        (assert= nil (get e :pubkey))
        (is (not (includes? (seq (dep-lock-vec e)) :pubkey))))))
  (test "a non-string signature/pubkey from the registry can't crash the install (advisory)"
    ;; type-confusion: the registry serves signature/pubkey as JSON NUMBERS. Verification is
    ;; advisory and must degrade to 'unsigned', never throw out of hex-decode and gate the install.
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [bytes checksum] (mock-package-tarball parent "weird")
          base (mock-registry-start (fn (req)
                                      (let (path (get req :path)
                                            rp "/api/v1/packages/weird/releases/1.0.0")
                                        (cond
                                          (= path (str rp "/tarball"))
                                            (net/http/response 200
                                              {"Content-Type" "application/gzip"}
                                              bytes)
                                          (= path rp)
                                            (net/http/ok (json/json-encode {:checksum checksum
                                                                            :version "1.0.0"
                                                                            :signature 123
                                                                            :pubkey 456
                                                                            :dependencies []}))
                                          else (net/http/not-found))))))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (let (e (package/package-resolve-registry app-dir (dep-registry 'weird "1.0.0") nil base))
        (assert= (get e :version) "1.0.0")
        (assert= nil (get e :pubkey)))))
  (test "a sha256 mismatch is refused"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [bytes _real] (mock-package-tarball parent "greeter")
          ;; the metadata declares a checksum that does NOT match the served bytes
          base (mock-registry-start (mock-registry-handler "greeter" "1.0.0" "d" "deadbeef" bytes)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (is (includes? (try
                       (package/package-resolve-registry app-dir
                         (dep-registry 'greeter "1.0.0")
                         nil
                         base)
                       (catch e (error-message e)))
            "sha256 mismatch"))))
  (test "an unknown version errors, pointing at `nest search`"
    (let (app-dir (pkg-fixture-root)
          base (mock-registry-start (mock-registry-handler "greeter" "1.0.0" "d" "x" #b"")))
      (is (includes? (try
                       (package/package-resolve-registry app-dir
                         (dep-registry 'greeter "9.9.9")
                         nil
                         base)
                       (catch e (error-message e)))
            "no registry entry"))))
  (test "registry-get-json parses a 2xx body and reports an error status"
    (let (base (mock-registry-start (mock-registry-handler "greeter" "1.0.0" "greetings" "x" #b"")))
      (match (package/registry-get-json (str base "/api/v1/packages?q=greet"))
        ([:ok data] (assert= (get (first (get data :packages)) :name) "greeter")))
      (match (package/registry-get-json (str base "/api/v1/packages/nope/releases/9.9.9"))
        ([:error status _message] (assert= status 404)))))
  (test "registry-search-line formats a hit"
    (assert= (package/registry-search-line {:name "greeter"
                                            :latest_version "1.0.0"
                                            :description "greetings"})
      "greeter  1.0.0  — greetings")
    (assert= (package/registry-search-line {:name "x" :latest_version "" :description ""}) "x  ?"))
  (test "publishable-deps keeps registry deps and omits local ones"
    (binding (*project-dependencies* (list (dep-registry 'foo "1.2.0") (dep-path 'bar "../bar")))
      (let (out (package/registry-publishable-deps))
        (assert= (count out) 1)
        (assert= (get (first out) :name) "foo")
        (assert= (get (first out) :version) "1.2.0"))))
  (test ":version deps parse into a registry dep map"
    (assert= (project/project-parse-deps [['foo :version "1.2.0"]])
      (list (assoc (dep-registry 'foo "1.2.0") :optional false))))
  (test "an external publish's metadata envelope carries :source_url; a hosted one omits it"
    (binding (*project-name* "foo"
              *project-version* "1.0.0"
              *project-description* ""
              *project-dependencies* nil
              *project-enhances* {})
      (let (ext (encoding/base64-decode (package/registry-publish-metadata "abc"
                                          "https://ex/f.tgz" nil nil)))
        (is (includes? ext "\"source_url\":\"https://ex/f.tgz\""))
        (is (includes? ext "\"checksum\":\"abc\"")))
      (let (hosted (encoding/base64-decode (package/registry-publish-metadata "abc" nil nil nil)))
        (is (not (includes? hosted "source_url"))))
      ;; a signed publish carries :signature + :pubkey; an unsigned one omits both
      (let (signed (encoding/base64-decode (package/registry-publish-metadata "abc"
                                             nil "sighex" "pubhex")))
        (is (includes? signed "\"signature\":\"sighex\""))
        (is (includes? signed "\"pubkey\":\"pubhex\"")))
      (let (unsigned (encoding/base64-decode (package/registry-publish-metadata "abc" nil nil nil)))
        (is (not (includes? unsigned "signature")))
        (is (not (includes? unsigned "pubkey")))))))

;; ---- version-range resolution (ADR-209) --------------------------------------
;; A `:version` dep now names a RANGE, resolved to a concrete version by the backtracking
;; resolver over the live registry. These drive the whole path against a loopback server
;; serving a multi-package, multi-version registry: list-releases, per-release metadata
;; (with its own `:dependencies` as ranges), and real tarballs — so a range flows through
;; the solver, gets downloaded + sha-verified + extracted, and is locked at its concrete
;; version. The registry SPEC is `{name -> {version -> {:deps [[dep-name range]...]
;; :checksum sha :bytes b}}}`.

;; The `/releases` list now carries each release's deps (the one-request contract the
;; resolver's prefetch relies on): `{:releases [{:version V :dependencies [...]} ...]}`.
(defn rr-releases-json (releases)
  (str "{\"releases\":["
    (join ","
      (map (fn (kv)
             (str "{\"version\":\""
               (first kv)
               "\",\"dependencies\":["
               (join ","
                 (map (fn (d) (str "{\"name\":\"" (first d) "\",\"version\":\"" (second d) "\"}"))
                   (get (second kv) :deps)))
               "]}"))
        (map-pairs releases)))
    "]}"))

(defn rr-release-json (version checksum deps)
  (str "{\"checksum\":\""
    checksum
    "\",\"version\":\""
    version
    "\",\"dependencies\":["
    (join ","
      (map (fn (d) (str "{\"name\":\"" (first d) "\",\"version\":\"" (second d) "\"}")) deps))
    "]}"))

;; Build one release tarball whose manifest declares `deps-line` (so the extracted
;; package's own project.blsp matches what the registry advertises). Returns [bytes sha].
(defn rr-build (parent nm version deps-line)
  (let (dir (path-join parent (str nm "-" version)))
    (pkg-write-project dir nm nm "(defn f () 1)" deps-line)
    (let (archive (path-join parent (str nm "-" version ".tar.gz")))
      (run-process "tar" (list "-czf" archive "-C" dir "."))
      (let (bytes (slurp-bytes archive)) [bytes (hash/sha256-bytes bytes)]))))

;; A handler serving `spec`. Path shapes: …/packages/<n>/releases (list),
;; …/releases/<v> (metadata), …/releases/<v>/tarball (bytes).
(defn rr-handler (spec)
  (fn (req)
    (let (parts (string-split (get req :path) "/")
          n (count parts))
      (let (nm (nth parts 4)
            releases (get spec nm))
        (cond
          (nil? releases) (net/http/not-found)
          (and (= n 6) (= (nth parts 5) "releases")) (net/http/ok (rr-releases-json releases))
          (and (= n 7) (= (nth parts 5) "releases"))
            (let (rel (get releases (nth parts 6)))
              (if (nil? rel)
                (net/http/not-found)
                (net/http/ok (rr-release-json (nth parts 6) (get rel :checksum) (get rel :deps)))))
          (and (= n 8) (= (nth parts 7) "tarball"))
            (let (rel (get releases (nth parts 6)))
              (if (nil? rel)
                (net/http/not-found)
                (net/http/response 200 {"Content-Type" "application/gzip"} (get rel :bytes))))
          else (net/http/not-found))))))

(describe "package: version-range resolution (ADR-209)"
  (test "the registry provider lists versions and reads a release's dep ranges"
    (let (parent (pkg-fixture-root)
          [b1 s1] (rr-build parent "foo" "1.0.0" "")
          [b2 s2] (rr-build parent "foo" "1.5.0" " :dependencies [[bar :version \"^2.0\"]]")
          spec {"foo" {"1.0.0" {:deps [] :checksum s1 :bytes b1}
                       "1.5.0" {:deps [["bar" "^2.0"]] :checksum s2 :bytes b2}}}
          base (mock-registry-start (rr-handler spec)))
      (let (versions (package/registry-list-versions base 'foo))
        (is (includes? versions "1.0.0"))
        (is (includes? versions "1.5.0")))
      (assert= (list ['bar "^2.0"]) (package/registry-release-deps base 'foo "1.5.0"))
      (assert= '() (package/registry-release-deps base 'foo "1.0.0"))
      ;; an unknown package has no versions (so the resolver reports it, not a crash)
      (assert= nil (package/registry-list-versions base 'nope))))

  (test "a range resolves to the newest compatible version, transitively, and locks it"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [foo15 fs] (rr-build parent "foo" "1.5.0" " :dependencies [[bar :version \"^2.0\"]]")
          [bar20 b20s] (rr-build parent "bar" "2.0.0" "")
          [bar21 b21s] (rr-build parent "bar" "2.1.0" "")
          spec {"foo" {"1.0.0" {:deps [] :checksum "x" :bytes #b""}
                       "1.5.0" {:deps [["bar" "^2.0"]] :checksum fs :bytes foo15}}
                "bar" {"2.0.0" {:deps [] :checksum b20s :bytes bar20}
                       "2.1.0" {:deps [] :checksum b21s :bytes bar21}}}
          base (mock-registry-start (rr-handler spec)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (binding (*config-registry* base)
        (let (entries (package/resolve-deps app-dir (list (dep-registry 'foo "^1.0")) nil)
              by-name (fold (fn (m e) (assoc m (get e :name) e)) {} entries))
          (assert= 2 (count entries))
          ;; foo: newest satisfying ^1.0 is 1.5.0
          (assert= "1.5.0" (get (get by-name 'foo) :version))
          ;; bar: pulled in transitively by foo 1.5.0's ^2.0, newest is 2.1.0
          (assert= "2.1.0" (get (get by-name 'bar) :version))
          ;; both are on disk under _deps/
          (is (dir? (path-join (path-join app-dir "_deps") "foo")))
          (is (dir? (path-join (path-join app-dir "_deps") "bar")))
          ;; the lock rows carry the CONCRETE resolved versions
          (let (foo-row (dep-lock-vec (get by-name 'foo)))
            (assert= :registry (vector-ref foo-row 1))
            (assert= "1.5.0" (vector-ref foo-row 2)))))))

  (test "a fully-covering lock reuses the solution network-free (the fast path)"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [foo10 fs] (rr-build parent "foo" "1.0.0" "")
          spec {"foo" {"1.0.0" {:deps [] :checksum fs :bytes foo10}}}
          base (mock-registry-start (rr-handler spec)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (binding (*config-registry* base)
        ;; first resolve pins foo = 1.0.0 and builds a lock row
        (let (entries (package/resolve-deps app-dir (list (dep-registry 'foo "^1.0")) nil)
              lock (apply vector (map dep-lock-vec entries)))
          (assert= "1.0.0" (get (first entries) :version))
          ;; now point the registry at a server that 404s EVERYTHING — a re-solve would
          ;; fail, so success proves the locked solution was reused without querying it
          (binding (*config-registry* (mock-registry-start (rr-handler {})))
            (let (again (package/resolve-deps app-dir (list (dep-registry 'foo "^1.0")) lock))
              (assert= "1.0.0" (get (first again) :version))))))))

  (test "adding a dep re-solves but keeps the already-locked dep at its pinned version"
    ;; foo is locked at 1.0.0 though 1.1.0 exists; adding bar forces a fresh solve —
    ;; foo must STAY 1.0.0 (the lock preference), only bar resolves newest.
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [foo10 f10] (rr-build parent "foo" "1.0.0" "")
          [foo11 f11] (rr-build parent "foo" "1.1.0" "")
          [bar20 b20] (rr-build parent "bar" "2.0.0" "")
          spec {"foo" {"1.0.0" {:deps [] :checksum f10 :bytes foo10}
                       "1.1.0" {:deps [] :checksum f11 :bytes foo11}}
                "bar" {"2.0.0" {:deps [] :checksum b20 :bytes bar20}}}
          base (mock-registry-start (rr-handler spec))
          ;; a prior lock pinning foo = 1.0.0 (bar not yet present)
          prior-lock [['foo :registry "1.0.0" :sha256 f10 :deps []]])
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (binding (*config-registry* base)
        (let (entries (package/resolve-deps app-dir
                        (list (dep-registry 'foo "^1.0") (dep-registry 'bar "^2.0"))
                        prior-lock)
              by-name (fold (fn (m e) (assoc m (get e :name) e)) {} entries))
          (assert= 2 (count entries))
          (assert= "1.0.0" (get (get by-name 'foo) :version)) ; kept, NOT upgraded to 1.1.0
          (assert= "2.0.0" (get (get by-name 'bar) :version))))))

  (test "backtracking end-to-end: a dead-end newest version falls back, then downloads"
    ;; a@2.0.0 needs c=1.0.0, a@1.0.0 needs c=2.0.0, and b forces c=2.0.0 — so the newest
    ;; a (2.0.0) dead-ends and the resolver must fall back to a@1.0.0. Only the SOLUTION
    ;; versions (a 1.0.0, b 1.0.0, c 2.0.0) are downloaded; a@2.0.0 / c@1.0.0 are consulted
    ;; during the pre-fetch but never fetched as tarballs. Proves prefetch + pure solve +
    ;; download all hang together on a graph that actually backtracks.
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [a10 a10s] (rr-build parent "a" "1.0.0" "")
          [b10 b10s] (rr-build parent "b" "1.0.0" "")
          [c20 c20s] (rr-build parent "c" "2.0.0" "")
          spec {"a" {"1.0.0" {:deps [["c" "= 2.0.0"]] :checksum a10s :bytes a10}
                     "2.0.0" {:deps [["c" "= 1.0.0"]] :checksum "x" :bytes #b""}}
                "b" {"1.0.0" {:deps [["c" "= 2.0.0"]] :checksum b10s :bytes b10}}
                "c" {"1.0.0" {:deps [] :checksum "x" :bytes #b""}
                     "2.0.0" {:deps [] :checksum c20s :bytes c20}}}
          base (mock-registry-start (rr-handler spec)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (binding (*config-registry* base)
        (let (entries (package/resolve-deps app-dir
                        (list (dep-registry 'a ">= 1.0") (dep-registry 'b ">= 1.0"))
                        nil)
              by-name (fold (fn (m e) (assoc m (get e :name) e)) {} entries))
          (assert= 3 (count entries))
          (assert= "1.0.0" (get (get by-name 'a) :version)) ; fell back from 2.0.0
          (assert= "1.0.0" (get (get by-name 'b) :version))
          (assert= "2.0.0" (get (get by-name 'c) :version))
          (is (dir? (path-join (path-join app-dir "_deps") "c")))))))

  (test "an unsatisfiable range set errors, naming the package"
    (let (parent (pkg-fixture-root)
          app-dir (path-join parent "app")
          [foo10 fs] (rr-build parent "foo" "1.0.0" " :dependencies [[shared :version \"^1.0\"]]")
          [baz10 bs] (rr-build parent "baz" "1.0.0" " :dependencies [[shared :version \"^2.0\"]]")
          spec {"foo" {"1.0.0" {:deps [["shared" "^1.0"]] :checksum fs :bytes foo10}}
                "baz" {"1.0.0" {:deps [["shared" "^2.0"]] :checksum bs :bytes baz10}}
                "shared" {"1.0.0" {:deps [] :checksum "x" :bytes #b""}
                          "2.0.0" {:deps [] :checksum "y" :bytes #b""}}}
          base (mock-registry-start (rr-handler spec)))
      (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
      (binding (*config-registry* base)
        (is (includes? (try
                         (package/resolve-deps app-dir
                           (list (dep-registry 'foo "^1.0") (dep-registry 'baz "^1.0"))
                           nil)
                         (catch e (error-message e)))
              "shared"))))))

;; `:enhances` — what a package plugs into (Debian's `Enhances:`). The whole point is
;; that NOTHING here knows any application by name: the manifest parses a map, publish
;; carries it, search passes it through as a query parameter. `bedit` below is just a
;; symbol a package author typed, and these tests would read identically for `hatch`.
(describe "package: :enhances (a plugin declares the application it extends)"
  (test "the manifest parses a map of application → constraint, symbol-keyed"
    (assert= {'bedit ">= 0.3"} (project/project-parse-enhances {'bedit ">= 0.3"}))
    ;; string keys normalize to symbols, so a consumer looks a name up ONE way
    (assert= {'bedit ">= 0.3"} (project/project-parse-enhances {"bedit" ">= 0.3"}))
    (assert= {'bedit "" 'hatch ">= 1.0"}
      (project/project-parse-enhances {'bedit "" 'hatch ">= 1.0"})))
  (test "absent is an ordinary library, not an error"
    (assert= {} (project/project-parse-enhances nil)))
  (test "a manifest typo fails when the MANIFEST is read, naming the key"
    (is (includes? (try
                     (project/project-parse-enhances [['bedit ">= 0.3"]])
                     (catch e (error-message e)))
          ":enhances must be a MAP"))
    (is (includes? (try
                     (project/project-parse-enhances {'bedit 0.3})
                     (catch e (error-message e)))
          "must be a string")))
  (test "a real manifest carries it through project-apply"
    ;; NOT wrapped in `binding`: `project-apply` `def`s the dynvar's global ROOT (that is
    ;; how a manifest configures the image), and a `binding` in front of it would shadow
    ;; the write with the bound value — masking exactly what this checks. So save and
    ;; restore the root instead, the way a manifest-reading tool would leave it.
    (let (root (pkg-fixture-root)
          saved *project-enhances*)
      (make-dir (path-join root "src"))
      (spit (path-join root "project.blsp")
        (str "(project :name \"bedit-zig\" :version \"0.1.0\""
          " :enhances {bedit \">= 0.1\"})\n"))
      ;; `rest`: the `project` MACRO passes only the opts plist to `project-apply`, so
      ;; handing it the whole `(project …)` form would shift every key by one and find
      ;; nothing — the same mistake as reading a manifest with `plist-get` on the form.
      (project/project-apply (rest (read-string (slurp (path-join root "project.blsp")))))
      (assert= ">= 0.1" (get *project-enhances* 'bedit))
      (def *project-enhances* saved)))
  (test "the publish envelope carries it with STRING keys (JSON has no symbols)"
    (binding (*project-enhances* {'bedit ">= 0.1"})
      (assert= {"bedit" ">= 0.1"} (package/registry-publishable-enhances)))
    (binding (*project-enhances* {})
      (assert= {} (package/registry-publishable-enhances))))
  (test "search narrows by it through a query parameter, url-encoded"
    (assert= "http://h/api/v1/packages?q=zig"
      (package/registry-search-url "http://h" "zig" nil))
    (assert= "http://h/api/v1/packages?q=zig"
      (package/registry-search-url "http://h" "zig" ""))
    (assert= "http://h/api/v1/packages?q=zig&enhances=bedit"
      (package/registry-search-url "http://h" "zig" "bedit"))
    ;; the application name is opaque data — whatever it is, it is encoded, not parsed
    (assert= "http://h/api/v1/packages?q=&enhances=my%20app"
      (package/registry-search-url "http://h" "" "my app"))))

;; Namespace-collision detection (ADR-070). We test the cwd-free helpers
;; (`package-provided-modules` / `package-check-namespace-collisions`) directly,
;; the way slice 1 tests the verbs' helpers rather than the cwd-driven verbs.
(describe "package: namespace-collision detection (ADR-070)"
  (test "provided-modules reports each file's (defmodule …) name"
    (let (root (pkg-fixture-root))
      (pkg-write-project root "x" "alpha" "(defn f () 1)" "")
      (assert= (package/package-provided-modules (path-join root "src")) (list 'alpha))))
  (test "provided-modules reads the defmodule name, not the filename"
    (let (root (pkg-fixture-root))
      (make-dir (path-join root "src"))
      ;; file is helpers.blsp but it declares (defmodule json) — json is the
      ;; namespace that would clobber, so that's what we must report.
      (spit (path-join (path-join root "src") "helpers.blsp")
        "(defmodule json \"x\")\n(defn p () 1)\n")
      (assert= (package/package-provided-modules (path-join root "src")) (list 'json))))
  ;; Post-package-rooting (ADR-070): two *dependencies* providing the same module
  ;; name no longer collide (they root to `a/util` vs `b/util`); the collision guard
  ;; now only checks a project's OWN source dirs against each other. The helper is
  ;; generic — it flags a duplicate in whatever source list it is given — so we test
  ;; it with two of the project's own dirs, the sources `package-collision-sources`
  ;; actually feeds it now.
  (test "two of your own source dirs declaring the same module collide loudly"
    (let (parent (pkg-fixture-root)
          a (path-join parent "a")
          b (path-join parent "b"))
      (pkg-write-project a "a" "util" "(defn f () 1)" "")
      (pkg-write-project b "b" "util" "(defn g () 2)" "")
      (is (includes? (try
                       (package/package-check-namespace-collisions (list (list "your project"
                                                                           (path-join a
                                                                             "src"))
                                                                     (list "your project"
                                                                       (path-join b "src"))))
                       (catch e e))
            "collision"))))
  (test "distinct module names across providers are fine"
    (let (parent (pkg-fixture-root)
          a (path-join parent "a")
          b (path-join parent "b"))
      (pkg-write-project a "a" "alpha" "(defn f () 1)" "")
      (pkg-write-project b "b" "beta" "(defn g () 2)" "")
      (assert= (package/package-check-namespace-collisions (list (list "dependency 'a'"
                                                                   (path-join a "src"))
                                                             (list "dependency 'b'"
                                                               (path-join b "src"))))
        nil)))
  ;; A hierarchical module `(defmodule gui/window)` lives in a SUBdirectory
  ;; (`src/gui/window.blsp`), so the scan must recurse — a top-level-only listing
  ;; would miss it and two providers of the same nested namespace would collide
  ;; undetected (ADR-070).
  (test "provided-modules finds a nested-directory module"
    (let (root (pkg-fixture-root)
          gui (path-join (path-join root "src") "gui"))
      (make-dir gui)
      (spit (path-join (path-join root "src") "top.blsp") "(defmodule top)\n")
      (spit (path-join gui "window.blsp") "(defmodule gui/window)\n")
      (assert= (sort (map name (package/package-provided-modules (path-join root "src"))))
        (list "gui/window" "top"))))
  (test "two providers of the same NESTED module name collide loudly"
    (let (parent (pkg-fixture-root)
          a (path-join parent "a")
          b (path-join parent "b"))
      (make-dir (path-join (path-join a "src") "gui"))
      (make-dir (path-join (path-join b "src") "gui"))
      (spit (path-join (path-join (path-join a "src") "gui") "window.blsp")
        "(defmodule gui/window)\n(defn f () 1)\n")
      (spit (path-join (path-join (path-join b "src") "gui") "window.blsp")
        "(defmodule gui/window)\n(defn g () 2)\n")
      (is (includes? (try
                       (package/package-check-namespace-collisions (list (list "dependency 'a'"
                                                                           (path-join a "src"))
                                                                     (list "dependency 'b'"
                                                                       (path-join b "src"))))
                       (catch e e))
            "collision")))))

(describe "package: the lock file round-trips"
  (test "write-lockfile then read-lockfile recovers the dep vector"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (pkg-write-project app-dir
        "app" "main" "(defn main () 1)" " :dependencies [[greeter :path \"../greeter\"]]")
      (let (entries (resolve-deps app-dir
                      (list (dep-path 'greeter "../greeter"))
                      nil))
        (write-lockfile app-dir entries)
        (let (locked (read-lockfile app-dir))
          (is (vector? locked))
          (assert= (vector-length locked) 1)
          ;; entry vector: [greeter :path "../greeter" :sha256 H :deps []]
          (let (row (vector-ref locked 0))
            (assert= (vector-ref row 0) 'greeter)
            (assert= (vector-ref row 1) :path)
            (assert= (vector-ref row 2) "../greeter"))))))
  (test "read-lockfile is nil when there is no lock file"
    (assert= (read-lockfile (pkg-fixture-root)) nil)))

(describe "package: ensure-deps yields load-path entries"
  (test "returns each dep's src dir and writes the lock file"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) w)" "")
      (pkg-write-project app-dir
        "app" "main" "(defn main () 1)" " :dependencies [[greeter :path \"../greeter\"]]")
      (let (dirs (ensure-deps app-dir (list (dep-path 'greeter "../greeter"))))
        (assert= (count dirs) 1)
        ;; the dir is the dep's src/ (relative ".." is left unnormalised — the OS
        ;; resolves it; normalisation is a deferred nicety)
        (is (includes? (first dirs) "greeter/src"))
        (is (file-exists? (path-join app-dir "project.lock.blsp"))))))
  (test "no deps means no load-path entries and no lock file"
    (let (app (pkg-fixture-root))
      (make-dir app)
      (assert= (ensure-deps app nil) nil)
      (refute (file-exists? (path-join app "project.lock.blsp"))))))

;; Editing the manifest — pure string→string transforms (comment-preserving),
;; so they test without the filesystem. The add/remove *verbs* are cwd-driven
;; (covered by the hand check `nest add`/`nest remove` in a scaffolded project).
(describe "package: editing the manifest"
  (test "add creates a :dependencies clause and preserves comments"
    (let (src "(project :name \"app\" :version \"0.1.0\")\n\n;; a keeper comment\n"
          out (package/package-manifest-add src
                (dep-entry-node (dep-path 'greeter "../greeter"))))
      (is (includes? out "a keeper comment"))
      (let (form (read-string out))
        (assert= (project/project-parse-deps (plist-get (rest form) :dependencies))
          (list (assoc (dep-path 'greeter "../greeter") :optional false))))))
  (test "add appends to an existing :dependencies"
    (let (src "(project :name \"app\" :dependencies [[a :path \"../a\"]])\n"
          out (package/package-manifest-add src
                (dep-entry-node (dep-path 'b "../b"))))
      (let (form (read-string out))
        (assert= (map (fn (d) (get d :name))
                   (project/project-parse-deps (plist-get (rest form) :dependencies)))
          (list 'a 'b)))))
  (test "remove drops the named dep, keeps the rest and comments"
    (let (src "(project :name \"app\"\n  :dependencies [[a :path \"../a\"] [b :path \"../b\"]])\n;; keep me\n"
          out (package/package-manifest-remove src 'a))
      (is (includes? out "keep me"))
      (let (form (read-string out))
        (assert= (map (fn (d) (get d :name))
                   (project/project-parse-deps (plist-get (rest form) :dependencies)))
          (list 'b)))))
  (test "remove of the only dep leaves an empty :dependencies"
    (let (src "(project :name \"app\" :dependencies [[a :path \"../a\"]])\n"
          out (package/package-manifest-remove src 'a))
      (assert= (project/project-parse-deps (plist-get (rest (read-string out)) :dependencies)) nil))))

;; ---- the Dependency ability -------------------------------------------------
;; Every per-kind behaviour (resolve / lock row / manifest entry / compatibility) is an
;; op of one `:sealed` ability dispatching on the dep record's identity, replacing five
;; separate `(get dep :kind)` cond chains. Sealing is what makes a forgotten op a `nest
;; check` error instead of a runtime surprise in one code path.

(describe "package: the Dependency ability"
  (test "the ability is sealed over exactly the four manifest kinds"
    (assert= (sort (sealed-members 'Dependency))
      (sort (list :project/dep-path
              :project/dep-git :project/dep-tarball :project/dep-registry))))
  (test "every declared op resolves for every sealed member"
    (is (every? (fn (d) (satisfies? 'Dependency d))
          (list (dep-path 'a "p")
            (dep-git 'b "u" "r")
            (dep-tarball 'c "u" "s")
            (dep-registry 'd "1.0.0")))))
  (test "the ability declares the five ops the package manager dispatches"
    (assert= (sort (map first (ability-ops 'Dependency)))
      (sort (list 'dep-kind
              'dep-resolve 'dep-check-compatible 'dep-lock-vec 'dep-entry-node))))
  (test "dep-kind is the manifest keyword for each identity"
    (assert= (dep-kind (dep-path 'a "p")) :path)
    (assert= (dep-kind (dep-git 'b "u" "r")) :git)
    (assert= (dep-kind (dep-tarball 'c "u" "s")) :tarball)
    (assert= (dep-kind (dep-registry 'd "1.0.0")) :registry))
  (test "a plain map is not a dependency — it dispatches as :map and raises"
    (is (not (satisfies? 'Dependency {:name 'x :path "p"})))
    (assert-error (dep-kind {:name 'x :path "p"})))
  (test "dep-entry-node round-trips each kind back to a manifest entry"
    (assert= (dep-entry-node (dep-path 'a "../a"))
      [:vector (vector [:symbol "a"] [:keyword ":path"] [:str "\"../a\""])])
    (assert= (dep-entry-node (dep-registry 'd "1.2.0"))
      [:vector (vector [:symbol "d"] [:keyword ":version"] [:str "\"1.2.0\""])])))

(describe "package: dependency compatibility is per-kind"
  (test "two requests for one name at the same source agree"
    (is (nil? (package/package-check-compatible (dep-path 'a "../a") (dep-path 'a "../a"))))
    (is (nil? (package/package-check-compatible (dep-git 'a "u" "v1") (dep-git 'a "u" "v1")))))
  (test "the same name at two paths is a loud, pin-it error"
    (is (includes? (try
                     (package/package-check-compatible (dep-path 'a "../a")
                       (dep-path 'a "../b"))
                     (catch e e))
          "conflicting dependency")))
  (test "the same name at two git refs is a loud error naming both"
    (let (message (try
                    (package/package-check-compatible (dep-git 'a "u" "v1")
                      (dep-git 'a "u" "v2"))
                    (catch e e)))
      (is (includes? message "conflicting dependency"))
      (is (includes? message "v1"))
      (is (includes? message "v2"))))
  (test "two registry versions of one name conflict"
    (is (includes? (try
                     (package/package-check-compatible (dep-registry 'a "1.0.0")
                       (dep-registry 'a "2.0.0"))
                     (catch e e))
          "two registry versions")))
  (test "two DIFFERENT kinds for one name can never agree"
    (let (message (try
                    (package/package-check-compatible (dep-path 'a "../a")
                      (dep-git 'a "u" "v1"))
                    (catch e e)))
      (is (includes? message "required as both :path and :git")))))

;; The `fetch`/`tree` verbs themselves are cwd-driven (they walk from `(cwd)` to a
;; project root), so — like `run-project` — they can't be isolated from the brood
;; repo the suite runs inside. The hand check is `nest fetch`/`nest tree` in a
;; scaffolded project. Here we cover their pure, cwd-free helpers.
(describe "package: tree helpers"
  (test "a path dep displays as its tree label"
    (assert= (to-str (dep-path 'shared "../shared"))
      "shared  (path \"../shared\")"))
  (test "a git dep displays as its tree label"
    (assert= (to-str (dep-git 'p "https://x.git" "v1"))
      "p  (git https://x.git @ v1)"))
  (test "index-by-name keys resolved entries by their name"
    (let (idx (package/package-index-by-name (list (assoc (dep-path 'a "../a") :deps nil)
                                               (assoc (dep-path 'b "../b") :deps nil))))
      (assert= (get (get idx 'a) :path) "../a")
      (assert= (get (get idx 'b) :path) "../b"))))

;; End-to-end: a path dep's module becomes require-able once its src dir is on
;; *load-path* — the whole point of the slice. :isolated because it mutates
;; *load-path* and loads a module (ADR-017 rolls both back).
(describe "package: a resolved :path dep is require-able"
  :isolated
  (test "require finds the dep's module after ensure-deps extends *load-path*"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "greeter")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "greeter" "greeter" "(defn greet (w) (str \"hi \" w))" "")
      (pkg-write-project app-dir
        "app" "main" "(defn main () 1)" " :dependencies [[greeter :path \"../greeter\"]]")
      (let (dirs (ensure-deps app-dir (list (dep-path 'greeter "../greeter"))))
        (set-load-path! (append *load-path* dirs))
        (require 'greeter)
        ;; greeter is a `(defmodule greeter)`, so its `greet` is `greeter/greet`
        (assert= (greeter/greet "you") "hi you")))))

;; The git equivalent: a :git dep is cloned into _deps/, its src/ joins *load-path*,
;; and its module becomes require-able. :isolated for the same load-path reason.
(describe "package: a resolved :git dep is require-able"
  :isolated
  (test "require finds a cloned git dep's module after ensure-deps"
    (let (parent (pkg-fixture-root)
          dep-dir (path-join parent "salutation")
          app-dir (path-join parent "app"))
      (pkg-write-project dep-dir "salutation" "salutation" "(defn hi (w) (str \"yo \" w))" "")
      (let (url (pkg-git-init dep-dir))
        (pkg-git-tag dep-dir "v1.0.0")
        (pkg-write-project app-dir "app" "main" "(defn main () 1)" "")
        (let (dirs (ensure-deps app-dir
                     (list (dep-git 'salutation url "v1.0.0"))))
          (set-load-path! (append *load-path* dirs))
          (require 'salutation)
          (assert= (salutation/hi "you") "yo you")
          ;; and the clone + lock landed under the app
          (is (dir? (path-join (path-join app-dir "_deps") "salutation")))
          (is (file-exists? (path-join app-dir "project.lock.blsp"))))))))

;; A dependency NAME is written verbatim (unquoted) into project.blsp, so it must
;; be a symbol that reads back as itself. Regression: `nest add "" :path ../x`
;; wrote `:dependencies [[ :path "../x"]]` — a manifest that no longer parsed —
;; and every later `nest` command in that project failed until it was hand-fixed.
;; Any name with a space, quote, bracket or paren did the same.
(describe "package: dependency-name validation (manifest safety)"
  (test "a plain symbol name is accepted"
    (is (package/package-valid-dep-name? "parser")))
  (test "kebab-case is accepted" (is (package/package-valid-dep-name? "my-dep")))
  (test "a namespaced name is accepted" (is (package/package-valid-dep-name? "net/http")))
  (test "a non-ASCII identifier is accepted" (is (package/package-valid-dep-name? "日本語")))
  (test "the empty string is rejected" (refute (package/package-valid-dep-name? "")))
  (test "a space-only name is rejected" (refute (package/package-valid-dep-name? " ")))
  (test "a name with an inner space is rejected"
    (refute (package/package-valid-dep-name? "a b")))
  (test "an open paren is rejected" (refute (package/package-valid-dep-name? "(")))
  (test "a close paren is rejected" (refute (package/package-valid-dep-name? ")")))
  (test "a quote character is rejected" (refute (package/package-valid-dep-name? "\"")))
  (test "a bracket is rejected" (refute (package/package-valid-dep-name? "[x]")))
  (test "a number is rejected (it reads as an int, not a symbol)"
    (refute (package/package-valid-dep-name? "5")))
  (test "a keyword is rejected" (refute (package/package-valid-dep-name? ":kw")))
  (test "a non-string is rejected" (refute (package/package-valid-dep-name? 5)))
  (test "a trailing-newline name is rejected"
    (refute (package/package-valid-dep-name? "a\n")))
  (test "add refuses a corrupting name before touching the manifest"
    (is (includes? (try (package/add "" ":path" "../x") (catch e e))
          "not a usable dependency name"))))

;; A dependency's `main` is its ENTRY POINT, not part of its library surface: `nest
;; run` only ever uses the ROOT project's `:main`, and nothing requires a dep's. Two
;; projects each having one is therefore not a conflict — but it used to be reported
;; as one, which meant any `nest new` project could never be used as a dependency
;; (it provides `main`, and so does whoever depends on it).
(describe "package: `main` is exempt from module-collision checking"
  (test "main is recognised as an entry module"
    (is (package/package-entry-module? 'main)))
  (test "a string spelling is recognised too"
    ;; The provider walk yields whatever `defmodule` recorded.
    (is (package/package-entry-module? "main")))
  (test "an ordinary module is not exempt"
    (refute (package/package-entry-module? 'greeter)))
  (test "a name merely containing main is not exempt"
    (and (refute (package/package-entry-module? 'main-lib))
      (refute (package/package-entry-module? 'domain)))))
