;; tests/slurp_bytes_test.blsp — byte-faithful file reads (`slurp-bytes`) and the
;; package-hashing invariant it preserves. `slurp` is UTF-8 (throws on a binary
;; file); `slurp-bytes` reads any bytes into a bytes value, so a package tree with a
;; binary asset can be hashed (store-driver findings #7 / package-hash gap).
;;
;; Fixtures live under a unique /tmp dir per call (rand/token), purged at load.

(defmodule slurp-bytes-test (:use test))

(purge-stale-temp "brood-slurpb-")

(defn sb-tmp ()
  (let (d (temp-dir "brood-slurpb-"))
    (file/mkdir d)
    d))

(describe "slurp-bytes: text files"
  (test "returns a bytes value equal to the file's UTF-8 bytes"
    (let (p (path/join (sb-tmp) "t.txt"))
      ; 'é' is two UTF-8 bytes
      (file/spit p "héllo")
      (let (bs (file/slurp-bytes p))
        (is (bytes? bs))
        (assert= bs (string/->bytes "héllo")))))

  (test "package-hash invariant: sha256-bytes∘slurp-bytes == sha256∘slurp"
    ;; The reason switching package-sha256-file to bytes doesn't churn existing
    ;; lock hashes: for a text file the two are byte-identical.
    (let (p (path/join (sb-tmp) "src.blsp"))
      (file/spit p "(defn f (x) (* x x))\n")
      (assert= (hash/sha256-bytes (file/slurp-bytes p))
        (hash/sha256 (file/slurp p))))))

(describe "slurp-bytes: binary files (what slurp can't read)"
  :isolated
  ;; Build a file of raw bytes 0xFF 0x80 0x41 via a subprocess — 0xFF 0x80 is not
  ;; valid UTF-8, so `slurp` (read_to_string) throws on it but `slurp-bytes` reads
  ;; it faithfully.
  (defn sb-write-binary (path)
    (let (p (os/spawn "sh" ["-c" (str "printf '\\377\\200\\101' > " path)]))
      (receive ([:proc-closed ^p _] :done) (after test/*wait-ms* :timeout))))

  (test "slurp throws on a non-UTF-8 file but slurp-bytes reads its bytes"
    (let (path (path/join (sb-tmp) "blob.bin"))
      (sb-write-binary path)
      (assert-error (file/slurp path))
      (assert= (into [] (file/slurp-bytes path)) [255 128 65])))

  (test "hashing a binary file matches the OS sha256 (printf '\\377\\200\\101')"
    ;; printf '\377\200\101' | sha256sum
    (let (path (path/join (sb-tmp) "blob2.bin"))
      (sb-write-binary path)
      (assert= "93a574562e1a3a9d1d3532381b3e3fab4679e0a1fd5de5794e91e8ddee34cca9"
        (hash/sha256-bytes (file/slurp-bytes path)))
      ;; and the raw-byte digest agrees (hex of it == the hex digest)
      (assert= "93a574562e1a3a9d1d3532381b3e3fab4679e0a1fd5de5794e91e8ddee34cca9"
        (encoding/hex-encode-bytes (hash/sha256-raw (file/slurp-bytes path)))))))

(describe "spit-bytes: byte-faithful file writes (the write side of slurp-bytes)"
  (test "round-trips a bytes value (file/spit accepts it too — ADR-139 iolists)"
    (let (p (path/join (sb-tmp) "w.bin")
          data (string/->bytes "PNG\0\1\2 héllo ☃"))
      ;; Since ADR-139 every write boundary takes an iolist, so plain `spit`
      ;; writes a bytes value byte-faithfully as well — same file either way.
      (file/spit p data)
      (assert= (file/slurp-bytes p) data)
      (file/spit-bytes p data)
      (assert= (file/slurp-bytes p) data)))

  (test "writes non-UTF-8 bytes directly — no printf subprocess needed"
    (let (p (path/join (sb-tmp) "raw.bin"))
      ; 0xFF 0x80 is not valid UTF-8
      (file/spit-bytes p [255 128 65])
      ; so slurp can't read it back
      (assert-error (file/slurp p))
      (assert= (into [] (file/slurp-bytes p)) [255 128 65])
      ;; byte-for-byte faithful: the digest matches the OS sha256 of those bytes
      (assert= "93a574562e1a3a9d1d3532381b3e3fab4679e0a1fd5de5794e91e8ddee34cca9"
        (hash/sha256-bytes (file/slurp-bytes p)))))

  (test "accepts a bytes value, a vector, or a list of byte ints alike"
    (let (p (path/join (sb-tmp) "seq.bin"))
      ; a list → "hi"
      (file/spit-bytes p (list 104 105))
      (assert= (file/slurp p) "hi")
      ; a vector → "hi"
      (file/spit-bytes p [104 105])
      (assert= (file/slurp p) "hi")
      ; a bytes value → "hi"
      (file/spit-bytes p (string/->bytes "hi"))
      (assert= (file/slurp p) "hi")))

  (test "a byte int out of 0–255 range is rejected, not silently truncated"
    (assert-error (file/spit-bytes (path/join (sb-tmp) "bad.bin") [256])))

  (test "replaces an existing file rather than appending"
    (let (p (path/join (sb-tmp) "over.bin"))
      (file/spit-bytes p (string/->bytes "longer first write"))
      (file/spit-bytes p (string/->bytes "short"))
      (assert= (file/slurp p) "short"))))

(describe "slurp-bytes-from: reading what was appended since the last read (ADR-781)"
  (test "reads from an offset to the end, or at most limit bytes"
    (let (p (path/join (sb-tmp) "log.txt"))
      (file/spit p "one\ntwo\n")
      (assert= (string/bytes-> (file/slurp-bytes-from p 4)) "two\n")
      (assert= (string/bytes-> (file/slurp-bytes-from p 0 3)) "one")
      (assert= (string/bytes-> (file/slurp-bytes-from p 4 100)) "two\n")))

  (test "a follower reads only what was appended after its offset"
    (let (p (path/join (sb-tmp) "journal.jsonl"))
      (file/spit p "{\"a\":1}\n")
      (let (end (count (file/slurp-bytes p)))
        (file/spit-append p "{\"b\":2}\n")
        (assert= (string/bytes-> (file/slurp-bytes-from p end)) "{\"b\":2}\n"))))

  (test "an offset at or past the end reads empty bytes; a missing file reads nil"
    (let (dir (sb-tmp)
          p (path/join dir "short.txt"))
      (file/spit p "abc")
      (assert= (count (file/slurp-bytes-from p 3)) 0)
      (assert= (count (file/slurp-bytes-from p 99)) 0)
      (is (nil? (file/slurp-bytes-from (path/join dir "missing.txt") 0)))))

  (test "a byte offset can split a character; the bytes are faithful"
    (let (p (path/join (sb-tmp) "utf8.txt"))
      ; 'é' is the two bytes 195 169
      (file/spit p "é")
      (assert= (into [] (file/slurp-bytes-from p 1)) [169])))

  (test "a negative offset or limit is refused"
    (let (p (path/join (sb-tmp) "n.txt"))
      (file/spit p "abc")
      (assert-error (file/slurp-bytes-from p -1))
      (assert-error (file/slurp-bytes-from p 0 -1)))))
