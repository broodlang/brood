;; The editor framework's buffer model (M2 Phase 1, ADR-045): the immutable
;; buffer value + pure point/mark/region/movement/editing ops, plus the thin
;; `spawn-buffer` actor shell (`editor/buffer-server`). Pure Brood over the rope primitives — opt-in
;; (`require 'buffer`), never in the prelude.
;;
;; Register-only — discovered and run by `nest test` (and cargo test, via
;; crates/lisp/tests/suite.rs). The whole suite runs in parallel (each test a
;; process); the final :isolated block adds explicit spawn/send/receive coverage
;; of the actor shell — and proves a buffer's rope stays inside its process.

(defmodule buffer-test
  (:use test)
  (:use-internals editor/buffer)
  (:use-internals editor/undo-region)
  (:use editor/buffer-server)
  (:use editor/buffer-file))

;; The buffer-as-log-sink integration test drives a real logger; `log` and
;; `gen` (for `call`, to flush the logger's casts before asserting) are
;; auto-required by the qualified `log/…` / `gen/…` references below.
;; Drop any fixtures a prior run left in /tmp (at load, before any test runs).
(purge-stale-temp "brood-buf-")
(purge-stale-temp "brood-revert-")

(describe "buffer construction & reads"
  (test "make-buffer"
    (let (b (make-buffer "hello world"))
      (is (buffer? b))
      (assert= (buffer-text b) "hello world")
      (assert= (buffer-point b) 0)
      (assert= (buffer-mark b) nil)
      (assert= (buffer-name b) "*scratch*")
      (assert= (buffer-file b) nil)
      (assert= (buffer-length b) 11)))
  (test "buffer-moved?: a point or text change, not a mark or a no-op"
    (let (b (make-buffer "hello world"))
      (is (not (buffer-moved? b b)))
      (is (not (buffer-moved? b (set-mark b))))
      (is (buffer-moved? b (forward-char b)))
      (is (buffer-moved? b (insert b "x")))))
  (test "make-buffer with name and file"
    (let (b (make-buffer "x" "notes" "/tmp/notes.txt"))
      (assert= (buffer-name b) "notes")
      (assert= (buffer-file b) "/tmp/notes.txt")))
  (test "buffer? rejects non-buffers"
    (refute (buffer? "hello"))
    (refute (buffer? {:rope "not-a-rope"}))
    (refute (buffer? 3)))
  ;; A buffer is a record: its type is its IDENTITY, so `buffer?` can't be fooled by a
  ;; map carrying a real rope under `:rope` (the old structural test accepted exactly
  ;; that), and a buffer is never `=` to a look-alike map.
  (test "buffer? is an identity check, not a shape check"
    (refute (buffer? {:rope (text/string-> "hello") :point 0 :mark nil}))
    (assert= (record-id (make-buffer "x")) :editor/buffer/buffer)
    (is (record? (make-buffer "x"))))
  (test "the identity survives every op that threads the buffer"
    (is (buffer? (insert (make-buffer "ab") "c")))
    (is (buffer? (goto-char (make-buffer "ab") 1)))
    (is (buffer? (undo (insert (make-buffer "ab") "c"))))
    (is (buffer? (set-mark (make-buffer "ab")))))
  (test "a buffer displays as a short identification, never its text"
    (assert= (->string (make-buffer "hello world")) "#<buffer *scratch* 11 chars>")
    (assert= (->string (make-buffer "x" "notes")) "#<buffer notes 1 chars>")
    (is (not (includes? (->string (make-buffer "secret")) "secret"))))
  (test "inspect adds the debugging detail"
    (let (b (set-mark (goto-char (make-buffer "hello" "notes" "/tmp/n.txt") 3)))
      (assert= (inspect b) "#<buffer notes 5 chars point=3 mark=3 file=/tmp/n.txt>")))
  (test "line reads"
    (let (b (make-buffer "alpha\nbeta\ngamma"))
      (assert= (buffer-line-count b) 3)
      (assert= (buffer-line-at b 0) "alpha\n")
      (assert= (buffer-line-at b 2) "gamma")))
  (test "char-after / char-before at the edges"
    (let (b (goto-char (make-buffer "abc") 1))
      (assert= (buffer-char-after b) "b")
      (assert= (buffer-char-before b) "a"))
    ; point 0
    (assert= (buffer-char-before (make-buffer "abc")) nil)
    (assert= (buffer-char-after (end-of-buffer (make-buffer "abc"))) nil)))

; ends "bar" before ')'
(describe "buffer movement"
  (test "goto-char clamps to [0, length]"
    (let (b (make-buffer "abc"))
      (assert= (buffer-point (goto-char b 2)) 2)
      (assert= (buffer-point (goto-char b 99)) 3)
      (assert= (buffer-point (goto-char b -5)) 0)))
  (test "forward/backward-char clamp"
    (let (b (goto-char (make-buffer "abcde") 2))
      (assert= (buffer-point (forward-char b)) 3)
      (assert= (buffer-point (forward-char b 10)) 5)
      (assert= (buffer-point (backward-char b)) 1)
      (assert= (buffer-point (backward-char b 10)) 0)))
  ; just before the newline
  (test "beginning/end-of-line"
    (let (b (goto-char (make-buffer "ab\ncde\nf") 4))
      ; on 'd' in line 1
      (assert= (buffer-point (beginning-of-line b)) 3)
      (assert= (buffer-point (end-of-line b)) 6)))
  (test "beginning/end-of-buffer"
    (let (b (make-buffer "abcde"))
      (assert= (buffer-point (end-of-buffer b)) 5)
      (assert= (buffer-point (beginning-of-buffer (end-of-buffer b))) 0)))
  (test "current-line and column"
    (let (b (goto-char (make-buffer "line0\nline1\nline2") 14))
      ; line 2, col 2
      (assert= (buffer-current-line b) 2)
      (assert= (buffer-column b) 2)))
  ; col 2 of "world" = 'r'
  (test "forward-line preserves the column when the line is long enough"
    (let (b (-> (make-buffer "hello\nworld\nhi") (goto-char 2) (forward-line 1)))
      (assert= (buffer-current-line b) 1)
      (assert= (buffer-column b) 2)))
  ; "hi" is only 2 long → column 2 (end)
  (test "forward-line clamps the column to a short target line"
    (let (b (-> (make-buffer "hello\nhi") (goto-char 4) (forward-line 1)))
      (assert= (buffer-current-line b) 1)
      (assert= (buffer-column b) 2)))
  (test "forward/backward-line clamp to the line range"
    (let (b (make-buffer "a\nb\nc"))
      (assert= (buffer-current-line (forward-line b 99)) 2)
      (assert= (buffer-current-line (backward-line (end-of-buffer b) 99)) 0)))
  ; at end, stays
  (test "forward-word moves to the end of the next word"
    (let (b (make-buffer "foo bar  baz"))
      ; end of "foo"
      (assert= (buffer-point (forward-word b)) 3)
      ; end of "bar"
      (assert= (buffer-point (forward-word (forward-word b))) 7)
      (assert= (buffer-point (forward-word (goto-char b 12))) 12)))
  ; at start, stays
  (test "backward-word moves to the start of the previous word"
    (let (b (goto-char (make-buffer "foo bar  baz") 12))
      ; end of "baz"
      ; start of "baz"
      (assert= (buffer-point (backward-word b)) 9)
      ; start of "bar"
      (assert= (buffer-point (backward-word (backward-word b))) 4)
      (assert= (buffer-point (backward-word (goto-char b 0))) 0)))
  (test "a qualified name is two words: `/` is a delimiter for M-f/M-b and M-d/M-DEL"
    (let (b (make-buffer "(math/floor x)"))
      ; end of "math"
      (assert= (buffer-point (forward-word b)) 5)
      ; end of "floor"
      (assert= (buffer-point (forward-word (forward-word b))) 11)
      ; from after "floor": back to its start, then to the start of "math"
      (assert= (buffer-point (backward-word (goto-char b 11))) 6)
      (assert= (buffer-point (backward-word (backward-word (goto-char b 11)))) 1)))
  (test "word motion crosses lines and delimiters"
    (let (b (make-buffer "(foo\n bar)"))
      ; skips '(', ends "foo"
      (assert= (buffer-point (forward-word b)) 4)
      (assert= (buffer-point (forward-word (forward-word b))) 9))))
(describe "back-to-indentation (M-m)"
  (test "point lands on the line's first non-whitespace character"
    (let (b (make-buffer "  hi\nthere"))
      (assert= (buffer-point (back-to-indentation b)) 2)
      ; from anywhere on the line
      (assert= (buffer-point (back-to-indentation (goto-char b 4))) 2)))
  (test "an all-whitespace line lands at its end"
    (assert= (buffer-point (back-to-indentation (make-buffer "   \nx"))) 3))
  (test "an unindented line is a no-op at the line's start"
    (assert= (buffer-point (back-to-indentation (goto-char (make-buffer "hi\nthere") 1))) 0)))

(describe "buffer editing is immutable"
  (test "insert advances point; the original is untouched"
    (let (b (goto-char (make-buffer "hello world") 5))
      (let (b2 (insert b ","))
        (assert= (buffer-text b2) "hello, world")
        (assert= (buffer-point b2) 6)
        ; original unchanged
        (assert= (buffer-text b) "hello world")
        (assert= (buffer-point b) 5))))
  (test "delete-char removes after point; point stays"
    (let (b (goto-char (make-buffer "hello") 1))
      (assert= (buffer-text (delete-char b)) "hllo")
      (assert= (buffer-point (delete-char b)) 1)
      (assert= (buffer-text (delete-char b 3)) "ho")))
  (test "delete-backward-char removes before point; point moves back"
    (let (b (goto-char (make-buffer "hello") 3))
      (assert= (buffer-text (delete-backward-char b)) "helo")
      (assert= (buffer-point (delete-backward-char b)) 2)
      (assert= (buffer-text (delete-backward-char b 2)) "hlo")))
  (test "edits at the buffer edges clamp safely"
    (assert= (buffer-text (delete-char (end-of-buffer (make-buffer "ab")))) "ab")
    (assert= (buffer-text (delete-backward-char (make-buffer "ab"))) "ab")))

(describe "read-only buffers"
  (test "fresh buffers are writable; set-read-only / read-only? round-trip"
    (let (b (make-buffer "hi"))
      (refute (read-only? b))
      (is (read-only? (set-read-only b true)))
      (refute (read-only? (set-read-only (set-read-only b true) false)))))
  (test "every text mutator refuses a read-only buffer"
    (let (b (set-read-only (goto-char (set-mark (make-buffer "hello")) 5) true))
      ;; mark at 0, point at 5 → a non-empty region for delete-region
      (assert-error (insert b "x"))
      (assert-error (delete-char b))
      (assert-error (delete-backward-char b))
      (assert-error (delete-region b))
      (assert-error (replace-region b 0 1 "X"))))
  (test "construction and movement still work while read-only"
    (let (b (set-read-only (make-buffer "hello world") true))
      ;; make-buffer built the text before the flag; navigation never checks it
      (assert= (buffer-text b) "hello world")
      (assert= (buffer-point (forward-word b)) 5)
      (assert= (buffer-point (end-of-buffer b)) 11)))
  (test "clearing read-only restores editing"
    (let (b (set-read-only (make-buffer "ab") true))
      (assert= (buffer-text (insert (set-read-only b false) "!")) "!ab"))))

(describe "partial read-only (protected spans)"
  ;; a FORM buffer: chars 0..2 and 7..9 generated (protected), 3..6 the editable gap
  (defn form () (set-read-only-spans (make-buffer "0123456789") [[0 3] [7 10]]))

  (test "spans round-trip, clamp to length, drop empties, and clear"
    (let (b (set-read-only-spans (make-buffer "0123456789") [[0 3] [99 200] [5 5] [8 10]]))
      (assert= (read-only-spans b) (list [0 3] [8 10])) ; out-of-range clamps to [10 10]→dropped, [5 5] empty→dropped
      (assert= (read-only-spans (set-read-only-spans b ())) ())))

  (test "editing the gap works; editing a protected span is refused"
    (let (b (form))
      (is (buffer? (insert (goto-char b 5) "X"))) ; interior of the gap: fine
      (assert-error (insert (goto-char b 1) "X")) ; interior of a protected span: no
      (assert-error (delete-char (goto-char b 1))) ; delete a protected char: no
      (assert-error (delete-backward-char (goto-char b 2))))) ; backspace over one: no
  (test "backspacing the gap's first char over the protected edge is refused (the box-start case)"
    ;; point at the gap start (3): the char before (2) is generated — backspace must not eat it
    (assert-error (delete-backward-char (goto-char (form) 3)))
    ;; forward-deleting the char AT the gap end edge (7) is a protected char too
    (assert-error (delete-char (goto-char (form) 7))))

  (test "insert at a PROTECTED buffer edge is refused (no editable text to grow into)"
    ;; span [0 3) reaches the buffer start; span [7 10) reaches the end — inserting at
    ;; either extreme would prepend/append to the generated text, so it is refused
    (assert-error (insert (goto-char (form) 0) "X"))
    (assert-error (insert (goto-char (form) 10) "X")))

  (test "insert at an editable buffer edge is allowed"
    ;; the gap itself reaches an edge: chars 0..9 editable, so position 0 is writable
    (let (b (set-read-only-spans (make-buffer "0123456789") [[4 7]]))
      (is (buffer? (insert (goto-char b 0) "X")))
      (is (buffer? (insert (goto-char b 10) "X")))))

  (test "insert AT a span edge lands in the gap, not the protected text (inward gravity)"
    (let (b (form)
          left (insert (goto-char b 3) "L") ; at the gap's left edge
          right (insert (goto-char b 7) "R"))
      ; at the gap's right edge
      (assert= (buffer-text left) "012L3456789")
      (assert= (buffer-text right) "0123456R789")
      ;; the left protected span is untouched; the right one slid past the insert
      (assert= (read-only-spans left) (list [0 3] [8 11]))
      (assert= (read-only-spans right) (list [0 3] [8 11]))
      ;; and the inserted char is itself editable — a second edit beside it is allowed
      (is (buffer? (insert (goto-char left 4) "!")))))

  (test "spans slide with an edit in the gap, staying correct without recomputation"
    (let (b (insert (goto-char (form) 5) "XY"))
      (assert= (buffer-text b) "01234XY56789")
      (assert= (read-only-spans b) (list [0 3] [9 12])))) ; right span moved +2, left unchanged
  (test "a delete confined to the gap slides later spans left"
    (let (b (delete-region (goto-char (set-mark (goto-char (form) 4)) 6)))
      ; delete [4 6)
      (assert= (buffer-text b) "01236789")
      (assert= (read-only-spans b) (list [0 3] [5 8]))))

  (test "undo reverts the protected spans in lockstep with the text"
    (let (b (insert (goto-char (form) 5) "X")
          u (undo b))
      (assert= (buffer-text u) "0123456789")
      (assert= (read-only-spans u) (list [0 3] [7 10]))))

  (test "position-read-only? answers per char; a gap position is writable"
    (let (b (form))
      (is (position-read-only? b 1))
      (refute (position-read-only? b 3)) ; the gap's first char
      (refute (position-read-only? b 6))
      (is (position-read-only? b 8))))

  (test "the whole-buffer flag still wins over the gap"
    (let (b (set-read-only (form) true))
      (assert-error (insert (goto-char b 5) "X")))) ; even the editable gap is frozen
  (test "typing refills a gap emptied down to zero width (two spans touching, not one)"
    ;; delete the whole gap [3 7): the two protected spans now MEET at 3 — but that junction
    ;; is a zero-width editable region, not one span's interior, so an insert there is allowed
    (let (empty (delete-region (assoc (goto-char (form) 3) :mark 7)))
      (assert= (buffer-text empty) "012789")
      (assert= (read-only-spans empty) (list [0 3] [3 6])) ; adjacent, touching at 3
      (let (refilled (insert (goto-char empty 3) "NEW"))
        (assert= (buffer-text refilled) "012NEW789")
        (assert= (read-only-spans refilled) (list [0 3] [6 9]))))) ; NEW is editable between them
  (test "but the interior of a single span stays refused"
    (assert-error (insert (goto-char (form) 8) "X"))) ; strictly inside [7 10)
  (test "a refusal is a structured error tagged :kind :read-only (not just a message)"
    ;; so a caller degrades a refusal to a no-op by matching the kind, never the wording
    (let (e (try (do (insert (goto-char (form) 8) "X") nil) (catch e e)))
      (assert= (:kind e) :read-only)
      (assert= (error-message e) "text is read-only"))
    (let (e (try (do (insert (set-read-only (make-buffer "hi") true) "x") nil) (catch e e)))
      (assert= (:kind e) :read-only)))) ; whole-buffer read-only carries the same kind
(describe "buffer mark & region"
  (test "set-mark / region / clear-mark"
    (let (b (-> (make-buffer "abcdef") (goto-char 1) set-mark (goto-char 4)))
      (assert= (buffer-mark b) 1)
      (assert= (buffer-region b) "bcd")
      (assert= (buffer-mark (clear-mark b)) nil)))
  (test "region works regardless of point/mark order"
    (let (b (-> (make-buffer "abcdef") (goto-char 4) set-mark (goto-char 1)))
      (assert= (buffer-region b) "bcd")))
  (test "no region without a mark"
    (assert= (buffer-region (make-buffer "abc")) nil))
  (test "delete-region removes between point and mark, clears mark, point to start"
    (let (b (-> (make-buffer "abcdef") (goto-char 1) set-mark (goto-char 4) delete-region))
      (assert= (buffer-text b) "aef")
      (assert= (buffer-point b) 1)
      (assert= (buffer-mark b) nil)))
  (test "delete-region is a no-op without a mark"
    (assert= (buffer-text (delete-region (make-buffer "abc"))) "abc"))
  (test "buffer-region-bounds gives [lo hi], order-independent, nil without a mark"
    (assert= (buffer-region-bounds (make-buffer "abc")) nil)
    (assert= (buffer-region-bounds (-> (make-buffer "abcdef") (goto-char 1) set-mark (goto-char 4)))
      [1 4])
    (assert= (buffer-region-bounds (-> (make-buffer "abcdef") (goto-char 4) set-mark (goto-char 1)))
      [1 4]))
  (test "buffer-region-bounds matches the buffer-region span"
    (let (b (-> (make-buffer "abcdef") (goto-char 1) set-mark (goto-char 4))
          [lo hi] (buffer-region-bounds b))
      (assert= (string/substring (buffer-text b) lo hi) (buffer-region b)))))

(describe "replace-region (the splice primitive)"
  ; 6 + len("there")
  (test "replaces [start,end) with the string, point after the insert"
    (let (b (replace-region (make-buffer "hello world") 6 11 "there"))
      (assert= (buffer-text b) "hello there")
      (assert= (buffer-point b) 11)))
  (test "an empty replacement deletes the range"
    (assert= (buffer-text (replace-region (make-buffer "abcdef") 1 4 "")) "aef"))
  (test "an empty range inserts at the point"
    (assert= (buffer-text (replace-region (make-buffer "abc") 1 1 "XY")) "aXYbc")))

(describe "line-wise region ops"
  (test "region-line-range is the current line when there's no mark"
    (assert= (region-line-range (-> (make-buffer "a\nb\nc") (goto-char 2))) [1 1]))
  ; covers lines 0–1
  (test "region-line-range spans the region's lines"
    (assert= (region-line-range (-> (make-buffer "a\nb\nc\nd") (goto-char 0) set-mark (goto-char 4)))
      [0 1]))
  (test "a region ending at a line start doesn't pull that trailing line in"
    ;; "a\nb\nc": mark 0, point 4 = start of line 2 → range is lines 0–1, not 0–2
    (assert= (region-line-range (-> (make-buffer "a\nb\nc") (goto-char 0) set-mark (goto-char 4)))
      [0 1]))
  (test "map-region-lines threads the buffer over each line in range"
    ;; prefix every line of the region with '> '
    (let (
          ; lines 0–1
          b (-> (make-buffer "a\nb\nc") (goto-char 0) set-mark (goto-char 3))
          out (map-region-lines b
                (fn (bb l) (insert (goto-char bb (text/line->char (buffer-rope bb) l)) "> "))))
      (assert= (buffer-text out) "> a\n> b\nc"))))

(describe "buffer mark ring"
  (test "push-mark sets the mark and pushes point onto the ring"
    (let (b (-> (make-buffer "abcdef") (goto-char 3) push-mark))
      (assert= (buffer-mark b) 3)
      (assert= (get b :mark-ring) (list 3))))
  ; ring cycles
  (test "pop-mark moves point to the newest ring entry, rotating it to the back"
    (let (b (-> (make-buffer "abcdef")
              (goto-char 2)
              push-mark
              (goto-char 5)
              push-mark
              (goto-char 0))
          p1 (pop-mark b))
      ; newest mark first
      (assert= (buffer-point p1) 5)
      ; then the older one
      (assert= (buffer-point (pop-mark p1)) 2)
      (assert= (buffer-point (pop-mark (pop-mark p1))) 5)))
  (test "pop-mark is a no-op on an empty ring"
    (assert= (buffer-point (pop-mark (goto-char (make-buffer "abc") 1))) 1)))

(describe "buffer search"
  (test "buffer-search-forward finds the first match at or after `from`"
    (let (b (make-buffer "abc abc"))
      (assert= (buffer-search-forward b "abc" 0) 0)
      (assert= (buffer-search-forward b "abc" 1) 4)
      (assert= (buffer-search-forward b "zzz" 0) nil)))
  (test "buffer-search-backward finds the last match before `before`"
    (let (b (make-buffer "abc abc"))
      (assert= (buffer-search-backward b "abc" 7) 4)
      (assert= (buffer-search-backward b "abc" 4) 0)
      (assert= (buffer-search-backward b "abc" 0) nil)
      (assert= (buffer-search-backward b "zzz" 7) nil))))

(defn- undo-limit-type-chars (buffer n)
  "`buffer` with `n` single-char inserts, each its own undo step."
  (fold (range n) buffer (fn (acc _) (insert acc "x"))))

(describe "buffer undo limit"
  (test "each step is priced once the next is pushed, and the size is their sum"
    (let (b (undo-limit-type-chars (make-buffer "") 3)
          history (get b :undo))
      (assert= (count history) 3)
      (assert= (get (first history) :cost) nil)
      (assert= (vec (map (rest history) :cost)) [1025 1025])
      (assert= (get b :undo-size) 2050)))
  (test "a large step costs the text it changed"
    (let (b (-> (make-buffer "") (insert (string/repeat "y" 5000)) (insert "z")))
      (assert= (get (second (get b :undo)) :cost) (+ 1024 5000))))
  (test "past the strong limit the oldest steps go until the rest fits the limit"
    (binding (editor/buffer/*undo-limit* 3000 editor/buffer/*undo-strong-limit* 5000)
      (let (b (undo-limit-type-chars (make-buffer "") 40))
        (is (<= (get b :undo-size) 5000))
        (is (< (count (get b :undo)) 8))
        ;; undo still walks back as far as what was kept, one char per step
        (let (oldest (fold (range (count (get b :undo)))
                       (undo-start b)
                       (fn (acc _) (undo-next acc))))
          (assert= (buffer-length oldest) (- 40 (count (get b :undo))))))))
  (test "the size the trim leaves is the recount of what it kept"
    (binding (editor/buffer/*undo-limit* 3000 editor/buffer/*undo-strong-limit* 5000)
      (let (b (undo-limit-type-chars (make-buffer "") 40))
        (assert= (get b :undo-size)
          (fold (get b :undo) 0 (fn (acc snapshot) (+ acc (or (get snapshot :cost) 0))))))))
  (test "a trim drops whole groups: every kept state is between two groups"
    (binding (editor/buffer/*undo-limit* 3000 editor/buffer/*undo-strong-limit* 5000)
      (let (b (fold (range 30)
                (make-buffer "")
                (fn (acc _) (undo-group acc (fn (inner) (insert (insert inner "a") "b"))))))
        (is (< (count (get b :undo)) 30))
        (is (every? (get b :undo) (fn (snapshot) (math/even? (count (get snapshot :rope))))))
        (assert= (buffer-text (undo b)) (string/repeat "ab" 29)))))
  (test "the newest step is kept whatever it costs"
    (binding (editor/buffer/*undo-limit* 0 editor/buffer/*undo-strong-limit* 0)
      (let (b (undo-limit-type-chars (make-buffer "") 10))
        (assert= (count (get b :undo)) 1)
        (assert= (buffer-text (undo b)) "xxxxxxxxx"))))
  (test "a group's own trim leaves the outer undo run alone"
    ;; a run in progress, then a group whose own edits pass the strong limit: the group's
    ;; trim drops ITS steps, which were never the outer run's
    (let (b (undo-limit-type-chars (make-buffer "") 2)
          running (undo-next (undo-start b))
          grouped (binding (editor/buffer/*undo-limit* 5000 editor/buffer/*undo-strong-limit* 5000)
                    (undo-group running
                      (fn (inner) (fold (range 10) inner (fn (acc _) (insert acc "y")))))))
      (is (> (count (get running :pending-undo)) 0))
      (assert= (count (get grouped :pending-undo)) (count (get running :pending-undo)))))
  (test "a region undo whose record trims keeps the size the recount of its history"
    ;; the region is the LAST line: the consumed change is the head, and the rest of the
    ;; history is what the record's trim cut
    (let (b (fold (range 8) (make-buffer "") (fn (acc _) (insert acc "x\n")))
          length (buffer-length b)
          region (binding (editor/buffer/*undo-limit* 3100 editor/buffer/*undo-strong-limit* 3100)
                   (undo-in-region (assoc b :mark (- length 2) :point length))))
      (assert= (buffer-text region) "x\nx\nx\nx\nx\nx\nx\n")
      (is (< (count (get region :undo)) (count (get b :undo))))
      (assert= (get region :undo-size)
        (fold (get region :undo) 0 (fn (acc snapshot) (+ acc (or (get snapshot :cost) 0)))))))
  (test "an undo run in progress loses the same oldest steps"
    (let (b (undo-limit-type-chars (make-buffer "") 20)
          running (undo-next (undo-start b))
          trimmed (binding (editor/buffer/*undo-limit* 3000 editor/buffer/*undo-strong-limit* 3000)
                    (trim-undo running)))
      (is (< (count (get trimmed :undo)) (count (get running :undo))))
      (is (<= (count (get trimmed :pending-undo)) (count (get trimmed :undo))))
      ;; walking the rest of the run lands on states the trimmed history still holds
      (let (walked (fold (range 30) trimmed (fn (acc _) (undo-next acc))))
        (is (includes? (map (get walked :undo) buffer-text) (buffer-text walked))))))
  (test "a strong limit below the limit is read as the limit"
    (binding (editor/buffer/*undo-limit* 5000 editor/buffer/*undo-strong-limit* 1000)
      (let (b (undo-limit-type-chars (make-buffer "") 40))
        (is (<= (get b :undo-size) 5000))
        ;; the history fills to the limit and stays there, rather than being cut to nothing
        (is (>= (count (get b :undo)) 4)))))
  (test "a nil limit keeps everything"
    (binding (editor/buffer/*undo-limit* nil)
      (assert= (count (get (undo-limit-type-chars (make-buffer "") 50) :undo)) 50)))
  (test "disabling undo zeroes the size"
    (assert= (get (disable-undo (undo-limit-type-chars (make-buffer "") 3)) :undo-size) 0)))

; amalgamated: one step
(describe "buffer undo (tree)"
  (test "undo restores the text and point before the last edit"
    (let (b (-> (make-buffer "hello") (goto-char 5) (insert "!"))
          u (undo b))
      (assert= (buffer-text b) "hello!")
      (assert= (buffer-text u) "hello")
      (assert= (buffer-point u) 5)))
  ; undo, then undo-the-undo = redo
  (test "undoing an undo redoes it (undo is itself recorded — the tree)"
    ;; `undo` always begins a fresh run, so a second standalone undo reverses direction.
    (let (b (-> (make-buffer "hi") end-of-buffer (insert "!")))
      (assert= (buffer-text (undo b)) "hi")
      (assert= (buffer-text (-> b undo undo)) "hi!")))
  ; fresh run now redoes
  (test "undo-start + undo-next walk groups; a fresh start reverses direction (redo)"
    (let (
          ; 3 separate edits
          b (-> (make-buffer "") (insert "a") (insert "b") (insert "c"))
          ; -> "ab"
          back1 (undo-next (undo-start b))
          ; continue -> "a"
          back2 (undo-next back1)
          back3 (undo-next back2))
      ; continue -> ""
      (assert= (buffer-text back1) "ab")
      (assert= (buffer-text back2) "a")
      (assert= (buffer-text back3) "")
      (assert= (buffer-text (undo-next (undo-start back3))) "a")))
  ; "ab" still in history
  (test "no state is lost: an edit after undo leaves the old branch reachable"
    (let (
          ; "ab"
          b (-> (make-buffer "") (insert "a") (insert "b"))
          ; "a" (undid "b")
          u (undo b)
          branched (insert u "z"))
      ; "az" — a new branch
      (assert= (buffer-text branched) "az")
      (is (includes? (map (get branched :undo) buffer-text) "ab"))))
  (test "undo with no history is a no-op"
    (assert= (buffer-text (undo (make-buffer "abc"))) "abc"))
  ; undo reaches the real edit
  (test "a no-op edit records nothing (undo skips past it)"
    (let (b (-> (make-buffer "ab") (insert "X"))
          noop (delete-char (end-of-buffer b)))
      ; delete at end → unchanged
      (assert= (buffer-text noop) "Xab")
      (assert= (buffer-text (undo noop)) "ab")))
  (test "undoing a region delete restores the text and the mark"
    (let (b (-> (make-buffer "abcdef") (goto-char 1) set-mark (goto-char 4) delete-region)
          u (undo b))
      (assert= (buffer-text b) "aef")
      (assert= (buffer-text u) "abcdef")
      (assert= (buffer-mark u) 1)
      (assert= (buffer-point u) 4)))
  ; undoing `a` left `c` untouched
  (test "two buffers keep independent histories"
    (let (a (-> (make-buffer "") (insert "a"))
          c (-> (make-buffer "") (insert "c")))
      (assert= (buffer-text (undo a)) "")
      (assert= (buffer-text c) "c")))
  (test "disable-undo stops recording (a log buffer), so undo is a no-op"
    (let (b (-> (disable-undo (make-buffer "")) (insert "a") (insert "b")))
      (assert= (buffer-text b) "ab")
      ; nothing recorded
      (assert= (get b :undo) ())
      (assert= (buffer-text (undo b)) "ab")))
  (test "amalgamate-undo merges the next edit into the current group (one undo step)"
    ;; by default each insert is its own step (undo → \"a\"); amalgamate-undo before the
    ;; second insert coalesces the run so one undo reverses both.
    (let (per-op (-> (make-buffer "") (insert "a") (insert "b"))
          merged (-> (make-buffer "") (insert "a") amalgamate-undo (insert "b")))
      ; default: per-op
      (assert= (buffer-text (undo per-op)) "a")
      (assert= (buffer-text (undo merged)) ""))))
(describe "buffer file round-trip"
  (test "buffer-from-file reads, save-buffer writes back"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "first line\nsecond line\n")
      (let (b (buffer-from-file path))
        (assert= (buffer-text b) "first line\nsecond line\n")
        (assert= (buffer-file b) path)
        ; edit and save, then re-read to confirm it persisted
        (save-buffer (-> b end-of-buffer (insert "third line\n")))
        (assert= (buffer-text (buffer-from-file path))
          "first line\nsecond line\nthird line\n"))))
  ;; The mtime stamp: a buffer remembers when its text and its file last agreed, so an
  ;; editor can notice another writer (a formatter, `git checkout`) on an idle beat.
  (test "a read and a save stamp the file's mtime; a later write on disk shows as changed"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "v1\n")
      (let (b (buffer-from-file path)
            stamp (or (get b :file-mtime) (error "buffer-from-file did not stamp :file-mtime")))
        (assert= stamp (file/mtime path))
        (is (not (buffer-file-changed? b)))
        ;; the file written since (an older stamp stands in for the clock having moved)
        (is (buffer-file-changed? (assoc b :file-mtime (dec stamp))))
        ;; a save re-stamps: the returned buffer agrees with the file again
        (let (saved (save-buffer (-> (assoc b :file-mtime 1) end-of-buffer (insert "v2\n"))))
          (assert= (get saved :file-mtime) (file/mtime path))
          (is (not (buffer-file-changed? saved)))))))
  ;; Line endings: the text has bare newlines, the file keeps the ones it had.
  (test "a CRLF file reads with bare newlines and saves with CRLF again"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "one\r\ntwo\r\n")
      (let (b (buffer-from-file path))
        (assert= (buffer-text b) "one\ntwo\n")
        (assert= (buffer-eol b) :crlf)
        (save-buffer (-> b end-of-buffer (insert "three\n")))
        (assert= (file/slurp path) "one\r\ntwo\r\nthree\r\n"))))
  (test "an LF file stays LF, and a file mixing the two is written back byte for byte"
    (let (lf-path (str (temp-dir "brood-buf-") ".txt")
          mixed-path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit lf-path "a\nb\n")
      (file/spit mixed-path "a\r\nb\n")
      (let (lf (buffer-from-file lf-path)
            mixed (buffer-from-file mixed-path))
        (assert= (buffer-eol lf) :lf)
        (assert= (buffer-eol mixed) :lf)
        (assert= (buffer-text mixed) "a\r\nb\n")
        (save-buffer lf)
        (save-buffer mixed)
        (assert= (file/slurp lf-path) "a\nb\n")
        (assert= (file/slurp mixed-path) "a\r\nb\n"))))
  ;; Revert: the file's text comes back as one undoable edit, so a revert (or another
  ;; writer's change picked up by auto-revert) never costs the history before it.
  (test "revert-buffer re-reads the file as ONE undoable edit, and is unmodified after"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "v1\n")
      (let (edited (-> (buffer-from-file path) end-of-buffer (insert "mine\n"))
            _ (file/spit path "theirs\n")
            reverted (revert-buffer edited))
        (assert= (buffer-text reverted) "theirs\n")
        (is (not (buffer-modified? reverted)))
        (is (not (buffer-file-changed? reverted)))
        (assert= (get reverted :file-mtime) (file/mtime path))
        ;; one undo: the text before the revert, unsaved edits and all, now modified
        (let (back (undo reverted))
          (assert= (buffer-text back) "v1\nmine\n")
          (is (buffer-modified? back))
          ;; and the history before it is still there: the same undo run, one step further
          (assert= (buffer-text (undo-next (undo-next (undo-start reverted)))) "v1\n")))))
  (test "revert-buffer takes text the caller has decoded"
    (let (path (path/join (temp-dir "brood-revert-") "a.txt"))
      (file/mkdir (path/dirname path))
      (file/spit path "old")
      (assert= (buffer-text (revert-buffer (buffer-from-file path) "new\n")) "new\n")))
  (test "revert-buffer after typing is its own step, not merged into the typing"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "a\n")
      (let (typed (-> (buffer-from-file path)
                    end-of-buffer
                    (insert "b")
                    amalgamate-undo
                    (insert "c"))
            _ (file/spit path "z\n")
            reverted (revert-buffer typed))
        (assert= (buffer-text (undo reverted)) "a\nbc"))))
  (test "revert-buffer of a file that did not change records nothing"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "same\n")
      (let (b (buffer-from-file path)
            reverted (revert-buffer b))
        (assert= (get reverted :undo) (get b :undo))
        (is (not (buffer-modified? reverted))))))
  (test "revert-buffer of a read-only buffer: the text changes, it stays read-only, undo keeps it so"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "old\n")
      (let (b (set-read-only (buffer-from-file path) true)
            _ (file/spit path "new\n")
            reverted (revert-buffer b))
        (assert= (buffer-text reverted) "new\n")
        (is (read-only? reverted))
        (let (back (undo reverted))
          (assert= (buffer-text back) "old\n")
          (is (read-only? back))))))
  (test "revert-buffer takes up the file's line ending as it is now"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "a\nb\n")
      (let (b (buffer-from-file path)
            _ (file/spit path "a\r\nb\r\nc\r\n")
            reverted (revert-buffer b))
        (assert= (buffer-text reverted) "a\nb\nc\n")
        (assert= (buffer-eol reverted) :crlf))))
  (test "revert-buffer raises for a buffer with no file, or a file that is gone"
    (assert= :raised (try (revert-buffer (make-buffer "x")) (catch _e :raised)))
    (assert= :raised
      (try
        (revert-buffer (make-buffer "x" "gone" "/no/such/dir/brood-revert.txt"))
        (catch _e :raised))))
  (test "buffer-from-file takes text already read, decoded and stamped as a read is"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "on disk\r\n")
      (let (b (buffer-from-file path "read once\r\n"))
        (assert= (buffer-text b) "read once\n")
        (assert= (buffer-eol b) :crlf)
        (assert= (buffer-file b) path)
        (assert= (get b :file-mtime) (file/mtime path))
        (is (not (buffer-modified? b))))))
  (test "eol-decode and eol-encode are inverses on a CRLF text"
    (let (decoded (eol-decode "x\r\n\r\ny"))
      (assert= decoded {:text "x\n\ny" :eol :crlf})
      (assert= (eol-encode (:text decoded) :crlf) "x\r\n\r\ny")
      (assert= (eol-decode "") {:text "" :eol :lf})
      (assert= (eol-decode "lone\r") {:text "lone\r" :eol :lf})))
  ;; The byte-order mark: Emacs's utf-8-with-signature — off the text, back on save.
  (test "a file opening with a byte-order mark reads without it and saves with it again"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "\u{feff}one\ntwo\n")
      (let (b (buffer-from-file path))
        (assert= (buffer-text b) "one\ntwo\n")
        (assert= (buffer-length b) 8)
        (is (buffer-bom? b))
        (is (not (buffer-modified? b)))
        (save-buffer (-> b end-of-buffer (insert "three\n")))
        (assert= (file/slurp path) "\u{feff}one\ntwo\nthree\n"))))
  (test "a byte-order mark and CRLF together both go back"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "\u{feff}a\r\nb\r\n")
      (let (b (buffer-from-file path))
        (assert= (buffer-text b) "a\nb\n")
        (is (buffer-bom? b))
        (assert= (buffer-eol b) :crlf)
        (save-buffer b)
        (assert= (file/slurp path) "\u{feff}a\r\nb\r\n"))))
  (test "a file without one gains none, and a mark past the start is text"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "a\u{feff}b\n")
      (let (b (buffer-from-file path))
        (is (not (buffer-bom? b)))
        (assert= (buffer-text b) "a\u{feff}b\n")
        (save-buffer b)
        (assert= (file/slurp path) "a\u{feff}b\n"))))
  (test "revert-buffer takes up the file's byte-order mark as it is now"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "x\n")
      (let (b (buffer-from-file path)
            _ (file/spit path "\u{feff}y\n")
            reverted (revert-buffer b))
        (assert= (buffer-text reverted) "y\n")
        (is (buffer-bom? reverted))
        (file/spit path "z\n")
        (is (not (buffer-bom? (revert-buffer reverted)))))))
  (test "file-text-decode and file-text-encode are inverses"
    (assert= (file-text-decode "\u{feff}x\r\ny") {:text "x\ny" :eol :crlf :bom true})
    (assert= (file-text-encode "x\ny" :crlf true) "\u{feff}x\r\ny")
    (assert= (file-text-decode "") {:text "" :eol :lf :bom false}))
  (test "a buffer with no file, or never stamped, has not changed on disk"
    (is (not (buffer-file-changed? (make-buffer "x"))))
    (is (not (buffer-file-changed? (make-buffer "x" "n" "/nowhere/at/all")))))
  (test "save-buffer with no file raises"
    (assert-error (save-buffer (make-buffer "x"))))
  ;; find-file-buffer: vim/emacs `find-file` — read an existing file, else a fresh
  ;; empty buffer backed by the path (so the first save creates the file).
  (test "find-file-buffer reads an existing file"
    (let (path (str (temp-dir "brood-buf-") ".txt"))
      (file/spit path "hi\n")
      (let (b (find-file-buffer path))
        (assert= (buffer-text b) "hi\n")
        (assert= (buffer-file b) path))))
  (test "find-file-buffer on a missing path is an empty buffer backed by it"
    (let (
          ; temp-dir creates the file…
          path (str (temp-dir "brood-buf-") "-new.txt")
          gone (str path ".absent"))
      ; …so use a path that doesn't exist
      (let (b (find-file-buffer gone))
        ; empty — not an error
        (assert= (buffer-text b) "")
        ; backed by the path, so save creates it
        (assert= (buffer-file b) gone)
        (save-buffer (insert b "made"))
        (assert= (buffer-text (find-file-buffer gone)) "made")))))

;; The actor shell: a buffer process owns its buffer (and process-local rope) and
;; replies only with derived views. Edits/reads cross as closures (ADR-033).
(describe "buffer actor shell"
  :isolated (test "spawn-buffer + edit + query"
    (let (bp (spawn-buffer (make-buffer "hello")))
      (buffer-edit bp (fn (b) (-> b end-of-buffer (insert " world"))))
      (assert= (buffer-query bp buffer-text) "hello world")
      (assert= (buffer-query bp buffer-length) 11)
      (assert= (stop-buffer bp) :stopped)))

  (test "a query returns a derived view (a line string), not the buffer"
    (let (bp (spawn-buffer (make-buffer "line0\nline1")))
      (assert= (buffer-query bp (fn (b) (buffer-line-at b 1))) "line1")
      (stop-buffer bp)))

  (test "spawning preserves point and mark (ships text, rebuilds the rope)"
    (let (src (-> (make-buffer "abcdef") (goto-char 1) set-mark (goto-char 4))
          bp (spawn-buffer src))
      (assert= (buffer-query bp buffer-point) 4)
      (assert= (buffer-query bp buffer-mark) 1)
      (assert= (buffer-query bp buffer-region) "bcd")
      (stop-buffer bp)))

  (test "two buffer processes are independent"
    (let (a (spawn-buffer (make-buffer "aaa"))
          b (spawn-buffer (make-buffer "bbb")))
      (buffer-edit a (fn (buf) (insert buf "!")))
      (assert= (buffer-query a buffer-text) "!aaa")
      (assert= (buffer-query b buffer-text) "bbb")
      (stop-buffer a)
      (stop-buffer b)))

  ;; A buffer process is an `io` sink: `[:write s]` appends. create-buffer /
  ;; stop-buffer are the lifecycle pair. Same-sender ordering makes this exact.
  (test "create-buffer + [:write] appends; stop-buffer stops it"
    (let (bp (create-buffer "*log*"))
      (send bp [:write "hello\n"])
      (send bp [:write "world\n"])
      (assert= (buffer-query bp buffer-text) "hello\nworld\n")
      (assert= (stop-buffer bp) :stopped)))

  ;; The read-then-decide edit: one closure returns [new-buf value] — the buffer is
  ;; replaced AND the caller learns what it read/removed, atomically ordered with
  ;; every other edit. The kill-region shape (delete the region, get its text back).
  (test "buffer-edit-value: delete a span and get its text back in one round-trip"
    (let (bp (spawn-buffer (make-buffer "hello world")))
      (assert= (buffer-edit-value bp
                 (fn (b)
                   [(delete-char (goto-char b 0) 6) (string/substring (buffer-text b) 0 6)]))
        "hello ")
      (assert= (buffer-query bp buffer-text) "world")
      (stop-buffer bp)))

  (test "buffer-edit-reply is totally ordered with a splice sent just before it"
    (let (bp (spawn-buffer (make-buffer "ab")))
      ; async — but same-sender ordered
      (buffer-splice bp 2 2 "cd" nil)
      (assert= (buffer-edit-value bp (fn (b) [b (buffer-text b)])) "abcd")
      (stop-buffer bp)))

  (test "an edit-reply's push carries its origin (the echo-suppression tag)"
    (let (bp (spawn-buffer (make-buffer "x")))
      (subscribe-buffer bp buffer-text)
      ; drain the seed
      (receive ([:buffer-updated _bp _ _ _] nil) (after test/*wait-ms* nil))
      (buffer-edit-value bp :me (fn (b) [(insert b "!") :done]))
      (assert= (receive ([:buffer-updated _bp _ _ o] o) (after test/*wait-ms* :none)) :me)
      (stop-buffer bp)))

  ;; PIPELINED same-origin splices: keystroke 2 is sent before keystroke 1's echo
  ;; folds, so both carry the same base — but the sender's local copy already
  ;; contained splice 1 when it computed splice 2's positions (local-apply-first),
  ;; so the ring transform must SKIP same-origin entries or the second lands one
  ;; column too far (server "axbycd" vs the typist's "axybcd" — the double-shift).
  (test "a based splice is not transformed over the sender's own earlier splices"
    (let (bp (spawn-buffer (make-buffer "abcd")))
      ; local: "axbcd"
      (buffer-splice bp 1 1 "x" :me 0)
      ; local: "axybcd", echo1 not yet folded
      (buffer-splice bp 2 2 "y" :me 0)
      (assert= (buffer-query bp buffer-text) "axybcd")
      ;; …while a DIFFERENT origin's stale-based splice still transforms over :me's
      ; computed against "abcd" → shifts past x,y
      (buffer-splice bp 1 1 "Z" :other 0)
      (assert= (buffer-query bp buffer-text) "axyZbcd")
      (stop-buffer bp)))

  (test "buffer-sync pairs the view with its version atomically"
    (let (bp (spawn-buffer (make-buffer "ab")))
      (buffer-splice bp 2 2 "c" nil)
      (let ([v txt] (buffer-sync bp buffer-text))
        (assert= v 1)
        (assert= txt "abc"))
      (stop-buffer bp)))

  (test "stop-buffer on an already-dead process returns :no-reply, not a hang"
    (let (bp (spawn-buffer (make-buffer "x")) watch (monitor bp))
      (exit bp :kill)
      (assert= (receive ([:down ^watch _ reason] reason) (after test/*wait-ms* :timeout)) :killed)
      (assert= (stop-buffer bp) :no-reply)))

  ;; :write is a structured splice: subscribers get the O(line) DELTA, not their
  ;; full projection — a streamed log buffer stays cheap however large it grows.
  (test "[:write] pushes an end-append splice delta to subscribers"
    (let (bp (spawn-buffer (make-buffer "ab")))
      (subscribe-buffer bp buffer-text)
      ; drain the seed
      (receive ([:buffer-updated _bp _ _ _] nil) (after test/*wait-ms* nil))
      (send bp [:write "cd"])
      (let (view (receive ([:buffer-updated _bp _ v _] v) (after test/*wait-ms* :none)))
        (assert= (get view :splice) [2 2 "cd"]))
      (stop-buffer bp)))

  ;; …and it is RECORDED in the transform ring: a based splice computed before the
  ;; append transforms over it, so a log line landing mid-round-trip can't misplace
  ;; a concurrent edit (an insert at the old end lands after the appended line).
  (test "a based splice computed before an [:write] transforms over the append"
    (let (bp (spawn-buffer (make-buffer "ab")))
      ; v1: "abcd"
      (send bp [:write "cd"])
      ; computed at v0 against "ab": insert at its end
      (buffer-splice bp 2 2 "X" nil 0)
      ; shifted past the append, not "abXcd"
      (assert= (buffer-query bp buffer-text) "abcdX")
      (stop-buffer bp)))

  ;; The point of it all: a std/log process-backend streams log lines into a buffer
  ;; process, no glue. Flush the logger (a query after the casts) before asserting,
  ;; since logging is fire-and-forget.
  (test "a logger process-backend streams log lines into a buffer process"
    (let (bp (create-buffer "*app-log*")
          lg (log/start-logger {:level :info :backends [(log/process-backend bp)]}))
      (log/info "server up")
      (log/warn "disk low")
      ; the logger has now dispatched both casts → bp
      (gen/call lg :config)
      (let (txt (buffer-query bp buffer-text))
        (is (includes? txt "server up"))
        (is (includes? txt "disk low")))
      (log/stop-logger)
      (stop-buffer bp))))

;; Markers — named positions the editing ops keep in sync as text shifts. Pure (no process).
(describe "markers — positions that survive edits"
  ; +2 (insert before it)
  (test "a marker after an insertion point shifts right with the text"
    (let (b (buffer-marker-set (make-buffer "hello world") :m 6))
      ; at "world"
      (assert= (buffer-marker b :m) 6)
      (assert= (buffer-marker (insert (goto-char b 0) "XY") :m) 8)))
  (test "a marker before an insertion point is unchanged"
    (let (b (buffer-marker-set (make-buffer "hello world") :m 2))
      (assert= (buffer-marker (insert (goto-char b 6) "XY") :m) 2)))
  (test "left-gravity: an insert exactly at a marker leaves it put"
    (let (b (buffer-marker-set (make-buffer "abc") :m 1))
      (assert= (buffer-marker (insert (goto-char b 1) "Z") :m) 1)))
  (test "an advancing marker moves past text inserted exactly at it"
    (let (b (buffer-marker-set (make-buffer "abc") :m 1 true))
      (is (buffer-marker-advances? b :m))
      (assert= (buffer-marker (insert (goto-char b 1) "ZZ") :m) 3)
      ;; anywhere else it moves as any marker does
      (assert= (buffer-marker (insert (goto-char b 0) "Z") :m) 2)
      (assert= (buffer-marker (insert (goto-char b 2) "Z") :m) 1)
      (assert= (buffer-marker (delete-char (goto-char b 0) 1) :m) 0)))
  (test "an advancing marker beside a left one: a field's start stays, its end grows"
    (let (b (buffer-marker-set (buffer-marker-set (make-buffer "f()") :start 2) :end 2 true)
          typed (insert (insert (goto-char b 2) "x") "y"))
      (assert= (buffer-text typed) "f(xy)")
      (assert= [(buffer-marker typed :start) (buffer-marker typed :end)] [2 4])))
  (test "the insertion type is the marker's: kept when it moves, changed only when asked"
    (let (b (buffer-marker-set (make-buffer "abcdef") :m 1 true)
          moved (buffer-marker-set b :m 4))
      (is (buffer-marker-advances? moved :m))
      (assert= (buffer-marker (insert (goto-char moved 4) "Z") :m) 5)
      (let (left (buffer-marker-set moved :m 4 false))
        (is (not (buffer-marker-advances? left :m)))
        (assert= (buffer-marker (insert (goto-char left 4) "Z") :m) 4)
        ;; the last one back to left gravity leaves no trace on the buffer
        (is (nil? (get left :marker-advance))))
      (is (not (buffer-marker-advances? (buffer-marker-delete moved :m) :m)))))
  ; delete [0,3)
  (test "a delete before a marker shifts it left by the deleted width"
    (let (b (buffer-marker-set (make-buffer "hello world") :m 8))
      ; "r"
      (assert= (buffer-marker (delete-char (goto-char b 0) 3) :m) 5)))
  ; delete [6,10), 8 inside
  (test "a delete straddling a marker collapses it to the range start"
    (let (b (buffer-marker-set (make-buffer "hello world") :m 8))
      (assert= (buffer-marker (delete-char (goto-char b 6) 4) :m) 6)))
  (test "set / read / delete a marker; buffer-markers lists them"
    (let (b (buffer-marker-set (make-buffer "abcdef") :m 5))
      (assert= (buffer-markers b) {:m 5})
      (is (nil? (buffer-marker (buffer-marker-delete b :m) :m)))))
  ; whole buffer gone
  (test "a marker read is clamped to the current length after a shrinking edit"
    (let (b (buffer-marker-set (make-buffer "abcdef") :m 5))
      (assert= (buffer-marker (delete-char (goto-char b 0) 6) :m) 0)))
  (test "a marker-less buffer stays marker-less across edits (no :markers key added)"
    (assert= (buffer-markers (insert (make-buffer "abc") "x")) {}))
  (test "markers survive undo — reverting an insert returns the marker to its old spot"
    (let (
          ; the 2nd 'l'
          b (buffer-marker-set (make-buffer "hello") :m 3)
          ins (insert (goto-char b 0) "XY"))
      ; "XYhello", :m -> 5
      (assert= (buffer-marker ins :m) 5)
      (assert= (buffer-text (undo ins)) "hello")
      (assert= (buffer-marker (undo ins) :m) 3)))
  (test "markers survive redo — undo then redo restores the shifted position"
    (let (b (buffer-marker-set (make-buffer "hello") :m 3)
          ins (insert (goto-char b 0) "XY")
          redone (undo (undo ins)))
      ; undo, then undo-the-undo = redo
      (assert= (buffer-text redone) "XYhello")
      (assert= (buffer-marker redone :m) 5)))
  (test "undo of a delete restores a marker the delete had collapsed"
    (let (
          ; "r"
          b (buffer-marker-set (make-buffer "hello world") :m 8)
          del (delete-char (goto-char b 6) 4))
      ; delete [6,10) -> :m collapses to 6
      (assert= (buffer-marker del :m) 6)
      (assert= (buffer-marker (undo del) :m) 8))))

;; The push side of buffers-as-processes: subscribers get the new projection on every edit.
(defn buf-relay-loop (bp tag report)
  (receive
    ([:buffer-updated _bp v txt _] (do
                                     (send report [:relayed tag v txt])
                                     (buf-relay-loop bp tag report)))))
(defn buf-relay (bp tag report)
  (do (subscribe-buffer bp buffer-text) (buf-relay-loop bp tag report)))
(defn drain-relayed (want acc)
  "Collect `want` relayed messages. The count is KNOWN — one per subscriber — so waiting for
it is exact, where a wall clock is a race: this drained on a 500 ms grace, which beat the
senders on an idle machine and is the shape that flaked `process_limit_test` under a loaded
suite run. `test/*wait-ms*` is a failure deadline, reached only if a relay never comes."
  (if (= (count acc) want)
    (reverse acc)
    (receive
      ([:relayed t v txt] (drain-relayed want (cons [t v txt] acc)))
      (after test/*wait-ms* (reverse acc)))))

(describe "buffer process — subscribe / push (the collaboration seam)"
  :isolated (test "a subscriber is seeded, then pushed each edit with a bumped version"
    (let (bp (spawn-buffer (make-buffer "hi")))
      (subscribe-buffer bp buffer-text)
      (assert= (receive ([:buffer-updated _bp v txt _] [v txt]) (after test/*wait-ms* :none))
        [0 "hi"])
      (buffer-edit bp (fn (b) (insert (end-of-buffer b) "!")))
      (assert= (receive ([:buffer-updated _bp v txt _] [v txt]) (after test/*wait-ms* :none))
        [1 "hi!"])
      (stop-buffer bp)))

  (test "unsubscribe-buffer stops the pushes"
    (let (bp (spawn-buffer (make-buffer "x")))
      (subscribe-buffer bp buffer-text)
      ; drain the seed
      (receive ([:buffer-updated _bp _ _ _] nil) (after test/*wait-ms* nil))
      (unsubscribe-buffer bp)
      ; let the unsubscribe land
      (receive (after 200 nil))
      (buffer-edit bp (fn (b) (insert (end-of-buffer b) "y")))
      (assert= (receive ([:buffer-updated _bp _ _ _] :got) (after 400 :none)) :none)
      (stop-buffer bp)))

  (test "a nil projection pushes a bare notification (nil view)"
    (let (bp (spawn-buffer (make-buffer "a")))
      (subscribe-buffer bp nil)
      (assert= (receive ([:buffer-updated _bp v view _] [v view]) (after test/*wait-ms* :none))
        [0 nil])
      (stop-buffer bp)))

  (test "two subscribers both receive an edit — the point of buffers-as-processes"
    (let (me (self)
          bp (spawn-buffer (make-buffer "")))
      (spawn (buf-relay bp :a me))
      (spawn (buf-relay bp :b me))
      ;; Wait for BOTH seeds rather than sleeping 300 ms: each subscriber relays the seed
      ;; before anything else, so two relayed messages IS "both are subscribed" — and it
      ;; must be established before the edit, or a late subscriber seeds with "Z" and the
      ;; test proves nothing about the push.
      (assert= (count (drain-relayed 2 ())) 2)
      (buffer-edit bp (fn (b) (insert (end-of-buffer b) "Z")))
      (let (zs (seq/filter (drain-relayed 2 ()) (fn (m) (= (nth m 2) "Z"))))
        (is (includes? (map zs (fn (m) (nth m 0))) :a))
        (is (includes? (map zs (fn (m) (nth m 0))) :b)))
      (stop-buffer bp)))

  (test "an origin-tagged edit's push carries the origin (the echo-suppression seam)"
    (let (bp (spawn-buffer (make-buffer "hi")))
      (subscribe-buffer bp buffer-text)
      ; drain the seed
      (receive ([:buffer-updated _bp _ _ _] nil) (after test/*wait-ms* nil))
      ;; untagged edit → nil origin; tagged edit → the tag comes back with the push
      (buffer-edit bp (fn (b) (insert (end-of-buffer b) "!")))
      (assert= (receive ([:buffer-updated _bp _ _ o] o) (after test/*wait-ms* :none)) nil)
      (buffer-edit bp :me-the-editor (fn (b) (insert (end-of-buffer b) "?")))
      (assert= (receive ([:buffer-updated _bp _ txt o] [txt o]) (after test/*wait-ms* :none))
        ["hi!?" :me-the-editor])
      (stop-buffer bp)))

  (test "splice-transform: disjoint concurrent splices merge exactly (both orders)"
    ;; the pure transform: B computed before A landed shifts by A's length delta
    ; A inserted 1 char before B
    (assert= (splice-transform [5 5 "Y"] [0 0 1]) [6 6 "Y"])
    ; A strictly after B — untouched
    (assert= (splice-transform [1 2 "z"] [5 7 0]) [1 2 "z"])
    ; delete shifted by (1 - 3)
    (assert= (splice-transform [8 9 ""] [2 5 1]) [6 7 ""])
    ;; overlap degrades to inserting after the applied replacement (authoritative)
    (assert= (splice-transform [3 6 "q"] [2 8 4]) [6 6 "q"])
    ;; strictness: touching spans are NOT disjoint (ambiguous → caller policy)
    (is (splice-disjoint? [0 2 ""] [3 5 ""]))
    (is (not (splice-disjoint? [0 3 ""] [3 5 ""]))))

  (test "concurrent based splices at the process: both land where they meant to"
    ;; A and B both edit \"hello\" at version 0, inside one round-trip window.
    ;; A prepends \"X\" (arrives first); B appends \"Y\" at offset 5 — computed
    ;; before X existed. With base-version transforms both land exactly.
    (let (bp (spawn-buffer (make-buffer "hello")))
      (buffer-splice bp 0 0 "X" :a 0)
      ; stale offsets: would give \"XhellYo\" untransformed
      (buffer-splice bp 5 5 "Y" :b 0)
      (assert= (buffer-query bp buffer-text) "XhelloY")
      (stop-buffer bp)))

  (test "buffer-splice / buffer-marker-move push DELTAS — the document never ships"
    (let (bp (spawn-buffer (make-buffer "hello")))
      (subscribe-buffer bp buffer-text)
      ; drain the seed
      (receive ([:buffer-updated _bp _ _ _] nil) (after test/*wait-ms* nil))
      ;; a structured splice: the push carries [lo hi repl] + markers, not the text
      (buffer-splice bp 5 5 "!" :alice)
      (let ([_v view o] (receive
                          ([:buffer-updated _bp v view o] [v view o])
                          (after test/*wait-ms* [:none :none :none])))
        (assert= (get view :splice) [5 5 "!"])
        (assert= o :alice))
      (assert= (buffer-query bp buffer-text) "hello!")
      ;; a marker move: no text, no splice — markers only
      (buffer-marker-move bp :alice 3 :alice)
      (let ([_ view _] (receive
                         ([:buffer-updated _bp v view o] [v view o])
                         (after test/*wait-ms* [:none :none :none])))
        (is (nil? (get view :splice)))
        (assert= (get (get view :markers) :alice) 3))
      (stop-buffer bp)))

  (test "a dead subscriber is dropped and its pid-keyed marker (its cursor) is cleaned up"
    ;; The lifecycle seam presence rides on: a participant keys its cursor marker by its
    ;; own pid; when it dies (crash / detach / link drop) the buffer process — which
    ;; monitors every subscriber — prunes the subscription AND the marker, and pushes,
    ;; so survivors see the cursor vanish rather than a ghost caret forever.
    (let (bp (spawn-buffer (make-buffer "hello")))
      (subscribe-buffer bp buffer-markers)
      ; drain our seed
      (receive ([:buffer-updated _bp _ _ _] nil) (after test/*wait-ms* nil))
      ;; a second participant: subscribes, plants its pid-keyed cursor, then dies
      ; a beat, then a normal exit
      (spawn (let (me (self))
               (subscribe-buffer bp nil)
               (buffer-edit bp (fn (b) (buffer-marker-set b me 3)))
               (receive (after 100 nil))))
      ;; we see its cursor arrive …
      (let ([_ marks] (receive
                        ([:buffer-updated _bp v mk _] [v mk])
                        (after test/*wait-ms* [:none :none])))
        (assert= (count marks) 1))
      ;; … and vanish again when it dies (the cleanup push)
      (let ([_ marks] (receive
                        ([:buffer-updated _bp v mk _] [v mk])
                        (after test/*wait-ms* [:none :none])))
        (assert= marks {}))
      (assert= (buffer-query bp buffer-markers) {})
      (stop-buffer bp))))

;; ---- annotations: derived data stamped with the text it describes ---------------
;; The staleness/currency pairing every gutter and overlay consumer used to hand-roll.

(describe "buffer annotations"
  (test "a fresh annotation is current and not stale"
    (let (b (annotate (make-buffer "a\nb\nc") :marks {0 :pass})
          a (annotation b :marks))
      (assert= (:value a) {0 :pass})
      (assert= (:current? a) true)
      (assert= (:stale? a) false)))

  (test "an edit that keeps the line count makes it STALE but still current"
    ;; a verdict on edited text is older than what you see — dim it, don't hide it
    (let (b (annotate (make-buffer "a\nb\nc") :marks {0 :pass})
          edited (insert (goto-char b 0) "x")
          a (annotation edited :marks))
      (assert= (:stale? a) true)
      (assert= (:current? a) true)))

  (test "an edit that SHIFTS lines makes it not current (line-keyed data would misplace)"
    (let (b (annotate (make-buffer "a\nb\nc") :marks {2 :fail})
          shifted (insert (goto-char b 0) "\n")
          a (annotation shifted :marks))
      (assert= (:current? a) false)
      (assert= (:stale? a) true)))

  (test "undoing back to the annotated text un-stales it (the rope is the identity)"
    (let (b (annotate (make-buffer "a\nb") :marks {0 :pass})
          edited (insert (goto-char b 0) "x")
          undone (undo edited))
      (assert= (:stale? (annotation undone :marks)) false)))

  (test "annotation-value gives the value only while positionally current"
    (let (b (annotate (make-buffer "a\nb\nc") :marks {1 :pass}))
      (assert= (annotation-value b :marks) {1 :pass})
      (assert= (annotation-value (insert (goto-char b 0) "\n") :marks) nil)))

  (test "no annotation reads as nil, and a foreign field isn't mistaken for one"
    (assert= (annotation (make-buffer "x") :marks) nil)
    (assert= (annotation (assoc (make-buffer "x") :marks "not-an-annotation") :marks) nil)))

;; ---- undo in a region: undo only the lines you selected -------------------------
;; Emacs's `undo-in-region`. Snapshot undo makes it cheap: the change set between two
;; texts is what a line diff computes, so selective undo needs no new undo data — just
;; keep the hunks that touch the region and drop the rest.

(defn uir-sel (b lo hi) (assoc (goto-char b lo) :mark hi))
;; `assoc` on a record answers `vector | map` — the record type does not survive an update —
;; so the result has to be re-declared or every caller reports it.
(sig uir-sel (buffer int int -> buffer))
(defn uir-line-start (b line) (text/line->char (buffer-rope b) line))

(describe "undo-in-region"
  ;; two edits on two different lines, most recent last
  (defn two-edits ()
    (let (b0 (make-buffer "one\ntwo\nthree\nfour")
          b1 (insert (goto-char b0 3) "!") ; line 0 -> "one!"
          b2 (insert (goto-char b1 8) "?"))
      ; line 1 -> "two?" (5 + len "two")
      b2))

  (test "undoes the change on the selected line, leaving other lines alone"
    (let (b (two-edits)
          line1 (uir-line-start b 1)
          ;; the whole of line 1, INCLUDING the "?" the edit appended (chars 5..9): a
          ;; selection that stops at 8 merely abuts the insertion, and Emacs does not
          ;; undo a change that only touches the region's edge
          sel (uir-sel b line1 (+ line1 4)))
      (assert= (buffer-text (undo-in-region sel)) "one!\ntwo\nthree\nfour")))

  (test "a change OUTSIDE the region is left standing, and history is searched for one inside"
    ;; the most recent edit is on line 1; selecting line 0 must still find line 0's edit
    (let (b (two-edits)
          sel (uir-sel b 0 4))
      ; covers the "!" at char 3
      (assert= (buffer-text (undo-in-region sel)) "one\ntwo?\nthree\nfour")))

  (test "a whole-buffer region reproduces a plain undo exactly"
    (let (b (two-edits))
      (assert= (buffer-text (undo-in-region (uir-sel b 0 (buffer-length b))))
        (buffer-text (undo b)))))

  (test "it undoes a DELETION inside the region (puts the line back)"
    (let (b0 (make-buffer "keep\ngone\ntail")
          b1 (delete-region (assoc (goto-char b0 5) :mark 10)) ; drop "gone\n"
          sel (uir-sel b1 0 (buffer-length b1)))
      (assert= (buffer-text b1) "keep\ntail")
      (assert= (buffer-text (undo-in-region sel)) "keep\ngone\ntail")))

  (test "a deletion OUTSIDE the region stays deleted"
    (let (b0 (make-buffer "a\nDROP\nb\nc")
          b1 (delete-region (assoc (goto-char b0 2) :mark 7)) ; drop "DROP\n"
          ;; select the LAST line only — the deletion happened above it
          last-start (uir-line-start b1 2)
          sel (uir-sel b1 last-start (buffer-length b1)))
      (assert= (buffer-text (undo-in-region sel)) (buffer-text b1))))

  (test "the region survives, so repeated calls peel changes off the same lines"
    (let (b0 (make-buffer "x\ny")
          b1 (insert (goto-char b0 1) "1")
          b2 (insert (goto-char b1 2) "2") ; two edits, both on line 0
          sel (uir-sel b2 0 3)
          once (undo-in-region sel))
      (is (not (nil? (buffer-mark once)))) ; mark kept
      (assert= (buffer-text once) "x1\ny")
      (assert= (buffer-text (undo-in-region once)) "x\ny")))

  (test "the region undo is itself undoable (a plain undo takes it back)"
    (let (b (two-edits)
          line1 (uir-line-start b 1)
          once (undo-in-region (uir-sel b line1 (+ line1 4))))
      (assert= (buffer-text (undo once)) (buffer-text b))))

  (test "no region, no history, or nothing in reach: the buffer is returned unchanged"
    (let (b (insert (make-buffer "a\nb") "x"))
      (assert= (undo-in-region b) b) ; no mark
      (assert= (undo-in-region (uir-sel (make-buffer "a") 0 1))
        (uir-sel (make-buffer "a") 0 1))) ; no history
    ;; a region on text nothing ever touched
    (let (b0 (make-buffer "top\nuntouched")
          b1 (insert (goto-char b0 3) "!")
          start (uir-line-start b1 1)
          sel (uir-sel b1 start (buffer-length b1)))
      (assert= (buffer-text (undo-in-region sel)) (buffer-text b1))))

  (test "point is clamped into the shortened text (no out-of-range cursor)"
    (let (b0 (make-buffer "short")
          b1 (insert (goto-char b0 5) " and much longer")
          sel (assoc (goto-char b1 (buffer-length b1)) :mark 0)
          out (undo-in-region sel))
      (is (<= (buffer-point out) (buffer-length out)))
      (is (<= (or (buffer-mark out) 0) (buffer-length out))))))

(describe "undo-region-restore (the pure core)"
  (test "chunk-wise over CHARACTERS: the changed span is what the region is tested against"
    ;; "old" -> "new" occupies chars 2..5; a region there undoes it, one elsewhere doesn't
    (assert= (editor/undo-region/undo-region-restore "a\nold\nz" "a\nnew\nz" 2 5)
      ["a\nold\nz" (list [:new 0 2] [:old 2 3] [:new 5 2])])
    (assert= (editor/undo-region/undo-region-restore "a\nold\nz" "a\nnew\nz" 0 1)
      ["a\nnew\nz" (list [:new 0 7])]))

  (test "identical texts are unchanged whatever the region"
    (assert= (editor/undo-region/undo-region-restore "a\nb" "a\nb" 0 9) ["a\nb" (list [:new 0 3])])))

;; ---- undo-in-region is CHARACTER-precise, like Emacs ------------------------------
;; A line-granular version answered "undo that line's last change", which is a different
;; question: with two edits on one line it undid the wrong one. These pin the Emacs rule
;; — a change is undone exactly when it OVERLAPS the region, character-wise.

(describe "undo-in-region with partial-line selections"
  (defn two-on-one-line ()
    ;; "aaa bbb" -> insert X at 3 -> insert Y at 8  =>  "aaaX bbbY"
    (let (b0 (make-buffer "aaa bbb")
          b1 (insert (goto-char b0 3) "X"))
      (insert (goto-char b1 8) "Y")))

  (test "selecting the FIRST half undoes the edit there, keeping the later one"
    (let (b (two-on-one-line))
      (assert= (buffer-text b) "aaaX bbbY")
      (assert= (buffer-text (undo-in-region (uir-sel b 0 4))) "aaa bbbY")))

  (test "selecting the SECOND half undoes that edit, keeping the earlier one"
    (assert= (buffer-text (undo-in-region (uir-sel (two-on-one-line) 5 9))) "aaaX bbb"))

  (test "a selection covering both undoes the most recent, then the other on a repeat"
    (let (b (two-on-one-line)
          once (undo-in-region (uir-sel b 0 9)))
      (assert= (buffer-text once) "aaaX bbb")
      (assert= (buffer-text (undo-in-region once)) "aaa bbb")))

  (test "a selection touching NEITHER edit changes nothing"
    ;; edits at 3 and 8; select chars 4..5 (the space), which no insertion overlaps
    (let (b (two-on-one-line))
      (assert= (buffer-text (undo-in-region (uir-sel b 4 5))) (buffer-text b))))

  (test "a change that only PARTLY overlaps the selection still counts (Emacs rule)"
    ;; insert "12345" at 3, then select just one char of it
    (let (b0 (make-buffer "abcdef")
          b1 (insert (goto-char b0 3) "12345"))
      (assert= (buffer-text b1) "abc12345def")
      (assert= (buffer-text (undo-in-region (uir-sel b1 5 6))) "abcdef")))

  (test "a deletion is undone when the selection sits where it happened"
    (let (b0 (make-buffer "keep GONE tail")
          b1 (delete-region (assoc (goto-char b0 5) :mark 10)))
      (assert= (buffer-text b1) "keep tail")
      ;; select around the seam where the text was removed
      (assert= (buffer-text (undo-in-region (uir-sel b1 4 6))) "keep GONE tail")))

  (test "a deletion elsewhere stays deleted"
    (let (b0 (make-buffer "one GONE two three")
          b1 (delete-region (assoc (goto-char b0 4) :mark 9))
          len (buffer-length b1))
      ;; select the very end, far from the seam at 4
      (assert= (buffer-text (undo-in-region (uir-sel b1 (- len 5) len))) (buffer-text b1))))

  (test "mid-word edits on the same word are separable"
    (let (b0 (make-buffer "word")
          b1 (insert (goto-char b0 2) "-") ; "wo-rd"
          b2 (insert (goto-char b1 5) "!"))
      ; "wo-rd!"
      (assert= (buffer-text b2) "wo-rd!")
      (assert= (buffer-text (undo-in-region (uir-sel b2 0 3))) "word!")
      (assert= (buffer-text (undo-in-region (uir-sel b2 5 6))) "wo-rd")))

  (test "a huge rewrite degrades to whole-span undo instead of hanging"
    ;; past the char budget the span is treated as one change — bounded, not frozen
    (let (big (apply str (map (range (+ 10 editor/undo-region/*char-budget*)) (fn (_i) "x")))
          b0 (make-buffer "seed")
          b1 (insert (goto-char b0 4) big))
      (assert= (buffer-text (undo-in-region (uir-sel b1 0 (buffer-length b1)))) "seed"))))

(describe "buffer: the electric pair ops"
  (test "insert-pair types both delimiters and leaves point between them"
    (let (b (insert-pair (goto-char (make-buffer "ab") 1) "(" ")"))
      (assert= "a()b" (buffer-text b))
      (assert= 2 (buffer-point b))))
  (test "delete-empty-pair removes an empty pair around point, and nothing else"
    (let (b (goto-char (make-buffer "a()b") 2))
      (assert= "ab" (buffer-text (delete-empty-pair b "(" ")")))
      (assert= 1 (buffer-point (delete-empty-pair b "(" ")"))))
    ;; not between that pair: unchanged, so the caller's ordinary backspace runs
    (let (b (goto-char (make-buffer "a(x)b") 2))
      (assert= b (delete-empty-pair b "(" ")")))
    (let (b (goto-char (make-buffer "a[]b") 2))
      (assert= b (delete-empty-pair b "(" ")")))))

;; A case-insensitive search must report offsets into the REAL text — folding is
;; length-preserving (`string/fold-case`), so it does.
(describe "buffer search: case folding"
  (defn bsc () (editor/buffer/make-buffer "hello World\nHELLO there\nİstanbul"))

  (test "without folding, case matters"
    (assert= (editor/buffer/buffer-search-forward (bsc) "hello" 0) 0)
    ;; `World` is in the text and `world` is not, so a case-sensitive search misses it
    (assert= (editor/buffer/buffer-search-forward (bsc) "World" 0) 6)
    (is (nil? (editor/buffer/buffer-search-forward (bsc) "world" 0 false)))
    ;; and `HELLO` is only at 12, never at 0
    (assert= (editor/buffer/buffer-search-forward (bsc) "HELLO" 0 false) 12))

  (test "with folding, either case finds either"
    (assert= (editor/buffer/buffer-search-forward (bsc) "HELLO" 0 true) 0)
    (assert= (editor/buffer/buffer-search-forward (bsc) "hello" 12 true) 12)
    (assert= (editor/buffer/buffer-search-forward (bsc) "world" 0 true) 6))

  (test "backward folds too, and still answers the LAST match before the bound"
    (assert= (editor/buffer/buffer-search-backward (bsc) "hello" 99 true) 12)
    (assert= (editor/buffer/buffer-search-backward (bsc) "hello" 12 true) 0))

  ;; The offset property, asserted against text whose lowercase is longer than itself:
  ;; the match must still be where the character actually is.
  (test "a folded match's offset indexes the real text, not the folded copy"
    ;; Each offset is read under an `if`, because the search answers `nil | int`: a
    ;; missed match then fails the assertion by name rather than indexing the text
    ;; with nil (which is also what the checker reads here).
    (let (b (bsc)
          text (editor/buffer/buffer-text b)
          at (editor/buffer/buffer-search-forward b "there" 0 true)
          ;; and past the İ, which is one character here and two when lowercased
          i (editor/buffer/buffer-search-forward b "stanbul" 0 true))
      (assert= (if at (string/substring text at (+ at 5)) :no-match) "there")
      (assert= (if i (string/substring text i (+ i 7)) :no-match) "stanbul"))))

;; ---- search streams the ROPE; nothing whole-buffer is built -----------------
;; `buffer-search-forward` used to read `(index-of (string/fold-case (buffer-text buf)) …)`
;; — flatten the rope, fold the flattening, scan — per call, and incremental search calls it
;; on every keystroke: 148 ms a character on a 5,700-line file, growing with the document.
;; It streams the rope now (`%rope-find`). These pin the SEMANTICS across that change, since
;; the whole risk of a native scan is that it lands a match somewhere subtly different.
(describe "buffer search — offsets, folding and edges"
  (test "forward finds the first occurrence at or after `from`"
    (let (b (make-buffer "abc abc abc"))
      (assert= 0 (buffer-search-forward b "abc" 0))
      (assert= 4 (buffer-search-forward b "abc" 1))
      (assert= 4 (buffer-search-forward b "abc" 4))
      (assert= 8 (buffer-search-forward b "abc" 5))
      (is (nil? (buffer-search-forward b "abc" 9)))))

  (test "backward finds the last occurrence starting strictly BEFORE `before`"
    (let (b (make-buffer "abc abc abc"))
      (assert= 8 (buffer-search-backward b "abc" 11))
      (assert= 4 (buffer-search-backward b "abc" 8))
      (assert= 0 (buffer-search-backward b "abc" 4))
      (is (nil? (buffer-search-backward b "abc" 0)))))

  (test "folding is off by default and on by request"
    (let (b (make-buffer "Hello World"))
      (is (nil? (buffer-search-forward b "hello" 0)))
      (assert= 0 (buffer-search-forward b "hello" 0 true))
      (assert= 6 (buffer-search-forward b "WORLD" 0 true))
      (assert= 6 (buffer-search-backward b "world" 11 true))))

  (test "a folded match's offset indexes the ORIGINAL text"
    ;; the reason the fold is one-character-per-character: `İ` lowercases to two characters,
    ;; so folding it would shift every offset after it and land the match on the wrong chars
    (let (b (make-buffer "aİb needle"))
      (assert= 4 (buffer-search-forward b "needle" 0 true))
      (assert= "needle" (string/substring (buffer-text b) 4 10))))

  (test "an empty needle answers where it was asked from"
    (let (b (make-buffer "abc"))
      (assert= 0 (buffer-search-forward b "" 0))
      (assert= 2 (buffer-search-forward b "" 2))))

  (test "a needle longer than the buffer, and searching an empty buffer"
    (is (nil? (buffer-search-forward (make-buffer "ab") "abcdef" 0)))
    (is (nil? (buffer-search-forward (make-buffer "") "a" 0)))
    (is (nil? (buffer-search-backward (make-buffer "") "a" 0))))

  (test "overlapping occurrences are found at every start"
    (let (b (make-buffer "aaaa"))
      (assert= 0 (buffer-search-forward b "aa" 0))
      (assert= 1 (buffer-search-forward b "aa" 1))
      (assert= 2 (buffer-search-backward b "aa" 4))))

  (test "a match spanning the newlines a rope is chunked on"
    (let (b (make-buffer (str (string/repeat "filler line\n" 400) "the needle here")))
      (assert= (index-of (buffer-text b) "the needle")
        (buffer-search-forward b "THE NEEDLE" 0 true)))))

(describe "undo-group: several edits, one undo"
  (test "replace-region undoes in one step, back to the text AND point before it"
    (let (b (goto-char (make-buffer "foo bar") 2)
          r (replace-region b 0 3 "FOO")
          u (undo r))
      (assert= (buffer-text r) "FOO bar")
      (assert= (buffer-text u) "foo bar")
      (assert= (buffer-point u) 2)))
  (test "a group of many edits is one step, and the edit before it is the next"
    (let (b (-> (make-buffer "a a a") (goto-char 5) (insert "!"))
          all (undo-group b
                (fn (x)
                  (-> x (replace-region 0 1 "b") (replace-region 2 3 "b") (replace-region 4 5 "b"))))
          back1 (undo-next (undo-start all))
          back2 (undo-next back1))
      (assert= (buffer-text all) "b b b!")
      (assert= (buffer-text back1) "a a a!")
      (assert= (buffer-text back2) "a a a")))
  (test "a group that changes nothing records nothing and keeps the history"
    (let (b (-> (make-buffer "ab") (insert "X"))
          g (undo-group b (fn (x) (end-of-buffer x))))
      (assert= (count (get g :undo)) 1)
      (assert= (buffer-text (undo g)) "ab")))
  (test "a group honours an armed amalgamate — it merges into the running step"
    (let (b (-> (make-buffer "") (insert "a") amalgamate-undo)
          g (undo-group b (fn (x) (insert (insert x "b") "c"))))
      (assert= (buffer-text g) "abc")
      (assert= (buffer-text (undo g)) "")))
  (test "a group on an undo-disabled buffer records nothing"
    (let (g (undo-group (disable-undo (make-buffer "x")) (fn (x) (replace-region x 0 1 "y"))))
      (assert= (buffer-text g) "y")
      (is (empty? (get g :undo)))))
  (test "delete-empty-pair is one step"
    (let (b (-> (make-buffer "") (insert-pair "(" ")"))
          d (delete-empty-pair b "(" ")"))
      (assert= (buffer-text d) "")
      (assert= (buffer-text (undo d)) "()"))))

(describe "buffer-modified?: the buffer, not its caller, knows it changed"
  (test "a fresh buffer is unmodified; any edit modifies it"
    (let (b (make-buffer "abc"))
      (refute (buffer-modified? b))
      (is (buffer-modified? (insert b "x")))
      (is (buffer-modified? (delete-char b)))
      (is (buffer-modified? (delete-backward-char (end-of-buffer b))))
      (is (buffer-modified? (replace-region b 0 1 "z")))
      (is (buffer-modified? (delete-region (goto-char (set-mark b) 2))))))
  (test "a no-op edit leaves it unmodified"
    (let (b (make-buffer "abc"))
      (refute (buffer-modified? (delete-char (end-of-buffer b))))
      (refute (buffer-modified? (insert b "")))
      (refute (buffer-modified? (undo-group b (fn (x) x))))))
  (test "undoing back to the saved text makes it unmodified again; redo modifies it"
    (let (e (insert (make-buffer "abc") "x")
          u (undo e))
      (refute (buffer-modified? u))
      (is (buffer-modified? (undo u)))))
  (test "undoing PAST the save point is a modification"
    (let (path (str (temp-dir "brood-buf-") ".txt")
          _ (file/spit path "v0")
          e (insert (buffer-from-file path) "1")
          saved (save-buffer e)
          e2 (insert saved "2"))
      (refute (buffer-modified? saved))
      (refute (buffer-modified? (undo e2))) ; back to what is on disk
      (is (buffer-modified? (-> e2 undo-start undo-next undo-next))))) ; older than disk
  (test "mark-buffer-saved and mark-buffer-modified set the baseline explicitly"
    (let (e (insert (make-buffer "a") "b"))
      (refute (buffer-modified? (mark-buffer-saved e)))
      (is (buffer-modified? (mark-buffer-modified (make-buffer "a")))))))

(defn- splices-apply (text splices)
  ;; `text` with each splice applied in order — what a holder replaying the log builds
  (fold splices
    text
    (fn (acc splice)
      (let ([lo hi repl] splice)
        (str (string/substring acc 0 lo) repl (string/substring acc hi (string/length acc)))))))

(defn- type-chars (buf n)
  ;; `n` single-character inserts, as a typing burst makes them
  (fold (range n) buf (fn (b i) (insert b (if (math/even? i) "a" "b")))))

(describe "buffer-splices-since: what the edits did, not a diff's guess"
  (test "typing at the front of a run of equal characters is an insert at the FRONT"
    ;; a text diff of "aaa" -> "aaaa" says [3 3 "a"]: the right size, the wrong place
    (let (before (make-buffer "aaa"))
      (assert= (buffer-splices-since before (insert before "a")) (list [0 0 "a"]))))
  (test "a typing run is one splice, a backspace into it included"
    (let (before (goto-char (make-buffer "abc") 1)
          after (delete-backward-char (insert (insert before "X") "Y")))
      (assert= (buffer-splices-since before after) (list [1 1 "X"]))))
  (test "edits apart from each other stay separate splices, oldest first"
    (let (before (goto-char (make-buffer "abcdef") 1)
          after (insert (goto-char (insert before "X") 5) "Y"))
      (assert= (buffer-splices-since before after) (list [1 1 "X"] [5 5 "Y"]))))
  (test "a typing burst longer than the log is still one splice"
    ;; it used to be one entry per key, 32 kept: a server synced after 40 keys got nil
    (let (before (make-buffer "")
          after (type-chars before 40))
      (assert= (count (buffer-splices-since before after)) 1)
      (assert= (splices-apply "" (buffer-splices-since before after)) (buffer-text after))))
  (test "a holder that synced mid-run gets exactly the rest of the run"
    (let (base (goto-char (make-buffer "aaa") 1)
          middle (insert (insert base "a") "a")
          after (insert (insert middle "a") "b"))
      (assert= (buffer-splices-since middle after) (list [3 3 "ab"]))
      (assert= (buffer-splices-since base after) (list [1 1 "aaab"]))))
  (test "a run of deletions is one splice, backward or forward, and answers mid-run too"
    (let (base (goto-char (make-buffer "hello world") 5)
          back-one (delete-backward-char base)
          back (delete-backward-char (delete-backward-char back-one))
          forward-base (goto-char (make-buffer "hello world") 5)
          forward (delete-char (delete-char forward-base)))
      (assert= (buffer-splices-since base back) (list [2 5 ""]))
      (assert= (buffer-splices-since back-one back) (list [2 4 ""]))
      (assert= (buffer-splices-since forward-base forward) (list [5 7 ""]))))
  (test "a deleted region and a replace-region are logged"
    (let (before (goto-char (set-mark (make-buffer "hello world")) 5))
      (assert= (buffer-splices-since before (delete-region before)) (list [0 5 ""]))
      (assert= (buffer-splices-since before (replace-region before 6 11 "there"))
        (list [6 11 "there"]))))
  (test "no change is no splices, and movement is no change"
    (let (before (make-buffer "abc"))
      (assert= (buffer-splices-since before before) ())
      (assert= (buffer-splices-since before (goto-char before 2)) ())))
  (test "an undo is the splice it restored, and a redo the one after it"
    (let (edited (insert (make-buffer "abc") "X")
          undone (undo edited)
          redone (undo undone))
      (assert= (buffer-text redone) "Xabc")
      (assert= (buffer-splices-since edited undone) (list [0 1 ""]))
      (assert= (buffer-splices-since undone redone) (list [0 0 "X"]))
      ;; the same text again: ropes compare by content, so the walk stops at once
      (assert= (buffer-splices-since edited redone) ())))
  (test "undoing an amalgamated typing run reverses the whole run as one splice"
    (let (base (goto-char (make-buffer "say hi") 4)
          typed (fold (range 3)
                  base
                  (fn (b i) (insert (if (= i 0) b (amalgamate-undo b)) (if (= i 1) "x" "o"))))
          undone (undo typed))
      (assert= (buffer-text undone) "say hi")
      (assert= (buffer-splices-since typed undone) (list [4 7 ""]))
      (assert= (splices-apply (buffer-text base) (buffer-splices-since base undone)) "say hi")))
  (test "a region undo logs the splice it made"
    (let (edited (insert (goto-char (make-buffer "one\ntwo\n") 4) "X")
          region (goto-char (set-mark (goto-char edited 4)) 6)
          undone (undo-in-region region))
      (assert= (buffer-text undone) "one\ntwo\n")
      (assert= (buffer-splices-since region undone) (list [4 5 ""]))))
  (test "replaying the splices rebuilds the text, edit after undo after edit"
    (let (before (goto-char (make-buffer "the quick fox") 4)
          after (-> before
                  (insert "very ")
                  (delete-backward-char 2)
                  (goto-char 0)
                  (insert "A: ")
                  undo
                  (insert "B")
                  (goto-char 3)
                  (delete-char 4))
          splices (buffer-splices-since before after))
      (is (not (nil? splices)))
      (assert= (splices-apply (buffer-text before) splices) (buffer-text after))))
  (test "a change the log cannot account for is nil, for the caller to diff"
    (is (nil? (buffer-splices-since (make-buffer "one") (make-buffer "two"))))))

(describe "buffer-splices-cover: the one stretch several splices changed"
  (test "nil for none, a splice's own range for one"
    (assert= nil (buffer-splices-cover '()))
    (assert= [2 4 5] (buffer-splices-cover [[2 4 "xyz"]])))
  (test "splices before, inside, after and straddling the cover widen it as the texts say"
    ;; each case is checked against the texts: before the cover nothing changed, after it
    ;; everything is the old text shifted
    (let (cases [[[2 4 "xyz"] [0 0 "a"]]
                  [[5 5 "abc"] [6 7 ""]]
                  [[1 2 ""] [8 9 "QQ"]]
                  [[3 3 "x"] [0 6 "y"] [2 2 "zz"]]
                  [[0 10 ""]]]
          base "0123456789abcdef"
          splice-into (fn (text splice)
                        (let ([lo hi repl] splice)
                          (str (string/substring text 0 lo)
                            repl
                            (string/substring text hi (string/length text)))))
          wrong (seq/filter cases
                  (fn (splices)
                    (let (after (fold splices base splice-into)
                          [lo old-hi new-hi] (buffer-splices-cover splices))
                      (not (and (= (string/substring base 0 lo) (string/substring after 0 lo))
                             (= (string/substring base old-hi (string/length base))
                               (string/substring after new-hi (string/length after)))))))))
      (assert= [] (vec wrong))))
  (test "the cover of a buffer's edits is what the compare of its texts finds, or wider"
    (let (before (make-buffer "(a)\n(b)\n(c)\n")
          after (insert (goto-char (insert (goto-char before 5) "xy") 0) ";; ")
          [lo old-hi new-hi] (buffer-splices-cover (buffer-splices-since before after))
          [clo cold chi] (text/changed-range (buffer-rope before) (buffer-rope after)))
      (is (<= lo clo))
      (is (>= old-hi cold))
      (assert= (- new-hi old-hi) (- chi cold)))))

(describe "narrowing: which text may be edited"
  (test "a fresh buffer is not narrowed; narrow-to narrows it and widen undoes that"
    (let (b (make-buffer "hello world")
          n (narrow-to b [[0 5]]))
      (refute (narrowed? b))
      (assert= (editable-regions b) nil)
      (is (narrowed? n))
      (refute (read-only? n))
      (assert= (editable-regions n) [[0 5]])
      (refute (narrowed? (widen n)))))
  (test "narrowed to nothing is read-only, which is narrowed, not a fresh buffer"
    ;; `'()` IS nil in Brood, so the regions must come back as a vector, or this buffer
    ;; and an un-narrowed one would read the same.
    (let (n (narrow-to (make-buffer "abc") '()))
      (is (narrowed? n))
      (is (read-only? n))
      (assert= (editable-regions n) [])
      (is (includes? (error-of (insert n "x")) "read-only"))))
  (test "an insert inside an editable region goes through; outside one is refused"
    (let (n (narrow-to (make-buffer "hello world") [[0 5]]))
      (assert= (buffer-text (insert (goto-char n 2) "XY")) "heXYllo world")
      (is (includes? (error-of (insert (goto-char n 8) "Z")) "read-only")))))

(describe "replace-region counts characters, not grapheme clusters"
  (test "a combining mark in the range takes no extra character with it"
    (let (b (make-buffer (str "e" (string/int->char 769) "xyz")))
      (assert= (buffer-text (replace-region b 0 2 "Q")) "Qxyz")))
  (test "a range ending before it starts deletes nothing and inserts at the start"
    (assert= (buffer-text (replace-region (make-buffer "abc") 2 1 "Z")) "abZc")))

;; ---- text properties (ADR-579) ----------------------------------------------------
;; Emacs's semantics: the property belongs to the characters — it moves with them, text
;; typed inside a span does not take it, a delete shrinks a span, undo gives it back.

(defn- coloured (text spans) (insert (make-buffer "") text {:face spans}))
(defn- region-of (buf from to) (goto-char (set-mark (goto-char buf from)) to))

(describe "text properties move with the text"
  (test "inserted text carries the properties it came with, relative to itself"
    (let (b (insert (end-of-buffer (make-buffer "log: ")) "ok fail" {:face [[3 7 :red]]}))
      (assert= (buffer-properties b :face) [[8 12 :red]])))
  (test "an insert before a span moves it; after it leaves it put"
    (let (b (coloured "abcdef" [[2 4 :red]]))
      (assert= (buffer-properties (insert (goto-char b 0) "XY") :face) [[4 6 :red]])
      (assert= (buffer-properties (insert (goto-char b 5) "XY") :face) [[2 4 :red]])))
  (test "typing inside a span splits it around the new text, which has none"
    (let (b (insert (goto-char (coloured "abcdef" [[0 6 :red]]) 3) "ZZ"))
      (assert= (buffer-text b) "abcZZdef")
      (assert= (buffer-properties b :face) [[0 3 :red] [5 8 :red]])))
  (test "text inserted at a span's edge is outside it"
    (let (b (coloured "abc" [[0 3 :red]]))
      (assert= (buffer-properties (insert (goto-char b 3) "!") :face) [[0 3 :red]])
      (assert= (buffer-properties (insert (goto-char b 0) "!") :face) [[1 4 :red]])))
  (test "a delete shrinks the spans it cuts, drops the one it empties, joins what meets"
    (let (b (coloured "aaXXbbYYcc" [[0 2 :a] [2 4 :x] [4 6 :a] [8 10 :c]]))
      (assert= (buffer-properties (delete-region (region-of b 2 4)) :face)
        [[0 4 :a] [6 8 :c]])
      (assert= (buffer-properties (delete-region (region-of b 1 9)) :face)
        [[0 1 :a] [1 2 :c]])))
  (test "appending in the same value joins the run; a chunk boundary never shows"
    (let (b (insert (end-of-buffer (coloured "ab" [[0 2 :red]])) "cd" {:face [[0 2 :red]]}))
      (assert= (buffer-properties b :face) [[0 4 :red]])))
  (test "a buffer whose properties all went carries no :properties key"
    (let (b (delete-region (region-of (coloured "abc" [[0 3 :red]]) 0 3)))
      (assert= (buffer-property-map b) {})
      (is (not (contains? b :properties)))))
  (test "keys are independent"
    (let (b (insert (make-buffer "") "abcd" {:face [[0 2 :red]] :link [[1 4 "url"]]}))
      (assert= (buffer-properties (delete-char (goto-char b 0) 1) :link) [[0 3 "url"]])
      (assert= (buffer-properties (delete-char (goto-char b 0) 1) :face) [[0 1 :red]])))
  (test "unsorted, overlapping or out-of-range spans are normalized on insert"
    (let (b (insert (make-buffer "") "abcd" {:face [[2 9 :b] [0 3 :a]]}))
      (assert= (buffer-properties b :face) [[0 3 :a] [3 4 :b]])))
  (test "buffer-properties-in clips to the range"
    (assert= (buffer-properties-in (coloured "abcdef" [[0 2 :a] [3 6 :b]]) :face 1 4)
      [[1 2 :a] [3 4 :b]])))

(describe "text properties and undo"
  (test "undo brings deleted text back with its properties"
    (let (b (coloured "abcdef" [[1 5 :red]])
          cut (delete-region (region-of b 0 6)))
      (assert= (buffer-properties (undo cut) :face) [[1 5 :red]])))
  (test "undo of a propertied insert removes the text and its properties"
    (let (b (make-buffer "ab")
          added (insert (end-of-buffer b) "cd" {:face [[0 2 :red]]}))
      (assert= (buffer-property-map (undo added)) {})))
  (test "redo puts them back"
    (let (b (insert (make-buffer "") "ab" {:face [[0 2 :red]]})
          undone (undo-next (undo-start b))
          redone (undo-next (undo-start undone)))
      (assert= (buffer-properties redone :face) [[0 2 :red]])))
  (test "a region undo carries the properties outside the change"
    (let (b (insert (goto-char (insert (make-buffer "") "a\nb\nc\n" {:face [[4 5 :red]]}) 0) "X")
          region (region-of b 0 1))
      (assert= (buffer-properties b :face) [[5 6 :red]])
      (assert= (buffer-properties (undo-in-region region) :face) [[4 5 :red]])))
  (test "revert replaces the text, properties and all, as one undoable edit"
    (let (path (str (temp-dir "brood-buf-") ".txt")
          _ (file/spit path "fresh\n")
          b (assoc (coloured "old" [[0 3 :red]]) :file path)
          reverted (revert-buffer b))
      (assert= (buffer-property-map reverted) {})
      (assert= (buffer-properties (undo reverted) :face) [[0 3 :red]]))))

(describe "put-properties — a property change is an edit"
  (test "sets one key over a range, keeping the others, point and mark"
    (let (b (goto-char (insert (make-buffer "") "abcdef" {:link [[0 6 "u"]]}) 4)
          put (put-properties b :face 1 5 [[2 4 :red]]))
      (assert= (buffer-properties put :face) [[2 4 :red]])
      (assert= (buffer-properties put :link) [[0 6 "u"]])
      (assert= (buffer-point put) 4)
      (assert= (buffer-text put) "abcdef")))
  (test "an empty span list removes the key there, and undo restores it"
    (let (b (coloured "abcdef" [[0 6 :red]])
          cleared (put-properties b :face 2 4 []))
      (assert= (buffer-properties cleared :face) [[0 2 :red] [4 6 :red]])
      (assert= (buffer-properties (undo cleared) :face) [[0 6 :red]])))
  (test "an unchanged property is no edit"
    (let (b (coloured "abc" [[0 3 :red]]))
      (is (= (put-properties b :face 0 3 [[0 3 :red]]) b))))
  (test "the splice log says what a propertied edit carried"
    (let (b (make-buffer "ab")
          after (insert (end-of-buffer b) "cd" {:face [[0 1 :red]]}))
      (assert= (buffer-edits-since b after) (list [2 2 "cd" {:face [[0 1 :red]]}]))
      (assert= (buffer-splices-since b after) (list [2 2 "cd"]))))
  (test "an undo's logged splice carries the restored properties"
    (let (b (coloured "abcdef" [[1 5 :red]])
          cut (delete-region (region-of b 0 6))
          undone (undo cut))
      (assert= (buffer-edits-since cut undone) (list [0 0 "abcdef" {:face [[1 5 :red]]}])))))

(describe "apply-splice — another holder's edit on a read-only copy"
  (test "applies through read-only and stays read-only"
    (let (b (apply-splice (set-read-only (make-buffer "abc") true) 1 2 "XY" {:face [[0 2 :red]]}))
      (assert= (buffer-text b) "aXYc")
      (assert= (buffer-properties b :face) [[1 3 :red]])
      (is (read-only? b))))
  (test "a narrowing is carried through the splice"
    (let (b (apply-splice (narrow-to (make-buffer "abcdef") [[4 6]]) 0 0 "ZZ"))
      (assert= (editable-regions b) [[6 8]]))))

(describe "text properties in a buffer process"
  :isolated (test "a propertied splice lands with its properties; a spawned copy keeps them"
    (let (bp (spawn-buffer (coloured "ab" [[0 2 :green]])))
      (buffer-splice bp 2 2 "cd" nil nil {:face [[0 2 :red]]})
      (assert= (buffer-query bp (fn (b) (buffer-properties b :face))) [[0 2 :green] [2 4 :red]])
      (stop-buffer bp))))

;; ---- redaction (ADR-581) ----------------------------------------------------------
;; A secret typed into a buffer one key at a time leaves a snapshot per key; removing it
;; must leave none — no undo brings any of it back, the splice log says only that it went.

(defn- typed (buf keys) (fold keys buf (fn (acc key) (insert acc key))))

(describe "redact-region — a delete that leaves no trace"
  (test "no undo or redo brings any part of the text back"
    (let (b (typed (end-of-buffer (make-buffer "Password: ")) ["h" "u" "n" "t" "e" "r"])
          redacted (redact-region b 10 16))
      (assert= (buffer-text redacted) "Password: ")
      (assert= (get redacted :undo) ())
      (assert= (buffer-text (undo redacted)) "Password: ")
      (is (not (includes? (str (get redacted :undo) (get redacted :pending-undo)) "hun")))))
  (test "the splice log records the delete as a redaction"
    (let (b (typed (end-of-buffer (make-buffer "pw: ")) ["a" "b"])
          redacted (redact-region b 4 6))
      (assert= (nth (first (get redacted :splices)) 6) :redact)
      (assert= (buffer-edits-between b redacted) (list [4 6 "" :redact]))))
  (test "a read-only buffer is redacted all the same and stays read-only"
    (let (redacted (redact-region (set-read-only (make-buffer "abcdef") true) 1 3))
      (assert= (buffer-text redacted) "adef")
      (is (read-only? redacted))))
  (test "point, markers and properties are carried"
    (let (b (buffer-marker-set (insert (make-buffer "") "xxSECRETyy" {:face [[8 10 :red]]}) :m 9)
          redacted (redact-region b 2 8))
      (assert= (buffer-point redacted) 4)
      (assert= (buffer-marker redacted :m) 3)
      (assert= (buffer-properties redacted :face) [[2 4 :red]])))
  (test "an empty range is no edit"
    (let (b (insert (make-buffer "") "ab"))
      (is (= (redact-region b 1 1) b)))))

(describe "redaction in a buffer process"
  :isolated (test "a redacting splice leaves the process no history and no log"
    (let (bp (spawn-buffer (make-buffer "pw: ")))
      (buffer-splice bp 4 4 "secret" :me nil nil)
      (buffer-splice bp 4 10 "" :me nil :redact)
      (assert= (buffer-query bp buffer-text) "pw: ")
      (assert= (buffer-query bp (fn (b) (get b :undo))) ())
      (is (nil? (buffer-query bp (fn (b) (get b :splices)))))
      (stop-buffer bp))))

(describe "a redaction's log entry holds no text from before it"
  (test "no entry holds a text with the secret in it, and the next edit is walkable"
    (let (b (typed (end-of-buffer (make-buffer "pw: ")) ["s" "e" "c"])
          redacted (redact-region b 4 7)
          next (insert redacted "\n")
          ropes (mapcat (append (get redacted :splices) (get next :splices))
                  (fn (entry) [(first entry) (second entry)])))
      (is (not (any? ropes
                 (fn (rope) (and (not (nil? rope)) (includes? (text/->string rope) "sec"))))))
      ;; a holder that synced at the redaction still replays the edit after it
      (assert= (buffer-edits-since redacted next) (list [4 4 "\n" nil])))))

;; Every text a buffer still holds besides its own: each log entry's ropes, its run's mid
;; texts and replacement, and each undo snapshot's rope — where a redacted secret could hide.
(defn- held-texts (buf)
  (append (mapcat (or (get buf :splices) ())
            (fn (entry)
              (let ([before after _ _ replacement mids _] entry)
                (append (seq/keep [before after] (fn (rope) (when rope (text/->string rope))))
                  [replacement]
                  (map mids (fn (mid) (text/->string (first mid))))))))
    (map (or (get buf :undo) ()) (fn (snapshot) (text/->string (get snapshot :rope))))))

(defn- holds? (buf secret) (any? (held-texts buf) (fn (text) (includes? text secret))))

;; The shell's case: output arrives at the process mark (before the typed-ahead text) and
;; the auto-opened password read redacts the type-ahead, both in ONE event.
(defn- prompt-event ()
  (let (synced (insert (insert (make-buffer "") "$ sudo x\n") "hun")
        output (replace-region synced 9 9 "pw: "))
    [synced (redact-region output 13 16)]))

(describe "a redaction reaches every holder, whatever else the event did"
  (test "the event's edits arrive as a redaction and the text the event left"
    (let ([synced redacted] (prompt-event))
      (assert= (buffer-text redacted) "$ sudo x\npw: ")
      (assert= (buffer-edits-since synced redacted) nil)
      (assert= (buffer-edits-between synced redacted) (list [9 12 "" :redact] [9 9 "pw: " nil]))))
  (test "the redacting buffer itself holds no text with the secret, at once"
    (let ([_ redacted] (prompt-event)
          next (insert redacted "\n"))
      (is (not (holds? redacted "hun")))
      (is (not (holds? next "hun")))))
  (test "a holder the log cannot reach is still sent a redaction"
    (let ([synced redacted] (prompt-event)
          next (insert redacted "x"))
      (assert= (buffer-edits-since synced next) nil)
      (assert= (buffer-edits-between synced next) (list [9 12 "" :redact] [9 9 "pw: x" nil]))))
  (test "a copy applying another holder's redaction keeps nothing of the text"
    (let (copy (apply-splice (apply-splice (make-buffer "pw: ") 4 4 "h") 5 5 "un")
          cleaned (apply-splice copy 4 7 "" :redact))
      (is (holds? copy "hun"))
      (assert= (buffer-text cleaned) "pw: ")
      (assert= (buffer-text (undo cleaned)) "pw: ")
      (is (not (holds? cleaned "hun")))))
  (test "an undo-group around a redaction does not bring the history back"
    (let (b (insert (end-of-buffer (make-buffer "pw: ")) "hun")
          grouped (undo-group b (fn (inner) (redact-region inner 4 7))))
      (assert= (get grouped :undo) ())
      (assert= (buffer-text (undo grouped)) "pw: ")
      (is (not (holds? (insert grouped "\n") "hun"))))))

;; ADR-579: a property change is not a text change — nothing moves, a text consumer sees
;; nothing, and a holder applies it as what it is.
(describe "put-properties — a property change, not a text change"
  (test "markers and the narrowing in the range stay where they were"
    (let (b (narrow-to (buffer-marker-set (make-buffer "abcdef") :m 3) [[2 5]])
          put (put-properties (widen b) :face 0 6 [[0 6 :x]])
          narrowed (put-properties b :face 2 5 [[2 5 :x]]))
      (assert= (buffer-marker put :m) 3)
      (assert= (editable-regions narrowed) [[2 5]])
      (assert= (buffer-text put) "abcdef")))
  (test "the log records a property entry; text consumers see no change"
    (let (b (make-buffer "abcdef")
          put (put-properties b :face 1 5 [[2 4 :red]]))
      (assert= (buffer-edits-since b put) (list [1 1 "" [:put-properties 4 {:face [[1 3 :red]]}]]))
      (assert= (buffer-splices-since b put) ())))
  (test "an undo of it is a property entry too"
    (let (b (coloured "abcdef" [[0 6 :red]])
          cleared (put-properties b :face 2 4 [])
          undone (undo cleared))
      (assert= (buffer-properties undone :face) [[0 6 :red]])
      (assert= (buffer-edits-since cleared undone)
        (list [2 2 "" [:put-properties 2 {:face [[0 2 :red]]}]]))))
  (test "a holder applies the entry without touching its text or its markers"
    (let (b (make-buffer "abcdef")
          put (put-properties b :face 1 5 [[2 4 :red]])
          [lo hi replacement properties] (first (buffer-edits-since b put))
          copy (buffer-marker-set (goto-char (make-buffer "abcdef") 3) :m 2)
          applied (apply-splice copy lo hi replacement properties))
      (assert= (buffer-properties applied :face) [[2 4 :red]])
      (assert= (buffer-point applied) 3)
      (assert= (buffer-marker applied :m) 2)
      (assert= (buffer-properties (undo applied) :face) []))))

(describe "undo-in-region gives back properties"
  (test "the restored text has the properties it had"
    (let (b (insert (make-buffer "") "aabb\n" {:f [[0 4 :a]]})
          cut (delete-char (goto-char b 1) 2)
          restored (undo-in-region (assoc (goto-char cut 0) :mark 3)))
      (assert= (buffer-text restored) "aabb\n")
      (assert= (buffer-properties restored :f) [[0 4 :a]])))
  (test "a holder replaying the region undo ends with the same properties"
    (let (b (insert (make-buffer "") "aabb\n" {:f [[0 4 :a]]})
          cut (delete-char (goto-char b 1) 2)
          restored (undo-in-region (assoc (goto-char cut 0) :mark 3))
          copy (fold (buffer-edits-since cut restored)
                 (assoc cut :splices ())
                 (fn (acc edit)
                   (let ([lo hi replacement properties] edit)
                     (apply-splice acc lo hi replacement properties)))))
      (assert= (buffer-text copy) "aabb\n")
      (assert= (buffer-properties copy :f) [[0 4 :a]]))))

(describe "propertied appends are one run; a comparison sends only what changed"
  (test "coloured chunks appended one after another are one entry"
    (let (b (end-of-buffer (make-buffer "$ make\n"))
          after (fold (range 40)
                  b
                  (fn (acc i) (insert acc "ab" {:face [[0 1 (if (math/even? i) :red :blue)]]}))))
      (assert= (count (get after :splices)) 1)
      (let (edit (first (buffer-edits-since b after))
            [lo hi replacement properties] edit)
        (assert= [lo hi (string/length replacement)] [7 7 80])
        (assert= (count (get properties :face)) 40)
        (assert= (first (get properties :face)) [0 1 :red])
        (assert= (last (get properties :face)) [78 79 :blue]))))
  (test "a holder that synced mid-run gets the rest with its properties"
    (let (b (end-of-buffer (make-buffer ""))
          mid (insert b "ab" {:face [[0 2 :red]]})
          after (insert mid "cd" {:face [[0 2 :blue]]}))
      (assert= (buffer-edits-since mid after) (list [2 2 "cd" {:face [[0 2 :blue]]}]))))
  (test "a delete back into a coloured run clips its properties"
    (let (b (make-buffer "")
          after (delete-backward-char (insert b "abcd" {:face [[0 4 :red]]}) 2))
      (assert= (buffer-edits-since b after) (list [0 0 "ab" {:face [[0 2 :red]]}]))))
  (test "the comparison sends the minimal range, widened to the properties it changed"
    (let (before (insert (make-buffer "") "abc" {:face [[0 3 :red]]})
          after (insert (make-buffer "") "abcd" {:face [[1 3 :red]]}))
      (assert= (buffer-edits-between before after) (list [0 3 "abcd" {:face [[1 3 :red]]}]))
      (assert= (buffer-edits-between (make-buffer "abc")
                 (insert (make-buffer "") "abX" {:face [[2 3 :red]]}))
        (list [2 3 "X" {:face [[0 1 :red]]}])))))

;; ---- concurrent redactions and property changes, the redaction marker through the
;; comparison, every property change in the walk, no rope holding the secret

(defn- next-push-properties (bp)
  "The `:properties` of the next push from `bp`, `:none` when none comes."
  (receive ([:buffer-updated ^bp _ view _] (get view :properties)) (after 1000 :none)))

(describe "a redaction or property change racing another holder's edit in its range"
  :isolated (test "a redaction grows over text typed inside it from another frame"
    (let (bp (spawn-buffer (make-buffer "pw: hunter")))
      (buffer-splice bp 6 6 "X" :b 0)
      (buffer-splice bp 4 10 "" :a 0 :redact)
      (assert= (buffer-query bp buffer-text) "pw: ")
      (stop-buffer bp)))
  :isolated (test "a redaction across an edit's edge covers the edit's text too"
    (let (bp (spawn-buffer (make-buffer "pw: hunter!")))
      (buffer-splice bp 8 11 "ZZZZ" :b 0)
      (buffer-splice bp 4 10 "" :a 0 :redact)
      (assert= (buffer-query bp buffer-text) "pw: ")
      (stop-buffer bp)))
  :isolated (test "an edit before the redaction only moves it"
    (let (bp (spawn-buffer (make-buffer "pw: hunter")))
      (buffer-splice bp 0 0 ">> " :b 0)
      (buffer-splice bp 4 10 "" :a 0 :redact)
      (assert= (buffer-query bp buffer-text) ">> pw: ")
      (stop-buffer bp)))
  :isolated (test "a property change is laid on its range, split around the inserted text"
    (let (bp (spawn-buffer (make-buffer "abcdef")))
      (subscribe-buffer bp nil)
      (next-push-properties bp)
      (buffer-splice bp 3 3 "X" :b 0)
      (buffer-splice bp 1 1 "" :a 0 [:put-properties 4 {:face [[0 4 :red]]}])
      (assert= (buffer-query bp buffer-text) "abcXdef")
      (assert= (buffer-query bp (fn (b) (buffer-properties b :face))) [[1 3 :red] [4 6 :red]])
      ;; what a holder in step with the process is pushed: the same result over the range
      (assert= (next-push-properties bp) nil)
      (assert= (next-push-properties bp) [:put-properties 5 {:face [[0 2 :red] [3 5 :red]]}])
      (stop-buffer bp))))

(describe "a redaction always reaches a holder the log cannot reach as one"
  (test "even when the event put the same characters back where they were"
    (let (before (insert (end-of-buffer (make-buffer "pw: ")) "hun")
          after (insert (goto-char (redact-region before 4 7) 4) "hun"))
      (assert= (buffer-text after) (buffer-text before))
      (assert= (buffer-edits-between before after) (list [4 7 "" :redact] [4 4 "hun" nil]))
      ;; and the holder applying it can undo nothing back
      (let (holder (fold (buffer-edits-between before after)
                     before
                     (fn (acc edit)
                       (let ([lo hi repl properties] edit) (apply-splice acc lo hi repl properties)))))
        (assert= (buffer-text holder) "pw: hun")
        ;; its one undo step is the re-insert's, back to the redacted text
        (assert= (map (get holder :undo) (fn (snapshot) (text/->string (get snapshot :rope))))
          (list "pw: ")))))
  (test "a redaction and an edit after it elsewhere: the union is redacted"
    (let (before (insert (end-of-buffer (make-buffer "pw: ")) "hun")
          after (insert (goto-char (redact-region before 4 7) 0) "> "))
      (assert= (buffer-edits-between before after)
        (list [0 7 "" :redact] [0 0 "> pw: " nil])))))

(describe "every property change after a holder's version is in its path"
  (test "a change behind an insert and its delete is not skipped"
    (let (b (make-buffer "abc")
          painted (put-properties b :face 0 3 [[0 3 :a]])
          typed (delete-backward-char (insert painted "x"))
          owner (put-properties typed :face 0 1 []))
      (assert= (buffer-text owner) "abc")
      (let (holder (fold (buffer-edits-between b owner)
                     b
                     (fn (acc edit)
                       (let ([lo hi repl properties] edit) (apply-splice acc lo hi repl properties)))))
        (assert= (buffer-property-map holder) (buffer-property-map owner))
        (assert= (buffer-property-map owner) {:face [[1 3 :a]]})))))

;; Every rope reachable from a value: a buffer's fields, maps, vectors and lists, walked.
(defn- reachable-ropes (value)
  (cond
    (rope? value) (list value)
    (or (map? value) (record? value))
      (mapcat (keys value) (fn (key) (reachable-ropes (get value key))))
    (or (vector? value) (list? value)) (mapcat value reachable-ropes)
    else ()))

(describe "a redaction leaves no rope holding the secret"
  (test "not the saved baseline, not an annotation, not the history"
    (let (b (annotate (mark-buffer-saved (make-buffer "pw: hunter")) :lint [1])
          typed (insert (end-of-buffer b) "!")
          redacted (redact-region typed 4 10))
      (is (any? (reachable-ropes typed) (fn (rope) (includes? (text/->string rope) "hunter"))))
      (assert= (buffer-text redacted) "pw: !")
      (is (not (any? (reachable-ropes redacted) (fn (rope) (includes? (text/->string rope) "hunt")))))
      (is (buffer-modified? redacted))
      (is (get (annotation redacted :lint) :stale?))))
  (test "a copy applying another holder's redaction keeps none either"
    (let (copy (mark-buffer-saved (make-buffer "pw: hunter"))
          cleaned (apply-splice copy 4 10 "" :redact))
      (is (not (any? (reachable-ropes cleaned) (fn (rope) (includes? (text/->string rope) "hunt"))))))))
