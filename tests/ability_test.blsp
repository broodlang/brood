;; Unified generic functions with nominal dispatch — `std/ability.blsp`. ONE concept,
;; value dispatch on the first argument's identity: a built-in dispatches on its
;; `type-of` kind, an identity-carrying record (`defrecord`) on its baked `module/name`
;; id. Subsumes value polymorphism (the `protocol` job) and drivers-as-values (part of
;; the `behaviour` job). Register-only — discovered and run by `nest test`.
(defmodule ability-test (:use test) (:use json))

;; Records carry a nominal identity captured from THIS module (`ability-test`).
(defrecord circle (r))
(defrecord rect (w h))

;; ---- value polymorphism: dispatch across built-in kinds AND record identities ----
(defability Size (size [self] :-> int))
(impl Size :int (size [n] n))
(impl Size :string (size [s] (count s)))
(impl Size :map (size [m] (count m)))
(impl Size ability-test/circle (size [c] (get c :r)))
(impl Size ability-test/rect (size [r] (* (get r :w) (get r :h))))
(impl Size :default (size [_] -1))

(describe "value dispatch"
  (test "dispatches on a built-in's type-of kind"
    (assert= (size 7) 7)
    (assert= (size "hello") 5)
    (assert= (size {:a 1 :b 2}) 2))
  (test "a record dispatches on its NOMINAL id, not as :map"
    ;; both records are :map structurally, but land on their own impls
    (assert= (size (circle 4)) 4)
    (assert= (size (rect 3 5)) 15))
  (test "two record shapes in one module dispatch apart"
    (assert= (size (circle 6)) 6)
    (assert= (size (rect 2 4)) 8))
  (test ":default catches an unregistered kind"
    (assert= (size :kw) -1)))

;; ---- ADR-011: a plain map (even with a :type field) is NEVER rerouted ----
(describe "nominal identity is opt-in"
  ; :map impl (count), NOT the circle impl
  (test "a plain map dispatches as :map, not as any record"
    (assert= (size {:type :circle :r 9}) 2))
  (test "the identity is a module/name keyword captured at definition"
    (assert= (get (circle 1) :__id__) :ability-test/circle))
  (test "a record is still a structural map for get/assoc"
    (assert= (get (circle 2) :r) 2)
    (assert= (get (assoc (circle 2) :r 9) :r) 9)))

;; ---- drivers are values: the "behaviour" job in the SAME mechanism ----
(defability Store (fetch [self k]))
(defrecord pg (pool))
(defrecord mem (data))
(impl Store ability-test/pg (fetch [db k] (str "pg:" (get db :pool) "/" k)))
(impl Store ability-test/mem (fetch [db k] (get (get db :data) k)))

(describe "drivers as values"
  (test "dispatch is on the driver value, not on any argument's type"
    (assert= (fetch (pg "P1") "k1") "pg:P1/k1")
    (assert= (fetch (mem {"k1" 42}) "k1") 42))
  (test "swapping the driver value swaps the impl — no config, no module atoms"
    (let (drivers [(pg "P1") (mem {"k" 99})])
      (assert= (fetch (nth drivers 0) "k") "pg:P1/k")
      (assert= (fetch (nth drivers 1) "k") 99))))

;; ---- satisfies? / missing impl ----
(defability Only-Int (only [self] :-> any))
(impl Only-Int :int (only [n] n))

(describe "satisfies? and missing impls"
  (test "true when every declared op resolves for the value's identity"
    (is (satisfies? 'Size 7))
    (is (satisfies? 'Size (circle 1))))
  (test "true via :default"
    (is (satisfies? 'Size :kw)))
  (test "false when no impl and no :default covers the identity"
    (refute (satisfies? 'Only-Int "s")))
  (test "false for an unknown ability"
    (refute (satisfies? 'No-Such 1)))
  (test "a missing impl is a loud, named error naming the ability, op, and id"
    ;; `arg` is a var, so the *static* missing-impl check can't judge it — this test
    ;; exercises the RUNTIME error path, which the checker's call-site pass complements.
    (let (arg "s"
          msg (try (only arg) (catch e (error-message e))))
      (is (includes? msg "Only-Int"))
      (is (includes? msg "only"))
      (is (includes? msg ":string")))))

;; ---- conflict detection: provenance distinguishes hot-reload from a real clash ----
(describe "impl conflict detection"
  :serial
  (test "a cross-module re-register overrides — last wins"
    (defability Ping (ping [self] :-> any))
    (register-impl 'Ping 'ping :int (fn (n) :a) 'lib-a)
    (assert= (ping 1) :a)
    ;; a DIFFERENT module claims the same [ability op id] — warns, last wins
    (register-impl 'Ping 'ping :int (fn (n) :b) 'lib-b)
    (assert= (ping 1) :b))
  (test "a same-module re-register (hot reload) overrides silently"
    ;; the `impl` macro tags both with THIS module — same provenance → no warning
    (defability Pong (pong [self] :-> any))
    (impl Pong :int (pong [n] :first))
    (assert= (pong 1) :first)
    (impl Pong :int (pong [n] :second))
    (assert= (pong 1) :second)))

;; ---- slice 2: the identity does not leak into serialization; clean field API ----
(describe "record identity does not leak"
  (test "json-encode omits the internal identity key, keeps the fields"
    (let (s (json-encode (circle 7)))
      (refute (includes? s "__id__"))
      (is (includes? s "\"r\":7"))))
  (test "record? / record-id / fields are the clean, id-free API"
    (is (record? (circle 3)))
    (refute (record? {:r 3}))
    (assert= (record-id (circle 3)) :ability-test/circle)
    (assert= (record-id {:r 3}) nil)
    (assert= (fields (circle 3)) {:r 3}))
  (test "a record is NOT = to a bare map with the same fields (Elixir-struct semantics)"
    ;; the identity intentionally distinguishes it — this is correct, not a leak
    (refute (= (circle 3) {:r 3})))
  (test "two records of different shape are never ="
    (refute (= (circle 3) (rect 3 3)))))

;; ---- slice 4: sealed abilities record their closed member set (checker uses it) ----
(defability Shape :sealed [circle rect] (area [self] :-> float))
(impl Shape ability-test/circle (area [c] (* 3 (get c :r) (get c :r))))
(impl Shape ability-test/rect (area [r] (* (get r :w) (get r :h))))

(describe "sealed abilities"
  (test "the closed member set is recorded (bare names qualified to this ns)"
    (assert= (sealed-members 'Shape) (list :ability-test/circle :ability-test/rect)))
  (test "sealing does not change dispatch"
    (assert= (area (circle 2)) 12)
    (assert= (area (rect 3 4)) 12)))

;; ---- KI-15: a bare impl id qualifies to the record's ns, like :sealed ----
(defability Kilo (kilo [self] :-> int))
; BARE `circle` must qualify to :ability-test/circle
(impl Kilo circle (kilo [c] 15))
(describe "impl id qualification (KI-15)"
  (test "a bare record id reaches the value's qualified identity"
    ;; before the fix this registered under :circle and never matched :ability-test/circle
    (assert= (kilo (circle 9)) 15)))

;; ---- late / open extension: an impl added after the fact, for a built-in ----
(describe "open extension"
  :serial
  (test "a new impl can be added for any kind after the ability is declared"
    (impl Size :vector (size [v] (* 10 (count v))))
    (assert= (size [1 2 3]) 30)))

;; ---- dispatch inline cache (ADR-172 §7): the per-op cache must stay transparent ----
;; The `%dispatch` cache memoises id→impl; these prove it deopts on reload and doesn't
;; leak one id's impl to another. WARM the cache (repeat calls) before each reload so a
;; stale entry, if the epoch guard failed, would show.
(describe "dispatch cache is transparent"
  :serial
  ; must deopt, not :v1
  (test "a reload is picked up even after the cache is warm"
    (defability Warm (warm [self] :-> any))
    (impl Warm :int (warm [n] :v1))
    ; warm the cache
    (assert= (list (warm 1) (warm 1) (warm 1)) (list :v1 :v1 :v1))
    ; reload → epoch bump
    (impl Warm :int (warm [n] :v2))
    (assert= (list (warm 1) (warm 1)) (list :v2 :v2)))
  (test "distinct ids do not share a cached impl"
    (defability Poly (poly [self] :-> any))
    (impl Poly :int (poly [n] :int))
    (impl Poly :string (poly [s] :string))
    ;; alternate ids repeatedly — a mono cache must miss+re-resolve per id, never leak
    (assert= (list (poly 1) (poly "a") (poly 2) (poly "b") (poly 3))
      (list :int :string :int :string :int))))

;; ---- impl precedence: deterministic by tier, not load order (ADR-172 §3) ----
;; `register-impl`/`register-ability`/`impl-for`/`impl-rank` are exercised directly with
;; crafted provenance (a `from` ns per registration), so the ordering is testable without
;; standing up real cross-module fixtures. Unique ability names avoid clashing the shared
;; registries. app (4) > type-owner (3) > ability-owner (2) > other (1); an ancestor ≠ owner.
(describe "impl precedence (deterministic by tier)"
  :serial
  (test "type-owner beats ability-owner regardless of registration order"
    ;; PaintA/PaintB owned by 'artlib; the record shapes/circle owned by 'shapes.
    (register-ability 'PaintA '((paint [self])) 'artlib)
    (register-impl 'PaintA 'paint :shapes/circle (fn (x) :ability) 'artlib)
    (register-impl 'PaintA 'paint :shapes/circle (fn (x) :type) 'shapes)
    (assert= ((impl-for '[PaintA paint] :shapes/circle) nil) :type)
    ;; reverse order — same winner (the point: order-independent)
    (register-ability 'PaintB '((paint [self])) 'artlib)
    (register-impl 'PaintB 'paint :shapes/circle (fn (x) :type) 'shapes)
    (register-impl 'PaintB 'paint :shapes/circle (fn (x) :ability) 'artlib)
    (assert= ((impl-for '[PaintB paint] :shapes/circle) nil) :type))
  ; owns neither
  (test "impl-rank orders type-owner > ability-owner > other"
    (register-ability 'Ranked '((op [self])) 'ownerns)
    ; owns the type
    (assert= (impl-rank 'Ranked :m/rec 'm) 3)
    ; owns the ability
    (assert= (impl-rank 'Ranked :m/rec 'ownerns) 2)
    (assert= (impl-rank 'Ranked :m/rec 'stranger) 1))
  (test "the ability owner may impl for a built-in id"
    (register-ability 'Sized '((sz [self])) 'sizelib)
    (register-impl 'Sized 'sz :int (fn (n) :int-sz) 'sizelib)
    (assert= ((impl-for '[Sized sz] :int) nil) :int-sz))
  (test "ability-owner-ns records the defining namespace"
    (register-ability 'Owned '((op [self])) 'mymod)
    (assert= (ability-owner-ns 'Owned) 'mymod))
  ;; regression: a top-level/REPL `impl` registers with `from` = nil (the root ns has no
  ;; name). Before the guard this crashed `impl-rank`'s `(name from)`. Exercise the real
  ;; path — `register-impl` with a nil `from`, then dispatch — which reproduces the crash.
  (test "a nil `from` (root/REPL impl) doesn't crash — dispatch round-trips"
    (register-ability 'RootAb '((op [self])) 'somens)
    (register-impl 'RootAb 'op :int (fn (n) :root-impl) nil)
    (assert= ((impl-for '[RootAb op] :int) nil) :root-impl))
  ;; a NESTED-namespace module (e.g. editor/display) owns its record's id — the split is
  ;; on the LAST `/` (the record name), so all leading segments stay in the owner name.
  (test "a nested-namespace module owns its record id (last `/` splits name off)"
    (register-ability 'NestAb '((op [self])) 'somelib)
    ; the true owner
    (assert= (impl-rank 'NestAb :editor/display/frame 'editor/display) 3)
    (assert= (impl-rank 'NestAb :editor/display/frame 'editor) 1))
  ;; app tier (4): a module in the project's OWN package (*ns-package* → *project-name*), or
  ;; a root/REPL impl (from=nil, the user IS the app), outranks type/ability owners.
  (test "the project's own package (and root/REPL) is the top app tier"
    (require 'project)
    (register-ability 'AppAb '((op [self])) 'artlib)
    (binding (*project-name* 'myproj
              *ns-package* (assoc *ns-package* 'appmod 'myproj))
      (assert= (impl-rank 'AppAb :foreign/rec 'appmod) 4)
      (assert= (impl-rank 'AppAb :foreign/rec nil) 4)
      (assert= (impl-rank 'AppAb :foreign/rec 'deplib) 1)))
  ;; regression (the nil-provenance bug): an app/root impl registers with `from` = nil, so
  ;; `*impl-from*` records nil as the incumbent's provenance. If registration keys "is there
  ;; an incumbent?" off truthiness of that stored `from` (nil → "none"), a LATER lower-tier
  ;; impl mistakes the app slot for empty and clobbers it — silently reversing ADR-172's
  ;; "the app can override anything, order-independent". The app must hold the slot when it
  ;; registered FIRST, against every lower tier, in either order.
  (test "an app/root impl (from=nil) is not displaced by a later lower tier"
    (register-ability 'HoldAb '((op [self])) 'holdlib)
    ;; app (nil) first, then ability-owner, type-owner, and 'other — none may displace it.
    (register-impl 'HoldAb 'op :h/rec (fn (x) :app) nil)
    (register-impl 'HoldAb 'op :h/rec (fn (x) :ability) 'holdlib)
    (register-impl 'HoldAb 'op :h/rec (fn (x) :type) 'h)
    (register-impl 'HoldAb 'op :h/rec (fn (x) :other) 'stranger)
    (assert= ((impl-for '[HoldAb op] :h/rec) nil) :app)
    ;; and for a built-in id, app-first then the ability owner: app still wins.
    (register-ability 'HoldB '((op [self])) 'hblib)
    (register-impl 'HoldB 'op :int (fn (n) :app) nil)
    (register-impl 'HoldB 'op :int (fn (n) :ability) 'hblib)
    (assert= ((impl-for '[HoldB op] :int) nil) :app)))

;; ---- variadic ops: a `&`-rest op dispatches on the first arg, passes the rest ----
;; Before the fix the op emitted a direct `(impl self & rest)` call — `&` was passed as an
;; argument (unbound-symbol error at every call). It now emits `(apply impl self … rest)`.
(defability Cat (cat [self & rest] :-> any))
(impl Cat :string (cat [s & rest] (apply str s rest)))
(impl Cat :int (cat [n & rest] (fold + n rest)))

(describe "variadic ops"
  (test "a & rest op dispatches on the first arg and receives the rest"
    (assert= (cat "a" "b" "c") "abc")
    (assert= (cat 1 2 3 4) 10))
  (test "a variadic op works with only its required arg (empty rest)"
    (assert= (cat "x") "x")
    (assert= (cat 7) 7)))

;; ---- no-impl raises a STRUCTURED error, not a bare string ----
(defability Narrow (narrow [self] :-> any))
(impl Narrow :int (narrow [n] n))

(describe "no-impl raises a structured error"
  ;; `arg` is a var so the STATIC missing-impl check can't judge it — this exercises the
  ;; RUNTIME error path (same reason the `only` test above uses a variable).
  (test "the thrown value carries :kind / :ability / :op / :id and a message"
    (let (arg "s"
          e (try (narrow arg) (catch e e)))
      (assert= (get e :kind) :no-impl)
      (assert= (get e :ability) 'Narrow)
      (assert= (get e :op) 'narrow)
      (assert= (get e :id) :string)
      ;; error-message still yields the human text, so a plain handler is unchanged
      (is (includes? (error-message e) "Narrow"))
      (is (includes? (error-message e) ":string"))))
  (test ":have lists the ids that ARE implemented"
    (let (arg "s"
          e (try (narrow arg) (catch e e)))
      (is (member? :int (get e :have))))))

;; ---- polymorphic dispatch cache (ADR-172 §7): more ids than cache ways ----
;; A monomorphic cache would re-resolve (still correct) but a leak/aliasing bug would show
;; as a wrong impl when > DISPATCH_IC_WAYS distinct ids alternate through one op.
(defability Poly6 (p6 [self] :-> any))
(impl Poly6 :int (p6 [_] :int))
(impl Poly6 :string (p6 [_] :string))
(impl Poly6 :keyword (p6 [_] :kw))
(impl Poly6 :float (p6 [_] :float))
(impl Poly6 :bool (p6 [_] :bool))
(impl Poly6 :vector (p6 [_] :vec))

(describe "polymorphic dispatch cache"
  (test "6 distinct ids (> cache ways) each resolve to their own impl"
    (assert= (list (p6 1) (p6 "a") (p6 :k) (p6 1.5) (p6 true) (p6 [0]))
      (list :int :string :kw :float :bool :vec)))
  (test "re-hitting an id after churning all six does not leak another id's impl"
    (assert= (list (p6 1) (p6 "a") (p6 1) (p6 :k) (p6 "a") (p6 1))
      (list :int :string :int :kw :string :int))))

;; ---- across processes: dispatch (polymorphic + variadic) works off the main process ----
;; Each worker builds a value via an ability op in its OWN process and sends it back; this
;; exercises dispatch on the worker's per-process inline cache and heap, not just the parent's.
(defability Kindly (kindly [self] :-> any))
(impl Kindly :int (kindly [_] :int))
(impl Kindly :string (kindly [_] :string))
(impl Kindly :keyword (kindly [_] :kw))
(impl Kindly :float (kindly [_] :float))
(impl Kindly :bool (kindly [_] :bool))
(impl Kindly :vector (kindly [_] :vec))

(defability Gather (gather [self & rest] :-> any))
(impl Gather :int (gather [n & rest] (fold + n rest)))

(defn abt-spawn-workers (parent xs)
  (when (not (empty? xs))
    (spawn (send parent [:r (kindly (first xs))]))
    (abt-spawn-workers parent (rest xs))))
(defn abt-collect (got total acc)
  (if (= got total) acc
    (abt-collect (+ got 1) total (receive ([:r v] (cons v acc))))))

(describe "abilities across processes"
  :isolated
  (test "polymorphic dispatch resolves each worker's own id in its own process"
    (let (xs [1 "a" :k 1.5 true [0]])
      (abt-spawn-workers (self) xs)
      (let (kinds (abt-collect 0 (count xs) nil))
        (assert= (count kinds) 6)
        ;; order is nondeterministic — assert every expected impl was reached
        (is (every? (fn (k) (member? k kinds))
              (list :int :string :kw :float :bool :vec))))))
  (test "a variadic op runs in a spawned worker"
    (let (parent (self))
      (spawn (send parent [:sum (gather 1 2 3 4)]))
      (assert= (receive ([:sum v] v)) 10))))

;; ---- typed ability ops: the checker consumes an op's `:-> RET` return type ----
;; A static/advisory feature, so these assert on the checker's warnings (via
;; `check-string-structured`) rather than on runtime behaviour, which is unchanged.
(defn abt-warns-of (src)
  "The advisory warning messages for source `src`."
  (map (fn (w) (get w :message)) (check-string-structured src)))
(defn abt-warns-about? (src needle)
  (any? (fn (w) (includes? w needle)) (abt-warns-of src)))

(describe "typed ability ops: :-> return types"
  (test "an op's declared return type flows into inference at the call site"
    ;; `size :-> int`, so `(size 5)` is an int; feeding it to `string-length` (wants a
    ;; string) is a provable mismatch — the declared return reached the call site.
    (is (abt-warns-about?
          "(defability S (sz [self] :-> int)) (impl S :int (sz [n] n)) (defn f () (string-length (sz 5)))"
          "int")))
  (test "an impl body that disagrees with the declared return is flagged"
    (is (abt-warns-about?
          "(defability S (sz [self] :-> int)) (impl S :int (sz [n] \"hi\"))"
          "declared return type int")))
  (test "a conforming or unknown impl body stays silent"
    (is (not (abt-warns-about?
          "(defability S (sz [self] :-> int)) (impl S :int (sz [n] 5)) (impl S :float (sz [n] n))"
          "declared return type"))))
  (test "a `:-> any` op imposes no return constraint"
    (is (not (abt-warns-about?
          "(defability B (bl [self] :-> any)) (impl B :int (bl [n] \"whatever\"))"
          "declared return type")))))

(describe "ability-name-as-a-type: a sealed ability is a finite union (ADR-181)"
  (test "a sealed ability name resolves as a type in a sig param"
    ;; Shape = (or circle rect); an int where Shape is wanted is a provable mismatch.
    (is (abt-warns-about?
          "(defmodule u) (defrecord circle (r)) (defrecord rect (w h)) (defability Shape :sealed [circle rect] (area [self] :-> float)) (sig total (Shape -> float)) (defn total (s) 1.0) (defn bad () (total 5))"
          "argument 1")))
  (test "a member record satisfies the ability type (no false positive)"
    (is (not (abt-warns-about?
          "(defmodule u) (defrecord circle (r)) (defrecord rect (w h)) (defability Shape :sealed [circle rect] (area [self] :-> float)) (sig total (Shape -> float)) (defn total (s) 1.0) (defn ok () (total (circle 2)))"
          "argument 1"))))
  (test "an open ability name is NOT a type (sig dropped, no spurious warning)"
    (is (not (abt-warns-about?
          "(defmodule u) (defability Open (op [self] :-> int)) (sig f (Open -> int)) (defn f (s) 1) (defn g () (f 5))"
          "argument 1")))))

(describe "direct-constructor ability calls (the BROOD_MONO Tier-1 devirt target)"
  ;; `Size` (above) has circle/rect impls. Calling an op with a DIRECT constructor arg
  ;; `(size (circle …))` is the shape the direct-constructor devirtualization rewrites;
  ;; the RESULT must be identical whether or not mono is on (verified byte-identical), and
  ;; a non-record `(op (some-fn …))` arg must dispatch on the fn's result identity, unchanged.
  (test "an op on a direct record constructor dispatches to that record's impl"
    (assert= (size (circle 5)) 5)          ; circle impl: (get c :r)
    (assert= (size (rect 3 4)) 12))        ; rect impl: (* w h)
  (test "an op on a non-record call dispatches on its result identity, not the fn name"
    ;; `(str …)` yields a string → :string impl (count), NOT any record path.
    (assert= (size (str "ab" "cd")) 4)))
