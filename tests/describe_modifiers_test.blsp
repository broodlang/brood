;; Every `:isolated` / `:serial` / `:skip` / `:tags` in `tests/` sits where a macro
;; actually reads it — checked STATICALLY, over the source, without running anything.
;;
;; WHY THIS EXISTS. A test modifier is a keyword, and a keyword evaluates to itself, so a
;; misplaced one is not an error — it is a body form that does nothing. That is KI-107: 31
;; tests in 10 files carried `:isolated` written *before* their `(test …)` form, every one
;; of them believed, none of them isolated, and `eval_server_test`'s three cases flaked at
;; 5–8% for months because of it. Two candidate fixes were refuted before anyone read the
;; marker.
;;
;; ADR-323 closed the spelling that caused it: `describe` now honours a modifier standing
;; before a test form and REJECTS any other bare keyword in its body. But that check runs
;; at expansion, which means it only fires for a file the runner actually loads, and it
;; cannot see inside a `(test …)` form at all. So the third spelling is still silent:
;;
;;     (test "name"
;;       (assert= 1 1)
;;       :isolated)          ; ← after the body started. Reads as a body form that
;;                           ;   evaluates to :isolated, asserts nothing, and passes.
;;
;; `test-split-mods` reads modifiers directly after the name and nowhere else, so this one
;; is a no-op by construction — and `describe`'s guard never sees it, because it is not in
;; the describe body. This gate reads every test file as DATA and walks it, so a file that
;; is filtered out, skipped, or fails to load for an unrelated reason is checked anyway.

(defmodule describe-modifiers-test (:use test))

;; Every `.blsp` under `dir`, recursively — `cons` + `%append-two` (not `append`) so the
;; walk stays linear in the file count. Same shape as `std_check_test`'s.
(defn- dm-files (dir)
  (if (file/dir? dir)
    (fold (file/ls dir)
      nil
      (fn (acc entry)
        (let (p (path/join dir entry))
          (cond
            (file/dir? p) (%append-two (dm-files p) acc)
            (string/ends-with? entry ".blsp") (cons p acc)
            else acc))))
    nil))

(defn- dm-modifier? (k)
  (includes? [:isolated :serial :skip :tags] k))

(defn- dm-test-form? (f)
  (and (pair? f) (includes? ['test 'deftest] (first f))))

(defn- dm-name-of (form)
  ;; The group/test name as written, for the report — a string literal, or a symbol for
  ;; `deftest`. Anything else prints as itself.
  (pr-str-bounded (second form)))

;; The body forms of a `(test …)`: modifiers are read as a leading run and nowhere else,
;; so anything after the first real body form is dead.
(defn- dm-scan-test-body (where forms in-body acc)
  (cond
    ;; `(not (pair? …))` rather than `empty?`: this file tree includes reader tests that
    ;; carry DOTTED forms, whose tail is an atom rather than nil, and `empty?` refuses one.
    (not (pair? forms)) acc
    (dm-modifier? (first forms))
      (if in-body
        (dm-scan-test-body where
          (rest forms)
          true
          (cons (str where
                  ": "
                  (first forms)
                  " stands after the body started, where nothing"
                  " reads it — a test's modifiers are read directly after its name")
            acc))
        ;; A leading modifier. `:tags` carries its vector with it.
        (dm-scan-test-body where
          (if (= (first forms) :tags) (rest (rest forms)) (rest forms))
          false
          acc))
    else (dm-scan-test-body where (rest forms) true acc)))

;; The body forms of a `(describe …)`: the same leading run, plus ADR-323's per-test
;; prefix — `:isolated`/`:skip`/`:tags […]` directly before a `(test …)`. `describe`
;; rejects the rest at expansion; this says so without loading the file.
(defn- dm-scan-describe-body (where forms in-body acc)
  (cond
    (not (pair? forms)) acc
    (dm-modifier? (first forms))
      (cond
        (not in-body)
          (dm-scan-describe-body where
            (if (= (first forms) :tags) (rest (rest forms)) (rest forms))
            false
            acc)

        (= (first forms) :serial)
          (dm-scan-describe-body where
            (rest forms)
            true
            (cons (str where
                    ": :serial is a group mode and has no per-test meaning — put it"
                    " right after the group name, or mark the one test :isolated")
              acc))

        (dm-test-form? (if (= (first forms) :tags) (third forms) (second forms)))
          (dm-scan-describe-body where
            (if (= (first forms) :tags) (rest (rest forms)) (rest forms))
            true
            acc)

        :else
          (dm-scan-describe-body where
            (rest forms)
            true
            (cons (str where
                    ": "
                    (first forms)
                    " does not stand before a (test …) form, so"
                    " nothing reads it")
              acc)))
    else (dm-scan-describe-body where (rest forms) true acc)))

(defn- dm-walk-kids (where form acc)
  ;; A form's children, walked by hand rather than with `fold`. `syntax_roundtrip_test`
  ;; carries DOTTED forms — a reader test would — whose tail is an atom rather than nil,
  ;; and every sequence combinator refuses one.
  (if (pair? form)
    (dm-walk-kids where (rest form) (dm-walk where (first form) acc))
    acc))

(defn- dm-walk (where form acc)
  (cond
    (dm-test-form? form)
      (let (body (rest (rest form))
            here (str where " " (dm-name-of form)))
        (dm-walk-kids here body (dm-scan-test-body here body false acc)))
    (and (pair? form) (= (first form) 'describe))
      (let (body (rest (rest form))
            here (str where " " (dm-name-of form)))
        (dm-walk-kids here body (dm-scan-describe-body here body false acc)))
    (pair? form) (dm-walk-kids where form acc)
    (vector? form) (fold form acc (fn (a f) (dm-walk where f a)))
    else acc))

(defn- dm-misplaced (path)
  "Every modifier keyword in `path` that no macro reads — as report strings."
  (fold (or (reflect/read-all (file/slurp path)) nil)
    nil
    (fn (acc form) (dm-walk path form acc))))

(describe "test modifiers sit where a macro reads them"
  (test "the test tree is discoverable from the suite's working directory"
    ;; Not ceremony: with a wrong cwd the walk returns nil and the assertion below passes
    ;; over zero files. Fail loudly rather than report a green gate that read nothing.
    (is (> (count (dm-files "tests")) 50)))

  (test "no modifier keyword in tests/ is a silent no-op"
    ;; Assert on the findings themselves, so a failure names the file and the marker
    ;; rather than only a count.
    (assert= (fold (sort (dm-files "tests")) nil (fn (acc p) (append acc (dm-misplaced p))))
      nil))

  (test "a modifier after the body has started is caught"
    ;; The gate's own sabotage, kept in the file: this is the exact shape KI-107's third
    ;; spelling takes, and `dm-misplaced` must report it. Written as source text rather
    ;; than as a real test, so reading it cannot register anything.
    (let (src "(describe \"g\" (test \"t\" (assert= 1 1) :isolated))"
          found (fold (or (reflect/read-all src) nil) nil (fn (a f) (dm-walk "src" f a))))
      (assert= (count found) 1)
      (is (includes? (first found) ":isolated"))))

  (test "the honoured spellings are not reported"
    (let (src "(describe \"g\" :serial :tags [:slow]
                  (test \"a\" :isolated (assert= 1 1))
                  :isolated (test \"b\" (assert= 1 1))
                  :tags [:x] (test \"c\" (assert= 1 1)))"
          found (fold (or (reflect/read-all src) nil) nil (fn (a f) (dm-walk "src" f a))))
      (assert= found nil))))
