;; Open generic functions — `std/protocol.blsp` (ADR-158): `defprotocol` declares
;; typed ops, `defimpl` registers a per-`type-of` implementation, and an op
;; dispatches on its first argument's runtime kind. The module is pure Brood over
;; two registry globals; the kernel's only involvement is the advisory conformance
;; pass the checker runs over these forms.
;;
;; It was `hatch`'s `protocol` module ("prototype for std/protocol") until
;; 2026-07-26 — the kernel had carried the checker/LSP support for it for months
;; while the macros themselves lived downstream, so the runtime hint pointed at a
;; module the tree didn't ship.
;;
;; Register-only — discovered and run by `nest test`. The suite runs each test in
;; its own green process, so these already exercise dispatch across cores; the
;; final :isolated block adds explicit spawn/send coverage (the registries are
;; ordinary globals, so a spawned process sees impls registered before it started —
;; the shared-code property of ADR-013).
(defmodule protocol-test (:use test) (:use protocol))

;; Protocols are declared at load, not inside a test body: `defprotocol` expands to
;; `defn`s, and the registries are globals — so the whole file shares one set of
;; declarations, as a real program would.
(defprotocol Label
  "Render a value as a short label."
  (label [v] :-> string))

(defimpl Label :int (label [n] (str "int:" n)))
(defimpl Label :string (label [s] (str "str:" s)))
(defimpl Label :vector (label [v] (str "vec/" (count v))))
(defimpl Label :default (label [x] (str "other:" (name (type-of x)))))

(defprotocol Combine
  (combine [a b] :-> any))
(defimpl Combine :int (combine [a b] (+ a b)))
(defimpl Combine :string (combine [a b] (str a b)))

;; No impls at all — the missing-impl error path.
(defprotocol Unimplemented
  (missing-op [v] :-> any))

(describe "protocol dispatch"
  (test "an op dispatches on the first argument's type-of"
    (assert= (label 7) "int:7")
    (assert= (label "x") "str:x")
    (assert= (label [1 2 3]) "vec/3"))
  (test ":default catches every unregistered type"
    (assert= (label :kw) "other:keyword")
    (assert= (label nil) "other:nil")
    (assert= (label 1.5) "other:float"))
  (test "a multi-argument op passes every argument to the impl"
    (assert= (combine 2 3) 5)
    (assert= (combine "a" "b") "ab"))
  (test "dispatch reads only the FIRST argument's type"
    ;; `(combine 2 "b")` picks the :int impl and then fails inside it — dispatch is
    ;; single, not multiple. Pinned so the single-dispatch contract is explicit.
    (assert-error (combine 2 "b")))
  (test "a missing impl is a loud, named error — never a silent nil"
    (let (msg (try (missing-op 1) (catch e (error-message e))))
      (is (includes? msg "Unimplemented"))
      (is (includes? msg "missing-op"))
      (is (includes? msg ":int"))))
  (test "the missing-impl error lists the kinds that ARE implemented"
    ;; `combine` has :int/:string impls but none for :keyword and no :default, so the
    ;; error hint names the kinds that would have worked — a misspelled/absent
    ;; `defimpl` shows up as a gap in that list rather than a bare failure.
    (let (msg (try (combine :kw 1) (catch e (error-message e))))
      (is (includes? msg "Combine"))
      (is (includes? msg ":int"))
      (is (includes? msg ":string")))))

;; :serial — these REGISTER impls from inside a test body. `register-impl` is a
;; read-modify-write of the `*impls*` global (`(def *impls* (assoc *impls* …))`), so
;; two processes registering at the same moment can lose one update. That is the
;; documented contract — register at load time, as `defimpl` at the top level does,
;; exactly like telemetry's `attach` — and running these serially is how the suite
;; honours it. (Found by the full parallel run: they pass standalone and raced under
;; the suite, which is precisely the property worth pinning.)
(describe "protocols are open"
  :serial
  (test "an impl can be added for a built-in type after the fact"
    ;; The whole point vs. a `cond` on `type-of`: extending needs no edit to the
    ;; dispatcher, and works from any module.
    (defimpl Combine :vector (combine [a b] (into a b)))
    (assert= (combine [1] [2]) [1 2]))
  (test "a later impl for the same key replaces the earlier one (hot reload)"
    (defprotocol Reloadable (reload-op [v] :-> any))
    (defimpl Reloadable :int (reload-op [n] :first))
    (assert= (reload-op 1) :first)
    (defimpl Reloadable :int (reload-op [n] :second))
    (assert= (reload-op 1) :second)))

(describe "protocol introspection"
  (test "protocol-ops returns the declared specs as data (the tooling hook)"
    (assert= (protocol-ops 'Label) (list '(label [v] :-> string)))
    (assert= (protocol-ops 'Combine) (list '(combine [a b] :-> any))))
  (test "an unknown protocol has no ops"
    (assert= (protocol-ops 'NoSuchProtocol) nil)))

;; `satisfies?` answers "is this protocol implemented for this value?" without
;; triggering the missing-impl error — the branch-instead-of-catch companion to
;; open dispatch. True iff every declared op resolves (a direct impl or `:default`).
(describe "satisfies?"
  (test "true when the value's kind has an impl for every declared op"
    (is (satisfies? 'Label 7))
    (is (satisfies? 'Label "x")))
  (test "true when covered only by a :default impl"
    ;; Label has a :default, so an otherwise-unregistered kind still satisfies it.
    (is (satisfies? 'Label :kw)))
  (test "false when no impl and no :default covers the kind"
    ;; Combine has :int/:string but no :keyword and no :default.
    (refute (satisfies? 'Combine :kw)))
  (test "false for an unknown protocol"
    (refute (satisfies? 'NoSuchProtocol 1))))

;; The generic fn the macro emits binds gensym'd temporaries for the resolved impl
;; and the dispatch kind, so an op argument that happens to share a temp's name
;; can't be captured — the impl still receives the real argument.
(defprotocol CallWith (call-with [f x] :-> any))
(defimpl CallWith :fn (call-with [f x] (f x)))

(describe "dispatch temporaries can't capture op arguments"
  (test "an op arg named `f` is passed through, not shadowed by the dispatch temp"
    (assert= (call-with inc 41) 42)))

;; Records are structural maps (ADR-130), so every defrecord value dispatches as
;; `:map`. This is a documented limitation, not an oversight — pin it so a future
;; `:type`-axis change has to face the test.
(defrecord pt-circle (radius))
(defrecord pt-square (side))
(defprotocol Shape (shape-name [s] :-> string))
(defimpl Shape :map
  (shape-name [m]
    ;; specialise per record shape by branching on a field, as the docs prescribe
    (if (contains? m :radius) "circle" "square")))

(describe "records dispatch as :map"
  (test "every record shape lands on the same :map impl"
    (assert= (shape-name (pt-circle 2)) "circle")
    (assert= (shape-name (pt-square 3)) "square"))
  (test "type-of a record is :map, which is why the above is necessary"
    (assert= (type-of (pt-circle 1)) :map)))

;; ---- behaviours: a contract a MODULE satisfies (no value dispatch) ----------
(defbehaviour Renderable
  (render-it [model])
  (mount-it [params]))

(describe "behaviours record their ops for the checker"
  (test "a behaviour registers ops without defining dispatching fns"
    (assert= (protocol-ops 'Renderable)
      (list '(render-it [model]) '(mount-it [params]))))
  (test "declaring a behaviour defines no function of its own"
    ;; unlike defprotocol, which defines a generic fn per op
    (refute (bound? 'render-it))))

;; ---- explicit concurrency: the registries are shared code, not shared data ---
(defn pt-echo-label (parent v) (send parent [:labelled (label v)]))

(describe "protocols across processes"
  :isolated
  (test "a spawned process dispatches through the impls registered before it"
    (let (me (self))
      (spawn (pt-echo-label me 5))
      (assert= (receive ([:labelled s] s)) "int:5")))
  (test "many processes dispatch concurrently on different types"
    (let (me (self))
      (spawn (pt-echo-label me 1))
      (spawn (pt-echo-label me "s"))
      (spawn (pt-echo-label me [1 2]))
      ;; fan-in: order is arbitrary, so compare as a set
      (let (a (receive ([:labelled s] s))
            b (receive ([:labelled s] s))
            c (receive ([:labelled s] s)))
        (assert= (into #{} [a b c]) #{"int:1" "str:s" "vec/2"})))))
