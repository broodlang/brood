;; The dispatcher enters a contract shim (ADR-748).
;;
;; A call of a contracted function whose arguments the kernel vouches for skips the shim's
;; own frame: the dispatcher calls the ORIGINAL in its place and keeps the declared result's
;; check as a return handler (or checks right after a call it runs to completion). Anything
;; it cannot vouch for runs the shim, whose Brood checks blame. These tests hold the
;; entered path to the shim's answers — the same values, the same blame, the same messages —
;; and `:entered` (`%type-verdict-counts`) says the path was taken, so each test that
;; asserts it goes red under `BROOD_NO_CONTRACT_DISPATCH=1`. The tree-walker
;; (`BROOD_TIER=0`) has no dispatcher: every contracted call there runs the shim, so the
;; count it reads is 0 and the answers must be the same anyway (KI-399).
(defmodule contract-dispatch-test
  (:use test))

(defn entered () (:entered (%type-verdict-counts)))

(defn entered? (n at-least)
  "Whether `n` entries is what this engine owes: `at-least` on the VM, none on the tree-walker."
  (if (%tree-walker?) (= n 0) (>= n at-least)))

(defn entered-by (thunk)
  "How many contracted calls the dispatcher entered while `thunk` ran, and its value."
  (let (before (entered) value (thunk)) [(- (entered) before) value]))

(defn dispatch-add (a b) (+ a b))
(sig! dispatch-add (int int -> int))

(check-allow :type-mismatch
  (defn dispatch-lies (x) (str "not " x)))
(sig! dispatch-lies (int -> int))

(defn dispatch-any (x) [x x])
(sig! dispatch-any (int -> any))

(defn dispatch-maybe (x) (when (> x 0) (str x)))
(sig! dispatch-maybe (int -> (or nil string)))

(defn dispatch-sum (x & more) (reduce more x +))
(sig! dispatch-sum (int & int -> int))

(defn dispatch-opt (s &optional n) (str s (or n 0)))
(sig! dispatch-opt (string &optional int -> string))

(defrecord dispatch-point (x y))
(defn dispatch-make (x) (dispatch-point x x))
(sig! dispatch-make (int -> dispatch-point))

(defn dispatch-counts (n) {:n n :next (inc n)})
(sig! dispatch-counts (int -> (map keyword int)))

(defn dispatch-caller (n) (let (result (dispatch-add n 1)) result))
(defn dispatch-lies-caller (n) (let (result (dispatch-lies n)) result))

(describe "a contracted call the dispatcher enters"
  (test "answers what the function answers, without the shim's frame"
    (let ([n value] (entered-by (fn () (dispatch-caller 41))))
      (assert= 42 value)
      (is (entered? n 1))))
  (test "an `any` result is not checked: the call is the original's"
    ;; a vector, which an `int` result check would refuse
    (let ([n value] (entered-by (fn () (dispatch-any 3))))
      (is (entered? n 1))
      (assert= [3 3] value)))
  (test "a result the kernel decides by its tag passes either way"
    (assert= nil (dispatch-maybe 0))
    (assert= "4" (dispatch-maybe 4)))
  (test "a rest and an optional shape forward every argument"
    (assert= 10 (dispatch-sum 1 2 3 4))
    (assert= 1 (dispatch-sum 1))
    (assert= "a0" (dispatch-opt "a"))
    (assert= "a5" (dispatch-opt "a" 5)))
  (test "a result only the Brood walk can decide is walked, and passes"
    (let ([n point] (entered-by (fn () (dispatch-make 3))))
      (is (entered? n 1))
      (assert= 3 (:x point)))
    (assert= {:n 2 :next 3} (dispatch-counts 2)))
  (test "a call through a native caller (map, apply) is checked too"
    (let ([n value] (entered-by (fn () (vec (map [1 2 3] (fn (x) (dispatch-add x 1)))))))
      (assert= [2 3 4] value)
      (is (entered? n 3)))
    (let ([n value] (entered-by (fn () (apply dispatch-add [3 4]))))
      (assert= 7 value)
      (is (entered? n 1)))
    (assert= :callee
      (get (try (vec (map [1] (fn (x) (dispatch-lies x)))) (catch error error)) :blame))
    (assert= :caller
      (get (try (check-allow :type-mismatch (apply dispatch-add ["a" 4])) (catch error error))
        :blame))))

(describe "what the entered path raises is the shim's error"
  (test "a bad result blames the callee, with the shim's message"
    (let ([n error] (entered-by (fn () (try (dispatch-lies-caller 1) (catch error error)))))
      (is (entered? n 1))
      (assert= :contract (get error :kind))
      (assert= :callee (get error :blame))
      (is (string/ends-with? (->string (get error :function)) "dispatch-lies"))
      (is (includes? (get error :message) "result expected int"))
      (assert= "not 1" (get error :got))))
  (test "a bad result from a tail call into the shim blames the callee too"
    (let (error (try (dispatch-lies 2) (catch error error)))
      (assert= :callee (get error :blame))))
  (test "a bad argument is not entered: the shim blames the caller"
    (let (error (check-allow :type-mismatch (try (dispatch-add 1 "two") (catch error error))))
      (assert= :caller (get error :blame))
      (assert= 2 (get error :argument))
      (is (includes? (get error :message) "argument 2 expected int"))))
  (test "a bad result's error is placed at the caller's call, not in the contract module"
    (let (error (try (dispatch-lies-caller 1) (catch error error)))
      (is (not (includes? (->string (get error :file)) "contract.blsp")))
      (is (not (any? (get error :trace)
                 (fn (frame) (includes? (->string (get frame :file)) "contract.blsp")))))))
  (test "a wrong arity is the shim's arity error"
    (assert-error (check-allow :type-mismatch (reflect/eval '(contract-dispatch-test/d-add 1))))))

;; Return-checked contracted tail calls stay flat (KI-216, ADR-396): a pending check for an
;; equal result type is not stacked again, whether the frame owing it is a shim's or the
;; dispatcher's handler.
(defn dispatch-ping (n) (if (= n 0) :done (dispatch-pong (dec n))))
(sig! dispatch-ping (int -> keyword))
(defn dispatch-pong (n) (if (= n 0) :done (dispatch-ping (dec n))))
(sig! dispatch-pong (int -> keyword))

(check-allow :type-mismatch
  (defn dispatch-narrow (n) (if (= n 0) "s" (dispatch-wide (dec n)))))
(sig! dispatch-narrow (int -> string))
(check-allow :type-mismatch
  (defn dispatch-wide (n) (if (= n 0) 7 (dispatch-narrow (dec n)))))
(sig! dispatch-wide (int -> (or int string)))

(describe "contracted tail calls"
  (test "a return-checked mutual recursion runs flat"
    (assert= :done (dispatch-ping 300000)))
  (test "an unequal result type still checks: the narrower one raises"
    (let (error (try (dispatch-narrow 1) (catch error error)))
      (assert= :callee (get error :blame))
      (is (string/ends-with? (->string (get error :function)) "dispatch-narrow")))))

;; The call site caches the shim's original (ADR-773): a call IC holds the ORIGINAL's arm
;; behind the shim, so a vouched call skips `dispatch`, and native code links to the original
;; the same way. What the cache must never do is outlive what it was filled under: an
;; argument it cannot vouch for still runs the shim, and a result still gets its check.
(defn dispatch-site-double (x) (* 2 x))
(sig! dispatch-site-double (int -> int))

(check-allow :type-mismatch
  (defn dispatch-site-maybe-lie (x) (if (< x 0) "negative" x)))
(sig! dispatch-site-maybe-lie (int -> int))

(defn dispatch-site-loop (n acc)
  (if (= n 0) acc (dispatch-site-loop (- n 1) (+ acc (dispatch-site-double n)))))

;; called with a string below, on purpose
(check-allow :type-mismatch
  (defn dispatch-site-call (x) (dispatch-site-double x)))
(defn dispatch-site-lie-call (x) (dispatch-site-maybe-lie x))

(defn dispatch-site-lie-loop (n acc)
  ;; non-tail, so a native caller makes the call and checks the value it returns
  (if (= n 0) acc (dispatch-site-lie-loop (- n 1) (+ acc (dispatch-site-maybe-lie (- 1000 n))))))

(describe "a call site that caches a contracted callee"
  (test "a hot loop's calls are entered and answer as the function does"
    (let ([n value] (entered-by (fn () (dispatch-site-loop 5000 0))))
      (assert= 25005000 value)
      (is (entered? n 5000))))
  (test "a bad argument at a warm site still runs the shim, which blames the caller"
    (doseq (_ (range 200)) (dispatch-site-call 1))
    (let (error (check-allow :type-mismatch (try (dispatch-site-call "x") (catch error error))))
      (assert= :caller (get error :blame))
      (assert= 1 (get error :argument))))
  (test "a bad result at a warm site is still checked, and blames the callee"
    (doseq (_ (range 200)) (dispatch-site-lie-call 1))
    (let (error (try (dispatch-site-lie-call -1) (catch error error)))
      (assert= :callee (get error :blame))
      (is (string/ends-with? (->string (get error :function)) "dispatch-site-maybe-lie"))))
  (test "a native caller's linked call still checks the result it gets back"
    (assert= 499500 (dispatch-site-lie-loop 1000 0))
    (let (error (try (dispatch-site-lie-loop 1001 0) (catch error error)))
      (assert= :callee (get error :blame)))))

;; A `defrecord` name, a record shape over a record instance, and the compound forms an
;; editor declares are decided by the kernel (ADR-773), so a call over them is entered —
;; and a value that does not inhabit them still runs the shim, which blames.
(defrecord dispatch-buffer (name lines))
(defrecord dispatch-other (name))
(defn dispatch-buffer-name (buffer) (:name buffer))
(sig! dispatch-buffer-name (dispatch-buffer -> any))
(defn dispatch-tuple-sum (pair) (+ (first pair) (second pair)))
(sig! dispatch-tuple-sum ((tuple int int) -> int))
(defn dispatch-map-size (table) (count table))
(sig! dispatch-map-size ((map keyword int) -> int))
(defn dispatch-rows (n) (map (range n) (fn (i) [i (str i)])))
(sig! dispatch-rows (int -> (list (tuple int string))))

(describe "record names and compound forms are decided without the walk"
  (test "a defrecord-typed argument is entered"
    (let ([n value] (entered-by (fn () (dispatch-buffer-name (dispatch-buffer "a" [])))))
      (is (entered? n 1))
      (assert= "a" value)))
  (test "another record, or a map, under a record name is the caller's error"
    (assert= :caller
      (get (check-allow :type-mismatch
             (try (dispatch-buffer-name (dispatch-other "a")) (catch error error)))
        :blame))
    (assert= :caller
      (get (check-allow :type-mismatch (try (dispatch-buffer-name {:name "a"}) (catch error error)))
        :blame)))
  (test "a tuple, a map and a fresh list of tuples are entered and checked"
    (let ([n value] (entered-by (fn () (dispatch-tuple-sum [1 2]))))
      (is (entered? n 1))
      (assert= 3 value))
    (let ([n value] (entered-by (fn () (dispatch-map-size {:a 1 :b 2}))))
      (is (entered? n 1))
      (assert= 2 value))
    (assert= [0 "0"] (first (dispatch-rows 3)))
    (assert= :caller
      (get (check-allow :type-mismatch (try (dispatch-tuple-sum [1 "2"]) (catch error error)))
        :blame))
    (assert= :caller
      (get (check-allow :type-mismatch (try (dispatch-map-size {:a "1"}) (catch error error)))
        :blame))))
