;; tests/highlight_test.blsp — the lexical highlighter / analysis (std/highlight.blsp).
;;
;; The module is pure (source string -> spans / chunks / positions), so it's fully
;; testable without a terminal — the live `term-*` rendering lives in
;; std/lineedit.blsp and is exercised manually. These cover the lexer's token
;; classification, the bracket matcher (incl. brackets ignored inside strings),
;; the signature scanner's callee + arg-index, and the completion helpers. The
;; closing :isolated block tokenizes inside a spawned process to prove the spans
;; (vectors of face maps) round-trip the copy-on-send heap boundary.

(defmodule highlight-test (:use test) (:use editor/line-cache) (:use-internals editor/highlight))

;; `highlight-spans` walks the native `scan-tokens` stream; pin that lexer's shape too.
(describe "scan-tokens — the native lexical token stream"
  ;; scan-tokens returns a VECTOR of [start end kind text] (like parse-source).
  (test "tokens carry [start end kind text], whitespace skipped"
    (assert= (reflect/scan-tokens "(map 42 :k)")
      [[0 1 :open "("]
        [1 4 :symbol "map"]
        [5 7 :number "42"]
        [8 10 :keyword ":k"]
        [10 11 :close ")"]]))
  (test "strings honour escapes; comments run to end of input"
    (assert= (reflect/scan-tokens "\"a\\\"b\" ; c")
      [[0 6 :string "\"a\\\"b\""] [7 10 :comment "; c"]]))
  (test "nil/true/false classify as keyword (constants)"
    (assert= (reflect/scan-tokens "nil") [[0 3 :keyword "nil"]]))
  (test "a number is whatever the reader reads as one — radix, ratio, decimal, bignum"
    ;; the kind comes from the reader's own classifier, not a second opinion on the
    ;; shape (ADR-334): before, `0xFF` / `1/2` / `1.50M` all lexed as :symbol.
    (map ["0xFF" "0XFF" "-0b1010" "0o17" "1/2" "1.50M" "99999999999999999999" "inf" "-inf"]
      (fn (t) (assert= (nth (first (reflect/scan-tokens t)) 2) :number)))
    ;; a malformed digit-led token is number-shaped, not a name — the LSP carries the error
    (map ["0xZZ" "0x" "1e" "1_000"]
      (fn (t) (assert= (nth (first (reflect/scan-tokens t)) 2) :number)))
    ;; names that merely contain a radix prefix, or that Rust would parse as a float
    (map ["x0b1" "a0xFF" "infinity" "+" "..."]
      (fn (t) (assert= (nth (first (reflect/scan-tokens t)) 2) :symbol))))
  (test "empty source yields no tokens"
    (assert= (reflect/scan-tokens "") [])))

(describe "highlight-spans — token classification"
  (test "special form vs call vs number"
    (assert= (highlight-spans "(+ 1)")
      (list [1 2 hl-face-function] [3 4 hl-face-number]))
    (assert= (highlight-spans "(if x)")
      (list [1 3 hl-face-special])))
  (test "strings and comments"
    (assert= (highlight-spans "\"hi\" ; c")
      (list [0 4 hl-face-string] [5 8 hl-face-comment])))
  (test "keywords colour as symbols"
    (assert= (highlight-spans ":foo") (list [0 4 hl-face-symbol])))
  (test "nil / true / false colour as constants, even in head position"
    (assert= (highlight-spans "nil") (list [0 3 hl-face-symbol]))
    (assert= (highlight-spans "(true)") (list [1 5 hl-face-symbol])))
  (test "a radix literal colours as a number, in argument and in head position"
    (assert= (highlight-spans "(bit/and b 0x3F)")
      (list [1 8 hl-face-function] [11 15 hl-face-number]))
    (assert= (highlight-spans "(0xFF)") (list [1 5 hl-face-number])))
  (test "a plain variable reference carries no span"
    (assert= (highlight-spans "x") '())))

;; A docstring and a string value are the same TOKEN — only position tells them apart —
;; so these pin the positional rule the kernel's `(reflect/doc-forms)` states (ADR-265).
(describe "highlight-spans — a docstring is not a string value"
  (test "the string after a defn's parameter list is documentation"
    (assert= (highlight-spans "(defn f () \"Doc.\" 1)")
      (list [1 5 hl-face-special]
        [6 7 hl-face-definition]
        [11 17 hl-face-doc]
        [18 19 hl-face-number])))
  (test "a defmodule's docstring may be the form's last element"
    (assert= (highlight-spans "(defmodule m \"Doc.\")")
      (list [1 10 hl-face-special] [11 12 hl-face-definition] [13 19 hl-face-doc])))
  (test "a multi-arity defn's leading docstring comes before the arms"
    (assert= (highlight-spans "(defn f \"Doc.\" ((x) x))")
      (list [1 5 hl-face-special]
        [6 7 hl-face-definition]
        [8 14 hl-face-doc]
        [17 18 hl-face-function])))
  (test "a function whose body is a LONE string returns it — that is a value"
    (assert= (highlight-spans "(defn f () \"hi\")")
      (list [1 5 hl-face-special] [6 7 hl-face-definition] [11 15 hl-face-string])))
  (test "the body string after a docstring stays a string"
    (assert= (highlight-spans "(defn f () \"Doc.\" \"hi\")")
      (list [1 5 hl-face-special]
        [6 7 hl-face-definition]
        [11 17 hl-face-doc]
        [18 22 hl-face-string])))
  (test "a def / def- value is never documentation (def takes no docstring)"
    (assert= (highlight-spans "(def- p \"[a-z]\")")
      (list [1 5 hl-face-function] [6 7 hl-face-definition] [8 15 hl-face-string])))
  (test "a string deeper in the body is a value, whatever its position"
    (assert= (highlight-spans "(defn f () (str \"a\"))")
      (list [1 5 hl-face-special]
        [6 7 hl-face-definition]
        [12 15 hl-face-function]
        [16 19 hl-face-string])))
  (test "doc-form? mirrors the kernel's (reflect/doc-forms)"
    (is (doc-form? "defn"))
    (is (doc-form? "defmodule"))
    (is (not (doc-form? "def")))
    (is (not (doc-form? "def-")))
    (is (not (doc-form? "let")))))

;; ---- definitions and punctuation (ADR-614) ----------------------------------------
;; A theme that colours where a thing is DEFINED and leaves calls plain, and dims the
;; brackets, needs the lexer to tell those apart. Each test styles the two faces apart from
;; the call face, then puts the registry back: every other test reads the defaults.

(defn- with-faces (styles thunk)
  ;; `thunk`'s value with each `face -> attrs` of `styles` registered, the old ones restored
  (let (saved (into [] (map (keys styles) (fn (name) [name (get (editor/face/faces) name)])))
        _ (doseq (entry styles) (let ([name attrs] entry) (editor/face/def-face name attrs)))
        result (thunk))
    (doseq (entry saved) (let ([name attrs] entry) (editor/face/def-face name attrs)))
    result))

(def- parted
  {:syntax/definition {:fg "#000001"} :syntax/punctuation {:fg "#000002"}})

(defn- span-at (spans start)
  ;; the face of the span that starts at `start`, or nil
  (seq/find (map spans (fn ([s _ f]) (when (= s start) f))) (fn (f) f)))

(describe "highlight-spans — a definition's name, apart from a call's head"
  :isolated (test "the name a defn binds takes the definition face; a call head keeps the call face"
    (let (spans (with-faces parted (fn () (highlight-spans "(defn area (s) (square s))"))))
      (assert= (span-at spans 6) {:fg "#000001"})
      (assert= (span-at spans 16) hl-face-function)))
  (test "def, defmacro and defmodule name what they define too"
    (with-faces parted
      (fn ()
        (assert= (span-at (highlight-spans "(def pi 3.14)") 5) {:fg "#000001"})
        (assert= (span-at (highlight-spans "(defmacro when2 (c) c)") 10) {:fg "#000001"})
        (assert= (span-at (highlight-spans "(defmodule geometry)") 11) {:fg "#000001"})
        ;; the private forms, which are not special forms themselves
        (assert= (span-at (highlight-spans "(defn- square (x) x)") 7) {:fg "#000001"})
        (assert= (span-at (highlight-spans "(def- limit 3)") 6) {:fg "#000001"}))))
  (test "a symbol after a head that defines nothing is left plain"
    (with-faces {:syntax/definition {:fg "#000001"}}
      (fn ()
        (assert= (highlight-spans "(let x)") (list [1 4 hl-face-special]))
        (assert= (span-at (highlight-spans "(map xs f)") 5) nil))))
  (test "another dialect's definer, by its special-form set — Scheme's name inside a list"
    (let (scheme {"define" true "lambda" true}
          spans (with-faces parted (fn () (highlight-spans "(define (square x) (* x x))" scheme))))
      (assert= (span-at spans 1) hl-face-special)
      (assert= (span-at spans 9) {:fg "#000001"})
      (assert= (span-at spans 20) hl-face-function)))
  (test "elisp's defun"
    (let (spans (with-faces parted
                  (fn () (highlight-spans "(defun greet (name) (message name))" {"defun" true}))))
      (assert= (span-at spans 7) {:fg "#000001"})
      (assert= (span-at spans 21) hl-face-function)))
  (test "by default the definition face IS the call face"
    (assert= (span-at (highlight-spans "(defn area (s) s)") 6) hl-face-function)
    (assert= hl-face-definition hl-face-function))
  (test "the line lexer agrees, across a line break after the definer"
    (let (lex (:lex (with-faces parted (fn () (lisp-line-lexer))))
          [_ state] (lex "(defn" [nil nil])
          [spans _] (lex "  area (s) s)" state))
      (assert= (span-at spans 2) {:fg "#000001"}))))

(describe "highlight-spans — punctuation"
  :isolated (test "by default a bracket carries no span"
    (assert= (highlight-spans "(+ 1)") (list [1 2 hl-face-function] [3 4 hl-face-number])))
  (test "with a punctuation face every bracket takes it"
    (let (spans (with-faces parted (fn () (highlight-spans "(f [1] {:a 2})"))))
      (assert= (map (seq/filter spans (fn ([_ _ f]) (= f {:fg "#000002"}))) first)
        (list 0 3 5 7 12 13))))
  (test "the line lexer paints them too, and a rainbow takes precedence"
    (let (plain (with-faces parted (fn () (lisp-line-lexer)))
          rainbow (with-faces (assoc parted :syntax/delimiter-1 {:fg "#000003"})
                    (fn () (lisp-line-lexer nil {:rainbow true})))
          [plain-spans _] ((:lex plain) "(a)" [nil nil])
          [rainbow-spans _] ((:lex rainbow) "(a)" [nil nil]))
      (assert= (span-at plain-spans 0) {:fg "#000002"})
      (assert= (span-at rainbow-spans 0) {:fg "#000003"}))))

;; ---- a keyword literal, apart from a language keyword (ADR-616) ---------------------
;; A theme that leaves keywords plain and colours literals (Tonsky's rule) needs `:foo` on a
;; face of its own: the tree-sitter languages' keywords (`def`, `fn`) are `:syntax/keyword`.

(describe "highlight-spans — a :keyword literal takes the symbol face"
  :isolated (test "styled apart, `:foo`, nil, true and false take `:syntax/symbol`, not the keyword face"
    (let (spans (with-faces {:syntax/keyword {:fg "#000001"} :syntax/symbol {:fg "#000004"}}
                  (fn () (highlight-spans "(f :foo nil true false)"))))
      (assert= (map (seq/filter spans (fn ([_ _ f]) (= f {:fg "#000004"}))) first) (list 3 8 12 17))
      (is (not (any? spans (fn ([_ _ f]) (= f {:fg "#000001"})))))))
  (test "the line lexer agrees"
    (let (lex (:lex (with-faces {:syntax/symbol {:fg "#000004"}} (fn () (lisp-line-lexer)))))
      (assert= (span-at (first (lex "(f :foo)" [nil nil])) 3) {:fg "#000004"})))
  (test "by default the symbol face IS the keyword face, and the constant face the special"
    (assert= hl-face-symbol hl-face-keyword)
    (assert= hl-face-constant hl-face-special)
    (assert= (highlight-spans ":foo") (list [0 4 hl-face-symbol]))))

(describe "highlight-window — spans shifted into absolute coordinates"
  (test "base 0 equals highlight-spans"
    (assert= (highlight-window "(+ 1)" 0) (highlight-spans "(+ 1)")))
  (test "every span start/end is shifted by base"
    (assert= (highlight-window "(+ 1)" 10)
      (list [11 12 hl-face-function] [13 14 hl-face-number]))))

; point inside the string → the enclosing (a form
(describe "safe-restart — a top-level form start to lex from"
  (test "backs up to the start of the enclosing top-level form"
    ;; `(defn a ()` is UNCLOSED, so the second defn — column 0 or not — is textually
    ;; inside it: the only sound restart is 0 (depth-tracked scan, not the Emacs
    ;; column-0 heuristic; the same rule that lets TAB re-indent a mis-indented arm).
    (assert= (safe-restart "(defn a ()\n(defn b ()" 18) 0))
  (test "a top-level open bracket at pos is itself the restart"
    (assert= (safe-restart "(a)\n(b)" 4) 4))
  (test "an INDENTED top-level open is a restart point (depth 0 decides, not the column)"
    (assert= (safe-restart "   (indented)" 8) 3)
    (assert= (safe-restart "" 0) 0))
  (test "a column-0 open INSIDE an unclosed form is not a restart point"
    ;; the classic trap: a mis-indented multi-arity defn arm at column 0
    (assert= (safe-restart "(defn fib\n((0) 0)\n((1) 1)" 15) 0))
  (test "an indented form falls back to the top-level form above it"
    (assert= (safe-restart "(let (x 1)\n  (f x))" 15) 0))
  (test "a column-0 bracket INSIDE a multi-line string is not a restart point"
    ;; value:  (a / "s / (x  <- col-0 ( but inside the string / ") / (b)
    ;; the ( at offset 6 opens no form — it's string content, so it must be skipped.
    (let (src "(a\n\"s\n(x\n\")\n(b)")
      ; point in (b) → (b), not the in-string (
      (assert= (safe-restart src 13) 12)
      ; the in-string ( itself → the (a form at 0
      (assert= (safe-restart src 6) 0)
      (assert= (safe-restart src 7) 0))))
(describe "highlight-chunks — tiling a visible line"
  (test "chunks cover the whole line, coalescing default runs"
    (assert= (highlight-chunks "(+ 1)" 0 "(+ 1)" '())
      (list ["(" nil]
        ["+" hl-face-function]
        [" " nil]
        ["1" hl-face-number]
        [")" nil])))
  (test "an empty line yields no chunks"
    (assert= (highlight-chunks "" 0 "" '()) '())))

(describe "face-at — the span covering an offset"
  (test "a hit inside a span returns its face"
    (assert= (face-at (list [1 2 hl-face-function] [3 4 hl-face-number]) 3) hl-face-number))
  (test "a gap between spans has no face"
    (assert= (face-at (list [1 2 hl-face-function] [3 4 hl-face-number]) 2) nil))
  (test "the end offset is exclusive"
    (assert= (face-at (list [1 4 hl-face-string]) 4) nil)))

(describe "ranges-face — merged overlay faces at an offset"
  (test "no covering range yields nil"
    (assert= (ranges-face (list [0 2 {:reverse true}]) 5) nil))
  (test "overlapping ranges merge, later winning on key conflict"
    (assert= (ranges-face (list [0 5 {:fg :red :bold true}] [0 5 {:fg :blue}]) 2)
      {:fg :blue :bold true})))

(describe "fontify-runs — span + range tiling into runs"
  (test "plain text is one nil-faced run"
    (assert= (fontify-runs "abc" 0 '() '()) (list ["abc" nil])))
  (test "adjacent equal-face chars coalesce into one run"
    (assert= (fontify-runs "abc" 0 (list [0 3 hl-face-string]) '())
      (list ["abc" hl-face-string])))
  (test "a covering range splits a run and merges on top of the span face"
    (assert= (fontify-runs "abc" 0 (list [0 3 {:fg :green}]) (list [1 2 {:reverse true}]))
      (list ["a" {:fg :green}]
        ["b" {:fg :green :reverse true}]
        ["c" {:fg :green}])))
  (test "base offsets span / range lookups into buffer coordinates"
    ;; text "bc" begins at buffer offset 1, so the [1 2 …] span faces only "b"
    (assert= (fontify-runs "bc" 1 (list [1 2 hl-face-number]) '())
      (list ["b" hl-face-number] ["c" nil])))
  (test "empty text yields no runs"
    (assert= (fontify-runs "" 0 '() '()) '())))

;; span-runs is the native no-overlay tiler `fontify-runs` calls when no range crosses
;; the line (the common per-frame case). The fontify-runs cases above exercise it through
;; that path; these pin its contract directly.
(describe "span-runs (native no-overlay tiler)"
  (test "a gap before and after a span are nil-faced runs"
    (assert= (%span-runs "a b" 0 (list [2 3 {:fg :green}]))
      (list ["a " nil] ["b" {:fg :green}])))
  (test "touching same-face spans coalesce; a base offsets into buffer coords"
    (assert= (%span-runs "abc" 0 (list [0 1 {:fg :red}] [1 2 {:fg :red}]))
      (list ["ab" {:fg :red}] ["c" nil]))
    (assert= (%span-runs "bc" 1 (list [1 2 {:fg :yellow}])) (list ["b" {:fg :yellow}] ["c" nil])))
  (test "no spans → one nil run; empty text → no runs"
    (assert= (%span-runs "abc" 0 '()) (list ["abc" nil]))
    (assert= (%span-runs "" 0 '()) '()))
  ;; `base` is caller-controlled; a huge base must not panic the host (kernel
  ;; audit #3 — `base + text-length` overflowed i64 -> SIGABRT / OOB char slice).
  (test "a base that overflows i64 raises a clean error, never panics the host"
    (assert-error (%span-runs "a" 9223372036854775807 '()))
    (assert-error (%span-runs "abc" 9223372036854775807 (list [0 1 {:fg :red}]))))
  (test "a large-but-non-overflowing base still tiles correctly"
    (assert= (%span-runs "abc"
               9223372036854775800
               (list [9223372036854775801 9223372036854775806 {:fg :red}]))
      (list ["a" nil] ["bc" {:fg :red}]))))

(describe "special-form?"
  (test "core forms / macros are special"
    (is (special-form? "defn"))
    (is (special-form? "cond"))
    (is (special-form? "->")))
  (test "ordinary functions are not"
    (refute (special-form? "map"))
    (refute (special-form? "reduce"))))

(describe "bracket-match — the pair adjacent to the cursor"
  (test "matches an opener forward and a closer backward"
    (assert= (bracket-match "(+ 1)" 1) [0 4])
    (assert= (bracket-match "(+ 1)" 5) [0 4]))
  (test "an unclosed opener is unmatched"
    (assert= (bracket-match "(+ 1" 1) [0 :unmatched]))
  (test "no bracket adjacent to the cursor"
    (assert= (bracket-match "abc" 1) nil))
  (test "brackets inside a string are ignored"
    ;; (str ")" 1) — the ) inside the string must not match the leading (
    (assert= (bracket-match "(str \")\" 1)" 1) [0 10]))
  ;; Emacs's order: just outside a pair (a closer left of the cursor, an opener under it)
  ;; before just inside one (an opener left of it, a closer under it)
  (test "the cursor on an inner opener lights the inner pair, not the outer one"
    (assert= (bracket-match "((x) y)" 1) [1 3]))
  (test "a closer left of the cursor wins over an opener under it"
    (assert= (bracket-match "(a)(b)" 3) [0 2]))
  (test "a closer left of the cursor wins over a closer under it"
    (assert= (bracket-match "((a))" 4) [1 3]))
  (test "just inside a pair: the opener left of the cursor, else the closer under it"
    (assert= (bracket-match "(a b)" 1) [0 4])
    (assert= (bracket-match "(a b)" 4) [0 4])
    (assert= (bracket-match "()" 1) [0 1])))

(describe "symbol-at — what the cursor is ON"
  ;; `symbol-prefix-at`'s sibling and a different question: that one stops dead at the cursor
  ;; (what has been TYPED, which is what completion needs), this one runs to the end of the
  ;; token (what is being POINTED at, which is what a doc lookup needs).
  (test "the whole token, wherever in it the cursor sits"
    (assert= (symbol-at "(map f xs)" 1) [1 "map"])
    (assert= (symbol-at "(map f xs)" 2) [1 "map"])
    (assert= (symbol-at "(map f xs)" 4) [1 "map"]))

  ;; A cursor immediately AFTER a token counts as on it, the way Emacs's `symbol-at-point`
  ;; does — that is where point lands the moment you finish typing one.
  (test "just past a token still counts as on it"
    (assert= (symbol-at "(map f xs)" 4) [1 "map"]))

  (test "between delimiters is on no symbol"
    (assert= (symbol-at "(map f xs)" 0) nil)
    (assert= (symbol-at "(map f xs)" 10) nil)
    (assert= (symbol-at "( )" 1) nil))

  (test "operators are symbols too"
    (assert= (symbol-at "(+ 1 2)" 1) [1 "+"])))

(describe "closer-redundant? — is this closer already there"
  ;; The question an editor asks before self-inserting a closing delimiter: with point at
  ;; `(+ 1 2|)`, typing `)` should move over the one already there rather than make
  ;; `(+ 1 2))` — Emacs's `electric-pair-mode` skip, paredit's `close-round`.
  (test "the closer of the form you are in is redundant"
    (is (closer-redundant? "(+ 1 2)" 6 ")"))
    (is (closer-redundant? "[1 2]" 4 "]"))
    (is (closer-redundant? "{:a 1}" 5 "}")))

  ;; The condition is about the enclosing FORM, not the next character — which is what stops
  ;; it eating a delimiter you meant. In `(foo (bar|)` the `)` closes `(bar`, so stepping
  ;; over it is right and leaves `(foo` still to close.
  (test "an inner form's closer is redundant; the outer one still has to be typed"
    (is (closer-redundant? "(foo (bar)" 9 ")"))
    (refute (closer-redundant? "(foo (bar)" 10 ")")))

  (test "a stray closer at top level closes nothing and is typed"
    (refute (closer-redundant? ")" 0 ")"))
    (refute (closer-redundant? "(+ 1 2)" 7 ")")))

  ;; Typing the character the reader will complain about is more honest than silently
  ;; stepping over a mismatch.
  (test "a mismatched closer is typed"
    (refute (closer-redundant? "[1 2)" 4 ")")))

  ;; Inside a string or a comment a bracket is a character, not structure.
  (test "text is text"
    (refute (closer-redundant? "(str \";)\")" 6 ")"))
    (refute (closer-redundant? "(a) ;; )" 7 ")")))

  (test "an unterminated string swallows the rest, so nothing in it is redundant"
    (refute (closer-redundant? "(str \")" 6 ")"))))

(describe "enclosing-call — the call around the cursor"
  (test "callee and arg index"
    (assert= (enclosing-call "(map f " 7) ["map" 1])
    (assert= (enclosing-call "(map f xs" 9) ["map" 1]))
  (test "the innermost call wins"
    (assert= (enclosing-call "(+ (* 2 3) " 11) ["+" 1]))
  (test "outside any call there is no hint"
    (assert= (enclosing-call "abc " 4) nil))
  (test "a number in head position is not a callee"
    ;; `hl-number?` asks the reader's classifier, so a radix literal or ratio in head
    ;; position is data, not a call to hint on
    (assert= (enclosing-call "(0xFF " 6) nil)
    (assert= (enclosing-call "(1/2 " 5) nil)
    (assert= (enclosing-call "(42 " 4) nil))
  (test "a call deep below many top-level forms is found (scan starts at the defun, not 0)"
    ;; the enclosing-bracket scan begins at the nearest column-0 form start (safe-restart),
    ;; so cost is O(enclosing form), not O(pos) — but the answer must still be exact.
    (let (lead (string/join (map (range 500) (fn (_i) "(defn f ())\n")) "")
          src (str lead "(map g "))
      (assert= (enclosing-call src (+ (string/length lead) 7)) ["map" 1]))))

(describe "completion helpers"
  (test "symbol-prefix-at returns the token start and text"
    (assert= (symbol-prefix-at "(map fo" 7) [5 "fo"])
    (assert= (symbol-prefix-at "(+ " 3) [3 ""]))
  (test "common-prefix of candidates"
    (assert= (common-prefix ["map" "mapcat" "max"]) "ma")
    (assert= (common-prefix ["reduce"]) "reduce")
    (assert= (common-prefix []) "")))

;; Cross-process: spans (vectors carrying face *maps*) cross a heap boundary via
;; send (a deep copy) before being compared, proving the analysis output survives
;; the copy-on-send round-trip under the scheduler — not just same-heap building.
(describe "highlight-spans across processes"
  :isolated (test "spans built in another process round-trip intact"
    (let (w (spawn (receive ([:lex src from] (send from (highlight-spans src))))))
      (send w [:lex "(+ 1)" (self)])
      (assert= (receive (r r))
        (list [1 2 hl-face-function] [3 4 hl-face-number])))))

(describe "line-restart — a line-oriented mode's restart rule (ADR-352)"
  (test "answers the position itself: any line start is a safe restart"
    (assert= (editor/highlight/line-restart "a\nb\nc" 4) 4)
    (assert= (editor/highlight/line-restart "" 0) 0)))

;; The closer scans start at the top-level form around the cursor, not at 0. Earlier forms
;; full of unbalanced-looking text — a `(` inside a string, a `)` in a comment, a char
;; literal — must not leak into a later form's answer.
(def hl-later-form-text "(def a \"((\") ; ))\n(def b [1 2])\n(foo (bar 1))")

(describe "closer scans in a later top-level form"
  (test "a closer that closes the innermost form is redundant"
    ;; `(foo (bar 1|))`: the `)` at point closes `(bar`
    (let (pos (+ (index-of hl-later-form-text "1))") 1))
      (is (closer-redundant? hl-later-form-text pos ")"))))
  (test "a mismatched closer is not"
    (let (pos (+ (index-of hl-later-form-text "1))") 1))
      (refute (closer-redundant? hl-later-form-text pos "]"))))
  (test "bracket-match pairs a closer with its opener in the later form"
    (let (close (+ (index-of hl-later-form-text "1))") 2)
          open (index-of hl-later-form-text "(foo"))
      (assert= [open close] (bracket-match hl-later-form-text (inc close))))))

(def ll-source
  (string/join ["(defmodule probe"
                 "  \"A module docstring" "over (three) lines, with \\\"escaped\\\" quotes"
                 "and a ; that is no comment.\")" "" "(defn f (x)" "  \"Doc that" ""
                 "spans a blank line.\"" "  (let (s \"one-line \\\"string\\\"\" ; a \"comment\""
                 "        r #\"re\")" "    [s r :k 42]))" "(def g \"a value"
                 "on two lines\" ) (h \"tail\")"]
    "\n"))

(defn ll-faces (src spans from to)
  "The face of each character of `src` in `[from, to)` that is not a newline — what a
reader sees, which a multi-line string's one span and its per-line spans agree on."
  (for (i (range from to) :when (not (= (string/char-at src i) "\n")) :into [])
    [i (face-at spans i)]))

(describe "lisp-line-lexer — highlight-spans a line at a time"
  (test "every window colours as the whole source does"
    (let (rope (text/from-string ll-source)
          lines (text/line-count rope)
          whole (highlight-spans ll-source)
          lexer (lisp-line-lexer))
      (map (range lines)
        (fn (lo)
          (let (spans (second (line-cache-update (line-cache) lexer rope lo lines))
                from (text/line->char rope lo))
            (assert= (ll-faces ll-source spans from (string/length ll-source))
              (ll-faces ll-source whole from (string/length ll-source))))))))

  (test "a line inside a docstring carries the doc face, a value string's the string face"
    (let (lex (:lex (lisp-line-lexer))
          [_ in-doc] (lex "(defn f \"doc" [nil nil])
          [_ in-value] (lex "(def g (str \"value" [nil nil]))
      (assert= (first (lex "more" in-doc)) (list [0 4 hl-face-doc]))
      (assert= (first (lex "more" in-value)) (list [0 4 hl-face-string]))))

  (test "an escaped quote at a line's end leaves the string open"
    (let (lex (:lex (lisp-line-lexer))
          [_ state] (lex "(f \"a\\\"" [nil nil]))
      (is (not (nil? (second state))))))

  (test "the line closing a string goes back to code"
    (let (lex (:lex (lisp-line-lexer))
          [_ state] (lex "(f \"a" [nil nil])
          [spans after] (lex "b\" (g 1)" state))
      (assert= spans (list [0 2 hl-face-string] [4 5 hl-face-function] [6 7 hl-face-number]))
      (assert= after [(list ["(" 3 "f" true]) nil])))

  (test "a docstring ending its line is a doc, the body unseen"
    ;; the one place a line differs from the whole source: here `\"hi\"` may be followed
    ;; by more body on the next line, so it reads as the doc it almost always is
    (let (lex (:lex (lisp-line-lexer)))
      (assert= (first (lex "(defn f () \"hi\"" [nil nil]))
        (list [1 5 hl-face-special] [6 7 hl-face-definition] [11 15 hl-face-doc])))))

(describe "lisp-line-lexer — rainbow brackets"
  (test "each bracket takes its depth's face, a pair one colour, across lines"
    (let (faces (vec (map (range 1 10) (fn (depth) {:fg (str "#" depth)})))
          _ (doseq (depth (range 1 10))
              (editor/face/face-set (keyword (str "syntax/delimiter-" depth))
                (nth faces (dec depth))))
          lex (:lex (lisp-line-lexer nil {:rainbow true}))
          [first-spans state] (lex "(a [b" [nil nil])
          [second-spans _] (lex " c] d)" state)
          bracket-face (fn (spans at)
                         (seq/find (map spans (fn ([s _e f]) (when (= s at) f))) (fn (f) f))))
      ;; `(` depth 1, `[` depth 2 on the first line; `]` closes depth 2, `)` depth 1 below
      (assert= (bracket-face first-spans 0) (nth faces 0))
      (assert= (bracket-face first-spans 3) (nth faces 1))
      (assert= (bracket-face second-spans 2) (nth faces 1))
      (assert= (bracket-face second-spans 5) (nth faces 0))))
  (test "without the option no bracket is coloured"
    (let ([spans _] ((:lex (lisp-line-lexer)) "(a)" [nil nil]))
      ;; `a`, the call head, is coloured; neither bracket is
      (is (not (any? spans (fn ([s _ _]) (or (= s 0) (= s 2)))))))))

(describe "lisp-line-lexer — the edges a line meets"
  (test "a string whose line ends in a lone backslash stays open, and nothing raises"
    ;; typing an escape at a line's end: `"a\` before its letter
    (let (lex (:lex (lisp-line-lexer))
          [spans state] (lex "(def x \"a\\" [nil nil]))
      (is (not (nil? (second state))))
      (is (not (empty? spans)))
      ;; and the continuation of such a string lexes too
      (is (vector? (second (lex "\\" state))))))
  (test "after its third form a list's lines start in the same state, however many forms"
    ;; what lets the line cache stop re-lexing after an edit inside a long body
    (let (lex (:lex (lisp-line-lexer))
          after (fn (line) (second (lex line [nil nil]))))
      (assert= (after "(defn f (x) (a) (b) (c)") (after "(defn f (x) (a) (b) (c) (d)")))))
