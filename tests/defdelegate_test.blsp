;; tests/defdelegate_test.blsp — `defdelegate` (ADR-751): a module's function that is another
;; module's, by name, forwarding every kind of parameter and staying late-bound.
(defmodule defdelegate-test
  (:use test))

(defn target-sum (a b) (+ a b))
(defn target-optional (a &optional (b 10)) [a b])
(defn target-rest (a & more) [a more])
;; redefined by the late-binding test alone: the tests run side by side
(defn target-rebound (a b) (+ a b))

(defdelegate sum (a b) defdelegate-test :as target-sum)
(defdelegate optional (a &optional (b 10)) defdelegate-test :as target-optional)
(defdelegate rest-of (a & more) defdelegate-test :as target-rest)
(defdelegate join (parts separator) string)
(defdelegate rebound (a b) defdelegate-test :as target-rebound)

(describe "defdelegate"
  (test "forwards plain arguments, to the same name or the :as one"
    (assert= 5 (sum 2 3))
    (assert= "a-b" (join ["a" "b"] "-")))
  (test "forwards an optional argument, given or defaulted by the target's own default"
    (assert= [1 2] (optional 1 2))
    (assert= [1 10] (optional 1)))
  (test "forwards a rest argument"
    (assert= [1 '(2 3)] (rest-of 1 2 3))
    (assert= [1 nil] (rest-of 1)))
  (test "stays late-bound: a redefined target is what the next call runs"
    (assert= 5 (rebound 2 3))
    (defn target-rebound (a b) (* a b))
    (assert= 6 (rebound 2 3)))
  (test "names its target in its docstring"
    (is (includes? (reflect/doc join) "[[string/join]]"))))
