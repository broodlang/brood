;; Tests for std/encoding.blsp — hex and base64.

(defmodule encoding-test (:use test))

;; The `*-decode-bytes` functions return `bytes | failure` (ADR-310), and every case here
;; feeds an input it controls — so a failure is a decoder REGRESSION, not an expected
;; channel. `decoded` says exactly that: it turns one into a named test failure instead of
;; letting it reach `into`, which would raise from inside the assertion. Asserting it up
;; front is also what lets the checker see a plain `bytes` (ADR-316: a failure is never a
;; valid materialisation), so these lines type without an opt-out.
(defn- decoded (v)
  (if (failure? v) (error "expected a successful decode, got " (pr-str v)) v))

;; ---- string/char->int / string/int->char / utf8 primitives --------------------------------

(describe "string/char->int / string/int->char"
  (test "ASCII roundtrip"
    (assert= 65 (string/char->int "A"))
    (assert= 97 (string/char->int "a"))
    (assert= 48 (string/char->int "0"))
    (assert= "A" (string/int->char 65))
    (assert= "a" (string/int->char 97)))
  (test "string/char->int uses first char only"
    (assert= 72 (string/char->int "Hello")))
  (test "non-ASCII codepoint"
    (assert= 233 (string/char->int "é"))
    (assert= "é" (string/int->char 233))))

(describe "string->utf8-bytes / utf8-bytes->string"
  (test "ASCII roundtrip"
    (let (bytes (string/->bytes "ABC"))
      (assert= [65 66 67] (into [] bytes))
      (assert= "ABC" (string/bytes-> bytes))))
  (test "multi-byte UTF-8 roundtrip"
    (let (s "é")
      ; U+00E9 = 0xC3 0xA9 in UTF-8
      (assert= s (string/bytes-> (string/->bytes s)))))
  (test "empty string"
    (assert= [] (into [] (string/->bytes "")))
    (assert= "" (string/bytes-> (string/->bytes "")))))

;; ---- hex encode -------------------------------------------------------------

(describe "hex-encode"
  (test "empty string"
    (assert= "" (encoding/hex-encode "")))
  (test "simple ASCII"
    (assert= "48656c6c6f" (encoding/hex-encode "Hello")))
  (test "single null byte"
    (assert= "00" (encoding/hex-encode (string/int->char 0))))
  (test "all hex digits present"
    (assert= "0a0b0c0d0e0f"
      (encoding/hex-encode (str (string/int->char 10)
                             (string/int->char 11)
                             (string/int->char 12)
                             (string/int->char 13)
                             (string/int->char 14)
                             (string/int->char 15))))))

(describe "hex-encode-upper"
  (test "uppercase output"
    (assert= "48656C6C6F" (encoding/hex-encode-upper "Hello"))))

;; ---- hex decode -------------------------------------------------------------

(describe "hex-decode"
  (test "roundtrip"
    (assert= "Hello" (encoding/hex-decode "48656c6c6f")))
  (test "uppercase hex"
    (assert= "Hello" (encoding/hex-decode "48656C6C6F")))
  (test "mixed case"
    (assert= "Hello" (encoding/hex-decode "48656c6C6f")))
  (test "empty string"
    (assert= "" (encoding/hex-decode "")))
  (test "odd length returns a failure"
    (is (failure? (encoding/hex-decode "abc"))))
  (test "invalid chars return nil"
    (is (failure? (encoding/hex-decode "gg"))))
  (test "encode-decode roundtrip"
    (let (s "Hello, World!")
      (assert= s (encoding/hex-decode (encoding/hex-encode s))))))

;; ---- base64 encode ----------------------------------------------------------

(describe "base64-encode"
  (test "empty string"
    (assert= "" (encoding/base64-encode "")))
  (test "RFC 4648 test vectors"
    (assert= "Zg==" (encoding/base64-encode "f"))
    (assert= "Zm8=" (encoding/base64-encode "fo"))
    (assert= "Zm9v" (encoding/base64-encode "foo"))
    (assert= "Zm9vYg==" (encoding/base64-encode "foob"))
    (assert= "Zm9vYmE=" (encoding/base64-encode "fooba"))
    (assert= "Zm9vYmFy" (encoding/base64-encode "foobar")))
  (test "Hello"
    (assert= "SGVsbG8=" (encoding/base64-encode "Hello")))
  (test "uses + and / for standard alphabet"
    (let (s (string/int->char 251))
      ; byte 0xFB → encodes to chars needing +/
      (is (string? (encoding/base64-encode s))))))

;; ---- base64 decode ----------------------------------------------------------

(describe "base64-decode"
  (test "RFC 4648 test vectors"
    (assert= "f" (encoding/base64-decode "Zg=="))
    (assert= "fo" (encoding/base64-decode "Zm8="))
    (assert= "foo" (encoding/base64-decode "Zm9v"))
    (assert= "foob" (encoding/base64-decode "Zm9vYg=="))
    (assert= "fooba" (encoding/base64-decode "Zm9vYmE="))
    (assert= "foobar" (encoding/base64-decode "Zm9vYmFy")))
  (test "empty string"
    (assert= "" (encoding/base64-decode "")))
  (test "invalid char returns nil"
    (is (failure? (encoding/base64-decode "Zg=!"))))
  (test "encode-decode roundtrip"
    (let (s "The quick brown fox jumps over the lazy dog")
      (assert= s (encoding/base64-decode (encoding/base64-encode s))))))

;; ---- base64 URL-safe --------------------------------------------------------

(describe "base64-url-encode / base64-url-decode"
  (test "uses - and _ instead of + and /"
    (let (s (encoding/base64-url-encode "Hello"))
      (refute (includes? s "+"))
      (refute (includes? s "/"))))
  (test "roundtrip"
    (let (s "Hello, World! 🎉")
      (assert= s (encoding/base64-url-decode (encoding/base64-url-encode s)))))
  (test "standard and url-safe differ for bytes that map to position 63"
    ;; bytes [0 0 63] → v4 = rem(63,64) = 63 → '/' in std, '_' in url-safe
    (let (bytes (str (string/int->char 0) (string/int->char 0) (string/int->char 63)))
      (assert= "AAA/" (encoding/base64-encode bytes))
      (assert= "AAA_" (encoding/base64-url-encode bytes)))))

;; ---- byte-vector variants (byte-faithful, no UTF-8 round-trip) --------------
;; The string functions UTF-8-encode, so a byte ≥ 0x80 becomes two bytes; the
;; -bytes variants carry arbitrary binary one byte per byte.

(describe "hex-encode-bytes / hex-decode-bytes"
  (test "encode a byte vector"
    (assert= "deadbeef" (encoding/hex-encode-bytes [222 173 190 239])))
  (test "uppercase variant"
    (assert= "DEADBEEF" (encoding/hex-encode-bytes-upper [222 173 190 239])))
  (test "decode to a bytes value"
    (assert= [222 173 190 239] (into [] (decoded (encoding/hex-decode-bytes "deadbeef")))))
  (test "decode-bytes returns a bytes value, not a string"
    (is (bytes? (encoding/hex-decode-bytes "00ff"))))
  (test "round-trips a high byte the string path would mangle"
    ;; 0xFF alone is not valid UTF-8; the string hex-decode can't carry it
    (assert= [255]
      (into [] (decoded (encoding/hex-decode-bytes (encoding/hex-encode-bytes [255]))))))
  (test "full 0x00-0xFF round-trip"
    (let (all (into [] (range 256)))
      (assert= all (into [] (decoded (encoding/hex-decode-bytes (encoding/hex-encode-bytes all)))))))
  (test "empty input decodes to an empty bytes value (not nil)"
    (assert= [] (into [] (decoded (encoding/hex-decode-bytes "")))))
  (test "odd length returns a failure"
    (is (failure? (encoding/hex-decode-bytes "abc"))))
  (test "invalid chars return nil"
    (is (failure? (encoding/hex-decode-bytes "zz")))))

(describe "base64-encode-bytes / base64-decode-bytes"
  ; "f"
  (test "RFC 4648 vectors over bytes"
    ; "foo"
    (assert= "Zm9v" (encoding/base64-encode-bytes [102 111 111]))
    (assert= "Zg==" (encoding/base64-encode-bytes [102])))
  (test "encodes a high byte the string path would mangle"
    ;; byte 0xFB → "+w==" using the '+' of the standard alphabet
    (assert= "+w==" (encoding/base64-encode-bytes [251])))
  (test "decode to a bytes value"
    (assert= [102 111 111] (into [] (decoded (encoding/base64-decode-bytes "Zm9v")))))
  (test "decode-bytes returns a bytes value, not a string"
    (is (bytes? (encoding/base64-decode-bytes "Zm9v"))))
  (test "empty input decodes to an empty bytes value (not nil)"
    (assert= [] (into [] (decoded (encoding/base64-decode-bytes "")))))
  (test "invalid input returns nil"
    (is (failure? (encoding/base64-decode-bytes "Zg=!"))))
  (test "full 0x00-0xFF round-trip"
    (let (all (into [] (range 256)))
      (assert= all
        (into [] (decoded (encoding/base64-decode-bytes (encoding/base64-encode-bytes all)))))))
  (test "url-safe byte round-trip"
    (let (bs [0 255 128 63 62])
      (assert= bs
        (into []
          (decoded (encoding/base64-url-decode-bytes (encoding/base64-url-encode-bytes bs)))))))
  (test "url-safe avoids + and /"
    (let (s (encoding/base64-url-encode-bytes [251 255]))
      (refute (includes? s "+"))
      (refute (includes? s "/")))))

;; ---- base64 padding must be TERMINAL ----------------------------------------
;; Decoding did `(string/replace s "=" "")`, deleting every `=` ANYWHERE — so a
;; misplaced one was not merely tolerated but erased: "QQ==QQ==" (two concatenated
;; payloads, not base64 at all) collapsed to "QQQQ" and decoded to a value, instead
;; of the nil a caller validating untrusted input relies on.

(describe "base64-decode — padding placement"
  (test "interior padding is rejected"
    (is (failure? (encoding/base64-decode "QQ==QQ==")))
    (is (failure? (encoding/base64-decode "Q=QQ")))
    (is (failure? (encoding/base64-decode "=QQQ"))))
  (test "more than two pad characters is rejected"
    (is (failure? (encoding/base64-decode "QQ==="))))
  (test "ordinary trailing padding still decodes"
    (assert= "A" (encoding/base64-decode "QQ=="))
    (assert= "AB" (encoding/base64-decode "QUI="))
    (assert= "ABC" (encoding/base64-decode "QUJD")))
  (test "unpadded input still decodes (the RFC 4648 §3.2 no-padding form)"
    (assert= "A" (encoding/base64-decode "QQ"))
    (assert= "AB" (encoding/base64-decode "QUI")))
  (test "the URL-safe decoder enforces the same rule"
    (is (failure? (encoding/base64-url-decode "QQ==QQ==")))
    (assert= "A" (encoding/base64-url-decode "QQ==")))
  (test "encode/decode still round-trips"
    (assert= "hello, world" (encoding/base64-decode (encoding/base64-encode "hello, world")))))
