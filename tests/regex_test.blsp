;; std/regex — Brood's pattern dialect over the native engine (ADR-389). Register-only —
;; run by `nest test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule regex-test (:use test) (:use regex))

; case-sensitive
(describe "regex match? (search)"
  (test "literals search anywhere in the string"
    (is (match? "hello" "lo"))
    (is (not (match? "hello" "xy"))))
  (test ". matches any one character"
    (is (match? "hello" "h.llo"))
    (is (not (match? "hllo" "h.llo"))))
  (test "anchors ^ and $"
    (is (match? "hello" "^he"))
    (is (not (match? "hello" "^el")))
    (is (match? "hello" "lo$"))
    (is (not (match? "hello" "el$"))))
  (test "suffix match — the .blsp file-type case"
    (is (match? "foo.blsp" "\\.blsp$"))
    (is (not (match? "foo.blsp.txt" "\\.blsp$")))
    ; \\. is a literal dot, not any-char
    (is (not (match? "fooXblsp" "\\.blsp$")))
    (is (not (match? "foo.BLSP" "\\.blsp$")))))
(describe "regex quantifiers"
  (test "* matches zero or more (greedy)"
    (is (matches? "ac" "ab*c"))
    (is (matches? "abbbc" "ab*c")))
  (test "+ matches one or more"
    (is (matches? "abc" "ab+c"))
    (is (not (matches? "ac" "ab+c"))))
  (test "? matches zero or one"
    (is (matches? "ac" "ab?c"))
    (is (matches? "abc" "ab?c"))
    (is (not (matches? "abbc" "ab?c"))))
  (test "greedy * still lets the rest match (backtracks)"
    (is (matches? "abcz" "a.*z"))
    (is (matches? "az" "a.*z"))))

(describe "regex classes & sets"
  (test "\\d \\w \\s"
    (is (matches? "2026" "\\d+"))
    (is (not (matches? "20x6" "\\d+")))
    (is (matches? "foo_bar9" "\\w+"))
    ; '-' isn't a word char
    (is (not (matches? "foo-bar" "\\w+")))
    (is (match? "a b" "\\s")))
  ;; Before these were parsed, `\S` was the letter S, so `brood\s+(\S+)` matched nothing in
  ;; `brood 0.42.0 (b3deae5a)` and said nothing (found porting the benchmark harness).
  (test "\\D \\W \\S are the negations, standing alone and inside a set"
    (is (matches? "0.42.0" "\\S+"))
    (is (not (match? " \t " "\\S")))
    (is (matches? "abc-" "\\D+"))
    (is (not (match? "123" "\\D")))
    (is (matches? " .-" "\\W+"))
    (is (not (match? "foo_9" "\\W")))
    (is (= (map/get-in (find "brood 0.42.0 (b3deae5a)" "brood\\s+(\\S+)\\s+\\(([0-9a-f]+)\\)")
             [:groups 0 :text])
          "0.42.0"))
    (is (matches? "ab" "[\\S]+"))
    (is (matches? "a.b" "[\\D.]+"))
    (is (not (match? "7" "[\\D]")))
    (is (matches? " \t" "[^\\S]+"))
    ;; `\d` is ASCII, so `\D` is its ASCII complement: a non-ASCII digit is not a `\d`
    (is (matches? "٣" "\\D")))
  (test "[...] set and [^...] negated set (explicit chars, no ranges yet)"
    (is (matches? "cabba" "[abc]+"))
    (is (not (matches? "cabx" "[abc]+")))
    (is (matches? "xyz" "[^abc]+"))
    (is (not (matches? "xya" "[^abc]+")))))

(describe "regex alternation & groups"
  (test "| alternation"
    (is (matches? "cat" "cat|dog"))
    (is (matches? "dog" "cat|dog"))
    (is (not (matches? "cow" "cat|dog"))))
  (test "(...) grouping, quantified"
    (is (matches? "ababab" "(ab)+"))
    (is (not (matches? "aba" "(ab)+")))
    (is (matches? "foobarbaz" "(foo|bar)+baz")))
  (test "escaped metacharacters are literal"
    (is (matches? "a+b" "a\\+b"))
    (is (not (matches? "aab" "a\\+b")))
    (is (matches? "(x)" "\\(x\\)"))))

(describe "regex matches? anchors the whole string"
  (test "must cover the entire string"
    (is (matches? "abc" "abc"))
    (is (not (matches? "abcd" "abc")))
    (is (not (matches? "xabc" "abc")))))

;; ---- character-set ranges and classes ---------------------------------------
;; `[0-9]` used to be a set of the three characters `0`, `-` and `9`: the dash was a
;; member, so `[0-9]` matched "-" and did NOT match "5". Nothing said so — the pattern
;; simply gave wrong answers — and `std/tool/explain.blsp` shipped `[0-9]+` against
;; "abc123" as an example of a call returning true, which it did not.
(describe "regex character sets: ranges"
  (test "a-z spans the range, and is not three literal characters"
    (is (match? "5" "[0-9]"))
    (is (match? "abc123" "[0-9]+"))
    (is (not (match? "-" "[0-9]")))
    (is (match? "m" "[a-z]"))
    (is (not (match? "M" "[a-z]")))
    (is (match? "M" "[A-Za-z]")))
  (test "a dash that cannot open a range is a literal member"
    (is (match? "-" "[a-]")) ; last in the set
    (is (match? "-" "[a\\-z]")) ; escaped
    (is (not (match? "m" "[a\\-z]")))) ; …so it is NOT a range
  (test "negation applies to the whole set, ranges included"
    (is (match? "M" "[^a-z]"))
    (is (not (match? "m" "[^a-z]"))))
  (test "classes may be written inside a set, beside chars and ranges"
    (is (matches? "42" "[\\d]+"))
    (is (matches? "foo-bar.ex" "[\\w.-]+"))
    (is (not (matches? "foo/bar" "[\\w.-]+")))
    (is (matches? " , " "[\\s,]+")))
  (test "an unterminated set still takes what it has, as before"
    (is (match? "b" "[abc"))))

;; ---- counted repetition ------------------------------------------------------
(describe "regex {m,n} repetition"
  (test "{m} is exactly m"
    (is (matches? "aaa" "a{3}"))
    (is (not (matches? "aa" "a{3}")))
    (is (not (matches? "aaaa" "a{3}"))))
  (test "{m,} is m or more"
    (is (matches? "aa" "a{2,}"))
    (is (matches? "aaaaa" "a{2,}"))
    (is (not (matches? "a" "a{2,}"))))
  (test "{m,n} is a bounded range"
    (is (matches? "aa" "a{2,3}"))
    (is (matches? "aaa" "a{2,3}"))
    (is (not (matches? "a" "a{2,3}")))
    (is (not (matches? "aaaa" "a{2,3}"))))
  (test "it repeats the preceding atom, group or class"
    (is (matches? "abab" "(ab){2}"))
    (is (matches? "123" "\\d{3}"))
    (is (matches? "ca" "[a-c]{2}")))
  ;; It was once expanded into copies, which copied the group: three groups, and the
  ;; one after the repetition answered at the wrong number.
  (test "a repeated group is still one group, holding the last iteration"
    (let (m (find "abx" "(a|b){2}(x)"))
      (assert= 2 (count (get m :groups)))
      (assert= "b" (get (nth (get m :groups) 0) :text))
      (assert= "x" (get (nth (get m :groups) 1) :text))))
  ;; A brace that is not a well-formed repetition is the character it looks like —
  ;; the same forgiveness the rest of this parser extends to a stray metacharacter.
  (test "a malformed brace is a literal brace"
    (is (matches? "a{x}" "a{x}"))
    (is (matches? "a{" "a{"))
    (is (matches? "a{2" "a{2"))
    (is (matches? "a{3,1}" "a{3,1}")))
  (test "a repetition too large to expand is refused out loud, not hung on"
    (assert= (get (try (match? "aaa" "a{1,100000}") (catch e e)) :kind) :parse)))

;; ---- lazy quantifiers --------------------------------------------------------
;; `a*?` used to parse as `a*` followed by a LITERAL `?`, which is what a parser does
;; when it has no notion of laziness and `?` is just another character.
(describe "regex lazy quantifiers"
  (test "*? +? ?? take the shortest match, not the longest"
    (assert= (get (find "caaab" "a+") :text) "aaa")
    (assert= (get (find "caaab" "a+?") :text) "a")
    (assert= (get (find "<a><b>" "<.*>") :text) "<a><b>")
    (assert= (get (find "<a><b>" "<.*?>") :text) "<a>"))
  (test "they still match the same LANGUAGE — only the choice differs"
    (is (matches? "" "a*?"))
    (is (matches? "aaa" "a+?"))
    (is (matches? "a" "a??"))))

;; ---- captures ----------------------------------------------------------------
(describe "regex find: where, and which groups"
  (defn- txt (m) (when m (get m :text)))
  (defn- gtxt (m k) (let (g (nth (get m :groups) k nil)) (when g (get g :text))))

  (test "a match carries its own half-open span"
    (let (m (find "a1b22c333" "\\d+"))
      (assert= (get m :text) "1")
      (assert= (get m :start) 1)
      (assert= (get m :end) 2)))
  (test "no match is nil, not an empty match"
    (is (nil? (find "abc" "zzz"))))
  (test "groups are numbered by their opening paren, left to right"
    (let (m (find "at worker.ex:42 today" "([\\w.]+):(\\d+)"))
      (assert= (get m :text) "worker.ex:42")
      (assert= (get m :start) 3)
      (assert= (gtxt m 0) "worker.ex")
      (assert= (gtxt m 1) "42")
      (assert= (get (nth (get m :groups) 1) :start) 13)))
  (test "a nested group is numbered after the one enclosing it"
    (let (m (find "abc" "((a)(b))c"))
      (assert= (gtxt m 0) "ab")
      (assert= (gtxt m 1) "a")
      (assert= (gtxt m 2) "b")))
  (test "a group that did not participate is nil, not \"\""
    (let (m (find "zzb" "(a)|(b)"))
      (assert= (get m :text) "b")
      (is (nil? (gtxt m 0)))
      (assert= (gtxt m 1) "b")))
  (test "(?:...) groups, and are not numbered"
    (let (m (find "ababc" "(?:ab)+(c)"))
      (assert= (get m :text) "ababc")
      (assert= (count (get m :groups)) 1)
      (assert= (gtxt m 0) "c")))
  (test "a repeated group keeps its LAST iteration, as everywhere else"
    (assert= (gtxt (find "a-b-c-" "(?:(\\w)-)+") 0) "c"))
  (test "leftmost wins, and anchors still mean the whole string"
    (assert= (txt (find "xxab" "a|ab")) "a")
    (is (nil? (find "ba" "^a")))
    (assert= (txt (find "ab" "b$")) "b"))
  (test "the match is greedy or lazy as the pattern asked"
    (assert= (txt (find "hello world" "\\w+")) "hello")))

(describe "regex find-all"
  (test "every non-overlapping match, left to right"
    (assert= (into [] (map (find-all "a1b22c333" "\\d+") (fn (m) (get m :text)))) ["1" "22" "333"]))
  (test "no matches is an empty vector"
    (assert= (find-all "abc" "z") []))
  (test "an empty match advances rather than repeating forever"
    ;; `a*` matches "" at every position it cannot match an `a`; the guard is what
    ;; makes this terminate at all, so the assertion is really that it returns.
    (assert= (count (find-all "bb" "a*")) 3))
  (test "matches do not overlap"
    (assert= (into [] (map (find-all "aaaa" "aa") (fn (m) (get m :start)))) [0 2])))

(describe "regex replace"
  (test "a template splices $0, the groups, and $$"
    (assert= (replace "a@b" "(\\w+)@(\\w+)" "$2@$1") "b@a")
    (assert= (replace "a1b22" "\\d+" "[$0]") "a[1]b[22]")
    (assert= (replace "a" "a" "$$") "$"))
  (test "a function computes the replacement from the match"
    (assert= (replace "a1b22" "\\d+" (fn (m) (str "<" (get m :text) ">"))) "a<1>b<22>"))
  (test "a group that did not participate expands to nothing"
    (assert= (replace "b" "(a)|(b)" "[$1]") "[]"))
  (test "no match leaves the string alone"
    (assert= (replace "abc" "z" "!") "abc")))

(describe "regex split"
  (test "splits on the pattern, dropping the separators"
    (assert= (split "a , b,c" "\\s*,\\s*") ["a" "b" "c"]))
  (test "adjacent separators leave an empty piece"
    (assert= (split "a,,b" ",") ["a" "" "b"]))
  (test "no match is the whole string, one piece"
    (assert= (split "abc" "z") ["abc"])))

;; The two engines share a parser and an NFA construction, so the property worth
;; asserting is that they never disagree about whether there is a match at all.
(defn- agree? (pattern s) (= (match? s pattern) (not (nil? (find s pattern)))))

(describe "match?, matches?, find and find-all agree on the same patterns"
  (test "across sets, quantifiers, alternation and anchors"
    (is (agree? "[a-z]+" "abc"))
    (is (agree? "[a-z]+" "123"))
    (is (agree? "a{2,3}" "aa"))
    (is (agree? "a{2,3}" "a"))
    (is (agree? "^ab" "abc"))
    (is (agree? "^ab" "xabc"))
    (is (agree? "c$" "abc"))
    (is (agree? "c$" "abcd"))
    (is (agree? "(foo|bar)+baz" "foobarbaz"))
    (is (agree? "(foo|bar)+baz" "foobar"))
    (is (agree? "\\d+" ""))
    (is (agree? "a*" ""))))

(describe "\\b and \\B — word boundaries (zero-width)"
  (test "find sees a whole word and not the same letters inside one"
    (assert= (map (regex/find-all "file fi fi_ x fi" "\\bfi\\b") (fn (m) (get m :start)))
      (list 5 14))
    (is (nil? (regex/find "file" "\\bfi\\b")))
    (assert= (get (regex/find "fi" "\\bfi\\b") :text) "fi"))
  (test "the string's edges are boundaries; \\B is the complement"
    (assert= (get (regex/find "  hello  " "\\b\\w+\\b") :text) "hello")
    (assert= (map (regex/find-all "fix i fi" "\\Bi\\B") (fn (m) (get m :start))) (list 1))
    (assert= (get (regex/find "ab" "\\B") :start) 1))
  (test "match? and matches? answer a boundary pattern too"
    (is (regex/match? "if x; then" "\\bthen\\b"))
    (is (not (regex/match? "file" "\\bfi\\b")))
    (is (regex/matches? "done" "\\bfi\\b|\\bdone\\b"))
    (is (not (regex/matches? "fix" "\\bfi\\b")))
    (is (not (regex/match? "" "\\b")))
    (is (regex/match? "" "\\B")))
  (test "a boundary inside a group and under a quantifier"
    (assert= (map (regex/find-all "in inside in" "(\\bin\\b)") (fn (m) (get m :start))) (list 0 10))
    (assert= (get (regex/find "a bb ccc" "\\b\\w+\\b(?:\\s+\\b\\w+\\b)*") :text) "a bb ccc")))

;; `tokens` — the lexer's scan (ADR-352, native since ADR-389): where a match begins and
;; how far it reaches, with the RULE as the token's identity instead of a capture group.
(defn- toks (rules s)
  "`[tag text]` per token — the shape the assertions read."
  (map (regex/tokens s rules) (fn (t) [(get t :tag) (get t :text)])))

(describe "regex tokens — a rule table scanned as one"
  (test "the earliest position wins, and at it the first rule in table order"
    (assert= (toks [["#.*" :comment] ["\"[^\"]*\"" :string] ["[a-z]+" :word]] "ab \"x#y\" # c")
      (list [:word "ab"] [:string "\"x#y\""] [:comment "# c"]))
    ;; two rules match at 0: the first listed takes it, even though the second is longer
    (assert= (toks [["ab" :short] ["abc" :long]] "abc") (list [:short "ab"])))
  (test "a rule takes its longest match; tokens are ascending, non-overlapping offsets"
    (assert= (map (regex/tokens "a12b345" [["\\d+" :n]])
               (fn (t) [(get t :start) (get t :end) (get t :text)]))
      (list [1 3 "12"] [4 7 "345"]))
    (assert= (toks [["a|ab|abc" :x]] "abcd") (list [:x "abc"])))
  (test "^ and $ anchor to the string's ends, never to a token's"
    (assert= (toks [["^#.*" :c]] "x #a") '())
    (assert= (toks [["^#.*" :c]] "#a b") (list [:c "#a b"]))
    (assert= (map (regex/tokens "bab" [["b$" :e]]) (fn (t) (get t :start))) (list 2))
    (assert= (toks [["a+$" :e]] "aa aa") (list [:e "aa"])))
  (test "a \\b at a rule's edge is a word boundary"
    (assert= (toks [["\\b\\d+\\b" :n]] "a1 22 3b 44") (list [:n "22"] [:n "44"]))
    (assert= (toks [["\\bfi" :k]] "file fi") (list [:k "fi"] [:k "fi"]))
    (assert= (toks [["fi\\b" :k]] "file fi") (list [:k "fi"]))
    ;; `\\\\b` is an escaped backslash then a `b`, not a boundary
    (assert= (toks [["x\\\\b" :k]] "x\\b") (list [:k "x\\b"])))
  (test "a \\b inside a rule is a boundary too — the old engine could only guard the edges"
    (assert= (toks [["a\\b" :x]] "a ab") (list [:x "a"]))
    (assert= (toks [["\\w+\\b-" :x]] "ab- a-b") (list [:x "ab-"] [:x "a-"]))
    (assert= (regex/tokens "ab" [["a\\bb" :x]]) []))
  (test "an empty match never makes a token; the empty string has none"
    (assert= (regex/tokens "bbb" [["a*" :a]]) [])
    (assert= (toks [["a*" :a] ["b" :b]] "bab") (list [:b "b"] [:a "a"] [:b "b"]))
    (assert= (regex/tokens "" [["x" :x]]) []))
  (test "agrees with find-all over the same rules joined as an alternation"
    (let (rules [["(?:^|\\s)#.*" :comment]
                  ["\"(?:[^\"\\\\]|\\\\.)*\"" :string]
                  ["\\$[A-Za-z_]+" :var]
                  ["[a-z]+" :word]]
          joined (string/join (map rules (fn ([p _]) (str "(" p ")"))) "|")
          lines (list "echo \"$HOME # x\" $USER # done" "# only" "no tokens here?" "a\"b\"c")
          via-find (fn (s)
                     (map (regex/find-all s joined)
                       (fn (m)
                         (let (groups (get m :groups)
                               which (or (seq/find (range (count groups))
                                           (fn (i) (not (nil? (nth groups i)))))
                                       (error "a match with no group set")))
                           [(second (nth rules which)) (get m :text)])))))
      (doseq (s lines)
        (assert= (toks rules s) (via-find s))))))

(describe "regex find — a start found far along a line"
  (test "results are unchanged where a match exists, including empty and end matches"
    (assert= (get (regex/find "bbb" "a*") :end) 0)
    (assert= (map (regex/find-all "a1" "\\d*") (fn (m) [(get m :start) (get m :end)]))
      (list [0 0] [1 2] [2 2]))
    (assert= (get (regex/find "ab" "x*$") :start) 2)
    (assert= (map (regex/find-all "a #b #c" "(?:^|\\s)#.*") (fn (m) [(get m :start) (get m :end)]))
      (list [1 7]))
    (assert= (get (regex/find "xxb" "(a)|(b)") :start) 2)
    (assert= (map (regex/find-all "ba" "a|") (fn (m) (get m :start))) (list 0 1 2)))
  (test "an anchor-only pattern matches where the anchor is"
    (assert= (get (regex/find "abc" "^") :start) 0)
    (assert= (get (regex/find "abc" "$") :start) 3)
    (assert= (get (regex/find "" "^$") :start) 0))
  (test "a long line with no match is answered without a match"
    (is (nil? (regex/find (string/repeat "abcdefgh" 200) "#.*")))
    (assert= (regex/find-all (string/repeat "no quotes " 100) "\"[^\"]*\"") [])))

(describe "regex paint — a line rule: prefix, the painted text, suffix"
  (test "paints the text between a prefix at the line's start and a suffix after it"
    (assert= (regex/paint "  [core] x" "^\\s*" "\\[[^\\]]*\\]" "") [2 8])
    (assert= (regex/paint "build: x" "^" "[^\\s:#=][^:#=]*" ":(?:[^=]|$)") [0 5])
    ;; `:=` is an assignment, not a target: no `:` end lets the suffix follow
    (is (nil? (regex/paint "CC := gcc" "^" "[^\\s:#=][^:#=]*" ":(?:[^=]|$)"))))
  (test "a greedy paint backtracks to the longest end the suffix follows; a lazy one takes the shortest"
    (assert= (regex/paint "a b: c: d" "^" "[a-z :]+" ":") [0 6])
    (assert= (regex/paint "a b: c: d" "^" "[a-z :]+?" ":") [0 3]))
  (test "the prefix takes its longest match first, and a line that does not match answers nil"
    (assert= (regex/paint "  - brood: \"0.27\""
               "^\\s*(?:-\\s+)*" "[A-Za-z0-9_.\\-\"' ]+?" "\\s*:(?:\\s|$)")
      [4 9])
    (is (nil? (regex/paint "abc" "^" "[a-z]+" ":")))
    (is (nil? (regex/paint "" "^" "x" "")))
    ;; a boundary is allowed in a line rule now, as anywhere
    (assert= (regex/paint "x y" "^" "\\bx\\b" "") [0 1]))
  (test "a tokenizer held in a def scans like its table"
    (let (tz (regex/tokenizer [["\\d+" :n] ["[a-z]+" :w]]))
      (assert= (map (regex/tokens "ab12" tz) (fn (t) (get t :tag))) (list :w :n))
      (assert= (regex/tokens "ab12" tz) (regex/tokens "ab12" [["\\d+" :n] ["[a-z]+" :w]])))))

;; ---- the dialect is Brood's, the engine native (ADR-389) ------------------------------
;; The parser translates every construct explicitly, so the engine's own readings of the
;; same characters never leak through. Each of these is a place the two syntaxes differ.
(describe "regex dialect — what the translation keeps from the engine's syntax"
  (test ". crosses a newline; ^ and $ are the whole string, not a line"
    (is (matches? "a\nb" "a.b"))
    (is (not (match? "a\nb" "^b")))
    (is (not (match? "a\nb" "a$"))))
  (test "\\n \\t \\r \\f \\v are the control characters, as every other engine reads them"
    (is (matches? "a\nb" "a\\nb"))
    (is (not (match? "n" "\\n")))
    (is (matches? "\t\r\u{c}\u{b}" "\\t\\r\\f\\v"))
    (is (matches? "a\nb" "a\nb"))
    ;; the pattern a carried-over `[ \t]*` was written to be: it matched the letter t
    (assert= (regex/replace "\t  x" "^[ \\t]*" "") "x")
    (is (not (match? "t" "^[ \\t]+$")))
    (is (matches? "abc" "[^\\n]+"))
    (is (not (match? "\n" "[^\\n]"))))
  (test "a hex escape is the character with that code point; a malformed one is the letter"
    (is (matches? "ABC😀" "\\x41\\x{42}\\u0043\\u{1F600}"))
    (is (matches? "plain ASCII ~" "[\\x00-\\x7F]+"))
    (is (not (match? "é" "[\\x00-\\x7F]")))
    (is (matches? "az" "[a-\\x{7A}]+"))
    (is (matches? "xg" "\\xg"))
    (is (matches? "x4" "\\x4"))
    ;; past Unicode, or a surrogate: the letter, and the braces after it are themselves
    (is (matches? "u{10}" "[\\u{110000}]+"))
    (is (matches? "u{D800}" "\\u{D800}")))
  (test "any other escaped letter is that letter"
    (is (matches? "qy" "\\q\\y"))
    (is (matches? "q" "[\\q]")))
  (test "an escaped character is the low or high end of a range like a plain one"
    (is (matches? "-./" "[\\--/]+"))
    (is (matches? "]^_`a" "[\\]-a]+"))
    ;; a `-` before a class is a member, as it is last in the set
    (is (matches? "a-1" "[a-\\d]+")))
  (test "a character the engine reads as syntax is a literal where the dialect says so"
    (is (matches? "a&&b" "a&&b"))
    (is (matches? "a&b" "[a&&b]+"))
    (is (matches? "~-~" "[~-]+"))
    (is (matches? "x#y" "x#y"))
    (is (matches? "<a>" "\\<a\\>")))
  (test "a stray metacharacter is the character it looks like"
    (is (matches? "a)" "a)"))
    ;; a stray ) used to END the pattern: `a)x` was `a`, and matched "ay"
    (is (not (match? "ay" "a)x")))
    (is (matches? "a)" "(a))"))
    (is (matches? ")" "[)]"))
    (is (matches? "*a" "*a"))
    (is (matches? "a*" "a**"))
    (is (matches? "a" "(a")))
  (test "an empty set matches nothing, a negated empty one anything, a backwards range nothing"
    (is (not (match? "abc" "[]")))
    (is (matches? "\n" "[^]"))
    (is (not (match? "m" "[z-a]"))))
  (test "\\d is ASCII — what string/->number reads — while \\w and \\s are Unicode"
    (is (not (matches? "٣" "\\d")))
    (is (matches? "日本語" "\\w+"))
    (is (matches? "café" "\\w+"))
    (is (matches? "\u{a0}" "\\s"))
    (assert= (map (find-all "naïve café" "\\b\\w+\\b") (fn (m) (get m :text)))
      (list "naïve" "café"))))

(describe "regex offsets are characters, not bytes"
  (test "find and its groups past multi-byte characters"
    (let (m (find "héllo wörld 12:34" "(\\d+):(\\d+)"))
      (assert= (get m :start) 12)
      (assert= (get m :text) "12:34")
      (assert= (get (second (get m :groups)) :start) 15)))
  (test "find-all, including an empty match stepping over a multi-byte character"
    (assert= (map (find-all "éxé" "x*") (fn (m) [(get m :start) (get m :end)]))
      (list [0 0] [1 2] [2 2] [3 3])))
  (test "tokens and paint"
    (assert= (map (tokens "→ été ok" [["[a-zé]+" :w]]) (fn (t) [(get t :start) (get t :end)]))
      (list [2 5] [6 8]))
    (assert= (paint "· key: v" "^·\\s*" "[a-z]+" ":") [2 5]))
  (test "replace and split splice at the right characters"
    (assert= (replace "föö" "ö" "o") "foo")
    (assert= (split "a→b→c" "→") ["a" "b" "c"])))

;; Every language feature runs across cores (CLAUDE.md): the compiled patterns are one
;; process-wide cache the worker threads share, so many processes matching at once — the
;; same pattern and different ones — must each get their own right answer.
(describe "regex across processes"
  (test "many processes matching at once, sharing the compiled patterns"
    (let (me (self)
          n 24
          _ (doseq (i (range n))
              (spawn (fn ()
                       (let (line (str "file" i ".ex:" (* i 7) ": boom")
                             m (find line "([\\w.]+):(\\d+)")
                             toks (tokens line [["\\d+" :n] ["[a-z]+" :w]]))
                         (send me [i (get (second (get m :groups)) :text) (count toks)])))))
          got (fold (range n) {} (fn (acc _) (receive ([i text k] (assoc acc i [text k]))))))
      (doseq (i (range n))
        (assert= (first (get got i)) (str (* i 7)))
        (is (> (second (get got i)) 2))))))

;; ---- a rope, searched in place (ADR-540) ------------------------------------------
;; The rope functions read a pattern the way a buffer search does — `^`/`$` at a line's
;; ends, `.` short of a newline — and their answers must agree with `find` over the same
;; text, leaf boundaries or not.
(describe "regex over a rope"
  (test "rope-find is find over the flattened text, from an offset"
    (let (text "alpha beta\ngamma beta delta"
          r (text/string-> text))
      (assert= (get (rope-find r "beta" 0) :start) 6)
      (assert= (get (rope-find r "beta" 7) :start) 17)
      (assert= (rope-find r "beta" 18) nil)
      (assert= (get (rope-find r "(\\w+) (\\w+)" 11) :text) "gamma beta")
      (assert= (get (second (get (rope-find r "(\\w+) (\\w+)" 11) :groups)) :text) "beta")))
  (test "a match straddling the rope's leaves is found whole"
    (let (text (string/join (map (range 3000) (fn (i) (str "w" i))) " ")
          r (text/string-> text)
          at (index-of text "w2999"))
      (assert= (get (rope-find r "w2999\\b" 0) :start) at)
      (assert= (first (rope-count r "w\\d+" 0 (string/length text))) 3000)))
  (test "line mode: ^ $ and . stay on a line unless :lines? is false"
    (let (r (text/string-> "ab\ncd\nab"))
      (assert= (get (rope-find r "^ab" 1) :start) 6)
      (assert= (get (rope-find r "b$" 0) :start) 1)
      (assert= (get (rope-find r "b.c" 0) :start) nil)
      (assert= (get (rope-find r "b.c" 0 {:lines? false}) :start) 1)
      (assert= (rope-find r "^ab" 1 {:lines? false}) nil)))
  (test ":fold? ignores case"
    (let (r (text/string-> "Foo FOO foo"))
      (assert= (map (rope-spans r "foo" 0 100) first) '(8))
      (assert= (map (rope-spans r "foo" 0 100 {:fold? true}) first) '(0 4 8))))
  (test "a match is never empty"
    (let (r (text/string-> "aa x b xx"))
      (assert= (rope-spans r "x*" 0 100) [[3 4] [7 9]])
      (assert= (get (rope-find r "x*" 0) :start) 3)
      (assert= (get (rope-find r "x*" 0 {:empty? true}) :end) 0)
      (assert= (get (rope-find-backward r "x*" 5 {:empty? true}) :start) 5)
      (assert= (get (rope-find-backward r "x*" 5) :start) 3)))
  (test ":bound — a match ends by it, look-around reads past it (ADR-554)"
    (let (r (text/string-> "aaaa foo\nbar foobar üüü"))
      (assert= (get (rope-find r "a+" 0 {:bound 2}) :text) "aa")
      (assert= (get (rope-find r "a+" 0) :text) "aaaa")
      (assert= (rope-find r "foo" 0 {:bound 7}) nil)
      (assert= (get (rope-find r "foo" 0 {:bound 8}) :start) 5)
      ;; `$` at the bound is a line's end only where the text has one
      (assert= (get (rope-find r "o$" 0 {:bound 8}) :start) 7)
      (assert= (rope-find r "foo$" 9 {:bound 16}) nil)
      ;; `\b` at the bound sees `bar` go on
      (assert= (rope-find r "foo\\b" 9 {:bound 16}) nil)
      ;; groups come from the bounded match
      (assert= (get (first (get (rope-find r "(a+)" 0 {:bound 3}) :groups)) :text) "aaa")
      ;; a Unicode word boundary quits the lazy DFA: the fallback is bounded too
      (assert= (get (rope-find r "\\bü+" 20 {:bound 22}) :text) "üü")
      (assert= (rope-find r "ü\\b" 20 {:bound 22}) nil)
      ;; an empty match at the bound is an answer when one is asked for
      (assert= (get (rope-find r "x*" 2 {:bound 2 :empty? true}) :start) 2)
      ;; a greedy match through the fallback reaches the rope's end whole
      (assert= (get (rope-find r "\\bü+" 20) :text) "üüü")))
  (test "rope-find-backward: the last start, ending by `before`"
    (let (r (text/string-> "foo foo xfoo"))
      (assert= (get (rope-find-backward r "fo+" 12) :start) 9)
      (assert= (get (rope-find-backward r "fo+" 11) :text) "fo")
      (assert= (get (rope-find-backward r "fo+" 9) :start) 4)
      (assert= (rope-find-backward r "fo+" 1) nil)))
  (test "rope-count counts the matches that START before its limit"
    (let (r (text/string-> "ab ab ab ab"))
      (assert= (rope-count r "ab" 0 6) [2 6])
      (assert= (rope-count r "ab" 0 7) [3 8])
      (assert= (rope-count r "ab" 6 100) [2 nil])))
  (test "a count taken in slices adds up to the whole"
    (let (text (string/join (map (range 500) (fn (i) (if (= 0 (math/mod i 3)) "hit" "miss"))) " ")
          r (text/string-> text)
          whole (count (find-all text "hit")))
      (letrec (slices (fn (from total)
                        (let ([n resume] (rope-count r "hit" from (+ from 50)))
                          (if (nil? resume) (+ total n) (slices resume (+ total n))))))
        (assert= (slices 0 0) whole))))
  (test "a Unicode word boundary before non-ASCII text still answers"
    (let (r (text/string-> "über foo über foo"))
      (assert= (map (rope-spans r "\\bfoo\\b" 0 100) first) '(5 14))
      (assert= (get (rope-find-backward r "\\bfoo\\b" 17) :start) 14))))

(describe "regex escape and incomplete?"
  (test "escape matches its text literally"
    (doseq (s ["a.b" "(x)" "[y]" "1+1=2?" "^$|\\" "{3}"])
      (is (matches? s (escape s)))))
  (test "incomplete? — an unclosed group or set, or a trailing backslash"
    (is (incomplete? "foo\\"))
    (is (incomplete? "(a|b"))
    (is (incomplete? "[abc"))
    (is (not (incomplete? "[]")))
    (is (not (incomplete? "[]]")))
    (is (not (incomplete? "\\(")))
    (is (not (incomplete? "a)b")))
    (is (not (incomplete? "")))))

;; ADR-573: case folding written in the pattern (`(?i)`, `(?i:…)`) or asked for (`:fold?`), and
;; the POSIX bracket classes — read the same by the string searches and the rope searches.
(describe "regex case folding"
  (test "(?i) folds the rest of the pattern, every alternative included"
    (is (match? "[sudo] Password: " "(?i)password:"))
    (is (match? "XYZ" "(?i)abc|xyz"))
    (is (not (match? "Password:" "password:"))))
  (test "(?-i) turns it back off, and (?i:…) folds one group"
    (is (match? "Ab" "(?i)a(?-i)b"))
    (is (not (match? "AB" "(?i)a(?-i)b")))
    (is (match? "xABCy" "x(?i:abc)y"))
    (is (not (match? "XABCY" "x(?i:abc)y"))))
  (test "a folding group does not capture; the groups after it keep their numbers"
    (let (m (find "ID=42" "(?i:id)=(\\d+)"))
      (assert= (get m :text) "ID=42")
      (assert= (count (get m :groups)) 1)
      (assert= (get (first (get m :groups)) :text) "42")))
  (test ":fold? on every string search is (?i) in front"
    (is (match? "ABC" "^abc$" {:fold? true}))
    (is (matches? "AbC" "[a-c]+" {:fold? true}))
    (assert= (get (find "ALPHA BETA" "beta" {:fold? true}) :start) 6)
    (assert= (count (find-all "fOo" "o" {:fold? true})) 2)
    (assert= (replace "aXbx" "x" "-" {:fold? true}) "a-b-")
    (assert= (split "aANDb" "and" {:fold? true}) ["a" "b"]))
  (test "a pattern that is not a flag still means what it did"
    (is (match? "i" "(?:i)"))

    (is (not (incomplete? "(?i)abc")))
    (is (incomplete? "(?i:abc"))))

(describe "regex POSIX classes"
  (test "each class inside a set"
    (is (matches? "abcÄß" "[[:alpha:]]+"))
    (is (matches? "0123" "[[:digit:]]+"))
    (is (not (match? "٣" "[[:digit:]]")))
    (is (matches? "a1Ä٣" "[[:alnum:]]+"))
    (is (matches? "ABÄ" "[[:upper:]]+"))
    (is (not (match? "abä" "[[:upper:]]")))
    (is (matches? "abä" "[[:lower:]]+"))
    (is (matches? " \t\n" "[[:space:]]+"))
    (is (matches? " \t" "[[:blank:]]+"))
    (is (not (match? "\n" "[[:blank:]]")))
    (is (matches? "!?.,;:$+<=>^`|~" "[[:punct:]]+"))
    (is (matches? "09afAF" "[[:xdigit:]]+"))
    (is (not (match? "g" "[[:xdigit:]]")))
    (is (matches? "\u{7}" "[[:cntrl:]]"))
    (is (matches? "a!é" "[[:graph:]]+"))
    (is (not (match? " " "[[:graph:]]")))
    (is (matches? "a b" "[[:print:]]+"))
    (is (matches? "a_1" "[[:word:]]+"))
    (is (matches? "az~" "[[:ascii:]]+"))
    (is (matches? "éß" "[[:nonascii:]]+")))
  (test "classes mix with chars and ranges, and negate with the set"
    (is (matches? "a_b-c" "[[:alpha:]_-]+"))
    (is (matches? "abc" "[^[:space:]]+"))
    (is (not (match? " \t" "[^[:space:]]")))
    (is (matches? "A1B2" "[[:digit:][:upper:]]+")))
  (test "under (?i) upper and lower are any cased letter, as Emacs folds them"
    (is (matches? "aB" "(?i)[[:upper:]]+")))
  (test "an unknown name keeps the old reading, and a paren after a class is literal"
    (is (match? ":]" "[[:foo:]]"))
    (is (matches? "a)b" "[[:alpha:])]+"))
    (is (not (incomplete? "[[:alpha:](]")))))

(describe "regex case folding and POSIX classes over a rope"
  (test "rope searches read (?i) and the POSIX classes as string searches do"
    (let (text "Alpha BETA gamma\n[sudo] Password: x"
          r (text/string-> text))
      (doseq (pattern ["(?i)beta"
                        "x(?i:bc)" "[[:upper:]]+" "[[:alpha:]]+:" "(?i)password:" "[^[:space:]]+"
                        "[[:punct:]]"])
        (assert= (map (rope-spans r pattern 0 (string/length text) {:lines? false})
                   (fn (span) (string/substring text (first span) (second span))))
          (map (find-all text pattern) :text)))))
  (test ":fold? and (?i) agree on a rope"
    (let (r (text/string-> "a Foo foo FOO"))
      (assert= (rope-spans r "foo" 0 13 {:fold? true}) (rope-spans r "(?i)foo" 0 13))
      (assert= (count (rope-spans r "(?i)foo" 0 13)) 3))))
