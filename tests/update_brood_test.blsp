;; tests/update_brood_test.blsp — `nest update-brood`'s decisions (no network, no files).

(defmodule update-brood-test (:use test))

(describe "update-brood/release-target"
  (test "every target a release publishes is its own release target"
    (doseq (target ["x86_64-unknown-linux-gnu"
                     "aarch64-unknown-linux-gnu" "x86_64-unknown-linux-musl" "aarch64-apple-darwin"
                     "x86_64-apple-darwin" "x86_64-pc-windows-msvc"])
      (assert= (update-brood/release-target target) target)))
  (test "this runtime's own target names its build: a musl install stays musl"
    (let (own (system/target))
      (is (string? own))
      (is (includes? own "-"))))
  (test "a build no release publishes is a failure that says which"
    (let (riscv (update-brood/release-target "riscv64gc-unknown-linux-gnu"))
      (is (failure? riscv))
      (is (includes? (error-message riscv) "riscv64gc-unknown-linux-gnu")))))

(describe "update-brood/version-newer?"
  (test "compares numerically, part by part, ignoring a leading v"
    (is (update-brood/version-newer? "v0.34.0" "0.33.0"))
    (is (update-brood/version-newer? "v0.10.0" "0.9.3"))
    (is (update-brood/version-newer? "v1.0.0" "0.99.99"))
    (is (update-brood/version-newer? "0.34.1" "v0.34.0")))
  (test "the same or an older release is not newer"
    (is (not (update-brood/version-newer? "v0.34.0" "0.34.0")))
    (is (not (update-brood/version-newer? "v0.9.0" "0.10.0")))
    (is (not (update-brood/version-newer? "v0.33.0" "0.34.0"))))
  (test "a pre-release suffix is ignored and a missing part counts as zero"
    (is (not (update-brood/version-newer? "v0.34.0-rc1" "0.34.0")))
    (is (not (update-brood/version-newer? "v0.34" "0.34.0")))
    (is (update-brood/version-newer? "v0.35" "0.34.9"))))

(describe "update-brood/asset-url"
  (test "points at the release tarball install.sh downloads"
    (is (= (update-brood/asset-url "v0.34.0" "aarch64-apple-darwin")
          "https://github.com/broodlang/brood/releases/download/v0.34.0/brood-v0.34.0-aarch64-apple-darwin.tar.gz")))
  (test "Windows's archive is a zip"
    (is (string/ends-with? (update-brood/asset-url "v0.52.0" "x86_64-pc-windows-msvc")
          "brood-v0.52.0-x86_64-pc-windows-msvc.zip"))))
