;; std/vcs.blsp — which version control a directory lives in, and the questions every tool
;; asks of it. git is asked for real (CI has it); a backend registered by a test stands in for
;; "a package adds a VCS" (bedit puts mur's). Each test registers its own kind and marker,
;; since the tests run at once and the registry is shared.

(defmodule vcs-test (:use vcs) (:use registry) (:use test))

;; every fixture below is a `brood-vcs-` temp dir; the previous run's go at load (KI-30)
(purge-stale-temp "brood-vcs-")

(defn- git (dir & args)
  (os/cmd "git"
    (append ["-C"
              dir "-c" "user.name=Test" "-c" "user.email=test@example.test" "-c"
              "commit.gpgsign=false"]
      args)))

(defn- git-repository (prefix)
  "A fresh git repository with one commit of `a.txt` and `sub/b.txt`, or nil without git."
  (let (dir (temp-dir prefix))
    (file/mkdir dir)
    (when (os/cmd-ok? (git dir "init" "-q" "-b" "main"))
      (file/mkdir (path/join dir "sub"))
      (file/spit (path/join dir "a.txt") "one\n")
      (file/spit (path/join dir "sub/b.txt") "two\n")
      (git dir "add" "-A")
      (git dir "commit" "-q" "-m" "first")
      dir)))

(describe "vcs/locate"
  (test "a directory in no checkout is in none"
    (let (dir (temp-dir "brood-vcs-none-"))
      (file/mkdir dir)
      (when (nil? (locate (path/dirname dir)))
        (assert= (locate dir) nil)
        (assert= (files dir) nil)
        (assert= (id dir) nil))))
  (test "the nearest marker wins, from the directory itself up"
    (let (dir (temp-dir "brood-vcs-nest-"))
      (file/mkdir dir)
      (file/mkdir (path/join dir ".git"))
      (file/mkdir (path/join dir "inner"))
      (file/mkdir (path/join dir "inner/.nestedvcs"))
      (file/mkdir (path/join dir "inner/deep"))
      (registry/put :vcs/backends :nested {:rank 30 :marker ".nestedvcs"})
      (assert= (locate (path/join dir "inner/deep")) {:kind :nested :root (path/join dir "inner")})
      (assert= (kind dir) :git)
      (assert= (root (path/join dir "inner")) (path/join dir "inner"))
      (registry/remove :vcs/backends :nested)))
  (test "a .git FILE (a worktree, a submodule) marks a checkout too"
    (let (dir (temp-dir "brood-vcs-worktree-"))
      (file/mkdir dir)
      (file/spit (path/join dir ".git") "gitdir: /elsewhere\n")
      (assert= (kind dir) :git)))
  (test "two markers in one directory: the backend ranked first"
    (let (dir (temp-dir "brood-vcs-both-"))
      (file/mkdir dir)
      (file/mkdir (path/join dir ".git"))
      (file/mkdir (path/join dir ".aheadvcs"))
      (file/mkdir (path/join dir ".behindvcs"))
      ;; one ranked before git, one after: the directory is the first one's
      (registry/put :vcs/backends :ahead {:rank 10 :marker ".aheadvcs"})
      (registry/put :vcs/backends :behind {:rank 40 :marker ".behindvcs"})
      (assert= (kind dir) :ahead)
      (registry/remove :vcs/backends :ahead)
      (assert= (kind dir) :git)
      (registry/remove :vcs/backends :behind))))

(describe "vcs over git"
  (test "files: tracked and new, not ignored, not deleted"
    (let (dir (git-repository "brood-vcs-git-files-"))
      (when dir
        (file/spit (path/join dir ".gitignore") "*.log\n")
        (file/spit (path/join dir "new.txt") "n\n")
        (file/spit (path/join dir "noise.log") "x\n")
        (file/rm (path/join dir "a.txt"))
        (assert= (files dir) (list ".gitignore" "new.txt" "sub/b.txt"))
        (assert= (files (path/join dir "sub")) (list ".gitignore" "new.txt" "sub/b.txt")))))
  (test "base-text: the file at HEAD, from any directory, nil for a new file"
    (let (dir (git-repository "brood-vcs-git-base-"))
      (when dir
        (file/spit (path/join dir "sub/b.txt") "edited\n")
        (file/spit (path/join dir "fresh.txt") "f\n")
        (assert= (base-text (path/join dir "sub/b.txt")) "two\n")
        (assert= (base-text (path/join dir "fresh.txt")) nil))))
  (test "changed: the edits and the new files"
    (let (dir (git-repository "brood-vcs-git-changed-"))
      (when dir
        (file/spit (path/join dir "a.txt") "edited\n")
        (file/spit (path/join dir "fresh.txt") "f\n")
        (assert= (changed dir) (list "a.txt" "fresh.txt")))))
  (test "changed: staged, renamed (the new name), untracked in a new directory, non-ASCII"
    (let (dir (git-repository "brood-vcs-git-changed-kinds-"))
      (when dir
        (git dir "mv" "a.txt" "moved.txt")
        (file/spit (path/join dir "sub/b.txt") "staged\n")
        (git dir "add" "sub/b.txt")
        (file/mkdir (path/join dir "fresh"))
        (file/spit (path/join dir "fresh/new.txt") "n\n")
        (file/spit (path/join dir "café.txt") "c\n")
        (assert= (changed dir) (list "café.txt" "fresh/new.txt" "moved.txt" "sub/b.txt")))))
  (test "id: HEAD's short sha, and whether the tree moved since"
    (let (dir (git-repository "brood-vcs-git-id-"))
      (when dir
        (let (clean (id dir))
          (assert= (count (:id clean)) 12)
          (refute (:dirty? clean))
          (file/spit (path/join dir "a.txt") "edited\n")
          (is (:dirty? (id dir)))))))
  (test "asking never writes the index, so a commit made meanwhile finds no index.lock"
    ;; a file whose mtime moved but whose text did not is what makes `git status` / `git
    ;; diff` refresh the index and write it back — under index.lock, the moment a user's
    ;; own `git commit` could collide with it
    (let (dir (git-repository "brood-vcs-git-locks-"))
      (when dir
        (let (index-sum (fn () (:stdout (os/cmd "cksum" [(path/join dir ".git/index")])))
              _ (os/cmd "touch" ["-d" "2001-01-01 00:00" (path/join dir "a.txt")])
              before (index-sum))
          (id dir)
          (changed dir)
          (base-text (path/join dir "a.txt"))
          (assert= (index-sum) before)
          ;; and the fixture can see a write: a git that may take the lock does write it
          (git dir "status" "--porcelain")
          (refute (= (index-sum) before)))))))

(defn fake-files (root) (list (str "listed-under-" (path/basename root))))
(defn fake-base-text (root path) (str "before:" (path/basename path)))

(describe "a registered backend"
  (test "a package adds a VCS as a row, and every question reaches its hooks"
    (let (dir (temp-dir "brood-vcs-fake-"))
      (file/mkdir dir)
      (file/mkdir (path/join dir ".fakevcs"))
      (registry/put :vcs/backends
        :fake {:rank 30
         :marker ".fakevcs"
         :files 'vcs-test/fake-files
         :base-text 'vcs-test/fake-base-text})
      (assert= (kind dir) :fake)
      (assert= (files dir) (list (str "listed-under-" (path/basename dir))))
      (assert= (base-text (path/join dir "x.txt")) "before:x.txt")
      ;; a question the row does not answer is nil, not an error
      (assert= (changed dir) nil)
      (registry/remove :vcs/backends :fake)
      (assert= (kind dir) nil)))
  (test "a hook may be a function — a package's way to call its own globals late"
    ;; a package's module names are rooted under the package, so a quoted symbol in its row
    ;; would not name its global; a function that calls it does
    (let (dir (temp-dir "brood-vcs-fn-"))
      (file/mkdir dir)
      (file/mkdir (path/join dir ".fnvcs"))
      (registry/put :vcs/backends
        :by-fn {:rank 30
         :marker ".fnvcs"
         :files (fn (root) (fake-files root))
         :changed (fn (root) (list "changed-in" (path/basename root)))
         :base-text (fn (root path) (fake-base-text root path))
         :id (fn (_root) {:id "fn-id" :dirty? false})})
      (assert= (files dir) (list (str "listed-under-" (path/basename dir))))
      (assert= (changed dir) (list "changed-in" (path/basename dir)))
      (assert= (base-text (path/join dir "y.txt")) "before:y.txt")
      (assert= (id dir) {:id "fn-id" :dirty? false})
      ;; the row is shared: a process that did not register it asks through the same hooks
      (let (me (self))
        (spawn (send me [:asked (files dir) (id dir)]))
        (assert= (receive ([:asked fs i] [fs i]) (after test/*wait-ms* :timeout))
          [(list (str "listed-under-" (path/basename dir))) {:id "fn-id" :dirty? false}]))
      (registry/remove :vcs/backends :by-fn))))

(describe "vcs/changed over git: this branch's work, not the upstream's"
  (test "commits that landed upstream after the branch left it are not counted"
    (let (dir (git-repository "brood-vcs-git-upstream-"))
      (when dir
        ;; `main` is the upstream; `work` leaves it, then main moves on without it
        (git dir "checkout" "-q" "-b" "work")
        (file/spit (path/join dir "mine.txt") "m\n")
        (git dir "add" "mine.txt")
        (git dir "commit" "-q" "-m" "mine")
        (git dir "branch" "-q" "--set-upstream-to=main")
        (git dir "checkout" "-q" "main")
        (file/spit (path/join dir "theirs.txt") "t\n")
        (git dir "add" "theirs.txt")
        (git dir "commit" "-q" "-m" "theirs")
        (git dir "checkout" "-q" "work")
        (assert= (changed dir) (list "mine.txt"))))))
