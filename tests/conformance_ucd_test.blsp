;; tests/conformance_ucd_test.blsp — the Unicode Character Database conformance files.
;;
;; Two corpora (Unicode licence; see tests/corpus/ucd/README.md), both machine-
;; generated from the standard's own tables:
;;
;;   GraphemeBreakTest.txt   UAX #29 extended grapheme cluster boundaries. Each line
;;                           spells a string with break markers: `÷` between code
;;                           points means "cluster boundary here", `×` means "no
;;                           boundary". Tests `string->graphemes`.
;;   NormalizationTest.txt   UAX #15. Each line is five columns of the same text —
;;                           source, NFC, NFD, NFKC, NFKD — and the conformance
;;                           requirement is a closure: normalising ANY of the five
;;                           into a given form must yield that form's column, not
;;                           just normalising the source. Tests `string-normalize`.
;;
;; These are the highest-consequence corpora for the editor framework. A cursor that
;; steps by code point instead of by grapheme cluster splits "é" in half and corrupts
;; the buffer; text that reads identically but isn't normalised silently fails `=`.
;;
;; VERSION SKEW is the failure mode to suspect first. The vendored files must match
;; the Unicode version the `unicode-segmentation` / `unicode-normalization` crates
;; were generated from — testing against a newer UCD than the crates implement
;; produces failures that are skew, not bugs. `tests/corpus/ucd/data/VERSION` records
;; which, and the first test below pins it.

(defmodule conformance-ucd-test (:use test) (:use corpus))

(defn- ucd-file
  (name)
  (first (filter (fn (p) (= (path-basename p) name)) (corpus-files "ucd"))))

;; A line's payload: everything before the `#` comment, tabs folded to spaces.
(defn- ucd-payload
  (line)
  (let (i (index-of line "#"))
    (string/replace (if (< i 0) line (string/substring line 0 i)) "\t" " ")))

(defn- ucd-codes->string (codes) (apply str (map int->char codes)))

;; ---- GraphemeBreakTest -------------------------------------------------------

;; EXCLUDED — one upstream crate gap, not a Brood bug. `÷ 2701 × 200D × 2701 ÷`:
;; UAX #29 rule GB11 joins a ZWJ sequence when both sides are Extended_Pictographic,
;; and Unicode 16 gives U+2701 UPPER BLADE SCISSORS that property, so the three code
;; points are ONE cluster. `unicode-segmentation` 1.13.3 (the current release) omits
;; U+2701 from its Extended_Pictographic table and splits it into two. The rule
;; itself is fine everywhere else — U+270A, U+2764, U+1F468 and U+1F3F3 ZWJ sequences
;; all join correctly — so this is a table gap around the U+2700 dingbats, worth an
;; upstream report rather than a workaround here. Pinned by "the one upstream gap"
;; below so that it fails loudly the day the crate fixes it.
(def- gb-upstream-gap "\u{2701}\u{200D}\u{2701}")

;; Fold the `÷ 0020 × 0308 ÷` token stream into the clusters it describes: `÷`
;; closes the current cluster, `×` keeps accumulating, a hex token adds a code point.
(defn- gb-fold
  (tokens cur clusters)
  (if (nil? tokens)
    (reverse clusters)
    (let (t (first tokens))
      (cond
        (= t "÷")
          (gb-fold (rest tokens)
            nil
            (if (nil? cur) clusters (cons (ucd-codes->string (reverse cur)) clusters)))
        (= t "×") (gb-fold (rest tokens) cur clusters)
        else (gb-fold (rest tokens) (cons (hex->int t) cur) clusters)))))

(defn- gb-case
  (line)
  "[input expected-clusters] for a test line, or nil if the line has no test."
  (let (toks (remove string/blank? (string/split (ucd-payload line) " ")))
    (if (nil? toks)
      nil
      (let (clusters (gb-fold toks nil nil))
        [(apply str clusters) (into [] clusters)]))))

(defn- gb-scan
  (lines ran bad)
  (if (nil? lines)
    [ran (reverse bad)]
    (let (c (gb-case (first lines)))
      (cond
        (nil? c) (gb-scan (rest lines) ran bad)
        (= (first c) gb-upstream-gap) (gb-scan (rest lines) ran bad)
        else
          (let ([input want] c
                got (string/to-graphemes input))
            (gb-scan (rest lines)
              (inc ran)
              (if (= got want) bad (cons [(pr-str input) want got] bad))))))))

(def- gb-lines (corpus-lines (ucd-file "GraphemeBreakTest.txt")))

;; ---- NormalizationTest -------------------------------------------------------

;; "0044 0307" -> the string it spells.
(defn- nt-field (s) (ucd-codes->string (map hex->int (remove string/blank? (string/split s " ")))))

(defn- nt-case
  (line)
  "The five columns [source nfc nfd nfkc nfkd] as strings, or nil for a non-test line."
  (let (p (ucd-payload line))
    (if (or (string/blank? p) (string/starts-with? (string/trim p) "@"))
      nil
      (let (cols (string/split p ";"))
        (if (< (count cols) 5)
          nil
          (into [] (map nt-field (take 5 cols))))))))

;; Is this a case line at all? Cheap — no field parsing, so the samplers can skip a case
;; without paying to decode it.
(defn- nt-test-line?
  (line)
  (let (p (ucd-payload line))
    (and (not (string/blank? p)) (not (string/starts-with? (string/trim p) "@")) (>= (count (string/split p ";")) 5))))

;; "@Part1 # Character by character test" -> "Part1", else nil. The corpus divides itself
;; into six sections and the runner uses them to split the sweep — see the describe below.
(defn- nt-part
  (line)
  (let (t (string/trim line))
    (if (string/starts-with? t "@")
      (first (string/split (string/substring t 1) " "))
      nil)))

;; UAX #15's conformance closure: NFC of columns 1,2,3 is column 2 and of 4,5 is
;; column 4; NFD of 1,2,3 is column 3 and of 4,5 is column 5; NFKC of all five is
;; column 4; NFKD of all five is column 5. Checking only NFC(source) would miss
;; idempotence, which is where a normaliser usually goes wrong.
(defn- nt-wrong
  (cols)
  (let ([c1 c2 c3 c4 c5] cols
        expect (fn (form sources want)
                 (first (remove (fn (s) (= (string/normalize s form) want)) sources)))
        fails (remove nil?
                (list (expect :nfc (list c1 c2 c3) c2)
                  (expect :nfc (list c4 c5) c4)
                  (expect :nfd (list c1 c2 c3) c3)
                  (expect :nfd (list c4 c5) c5)
                  (expect :nfkc (list c1 c2 c3 c4 c5) c4)
                  (expect :nfkd (list c1 c2 c3 c4 c5) c5))))
    (if (nil? fails) nil [(pr-str c1) (pr-str (first fails))])))

;; Walk the whole file but only test the lines inside `want` (a "PartN" name), tracking
;; the current section as it goes.
(defn- nt-scan-part
  (want lines here ran bad)
  (if (nil? lines)
    [ran (reverse bad)]
    (let (line (first lines)
          p (nt-part line))
      (cond
        p (nt-scan-part want (rest lines) p ran bad)
        (not (= here want)) (nt-scan-part want (rest lines) here ran bad)
        else
          (let (cols (nt-case line))
            (if (nil? cols)
              (nt-scan-part want (rest lines) here ran bad)
              (let (w (nt-wrong cols))
                (nt-scan-part want
                  (rest lines)
                  here
                  (inc ran)
                  (if w (cons w bad) bad)))))))))

;; Read and split the ~20,000-line file ONCE at load, not once per part. Six re-reads cost
;; ~40 s of a debug build's suite budget for nothing — the parts differ in which lines they
;; test, not in the lines they read.
(def- nt-lines (corpus-lines (ucd-file "NormalizationTest.txt")))

(defn- nt-part-scan (want) (nt-scan-part want nt-lines nil 0 nil))

;; The case lines of one section, collected ONCE. The predicate is deliberately crude —
;; "not blank, not an `@` header, has at least four `;`" — because it runs on all ~20,000
;; lines, and the precise version (`nt-test-line?`, which folds tabs with `replace` and
;; then `string-split`s) costs over 120 s in a DEBUG build all by itself.
;;
;; That cost is why sampling looked useless: it was paid per test regardless of how few
;; cases the sample tested, so 16x sampling changed nothing measurable. Provable by
;; running a slice with the modulus set so high that no case is tested at all — still
;; >120 s. With the walk done once, a 1-in-16 slice is ~42 s. `nt-case` still does the
;; real parsing, on the lines a slice actually tests.
(defn- nt-case-line?
  (line)
  (and (not (string/blank? line))
    (not (string/starts-with? (string/trim line) "@"))
    (not (string/starts-with? (string/trim line) "#"))
    (>= (count (string/split line ";")) 5)))

(defn- nt-collect
  (want lines here acc)
  (if (nil? lines)
    (reverse acc)
    (let (line (first lines)
          p (nt-part line))
      (cond
        p (nt-collect want (rest lines) p acc)
        (not (= here want)) (nt-collect want (rest lines) here acc)
        (nt-case-line? line) (nt-collect want (rest lines) here (cons line acc))
        else (nt-collect want (rest lines) here acc)))))

(def- nt-part1-cases (nt-collect "Part1" nt-lines nil nil))

;; Part1 alone is ~16,000 cases x 6 normalisations — one test's worth of work in release,
;; but enough to blow the framework's 120 s per-test ceiling inside the DEBUG-build
;; `brood_suite_passes` wrapper when it is competing with the whole workspace. Chunking by
;; `index mod n` splits it evenly across `n` tests that run in parallel, keeping every case.
(defn- nt-scan-chunk
  (want k n lines here idx ran bad)
  (if (nil? lines)
    [ran (reverse bad)]
    (let (line (first lines)
          p (nt-part line))
      (cond
        p (nt-scan-chunk want k n (rest lines) p idx ran bad)
        (not (= here want)) (nt-scan-chunk want k n (rest lines) here idx ran bad)
        (not (nt-test-line? line)) (nt-scan-chunk want k n (rest lines) here idx ran bad)
        ;; Decide BEFORE parsing. `nt-case` hex-decodes five fields and builds five
        ;; strings, so parsing every case and then discarding 15 of 16 made the sample cost
        ;; the same as the full sweep — the whole point of sampling was lost.
        ;; `idx` advances over test lines only, so the slices stay balanced.
        (not (= (rem idx n) k)) (nt-scan-chunk want k n (rest lines) here (inc idx) ran bad)
        else
          (let (w (nt-wrong (nt-case line)))
            (nt-scan-chunk want
              k
              n
              (rest lines)
              here
              (inc idx)
              (inc ran)
              (if w (cons w bad) bad)))))))

;; Part1 runs in FULL by default (`BROOD_UCD_PART1_OF` unset) — every one of its ~16,000 cases.
;;
;; The one context that cannot afford that is `brood_suite_passes`, the DEBUG-build
;; wrapper that runs this suite under cargo: a case costs roughly 30x its release price
;; there, so the full sweep is ~670 s of work inside a 600 s nextest cap on the whole
;; suite binary. `crates/lisp/tests/suite.rs` turns this knob down to 16 for that wrapper
;; only. Release stays exhaustive:
;; `nest test` and `make suite` sweep all of Part1 in ~5 s.
;;
;; An earlier attempt at sampling was abandoned because it "measurably didn't" help — and
;; it didn't, because the per-test cost was the 20,000-line WALK, not the cases (see
;; `nt-case-line?`). With the walk collected once, the sample is what it was meant to be.
;;
;; `index mod n` sampling, so the slice is spread across the whole section rather than
;; being a prefix, and it is deterministic. The slicing machinery is kept because it is
;; the right tool if a future case genuinely needs splitting — pass a different `k`.
;; Read from the ENVIRONMENT, not from a global the wrapper defines first. The wrapper's
;; `def` runs before this file is loaded, and this line is evaluated AT load — so a global
;; default here overwrote the wrapper's 16 back to 1, the sweep stayed full, and the
;; wrapper went on timing out. The environment is read at the same moment, by the code
;; that needs it, so there is no ordering to get wrong.
(def- nt-part1-of (max 1 (or (string->number (or (getenv "BROOD_UCD_PART1_OF") "")) 1)))

;; Every `*ucd-part1-of*`-th case of the pre-collected Part1 list, from offset `k`.
(defn- nt-slice-scan
  (lines k n idx ran bad)
  (if (nil? lines)
    [ran (reverse bad)]
    (if (= (rem idx n) k)
      (let (w (nt-wrong (nt-case (first lines))))
        (nt-slice-scan (rest lines) k n (inc idx) (inc ran) (if w (cons w bad) bad)))
      (nt-slice-scan (rest lines) k n (inc idx) ran bad))))

(defn- nt-part1-slice () (nt-slice-scan nt-part1-cases 0 nt-part1-of 0 0 nil))

;; ---- the suite ---------------------------------------------------------------

(describe "UCD: grapheme cluster boundaries (UAX #29)"
  :tags
  [:conformance :slow]

  (test "the corpus is present and matches the crates' Unicode version"
    (is (corpus-present? "ucd"))
    ;; Bump this together with UCD_VERSION in scripts/fetch-corpus.sh, and only
    ;; after checking Cargo.lock — see the header note on version skew.
    (assert= (string/trim (slurp (ucd-file "VERSION"))) "16.0.0"))

  (test "string->graphemes segments every GraphemeBreakTest case"
    (let ([ran bad] (gb-scan gb-lines 0 nil))
      (is (> ran 600))
      (assert= (take 3 bad) ())
      (assert= (count bad) 0))))

;; Split by the corpus's own `@PartN` sections rather than run as one sweep. Not
;; cosmetic: the whole file is ~19,000 cases x 6 normalisations, which is 44 s in a debug
;; build and enough to blow the framework's 120 s per-test ceiling once it is competing
;; with ~nproc other tests. Part1 ("character by character") is the bulk. Splitting keeps
;; every case AND lets the parts run in parallel, so the slowest test is a fraction of the
;; whole. Each part asserts its own case count, so a parsing change that silently stops
;; testing a section fails instead of reading as a pass.
(describe "UCD: normalization (UAX #15)"
  :tags
  [:conformance :slow]

  (test "Part0 — specific cases"
    (let ([ran bad] (nt-part-scan "Part0"))
      (is (> ran 15))
      (assert= (take 3 bad) ())))

  (test "Part1 — character by character (the bulk)"
    (let ([ran bad] (nt-part1-slice))
      ;; Scaled to the sample so BOTH contexts assert real coverage: ~16,000 cases at the
      ;; default, ~1,000 under the debug wrapper's 1-in-16. A sampling change that guts
      ;; the coverage fails rather than reading as a pass.
      (is (> ran (quot 16000 nt-part1-of)))
      (assert= (take 3 bad) ())))

  (test "Part2 — canonical order"
    (let ([ran bad] (nt-part-scan "Part2"))
      (is (> ran 1500))
      (assert= (take 3 bad) ())))

  (test "Part3 — PRI #29"
    (let ([ran bad] (nt-part-scan "Part3"))
      (is (> ran 100))
      (assert= (take 3 bad) ())))

  (test "Part4 — canonical closures (excluding Hangul)"
    (let ([ran bad] (nt-part-scan "Part4"))
      (is (> ran 600))
      (assert= (take 3 bad) ())))

  (test "Part5 — chained primary composites"
    (let ([ran bad] (nt-part-scan "Part5"))
      (is (> ran 10))
      (assert= (take 3 bad) ()))))

;; The properties worth naming: what these primitives are FOR, in cases a reader can
;; check by eye without decoding hex.
(describe "graphemes and normalization: the properties that matter"
  :tags
  [:conformance]

  (test "a cluster is what a human calls a character"
    ;; "e" + COMBINING ACUTE is one grapheme, two code points. Spelled with escapes
    ;; on BOTH sides deliberately: a literal "é" in this file is the precomposed
    ;; U+00E9, which is a different string, and `=` would rightly reject it.
    (assert= (string/to-graphemes "e\u{301}f") ["e\u{301}" "f"])
    (assert= (count (string/to-codepoints "e\u{301}f")) 3)
    ;; a regional-indicator pair is one flag, not two letters
    (assert= (count (string/to-graphemes "\u{1F1FF}\u{1F1E6}")) 1)
    ;; CRLF is one cluster — splitting it is the classic off-by-one
    (assert= (count (string/to-graphemes "\r\n")) 1))

  (test "graphemes reassemble to the original string"
    (dolist (s ["" "plain" "e\u{301}f" "\u{1F1FF}\u{1F1E6}x" "\r\n" "ne\u{301}e\u{301}"])
      (assert= (apply str (string/to-graphemes s)) s)))

  (test "normalization makes text that reads the same compare the same"
    ;; U+00E9 vs U+0065 U+0301 — different strings, same text
    (refute (= "\u{E9}" "e\u{301}"))
    (assert= (string/normalize "e\u{301}" :nfc) "\u{E9}")
    (assert= (string/normalize "\u{E9}" :nfd) "e\u{301}")
    (assert= (string/normalize "\u{E9}" :nfc) (string/normalize "e\u{301}" :nfc)))

  (test "compatibility forms fold presentation, canonical forms do not"
    ;; U+FB01 LATIN SMALL LIGATURE FI
    (assert= (string/normalize "\u{FB01}" :nfkc) "fi")
    (assert= (string/normalize "\u{FB01}" :nfc) "\u{FB01}")
    ;; U+00B2 SUPERSCRIPT TWO
    (assert= (string/normalize "\u{B2}" :nfkc) "2")
    (assert= (string/normalize "\u{B2}" :nfd) "\u{B2}"))

  (test "every form is idempotent"
    (dolist (form [:nfc :nfd :nfkc :nfkd])
      (dolist (s ["e\u{301}" "\u{E9}" "\u{FB01}" "\u{1E0A}\u{323}"])
        (assert= (string/normalize (string/normalize s form) form)
          (string/normalize s form)))))

  (test "an unknown form is rejected rather than silently passed through"
    (assert-error (string/normalize "x" :nfz))
    (assert-error (string/normalize "x" "nfc")))

  ;; The single case excluded from the sweep above, asserted as it CURRENTLY behaves
  ;; rather than as UAX #29 requires — so the day `unicode-segmentation` adds U+2701
  ;; to its Extended_Pictographic table, this test fails and tells us to drop the
  ;; exclusion. See the comment on `gb-upstream-gap`.
  (test "the one upstream gap: U+2701 is missing from Extended_Pictographic"
    ;; UAX #29 GB11 says one cluster; the crate gives two.
    (assert= (count (string/to-graphemes "\u{2701}\u{200D}\u{2701}")) 2)
    ;; the rule itself is correct for every other pictographic
    (assert= (count (string/to-graphemes "\u{270A}\u{200D}\u{270A}")) 1)
    (assert= (count (string/to-graphemes "\u{1F468}\u{200D}\u{1F469}")) 1)
    (assert= (count (string/to-graphemes "\u{2764}\u{200D}\u{1F525}")) 1)))
