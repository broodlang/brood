;;; KI-134 / ADR-339: a module load survives an `%isolate` restore.
;;;
;;; Isolation exists to roll back what a TEST did, not what a LOAD did. A module load is a
;;; process-shared, idempotent fact: once `require-one` has provided it, every process of the
;;; runtime may be using its bindings and its registrations (`*record-ids*`, `*impls*`,
;;; `*features*`). Under lazy loading (ADR-335) that load happens at whichever first use
;;; reaches it — which can be inside an `%isolate` window, this process's or a concurrent
;;; one's — and the restore's wholesale table swap used to discard it while the bindings'
;;; users were still running: a `queue` whose `pop` dispatched against an `*impls*` table
;;; `queue` was no longer in (`:size -1`), a worker whose `conj` found no impl and died.
;;;
;;; The fixture is a module nothing else in the suite knows, written to a temp dir on
;;; `*load-path*` at file load, so "not loaded yet" is guaranteed rather than hoped.

(defmodule isolate-load-test (:use test))

(purge-stale-temp "isoload-")
(def- *dir* (temp-dir "isoload-"))
(file/mkdir *dir*)
(reflect/add-load-path *dir*)
(file/spit (path/join *dir* "isoload-probe.blsp")
  (str "(defmodule isoload-probe)\n"
    "(defrecord thing (n))\n" "(defn answer () 42)\n"))
(file/spit (path/join *dir* "isoload-scratch.blsp")
  "(defmodule isoload-scratch)\n(defn answer () 7)\n")

(describe "a module loaded inside an isolate survives the restore (KI-134)"
  ;; Every reference to the fixture below is QUOTED and evaluated through `reflect/eval`: a
  ;; bare `isoload-probe/answer` would be loaded eagerly when this file loads (the runner's
  ;; own KI-134 mitigation), before the unit runs, and the "not loaded yet" half — the half
  ;; that proves the isolate did the loading — would be gone.
  ;; `:isolated`: each unit calls `%isolate` itself, and the runner's rule (KI-89, the
  ;; `isolate_tests_run_alone` gate) is that such a unit runs alone, not beside parallel
  ;; workers whose globals it would roll back.
  :isolated (test "its bindings, its record registration and its feature mark all persist"
    (assert= false (contains? *features* "isoload-probe"))
    ;; The load AND a test-style def, in one window: the load must stay, the def must go.
    (%isolate (fn () (do (require-one 'isoload-probe) (def isoload-dropped 1))))
    (assert= true (contains? *features* "isoload-probe"))
    (assert= 42 (reflect/eval '(isoload-probe/answer)))
    ;; The KI-89 asymmetry, checked both ways: the constructor is bound AND the record id
    ;; is registered — the registration is a registry write, the binding a plain define.
    (let (id (%identity-of (reflect/eval '(isoload-probe/thing 1))))
      (assert= :isoload-probe/thing id)
      (assert= true (contains? *record-ids* id))
      (assert= true (bound? (symbol (->string id)))))
    (assert= 1 (reflect/eval '(isoload-probe/thing-n (isoload-probe/thing 1))))
    (assert= false (bound? 'isoload-dropped)))

  :isolated (test "a registration the isolate itself makes is still rolled back"
    (%isolate (fn () (%registry-update! '*features* :assoc ["isoload-fake"] true)))
    (assert= false (contains? *features* "isoload-fake")))

  :isolated (test "a scratch isolate rolls a module load back with everything else"
    (assert= false (contains? *features* "isoload-scratch"))
    (%isolate-discard-loads (fn () (require-one 'isoload-scratch)))
    (assert= false (contains? *features* "isoload-scratch"))
    (assert= false (bound? 'isoload-scratch/answer))))

;;; KI-141: a module's REGISTRATION onto a registry another module owns survives the isolate
;;; its load landed in — not only its defines. `editor/highlight` `def-face`s its `:syntax/*`
;;; faces onto `editor/face`'s `*faces*` at load; written as a whole-map swap that was a LIVE
;;; write the restore discarded while the module stayed provided, and every later file in the
;;; tree-walker CI job found `highlight-spans` answering nil. The fixture below is the exact
;;; shape with the load journal opened by hand: a def-face made INSIDE a journalled load
;;; inside an isolate must be there after the restore; the same def-face made by a TEST (no
;;; load) inside an isolate must be gone — isolation still undoes what a test did.
(describe "a module's registration onto a foreign registry survives the isolate (KI-141)"
  :isolated (test "a def-face inside a journalled load, inside an isolate, is there after the restore"
    (%isolate (fn () (%with-load-journal (fn () (editor/face/def-face :ki141-loaded {:fg :red})))))
    (assert= {:fg :red} (editor/face/face :ki141-loaded)))
  :isolated (test "a system layer registered inside a journalled load, inside an isolate, survives too"
    (%isolate (fn ()
                (%with-load-journal (fn () (editor/layers/register-system-layer :ki141-layer)))))
    (is (any? editor/layers/*system-layers* (fn (r) (= r :ki141-layer)))))
  :isolated (test "…and a test's own def-face inside an isolate is still rolled back"
    (%isolate (fn () (editor/face/def-face :ki141-scratch {:fg :blue})))
    (is (nil? (editor/face/face :ki141-scratch)))))
