;; Module privacy is ENFORCED (ADR-146). Privacy is a **def-site fact**: `defn-`
;; and `def-` define a module-private name (a clean name, no marker in it), and the
;; kernel records it. From inside another module, a hand-written qualified reference
;; to such a name is a compile error at load; `(:use-internals mod)` is the explicit
;; grant (the @testable seam for tests and tightly-coupled tooling); top-level code
;; (no module) stays unrestricted — the live-hacking hatch hot reload depends on. A
;; module's macros may expand to its own privates anywhere (enforcement reads the
;; hand-written source, pre-expansion).
;;
;; Because a private name is spelled identically to a public one, privacy is judged
;; against the RECORD, which requires the module to be loaded — a reference into a
;; module that was never loaded can't be judged private and degrades to a normal
;; (call-time) unbound reference, NOT a load-time privacy error.
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule private-test (:use test))

;; A worker that reports `(private? sym)` for a symbol it is sent — used to prove
;; the recorded private-set (ADR-146) is visible to a *spawned* process through the
;; shared runtime `Arc`, not just the process that made the definitions.
(defn priv-refl-worker (parent)
  (receive (sym (send parent (private? sym)))))

(describe "module privacy (ADR-146)"
  ;; :serial — every test here `%load-string`s whole MODULES into the shared module
  ;; registry and global table, and some read a module a *sibling* test registered
  ;; (`priv-vault` is defined in the first test and re-used by later tests). Run in
  ;; parallel that is a race: this block was the source of an intermittent
  ;; `require: cannot find module 'priv-vault2'` that failed the whole in-language
  ;; suite roughly one run in five. Same reason `suite_test.blsp`'s macro blocks are
  ;; serial: module registration, not just a `defn`.
  :serial (test "a cross-module reference to a loaded module's private fails the load, catchably"
    (%load-string "(defmodule priv-vault) (defn- secret () 41)")
    (is (= (try
             (%load-string "(defmodule priv-thief) (defn steal () (priv-vault/secret))")
             (catch e
               (if (includes? (str (get e :message)) "module-private")
                 :blocked [:other e])))
          :blocked)))
  (test "a reference into a NEVER-LOADED module is not a privacy error — it degrades to unbound"
    ;; The record can't answer for a module it has never seen, so this loads (the
    ;; unbound reference only surfaces if `c` is ever called). This deliberately
    ;; REPLACES the old name-authoritative behavior, which rejected it at load.
    (is (= (try
             (do (%load-string "(defmodule priv-nl) (defn c () (never-loaded/thing))") :loaded)
             (catch e :errored))
          :loaded)))

  (test "(:use-internals mod) grants access — loud, explicit, greppable"
    (%load-string "(defmodule priv-vault2) (defn- secret2 () 42)")
    (%load-string "(defmodule priv-friend (:use-internals priv-vault2)) (defn borrow () (priv-vault2/secret2))")
    (assert= (priv-friend/borrow) 42))
  (test "same-module private access is untouched (defn- and def-)"
    (%load-string "(defmodule priv-pub) (defn- inner () 7) (def- base 10) (defn outer () (+ (inner) base))")
    (assert= (priv-pub/outer) 17))
  (test "an aliased qualified private is still blocked (the alias resolves first)"
    (is (= (try
             (%load-string "(defmodule priv-al (:alias priv-vault :as pv)) (defn s () (pv/secret))")
             (catch e :blocked))
          :blocked)))
  (test "(:use mod :only [...]) refuses a private name without a grant"
    (is (= (try
             (%load-string "(defmodule priv-only (:use priv-vault :only [secret]))")
             (catch e :refused))
          :refused)))
  (test "top-level (no module) code may reach privates — the live-hacking hatch"
    (assert= (eval (reflect/read-string "(priv-vault/secret)")) 41))
  (test "an unquoted private ref inside a quasiquote is still an evaluated ref — blocked"
    ;; `(x ~(other/priv)) — the ~ brings the ref back to the evaluated context,
    ;; so wrapping it in a quasiquote is not a bypass (ADR-146 level-aware walk).
    (is (= (try
             (%load-string "(defmodule priv-qq) (defn f () `(x ~(priv-vault/secret)))")
             (catch e :blocked))
          :blocked)))
  (test "a quasiquote TEMPLATE (data, not unquoted) may name another module — data, not a ref"
    ;; `(priv-vault/secret) with NO unquote is just a quoted symbol list.
    (%load-string "(defmodule priv-tmpl) (defn f () `(priv-vault/secret))")
    (is (= (first (priv-tmpl/f)) 'priv-vault/secret)))
  (test "an unquote nested inside a (quote ...) template is still an evaluated ref — blocked"
    ;; `(quote ~(other/priv)) — Brood's quasiquote splices the unquote even inside
    ;; a quoted subform, so `(quote ~(m/priv)) evaluates the private. The
    ;; level-aware walk must not treat `quote` as terminal data inside a quasiquote.
    (is (= (try
             (%load-string "(defmodule priv-qq2) (defn f () `(quote ~(priv-vault/secret)))")
             (catch e :blocked))
          :blocked)))
  (test "a macro template referencing its OWN module's private still works"
    (%load-string "(defmodule priv-mac) (defn- mac-h (x) (* x 2)) (defmacro dbl (x) `(mac-h ~x)) (defn use () (dbl 21))")
    (assert= (priv-mac/use) 42))

  ;; ---- `private?` reflection over the recorded private-set (ADR-146) -----------
  ;; Privacy is a recorded per-module fact (`Heap::is_private`), populated where the
  ;; `defn-`/`def-` runs and consulted via `private?`.
  (test "private? reports a recorded private true; a public or undefined name false"
    (%load-string "(defmodule priv-refl) (defn- helper () 1) (defn pub () 2) (def- k 3)")
    (and (is (private? 'priv-refl/helper))
      (is (private? 'priv-refl/k))
      (refute (private? 'priv-refl/pub))
      (refute (private? 'priv-refl/never-defined))))
  (test "the recorded private-set is visible to a spawned process (shared runtime Arc)"
    (%load-string "(defmodule priv-refl2) (defn- helper () 1) (defn pub () 2)")
    (let (me (self) worker (spawn (priv-refl-worker me)))
      (send worker 'priv-refl2/helper)
      (is (= (receive) true))))
  (test "a spawned process also sees a public name as not private"
    (%load-string "(defmodule priv-refl3) (defn- helper () 1) (defn pub () 2)")
    (let (me (self) worker (spawn (priv-refl-worker me)))
      (send worker 'priv-refl3/pub)
      (is (= (receive) false))))
  (test "privacy tracks the latest def form across redefinition (hot reload)"
    ;; Editing `defn-` → `defn` and reloading makes the name public again, and
    ;; back: `env_define` clears the mark on every def, `%mark-private` re-adds it
    ;; only for `defn-`/`def-`.
    (%load-string "(defmodule priv-flip) (defn- x () 1)")
    (is (private? 'priv-flip/x))
    (%load-string "(defmodule priv-flip) (defn x () 2)") ; redefine PUBLIC
    (refute (private? 'priv-flip/x))
    (%load-string "(defmodule priv-flip) (defn- x () 3)") ; redefine PRIVATE
    (is (private? 'priv-flip/x))))
