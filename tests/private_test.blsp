;; Module privacy is ENFORCED (ADR-146): from inside a module, a hand-written
;; qualified reference to another module's `--` name is a compile error at
;; load; `(:use-internals mod)` is the explicit grant (the @testable seam for
;; tests and tightly-coupled tooling); top-level code (no module) stays
;; unrestricted — the live-hacking hatch hot reload depends on. A module's
;; macros may expand to its own privates anywhere (enforcement reads the
;; hand-written source, pre-expansion).
;;
;; Register-only — discovered and run by `nest test` (and cargo test).

(defmodule private-test (:use test))

(describe "module privacy (ADR-146)"
  (test "a cross-module private reference fails the module's load, catchably"
    (%load-string "(defmodule priv-vault) (defn vault--secret () 41)")
    (is (= (try
             (%load-string "(defmodule priv-thief) (defn steal () (priv-vault/vault--secret))")
             (catch e
               (if (string-contains? (str (get e :message)) "module-private")
                 :blocked
                 [:other e])))
          :blocked)))
  ;; The common real-world case is NOT someone reaching into another module: it is a
  ;; caller left behind when a `--` helper was promoted to a public name. Reporting that
  ;; as a privacy violation sends you looking for a grant you don't need. Two downstream
  ;; projects lost their whole suite to exactly this (`lineedit--init` → `lineedit-init`).
  (test "a stale reference to a PROMOTED helper says so, and names the public name"
    (%load-string "(defmodule priv-moved) (defn moved-helper () 7)")
    (let (message (try
                    (%load-string "(defmodule priv-caller) (defn c () (priv-moved/moved--helper))")
                    (catch e (str (get e :message)))))
      (and (is (string-contains? message "does not exist"))
        (is (string-contains? message "priv-moved/moved-helper"))
        ;; and it must NOT send the reader after a privacy grant they don't need
        (refute (string-contains? message ":use-internals")))))
  (test "a private that really DOES exist still reports privacy, not a rename"
    (%load-string "(defmodule priv-real) (defn real--secret () 9)")
    (let (message (try
                    (%load-string "(defmodule priv-caller2) (defn c () (priv-real/real--secret))")
                    (catch e (str (get e :message)))))
      (and (is (string-contains? message "module-private"))
        (is (string-contains? message ":use-internals")))))
  (test "with no public counterpart either, the plain privacy message stands"
    ;; An unloaded module has neither name, so the diagnosis must not be guessed.
    (let (message (try
                    (%load-string "(defmodule priv-caller3) (defn c () (never-loaded/nope--thing))")
                    (catch e (str (get e :message)))))
      (is (string-contains? message "module-private"))))

  (test "(:use-internals mod) grants access — loud, explicit, greppable"
    (%load-string "(defmodule priv-vault2) (defn vault2--secret () 42)")
    (%load-string "(defmodule priv-friend (:use-internals priv-vault2)) (defn borrow () (priv-vault2/vault2--secret))")
    (assert= (priv-friend/borrow) 42))
  (test "same-module private access is untouched"
    (%load-string "(defmodule priv-pub) (defn pub--inner () 7) (defn outer () (pub--inner))")
    (assert= (priv-pub/outer) 7))
  (test "an aliased qualified private is still blocked (the alias resolves first)"
    (is (= (try
             (%load-string "(defmodule priv-al (:alias priv-vault :as pv)) (defn s () (pv/vault--secret))")
             (catch e :blocked))
          :blocked)))
  (test "(:use mod :only [...]) refuses a private name without a grant"
    (is (= (try
             (%load-string "(defmodule priv-only (:use priv-vault :only [vault--secret]))")
             (catch e :refused))
          :refused)))
  (test "top-level (no module) code may reach privates — the live-hacking hatch"
    (assert= (eval (read-string "(priv-vault/vault--secret)")) 41))
  (test "an unquoted private ref inside a quasiquote is still an evaluated ref — blocked"
    ;; `(x ~(other/priv)) — the ~ brings the ref back to the evaluated context,
    ;; so wrapping it in a quasiquote is not a bypass (ADR-146 level-aware walk).
    (is (= (try
             (%load-string "(defmodule priv-qq) (defn f () `(x ~(priv-vault/vault--secret)))")
             (catch e :blocked))
          :blocked)))
  (test "a quasiquote TEMPLATE (data, not unquoted) may name another module — data, not a ref"
    ;; `(priv-vault/vault--secret) with NO unquote is just a quoted symbol list.
    (%load-string "(defmodule priv-tmpl) (defn f () `(priv-vault/vault--secret))")
    (is (= (first (priv-tmpl/f)) 'priv-vault/vault--secret)))
  (test "an unquote nested inside a (quote ...) template is still an evaluated ref — blocked"
    ;; `(quote ~(other/priv)) — Brood's quasiquote splices the unquote even inside
    ;; a quoted subform, so `(quote ~(m/priv--x)) evaluates the private. The
    ;; level-aware walk must not treat `quote` as terminal data inside a quasiquote.
    (is (= (try
             (%load-string "(defmodule priv-qq2) (defn f () `(quote ~(priv-vault/vault--secret)))")
             (catch e :blocked))
          :blocked)))
  (test "a macro template referencing its OWN module's private still works"
    (%load-string "(defmodule priv-mac) (defn mac--h (x) (* x 2)) (defmacro dbl (x) `(mac--h ~x)) (defn use () (dbl 21))")
    (assert= (priv-mac/use) 42)))
