;; `&optional` defaults. On the VM a real default is a prologue in its arm's own bytecode
;; (`compile_arm`): `push_frame` marks each missing optional in a hidden flag slot, and the
;; prologue evaluates that default into its slot, left to right, ahead of the body. These pin
;; what that has to keep: a default runs exactly when its argument is missing — an explicit
;; `nil` is an argument — it sees the parameters before it, and the body keeps its tail.

(defmodule optional-defaults-test (:use test) (:use suite-helpers))

(defn chained (a &optional (b (+ a 1)) (c (* b 2))) [a b c])

(defn with-let (a &optional (b (let (x (* a 10) y 3) (+ x y)))) [a b])

(defn square (x) (* x x))

(defn calls-out (a &optional (b (square a))) (+ a b))

(defn raises (&optional (b (throw "default ran"))) b)

(defn sum-down (n &optional (acc 0)) (if (= n 0) acc (sum-down (- n 1) (+ acc n))))

(defn nil-then-default (a &optional b (c (or b a))) [a b c])

(defn with-rest (a &optional (b a) & more) [a b more])

(defn counting (table &optional (v (do (table/put table :ran (+ 1 (table/get table :ran 0))) :d)))
  v)

(describe "&optional defaults"
  (test "a default sees the parameters before it, left to right"
    (assert= [1 2 4] (chained 1))
    (assert= [1 5 10] (chained 1 5))
    (assert= [1 5 9] (chained 1 5 9)))
  (test "a default can bind its own locals and call out"
    (assert= [2 23] (with-let 2))
    (assert= 20 (calls-out 4)))
  (test "a default runs only when its argument is missing"
    (assert= 7 (raises 7))
    (assert-error (raises))
    (let (t (table/new))
      (counting t :given)
      (counting t nil)
      (assert= nil (table/get t :ran))
      (assert= :d (counting t))
      (assert= 1 (table/get t :ran))))
  (test "an explicit nil is an argument, not a missing one"
    (assert= [1 nil 1] (nil-then-default 1))
    (assert= [1 2 2] (nil-then-default 1 2))
    (assert= [1 nil nil] (nil-then-default 1 nil nil)))
  (test "a default beside a rest parameter"
    (assert= [1 1 nil] (with-rest 1))
    (assert= [1 2 (list 3 4)] (with-rest 1 2 3 4)))
  (test "the body keeps its tail position: a deep loop through an optional accumulator"
    (assert= 5000050000 (sum-down 100000)))
  (test "a default closes over a parameter and over the enclosing scope"
    (assert= 3 ((fn (a &optional (b (fn () a))) (b)) 3))
    (assert= 16 (let (m 4) ((fn (&optional (q (* m m))) q))))
    (assert= (list 11 12 13) (map [1 2 3] (fn (x &optional (y 10)) (+ x y))))))

;; The flag that says an optional was missing is a frame slot above the body's, and native
;; entry clears the slots above the parameters. Clearing the flag too skipped the default
;; once the arm went native, and again after the deopt that followed, which re-runs the same
;; frame: bedit's `git-git`, `&optional (opts {})`, saw nil after enough calls.
(defn native-default (a &optional (o {})) (assoc o :x a))

(defn- drive-native-default (n acc)
  (if (= n 0) acc (drive-native-default (- n 1) (native-default n))))

(describe "&optional defaults on the native tier"
  (test "a default still runs once its arm has gone native"
    (when (%native-tier?)
      (assert= :native (settle native-default 1 (fn () (drive-native-default 4000 nil)) 40))
      (assert= {:x 1} (native-default 1))
      (assert= {:x 1 :y 2} (native-default 1 {:y 2}))
      (assert= 0 (get (%jit-arm-state native-default 1) :deopts-total))))

  ;; The prologue's then-branch stores the default, and the native lowering kept that store's
  ;; SSA value as the slot's for the rest of the arm: `(+ acc n)` after the join read the
  ;; constant on every path, given the argument or not, and the loop answered 1. The
  ;; suite's own deep-loop case above ran on the VM — every rebind elsewhere in the runtime
  ;; reset the arm (KI-303) — so it never saw native code.
  (test "a loop over an optional accumulator keeps its sum on the native tier"
    (when (%native-tier?)
      (assert= :native (settle sum-down 1 (fn () (sum-down 1000)) 40)))
    (assert= 15 (sum-down 5))
    (assert= 5000050000 (sum-down 100000))
    (assert= 5000050000 (sum-down 100000 0))
    (assert= 5000050010 (sum-down 100000 10))))

(defn opt-nil (a &optional b c) (if (nil? c) (if (nil? b) 0 1) 2))

(defn opt-mixed (a &optional (b 10) c) (if (nil? c) b (+ b c)))

(defn hot-calls (i acc)
  ;; Native callers re-entered thousands of times, so every call path into an optional arm
  ;; is taken: the fast frames (`frame_is_args_then_nil`) for an omitted nil default or a
  ;; full argument list, `push_frame` for an omitted real default.
  (if (>= i 20000)
    acc
    (hot-calls (+ i 1)
      (+ acc
        (opt-nil i)
        (opt-nil i 1)
        (opt-nil i 1 2)
        (opt-mixed i)
        (opt-mixed i 2)
        (opt-mixed i 2 3)))))

(describe "&optional arms on the fast call paths"
  (test "an omitted nil default reads nil and a real default runs, however hot the call"
    ;; per round: 0 + 1 + 2 + 10 + 2 + 5 = 20
    (assert= 400000 (hot-calls 0 0))))

(describe "&optional defaults across processes"
  :isolated (test "workers calling one function with and without its optionals agree"
    (let (me (self))
      (doseq (k (range 8))
        (spawn (send me [:r k (chained k) (chained k 0) (sum-down 1000)])))
      (let (rs (map (range 8) (fn (_) (receive ([:r k a b s] [k a b s]) (after 20000 :timeout)))))
        (assert= 8 (count rs))
        (each rs
          (fn (r)
            (let ([k a b s] r)
              (assert= [k (+ k 1) (* 2 (+ k 1))] a)
              (assert= [k 0 0] b)
              (assert= 500500 s))))))))
