;;; Namespaces — increment 1 (ADR-065): expand-time resolution over the flat
;;; table. `(defmodule foo)` qualifies definitions to `foo/name`; a bare reference
;;; resolves to `foo/name` if this namespace defines it, else falls back to root
;;; (the prelude). Each case loads a small namespaced source via `%load-string`
;;; (the module-load path: resets to root, the source's `(defmodule …)` sets it, with a
;;; forward-reference pre-scan) and checks the resulting globals / behaviour.
;;;
;;; Note: the advisory checker may print `unbound symbol: nsX/…` for these cases —
;;; the fixtures are defined dynamically (`%load-string`), invisible to static
;;; analysis, exactly as `(reflect/eval-string "(def f …)") (f)` is. Advisory only; the
;;; tests pass regardless.

(defmodule namespace-test (:use test))

;; A plain root worker that echoes one message back to its parent.
(defn ns-echo (parent) (send parent (receive)))

(describe "namespaces: definition + resolution"
  :isolated (test "definitions are qualified under the namespace; bare name is unbound"
    (%load-string "(defmodule nsA) (defn greet () 42)")
    (is (bound? 'nsA/greet))
    (is (not (bound? 'greet)))
    (is (= (nsA/greet) 42)))

  (test "a bare same-namespace reference resolves to the qualified name"
    (%load-string "(defmodule nsB) (defn helper () 7) (defn use-it () (helper))")
    (is (= (nsB/use-it) 7)))

  (test "a forward reference resolves (callee defined later in the file)"
    (%load-string "(defmodule nsC) (defn front () (back)) (defn back () 99)")
    (is (= (nsC/front) 99)))

  (test "root/prelude names fall through and stay bare"
    (%load-string "(defmodule nsD) (defn doubled (xs) (map xs (fn (x) (* x 2))))")
    (is (= (nsD/doubled (list 1 2 3)) (list 2 4 6))))

  (test "two namespaces define the same short name without colliding"
    (%load-string "(defmodule nsE) (defn val () :e)")
    (%load-string "(defmodule nsF) (defn val () :f)")
    (is (= (nsE/val) :e))
    (is (= (nsF/val) :f)))

  (test "an explicitly qualified cross-namespace reference is left as-is"
    (%load-string "(defmodule nsG) (defn target () :got)")
    (%load-string "(defmodule nsH) (defn reach () (nsG/target))")
    (is (= (nsH/reach) :got)))

  (test "a quoted symbol is data — never qualified"
    (%load-string "(defmodule nsI) (defn tag () (quote hello))")
    (is (= (nsI/tag) 'hello))
    (is (= (str (nsI/tag)) "hello")))

  (test "a local binding shadows a same-named namespace global"
    (%load-string "(defmodule nsJ) (def x 100) (defn shadowed () (let (x 5) x))")
    (is (= (nsJ/shadowed) 5))
    (is (= nsJ/x 100)))

  (test "a namespaced global is late-bound and redefinable (hot-reload property)"
    (%load-string "(defmodule nsK) (defn f () 1)")
    (is (= (nsK/f) 1))
    (%load-string "(defmodule nsK) (defn f () 2)")
    (is (= (nsK/f) 2)))

  (test "def-sites are keyed by the qualified name"
    (%load-string "(defmodule nsM) (defn located () 0)")
    ;; recorded only for a real file load; here just assert the qualified global
    ;; is the one that exists (bare is not).
    (is (bound? 'nsM/located))
    (is (not (bound? 'located)))))

(describe "namespaces across processes"
  :isolated (test "a qualified symbol round-trips through send (re-intern by name)"
    (let (me (self) w (spawn (ns-echo me)))
      (send w {:sym 'some-ns/some-fn :n 1})
      (let (back (receive))
        (is (symbol? (get back :sym)))
        (is (= (get back :sym) 'some-ns/some-fn))
        (is (= (str (get back :sym)) "some-ns/some-fn")))))

  (test "a value built by a namespaced fn survives a worker round-trip"
    (%load-string "(defmodule nsP) (defn make () {:tag 'nsP/make :data (list 1 2 3)})")
    (let (me (self) w (spawn (ns-echo me)))
      (send w (nsP/make))
      (is (= (receive) {:tag 'nsP/make :data (list 1 2 3)})))))

(describe "namespaces: (:use …) imports"
  :isolated (test "(:use mod) refers all of a module's public names bare"
    (%load-string "(defmodule ilibA) (defn pub-x () :x) (defn pub-y () :y)")
    (%load-string "(defmodule iappA (:use ilibA)) (defn run () (list (pub-x) (pub-y)))")
    (is (= (iappA/run) (list :x :y))))

  (test "(:use mod :only [..]) refers only the named symbols"
    (%load-string "(defmodule ilibB) (defn keep-me () :kept) (defn skip-me () :skipped)")
    (%load-string "(defmodule iappB (:use ilibB :only [keep-me])) (defn run () (keep-me))")
    (is (= (iappB/run) :kept))
    ;; skip-me wasn't referred, so a bare reference would resolve to root (unbound),
    ;; not to ilibB/skip-me — confirm only the qualified one exists.
    (is (bound? 'ilibB/skip-me)))

  (test "a `defn-` private name is not referred by (:use), and privacy is ENFORCED (ADR-146)"
    (%load-string "(defmodule ilibC) (defn shown () :shown) (defn- hidden () :hidden)")
    (%load-string "(defmodule iappC (:use ilibC)) (defn run () (shown))")
    (is (= (iappC/run) :shown))
    ;; hard privacy: a module hand-writing another (loaded) module's qualified
    ;; private fails to COMPILE at load (it used to be reachable — "soft privacy")
    (is (= (try
             (%load-string "(defmodule iappC2 (:use ilibC)) (defn peek () (ilibC/hidden))")
             (catch e :blocked))
          :blocked))
    ;; …unless it declares the grant — the explicit @testable seam
    (%load-string "(defmodule iappC3 (:use-internals ilibC)) (defn peek () (ilibC/hidden))")
    (is (= (iappC3/peek) :hidden)))

  (test "an own-namespace definition shadows an imported name"
    (%load-string "(defmodule ilibD) (defn val () :theirs)")
    (%load-string "(defmodule iappD (:use ilibD)) (defn val () :mine) (defn run () (val))")
    (is (= (iappD/run) :mine)))

  (test "(:use) of an already-provided namespace works (require is a no-op)"
    (%load-string "(defmodule ilibE) (defn ping () :pong)")
    ;; ilibE is now provided; :use-ing it again should still refer its names
    (%load-string "(defmodule iappE (:use ilibE)) (defn run () (ping))")
    (is (= (iappE/run) :pong)))

  (test "a result built via imported names round-trips through a worker"
    (%load-string "(defmodule ilibF) (defn tag () 'ilibF/tag)")
    (%load-string "(defmodule iappF (:use ilibF)) (defn make () {:t (tag) :n 7})")
    (let (me (self) w (spawn (ns-echo me)))
      (send w (iappF/make))
      (is (= (receive) {:t 'ilibF/tag :n 7})))))

;;; Hierarchical module names (ADR-085): a module name may itself contain `/`
;;; (`gui/window`), so its defs qualify on the *last* `/` — module `gui/window`,
;;; def `draw` → the symbol `gui/window/draw`. Resolution, imports, and the
;;; cross-process round-trip all reuse the flat-table machinery (a qualified name
;;; is one interned symbol), so these mirror the flat cases above one level deeper.
(describe "namespaces: hierarchical module names (ADR-085)"
  :isolated (test "a hierarchical module qualifies its defs on the last `/`"
    (%load-string "(defmodule gui/window) (defn draw () :drawn)")
    (is (bound? 'gui/window/draw))
    (is (not (bound? 'window/draw)))
    (is (not (bound? 'draw)))
    (is (= (gui/window/draw) :drawn)))

  (test "a deeper (3-segment) module name works the same way"
    (%load-string "(defmodule a/b/c) (defn f () 3)")
    (is (bound? 'a/b/c/f))
    (is (= (a/b/c/f) 3)))

  (test "a bare same-namespace reference resolves inside a hierarchical module"
    (%load-string "(defmodule gui/panel) (defn helper () 7) (defn use-it () (helper))")
    (is (= (gui/panel/use-it) 7)))

  (test "an explicitly qualified cross-module reference resolves"
    (%load-string "(defmodule gui/text) (defn target () :got)")
    (%load-string "(defmodule gui/edit) (defn reach () (gui/text/target))")
    (is (= (gui/edit/reach) :got)))

  (test "(:use gui/lib) refers a hierarchical module's public names bare"
    (%load-string "(defmodule gui/lib) (defn pub-x () :x) (defn pub-y () :y)")
    (%load-string "(defmodule gui/app (:use gui/lib)) (defn run () (list (pub-x) (pub-y)))")
    (is (= (gui/app/run) (list :x :y))))

  (test "a value built by a hierarchical-namespaced fn survives a worker round-trip"
    (%load-string "(defmodule gui/build) (defn make () {:tag 'gui/build/make :data (list 1 2 3)})")
    (let (me (self) w (spawn (ns-echo me)))
      (send w (gui/build/make))
      (is (= (receive) {:tag 'gui/build/make :data (list 1 2 3)})))))

;; An `&optional` default is code in the module that wrote it, so it must resolve in
;; that module's namespace — like the body does. It didn't: param lists were passed
;; through the resolver verbatim (correct for the BINDERS, which are not references),
;; and the default expression rode along unresolved. It then resolved at call time in
;; whatever namespace the caller happened to be in, so a module reading its own global
;; from a default raised `unbound symbol`.
;;
;; Earmuffs hid this until ADR-151: `*knob*` was ambient, so the common
;; `(&optional (n *knob*))` happened to work while a plain `(&optional (n limit))` was
;; already broken. Found by a downstream project (bedit) failing 25 tests on it.
(describe "namespaces: &optional defaults resolve in the DEFINING module"
  (test "a default reading the module's own plain global"
    (%load-string "(defmodule nsopt1) (def lim 7) (defn f (x &optional (n lim)) (list x n))")
    (assert= (nsopt1/f 1) (list 1 7)))
  (test "a default reading the module's own earmuffed global"
    (%load-string "(defmodule nsopt2) (def *lim* 5) (defn f (x &optional (n *lim*)) (list x n))")
    (assert= (nsopt2/f 1) (list 1 5)))
  (test "resolution follows the DEFINING module, not the calling one"
    ;; The caller has a global of the same name; the default must not pick it up.
    (%load-string "(defmodule nsopt3) (def lim 7) (defn f (&optional (n lim)) n)")
    (%load-string "(defmodule nsopt4) (def lim 999) (defn call-it () (nsopt3/f))")
    (assert= (nsopt4/call-it) 7))
  (test "an explicit argument still wins over the default"
    (%load-string "(defmodule nsopt5) (def lim 7) (defn f (x &optional (n lim)) (list x n))")
    (assert= (nsopt5/f 1 42) (list 1 42)))
  (test "a default referencing an EARLIER PARAM stays a local reference"
    ;; docs/language.md: "a default may reference an earlier parameter (left-to-right)".
    ;; The binder must not be qualified into the namespace by the same pass.
    (%load-string "(defmodule nsopt6) (defn rect (w &optional (h w)) (* w h))")
    (and (assert= (nsopt6/rect 3) 9) (assert= (nsopt6/rect 3 4) 12)))
  (test "a default mixing an earlier param and a module global"
    (%load-string "(defmodule nsopt7) (def lim 5) (defn f (w &optional (h lim) (area (* w h))) area)")
    (assert= (nsopt7/f 2) 10))
  (test "a defdyn knob keeps working from a default (it is ambient, never namespaced)"
    (%load-string "(defmodule nsopt8) (defdyn *dlim* 9) (defn f (&optional (n *dlim*)) n)")
    (assert= (nsopt8/f) 9)))

;;; The `/name` root escape (ADR-065): an empty module prefix addresses the ROOT /
;;; prelude namespace, so a module that shadows a prelude name can still reach the
;;; original — `/map` is prelude's `map` even where the module defined its own.
(describe "namespaces: the /name root escape"
  :isolated (test "a module shadowing a prelude name reaches the original via /name"
    (%load-string (str "(defmodule nsroot1)"
                    " (defn map (x) (list :mine x))" " (defn mine (x) (map x))"
                    " (defn orig () (/map (list 1 2 3) (fn (x) (* x x))))"))
    ;; the module's own `map` wins for a bare reference…
    (assert= (nsroot1/mine 5) (list :mine 5))
    ;; …and `/map` still reaches the prelude's `map`.
    (assert= (nsroot1/orig) (list 1 4 9)))
  (test "the bare division operator is untouched by the /name escape"
    (%load-string "(defmodule nsroot2) (defn half (x) (/ x 2))")
    (assert= (nsroot2/half 10) 5)))

;;; A `def` that runs BEFORE the file's `(defmodule …)` opens is a ROOT def (the
;;; namespace isn't set yet), so a bare reference to it from inside the module must
;;; fall through to root. The forward-reference pre-scan used to collect def heads
;;; from the WHOLE file — including pre-module ones — which made the module reference
;;; misqualify to `mod/name` and fail with a confusing "unbound `mod/name`" even
;;; though the name was plainly defined. The scan now starts at the first `defmodule`.
(describe "namespaces: a pre-module def stays at root"
  :isolated (test "a bare reference to a def written before defmodule resolves to root"
    (%load-string (str "(def pre-cfg 7)" " (defmodule nspre) (defn read-it () pre-cfg)"))
    (is (bound? 'pre-cfg)) ; defined at root, not nspre/pre-cfg
    (is (not (bound? 'nspre/pre-cfg)))
    (assert= (nspre/read-it) 7))
  (test "a pre-module def the module also calls as a function resolves to root"
    (%load-string (str "(defn pre-helper () :root)"
                    " (defmodule nspre2) (defn use-it () (pre-helper))"))
    (assert= (nspre2/use-it) :root)))

;;; Multiple modules per file (ADR-223). A file may open more than one `(defmodule …)`;
;;; each opens a REGION that runs to the next `defmodule` or EOF. A bare reference
;;; resolves against the module it is *inside* (its region's forward-ref set), so
;;; co-located modules don't see each other's bare names — they qualify or `:use`. This
;;; subsumes the pre-module case above: forms before the first `defmodule` are the root
;;; region. `%in-ns` switches the active region at run time; the checker mirrors the
;;; switch. The runtime is unchanged — still flat interned symbols, one per qualified name.
(describe "namespaces: multiple modules per file (ADR-223)"
  :isolated (test "two modules in one file each qualify their own same-named def"
    (%load-string (str "(defmodule mm-a) (defn val () :a)" " (defmodule mm-b) (defn val () :b)"))
    (is (= (mm-a/val) :a))
    (is (= (mm-b/val) :b))
    (is (bound? 'mm-a/val))
    (is (bound? 'mm-b/val))
    (is (not (bound? 'val))))

  (test "a bare reference resolves against the module it is inside, not an earlier one"
    ;; `describe` in mm-sq calls its OWN `area`/`perimeter`, never mm-ci's `area`.
    (%load-string (str "(defmodule mm-ci) (defn area (r) (* 3 r r))"
                    " (defmodule mm-sq) (defn area (s) (* s s))" " (defn perimeter (s) (* 4 s))"
                    " (defn describe (s) (list (area s) (perimeter s)))"))
    (is (= (mm-ci/area 2) 12))
    (is (= (mm-sq/area 3) 9))
    (is (= (mm-sq/describe 3) (list 9 12))))

  (test "a co-located module is reachable by an explicit qualified reference"
    (%load-string (str "(defmodule mm-x) (defn base () 10)"
                    " (defmodule mm-y) (defn use-x () (mm-x/base))"))
    (is (= (mm-y/use-x) 10)))

  (test "a bare cross-module reference is isolated (a sibling module isn't auto-visible)"
    (%load-string (str "(defmodule mm-i1) (defn secret () 1)"
                    " (defmodule mm-i2) (defn peek () (secret))"))
    ;; `secret` is mm-i1's; a bare reference from mm-i2 is not mm-i2's own → unbound.
    (is (= (try (mm-i2/peek) (catch e :unbound)) :unbound)))

  (test "a forward reference within a later module's region resolves"
    (%load-string (str "(defmodule mm-f1) (defn f () 1)"
                    " (defmodule mm-f2) (defn front () (back)) (defn back () 99)"))
    (is (= (mm-f2/front) 99)))

  (test "a value built by a co-located module round-trips through a worker"
    (%load-string (str "(defmodule mm-p1) (defn tag () 'mm-p1/tag)"
                    " (defmodule mm-p2) (defn make () {:t (mm-p1/tag) :n 7})"))
    (let (me (self) w (spawn (ns-echo me)))
      (send w (mm-p2/make))
      (is (= (receive) {:t 'mm-p1/tag :n 7})))))

;; ---- lazy `(:use …)` clash resolution (ADR-235) -----------------------------
;; Namespacing means two modules MAY export the same short name. Importing both is fine;
;; the clash surfaces only when the shared name is actually USED bare, and the error then
;; names the candidate modules. So there is NO std-wide "overlap set" to maintain — overlaps
;; self-report at the point of use, and stay silent when a caller only touches non-overlapping
;; names. (`sexp` and `telemetry` both export `forward` — the pair exercised here; before
;; ADR-235 this whole section pinned a hand-maintained list of every std overlap.)
(defn- ns-loads? (src)
  "True if `src` loads without error — the clash, if any, never fired."
  ;; check-allow :discarded-catch — a did-it-throw assertion: the caught error is the answer
  (check-allow :discarded-catch (try (do (%load-string src) true) (catch e false))))

(defn- ns-load-error (src)
  (try (do (%load-string src) "") (catch e (str (error-message e)))))

(describe "namespaces: `(:use …)` clashes resolve lazily (ADR-235)"
  :isolated (test "importing two modules that share a name is fine when the name is not used bare"
    ;; `up` is sexp-only and `forward` (shared) is never referenced — no error.
    (is (ns-loads? "(defmodule lz-ok (:use sexp) (:use telemetry)) (defn f (x) (up x))")))

  (test "using the shared bare name is a use-site error naming both candidates"
    (let (msg (ns-load-error "(defmodule lz-bad (:use sexp) (:use telemetry)) (defn f (x) (forward x))"))
      (is (includes? msg "ambiguous"))
      (is (includes? msg "sexp/forward"))
      (is (includes? msg "telemetry/forward"))))

  (test "a qualified call sidesteps the clash"
    (is (ns-loads? "(defmodule lz-q (:use sexp) (:use telemetry)) (defn f (x) (sexp/forward x x))")))

  (test ":exclude on one use makes the bare name unambiguous"
    (is (ns-loads? "(defmodule lz-x (:use sexp) (:use telemetry :exclude [forward])) (defn f (x) (forward x x))"))))

;; A package (dependency or root project) may not take a name the standard library
;; owns: its name becomes a load-time package prefix (ADR-070), so a package called
;; `http` would shadow the baked-in `http` module (or `editor` its whole group).
;; `reserved-package-name?`
;; (prelude) is the single predicate the `nest new`, `nest publish`, and load-time
;; (`require`) guards share. Here we exercise the predicate and the deepest layer:
;; `require`'s refusal of a module rooted under a reserved prefix — the layer that
;; catches a `:path`/`:git` dependency that never touched the registry.
(describe "namespaces: standard-library names are reserved (ADR-070/166)"
  :isolated (test "reserved-package-name? is true for a baked-in module (flat and group prefixes)"
    (is (reserved-package-name? 'json))
    (is (reserved-package-name? "set"))
    (is (reserved-package-name? 'http)) ; a flat net module (was net/http)
    (is (reserved-package-name? 'supervisor)) ; a flat proc-group module (std/proc/supervisor.blsp)
    (is (reserved-package-name? 'editor))) ; a group prefix — owns buffer, ui, …
  (test "reserved-package-name? is false for an ordinary package name"
    (is (not (reserved-package-name? 'myapp)))
    (is (not (reserved-package-name? "greeter"))))

  (test "requiring a package rooted under a reserved name is refused at load time"
    ;; Register a rooted module file so `require` reaches the package-load path; the
    ;; reserved-name guard fires BEFORE the file is opened, so a bogus path is fine.
    (%registry-update! '*module-files* :assoc ["set/thing"] "/nonexistent/thing.blsp")
    (let (msg (try
                (do (require-one 'set/thing) :no-error)
                (catch e (error-message e))))
      (is (includes? (str msg) "reserved"))))

  (test "an ordinary package name passes the reserved-name guard (fails only to find its file)"
    (%registry-update! '*module-files* :assoc ["greeter/thing"] "/nonexistent/thing.blsp")
    (let (msg (try
                (do (require-one 'greeter/thing) :no-error)
                (catch e (error-message e))))
      (is (not (includes? (str msg) "reserved"))))))

;; ── require by name for a CO-LOCATED module, nameless project / bare run (ADR-223) ──────
;; A module declared beside another in one file (region model, ADR-223 Phase 1) whose name is
;; not the file's is invisible to the `<name>.blsp` filename probe. A named project registers
;; it (rooted) in `*module-files*`; a nameless project or a bare `brood file.blsp` run
;; has no such registry, so `require` scans `*load-path*` for the declaring file. `:isolated`
;; so each test's `reflect/set-load-path` mutation stays on its private globals copy.
(describe "require: co-located module by name (nameless project / bare run, ADR-223)"
  :isolated (test "a module in a file whose name it does not share is require-able by name"
    (let (dir (path/temp "brood-coloc-req-"))
      (file/mkdir dir)
      (file/spit (path/join dir "combined.blsp")
        "(defmodule combined-primary)\n(defn cbase () :base)\n(defmodule combined-extra)\n(defn cextra () :extra)\n")
      (reflect/set-load-path (cons dir *load-path*))
      (require-one 'combined-extra)
      (assert= :extra (combined-extra/cextra))))
  (test "requiring one co-located module loads its file's siblings too"
    (let (dir (path/temp "brood-coloc-sib-"))
      (file/mkdir dir)
      (file/spit (path/join dir "pair.blsp")
        "(defmodule pair-a)\n(defn pa () 1)\n(defmodule pair-b)\n(defn pb () 2)\n")
      (reflect/set-load-path (cons dir *load-path*))
      (require-one 'pair-b)
      (assert= 3 (+ (pair-a/pa) (pair-b/pb)))))
  (test "two files declaring the same co-located module error loudly"
    (let (dir (path/temp "brood-coloc-dup-"))
      (file/mkdir dir)
      (file/spit (path/join dir "x.blsp") "(defmodule x-primary)\n(defmodule shared-dup)\n")
      (file/spit (path/join dir "y.blsp") "(defmodule y-primary)\n(defmodule shared-dup)\n")
      (reflect/set-load-path (cons dir *load-path*))
      (is (try
            (do (require-one 'shared-dup) false)
            (catch e (includes? (str (error-message e)) "more than one"))))))
  (test "across processes: a co-located module's produced value round-trips through send"
    (let (dir (path/temp "brood-coloc-proc-"))
      (file/mkdir dir)
      (file/spit (path/join dir "vals.blsp")
        "(defmodule vals-primary)\n(defmodule vals-extra)\n(defn payload (n) {:n n :sq (* n n)})\n")
      (reflect/set-load-path (cons dir *load-path*))
      (require-one 'vals-extra)
      (let (me (self))
        (map (range 5)
          (fn (k) (let (v (vals-extra/payload k)) (spawn (fn () (send me (get v :sq)))))))
        (let (results (fold (range 5) nil (fn (acc _) (cons (receive) acc))))
          (assert= [0 1 4 9 16] (into [] (sort results))))))))
