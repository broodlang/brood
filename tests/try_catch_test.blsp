;; Comprehensive tests for `try`/`catch`/`throw`/`error`.
;;
;; Coverage:
;;   - Basic catch and no-catch expansion
;;   - Every kernel error kind (type, arity, runtime, unbound, parse)
;;   - throw with all value shapes (string, keyword, int, vector, map, nil)
;;   - Error map structure and the error-message / error-of accessors
;;   - Multiple body forms, nested try, rethrowing
;;   - Tail-position catching (no stack growth)
;;   - Wrong-syntax guard: (try … (fn …)) → clear compile-time error
;;   - JIT / VM deopt → recoverable error (the crash-repro scenario)
;;   - GC stress: catch after GC moved the nursery

(defmodule try-catch-test (:use test))

;; ── helpers ──────────────────────────────────────────────────────────────────

(defn raises? (f)
  "Returns true if calling the zero-arg fn `f` raises any error."
  (try (f) false (catch _ true)))

(defn caught-msg (f)
  "Returns the error-message string of whatever `f` raises, or nil."
  (try (f) nil (catch e (error-message e))))

;; ── 1. Basic syntax ──────────────────────────────────────────────────────────

(describe "try / catch — basic syntax"
  (test "catch clause receives the thrown value"
    (assert= (try (throw :boom) (catch e e)) :boom))

  (test "body value returned when no error"
    (assert= (try (+ 1 2) (catch e :nope)) 3))

  (test "catch is not entered when body succeeds"
    ;; If catch were entered, result would be :nope; body value proves it wasn't.
    (assert= (try (+ 1 1) (catch _ :nope)) 2))

  (test "no catch clause — try expands to do, evaluates body"
    (assert= (try 1 2 3) 3))

  (test "single body form with no catch returns that form's value"
    (assert= (try 42) 42))

  (test "multiple body forms: error in an earlier form is caught"
    (assert= (try (throw :stop) (+ 2 2) (catch e e)) :stop))

  (test "multiple body forms: last form is the result when no error"
    (assert= (try (+ 1 1) (* 3 3) (catch _ :err)) 9))

  (test "catch body may have multiple forms; last is the result"
    (assert= (try (throw :x) (catch _ (+ 1 1) :result)) :result))

  (test "catch binding shadows outer binding of same name"
    (let (e :outer)
      (assert= (try (throw :inner) (catch e e)) :inner)
      (assert= e :outer))))

;; ── 2. throw value shapes ────────────────────────────────────────────────────

(describe "try / catch — throw value shapes"
  (test "throw a string"
    (assert= (try (throw "oops") (catch e e)) "oops"))

  (test "throw a keyword"
    (assert= (try (throw :abort) (catch e e)) :abort))

  (test "throw an integer"
    (assert= (try (throw 42) (catch e e)) 42))

  (test "throw nil"
    (assert= (try (throw nil) (catch e e)) nil))

  (test "throw a vector"
    (assert= (try (throw [:tag 1 2]) (catch e e)) [:tag 1 2]))

  (test "throw a map"
    (let (m {:a 1 :b 2})
      (assert= (try (throw m) (catch e e)) m)))

  (test "throw a list"
    (assert= (try (throw '(a b c)) (catch e e)) '(a b c)))

  (test "error function raises a string message"
    (assert= (try (error "bad " "input") (catch e e)) "bad input")))

;; ── 3. Kernel error kinds ────────────────────────────────────────────────────

(describe "try / catch — kernel error kinds"
  (test "type error is catchable"
    (is (try (+ 1 "x") false (catch _ true))))

  (test "arity error is catchable"
    (is (try ((fn (x) x) 1 2) false (catch _ true))))

  (test "runtime error (div by zero) is catchable"
    (is (try (/ 1 0) false (catch _ true))))

  (test "unbound symbol error is catchable"
    (is (try (reflect/eval 'no-such-symbol-xyz) false (catch _ true))))

  (test "parse error from reflect/read-string is catchable"
    (is (try (reflect/read-string "(1 2") false (catch _ true))))

  (test "index out of bounds is catchable"
    (is (try (seq/vector-ref [1 2 3] 99) false (catch _ true)))))

;; ── 4. Error map structure ───────────────────────────────────────────────────

(describe "try / catch — error map structure"
  (test "kernel error arrives as a map with :kind and :message"
    (let (e (try (/ 1 0) (catch e e)))
      (is (map? e))
      (is (keyword? (get e :kind)))
      (is (string? (get e :message)))))

  (test ":kind is a keyword naming the error family"
    (assert= (get (try (/ 1 0) (catch e e)) :kind) :runtime)
    (assert= (get (try (+ 1 "x") (catch e e)) :kind) :type)
    (assert= (get (try ((fn (x) x) 1 2) (catch e e)) :kind) :arity))

  (test ":message is a human-readable string"
    (assert= (get (try (/ 1 0) (catch e e)) :message) "division by zero"))

  (test "throw passes the value through unchanged (not wrapped in a map)"
    (assert= (try (throw :raw) (catch e e)) :raw)
    (assert= (try (throw "msg") (catch e e)) "msg")
    (refute (map? (try (throw :x) (catch e e))))))

;; ── 5. error-message and error-of ───────────────────────────────────────────

(describe "error-message"
  (test "kernel error map → :message field"
    (assert= (try (/ 1 0) (catch e (error-message e))) "division by zero")
    (assert= (try (+ 1 "x") (catch e (error-message e)))
      "+: expected number, got string (\"x\")"))

  (test "a raised string is returned as-is"
    (assert= (try (error "plain") (catch e (error-message e))) "plain"))

  (test "a raised keyword is pr-str'd"
    (assert= (try (throw :boom) (catch e (error-message e))) ":boom"))

  (test "a raised vector is pr-str'd"
    (assert= (try (throw [:tag 1]) (catch e (error-message e))) "[:tag 1]"))

  (test "nil thrown → pr-str of nil"
    (assert= (try (throw nil) (catch e (error-message e))) "nil")))

(describe "error-of"
  (test "returns nil when no error"
    (assert= (error-of (+ 1 2)) nil))

  (test "returns rendered error string on failure"
    (assert= (error-of (/ 1 0)) "runtime error: division by zero"))

  (test "type error names the op, the expected type, and the value"
    (assert= (error-of (+ 1 "x")) "type error: +: expected number, got string (\"x\")")
    (assert= (error-of (first 5))
      "type error: first: expected list, vector, set, map or bytes, got int (5)"))

  (test "throw value is returned verbatim"
    (assert= (error-of (throw :boom)) :boom)
    (assert= (error-of (throw 99)) 99)))

;; ── 6. Nested try and rethrowing ─────────────────────────────────────────────

(describe "try / catch — nested and rethrow"
  (test "inner catch handles its own error; outer sees nothing"
    ;; If outer catch fired, result would be :outer; inner handling gives :handled.
    (assert= (try
               (check-allow :discarded-catch (try (throw :inner) (catch _ :handled)))
               (catch _ :outer))
      :handled))

  (test "outer catch handles error that escapes inner"
    (assert= (try (try (throw :escapes) (catch e (throw e))) (catch e e))
      :escapes))

  (test "rethrowing inside catch propagates to the next handler"
    (assert= (try (try (throw :original) (catch e (throw :rethrown))) (catch e e))
      :rethrown))

  (test "try can be nested three levels deep"
    (assert= (try
               (try
                 (try (throw :deep) (catch e (throw :level2)))
                 (catch e (throw :level3)))
               (catch e e))
      :level3))

  (test "a catch handler that itself throws is caught by the next outer try"
    (assert= (try (try (/ 1 0) (catch _ (error "handler-boom"))) (catch e (error-message e)))
      "handler-boom")))

;; ── 7. try in various positions ──────────────────────────────────────────────

(describe "try / catch — usage positions"
  (test "try as a let binding"
    (let (v (try (throw :x) (catch e e)))
      (assert= v :x)))

  (test "try as the condition of if"
    (assert= (if (try (throw :x) false (catch _ true)) :yes :no)
      :yes))

  (test "try as function argument"
    (assert= (str (try (throw :x) (catch e e))) ":x"))

  (test "try in tail position of a function"
    ;; try bodies compile non-tail (each level is a new frame); keep depth modest.
    (defn t-tail (n)
      (try
        (if (= n 0) (throw :done) (t-tail (- n 1)))
        (catch e e)))
    (assert= (t-tail 50) :done))

  (test "try wrapping a deep TAIL-recursive function does not overflow"
    ;; t-loop itself is tail-recursive; the try wrapper adds only one frame.
    (defn t-loop (n)
      (if (= n 0) :ok (t-loop (- n 1))))
    (assert= (try (t-loop 50000) (catch _ :error)) :ok)))

;; ── 8. Wrong-syntax guard ────────────────────────────────────────────────────

(describe "try / catch — wrong syntax gives a clear error"
  (test "(try body (fn (e) handler)) raises a clear compile error"
    ;; Using eval + a quoted form forces macro expansion at runtime, so
    ;; error-of can intercept the compile-time error.
    (let (msg (error-of (reflect/eval '(try (+ 1 2) (fn (e) :caught)))))
      (is (string? msg))
      (is (includes? msg "try:"))
      (is (includes? msg "(catch"))))

  (test "error message names the fn form that was passed"
    (let (msg (error-of (reflect/eval '(try (+ 1 2) (fn (x) (* x 2))))))
      (is (includes? msg "(fn"))))

  (test "error message suggests the right param name from the fn"
    (let (msg (error-of (reflect/eval '(try (throw :x) (fn (err) err)))))
      (is (includes? msg "err"))))

  (test "correct syntax (catch e ...) does NOT trigger the guard"
    (assert= (try (throw :ok) (catch e e)) :ok))

  (test "(try body) with no catch still works — no guard fires"
    (assert= (try (+ 1 2)) 3)))

;; ── 9. JIT / VM deopt → recoverable error ────────────────────────────────────
;;
;; Regression: before the fix in e000652 the stale-LOCAL-handle bug caused these
;; to CRASH (panicked at heap.rs) instead of raising a catchable Brood error.
;; Now they must raise a clean type error that try/catch intercepts.

(describe "try / catch — JIT / VM deopt recovery"
  :serial
  ;; Helper: a function compiled by the VM/JIT for integer operands.
  ;; When called with a non-integer the JIT deopts — previously crashed.
  (defn deopt-adder (x)
    (+ x 1))

  ;; Heat the function so the JIT/VM compiles it for integers.
  (defn deopt-heat (n)
    (when (> n 0)
      (deopt-adder n)
      (deopt-heat (- n 1))))

  (test "type error from a compiled function is catchable"
    (deopt-heat 5000)
    (assert= (try (deopt-adder "not-a-number") (catch _ :caught))
      :caught))

  (test "type error from compiled function carries the right message"
    (deopt-heat 5000)
    (let (msg (caught-msg (fn () (deopt-adder "x"))))
      (is (string? msg))
      (is (includes? msg "expected number"))))

  (test "try/catch works across repeated deopt calls"
    (deopt-heat 5000)
    ;; check-allow :discarded-catch — try/catch itself is under test: the constant proves which arm ran
    (let (results (map '("a" "b" "c" 1 "d" 2)
                    (fn (v)
                      (try (deopt-adder v) (catch _ :caught)))))
      (assert= results '(:caught :caught :caught 2 :caught 3))))

  ;; Stale-handle scenario: allocate many short-lived pairs (stress the
  ;; nursery) and confirm errors are still catchable after GC moves things.
  (defn make-pairs (n acc)
    (if (= n 0) acc (make-pairs (- n 1) (cons n acc))))

  (test "error catchable even when GC ran before the deopt"
    (deopt-heat 5000)
    ; stress the nursery
    (make-pairs 500 nil)
    (assert= (try (deopt-adder :keyword) (catch _ :ok)) :ok))

  ;; Multi-arg variant: more slots means more stale-handle exposure.
  (defn deopt-mul (x y)
    (* x y))

  (defn deopt-heat-mul (n)
    (when (> n 0)
      (deopt-mul n n)
      (deopt-heat-mul (- n 1))))

  (test "two-arg compiled function deopt is catchable"
    (deopt-heat-mul 5000)
    (assert= (try (deopt-mul nil 2) (catch _ :caught)) :caught)
    (assert= (try (deopt-mul 2 "x") (catch _ :caught)) :caught)))

;; ── 10. assert-error macro ───────────────────────────────────────────────────

(describe "assert-error"
  (test "passes when the body raises"
    (assert-error (/ 1 0))
    (assert-error (throw :boom))
    (assert-error (+ 1 "x"))
    (assert-error (seq/vector-ref [] 0)))

  (test "multiple assert-error in one test"
    (assert-error (first 5))
    (assert-error (reflect/eval 'undefined-xyz-99))
    (assert-error (reflect/read-string "(("))))

;; ── 11. error stack traces (:trace) ──────────────────────────────────────────
;; A caught builtin error's map carries :trace — the call stack at the raise,
;; innermost frame first, each entry {:fn name :file f :line l :col c} with
;; absent fields omitted. Entries pair a frame's fn with the call site that
;; entered it; tail calls collapse into their caller's frame (BEAM-style).

(defn trace-inner (x) (/ x 0))
(defn trace-middle (x) (+ 1 (trace-inner x)))
(defn trace-outer () (trace-middle 41))

(defn caught-trace ()
  (try (trace-outer) (catch e (get e :trace))))

(describe "error stack traces"
  (test "innermost frame first, named by the erroring fn"
    (assert= "try-catch-test/trace-inner" (get (first (caught-trace)) :fn)))

  (test "the tail chain outer->middle collapses to one frame named middle"
    (assert= "try-catch-test/trace-middle" (get (first (rest (caught-trace))) :fn)))

  (test "the innermost entry carries its call site"
    (let (f (first (caught-trace)))
      (is (> (get f :line) 0))
      (is (> (get f :col) 0))))

  (test "trace is capped at 32 frames under deep non-tail recursion"
    (check-allow :non-tail-recursion
      (letrec (deep (fn (n) (if (= n 0) (/ 1 0) (+ 1 (deep (- n 1))))))
        (assert= 32 (count (try (deep 100) (catch e (get e :trace))))))))

  (test "a native-boundary callback frame appears by name"
    (let (names (try
                  (map [1] trace-inner)
                  (catch e (map (get e :trace) (fn (f) (get f :fn))))))
      (assert= "try-catch-test/trace-inner" (first names))))

  (test "a user throw's error still traces when uncaught payload is rethrown"
    ;; the trace rides the error object, so a catch of a *builtin* error after
    ;; frames unwound through helpers still sees them
    (assert= "try-catch-test/trace-inner"
      (get (first (try (trace-middle 1) (catch e (get e :trace)))) :fn))))

;; ── finally (ADR-306) ────────────────────────────────────────────────────────
;; `cleanup` runs whether the try completes or throws; the try's value (or the
;; escaping error) is what comes out. Order of effects is observed through a
;; process mailbox rather than a mutable cell (there is none).

(defn- finally-note (to tag)
  "Record `tag` with the observer `to`."
  (send to [:note tag]))

(defn- finally-notes (n acc)
  "Collect `n` notes, in arrival order."
  (if (= n 0)
    (reverse acc)
    (receive
      ([:note tag] (finally-notes (- n 1) (cons tag acc)))
      (after *test-wait-ms* (reverse (cons :timeout acc))))))

(defn- finally-type-error ()
  "A kernel type error raised one frame down."
  (check-allow :type-mismatch (* 2 (+ 1 "not a number"))))

(describe "try / finally"
  (test "cleanup runs after a completing body and the body's value is kept"
    (let (me (self))
      (assert= 42 (try (do (finally-note me :body) 42) (finally (finally-note me :cleanup))))
      (assert= (list :body :cleanup) (finally-notes 2 ()))))

  (test "cleanup's own value is discarded"
    (assert= :kept (try :kept (finally :discarded))))

  (test "cleanup runs when the body throws, and the same value escapes"
    (let (me (self))
      (assert= :boom
        (try
          (try (throw :boom) (finally (finally-note me :cleanup)))
          (catch e e)))
      (assert= (list :cleanup) (finally-notes 1 ()))))

  (test "with a catch: handler first, then cleanup, and the handler's value is kept"
    (let (me (self))
      (assert= :handled
        (try
          (throw :x)
          (catch _ (do (finally-note me :handler) :handled))
          (finally (finally-note me :cleanup))))
      (assert= (list :handler :cleanup) (finally-notes 2 ()))))

  (test "a throw from the handler still runs cleanup, then propagates"
    (let (me (self))
      (assert= :from-handler
        (try
          (try
            (throw :x)
            (catch _ (throw :from-handler))
            (finally (finally-note me :cleanup)))
          (catch e e)))
      (assert= (list :cleanup) (finally-notes 1 ()))))

  (test "a throw from cleanup replaces the pending error"
    (assert= :from-cleanup
      (try
        (try (throw :original) (finally (throw :from-cleanup)))
        (catch e e))))

  (test "a rethrown built-in error keeps its kind, message and trace"
    ;; raised inside a call so there is a frame between the raise and the catch
    (let (e (try
              (try (* 2 (finally-type-error)) (finally nil))
              (catch e e)))
      (assert= :type (get e :kind))
      (is (string? (get e :message)))
      (is (pair? (get e :trace)))))

  (test "nested: inner cleanup before outer cleanup"
    (let (me (self))
      (assert= :v
        (try
          (try :v (finally (finally-note me :inner)))
          (finally (finally-note me :outer))))
      (assert= (list :inner :outer) (finally-notes 2 ()))))

  (test "cleanup sees the try's lexical scope"
    (let (me (self) resource :r1)
      (try :ok (finally (finally-note me resource)))
      (assert= (list :r1) (finally-notes 1 ()))))

  (test "a crash escaping a finally in a process is the original reason"
    (let (p (spawn (try (error "worker failed") (finally nil)))
          m (monitor p))
      (assert= "worker failed"
        (receive ([:down ^m _ [:error e]] (get e :message)) (after *test-wait-ms* :timeout)))))

  (test "(finally) with no body, or not last, is a macro-time error"
    (is (raises? (fn () (reflect/eval-string "(try 1 (finally))"))))
    (is (raises? (fn () (reflect/eval-string "(try 1 (finally 2) (catch e e))"))))))

(describe "throw of an error map rebuilds the error"
  (test "the caught value is still the map thrown (throw shape == catch shape)"
    (let (original (try (finally-type-error) (catch e e))
          again (try (throw original) (catch e e)))
      (assert= (get original :kind) (get again :kind))
      (assert= (get original :message) (get again :message))))

  (test "a plain map without :kind/:message is an ordinary thrown value"
    (assert= {:a 1} (try (throw {:a 1}) (catch e e)))))

;; ---- the failure contract, asserted across every function that returns one ---------
;; ADR-310. These twelve are the whole surface; the point of the test is that they behave
;; IDENTICALLY, so a thirteenth cannot be added with a different shape and go unnoticed.
;; Each property below has already been a real bug: a nil-returning parse (the original),
;; a falsy failure silently defaulted by `(or … d)` (v0.22), and a `(refute (nil? …))`
;; assertion that went vacuous when the miss stopped being nil.

(defn- fc-bad-inputs ()
  [["string/->number" (fn () (string/->number "x"))]
    ["string/->number radix" (fn () (string/->number "zz" 16))]
    ["encoding/hex-decode" (fn () (encoding/hex-decode "zz"))]
    ["encoding/hex-decode-bytes" (fn () (encoding/hex-decode-bytes "zz"))]
    ["encoding/base64-decode" (fn () (encoding/base64-decode "!!"))]
    ["encoding/base64-decode-bytes" (fn () (encoding/base64-decode-bytes "!!"))]
    ["encoding/base64-url-decode" (fn () (encoding/base64-url-decode "!!"))]
    ["encoding/base64-url-decode-bytes" (fn () (encoding/base64-url-decode-bytes "!!"))]
    ["datetime/parse-date" (fn () (datetime/parse-date "2026-02-31"))]
    ["datetime/parse-time" (fn () (datetime/parse-time "24:00:00"))]
    ["datetime/parse-iso8601" (fn () (datetime/parse-iso8601 "nope"))]
    ["url/percent-decode" (fn () (url/percent-decode "a%ZZ"))]
    ["url/query-decode" (fn () (url/query-decode "a=%ZZ"))]])

(describe "the failure contract holds for every function that returns one"
  (test "bad input yields a failure — never nil, never a raise"
    (doseq (c (fc-bad-inputs))
      (let (r (try ((second c)) (catch e :raised)))
        (is (failure? r))
        (refute (nil? r))
        (refute (= r :raised)))))
  (test "a failure is TRUTHY, so it is never silently defaulted away"
    ;; the v0.22 defect: falsy meant `(or (parse s) 0)` swallowed it in silence
    (doseq (c (fc-bad-inputs))
      (let (r ((second c)))
        (is (if r true false))
        (assert= r (or r :never-reached))
        (assert= :reached (and r :reached)))))
  (test "every failure carries a message naming its function and the input"
    (doseq (c (fc-bad-inputs))
      (let (m (error-message ((second c))))
        (is (string? m))
        (is (> (string/length m) 0)))))
  (test "good input is unaffected — none of the above touches the happy path"
    (assert= 42 (string/->number "42"))
    (assert= 31 (string/->number "1F" 16))
    (assert= "hi" (encoding/hex-decode "6869"))
    (assert= "hi" (encoding/base64-decode "aGk="))
    (assert= "a b" (url/percent-decode "a%20b"))
    (assert= {"a" "1"} (url/query-decode "a=1"))
    (refute (failure? (datetime/parse-date "2026-08-24"))))
  (test "a failure crosses a process boundary intact"
    (let (parent (self))
      (spawn (fn () (send parent [:f (string/->number "x")])))
      (receive
        ([:f f] (do (is (failure? f)) (is (includes? (error-message f) "not a number"))))
        (after *test-wait-ms* (is false))))))
