;; std/ansi — the STREAMING decoder (`decoder` / `feed`), the SGR attribute model it shares
;; with `vt`, and `strip` rebuilt over it (ADR-567). The property that matters is the one a
;; pipe forces: output arrives in chunks the reader did not choose, so feeding a stream cut
;; at ANY position must decode exactly as feeding it whole — half an escape never shows.

(defmodule ansi-stream-test (:use test))

(defn- whole (s) (second (ansi/feed (ansi/decoder) s)))

(defn- join-segments (segments)
  "`segments` with adjacent runs of one attribute joined — what two chunks' segments are
when the cut fell inside a run."
  (reduce segments
    []
    (fn (out segment)
      (let (previous (last out))
        (if (and previous (= (second previous) (second segment)))
          (assoc out (dec (count out)) [(str (first previous) (first segment)) (second segment)])
          (conj out segment))))))

(defn- fed-in (chunks)
  "The segments of `chunks` fed one after another through one decoder."
  (second (reduce chunks
            [(ansi/decoder) []]
            (fn (state chunk)
              (let ([decoder segments] state
                    [next-decoder got] (ansi/feed decoder chunk))
                [next-decoder (into segments got)])))))

(defn- split-everywhere-agrees? (s)
  "Whether every two-way cut of `s`, and the one-character-at-a-time feed, decode as `s` whole."
  (let (expected (whole s)
        n (string/length s))
    (and (every? (range (inc n))
           (fn (i)
             (= expected
               (join-segments (fed-in [(string/substring s 0 i) (string/substring s i n)])))))
      (= expected (join-segments (fed-in (string/->list s)))))))

(def- samples
  ["\e[1mERROR\e[0m: done"
    "a\e[0;31mred\e[38;5;196mx\e[48;2;1;2;3my\e[m z" "x\e[38:2::9:8:7mtrue\e[39m"
    "pre\e]0;a title\x07post" "\e]8;;http://example.com\e\\link\e]8;;\e\\ after"
    "a\e[2K\e[1Gb\e[?25lc\e[>4;2md" "\e(Bq\e7x\e8\e=y" "é\e[1m😀\e[0mü" "\e[3\e[1mx"
    "\ePq#0;2;0;0;0\e\\after-dcs" "line one\r\n\e[32mline two\e[0m\r\n"
    "x\e[1;4:3mcurly\e[4:0m\e[58:5:1mu\e[59;38:2:1:2:3mv"])

(defn- digits (n d) (string/join (seq/repeat n d) ""))

(def- long-csi
  ;; a CSI past the 256-character cap, finished; another, aborted by a newline
  (str "a\e[" (digits 258 "1") "mX\e[" (digits 258 "2") "\nY"))

(describe "ansi/feed: one chunk"
  (test "SGR sets attributes; the text keeps no escape"
    (assert= (whole "\e[1mERROR\e[0m: done") [["ERROR" {:bold true}] [": done" nil]]))
  (test "16, 256 and true colour, and the resets"
    (assert= (whole "a\e[0;31mred\e[38;5;196mx\e[48;2;1;2;3my\e[m z")
      [["a" nil] ["red" {:fg 1}] ["x" {:fg 196}] ["y" {:fg 196 :bg [1 2 3]}] [" z" nil]])
    (assert= (whole "\e[91;44mb") [["b" {:fg 9 :bg 4}]])
    (assert= (whole "\e[3;4mi\e[23mu\e[24mn")
      [["i" {:italic true :underline true}] ["u" {:underline true}] ["n" nil]]))
  (test "OSC titles and hyperlinks are consumed, by BEL or by ESC backslash"
    (assert= (whole "pre\e]0;a title\x07post") [["prepost" nil]])
    (assert= (whole "\e]8;;http://example.com\e\\link\e]8;;\e\\ after") [["link after" nil]]))
  (test "cursor, erase, private and charset sequences are consumed, not shown"
    (assert= (whole "a\e[2K\e[1Gb\e[?25lc\e[>4;2md") [["abcd" nil]])
    (assert= (whole "\e(Bq\e7x\e8\e=y") [["qxy" nil]])
    (assert= (whole "\ePq#0;2;0;0;0\e\\after-dcs") [["after-dcs" nil]]))
  (test "an ESC inside a CSI cancels it; the new sequence counts"
    (assert= (whole "\e[3\e[1mx") [["x" {:bold true}]]))
  (test "control characters stay in the text for the caller"
    (assert= (whole "a\rb\n") [["a\rb\n" nil]]))
  (test "UTF-8 around the escapes is kept whole"
    (assert= (whole "é\e[1m😀\e[0mü") [["é" nil] ["😀" {:bold true}] ["ü" nil]]))
  (test "plain text is one segment in the current attribute"
    (let ([decoder _] (ansi/feed (ansi/decoder) "\e[32m"))
      (assert= (second (ansi/feed decoder "plain")) [["plain" {:fg 2}]])))
  (test "empty input decodes to nothing"
    (assert= (whole "") [])))

(describe "ansi/feed: a stream cut anywhere"
  (test "every two-way cut, and one character at a time, decodes as the whole"
    (doseq (s samples) (assert= [s (split-everywhere-agrees? s)] [s true])))
  (test "an over-long CSI agrees too, cut anywhere"
    (assert= (whole long-csi) [["aX\nY" nil]])
    (doseq (s (string/split long-csi "X")) (assert (split-everywhere-agrees? s))))
  (test "a CSI past the cap is swallowed through its final byte, chunks later"
    (let ([d1 g1] (ansi/feed (ansi/decoder) (str "a\e[" (digits 200 "1")))
          [d2 g2] (ansi/feed d1 (digits 200 "1"))
          [d3 g3] (ansi/feed d2 (digits 50 "1"))
          [_ g4] (ansi/feed d3 "mX"))
      (assert= [g1 g2 g3 g4] [[["a" nil]] [] [] [["X" nil]]])
      ;; swallowed, not held: nothing of it waits in the decoder
      (assert= [(:pending d2) (:inside d2)] ["" :csi])))
  (test "a swallowed CSI is ended by a control character, or cancelled by an ESC"
    (let ([d _] (ansi/feed (ansi/decoder) (str "\e[" (digits 300 "1"))))
      (assert= (second (ansi/feed d "\nX")) [["\nX" nil]])
      (assert= (second (ansi/feed d "\e[1mY")) [["Y" {:bold true}]])))
  (test "the half of an escape a chunk ends inside is held, never shown"
    (let ([decoder got] (ansi/feed (ansi/decoder) "ok \e[1"))
      (assert= got [["ok " nil]])
      (assert= (second (ansi/feed decoder "mERROR")) [["ERROR" {:bold true}]])))
  (test "an OSC string open at a chunk's end swallows its content until the terminator"
    (let ([d1 g1] (ansi/feed (ansi/decoder) "a\e]0;long ti")
          [d2 g2] (ansi/feed d1 "tle still")
          [d3 g3] (ansi/feed d2 "\e")
          [_ g4] (ansi/feed d3 "\\b"))
      (assert= [g1 g2 g3 g4] [[["a" nil]] [] [] [["b" nil]]])
      ;; the string's content is discarded as it comes, not kept pending
      (assert= (:pending d2) "")))
  (test "attributes carry from one chunk to the next"
    (assert= (fed-in ["\e[31mred " "still red\e[0m plain"])
      [["red " {:fg 1}] ["still red" {:fg 1}] [" plain" nil]])))

(describe "ansi/segments-text and ansi/segments-spans"
  (test "the text, and the spans at an offset"
    (let (segments (whole "a\e[1mbc\e[0md\e[4me"))
      (assert= (ansi/segments-text segments) "abcde")
      (assert= (ansi/segments-spans segments 5) [[6 8 {:bold true}] [9 10 {:underline true}]]))))

(describe "ansi/sgr and the colours"
  (test "22 clears bold and dim together; 39 / 49 the colours"
    (assert= (ansi/sgr {:bold true :dim true :fg 3 :bg 4} [22 39]) {:bg 4})
    (assert= (ansi/sgr {:bg 4} [49]) nil))
  (test "an empty parameter reads as 0, a reset"
    (assert= (ansi/sgr {:fg 1} (ansi/params ";1")) {:bold true}))
  (test "the cube and the grey ramp"
    (assert= (ansi/color 196 ansi/xterm-palette) [255 0 0])
    (assert= (ansi/color 232 ansi/xterm-palette) [8 8 8])
    (assert= (ansi/color 16 ["#000000"]) [0 0 0]))
  (test "a face resolves indexes through the caller's palette"
    (assert= (ansi/face {:fg 1 :underline true} {:colors (into [] (seq/repeat 16 "#123456"))})
      {:fg "#123456" :underline true}))
  (test "a face resolves the underline colour, and passes its style through"
    (assert= (ansi/face {:underline true :underline-style :curly :underline-color 1} nil)
      {:underline true :underline-style :curly :underline-color [205 0 0]})))

(describe "ansi: colon sub-parameters (ECMA-48 / ITU T.416)"
  (test "params keeps a `:` group together as one parameter"
    (assert= (ansi/params "4:3") [[4 3]])
    (assert= (ansi/params "1;38:2::9:8:7;4") [1 [38 2 nil 9 8 7] 4]))
  (test "4:n is the underline style, and is never italic"
    (assert= (whole "\e[4:3mc") [["c" {:underline true :underline-style :curly}]])
    (assert= (ansi/sgr nil [[4 2]]) {:underline true :underline-style :double})
    (assert= (ansi/sgr nil [[4 4]]) {:underline true :underline-style :dotted})
    (assert= (ansi/sgr nil [[4 5]]) {:underline true :underline-style :dashed})
    (assert= (ansi/sgr {:underline true :underline-style :curly} [[4 1]]) {:underline true}))
  (test "4:0 clears only the underline, not the rest"
    (assert= (whole "\e[1;31;4:3mx\e[4:0my")
      [["x" {:bold true :fg 1 :underline true :underline-style :curly}] ["y" {:bold true :fg 1}]]))
  (test "a plain 4 is single, and 24 clears the style too"
    (assert= (ansi/sgr {:underline true :underline-style :curly} [4]) {:underline true})
    (assert= (ansi/sgr {:bold true :underline true :underline-style :curly} [24]) {:bold true}))
  (test "38 / 48 colours with and without the colour-space id"
    (assert= (ansi/sgr nil (ansi/params "38:2::1:2:3")) {:fg [1 2 3]})
    (assert= (ansi/sgr nil (ansi/params "38:2:1:2:3")) {:fg [1 2 3]})
    (assert= (ansi/sgr nil (ansi/params "38:5:196")) {:fg 196})
    (assert= (ansi/sgr nil (ansi/params "48:2::9:8:7;48:5:4")) {:bg 4}))
  (test "58 is the underline colour in either spelling; 59 resets it"
    (assert= (ansi/sgr nil (ansi/params "58:2::1:2:3")) {:underline-color [1 2 3]})
    (assert= (ansi/sgr nil (ansi/params "58;5;9")) {:underline-color 9})
    (assert= (ansi/sgr {:underline-color 9 :bold true} [59]) {:bold true}))
  (test "an unknown group, or an unreadable one, changes nothing"
    (assert= (ansi/sgr {:fg 1} (ansi/params "4:9")) {:fg 1})
    (assert= (ansi/sgr {:fg 1} (ansi/params "38:7:1")) {:fg 1})
    (assert= (ansi/sgr {:fg 1} (ansi/params "38:5")) {:fg 1})
    (assert= (ansi/sgr nil (ansi/params "1:2;3")) {:italic true})))

(describe "ansi/strip over the decoder"
  (test "an OSC title is removed whole — its text never leaks"
    (assert= (ansi/strip "a\e]2;title\x07b") "ab"))
  (test "carriage returns still go"
    (assert= (ansi/strip "\e[1mx\r\n\e[0m") "x\n"))
  (test "strip's own scan keeps exactly the text the decoder keeps"
    (doseq (s (conj samples long-csi))
      (assert= [s (ansi/strip s)]
        [s (string/replace (ansi/segments-text (whole s)) "\r" "")])))
  (test "an over-long CSI never leaks its tail"
    (assert= (ansi/strip long-csi) "aX\nY")))

(describe "ansi/render: strings"
  (test "an OSC title is dropped through its terminator, not shown"
    (assert= (ansi/render "" "a\e]0;a title\x07b") "ab")
    (assert= (ansi/render "" "a\e]8;;http://x\e\\link") "alink")))
