;;; The startup image (ADR-218): a project starts by restoring bindings from a binary
;;; artifact instead of re-evaluating its sources, and does it **per module, on demand**.
;;;
;;; The load-bearing property is not speed — it is that an imaged start is
;;; INDISTINGUISHABLE from a source start. The image defines exactly the globals a source
;;; load would have, so `def`, hot reload and late binding must behave identically
;;; afterwards; a process running since before a redefinition must still observe it. Those
;;; are the cases here. Speed is measured in the devlog and never asserted — a wall-clock
;;; assertion would be flaky on a loaded CI box.
;;;
;;; `:isolated` because these `def` globals they also assert on, so a second run in one
;;; image (`--repeat-until-failure`, `nest test --failed`) would otherwise start from the
;;; redefined state (KI-25).

(defmodule startup-image-test (:use test))

(defn- img-tmp (n) (path-join "/tmp" (str "brood-startup-image-" n ".bin")))

;; A worker that re-reads the global on every request — the late-binding contract.
(defn si-worker ()
  (receive
    ([:ask from] (do (send from [:got (si-greet)]) (si-worker)))
    ([:stop] :ok)))

(defn si-ask (w)
  (send w [:ask (self)])
  (receive ([:got v] v)))

;; Load every section an index names — the whole-image restore expressed in terms of the
;; sectioned primitives, which is what a tool wanting the entire project in the heap does.
(defn- si-load-all
  (path idx)
  (fold (fn (acc k)
          (let (sec (get idx k))
            (+ acc (or (%image-load-section path (first sec) (second sec)) 0))))
    0
    (keys idx)))

(describe "startup image: write and restore"
  :isolated

  (test "a written image restores the values it captured"
    (def si-a 41)
    (def si-f (fn (x) (+ x 1)))
    (let (p (img-tmp "basic"))
      (%image-write p [["" ['startup-image-test/si-a 'startup-image-test/si-f]]] "fp1")
      (def si-a :clobbered)
      (def si-f (fn (_) :clobbered))
      (assert= :clobbered si-a)
      (let (idx (%image-index p "fp1"))
        (is (map? idx))
        (si-load-all p idx))
      (assert= 41 si-a)
      (assert= 6 (si-f 5))))

  ;; A `defdyn` var written into an image (v5) must open without error and stay a *dynamic* var:
  ;; `binding` on it must work, not raise "not a dynamic variable". The dynamic mark lives in a
  ;; process-wide static that an imaged start would otherwise miss (it skips the module load that
  ;; ran the `defdyn`), so the image records the dynamic-var names and `%image-index` re-marks
  ;; them. This guards the v5 format round-trip; the cross-run behavioural guard is that the hatch
  ;; suite (which images `*bml-source*`) stopped flaking on repeat imaged runs — cold pass then
  ;; 38 imaged failures → all green. (An in-process test can't remove the mark to prove the
  ;; restore in isolation: the set is monotonic.)
  (test "a defdyn var images (v5) and stays dynamic — binding works after open"
    (defdyn *si-dyn* :seed)
    (let (p (img-tmp "dynvar"))
      (%image-write p [["" ['startup-image-test/*si-dyn*]]] "fp-dyn")
      (is (map? (%image-index p "fp-dyn")))
      (assert= :bound (binding (*si-dyn* :bound) *si-dyn*))))

  ;; A stale image must be a MISS, not an error and not a wrong restore — the caller's
  ;; entire recovery strategy is "nil means load from source instead".
  (test "a fingerprint mismatch is a miss, not an error"
    (def si-b 7)
    (let (p (img-tmp "stale"))
      (%image-write p [["" ['startup-image-test/si-b]]] "fp-written")
      (def si-b 8)
      (is (nil? (%image-index p "fp-DIFFERENT")))
      (assert= 8 si-b)))

  (test "an absent or corrupt image is a miss"
    (is (nil? (%image-index (img-tmp "no-such-file-at-all") "fp")))
    (let (p (img-tmp "corrupt"))
      (file/spit p "this is not a brood image")
      (is (nil? (%image-index p "fp")))))

  ;; The point of sectioning: a module materialises on its own, and loading one section
  ;; must not drag in the rest. This is what lets an imaged `nest run` pay only for the
  ;; modules its entry point actually reaches.
  (test "one section can be loaded without the others"
    (def si-p 1)
    (def si-q 2)
    (let (path (img-tmp "sections"))
      (%image-write path
        [["" nil]
          ["secp" ['startup-image-test/si-p]]
          ["secq" ['startup-image-test/si-q]]]
        "fp-sec")
      (def si-p :clobbered)
      (def si-q :clobbered)
      (let (idx (%image-index path "fp-sec")
            p-sec (get idx "secp"))
        (assert= 1 (%image-load-section path (first p-sec) (second p-sec)))
        (assert= 1 si-p)
        ;; the OTHER section was not touched
        (assert= :clobbered si-q))))

  ;; `to_message` refuses a macro — sending one to another process is meaningless. An
  ;; image is the opposite case, so a macro rides as its closure plus a kind tag. If that
  ;; regressed, a project's `defmacro`s would come back as plain functions and every call
  ;; site would silently start evaluating its arguments.
  (test "a macro survives the round trip as a macro"
    (defmacro si-twice (e) (list 'do e e))
    (let (p (img-tmp "macro"))
      (%image-write p [["" ['startup-image-test/si-twice]]] "fp-m")
      (def si-twice :clobbered)
      (let (idx (%image-index p "fp-m")) (si-load-all p idx))
      ;; The property a function cannot have: the call site EXPANDS. If the round trip had
      ;; returned a plain closure, macroexpand would leave the form untouched.
      (assert= '(do 1 1) (macroexpand '(startup-image-test/si-twice 1)))))

  ;; A user `(sig …)` lives in `RuntimeCode::declared_sigs`, NOT in the globals table, so
  ;; an image that snapshotted only globals lost every one and the checker quietly fell
  ;; back to inferring from the body — `expects int` became `expects number | map`. Weaker
  ;; advice with no error, which is why this is pinned. Sigs ride in the root section.
  (test "a declared sig survives the round trip"
    (defn si-typed (n) (+ n 1))
    (%register-sig 'startup-image-test/si-typed '(int -> int))
    (let (p (img-tmp "sig"))
      (%image-write p [["" ['startup-image-test/si-typed]]] "fp-s")
      (%register-sig 'startup-image-test/si-typed '(string -> string))
      (assert= "(string) -> string" (type-signature 'startup-image-test/si-typed))
      (let (idx (%image-index p "fp-s")) (si-load-all p idx))
      (assert= "(int) -> int" (type-signature 'startup-image-test/si-typed))))

  ;; The whole point: an imaged start must not freeze the image.
  (test "hot reload still works after restoring from an image"
    (def si-greet (fn () "v1"))
    (let (p (img-tmp "reload"))
      (%image-write p [["" ['startup-image-test/si-greet]]] "fp-r")
      (def si-greet (fn () :clobbered))
      (let (idx (%image-index p "fp-r")) (si-load-all p idx))
      (assert= "v1" (si-greet))
      (let (w (spawn (si-worker)))
        (assert= "v1" (si-ask w))
        (def si-greet (fn () "v2-hot"))
        (assert= "v2-hot" (si-greet))
        ;; the ALREADY-RUNNING process must observe the new binding
        (assert= "v2-hot" (si-ask w))
        (send w [:stop]))))

  ;; Line coverage instruments at COMPILE time, so code restored from an image was never
  ;; compiled in this process and carries no instrumentation — the report would come back
  ;; silently empty. The loader must therefore decline the image under `BROOD_COVERAGE`.
  ;; Found by `nest::coverage_lines` failing, not by reasoning, which is why it is pinned.
  (test "an instrumented run declines the image"
    (is (nil? (os/getenv "BROOD_COVERAGE")))
    (is (project/image-usable?))))

;; Values a cross-process MESSAGE cannot carry — a builtin (a Rust primitive with no data
;; form) and a raw-bytes literal — can still be IMAGED, because the image restores bindings in
;; the same, binary-keyed runtime: a builtin travels by the name it is bound to and re-resolves
;; on read, and bytes copy inline. Without this a single such global forfeits the whole image
;; (found via bedit: `std/editor/ui`'s `*term-display*` is a map of `term-*` prims, and a
;; `#b"…"` literal sits in a function body). Guarded here at the primitive level.
(describe "startup image: builtins by name, bytes inline"
  :isolated

  (test "a global bound to a builtin restores as the callable primitive"
    (def si-prim string/length) ; :native — no portable data form
    (let (p (img-tmp "prim"))
      (%image-write p [["" ['startup-image-test/si-prim]]] "fp-prim")
      (def si-prim :clobbered)
      (let (idx (%image-index p "fp-prim")) (si-load-all p idx))
      (assert= 4 (si-prim "abcd")))) ; re-resolved to the real primitive, by name
  (test "a map of builtins round-trips (the *term-display* display-map shape)"
    (def si-display {:len string/length :up string/upper})
    (let (p (img-tmp "display"))
      (%image-write p [["" ['startup-image-test/si-display]]] "fp-display")
      (def si-display :clobbered)
      (let (idx (%image-index p "fp-display")) (si-load-all p idx))
      (assert= 4 ((get si-display :len) "abcd"))
      (assert= "OK" ((get si-display :up) "ok"))))

  (test "a bytes value round-trips inline"
    (def si-bytes #b"hi\x00\xffthere")
    (let (original si-bytes
          p (img-tmp "bytes"))
      (%image-write p [["" ['startup-image-test/si-bytes]]] "fp-bytes")
      (def si-bytes :clobbered)
      (let (idx (%image-index p "fp-bytes")) (si-load-all p idx))
      (is (bytes? si-bytes))
      (is (= original si-bytes))))

  (test "a closure whose body holds a bytes literal round-trips (web-handle-input shape)"
    (def si-body (fn () #b"\x00payload"))
    (let (p (img-tmp "body"))
      (%image-write p [["" ['startup-image-test/si-body]]] "fp-body")
      (def si-body :clobbered)
      (let (idx (%image-index p "fp-body")) (si-load-all p idx))
      (is (= #b"\x00payload" (si-body))))))

;; A `table` global used to make `%image-write` raise, which forfeited the image for the
;; WHOLE project — so any app holding shared state the blessed way (ADR-026/107: a table
;; is the language's only mutable structure) silently lost imaged startup. Reproduced on
;; hatch, whose `web/static` caches a fingerprint manifest and ETags in two tables.
;;
;; A table handle is per-runtime and cannot be carried, so the image stores the table's
;; CONTENTS and rebuilds a fresh table on restore. What has to hold: the global is bound
;; to a live, writable table, and whatever load-time code put in it is still there.
(describe "startup image: table globals"
  :isolated

  (test "a table global restores as a live, writable table"
    (def si-tab (table/new))
    (let (p (img-tmp "table"))
      (%image-write p [["" ['startup-image-test/si-tab]]] "fp-table")
      (def si-tab :clobbered)
      (let (idx (%image-index p "fp-table")) (si-load-all p idx))
      (assert= :table (type-of si-tab))
      ;; writable, not a frozen snapshot masquerading as one
      (table/put si-tab :k 7)
      (assert= 7 (table/get si-tab :k))))

  (test "a table's load-time CONTENTS survive the round-trip"
    (def si-tab2 (table/new))
    (table/put si-tab2 :a 1)
    (table/put si-tab2 "b" [2 3])
    (let (p (img-tmp "table2"))
      (%image-write p [["" ['startup-image-test/si-tab2]]] "fp-table2")
      (def si-tab2 :clobbered)
      (let (idx (%image-index p "fp-table2")) (si-load-all p idx))
      (assert= 1 (table/get si-tab2 :a))
      (assert= [2 3] (table/get si-tab2 "b"))
      (assert= 2 (table/count si-tab2))))

  (test "the restored table is a FRESH store — writing it does not touch the original"
    (def si-tab3 (table/new))
    (table/put si-tab3 :n 1)
    (let (original si-tab3
          p (img-tmp "table3"))
      (%image-write p [["" ['startup-image-test/si-tab3]]] "fp-table3")
      (def si-tab3 :clobbered)
      (let (idx (%image-index p "fp-table3")) (si-load-all p idx))
      (table/put si-tab3 :n 99)
      ;; the pre-image handle still reads its own store
      (assert= 1 (table/get original :n))
      (assert= 99 (table/get si-tab3 :n))))

  (test "two globals aliasing ONE table are refused, not silently split"
    (def si-alias-a (table/new))
    (def si-alias-b si-alias-a)
    (let (p (img-tmp "table-alias")
          r (try
              (do
                (%image-write p
                  [["" ['startup-image-test/si-alias-a 'startup-image-test/si-alias-b]]]
                  "fp-alias")
                :no-raise)
              (catch e (error-message e))))
      (is (not (= r :no-raise)))
      (is (includes? r "same table")))))
