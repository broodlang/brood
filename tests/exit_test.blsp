;; `(exit pid reason)` — Erlang-style exit signals (ADR-063). `:kill` is the
;; untrappable hard kill (caught at the reduction tick, so it stops even a tight
;; CPU loop that never receives); any other reason is the soft signal (the target
;; dies at its next `receive`). A parked process is killed directly; an already-dead
;; pid is a no-op. Monitors fire `[:down ref pid reason]` carrying the exit reason.
;;
;; Register-only — discovered and run by `nest test` (and cargo test). Each test is
;; its own green process, so spawn/monitor/exit/receive here exercise the signal
;; across the worker pool; the final :isolated block mass-kills to stress the
;; force-unwind-on-drop path concurrently.

(defmodule exit-test (:use test))

;; file-local worker bodies (tail-recursive: a test runs in a small-stack green proc)
; tight CPU loop — only a hard :kill (preempt) catches it
(defn ex-spin () (ex-spin))
; parks forever on an empty mailbox
(defn ex-park () (receive (x x)))
; a receive loop (one iteration per message)
(defn ex-echo () (receive (m (ex-echo))))
;; native-nested receives — a `receive` reached through a native frame (`try`/HOF), so
;; it BLOCKS the worker on the mailbox condvar instead of capturing (§7.4). An exit must
;; still reach it (unwind with `Control::Kill`); the `catch` must NOT swallow the signal.
(defn ex-park-try () (try (receive (x x)) (catch e :caught)))
(defn ex-park-map () (map [1] (fn (_) (receive (x x)))))

(defn ex-down-reason (p m)
  ; wait for p's :down, return its reason. Liveness — every caller asserts a real
  ; reason (p IS killed/returns), so block rather than bound it with a wall-clock
  ; (after …) that fires early under load; the runner's per-test watchdog is the
  ; hang-guard if a real regression ever leaves p alive.
  (receive ([:down ^m ^p r] r)))

(describe "exit / kill signals"
  (test "hard :kill stops a tight CPU loop (caught at the reduction tick)"
    (let (p (spawn (ex-spin)) m (monitor p))
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill)))

  (test "exit kills a process parked in receive, with its reason"
    (let (p (spawn (ex-park)) m (monitor p))
      ; let it park
      (sleep 30)
      (exit p :stopped)
      (assert= (ex-down-reason p m) :stopped)))

  (test "soft exit stops a receive loop at its next iteration"
    (let (p (spawn (ex-echo)) m (monitor p))
      (sleep 30)
      ; one iteration
      (send p :ping)
      ; soft — dies at the next receive
      (exit p :done)
      (assert= (ex-down-reason p m) :done)))

  (test "exit of an already-dead pid is a harmless no-op"
    (let (p (spawn (ex-park)) m (monitor p))
      (sleep 30)
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill)
      ; already dead — must not error or hang
      (exit p :kill)
      (is true))))

(describe "exit reaches a native-nested receive (the worker-block path)"
  ;; The reason arriving as the :down (not :normal, not :caught) proves the exit
  ;; reached the blocked receive AND the enclosing `catch` did not swallow it.
  (test "hard :kill reaches a receive nested in try"
    (let (p (spawn (ex-park-try)) m (monitor p))
      (sleep 30)
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill)))
  (test "soft exit reaches a receive nested in try, with its reason (catch does not run)"
    (let (p (spawn (ex-park-try)) m (monitor p))
      (sleep 30)
      (exit p :shutdown)
      (assert= (ex-down-reason p m) :shutdown)))
  (test "hard :kill reaches a receive nested in a HOF callback"
    (let (p (spawn (ex-park-map)) m (monitor p))
      (sleep 30)
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill))))

;; ---- kill inside a nested eval ------------------------------------------------
;; A process spinning inside `reflect/eval` / `reflect/eval-string` runs on the NON-capturing eval
;; paths (the tree-walker and nested VM runs behind the native frame), whose
;; reduction tick was once pure accounting — so a hard `:kill` latched its flag and
;; was never honoured: the direct-call spin above died while the identical loop
;; under `reflect/eval-string` survived forever (found 2026-07-28 wiring REPL Ctrl-C, which
;; evaluates everything through `reflect/eval-string`). Now every eval path checks the flag
;; at its reduction rollover (`tick_reporting_hard_kill`) and unwinds with the
;; untrappable kill signal. These pin each route separately, plus the two properties
;; that make the REPL usable: the kill stays untrappable through `try`, and a soft
;; exit still waits for a `receive` even inside `reflect/eval`.

; the same tight loop, but entered through the reader + evaluator. QUALIFIED name in
; the source text: a string reaches `reflect/eval-string` after this module's compile-time
; namespace qualification, so a bare `ex-spin` would be unbound at runtime.
(defn ex-spin-eval-string () (reflect/eval-string "(exit-test/ex-spin)"))
(defn ex-spin-eval-form () (reflect/eval (reflect/read-first "(exit-test/ex-spin)")))
; `try` around the eval'd spin — the kill must NOT surface as a catchable error
;; check-allow :discarded-catch — a did-it-throw assertion: the caught error is the answer
(defn ex-spin-eval-try ()
  (try (reflect/eval-string "(exit-test/ex-spin)") (catch e :caught)))

(describe "exit reaches a nested eval (the non-capturing paths)"
  (test "hard :kill stops a tight loop inside eval-string"
    (let (p (spawn (ex-spin-eval-string)) m (monitor p))
      (sleep 30)
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill)))
  (test "hard :kill stops a tight loop inside (reflect/eval (reflect/read-first …))"
    (let (p (spawn (ex-spin-eval-form)) m (monitor p))
      (sleep 30)
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill)))
  (test "the kill is untrappable through a try around the eval"
    (let (p (spawn (ex-spin-eval-try)) m (monitor p))
      (sleep 30)
      (exit p :kill)
      ; :kill, not :normal — a catch that swallowed the signal would return :caught
      ; and the process would die :normal
      (assert= (ex-down-reason p m) :kill)))
  (test "a soft exit is still deferred inside eval (no receive => still running)"
    (let (p (spawn (ex-spin-eval-string)) m (monitor p))
      (sleep 30)
      (exit p :polite)
      ; the soft signal must NOT stop a spinning eval — only a hard :kill may
      (assert= (receive ([:down ^m ^p r] [:died r]) (after 300 :still-running))
        :still-running)
      ; clean up with the hard kill (also re-proves it lands after the soft latch)
      (exit p :kill)
      (assert= (ex-down-reason p m) :kill))))

;; ---- mass force-unwind: kill many parked processes concurrently --------------
(defn ex-spawn-parked (n acc)
  (if (= n 0)
    acc
    (let (p (spawn (ex-park)) _m (monitor p)) (ex-spawn-parked (- n 1) (cons p acc)))))
(defn ex-kill-all (ps)
  (if (empty? ps) nil (do (exit (first ps) :bye) (ex-kill-all (rest ps)))))
(defn ex-collect-downs (k)
  ; tail-recursive via the receive trampoline
  (if (= k 0) :all-down (receive ([:down a b c] (ex-collect-downs (- k 1))))))

(describe "exit under load"
  :isolated (test "mass kill: spawn 100 parked processes, exit all, collect every :down"
    (let (n 100 ps (ex-spawn-parked n nil))
      ; let them all park
      (sleep 50)
      (ex-kill-all ps)
      (assert= (ex-collect-downs n) :all-down))))
