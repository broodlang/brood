;; std/editor/treesit.blsp (ROADMAP §C): the language-agnostic services over
;; `tree-sitter-parse`'s positioned CST — `fontify` (kind→face colour spans) and
;; the pure structural motions. Requires `editor/highlight` for the shared
;; `:syntax/*` face registry (the editor always loads it).
;;
;; Register-only — discovered and run by `nest test` (and `brood --test`).

(defmodule treesit-module-test
  (:use test)
  (:use editor/treesit))

;; `editor/highlight` must be loaded for effect — it registers the `:syntax/*`
;; faces the fontify comparisons below resolve against. The file references none
;; of its names, so name one export to auto-require the module at load time; the
;; value is discarded.
(def tsm-highlight-loaded? (fn? editor/highlight/highlight-spans))

;; The ruby/elixir grammars are opt-in (--features treesit-grammars); the kernel
;; ships none by default. Skip these suites when absent so a bare `cargo test`
;; stays green — `make test` builds them in and runs them.
(defn tsm-grammar? (lang)
  ;; check-allow :discarded-catch — probing whether a grammar is compiled in: the error is the answer
  (check-allow :discarded-catch (try (do (%tree-sitter-parse "" lang) true) (catch _ false))))
(def tsm-grammars? (and (tsm-grammar? :ruby) (tsm-grammar? :elixir)))

;; A small Ruby method, used across the navigation tests. Offsets:
;;   0       8         18  22
;;   def foo\n  x = 1\nend\n
(def rb "def foo\n  x = 1\nend\n")

(def rb-faces
  {:comment :syntax/comment
   :string :syntax/string
   :integer :syntax/number
   :def :syntax/keyword
   :end :syntax/keyword
   :identifier :syntax/function})

; end (when tsm-grammars? …) — grammar-dependent suites
(when tsm-grammars?

  ; named ⇒ not a keyword
  (describe "treesit fontify"
    (test "produces ascending, non-overlapping [start end face] spans"
      (let (spans (editor/treesit/fontify rb :ruby rb-faces false))
        (is (not (empty? spans)))
        ;; every span is [start end face] with start < end, and starts ascend
        (is (every? spans (fn (s) (< (first s) (second s)))))
        (is (= spans (seq/sort-by spans first)))))

    (test "colours a whole comment node (delimiter + content) as one span"
      (let (src "x = 1 # note\n"
            spans (editor/treesit/fontify src :ruby rb-faces false)
            cspan (first (seq/filter spans
                           (fn (s) (= (nth s 2) (editor/face/face :syntax/comment))))))
        (refute (nil? cspan))
        ; "# note" starts at col 6
        (assert= (first cspan) 6)
        (assert= (second cspan) 12)))

    ;; The walk builds ONE accumulator and reverses it once, rather than `mapcat`-ing a
    ;; fresh list per level (O(nodes × depth) allocation for O(nodes) of work — the dominant
    ;; half of an editor's per-keystroke fontify). Source order is therefore a property of
    ;; the reversal, not of the concatenation, so it is worth pinning on something DEEP:
    ;; a nested method body whose spans must still come out ascending and unduplicated.
    (test "source order survives nesting, at depth"
      (let (src "class A\n  def a # one\n    if x # two\n      y # three\n    end\n  end\nend\n"
            spans (editor/treesit/fontify src :ruby rb-faces false)
            starts (map spans first)
            comments (seq/filter spans
                       (fn (sp) (= (nth sp 2) (editor/face/face :syntax/comment)))))
        ;; every span, at every depth, in source order and none emitted twice
        (assert= starts (sort starts))
        (assert= (count (seq/distinct starts)) (count starts))
        ;; the three comments come out at their three nesting levels, delimiter included
        (assert= (map comments (fn (sp) (string/substring src (first sp) (second sp))))
          (list "# one" "# two" "# three"))))

    (test "an unmapped kind yields no span for that node (descends instead)"
      ;; with an empty table nothing is coloured
      (let (spans (editor/treesit/fontify rb :ruby {} false))
        (is (empty? spans))))

    (test "face-of-syntax colours keywords via the anonymous-token heuristic"
      ;; the table names NO keywords; `def`/`end` (anonymous alphabetic tokens) are
      ;; coloured :syntax/keyword by `face-of-syntax` — the path the editor modes use.
      (let (spans (editor/treesit/fontify rb :ruby {})
            kw (editor/face/face :syntax/keyword)
            kw-spans (seq/filter spans (fn (s) (= (nth s 2) kw))))
        ; def + end
        (is (>= (count kw-spans) 2))
        ; "def" at col 0
        (assert= (first (first kw-spans)) 0)
        (assert= (second (first kw-spans)) 3)))

    (test "anonymous-keyword? distinguishes alphabetic tokens from punctuation"
      (is (editor/treesit/anonymous-keyword? {:named false :text "def"}))
      (is (editor/treesit/anonymous-keyword? {:named false :text "end"}))
      (refute (editor/treesit/anonymous-keyword? {:named false :text "("}))
      (refute (editor/treesit/anonymous-keyword? {:named false :text "="}))
      (refute (editor/treesit/anonymous-keyword? {:named true :text "foo"}))))

  ;; ---- the windowed-fontify restart ----------------------------------------
  ;; Measured in bedit against a WHOLE-FILE parse (the only honest baseline): on ordinary
  ;; code this cuts a 245-line window to 45 and 29 ms to 5 ms with zero span differences;
  ;; inside a heredoc it declines and matches the full lead-in exactly.
  (describe "treesit column0-restart"
    (def rs-delims ["\"\"\"" "'''"])

    (test "restarts at the previous column-0 line"
      (let (src "defmodule A do\n  def a do\n    1\n  end\nend\n"
            pos (index-of src "    1"))
        ;; the enclosing top-level form, not the indented line the viewport starts on
        (assert= (editor/treesit/column0-restart src pos rs-delims) 0)))

    (test "a column-0 line IS its own restart point"
      (let (src "defmodule A do\nend\ndefmodule B do\nend\n"
            pos (index-of src "defmodule B"))
        (assert= (editor/treesit/column0-restart src pos rs-delims) pos)))

    ;; the whole reason for the guard: prose in a heredoc that looks like code
    (test "declines a candidate inside an open heredoc"
      (let (src "defmodule A do\n  @moduledoc \"\"\"\ndef not_code(x) do\nmore prose\n"
            pos (index-of src "more prose"))
        ;; one delimiter seen and not closed -> fall back to the top of the window
        (assert= (editor/treesit/column0-restart src pos rs-delims) 0)))

    (test "accepts again once the heredoc has closed"
      (let (src "defmodule A do\n  @moduledoc \"\"\"\nprose\n  \"\"\"\nend\ndefmodule B do\n"
            pos (index-of src "defmodule B"))
        (assert= (editor/treesit/column0-restart src pos rs-delims) pos)))

    (test "no delimiters to count means every column-0 line is taken"
      (let (src "a\n  b\nc\n" pos (index-of src "c"))
        (assert= (editor/treesit/column0-restart src pos []) pos)))

    (test "the top of the window is always a valid answer"
      (assert= (editor/treesit/column0-restart "" 0 rs-delims) 0)
      ;; nothing above is in column 0 — there is nowhere to cut, so keep the whole window
      (assert= (editor/treesit/column0-restart "  indented only\n" 0 rs-delims) 0))

    ;; the caller passes a line start, but an offset mid-line must still answer about THAT
    ;; line rather than about the character it happens to land on
    (test "an offset inside a line is normalised to the line"
      (let (src "defmodule A do\n  some indented thing\n")
        (assert= (editor/treesit/column0-restart src 20 rs-delims) 0)
        (assert= (editor/treesit/column0-restart src 5 rs-delims) 0))))

  ;; ---- indentation ---------------------------------------------------------
  ;; Checked line-for-line against real source: for every line, indent it from scratch and
  ;; demand the column the source already has. That is the only assertion worth making about
  ;; an indenter — it agrees with hand-written code — and it is why the whole enclosing form
  ;; is the slice: parsing a truncated prefix reports ERROR for nearly every line, because
  ;; tree-sitter recovers an unterminated `do` rather than leaving the block open.
  (describe "treesit indent-column"
    (def ts-elixir-indent
      {:width 2
       :blocks #{:do_block :body}
       :dedent #{"end" "else" "catch" "rescue" "after"}})

    (defn ts-bol (text n)
      (let (lines (string/split text "\n"))
        (fold (range n) 0 (fn (a k) (+ a (string/length (or (nth lines k) "")) 1)))))

    (defn ts-reindents-itself? (text spec)
      ;; every line, indented from scratch, lands where the source already has it
      (let (lines (string/split text "\n"))
        (every? (range (count lines))
          (fn (i)
            (let (line (nth lines i "")
                  want (- (string/length line) (string/length (string/triml line))))
              (or (= (string/trim line) "")
                ; blank lines carry no claim
                (= want (editor/treesit/indent-column text :elixir (ts-bol text i) spec))))))))

    (test "nested do-blocks, case clauses and their bodies"
      (is (ts-reindents-itself? "defmodule A do\n  def run(x) do\n    case x do\n      1 -> :one\n      _ ->\n        :other\n    end\n  end\nend\n"
            ts-elixir-indent)))

    (test "a module with several top-level forms — each is its own slice"
      (is (ts-reindents-itself? "defmodule A do\n  def a do\n    1\n  end\n\n  def b do\n    2\n  end\nend\n\ndefmodule B do\n  def c do\n    3\n  end\nend\n"
            ts-elixir-indent)))

    (test "the first line of a form is column 0, and so is an empty buffer"
      (assert= (editor/treesit/indent-column "defmodule A do\n" :elixir 0 ts-elixir-indent) 0)
      (assert= (editor/treesit/indent-column "" :elixir 0 ts-elixir-indent) 0))

    ;; `end` belongs under the construct it closes, not under that construct's body — the
    ;; whole reason the spec carries a dedent set rather than only block kinds
    (test "a closing token dedents out of the block it ends"
      (let (text "defmodule A do\n  def a do\n    1\n  end\nend\n")
        (assert= (editor/treesit/indent-column text :elixir (ts-bol text 2) ts-elixir-indent) 4)
        (assert= (editor/treesit/indent-column text :elixir (ts-bol text 3) ts-elixir-indent) 2)
        (assert= (editor/treesit/indent-column text :elixir (ts-bol text 4) ts-elixir-indent) 0)))

    (test "a width of its own is honoured"
      (let (text "defmodule A do\n  def a do\n    1\n  end\nend\n")
        (assert= (editor/treesit/indent-column text
                   :elixir (ts-bol text 2)
                   (assoc ts-elixir-indent :width 4))
          8)))

    ;; text nobody can parse must still answer a column rather than raise
    ;; The two grammars disagree about where a block begins, which is why the spec carries
    ;; `:dedent-levels`: Elixir's `do_block` spans its own `end` (a closer is still inside
    ;; it), Ruby's `body_statement` stops before `end` (a closer is already out).
    (test "ruby, whose blocks begin at the first statement rather than at a keyword"
      (let (rb "class A\n  def run(x)\n    if x\n      1\n    else\n      2\n    end\n  end\nend\n"
            spec {:width 2
                  :blocks #{:body_statement :then :else}
                  :dedent #{"end" "else" "elsif" "rescue" "ensure" "when"}
                  :dedent-levels 0}
            lines (string/split rb "\n"))
        (is (every? (range (count lines))
              (fn (i)
                (let (line (nth lines i "")
                      want (- (string/length line) (string/length (string/triml line))))
                  (or (= (string/trim line) "")
                    (= want (editor/treesit/indent-column rb :ruby (ts-bol rb i) spec)))))))))

    (test "unparsable source indents to something rather than failing"
      (is (int? (editor/treesit/indent-column "defmodule ((( do\n  x\n" :elixir 17 ts-elixir-indent)))))

  (describe "treesit structural navigation"
    (test "point-forward lands at the end of the next named node"
      ;; from col 0 the next top-level node is the whole `def…end` method
      (let (end (editor/treesit/point-forward rb :ruby 0))
        (is (> end 0))
        (assert= (string/substring rb 0 3) "def")))

    (test "point-defun-start finds the enclosing top-level node"
      ;; col 11 is inside the body; the method begins at 0
      (assert= (editor/treesit/point-defun-start rb :ruby 11) 0))

    ; module body, no def → the module
    (test "point-defun-start finds the enclosing def, not the whole module (Elixir)"
      ;; def is a `call` to a def-macro, nested in the module's do-block — C-M-a must land on
      ;; the enclosing def, not the file top (the bug: it always jumped to the module start).
      (let (ex "defmodule A do\n  def f, do: 1\n  def g, do: 2\nend\n")
        ; inside def f → def f's start
        (assert= (editor/treesit/point-defun-start ex :elixir 18) 17)
        ; inside def g → def g's start
        (assert= (editor/treesit/point-defun-start ex :elixir 36) 32)
        (assert= (editor/treesit/point-defun-start ex :elixir 14) 0)))

    ;; What a definition is comes from the LANGUAGE's declaration: taking `:method` out of
    ;; Ruby's kinds makes C-M-a inside a method land on the class around it instead.
    (test "a language's declared definitions decide where beginning-of-defun lands"
      (let (src "class A\n  def f\n    1\n  end\nend\n"
            declared (editor/treesit/definitions :ruby)
            inside (index-of src "1"))
        (assert= (editor/treesit/point-defun-start src :ruby inside) (index-of src "def f"))
        (editor/treesit/register-definitions :ruby {:kinds #{:class}})
        (let (moved (editor/treesit/point-defun-start src :ruby inside))
          (editor/treesit/register-definitions :ruby declared)
          (assert= moved 0))))

    (test "a language that declared nothing falls back to the top-level form"
      (assert= (editor/treesit/definitions :no-such-language) {}))
    (test "point-up rises to the enclosing node's start"
      (let (up (editor/treesit/point-up rb :ruby 11))
        (is (>= up 0))
        (is (< up 11))))

    (test "motions are no-ops with nothing to move to"
      ;; past the end, forward stays put
      (assert= (editor/treesit/point-forward rb :ruby (string/length rb)) (string/length rb))))

  ;; ---- the structural queries over a held tree (ADR-467) ----------------------
  ;; A held tree answers exactly what the text query answers — at every offset, so a
  ;; char/byte slip on the multi-byte line shows — and the wiring is proved by handing a
  ;; tree whose text is NOT the text passed: the answer follows the tree.
  (describe "treesit queries over a held tree"
    (def ts-held-src "defmodule A do\n  # héllo — ünïcode\n  def f(x) do\n    [x, 1]\n  end\nend\n")

    (defn ts-held-agrees? (motion tree)
      (every? (range (inc (string/length ts-held-src)))
        (fn (p) (= (motion ts-held-src :elixir p) (motion ts-held-src :elixir p tree)))))

    (test "every motion over the tree agrees with the text query at every offset"
      (let (tree (editor/treesit/open-tree (text/from-string ts-held-src) :elixir))
        (is (ts-held-agrees? editor/treesit/point-forward tree))
        (is (ts-held-agrees? editor/treesit/point-backward tree))
        (is (ts-held-agrees? editor/treesit/point-list-forward tree))
        (is (ts-held-agrees? editor/treesit/point-list-backward tree))
        (is (ts-held-agrees? editor/treesit/point-up tree))
        (is (ts-held-agrees? editor/treesit/point-up-forward tree))
        (is (ts-held-agrees? editor/treesit/point-down tree))
        (is (ts-held-agrees? editor/treesit/point-defun-start tree))
        (is (ts-held-agrees? editor/treesit/point-defun-end tree))
        (editor/treesit/free-tree tree)))

    (test "indent-column over the tree agrees with the text query on every line"
      (let (tree (editor/treesit/open-tree ts-held-src :elixir)
            spec {:width 2 :blocks #{:do_block :body} :dedent #{"end"}}
            starts (cons 0
                     (seq/keep (range (string/length ts-held-src))
                       (fn (i) (when (= (string/char-at ts-held-src i) "\n") (inc i))))))
        (is (every? starts
              (fn (bol)
                (= (editor/treesit/indent-column ts-held-src :elixir bol spec)
                  (editor/treesit/indent-column ts-held-src :elixir bol spec tree)))))
        (editor/treesit/free-tree tree)))

    ;; ADR-483: an editor holds a rope, and RET used to build the whole buffer's string to
    ;; indent one line. A rope answers exactly what its string does — with the tree and
    ;; without, on the multi-byte line, a comment, a blank and an aligned bracket.
    (def ts-rope-src
      "defmodule A do\n  # héllo — ünïcode\n\n  def f(x) do\n    g(x,\n      1)\n  end\nend\n")

    (test "indent-column over a rope agrees with the string on every line"
      (let (rope (text/from-string ts-rope-src)
            tree (editor/treesit/open-tree rope :elixir)
            spec {:width 2 :blocks #{:do_block :body} :dedent #{"end"} :brackets #{:arguments}}
            starts (cons 0
                     (seq/keep (range (string/length ts-rope-src))
                       (fn (i) (when (= (string/char-at ts-rope-src i) "\n") (inc i))))))
        (is (every? starts
              (fn (bol)
                (let (want (editor/treesit/indent-column ts-rope-src :elixir bol spec))
                  (and (= want (editor/treesit/indent-column rope :elixir bol spec))
                    (= want (editor/treesit/indent-column rope :elixir bol spec tree)))))))
        (editor/treesit/free-tree tree)))

    (test "every motion over a rope agrees with the string at every offset"
      (let (rope (text/from-string ts-rope-src)
            tree (editor/treesit/open-tree rope :elixir)
            agrees? (fn (motion)
                      (every? (range (inc (string/length ts-rope-src)))
                        (fn (p)
                          (let (want (motion ts-rope-src :elixir p))
                            (and (= want (motion rope :elixir p))
                              (= want (motion rope :elixir p tree))))))))
        (is (agrees? editor/treesit/point-forward))
        (is (agrees? editor/treesit/point-backward))
        (is (agrees? editor/treesit/point-up))
        (is (agrees? editor/treesit/point-down))
        (is (agrees? editor/treesit/point-defun-start))
        (is (agrees? editor/treesit/point-defun-end))
        (editor/treesit/free-tree tree)))

    (test "the tree is what is read: an empty text with this tree still finds the def"
      (let (tree (editor/treesit/open-tree ts-held-src :elixir)
            inside (index-of ts-held-src "[x"))
        (assert= (editor/treesit/point-up "" :elixir inside) inside)
        (assert= (editor/treesit/point-up "" :elixir inside tree)
          (editor/treesit/point-up ts-held-src :elixir inside))
        (editor/treesit/free-tree tree)))

    (test "a gone tree falls back to the text, and tree-alive? says which"
      (let (tree (editor/treesit/open-tree ts-held-src :elixir)
            inside (index-of ts-held-src "[x")
            alive (editor/treesit/tree-alive? tree))
        (editor/treesit/free-tree tree)
        (is alive)
        (refute (editor/treesit/tree-alive? tree))
        (assert= (editor/treesit/point-up ts-held-src :elixir inside tree)
          (editor/treesit/point-up ts-held-src :elixir inside))))

    (test "a tree updated with the buffer's own splices answers for the new text"
      (let (at (index-of ts-held-src "1]")
            before (editor/buffer/goto-char (editor/buffer/make-buffer ts-held-src) at)
            after (editor/buffer/insert (editor/buffer/delete-char before) "2, 3")
            edits (into []
                    (map (editor/buffer/buffer-splices-since before after)
                      (fn ([lo hi repl]) [lo hi (+ lo (string/length repl))])))
            tree (editor/treesit/open-tree (editor/buffer/buffer-rope before) :elixir)
            updated (editor/treesit/update-tree tree
                      (editor/buffer/buffer-rope after)
                      :elixir edits)
            text (editor/buffer/buffer-text after))
        ;; one splice — the deletion and the typing after it are one run
        (assert= edits [[at (inc at) (+ at 4)]])
        (is (every? (range (inc (string/length text)))
              (fn (p)
                (= (editor/treesit/point-forward text :elixir p)
                  (editor/treesit/point-forward text :elixir p updated)))))
        (editor/treesit/free-tree tree)
        (editor/treesit/free-tree updated))))

  ;; ---- parse-state: unfinished is not wrong -----------------------------------
  ;; The whole contract of a live evaluator sits on this distinction, so each case
  ;; below is one shape a reader passes through while typing — or one they do not.
  (describe "treesit parse-state"
    (test "blank text is :blank, and complete text is :ok"
      (assert= (editor/treesit/parse-state "   \n  " :elixir) :blank)
      (assert= (editor/treesit/parse-state "1 + 2" :elixir) :ok)
      (assert= (editor/treesit/parse-state "defmodule A do\n  def f, do: 1\nend" :elixir) :ok))

    (test "an unclosed construct is :incomplete, naming what opened"
      ;; tree-sitter-elixir repairs an unclosed `do` with an ERROR node, not a MISSING
      ;; `end` — which is exactly why the rule reads the error's POSITION and not its
      ;; kind alone. Called an error, this would put a red verdict on every `defmodule`
      ;; the moment its first line was typed.
      (assert= (editor/treesit/parse-state "defmodule Foo do" :elixir)
        [:incomplete "unclosed `do`"])
      (assert= (editor/treesit/parse-state "IO.puts(" :elixir) [:incomplete "unclosed `(`"])
      (assert= (editor/treesit/parse-state "Enum.map([1, 2], fn x ->" :elixir)
        [:incomplete "unclosed `(`"]))

    (test "a MISSING node is :incomplete, naming the token the grammar wanted"
      ;; the grammar inserts the closer itself here, so the reason is what is missing
      ;; rather than what opened
      (assert= (editor/treesit/parse-state "x = \"hello" :elixir) [:incomplete "missing `\"`"])
      (assert= (editor/treesit/parse-state "defmodule Foo do\n" :elixir)
        [:incomplete "missing `end`"]))

    (test "an error with good code after it is :err"
      ;; no further typing at the cursor explains the text that already follows, so this
      ;; is a mistake rather than an unfinished thought
      (assert= (editor/treesit/parse-state "1 +* 2" :elixir) [:err "unexpected `*`"])
      (assert= (editor/treesit/parse-state "defmodule A do\nend\n1 +* 2\nIO.puts(\"ok\")" :elixir)
        [:err "unexpected `*`"]))

    (test "trailing whitespace does not make an unclosed construct look broken"
      ;; the tail test measures against the TRIMMED end; without that, pressing space
      ;; after `fn ->` flipped a pending note into a verdict
      (assert= (editor/treesit/parse-state "Enum.map([1, 2], fn x ->   \n\n" :elixir)
        [:incomplete "unclosed `(`"]))

    (test "the rule is language-agnostic: Ruby classifies the same way"
      (assert= (editor/treesit/parse-state "def foo\n  1\nend" :ruby) :ok)
      (assert= (editor/treesit/parse-tag (editor/treesit/parse-state "def foo" :ruby)) :incomplete))

    (test "parse-tag drops the reason"
      (assert= (editor/treesit/parse-tag :ok) :ok)
      (assert= (editor/treesit/parse-tag [:err "boom"]) :err))))

;; What a language registration checks before accepting a mode — bedit's `modes` calls it.
(describe "missing-services"
  (test "names each required service a layer lacks, in contract order; none when complete"
    (assert= (editor/treesit/missing-services {}) '(:ts-lang :fontify :indent))
    (assert= (editor/treesit/missing-services {:ts-lang :x :fontify identity}) '(:indent))
    (is (empty? (editor/treesit/missing-services {:ts-lang :x :fontify identity :indent identity})))))

;; An editor asks this before offering to fetch a grammar, rather than parsing and reading
;; the error.
(describe "languages"
  (test "lists what parses: keywords, sorted, with the built-in grammars when there are any"
    (let (names (editor/treesit/languages))
      (is (vector? names))
      (is (every? names keyword?))
      (assert= names (vec (seq/sort-by names ->string)))
      (when tsm-grammars?
        (is (includes? names :ruby))
        (is (includes? names :elixir))))))

;; A face table keyed on CONTEXT (ADR-486): a selector map names the node's parent kind,
;; the field it fills, its place among the parent's named children. The raw span query is
;; asserted where the face names matter; it reports the table's value untouched.
(when tsm-grammars?
  (describe "face-table context selectors"
    (test "a field beats a kind: a Ruby call's method name is told from its receiver"
      (assert= (%tree-sitter-spans "foo.bar(1)\nbaz(2)\n"
                 :ruby {{:field :method} :syntax/function :identifier :syntax/variable}
                 false)
        [[0 3 :syntax/variable] [4 7 :syntax/function] [11 14 :syntax/function]]))

    (test "the most specific entry wins, whatever the map's order"
      (let (src "a.b(c)\n"
            table {:identifier :plain
                   {:kind :identifier :parent :call} :parent
                   {:kind :identifier :parent :call :field :method} :field})
        ;; `a` fills :receiver, `b` :method; `c` sits under argument_list, so only the kind holds
        (assert= (%tree-sitter-spans src :ruby table false)
          [[0 1 :parent] [2 3 :field] [4 5 :plain]])))

    (test ":nth counts named children only"
      (assert= (%tree-sitter-spans "f(a, b)\n"
                 :ruby {{:parent :argument_list :nth 1} :second}
                 false)
        [[5 6 :second]]))

    (test "a coloured ancestor still hides what is under it"
      (assert= (%tree-sitter-spans "foo.bar\n" :ruby {:call :whole {:field :method} :method} false)
        [[0 7 :whole]]))

    (test "the held tree answers what the text does, context and all"
      (let (src "def go\n  foo.bar(1)\n  baz(x)\nend\n"
            table {{:field :method} :syntax/function :identifier :syntax/variable}
            tree (editor/treesit/open-tree src :ruby))
        (assert= (%tree-sitter-tree-spans tree table false 0 (string/length src))
          (%tree-sitter-spans src :ruby table false))
        (assert= (editor/treesit/fontify-tree tree table 0 (string/length src))
          (vec (editor/treesit/fontify src :ruby table)))
        (editor/treesit/free-tree tree)))

    (test "a malformed selector is refused by the kernel and named by the validator"
      (is (failure? (try
                      (%tree-sitter-spans "x\n" :ruby {{:feild :name} :f} false)
                      (catch e (failure (error-message e))))))
      (is (failure? (try
                      (%tree-sitter-spans "x\n" :ruby {{} :f} false)
                      (catch e (failure (error-message e))))))
      (assert= (count (editor/treesit/face-table-problems {{:feild :name} :f
                                                           {} :g
                                                           {:nth -1} :h
                                                           {:kind "x"} :i
                                                           :ok "face"}))
        5)
      (assert= (editor/treesit/face-table-problems {:string :syntax/string
                                                    {:parent :call
                                                     :field :method
                                                     :kind :identifier
                                                     :nth 0} :f})
        '()))))

;; Two selectors past position (ADR-487): a node's exact TEXT, and a PARENT that must satisfy
;; a selector of its own.
(when tsm-grammars?
  (def tsm-elixir-src "def go(x) do\n  if x do\n    foo(x)\n  end\nend\n")

  (def tsm-elixir-faces
    {{:kind :identifier :parent :call :field :target :text #{"def" "if" "case"}} :keyword
     {:kind :identifier :parent :call :field :target} :function
     :identifier :variable})

  (describe "face-table :text and nested :parent selectors"
    (test "Elixir's def and if are told from a call by their text"
      ;; def · go · x · if · x · foo · x — `go` is the call `def` takes, a call by shape
      (assert= (%tree-sitter-spans tsm-elixir-src :elixir tsm-elixir-faces false)
        [[0 3 :keyword]
          [4 6 :function]
          [7 8 :variable]
          [15 17 :keyword]
          [18 19 :variable]
          [27 30 :function]
          [31 32 :variable]]))

    (test "text beats field, a deeper parent breaks a tie, the narrower text set wins"
      ;; Ruby `a.b(c)`: `a` fills :receiver, `b` :method, `c` sits in an argument_list
      (assert= (%tree-sitter-spans "a.b(c)\n"
                 :ruby {{:kind :identifier :field :method} :field
                  {:kind :identifier :text "b"} :text}
                 false)
        [[2 3 :text]])
      (assert= (%tree-sitter-spans "a.b(c)\n"
                 :ruby {{:kind :identifier :parent :argument_list} :flat
                  {:kind :identifier :parent {:kind :argument_list :parent :call}} :nested}
                 false)
        [[4 5 :nested]])
      (assert= (%tree-sitter-spans "a.b(c)\n"
                 :ruby {{:kind :identifier :text #{"a" "b" "c"}} :wide
                  {:kind :identifier :text "c"} :narrow}
                 false)
        [[0 1 :wide] [2 3 :wide] [4 5 :narrow]]))

    (test "a nested parent places the parent by its own field"
      ;; `b` is the method; the argument `c` has a parent (argument_list) that fills
      ;; :arguments, not :receiver
      (assert= (%tree-sitter-spans "a.b(c)\n"
                 :ruby {{:kind :identifier :parent {:kind :argument_list :field :arguments}} :argument
                  {:kind :identifier :parent {:kind :argument_list :field :receiver}} :never}
                 false)
        [[4 5 :argument]]))

    (test "the held tree answers what the text does, over the file and a window"
      (let (tree (editor/treesit/open-tree tsm-elixir-src :elixir)
            whole (%tree-sitter-spans tsm-elixir-src :elixir tsm-elixir-faces false))
        (assert= (%tree-sitter-tree-spans tree
                   tsm-elixir-faces
                   false
                   0
                   (string/length tsm-elixir-src))
          whole)
        (assert= (%tree-sitter-tree-spans tree tsm-elixir-faces false 13 32)
          (vec (seq/filter whole (fn (sp) (and (>= (first sp) 13) (< (first sp) 32))))))
        (editor/treesit/free-tree tree)))

    (test "a malformed :text or :parent is refused by the kernel and named by the validator"
      (let (bad [{:kind :identifier :text #{}}
                  {:kind :identifier :text 3}
                  {:kind :identifier :text #{"a" :b}}
                  {:kind :identifier :parent "call"}
                  {:kind :identifier :parent {}}
                  {:kind :identifier
                   :parent {:kind :call :parent {:kind :call :parent {:kind :call}}}}
                  {:kind :identifier :parent {:feild :x}}
                  ;; a constraint present with no value: the kernel reads every key it has
                  {:kind :identifier :text nil}
                  {:kind :identifier :parent nil}
                  {:kind :identifier :nth nil}
                  {:kind nil :field :name}])
        (is (every? bad
              (fn (selector)
                (failure? (try
                            (%tree-sitter-spans "x\n" :ruby {selector :f} false)
                            (catch e (failure (error-message e))))))))
        (assert= (count (editor/treesit/face-table-problems (into {} (map bad (fn (s) [s :f])))))
          (count bad)))
      ;; three maps deep is the bound, and is allowed
      (assert= (editor/treesit/face-table-problems {{:kind :identifier
                                                     :parent {:kind :call
                                                              :parent {:kind :call :field :x}}} :f
                                                    {:text "def"} :g})
        '()))))

;; The installed grammars an editor fetched ($BROOD_TEST_GRAMMARS, else bedit's ~/.config/bedit/grammars); a suite
;; runs only when its library is there, so a machine without them stays green.
(def tsm-grammar-dir
  (str (or (os/env "BROOD_TEST_GRAMMARS") (str (or (os/env "HOME") "") "/.config/bedit/grammars"))
    "/"))

(defn tsm-installed? (lang)
  (let (path (str tsm-grammar-dir "libtree-sitter-" (->string lang) ".so"))
    (when (file/exists? path) (editor/treesit/declare-grammar path lang))))

(when (tsm-installed? :hcl)
  ;; Every name in HCL is an `identifier`; where it sits is the only thing telling a block's
  ;; type from an attribute's name from a called function.
  (def tsm-hcl-faces
    {:string_lit :label
     {:parent :block :kind :identifier :nth 0} :block-type
     {:parent :attribute :kind :identifier} :attribute
     {:parent :function_call :kind :identifier} :function
     :identifier :name})

  (def tsm-hcl-src
    "resource \"aws_instance\" \"web\" {\n  ami = lookup(var.amis, \"x\")\n  user_data = <<-EOT\n    #!/bin/bash\n\n      echo hi\n}\n  EOT\n}\nlocals {\n  a = 1\n}\n")

  (describe "HCL: context faces"
    (test "block type, label, attribute name, function name and variable each their own"
      (let (spans (%tree-sitter-spans tsm-hcl-src :hcl tsm-hcl-faces false)
            named (fn (from) (nth (seq/find spans (fn (sp) (= (first sp) from))) 2)))
        (assert= (named 0) :block-type)
        (assert= (named 9) :label)
        (assert= (named 34) :attribute)
        (assert= (named 40) :function)
        (assert= (named 47) :name)
        ;; `locals` is a block type too, with no label after it
        (assert= (named (index-of tsm-hcl-src "locals")) :block-type)))

    (test "the held tree's spans equal the text's, over the whole file and a window"
      (let (tree (editor/treesit/open-tree tsm-hcl-src :hcl)
            whole (%tree-sitter-spans tsm-hcl-src :hcl tsm-hcl-faces false))
        (assert= (%tree-sitter-tree-spans tree tsm-hcl-faces false 0 (string/length tsm-hcl-src))
          whole)
        ;; a window starting inside the first block still sees `ami` as an attribute
        (assert= (%tree-sitter-tree-spans tree tsm-hcl-faces false 34 61)
          (vec (seq/filter whole (fn (sp) (and (>= (first sp) 34) (< (first sp) 61))))))
        (editor/treesit/free-tree tree))))

  (def tsm-hcl-indent
    {:width 2
     :blocks #{}
     :brackets #{:block :object :tuple :function_call}
     :dedent #{}
     :opens #{"{" "[" "("}
     :verbatim #{:heredoc_template}})

  (describe "HCL: verbatim heredoc lines"
    (test "a heredoc's lines keep their indentation; a blank one continues the content's"
      (let (lines (string/split tsm-hcl-src "\n")
            bol (fn (i) (fold (take lines i) 0 (fn (acc l) (+ acc (string/length l) 1))))
            column (fn (spec i) (editor/treesit/indent-column tsm-hcl-src :hcl (bol i) spec)))
        ;; resource · ami · user_data · #!/bin/bash · blank · echo · `}` · EOT · } · locals · a · }
        (assert= (map (range 0 12) (fn (i) (column tsm-hcl-indent i)))
          '(0 2 2 4 4 6 0 2 0 0 2 0))
        ;; the opening line is code; without :verbatim the content is re-indented as code
        (assert= (column (dissoc tsm-hcl-indent :verbatim) 5) 2)))

    (test "the held tree agrees"
      (let (tree (editor/treesit/open-tree tsm-hcl-src :hcl)
            echo-bol (index-of tsm-hcl-src "      echo"))
        (assert= (editor/treesit/indent-column tsm-hcl-src :hcl echo-bol tsm-hcl-indent tree) 6)
        (editor/treesit/free-tree tree)))

    ;; the answer is a COLUMN: a line indented with tabs keeps the column its tabs reach, at
    ;; the ambient tab width (ADR-537) — not the count of its tab characters
    (test "a heredoc line indented with tabs keeps its column, not its character count"
      (let (src "x = <<EOT\n\t\techo hi\n\t\t\nEOT\n"
            echo-bol (index-of src "\t\techo")
            blank-bol (+ echo-bol (string/length "\t\techo hi\n")))
        (assert= (editor/treesit/indent-column src :hcl echo-bol tsm-hcl-indent) 16)
        (assert= (binding (*tab-width* 4)
                   (editor/treesit/indent-column src :hcl echo-bol tsm-hcl-indent))
          8)
        ;; a blank verbatim line continues the content's column
        (assert= (editor/treesit/indent-column src :hcl blank-bol tsm-hcl-indent) 16)))))

(when (and (tsm-installed? :rust) (tsm-installed? :go))
  (describe "Rust and Go: a call's function name"
    (test "the identifier filling `function` is not the one in the arguments"
      (let (calls {{:field :function :kind :identifier} :function :identifier :name})
        (assert= (%tree-sitter-spans "fn main() { let x = foo(y); }\n" :rust calls false)
          [[3 7 :name] [16 17 :name] [20 23 :function] [24 25 :name]])
        (assert= (%tree-sitter-spans "package m\nfunc main() { x := foo(y) }\n" :go calls false)
          [[15 19 :name] [24 25 :name] [29 32 :function] [33 34 :name]])))))

(when (tsm-installed? :rust)
  (describe "Rust: a method call's name by its parent's place"
    (test "`bar` in `s.bar()` is a method; `x` in `p.x` is a field read"
      (let (src "fn main() { s.bar(); let y = p.x; }\n"
            faces {{:kind :field_identifier :parent {:kind :field_expression :field :function}} :method
                   :field_identifier :field}
            tree (editor/treesit/open-tree src :rust))
        (assert= (%tree-sitter-spans src :rust faces false) [[14 17 :method] [31 32 :field]])
        (assert= (%tree-sitter-tree-spans tree faces false 0 (string/length src))
          (%tree-sitter-spans src :rust faces false))
        (editor/treesit/free-tree tree)))))

;; ---- injections: another language's document inside this one (ADR-489) ----------------

(when tsm-grammars?
  ;; `x = "abc` and `def"` are two ranges of one Ruby document: together they are a
  ;; string, and the `def` after the gap is inside it — alone, the second range is a keyword.
  (def tsm-split "x = \"abc@@@@def\"\n")

  (describe "injections: ranges of a text as one document"
    (test "ranges spanning several pieces parse as one document, in the outer text's offsets"
      (assert= (%tree-sitter-range-spans tsm-split :ruby [[0 8] [12 17]] {:string :s} true)
        [[4 8 :s] [12 16 :s]])
      ;; the second piece alone is code, which is what one document is not
      (assert= (first (%tree-sitter-range-spans tsm-split :ruby [[12 17]] {:string :s} true))
        [12 15 :__keyword__]))

    (test "an injected parse leaves the pooled parser whole for the next document"
      ;; the parser goes back to a pool; one still carrying [[0 3]] would read `# r` alone
      (%tree-sitter-range-spans "# range only\n" :ruby [[0 3]] {:comment :c} false)
      (assert= (%tree-sitter-spans "# r\n\"after the range\"\n"
                 :ruby {:comment :c :string :s}
                 false)
        [[0 3 :c] [4 21 :s]]))

    (test "a rope answers as the string does, and ranges are sorted and merged"
      (assert= (%tree-sitter-range-spans (text/from-string tsm-split)
                 :ruby [[12 17] [0 8] [2 5]]
                 {:string :s}
                 true)
        (%tree-sitter-range-spans tsm-split :ruby [[0 8] [12 17]] {:string :s} true)))

    (test "a missing grammar yields no spans and never raises"
      (assert= (%tree-sitter-range-spans tsm-split :no-such-grammar [[0 8]] {:string :s} true) nil)
      (assert= (editor/treesit/fontify-ranges tsm-split :no-such-grammar [[0 8]] {:string :s}) '()))

    (test "fontify-ranges colours an Elixir heredoc's body as Ruby, with resolved faces"
      (let (src "x = \"\"\"\ndef a\n  1\nend\n\"\"\"\n"
            body [(+ 7 1) (index-of src "\"\"\"" 8)])
        (assert= (editor/treesit/fontify-ranges src :ruby [body] {:integer :syntax/number} false)
          (list [16 17 (editor/face/face :syntax/number)])))))

  ;; An Elixir host with Ruby embedded twice: a `~R` sigil (its language read from the sigil's
  ;; name) and a heredoc split by an interpolation (a fixed language, two pieces).
  (def tsm-inject-src "x = ~R\"\"\"\ndef a\n  1\nend\n\"\"\"\ny = \"\"\"\ndef a#{x}\nend\n\"\"\"\n")
  (def tsm-inject-host {:sigil :str :string :str})
  (def tsm-inject-rb {:integer :rb-int :method :rb-method})
  (def tsm-inject
    {:rules [{:content {:kind :quoted_content :parent :sigil}
              :lang-from :sigil_name
              :aliases {"R" :ruby}}
              {:content {:kind :quoted_content :parent :string} :lang :ruby}]
     :faces {:ruby tsm-inject-rb}})
  (def tsm-injected
    [[4 9 :str]
      [10 23 :rb-method]
      [24 27 :str]
      [32 35 :str]
      [36 41 :rb-method]
      [41 45 :str]
      [45 49 :rb-method]
      [50 53 :str]])

  (defn tsm-clip (spans from to)
    ;; spans as a window [from, to) of a held tree reports them
    (into []
      (seq/keep spans
        (fn ([start end reported])
          (when (and (< start to) (> end from))
            [(math/max start from) (math/min end to) reported])))))

  (describe "injections: declared on a tree-sitter host"
    (test "the injected language's spans replace the host's over the content"
      (assert= (%tree-sitter-spans tsm-inject-src :elixir tsm-inject-host false)
        [[4 27 :str] [32 53 :str]])
      (assert= (%tree-sitter-spans tsm-inject-src :elixir tsm-inject-host false tsm-inject)
        tsm-injected))

    (test "a parent's matching children are ONE document: the method spans the interpolation"
      ;; `\ndef a` and `\nend\n` are each half a method; only together are they one
      (let (spans (%tree-sitter-spans tsm-inject-src :elixir tsm-inject-host false tsm-inject))
        (assert= (seq/filter spans (fn (sp) (>= (first sp) 32)))
          (list [32 35 :str] [36 41 :rb-method] [41 45 :str] [45 49 :rb-method] [50 53 :str]))))

    (test "processes injecting at once each get the same spans"
      ;; the injected parses share the runtime's parser pool; each process's answer is its own
      (assert= (seq/distinct (seq/pmap (range 0 8)
                               (fn (_)
                                 (%tree-sitter-spans tsm-inject-src
                                   :elixir tsm-inject-host false tsm-inject))))
        (list tsm-injected)))

    (test "a language with no table or no grammar keeps the host's colours"
      (let (host (%tree-sitter-spans tsm-inject-src :elixir tsm-inject-host false))
        ;; no grammar for :nope
        (assert= (%tree-sitter-spans tsm-inject-src
                   :elixir tsm-inject-host
                   false
                   {:rules [{:content {:kind :quoted_content :parent :string} :lang :nope}]
                    :faces {:nope tsm-inject-rb}})
          host)
        ;; no table: the sigil's word without an alias is `r`, which :faces does not name
        (assert= (%tree-sitter-spans tsm-inject-src
                   :elixir tsm-inject-host
                   false
                   {:rules [{:content {:kind :quoted_content :parent :sigil} :lang-from :sigil_name}]
                    :faces {:ruby tsm-inject-rb}})
          host)))

    (test "held-tree spans equal the text's, over the whole file and over a window"
      (let (tree (editor/treesit/open-tree tsm-inject-src :elixir)
            whole (%tree-sitter-spans tsm-inject-src :elixir tsm-inject-host false tsm-inject))
        (assert= (%tree-sitter-tree-spans tree
                   tsm-inject-host
                   false
                   0
                   (string/length tsm-inject-src)
                   tsm-inject)
          whole)
        ;; a window inside the sigil's body still parses the whole body
        (assert= (%tree-sitter-tree-spans tree tsm-inject-host false 12 20 tsm-inject)
          (tsm-clip whole 12 20))
        ;; and one over the second heredoc's tail sees the document its first piece began
        (assert= (%tree-sitter-tree-spans tree tsm-inject-host false 46 54 tsm-inject)
          (tsm-clip whole 46 54))
        (editor/treesit/free-tree tree)))

    (test "a window ending before a document's later pieces still parses them"
      ;; Ruby's `"a` is a string only with the `b"` after the interpolation: a window over
      ;; the first piece alone must not see it unterminated
      (let (src "z = \"\"\"\nq = \"a#{x}b\"\n\"\"\"\n"
            rule {:rules [{:content {:kind :quoted_content :parent :string} :lang :ruby}]
                  :faces {:ruby {:string :rb-string}}}
            tree (editor/treesit/open-tree src :elixir)
            whole (%tree-sitter-spans src :elixir {:string :str} false rule))
        (assert= (tsm-clip whole 8 15) [[12 14 :rb-string] [14 15 :str]])
        (assert= (%tree-sitter-tree-spans tree {:string :str} false 8 15 rule)
          (tsm-clip whole 8 15))
        (editor/treesit/free-tree tree)))

    (test "fontify and fontify-tree resolve the injected table's faces"
      (let (host-faces {:sigil :syntax/string :string :syntax/string}
            injections {:rules (get tsm-inject :rules) :faces {:ruby {:method :syntax/function}}}
            spans (editor/treesit/fontify tsm-inject-src :elixir host-faces false injections)
            tree (editor/treesit/open-tree tsm-inject-src :elixir))
        (assert= (nth (seq/find spans (fn (sp) (= (first sp) 10))) 2)
          (editor/face/face :syntax/function))
        (assert= (editor/treesit/fontify-tree tree
                   host-faces
                   0
                   (string/length tsm-inject-src)
                   false
                   injections)
          (into [] spans))
        (editor/treesit/free-tree tree)))

    (test "an edit inside an embedded document widens the tree's changes over all of it"
      (let (tree (editor/treesit/open-tree tsm-inject-src :elixir)
            edited (str (string/substring tsm-inject-src 0 12)
                     "\""
                     (string/substring tsm-inject-src 12 (string/length tsm-inject-src)))
            next (editor/treesit/update-tree tree edited :elixir))
        ;; the host saw a character typed; the Ruby inside it may have recoloured to its end
        (assert= (editor/treesit/tree-changes next) [[12 13]])
        (assert= (editor/treesit/tree-changes next tsm-inject) [[9 25]])
        (editor/treesit/free-tree tree)
        (editor/treesit/free-tree next)))

    (test "a document past the per-document cap keeps the host's colours unless a window cuts it"
      (let (body (string/join (map (range 0 4000) (fn (_) "def a\nend\n")) "")
            src (str "y = \"\"\"\n" body "\"\"\"\n")
            rule {:rules [{:content {:kind :quoted_content :parent :string} :lang :ruby}]
                  :faces {:ruby tsm-inject-rb}}
            tree (editor/treesit/open-tree src :elixir))
        ;; 40 KB of Ruby is past 32 KB: the whole-text query leaves it a string
        (assert= (%tree-sitter-spans src :elixir tsm-inject-host false rule)
          [[4 (dec (string/length src)) :str]])
        ;; a window parses the part it shows
        (assert= (%tree-sitter-tree-spans tree tsm-inject-host false 8 28 rule)
          [[8 17 :rb-method] [18 27 :rb-method]])
        (editor/treesit/free-tree tree)))

    (test "a malformed spec is refused by the kernel and named by injection-problems"
      (assert= (count (editor/treesit/injection-problems tsm-inject)) 0)
      (each [[{:rules [{:content :x :lang :ruby :aliases {"a" :ruby}}] :faces {:ruby {}}} 1]
              [{:rules [{:lang :ruby}] :faces {:ruby {}}} 1]
              [{:rules [{:content {:feild :x} :lang :ruby}] :faces {:ruby {}}} 1]
              [{:rules [{:content :x :lang-from :y :aliases {:a :ruby}}] :faces {:ruby {}}} 1]
              [{:rules [] :faces {:ruby {{} :f}}} 1]
              [{:rulez []} 1]]
        (fn ([spec problems])
          (assert= (count (editor/treesit/injection-problems spec)) problems)
          (is (failure? (check-allow :discarded-catch
                          (try
                            (%tree-sitter-spans "x\n" :elixir {} false spec)
                            (catch e (failure (error-message e)))))))))
      ;; and what the kernel takes, the validator takes: an empty :aliases beside a fixed
      ;; :lang names no second language
      (let (spec {:rules [{:content :x :lang :ruby :aliases {}}] :faces {:ruby {}}})
        (assert= (editor/treesit/injection-problems spec) '())
        (is (not (failure? (check-allow :discarded-catch
                             (try
                               (%tree-sitter-spans "x\n" :elixir {} false spec)
                               (catch e (failure (error-message e)))))))))
      ;; a rule key present with no value is refused by both
      (let (spec {:rules [{:content :x :lang-from :y :lang nil}] :faces {}})
        (assert= (count (editor/treesit/injection-problems spec)) 1)
        (is (failure? (check-allow :discarded-catch
                        (try
                          (%tree-sitter-spans "x\n" :elixir {} false spec)
                          (catch e (failure (error-message e))))))))
      ;; a fixed language with no table is legal to the kernel (it injects nothing) and a
      ;; problem to a registration, which can only have meant a table
      (assert= (count (editor/treesit/injection-problems {:rules [{:content :x :lang :sql}]
                                                          :faces {}}))
        1))))

(when (and (tsm-installed? :hcl) (tsm-installed? :python))
  (describe "injections: an HCL heredoc as Python"
    (test "the heredoc's identifier names the language; its pieces are one document"
      (let (src "x = <<-PY\n  def f(): return \"${var.a}\"\nPY\n"
            injections {:rules [{:content {:kind :template_literal :parent :heredoc_template}
                                 :lang-from :heredoc_identifier
                                 :aliases {"PY" :python}}]
                        :faces {:python {:string :py-string :identifier :py-name}}}
            host {:heredoc_template :str}
            tree (editor/treesit/open-tree src :hcl)
            spans (%tree-sitter-spans src :hcl host true injections))
        ;; Python's `""` spans the `${var.a}` between its quotes; each quote is its own piece
        (assert= spans
          [[4 12 :str]
            [12 15 :__keyword__]
            [16 17 :py-name]
            [21 27 :__keyword__]
            [28 29 :py-string]
            [29 37 :str]
            [37 38 :py-string]
            [38 41 :str]])
        (assert= (%tree-sitter-tree-spans tree host true 0 (string/length src) injections) spans)
        (editor/treesit/free-tree tree)))))

;; ---- a node's anonymous children: the parent's own tokens --------------------------------

(when tsm-grammars?
  (describe "node-children with all?"
    (test "the parent's tokens come with its named children, in source order"
      (let (src "f(a, b)\n"
            shape (fn (kids)
                    (map kids (fn (k) [(->string (:kind k)) (:start k) (:end k) (:named k)])))
            tree (editor/treesit/open-tree src :elixir))
        (assert= (shape (editor/treesit/node-children src :elixir 2 true))
          '(["(" 1 2 false] ["identifier" 2 3 true]
             ["," 3 4 false]
             ["identifier" 5 6 true]
             [")" 6 7 false]))
        ;; without all? only the named ones, as the motions have always had them
        (assert= (shape (editor/treesit/node-children src :elixir 2))
          '(["identifier" 2 3 true] ["identifier" 5 6 true]))
        ;; the held tree answers alike, through the wrapper and the primitive
        (assert= (editor/treesit/node-children src :elixir 2 true tree)
          (editor/treesit/node-children src :elixir 2 true))
        (assert= (%tree-sitter-tree-kids tree 2 true) (%tree-sitter-kids src :elixir 2 true))
        (editor/treesit/free-tree tree)))))

(when (tsm-installed? :hcl)
  (describe "node-children with all?: an HCL block's braces"
    (test "the braces after a block's labels are in the block's children"
      ;; HCL wraps each brace in a named one-character node (`block_start`, `block_end`):
      ;; a matcher compares a child's extent with the brace token's, as it lifts a wrapper
      (let (src "resource \"a\" \"b\" {\n  x = 1\n}\n"
            kids (%tree-sitter-kids src :hcl 18 true))
        (assert= (map kids (fn (k) [(:kind k) (:start k) (:end k)]))
          '([:identifier 0 8] [:string_lit 9 12]
             [:string_lit 13 16]
             [:block_start 17 18]
             [:body 21 26]
             [:block_end 27 28]))))))

;; ADR-495: a tree handle is its owner's. Before it the handles lived in one runtime-wide LRU of
;; 32, so a 33rd tree opened ANYWHERE — another test running beside this one — dropped the
;; oldest, and "an edit inside an embedded document…" above saw `true` (a fresh parse) where
;; it asked for `[[12 13]]`, once in a while. These say it deterministically.
(when tsm-grammars?
  (describe "tree handles are owned"
    (test "a held tree outlives forty trees another process opens, and updates incrementally"
      (let (tree (open-tree tsm-inject-src :elixir)
            parent (self)
            [child monitor] (spawn-monitor (let (others (into []
                                                          (map (range 0 40)
                                                            (fn (_)
                                                              (open-tree tsm-inject-src :elixir)))))
                                             (send parent [:opened others])
                                             (receive (:done :ok) (after test/*wait-ms* :timeout))))
            others (receive ([:opened others] others) (after test/*wait-ms* []))
            edited (str (string/substring tsm-inject-src 0 12)
                     "\""
                     (string/substring tsm-inject-src 12 (string/length tsm-inject-src))))
        (assert= (count others) 40)
        (assert (tree-alive? tree))
        (let (next (update-tree tree edited :elixir))
          ;; reparsed from the held tree: what the edit changed, not `true`
          (assert= (tree-changes next) [[12 13]])
          (free-tree next))
        ;; the child's trees go with it — and only its own
        (send child :done)
        (assert= (receive ([:down ^monitor _ _] :down) (after test/*wait-ms* :timeout)) :down)
        (assert (every? others (fn (other) (not (tree-alive? other)))))
        (assert (tree-alive? tree))
        (free-tree tree)))

    (test "a task's tree dies with it unless it gives the tree to the process it replies to"
      (let (parent (self)
            [_ kept-monitor] (spawn-monitor (let (tree (open-tree "x = 1\n" :elixir))
                                              (send parent [:kept tree (give-tree tree parent)])))
            [_ dropped-monitor] (spawn-monitor (send parent
                                                 [:dropped (open-tree "y = 2\n" :elixir)]))
            [kept given?] (receive
                            ([:kept tree given?] [tree given?])
                            (after test/*wait-ms* [nil :timeout]))
            dropped (receive ([:dropped tree] tree) (after test/*wait-ms* nil)))
        (receive ([:down ^kept-monitor _ _] :down) (after test/*wait-ms* :timeout))
        (receive ([:down ^dropped-monitor _ _] :down) (after test/*wait-ms* :timeout))
        (assert= given? true)
        (assert (tree-alive? kept))
        (assert= (tree-changes kept) true)
        (assert (not (tree-alive? dropped)))
        (assert= (tree-changes dropped) nil)
        (assert= (free-tree kept) true)))

    (test "only a tree's owner can give it away"
      (let (tree (open-tree "x = 1\n" :elixir)
            parent (self)
            _ (spawn (send parent
                       [:gave
                         (check-allow :discarded-catch
                           (try (give-tree tree (self)) (catch e (error-message e))))]))
            answer (receive ([:gave answer] answer) (after test/*wait-ms* :timeout)))
        (assert (includes? answer "does not own"))
        (assert (tree-alive? tree))
        (assert= (give-tree tree parent) true)
        (free-tree tree)))))

;; ADR-496: a rule's `:exclude` cuts the content's descendants it selects out of the embedded
;; document, and they keep the host's colours; and pieces with a line break between them parse
;; as separate lines.
(when tsm-grammars?
  (describe "injections: :exclude and line breaks"
    (test "an excluded descendant keeps the host's colour and is not part of the document"
      (let (src "y = \"def m#{x}\nend\n\"\n"
            host {:string :str}
            ruby {:string :rb-str :identifier :rb-id})
        ;; without :exclude Ruby takes the whole text, the interpolation inside its string
        (assert= (%tree-sitter-spans src
                   :elixir host
                   false
                   {:rules [{:content :string :lang :ruby}] :faces {:ruby ruby}})
          [[4 20 :rb-str]])
        ;; with it the `#{x}` is the host's string, and Ruby parses the text on either side
        (assert= (%tree-sitter-spans src
                   :elixir host
                   false
                   {:rules [{:content :string :exclude :interpolation :lang :ruby}]
                    :faces {:ruby ruby}})
          [[4 10 :rb-str] [10 14 :str] [14 20 :rb-str]])
        (assert= (count (editor/treesit/injection-problems {:rules [{:content :string
                                                                     :exclude {:kind :interpolation
                                                                               :feild 1}
                                                                     :lang :ruby}]
                                                            :faces {:ruby ruby}}))
          1)))))

;; The Dockerfile and bash grammars are not built in: the test reads them from
;; $BROOD_TEST_GRAMMARS, else bedit's grammar directory, and is skipped without them. Loaded
;; HERE, at file load, never inside a test: a load moves the grammar epoch, and a held tree in
;; a test running beside it would then reparse from scratch.
(defn- tsm-load-grammar? (file-name lang)
  (let (path (str tsm-grammar-dir "libtree-sitter-" file-name ".so"))
    (and (file/exists? path)
      (check-allow :discarded-catch
        (try (do (%tree-sitter-load-grammar path lang) true) (catch _ false))))))
(def tsm-docker?
  (and (tsm-load-grammar? "dockerfile" :dockerfile) (tsm-load-grammar? "bash" :bash)))

(when tsm-docker?
  (describe "injections: a Dockerfile heredoc as bash"
    ;;  0         10      17      24   29                          53  56
    ;;  RUN <<EOT\necho a\necho b\nEOT\nRUN cat <<EOF > /x && ls\nhi\nEOF\n
    (def tsm-docker-src "RUN <<EOT\necho a\necho b\nEOT\nRUN cat <<EOF > /x && ls\nhi\nEOF\n")
    (def tsm-docker-host {:heredoc_marker :marker :heredoc_end :end})
    (def tsm-docker-bash {:command_name :cmd :word :w :ERROR :err :file_redirect :redirect})

    (test "the <<EOT marker and the closing EOT stay the host's; bash parses the rest"
      (assert= (%tree-sitter-spans tsm-docker-src
                 :dockerfile tsm-docker-host
                 false
                 {:rules [{:content {:kind :shell_fragment :parent :shell_command}
                           :exclude :heredoc_marker
                           :lang :bash}
                           {:content :heredoc_block :exclude :heredoc_end :lang :bash}]
                  :faces {:bash tsm-docker-bash}})
        [[4 9 :marker]
          [10 14 :cmd]
          [15 16 :w]
          [17 21 :cmd]
          [22 23 :w]
          [24 27 :end]
          [32 35 :cmd]
          [36 41 :marker]
          [42 46 :redirect]
          [50 52 :cmd]
          [53 55 :cmd]
          [56 59 :end]]))

    (test "heredoc lines handed over one by one still parse as lines"
      ;; before ADR-496 the parser saw `echo a echo b`: the second `echo` was an argument
      (assert= (%tree-sitter-spans tsm-docker-src
                 :dockerfile tsm-docker-host
                 false
                 {:rules [{:content :heredoc_line :lang :bash}] :faces {:bash tsm-docker-bash}})
        [[4 9 :marker]
          [10 14 :cmd]
          [15 16 :w]
          [17 21 :cmd]
          [22 23 :w]
          [24 27 :end]
          [36 41 :marker]
          [53 55 :cmd]
          [56 59 :end]]))))

;; ADR-495: a holder's sweep — what the calling process owns, so it can free what it lost track of.
(when tsm-grammars?
  (describe "owned-trees"
    (test "lists the trees this process owns: not a freed one, not another process's"
      (let (parent (self)
            kept (open-tree "x = 1\n" :elixir)
            freed (open-tree "y = 2\n" :elixir)
            [child _] (spawn-monitor (let (theirs (open-tree "z = 3\n" :elixir))
                                       (send parent [:theirs theirs])
                                       (receive (:done :ok) (after test/*wait-ms* :timeout))))
            theirs (receive ([:theirs tree] tree) (after test/*wait-ms* nil)))
        (free-tree freed)
        ;; a test runs in its own process, so this one owns exactly what it opened
        (assert= (owned-trees) [kept])
        (is (tree-alive? theirs))
        (free-tree kept)
        (assert= (owned-trees) [])
        (send child :done)))))

;; ---- grammar drift: the names a language wrote against the grammar it has (ADR-583) ------

(describe "language-names: every kind and field a language's tables refer to"
  (test "faces, injections, indent and definitions, each by its own shape"
    (assert= (language-names {:faces {:string :s
                                      {:kind :identifier
                                       :field :name
                                       :parent {:kind :call :field :function}} :f
                                      {:text "def"} :k}
                              :injections [{:content {:kind :heredoc_template :parent :heredoc}
                                            :exclude :heredoc_marker
                                            :lang-from :heredoc_identifier
                                            :aliases {"BASH" :bash}}]
                              :indent {:width 2
                                       :blocks #{:do_block}
                                       :brackets #{:arguments}
                                       :dedent #{"end"}
                                       :opens #{"{"}
                                       :verbatim #{:heredoc_body}}
                              :definitions {:kinds #{:method} :calls #{"def"}}})
      {:kinds #{:string
                :identifier :call :heredoc_template :heredoc :heredoc_marker :heredoc_identifier
                :do_block :arguments :heredoc_body :method}
       :fields #{:name :function}}))

  (test "an empty language refers to nothing"
    (assert= (language-names {}) {:kinds #{} :fields #{}})))

(def tsm-drift-info
  {:lang :demo :abi 14 :named #{:call :identifier} :anonymous #{:def} :fields #{:name}})

(describe "grammar-problems: what the grammar lacks, named"
  (test "a grammar with every name has no problems; anonymous tokens and ERROR count"
    (assert= (grammar-problems tsm-drift-info {:kinds #{:call :def :ERROR} :fields #{:name}}) '()))

  (test "each missing kind and field is its own message, sorted, naming the grammar"
    (assert= (grammar-problems tsm-drift-info
               {:kinds #{:heredoc_body :call :alpha} :fields #{:body}})
      '("node kind `alpha` is not in the :demo grammar" "node kind `heredoc_body` is not in the :demo grammar"
         "field `body` is not in the :demo grammar")))

  (test "no grammar at all is one problem, not a raise"
    (assert= (language-grammar-problems :tsm-no-such-grammar {:faces {:x :y}})
      '("no :tsm-no-such-grammar grammar to check"))))

(describe "grammar-fingerprint: the grammar's shape, not its bytes"
  (test "the same names hash alike whatever their order; a renamed node does not"
    (let (a {:abi 14 :named #{:call :identifier} :anonymous #{:def} :fields #{:name}}
          b {:abi 14
             :named #{:identifier :call}
             :anonymous #{:def}
             :fields #{:name}
             :source "/x.so"}
          renamed {:abi 14 :named #{:call :ident} :anonymous #{:def} :fields #{:name}}
          other-abi (assoc a :abi 15))
      (assert= (grammar-fingerprint a) (grammar-fingerprint b))
      (refute (= (grammar-fingerprint a) (grammar-fingerprint renamed)))
      (refute (= (grammar-fingerprint a) (grammar-fingerprint other-abi))))))

(when tsm-grammars?
  (describe "grammar-info: a built-in grammar's vocabulary"
    (test "kinds, tokens, fields and ABI come from the grammar itself"
      (let (info (grammar-info :ruby))
        (assert= (:lang info) :ruby)
        (is (int? (:abi info)))
        (is (contains? (:named info) :method))
        (is (contains? (:anonymous info) :def))
        (is (contains? (:fields info) :name))
        ;; a hidden rule is never a node's kind
        (refute (contains? (:named info) :_statement))))

    (test "a language checked against it: present names pass, a renamed one is reported"
      (assert= (language-grammar-problems :ruby
                 {:faces {:method :f {:parent :method :field :name} :g}})
        '())
      (assert= (language-grammar-problems :ruby {:faces {:method_definition :f}})
        '("node kind `method_definition` is not in the :ruby grammar")))))

;; A grammar load moves only ITS language's epoch: a held Elixir tree still reparses
;; incrementally after the HCL grammar loads. One runtime-wide counter made every held tree of
;; every language parse afresh whenever any grammar loaded — a file of a new language opened.
(when (and tsm-grammars? (file/exists? (str tsm-grammar-dir "libtree-sitter-hcl.so")))
  (describe "a grammar load leaves other languages' trees incremental"
    (test "an Elixir tree reparses incrementally across an HCL grammar load"
      (let (src "x = 1\ny = 2\n"
            tree (open-tree src :elixir)
            _ (%tree-sitter-load-grammar (str tsm-grammar-dir "libtree-sitter-hcl.so") :hcl)
            next (update-tree tree "x = 1\ny = 23\n" :elixir))
        (is (vector? (tree-changes next)))
        (free-tree tree)
        (free-tree next)))))

(describe "grammar-info without a grammar"
  (test "raises, as a parse would"
    (is (check-allow :discarded-catch
          (try (do (grammar-info :tsm-no-such-grammar) false) (catch _ true))))))

;; Fetching at a revision and the manifest, against a local repository: `file://` is a git
;; URL, so this is the real fetch path with no network. The "grammar" is a C file with the
;; generator's ABI line — enough to compile; nothing here loads it.
(def tsm-git? (and (os/which "git") (os/which "cc")))

(defn- tsm-git (dir & args)
  (os/cmd "git"
    (append ["-C" dir "-c" "user.name=t" "-c" "user.email=t@t" "-c" "commit.gpgsign=false"] args)))

(defn- tsm-commit (repository text)
  ;; write `text` as the grammar's parser.c, commit it, answer the commit
  (file/spit (path/join repository "src" "parser.c")
    (str "#define LANGUAGE_VERSION 14\nint tree_sitter_demo(void) { return " text "; }\n"))
  (tsm-git repository "add" "-A")
  (tsm-git repository "commit" "-q" "-m" text)
  (string/trim (:stdout (tsm-git repository "rev-parse" "HEAD"))))

(purge-stale-temp "brood-grammarpin-")

(when tsm-git?
  (describe "grammar-install at a revision, and the manifest it writes"
    (test "installs the pinned commit, records it, and moves to another on the next install"
      (let (root (temp-dir "brood-grammarpin-")
            repository (path/join root "repo")
            out (path/join root "out")
            work (path/join root "work")
            url (str "file://" repository))
        (file/mkdir (path/join repository "src"))
        (tsm-git repository "init" "-q")
        (let (first-commit (tsm-commit repository "1")
              second-commit (tsm-commit repository "2")
              pinned (grammar-install url :demo out work {:revision first-commit})
              library (path/join out "libtree-sitter-demo.so")
              manifest (grammar-manifest library))
          (assert= pinned {:ok library :commit first-commit})
          (is (includes? (file/slurp (path/join work "demo" "src" "parser.c")) "return 1;"))
          (assert= (:revision manifest) first-commit)
          (assert= (:commit manifest) first-commit)
          (assert= (:source manifest) url)
          (assert= (:abi manifest) 14)
          (assert= (:sha256 manifest) (grammar-file-hash library))
          ;; the same checkout moved to the default branch's head: an update
          (let (updated (grammar-install url :demo out work))
            (assert= (:commit updated) second-commit)
            (assert= (:revision (grammar-manifest library)) nil)
            (assert= (:commit (grammar-manifest library)) second-commit))
          ;; and back to the pin; an abbreviated hash cannot be fetched, and says so
          (assert= (:commit (grammar-fetch url (path/join work "demo") first-commit)) first-commit)
          (is (includes? (:error (grammar-fetch url
                                   (path/join work "demo")
                                   (string/substring first-commit 0 12)))
                "abbreviated")))
        (file/rmdir root)))

    (test "a revision the repository does not have is an error, not the default branch"
      (let (root (temp-dir "brood-grammarpin-")
            repository (path/join root "repo"))
        (file/mkdir (path/join repository "src"))
        (tsm-git repository "init" "-q")
        (tsm-commit repository "1")
        (is (contains? (grammar-fetch (str "file://" repository) (path/join root "work") "v9.9.9")
              :error))
        (file/rmdir root)))))

(describe "the manifest's place"
  (test "beside the library, not a library itself"
    (assert= (grammar-manifest-path "/g/libtree-sitter-c-sharp.so")
      "/g/libtree-sitter-c-sharp.manifest"))
  (test "a library with no manifest has none"
    (assert= (grammar-manifest "/nonexistent/libtree-sitter-x.so") nil)))

;; A library rebuilt IN PLACE and loaded again is the new build (ADR-583). The dynamic loader
;; answers a name it has opened with the object it already has, so before the private
;; content-named copy this kept parsing with the first build until the process restarted.
;; Two one-line shims export the same entry point, `tree_sitter_tsswap`, each answering a
;; different installed grammar (JSON, then TOML) — two builds of one "language" whose node
;; kinds tell them apart, compiled in a moment.
(defn- tsm-shim (dir grammar out)
  ;; a library exporting `tree_sitter_tsswap` that answers `grammar`'s language
  (let (source (path/join dir (str "shim-" grammar ".c"))
        entry (str "tree_sitter_" grammar))
    (file/spit source
      (str "extern const void *" entry "(void);\n"
        "const void *tree_sitter_tsswap(void) { return " entry "(); }\n"))
    (os/cmd "cc"
      ["-shared" "-fPIC" "-o" out source (str "-L" tsm-grammar-dir)
       (str "-l:libtree-sitter-" grammar ".so") (str "-Wl,-rpath," tsm-grammar-dir)])))

(when (and (os/which "cc")
        (file/exists? (str tsm-grammar-dir "libtree-sitter-json.so"))
        (file/exists? (str tsm-grammar-dir "libtree-sitter-toml.so")))
  (describe "a grammar replaced at the same path and loaded again"
    (test "the new build is the one in use, and a held tree of it parses afresh"
      (let (root (temp-dir "brood-grammarpin-")
            library (path/join root "libtree-sitter-tsswap.so")
            built-json (path/join root "json.so")
            built-toml (path/join root "toml.so"))
        (file/mkdir root)
        (tsm-shim root "json" built-json)
        (tsm-shim root "toml" built-toml)
        (file/cp built-json library)
        (%tree-sitter-load-grammar library :tsswap)
        (let (first-info (grammar-info :tsswap)
              tree (open-tree "{\"a\": 1}\n" :tsswap))
          (is (contains? (:named first-info) :object))
          ;; rebuilt in place: a new file at the same path
          (file/rm library)
          (file/cp built-toml library)
          (%tree-sitter-load-grammar library :tsswap)
          (let (second-info (grammar-info :tsswap))
            (is (contains? (:named second-info) :table))
            (refute (contains? (:named second-info) :object))
            (assert= (:source second-info) library)
            (refute (= (grammar-fingerprint first-info) (grammar-fingerprint second-info)))
            ;; a parse is the new grammar's, and the held tree of the old one is not
            ;; reparsed from: what changed is everything
            (assert= (:kind (%tree-sitter-parse "a = 1\n" :tsswap)) :document)
            (let (next (update-tree tree "a = 1\n" :tsswap))
              (assert= (tree-changes next) true)
              (free-tree next)))
          (free-tree tree))
        ;; the same build loaded again is the object already loaded, not a second one
        (%tree-sitter-load-grammar library :tsswap)
        (is (contains? (:named (grammar-info :tsswap)) :table))
        (file/rmdir root)))))
