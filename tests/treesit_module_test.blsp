;; std/editor/treesit.blsp (ROADMAP §C): the language-agnostic services over
;; `tree-sitter-parse`'s positioned CST — `fontify` (kind→face colour spans) and
;; the pure structural motions. Requires `editor/highlight` for the shared
;; `:syntax/*` face registry (the editor always loads it).
;;
;; Register-only — discovered and run by `nest test` (and `brood --test`).

(defmodule treesit-module-test
  (:use test)
  (:use editor/treesit))

;; `editor/highlight` must be loaded for effect — it registers the `:syntax/*`
;; faces the fontify comparisons below resolve against. The file references none
;; of its names, so name one export to auto-require the module at load time; the
;; value is discarded.
(def tsm-highlight-loaded? (fn? editor/highlight/highlight-spans))

;; The ruby/elixir grammars are opt-in (--features treesit-grammars); the kernel
;; ships none by default. Skip these suites when absent so a bare `cargo test`
;; stays green — `make test` builds them in and runs them.
(defn tsm-grammar? (lang)
  ;; check-allow :discarded-catch — probing whether a grammar is compiled in: the error is the answer
  (check-allow :discarded-catch (try (do (%tree-sitter-parse "" lang) true) (catch _ false))))
(def tsm-grammars? (and (tsm-grammar? :ruby) (tsm-grammar? :elixir)))

;; A small Ruby method, used across the navigation tests. Offsets:
;;   0       8         18  22
;;   def foo\n  x = 1\nend\n
(def rb "def foo\n  x = 1\nend\n")

(def rb-faces
  {:comment :syntax/comment
   :string :syntax/string
   :integer :syntax/number
   :def :syntax/keyword
   :end :syntax/keyword
   :identifier :syntax/function})

; end (when tsm-grammars? …) — grammar-dependent suites
(when tsm-grammars?

  ; named ⇒ not a keyword
  (describe "treesit fontify"
    (test "produces ascending, non-overlapping [start end face] spans"
      (let (spans (editor/treesit/fontify rb :ruby (editor/treesit/face-of-kinds rb-faces)))
        (is (not (empty? spans)))
        ;; every span is [start end face] with start < end, and starts ascend
        (is (every? spans (fn (s) (< (first s) (second s)))))
        (is (= spans (sort-by spans first)))))

    (test "colours a whole comment node (delimiter + content) as one span"
      (let (src "x = 1 # note\n"
            spans (editor/treesit/fontify src :ruby (editor/treesit/face-of-kinds rb-faces))
            cspan (first (filter spans (fn (s) (= (nth s 2) (editor/face/face :syntax/comment))))))
        (refute (nil? cspan))
        ; "# note" starts at col 6
        (assert= (first cspan) 6)
        (assert= (second cspan) 12)))

    ;; The walk builds ONE accumulator and reverses it once, rather than `mapcat`-ing a
    ;; fresh list per level (O(nodes × depth) allocation for O(nodes) of work — the dominant
    ;; half of an editor's per-keystroke fontify). Source order is therefore a property of
    ;; the reversal, not of the concatenation, so it is worth pinning on something DEEP:
    ;; a nested method body whose spans must still come out ascending and unduplicated.
    (test "source order survives nesting, at depth"
      (let (src "class A\n  def a # one\n    if x # two\n      y # three\n    end\n  end\nend\n"
            spans (editor/treesit/fontify src :ruby (editor/treesit/face-of-kinds rb-faces))
            starts (map spans first)
            comments (filter spans
                       (fn (sp) (= (nth sp 2) (editor/face/face :syntax/comment)))))
        ;; every span, at every depth, in source order and none emitted twice
        (assert= starts (sort starts))
        (assert= (count (seq/distinct starts)) (count starts))
        ;; the three comments come out at their three nesting levels, delimiter included
        (assert= (map comments (fn (sp) (string/substring src (first sp) (second sp))))
          (list "# one" "# two" "# three"))))

    (test "an unmapped kind yields no span for that node (descends instead)"
      ;; with an empty table nothing is coloured
      (let (spans (editor/treesit/fontify rb :ruby (editor/treesit/face-of-kinds {})))
        (is (empty? spans))))

    (test "face-of-syntax colours keywords via the anonymous-token heuristic"
      ;; the table names NO keywords; `def`/`end` (anonymous alphabetic tokens) are
      ;; coloured :syntax/keyword by `face-of-syntax` — the path the editor modes use.
      (let (spans (editor/treesit/fontify rb :ruby (editor/treesit/face-of-syntax {}))
            kw (editor/face/face :syntax/keyword)
            kw-spans (filter spans (fn (s) (= (nth s 2) kw))))
        ; def + end
        (is (>= (count kw-spans) 2))
        ; "def" at col 0
        (assert= (first (first kw-spans)) 0)
        (assert= (second (first kw-spans)) 3)))

    (test "anonymous-keyword? distinguishes alphabetic tokens from punctuation"
      (is (editor/treesit/anonymous-keyword? {:named false :text "def"}))
      (is (editor/treesit/anonymous-keyword? {:named false :text "end"}))
      (refute (editor/treesit/anonymous-keyword? {:named false :text "("}))
      (refute (editor/treesit/anonymous-keyword? {:named false :text "="}))
      (refute (editor/treesit/anonymous-keyword? {:named true :text "foo"}))))

  ;; ---- the windowed-fontify restart ----------------------------------------
  ;; Measured in bedit against a WHOLE-FILE parse (the only honest baseline): on ordinary
  ;; code this cuts a 245-line window to 45 and 29 ms to 5 ms with zero span differences;
  ;; inside a heredoc it declines and matches the full lead-in exactly.
  (describe "treesit column0-restart"
    (def rs-delims ["\"\"\"" "'''"])

    (test "restarts at the previous column-0 line"
      (let (src "defmodule A do\n  def a do\n    1\n  end\nend\n"
            pos (index-of src "    1"))
        ;; the enclosing top-level form, not the indented line the viewport starts on
        (assert= (editor/treesit/column0-restart src pos rs-delims) 0)))

    (test "a column-0 line IS its own restart point"
      (let (src "defmodule A do\nend\ndefmodule B do\nend\n"
            pos (index-of src "defmodule B"))
        (assert= (editor/treesit/column0-restart src pos rs-delims) pos)))

    ;; the whole reason for the guard: prose in a heredoc that looks like code
    (test "declines a candidate inside an open heredoc"
      (let (src "defmodule A do\n  @moduledoc \"\"\"\ndef not_code(x) do\nmore prose\n"
            pos (index-of src "more prose"))
        ;; one delimiter seen and not closed -> fall back to the top of the window
        (assert= (editor/treesit/column0-restart src pos rs-delims) 0)))

    (test "accepts again once the heredoc has closed"
      (let (src "defmodule A do\n  @moduledoc \"\"\"\nprose\n  \"\"\"\nend\ndefmodule B do\n"
            pos (index-of src "defmodule B"))
        (assert= (editor/treesit/column0-restart src pos rs-delims) pos)))

    (test "no delimiters to count means every column-0 line is taken"
      (let (src "a\n  b\nc\n" pos (index-of src "c"))
        (assert= (editor/treesit/column0-restart src pos []) pos)))

    (test "the top of the window is always a valid answer"
      (assert= (editor/treesit/column0-restart "" 0 rs-delims) 0)
      ;; nothing above is in column 0 — there is nowhere to cut, so keep the whole window
      (assert= (editor/treesit/column0-restart "  indented only\n" 0 rs-delims) 0))

    ;; the caller passes a line start, but an offset mid-line must still answer about THAT
    ;; line rather than about the character it happens to land on
    (test "an offset inside a line is normalised to the line"
      (let (src "defmodule A do\n  some indented thing\n")
        (assert= (editor/treesit/column0-restart src 20 rs-delims) 0)
        (assert= (editor/treesit/column0-restart src 5 rs-delims) 0))))

  (describe "treesit structural navigation"
    (test "point-forward lands at the end of the next named node"
      ;; from col 0 the next top-level node is the whole `def…end` method
      (let (end (editor/treesit/point-forward rb :ruby 0))
        (is (> end 0))
        (assert= (string/substring rb 0 3) "def")))

    (test "point-defun-start finds the enclosing top-level node"
      ;; col 11 is inside the body; the method begins at 0
      (assert= (editor/treesit/point-defun-start rb :ruby 11) 0))

    ; module body, no def → the module
    (test "point-defun-start finds the enclosing def, not the whole module (Elixir)"
      ;; def is a `call` to a def-macro, nested in the module's do-block — C-M-a must land on
      ;; the enclosing def, not the file top (the bug: it always jumped to the module start).
      (let (ex "defmodule A do\n  def f, do: 1\n  def g, do: 2\nend\n")
        ; inside def f → def f's start
        (assert= (editor/treesit/point-defun-start ex :elixir 18) 17)
        ; inside def g → def g's start
        (assert= (editor/treesit/point-defun-start ex :elixir 36) 32)
        (assert= (editor/treesit/point-defun-start ex :elixir 14) 0)))
    (test "point-up rises to the enclosing node's start"
      (let (up (editor/treesit/point-up rb :ruby 11))
        (is (>= up 0))
        (is (< up 11))))

    (test "motions are no-ops with nothing to move to"
      ;; past the end, forward stays put
      (assert= (editor/treesit/point-forward rb :ruby (string/length rb)) (string/length rb)))))
