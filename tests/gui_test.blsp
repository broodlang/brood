;; `gui/open`'s opts map — the window attributes that can only be set while the
;; window is *built* (`:decorations`, `:app-id`). Only the *parsing* is testable
;; here: it runs before any window exists, so it behaves identically on a
;; `--features gui` runtime and on one without (where the call goes on to raise
;; "gui backend not compiled in"). Actually opening a window is deliberately not
;; tested — `nest test` runs on a real desktop, and a test that opened one would
;; flash a window across the screen on every run.

(defmodule gui-test (:use test))

(describe "gui/open — the build-time opts map"
  ;; A silently-ignored bad `:app-id` would be the worst outcome: the window opens
  ;; anyway, and the only symptom is the desktop quietly falling back to its generic
  ;; icon — exactly the bug the key exists to fix.
  (test "a non-string :app-id is a type error, not an ignored key"
    (assert-error (gui/open nil nil nil {:app-id 42})))

  (test "an empty :app-id is rejected — it would match no desktop entry"
    (assert-error (gui/open nil nil nil {:app-id ""})))

  (test "the opts map is the last argument — a 5th is an arity error"
    (assert-error (gui/open nil nil nil {} :extra))))

(describe "gui/font — the one-arg (global default) form"
  ;; The wrapper used to nil-pad `spec` (&optional), so the documented one-arg form
  ;; `(gui/font spec)` reached `%gui-font!` as TWO args and the spec map landed in
  ;; the window-id slot: "expected int, got map" (found by bedit's startup). The
  ;; lone map must parse as the spec. Testable on any build: the argument parse
  ;; runs before the backend call, so a runtime without --features gui raises its
  ;; own "not compiled in" error — never the type error asserted absent here.
  (test "a lone spec map is the spec, never a window id"
    (let (msg (try
                (do (gui/font {:height 15 :family :mono}) "")
                (catch e (error-message e))))
      (is (not (includes? msg "expected int"))))))

(describe "gui/grab-cursor"
  ;; No window here, so the call can only fail — but it must fail in the BACKEND (no such
  ;; window, or no gui compiled in), which means the wrapper handed the primitive an int
  ;; id and the flag in the right places. A swapped or dropped argument fails before that.
  (test "reaches the backend with the id and the flag, and a non-int id is refused first"
    (let (msg (try
                (do (gui/grab-cursor 999999 true) "")
                (catch e (error-message e))))
      (is (not (includes? msg "expected int")))
      (is (not (includes? msg "arity"))))
    (is (includes? (try
                     (check-allow :type-mismatch (gui/grab-cursor true 999999))
                     (catch e (error-message e)))
          "expected int"))))

;; --- the pixel-space layer: policy in Brood over the runtime's two quad ops -----------
;;
;; `gui/line`, `gui/sprite` and `gui/texture-size` are pure (no window), so they run
;; in full on every build. `gui/texture` allocates its handle and records the size
;; BEFORE the upload reaches the backend, so what can be pinned without a window is the
;; validation order: a mismatched buffer is refused, and a good one reaches the backend
;; (whose "no such window" is a different error).

(describe "gui/line — a line is a rotated quad"
  (test "a horizontal line is a flat quad centred on the segment"
    (assert= (gui/line 0 0 10 0 :red) [:quad 0.0 -0.5 10.0 1.0 :red 0.0]))

  (test "a vertical line turns a quarter turn and takes its width"
    (let ([tag x y w h color rot] (gui/line 0 0 0 10 [1 2 3 4] 3))
      (assert= [tag x y w h color] [:quad -5.0 3.5 10.0 3.0 [1 2 3 4]])
      (is (< (math/abs (- rot (/ math/pi 2))) 1e-9))))

  (test "the width floors at one pixel — a hairline, never nothing"
    (assert= (nth (gui/line 0 0 4 0 :red 0) 4) 1.0)))

(describe "gui/sprite — a source rect and flips become a UV rect"
  (test "no opts is the whole texture, opaque white, unrotated"
    (assert= (gui/sprite 0 10 20 32 32)
      [:sprite 0 10 20 32 32 [0.0 0.0 1.0 1.0] [255 255 255 255] 0.0]))

  (test "a flip mirrors by negating the extent and moving the origin"
    (assert= (nth (gui/sprite 0 1 2 3 4 {:flip-x true}) 6) [1.0 0.0 -1.0 1.0])
    (assert= (nth (gui/sprite 0 1 2 3 4 {:flip-y true}) 6) [0.0 1.0 1.0 -1.0]))

  (test "tint and rotation pass through, rotation as a float"
    (let (op (gui/sprite 0 1 2 3 4 {:tint :red :rot 1}))
      (assert= (nth op 7) :red)
      (assert= (nth op 8) 1.0)))

  ;; A `:src` needs the texture's size to become a UV rect, and only `gui/texture`
  ;; records one; for a handle it never saw the src is ignored rather than guessed.
  (test "a :src on an unknown handle draws the whole texture"
    (assert= (nth (gui/sprite 0 1 2 3 4 {:src [1 0 1 1]}) 6) [0.0 0.0 1.0 1.0]))

  (test "texture-size is nil for a handle never uploaded"
    (assert= (gui/texture-size 0) nil)))

(describe "gui/texture — validated before it reaches the backend"
  (test "a byte count that is not w*h*4 is a clean error"
    (let (msg (try (gui/texture 999999 [1 2 3] 1 1) :no-error (catch e (error-message e))))
      (is (includes? msg "bytes of rgba"))))

  (test "a negative dimension is a clean error"
    (assert-error (gui/texture 999999 [1 2 3 4] -1 1)))

  (test "a correctly-sized buffer passes validation and reaches the backend"
    (let (msg (try (gui/texture 999999 [1 2 3 4] 1 1) :no-error (catch e (error-message e))))
      (is (or (= msg :no-error) (not (includes? msg "bytes of rgba"))))))

  (test "the image-map form is the bytes form"
    (let (msg (try
                (gui/texture 999999 {:width 1 :height 1 :rgba [1 2 3]})
                :no-error (catch e (error-message e))))
      (is (includes? msg "bytes of rgba")))))

(describe "gui/open — the pixel-input and vsync options"
  ;; Parsed before any window exists, like :app-id above: on a build without the gui
  ;; feature the call still reaches the "not compiled in" error, never a parse error.
  (test "an :input other than :pixels is not an error — it is the cell default"
    (let (msg (try
                (gui/open nil nil nil {:input :cells :vsync true})
                ""
                (catch e (error-message e))))
      (is (not (includes? msg "expected"))))))

(describe "gui/alloc-texture and gui/alloc-sound — one registry, however many processes allocate first"
  ;; The registries used to be created on first use by `(when (nil? *textures*) (def …))`:
  ;; N processes allocating their first handle at once each saw nil and each `def`'d a
  ;; table, so all but the last table's handles were orphaned — `texture-size` answered nil
  ;; for a handle just allocated, or another process's size when the two counters collided
  ;; (`ui_test`, full suite only, 2026-09-21). Every process must find its own handle's size.
  (test "forty processes each allocate a texture and a sound and read back their own"
    (let (me (self)
          n 40)
      (doseq (i (range n))
        (spawn (fn ()
                 (let (tex (gui/alloc-texture (+ i 1) 7)
                       snd (gui/alloc-sound (->float (+ i 1))))
                   (send me [:got i (gui/texture-size tex) (gui/sound-seconds snd)])))))
      (letrec (collect (fn (k acc)
                         (if (= k 0)
                           acc
                           (receive
                             ([:got i size secs] (collect (- k 1) (conj acc [i size secs])))
                             (after 5000 (collect 0 (conj acc [:timeout k])))))))
        (let (got (collect n []))
          (assert= n (count got))
          (doseq (r got)
            (let ([i size secs] r)
              (assert= [(+ i 1) 7] size)
              (assert= (->float (+ i 1)) secs))))))))

;; --- frame capture (ADR-609): what a window paints, as pixels -------------------------
;;
;; `gui/render-frame` paints through the window's own CPU painter with no window, so it
;; runs headless and on a desktop alike — but only in a --features gui runtime; without
;; one, it raises "not compiled in" and these tests check nothing (`when-gui`).

(defn- when-gui (check) (if (gui/available?) (check) (is true)))

(def- capture-bg [10 20 30])
(def- capture-band [200 40 40])

(defn- capture-spec ()
  {:width 400 :height 203 :inset 6 :bg capture-bg :size 15 :line-height 1.4})

(defn- ink-in (image x0 y0 w h)
  "How many pixels of the w×h rectangle at (x0, y0) are not the window background."
  (fold-for (acc 0
              y
              (range (math/round y0) (math/round (+ y0 h)))
              x
              (range (math/round x0) (math/round (+ x0 w))))
    (if (= (gui/pixel image x y) capture-bg) acc (inc acc))))

(defn- inked-rows (image x0 y0 w h)
  "The rows, counted from y0, of the w×h rectangle at (x0, y0) holding ink."
  (into [] (seq/filter (range h) (fn (dy) (> (ink-in image x0 (math/round (+ y0 dy)) w 1) 0)))))

(defn- lowercase-rows (size)
  "An `x` on each of three rows at `size` px and a line height of 1.25: the cell height
and, per row, the rows of its cell the `x` inks."
  (let (face {:fg [255 255 255]}
        image (gui/render-frame [[:clear]
                                  [:text 0 0 "x" face]
                                  [:text 1 0 "x" face]
                                  [:text 2 0 "x" face]]
                (assoc (capture-spec) :size size :line-height 1.25))
        [cell-w cell-h] (:cell image))
    [cell-h (map [0 1 2] (fn (row) (inked-rows image 6 (* row cell-h) cell-w cell-h)))]))

(describe "gui/render-frame — the window's painter, without a window"
  (test "row 0 starts at the window's top edge: a band on it is coloured from y = 0"
    (when-gui (fn ()
                (let (cols (first (:grid (gui/render-frame [[:clear]] (capture-spec))))
                      image (gui/render-frame [[:clear] [:rect 0 0 cols 1 {:bg capture-band}]]
                              (capture-spec))
                      [_ cell-h] (:cell image))
                  (is (= (:origin image) [6 0]))
                  (is (= (gui/pixel image 200 0) capture-band))
                  (is (= (gui/pixel image 200 (dec cell-h)) capture-band))
                  (is (= (gui/pixel image 200 cell-h) capture-bg))))))

  (test "the inset is a margin on the left, right and bottom; the leftover is below"
    (when-gui (fn ()
                (let (image (gui/render-frame [[:clear] [:rect 1 1 3 2 {:bg capture-band}]]
                              (capture-spec))
                      [cell-w cell-h] (:cell image)
                      [cols rows] (:grid image))
                  (is (= (:inset image) 6))
                  (is (= cols (math/quot (- 400 12) cell-w)))
                  (is (= rows (math/quot (- 203 6) cell-h)))
                  (is (= (gui/pixel image 3 (+ cell-h 2)) capture-bg))
                  (is (= (gui/pixel image (+ 6 cell-w) (+ cell-h 2)) capture-band))
                  (is (= (gui/pixel image (+ 6 cell-w) 202) capture-bg))))))

  (test "a band reaching the grid's edges bleeds through the margin to the window's"
    (when-gui (fn ()
                (let ([cols rows] (:grid (gui/render-frame [[:clear]] (capture-spec)))
                      image (gui/render-frame [[:clear]
                                                [:rect (dec rows) 0 cols 1 {:bg capture-band}]]
                              (capture-spec)))
                  (is (= (gui/pixel image 0 202) capture-band))
                  (is (= (gui/pixel image 399 202) capture-band))))))

  (test "a glyph's ink is inside its own cell"
    (when-gui (fn ()
                (let (image (gui/render-frame [[:clear] [:text 1 2 "M" {:fg [255 255 255]}]]
                              (capture-spec))
                      [cell-w cell-h] (:cell image)
                      x (+ 6 (* 2 cell-w)))
                  (is (> (ink-in image x cell-h cell-w cell-h) 10))
                  (is (= (ink-in image (- x cell-w) cell-h cell-w cell-h) 0))
                  (is (= (ink-in image (+ x cell-w) cell-h cell-w cell-h) 0))
                  (is (= (ink-in image x 0 cell-w cell-h) 0))
                  (is (= (ink-in image x (* 2 cell-h) cell-w cell-h) 0))))))

  (test "text whose face names no :fg is drawn in the window's text colour (ADR-613)"
    (when-gui (fn ()
                (let (ink [76 79 105]
                      image (gui/render-frame [[:clear]
                                                [:text 0 0 "█" {}]
                                                [:text 0 2 " " {:reverse true}]]
                              (assoc (capture-spec) :fg ink))
                      [cell-w cell-h] (:cell image)
                      middle-y (math/quot cell-h 2))
                  ;; a full block's middle, and a reversed blank's ground, are the colour
                  (is (= (gui/pixel image (+ 6 (math/quot cell-w 2)) middle-y) ink))
                  (is (= (gui/pixel image (+ 6 (* 2 cell-w) (math/quot cell-w 2)) middle-y) ink))))))

  (test "a lowercase letter sits on the same pixels in every row, in its row's middle (ADR-611)"
    (when-gui (fn ()
                (doseq (size [11 15 22])
                  (let ([cell-h rows] (lowercase-rows size)
                        [top bottom] [(first (first rows)) (last (first rows))]
                        middle (/ (+ (or top 0) (or bottom 0) 1) 2.0))
                    (is (every? rows (fn (inked) (= inked (first rows)))))
                    (is (<= (math/abs (- middle (/ cell-h 2.0))) 1.0))))))))

(describe "gui/write-png and gui/pixel"
  (test "a picture written as PNG decodes back to the same pixels, cropped and scaled"
    (when-gui (fn ()
                (let (image (gui/render-frame [[:clear] [:rect 0 0 2 1 {:bg capture-band}]]
                              (capture-spec))
                      path (str (path/temp "brood-capture-") ".png")
                      _ (gui/write-png image path {:crop [0 0 10 4] :scale 3})
                      back (gui/image-thumb (file/slurp-bytes path) 100 100))
                  (file/rm path)
                  (is (= [(:width back) (:height back)] [30 12]))
                  (is (= (gui/pixel back 0 0) capture-band))
                  (is (= (gui/pixel back 29 11) capture-band))))))

  (test "a pixel outside the picture is nil"
    (let (image {:width 1
                 :height 1
                 :rgba (bytes/concat (bytes/int-> 1 1)
                         (bytes/int-> 2 1)
                         (bytes/int-> 3 1)
                         (bytes/int-> 255 1))})
      (is (= (gui/pixel image 0 0) [1 2 3]))
      (is (nil? (gui/pixel image 1 0)))
      (is (nil? (gui/pixel image 0 -1)))))

  (test "an :rgba of the wrong length is refused"
    (assert-error (gui/write-png {:width 2 :height 2 :rgba (bytes/int-> 0 4)} "/nonexistent/x.png"))))

(describe "gui/capture"
  (test "a window that is not open is an error, not an empty picture"
    (assert-error (gui/capture 987654321))))

;; ADR-612: input→present as a distribution, read off plain histograms — synthetic data
;; only; nothing here measures anything
(describe "gui/latency-percentiles — the tail typing feels"
  (test "p50, p99 and p99.9 land on the bucket tops, never above the maximum"
    ;; 1000 inputs: 980 at ~2 ms, 15 at ~8 ms, 5 at ~40 ms
    (let (h {:count 1000 :max-us 40000 :buckets {2047 980 8191 15 40959 5}}
          p (gui/latency-percentiles h))
      (assert= (:count p) 1000)
      (assert= (:p50 p) 2.047)
      (assert= (:p99 p) 8.191)
      (assert= (:p999 p) 40.0)
      (assert= (:max p) 40.0)))
  (test "p99 of a hundred inputs is the ninety-ninth, not the hundredth"
    (let (p (gui/latency-percentiles {:count 100 :max-us 50000 :buckets {1023 99 51199 1}}))
      (assert= (:p99 p) 1.023)
      (assert= (:p999 p) 50.0)))
  (test "an empty histogram has no percentiles"
    (assert= (gui/latency-percentiles {:count 0 :max-us 0 :buckets {}})
      {:count 0 :p50 nil :p99 nil :p999 nil :max nil})))

(describe "gui/latency-merge and gui/latency-since — histograms are data"
  (test "two sessions add bucket by bucket"
    (let (merged (gui/latency-merge {:count 2 :max-us 3000 :buckets {1023 1 3071 1}}
                   {:count 1 :max-us 900 :buckets {1023 1}}))
      (assert= merged {:count 3 :max-us 3000 :buckets {1023 2 3071 1}})
      (assert= (gui/latency-merge nil merged) merged)))
  (test "a window of time is the later reading less the earlier"
    (let (before {:count 2 :max-us 3000 :buckets {1023 1 3071 1}}
          now {:count 5 :max-us 9000 :buckets {1023 3 3071 1 9215 1}}
          window (gui/latency-since now before))
      (assert= window {:count 3 :max-us 9000 :buckets {1023 2 9215 1}})
      ;; the window's own maximum is its slowest bucket's top, under the session's
      (assert= (:max-us (gui/latency-since {:count 3 :max-us 9000 :buckets {1023 2 9215 1}}
                          {:count 1 :max-us 9000 :buckets {9215 1}}))
        1023)
      (assert= (gui/latency-since now nil) now))))

(describe "gui/key-repeat? and gui/latency-histogram without a window"
  (test "a window that is not open has no repeat and no histogram"
    (assert= (gui/key-repeat? 987654) false)
    (assert-error (gui/latency-histogram 987654))))

(describe "gui/reduce-motion-from — each desktop's switch, read from what it says"
  (test "GNOME's animations switch off asks for reduced motion"
    (is (gui/reduce-motion-from :linux {:gnome "false"}))
    (is (not (gui/reduce-motion-from :linux {:gnome "true"}))))
  (test "KDE's animation speed at instant asks, any other speed does not"
    (is (gui/reduce-motion-from :linux {:kde "[General]\nx=1\n[KDE]\nAnimationDurationFactor=0\n"}))
    (is (not (gui/reduce-motion-from :linux {:kde "[KDE]\nAnimationDurationFactor=0.5\n"}))))
  (test "macOS Reduce Motion and Windows' animation effects"
    (is (gui/reduce-motion-from :macos {:macos "1\n"}))
    (is (not (gui/reduce-motion-from :macos {:macos "0"})))
    (is (gui/reduce-motion-from :windows
          {:windows "HKEY_CURRENT_USER\\Control Panel\\Desktop\\WindowMetrics\n    MinAnimate    REG_SZ    0\n"}))
    (is (not (gui/reduce-motion-from :windows {:windows "    MinAnimate    REG_SZ    1"}))))
  (test "a source that said nothing does not ask"
    (is (not (gui/reduce-motion-from :linux {:gnome nil :kde nil})))
    (is (not (gui/reduce-motion-from :windows {}))))
  (test "the live read answers a boolean on any machine"
    (is (bool? (gui/reduce-motion?)))))

;; --- the seam (ADR-610): rows above it top-anchored, from it down bottom-anchored ------

(def- seam-header [200 40 40])
(def- seam-body [40 200 40])
(def- seam-above [40 40 200])
(def- seam-mode [200 200 40])
(def- seam-echo [40 200 200])

(defn- seam-spec (h size)
  {:width 400 :height h :inset 6 :bg capture-bg :size size :line-height 1.4})

(defn- seam-frame (cols rows top-band)
  "An editor's frame: a header on row 0 (three columns, so it does not bleed), the body,
the body's last row in its own colour, the mode line on the seam and the echo area last."
  (let (seam (- rows 2))
    [[:clear]
      [:seam seam {:top-band top-band}]
      [:rect 0 1 3 1 {:bg seam-header}]
      [:rect 1 0 cols (- seam 2) {:bg seam-body}]
      [:rect (dec seam) 0 cols 1 {:bg seam-above}]
      [:rect seam 0 cols 1 {:bg seam-mode}]
      [:rect (dec rows) 0 cols 1 {:bg seam-echo}]]))

(defn- seam-failures (h size top-band)
  "What breaks the layout rule for a window `h` px tall at font `size`: a vector of
descriptions, empty when the rule holds."
  (let ([cols rows] (:grid (gui/render-frame [[:clear] [:seam nil {:top-band top-band}]]
                             (seam-spec h size)))
        image (gui/render-frame (seam-frame cols rows top-band) (seam-spec h size))
        tops (:row-tops image)
        [cell-w cell-h] (:cell image)
        seam (- rows 2)
        top (if top-band 0 6)
        gap-from (math/round (+ (nth tops (dec seam)) cell-h))
        gap-to (nth tops seam)
        bare (seq/filter (range (second tops) h) (fn (y) (= (gui/pixel image 200 y) capture-bg)))
        gap-wrong (seq/filter (range gap-from gap-to)
                    (fn (y) (not (= (gui/pixel image 200 y) seam-above)))))
    (vec (seq/filter [(when (not (= (:seam image) seam)) [:seam (:seam image)])
                       (when (not (= (last tops) (- h 6))) [:last-row-ends (last tops)])
                       (when (not (= (gui/pixel image 200 (dec h)) seam-echo))
                         :bottom-inset-not-echo)
                       (when (not (= (first tops) top)) [:row-0 (first tops)])
                       (when (not (= (gui/pixel image (+ 6 (* 2 cell-w)) top) seam-header))
                         :header-not-at-top)
                       (when (and (not top-band) (not (= (gui/pixel image 6 (dec top)) capture-bg)))
                         :top-margin-painted)
                       (when (>= (- gap-to gap-from) cell-h) [:gap (- gap-to gap-from)])
                       (when (not (empty? gap-wrong)) [:gap-not-the-row-above (first gap-wrong)])
                       (when (not (empty? bare)) [:bare-row (first bare)])]
           (fn (failure) (not (nil? failure)))))))

(describe "gui/render-frame — the seam holds the leftover at every height (ADR-610)"
  (test "every height in one row's span, two font sizes, row 0 a band and not"
    (when-gui (fn ()
                (doseq (size [15 21])
                  (let (cell-h (second (:cell (gui/render-frame [[:clear]] (seam-spec 300 size)))))
                    (doseq (h (range 300 (+ 300 cell-h)))
                      (doseq (top-band [true false])
                        (is (= [size h top-band (seam-failures h size top-band)]
                              [size h top-band []]))))))))))

(test "without a seam the leftover stays under the last row"
  (when-gui (fn ()
              (let (image (gui/render-frame [[:clear]] (seam-spec 307 15))
                    cell-h (second (:cell image)))
                (is (nil? (:seam image)))
                (is (= (:row-tops image)
                      (vec (map (range (math/round (inc (second (:grid image)))))
                             (fn (k) (* k cell-h))))))))))

;; --- the strip as content (ADR-615): the next line laid out past the seam, cut off there --

(def- strip-next [230 120 30])
(def- strip-ink [250 250 250])

(defn- strip-next-line (seam cols)
  "The body's next line, on the seam's row: its background and ink reaching the cell's top."
  [[:rect seam 0 cols 1 {:bg strip-next}] [:text seam 2 "Ég|ÉÉ|Ég" {:fg strip-ink}]])

(defn- strip-failures (h size)
  "What breaks the strip rule for a window `h` px tall at font `size`: the strip's pixel rows
must be exactly the next line's top as it paints with no seam at all when the strip is at
least half a row tall, and every other pixel row (all of them, under half a row) the phase-1
picture. A vector of descriptions, empty when it holds; with whether any strip row showed
the line's ink, and whether this strip was tall enough to show it."
  (let ([cols rows] (:grid (gui/render-frame [[:clear] [:seam nil]] (seam-spec h size)))
        seam (- rows 2)
        body [:rect 0 0 cols seam {:bg seam-body}]
        chrome [[:rect seam 0 cols 1 {:bg seam-mode}] [:rect (dec rows) 0 cols 1 {:bg seam-echo}]]
        phase-1 (gui/render-frame (into [[:clear] [:seam seam] body] chrome) (seam-spec h size))
        phase-2 (gui/render-frame (into [[:clear]
                                          [:seam seam]
                                          body
                                          [:above-seam (strip-next-line seam cols)]]
                                    chrome)
                  (seam-spec h size))
        flat (gui/render-frame (into [[:clear] body] (strip-next-line seam cols))
               (seam-spec h size))
        cell-h (second (:cell phase-1))
        strip-top (+ (nth (:row-tops phase-1) (dec seam)) cell-h)
        strip-bottom (nth (:row-tops phase-1) seam)
        ;; the rule: the line shows from half a row of strip; under that, phase 1
        shown (>= (* 2 (- strip-bottom strip-top)) cell-h)
        pixels (fn (image y) (bytes/slice (:rgba image) (* y 1600) (* (inc y) 1600)))
        wrong (seq/filter (range 0 h)
                (fn (y)
                  (not (= (pixels phase-2 y)
                         (pixels (if (and shown (>= y strip-top) (< y strip-bottom)) flat phase-1) y))))))
    [(vec (seq/filter [(when (not (= (:row-tops phase-2) (:row-tops phase-1))) :rows-moved)
                        (when (not (empty? wrong)) [:pixel-row (first wrong)])]
            (fn (failure) (not (nil? failure)))))
      (any? (range strip-top strip-bottom)
        (fn (y) (any? (range 0 400) (fn (x) (= (gui/pixel phase-2 x y) strip-ink)))))
      (if shown :shown (if (> strip-bottom strip-top) :too-short :none))]))

(describe "gui/render-frame — the strip shows the next line (ADR-615)"
  (test "from half a row the strip shows the next line clipped; under it, phase 1"
    (when-gui
      (fn ()
        (doseq (size [15 21])
          (let (cell-h (second (:cell (gui/render-frame [[:clear]] (seam-spec 300 size))))
                results (map (range 300 (+ 300 cell-h))
                          (fn (h) [h (strip-failures h size)])))
            (doseq ([h [failures _ _]] results)
              (is (= [size h failures] [size h []])))
            ;; some height's strip is tall enough to show the line's ink, and some is too short
            (is (any? results (fn ([_ [_ inked _]]) inked)))
            (is (any? results (fn ([_ [_ _ kind]]) (= kind :too-short))))))))))

(describe "gui/render-frame — what bleeds into a top margin (ADR-610)"
  (test "a one-row band on row 0 stays out of it; a taller band reaches the top edge"
    (when-gui (fn ()
                (let (spec (seam-spec 300 15)
                      [cols rows] (:grid (gui/render-frame [[:clear] [:seam nil {:top-band false}]]
                                           spec))
                      image (gui/render-frame [[:clear]
                                                [:seam (- rows 2) {:top-band false}]
                                                [:rect 0 0 cols 1 {:bg seam-above}]
                                                [:rect 0 0 3 (- rows 2) {:bg seam-body}]]
                              spec)
                      [cell-w _] (:cell image)
                      line-x (+ 6 (* 10 cell-w))
                      gutter-x (+ 6 cell-w))
                  (is (= (first (:row-tops image)) 6))
                  (is (every? (vec (range 0 6)) (fn (y) (= (gui/pixel image line-x y) capture-bg))))
                  (is (= (gui/pixel image line-x 6) seam-above))
                  (is (= (gui/pixel image gutter-x 0) seam-body))
                  (is (= (gui/pixel image 0 0) seam-body)))))))
