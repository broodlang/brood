;; Documentation extraction (std/docs.blsp): module docstrings and the
;; load+introspect renderer behind `nest doc`. Register-only — discovered and run
;; by `nest test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule docs-test (:use-internals docs) (:use test) (:use docs))

(describe "docs: leading module docstring"
  (test "a file's leading string form is its module doc"
    (assert= (docs/docs-leading-doc "\"Hi.\" (def x 1)") "Hi."))
  (test "a leading non-string means no module doc"
    (assert= (docs/docs-leading-doc "(def x 1)") nil))
  (test "comments before the string are skipped"
    (assert= (docs/docs-leading-doc ";; a comment\n\"Hi.\"\n(def x 1)") "Hi."))
  (test "the baked-in test module carries a module docstring"
    (is (string/starts-with? (docs/docs-leading-doc (%builtin-module "test")) "A tiny ExUnit"))))

(describe "docs: name attribution (global-names delta)"
  (test "added names are those in after but not before"
    (assert= (docs/docs-added '(a b) '(a b c d)) '(c d)))
  (test "nothing newly bound is empty" (assert= (docs/docs-added '(a b) '(a b)) nil)))

(describe "docs: classification"
  (test "functions and macros are documentable; plain values are not"
    (defn doc-test-fn (x) x)
    (defmacro doc-test-macro (x) x)
    (is (docs/docs-documentable? doc-test-fn))
    (is (docs/docs-documentable? doc-test-macro))
    (is (docs/docs-documentable? map))
    ; a native/closure builtin is a fn
    (refute (docs/docs-documentable? 42))
    (refute (docs/docs-documentable? "a string"))))

(describe "docs: basename from a path"
  (test "strips the directory and the .blsp suffix"
    (assert= (docs/docs-basename "a/b/foo.blsp") "foo")
    (assert= (docs/docs-basename "foo.blsp") "foo")
    (assert= (docs/docs-basename "foo") "foo")))

(describe "docs: rendering one definition"
  (test "a documented function renders its signature and docstring"
    (defn doc-squared (x) "Return x times itself." (* x x))
    (assert= (docs/docs-entry 'doc-squared doc-squared)
      "### `(doc-squared x)`\n\nReturn x times itself.\n"))
  (test "a macro entry is tagged"
    (defmacro doc-inc! (x) "Add one." `(+ ~x 1))
    (assert= (docs/docs-entry 'doc-inc! doc-inc!) "### `(doc-inc! x)`  *(macro)*\n\nAdd one.\n"))
  (test "an undocumented function gets a placeholder"
    (defn doc-bare (x) (* x x))
    (assert= (docs/docs-entry 'doc-bare doc-bare) "### `(doc-bare x)`\n\n_Undocumented._\n")))

(describe "docs: structured model (nest docs)"
  (test "docs-bare strips the module namespace to the last segment"
    (assert= (docs/docs-bare 'http/fetch) "fetch")
    (assert= (docs/docs-bare 'map) "map")
    ; a bare operator name (empty last segment) keeps its whole name
    (assert= (docs/docs-bare '/) "/"))
  (test "a def record carries name, bare signature, docstring, and macro flag"
    (defn model-sq (x) "Square x." (* x x))
    (let (record (docs/docs-def-record 'model-sq model-sq))
      (assert= (get record :name) "model-sq")
      (assert= (get record :sig) "(model-sq x)")
      (assert= (get record :doc) "Square x.")
      (refute (get record :macro))))
  (test "a module model has :module/:doc/:defs; only documentable fns/macros reach :defs"
    (defn model-pub (x) x)
    (def model-val 42)
    ; the syms arrive qualified (as they do from `global-names`), so eval resolves them;
    ; the plain value is not documentable and is dropped, the function is kept
    (let (model (docs/docs-module-model "m" "Doc." '(docs-test/model-pub docs-test/model-val)))
      (assert= (get model :module) "m")
      (assert= (get model :doc) "Doc.")
      (assert= (count (get model :defs)) 1)
      (assert= (get (first (get model :defs)) :name) "model-pub"))))

(describe "docs: doctests (nest doctest)"
  (test "a `expr ;=> expected` line parses into [expr expected]"
    (assert= (docs/doctest-of-line "(+ 1 2) ;=> 3") ["(+ 1 2)" "3"])
    (assert= (docs/doctest-of-line "just prose") nil)
    (assert= (docs/doctest-of-line "  (f x) ;=> :ok  ") ["(f x)" ":ok"]))
  (test "multiple examples are extracted in order"
    (assert= (docs/doctests-in "Doc.\n(a) ;=> 1\n(b) ;=> 2") (list ["(a)" "1"] ["(b)" "2"])))
  (test "run-one-doctest evaluates and compares"
    (assert= (docs/run-one-doctest "(+ 2 2)" "4") [:ok])
    (assert= (first (docs/run-one-doctest "(+ 2 2)" "5")) :fail)
    (assert= (first (docs/run-one-doctest "(this-is-unbound)" "5")) :error)))

(describe "docs: guides (Markdown → HTML)"
  (test "headings, inline code, links, lists, and fenced code render"
    (assert= (docs/markdown->html "# Hi") "<h1>Hi</h1>")
    (is (includes? (docs/markdown->html "a `b` c") "<code>b</code>"))
    (is (includes? (docs/markdown->html "see [x](/y)") "<a href=\"/y\">x</a>"))
    (is (includes? (docs/markdown->html "- one\n- two") "<li>one</li>"))
    (is (includes? (docs/markdown->html "```\n(+ 1 2)\n```") "<pre><code>(+ 1 2)</code></pre>"))
    ; HTML in prose is escaped
    (is (includes? (docs/markdown->html "a <b> c") "&lt;b&gt;")))
  (test "guide title humanises the filename"
    (assert= (docs/guide-title "guides/getting-started.md") "Getting started")))

(describe "docs: Markdown edge cases (review fixes)"
  (test "an unmatched [ is a literal, not a runaway recursion"
    (assert= (docs/markdown->html "a [b c") "<p>a [b c</p>")
    (assert= (docs/markdown->html "cost $[5 today") "<p>cost $[5 today</p>"))
  (test "a link URL is attribute-escaped and javascript: is neutralised"
    (is (includes? (docs/markdown->html "x [y](\" onx=1)") "&quot;"))
    (is (includes? (docs/markdown->html "[a](javascript:alert(1))") "href=\"#\"")))
  (test "an unclosed code fence at EOF is emitted, not dropped"
    (is (includes? (docs/markdown->html "```\n(+ 1 2)") "<pre><code>(+ 1 2)</code></pre>"))))

;; `md-links` — inline link rendering. Characterisation tests written BEFORE making the
;; function tail-recursive: it had no coverage at all, and it is fiddly index arithmetic over
;; strings, so the rewrite needed something to hold it to. Every case below passed against the
;; original non-tail implementation first.
(describe "docs: md-links"
  (test "text with no bracket is escaped and returned"
    (assert= "plain &lt;b&gt;" (docs/md-links "plain <b>")))

  (test "a real [text](url) link becomes an anchor"
    (assert= "<a href=\"u\">a</a>" (docs/md-links "[a](u)")))

  (test "text around a link is preserved and escaped"
    (assert= "x <a href=\"u\">a</a> y" (docs/md-links "x [a](u) y")))

  (test "two links in one run both render"
    (assert= "<a href=\"u\">a</a><a href=\"v\">b</a>"
      (docs/md-links "[a](u)[b](v)")))

  (test "a bracket run that is not a link is emitted literally, and scanning continues"
    (assert= "[a] then <a href=\"u\">b</a>" (docs/md-links "[a] then [b](u)")))

  (test "an unclosed ] escapes the whole run"
    (assert= "[a(u)" (docs/md-links "[a(u)")))

  (test "an unclosed ) escapes the whole run"
    (assert= "[a](u" (docs/md-links "[a](u")))

  (test "link text and url are escaped"
    (assert= "<a href=\"u&amp;v\">&lt;t&gt;</a>" (docs/md-links "[<t>](u&v)")))

  (test "a javascript: url is neutralised"
    ;; The trailing `)` is real, not a bug in the test: `index-of ")"` finds the INNER paren,
    ;; so the url is `javascript:alert(1` and the outer `)` falls through as literal text.
    ;; Nested parens in a url truncate it — pinned here because the security property that
    ;; matters (a `javascript:` url becomes `#`) holds regardless.
    (assert= "<a href=\"#\">x</a>)" (docs/md-links "[x](javascript:alert(1))")))

  (test "a long run of links all render"
    ;; 2000 links. Recursion depth here is one frame per link, so this is also the shape the
    ;; checker's non-tail-recursion warning is about — though 2000 does NOT overflow, so the
    ;; warning is about headroom, not an observed failure. `string-split` on N separators
    ;; yields N+1 pieces.
    (let (src (apply str (map (fn (_) "[a](u)") (range 0 2000))))
      (assert= 2001 (count (string/split (docs/md-links src) "<a href="))))))

;; ---------------------------------------------------------------------------
;; The doc catalogue must not name things that do not exist.
;;
;; `std/doc-catalog.blsp` maps every public bare name to a category, and its own
;; docstring says to "regenerate when the builtin/prelude surface changes" — a manual
;; step, which is exactly what rotted. Found 2026-08-17: **13 stale entries**, including
;; `require` (removed by ADR-229, so `nest docs --all` and hive's hosted /reference were
;; still presenting it as a language function) and twelve private `-acc`/helper names
;; (`dedupe-acc`, `pow-acc`, `index-where-from`, …) that moved into `seq`/`math` as
;; module internals when ADR-227 namespaced them, but stayed listed as public API.
;;
;; Nothing detected it because a catalogue entry has no callers: `nest docs --all` simply
;; prints whatever the map says, and an entry for a nonexistent name renders happily. So
;; this asserts the invariant directly, and it is cheap (one `bound?` per entry).
(describe "doc catalogue: every entry names something that exists"
  (test "no catalogue entry is a name the runtime cannot resolve"
    (let (forms (into #{} (map (fn (f) (if (pair? f) (first f) f)) (special-forms)))
          missing (filter (fn (k)
                            (let (s (string/->symbol k))
                              (not (or (bound? s) (contains? forms s)))))
                    (keys doc-catalog/*catalog*)))
      ;; Names, not just a count — a failure should say WHICH entry to remove.
      (assert= (sort missing) (list))))
  ;; A floor, not a target: the check above is vacuous against an empty/failed-to-load
  ;; catalogue, so this only has to be large enough that a broken load cannot pass it.
  ;; It sat at 500 while the catalogue covered a 613-name core; the namespace waves moved
  ;; most of those out (they are catalogued by their module now), so 400 is the new floor.
  (test "the catalogue is not empty (a broken load would vacuously pass the check above)"
    (is (> (count (keys doc-catalog/*catalog*)) 400))))

;; ...and the other direction: every public core name must HAVE a category.
;;
;; `category-of` falls back to `:other`, so an uncatalogued name does not error — it just
;; lands in a junk drawer at the bottom of the hosted reference. That drawer had grown to
;; 41 entries, mixing genuinely core vocabulary nobody could find (`stop`, `cast`,
;; `start` — miscategorised while `gen` was briefly prelude-bundled) with
;; threading helpers (`tap`, `then`) and internals. A reader scanning by category simply
;; never saw them. This asserts the drawer stays empty.
(describe "doc catalogue: every public core name has a category"
  (test "nothing falls through to :other"
    ;; The candidate set is asserted before the violation set. This gate walks
    ;; `(global-names)` and asserts a FILTERED result is empty, which is the shape that
    ;; passes vacuously when the filter stops matching — a bug that made every name look
    ;; private, say, would empty the corpus and the drawer would look clean. ADR-280 is
    ;; the same lesson from the startup image: assert the coverage, not only the verdict.
    (let (candidates (filter (fn (s)
                               (let (nm (->string s) i (index-of nm "/"))
                                 (and (not (and i (> i 0)))
                                   (not (includes? nm "--"))
                                   (not (string/starts-with? nm "%"))
                                   (not (private? s))
                                   (or (fn? (eval s)) (= (type-of (eval s)) :macro)))))
                       (global-names)))
      (assert= true (> (count candidates) 200)))
    (let (uncatalogued (filter
                         (fn (s)
                           (let (nm (->string s) i (index-of nm "/"))
                             (and (not (and i (> i 0)))
                               ; not a module function
                               (not (includes? nm "--"))
                               (not (string/starts-with? nm "%")) ; not a kernel primitive
                               (not (private? s)) ; not an internal helper
                               (or (fn? (eval s)) (= (type-of (eval s)) :macro))
                               (= (doc-catalog/category-of nm) :other))))
                         (global-names)))
      ;; Names, not a count — a failure should say WHICH name needs a category.
      (assert= (sort (map ->string uncatalogued)) (list)))))
