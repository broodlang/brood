;; Documentation extraction (std/docs.blsp): module docstrings and the
;; load+introspect renderer behind `nest doc`. Register-only — discovered and run
;; by `nest test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule docs-test (:use-internals docs) (:use test) (:use docs))

(describe "docs: leading module docstring"
  (test "a file's leading string form is its module doc"
    (assert= (docs/docs-leading-doc "\"Hi.\" (def x 1)") "Hi."))
  (test "a leading non-string means no module doc"
    (assert= (docs/docs-leading-doc "(def x 1)") nil))
  (test "comments before the string are skipped"
    (assert= (docs/docs-leading-doc ";; a comment\n\"Hi.\"\n(def x 1)") "Hi."))
  (test "the baked-in test module carries a module docstring"
    (is (starts-with? (docs/docs-leading-doc (%builtin-module "test")) "A tiny ExUnit"))))

(describe "docs: name attribution (global-names delta)"
  (test "added names are those in after but not before"
    (assert= (docs/docs-added '(a b) '(a b c d)) '(c d)))
  (test "nothing newly bound is empty" (assert= (docs/docs-added '(a b) '(a b)) nil)))

(describe "docs: classification"
  (test "functions and macros are documentable; plain values are not"
    (defn doc-test-fn (x) x)
    (defmacro doc-test-macro (x) x)
    (is (docs/docs-documentable? doc-test-fn))
    (is (docs/docs-documentable? doc-test-macro))
    (is (docs/docs-documentable? map))
    ; a native/closure builtin is a fn
    (refute (docs/docs-documentable? 42))
    (refute (docs/docs-documentable? "a string"))))

(describe "docs: basename from a path"
  (test "strips the directory and the .blsp suffix"
    (assert= (docs/docs-basename "a/b/foo.blsp") "foo")
    (assert= (docs/docs-basename "foo.blsp") "foo")
    (assert= (docs/docs-basename "foo") "foo")))

(describe "docs: rendering one definition"
  (test "a documented function renders its signature and docstring"
    (defn doc-squared (x) "Return x times itself." (* x x))
    (assert= (docs/docs-entry 'doc-squared doc-squared)
      "### `(doc-squared x)`\n\nReturn x times itself.\n"))
  (test "a macro entry is tagged"
    (defmacro doc-inc! (x) "Add one." `(+ ~x 1))
    (assert= (docs/docs-entry 'doc-inc! doc-inc!) "### `(doc-inc! x)`  *(macro)*\n\nAdd one.\n"))
  (test "an undocumented function gets a placeholder"
    (defn doc-bare (x) (* x x))
    (assert= (docs/docs-entry 'doc-bare doc-bare) "### `(doc-bare x)`\n\n_Undocumented._\n")))

(describe "docs: structured model (nest docs)"
  (test "docs-bare strips the module namespace to the last segment"
    (assert= (docs/docs-bare 'net/http/get) "get")
    (assert= (docs/docs-bare 'map) "map")
    ; a bare operator name (empty last segment) keeps its whole name
    (assert= (docs/docs-bare '/) "/"))
  (test "a def record carries name, bare signature, docstring, and macro flag"
    (defn model-sq (x) "Square x." (* x x))
    (let (record (docs/docs-def-record 'model-sq model-sq))
      (assert= (get record :name) "model-sq")
      (assert= (get record :sig) "(model-sq x)")
      (assert= (get record :doc) "Square x.")
      (refute (get record :macro))))
  (test "a module model has :module/:doc/:defs; only documentable fns/macros reach :defs"
    (defn model-pub (x) x)
    (def model-val 42)
    ; the syms arrive qualified (as they do from `global-names`), so eval resolves them;
    ; the plain value is not documentable and is dropped, the function is kept
    (let (model (docs/docs-module-model "m" "Doc." '(docs-test/model-pub docs-test/model-val)))
      (assert= (get model :module) "m")
      (assert= (get model :doc) "Doc.")
      (assert= (count (get model :defs)) 1)
      (assert= (get (first (get model :defs)) :name) "model-pub"))))

(describe "docs: doctests (nest doctest)"
  (test "a `expr ;=> expected` line parses into [expr expected]"
    (assert= (docs/doctest-of-line "(+ 1 2) ;=> 3") ["(+ 1 2)" "3"])
    (assert= (docs/doctest-of-line "just prose") nil)
    (assert= (docs/doctest-of-line "  (f x) ;=> :ok  ") ["(f x)" ":ok"]))
  (test "multiple examples are extracted in order"
    (assert= (docs/doctests-in "Doc.\n(a) ;=> 1\n(b) ;=> 2") (list ["(a)" "1"] ["(b)" "2"])))
  (test "run-one-doctest evaluates and compares"
    (assert= (docs/run-one-doctest "(+ 2 2)" "4") [:ok])
    (assert= (first (docs/run-one-doctest "(+ 2 2)" "5")) :fail)
    (assert= (first (docs/run-one-doctest "(this-is-unbound)" "5")) :error)))

(describe "docs: guides (Markdown → HTML)"
  (test "headings, inline code, links, lists, and fenced code render"
    (assert= (docs/markdown->html "# Hi") "<h1>Hi</h1>")
    (is (includes? (docs/markdown->html "a `b` c") "<code>b</code>"))
    (is (includes? (docs/markdown->html "see [x](/y)") "<a href=\"/y\">x</a>"))
    (is (includes? (docs/markdown->html "- one\n- two") "<li>one</li>"))
    (is (includes? (docs/markdown->html "```\n(+ 1 2)\n```") "<pre><code>(+ 1 2)</code></pre>"))
    ; HTML in prose is escaped
    (is (includes? (docs/markdown->html "a <b> c") "&lt;b&gt;")))
  (test "guide title humanises the filename"
    (assert= (docs/guide-title "guides/getting-started.md") "Getting started")))

(describe "docs: Markdown edge cases (review fixes)"
  (test "an unmatched [ is a literal, not a runaway recursion"
    (assert= (docs/markdown->html "a [b c") "<p>a [b c</p>")
    (assert= (docs/markdown->html "cost $[5 today") "<p>cost $[5 today</p>"))
  (test "a link URL is attribute-escaped and javascript: is neutralised"
    (is (includes? (docs/markdown->html "x [y](\" onx=1)") "&quot;"))
    (is (includes? (docs/markdown->html "[a](javascript:alert(1))") "href=\"#\"")))
  (test "an unclosed code fence at EOF is emitted, not dropped"
    (is (includes? (docs/markdown->html "```\n(+ 1 2)") "<pre><code>(+ 1 2)</code></pre>"))))
