;; Tests for std/datetime.blsp — UTC date/time utilities.
;; Run via `nest test` or `cargo run -p cli -- --test tests/datetime_test.blsp`.

(defmodule datetime-test (:use test))

;; ---- leap-year? -------------------------------------------------------------

(describe "leap-year?"
  (test "century years"
    (refute (datetime/leap-year? 1900))
    (is (datetime/leap-year? 2000))
    (refute (datetime/leap-year? 2100)))
  (test "ordinary years"
    (is (datetime/leap-year? 2024))
    (is (datetime/leap-year? 2020))
    (refute (datetime/leap-year? 2023))
    (refute (datetime/leap-year? 1970))))

;; ---- days-in-month ----------------------------------------------------------

(describe "days-in-month"
  (test "31-day months"
    (assert= 31 (datetime/days-in-month 2026 1))
    (assert= 31 (datetime/days-in-month 2026 3))
    (assert= 31 (datetime/days-in-month 2026 7))
    (assert= 31 (datetime/days-in-month 2026 12)))
  (test "30-day months"
    (assert= 30 (datetime/days-in-month 2026 4))
    (assert= 30 (datetime/days-in-month 2026 6))
    (assert= 30 (datetime/days-in-month 2026 9))
    (assert= 30 (datetime/days-in-month 2026 11)))
  (test "February non-leap"
    (assert= 28 (datetime/days-in-month 2023 2)))
  (test "February leap"
    (assert= 29 (datetime/days-in-month 2024 2))
    (assert= 29 (datetime/days-in-month 2000 2))))

;; ---- epoch-ms-> round-trip ------------------------------------------------

(describe "epoch-ms->"
  (test "Unix epoch itself"
    (let (dt (datetime/epoch-ms-> 0))
      (assert= 1970 (datetime/year dt))
      (assert= 1 (datetime/month dt))
      (assert= 1 (datetime/day dt))
      (assert= 0 (datetime/hour dt))
      (assert= 0 (datetime/minute dt))
      (assert= 0 (datetime/second dt))
      (assert= 0 (datetime/ms dt))))
  (test "a known date — 2013-01-23T00:00:00Z"
    ; 15728 days * 86400 * 1000
    (let (dt (datetime/epoch-ms-> 1358899200000))
      (assert= 2013 (datetime/year dt))
      (assert= 1 (datetime/month dt))
      (assert= 23 (datetime/day dt))
      (assert= 0 (datetime/hour dt))))
  (test "sub-second component"
    (let (dt (datetime/epoch-ms-> 1358899200750))
      (assert= 750 (datetime/ms dt))))
  (test "one ms before epoch → 1969-12-31T23:59:59.999Z"
    (let (dt (datetime/epoch-ms-> -1))
      (assert= 1969 (datetime/year dt))
      (assert= 12 (datetime/month dt))
      (assert= 31 (datetime/day dt))
      (assert= 23 (datetime/hour dt))
      (assert= 59 (datetime/minute dt))
      (assert= 59 (datetime/second dt))
      (assert= 999 (datetime/ms dt))))
  (test "one full day before epoch → 1969-12-31T00:00:00Z"
    (let (dt (datetime/epoch-ms-> -86400000))
      (assert= 1969 (datetime/year dt))
      (assert= 12 (datetime/month dt))
      (assert= 31 (datetime/day dt))
      (assert= 0 (datetime/hour dt))
      (assert= 0 (datetime/second dt)))))

;; ---- ->epoch-ms -----------------------------------------------------------

(describe "->epoch-ms"
  (test "Unix epoch"
    (assert= 0 (datetime/->epoch-ms (datetime/datetime 1970 1 1 0 0 0 0))))
  (test "known date"
    (assert= 1358899200000
      (datetime/->epoch-ms (datetime/datetime 2013 1 23 0 0 0 0))))
  (test "round-trip through epoch-ms->"
    (let (ms 1700000000123)
      (assert= ms (datetime/->epoch-ms (datetime/epoch-ms-> ms)))))
  (test "round-trip negative epoch"
    (let (ms -86400500)
      (assert= ms (datetime/->epoch-ms (datetime/epoch-ms-> ms))))))

;; ---- ISO 8601 formatting ----------------------------------------------------

;; One op renders all three types — `->iso` dispatches on the value instead of the
;; caller picking date->/time->/dt-> by knowing which shape it holds.
(describe "->iso on a date"
  (test "basic date"
    (assert= "2026-06-07" (datetime/->iso (datetime/date 2026 6 7))))
  (test "zero-pads month and day"
    (assert= "2000-01-05" (datetime/->iso (datetime/date 2000 1 5))))
  (test "four-digit year zero-pad"
    (assert= "0042-03-15" (datetime/->iso (datetime/date 42 3 15)))))

(describe "->iso on a time-of-day"
  (test "midnight"
    (assert= "00:00:00.000" (datetime/->iso (datetime/time-of-day 0 0 0 0))))
  (test "non-zero fields"
    (assert= "10:30:05.750" (datetime/->iso (datetime/time-of-day 10 30 5 750)))))

(describe "->iso on a datetime"
  (test "epoch"
    (assert= "1970-01-01T00:00:00.000Z" (datetime/->iso (datetime/epoch-ms-> 0))))
  (test "a real datetime"
    (assert= "2026-06-07T15:04:30.000Z"
      (datetime/->iso (datetime/datetime 2026 6 7 15 4 30 0)))))

;; The three types are records, so they are distinct types rather than maps told apart by
;; their keys — and each prints as its ISO string.
(describe "the temporal types are records"
  (test "each predicate accepts only its own type"
    (let (dt (datetime/datetime 2026 6 7 1 2 3 4)
          d (datetime/date 2026 6 7)
          t (datetime/time-of-day 1 2 3 4))
      (is (datetime? dt))
      (is (not (datetime? d)))
      (is (date? d))
      (is (not (date? dt)))
      (is (time-of-day? t))
      (is (not (time-of-day? d)))))
  (test "a look-alike map is none of them"
    (is (not (date? {:year 2026 :month 6 :day 7})))
    (is (not (= (datetime/date 2026 6 7) {:year 2026 :month 6 :day 7}))))
  (test "a date and a datetime for the same day are different values"
    (is (not (= (datetime/date 2026 6 7) (datetime/datetime 2026 6 7 0 0 0 0)))))
  (test "each displays as its ISO 8601 form, not its field map"
    (assert= (->string (datetime/date 2026 6 7)) "2026-06-07")
    (assert= (->string (datetime/time-of-day 10 30 5 750)) "10:30:05.750")
    (assert= (->string (datetime/datetime 2026 6 7 15 4 30 0)) "2026-06-07T15:04:30.000Z"))
  (test "Temporal is sealed over exactly the three types"
    (assert= (sort (%sealed-members 'Temporal))
      (sort (list :datetime/datetime :datetime/date :datetime/time-of-day))))
  (test "every sealed member satisfies the ability"
    (is (satisfies? 'Temporal (datetime/date 2026 6 7)))
    (is (satisfies? 'Temporal (datetime/time-of-day 0 0 0 0)))
    (is (satisfies? 'Temporal (datetime/epoch-ms-> 0))))
  (test "a value that is not temporal raises rather than rendering nonsense"
    (assert-error (datetime/->iso {:year 2026 :month 6 :day 7}))))

;; ---- format --------------------------------------------------------------

(describe "format"
  (test "ISO 8601 manual"
    (let (dt (datetime/datetime 2026 6 7 9 5 3 42))
      (assert= "2026-06-07 09:05:03"
        (datetime/format dt "%Y-%m-%d %H:%M:%S"))))
  (test "literal percent"
    (let (dt (datetime/datetime 2026 1 1 0 0 0 0))
      (assert= "100%" (datetime/format dt "100%%"))))
  (test "ms field"
    (let (dt (datetime/datetime 2026 1 1 0 0 0 7))
      (assert= "007" (datetime/format dt "%f")))))

;; ---- parsing ----------------------------------------------------------------

(describe "parse-date"
  (test "valid date"
    (assert= (datetime/date 2026 6 7)
      (datetime/parse-date "2026-06-07")))
  (test "leading zeros"
    (assert= (datetime/date 2000 1 5)
      (datetime/parse-date "2000-01-05")))
  (test "invalid returns nil"
    (assert= nil (datetime/parse-date "not-a-date"))
    (assert= nil (datetime/parse-date "2026-06"))))

(describe "parse-time"
  (test "no fractional seconds"
    (assert= (datetime/time-of-day 10 30 5 0)
      (datetime/parse-time "10:30:05")))
  (test "with ms"
    (assert= (datetime/time-of-day 10 30 5 750)
      (datetime/parse-time "10:30:05.750")))
  (test "trailing Z is ignored"
    (assert= (datetime/time-of-day 0 0 0 0)
      (datetime/parse-time "00:00:00Z")))
  (test "fractional right-padding: .5 → 500ms"
    (assert= (datetime/time-of-day 0 0 0 500)
      (datetime/parse-time "00:00:00.5"))))

(describe "parse-iso8601"
  (test "full datetime with Z"
    (assert= (datetime/datetime 2026 6 7 15 4 30 0)
      (datetime/parse-iso8601 "2026-06-07T15:04:30Z")))
  (test "with milliseconds"
    (assert= (datetime/datetime 2026 6 7 15 4 30 750)
      (datetime/parse-iso8601 "2026-06-07T15:04:30.750Z")))
  (test "invalid returns nil"
    (assert= nil (datetime/parse-iso8601 "not a date"))
    (assert= nil (datetime/parse-iso8601 "2026-06-07"))))

;; ---- arithmetic -------------------------------------------------------------

(describe "duration helpers"
  (test "seconds" (assert= 5000 (datetime/seconds 5)))
  (test "minutes" (assert= 300000 (datetime/minutes 5)))
  (test "hours" (assert= 3600000 (datetime/hours 1)))
  (test "days" (assert= 86400000 (datetime/days 1))))

(describe "add / diff"
  (test "add one day"
    (let (d1 (datetime/datetime 2026 6 7 0 0 0 0)
          d2 (datetime/add d1 (datetime/days 1)))
      (assert= 2026 (datetime/year d2))
      (assert= 6 (datetime/month d2))
      (assert= 8 (datetime/day d2))))
  (test "add across month boundary"
    (let (d1 (datetime/datetime 2026 1 31 0 0 0 0)
          d2 (datetime/add d1 (datetime/days 1)))
      (assert= 2 (datetime/month d2))
      (assert= 1 (datetime/day d2))))
  (test "add across year boundary"
    (let (d1 (datetime/datetime 2025 12 31 23 59 59 999)
          d2 (datetime/add d1 1))
      (assert= 2026 (datetime/year d2))
      (assert= 1 (datetime/month d2))
      (assert= 1 (datetime/day d2))
      (assert= 0 (datetime/ms d2))))
  (test "diff positive"
    (let (d1 (datetime/datetime 2026 6 8 0 0 0 0)
          d2 (datetime/datetime 2026 6 7 0 0 0 0))
      (assert= (datetime/days 1) (datetime/diff d1 d2))))
  (test "diff negative"
    (let (d1 (datetime/datetime 2026 6 7 0 0 0 0)
          d2 (datetime/datetime 2026 6 8 0 0 0 0))
      (assert= (- (datetime/days 1)) (datetime/diff d1 d2)))))

;; ---- comparison -------------------------------------------------------------

(describe "dt comparison"
  (let (a (datetime/datetime 2026 6 7 0 0 0 0)
        b (datetime/datetime 2026 6 8 0 0 0 0))
    (test "before?" (is (datetime/before? a b)) (refute (datetime/before? b a)))
    (test "after?" (is (datetime/after? b a)) (refute (datetime/after? a b)))
    (test "same?" (is (datetime/same? a a)) (refute (datetime/same? a b)))
    (test "not-after?" (is (datetime/not-after? a a)) (is (datetime/not-after? a b)))
    (test "not-before?" (is (datetime/not-before? b b)) (is (datetime/not-before? b a)))))

;; ---- day-of-week ------------------------------------------------------------

(describe "day-of-week"
  (test "1970-01-01 is a Thursday"
    (assert= :thursday (datetime/day-of-week (datetime/date 1970 1 1))))
  (test "2013-01-23 is a Wednesday"
    (assert= :wednesday (datetime/day-of-week (datetime/date 2013 1 23))))
  (test "1969-12-31 is a Wednesday"
    (assert= :wednesday (datetime/day-of-week (datetime/date 1969 12 31)))))

;; ---- day-of-year ------------------------------------------------------------

(describe "day-of-year"
  (test "January 1 is day 1"
    (assert= 1 (datetime/day-of-year (datetime/date 2026 1 1))))
  (test "December 31 non-leap"
    (assert= 365 (datetime/day-of-year (datetime/date 2023 12 31))))
  (test "December 31 leap"
    (assert= 366 (datetime/day-of-year (datetime/date 2024 12 31))))
  (test "March 1 non-leap"
    (assert= 60 (datetime/day-of-year (datetime/date 2023 3 1)))))

;; ---- decomposition / date+time ----------------------------------------------

(describe "->date / ->time / date+time"
  (test "round-trip through date+time"
    (let (dt (datetime/datetime 2026 6 7 10 30 5 123)
          d (datetime/->date dt)
          t (datetime/->time dt))
      (assert= dt (datetime/date+time d t))))
  (test "->date strips time fields"
    (let (d (datetime/->date (datetime/datetime 2026 6 7 10 30 5 123)))
      (assert= (datetime/date 2026 6 7) d)
      (is (date? d))))
  (test "->time strips date fields"
    (let (t (datetime/->time (datetime/datetime 2026 6 7 10 30 5 123)))
      (assert= (datetime/time-of-day 10 30 5 123) t)
      (is (time-of-day? t)))))

;; ---- input validation --------------------------------------------------------
;; The parsers checked SHAPE only and handed whatever came out straight to the
;; record constructor, which checks nothing either — so "2026-02-31", "2026-13-05",
;; "12:-5:00" and hour 99 all "parsed", and every later conversion silently
;; NORMALISED them (Feb 31 → Mar 3). A parser that accepts an impossible date and
;; quietly moves it is worse than one that rejects it: the caller's validation
;; looks like it passed. The calendar core itself was always correct.

(describe "parse-date — impossible dates are nil, not normalised"
  (test "a day past the end of the month"
    (assert= nil (datetime/parse-date "2026-02-31"))
    (assert= nil (datetime/parse-date "2026-04-31"))
    (assert= nil (datetime/parse-date "2026-01-32")))
  (test "an out-of-range month"
    (assert= nil (datetime/parse-date "2026-13-05"))
    (assert= nil (datetime/parse-date "2026-00-05")))
  (test "a zero day"
    (assert= nil (datetime/parse-date "2026-01-00")))
  (test "leap days follow the real calendar"
    (refute (nil? (datetime/parse-date "2024-02-29")))
    (assert= nil (datetime/parse-date "2026-02-29"))
    (refute (nil? (datetime/parse-date "2000-02-29")))
    (assert= nil (datetime/parse-date "1900-02-29")))
  (test "ordinary dates still parse"
    (let (d (datetime/parse-date "2026-08-24"))
      (assert= 2026 (datetime/date-year d))
      (assert= 8 (datetime/date-month d))
      (assert= 24 (datetime/date-day d)))))

(describe "parse-time — out-of-range components are nil"
  (test "a negative component"
    (assert= nil (datetime/parse-time "12:-5:00")))
  (test "hour, minute and second bounds"
    (assert= nil (datetime/parse-time "24:00:00"))
    (assert= nil (datetime/parse-time "12:60:00"))
    (assert= nil (datetime/parse-time "12:00:60"))
    (refute (nil? (datetime/parse-time "23:59:59"))))
  (test "junk after the Z is nil, not silently truncated"
    (assert= nil (datetime/parse-time "12:00:00Zjunk"))
    (refute (nil? (datetime/parse-time "12:00:00Z"))))
  (test "a non-numeric fraction is nil, not 0 ms"
    (assert= nil (datetime/parse-time "12:00:00.xyz"))
    (refute (nil? (datetime/parse-time "12:00:00.250")))))

(describe "parse-iso8601 — validation flows through"
  (test "an impossible hour is nil"
    (assert= nil (datetime/parse-iso8601 "2026-01-01T99:00:00Z")))
  (test "an impossible date is nil"
    (assert= nil (datetime/parse-iso8601 "2026-02-31T00:00:00Z")))
  (test "a real timestamp still parses"
    (refute (nil? (datetime/parse-iso8601 "2026-08-24T12:34:56.789Z")))))
