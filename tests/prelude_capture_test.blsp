;; A prelude macro's template is spliced into a USER's file, where a bare reference
;; resolves against their namespace first. So a template that emits a bare public
;; function name is captured by any module that happens to define that name — and the
;; failure is a silent wrong value, not an error:
;;
;;     (defmodule mine)
;;     (defn get (bag k) :CAPTURED)     ; a perfectly reasonable domain function
;;     (defrecord point (x y))
;;     (point-x (point 1 2))            ; => :CAPTURED, before `defrecord` used `/get`
;;
;; The fix is the `/name` root escape (ADR-236): `/get` pins the reference to root.
;; This test is the gate that keeps it applied, because nothing else notices — the
;; arity is right, no name is unbound, and `nest check` is silent.
;;
;; NOT flagged, and why:
;;   - `%name`      — a user cannot define one by accident (ADR-250)
;;   - `/name`      — already escaped, which is the whole point
;;   - special form — resolved by the compiler, not through the global table
;;   - `*earmuff*`  — ambient/root by declaration (ADR-065's earmuff rule)
;;   - a template's own `let`/`fn` binders — alpha-renamed by the hygiene pass
(defmodule prelude-capture-test
  (:use test))

(def- prelude-files
  ["std/prelude/core.blsp"
    "std/prelude/predicates.blsp" "std/prelude/map.blsp" "std/prelude/control.blsp"
    "std/prelude/match.blsp" "std/prelude/process.blsp" "std/prelude/seq.blsp"
    "std/prelude/string.blsp" "std/prelude/tools.blsp" "std/prelude/modules.blsp"
    "std/prelude/abilities.blsp" "std/prelude/image-install.blsp"])

(def- prelude-source
  (string/join (map prelude-files file/slurp) "\n"))

;; Every bare root name that is NOT a special form — the set a template could capture.
(def- capturable
  (let (sf (into #{} (map (reflect/special-forms) ->string)))
    (into #{}
      (seq/reject (map (reflect/global-names) ->string)
        (fn (s)
          (or (string/starts-with? s "%")
            (includes? s "/")
            (string/starts-with? s "*")
            (contains? sf s)))))))

;; Walk a form, collecting head symbols that sit inside a quasiquote template.
;; `~`/`~@` holes are caller code (already resolved at the call site) and `quote`
;; subtrees are data, so both are skipped — the same rule the resolver follows.
(defn- heads-in (form in-template acc)
  (cond
    (not (pair? form)) acc
    (= (first form) 'quote) acc
    (= (first form) 'unquote) acc
    (= (first form) 'unquote-splicing) acc
    (= (first form) 'quasiquote) (heads-in (second form) true acc)
    else
      (let (head (first form)
            acc (if (and in-template (symbol? head) (contains? capturable (->string head)))
                  (conj acc (->string head))
                  acc))
        (fold form acc (fn (a f) (heads-in f in-template a))))))

;; The second emission shape, and the one that hid a live bug for a day. A macro can
;; build its output with `(list 'head …)` instead of a quasiquote — `defmulti` did, with
;; `(list 'mapv '%identity-of 'args)` — and the template walker above skips `quote`
;; subtrees by design, so it never saw those heads. A module defining `mapv` therefore
;; broke every multimethod it declared, silently: dispatch keyed on `:CAPTURED`.
(defn- quoted-heads-in (form acc)
  (if (not (pair? form))
    acc
    ;; `(cons 'head …)` builds a call too: `string/interp` emitted `(cons 'str …)`
    (let (acc (if (and (includes? ['list 'cons] (first form))
                    (pair? (rest form))
                    (pair? (second form))
                    (= (first (second form)) 'quote)
                    (symbol? (second (second form)))
                    (contains? capturable (->string (second (second form)))))
                (conj acc (->string (second (second form))))
                acc))
      (fold form acc (fn (a f) (quoted-heads-in f a))))))

;; The same shape built from a quoted LIST: `(list 'if '(empty? next-args) …)` — the `next-impl`
;; default once spliced a quoted `(empty? next-args)` into a method body, where a parameter
;; named `empty?` captured it. A quoted list handed to `list`/`cons`/`append` is code being
;; assembled, so its head is a call head like any other.
(defn- quoted-lists-in (form acc)
  (if (not (pair? form))
    acc
    (let (acc (if (includes? ['list 'cons 'append] (first form))
                (fold (rest form)
                  acc
                  (fn (a arg)
                    (if (and (pair? arg)
                          (= (first arg) 'quote)
                          (pair? (second arg))
                          (symbol? (first (second arg)))
                          (contains? capturable (->string (first (second arg)))))
                      (conj a (->string (first (second arg))))
                      a)))
                acc))
      (if (= (first form) 'quote) acc (fold form acc (fn (a f) (quoted-lists-in f a)))))))

;; The third shape: a capturable root name in ARGUMENT position — `(map ~xs first)`. ADR-423's
;; definition-time pass writes a template's call HEADS as `/name`, never its arguments (an
;; argument may be a binder, or data), so these still need the hand-written `/first`.
(defn- args-in (form in-template acc)
  (cond
    (and in-template (symbol? form) (contains? capturable (->string form)))
      (conj acc (->string form))
    (vector? form) (fold form acc (fn (a f) (args-in f in-template a)))
    (not (pair? form)) acc
    (= (first form) 'quote) acc
    (= (first form) 'unquote) acc
    (= (first form) 'unquote-splicing) acc
    (= (first form) 'quasiquote) (args-in (second form) true acc)
    ;; inside a template the head is the call, which the pass escapes; walk the arguments
    else (fold (if in-template (rest form) form) acc (fn (a f) (args-in f in-template a)))))

(defn- macro-offenders (forms label-of scan)
  (fold forms
    {}
    (fn (acc form)
      (if (and (pair? form) (= (first form) 'defmacro))
        (let (hits (seq (scan form)))
          (if (empty? hits) acc (assoc acc (label-of form) (sort hits))))
        acc))))

;; The prelude is held to all three shapes — its heads are escaped by hand, and the gate
;; predates ADR-423's automatic pass.
(defn- offenders ()
  (macro-offenders (reflect/read-all prelude-source)
    (fn (form) (->string (second form)))
    (fn (form)
      (quoted-lists-in form (args-in form false (quoted-heads-in form (heads-in form false #{})))))))

;; The prelude's FUNCTIONS that build code for a macro — the pattern compiler's
;; `%match-compile-seq`, `for`'s `%for-fold`, `receive`'s `%receive-binds` — emit into the
;; caller's code too, and ADR-423's pass never sees them: it escapes templates inside a
;; macro's own function only. Their output often lands inside a binder the CALLER named (a
;; pattern variable), so a bare `rest` there was captured by `(x & rest)` as well as by a
;; module defining `rest`. Held to the same three shapes; a `check-allow` wrapper is opened.
(defn- defn-forms (form)
  (cond
    (not (pair? form)) []
    (includes? ['defn 'defn-] (first form)) [form]
    (= (first form) 'check-allow) (mapcat (rest (rest form)) defn-forms)
    else []))

(defn- builder-offenders (source)
  (fold (mapcat (reflect/read-all source) defn-forms)
    {}
    (fn (acc form)
      (let (hits (seq (quoted-lists-in form
                        (args-in form false (quoted-heads-in form (heads-in form false #{}))))))
        (if (empty? hits) acc (assoc acc (->string (second form)) (sort hits)))))))

;; Every std module's macros, not only the prelude's: a module macro expands in the module
;; that USES it, where — since ADR-423 — that module's own `first` wins a bare reference.
(defn- std-arg-offenders ()
  (fold (seq/filter (file/walk-files "std") (fn (f) (string/ends-with? f ".blsp")))
    {}
    (fn (acc f)
      (merge acc
        ;; arguments only: a module macro's call heads are escaped for it (ADR-423)
        (macro-offenders (reflect/read-all (file/slurp f))
          (fn (form) (str f " " (->string (second form))))
          (fn (form) (args-in form false #{})))))))

(describe "prelude macro templates cannot be captured by user code"
  ;; Compared as the whole MAP, not a count: a failure then prints which macro emits
  ;; which name, which is the entire fix instruction (write it `/name`).
  ;;
  (test "no template emits a bare capturable name"
    (assert= (offenders) {}))

  (test "no std macro passes a capturable root name as a template argument"
    (assert= (std-arg-offenders) {}))

  ;; Every std file, not only the prelude: `gen`'s `defserver` clause builder emitted a bare
  ;; `send`/`nth` inside the caller's pattern variables, and the prelude-only scan missed it.
  (test "no std function that builds code emits a bare capturable name"
    (assert= (fold (seq/filter (file/walk-files "std") (fn (f) (string/ends-with? f ".blsp")))
               {}
               (fn (acc f)
                 (let (hits (builder-offenders (file/slurp f)))
                   (if (empty? hits) acc (assoc acc f hits)))))
      {}))

  (test "the builder scan opens a check-allow wrapper"
    (assert= (builder-offenders "(check-allow :non-tail-recursion (defn- f (t) `(if (pair? ~t) (first ~t) nil)))")
      {"f" (list "first" "pair?")}))

  ;; The scans above pass on an empty result, so prove each shape is SEEN.
  (test "the scans see each shape they gate"
    (assert= (args-in (reflect/read-string "(defmacro m (x) `(map ~x first))") false #{})
      #{"first"})
    (assert= (heads-in (reflect/read-string "(defmacro m (x) `(first ~x))") false #{})
      #{"first"})
    (assert= (quoted-heads-in (reflect/read-string "(defn f (xs) (cons 'str xs))") #{})
      #{"str"})
    (assert= (quoted-lists-in (reflect/read-string "(defn f (b) (list 'if '(empty? xs) b))") #{})
      #{"empty?"}))

  ;; The gate above is a static scan; this is the behaviour it stands for. If someone
  ;; drops the escape, this fails with a wrong VALUE, which is what a user would see.
  (test "a module defining `get` does not capture defrecord's accessor"
    (assert=
      (%load-string
        "(defmodule capture-probe-get)
                (defn get (bag k) :CAPTURED)
                (defrecord pt (x y))
                (pt-x (pt 7 8))")
      7))

  (test "a module defining `reverse` does not capture `for`"
    (assert=
      (%load-string
        "(defmodule capture-probe-reverse)
                (defn reverse (c) :CAPTURED)
                (for (x [1 2 3]) x)")
      (list 1 2 3)))

  ;; `receive` was the last holdout: it could not use the escape until `but-last` moved
  ;; into core.blsp and `sleep` moved below `receive`, because until then `sleep`'s
  ;; `(receive …)` expanded lazily at first call, where no resolve pass runs.
  (test "a module defining `nil?`/`nth` does not capture `receive`"
    (assert=
      (%load-string
        "(defmodule capture-probe-receive)
                (defn nil? (x) :CAPTURED)
                (defn nth (c i) :CAPTURED)
                (let (p (spawn (fn () (receive (m m)))))
                  (send p :hello)
                  (proc/sleep 20)
                  :ok)")
      :ok))

  ;; `sig` is the subtle one: capturing it does not produce a wrong value, it silently
  ;; stops the checker seeing a record's field types. The escape only works because
  ;; macro-head lookup learned it — `compile` expands before it resolves, so an
  ;; unrecognised `/sig` never produces the `%register-sig` the checker collects.
  (test "a module defining `sig` does not capture defrecord's signatures"
    (assert=
      (%load-string
        "(defmodule capture-probe-sig)
         (defn sig (a b) :CAPTURED)
         (defrecord pt ((x int) (y int)))
         (pt-x (pt 3 4))")
      3))

  ;; the `(list 'head …)` shape — `defmulti` built its dispatch key with `mapv`
  (test "a module defining `mapv` does not capture `defmulti` dispatch"
    (assert=
      (%load-string
        "(defmodule capture-probe-mapv)
         (defn mapv (c f) :CAPTURED)
         (defrecord sq (n))
         (defmulti describe-it)
         (defmethod describe-it [capture-probe-mapv/sq] (x) :ok)
         (describe-it (sq 2))")
      :ok))

  (test "a module defining `bound?` does not capture `defonce`"
    (assert=
      (%load-string
        "(defmodule capture-probe-bound)
                (defn bound? (s) :CAPTURED)
                (defonce zz 5)
                zz")
      5))

  ;; ADR-423: a module's own definition wins over a root MACRO inside that module — so the
  ;; templates above must not be capturable by one either. They are not written `/when` by
  ;; hand: the definition-time pass escapes a template's call heads for every macro.
  (test "a module defining its own `when` macro does not capture `when-let` or `cond`"
    (assert=
      (%load-string
        "(defmodule capture-probe-when (:shadow when and))
         (defmacro when (c & body) :CAPTURED)
         (defmacro and (& xs) :CAPTURED)
         [(when-let (x 5) x) (if-let (y 1) y 0) (cond (= 1 1) :ok else :no)]")
      [5 1 :ok]))

  (test "a module's own function wins a bare call over a root macro; /name reaches the macro"
    (assert=
      (%load-string
        "(defmodule capture-probe-doto (:shadow doto))
         (defn- doto (x) [:mine x])
         [(doto 1) (/doto 3)]")
      ;; the macro returns its expression's value; the module's function would give [:mine 3]
      [[:mine 1] 3]))

  ;; The same pass covers a MODULE's macro: its template's root heads are escaped too, so a
  ;; consumer that defines `first` does not capture a library macro that calls it.
  (test "a module macro's template is not captured by the module that uses it"
    (assert=
      (%load-string
        "(defmodule capture-probe-lib)
         (defmacro head-of (xs) `(first ~xs))
         (defmodule capture-probe-user)
         (defn first (xs) :CAPTURED)
         (capture-probe-lib/head-of [7 8])")
      7)))

(describe "the shadow warnings go through *err*"
  ;; Kernel warnings, written through the dynamic `*err*` port so a test or a tool can capture
  ;; them as it captures any Brood output. (Module names are unique per case: each warning is
  ;; printed once per definition per process.)
  (test "defining a root macro's name warns, and (:shadow …) silences it"
    (is (includes? (with-err-str (%load-string "(defmodule capture-warn-a) (defn doto (x) x)"))
          "`capture-warn-a/doto` shadows the prelude macro `doto`"))
    (assert= ""
      (with-err-str (%load-string "(defmodule capture-warn-b (:shadow doto)) (defn doto (x) x)"))))
  (test "an import that shadows a root function warns"
    (is
      (includes?
        (with-err-str
          (%load-string
            "(defmodule capture-warn-lib) (defn identity (x) [:mine x])
               (defmodule capture-warn-user (:use capture-warn-lib))"))
        "refers `identity`, which shadows the prelude/root `identity`"))))

(describe "macro shadowing across processes"
  ;; Every worker compiles its own module defining `when`, in parallel; each must see its own
  ;; macro win in its module and the prelude's `when-let` stay uncaptured.
  :isolated (test "parallel modules each own their shadow"
    (let (me (self)
          n 4)
      (doseq (i (range n))
        (spawn
          (fn ()
            (send me
              [i
                (%load-string
                  (str "(defmodule capture-probe-par"
                    i
                    " (:shadow when))
                              (defmacro when (c & body) [:own "
                    i
                    "])
                              [(when true 1) (when-let (x "
                    i ") x)]"))]))))
      (let (got (fold (range n) {} (fn (acc _) (receive ([i v] (assoc acc i v))))))
        (doseq (i (range n))
          (assert= [[:own i] i] (get got i)))))))
