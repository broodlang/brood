;; editor/lexer — the table-driven line lexer. Each check names the TOKEN a span covers
;; (`spans-of`), so a wrong extent fails by text, not by offset. The format tables built on
;; it (JSON, YAML, …) live in bedit (ADR-417).
(defmodule lexer-test
  (:use test)
  (:use editor/face)
  (:use editor/lexer))

(defn- spans-of (spans src role)
  "The texts of the spans painted in `role`'s face, in order."
  (let (f (face (get lexer-roles role)))
    (map (seq/filter spans (fn ([s e face]) (= face f)))
      (fn ([s e _]) (string/substring src s e)))))

(defn- ordered? (spans)
  "Ascending and non-overlapping — the `highlight-spans` contract."
  (or (< (count spans) 2)
    (every? (map (range (dec (count spans))) (fn (i) [(nth spans i) (nth spans (inc i))]))
      (fn ([a b]) (<= (second a) (first b))))))

(describe "editor/lexer — a lexer from a table"
  (test "structured rules: leftmost match wins, the group says which rule"
    (let (g (lexer-grammar {:structured [["#.*" :comment] ["\"[^\"]*\"" :string]]})
          src "x = \"a # not a comment\" # yes")
      (assert= (spans-of (lexer-spans g src) src :string) (list "\"a # not a comment\""))
      (assert= (spans-of (lexer-spans g src) src :comment) (list "# yes"))))
  (test "words are classified by exact lookup, outside structured tokens only"
    (let (g (lexer-grammar {:structured [["\"[^\"]*\"" :string]]
                            :words "[a-z]+"
                            :classes {"true" :special}})
          src "true \"true\" truer")
      (assert= (spans-of (lexer-spans g src) src :special) (list "true"))))
  (test "a line rule paints its first group at the line's start, and only there"
    (let (g (lexer-grammar {:line [["^(\\w+):" :function]]})
          src "build: x\n  not: a target\nall:")
      (assert= (spans-of (lexer-spans g src) src :function) (list "build" "all"))))
  (test "a definition and punctuation are roles too (ADR-614)"
    (assert= (get lexer-roles :definition) :syntax/definition)
    (assert= (get lexer-roles :punctuation) :syntax/punctuation)
    (let (g (lexer-grammar {:structured [["[\\[\\]]" :punctuation]]
                            :line [["^\\[(\\w+)\\]" :definition]]})
          src "[server]"
          spans (lexer-spans g src))
      (is (any? spans (fn ([s e _]) (and (= s 1) (= e 7)))))
      (is (any? spans (fn ([s e _]) (and (= s 0) (= e 1)))))))
  (test "a symbol and a constant are roles of their own, the keyword and special faces by default (ADR-616)"
    (assert= (get lexer-roles :symbol) :syntax/symbol)
    (assert= (get lexer-roles :constant) :syntax/constant)
    (let (g (lexer-grammar {:structured [["\"\\w+\":" :symbol]]
                            :words "[a-z]+"
                            :classes {"null" :constant}})
          src "\"k\": null"
          spans (lexer-spans g src))
      (assert= (spans-of spans src :symbol) (list "\"k\":"))
      (assert= (spans-of spans src :constant) (list "null"))
      ;; untouched by a theme, each is the face its tokens always had
      (assert= (face :syntax/symbol) (face :syntax/keyword))
      (assert= (face :syntax/constant) (face :syntax/special))))
  (test "every span list is ascending and non-overlapping"
    (let (g (lexer-grammar {:structured [["#.*" :comment] ["\\d+" :number]]
                            :words "[a-z]+"
                            :classes {"if" :special}
                            :line [["^(\\w+)=" :keyword]]}))
      (is (ordered? (lexer-spans g "a=1 if 2 # if 3\nb=if"))))))

(describe "editor/lexer — through the line cache (ADR-471)"
  (test "a grammar as a line lexer colours a window as lexer-spans colours the whole"
    (let (g (lexer-grammar {:structured [["#.*" :comment] ["\\d+" :number]]})
          src "a 1\n# two\nb 3 # x"
          rope (text/from-string src)
          [_ spans] (editor/line-cache/line-cache-update (editor/line-cache/line-cache)
                      (lexer-line-lexer g)
                      rope
                      0
                      (text/line-count rope)))
      (assert= spans (lexer-spans g src)))))

(describe "editor/lexer — a theme styles a keyword apart from a literal (ADR-616)"
  :isolated (test "the keyword role and the symbol / constant roles take their own faces"
    (let (saved (into {}
                  (map [:syntax/keyword :syntax/symbol :syntax/constant]
                    (fn (name) [name (get (faces) name)])))
          _ (do
              (def-face :syntax/keyword {:fg "#000001"})
              (def-face :syntax/symbol {:fg "#000002"})
              (def-face :syntax/constant {:fg "#000003"}))
          g (lexer-grammar {:structured [["\"\\w+\":" :symbol]]
                            :words "[a-z]+"
                            :classes {"if" :keyword "null" :constant}})
          src "\"k\": null if"
          painted (map (lexer-spans g src) (fn ([s e f]) [(string/substring src s e) f])))
      (doseq (entry saved) (let ([name attrs] entry) (def-face name attrs)))
      (assert= painted
        (list ["\"k\":" {:fg "#000002"}] ["null" {:fg "#000003"}] ["if" {:fg "#000001"}])))))
