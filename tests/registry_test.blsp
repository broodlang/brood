;; Registry updates are atomic under concurrency (KI-22, KI-23).
;;
;; A registry is a global holding a whole map/list that many processes register into.
;; Written the obvious way — `(def *X* (assoc *X* k v))` — it loses registrations: two
;; processes each read the old registry, each compute their own new one, and the second
;; `def` wins. KI-22 measured ~40% lost across the prelude's registries; the same shape
;; survived in ten more that live in `std/` modules (KI-23), where it showed up as
;; `repl_test`'s "re-registering replaces rather than duplicates" failing 2 runs in 5.
;;
;; Two mechanisms fix it, both indivisible under the runtime's registry lock:
;;   `%registry-update!`  one named map/list op (`:assoc`, `:cons-new`, …)
;;   `%registry-cas!`     compare-and-swap, with the transform left as a Brood function
;;                        and `%registry-swap!` / the `%swap-registry!` macro retrying
;;
;; Each test below runs the registration from many processes at once and asserts nothing
;; was lost. The control (a plain `def` read-modify-write) is measured in the first test
;; rather than described, so these numbers stay honest if the mechanism ever regresses.
;;
;; `:isolated` because every test here rebinds a shared global — that is the point.

(defmodule registry-test
  (:use test)
  (:use editor/face)
  (:use editor/layers)
  (:use telemetry)
  (:use repl))

(def *reg-writers* 200)

;; Fan `n` processes out over `f` (called with its index) and wait for all of them.
(defn- reg-fan (n f)
  (let (me (self))
    (dotimes (i n) (spawn (do (f i) (send me [:reg-done]))))
    (dotimes (_ n) (receive ([:reg-done] :ok) (after 30000 :timeout)))))

(def *reg-plain* {})
(def *reg-swapped* {})

(describe "atomic registry updates"
  :isolated

  ;; The mechanism itself, with its own control — so a regression cannot hide behind a
  ;; test that would pass even with the bug.
  (test "%swap-registry! loses no updates where a plain def rebind does"
    ;; The control: read the global, YIELD, then write it back — the read-modify-write
    ;; shape the registry mechanisms exist to fix. The `sleep` is load-bearing and is why
    ;; this reads as it does: the assertion below needs the control to ACTUALLY lose
    ;; updates, and without a yield that depends on the read and write windows happening
    ;; to overlap. They do on a many-core box; they do NOT on a 2-core runner, where 200
    ;; spawned writers serialise enough that every update survives, `count` equals
    ;; `*reg-writers*`, and the assertion fails — reddening the whole 4600-case wrapper on
    ;; CI while passing locally (diagnosed 2026-08-11 by pinning a local run to 2 cores
    ;; with `taskset`; it failed on both nextest attempts there and passes on 12).
    ;; With the yield every writer has read before any write lands, so updates are lost by
    ;; construction at any core count — a stronger demonstration of the same bug, and a
    ;; deterministic one.
    (reg-fan *reg-writers*
      (fn (i)
        (let (old *reg-plain*)
          (sleep 5)
          (def *reg-plain* (assoc old i i)))))
    ;; The mechanism, deliberately left un-yielded: its CAS retry recomputes from whatever
    ;; won, so it must lose nothing under ordinary contention.
    (reg-fan *reg-writers*
      (fn (i)
        (%swap-registry! registry-test/*reg-swapped*
          (fn (m) (assoc m i i)))))
    (assert= *reg-writers* (count *reg-swapped*))
    ;; Now a hard bound rather than a hopeful one: with every writer working from a stale
    ;; read, at most a handful of the 200 registrations can survive.
    (is (< (count *reg-plain*) *reg-writers*)))

  (test "the transform runs against the value that won, not a stale copy"
    ;; A counter is the sharpest form of this: every increment must survive, which is
    ;; only true if each retry recomputes from the current value.
    (def *reg-count* 0)
    (reg-fan *reg-writers* (fn (_) (%swap-registry! registry-test/*reg-count* (fn (n) (+ n 1)))))
    (assert= *reg-writers* *reg-count*)))

;; ---- the converted std registries (KI-23), each under concurrent registration ------

(describe "std registries register concurrently without loss"
  :isolated (test "def-face — every concurrently registered face is present"
    (reg-fan *reg-writers* (fn (i) (def-face (keyword (str "rt/f" i)) {:fg :red})))
    (assert= *reg-writers*
      (count (filter (range *reg-writers*) (fn (i) (map? (face (keyword (str "rt/f" i)))))))))

  (test "face-set — concurrent merges into the SAME face all land"
    ;; The read-modify-write is on the entry, not just the registry: each writer merges
    ;; one key into one shared face, so a lost update is a missing key.
    (def-face :rt/merged {:fg :red})
    (reg-fan 64 (fn (i) (face-set :rt/merged {(keyword (str "k" i)) i})))
    (let (f (face :rt/merged))
      (assert= :red (get f :fg))
      (assert= 64 (count (filter (range 64) (fn (i) (= i (get f (keyword (str "k" i))))))))))

  (test "register-repl-command — re-registering a name replaces, never duplicates"
    ;; This is the shape that was failing repl_test 2 runs in 5: two concurrent
    ;; registrations of the same name each filtered the old list and each appended, so
    ;; the duplicate the API forbids survived.
    (reg-fan 64
      (fn (_)
        (register-repl-command {:names (list "rt-dup")
                                :usage "u"
                                :summary "s"
                                :handler (fn (_) nil)})))
    (assert= 1 (count (filter *repl-commands* (fn (c) (includes? (get c :names) "rt-dup")))))
    ;; …while distinct names all survive.
    (reg-fan 64
      (fn (i)
        (register-repl-command {:names (list (str "rt-c" i))
                                :usage "u"
                                :summary "s"
                                :handler (fn (_) nil)})))
    (assert= 64
      (count (filter (range 64)
               (fn (i)
                 (any? *repl-commands* (fn (c) (includes? (get c :names) (str "rt-c" i)))))))))

  (test "telemetry attach — concurrent attaches to one event all survive"
    (reg-fan 64 (fn (i) (attach (str "rt-h" i) :rt/evt (fn (_e _m _md) nil))))
    (assert= 64 (count (get *telemetry-handlers* :rt/evt))))

  (test "telemetry attach — re-attaching an id replaces it across every bucket"
    (attach "rt-solo" :rt/one (fn (_e _m _md) nil))
    (attach "rt-solo" :rt/two (fn (_e _m _md) nil))
    (assert= 0
      (count (filter (get *telemetry-handlers* :rt/one) (fn (h) (= (get h :id) "rt-solo")))))
    (assert= 1
      (count (filter (get *telemetry-handlers* :rt/two) (fn (h) (= (get h :id) "rt-solo"))))))

  (test "register-system-layer — idempotent even when two processes race the same ref"
    ;; The membership test has to be inside the transform: outside it, both processes
    ;; see the ref absent and both append.
    (reg-fan 64 (fn (_) (register-system-layer :rt/sys)))
    (assert= 1 (count (filter *system-layers* (fn (r) (= r :rt/sys))))))

  (test "register-file-type — every concurrently registered rule is kept"
    (reg-fan 64 (fn (i) (register-file-type (str ".rt" i) (keyword (str "rt/t" i)))))
    (assert= 64
      (count (filter (range 64)
               (fn (i) (any? *auto-type-by-file* (fn (r) (= (get r :match) (str ".rt" i)))))))))

  (test "register-type-layers — every concurrently bound type is kept"
    (reg-fan 64 (fn (i) (register-type-layers (keyword (str "rt/ty" i)) (list :rt/l))))
    (assert= 64
      (count (filter (range 64)
               (fn (i) (= (list :rt/l) (layers-for-type (keyword (str "rt/ty" i))))))))))
