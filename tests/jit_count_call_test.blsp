;;; `count` of a receiver only Brood can count, in native code (ADR-811). The inline `count`
;;; answers the sizes the heap holds and DECLINES the rest — a record (its `Counted` or
;;; `Seqable` method), a lazy view (its realisation) — and native code cannot run Brood at a
;;; primitive, so each decline deopted. An arm counting such values on every call deopted
;;; until the thrash latch switched it off for good (womanblend's `head-held`,
;;; `deopt-thrash-latched:count-declined`).
;;;
;;; After four declines the arm now re-tiers with `count` a call to the real function. The
;;; TIER case asserts it is native and stays so: without the re-tier it latches `:bailed`.

(defmodule jit-count-call-test (:use test) (:use suite-helpers))

(defrecord cc-tally (n))
(impl Counted jit-count-call-test/cc-tally (->count (t) (get t :n)))
(defrecord cc-box (a b))

(def- cc-v [10 20])

(defn cc-held (r i) (+ (count r) (nth cc-v 0) i))
(defn- cc-drive (r i acc) (if (= i 0) acc (cc-drive r (- i 1) (+ acc (cc-held r i)))))

(describe "count of a receiver only Brood can count, in native code"
  (test "the arm re-tiers with count a call, and stays native"
    (when (%native-tier?)
      (assert-settles-native cc-held 2 (fn () (cc-drive (cc-tally 3) 300 0)))
      (cc-drive (cc-tally 3) 5000 0)
      ;; Still native after thousands more: a latched arm reads `:bailed`. (Not a bound on
      ;; `:deopts-total`: the arm is shared by the suite's processes, so another test counting
      ;; records adds its own declines before the re-tier lands — CI read more than four.)
      (assert= :native (get (%jit-arm-state cc-held 2) :state))))

  (test "the answers are count's"
    (cc-drive (cc-tally 3) 300 0)
    ;; a Counted record, a record by its fields, a lazy view, and the inline's own kinds
    (assert= 14 (cc-held (cc-tally 3) 1))
    (assert= 13 (cc-held (cc-box 1 2) 1))
    (assert= 14 (cc-held (seq/lmap [1 2 3] inc) 1))
    (assert= 15 (cc-held [1 2 3 4] 1))
    (assert= 11 (cc-held nil 1))))
