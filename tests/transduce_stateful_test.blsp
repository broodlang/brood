;; Stateful transducer stages (ADR-421): each `seq/transduce` run owns one table, bound while
;; the stack is built; a stateful stage keeps its state in a slot of it (`seq/stage-slot`), and
;; the run drops the table on every exit. `seq/xtake` is the built-in stateful stage.

(defmodule transduce-stateful-test (:use test))

;; A stage that records the run's table, so a test can ask whether it was dropped.
(defn- run-spy (seen)
  (fn (rf)
    (table/put seen :run *transduce-run*)
    rf))

(defn- dropped? (seen)
  ;; check-allow :discarded-catch — a dropped table is exactly the error this asks about
  (check-allow :discarded-catch
    (try (do (count (table/get seen :run)) false) (catch _ true))))

(describe "xtake"
  (test "passes the first n inputs and stops the run there"
    (assert= [0 1 2] (seq/transduce (range 1000000) (seq/xtake 3) [] conj)))
  (test "a short input ends first"
    (assert= [1 2] (seq/transduce [1 2] (seq/xtake 5) [] conj)))
  (test "zero takes nothing"
    (assert= [] (seq/transduce [1 2 3] (seq/xtake 0) [] conj)))
  (test "composes after and before stateless stages"
    (assert= [2 3] (seq/transduce [1 2 3 4 5] (comp (seq/xmap inc) (seq/xtake 2)) [] conj))
    (assert= [1 3] (seq/transduce (range 10) (comp (seq/xfilter math/odd?) (seq/xtake 2)) [] conj)))
  (test "the caller's reducing function is never called with one argument"
    ;; `(- acc)` would negate: no completion step reaches the caller's function
    (assert= -3 (seq/transduce [1 2 3] (seq/xtake 2) 0 -)))
  (test "two xtake stages keep separate counts"
    (assert= [0 1] (seq/transduce (range 10) (comp (seq/xtake 5) (seq/xtake 2)) [] conj))))

(describe "the run's table is dropped on every exit"
  (test "the input running out"
    (let (seen (table/new))
      (seq/transduce [1 2] (comp (run-spy seen) (seq/xtake 5)) [] conj)
      (is (dropped? seen))))
  (test "a reduced exit"
    (let (seen (table/new))
      (seq/transduce (range 100) (comp (run-spy seen) (seq/xtake 1)) [] conj)
      (is (dropped? seen))))
  (test "a throw out of the run"
    (let (seen (table/new))
      ;; check-allow :discarded-catch — the throw is the exit under test
      (check-allow :discarded-catch
        (try
          (seq/transduce [1 2]
            (comp (run-spy seen) (seq/xmap (fn (_x) (error "boom"))))
            []
            conj)
          (catch _ nil)))
      (is (dropped? seen)))))

(describe "stage-slot outside a run"
  (test "a stateful stage refuses to run outside transduce"
    (assert-error ((seq/xtake 1) conj))))

(describe "stateful stages across processes"
  :isolated (test "concurrent runs each own their state"
    (let (me (self)
          n 8)
      (doseq (i (range n))
        (spawn (fn () (send me [i (seq/transduce (range 100) (seq/xtake i) [] conj)]))))
      (let (got (fold (range n) {} (fn (acc _) (receive ([i v] (assoc acc i v))))))
        (doseq (i (range n))
          (assert= (vec (range i)) (get got i)))))))
