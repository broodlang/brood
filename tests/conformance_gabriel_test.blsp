;; tests/conformance_gabriel_test.blsp — the Gabriel/Larceny Scheme benchmarks as a
;; conformance suite (ROADMAP "External conformance corpora", suite 13).
;;
;; Every other corpus here feeds hostile *data* to one parser. This one runs whole
;; *programs* with known answers, which buys something the others cannot: an oracle for
;; the evaluator itself. A theorem prover that reports 95,024 rewrites, a maze whose 121
;; cells are all correct, or ten exact 500-digit integers cannot be produced by an engine
;; that mis-stages a closure slot, loses a branch under GC, or miscompiles an arm — and
;; unlike a benchmark timing, a wrong answer here is unambiguous. These are real Lisp
;; programs, 30-40 years of other implementers' debugging behind them, run against
;; Brood's three engines.
;;
;; Where each expected value comes from, since it differs per benchmark and that is the
;; whole basis of the suite's authority:
;;
;;   (a) the vendored `.input` file's live stanza — upstream's own bytes, read here with
;;       `corpus-forms` and never retyped: deriv, mazefun, primes, chudnovsky.
;;   (b) an OLDER stanza upstream still keeps in the same `.input` file, because the
;;       current one is sized for timing a native-compiling Scheme and is far too slow
;;       for a test suite: cpstak (live data further down the file), takl (upstream's
;;       comment block — quoted in tests/corpus/gabriel/README.md).
;;   (c) an external published table: nboyer's rewrite counts, from the sanity-check
;;       table in upstream's own source header; nqueens' solution counts, from OEIS
;;       A000170. Both are quoted in the README.
;;
;; The `.input` files put the ITERATION COUNT first, then the arguments, then the
;; expected result — upstream's `(read)` order. The count is for timing and is ignored
;; here (we run each program once), so the arguments start at index 1.
;;
;; Runtime, release build: the whole file is ~0.4 s except the two `:slow` cases. Sizes
;; were chosen against that budget deliberately — see the README for what each costs and
;; what was excluded for being too slow to be worth its coverage.

(defmodule conformance-gabriel-test
  (:use test)
  (:use seq)
  (:use corpus)
  (:use gabriel/deriv)
  (:use gabriel/takl)
  (:use gabriel/cpstak)
  (:use gabriel/mazefun)
  (:use gabriel/nqueens)
  (:use gabriel/primes)
  (:use gabriel/nboyer)
  (:use gabriel/chudnovsky))

(defn- gb-forms
  (name)
  "The s-expressions of the vendored `<name>.input`, in upstream's `(read)` order."
  ;; the prelude's bootstrap `path-join` is 2-arg (`path/join` is the variadic one)
  (corpus-forms (path-join (path-join (corpus-dir "gabriel") "data") (str name ".input"))))

;; ---- (c) upstream's published tables ------------------------------------------
;; These two are the only expectations in this file that are typed rather than read,
;; because neither is in a machine-readable upstream artifact. Both are quoted in the
;; README next to their source.

;; nboyer.scm's header: "The correct number of rewrites is | n rewrites | 0 95024 |
;; 1 591777 | 2 1813975 | 3 5375678 | 4 16445406 | 5 51507739".
(def- gb-nboyer-rewrites {0 95024 1 591777 2 1813975})

;; OEIS A000170, the number of solutions to the n-queens problem, n = 1..10.
(def- gb-nqueens-solutions [1 0 0 2 10 4 40 92 352 724])

(describe "Gabriel benchmarks: whole programs with known answers"
  :tags
  [:conformance]

  (test "the corpus is present, one .input per ported program"
    (is (corpus-present? "gabriel"))
    (assert= (count (corpus-files "gabriel" "data")) 8))

  ;; ---- (a) the vendored live stanza ------------------------------------------

  (test "deriv — the whole derivative tree, not a number"
    ;; The result is a ~90-node s-expression, so this compares structure: a `cons` that
    ;; built the wrong shape fails even when every leaf is right.
    (let (f (gb-forms "deriv"))
      (assert= (deriv (nth f 1)) (nth f 2))))

  (test "mazefun — all 121 cells of a deterministically generated maze"
    ;; Purely functional generation from a fixed LCG seed, so the grid is fully
    ;; determined. One mis-flooded cavity changes one cell and fails.
    (let (f (gb-forms "mazefun"))
      (assert= (make-maze (nth f 1) (nth f 2)) (nth f 3))))

  (test "primes — the list sieve up to 1000, every element in order"
    (let (f (gb-forms "primes"))
      (assert= (primes<= (nth f 1)) (nth f 2))))

  (test "chudnovsky — ten exact big-integer values of π, 50 to 500 digits"
    ;; The big-integer oracle: ~1000-digit exact arithmetic throughout, and the answer
    ;; is checked digit for digit against upstream's.
    (let (f (gb-forms "chudnovsky"))
      (assert= (pies (nth f 1) (nth f 2) (nth f 3)) (nth f 4))))

  ;; ---- (b) an older upstream stanza -------------------------------------------

  (test "cpstak — continuation-passing TAK, upstream's smallest stanza"
    ;; cpstak.input keeps three historical stanzas; `read-all` sees all of them because
    ;; only the prose between them is commented. The third — count 1700, then 18 12 6,
    ;; then 7 — is the classic Gabriel size and the only one that fits a test budget:
    ;; the current stanza (40 20 11) takes 3.5 s in Chez for ONE iteration.
    (let (f (gb-forms "cpstak"))
      ; the stanza is where we think
      (assert= (take 5 (drop 10 f)) '(1700 18 12 6 7))
      (assert= (cpstak (nth f 11) (nth f 12) (nth f 13)) (nth f 14))))

  (test "takl — Takeuchi over lists as counters, upstream's oldest stanza"
    ;; takl.input's older stanzas are `;;`-commented, so the reader cannot see them and
    ;; these three sizes are transcribed from that comment block (README quotes it):
    ;; lists of 18, 12 and 6 elements, expecting a result of length 7. The live stanza
    ;; (40 20 12) takes 4 s in Chez and minutes here.
    ;;
    ;; The counter lists are built here rather than by a ported `listn`, because upstream
    ;; defines `listn` and then does not use it — the R7RS harness reads its lists from
    ;; the file. Descending order, matching the file's own `(18 17 … 1)` spelling.
    (let (l18 (reverse (into () (range 1 19)))
          l12 (reverse (into () (range 1 13)))
          l6 (reverse (into () (range 1 7))))
      (assert= (count l18) 18)
      (assert= (first l18) 18)
      (assert= (count (mas l18 l12 l6)) 7)))

  ;; ---- (c) an external published table ----------------------------------------

  (test "nboyer — the rewrite count, upstream's own sanity check"
    ;; Upstream reports rewrites rather than the boolean "because it is too easy for a
    ;; buggy version to return the correct boolean result". Matching a six-figure count
    ;; exercises rule ORDER, unification and the tautology walk together: an engine or a
    ;; port that takes one wrong branch lands on a different number, not a near miss.
    (let (db (setup-boyer))
      ; 58 symbols carry lemmas
      (assert= (count db) 58)
      (assert= (test-boyer nboyer-alist nboyer-term 0 db)
        (get gb-nboyer-rewrites 0))))

  (test "nqueens — solution counts for n = 1..10 (OEIS A000170)"
    ;; Upstream's own stanza is n=13 -> 73712, excluded at ~40 s here (see the README).
    ;; The published sequence prefix is a stronger oracle anyway: ten independent
    ;; answers, including the two n with no solutions at all.
    (dolist (p (enumerate gb-nqueens-solutions))
      (let ([i want] p)
        (assert= (nqueens (+ i 1)) want)))))

;; The two heavier sizes, kept out of the default budget. `:slow` raises the batch
;; timeout (a `:conformance` tag does too) rather than skipping them, so they really do
;; run — they are the cases that put sustained pressure on the rewriter and the GC.
(describe "Gabriel benchmarks: the heavier sizes"
  :tags
  [:conformance :slow]

  (test "nboyer — n=1 and n=2, 0.6M and 1.8M rewrites"
    ;; Each step of upstream's scaling parameter wraps the term in `(or term (f))` again,
    ;; roughly tripling the rewrites. Held here because a rewriter that drifts only under
    ;; sustained allocation — a GC or JIT-tiering bug rather than a logic one — shows up
    ;; at 1.8M rewrites and not at 95k.
    (let (db (setup-boyer))
      (dolist (n [1 2])
        (assert= (test-boyer nboyer-alist nboyer-term n db)
          (get gb-nboyer-rewrites n)))))

  (test "nqueens — n=11, 2680 solutions"
    ;; One size past the fast block: ~1.3 s, where n=12 is ~7 s and n=13 ~40 s.
    (assert= (nqueens 11) 2680)))
