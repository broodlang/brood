;; A responsive process — `(proc/flag :responsive mode)` (ADR-517): a native call that waits
;; on the outside world is reported to the process after the wait, or refused before it.
;;
;; Coverage:
;;   - the flag reads nil / :report / :refuse and a set returns the previous mode
;;   - :refuse raises a catchable E0048 naming the call, and the command never runs
;;   - :report lets the call through and then sends [:blocking-call {:native :detail :ms}]
;;   - an ordinary process gets no message
;;   - a file call is reported only when it held the process, and never refused
;; Each case runs in its own process, so the flag never reaches the test runner.

(defmodule responsive-process-test (:use test))

(defn- in-process (body)
  "Run `body` in a fresh process and answer what it returned."
  (let (me (self))
    (spawn (fn () (send me [:done (body)])))
    (receive ([:done value] value) (after 20000 :timed-out))))

(defn- blocking-reports ()
  "The `[:blocking-call …]` facts already in this process's mailbox, oldest first."
  (letrec (drain (fn (acc)
                   (receive ([:blocking-call facts] (drain (conj acc facts))) (after 0 acc))))
    (drain [])))

(describe "a responsive process"
  (test "the flag reads its mode and a set answers the previous one"
    (assert= (in-process (fn ()
                           [(proc/flag :responsive)
                             (proc/flag :responsive true)
                             (proc/flag :responsive :refuse)
                             (proc/flag :responsive nil)
                             (proc/flag :responsive)]))
      [nil nil :report :refuse nil]))
  (test "a refusing process is refused with E0048 before the command runs"
    (let (marker (path/temp (str "brood-responsive-" (rand/token 8))))
      (assert= (in-process (fn ()
                             (proc/flag :responsive :refuse)
                             (try
                               (os/cmd "touch" [marker])
                               (catch e [(get e :code) (includes? (error-message e) "touch")]))))
        ["E0048" true])
      (is (not (file/exists? marker)))))
  (test "a reporting process runs the command, then is told what held it and for how long"
    (let (facts (in-process (fn ()
                              (proc/flag :responsive true)
                              (os/cmd "true" ["one" "two"])
                              (blocking-reports))))
      (assert= (count facts) 1)
      (assert= (:native (first facts)) "os/cmd")
      (assert= (:detail (first facts)) "true one two")
      (is (int? (:ms (first facts))))))
  (test "an ordinary process is told nothing"
    (assert= (in-process (fn () (os/cmd "true" []) (blocking-reports))) [])))

;; A clipboard READ waits on another program too: the selection's owner serialises what it
;; holds (an X11 conversion, a Wayland data-offer pipe), and a hung or slow owner holds the
;; reader. An editor's yank read it inside the keypress, unseen by the flag (ADR-536).
(describe "a responsive process and the clipboard"
  (test "a refusing process is refused a clipboard read, text or image"
    (assert= (in-process (fn ()
                           (proc/flag :responsive :refuse)
                           [(try (os/clipboard-get) (catch e (get e :code)))
                             (try (os/clipboard-image) (catch e (get e :code)))]))
      ["E0048" "E0048"]))
  (test "a reporting process is told a clipboard read held it"
    (let (facts (in-process (fn ()
                              (proc/flag :responsive true)
                              (os/clipboard-get)
                              (blocking-reports))))
      (assert= (into [] (map facts :native)) ["os/clipboard-get"])))
  (test "writing the clipboard waits on nobody, so it is never refused"
    (assert= (in-process (fn ()
                           (proc/flag :responsive :refuse)
                           (os/clipboard-set "brood responsive test")))
      "brood responsive test")))

;; A file call waits on the world too — a network mount, a spun-down disk, a FIFO no one
;; writes — but almost always it is instant, and a responsive process makes local reads on
;; purpose. So it is reported only when it held the process (`SLOW_FILE_CALL_MS`, 20 ms), and
;; never refused (ADR-517's file addendum). A FIFO stands in for the slow mount. The shell
;; opens it FIRST (`exec 3>`, which blocks until the reader has opened it too), and only
;; then waits 100 ms and writes, so the read is held for those 100 ms however late the
;; reading process starts. Sleeping before the open made the hold depend on the reader
;; arriving within 100 ms of the spawn; a loaded run started it later and read instantly.
(describe "a responsive process and the disk"
  (test "a file read that held the process is reported with its path"
    (when (not (= (os/type) :windows))
      (let (fifo (path/temp (str "brood-responsive-fifo-" (rand/token 8)))
            _ (os/cmd "mkfifo" [fifo])
            _ (os/spawn "sh" ["-c" (str "exec 3> '" fifo "'; sleep 0.1; printf slow >&3")])
            [text facts] (in-process (fn ()
                                       (proc/flag :responsive true)
                                       [(file/slurp fifo) (blocking-reports)])))
        (file/rm fifo)
        (assert= text "slow")
        (assert= (into [] (map facts :native)) ["file/slurp"])
        (assert= (:detail (first facts)) fifo)
        (is (>= (:ms (first facts)) 20)))))
  (test "a quick file call is not reported, and a refusing process is never refused one"
    (let (path (path/temp (str "brood-responsive-file-" (rand/token 8))))
      (assert= (in-process (fn ()
                             (proc/flag :responsive :refuse)
                             (file/spit path "quick")
                             [(file/slurp path) (file/exists? path) (blocking-reports)]))
        ["quick" true []])
      (file/rm path))))
