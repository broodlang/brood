#!/bin/sh
# Thin ./configure for the Brood build, in the familiar autotools shape
# (./configure && make install). Brood is a Cargo workspace — this is just a
# convenience that records local build options into `config.mk`, which the
# Makefile includes. Re-run it any time to change options; it is not generated by
# autoconf and has no dependencies beyond a POSIX shell.

set -eu

prefix="$HOME/.local"
with_gui=0
with_gui_gpu=0
with_audio=0
with_jit=1
with_stdimage=1

usage() {
	cat <<'EOF'
Usage: ./configure [options]

Options:
  --with-gui        Build the native GUI window backend (winit/softbuffer/fontdue),
                    so `(observe)` can open a window. Off by default.
  --without-gui     Disable the GUI backend (the default).
  --with-gui-gpu    Build the EXPERIMENTAL GPU (OpenGL) render backend instead of the
                    CPU softbuffer one (implies --with-gui). Instanced quads + an
                    immediate swapchain; text is not yet drawn on the GPU. Off by default.
  --without-gui-gpu Use the CPU softbuffer backend (the default).
  --with-audio      Build the audio backend (the `audio-beep` builtin, via rodio).
                    OFF by default and independent of --with-gui: on Linux it links
                    libasound.so.2 as a hard runtime dep, so a default/gui build
                    stays portable. Needs libasound2-dev + pkg-config to compile.
  --without-audio   Disable the audio backend (the default).
  --with-jit        Build the tier-1 JIT (ADR-101) into `brood`/`nest`. On by default;
                    hot compute loops run as native code. Needs a Cranelift-supported
                    host (x86_64 / aarch64).
  --without-jit     Disable the JIT (bytecode VM only) — for an unsupported host or a
                    minimal build.
  --with-stdimage   Build the stdlib startup image in (ADR-256/281). On by default: a
                    `require`d std module materialises its bindings from ~/.cache/brood
                    instead of re-evaluating its source (a three-module script 46.5 ->
                    36.2 ms). Costs nothing when no image is present.
  --without-stdimage
                    Never consult or write a cache directory — for a read-only or
                    sandboxed deployment, or a machine that should grow no ~2 MB file.
                    The per-run switch is BROOD_NO_STDIMAGE=1; this is the build-time one.
  --prefix=DIR      Install root for `make install` (default: $HOME/.local).
                    Binaries go in DIR/bin.
  -h, --help        Show this help and exit.

Writes config.mk, then run `make install`. Example:
  ./configure --with-gui && make install
EOF
}

for arg in "$@"; do
	case "$arg" in
	--with-gui) with_gui=1 ;;
	--without-gui) with_gui=0 ;;
	--with-gui-gpu) with_gui_gpu=1; with_gui=1 ;;
	--without-gui-gpu) with_gui_gpu=0 ;;
	--with-audio) with_audio=1 ;;
	--without-audio) with_audio=0 ;;
	--with-jit) with_jit=1 ;;
	--without-jit) with_jit=0 ;;
	--with-stdimage) with_stdimage=1 ;;
	--without-stdimage) with_stdimage=0 ;;
	--prefix=*) prefix=${arg#--prefix=} ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "configure: unknown option: $arg" >&2
		echo "Try './configure --help'." >&2
		exit 1
		;;
	esac
done

# Re-running ./configure starts from the DEFAULTS, never from the last run — that is
# the autotools contract and this keeps it. But it is a trap worth naming out loud:
# `./configure --with-audio` on a tree configured `--with-gui` turns the GUI back OFF,
# and nothing says so until a GUI app dies at its first frame with "gui backend not
# compiled in" (2026-08-29: that is exactly how bedit stopped booting). So diff against
# the config.mk we are about to replace, and report every option this run turns OFF.
turned_off=""
prefix_was=""
if [ -f config.mk ]; then
	for pair in "WITH_GUI:$with_gui" "WITH_GUI_GPU:$with_gui_gpu" \
		"WITH_AUDIO:$with_audio" "WITH_JIT:$with_jit" "WITH_STDIMAGE:$with_stdimage"; do
		key=${pair%%:*}
		now=${pair#*:}
		was=$(sed -n "s/^$key *:= *//p" config.mk | head -1)
		if [ "$was" = "1" ] && [ "$now" = "0" ]; then
			turned_off="$turned_off $key"
		fi
	done
	was_prefix=$(sed -n "s/^PREFIX *:= *//p" config.mk | head -1)
	if [ -n "$was_prefix" ] && [ "$was_prefix" != "$prefix" ]; then
		prefix_was=$was_prefix
	fi
fi

cat >config.mk <<EOF
# Generated by ./configure — do not edit by hand (re-run ./configure to change).
PREFIX   := $prefix
WITH_GUI := $with_gui
WITH_GUI_GPU := $with_gui_gpu
WITH_AUDIO := $with_audio
WITH_JIT := $with_jit
WITH_STDIMAGE := $with_stdimage
EOF

echo "configure: wrote config.mk"
echo "  prefix      = $prefix"
echo "  with-gui    = $with_gui"
echo "  with-gui-gpu = $with_gui_gpu"
echo "  with-audio  = $with_audio"
echo "  with-jit    = $with_jit"
echo "  with-stdimage = $with_stdimage"

if [ -n "$turned_off" ]; then
	echo
	echo "configure: WARNING — this run turns OFF what the previous config.mk had ON:"
	for key in $turned_off; do
		echo "    $key := 0   (was 1)"
	done
	echo "  ./configure starts from the defaults every time, so pass EVERY option you"
	echo "  want on one line — e.g. ./configure --with-gui --with-audio"
fi
if [ -n "$prefix_was" ]; then
	echo
	echo "configure: note — prefix changed from $prefix_was to $prefix"
fi
echo
echo "Next: make install"
